  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Τεκνία μου, ταῦτα γράφω ὑμῖν, ἵνα μὴ ἁμάρτητε. Καὶ ἐάν τις ἁμάρτῃ, παράκλητον ἔχομεν πρὸς τὸν πατέρα, Ἰησοῦν Χριστὸν δίκαιον·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ αὐτὸς ἱλασμός ἐστι περὶ τῶν ἁμαρτιῶν ἡμῶν· οὐ περὶ τῶν ἡμετέρων δὲ μόνον, ἀλλὰ καὶ περὶ ὅλου τοῦ κόσμου."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Καὶ ἐν τούτῳ γινώσκομεν ὅτι ἐγνώκαμεν αὐτόν, ἐὰν τὰς ἐντολὰς αὐτοῦ τηρῶμεν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Ὁ λέγων, Ἔγνωκα αὐτόν, καὶ τὰς ἐντολὰς αὐτοῦ μὴ τηρῶν, ψεύστης ἐστί, καὶ ἐν τούτῳ ἡ ἀλήθεια οὐκ ἔστιν·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ὃς δ᾿ ἂν τηρῇ αὐτοῦ τὸν λόγον, ἀληθῶς ἐν τούτῳ ἡ ἀγάπη τοῦ Θεοῦ τετελείωται. Ἐν τούτῳ γινώσκομεν ὅτι ἐν αὐτῷ ἐσμέν·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ὁ λέγων ἐν αὐτῷ μένειν ὀφείλει, καθὼς ἐκεῖνος περιεπάτησε, καὶ αὐτὸς οὕτω περιπατεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ἀδελφοί, οὐκ ἐντολὴν καινὴν γράφω ὑμῖν, ἀλλ᾿ ἐντολὴν παλαιάν, ἣν εἴχετε ἀπ᾿ ἀρχῆς· ἡ ἐντολὴ ἡ παλαιά ἐστιν ὁ λόγος ὃν ἠκούσατε ἀπ᾿ ἀρχῆς."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Πάλιν ἐντολὴν καινὴν γράφω ὑμῖν, ὅ ἐστιν ἀληθὲς ἐν αὐτῷ καὶ ἐν ὑμῖν· ὅτι ἡ σκοτία παράγεται, καὶ τὸ φῶς τὸ ἀληθινὸν ἤδη φαίνει."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Ὁ λέγων ἐν τῷ φωτὶ εἶναι καὶ τὸν ἀδελφὸν αὐτοῦ μισῶν, ἐν τῇ σκοτίᾳ ἐστὶν ἕως ἄρτι."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Ὁ ἀγαπῶν τὸν ἀδελφὸν αὐτοῦ ἐν τῷ φωτὶ μένει, καὶ σκάνδαλον ἐν αὐτῷ οὐκ ἔστιν."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ὁ δὲ μισῶν τὸν ἀδελφὸν αὐτοῦ ἐν τῇ σκοτίᾳ ἐστί, καὶ ἐν τῇ σκοτίᾳ περιπατεῖ, καὶ οὐκ οἶδε ποῦ ὑπάγει, ὅτι ἡ σκοτία ἐτύφλωσε τοὺς ὀφθαλμοὺς αὐτοῦ."
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Γράφω ὑμῖν, τεκνία,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ὅτι ἀφέωνται ὑμῖν αἱ ἁμαρτίαι διὰ τὸ ὄνομα αὐτοῦ.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Γράφω ὑμῖν, πατέρες,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ὅτι ἐγνώκατε τὸν ἀπ᾿ ἀρχῆς.",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Γράφω ὑμῖν, νεανίσκοι,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ὅτι νενικήκατε τὸν πονηρόν.",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Γράφω ὑμῖν, παιδία,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ὅτι ἐγνώκατε τὸν πατέρα.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ἔγραψα ὑμῖν, πατέρες,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ὅτι ἐγνώκατε τὸν ἀπ᾿ ἀρχῆς.",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ἔγραψα ὑμῖν, νεανίσκοι,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ὅτι ἰσχυροί ἐστε,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ὁ λόγος τοῦ Θεοῦ ἐν ὑμῖν μένει,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ νενικήκατε τὸν πονηρόν.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Μὴ ἀγαπᾶτε τὸν κόσμον, μηδὲ τὰ ἐν τῷ κόσμῳ. Ἐάν τις ἀγαπᾷ τὸν κόσμον, οὐκ ἔστιν ἡ ἀγάπη τοῦ πατρὸς ἐν αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Ὅτι πᾶν τὸ ἐν τῷ κόσμῳ, ἡ ἐπιθυμία τῆς σαρκός, καὶ ἡ ἐπιθυμία τῶν ὀφθαλμῶν, καὶ ἡ ἀλαζονεία τοῦ βίου, οὐκ ἔστιν ἐκ τοῦ πατρός, ἀλλ᾿ ἐκ τοῦ κόσμου ἐστί."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Καὶ ὁ κόσμος παράγεται, καὶ ἡ ἐπιθυμία αὐτοῦ· ὁ δὲ ποιῶν τὸ θέλημα τοῦ Θεοῦ μένει εἰς τὸν αἰῶνα."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Παιδία, ἐσχάτη ὥρα ἐστί· καὶ καθὼς ἠκούσατε ὅτι ὁ ἀντίχριστος ἔρχεται, καὶ νῦν ἀντίχριστοι πολλοὶ γεγόνασιν· ὅθεν γινώσκομεν ὅτι ἐσχάτη ὥρα ἐστίν."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Ἐξ ἡμῶν ἐξῆλθον, ἀλλ᾿ οὐκ ἦσαν ἐξ ἡμῶν· εἰ γὰρ ἦσαν ἐξ ἡμῶν, μεμενήκεισαν ἂν μεθ᾿ ἡμῶν· ἀλλ᾿ ἵνα φανερωθῶσιν ὅτι οὐκ εἰσὶ πάντες ἐξ ἡμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Καὶ ὑμεῖς χρίσμα ἔχετε ἀπὸ τοῦ ἁγίου, καὶ οἴδατε πάντα."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Οὐκ ἔγραψα ὑμῖν ὅτι οὐκ οἴδατε τὴν ἀλήθειαν, ἀλλ᾿ ὅτι οἴδατε αὐτήν, καὶ ὅτι πᾶν ψεῦδος ἐκ τῆς ἀληθείας οὐκ ἔστι."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Τίς ἐστιν ὁ ψεύστης, εἰ μὴ ὁ ἀρνούμενος ὅτι Ἰησοῦς οὐκ ἔστιν ὁ Χριστός; Οὗτός ἐστιν ὁ ἀντίχριστος, ὁ ἀρνούμενος τὸν πατέρα καὶ τὸν υἱόν."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Πᾶς ὁ ἀρνούμενος τὸν υἱὸν οὐδὲ τὸν πατέρα",
          {
            "noteId": 2
          },
          "ἔχει."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Ὑμεῖς οὖν ὃ ἠκούσατε ἀπ᾿ ἀρχῆς, ἐν ὑμῖν μενέτω. Ἐὰν ἐν ὑμῖν μείνῃ ὃ ἀπ᾿ ἀρχῆς ἠκούσατε, καὶ ὑμεῖς ἐν τῷ υἱῷ καὶ ἐν τῷ πατρὶ μενεῖτε."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Καὶ αὕτη ἐστὶν ἡ ἐπαγγελία ἣν αὐτὸς ἐπηγγείλατο ἡμῖν, τὴν ζωὴν τὴν αἰώνιον."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Ταῦτα ἔγραψα ὑμῖν περὶ τῶν πλανώντων ὑμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Καὶ ὑμεῖς, τὸ χρίσμα ὃ ἐλάβετε ἀπ᾿ αὐτοῦ ἐν ὑμῖν μένει, καὶ οὐ χρείαν ἔχετε ἵνα τις διδάσκῃ ὑμᾶς· ἀλλ᾿ ὡς τὸ αὐτὸ χρίσμα διδάσκει ὑμᾶς περὶ πάντων, καὶ ἀληθές ἐστι, καὶ οὐκ ἔστι ψεῦδος, καὶ καθὼς ἐδίδαξεν ὑμᾶς, μενεῖτε ἐν αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Καὶ νῦν, τεκνία, μένετε ἐν αὐτῷ· ἵνα ὅταν φανερωθῇ, ἔχωμεν παρρησίαν, καὶ μὴ αἰσχυνθῶμεν ἀπ᾿ αὐτοῦ ἐν τῇ παρουσίᾳ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Ἐὰν εἰδῆτε ὅτι δίκαιός ἐστι, γινώσκετε ὅτι πᾶς ὁ ποιῶν τὴν δικαιοσύνην ἐξ αὐτοῦ",
          {
            "noteId": 3
          },
          "γεγέννηται."
        ]
      }
    ],
