  "chapter": {
    "number": 15,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ εἶδον ἄλλο σημεῖον ἐν τῷ οὐρανῷ μέγα καὶ θαυμαστόν, ἀγγέλους ἑπτὰ ἔχοντας πληγὰς ἑπτὰ τὰς ἐσχάτας, ὅτι ἐν αὐταῖς ἐτελέσθη ὁ θυμὸς τοῦ Θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Καὶ εἶδον ὡς θάλασσαν ὑαλίνην μεμιγμένην πυρί, καὶ τοὺς νικῶντας ἐκ τοῦ θηρίου καὶ ἐκ τῆς εἰκόνος αὐτοῦ καὶ ἐκ τοῦ χαράγματος αὐτοῦ, ἐκ τοῦ ἀριθμοῦ τοῦ ὀνόματος αὐτοῦ, ἑστῶτας ἐπὶ τὴν θάλασσαν τὴν ὑαλίνην, ἔχοντας κιθάρας τοῦ Θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Καὶ ᾄδουσι τὴν ᾠδὴν Μωσέως",
          {
            "noteId": 32
          },
          "δούλου τοῦ Θεοῦ, καὶ τὴν ᾠδὴν τοῦ ἀρνίου, λέγοντες,",
          {
            "lineBreak": true
          },
          {
            "text": "Μεγάλα καὶ θαυμαστὰ τὰ ἔργα σου,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Κύριε ὁ Θεὸς ὁ παντοκράτωρ·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "δίκαιαι καὶ ἀληθιναὶ αἱ ὁδοί σου,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ὁ βασιλεὺς τῶν ἁγίων.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Τίς οὐ μὴ φοβηθῇ σε, Κύριε,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ δοξάσῃ τὸ ὄνομά σου;",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ὅτι μόνος ὅσιος·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ὅτι πάντα τὰ ἔθνη ἥξουσι",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ προσκυνήσουσιν ἐνώπιόν σου,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ὅτι τὰ δικαιώματά σου ἐφανερώθησαν.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Καὶ μετὰ ταῦτα εἶδον, καὶ ἰδού, ἠνοίγη ὁ ναὸς τῆς σκηνῆς τοῦ μαρτυρίου ἐν τῷ οὐρανῷ·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ ἐξῆλθον οἱ ἑπτὰ ἄγγελοι ἔχοντες τὰς ἑπτὰ πληγὰς ἐκ τοῦ ναοῦ, ἐνδεδυμένοι λίνον καθαρὸν καὶ λαμπρόν, καὶ περιεζωσμένοι περὶ τὰ στήθη ζώνας χρυσᾶς·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "καὶ ἓν ἐκ τῶν τεσσάρων ζῴων ἔδωκε τοῖς ἑπτὰ ἀγγέλοις ἑπτὰ φιάλας χρυσᾶς γεμούσας τοῦ θυμοῦ τοῦ Θεοῦ τοῦ ζῶντος εἰς τοὺς αἰῶνας τῶν αἰώνων."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Καὶ ἐγεμίσθη ὁ ναὸς καπνοῦ ἐκ τῆς δόξης τοῦ Θεοῦ, καὶ ἐκ τῆς δυνάμεως αὐτοῦ· καὶ οὐδεὶς ἠδύνατο εἰσελθεῖν εἰς τὸν ναόν, ἄχρι τελεσθῶσιν αἱ ἑπτὰ πληγαὶ τῶν ἑπτὰ ἀγγέλων."
        ]
      }
    ],
