    "commonName": "ΑΠΟΚΑΛΥΨΙΣ ΙΩΑΝΝΟΥ",
    "title": "ΑΠΟΚΑΛΥΨΙΣ ΤΟΥ ΑΓΙΟΥ ΙΩΑΝΝΟΥ ΤΟΥ ΘΕΟΛΟΓΟΥ",
    "order": 66,
    "numberOfChapters": 22,
    "sha256": "683d484dd1c8ebeac68c0e6870723135c95ec65c765bd11990abf822ef7cae7a",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_gtr/REV/1.json",
    "lastChapterNumber": 22,
    "lastChapterApiLink": "/api/grc_gtr/REV/22.json",
    "totalNumberOfVerses": 404
  },
  "chapter": {
    "number": 18,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ μετὰ ταῦτα εἶδον",
          {
            "noteId": 38
          },
          "ἄγγελον καταβαίνοντα ἐκ τοῦ οὐρανοῦ, ἔχοντα ἐξουσίαν μεγάλην· καὶ ἡ γῆ ἐφωτίσθη ἐκ τῆς δόξης αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Καὶ ἔκραξεν ἐν ἰσχύϊ, φωνῇ μεγάλῃ, λέγων,",
          {
            "lineBreak": true
          },
          {
            "text": "Ἔπεσεν ἔπεσε Βαβυλὼν ἡ μεγάλη,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ἐγένετο κατοικητήριον δαιμόνων,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ φυλακὴ παντὸς πνεύματος ἀκαθάρτου,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ φυλακὴ παντὸς ὀρνέου ἀκαθάρτου καὶ μεμισημένου.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ὅτι ἐκ τοῦ οἴνου τοῦ θυμοῦ τῆς πορνείας αὐτῆς",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "πέπωκε πάντα τὰ ἔθνη,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ οἱ βασιλεῖς τῆς γῆς μετ᾿ αὐτῆς ἐπόρνευσαν,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ οἱ ἔμποροι τῆς γῆς ἐκ τῆς δυνάμεως τοῦ στρήνους αὐτῆς ἐπλούτησαν.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Καὶ ἤκουσα ἄλλην φωνὴν ἐκ τοῦ οὐρανοῦ, λέγουσαν,",
          {
            "lineBreak": true
          },
          {
            "text": "Ἐξέλθετε ἐξ αὐτῆς ὁ λαός μου,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἵνα μὴ συγκοινωνήσητε ταῖς ἁμαρτίαις αὐτῆς,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ἵνα μὴ λάβητε ἐκ τῶν πληγῶν αὐτῆς·",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "ὅτι",
            "poem": 1
          },
          {
            "noteId": 39
          },
          {
            "text": "ἠκολούθησαν αὐτῆς αἱ ἁμαρτίαι ἄχρι τοῦ οὐρανοῦ,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ἐμνημόνευσεν ὁ Θεὸς τὰ ἀδικήματα αὐτῆς.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ἀπόδοτε αὐτῇ ὡς καὶ αὐτὴ ἀπέδωκεν ὑμῖν,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ διπλώσατε αὐτῇ διπλᾶ κατὰ τὰ ἔργα αὐτῆς·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἐν τῷ ποτηρίῳ ᾧ ἐκέρασε κεράσατε αὐτῇ διπλοῦν.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ὅσα ἐδόξασεν ἑαυτὴν καὶ ἐστρηνίασε,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "τοσοῦτον δότε αὐτῇ βασανισμὸν καὶ πένθος·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ὅτι ἐν τῇ καρδίᾳ αὐτῆς λέγει,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Κάθημαι βασίλισσα,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ χήρα οὐκ εἰμί,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ πένθος οὐ μὴ ἴδω.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Διὰ τοῦτο ἐν μιᾷ ἡμέρᾳ ἥξουσιν αἱ πληγαὶ αὐτῆς,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "θάνατος καὶ πένθος καὶ λιμός,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ἐν πυρὶ κατακαυθήσεται,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ὅτι ἰσχυρὸς Κύριος ὁ Θεὸς ὁ κρίνων αὐτήν.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Καὶ κλαύσονται αὐτήν, καὶ κόψονται ἐπ᾿ αὐτῇ οἱ βασιλεῖς τῆς γῆς οἱ μετ᾿ αὐτῆς πορνεύσαντες καὶ στρηνιάσαντες, ὅταν βλέπωσι τὸν καπνὸν τῆς πυρώσεως αὐτῆς,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἀπὸ μακρόθεν ἑστηκότες διὰ τὸν φόβον τοῦ βασανισμοῦ αὐτῆς, λέγοντες,",
          {
            "lineBreak": true
          },
          {
            "text": "Οὐαί, οὐαί, ἡ πόλις ἡ μεγάλη",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Βαβυλών, ἡ πόλις ἡ ἰσχυρά,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ὅτι ἐν μιᾷ ὥρᾳ ἦλθεν ἡ κρίσις σου.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Καὶ οἱ ἔμποροι τῆς γῆς κλαίουσι καὶ πενθοῦσιν ἐπ᾿ αὐτῇ, ὅτι τὸν γόμον αὐτῶν οὐδεὶς ἀγοράζει οὐκέτι·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "γόμον χρυσοῦ, καὶ ἀργύρου, καὶ λίθου τιμίου, καὶ μαργαρίτου, καὶ βύσσου, καὶ πορφύρας, καὶ σηρικοῦ, καὶ κοκκίνου· καὶ πᾶν ξύλον θύϊνον, καὶ πᾶν σκεῦος ἐλεφάντινον, καὶ πᾶν σκεῦος ἐκ ξύλου τιμιωτάτου, καὶ χαλκοῦ, καὶ σιδήρου, καὶ μαρμάρου·"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ κινάμωμον, καὶ θυμιάματα, καὶ μύρον, καὶ λίβανον, καὶ οἶνον, καὶ ἔλαιον, καὶ σεμίδαλιν, καὶ σῖτον, καὶ κτήνη, καὶ πρόβατα· καὶ ἵππων, καὶ ῥεδῶν, καὶ σωμάτων, καὶ ψυχὰς ἀνθρώπων."
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Καὶ ἡ ὀπώρα τῆς ἐπιθυμίας τῆς ψυχῆς σου",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἀπῆλθεν ἀπὸ σοῦ,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ πάντα τὰ λιπαρὰ καὶ τὰ λαμπρὰ",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἀπῆλθεν ἀπὸ σοῦ,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ οὐκέτι οὐ μὴ εὑρήσῃς αὐτά.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Οἱ ἔμποροι τούτων, οἱ πλουτήσαντες ἀπ᾿ αὐτῆς, ἀπὸ μακρόθεν στήσονται διὰ τὸν φόβον τοῦ βασανισμοῦ αὐτῆς, κλαίοντες καὶ πενθοῦντες,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ λέγοντες,",
          {
            "lineBreak": true
          },
          {
            "text": "Οὐαί, οὐαί, ἡ πόλις ἡ μεγάλη,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἡ περιβεβλημένη βύσσινον",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ πορφυροῦν καὶ κόκκινον,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ",
            "poem": 1
          },
          {
            "noteId": 40
          },
          {
            "text": "κεχρυσωμένη ἐν χρυσῷ",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ λίθῳ τιμίῳ καὶ μαργαρίταις·",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "ὅτι μιᾷ ὥρᾳ ἠρημώθη ὁ τοσοῦτος πλοῦτος.",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          "Καὶ πᾶς κυβερνήτης, καὶ πᾶς ἐπὶ τῶν πλοίων ὁ ὅμιλος, καὶ ναῦται, καὶ ὅσοι τὴν θάλασσαν ἐργάζονται, ἀπὸ μακρόθεν ἔστησαν,"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ ἔκραζον, ὁρῶντες τὸν καπνὸν τῆς πυρώσεως αὐτῆς, λέγοντες,",
          {
            "lineBreak": true
          },
          {
            "text": "Τίς ὁμοία τῇ πόλει τῇ μεγάλῃ;",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Καὶ ἔβαλον χοῦν ἐπὶ τὰς κεφαλὰς αὐτῶν, καὶ ἔκραζον κλαίοντες καὶ πενθοῦντες, λέγοντες,",
          {
            "lineBreak": true
          },
          {
            "text": "Οὐαί, οὐαί, ἡ πόλις ἡ μεγάλη,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἐν ᾗ ἐπλούτησαν πάντες οἱ ἔχοντες πλοῖα ἐν τῇ θαλάσσῃ",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἐκ τῆς τιμιότητος αὐτῆς,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ὅτι μιᾷ ὥρᾳ ἠρημώθη.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Εὐφραίνου ἐπ᾿ αὐτήν, οὐρανέ,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ οἱ ἅγιοι ἀπόστολοι, καὶ οἱ προφῆται,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ὅτι ἔκρινεν ὁ Θεὸς τὸ κρίμα ὑμῶν ἐξ αὐτῆς.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Καὶ ἦρεν εἷς ἄγγελος ἰσχυρὸς λίθον ὡς μύλον μέγαν, καὶ ἔβαλεν εἰς τὴν θάλασσαν, λέγων,",
          {
            "lineBreak": true
          },
          {
            "text": "Οὕτως ὁρμήματι βληθήσεται",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Βαβυλὼν ἡ μεγάλη πόλις,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ οὐ μὴ εὑρεθῇ ἔτι.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Καὶ φωνὴ κιθαρῳδῶν καὶ μουσικῶν καὶ αὐλητῶν καὶ σαλπιστῶν",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "οὐ μὴ ἀκουσθῇ ἐν σοὶ ἔτι,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ πᾶς τεχνίτης πάσης τέχνης",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "οὐ μὴ εὑρεθῇ ἐν σοὶ ἔτι,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ φωνὴ μύλου",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "οὐ μὴ ἀκουσθῇ ἐν σοὶ ἔτι,",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "καὶ φῶς λύχνου",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "οὐ μὴ φανῇ ἐν σοὶ ἔτι,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ φωνὴ νυμφίου καὶ νύμφης",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "οὐ μὴ ἀκουσθῇ ἐν σοὶ ἔτι·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ὅτι οἱ ἔμποροί σου ἦσαν οἱ μεγιστᾶνες τῆς γῆς·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ὅτι ἐν τῇ φαρμακείᾳ σου ἐπλανήθησαν πάντα τὰ ἔθνη.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Καὶ ἐν αὐτῇ αἷμα προφητῶν καὶ ἁγίων εὑρέθη,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ πάντων τῶν ἐσφαγμένων ἐπὶ τῆς γῆς.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
