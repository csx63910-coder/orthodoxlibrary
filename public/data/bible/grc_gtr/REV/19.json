  },
  "chapter": {
    "number": 19,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ μετὰ ταῦτα ἤκουσα",
          {
            "noteId": 41
          },
          "φωνὴν ὄχλου πολλοῦ μεγάλην ἐν τῷ οὐρανῷ, λέγοντος,",
          {
            "lineBreak": true
          },
          {
            "text": "Ἁλληλούϊα·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἡ σωτηρία καὶ ἡ δόξα καὶ ἡ τιμὴ καὶ ἡ δύναμις Κυρίῳ τῷ Θεῷ ἡμῶν·",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "ὅτι ἀληθιναὶ καὶ δίκαιαι αἱ κρίσεις αὐτοῦ·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ὅτι ἔκρινε τὴν πόρνην τὴν μεγάλην,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἥτις ἔφθειρε τὴν γῆν ἐν τῇ πορνείᾳ αὐτῆς,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ἐξεδίκησε τὸ αἷμα τῶν δούλων αὐτοῦ ἐκ τῆς χειρὸς αὐτῆς.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Καὶ δεύτερον εἴρηκαν,",
          {
            "lineBreak": true
          },
          {
            "text": "Ἁλληλούϊα·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ὁ καπνὸς αὐτῆς ἀναβαίνει εἰς τοὺς αἰῶνας τῶν αἰώνων.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Καὶ",
          {
            "noteId": 42
          },
          "ἔπεσαν οἱ πρεσβύτεροι οἱ εἴκοσι καὶ τέσσαρες, καὶ τὰ τέσσαρα ζῷα, καὶ προσεκύνησαν τῷ Θεῷ τῷ καθημένῳ ἐπὶ τοῦ θρόνου, λέγοντες, Ἀμήν· Ἁλληλούϊα."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Καὶ φωνὴ ἐκ τοῦ θρόνου ἐξῆλθε, λέγουσα,",
          {
            "lineBreak": true
          },
          {
            "text": "Αἰνεῖτε τὸν Θεὸν ἡμῶν",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "πάντες οἱ δοῦλοι αὐτοῦ,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ οἱ φοβούμενοι αὐτόν,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ οἱ μικροὶ καὶ οἱ μεγάλοι.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Καὶ ἤκουσα ὡς φωνὴν ὄχλου πολλοῦ, καὶ ὡς φωνὴν ὑδάτων πολλῶν, καὶ ὡς φωνὴν βροντῶν ἰσχυρῶν,",
          {
            "noteId": 43
          },
          "λέγοντας,",
          {
            "lineBreak": true
          },
          {
            "text": "Ἁλληλούϊα·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ὅτι ἐβασίλευσε Κύριος",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ὁ Θεὸς ὁ παντοκράτωρ.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Χαίρωμεν καὶ ἀγαλλιώμεθα,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ δῶμεν τὴν δόξαν αὐτῷ·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ὅτι ἦλθεν ὁ γάμος τοῦ ἀρνίου,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ἡ γυνὴ αὐτοῦ ἡτοίμασεν ἑαυτήν.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Καὶ ἐδόθη αὐτῇ ἵνα περιβάληται",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "βύσσινον καθαρὸν καὶ λαμπρόν·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          "τὸ γὰρ βύσσινον τὰ δικαιώματά ἐστι τῶν ἁγίων."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Καὶ λέγει μοι, Γράψον, Μακάριοι οἱ εἰς τὸ δεῖπνον τοῦ γάμου τοῦ ἀρνίου κεκλημένοι. Καὶ λέγει μοι, Οὗτοι οἱ λόγοι ἀληθινοί εἰσι τοῦ Θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Καὶ ἔπεσον ἔμπροσθεν τῶν ποδῶν αὐτοῦ προσκυνῆσαι αὐτῷ· καὶ λέγει μοι, Ὅρα μή· σύνδουλός σου εἰμὶ καὶ τῶν ἀδελφῶν σου τῶν ἐχόντων τὴν μαρτυρίαν τοῦ Ἰησοῦ· τῷ Θεῷ προσκύνησον· ἡ γὰρ μαρτυρία τοῦ Ἰησοῦ ἐστὶ τὸ πνεῦμα τῆς προφητείας."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Καὶ εἶδον τὸν οὐρανὸν ἀνεῳγμένον, καὶ ἰδού, ἵππος λευκός, καὶ ὁ καθήμενος ἐπ᾿ αὐτόν, καλούμενος πιστὸς καὶ ἀληθινός, καὶ ἐν δικαιοσύνῃ κρίνει καὶ πολεμεῖ."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Οἱ δὲ ὀφθαλμοὶ αὐτοῦ ὡς φλὸξ πυρός, καὶ ἐπὶ τὴν κεφαλὴν αὐτοῦ διαδήματα πολλά· ἔχων ὄνομα γεγραμμένον ὃ οὐδεὶς οἶδεν εἰ μὴ αὐτός,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ περιβεβλημένος ἱμάτιον βεβαμμένον αἵματι· καὶ καλεῖται τὸ ὄνομα αὐτοῦ, Ὁ λόγος τοῦ Θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Καὶ τὰ στρατεύματα",
          {
            "noteId": 44
          },
          "τὰ ἐν τῷ οὐρανῷ ἠκολούθει αὐτῷ ἐφ᾿ ἵπποις λευκοῖς, ἐνδεδυμένοι βύσσινον λευκὸν καὶ καθαρόν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Καὶ ἐκ τοῦ στόματος αὐτοῦ ἐκπορεύεται ῥομφαία ὀξεῖα, ἵνα ἐν αὐτῇ πατάσσῃ τὰ ἔθνη· καὶ αὐτὸς ποιμανεῖ αὐτοὺς ἐν ῥάβδῳ σιδηρᾷ· καὶ αὐτὸς πατεῖ τὴν ληνὸν τοῦ οἴνου τοῦ θυμοῦ καὶ τῆς ὀργῆς τοῦ Θεοῦ τοῦ παντοκράτορος."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Καὶ ἔχει ἐπὶ τὸ ἱμάτιον καὶ ἐπὶ τὸν μηρὸν αὐτοῦ",
          {
            "noteId": 45
          },
          "τὸ ὄνομα γεγραμμένον, Βασιλεὺς βασιλέων καὶ Κύριος κυρίων."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Καὶ εἶδον ἕνα ἄγγελον ἑστῶτα ἐν τῷ ἡλίῳ· καὶ ἔκραξε φωνῇ μεγάλῃ, λέγων πᾶσι τοῖς ὀρνέοις τοῖς πετωμένοις ἐν μεσουρανήματι, Δεῦτε καὶ συνάγεσθε εἰς τὸ δεῖπνον τοῦ μεγάλου Θεοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ἵνα φάγητε σάρκας βασιλέων, καὶ σάρκας χιλιάρχων, καὶ σάρκας ἰσχυρῶν, καὶ σάρκας ἵππων καὶ τῶν καθημένων ἐπ᾿ αὐτῶν, καὶ σάρκας πάντων, ἐλευθέρων",
          {
            "noteId": 46
          },
          "καὶ δούλων, καὶ μικρῶν καὶ μεγάλων."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Καὶ εἶδον τὸ θηρίον, καὶ τοὺς βασιλεῖς τῆς γῆς, καὶ τὰ στρατεύματα αὐτῶν συνηγμένα ποιῆσαι πόλεμον μετὰ τοῦ καθημένου ἐπὶ τοῦ ἵππου, καὶ μετὰ τοῦ στρατεύματος αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Καὶ ἐπιάσθη τὸ θηρίον, καὶ μετὰ τούτου ὁ ψευδοπροφήτης ὁ ποιήσας τὰ σημεῖα ἐνώπιον αὐτοῦ, ἐν οἷς ἐπλάνησε τοὺς λαβόντας τὸ χάραγμα τοῦ θηρίου, καὶ τοὺς προσκυνοῦντας τῇ εἰκόνι αὐτοῦ· ζῶντες ἐβλήθησαν οἱ δύο εἰς τὴν λίμνην τοῦ πυρὸς τὴν καιομένην ἐν τῷ θείῳ·"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "καὶ οἱ λοιποὶ ἀπεκτάνθησαν ἐν τῇ ῥομφαίᾳ τοῦ καθημένου ἐπὶ τοῦ ἵππου, τῇ ἐκπορευομένῃ ἐκ τοῦ στόματος αὐτοῦ· καὶ πάντα τὰ ὄρνεα ἐχορτάσθησαν ἐκ τῶν σαρκῶν αὐτῶν."
        ]
      }
    ],
