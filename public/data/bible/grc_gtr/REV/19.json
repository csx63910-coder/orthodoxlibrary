    "order": 66,
    "numberOfChapters": 22,
    "sha256": "683d484dd1c8ebeac68c0e6870723135c95ec65c765bd11990abf822ef7cae7a",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_gtr/REV/1.json",
