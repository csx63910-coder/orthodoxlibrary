  "chapter": {
    "number": 7,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ μετὰ ταῦτα εἶδον τέσσαρας ἀγγέλους ἑστῶτας ἐπὶ τὰς τέσσαρας γωνίας τῆς γῆς, κρατοῦντας τοὺς τέσσαρας ἀνέμους τῆς γῆς, ἵνα μὴ πνέῃ ἄνεμος ἐπὶ τῆς γῆς, μήτε ἐπὶ τῆς θαλάσσης, μήτε ἐπὶ πᾶν δένδρον."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Καὶ εἶδον ἄλλον ἄγγελον",
          {
            "noteId": 10
          },
          "ἀναβάντα ἀπὸ ἀνατολῆς ἡλίου, ἔχοντα σφραγῖδα Θεοῦ ζῶντος· καὶ ἔκραξε φωνῇ μεγάλῃ τοῖς τέσσαρσιν ἀγγέλοις, οἷς ἐδόθη αὐτοῖς ἀδικῆσαι τὴν γῆν καὶ τὴν θάλασσαν,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "λέγων, Μὴ ἀδικήσητε τὴν γῆν, μήτε τὴν θάλασσαν, μήτε τὰ δένδρα, ἄχρις οὗ",
          {
            "noteId": 11
          },
          "σφραγίσωμεν τοὺς δούλους τοῦ Θεοῦ ἡμῶν ἐπὶ τῶν μετώπων αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Καὶ ἤκουσα τὸν ἀριθμὸν τῶν ἐσφραγισμένων, ρμδ΄ χιλιάδες, ἐσφραγισμένοι ἐκ πάσης φυλῆς υἱῶν Ἰσραήλ."
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ἐκ φυλῆς Ἰούδα, ιβ΄ χιλιάδες ἐσφραγισμένοι·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἐκ φυλῆς Ῥουβήν, ιβ΄ χιλιάδες ἐσφραγισμένοι·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἐκ φυλῆς Γάδ, ιβ΄ χιλιάδες ἐσφραγισμένοι·",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "ἐκ φυλῆς Ἀσήρ, ιβ΄ χιλιάδες ἐσφραγισμένοι·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἐκ φυλῆς Νεφθαλείμ, ιβ΄ χιλιάδες ἐσφραγισμένοι·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἐκ φυλῆς Μανασσῆ, ιβ΄ χιλιάδες ἐσφραγισμένοι·",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "ἐκ φυλῆς Συμεών, ιβ΄ χιλιάδες ἐσφραγισμένοι·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἐκ φυλῆς Λευΐ, ιβ΄ χιλιάδες ἐσφραγισμένοι·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἐκ φυλῆς",
            "poem": 1
          },
          {
            "noteId": 12
          },
          {
            "text": "Ἰσαχάρ, ιβ΄ χιλιάδες ἐσφραγισμένοι·",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "ἐκ φυλῆς Ζαβουλών, ιβ΄ χιλιάδες ἐσφραγισμένοι·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἐκ φυλῆς Ἰωσήφ, ιβ΄ χιλιάδες ἐσφραγισμένοι·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἐκ φυλῆς Βενιαμίν, ιβ΄ χιλιάδες ἐσφραγισμένοι.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Μετὰ ταῦτα εἶδον, καὶ ἰδού, ὄχλος πολύς, ὃν ἀριθμῆσαι αὐτὸν οὐδεὶς ἠδύνατο, ἐκ παντὸς ἔθνους καὶ φυλῶν καὶ λαῶν καὶ γλωσσῶν, ἑστῶτες ἐνώπιον τοῦ θρόνου καὶ ἐνώπιον τοῦ ἀρνίου, περιβεβλημένοι στολὰς λευκάς, καὶ φοίνικες ἐν ταῖς χερσὶν αὐτῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ κράζοντες φωνῇ μεγάλῃ, λέγοντες, Ἡ σωτηρία",
          {
            "noteId": 13
          },
          "τῷ Θεῷ ἡμῶν τῷ καθημένῳ ἐπὶ τοῦ",
          {
            "noteId": 14
          },
          "θρόνου, καὶ τῷ ἀρνίῳ."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Καὶ πάντες οἱ ἄγγελοι ἑστήκεσαν κύκλῳ τοῦ θρόνου καὶ τῶν πρεσβυτέρων καὶ τῶν τεσσάρων ζῴων, καὶ ἔπεσον ἐνώπιον τοῦ θρόνου ἐπὶ πρόσωπον αὐτῶν, καὶ προσεκύνησαν τῷ Θεῷ,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "λέγοντες,",
          {
            "lineBreak": true
          },
          {
            "text": "Ἀμήν· ἡ εὐλογία καὶ ἡ δόξα καὶ ἡ σοφία",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ἡ εὐχαριστία καὶ ἡ τιμὴ",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ἡ δύναμις καὶ ἡ ἰσχὺς",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "τῷ Θεῷ ἡμῶν εἰς τοὺς αἰῶνας τῶν αἰώνων. Ἀμήν.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Καὶ ἀπεκρίθη εἷς ἐκ τῶν πρεσβυτέρων, λέγων μοι, Οὗτοι οἱ περιβεβλημένοι τὰς στολὰς τὰς λευκάς, τίνες εἰσί, καὶ πόθεν ἦλθον;"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Καὶ εἴρηκα αὐτῷ, Κύριε, σὺ οἶδας. Καὶ εἶπέ μοι, Οὗτοί εἰσιν οἱ ἐρχόμενοι ἐκ τῆς θλίψεως τῆς μεγάλης, καὶ ἔπλυναν τὰς στολὰς αὐτῶν, καὶ ἐλεύκαναν",
          {
            "noteId": 15
          },
          "στολὰς αὐτῶν ἐν τῷ αἵματι τοῦ ἀρνίου."
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Διὰ τοῦτό εἰσιν ἐνώπιον τοῦ θρόνου τοῦ Θεοῦ,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ λατρεύουσιν αὐτῷ ἡμέρας καὶ νυκτὸς ἐν τῷ ναῷ αὐτοῦ·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ὁ καθήμενος ἐπὶ τοῦ θρόνου σκηνώσει ἐπ᾿ αὐτούς.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Οὐ πεινάσουσιν ἔτι, οὐδὲ διψήσουσιν ἔτι,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "οὐδὲ μὴ πέσῃ ἐπ᾿ αὐτοὺς ὁ ἥλιος,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "οὐδὲ πᾶν καῦμα·",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "ὅτι τὸ ἀρνίον τὸ ἀνὰ μέσον τοῦ θρόνου ποιμανεῖ αὐτούς,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ὁδηγήσει αὐτοὺς ἐπὶ ζώσας πηγὰς ὑδάτων,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ἐξαλείψει ὁ Θεὸς πᾶν δάκρυον ἀπὸ τῶν ὀφθαλμῶν αὐτῶν.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
