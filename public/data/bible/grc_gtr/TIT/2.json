  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Σὺ δὲ λάλει ἃ πρέπει τῇ ὑγιαινούσῃ διδασκαλίᾳ·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "πρεσβύτας νηφαλίους εἶναι, σεμνούς, σώφρονας, ὑγιαίνοντας τῇ πίστει, τῇ ἀγάπῃ, τῇ ὑπομονῇ·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "πρεσβύτιδας ὡσαύτως ἐν καταστήματι ἱεροπρεπεῖς, μὴ διαβόλους, μὴ οἴνῳ πολλῷ δεδουλωμένας, καλοδιδασκάλους,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἵνα σωφρονίζωσι τὰς νέας φιλάνδρους εἶναι, φιλοτέκνους,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "σώφρονας, ἁγνάς, οἰκουρούς, ἀγαθάς, ὑποτασσομένας τοῖς ἰδίοις ἀνδράσιν, ἵνα μὴ ὁ λόγος τοῦ Θεοῦ βλασφημῆται·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "τοὺς νεωτέρους ὡσαύτως παρακάλει σωφρονεῖν·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "περὶ πάντα σεαυτὸν παρεχόμενος τύπον καλῶν ἔργων, ἐν τῇ διδασκαλίᾳ ἀδιαφθορίαν, σεμνότητα,",
          {
            "noteId": 0
          },
          "ἀφθαρσίαν,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "λόγον ὑγιῆ, ἀκατάγνωστον, ἵνα ὁ ἐξ ἐναντίας ἐντραπῇ, μηδὲν ἔχων περὶ ὑμῶν λέγειν φαῦλον."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Δούλους ἰδίοις δεσπόταις ὑποτάσσεσθαι, ἐν πᾶσιν εὐαρέστους εἶναι, μὴ ἀντιλέγοντας,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "μὴ νοσφιζομένους, ἀλλὰ πίστιν πᾶσαν ἐνδεικνυμένους ἀγαθήν, ἵνα τὴν διδασκαλίαν τοῦ σωτῆρος",
          {
            "noteId": 1
          },
          "ἡμῶν Θεοῦ κοσμῶσιν ἐν πᾶσιν."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ἐπεφάνη γὰρ ἡ χάρις τοῦ Θεοῦ ἡ σωτήριος πᾶσιν ἀνθρώποις,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "παιδεύουσα ἡμᾶς ἵνα, ἀρνησάμενοι τὴν ἀσέβειαν καὶ τὰς κοσμικὰς ἐπιθυμίας, σωφρόνως καὶ δικαίως καὶ εὐσεβῶς ζήσωμεν ἐν τῷ νῦν αἰῶνι,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "προσδεχόμενοι τὴν μακαρίαν ἐλπίδα καὶ ἐπιφάνειαν τῆς δόξης τοῦ μεγάλου Θεοῦ καὶ σωτῆρος ἡμῶν Ἰησοῦ Χριστοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ὃς ἔδωκεν ἑαυτὸν ὑπὲρ ἡμῶν, ἵνα λυτρώσηται ἡμᾶς ἀπὸ πάσης ἀνομίας, καὶ καθαρίσῃ ἑαυτῷ λαὸν περιούσιον, ζηλωτὴν καλῶν ἔργων."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Ταῦτα λάλει, καὶ παρακάλει, καὶ ἔλεγχε μετὰ πάσης ἐπιταγῆς. Μηδείς σου περιφρονείτω."
        ]
      }
    ],
