    "order": 56,
    "numberOfChapters": 3,
    "sha256": "655946483464b398169d5092414ca6dcccdece212758ec610e98b87888f6dd96",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_gtr/TIT/1.json",
