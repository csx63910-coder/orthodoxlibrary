  "chapter": {
    "number": 6,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Συνεργοῦντες δὲ καὶ παρακαλοῦμεν μὴ εἰς κενὸν τὴν χάριν τοῦ Θεοῦ δέξασθαι ὑμᾶς —"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "λέγει γάρ,",
          {
            "lineBreak": true
          },
          {
            "text": "Καιρῷ δεκτῷ ἐπήκουσά σου,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ἐν ἡμέρᾳ σωτηρίας ἐβοήθησά σοι·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          "ἰδού, νῦν καιρὸς εὐπρόσδεκτος, ἰδού, νῦν ἡμέρα σωτηρίας —"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "μηδεμίαν ἐν μηδενὶ διδόντες προσκοπήν, ἵνα μὴ μωμηθῇ ἡ διακονία·"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἀλλ᾿ ἐν παντὶ συνιστῶντες ἑαυτοὺς ὡς Θεοῦ διάκονοι, ἐν ὑπομονῇ πολλῇ, ἐν θλίψεσιν, ἐν ἀνάγκαις, ἐν στενοχωρίαις,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἐν πληγαῖς, ἐν φυλακαῖς, ἐν ἀκαταστασίαις, ἐν κόποις, ἐν ἀγρυπνίαις, ἐν νηστείαις,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἐν ἁγνότητι, ἐν γνώσει, ἐν μακροθυμίᾳ, ἐν χρηστότητι, ἐν πνεύματι ἁγίῳ, ἐν ἀγάπῃ ἀνυποκρίτῳ,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἐν λόγῳ ἀληθείας, ἐν δυνάμει Θεοῦ, διὰ τῶν ὅπλων τῆς δικαιοσύνης τῶν δεξιῶν καὶ ἀριστερῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "διὰ δόξης καὶ ἀτιμίας, διὰ δυσφημίας καὶ εὐφημίας· ὡς πλάνοι καὶ ἀληθεῖς·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ὡς ἀγνοούμενοι, καὶ ἐπιγινωσκόμενοι· ὡς ἀποθνῄσκοντες, καὶ ἰδού, ζῶμεν· ὡς παιδευόμενοι, καὶ μὴ θανατούμενοι·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ὡς λυπούμενοι, ἀεὶ δὲ χαίροντες· ὡς πτωχοί, πολλοὺς δὲ πλουτίζοντες· ὡς μηδὲν ἔχοντες, καὶ πάντα κατέχοντες."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Τὸ στόμα ἡμῶν ἀνέῳγε πρὸς ὑμᾶς, Κορίνθιοι, ἡ καρδία ἡμῶν πεπλάτυνται."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Οὐ στενοχωρεῖσθε ἐν ἡμῖν, στενοχωρεῖσθε δὲ ἐν τοῖς σπλάγχνοις ὑμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Τὴν δὲ αὐτὴν ἀντιμισθίαν — ὡς τέκνοις λέγω — πλατύνθητε καὶ ὑμεῖς."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Μὴ γίνεσθε ἑτεροζυγοῦντες ἀπίστοις· τίς γὰρ μετοχὴ δικαιοσύνῃ καὶ ἀνομίᾳ; Τίς δὲ κοινωνία φωτὶ πρὸς σκότος;"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Τίς δὲ συμφώνησις Χριστῷ πρὸς",
          {
            "noteId": 5
          },
          "Βελίαλ; Ἢ τίς μερὶς πιστῷ μετὰ ἀπίστου;"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Τίς δὲ συγκατάθεσις ναῷ Θεοῦ μετὰ εἰδώλων; Ὑμεῖς γὰρ ναὸς Θεοῦ ἐστε ζῶντος, καθὼς εἶπεν ὁ Θεὸς ὅτι",
          {
            "lineBreak": true
          },
          {
            "text": "Ἐνοικήσω ἐν αὐτοῖς, καὶ ἐμπεριπατήσω·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ἔσομαι αὐτῶν Θεός,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ αὐτοὶ ἔσονταί μοι λαός.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Διό, Ἐξέλθετε ἐκ μέσου αὐτῶν",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ἀφορίσθητε, λέγει Κύριος,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ἀκαθάρτου μὴ ἅπτεσθε·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "κἀγὼ εἰσδέξομαι ὑμᾶς,",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "καὶ ἔσομαι ὑμῖν εἰς πατέρα,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ὑμεῖς ἔσεσθέ μοι εἰς υἱοὺς καὶ θυγατέρας,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "λέγει Κύριος παντοκράτωρ.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
