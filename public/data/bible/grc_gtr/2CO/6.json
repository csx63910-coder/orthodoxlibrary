    "order": 47,
    "numberOfChapters": 13,
    "sha256": "fa22fe316dcedf68d105b9c425b4b9e0752847e2598d648f2c11481cedeba9d6",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_gtr/2CO/1.json",
