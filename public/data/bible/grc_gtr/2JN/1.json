    "sha256": "fcd0c7e30c9bfc5f27a5fd468c99ceea020c5922dca969c8322850d8b94b911a",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_gtr/2JN/1.json",
