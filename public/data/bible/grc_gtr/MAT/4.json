    "commonName": "ΚΑΤΑ ΜΑΤΘΑΙΟΝ",
    "title": "ΕΥΑΓΓΕΛΙΟΝ ΤΟ ΚΑΤΑ ΜΑΤΘΑΙΟΝ",
    "order": 40,
    "numberOfChapters": 28,
    "sha256": "eed8e2cbc09faa0498d40ef4b2125594dfa3a793287c74f21255803d32c56c7d",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_gtr/MAT/1.json",
    "lastChapterNumber": 28,
    "lastChapterApiLink": "/api/grc_gtr/MAT/28.json",
    "totalNumberOfVerses": 1071
  },
  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Τότε ὁ Ἰησοῦς ἀνήχθη εἰς τὴν ἔρημον ὑπὸ τοῦ πνεύματος, πειρασθῆναι ὑπὸ τοῦ διαβόλου."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Καὶ νηστεύσας ἡμέρας τεσσαράκοντα καὶ νύκτας τεσσαράκοντα, ὕστερον ἐπείνασε."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Καὶ προσελθὼν αὐτῷ ὁ πειράζων εἶπεν, Εἰ υἱὸς εἶ τοῦ Θεοῦ, εἰπὲ ἵνα οἱ λίθοι οὗτοι ἄρτοι γένωνται."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Ὁ δὲ ἀποκριθεὶς εἶπε, Γέγραπται,",
          {
            "lineBreak": true
          },
          {
            "text": "Οὐκ ἐπ᾿ ἄρτῳ μόνῳ ζήσεται ἄνθρωπος,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἀλλ᾿ ἐπὶ παντὶ ῥήματι ἐκπορευομένῳ διὰ στόματος Θεοῦ.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Τότε παραλαμβάνει αὐτὸν ὁ διάβολος εἰς τὴν ἁγίαν πόλιν, καὶ ἵστησιν αὐτὸν ἐπὶ τὸ πτερύγιον τοῦ ἱεροῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ λέγει αὐτῷ, Εἰ υἱὸς εἶ τοῦ Θεοῦ, βάλε σεαυτὸν κάτω· γέγραπται γὰρ ὅτι",
          {
            "lineBreak": true
          },
          {
            "text": "Τοῖς ἀγγέλοις αὐτοῦ ἐντελεῖται περὶ σοῦ·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          "καί,",
          {
            "lineBreak": true
          },
          {
            "text": "Ἐπὶ χειρῶν ἀροῦσί σε,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "μήποτε προσκόψῃς πρὸς λίθον τὸν πόδα σοῦ.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ἔφη αὐτῷ ὁ Ἰησοῦς, Πάλιν γέγραπται, Οὐκ ἐκπειράσεις Κύριον τὸν Θεόν σου."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Πάλιν παραλαμβάνει αὐτὸν ὁ διάβολος εἰς ὄρος ὑψηλὸν λίαν, καὶ δείκνυσιν αὐτῷ πάσας τὰς βασιλείας τοῦ κόσμου καὶ τὴν δόξαν αὐτῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ λέγει αὐτῷ, Ταῦτα πάντα σοι δώσω, ἐὰν πεσὼν προσκυνήσῃς μοι."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Τότε λέγει αὐτῷ ὁ Ἰησοῦς, Ὕπαγε, Σατανᾶ· γέγραπται γάρ,",
          {
            "lineBreak": true
          },
          {
            "text": "Κύριον τὸν Θεόν σου προσκυνήσεις,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ αὐτῷ μόνῳ λατρεύσεις.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Τότε ἀφίησιν αὐτὸν ὁ διάβολος· καὶ ἰδού, ἄγγελοι προσῆλθον καὶ διηκόνουν αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ἀκούσας δὲ ὁ Ἰησοῦς ὅτι Ἰωάννης παρεδόθη, ἀνεχώρησεν εἰς τὴν Γαλιλαίαν·"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ καταλιπὼν τὴν",
          {
            "noteId": 2
          },
          "Ναζαρέτ, ἐλθὼν κατῴκησεν εἰς Καπερναοὺμ τὴν παραθαλασσίαν, ἐν ὁρίοις Ζαβουλὼν καὶ Νεφθαλείμ·"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἵνα πληρωθῇ τὸ ῥηθὲν διὰ Ἠσαΐου τοῦ προφήτου, λέγοντος,"
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Γῆ Ζαβουλὼν καὶ γῆ Νεφθαλείμ,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ὁδὸν θαλάσσης, πέραν τοῦ Ἰορδάνου, Γαλιλαία τῶν ἐθνῶν,",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "ὁ λαὸς ὁ καθήμενος ἐν σκότει",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "εἶδε φῶς μέγα,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ τοῖς καθημένοις ἐν χώρᾳ καὶ σκιᾷ θανάτου,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "φῶς ἀνέτειλεν αὐτοῖς.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Ἀπὸ τότε ἤρξατο ὁ Ἰησοῦς κηρύσσειν καὶ λέγειν, Μετανοεῖτε· ἤγγικε γὰρ ἡ βασιλεία τῶν οὐρανῶν."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Περιπατῶν δὲ ὁ Ἰησοῦς παρὰ τὴν θάλασσαν τῆς Γαλιλαίας εἶδε δύο ἀδελφούς, Σίμωνα τὸν λεγόμενον Πέτρον, καὶ Ἀνδρέαν τὸν ἀδελφὸν αὐτοῦ, βάλλοντας ἀμφίβληστρον εἰς τὴν θάλασσαν· ἦσαν γὰρ ἁλιεῖς."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Καὶ λέγει αὐτοῖς, Δεῦτε ὀπίσω μου, καὶ ποιήσω ὑμᾶς ἁλιεῖς ἀνθρώπων."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Οἱ δὲ εὐθέως ἀφέντες τὰ δίκτυα ἠκολούθησαν αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Καὶ προβὰς ἐκεῖθεν, εἶδεν ἄλλους δύο ἀδελφούς, Ἰάκωβον τὸν τοῦ Ζεβεδαίου καὶ Ἰωάννην τὸν ἀδελφὸν αὐτοῦ, ἐν τῷ πλοίῳ μετὰ Ζεβεδαίου τοῦ πατρὸς αὐτῶν, καταρτίζοντας τὰ δίκτυα αὐτῶν· καὶ ἐκάλεσεν αὐτούς."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Οἱ δὲ εὐθέως ἀφέντες τὸ πλοῖον καὶ τὸν πατέρα αὐτῶν ἠκολούθησαν αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Καὶ περιῆγεν ὅλην τὴν Γαλιλαίαν ὁ Ἰησοῦς, διδάσκων ἐν ταῖς συναγωγαῖς αὐτῶν, καὶ κηρύσσων τὸ εὐαγγέλιον τῆς βασιλείας, καὶ θεραπεύων πᾶσαν νόσον καὶ πᾶσαν μαλακίαν ἐν τῷ λαῷ."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Καὶ ἀπῆλθεν ἡ ἀκοὴ αὐτοῦ εἰς ὅλην τὴν Συρίαν· καὶ προσήνεγκαν αὐτῷ πάντας τοὺς κακῶς ἔχοντας, ποικίλαις νόσοις καὶ βασάνοις συνεχομένους, καὶ δαιμονιζομένους, καὶ σεληνιαζομένους, καὶ παραλυτικούς· καὶ ἐθεράπευσεν αὐτούς."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Καὶ ἠκολούθησαν αὐτῷ ὄχλοι πολλοὶ ἀπὸ τῆς Γαλιλαίας καὶ Δεκαπόλεως καὶ Ἱεροσολύμων καὶ Ἰουδαίας καὶ πέραν τοῦ Ἰορδάνου."
        ]
      }
    ],
