  },
  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ὅθεν, ἀδελφοὶ ἅγιοι, κλήσεως ἐπουρανίου μέτοχοι, κατανοήσατε τὸν ἀπόστολον καὶ ἀρχιερέα τῆς ὁμολογίας ἡμῶν Χριστὸν Ἰησοῦν,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "πιστὸν ὄντα τῷ ποιήσαντι αὐτόν, ὡς καὶ Μωσῆς ἐν ὅλῳ τῷ οἴκῳ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Πλείονος γὰρ δόξης οὗτος παρὰ Μωσῆν ἠξίωται, καθ᾿ ὅσον πλείονα τιμὴν ἔχει τοῦ οἴκου ὁ κατασκευάσας αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Πᾶς γὰρ οἶκος κατασκευάζεται ὑπό τινος· ὁ δὲ τὰ πάντα κατασκευάσας Θεός."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Καὶ Μωσῆς μὲν πιστὸς ἐν ὅλῳ τῷ οἴκῳ αὐτοῦ ὡς θεράπων, εἰς μαρτύριον τῶν λαληθησομένων·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Χριστὸς δὲ ὡς υἱὸς ἐπὶ τὸν οἶκον αὐτοῦ· οὗ οἶκός ἐσμεν ἡμεῖς, ἐάνπερ τὴν παρρησίαν καὶ τὸ καύχημα τῆς ἐλπίδος μέχρι τέλους βεβαίαν κατάσχωμεν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Διό, καθὼς λέγει τὸ πνεῦμα τὸ ἅγιον,",
          {
            "lineBreak": true
          },
          {
            "text": "Σήμερον ἐὰν τῆς φωνῆς αὐτοῦ ἀκούσητε,",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "μὴ σκληρύνητε τὰς καρδίας ὑμῶν, ὡς ἐν τῷ παραπικρασμῷ,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "κατὰ τὴν ἡμέραν τοῦ πειρασμοῦ ἐν τῇ ἐρήμῳ,",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "οὗ ἐπείρασάν με οἱ πατέρες ὑμῶν, ἐδοκίμασάν με,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ εἶδον τὰ ἔργα μου τεσσαράκοντα ἔτη.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Διὸ προσώχθισα τῇ γενεᾷ ἐκείνῃ,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ εἶπον, Ἀεὶ πλανῶνται τῇ καρδίᾳ·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "αὐτοὶ δὲ οὐκ ἔγνωσαν τὰς ὁδούς μου·",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "ὡς ὤμοσα ἐν τῇ ὀργῇ μου,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Εἰ εἰσελεύσονται εἰς τὴν κατάπαυσίν μου.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Βλέπετε, ἀδελφοί, μήποτε ἔσται ἔν τινι ὑμῶν καρδία πονηρὰ ἀπιστίας ἐν τῷ ἀποστῆναι ἀπὸ Θεοῦ ζῶντος·"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ἀλλὰ παρακαλεῖτε ἑαυτοὺς καθ᾿ ἑκάστην ἡμέραν, ἄχρις οὗ τὸ σήμερον καλεῖται, ἵνα μὴ σκληρυνθῇ τις ἐξ ὑμῶν ἀπάτῃ τῆς ἁμαρτίας·"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "μέτοχοι γὰρ γεγόναμεν τοῦ Χριστοῦ, ἐάνπερ τὴν ἀρχὴν τῆς ὑποστάσεως μέχρι τέλους βεβαίαν κατάσχωμεν·"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ἐν τῷ λέγεσθαι,",
          {
            "lineBreak": true
          },
          {
            "text": "Σήμερον ἐὰν τῆς φωνῆς αὐτοῦ ἀκούσητε,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "μὴ σκληρύνητε τὰς καρδίας ὑμῶν, ὡς ἐν τῷ παραπικρασμῷ.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Τινὲς γὰρ ἀκούσαντες παρεπίκραναν, ἀλλ᾿ οὐ πάντες οἱ ἐξελθόντες ἐξ Αἰγύπτου διὰ Μωσέως."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Τίσι δὲ προσώχθισε τεσσαράκοντα ἔτη; Οὐχὶ τοῖς ἁμαρτήσασιν, ὧν τὰ κῶλα ἔπεσεν ἐν τῇ ἐρήμῳ;"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Τίσι δὲ ὤμοσε μὴ εἰσελεύσεσθαι εἰς τὴν κατάπαυσιν αὐτοῦ, εἰ μὴ τοῖς ἀπειθήσασι;"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Καὶ βλέπομεν ὅτι οὐκ ἠδυνήθησαν εἰσελθεῖν δι᾿ ἀπιστίαν."
        ]
      }
    ],
