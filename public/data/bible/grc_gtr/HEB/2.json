  },
  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Διὰ τοῦτο δεῖ περισσοτέρως ἡμᾶς προσέχειν τοῖς ἀκουσθεῖσι, μήποτε παραρρυῶμεν."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Εἰ γὰρ ὁ δι᾿ ἀγγέλων λαληθεὶς λόγος ἐγένετο βέβαιος, καὶ πᾶσα παράβασις καὶ παρακοὴ ἔλαβεν ἔνδικον μισθαποδοσίαν,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "πῶς ἡμεῖς ἐκφευξόμεθα τηλικαύτης ἀμελήσαντες σωτηρίας; Ἥτις, ἀρχὴν λαβοῦσα λαλεῖσθαι διὰ τοῦ Κυρίου, ὑπὸ τῶν ἀκουσάντων εἰς ἡμᾶς ἐβεβαιώθη,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "συνεπιμαρτυροῦντος τοῦ Θεοῦ σημείοις τε καὶ τέρασι, καὶ ποικίλαις δυνάμεσι, καὶ πνεύματος ἁγίου μερισμοῖς, κατὰ τὴν αὐτοῦ θέλησιν."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Οὐ γὰρ ἀγγέλοις ὑπέταξε τὴν οἰκουμένην τὴν μέλλουσαν, περὶ ἧς λαλοῦμεν."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Διεμαρτύρατο δέ πού τις λέγων,",
          {
            "lineBreak": true
          },
          {
            "text": "Τί ἐστιν ἄνθρωπος, ὅτι μιμνῄσκῃ αὐτοῦ;",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ἢ υἱὸς ἀνθρώπου, ὅτι ἐπισκέπτῃ αὐτόν;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ἠλάττωσας αὐτὸν βραχύ τι παρ᾿ ἀγγέλους·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "δόξῃ καὶ τιμῇ ἐστεφάνωσας αὐτόν,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ κατέστησας αὐτὸν ἐπὶ τὰ ἔργα τῶν χειρῶν σου·",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "πάντα ὑπέταξας ὑποκάτω τῶν ποδῶν αὐτοῦ.",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          "Ἐν γὰρ τῷ ὑποτάξαι αὐτῷ τὰ πάντα, οὐδὲν ἀφῆκεν αὐτῷ ἀνυπότακτον. Νῦν δὲ οὔπω ὁρῶμεν αὐτῷ τὰ πάντα ὑποτεταγμένα."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Τὸν δὲ βραχύ τι παρ᾿ ἀγγέλους ἠλαττωμένον βλέπομεν Ἰησοῦν, διὰ τὸ πάθημα τοῦ θανάτου δόξῃ καὶ τιμῇ ἐστεφανωμένον, ὅπως χάριτι Θεοῦ ὑπὲρ παντὸς γεύσηται θανάτου."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Ἔπρεπε γὰρ αὐτῷ, δι᾿ ὃν τὰ πάντα, καὶ δι᾿ οὗ τὰ πάντα, πολλοὺς υἱοὺς εἰς δόξαν ἀγαγόντα, τὸν ἀρχηγὸν τῆς σωτηρίας αὐτῶν διὰ παθημάτων τελειῶσαι."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ὅ τε γὰρ ἁγιάζων καὶ οἱ ἁγιαζόμενοι, ἐξ ἑνὸς πάντες· δι᾿ ἣν αἰτίαν οὐκ ἐπαισχύνεται ἀδελφοὺς αὐτοὺς καλεῖν,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "λέγων,",
          {
            "lineBreak": true
          },
          {
            "text": "Ἀπαγγελῶ τὸ ὄνομά σου τοῖς ἀδελφοῖς μου,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἐν μέσῳ ἐκκλησίας ὑμνήσω σε.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Καὶ πάλιν,",
          {
            "lineBreak": true
          },
          {
            "text": "Ἐγὼ ἔσομαι πεποιθὼς ἐπ᾿ αὐτῷ.",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          "Καὶ πάλιν,",
          {
            "lineBreak": true
          },
          {
            "text": "Ἰδοὺ ἐγὼ καὶ τὰ παιδία ἅ μοι ἔδωκεν ὁ Θεός.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Ἐπεὶ οὖν τὰ παιδία κεκοινώνηκε σαρκὸς καὶ αἵματος, καὶ αὐτὸς παραπλησίως μετέσχε τῶν αὐτῶν, ἵνα διὰ τοῦ θανάτου καταργήσῃ τὸν τὸ κράτος ἔχοντα τοῦ θανάτου, τοῦτ᾿ ἔστι τὸν διάβολον,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ ἀπαλλάξῃ τούτους, ὅσοι φόβῳ θανάτου διὰ παντὸς τοῦ ζῇν ἔνοχοι ἦσαν δουλείας."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Οὐ γὰρ δήπου ἀγγέλων ἐπιλαμβάνεται, ἀλλὰ σπέρματος Ἀβραὰμ ἐπιλαμβάνεται."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Ὅθεν ὤφειλε κατὰ πάντα τοῖς ἀδελφοῖς ὁμοιωθῆναι, ἵνα ἐλεήμων γένηται καὶ πιστὸς ἀρχιερεὺς τὰ πρὸς τὸν Θεόν, εἰς τὸ ἱλάσκεσθαι τὰς ἁμαρτίας τοῦ λαοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Ἐν ᾧ γὰρ πέπονθεν αὐτὸς πειρασθείς, δύναται τοῖς πειραζομένοις βοηθῆσαι."
        ]
      }
    ],
