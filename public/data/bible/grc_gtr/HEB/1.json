    "name": "ΠΡΟΣ ΕΒΡΑΙΟΥΣ",
    "commonName": "ΠΡΟΣ ΕΒΡΑΙΟΥΣ",
    "title": "ΠΑΥΛΟΥ ΤΟΥ ΑΠΟΣΤΟΛΟΥ Η ΠΡΟΣ ΕΒΡΑΙΟΥΣ ΕΠΙΣΤΟΛΗ",
    "order": 58,
    "numberOfChapters": 13,
    "sha256": "42df6c2461b2666695ba1a61d4f54b32edb92c237f7d601d2302aa16ad906fcc",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_gtr/HEB/1.json",
    "lastChapterNumber": 13,
    "lastChapterApiLink": "/api/grc_gtr/HEB/13.json",
    "totalNumberOfVerses": 303
  },
  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Πολυμερῶς καὶ πολυτρόπως πάλαι ὁ Θεὸς λαλήσας τοῖς πατράσιν ἐν τοῖς προφήταις, ἐπ᾿ ἐσχάτων τῶν ἡμερῶν τούτων ἐλάλησεν ἡμῖν ἐν υἱῷ,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ὃν ἔθηκε κληρονόμον πάντων, δι᾿ οὗ καὶ τοὺς αἰῶνας ἐποίησεν,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ὃς ὢν ἀπαύγασμα τῆς δόξης καὶ χαρακτὴρ τῆς ὑποστάσεως αὐτοῦ, φέρων τε τὰ πάντα τῷ ῥήματι τῆς δυνάμεως αὐτοῦ, δι᾿ ἑαυτοῦ καθαρισμὸν ποιησάμενος τῶν ἁμαρτιῶν ἡμῶν, ἐκάθισεν ἐν δεξιᾷ τῆς μεγαλωσύνης ἐν ὑψηλοῖς,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "τοσούτῳ κρείττων γενόμενος τῶν ἀγγέλων, ὅσῳ διαφορώτερον παρ᾿ αὐτοὺς κεκληρονόμηκεν ὄνομα."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Τίνι γὰρ εἶπέ ποτε τῶν ἀγγέλων,",
          {
            "lineBreak": true
          },
          {
            "text": "Υἱός μου εἶ σύ,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἐγὼ σήμερον γεγέννηκά σε;",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          "Καὶ πάλιν,",
          {
            "lineBreak": true
          },
          {
            "text": "Ἐγὼ ἔσομαι αὐτῷ εἰς πατέρα,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ αὐτὸς ἔσται μοι εἰς υἱόν;",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ὅταν δὲ πάλιν εἰσαγάγῃ τὸν πρωτότοκον εἰς τὴν οἰκουμένην λέγει,",
          {
            "lineBreak": true
          },
          {
            "text": "Καὶ προσκυνησάτωσαν αὐτῷ πάντες ἄγγελοι Θεοῦ.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Καὶ πρὸς μὲν τοὺς ἀγγέλους λέγει,",
          {
            "lineBreak": true
          },
          {
            "text": "Ὁ ποιῶν τοὺς ἀγγέλους αὐτοῦ πνεύματα,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ τοὺς λειτουργοὺς αὐτοῦ πυρὸς φλόγα·",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "πρὸς δὲ τὸν υἱόν,",
          {
            "lineBreak": true
          },
          {
            "text": "Ὁ θρόνος σου, ὁ Θεός, εἰς τὸν αἰῶνα τοῦ αἰῶνος·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ῥάβδος εὐθύτητος ἡ ῥάβδος τῆς βασιλείας σου.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ἠγάπησας δικαιοσύνην, καὶ ἐμίσησας ἀνομίαν·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "διὰ τοῦτο ἔχρισέ σε ὁ Θεός, ὁ Θεός σου,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἔλαιον ἀγαλλιάσεως παρὰ τοὺς μετόχους σου.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Καί,",
          {
            "lineBreak": true
          },
          {
            "text": "Σὺ κατ᾿ ἀρχάς, Κύριε, τὴν γῆν ἐθεμελίωσας,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ἔργα τῶν χειρῶν σού εἰσιν οἱ οὐρανοί·",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "αὐτοὶ ἀπολοῦνται, σὺ δὲ διαμένεις·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ πάντες ὡς ἱμάτιον παλαιωθήσονται,",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "καὶ ὡσεὶ περιβόλαιον ἑλίξεις αὐτούς,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ἀλλαγήσονται·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "σὺ δὲ ὁ αὐτὸς εἶ,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ τὰ ἔτη σου οὐκ ἐκλείψουσι.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Πρὸς τίνα δὲ τῶν ἀγγέλων εἴρηκέ ποτε,",
          {
            "lineBreak": true
          },
          {
            "text": "Κάθου ἐκ δεξιῶν μου,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἕως ἂν θῶ τοὺς ἐχθρούς σου ὑποπόδιον τῶν ποδῶν σου;",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Οὐχὶ πάντες εἰσὶ λειτουργικὰ πνεύματα, εἰς διακονίαν ἀποστελλόμενα διὰ τοὺς μέλλοντας κληρονομεῖν σωτηρίαν;"
        ]
      }
    ],
