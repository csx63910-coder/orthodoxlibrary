  "book": {
    "id": "HEB",
    "translationId": "grc_gtr",
    "name": "ΠΡΟΣ ΕΒΡΑΙΟΥΣ",
    "commonName": "ΠΡΟΣ ΕΒΡΑΙΟΥΣ",
    "title": "ΠΑΥΛΟΥ ΤΟΥ ΑΠΟΣΤΟΛΟΥ Η ΠΡΟΣ ΕΒΡΑΙΟΥΣ ΕΠΙΣΤΟΛΗ",
    "order": 58,
    "numberOfChapters": 13,
    "sha256": "42df6c2461b2666695ba1a61d4f54b32edb92c237f7d601d2302aa16ad906fcc",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_gtr/HEB/1.json",
    "lastChapterNumber": 13,
    "lastChapterApiLink": "/api/grc_gtr/HEB/13.json",
    "totalNumberOfVerses": 303
  },
  "chapter": {
    "number": 10,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Σκιὰν γὰρ ἔχων ὁ νόμος τῶν μελλόντων ἀγαθῶν, οὐκ αὐτὴν τὴν εἰκόνα τῶν πραγμάτων, κατ᾿ ἐνιαυτὸν ταῖς αὐταῖς θυσίαις ἃς προσφέρουσιν εἰς τὸ διηνεκές, οὐδέποτε δύναται τοὺς προσερχομένους τελειῶσαι."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "noteId": 6
          },
          "Ἐπεὶ οὐκ ἂν ἐπαύσαντο προσφερόμεναι, διὰ τὸ μηδεμίαν ἔχειν ἔτι συνείδησιν ἁμαρτιῶν τοὺς λατρεύοντας, ἅπαξ κεκαθαρμένους;"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Ἀλλ᾿ ἐν αὐταῖς ἀνάμνησις ἁμαρτιῶν κατ᾿ ἐνιαυτόν·"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἀδύνατον γὰρ αἷμα ταύρων καὶ τράγων ἀφαιρεῖν ἁμαρτίας."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Διὸ εἰσερχόμενος εἰς τὸν κόσμον λέγει,",
          {
            "lineBreak": true
          },
          {
            "text": "Θυσίαν καὶ προσφορὰν οὐκ ἠθέλησας,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "σῶμα δὲ κατηρτίσω μοι·",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "ὁλοκαυτώματα καὶ περὶ ἁμαρτίας",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "οὐκ εὐδόκησας·",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "τότε εἶπον, Ἰδού, ἥκω —",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἐν κεφαλίδι βιβλίου γέγραπται περὶ ἐμοῦ —",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "τοῦ ποιῆσαι, ὁ Θεός, τὸ θέλημά σου.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Ἀνώτερον λέγων ὅτι Θυσίαν καὶ προσφορὰν καὶ ὁλοκαυτώματα καὶ περὶ ἁμαρτίας οὐκ ἠθέλησας, οὐδὲ εὐδόκησας — αἵτινες κατὰ τὸν νόμον προσφέρονται —"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "τότε εἴρηκεν, Ἰδού, ἥκω τοῦ ποιῆσαι, ὁ Θεός, τὸ θέλημά σου. Ἀναιρεῖ τὸ πρῶτον, ἵνα τὸ δεύτερον στήσῃ."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Ἐν ᾧ θελήματι ἡγιασμένοι",
          {
            "noteId": 7
          },
          "ἐσμέν διὰ τῆς προσφορᾶς τοῦ σώματος τοῦ Ἰησοῦ Χριστοῦ ἐφάπαξ."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Καὶ πᾶς μὲν ἱερεὺς ἕστηκε καθ᾿ ἡμέραν λειτουργῶν, καὶ τὰς αὐτὰς πολλάκις προσφέρων θυσίας, αἵτινες οὐδέποτε δύνανται περιελεῖν ἁμαρτίας·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "αὐτὸς δὲ μίαν ὑπὲρ ἁμαρτιῶν προσενέγκας θυσίαν εἰς τὸ διηνεκές, ἐκάθισεν ἐν δεξιᾷ τοῦ Θεοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "τὸ λοιπὸν ἐκδεχόμενος ἕως τεθῶσιν οἱ ἐχθροὶ αὐτοῦ ὑποπόδιον τῶν ποδῶν αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Μιᾷ γὰρ προσφορᾷ τετελείωκεν εἰς τὸ διηνεκὲς τοὺς ἁγιαζομένους."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Μαρτυρεῖ δὲ ἡμῖν καὶ τὸ πνεῦμα τὸ ἅγιον· μετὰ γὰρ τὸ προειρηκέναι,"
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Αὕτη ἡ διαθήκη ἣν διαθήσομαι πρὸς αὐτοὺς",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "μετὰ τὰς ἡμέρας ἐκείνας, λέγει Κύριος,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "διδοὺς νόμους μου ἐπὶ καρδίας αὐτῶν,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ἐπὶ τῶν διανοιῶν αὐτῶν ἐπιγράψω αὐτούς·",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καὶ",
          {
            "lineBreak": true
          },
          {
            "text": "τῶν ἁμαρτιῶν αὐτῶν καὶ τῶν ἀνομιῶν αὐτῶν οὐ μὴ μνησθῶ ἔτι.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Ὅπου δὲ ἄφεσις τούτων, οὐκέτι προσφορὰ περὶ ἁμαρτίας."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Ἔχοντες οὖν, ἀδελφοί, παρρησίαν εἰς τὴν εἴσοδον τῶν ἁγίων ἐν τῷ αἵματι Ἰησοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἣν ἐνεκαίνισεν ἡμῖν ὁδὸν πρόσφατον καὶ ζῶσαν, διὰ τοῦ καταπετάσματος, τοῦτ᾿ ἔστι, τῆς σαρκὸς αὐτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "καὶ ἱερέα μέγαν ἐπὶ τὸν οἶκον τοῦ Θεοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "προσερχώμεθα μετὰ ἀληθινῆς καρδίας ἐν πληροφορίᾳ πίστεως, ἐρραντισμένοι τὰς καρδίας ἀπὸ συνειδήσεως",
          {
            "noteId": 8
          },
          "πονηρᾶς, καὶ λελουμένοι τὸ σῶμα ὕδατι καθαρῷ·"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "κατέχωμεν τὴν ὁμολογίαν τῆς ἐλπίδος ἀκλινῆ, πιστὸς γὰρ ὁ ἐπαγγειλάμενος·"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "καὶ κατανοῶμεν ἀλλήλους εἰς παροξυσμὸν ἀγάπης καὶ καλῶν ἔργων,"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "μὴ ἐγκαταλείποντες τὴν ἐπισυναγωγὴν ἑαυτῶν, καθὼς ἔθος τισίν, ἀλλὰ παρακαλοῦντες, καὶ τοσούτῳ μᾶλλον, ὅσῳ βλέπετε ἐγγίζουσαν τὴν ἡμέραν."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Ἑκουσίως γὰρ ἁμαρτανόντων ἡμῶν μετὰ τὸ λαβεῖν τὴν ἐπίγνωσιν τῆς ἀληθείας, οὐκέτι περὶ ἁμαρτιῶν ἀπολείπεται θυσία,"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "φοβερὰ δέ τις ἐκδοχὴ κρίσεως, καὶ πυρὸς ζῆλος ἐσθίειν μέλλοντος τοὺς ὑπεναντίους."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Ἀθετήσας τις νόμον Μωσέως χωρὶς οἰκτιρμῶν ἐπὶ δυσὶν ἢ τρισὶ μάρτυσιν ἀποθνῄσκει·"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "πόσῳ, δοκεῖτε, χείρονος ἀξιωθήσεται τιμωρίας ὁ τὸν υἱὸν τοῦ Θεοῦ καταπατήσας, καὶ τὸ αἷμα τῆς διαθήκης κοινὸν ἡγησάμενος ἐν ᾧ ἡγιάσθη, καὶ τὸ πνεῦμα τῆς χάριτος ἐνυβρίσας;"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Οἴδαμεν γὰρ τὸν εἰπόντα, Ἐμοὶ ἐκδίκησις, ἐγὼ ἀνταποδώσω, λέγει Κύριος· καὶ πάλιν, Κύριος κρινεῖ τὸν λαὸν αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "Φοβερὸν τὸ ἐμπεσεῖν εἰς χεῖρας Θεοῦ ζῶντος."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Ἀναμιμνῄσκεσθε δὲ τὰς πρότερον ἡμέρας, ἐν αἷς φωτισθέντες πολλὴν ἄθλησιν ὑπεμείνατε παθημάτων·"
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "τοῦτο μέν, ὀνειδισμοῖς τε καὶ θλίψεσι θεατριζόμενοι· τοῦτο δέ, κοινωνοὶ τῶν οὕτως ἀναστρεφομένων γενηθέντες."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "Καὶ γὰρ τοῖς δεσμοῖς μου συνεπαθήσατε, καὶ τὴν ἁρπαγὴν τῶν ὑπαρχόντων ὑμῶν μετὰ χαρᾶς προσεδέξασθε, γινώσκοντες ἔχειν ἐν ἑαυτοῖς κρείττονα ὕπαρξιν ἐν οὐρανοῖς καὶ μένουσαν."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "Μὴ ἀποβάλητε οὖν τὴν παρρησίαν ὑμῶν, ἥτις ἔχει μισθαποδοσίαν μεγάλην."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "Ὑπομονῆς γὰρ ἔχετε χρείαν, ἵνα τὸ θέλημα τοῦ Θεοῦ ποιήσαντες κομίσησθε τὴν ἐπαγγελίαν."
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Ἔτι γὰρ μικρὸν ὅσον ὅσον,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ὁ ἐρχόμενος ἥξει, καὶ οὐ χρονιεῖ.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "Ὁ δὲ δίκαιος ἐκ πίστεως ζήσεται·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ἐὰν ὑποστείληται,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "οὐκ εὐδοκεῖ ἡ ψυχή μου ἐν αὐτῷ.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "Ἡμεῖς δὲ οὐκ ἐσμὲν ὑποστολῆς εἰς ἀπώλειαν, ἀλλὰ πίστεως εἰς περιποίησιν ψυχῆς."
        ]
      }
    ],
