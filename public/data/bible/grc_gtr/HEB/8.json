  },
  "chapter": {
    "number": 8,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Κεφάλαιον δὲ ἐπὶ τοῖς λεγομένοις· τοιοῦτον ἔχομεν ἀρχιερέα, ὃς ἐκάθισεν ἐν δεξιᾷ τοῦ θρόνου τῆς μεγαλωσύνης ἐν τοῖς οὐρανοῖς,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "τῶν ἁγίων λειτουργός, καὶ τῆς σκηνῆς τῆς ἀληθινῆς, ἣν ἔπηξεν ὁ Κύριος, καὶ οὐκ ἄνθρωπος·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "πᾶς γὰρ ἀρχιερεὺς εἰς τὸ προσφέρειν δῶρά τε καὶ θυσίας καθίσταται· ὅθεν ἀναγκαῖον ἔχειν τι καὶ τοῦτον ὃ προσενέγκῃ."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Εἰ μὲν γὰρ ἦν ἐπὶ γῆς, οὐδ᾿ ἂν ἦν ἱερεύς, ὄντων τῶν ἱερέων τῶν προσφερόντων κατὰ τὸν νόμον τὰ δῶρα,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "οἵτινες ὑποδείγματι καὶ σκιᾷ λατρεύουσι τῶν ἐπουρανίων, καθὼς κεχρημάτισται Μωσῆς μέλλων ἐπιτελεῖν τὴν σκηνήν, Ὅρα, γάρ φησι, ποιήσῃς πάντα κατὰ τὸν τύπον τὸν δειχθέντα σοι ἐν τῷ ὄρει."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Νυνὶ δὲ διαφορωτέρας τέτευχε λειτουργίας, ὅσῳ καὶ κρείττονός ἐστι διαθήκης μεσίτης, ἥτις ἐπὶ κρείττοσιν ἐπαγγελίαις νενομοθέτηται."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Εἰ γὰρ ἡ πρώτη ἐκείνη ἦν ἄμεμπτος, οὐκ ἂν δευτέρας ἐζητεῖτο τόπος."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Μεμφόμενος γὰρ αὐτοῖς λέγει,",
          {
            "lineBreak": true
          },
          {
            "text": "Ἰδού, ἡμέραι ἔρχονται, λέγει Κύριος,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ συντελέσω ἐπὶ τὸν οἶκον Ἰσραὴλ",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ἐπὶ τὸν οἶκον Ἰούδα διαθήκην καινήν·",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "οὐ κατὰ τὴν διαθήκην ἣν ἐποίησα τοῖς πατράσιν αὐτῶν",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἐν ἡμέρᾳ ἐπιλαβομένου",
            "poem": 1
          },
          {
            "noteId": 3
          },
          {
            "text": "μου τῆς χειρὸς αὐτῶν ἐξαγαγεῖν αὐτοὺς ἐκ γῆς Αἰγύπτου·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ὅτι αὐτοὶ οὐκ ἐνέμειναν ἐν τῇ διαθήκῃ μου,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "κἀγὼ ἠμέλησα αὐτῶν, λέγει Κύριος.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ὅτι αὕτη ἡ διαθήκη ἣν διαθήσομαι τῷ οἴκῳ Ἰσραὴλ",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "μετὰ τὰς ἡμέρας ἐκείνας, λέγει Κύριος,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "διδοὺς νόμους μου εἰς τὴν διάνοιαν αὐτῶν,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ἐπὶ καρδίας αὐτῶν ἐπιγράψω αὐτούς·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ἔσομαι αὐτοῖς εἰς Θεόν,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ αὐτοὶ ἔσονταί μοι εἰς λαόν.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Καὶ οὐ μὴ διδάξωσιν ἕκαστος τὸν πλησίον αὐτοῦ,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ἕκαστος τὸν ἀδελφὸν αὐτοῦ, λέγων, Γνῶθι τὸν Κύριον·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ὅτι πάντες εἰδήσουσί με,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἀπὸ μικροῦ αὐτῶν ἕως μεγάλου αὐτῶν.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ὅτι ἵλεως ἔσομαι ταῖς ἀδικίαις αὐτῶν,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ τῶν ἁμαρτιῶν αὐτῶν καὶ τῶν ἀνομιῶν αὐτῶν οὐ μὴ μνησθῶ ἔτι.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ἐν τῷ λέγειν, Καινήν, πεπαλαίωκε τὴν πρώτην. Τὸ δὲ παλαιούμενον καὶ γηράσκον, ἐγγὺς ἀφανισμοῦ."
        ]
      }
    ],
