  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Πᾶς γὰρ ἀρχιερεύς, ἐξ ἀνθρώπων λαμβανόμενος, ὑπὲρ ἀνθρώπων καθίσταται τὰ πρὸς τὸν Θεόν, ἵνα προσφέρῃ δῶρά τε καὶ θυσίας ὑπὲρ ἁμαρτιῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "μετριοπαθεῖν δυνάμενος τοῖς ἀγνοοῦσι καὶ πλανωμένοις, ἐπεὶ καὶ αὐτὸς περίκειται ἀσθένειαν·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ διὰ ταύτην ὀφείλει, καθὼς περὶ τοῦ λαοῦ, οὕτω καὶ περὶ ἑαυτοῦ, προσφέρειν ὑπὲρ ἁμαρτιῶν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Καὶ οὐχ ἑαυτῷ τις λαμβάνει τὴν τιμήν, ἀλλὰ ὁ καλούμενος ὑπὸ τοῦ Θεοῦ, καθάπερ καὶ ὁ Ἀαρών."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Οὕτω καὶ ὁ Χριστὸς οὐχ ἑαυτὸν ἐδόξασε γενηθῆναι ἀρχιερέα, ἀλλ᾿ ὁ λαλήσας πρὸς αὐτόν,",
          {
            "lineBreak": true
          },
          {
            "text": "Υἱός μου εἶ σύ,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἐγὼ σήμερον γεγέννηκά σε.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Καθὼς καὶ ἐν ἑτέρῳ λέγει,",
          {
            "lineBreak": true
          },
          {
            "text": "Σὺ ἱερεὺς εἰς τὸν αἰῶνα",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "κατὰ τὴν τάξιν Μελχισεδέκ.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ὃς ἐν ταῖς ἡμέραις τῆς σαρκὸς αὐτοῦ, δεήσεις τε καὶ ἱκετηρίας πρὸς τὸν δυνάμενον σώζειν αὐτὸν ἐκ θανάτου μετὰ κραυγῆς ἰσχυρᾶς καὶ δακρύων προσενέγκας, καὶ εἰσακουσθεὶς ἀπὸ τῆς εὐλαβείας,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καίπερ ὢν υἱός, ἔμαθεν ἀφ᾿ ὧν ἔπαθε τὴν ὑπακοήν,"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ τελειωθεὶς ἐγένετο τοῖς ὑπακούουσιν αὐτῷ πᾶσιν αἴτιος σωτηρίας αἰωνίου·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "προσαγορευθεὶς ὑπὸ τοῦ Θεοῦ ἀρχιερεὺς κατὰ τὴν τάξιν Μελχισεδέκ."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Περὶ οὗ πολὺς ἡμῖν ὁ λόγος καὶ δυσερμήνευτος λέγειν, ἐπεὶ νωθροὶ γεγόνατε ταῖς ἀκοαῖς."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Καὶ γὰρ ὀφείλοντες εἶναι διδάσκαλοι διὰ τὸν χρόνον, πάλιν χρείαν ἔχετε τοῦ διδάσκειν ὑμᾶς, τίνα τὰ στοιχεῖα τῆς ἀρχῆς τῶν λογίων τοῦ Θεοῦ· καὶ γεγόνατε χρείαν ἔχοντες γάλακτος, καὶ οὐ στερεᾶς τροφῆς."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Πᾶς γὰρ ὁ μετέχων γάλακτος ἄπειρος λόγου δικαιοσύνης· νήπιος γάρ ἐστι."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Τελείων δέ ἐστιν ἡ στερεὰ τροφή, τῶν διὰ τὴν ἕξιν τὰ αἰσθητήρια γεγυμνασμένα ἐχόντων πρὸς διάκρισιν καλοῦ τε καὶ κακοῦ."
        ]
      }
    ],
