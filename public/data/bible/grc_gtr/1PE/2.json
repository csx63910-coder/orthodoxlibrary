    "title": "ΠΕΤΡΟΥ ΕΠΙΣΤΟΛΗ ΚΑΘΟΛΙΚΗ ΠΡΩΤΗ",
    "order": 60,
    "numberOfChapters": 5,
    "sha256": "1ef0ed0eeab127dba4d32bb54c26134ef3718ee0b956d5781b03aa62faa8a8ce",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_gtr/1PE/1.json",
    "lastChapterNumber": 5,
    "lastChapterApiLink": "/api/grc_gtr/1PE/5.json",
    "totalNumberOfVerses": 105
  },
  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἀποθέμενοι οὖν πᾶσαν κακίαν καὶ πάντα δόλον καὶ ὑποκρίσεις καὶ φθόνους καὶ πάσας καταλαλιάς,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ὡς ἀρτιγέννητα βρέφη, τὸ λογικὸν ἄδολον γάλα ἐπιποθήσατε, ἵνα ἐν αὐτῷ αὐξηθῆτε,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "εἴπερ ἐγεύσασθε ὅτι χρηστὸς ὁ Κύριος·"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "πρὸς ὃν προσερχόμενοι, λίθον ζῶντα, ὑπὸ ἀνθρώπων μὲν ἀποδεδοκιμασμένον, παρὰ δὲ Θεῷ ἐκλεκτόν, ἔντιμον,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ αὐτοὶ ὡς λίθοι ζῶντες οἰκοδομεῖσθε οἶκος πνευματικός, ἱεράτευμα ἅγιον, ἀνενέγκαι πνευματικὰς θυσίας εὐπροσδέκτους τῷ Θεῷ διὰ Ἰησοῦ Χριστοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Διὸ καὶ περιέχει ἐν τῇ γραφῇ,",
          {
            "lineBreak": true
          },
          {
            "text": "Ἰδού, τίθημι ἐν Σιὼν λίθον ἀκρογωνιαῖον,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἐκλεκτόν, ἔντιμον·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ὁ πιστεύων ἐπ᾿ αὐτῷ οὐ μὴ καταισχυνθῇ.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ὑμῖν οὖν ἡ τιμὴ τοῖς πιστεύουσιν· ἀπειθοῦσι δέ,",
          {
            "lineBreak": true
          },
          {
            "text": "Λίθον ὃν ἀπεδοκίμασαν οἱ οἰκοδομοῦντες,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "οὗτος ἐγενήθη εἰς κεφαλὴν γωνίας,",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καί,",
          {
            "lineBreak": true
          },
          {
            "text": "Λίθος προσκόμματος",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ πέτρα σκανδάλου·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          "οἳ προσκόπτουσι τῷ λόγῳ ἀπειθοῦντες· εἰς ὃ καὶ ἐτέθησαν."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Ὑμεῖς δὲ γένος ἐκλεκτόν, βασίλειον ἱεράτευμα, ἔθνος ἅγιον, λαὸς εἰς περιποίησιν, ὅπως τὰς ἀρετὰς ἐξαγγείλητε τοῦ ἐκ σκότους ὑμᾶς καλέσαντος εἰς τὸ θαυμαστὸν αὐτοῦ φῶς·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "οἱ ποτὲ οὐ λαός, νῦν δὲ λαὸς Θεοῦ· οἱ οὐκ ἠλεημένοι, νῦν δὲ ἐλεηθέντες."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ἀγαπητοί, παρακαλῶ ὡς παροίκους καὶ παρεπιδήμους, ἀπέχεσθαι τῶν σαρκικῶν ἐπιθυμιῶν, αἵτινες στρατεύονται κατὰ τῆς ψυχῆς·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "τὴν ἀναστροφὴν ὑμῶν ἐν τοῖς ἔθνεσιν ἔχοντες καλήν, ἵνα, ἐν ᾧ καταλαλοῦσιν ὑμῶν ὡς κακοποιῶν, ἐκ τῶν καλῶν ἔργων, ἐποπτεύσαντες, δοξάσωσι τὸν Θεὸν ἐν ἡμέρᾳ ἐπισκοπῆς."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ὑποτάγητε οὖν πάσῃ ἀνθρωπίνῃ κτίσει διὰ τὸν Κύριον· εἴτε βασιλεῖ, ὡς ὑπερέχοντι·"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "εἴτε ἡγεμόσιν, ὡς δι᾿ αὐτοῦ πεμπομένοις εἰς ἐκδίκησιν μὲν κακοποιῶν, ἔπαινον δὲ ἀγαθοποιῶν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Ὅτι οὕτως ἐστὶ τὸ θέλημα τοῦ Θεοῦ, ἀγαθοποιοῦντας φιμοῦν τὴν τῶν ἀφρόνων ἀνθρώπων ἀγνωσίαν·"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ὡς ἐλεύθεροι, καὶ μὴ ὡς ἐπικάλυμμα ἔχοντες τῆς κακίας τὴν ἐλευθερίαν, ἀλλ᾿ ὡς δοῦλοι Θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Πάντας τιμήσατε. Τὴν ἀδελφότητα ἀγαπᾶτε. Τὸν Θεὸν φοβεῖσθε. Τὸν βασιλέα τιμᾶτε."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Οἱ οἰκέται, ὑποτασσόμενοι ἐν παντὶ φόβῳ τοῖς δεσπόταις, οὐ μόνον τοῖς ἀγαθοῖς καὶ ἐπιεικέσιν, ἀλλὰ καὶ τοῖς σκολιοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Τοῦτο γὰρ χάρις, εἰ διὰ συνείδησιν Θεοῦ ὑποφέρει τις λύπας, πάσχων ἀδίκως."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Ποῖον γὰρ κλέος, εἰ ἁμαρτάνοντες καὶ κολαφιζόμενοι ὑπομενεῖτε; Ἀλλ᾿ εἰ ἀγαθοποιοῦντες καὶ πάσχοντες ὑπομενεῖτε, τοῦτο χάρις παρὰ Θεῷ."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Εἰς τοῦτο γὰρ ἐκλήθητε, ὅτι καὶ Χριστὸς ἔπαθεν ὑπὲρ",
          {
            "noteId": 3
          },
          "ἡμῶν, ἡμῖν ὑπολιμπάνων ὑπογραμμόν, ἵνα ἐπακολουθήσητε τοῖς ἴχνεσιν αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ὃς ἁμαρτίαν οὐκ ἐποίησεν, οὐδὲ εὑρέθη δόλος ἐν τῷ στόματι αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ὃς λοιδορούμενος οὐκ ἀντελοιδόρει, πάσχων οὐκ ἠπείλει, παρεδίδου δὲ τῷ κρίνοντι δικαίως·"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ὃς τὰς ἁμαρτίας ἡμῶν αὐτὸς ἀνήνεγκεν ἐν τῷ σώματι αὐτοῦ ἐπὶ τὸ ξύλον, ἵνα, ταῖς ἁμαρτίαις ἀπογενόμενοι, τῇ δικαιοσύνῃ ζήσωμεν· οὗ τῷ μώλωπι αὐτοῦ ἰάθητε."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Ἦτε γὰρ ὡς πρόβατα πλανώμενα· ἀλλ᾿ ἐπεστράφητε νῦν ἐπὶ τὸν ποιμένα καὶ ἐπίσκοπον τῶν ψυχῶν ὑμῶν."
        ]
      }
    ],
