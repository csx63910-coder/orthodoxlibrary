    "name": "ΠΡΟΣ ΤΙΜΟΘΕΟΝ Α",
    "commonName": "ΠΡΟΣ ΤΙΜΟΘΕΟΝ Α",
    "title": "ΠΑΥΛΟΥ ΤΟΥ ΑΠΟΣΤΟΛΟΥ Η ΠΡΟΣ ΤΙΜΟΘΕΟΝ ΕΠΙΣΤΟΛΗ ΠΡΩΤΗ",
    "order": 54,
    "numberOfChapters": 6,
    "sha256": "07d2c48e161969435e32dbf887f3dfb87e248a4536e8b16f7e5e8dd40b0dd704",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_gtr/1TI/1.json",
    "lastChapterNumber": 6,
    "lastChapterApiLink": "/api/grc_gtr/1TI/6.json",
    "totalNumberOfVerses": 113
  },
  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Πιστὸς ὁ λόγος· εἴ τις ἐπισκοπῆς ὀρέγεται, καλοῦ ἔργου ἐπιθυμεῖ."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Δεῖ οὖν τὸν ἐπίσκοπον ἀνεπίληπτον εἶναι, μιᾶς γυναικὸς ἄνδρα,",
          {
            "noteId": 2
          },
          "νηφάλιον, σώφρονα, κόσμιον, φιλόξενον, διδακτικόν·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "μὴ πάροινον, μὴ πλήκτην, μὴ αἰσχροκερδῆ, ἀλλ᾿ ἐπιεικῆ, ἄμαχον, ἀφιλάργυρον·"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "τοῦ ἰδίου οἴκου καλῶς προϊστάμενον, τέκνα ἔχοντα ἐν ὑποταγῇ μετὰ πάσης σεμνότητος."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Εἰ δέ τις τοῦ ἰδίου οἴκου προστῆναι οὐκ οἶδε, πῶς ἐκκλησίας Θεοῦ ἐπιμελήσεται;"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Μὴ νεόφυτον, ἵνα μὴ τυφωθεὶς εἰς κρίμα ἐμπέσῃ τοῦ διαβόλου."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Δεῖ δὲ αὐτὸν καὶ μαρτυρίαν καλὴν ἔχειν ἀπὸ τῶν ἔξωθεν, ἵνα μὴ εἰς ὀνειδισμὸν ἐμπέσῃ καὶ παγίδα τοῦ διαβόλου."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Διακόνους ὡσαύτως σεμνούς, μὴ διλόγους, μὴ οἴνῳ πολλῷ προσέχοντας, μὴ αἰσχροκερδεῖς,"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ἔχοντας τὸ μυστήριον τῆς πίστεως ἐν καθαρᾷ συνειδήσει."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Καὶ οὗτοι δὲ δοκιμαζέσθωσαν πρῶτον, εἶτα διακονείτωσαν, ἀνέγκλητοι ὄντες."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Γυναῖκας ὡσαύτως σεμνάς, μὴ διαβόλους,",
          {
            "noteId": 3
          },
          "νηφαλίους, πιστὰς ἐν πᾶσι."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Διάκονοι ἔστωσαν μιᾶς γυναικὸς ἄνδρες, τέκνων καλῶς προϊστάμενοι καὶ τῶν ἰδίων οἴκων."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Οἱ γὰρ καλῶς διακονήσαντες βαθμὸν ἑαυτοῖς καλὸν περιποιοῦνται, καὶ πολλὴν παρρησίαν ἐν πίστει τῇ ἐν Χριστῷ Ἰησοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Ταῦτά σοι γράφω, ἐλπίζων ἐλθεῖν πρός σε τάχιον·"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ἐὰν δὲ βραδύνω, ἵνα εἰδῇς πῶς δεῖ ἐν οἴκῳ Θεοῦ ἀναστρέφεσθαι, ἥτις ἐστὶν ἐκκλησία Θεοῦ ζῶντος, στύλος καὶ ἑδραίωμα τῆς ἀληθείας."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Καὶ ὁμολογουμένως μέγα ἐστὶ τὸ τῆς εὐσεβείας μυστήριον·",
          {
            "lineBreak": true
          },
          {
            "text": "Θεὸς ἐφανερώθη ἐν σαρκί,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἐδικαιώθη ἐν πνεύματι,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ὤφθη ἀγγέλοις,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἐκηρύχθη ἐν ἔθνεσιν,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἐπιστεύθη ἐν κόσμῳ,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἀνελήφθη ἐν δόξῃ.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
