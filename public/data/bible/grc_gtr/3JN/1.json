    "title": "ΙΩΑΝΝΟΥ ΕΠΙΣΤΟΛΗ ΤΡΙΤΗ",
    "order": 64,
    "numberOfChapters": 1,
    "sha256": "7410d848e870b3fee7fa0166d7dbc8807a34a2492306ebc8356a9426c88c669e",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_gtr/3JN/1.json",
