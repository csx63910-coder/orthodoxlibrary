  "chapter": {
    "number": 11,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Λέγω οὖν, μὴ ἀπώσατο ὁ Θεὸς τὸν λαὸν αὐτοῦ; Μὴ γένοιτο. Καὶ γὰρ ἐγὼ Ἰσραηλίτης εἰμί, ἐκ σπέρματος Ἀβραάμ, φυλῆς Βενιαμίν."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Οὐκ ἀπώσατο ὁ Θεὸς τὸν λαὸν αὐτοῦ ὃν προέγνω. Ἢ οὐκ οἴδατε ἐν Ἠλίᾳ τί λέγει ἡ γραφή; Ὡς ἐντυγχάνει τῷ Θεῷ κατὰ τοῦ Ἰσραήλ, λέγων,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Κύριε, τοὺς προφήτας σου ἀπέκτειναν, καὶ τὰ θυσιαστήριά σου κατέσκαψαν· κἀγὼ ὑπελείφθην μόνος, καὶ ζητοῦσι τὴν ψυχήν μου."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Ἀλλὰ τί λέγει αὐτῷ ὁ χρηματισμός; Κατέλιπον ἐμαυτῷ ἑπτακισχιλίους ἄνδρας, οἵτινες οὐκ ἔκαμψαν γόνυ τῇ Βάαλ."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Οὕτως οὖν καὶ ἐν τῷ νῦν καιρῷ λεῖμμα κατ᾿ ἐκλογὴν χάριτος γέγονεν."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Εἰ δὲ χάριτι, οὐκέτι ἐξ ἔργων· ἐπεὶ ἡ χάρις οὐκέτι γίνεται χάρις. Εἰ δὲ ἐξ ἔργων, οὐκέτι ἐστὶ χάρις· ἐπεὶ τὸ ἔργον οὐκέτι ἐστὶν ἔργον."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Τί οὖν; Ὃ ἐπιζητεῖ Ἰσραήλ, τούτου οὐκ ἐπέτυχεν, ἡ δὲ ἐκλογὴ ἐπέτυχεν, οἱ δὲ λοιποὶ ἐπωρώθησαν·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καθὼς γέγραπται,",
          {
            "lineBreak": true
          },
          {
            "text": "Ἔδωκεν αὐτοῖς ὁ Θεὸς πνεῦμα κατανύξεως,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ὀφθαλμοὺς τοῦ μὴ βλέπειν,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ὦτα τοῦ μὴ ἀκούειν,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἕως τῆς σήμερον ἡμέρας.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Καὶ Δαβὶδ λέγει,",
          {
            "lineBreak": true
          },
          {
            "text": "Γενηθήτω ἡ τράπεζα αὐτῶν εἰς παγίδα καὶ εἰς θήραν,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ εἰς σκάνδαλον, καὶ εἰς ἀνταπόδομα αὐτοῖς·",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "σκοτισθήτωσαν οἱ ὀφθαλμοὶ αὐτῶν τοῦ μὴ βλέπειν,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ τὸν νῶτον αὐτῶν διὰ παντὸς σύγκαμψον.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Λέγω οὖν, μὴ ἔπταισαν ἵνα πέσωσι; Μὴ γένοιτο· ἀλλὰ τῷ αὐτῶν παραπτώματι ἡ σωτηρία τοῖς ἔθνεσιν, εἰς τὸ παραζηλῶσαι αὐτούς."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Εἰ δὲ τὸ παράπτωμα αὐτῶν πλοῦτος κόσμου, καὶ τὸ ἥττημα αὐτῶν πλοῦτος ἐθνῶν, πόσῳ μᾶλλον τὸ πλήρωμα αὐτῶν;"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ὑμῖν γὰρ λέγω τοῖς ἔθνεσιν. Ἐφ᾿ ὅσον μέν εἰμι ἐγὼ ἐθνῶν ἀπόστολος, τὴν διακονίαν μου δοξάζω·"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "εἴ πως παραζηλώσω μου τὴν σάρκα, καὶ σώσω τινὰς ἐξ αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Εἰ γὰρ ἡ ἀποβολὴ αὐτῶν καταλλαγὴ κόσμου, τίς ἡ πρόσληψις, εἰ μὴ ζωὴ ἐκ νεκρῶν;"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Εἰ δὲ ἡ ἀπαρχὴ ἁγία, καὶ τὸ φύραμα· καὶ εἰ ἡ ῥίζα ἁγία, καὶ οἱ κλάδοι."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Εἰ δέ τινες τῶν κλάδων ἐξεκλάσθησαν, σὺ δὲ ἀγριέλαιος ὢν ἐνεκεντρίσθης ἐν αὐτοῖς, καὶ συγκοινωνὸς τῆς ῥίζης καὶ τῆς πιότητος τῆς ἐλαίας ἐγένου,"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "μὴ κατακαυχῶ τῶν κλάδων· εἰ δὲ κατακαυχᾶσαι, οὐ σὺ τὴν ῥίζαν βαστάζεις, ἀλλ᾿ ἡ ῥίζα σέ."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Ἐρεῖς οὖν, Ἐξεκλάσθησαν οἱ κλάδοι, ἵνα ἐγὼ ἐγκεντρισθῶ."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Καλῶς· τῇ ἀπιστίᾳ ἐξεκλάσθησαν, σὺ δὲ τῇ πίστει ἕστηκας. Μὴ ὑψηλοφρόνει, ἀλλὰ φοβοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "εἰ γὰρ ὁ Θεὸς τῶν κατὰ φύσιν κλάδων οὐκ ἐφείσατο, μήπως οὐδέ σου φείσηται."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Ἴδε οὖν χρηστότητα καὶ ἀποτομίαν Θεοῦ· ἐπὶ μὲν τοὺς πεσόντας, ἀποτομίαν· ἐπὶ δὲ σὲ, χρηστότητα, ἐὰν ἐπιμείνῃς τῇ χρηστότητι· ἐπεὶ καὶ σὺ ἐκκοπήσῃ."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Καὶ ἐκεῖνοι δέ, ἐὰν μὴ ἐπιμείνωσι τῇ ἀπιστίᾳ, ἐγκεντρισθήσονται· δυνατὸς γάρ ἐστιν ὁ Θεός πάλιν ἐγκεντρίσαι αὐτούς."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Εἰ γὰρ σὺ ἐκ τῆς κατὰ φύσιν ἐξεκόπης ἀγριελαίου, καὶ παρὰ φύσιν ἐνεκεντρίσθης εἰς καλλιέλαιον, πόσῳ μᾶλλον οὗτοι, οἱ κατὰ φύσιν, ἐγκεντρισθήσονται τῇ ἰδίᾳ ἐλαίᾳ;"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Οὐ γὰρ θέλω ὑμᾶς ἀγνοεῖν, ἀδελφοί, τὸ μυστήριον τοῦτο, ἵνα μὴ ἦτε παρ᾿ ἑαυτοῖς φρόνιμοι, ὅτι πώρωσις ἀπὸ μέρους τῷ Ἰσραὴλ γέγονεν, ἄχρις οὗ τὸ πλήρωμα τῶν ἐθνῶν εἰσέλθῃ·"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "καὶ οὕτω πᾶς Ἰσραὴλ σωθήσεται· καθὼς γέγραπται,",
          {
            "lineBreak": true
          },
          {
            "text": "Ἥξει ἐκ Σιὼν ὁ ῥυόμενος,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ἀποστρέψει ἀσεβείας ἀπὸ Ἰακώβ·",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "καὶ αὕτη αὐτοῖς ἡ παρ᾿ ἐμοῦ διαθήκη,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ὅταν ἀφέλωμαι τὰς ἁμαρτίας αὐτῶν.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Κατὰ μὲν τὸ εὐαγγέλιον, ἐχθροὶ δι᾿ ὑμᾶς· κατὰ δὲ τὴν ἐκλογήν, ἀγαπητοὶ διὰ τοὺς πατέρας."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Ἀμεταμέλητα γὰρ τὰ χαρίσματα καὶ ἡ κλῆσις τοῦ Θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Ὥσπερ γὰρ καὶ ὑμεῖς ποτὲ ἠπειθήσατε τῷ Θεῷ, νῦν δὲ ἠλεήθητε τῇ τούτων ἀπειθείᾳ·"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "οὕτω καὶ οὗτοι νῦν ἠπείθησαν, τῷ",
          {
            "noteId": 6
          },
          "ὑμετέρῳ ἐλέει ἵνα καὶ αὐτοὶ ἐλεηθῶσι·"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "συνέκλεισε γὰρ ὁ Θεὸς τοὺς πάντας εἰς ἀπείθειαν, ἵνα τοὺς πάντας ἐλεήσῃ."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "Ὦ βάθος πλούτου καὶ σοφίας καὶ γνώσεως Θεοῦ. Ὡς ἀνεξερεύνητα τὰ κρίματα αὐτοῦ, καὶ ἀνεξιχνίαστοι αἱ ὁδοὶ αὐτοῦ."
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Τίς γὰρ ἔγνω νοῦν Κυρίου;",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ἢ τίς σύμβουλος αὐτοῦ ἐγένετο;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Ἢ τίς προέδωκεν αὐτῷ,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ἀνταποδοθήσεται αὐτῷ;",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "Ὅτι ἐξ αὐτοῦ καὶ δι᾿ αὐτοῦ καὶ εἰς αὐτὸν τὰ πάντα· αὐτῷ ἡ δόξα εἰς τοὺς αἰῶνας. Ἀμήν."
        ]
      }
    ],
