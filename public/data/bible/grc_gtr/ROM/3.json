    "title": "ΠΑΥΛΟΥ ΤΟΥ ΑΠΟΣΤΟΛΟΥ Η ΠΡΟΣ ΠΡΟΣ ΡΩΜΑΙΟΥΣ",
    "order": 45,
    "numberOfChapters": 16,
    "sha256": "43919de7a36f780214122273bd26f56c1872ac1d630075265049e8b96061a240",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_gtr/ROM/1.json",
    "lastChapterNumber": 16,
    "lastChapterApiLink": "/api/grc_gtr/ROM/16.json",
    "totalNumberOfVerses": 433
  },
  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Τί οὖν τὸ περισσὸν τοῦ Ἰουδαίου, ἢ τίς ἡ ὠφέλεια τῆς περιτομῆς;"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Πολὺ κατὰ πάντα τρόπον· πρῶτον μὲν γὰρ ὅτι ἐπιστεύθησαν τὰ λόγια τοῦ Θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Τί γὰρ εἰ ἠπίστησάν τινες; Μὴ ἡ ἀπιστία αὐτῶν τὴν πίστιν τοῦ Θεοῦ καταργήσει;"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Μὴ γένοιτο· γινέσθω δὲ ὁ Θεὸς ἀληθής, πᾶς δὲ ἄνθρωπος ψεύστης, καθὼς γέγραπται,",
          {
            "lineBreak": true
          },
          {
            "text": "Ὅπως ἂν δικαιωθῇς ἐν τοῖς λόγοις σου,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ νικήσῃς ἐν τῷ κρίνεσθαί σε.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Εἰ δὲ ἡ ἀδικία ἡμῶν Θεοῦ δικαιοσύνην συνίστησι, τί ἐροῦμεν; Μὴ ἄδικος ὁ Θεὸς ὁ ἐπιφέρων τὴν ὀργήν; — κατὰ ἄνθρωπον λέγω —"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Μὴ γένοιτο· ἐπεὶ πῶς κρινεῖ ὁ Θεὸς τὸν κόσμον;"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Εἰ γὰρ ἡ ἀλήθεια τοῦ Θεοῦ ἐν τῷ ἐμῷ ψεύσματι ἐπερίσσευσεν εἰς τὴν δόξαν αὐτοῦ, τί ἔτι κἀγὼ ὡς ἁμαρτωλὸς κρίνομαι;"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Καὶ μή — καθὼς βλασφημούμεθα, καὶ καθώς φασί τινες ἡμᾶς λέγειν — ὅτι Ποιήσωμεν τὰ κακὰ ἵνα ἔλθῃ τὰ ἀγαθά; Ὧν τὸ κρίμα ἔνδικόν ἐστι."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Τί οὖν; Προεχόμεθα; Οὐ πάντως· προῃτιασάμεθα γὰρ Ἰουδαίους τε καὶ Ἕλληνας πάντας ὑφ᾿ ἁμαρτίαν εἶναι,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καθὼς γέγραπται ὅτι",
          {
            "lineBreak": true
          },
          {
            "text": "Οὐκ ἔστι δίκαιος οὐδὲ εἷς·",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "οὐκ ἔστιν ὁ συνιῶν,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "οὐκ ἔστιν ὁ ἐκζητῶν τὸν Θεόν·",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "πάντες ἐξέκλιναν, ἅμα ἠχρειώθησαν·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "οὐκ ἔστι ποιῶν χρηστότητα,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "οὐκ ἔστιν ἕως ἑνός·",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "τάφος ἀνεῳγμένος ὁ λάρυγξ αὐτῶν,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ταῖς γλώσσαις αὐτῶν ἐδολιοῦσαν·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἰὸς ἀσπίδων ὑπὸ τὰ χείλη αὐτῶν·",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "ὧν τὸ στόμα ἀρᾶς καὶ πικρίας γέμει·",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "ὀξεῖς οἱ πόδες αὐτῶν ἐκχέαι αἷμα·",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "σύντριμμα καὶ ταλαιπωρία ἐν ταῖς ὁδοῖς αὐτῶν,",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "καὶ ὁδὸν εἰρήνης οὐκ ἔγνωσαν·",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "οὐκ ἔστι φόβος Θεοῦ ἀπέναντι τῶν ὀφθαλμῶν αὐτῶν.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Οἴδαμεν δὲ ὅτι ὅσα ὁ νόμος λέγει, τοῖς ἐν τῷ νόμῳ λαλεῖ, ἵνα πᾶν στόμα φραγῇ, καὶ ὑπόδικος γένηται πᾶς ὁ κόσμος τῷ Θεῷ·"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "διότι ἐξ ἔργων νόμου οὐ δικαιωθήσεται πᾶσα σὰρξ ἐνώπιον αὐτοῦ· διὰ γὰρ νόμου ἐπίγνωσις ἁμαρτίας."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Νυνὶ δὲ χωρὶς νόμου δικαιοσύνη Θεοῦ πεφανέρωται, μαρτυρουμένη ὑπὸ τοῦ νόμου καὶ τῶν προφητῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "δικαιοσύνη δὲ Θεοῦ διὰ πίστεως Ἰησοῦ Χριστοῦ εἰς πάντας καὶ ἐπὶ πάντας τοὺς πιστεύοντας· οὐ γάρ ἐστι διαστολή·"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "πάντες γὰρ ἥμαρτον καὶ ὑστεροῦνται τῆς δόξης τοῦ Θεοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "δικαιούμενοι δωρεὰν τῇ αὐτοῦ χάριτι διὰ τῆς ἀπολυτρώσεως τῆς ἐν Χριστῷ Ἰησοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ὃν προέθετο ὁ Θεὸς ἱλαστήριον, διὰ τῆς πίστεως, ἐν τῷ αὐτοῦ αἵματι, εἰς ἔνδειξιν τῆς δικαιοσύνης αὐτοῦ, διὰ τὴν πάρεσιν τῶν προγεγονότων ἁμαρτημάτων,"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ἐν τῇ ἀνοχῇ τοῦ Θεοῦ· πρὸς ἔνδειξιν τῆς δικαιοσύνης αὐτοῦ ἐν τῷ νῦν καιρῷ, εἰς τὸ εἶναι αὐτὸν δίκαιον καὶ δικαιοῦντα τὸν ἐκ πίστεως Ἰησοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Ποῦ οὖν ἡ καύχησις; Ἐξεκλείσθη. Διὰ ποίου νόμου; Τῶν ἔργων; Οὐχί, ἀλλὰ διὰ νόμου πίστεως."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Λογιζόμεθα οὖν πίστει δικαιοῦσθαι ἄνθρωπον, χωρὶς ἔργων νόμου."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Ἢ Ἰουδαίων ὁ Θεὸς μόνον; Οὐχὶ δὲ καὶ ἐθνῶν; Ναὶ καὶ ἐθνῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ἐπείπερ εἷς ὁ Θεός, ὃς δικαιώσει περιτομὴν ἐκ πίστεως, καὶ ἀκροβυστίαν διὰ τῆς πίστεως."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "Νόμον οὖν καταργοῦμεν διὰ τῆς πίστεως; Μὴ γένοιτο· ἀλλὰ νόμον ἱστῶμεν."
        ]
      }
    ],
