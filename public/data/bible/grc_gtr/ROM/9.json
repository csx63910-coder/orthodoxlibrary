  "chapter": {
    "number": 9,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἀλήθειαν λέγω ἐν Χριστῷ, οὐ ψεύδομαι, συμμαρτυρούσης μοι τῆς συνειδήσεώς μου ἐν πνεύματι ἁγίῳ,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ὅτι λύπη μοι ἐστὶ μεγάλη, καὶ ἀδιάλειπτος ὀδύνη τῇ καρδίᾳ μου."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Ηὐχόμην γὰρ αὐτὸς ἐγὼ ἀνάθεμα εἶναι ἀπὸ τοῦ Χριστοῦ ὑπὲρ τῶν ἀδελφῶν μου, τῶν συγγενῶν μου κατὰ σάρκα·"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "οἵτινές εἰσιν Ἰσραηλῖται, ὧν ἡ υἱοθεσία καὶ ἡ δόξα καὶ αἱ διαθῆκαι καὶ ἡ νομοθεσία καὶ ἡ λατρεία καὶ αἱ ἐπαγγελίαι,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ὧν οἱ πατέρες, καὶ ἐξ ὧν ὁ Χριστὸς τὸ κατὰ σάρκα, ὁ ὢν ἐπὶ πάντων, Θεὸς εὐλογητὸς εἰς τοὺς αἰῶνας. Ἀμήν."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Οὐχ οἷον δὲ ὅτι ἐκπέπτωκεν ὁ λόγος τοῦ Θεοῦ. Οὐ γὰρ πάντες οἱ ἐξ Ἰσραήλ, οὗτοι Ἰσραήλ·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "οὐδ᾿ ὅτι εἰσὶ σπέρμα Ἀβραάμ, πάντες τέκνα· ἀλλ᾿ Ἐν Ἰσαὰκ κληθήσεταί σοι σπέρμα."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Τοῦτ᾿ ἔστιν, οὐ τὰ τέκνα τῆς σαρκός, ταῦτα τέκνα τοῦ Θεοῦ· ἀλλὰ τὰ τέκνα τῆς ἐπαγγελίας λογίζεται εἰς σπέρμα."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Ἐπαγγελίας γὰρ ὁ λόγος οὗτος, Κατὰ τὸν καιρὸν τοῦτον ἐλεύσομαι, καὶ ἔσται τῇ Σάρρᾳ υἱός."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Οὐ μόνον δέ, ἀλλὰ καὶ Ῥεβέκκα ἐξ ἑνὸς κοίτην ἔχουσα, Ἰσαὰκ τοῦ πατρὸς ἡμῶν —"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "μήπω γὰρ γεννηθέντων, μηδὲ πραξάντων τι ἀγαθὸν ἢ κακόν, ἵνα ἡ κατ᾿ ἐκλογὴν τοῦ Θεοῦ πρόθεσις μένῃ, οὐκ ἐξ ἔργων, ἀλλ᾿ ἐκ τοῦ καλοῦντος,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ἐρρήθη αὐτῇ ὅτι Ὁ μείζων δουλεύσει τῷ ἐλάσσονι."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Καθὼς γέγραπται, Τὸν Ἰακὼβ ἠγάπησα, τὸν δὲ Ἠσαῦ ἐμίσησα."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Τί οὖν ἐροῦμεν; Μὴ ἀδικία παρὰ τῷ Θεῷ; Μὴ γένοιτο."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Τῷ γὰρ Μωσῇ λέγει, Ἐλεήσω ὃν ἂν ἐλεῶ, καὶ οἰκτειρήσω ὃν ἂν οἰκτείρω."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Ἄρα οὖν οὐ τοῦ θέλοντος, οὐδὲ τοῦ τρέχοντος, ἀλλὰ τοῦ ἐλεοῦντος Θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Λέγει γὰρ ἡ γραφὴ τῷ Φαραὼ ὅτι Εἰς αὐτὸ τοῦτο ἐξήγειρά σε, ὅπως ἐνδείξωμαι ἐν σοὶ τὴν δύναμίν μου, καὶ ὅπως διαγγελῇ τὸ ὄνομά μου ἐν πάσῃ τῇ γῇ."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Ἄρα οὖν ὃν θέλει ἐλεεῖ· ὃν δὲ θέλει σκληρύνει."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Ἐρεῖς οὖν μοι, Τί ἔτι μέμφεται; Τῷ",
          {
            "noteId": 4
          },
          "γὰρ βουλήματι αὐτοῦ τίς ἀνθέστηκε;"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Μενοῦνγε, ὦ ἄνθρωπε, σὺ τίς εἶ ὁ ἀνταποκρινόμενος τῷ Θεῷ; Μὴ ἐρεῖ τὸ πλάσμα τῷ πλάσαντι, Τί με ἐποίησας οὕτως;"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Ἢ οὐκ ἔχει ἐξουσίαν ὁ κεραμεὺς τοῦ πηλοῦ, ἐκ τοῦ αὐτοῦ φυράματος ποιῆσαι ὃ μὲν εἰς τιμὴν σκεῦος, ὃ δὲ εἰς ἀτιμίαν;"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Εἰ δὲ θέλων ὁ Θεὸς ἐνδείξασθαι τὴν ὀργήν, καὶ γνωρίσαι τὸ δυνατὸν αὐτοῦ, ἤνεγκεν ἐν πολλῇ μακροθυμίᾳ σκεύη ὀργῆς κατηρτισμένα εἰς ἀπώλειαν·"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "καὶ ἵνα γνωρίσῃ τὸν πλοῦτον τῆς δόξης αὐτοῦ ἐπὶ σκεύη ἐλέους, ἃ προητοίμασεν εἰς δόξαν,"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "οὓς καὶ ἐκάλεσεν ἡμᾶς οὐ μόνον ἐξ Ἰουδαίων, ἀλλὰ καὶ ἐξ ἐθνῶν;"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Ὡς καὶ ἐν τῷ Ὡσηὲ λέγει,",
          {
            "lineBreak": true
          },
          {
            "text": "Καλέσω τὸν οὐ λαόν μου λαόν μου·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ τὴν οὐκ ἠγαπημένην ἠγαπημένην.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Καὶ ἔσται, ἐν τῷ τόπῳ οὗ ἐρρήθη αὐτοῖς, Οὐ λαός μου ὑμεῖς,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἐκεῖ κληθήσονται υἱοὶ Θεοῦ ζῶντος.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Ἠσαΐας δὲ κράζει ὑπὲρ τοῦ Ἰσραήλ,",
          {
            "lineBreak": true
          },
          {
            "text": "Ἐὰν ᾖ ὁ ἀριθμὸς τῶν υἱῶν Ἰσραὴλ ὡς ἡ ἄμμος τῆς θαλάσσης,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "τὸ κατάλειμμα σωθήσεται·",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "λόγον γὰρ συντελῶν καὶ συντέμνων ἐν δικαιοσύνῃ·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ὅτι λόγον συντετμημένον ποιήσει Κύριος ἐπὶ τῆς γῆς.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Καὶ καθὼς προείρηκεν Ἠσαΐας,",
          {
            "lineBreak": true
          },
          {
            "text": "Εἰ μὴ Κύριος Σαβαὼθ ἐγκατέλιπεν ἡμῖν σπέρμα,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ὡς Σόδομα ἂν ἐγενήθημεν,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ ὡς Γόμορρα ἂν ὡμοιώθημεν.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Τί οὖν ἐροῦμεν; Ὅτι ἔθνη τὰ μὴ διώκοντα δικαιοσύνην, κατέλαβε δικαιοσύνην, δικαιοσύνην δὲ τὴν ἐκ πίστεως·"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "Ἰσραὴλ δέ, διώκων νόμον δικαιοσύνης, εἰς νόμον δικαιοσύνης οὐκ ἔφθασε."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Διὰ τί; Ὅτι οὐκ ἐκ πίστεως, ἀλλ᾿ ὡς ἐξ ἔργων νόμου· προσέκοψαν γὰρ τῷ λίθῳ τοῦ προσκόμματος,"
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "καθὼς γέγραπται,",
          {
            "lineBreak": true
          },
          {
            "text": "Ἰδοὺ τίθημι ἐν Σιὼν λίθον προσκόμματος καὶ πέτραν σκανδάλου·",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ πᾶς ὁ πιστεύων ἐπ᾿ αὐτῷ οὐ καταισχυνθήσεται.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
