  "chapter": {
    "number": 10,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἀδελφοί, ἡ μὲν εὐδοκία τῆς ἐμῆς καρδίας καὶ ἡ δέησις ἡ πρὸς τὸν Θεὸν ὑπὲρ τοῦ Ἰσραήλ ἐστιν εἰς σωτηρίαν."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Μαρτυρῶ γὰρ αὐτοῖς ὅτι ζῆλον Θεοῦ ἔχουσιν, ἀλλ᾿ οὐ κατ᾿ ἐπίγνωσιν."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Ἀγνοοῦντες γὰρ τὴν τοῦ Θεοῦ δικαιοσύνην, καὶ τὴν ἰδίαν δικαιοσύνην ζητοῦντες στῆσαι, τῇ δικαιοσύνῃ τοῦ Θεοῦ οὐχ ὑπετάγησαν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Τέλος γὰρ νόμου Χριστὸς εἰς δικαιοσύνην παντὶ τῷ πιστεύοντι."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Μωσῆς γὰρ γράφει τὴν δικαιοσύνην τὴν ἐκ τοῦ νόμου, ὅτι ὁ ποιήσας αὐτὰ ἄνθρωπος ζήσεται ἐν αὐτοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ἡ δὲ ἐκ πίστεως δικαιοσύνη οὕτω λέγει, Μὴ εἴπῃς ἐν",
          {
            "noteId": 5
          },
          "τῇ καρδίᾳ σου, Τίς ἀναβήσεται εἰς τὸν οὐρανόν; — τοῦτ᾿ ἔστι Χριστὸν καταγαγεῖν —"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἤ, Τίς καταβήσεται εἰς τὴν ἄβυσσον; — τοῦτ᾿ ἔστι Χριστὸν ἐκ νεκρῶν ἀναγαγεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Ἀλλὰ τί λέγει; Ἐγγύς σου τὸ ῥῆμά ἐστιν, ἐν τῷ στόματί σου καὶ ἐν τῇ καρδίᾳ σου· τοῦτ᾿ ἔστι τὸ ῥῆμα τῆς πίστεως ὃ κηρύσσομεν·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ὅτι ἐὰν ὁμολογήσῃς ἐν τῷ στόματί σου Κύριον Ἰησοῦν, καὶ πιστεύσῃς ἐν τῇ καρδίᾳ σου ὅτι ὁ Θεὸς αὐτὸν ἤγειρεν ἐκ νεκρῶν, σωθήσῃ·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καρδίᾳ γὰρ πιστεύεται εἰς δικαιοσύνην, στόματι δὲ ὁμολογεῖται εἰς σωτηρίαν."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Λέγει γὰρ ἡ γραφή, Πᾶς ὁ πιστεύων ἐπ᾿ αὐτῷ οὐ καταισχυνθήσεται."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Οὐ γάρ ἐστι διαστολὴ Ἰουδαίου τε καὶ Ἕλληνος· ὁ γὰρ αὐτὸς Κύριος πάντων, πλουτῶν εἰς πάντας τοὺς ἐπικαλουμένους αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Πᾶς γὰρ ὃς ἂν ἐπικαλέσηται τὸ ὄνομα Κυρίου σωθήσεται."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Πῶς οὖν ἐπικαλέσονται εἰς ὃν οὐκ ἐπίστευσαν; Πῶς δὲ πιστεύσουσιν οὗ οὐκ ἤκουσαν; Πῶς δὲ ἀκούσουσι χωρὶς κηρύσσοντος;"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Πῶς δὲ κηρύξουσιν ἐὰν μὴ ἀποσταλῶσι; Καθὼς γέγραπται, Ὡς ὡραῖοι οἱ πόδες τῶν εὐαγγελιζομένων εἰρήνην, τῶν εὐαγγελιζομένων τὰ ἀγαθά."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Ἀλλ᾿ οὐ πάντες ὑπήκουσαν τῷ εὐαγγελίῳ. Ἠσαΐας γὰρ λέγει, Κύριε, τίς ἐπίστευσε τῇ ἀκοῇ ἡμῶν;"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Ἄρα ἡ πίστις ἐξ ἀκοῆς, ἡ δὲ ἀκοὴ διὰ ῥήματος Θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Ἀλλὰ λέγω, μὴ οὐκ ἤκουσαν; Μενοῦνγε·",
          {
            "lineBreak": true
          },
          {
            "text": "Εἰς πᾶσαν τὴν γῆν ἐξῆλθεν ὁ φθόγγος αὐτῶν,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "καὶ εἰς τὰ πέρατα τῆς οἰκουμένης τὰ ῥήματα αὐτῶν.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Ἀλλὰ λέγω, μὴ οὐκ ἔγνω Ἰσραήλ; Πρῶτος Μωσῆς λέγει,",
          {
            "lineBreak": true
          },
          {
            "text": "Ἐγὼ παραζηλώσω ὑμᾶς ἐπ᾿ οὐκ ἔθνει,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἐπὶ ἔθνει ἀσυνέτῳ παροργιῶ ὑμᾶς.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Ἠσαΐας δὲ ἀποτολμᾷ καὶ λέγει,",
          {
            "lineBreak": true
          },
          {
            "text": "Εὑρέθην τοῖς ἐμὲ μὴ ζητοῦσιν,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "ἐμφανὴς ἐγενόμην τοῖς ἐμὲ μὴ ἐπερωτῶσι.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Πρὸς δὲ τὸν Ἰσραὴλ λέγει, Ὅλην τὴν ἡμέραν ἐξεπέτασα τὰς χεῖράς μου πρὸς λαὸν ἀπειθοῦντα καὶ ἀντιλέγοντα."
        ]
      }
    ],
