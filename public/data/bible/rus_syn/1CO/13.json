    "commonName": "Первое послание к Коринфянам",
    "title": "Первое послание к Коринфянам",
    "order": 46,
    "numberOfChapters": 16,
    "sha256": "dda0262e9cdcfed9887f90813bba5af472b520b60bfc128fda17db32a0af9b22",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/rus_syn/1CO/1.json",
