    "name": "Притчи Соломона",
    "commonName": "Притчи Соломона",
    "title": "Притчи Соломона",
    "order": 20,
    "numberOfChapters": 31,
    "sha256": "1466b3c74443397d1e286801516bf74c481b5f7bd2ef148fde9699b41dfe7cac",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/rus_syn/PRO/1.json",
    "lastChapterNumber": 31,
    "lastChapterApiLink": "/api/rus_syn/PRO/31.json",
    "totalNumberOfVerses": 918
  },
  "chapter": {
    "number": 17,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Лучше кусок сухого хлеба, и с ним мир, нежели дом, полный заколотого скота, с раздором.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Разумный раб господствует над беспутным сыном и между братьями разделит наследство.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Плавильня - для серебра, и горнило - для золота, а сердца испытывает Господь.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Злодей внимает устам беззаконным, лжец слушается языка пагубного.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Кто ругается над нищим, тот хулит Творца его; кто радуется несчастью, тот не останется ненаказанным.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Венец стариков - сыновья сыновей, и слава детей - родители их.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Неприлична глупому важная речь, тем паче знатному - уста лживые.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Подарок - драгоценный камень в глазах владеющего им: куда ни обратится он, успеет.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Прикрывающий проступок ищет любви; а кто снова напоминает о нем, тот удаляет друга.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "На разумного сильнее действует выговор, нежели на глупого сто ударов.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Возмутитель ищет только зла; поэтому жестокий ангел будет послан против него.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Лучше встретить человеку медведицу, лишенную детей, нежели глупца с его глупостью.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Кто за добро воздает злом, от дома того не отойдет зло.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Начало ссоры - как прорыв воды; оставь ссору прежде, нежели разгорелась она.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Оправдывающий нечестивого и обвиняющий праведного - оба мерзость пред Господом.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "К чему сокровище в руках глупца? Для приобретения мудрости у него нет разума.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Друг любит во всякое время и, как брат, явится во время несчастья.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Человек малоумный дает руку и ручается за ближнего своего.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Кто любит ссоры, любит грех, и кто высоко поднимает ворота свои, тот ищет падения.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Коварное сердце не найдет добра, и лукавый язык попадет в беду.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Родил кто глупого, - себе на горе, и отец глупого не порадуется.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Веселое сердце благотворно, как врачевство, а унылый дух сушит кости.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Нечестивый берет подарок из пазухи, чтобы извратить пути правосудия.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Мудрость - пред лицoм у разумного, а глаза глупца - на конце земли.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Глупый сын - досада отцу своему и огорчение для матери своей.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Нехорошо и обвинять правого, и бить вельмож за правду.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Разумный воздержан в словах своих, и благоразумный хладнокровен.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "И глупец, когда молчит, может показаться мудрым, и затворяющий уста свои - благоразумным.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
