    "name": "Книга Иова",
    "commonName": "Книга Иова",
    "title": "Книга Иова",
    "order": 18,
    "numberOfChapters": 42,
    "sha256": "6e81b8d8d66ff48101827d6560c2e589699807c01aa3556d1df778d0f33ac62d",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/rus_syn/JOB/1.json",
