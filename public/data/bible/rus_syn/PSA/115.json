  "chapter": {
    "number": 115,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Аллилуия."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Я веровал, и потому говорил: я сильно сокрушен.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Я сказал в опрометчивости моей: всякий человек ложь.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Что воздам Господу за все благодеяния Его ко мне?",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Чашу спасения прииму и имя Господне призову.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Обеты мои воздам Господу пред всем народом Его.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Дорога в очах Господних смерть святых Его!",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "О, Господи! я раб Твой, я раб Твой и сын рабы Твоей; Ты разрешил узы мои.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Тебе принесу жертву хвалы, и имя Господне призову.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Обеты мои воздам Господу пред всем народом Его,",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "во дворах дома Господня, посреди тебя, Иерусалим! Аллилуия.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
