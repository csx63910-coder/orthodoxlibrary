  "chapter": {
    "number": 133,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Песнь восхождения."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Благословите ныне Господа, все рабы Господни, стоящие в доме Господнем, во дворах дома Бога нашего, во время ночи.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Воздвигните руки ваши к святилищу, и благословите Господа.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Благословит тебя Господь с Сиона, сотворивший небо и землю.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
