    "id": "PSA",
    "translationId": "rus_syn",
    "name": "Псалтырь",
    "commonName": "Псалтырь",
    "title": "Псалтырь",
    "order": 19,
    "numberOfChapters": 150,
    "sha256": "e62d3dc6e880ec6e368dddb5c78ada932240d86d48b244417ae5c8951145dcf8",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/rus_syn/PSA/1.json",
    "lastChapterNumber": 150,
    "lastChapterApiLink": "/api/rus_syn/PSA/150.json",
    "totalNumberOfVerses": 2526
  },
  "chapter": {
    "number": 32,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Радуйтесь, праведные, о Господе: правым прилично славословить.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Славьте Господа на гуслях, пойте Ему на десятиструнной псалтири;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "пойте Ему новую песнь; пойте Ему стройно, с восклицанием,",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "ибо слово Господне право и все дела Его верны.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Он любит правду и суд; милости Господней полна земля.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Словом Господа сотворены небеса, и духом уст Его - все воинство их:",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Он собрал, будто груды, морские воды, положил бездны в хранилищах.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Да боится Господа вся земля; да трепещут пред Ним все живущие во вселенной,",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "ибо Он сказал, - и сделалось; Он повелел, - и явилось.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Господь разрушает советы язычников, уничтожает замыслы народов.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Совет же Господень стоит вовек; помышления сердца Его - в род и род.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Блажен народ, у которого Господь есть Бог, племя, которое Он избрал в наследие Себе.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "С небес призирает Господь, видит всех сынов человеческих;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "с престола, на котором восседает, Он призирает на всех, живущих на земле:",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Он создал сердца всех их и вникает во все дела их.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Не спасется царь множеством воинства; исполина не защитит великая сила.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ненадежен конь для спасения, не избавит великою силою своею.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Вот, око Господне над боящимися Его и уповающими на милость Его,",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "что Он душу их спасет от смерти и во время голода пропитает их.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Душа наша уповает на Господа: Он - помощь наша и защита наша;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "о Нем веселится сердце наше, ибо на святое имя Его мы уповали.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Да будет милость Твоя, Господи, над нами, как мы уповаем на Тебя.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
