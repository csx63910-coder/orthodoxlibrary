    "name": "Псалтырь",
    "commonName": "Псалтырь",
    "title": "Псалтырь",
    "order": 19,
    "numberOfChapters": 150,
    "sha256": "e62d3dc6e880ec6e368dddb5c78ada932240d86d48b244417ae5c8951145dcf8",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/rus_syn/PSA/1.json",
    "lastChapterNumber": 150,
    "lastChapterApiLink": "/api/rus_syn/PSA/150.json",
    "totalNumberOfVerses": 2526
  },
  "chapter": {
    "number": 110,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Аллилуия."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Славлю Тебя, Господи, всем сердцем моим в совете праведных и в собрании.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Велики дела Господни, вожделенны для всех, любящих оные.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Дело Его - слава и красота, и правда Его пребывает вовек.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Памятными соделал Он чудеса Свои; милостив и щедр Господь.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Пищу дает боящимся Его; вечно помнит завет Свой.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Силу дел Своих явил Он народу Своему, чтобы дать ему наследие язычников.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Дела рук Его - истина и суд; все заповеди Его верны,",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "тверды на веки и веки, основаны на истине и правоте.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Избавление послал Он народу Своему; заповедал на веки завет Свой. Свято и страшно имя Его!",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Начало мудрости - страх Господень; разум верный у всех, исполняющих заповеди Его. Хвала Ему пребудет вовек",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
