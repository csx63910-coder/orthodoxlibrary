  "chapter": {
    "number": 119,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Песнь восхождения."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "К Господу воззвал я в скорби моей, и Он услышал меня.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Господи! избавь душу мою от уст лживых, от языка лукавого.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Что даст тебе и что прибавит тебе язык лукавый?",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Изощренные стрелы сильного, с горящими углями дроковыми.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Горе мне, что я пребываю у Мосоха, живу у шатров Кидарских.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Долго жила душа моя с ненавидящими мир.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Я мирен: но только заговорю, они - к войне.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
