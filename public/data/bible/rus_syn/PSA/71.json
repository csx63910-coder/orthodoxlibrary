  "book": {
    "id": "PSA",
    "translationId": "rus_syn",
    "name": "Псалтырь",
    "commonName": "Псалтырь",
    "title": "Псалтырь",
    "order": 19,
    "numberOfChapters": 150,
    "sha256": "e62d3dc6e880ec6e368dddb5c78ada932240d86d48b244417ae5c8951145dcf8",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/rus_syn/PSA/1.json",
    "lastChapterNumber": 150,
    "lastChapterApiLink": "/api/rus_syn/PSA/150.json",
    "totalNumberOfVerses": 2526
  },
  "chapter": {
    "number": 71,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "О Соломоне."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Боже! даруй царю Твой суд и сыну царя Твою правду,",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "да судит праведно людей Твоих и нищих Твоих на суде;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "да принесут горы мир людям и холмы правду;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "да судит нищих народа, да спасет сынов убогого и смирит притеснителя, -",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "и будут бояться Тебя, доколе пребудут солнце и луна, в роды родов.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Он сойдет, как дождь на скошенный луг, как капли, орошающие землю;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "во дни его процветет праведник, и будет обилие мира, доколе не престанет луна;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "он будет обладать от моря до моря и от реки до концов земли;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "падут пред ним жители пустынь, и враги его будут лизать прах;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "цари Фарсиса и островов поднесут ему дань; цари Аравии и Савы принесут дары;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "и поклонятся ему все цари; все народы будут служить ему;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "ибо он избавит нищего, вопиющего и угнетенного, у которого нет помощника.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Будет милосерд к нищему и убогому, и души убогих спасет;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "от коварства и насилия избавит души их, и драгоценна будет кровь их пред очами его;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "и будет жить, и будут давать ему от золота Аравии, и будут молиться о нем непрестанно, всякий день благословлять его;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "будет обилие хлеба на земле, наверху гор; плоды его будут волноваться, как лес на Ливане, и в городах размножатся люди, как трава на земле;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "будет имя его вовек; доколе пребывает солнце, будет передаваться имя его; и благословятся в нем племена, все народы ублажат его.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Благословен Господь Бог, Бог Израилев, един творящий чудеса,",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "и благословенно имя славы Его вовек, и наполнится славою Его вся земля. Аминь и аминь.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Кончились молитвы Давида, сына Иесеева.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
