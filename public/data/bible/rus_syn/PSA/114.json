  "chapter": {
    "number": 114,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Аллилуия."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Я радуюсь, что Господь услышал голос мой, моление мое;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "приклонил ко мне ухо Свое, и потому буду призывать Его во все дни мои.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Объяли меня болезни смертные, муки адские постигли меня; я встретил тесноту и скорбь.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Тогда призвал я имя Господне: Господи! избавь душу мою.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Милостив Господь и праведен, и милосерд Бог наш.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Хранит Господь простодушных: я изнемог, и Он помог мне.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Возвратись, душа моя, в покой твой, ибо Господь облагодетельствовал тебя.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ты избавил душу мою от смерти, очи мои от слез и ноги мои от преткновения.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Буду ходить пред лицем Господним на земле живых.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
