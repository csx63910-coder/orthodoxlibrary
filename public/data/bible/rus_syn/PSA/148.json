    "name": "Псалтырь",
    "commonName": "Псалтырь",
    "title": "Псалтырь",
    "order": 19,
    "numberOfChapters": 150,
    "sha256": "e62d3dc6e880ec6e368dddb5c78ada932240d86d48b244417ae5c8951145dcf8",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/rus_syn/PSA/1.json",
    "lastChapterNumber": 150,
    "lastChapterApiLink": "/api/rus_syn/PSA/150.json",
    "totalNumberOfVerses": 2526
  },
  "chapter": {
    "number": 148,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Аллилуия."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Хвалите Господа с небес, хвалите Его в вышних.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Хвалите Его, все Ангелы Его, хвалите Его, все воинства Его.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Хвалите Его, солнце и луна, хвалите Его, все звезды света.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Хвалите Его, небеса небес и воды, которые превыше небес.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Да хвалят имя Господа, ибо Он сказал, и они сделались, повелел, и сотворились;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "поставил их на веки и веки; дал устав, который не прейдет.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Хвалите Господа от земли, великие рыбы и все бездны,",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "огонь и град, снег и туман, бурный ветер, исполняющий слово Его,",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "горы и все холмы, дерева плодоносные и все кедры,",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "звери и всякий скот, пресмыкающиеся и птицы крылатые,",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "цари земные и все народы, князья и все судьи земные,",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "юноши и девицы, старцы и отроки",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "да хвалят имя Господа, ибо имя Его единого превознесенно, слава Его на земле и на небесах.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Он возвысил рог народа Своего, славу всех святых Своих, сынов Израилевых, народа, близкого к Нему. Аллилуия.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
