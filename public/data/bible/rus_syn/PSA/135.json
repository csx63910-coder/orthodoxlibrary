    "name": "Псалтырь",
    "commonName": "Псалтырь",
    "title": "Псалтырь",
    "order": 19,
    "numberOfChapters": 150,
    "sha256": "e62d3dc6e880ec6e368dddb5c78ada932240d86d48b244417ae5c8951145dcf8",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/rus_syn/PSA/1.json",
    "lastChapterNumber": 150,
    "lastChapterApiLink": "/api/rus_syn/PSA/150.json",
    "totalNumberOfVerses": 2526
  },
  "chapter": {
    "number": 135,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Аллилуия."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Славьте Господа, ибо Он благ, ибо вовек милость Его.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Славьте Бога богов, ибо вовек милость Его.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Славьте Господа господствующих, ибо вовек милость Его;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Того, Который один творит чудеса великие, ибо вовек милость Его;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Который сотворил небеса премудро, ибо вовек милость Его;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "утвердил землю на водах, ибо вовек милость Его;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "сотворил светила великие, ибо вовек милость Его;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "солнце - для управления днем, ибо вовек милость Его;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "луну и звезды - для управления ночью, ибо вовек милость Его;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "поразил Египет в первенцах его, ибо вовек милость Его;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "и вывел Израиля из среды его, ибо вовек милость Его;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "рукою крепкою и мышцею простертою, ибо вовек милость Его;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "разделил Чермное море, ибо вовек милость Его;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "и провел Израиля посреди его, ибо вовек милость Его;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "и низверг фараона и войско его в море Чермное, ибо вовек милость Его;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "провел народ Свой чрез пустыню, ибо вовек милость Его;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "поразил царей великих, ибо вовек милость Его;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "и убил царей сильных, ибо вовек милость Его;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Сигона, царя Аморрейского, ибо вовек милость Его;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "и Ога, царя Васанского, ибо вовек милость Его;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "и отдал землю их в наследие, ибо вовек милость Его;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "в наследие Израилю, рабу Своему, ибо вовек милость Его;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "вспомнил нас в унижении нашем, ибо вовек милость Его;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "и избавил нас от врагов наших, ибо вовек милость Его;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "дает пищу всякой плоти, ибо вовек милость Его.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Славьте Бога небес, ибо вовек милость Его.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
