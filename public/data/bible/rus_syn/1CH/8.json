    "name": "Первая книга Паралипоменон",
    "commonName": "Первая книга Паралипоменон",
    "title": "Первая книга Паралипоменон",
    "order": 13,
    "numberOfChapters": 29,
    "sha256": "720d13fea97a4ae7a539fd861792776a4141450d33d360ae5dea8ca2fb6a1ae6",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/rus_syn/1CH/1.json",
    "lastChapterNumber": 29,
    "lastChapterApiLink": "/api/rus_syn/1CH/29.json",
    "totalNumberOfVerses": 942
  },
  "chapter": {
    "number": 8,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Вениамин родил Белу, первенца своего, второго Ашбела, третьего Ахрая,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "четвертого Ноху и пятого Рафу."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Сыновья Белы были: Аддар, Гера, Авиуд,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Авишуа, Нааман, Ахоах,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Гера, Шефуфан и Хурам."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "И вот сыновья Егуда, которые были главами родов, живших в Геве и переселенных в Манахаф:"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Нааман, Ахия и Гера, который переселил их; он родил Уззу и Ахихуда."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Шегараим родил детей в земле Моавитской после того, как отпустил от себя Хушиму и Баару, жен своих."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "И родил он от Ходеши, жены своей, Иовава, Цивию, Мешу, Малхама,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Иеуца, Шахию и Мирму: вот сыновья его, главы поколений."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "От Хушимы родил он Авитува и Елпаала."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Сыновья Елпаала: Евер, Мишам и Шемер, который построил Оно и Лод и зависящие от него города,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "и Берия и Шема. Они были главами поколений жителей Аиалона. Они выгнали жителей Гефа."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Ахио, Шашак, Иремоф,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Зевадия, Арад, Едер,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Михаил, Ишфа и Иоха - сыновья Берии."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Зевадия, Мешуллам, Хизкий, Хевер,"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Ишмерай, Излия и Иовав - сыновья Елпаала."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Иаким, Зихрий, Завдий,"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Елиенай, Цилфай, Елиил,"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Адаия, Бераия и Шимраф - сыновья Шимея."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Ишпан, Евер, Елиил,"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Авдон, Зихрий, Ханан,"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Ханания, Елам, Антофия,"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Ифдия и Фенуил - сыновья Шашака."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Шамшерай, Шехария, Афалия,"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Иаарешия, Елия и Зихрий, сыновья Иерохама."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Это главы поколений, в родах своих главные. Они жили в Иерусалиме."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "В Гаваоне жили: Иеил, отец Гаваонитян, - имя жены его Мааха,"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "и сын его, первенец Авдон, за ним Цур, Кис, Ваал, Надав, Нер,"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "Гедор, Ахио, Зехер и Миклоф."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Миклоф родил Шимея. И они подле братьев своих жили в Иерусалиме, вместе с братьями своими."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "Нер родил Киса; Кис родил Саула; Саул родил Иоанафана, Мелхисуя, Авинадава и Ешбаала."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "Сын Ионафана Мериббаал; Мериббаал родил Миху."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "Сыновья Михи: Пифон, Мелег, Фаарея и Ахаз."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "Ахаз родил Иоиадду; Иоиадда родил Алемефа, Азмавефа и Замврия; Замврий родил Моцу;"
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "Моца родил Бинею. Рефаия, сын его; Елеаса, сын его; Ацел, сын его."
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "У Ацела шесть сыновей, и вот имена их: Азрикам, Бохру, Исмаил, Шеария, Овадия и Ханан; все они сыновья Ацела."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "Сыновья Ешека, брата его: Улам, первенец его, второй Иеуш, третий Елифелет."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "Сыновья Улама были люди воинственные, стрелявшие из лука, имевшие много сыновей и внуков: сто пятьдесят. Все они от сынов Вениамина."
        ]
      }
    ],
