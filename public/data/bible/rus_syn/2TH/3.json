    "order": 53,
    "numberOfChapters": 3,
    "sha256": "62967839f505a0514713bf3a98a8652df1775296f2840e560508a100cf34314e",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/rus_syn/2TH/1.json",
