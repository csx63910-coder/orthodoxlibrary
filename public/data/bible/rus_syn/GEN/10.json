    "title": "Бытие",
    "order": 1,
    "numberOfChapters": 50,
    "sha256": "8e99c2ec6b047e2147b1ef56bc52da6ecd6eb5c97148b533b9725620fcd04223",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/rus_syn/GEN/1.json",
