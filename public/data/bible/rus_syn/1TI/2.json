    "order": 54,
    "numberOfChapters": 6,
    "sha256": "631f1012cf71aa1f6de965f9e8721e0b69752491c0a0a093a829ae8c2c42451a",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/rus_syn/1TI/1.json",
