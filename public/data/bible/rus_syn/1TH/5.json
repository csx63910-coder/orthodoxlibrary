    "commonName": "Первое послание к Фессалоникийцам",
    "title": "Первое послание к Фессалоникийцам",
    "order": 52,
    "numberOfChapters": 5,
    "sha256": "ec0358e9c51a2a6b99ad27eea3d45096f8ed815648fd7bc777ee3347cdeb18ac",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/rus_syn/1TH/1.json",
