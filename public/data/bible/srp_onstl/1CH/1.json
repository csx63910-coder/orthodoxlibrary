  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "heading",
        "content": [
          "Od Adama do Avrahama"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Nojevi potomci"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Adam, Sit, Enos,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Kajinan, Maleleilo, Jared,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Enoh, Matusal, Lameh,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Nojevi sinovi",
          {
            "noteId": 0
          },
          ": Sim, Ham i Jafet."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Jafetovi potomci"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Jafetovi sinovi su: Gomer, Magog, Midij, Javan, Tuval, Meseh i Tiras."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Gomerovi sinovi su: Ashenas, Rifat i Togarma."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Javanovi sinovi su: Elisa i Tarsis, Kitim i Dodanim."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Hamovi potomci"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Hamovi sinovi su: Kuš i Misraim, Fut i Hanan."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Kušovi sinovi su: Seva, Evila, Savata, Regma i Savataka. Regmini sinovi su: Sava i Dedan."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Kušu se rodio Nevrod. Ovaj je postao prvi moćnik na zemlji."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Od Misraima su, pak, potekli Ludejci, Enemejci, Lavejci i Naftuhijci,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "pa Patrošani, Haslonjani (od kojih su potekli Filistejci) i Kaftoreji."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Hananu se rodio Sidon, njegov prvenac i Het."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Od Hanana vode poreklo Jevusejci, Amorejci, Gergešani,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Evejci, Arukejci, Sinijci,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Arvađani, Samarjani i Amaćani."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Simovi potomci"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Simovi sinovi: Elam, Asur, Arfaksad, Lud i Aram. A Aramovi potomci su: Uz, Ul, Geter i Meseh."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Arfaksadu se, pak, rodio Sala, a Sali Ever."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Everu su se rodila dva sina: jedan se zvao Falek, jer su se za vreme njegovog života ljudi na zemlji podelili",
          {
            "noteId": 1
          },
          "; a njegov brat se zvao Jektan."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Jektanu su se rodili Elmodad, Salef, Acarmavet i Jarah,"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Adoram, Uzal, Dikla,"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Eval, Avimail, Sava,"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Ofir, Evila i Jovav; svi ovi su bili Jektanovi sinovi."
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Sim, Arfaksad, Sala,"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Ever, Falek, Ragav,"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Seruh, Nahor, Tara,"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Avram, to jest, Avraham."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Od Avrahama do Jakova"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Sinovi Avrahamovi: Isak i Ismailo."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Agarini potomci"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Ovo je njihov rodoslov: Ismailov prvenac Navajot, pa Kedar, Avdeilo, Mivsam,"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Mišma, Duma, Masa, Hadad, Tema,"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "Jetur, Nafis i Kedma; to su sinovi Ismailovi."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Heturini potomci"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "A sinovi Heture, Avrahamove inoče: ona je rodila Zomrana, Joksana, Madana, Madijana, Jesvoka i Soijena. A Joksanovi sinovi su: Sava i Dedan."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "Madijanovi sinovi su: Gefa, Afir, Enoh, Avida i Eldaga. Sve su ovo Heturini potomci."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Sarini potomci"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "Avrahamu se rodio Isak; a sinovi Isakovi su bili Isav i Izrailj."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Isavovi potomci"
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "Isavovi sinovi: Elifas, Raguilo, Jeus, Jeglom i Korej."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "Sinovi Elifasovi: Teman, Omar, Sofar, Gotom, Kenez, Tamna i Amalik."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "Sinovi Raguilovi: Nahat, Zara, Šama i Moze."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Sirovi potomci"
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "Sirovi sinovi: Lotan, Soval, Sevegon, Ana, Dison, Asar i Disan."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "Lotanovi sinovi: Horije i Eman. Lotanova sestra je bila Tamna."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "Sinovi Sovalovi: Golam, Manahat, Eval, Šefija i Onam. Sinovi Sevegonovi: Aja i Ana."
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "Sinovi Anini: Dison. Disonovi sinovi: Amada, Asvan, Itran i Haran."
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "Sinovi Asarovi: Valan, Zavan i Jakan. Sinovi Disonovi: Uz i Aran."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Vladari Edoma"
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "A ovo su carevi koji su vladali u zemlji Edom, pre nego što je i jedan car zavladao nad izrailjskim narodom: Valak, Veorov sin, čiji grad se zvao Denava."
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "Kad je Valak umro, na njegovo mesto se zacario Jovav, sin Zarin iz Vosore."
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "Kad je Jovav umro, na njegovo mesto se zacario Asom iz zemlje Temanaca."
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "Kad je Asom umro, na njegovo mesto se zacario Adad, Varadov sin, koji je potukao Madijance na moavskom polju. Njegov grad se zvao Avit."
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          "Kad je Adad umro, na njegovo mesto se zacario Samala iz Masreke."
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          "Kad je Samala umro, na njegovo mesto se zacario Saul iz Rovota na Reci."
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          "Kad je Saul umro, na njegovo mesto se zacario Valenon, sin Ahvorov."
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          "Kad je Valenon umro, na njegovo mesto se zacario Adad. Njegov grad se zvao Pau. Njegovoj ženi je bilo ime Metaveila, koja je bila ćerka Matraide, ćerke Mezahavove."
        ]
      },
      {
        "type": "verse",
        "number": 51,
        "content": [
          "A kad je umro Adad, nastali su knezovi u Edomu: Tamna, Gola, Jetet,"
        ]
      },
      {
        "type": "verse",
        "number": 52,
        "content": [
          "Olivema, Ila, Finon,"
        ]
      },
      {
        "type": "verse",
        "number": 53,
        "content": [
          "Kenez, Teman, Mivsar,"
        ]
      },
      {
        "type": "verse",
        "number": 54,
        "content": [
          "Magedilo i Iram. To su bili edomski knezovi."
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 0,
        "caller": "+",
        "text": "1,4 Prema Septuaginti.",
        "reference": {
          "chapter": 1,
          "verse": 4
        }
      },
      {
        "noteId": 1,
        "caller": "+",
        "text": "1,19 Podelili se najverovatnije odnosi na podelu koja je nastala u toku gradnje Vavilonske kule. Tom prilikom je Bog pobrkao jezike, nakon čega su se ljudi rasejali po celoj zemlji.",
        "reference": {
          "chapter": 1,
          "verse": 19
        }
      }
    ]
  },
