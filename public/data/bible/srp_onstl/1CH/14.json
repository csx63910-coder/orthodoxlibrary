  "chapter": {
    "number": 14,
    "content": [
      {
        "type": "heading",
        "content": [
          "David utvrđuje svoju vladavinu"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "A Hiram, tirski car, je poslao Davidu glasnike i kedrovog drveta, zidare i drvodelje, da mu sagrade dvorac."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Tada je David uvideo da ga je Gospod postavio za cara nad Izrailjem i da je visoko uzdigao njegovo carstvo radi svog naroda Izrailja."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "David je uzeo sebi još žena u Jerusalimu, koje su rodile Davidu još sinova i ćerki."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Ovo su imena onih koji su mu se rodili u Jerusalimu: Samuja, Sovav, Natan, Solomon,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Jevar, Elisuja, Elfalet,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Noga, Nefeg, Jafija,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Elisama, Velijada i Elifelet."
        ]
      },
      {
        "type": "heading",
        "content": [
          "David poražava Filistejce"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Kad su Filistejci čuli da je David pomazan za cara nad Izrailjem, svi su krenuli gore da traže Davida. Ali David je to čuo, pa je izašao pred njih."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Filistejci dođu i izvrše napad u refaimskoj dolini."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Tada David zapita Boga: „Da li da napadnem Filistejce? Hoćeš li ih predati u moje ruke?“ Gospod odgovori Davidu: „Napadni ih, jer ću ih predati u tvoje ruke.“"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "David dođe u Val-Faresim i porazi ih tamo. Tada je rekao: „Bog je prodro kroz moje neprijatelje mojom rukom, kao što prodire voda.“ Zato se to mesto prozvalo Val-Faresim."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Filistejci su tamo ostavili svoje bogove, a David je zapovedio da ih spale."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ali Filistejci ponovo izvrše napad u dolini."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "David upita Boga, i on mu odgovori: „Ne idi gore, nego idi okolo, iza njih i navali na njih kod balzamovih stabala."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Kad začuješ zvuk koraka s vrha balzamovih stabala, kreni u bitku, jer će Bog izaći pred tobom da udari na filistejski tabor.“"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "David učini kako mu je Bog zapovedio, i potuče filistejski tabor od Gavaona do Gezera."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Tako se Davidovo ime pročulo po svoj zemlji, a Gospod je uneo strah među sve narode."
        ]
      }
    ],
    "footnotes": []
  },
