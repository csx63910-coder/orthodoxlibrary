  "chapter": {
    "number": 8,
    "content": [
      {
        "type": "heading",
        "content": [
          "Venijaminovi potomci"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Venijaminu se rodio Vela, njegov prvenac; Asvil je bio drugi, Ara treći,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Noja četvrti, i Rafaj peti."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Velini sinovi su bili: Adar, Gira, Avijud,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Avisuj, Naman, Ahoja,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Gira, Šefufan i Uram."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ovo su bili Ehudovi sinovi. Oni su bili glavari otačkih domova stanovnika Gavaje, koji su bili izgnani u Manahat:"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Naman, Ahija i Gira, koji ih je odveo u izgnanstvo; njemu su se rodili Uza i Ahihud."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Sarajim je imao sinove u moavskoj zemlji nakon što se razveo od svojih žena Usime i Vare."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "On je sa svojom ženom Odesom imao Jovava, Siviju, Misu, Malhama,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Jeusa, Sahiju i Mirmu. To su bili njegovi sinovi, i glavari otačkih domova."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Sa Usimom je imao Avitova i Elfala."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Elfalovi sinovi su bili: Ever, Misam i Samed, koji je sazidao Onan i Lod i njegova sela,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "i Verija i Sema, koji su bili glavari otačkih domova stanovnika Ajalona; oni su naterali u beg stanovnike Gata."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Ahijo, Sasak, Jeremot,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Zevadija, Arad, Eder,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Mihailo, Jespa i Joha bili su Verijini sinovi."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Zevadija, Mesulam, Jezekija, Hever,"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Ismeraj, Jezlija i Jovav bili su Elfalovi sinovi."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Jakim, Zihrije, Zavdije,"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Elinaj, Ciltaj, Elilo,"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Adaja, Veraja i Simrat bili su Semajevi sinovi."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Jišpan, Ever, Elilo,"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Avdon, Zihrije, Anan,"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Hananija i Elam i Antotija,"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Jefedija, i Fanuilo, bili su Sasakovi sinovi."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Samseraj, Searija, Gotolija,"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Jeresija, Ilija i Zihrije, bili su Jeroamovi sinovi."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Ovi su bili glavari otačkih domova po svojim rodoslovima. Živeli su u Jerusalimu."
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Gavaonov otac je živeo u Gavaonu. Žena mu se zvala Maha."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Njegov prvenac je bio Avdon, pa Sur, Kis, Val, Nadav,"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "Gedor, Ahijo, Zaher,"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "i Miklot, kome se rodio Sima. Oni su sa svojom braćom živeli u Jerusalimu nasuprot svojih srodnika."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "Neru se rodio Kis, Kisu se rodio Saul, a Saulu su se rodili Jonatan, Malhi-Suv, Avinadav i Esval."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "Jonatanov sin je bio Merival",
          {
            "noteId": 11
          },
          ", a Merivalu se rodio Miha."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "Mihini sinovi su bili: Fiton, Meleh, Tareja i Ahaz."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "Ahazu se rodio Joada, a Joadi su se rodili Alemet, Azmavet i Zimrije. Zimriji se rodio Mosa."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "Mosi se rodio Vineja; njegov sin je bio Rafaj, njegov sin Eleasa i njegov sin Acel."
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "Acel je imao šest sinova, a ovo su im imena: Azrikam, Voheruj, Ismailo, Searija, Ovadija i Anan. Svi ovi su bili Acelovi sinovi."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "A sinovi njegovog brata Iseka: njegov prvenac Ulam, Jeus drugi, i Elifelet treći."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "Ulamovi sinovi su bili hrabri ratnici, koji su natezali luk. Imali su mnogo sinova i unuka, stotinu pedeset. Svi ovi su bili Venijaminovi potomci."
        ]
      }
    ],
