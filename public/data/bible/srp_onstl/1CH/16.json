  "chapter": {
    "number": 16,
    "content": [
      {
        "type": "heading",
        "content": [
          "Kovčeg saveza u šatoru"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Kovčeg Gospodnji su doneli i postavili ga usred šatora koji je David razapeo za njega. Onda su prineli žrtve svespalnice i žrtve mira."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Kad je David završio s prinošenjem žrtve svespalnice i žrtve mira, blagoslovio je narod u ime Gospodnje."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Zatim je razdelio svim Izrailjcima, i muškarcima i ženama, svakome po jedan hleb, kolač od urmi i kolač od suvog grožđa."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Potom je postavio neke od Levita da služe ispred Kovčega Gospodnjeg, da zazivaju, hvale i slave Gospoda, Boga Izrailjevog:"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Asafa glavara, a drugog za njim Zahariju, pa Jeiela, Semiramota, Jehila, Matatiju, Elijava, Venaju i Ovid-Edoma. Jeiel je svirao liru i harfu a Asaf cimbale."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Sveštenici Venaja i Jazilo su redovno trubili u trubu pred Kovčegom saveza Gospodnjeg."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Tog dana je David prvi put naredio da Asaf i njegova braća prinose hvale Gospodu:"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Hvalite Gospoda, prizivajte mu ime,",
            "poem": 1
          },
          {
            "text": "objavite njegova dela među narodima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Pevajte mu, slavite ga pesmom,",
            "poem": 1
          },
          {
            "text": "govorite o svim njegovim čudesima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Hvalite se svetim imenom njegovim,",
            "poem": 1
          },
          {
            "text": "nek se raduju srca onih koji traže Gospoda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Tražite Gospoda i njegovu snagu,",
            "poem": 1
          },
          {
            "text": "tražite svagda lice njegovo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Pamtite čudesa koja je učinio,",
            "poem": 1
          },
          {
            "text": "čuda i sudove usta njegovih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "O, seme Izrailjevo, slugo njegov,",
            "poem": 1
          },
          {
            "text": "deco Jakovljeva, izabranici njegovi!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "On je Gospod, Bog naš, sudovi su njegovi",
            "poem": 1
          },
          {
            "text": "po svoj zemlji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Sećajte se uvek njegovog saveza,",
            "poem": 1
          },
          {
            "text": "reči što je zapovedio za hiljadu naraštaja,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "koji je sklopio sa Avrahamom,",
            "poem": 1
          },
          {
            "text": "i kojim se zakleo Isaku,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "za uredbu ga je postavio Jakovu,",
            "poem": 1
          },
          {
            "text": "Izrailju za večni savez,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "govoreći: „Tebi ću dati zemlju hanansku,",
            "poem": 1
          },
          {
            "text": "kao deo vašega nasledstva.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Dok vas je još bilo malo,",
            "poem": 1
          },
          {
            "text": "tek šačica došljaka u zemlji,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "lutajući od naroda do naroda,",
            "poem": 1
          },
          {
            "text": "od jednog carstva do drugog,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "nije dao nikom da ih tlači,",
            "poem": 1
          },
          {
            "text": "radi njih je kažnjavao careve.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "„Ne dirajte moje pomazanike,",
            "poem": 1
          },
          {
            "text": "mojim prorocima zlobu ne činite!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Pevaj Gospodu, sva zemljo,",
            "poem": 1
          },
          {
            "text": "dan za danom navešćujte njegovo spasenje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Objavite mu slavu među pucima,",
            "poem": 1
          },
          {
            "text": "njegova čudesa među svim narodima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Jer velik je Gospod, mnoge hvale vredan;",
            "poem": 1
          },
          {
            "text": "strašniji od svih bogova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Jer ništavni su svi bogovi naroda,",
            "poem": 1
          },
          {
            "text": "ali Gospod je sazdao nebesa.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Pred njim su slava i veličanstvo,",
            "poem": 1
          },
          {
            "text": "na njegovom su mestu sila i radost.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Dajte Gospodu, plemena narodna,",
            "poem": 1
          },
          {
            "text": "dajte Gospodu slavu i silu,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "dajte Gospodu slavu radi njegovog imena,",
            "poem": 1
          },
          {
            "text": "donesite mu prinos, dođite pred njega,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "klanjajte se Gospodu sjajnom u svetosti,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "drhti pred njim, sva zemljo!",
            "poem": 1
          },
          {
            "text": "Čvrsto stoji svet, neće se poljuljati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Neka se raduju nebesa,",
            "poem": 1
          },
          {
            "text": "neka se veseli zemlja,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "neka se govori među narodima: „Gospod vlada!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Neka huči more i sve što je u njemu,",
            "poem": 1
          },
          {
            "text": "nek se raduje polje i sve što je na njemu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Tada će pevati šumsko drveće pred Gospodom,",
            "poem": 1
          },
          {
            "text": "jer on dolazi da sudi zemlji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Hvalite Gospoda jer je dobar,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Recite: „Spasi nas, Bože našega spasenja,",
            "poem": 1
          },
          {
            "text": "skupi nas, izbavi nas od naroda,",
            "poem": 2
          },
          {
            "text": "da hvalimo tvoje sveto ime,",
            "poem": 1
          },
          {
            "text": "da se dičimo tvojom slavom.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Blagosloven da je Gospod,",
            "poem": 1
          },
          {
            "text": "Bog Izrailjev, od veka do veka.",
            "poem": 2
          },
          "I sav narod neka kaže: „Amin“ i „Nek je slava Gospodu!“"
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "Asafa i njegovu braću je ostavio tamo pred Kovčegom saveza Gospodnjeg da redovno služe pred Kovčegom, kako je propisano za svaki dan,"
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "a tako i Ovid-Edoma i njegovu braću, njih šezdeset osam; Ovid-Edoma, sina Jedutunovog i Osu kao vratare."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "Sveštenika Sadoka i njegovu braću sveštenike je ostavio pred Prebivalištem Gospodnjim, na uzvišici kod Gavaona,"
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "da stalno prinose žrtve svespalnice Gospodu na žrtveniku za žrtve svespalnice, ujutro i uveče, u skladu sa svim što je napisano u Zakonu Gospodnjem, koji je on dao Izrailju."
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "S njima su bili Eman, Jedutun i ostali izabrani, koji su bili određeni poimence da prinose hvalu Gospodu: „Jer je milost njegova doveka.“"
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "Eman i Jedutun su imali da trube u trube, i da sviraju cimbale i druge muzičke sprave na slavu Bogu."
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "Zatim se narod vratio svojim kućama, a David se vratio da blagoslovi svoj dom."
        ]
      }
    ],
