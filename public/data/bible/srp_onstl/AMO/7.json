  "chapter": {
    "number": 7,
    "content": [
      {
        "type": "heading",
        "content": [
          "Skakavci, oganj i visak"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ovo mi je pokazao Gospod Bog. Gle, sazdao je skakavce kad prolećni usevi počinju da niču. I gle, to su usevi nakon carske kosidbe!"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "I tako su popasli sve bilje po zemlji, a ja sam rekao: „O, Gospode Bože, molim te oprosti! Ali, kako će se dići Jakov kad je tako nejak?“"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Gospod se sažalio zbog ovog. „Neće tako biti“ – rekao je Gospod."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Ovo mi je pokazao Gospod Bog. Gle, Gospod Bog je pozvao oganj da sudi i on proguta golemi bezdan i proguta polje."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "A ja sam rekao: „O, Gospode Bože, molim te oprosti! Ali, kako će se dići Jakov kad je tako nejak?“"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Gospod se sažalio zbog ovog. „Neće ni ovo tako biti“ – rekao je Gospod."
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ovo mi je pokazao Gospod Bog. Gle, Gospod je stajao na zidu pravljenom po visku, a u ruci mu je bio visak."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "I rekao mi je Gospod: „Amose, šta vidiš?“ Odgovorio sam: „Visak.“ Gospod uzvrati: „Evo, postavljam visak usred svog naroda Izrailja i više im ne popuštam."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Opusteće Isakove uzvišice",
            "poem": 1
          },
          {
            "text": "i svetilišta Izrailjeva će se srušiti.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "A ja ću mačem da ustanem na dom Jerovoamov.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Amos i Amasija"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Amasija, sveštenik iz Vetilja, je poručio Jerovoamu, caru Izrailja: „Znaš, protiv tebe se urotio Amos usred doma Izrailjevog. Zemlja ne može da trpi njegove reči!"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Evo šta kaže Amos:",
          {
            "text": "’Jerovoam će skončati od mača,",
            "poem": 1
          },
          {
            "text": "a Izrailj iz svoje zemlje",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "sigurno ide u izgnanstvo.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Amasija je rekao Amosu: „Odlazi, videoče! Beži u Judinu zemlju pa tamo jedi hleba i prorokuj!"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "A u Vetilju ne smeš više da prorokuješ jer je ovo carevo svetilište i prestonica suverena.“"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Amos je odgovorio Amasiji rečima: „Nisam bio ni prorok ni prorokov sin. Bio sam stočar i divlje smokve sam gajio."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Gospod me je uzeo od stada i rekao mi je Gospod: ’Idi, prorokuj Izrailju, mom narodu.’"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "I sada čuj Gospodnju reč: ti kažeš:",
          {
            "text": "’Ne prorokuj protiv Izrailja",
            "poem": 1
          },
          {
            "text": "i ne žvali protiv doma Isakovog.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Zato ovako kaže Gospod:",
          {
            "text": "’Žena će ti postati gradska bludnica,",
            "poem": 1
          },
          {
            "text": "a sinovi tvoji i tvoje ćerke će pasti od mača.",
            "poem": 2
          },
          {
            "text": "Tvoje će se imanje užetom premeriti i razdeliti,",
            "poem": 1
          },
          {
            "text": "a ti ćeš umreti na nečistom tlu.",
            "poem": 2
          },
          {
            "text": "A Izrailj će sigurno iz svoje zemlje",
            "poem": 1
          },
          {
            "text": "otići u izgnanstvo.’“",
            "poem": 2
          }
        ]
      }
    ],
