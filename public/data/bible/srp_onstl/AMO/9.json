  "chapter": {
    "number": 9,
    "content": [
      {
        "type": "heading",
        "content": [
          "Razaranje Izrailja"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Video sam Gospoda, stajao je kod žrtvenika i rekao:",
          {
            "text": "„Udari u stubove!",
            "poem": 1
          },
          {
            "text": "Neka se zatresu dovraci!",
            "poem": 2
          },
          {
            "text": "Sruši ih na glavu svih njih,",
            "poem": 1
          },
          {
            "text": "a ja ću da pobijem preživele",
            "poem": 2
          },
          {
            "text": "i neće umaći ko god da beži,",
            "poem": 1
          },
          {
            "text": "i niko se neće spasti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "U Svet mrtvih",
            "poem": 1
          },
          {
            "noteId": 4
          },
          {
            "text": "ako se ukopaju,",
            "poem": 1
          },
          {
            "text": "i onde će ih moja ruka zgrabiti.",
            "poem": 2
          },
          {
            "text": "Na nebesa da se popnu,",
            "poem": 1
          },
          {
            "text": "i odande ću ih skinuti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Na vrh Karmila da se sakriju,",
            "poem": 1
          },
          {
            "text": "ja ću ih naći i uzeću ih odande.",
            "poem": 2
          },
          {
            "text": "Na dno mora da se sakriju od pogleda moga,",
            "poem": 1
          },
          {
            "text": "i onde ću zapovediti zmiji da ih ujede.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ako ih njihov neprijatelj otera u izgnanstvo,",
            "poem": 1
          },
          {
            "text": "i onde ću da zapovedim maču, pa će ih saseći.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Oka sa njih ja skinuti neću",
            "poem": 1
          },
          {
            "text": "da im zlo donesem, a ne dobro.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Gospod Bog nad vojskama",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "dotiče zemlju i ona se topi.",
            "poem": 1
          },
          {
            "text": "I kukaju njeni stanovnici,",
            "poem": 2
          },
          {
            "text": "nabuja ona poput Nila",
            "poem": 1
          },
          {
            "text": "i opada poput Nila egipatskog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "On sebi na nebesima gradi odaje,",
            "poem": 1
          },
          {
            "text": "za sebe je svod nad zemljom utemeljio.",
            "poem": 2
          },
          {
            "text": "On poziva vode mora",
            "poem": 1
          },
          {
            "text": "i izliva ih po zemljinom licu –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Gospod je ime njegovo!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "„Niste li za mene kao deca kušitska,",
            "poem": 1
          },
          {
            "text": "vi, deco izrailjska?",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          },
          {
            "text": "Zar ja nisam iz egipatske zemlje izveo Izrailja,",
            "poem": 1
          },
          {
            "text": "Filistejce sa Kaftora",
            "poem": 2
          },
          {
            "noteId": 5
          },
          {
            "lineBreak": true
          },
          {
            "text": "i Arama iz Kira?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Evo, oči su Gospoda Boga",
            "poem": 1
          },
          {
            "text": "na grešnom carstvu",
            "poem": 2
          },
          {
            "text": "i ja ću da ga zbrišem",
            "poem": 1
          },
          {
            "text": "sa lica zemlje.",
            "poem": 2
          },
          {
            "text": "Ipak neću sasvim da zbrišem",
            "poem": 1
          },
          {
            "text": "dom Jakovljev",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Jer, evo, zapovedam",
            "poem": 1
          },
          {
            "text": "da ću prosejati dom Izrailjev",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "među svim narodima",
            "poem": 2
          },
          {
            "text": "kao da ga prosejavam sitom,",
            "poem": 1
          },
          {
            "text": "i ni zrnce na tlo pasti neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Od mača će izginuti",
            "poem": 1
          },
          {
            "text": "svi grešnici mog naroda što govore:",
            "poem": 2
          },
          {
            "text": "’Neće nam se približiti,",
            "poem": 1
          },
          {
            "text": "zlo nas neće dohvatiti!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Obnova Izrailja"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Toga ću dana",
          {
            "text": "podići pali šator Davidov,",
            "poem": 1
          },
          {
            "text": "zazidaću mu pukotine,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "sagradiću što je u njemu srušeno,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i obnoviti ga kao u davnašnje vreme.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Tako će uzeti nasledstvo ostatka Edoma",
            "poem": 1
          },
          {
            "text": "i sve narode koji nose moje ime",
            "poem": 2
          },
          {
            "text": "– govori Gospod koji čini ovo.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Evo, dolaze dani – govori Gospod –",
          {
            "text": "kada će ratar stizati žeteoca",
            "poem": 1
          },
          {
            "text": "i gazilac grožđa prestići sejača.",
            "poem": 2
          },
          {
            "text": "I tada će gore kapati slatkim vinom",
            "poem": 1
          },
          {
            "text": "i svi će se bregovi prelivati.",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Vratiću Izrailj, svoj narod iz izgnanstva.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "I oni će obnoviti gradove napuštene i živeće u njima.",
            "poem": 1
          },
          {
            "text": "Sadiće vinograde i njihovo piti vino,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "sadiće bašte i njihov rod jesti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Zasadiću ih u zemlju njihovu",
            "poem": 1
          },
          {
            "text": "i neće biti iščupani opet",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "iz svoje zemlje, koju sam im dao“ –",
            "poem": 2
          },
          {
            "text": "kaže Gospod, tvoj Bog.",
            "poem": 3
          }
        ]
      }
    ],
