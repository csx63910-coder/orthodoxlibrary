  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "heading",
        "content": [
          "Izrailj se nije vratio Bogu"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Čujte ovu reč, o, krave vasanske koje ste na brdu Samarije,",
            "poem": 1
          },
          {
            "text": "što tlačite siromaha, obarate ubogoga",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i govorite muževima: „Donesite nam da pijemo!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Gospod Bog se zakleo svetošću svojom:",
            "poem": 1
          },
          {
            "text": "„Gle, evo dolaze vam dani",
            "poem": 2
          },
          {
            "text": "kada će vas izvlačiti kukama,",
            "poem": 1
          },
          {
            "text": "a poslednje od vas udicama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Izlaziće svaka od vas,",
            "poem": 1
          },
          {
            "text": "ravno napred, kroz pukotine",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i razbacaće vas po Armonu",
            "poem": 2
          },
          {
            "noteId": 1
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Dođite u Vetilj i grešite,",
            "poem": 1
          },
          {
            "text": "a u Galgalu grešite još više.",
            "poem": 2
          },
          {
            "text": "Svoje žrtve jutrom prinosite",
            "poem": 1
          },
          {
            "text": "i trećeg dana svoje desetke.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Zahvalnice sa kvascem prinosite,",
            "poem": 1
          },
          {
            "text": "objavite dobrovoljne žrtve,",
            "poem": 2
          },
          {
            "text": "razglasite ih, jer vam je to po volji,",
            "poem": 1
          },
          {
            "text": "deco Izrailjeva",
            "poem": 2
          },
          {
            "text": "– govori Gospod Bog.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "A ja sam vam dao čiste zube",
            "poem": 1
          },
          {
            "noteId": 2
          },
          {
            "text": "u svim vašim gradovima,",
            "poem": 1
          },
          {
            "text": "oskudicu hleba u svim mestima vašim,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ali vi mi se niste vratili",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Još sam vam i kišu uskratio,",
            "poem": 1
          },
          {
            "text": "a bilo je tri meseca pred žetvu.",
            "poem": 2
          },
          {
            "text": "Na jedan grad sam poslao kišu,",
            "poem": 1
          },
          {
            "text": "a na drugi nisam.",
            "poem": 2
          },
          {
            "text": "Poslao sam kišu na jednu njivu da je natopi,",
            "poem": 1
          },
          {
            "text": "a ona koja nije natapana se osušila.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Dva su se, pa i tri grada doteturala do jednog grada da piju vode.",
            "poem": 1
          },
          {
            "text": "I nisu se napili",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i vi mi se niste vratili",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Udario sam medljikom i kukoljem",
            "poem": 1
          },
          {
            "text": "bašte vaše i vaše vinograde,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "vaše smokve i vinograde vaše.",
            "poem": 2
          },
          {
            "text": "Pojeo ih je skakavac,",
            "poem": 1
          },
          {
            "text": "ali vi mi se niste vratili",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "I pomor sam slao među vas",
            "poem": 1
          },
          {
            "text": "kao na Egipat.",
            "poem": 2
          },
          {
            "text": "Mačem sam sasekao vaše mladiće",
            "poem": 1
          },
          {
            "text": "sa sve vašim preotetim konjima.",
            "poem": 2
          },
          {
            "text": "Dao sam da vam se do nosa podiže smrad vašeg tabora,",
            "poem": 1
          },
          {
            "text": "ali vi mi se niste vratili",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Zatirao sam neke od vas",
            "poem": 1
          },
          {
            "text": "kao što je Bog opustošio Sodomu i Gomoru,",
            "poem": 2
          },
          {
            "text": "bili ste kao ugarak izvučen iz ložišta,",
            "poem": 1
          },
          {
            "text": "ali vi mi se niste vratili",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Zato ću tako da ti uradim, o, Izrailju!",
            "poem": 1
          },
          {
            "text": "I zbog toga što ću da ti uradim,",
            "poem": 2
          },
          {
            "text": "pripremi se da sretneš svoga Boga, o, Izrailju!“",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Jer, evo onoga što je gore načinio,",
            "poem": 1
          },
          {
            "text": "što je vetar sazdao",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i javio čoveku misao svoju;",
            "poem": 2
          },
          {
            "text": "koji zoru u tamu pretvara",
            "poem": 1
          },
          {
            "text": "i hoda po uzvišenjima zemlje –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ime mu je Gospod, Bog nad vojskama!",
            "poem": 2
          }
        ]
      }
    ],
