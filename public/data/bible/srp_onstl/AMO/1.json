  "book": {
    "id": "AMO",
    "translationId": "srp_onstl",
    "name": "Knjiga proroka Amosa",
    "commonName": "Knjiga proroka Amosa",
    "title": "Knjiga proroka Amosa",
    "order": 30,
    "numberOfChapters": 9,
    "sha256": "a1b99bbdcd3de2eaf18e27c6e45b0a46d5a9af688337f16d8b8e0e5d9f119374",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/AMO/1.json",
    "lastChapterNumber": 9,
    "lastChapterApiLink": "/api/srp_onstl/AMO/9.json",
    "totalNumberOfVerses": 146
  },
  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Reči Amosa koje je video za Izrailj, dok je bio među stočarima iz Tekuje. Bilo je to dve godine pre zemljotresa, u vreme Ozije, cara Jude, i za vreme Jerovoama, cara Izrailja, Joasovog sina."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "On je rekao:",
          {
            "text": "„Gospod riče sa Siona,",
            "poem": 1
          },
          {
            "text": "iz Jerusalima glas svoj pušta.",
            "poem": 2
          },
          {
            "text": "Tuguju pastirski pašnjaci",
            "poem": 1
          },
          {
            "text": "i vrh Karmila se suši.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Sud nad okolnim narodima"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Ovako kaže Gospod:",
          {
            "text": "„Zbog tri prestupa Damaska,",
            "poem": 1
          },
          {
            "text": "a i zbog četiri, svoju kaznu neću da povučem,",
            "poem": 2
          },
          {
            "text": "jer su Galad ovršili",
            "poem": 1
          },
          {
            "text": "gvozdenom vršilicom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Baciću oganj na kuću Azailovu",
            "poem": 1
          },
          {
            "text": "i spaliće Ven-Adadova utvrđenja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Izlomiću prevornice na Damasku,",
            "poem": 1
          },
          {
            "text": "istrebiću živalj iz te doline Aven",
            "poem": 2
          },
          {
            "noteId": 0
          },
          {
            "text": "i onoga što u Vet-Edenu žezlo drži.",
            "poem": 1
          },
          {
            "text": "U izgnanstvo, u Kir će otići Aramov narod –",
            "poem": 2
          },
          {
            "text": "kaže Gospod.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ovako kaže Gospod:",
          {
            "text": "„Zbog tri prestupa Gaze,",
            "poem": 1
          },
          {
            "text": "a i zbog četiri, svoju kaznu neću da povučem,",
            "poem": 2
          },
          {
            "text": "jer su sve izgnanike odveli u ropstvo",
            "poem": 1
          },
          {
            "text": "i predali ih Edomu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Baciću oganj na zidine Gaze",
            "poem": 1
          },
          {
            "text": "i spaliće njena utvrđenja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Istrebiću živalj iz Azota",
            "poem": 1
          },
          {
            "text": "i onoga što u Askalonu žezlo drži.",
            "poem": 2
          },
          {
            "text": "Ruku ću svoju da okrenem na Akaron,",
            "poem": 1
          },
          {
            "text": "i postradaće ostatak filistejski",
            "poem": 2
          },
          {
            "text": "– govori Gospod Bog.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Ovako kaže Gospod:",
          {
            "text": "„Zbog tri prestupa Tira,",
            "poem": 1
          },
          {
            "text": "a i zbog četiri, svoju kaznu neću da povučem,",
            "poem": 2
          },
          {
            "text": "jer su sve izgnanike predali Edomu.",
            "poem": 1
          },
          {
            "text": "Nisu se setili bratskog saveza.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Baciću oganj na zidine Tira",
            "poem": 1
          },
          {
            "text": "i spaliće njegova utvrđenja.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ovako kaže Gospod:",
          {
            "text": "„Zbog tri prestupa Edoma,",
            "poem": 1
          },
          {
            "text": "a i zbog četiri, svoju kaznu neću da povučem,",
            "poem": 2
          },
          {
            "text": "jer je mačem svoga brata progonio",
            "poem": 1
          },
          {
            "text": "i potisnuo svoje smilovanje.",
            "poem": 2
          },
          {
            "text": "U svom ga je besu satirao stalno",
            "poem": 1
          },
          {
            "text": "i doveka razjaren bio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Baciću oganj na Teman",
            "poem": 1
          },
          {
            "text": "i spaliće utvrđenja Vosore.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ovako kaže Gospod:",
          {
            "text": "„Zbog tri prestupa sinova Amonovih,",
            "poem": 1
          },
          {
            "text": "a i zbog četiri, svoju kaznu neću da povučem,",
            "poem": 2
          },
          {
            "text": "jer su rasporili trudnice Galada",
            "poem": 1
          },
          {
            "text": "da bi među svoju proširili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Zapaliću oganj na zidinama Rave",
            "poem": 1
          },
          {
            "text": "i spaliće njena utvrđenja,",
            "poem": 2
          },
          {
            "text": "sve uz poklič na dan boja",
            "poem": 1
          },
          {
            "text": "i uz vihor olujnoga dana.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "A njihov će car otići u izgnanstvo,",
            "poem": 1
          },
          {
            "text": "zajedno – on i glavari njegovi“ –",
            "poem": 2
          },
          {
            "text": "kaže Gospod.",
            "poem": 3
          }
        ]
      }
    ],
    "footnotes": [
      {
