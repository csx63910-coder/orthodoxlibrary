  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ovako kaže Gospod:",
          {
            "text": "„Zbog tri prestupa Moava,",
            "poem": 1
          },
          {
            "text": "a i zbog četiri, svoju kaznu neću da povučem,",
            "poem": 2
          },
          {
            "text": "jer je u kreču spalio",
            "poem": 1
          },
          {
            "text": "kosti cara Edoma.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Baciću oganj na Moav",
            "poem": 1
          },
          {
            "text": "i spaliće keriotska utvrđenja.",
            "poem": 2
          },
          {
            "text": "Moav će propasti uz vrevu,",
            "poem": 1
          },
          {
            "text": "uz pokliče i uz jeku trube.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Istrebiću iz njega sudije,",
            "poem": 1
          },
          {
            "text": "sa njim pobiću sve njegove glavare“ –",
            "poem": 2
          },
          {
            "text": "kaže Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Ovako kaže Gospod:",
          {
            "text": "„Zbog tri prestupa Jude,",
            "poem": 1
          },
          {
            "text": "a i zbog četiri, svoju kaznu neću da povučem,",
            "poem": 2
          },
          {
            "text": "jer su odbacili Zakon Gospodnji",
            "poem": 1
          },
          {
            "text": "i njegove uredbe nisu držali.",
            "poem": 2
          },
          {
            "text": "Na greh su ih navele njihove laži,",
            "poem": 1
          },
          {
            "text": "u kojima su živeli i njihovi očevi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Baciću oganj na Judu",
            "poem": 1
          },
          {
            "text": "i spaliće jerusalimska utvrđenja.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Sud nad Izrailjem"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ovako kaže Gospod:",
          {
            "text": "„Zbog tri prestupa Izrailja,",
            "poem": 1
          },
          {
            "text": "a i zbog četiri, svoju kaznu neću da povučem,",
            "poem": 2
          },
          {
            "text": "jer su pravednika prodavali za srebro",
            "poem": 1
          },
          {
            "text": "i ubogoga za sandale.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Oni gaze po prašini na glavi siromaha.",
            "poem": 1
          },
          {
            "text": "Put poniznih izokreću,",
            "poem": 2
          },
          {
            "text": "čovek i otac njegov idu istoj devojci",
            "poem": 1
          },
          {
            "text": "i tako skrnave moje sveto ime.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Na založenim haljinama leže",
            "poem": 1
          },
          {
            "text": "kraj svakog žrtvenika",
            "poem": 2
          },
          {
            "text": "i vino onih koji su globljeni piju",
            "poem": 1
          },
          {
            "text": "u hramu njihovih bogova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "A ja sam istrebio Amorejce među njima,",
            "poem": 1
          },
          {
            "text": "visoke kao kedrovi moćni,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jake kao hrastovi.",
            "poem": 2
          },
          {
            "text": "Istrebio sam ih od podnožja do vrha,",
            "poem": 1
          },
          {
            "text": "od korena do ploda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "I još sam vas izveo iz egipatske zemlje",
            "poem": 1
          },
          {
            "text": "i vodio vas po pustinji četrdeset godina,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da biste zaposeli zemlju Amorejaca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Od vaših sam sinova neke podizao za proroke,",
            "poem": 1
          },
          {
            "text": "i za nazireje neke od vaših mladića.",
            "poem": 2
          },
          {
            "text": "Zar nije tako, o, deco Izrailjeva",
            "poem": 1
          },
          {
            "text": "– govori Gospod.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ali vi ste nazirejima davali da piju vino",
            "poem": 1
          },
          {
            "text": "i prorocima ste zapovedali: ’Ne prorokujte!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Evo, pritisnuću vas",
            "poem": 1
          },
          {
            "text": "kao što snopovi mnogi pritiskaju zapregu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ni onaj koji je brz neće uteći,",
            "poem": 1
          },
          {
            "text": "ni jaki neće učvrstiti snagu svoju",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i svoj život junak spasti neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Strelac se neće održati,",
            "poem": 1
          },
          {
            "text": "brzi na nogama se neće spasti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a ni konjanik život sačuvati neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "I najsrčaniji među ratnicima",
            "poem": 1
          },
          {
            "text": "toga će dana uteći neodeven",
            "poem": 2
          },
          {
            "text": "– govori Gospod.“",
            "poem": 3
          }
        ]
      }
    ],
    "footnotes": []
  },
