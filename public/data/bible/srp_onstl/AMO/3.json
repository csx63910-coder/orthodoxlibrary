    "sha256": "a1b99bbdcd3de2eaf18e27c6e45b0a46d5a9af688337f16d8b8e0e5d9f119374",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/AMO/1.json",
