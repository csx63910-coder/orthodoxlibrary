  },
  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "heading",
        "content": [
          "Svedoci protiv Izrailja"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Čujte ovu reč, jer Gospod protiv vas govori, deco Izrailjeva. Govori protiv vas i sveg roda koji sam izveo iz egipatske zemlje:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Samo sam vas poznavao",
            "poem": 1
          },
          {
            "text": "više od svih rodova na zemlji.",
            "poem": 2
          },
          {
            "text": "Zato ću vas i kazniti",
            "poem": 1
          },
          {
            "text": "za sve vaše krivice.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Idu li dvoje zajedno,",
            "poem": 1
          },
          {
            "text": "a da se nisu sreli?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Riče li lav u šumi",
            "poem": 1
          },
          {
            "text": "ako nema plena?",
            "poem": 2
          },
          {
            "text": "Javlja li se rikom lavić iz brloga svoga,",
            "poem": 1
          },
          {
            "text": "ako nije nešto uhvatio?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Sleće li ptica u zamku na tle,",
            "poem": 1
          },
          {
            "text": "ako nema mamca?",
            "poem": 2
          },
          {
            "text": "Sklanja li se ptičija zamka sa tla,",
            "poem": 1
          },
          {
            "text": "ako ništa uhvaćeno nije?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Oglasi li se truba u gradu,",
            "poem": 1
          },
          {
            "text": "a da narod ne zadrhti?",
            "poem": 2
          },
          {
            "text": "Zar postoji nesreća u gradu,",
            "poem": 1
          },
          {
            "text": "a da nije od Gospoda?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Jer Gospod ne čini ništa,",
            "poem": 1
          },
          {
            "text": "a da tajnu svoju ne objavi prorocima,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "slugama svojim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Zarikao je lav!",
            "poem": 1
          },
          {
            "text": "I ko da se ne prepadne?!",
            "poem": 2
          },
          {
            "text": "Progovorio je Gospod Bog!",
            "poem": 1
          },
          {
            "text": "I ko da ne prorokuje?!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Objavite po utvrđenjima u Azotu",
            "poem": 1
          },
          {
            "text": "i po utvrđenjima egipatske zemlje.",
            "poem": 2
          },
          {
            "text": "Recite: „Saberite se po brdima Samarije,",
            "poem": 1
          },
          {
            "text": "gledajte velike nemire sred nje",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i nasilje u njoj.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "„Nisu znali dobro da čine – govori Gospod –",
            "poem": 1
          },
          {
            "text": "ti što zgrću nasiljem",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i pustošenjem po svojim utvrđenjima.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Zato ovako kaže Gospod Bog:",
          {
            "text": "„Neprijatelj je oko zemlje,",
            "poem": 1
          },
          {
            "text": "snagu će tvoju da obori,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "opleniće tvoja utvrđenja.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ovako kaže Gospod:",
          {
            "text": "„Kao kada pastir istrgne iz lavljih čeljusti",
            "poem": 1
          },
          {
            "text": "par nogu ili komad uva,",
            "poem": 2
          },
          {
            "text": "tako će istrgnuti decu Izrailjevu",
            "poem": 1
          },
          {
            "text": "koja u Samariji prebivaju na uglu postelje,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "na svilenom krevetu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Čuj i svedoči domu Jakovljevom, govori Gospod, Gospod Bog nad vojskama:"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Na dan kada kaznim Izrailj za prestupe njegove",
            "poem": 1
          },
          {
            "text": "kazniću i žrtvenike Vetilja.",
            "poem": 2
          },
          {
            "text": "Odseće se rogovi žrtvenika",
            "poem": 1
          },
          {
            "text": "i popadaće na tle.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "I zimsku i letnju ću kuću udariti.",
            "poem": 1
          },
          {
            "text": "Srušiće se kuće pune slonovače",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i mnogi će domovi biti zbrisani",
            "poem": 2
          },
          {
            "text": "– govori Gospod.“",
            "poem": 3
          }
        ]
      }
    ],
