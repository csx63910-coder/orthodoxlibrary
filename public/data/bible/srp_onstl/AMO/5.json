    "lastChapterApiLink": "/api/srp_onstl/AMO/9.json",
    "totalNumberOfVerses": 146
  },
  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "heading",
        "content": [
          "Jadikovka i poziv na pokajanje"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Čujte ovu reč, naricaljku koju o vama iznosim, o, dome Izrailjev!"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Pala je devica izrailjska",
            "poem": 1
          },
          {
            "text": "i više ustati neće.",
            "poem": 2
          },
          {
            "text": "Napuštena je na svojoj zemlji",
            "poem": 1
          },
          {
            "text": "i nikoga nema da je podigne.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Jer ovako kaže Gospod Bog:",
          {
            "text": "„U gradu iz kog je otišla hiljada",
            "poem": 1
          },
          {
            "text": "ostaće njih stotinu,",
            "poem": 2
          },
          {
            "text": "iz kog je otišlo njih stotinu",
            "poem": 1
          },
          {
            "text": "ostaće desetoro domu izrailjskom.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Jer ovako kaže Gospod domu izrailjskom:",
          {
            "text": "„Tražite me i živećete!",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ne tražite Vetilj!",
            "poem": 2
          },
          {
            "text": "Ne idite u Galgal!",
            "poem": 1
          },
          {
            "text": "Ne prelazite u Vir-Saveju!",
            "poem": 2
          },
          {
            "text": "Jer, Galgal će sigurno u izgnanstvo,",
            "poem": 1
          },
          {
            "text": "a i Vetilj će avetinja postati.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Tražite Gospoda i živećete,",
            "poem": 1
          },
          {
            "text": "da se ne bi obrušio kao oganj na dom Josifov",
            "poem": 2
          },
          {
            "text": "i spalio ga,",
            "poem": 1
          },
          {
            "text": "a niko ga ne gasi u Vetilju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Vi u pelen pravdu izokrećete",
            "poem": 1
          },
          {
            "text": "i pravednost na tle obarate.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "A on je stvorio Vlašiće i Orion,",
            "poem": 1
          },
          {
            "text": "pretvara mrak u jutro",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i okreće dan u noć.",
            "poem": 2
          },
          {
            "text": "On doziva morske vode",
            "poem": 1
          },
          {
            "text": "i izliva ih po zemljinom licu.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Gospod je ime njegovo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "On sukne pustoš na moćnika",
            "poem": 1
          },
          {
            "text": "i pustoš će na utvrđenje doći.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "A oni mrze onoga koji na vratima prekoreva,",
            "poem": 1
          },
          {
            "text": "gade se onoga koji čestito govori.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Zato što gazite ubogoga",
            "poem": 1
          },
          {
            "text": "i uzimate mu danak u žitu,",
            "poem": 2
          },
          {
            "text": "sagradili ste kuće od klesanog kamena",
            "poem": 1
          },
          {
            "text": "ali nećete prebivati u njima.",
            "poem": 2
          },
          {
            "text": "Nećete piti vino",
            "poem": 1
          },
          {
            "text": "vaših rodnih vinograda koje ste zasadili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Jer ja znam mnoštvo vaših prestupa",
            "poem": 1
          },
          {
            "text": "i vaše mnogobrojne grehe.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Tlačite pravednika, mito uzimate,",
            "poem": 1
          },
          {
            "text": "na vratima ubogome pravdu izvrćete.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Zato mudar ćuti u ovom vremenu",
            "poem": 1
          },
          {
            "text": "jer je zlo vreme.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Dobro tražite, a ne zlo,",
            "poem": 1
          },
          {
            "text": "da živi budete,",
            "poem": 2
          },
          {
            "text": "da sa vama bude Gospod, Bog nad vojskama,",
            "poem": 1
          },
          {
            "text": "kako i kažete.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Zlo mrzite, a volite dobro,",
            "poem": 1
          },
          {
            "text": "na vratima pravdu zastupajte,",
            "poem": 2
          },
          {
            "text": "pa se možda Gospod, Bog nad vojskama,",
            "poem": 1
          },
          {
            "text": "smiluje ostatku Josifovom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Zato ovako kaže Gospod, Bog nad vojskama, Gospod:",
          {
            "text": "„Jadikovka je po svim trgovima",
            "poem": 1
          },
          {
            "text": "i ulicama svim: ’Jao! Jao!’",
            "poem": 2
          },
          {
            "text": "I zvaće ratara da žali,",
            "poem": 1
          },
          {
            "text": "da žale oni koji znaju naricaljku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Jadikovaće po svim vinogradima,",
            "poem": 1
          },
          {
            "text": "jer posred tebe ja ću proći",
            "poem": 2
          },
          {
            "text": "– govori Gospod.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Dan Gospodnji"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Jao onima što priželjkuju",
            "poem": 1
          },
          {
            "text": "dan Gospodnji!",
            "poem": 2
          },
          {
            "text": "Šta će vama dan Gospodnji?",
            "poem": 1
          },
          {
            "text": "Tad je tama, a ne svetlo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Kao čovek kad od lava beži,",
            "poem": 1
          },
          {
            "text": "a dočeka ga medved,",
            "poem": 2
          },
          {
            "text": "ili u kuću uđe",
            "poem": 1
          },
          {
            "text": "i ruku svoju na zid stavi",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da ga ujede zmija.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Neće li dan Gospodnji biti tama, a ne svetlo",
            "poem": 1
          },
          {
            "text": "i pomrčina bez sjaja?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "„Ja mrzim, ja prezirem vaše svetkovine!",
            "poem": 1
          },
          {
            "text": "Svetim saborima vašim ni da primirišem!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "I ako mi prinosite svespalnice",
            "poem": 1
          },
          {
            "text": "i vaše žitne žrtve,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "neću da ih prihvatim.",
            "poem": 2
          },
          {
            "text": "Ne obazirem se na žrtve mira",
            "poem": 1
          },
          {
            "text": "vaših utovljenih junaca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Sklonite od mene buku svojih pesama",
            "poem": 1
          },
          {
            "text": "i melodiju harfi svojih.",
            "poem": 2
          },
          {
            "text": "Ne želim da ih čujem.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Neka pravda kao voda poteče",
            "poem": 1
          },
          {
            "text": "i pravednost kao potok nepresušni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Meni li ste prinosili žitne žrtve",
            "poem": 1
          },
          {
            "text": "i prinose u pustinji četrdeset godina,",
            "poem": 2
          },
          {
            "text": "o, dome Izrailjev?!",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Nosili ste svoje idole –",
            "poem": 1
          },
          {
            "text": "Sikuta, cara svoga",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i Kijuna, zvezdu svojih bogova –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "koje ste sebi načinili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Izagnaću vas još dalje od Damaska,",
            "poem": 1
          },
          {
            "text": "kaže Gospod, a njegovo je ime Bog nad vojskama.“",
            "poem": 2
          }
        ]
      }
    ],
