  "chapter": {
    "number": 6,
    "content": [
      {
        "type": "heading",
        "content": [
          "Jao lakomislenima!"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Jao lakomislenima na Sionu,",
            "poem": 1
          },
          {
            "text": "onima što su bezbrižni na gori Samariji,",
            "poem": 2
          },
          {
            "text": "onima što se zovu uglednima najboljih naroda,",
            "poem": 1
          },
          {
            "text": "a kojima dolazi dom Izrailjev!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Pređite u Halani, razgledajte,",
            "poem": 1
          },
          {
            "text": "pa odande idite u Amat-Rabu",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i spustite se u Gat filistejski.",
            "poem": 2
          },
          {
            "text": "Jesu li ta carstva bolja od ovih",
            "poem": 1
          },
          {
            "text": "i da li su im prostranije međe od vaših međa?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Vi odgurujete dolazak dana zla,",
            "poem": 1
          },
          {
            "text": "a primičete vladavinu nasilja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Baškarite se na ležajima od slonovače,",
            "poem": 1
          },
          {
            "text": "protežete na divanima svojim",
            "poem": 2
          },
          {
            "text": "i jedete jagnjad iz stada",
            "poem": 1
          },
          {
            "text": "i telad iz štale.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Drndate po harfi,",
            "poem": 1
          },
          {
            "text": "kao David sebi izmišljate instrumente.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Vi peharima pijete vino,",
            "poem": 1
          },
          {
            "text": "mažete se najboljim uljima",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i ne bole vas Josifove razvaline.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Zato ćete sada otići u izgnanstvo na čelu izgnanika,",
            "poem": 1
          },
          {
            "text": "umuknuće slavlje onih što se protežu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Bog se gnuša Jakovljevog ponosa"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Sobom se zakleo Gospod Bog, ovako govori Gospod, Bog nad vojskama:",
          {
            "text": "„Gnušam se Jakovljevog ponosa",
            "poem": 1
          },
          {
            "text": "i mrzim njegova utvrđenja.",
            "poem": 2
          },
          {
            "text": "Zato ću da predam grad",
            "poem": 1
          },
          {
            "text": "i sve u njemu.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Ako i desetoro ljudi preostane u jednoj kući i oni će pomreti."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Njihov rođak, najbliži njihov će ih uzeti da ih spali, da iznese kosti njihove iz kuće. I reći će onome u ćošku kuće: „Je li još neko sa tobom?“ A on će mu odgovoriti: „Nije.“ I dodaće: „Tiše samo! Ne spominji Gospodnje ime!“"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Jer, evo, Gospod zapoveda",
            "poem": 1
          },
          {
            "text": "i udariće veliku kuću i razvaliće je,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a manja će kuća pući.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Trče li konji po liticama?",
            "poem": 1
          },
          {
            "text": "Ore li se more volovima?",
            "poem": 2
          },
          {
            "text": "Jer, pravdu ste u otrov preokrenuli",
            "poem": 1
          },
          {
            "text": "i u pelen plod pravednosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Radujete se Lo-Devaru i govorite:",
            "poem": 1
          },
          {
            "text": "„Nismo li svojom snagom osvojili Karnajim!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "„Jer, evo, podižem protiv vas, o, dome Izrailjev",
            "poem": 1
          },
          {
            "text": "– govori Gospod Bog nad vojskama –",
            "poem": 2
          },
          {
            "text": "narod koji će vas tlačiti",
            "poem": 1
          },
          {
            "text": "od Levo-Amata do pustinjskog potoka.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
