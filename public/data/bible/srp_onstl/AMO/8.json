  "chapter": {
    "number": 8,
    "content": [
      {
        "type": "heading",
        "content": [
          "Korpa letnjeg voća"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ovo mi je pokazao Gospod Bog. Gle, korpa letnjeg voća."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Kazao mi je: „Amose, šta vidiš?“ Odgovorio sam: „Korpu letnjeg voća.“ Gospod uzvrati: „Mom narodu, Izrailju, došao je kraj",
          {
            "noteId": 3
          },
          "i ja više neću da mu popuštam."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Na taj dan će lelek biti hramska pesma – govori Gospod Bog – posvuda će biti razbacani mnogi leševi. Tiše samo!"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Čujte ovo, o, vi što gazite ubogoga",
            "poem": 1
          },
          {
            "text": "i satirete ponizne u zemlji!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Govorite:",
          {
            "text": "’Kada će se završiti mladina",
            "poem": 1
          },
          {
            "text": "da prodajemo žito,",
            "poem": 2
          },
          {
            "text": "i subota, da otvorimo žitnice;",
            "poem": 1
          },
          {
            "text": "da zakidamo na meri,",
            "poem": 2
          },
          {
            "text": "varamo na tegovima",
            "poem": 1
          },
          {
            "text": "i podvaljujemo nepoštenim terazijama;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "da za srebro kupujemo siromaha",
            "poem": 1
          },
          {
            "text": "i ubogog za sandale,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da prodajemo žitne trice.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Gospod se zakleo ponosom Jakovljevim: „Doveka zaboraviti neću sva njihova dela."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Zar se zemlja zbog toga neće zadrmati",
            "poem": 1
          },
          {
            "text": "i zakukati svako živi na njoj?",
            "poem": 2
          },
          {
            "text": "Podiće se na njoj sve poput Nila,",
            "poem": 1
          },
          {
            "text": "nabujaće i opašće",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kao Nil egipatski.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "I toga dana ću dati da sunce zađe u podne,",
          {
            "text": "i doneću zemlji pomrčinu u po bela dana",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Okrenuću vaše svetkovine u žalopojku",
            "poem": 1
          },
          {
            "text": "i sve pesme vaše u naricaljku.",
            "poem": 2
          },
          {
            "text": "Sva ću bedra vaša obući u kostret",
            "poem": 1
          },
          {
            "text": "i oćelaviću svaku glavu.",
            "poem": 2
          },
          {
            "text": "Učiniću žalopojku kao za jedincem",
            "poem": 1
          },
          {
            "text": "i kraj toga kao dan gorčine.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Gle, dolaze dani – govori Gospod Bog –",
            "poem": 1
          },
          {
            "text": "kada ću poslati glad na zemlju.",
            "poem": 2
          },
          {
            "text": "Ali ne glad za hlebom, ne žeđ za vodom,",
            "poem": 1
          },
          {
            "text": "već za slušanjem reči Gospodnjih!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Tumaraće od mora do mora",
            "poem": 1
          },
          {
            "text": "i od severa do istoka.",
            "poem": 2
          },
          {
            "text": "Lutaće s jednog kraja na drugi,",
            "poem": 1
          },
          {
            "text": "tražiće reč Gospodnju i neće je naći.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Toga će dana",
          {
            "text": "od žeđi smalaksati",
            "poem": 1
          },
          {
            "text": "lepe devojke i mladići,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "oni koji se zaklinju idolom Samarije",
            "poem": 1
          },
          {
            "text": "i govore: ’Živ bio tvoj bog, o, Dane!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Živ bio put u Vir-Saveju!’",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "I onda će pasti i više se neće dići.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 3,
        "caller": "+",
        "text": "8,2 Igra reči, jer imenice kraj i letnje voće na jevrejskom zvuče gotovo isto.",
