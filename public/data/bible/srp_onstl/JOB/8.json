  "chapter": {
    "number": 8,
    "content": [
      {
        "type": "heading",
        "content": [
          "Vildad"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "A Vildad iz Suša je odgovorio ovim rečima:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Dokle ćeš o tome da pričaš",
            "poem": 1
          },
          {
            "text": "i dokle će reči tvojih usta biti vihor?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Zar Bog izvrće pravdu?",
            "poem": 1
          },
          {
            "text": "Izvrće li Svemoćni pravednost?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ako su mu tvoja deca sagrešila,",
            "poem": 1
          },
          {
            "text": "on ih je prepustio njihovim gresima!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ali ako potražiš Boga",
            "poem": 1
          },
          {
            "text": "i Svemoćnoga preklinješ za milost;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "ako budeš čist i pravedan,",
            "poem": 1
          },
          {
            "text": "on će bdeti nad tobom",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i obnoviće tvoje pravedno boravište.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Neznatni su bili počeci tvoji,",
            "poem": 1
          },
          {
            "text": "a budućnost tvoja procvetaće silno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Hajde, pitaj naraštaj pređašnji",
            "poem": 1
          },
          {
            "text": "i istraži saznanja njihovih predaka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Jer, mi smo od juče, ne znamo ništa,",
            "poem": 1
          },
          {
            "text": "sena su naši zemaljski dani.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Zar te neće poučiti,",
            "poem": 1
          },
          {
            "text": "reći ti iz srca svoga i izneti pouke?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Raste li papirus mimo močvare?",
            "poem": 1
          },
          {
            "text": "Raste li trska mimo voda?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Dok je još u cvatu i neposečena,",
            "poem": 1
          },
          {
            "text": "već se suši pre ostalih trava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "E, takve su staze onih što Boga zaboravljaju,",
            "poem": 1
          },
          {
            "text": "tako se ruši nada bezbožnička;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "onoga čije se pouzdanje kida",
            "poem": 1
          },
          {
            "text": "i koji se oslanja na kuću od paučine;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Elem, osloni li se na kuću svoju –",
            "poem": 1
          },
          {
            "text": "neće stajati;",
            "poem": 2
          },
          {
            "text": "prihvati li je se –",
            "poem": 1
          },
          {
            "text": "neće se držati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "On je kao jedra biljka na suncu,",
            "poem": 1
          },
          {
            "text": "čije se mladice pružaju izvan vrta;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "korenje mu se nad kamenjarem prepliće",
            "poem": 1
          },
          {
            "text": "i u kršu traži mesta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ali, ako se iskoreni sa svog mesta,",
            "poem": 1
          },
          {
            "text": "ono će ga se odreći: ’Videlo te nikad nisam!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Eto, to ti je radost njegovog puta,",
            "poem": 1
          },
          {
            "text": "a već neko drugi niče iz tla.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Gle, Bog ne odbacuje čoveka bez mane,",
            "poem": 1
          },
          {
            "text": "ali i ne prihvata zlotvora za ruku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Štaviše, smehom će ispuniti usta tvoja",
            "poem": 1
          },
          {
            "text": "i usne tvoje klicanjem!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Stidom će se zagrnuti oni koji te mrze,",
            "poem": 1
          },
          {
            "text": "a šator zlikovaca će nestati.“",
            "poem": 2
          }
        ]
      }
    ],
