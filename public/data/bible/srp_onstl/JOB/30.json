  "chapter": {
    "number": 30,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "A sad mi se smeju mlađi od mene,",
            "poem": 1
          },
          {
            "text": "oni čije očeve nisam hteo",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ni sa psima stada svoga!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "A i šta bih sa njihovih ruku snagom?",
            "poem": 1
          },
          {
            "text": "Usahla je ta snaga u njima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Sparušeni su od bede i gladi,",
            "poem": 1
          },
          {
            "text": "ti što glođu štagod po pustari,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "u sumraku, po ruševinama i razvalinama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Oni čupaju slez po čestarima",
            "poem": 1
          },
          {
            "text": "i koren smreke sebi za hranu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Oterani su iz društva,",
            "poem": 1
          },
          {
            "text": "ljudi na njih viču kao na lopova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Eno ih u jarugama potoka,",
            "poem": 1
          },
          {
            "text": "konače po jamama u zemlji i po kamenjarima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Zapomažu među grmljem,",
            "poem": 1
          },
          {
            "text": "skupljaju se u koprivama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Sinovi su bezumnika,",
            "poem": 1
          },
          {
            "text": "soj bezimenih iz zemlje proteranih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "A sad sam im pesma rugalica,",
            "poem": 1
          },
          {
            "text": "postao sam priča za njih!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Gade me se, stoje izdaleka,",
            "poem": 1
          },
          {
            "text": "ne libe se da me u lice pljunu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Jer Bog je razvezao mog šatora uže,",
            "poem": 1
          },
          {
            "text": "udario me je, a ljudi se na mene razulariše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Meni s desna diže se mladalačka rulja,",
            "poem": 1
          },
          {
            "text": "teraju me da bežim,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "protiv mene nasipaju bedeme propasti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ruše mi puteve,",
            "poem": 1
          },
          {
            "text": "uspešno me razaraju",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i za to im pomoć nije potrebna.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Naviru ko kroz širok procep,",
            "poem": 1
          },
          {
            "text": "navaljuju preko razvalina.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Nenadane strahote pale su na mene,",
            "poem": 1
          },
          {
            "text": "poput vetra razgone mi dostojanstvo,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a moje spasenje nestade ko oblak.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Sad se duša moja razlila u meni,",
            "poem": 1
          },
          {
            "text": "jer su me sustigli dani jada.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Kosti moje noć probada u meni,",
            "poem": 1
          },
          {
            "text": "bolovi me glođu bez prestanka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Odora se moja izobličila od sile velike,",
            "poem": 1
          },
          {
            "text": "sapela me kao kragna od tunike moje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "On me je u blato bacio,",
            "poem": 1
          },
          {
            "text": "sad sam nalik prahu i pepelu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Za pomoć ja tebi vapim,",
            "poem": 1
          },
          {
            "text": "alʼ se ne odazivaš;",
            "poem": 2
          },
          {
            "text": "a kada sam stao,",
            "poem": 1
          },
          {
            "text": "na mene si pažnju obratio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "U krvnika moga si se pretvorio,",
            "poem": 1
          },
          {
            "text": "silom ruke svoje si me spopao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Vinuo si me da vetar zajašem,",
            "poem": 1
          },
          {
            "text": "rastapaš me u oluji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Jer ja znam da me u smrt odvodiš,",
            "poem": 1
          },
          {
            "text": "u kuću sastanka svih koji su živi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Ali niko ne pruža ruku svoju ruini,",
            "poem": 1
          },
          {
            "text": "makar da za pomoć vapi u propasti svojoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Zar ja nisam zaplakao radi nevoljnika?",
            "poem": 1
          },
          {
            "text": "Zar mi duša zajecala nije radi ubogoga?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Ali kad sam čekao na dobro,",
            "poem": 1
          },
          {
            "text": "zlo je došlo;",
            "poem": 2
          },
          {
            "text": "kada sam se ponadao svetlu,",
            "poem": 1
          },
          {
            "text": "pristigla je tama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Utroba je moja ustreptala i nije se primirila,",
            "poem": 1
          },
          {
            "text": "dani patnje su me zadesili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Pocrneo hodam, ali ne od sunca;",
            "poem": 1
          },
          {
            "text": "ustajem u zboru i vičem za pomoć.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Zbratimljen sam sa šakalima,",
            "poem": 1
          },
          {
            "text": "prijatelj sam nojevima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Pocrnela koža je na meni,",
            "poem": 1
          },
          {
            "text": "od groznice cvokoću mi kosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Moja lira sad je za kuknjavu,",
            "poem": 1
          },
          {
            "text": "a svirala moja za plač narikača.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
