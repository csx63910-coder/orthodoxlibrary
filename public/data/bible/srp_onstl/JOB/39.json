  },
  "chapter": {
    "number": 39,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Hoćeš li ti lavu plen da loviš",
            "poem": 1
          },
          {
            "text": "i nahraniš laviće,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "kad se primire u jazbinama,",
            "poem": 1
          },
          {
            "text": "kad iz potaje vrebaju u žbunju?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ko gavranu jelo sprema,",
            "poem": 1
          },
          {
            "text": "kada mu ptići pište Bogu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kada za hranom gegaju se?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "A znaš li vreme kad se divokoze koze?",
            "poem": 1
          },
          {
            "text": "Jesi li gledao kad košute kote mlade?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Da li brojiš koliko su meseci skotne?",
            "poem": 1
          },
          {
            "text": "Znaš li kada će se omladiti?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Šćućure se i okote svoje mlade,",
            "poem": 1
          },
          {
            "text": "bolova se oslobode.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "I mladi im ojačaju, rastu u divljini,",
            "poem": 1
          },
          {
            "text": "i kad odu više im se ne vraćaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ko je divljeg magarca oslobodio",
            "poem": 1
          },
          {
            "text": "i ko mu je razvezao užad?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ja sam njemu pustaru za kuću dao",
            "poem": 1
          },
          {
            "text": "i slatinu za prebivalište.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "On na gradsku vrevu njače",
            "poem": 1
          },
          {
            "text": "i ne haje za povik goniča.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Po brdima pašu svoju traži,",
            "poem": 1
          },
          {
            "text": "njuši za svakim zelenilom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Pristaje li bivo da ti služi,",
            "poem": 1
          },
          {
            "text": "da zanoći za tvojim jaslama?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Zar ćeš bivola užetom u plug da upregneš?",
            "poem": 1
          },
          {
            "text": "Hoće li za tobom dolove da drlja?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Hoćeš li se uzdati u njega zbog njegove pogoleme snage?",
            "poem": 1
          },
          {
            "text": "Hoćeš da mu svoj rad prepustiš?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Zar veruješ kako će ti dovući letinu,",
            "poem": 1
          },
          {
            "text": "na gumno ti skupiti pšenicu?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Noj ponosno lepeće krilima,",
            "poem": 1
          },
          {
            "text": "ali to nisu ni krila ni perje rode!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Svoja jaja na zemlji polaže,",
            "poem": 1
          },
          {
            "text": "u prašini, da im bude toplo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "On ne mari dalʼ će noga da ih smrska,",
            "poem": 1
          },
          {
            "text": "divlja zverka da ih zgazi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Nema sažaljenja za ptiće svoje",
            "poem": 1
          },
          {
            "text": "kao da nisu njegovi,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ne mari što trud mu je uzaludan.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Bog ga je mudrosti lišio,",
            "poem": 1
          },
          {
            "text": "razuma mu nije udelio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Kad se visoko razmaše,",
            "poem": 1
          },
          {
            "text": "i konju i njegovom jahaču se smeje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Dade li ti konju snagu?",
            "poem": 1
          },
          {
            "text": "Da li si mu grivom ukrasio vrat?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Ti li mu daješ da ko skakavac skače?",
            "poem": 1
          },
          {
            "text": "Užasno je rzanje njegovo ponosno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Zemlju kopa, od snage drhti,",
            "poem": 1
          },
          {
            "text": "na oružje hrli!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Strahu se smeje, ne da se smesti",
            "poem": 1
          },
          {
            "text": "i pred mačem ne uzmiče.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Tobolac nad njim zveči,",
            "poem": 1
          },
          {
            "text": "sevaju sablja i koplje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Od drhtanja i frktanja zemlju grize,",
            "poem": 1
          },
          {
            "text": "ne miruje na poziv roga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "On zanjišti na zvuk roga",
            "poem": 1
          },
          {
            "text": "i nanjuši izdaleka bitku,",
            "poem": 2
          },
          {
            "text": "viku zapovednika",
            "poem": 1
          },
          {
            "text": "i bojni poklič.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Vine li se kraguj po zamisli tvojoj",
            "poem": 1
          },
          {
            "text": "i raširi krila prema jugu?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Po tvojoj li se reči orao uzdiže",
            "poem": 1
          },
          {
            "text": "i na visinama gnezdi?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Na litici živi,",
            "poem": 1
          },
          {
            "text": "noć provodi na grebenu",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i na utvrđenju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Odatle on hranu vreba",
            "poem": 1
          },
          {
            "text": "i oči mu nadaleko vide.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Njegovi ptići krv piju,",
            "poem": 1
          },
          {
            "text": "leševi gde su –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i on je tamo.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "Tada je Gospod uzvratio Jovu ovim rečima:"
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "„Zar će svađalica Svemoćnoga da ispravlja?",
            "poem": 1
          },
          {
            "text": "Neka Bogu sad uzvrati taj što mu zamera!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "I Jov je ovim rečima uzvratio Gospodu:"
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "„Gle, ja nikakav kako bih tebi uzvratio?!",
            "poem": 1
          },
          {
            "text": "Rukom svojom zatvaram usta svoja!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "Neću da uzvratim, već jednom sam govorio;",
            "poem": 1
          },
          {
            "text": "i još jednom, ali više neću.“",
            "poem": 2
          }
        ]
      }
    ],
