  "chapter": {
    "number": 18,
    "content": [
      {
        "type": "heading",
        "content": [
          "Vildad"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "A Vildad iz Suša je odgovorio ovim rečima:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Kada ćete da stanete sa pričom?",
            "poem": 1
          },
          {
            "text": "Urazumite se, pa da razgovaramo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Zašto bi nas za stoku smatrali?",
            "poem": 1
          },
          {
            "text": "Zar smo glupi u vašim očima?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ti što razdireš u svom besu dušu svoju!",
            "poem": 1
          },
          {
            "text": "Hoće li zbog tebe zemlja da opusti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "hoće li se sa svog mesta pomeriti stena?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Baš se gasi svetlo zlikovca,",
            "poem": 1
          },
          {
            "text": "neće sijati žar njegovog plama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Zgasnuće svetlo u njegovom šatoru,",
            "poem": 1
          },
          {
            "text": "a nad njim će dogoreti svetiljka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Jenjava žilavost njegovih koraka",
            "poem": 1
          },
          {
            "text": "i ruše ga namere njegove.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Jer su mu noge upale u mrežu,",
            "poem": 1
          },
          {
            "text": "u njene se petlje zapetljao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Zamka ga je za petu zgrabila,",
            "poem": 1
          },
          {
            "text": "zaplela ga omča.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Za njega je klopka na tlu sakrivena,",
            "poem": 1
          },
          {
            "text": "na putu je zamka za njega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Užasnut je od strahota svud unaokolo,",
            "poem": 1
          },
          {
            "text": "satiru ga na koraku svakom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Gladna ga je nevolja njegova,",
            "poem": 1
          },
          {
            "text": "propast je spremljena da ga saplete.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ona mu rastače delove kože,",
            "poem": 1
          },
          {
            "text": "najcrnja smrt mu jede udove.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Odvlače ga iz sigurnosti svog šatora,",
            "poem": 1
          },
          {
            "text": "i teraju do cara strahote",
            "poem": 2
          },
          {
            "noteId": 4
          },
          {
            "text": ".",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Njemu tuđi prebivaće u njegovom šatoru,",
            "poem": 1
          },
          {
            "text": "sumpor će mu po imanju razasuti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Korenje njegovo istruliće odozdo,",
            "poem": 1
          },
          {
            "text": "a njegove grane svenuće odozgo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Iščeznuće sa zemlje sećanje na njega,",
            "poem": 1
          },
          {
            "text": "neće mu se na ulici ime čuti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Oteraće ga sa svetla u tamu,",
            "poem": 1
          },
          {
            "text": "proteraće ga sa zemlje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ostaće bez roda,",
            "poem": 1
          },
          {
            "text": "bez poroda u narodu svome,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "bez preživeloga u svom zavičaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Na njegov dan zgranuće se i oni na zapadu,",
            "poem": 1
          },
          {
            "text": "a i one na istoku podilaziće jeza.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Zaista, takav je zavičaj zlotvora,",
            "poem": 1
          },
          {
            "text": "takvo je mesto onoga što za Boga ne zna!“",
            "poem": 2
          }
        ]
      }
    ],
