  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "heading",
        "content": [
          "Elifas"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Tada je Elifas iz Temana uzvratio ovako:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Hoćeš li imati strpljenja da ti neko odgovori?",
            "poem": 1
          },
          {
            "text": "Ali ko bi se mogao uzdržati od reči?!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Eto, poučavao si mnoge",
            "poem": 1
          },
          {
            "text": "i ruke klonule si snažio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Posrnulog su tvoje reči podizale",
            "poem": 1
          },
          {
            "text": "i kolena si klecava jačao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "A sad, kada je tebe snašlo,",
            "poem": 1
          },
          {
            "text": "postao si nestrpljiv;",
            "poem": 2
          },
          {
            "text": "kad se tebe taklo,",
            "poem": 1
          },
          {
            "text": "ti si preneražen.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Nije li bogobojaznost tvoja pouzdanje tvoje,",
            "poem": 1
          },
          {
            "text": "a čestitost puteva tvojih nada tvoja?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Molim te, seti se: ko je nevin postradao?",
            "poem": 1
          },
          {
            "text": "Gde su to pravednici satrveni bili?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Koliko sam ja video, oni koji oru nepravdu",
            "poem": 1
          },
          {
            "text": "i nevolju seju, baš to i žanju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Oni ginu od Božijeg daha,",
            "poem": 1
          },
          {
            "text": "iščezavaju od duha gneva njegovoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Rika lava, lavlje urlikanje",
            "poem": 1
          },
          {
            "text": "i zubi lavića se lome.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Lav skapava bez plena",
            "poem": 1
          },
          {
            "text": "i lavići se gube.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Znaš, k meni je potajno doprla reč,",
            "poem": 1
          },
          {
            "text": "o tom mi je uho šapat uhvatilo;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "u nemirnim mislima, u viđenjima noćnim,",
            "poem": 1
          },
          {
            "text": "kad ljude ophrva duboki san;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "strah i trepet su me spopali",
            "poem": 1
          },
          {
            "text": "i od njih mi kosti zazvečaše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Tek, duh mi je prešao preko lica",
            "poem": 1
          },
          {
            "text": "i dlake na telu su mi se naježile!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "I on stade,",
            "poem": 1
          },
          {
            "text": "ali mu nisam razaznao lik.",
            "poem": 2
          },
          {
            "text": "Bio mi je neki oblik pred očima",
            "poem": 1
          },
          {
            "text": "i čuo sam glas koji šapuće:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "’Zar smrtnik može da bude pravedniji od Boga?",
            "poem": 1
          },
          {
            "text": "Zar je čovek čistiji od Sazdatelja svoga?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Pa on se ni u sluge svoje ne pouzdaje",
            "poem": 1
          },
          {
            "text": "i anđelima svojim on nalazi manu,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "a kamoli onima što žive u nabijačama,",
            "poem": 1
          },
          {
            "text": "što im je temelj u prašini",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i koje smrskaju ko moljca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Satiru ih u komade od jutra do sutra,",
            "poem": 1
          },
          {
            "text": "zauvek iščezavaju i niko ne mari.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Nije li uže njihovog šatora iščupano?",
            "poem": 1
          },
          {
            "text": "Pomreće bez mudrosti.’",
            "poem": 2
          }
        ]
      }
    ],
