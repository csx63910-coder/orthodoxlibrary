  "chapter": {
    "number": 21,
    "content": [
      {
        "type": "heading",
        "content": [
          "Jov"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "A Jov je odgovorio ovim rečima:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Poslušajte pažljivo besedu moju,",
            "poem": 1
          },
          {
            "text": "neka mi to bude uteha od vas.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Otrpite me, ja bih govorio!",
            "poem": 1
          },
          {
            "text": "A vi se rugajte kada to kažem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Žalim li se ja to čoveku?",
            "poem": 1
          },
          {
            "text": "Zar da duh moj ne plane?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "K meni se okrenite i zapanjite se,",
            "poem": 1
          },
          {
            "text": "zatvorite rukom usta!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "I ja sam potresen kad mislim o ovom,",
            "poem": 1
          },
          {
            "text": "groznica mi telo grči.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Elem, zašto žive zlikovci,",
            "poem": 1
          },
          {
            "text": "zašto ostare i osile?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Deca su njihova jedra pred njima,",
            "poem": 1
          },
          {
            "text": "njihovi su potomci sa njima,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pred očima njihovim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Kuće su njihove lišene straha,",
            "poem": 1
          },
          {
            "text": "nad njima nema Božijeg pruta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Bikovi su im priplodni, osemenjuju,",
            "poem": 1
          },
          {
            "text": "krave im se tele i nisu jalove.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Poput stada puštaju dečake,",
            "poem": 1
          },
          {
            "text": "njihova deca skakuću okolo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Podcikuju uz daire i liru,",
            "poem": 1
          },
          {
            "text": "raduju se uz zvuke svirale.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Dane svoje prožive u dobru",
            "poem": 1
          },
          {
            "text": "i spokojno silaze u Svet mrtvih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "A Bogu govore: ’Prođi nas se!",
            "poem": 1
          },
          {
            "text": "Za puteve tvoje nećemo da znamo!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ko je Svemoćni, pa da mu služimo?",
            "poem": 1
          },
          {
            "text": "Šta to dobijamo ako ga molimo?’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Gle! Napredak njihov nije u ruci njihovoj,",
            "poem": 1
          },
          {
            "text": "od mene je podaleko savet zlikovaca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Koliko se često gasi svetiljka zlikovca?",
            "poem": 1
          },
          {
            "text": "Stiže li ih propast njihova?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Dodeljuje li im Bog u svom gnevu boli?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Jesu li oni poput slame na vetru,",
            "poem": 1
          },
          {
            "text": "poput pleve koju vihor nosi?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "’Bog grehe čoveka čuva za decu njegovu’?",
            "poem": 1
          },
          {
            "text": "Ma neka to njemu vrati, neka toga svestan bude!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Nek očima svojim svoju propast gleda,",
            "poem": 1
          },
          {
            "text": "nek od gneva Svemoćnoga pije!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Jer, mari li on šta će nakon njega sa kućom mu biti,",
            "poem": 1
          },
          {
            "text": "kada mu se broj meseci skrati?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Uči li iko Boga mudrosti?",
            "poem": 1
          },
          {
            "text": "Njega, koji sudi uznositima?!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Jedan umre u obilju svega",
            "poem": 1
          },
          {
            "text": "i sve mu je potaman, napredno;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "telo mu je uhranjeno mlekom",
            "poem": 1
          },
          {
            "text": "i jedra mu srž je u kostima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Drugi umire ogorčene duše,",
            "poem": 1
          },
          {
            "text": "a dobra se nauživao nije.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Tek, obojica će u prašinu leći,",
            "poem": 1
          },
          {
            "text": "prekriće ih crvi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Eto, meni su poznate misli vaše,",
            "poem": 1
          },
          {
            "text": "spletke koje spletkarite protiv mene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Vi kažete: ’Gde je sada kuća plemićeva?",
            "poem": 1
          },
          {
            "text": "Gde je šator u kome zlikovci počivaju?’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Što niste pitali one koji prolaze tim putem?!",
            "poem": 1
          },
          {
            "text": "Niste li njihove znakove uočili?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Jer, zlikovac se pošteđuje u danu propasti,",
            "poem": 1
          },
          {
            "text": "izbavlja se zlobnik u danu jarosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Ko će da ga prekori u lice zbog njegovog puta?",
            "poem": 1
          },
          {
            "text": "Ko će da mu uzvrati za ono što je učinio?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Ali kada ga na groblje budu izneli,",
            "poem": 1
          },
          {
            "text": "neko će stražariti nad humkom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Slatko će mu biti grumenje zemlje;",
            "poem": 1
          },
          {
            "text": "svaki čovek njega će slediti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a pre njega bilo ih je bezbroj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "I kako me sada uludo tešite?",
            "poem": 1
          },
          {
            "text": "Odgovori vaši ostali su lažni.“",
            "poem": 2
          }
        ]
      }
    ],
