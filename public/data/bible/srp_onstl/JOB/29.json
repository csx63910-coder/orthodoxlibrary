  "chapter": {
    "number": 29,
    "content": [
      {
        "type": "heading",
        "content": [
          "Jovova poslednja odbrana"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "A Jov je nastavio svoje kazivanje ovim rečima:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„O, kada bi mi bilo kao koji mesec ranije,",
            "poem": 1
          },
          {
            "text": "kao u danima kada me je Bog čuvao;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "kada mi je svetlila njegova svetiljka nad glavom mojom,",
            "poem": 1
          },
          {
            "text": "po njegovom svetlu kad sam mrakom išao;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "baš kakav sam bio u svojim jedrim danima,",
            "poem": 1
          },
          {
            "text": "kada sam u šatoru svome s Bogom blizak bio;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "onda kad je Svemoćni sa mnom bio",
            "poem": 1
          },
          {
            "text": "i deca moja oko mene!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Tad sam noge u maslu prao",
            "poem": 1
          },
          {
            "text": "i potoke ulja cedio mi kamen!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "A kada bih izašao na gradska vrata i na trg,",
            "poem": 1
          },
          {
            "text": "stavio bih stolicu svoju;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "mladići bi me videli, pa bi se povukli,",
            "poem": 1
          },
          {
            "text": "a starci bi ustajali i stajali;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "glavari bi priču prekidali,",
            "poem": 1
          },
          {
            "text": "svoja usta rukom zatvarali;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "utihnuo bi glas vladara,",
            "poem": 1
          },
          {
            "text": "jezik im se za nepce lepio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Blaženim me zvalo uho što me je slušalo,",
            "poem": 1
          },
          {
            "text": "hvalilo me oko što me je gledalo;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "jer sam izbavljao ubogoga što ko bednik vapi,",
            "poem": 1
          },
          {
            "text": "sirotoga bez pomoći.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Stradalnikov blagoslov bio je na meni,",
            "poem": 1
          },
          {
            "text": "a srcu sam udovice donosio pesmu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Pravednost bih uzimao, ona me je odevala;",
            "poem": 1
          },
          {
            "text": "pravda mi je moja bila ko odeća i ko turban.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Slepome sam oči bio,",
            "poem": 1
          },
          {
            "text": "hromome sam noge bio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Otac sam bio ubogima,",
            "poem": 1
          },
          {
            "text": "neznanca sam na sudu branio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Lomio sam vilice zlotvoru,",
            "poem": 1
          },
          {
            "text": "iz usta mu žrtvu otimao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "A pričao sam: ’U svome ću gnezdu da preminem,",
            "poem": 1
          },
          {
            "text": "umnožiću dane poput peska.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Moj je koren dosezao vodu,",
            "poem": 1
          },
          {
            "text": "grane su moje preko noći rosne;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Moja je slava u meni sveža,",
            "poem": 1
          },
          {
            "text": "u ruci je mojoj uvek mlad luk.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Čekali su ljudi da me čuju,",
            "poem": 1
          },
          {
            "text": "ćutali bi da čuju moj savet.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Posle moje reči nisu uzvraćali,",
            "poem": 1
          },
          {
            "text": "po njima bi moj govor kapao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Ko na kišu čekali bi na me,",
            "poem": 1
          },
          {
            "text": "usta svoja otvarali kao da sam dažd prolećni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Verovali ne bi kad bih im se nasmejao",
            "poem": 1
          },
          {
            "text": "i vedrinu mog lica nisu potamnili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Put sam im birao, poput kneza sam sedeo;",
            "poem": 1
          },
          {
            "text": "bio sam kao car među četama,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kao onaj što žalosne teši.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
