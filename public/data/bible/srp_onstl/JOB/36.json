  "chapter": {
    "number": 36,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Elijuj je nastavio ovim rečima:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Strpi se malo da ti objasnim,",
            "poem": 1
          },
          {
            "text": "još bih da ti nešto kažem o Bogu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Znanje ću svoje naširoko da iznesem,",
            "poem": 1
          },
          {
            "text": "zarad Sazdatelja svoga",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pravednost ću da objasnim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Stvarno nema neistine u rečima mojim,",
            "poem": 1
          },
          {
            "text": "pred tobom je čovek besprekornog znanja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Gle! Bog je silan, ne prezire nikog.",
            "poem": 1
          },
          {
            "text": "On je silan, u naumu velik!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "On zlotvora ne ostavlja živog,",
            "poem": 1
          },
          {
            "text": "ojađenim udeljuje pravdu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Sa pravednog svoj pogled ne skida,",
            "poem": 1
          },
          {
            "text": "s carevima navek na presto ih postavlja",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i oni se uzdižu visoko.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ako su i lancima okovani",
            "poem": 1
          },
          {
            "text": "i svezani konopcima jada,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "on im javlja šta su uradili,",
            "poem": 1
          },
          {
            "text": "o prestupima kojim se bahate.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "On im uho za prekor otvara,",
            "poem": 1
          },
          {
            "text": "poziva ih da se greha klone.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Budu li ga čuli i njemu služili,",
            "poem": 1
          },
          {
            "text": "u napretku dane svoje proživeće",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i godine svoje u milini.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "A ako ne poslušaju,",
            "poem": 1
          },
          {
            "text": "mač će ih saseći;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "iščeznuće bez ikakvog znanja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Gnev navlače ljudi srca bezbožnoga,",
            "poem": 1
          },
          {
            "text": "čak i za pomoć ne preklinju kad ih on vezuje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Dok su mladi duša im umire,",
            "poem": 1
          },
          {
            "text": "skončavaju među hramskim bludnicima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Nevoljnika on nevoljom spasava",
            "poem": 1
          },
          {
            "text": "i uho mu tlačenjem otvara.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "I tebe će iščupati iz ralja nevolje na prostrano mesto;",
            "poem": 1
          },
          {
            "text": "na mesto gde zebnje nema,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "gde je prostrt sto krcat izobiljem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ali ti kipiš sudom za zlobnike,",
            "poem": 1
          },
          {
            "text": "obuzet si i sudom i pravdom!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Pazi da te niko bogatstvom ne mami,",
            "poem": 1
          },
          {
            "text": "ne daj da te zavede golemi otkup.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Hoće li te iz nevolje izbaviti blago tvoje",
            "poem": 1
          },
          {
            "text": "i sav trud snage tvoje?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Ne žudi za noći",
            "poem": 1
          },
          {
            "text": "kada ljude uzimaju iz njihovih kuća.",
            "poem": 2
          },
          {
            "noteId": 8
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Čuvaj se, zlu se ne priklanjaj,",
            "poem": 1
          },
          {
            "text": "jer to si i odabrao rađe nego muku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Gle! Uzvišen je Gospod u sili svojoj!",
            "poem": 1
          },
          {
            "text": "Poput njega učitelj ko li je?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Ko li mu je put njegov namenio?",
            "poem": 1
          },
          {
            "text": "Kaže li mu iko: ’Loše si činio’?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Imaj na umu da njegovo veličaš delo",
            "poem": 1
          },
          {
            "text": "o kome pevaju ljudi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Sav ga je ljudski rod video,",
            "poem": 1
          },
          {
            "text": "motre ga ljudi izdaleka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Jeste, uzvišen je Bog, nama nesaznatljiv",
            "poem": 1
          },
          {
            "text": "i broj godina njegovih nam je nedokučiv!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Jer on podiže kapi vode",
            "poem": 1
          },
          {
            "text": "što iz kiše maglom rose,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "pa ljudima obilno",
            "poem": 1
          },
          {
            "text": "iz oblaka pljušte.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Ko još razume kako se valja oblak",
            "poem": 1
          },
          {
            "text": "i kako grmi iz kuće njegove?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Eno, oko sebe on prostire munju svoju",
            "poem": 1
          },
          {
            "text": "i pokriva dubine mora!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "On time vlada narodima",
            "poem": 1
          },
          {
            "text": "i daje obilje hrane.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Munjama puni ruke",
            "poem": 1
          },
          {
            "text": "pa im naredi gde će da udare.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Grmljavina njihova ga najavljuje,",
            "poem": 1
          },
          {
            "text": "ali i stoka kada oluja stiže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
    "footnotes": [
      {
        "noteId": 8,
        "caller": "+",
        "text": "36,20 Ili: kada narode odvode sa svog mesta.",
