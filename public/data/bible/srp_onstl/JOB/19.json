  "chapter": {
    "number": 19,
    "content": [
      {
        "type": "heading",
        "content": [
          "Jov"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "A Jov je odgovorio ovim rečima:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Dokle ćete da kinjite dušu moju",
            "poem": 1
          },
          {
            "text": "i rečima me lomite?!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Pa već ste me deset puta ponizili!",
            "poem": 1
          },
          {
            "text": "Ne stidite li se što mi tako pakostite?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Sve i da sam stvarno pogrešio,",
            "poem": 1
          },
          {
            "text": "moja greška je samo moja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ako biste stvarno da se nada mnom uzdižete",
            "poem": 1
          },
          {
            "text": "i da me ubeđujete u ruglo moje,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "znajte onda da me je Bog ojadio,",
            "poem": 1
          },
          {
            "text": "svojom me je mrežom obmotao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Eto, ja vičem: ’Nasilje!’, a uslišen nisam;",
            "poem": 1
          },
          {
            "text": "ja za pomoć zapomažem, ali pravde nema.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Moj put on je zagradio, ne mogu da prođem;",
            "poem": 1
          },
          {
            "text": "staze moje on je zamračio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Čast je moju svukao sa mene,",
            "poem": 1
          },
          {
            "text": "skinuo mi krunu s glave moje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Sa svih strana svaljuje me da nestanem,",
            "poem": 1
          },
          {
            "text": "izvaljuje kao drvo nadu moju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Užario se gnev njegov na mene,",
            "poem": 1
          },
          {
            "text": "pa me smatra dušmaninom svojim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Složno marširaju njegove čete,",
            "poem": 1
          },
          {
            "text": "eno, naspram mene nasip podižu;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "oko mog šatora logor dižu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Daleko od mene on je odveo braću moju,",
            "poem": 1
          },
          {
            "text": "a moji znanci su mi sada ko potpuni stranci.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Mojih rođaka više nema,",
            "poem": 1
          },
          {
            "text": "zaboravili su me poznanici moji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Gosti moga doma i sluškinje moje gledaju me ko tuđinca,",
            "poem": 1
          },
          {
            "text": "za njihove oči ja sam pridošlica.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Slugu svoga ja dozivam, alʼ mi se ne javlja,",
            "poem": 1
          },
          {
            "text": "ustima ga svojim preklinjem za pomoć.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Žena mi se gadi od zadaha moga,",
            "poem": 1
          },
          {
            "text": "oduran sam i rodbini svojoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Čak me i dečaci preziru,",
            "poem": 1
          },
          {
            "text": "rugaju mi se kad bih da ustanem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Gade me se svi prijatelji bliski,",
            "poem": 1
          },
          {
            "text": "oni koje sam voleo, sad su protiv mene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Koža mi se slepila za kosti,",
            "poem": 1
          },
          {
            "text": "zubi su mi poispadali.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Smilujte mi se! Smilujte mi se,",
            "poem": 1
          },
          {
            "text": "o, prijatelji moji,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer je ruka Božija udarila na me!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Pa zašto me poput Boga progonite,",
            "poem": 1
          },
          {
            "text": "mesa moga zar niste siti?",
            "poem": 2
          },
          {
            "noteId": 5
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "O, kada bi se reči moje zapisale!",
            "poem": 1
          },
          {
            "text": "O, kada bi se u knjigu utisnule;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "gvozdenim perom i olovom",
            "poem": 1
          },
          {
            "text": "zauvek u kamen urezale!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Ali ja znam da Otkupitelj moj živi,",
            "poem": 1
          },
          {
            "text": "da će na kraju on stati nad prahom!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Neka i pukne ova moja koža,",
            "poem": 1
          },
          {
            "text": "gledaću Boga iz tela svoga;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "njega ću ja lično gledati,",
            "poem": 1
          },
          {
            "text": "očima svojim, a ne ko tuđinac.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "A nutrina moja u meni malakše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "A vi bi trebalo da kažete: ’Zašto ga progonimo?’,",
            "poem": 1
          },
          {
            "text": "jer nalazite da je u meni koren ove stvari.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Od mača strahujte,",
            "poem": 1
          },
          {
            "text": "jer gnev donosi odmazdu mača,",
            "poem": 2
          },
          {
            "text": "da biste znali –",
            "poem": 1
          },
          {
            "text": "sud postoji.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 5,
        "caller": "+",
        "text": "19,22 Idiom jesti nečije meso prema aramejskom, arapskom i akadskom znači optuživati (Dan 3,8), pa ovaj deo stiha može da se prevede i kao: niste li me dovoljno optužili?",
        "reference": {
          "chapter": 19,
          "verse": 22
        }
      }
    ]
