  "chapter": {
    "number": 25,
    "content": [
      {
        "type": "heading",
        "content": [
          "Vildad"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Tada je Vildad iz Suša uzvratio ovako:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Božiji su i vlast i strah!",
            "poem": 1
          },
          {
            "text": "On mir stvara u visinama svojim!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Da li ima broja njegovim četama?",
            "poem": 1
          },
          {
            "text": "Koga to svetlo njegovo ne obasjava?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Kako da se čovek opravda pred Bogom?",
            "poem": 1
          },
          {
            "text": "Kako da se očisti onaj što ga žena rodi?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Gle! Ni mesec mu bistar nije,",
            "poem": 1
          },
          {
            "text": "očima njegovim niti zvezde nisu čiste;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "a kamoli čovek – crv",
            "poem": 1
          },
          {
            "text": "i potomak čoveka – crvić!“",
            "poem": 2
          }
        ]
      }
    ],
