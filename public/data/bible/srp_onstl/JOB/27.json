  "chapter": {
    "number": 27,
    "content": [
      {
        "type": "heading",
        "content": [
          "Poslednje reči Jova prijateljima"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "A Jov je nastavio svoje kazivanje ovim rečima:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Živoga mi Boga koji mi je uskratio pravo",
            "poem": 1
          },
          {
            "text": "i Svemoćnog što mi dušu ogorči;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "dok u meni daha ima",
            "poem": 1
          },
          {
            "text": "i Božijeg duha u mom nosu;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "usne moje neće govoriti nepravdu,",
            "poem": 1
          },
          {
            "text": "moj jezik neće izustiti obmanu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Daleko od mene bilo da izjavim kako ste u pravu!",
            "poem": 1
          },
          {
            "text": "Dok me ima ne odustajem od svoje čestitosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Držaću se pravednosti svoje, neću je pustiti;",
            "poem": 1
          },
          {
            "text": "sve dok živim savest moja me zapeći neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Dušmanin moj neka prođe kao pokvarenjak,",
            "poem": 1
          },
          {
            "text": "kao zlotvor neka prođe onaj što se diže na me.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Jer kakva je nada bezbožnika kada je sasečen,",
            "poem": 1
          },
          {
            "text": "kada Bog mu dušu uzme?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Čuje li Bog vapaj njegov",
            "poem": 1
          },
          {
            "text": "kad na njega nevolja dođe?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Raduje li se Svemoćnome",
            "poem": 1
          },
          {
            "text": "i zove li Boga u doba svako?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ja ću vas poučiti o Božijoj ruci,",
            "poem": 1
          },
          {
            "text": "neću da vam krijem naum Svemoćnoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Eto, svi vi ste videli ovo,",
            "poem": 1
          },
          {
            "text": "pa zašto onda uludo govorite besmislice?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Takva je od Boga sudbina za zlikovca,",
            "poem": 1
          },
          {
            "text": "nasledstvo Svemoćnog što primaju okrutni!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Makar i da mu se deca rađaju, za mač se rađaju;",
            "poem": 1
          },
          {
            "text": "potomstvo mu nikad hleba neće biti sito.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Preživele će mu pokopati zaraza,",
            "poem": 1
          },
          {
            "text": "a udovice im zakukati neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Makar da zgrne srebra ko da je prašina,",
            "poem": 1
          },
          {
            "text": "i spremi odeće kao da je zemlja;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "sve što spremi obući će pravednik,",
            "poem": 1
          },
          {
            "text": "a srebro će da razdeli nedužni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Poput moljca kuću sebi zida,",
            "poem": 1
          },
          {
            "text": "kao da je kolibica što je čuvar pravi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Leći će bogat tad i nikad više,",
            "poem": 1
          },
          {
            "text": "kad oči svoje otvori – ničeg više nema.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Nenadane strahote ko bujice odnose ga,",
            "poem": 1
          },
          {
            "text": "oluja ga noću krade.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Podiže ga vetar sa istoka, odleteće,",
            "poem": 1
          },
          {
            "text": "svitlaće ga sa mesta njegovog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Sjuriće se na njega, štedeti ga neće",
            "poem": 1
          },
          {
            "text": "dok on bude strmoglavce bežao od ruke njegove.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "I pljeskaće svojim rukama nad njim,",
            "poem": 1
          },
          {
            "text": "i zviždaće ga sa njegovog mesta.",
            "poem": 2
          }
        ]
      }
    ],
