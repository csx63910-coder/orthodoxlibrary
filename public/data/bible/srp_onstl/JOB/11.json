  "chapter": {
    "number": 11,
    "content": [
      {
        "type": "heading",
        "content": [
          "Sofar"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "A Sofar iz Namata je odgovorio ovim rečima:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Zar na mnoge reči odgovora nema",
            "poem": 1
          },
          {
            "text": "i hoće li pričalica postati pravedan?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Hoće li tvoje prazne priče ućutkati ljude",
            "poem": 1
          },
          {
            "text": "i tvoje ruganje proći bez poniženja?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Eto, rekao si: ’Moja je pouka bez mane!",
            "poem": 1
          },
          {
            "text": "Ja sam nevin u tvojim očima!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ali kada bi Bog hteo da govori,",
            "poem": 1
          },
          {
            "text": "protiv tebe da otvori usta svoja;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "da ti kaže tajne mudrosti –",
            "poem": 1
          },
          {
            "text": "mudrosti što ima dvostruko značenje –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "saznao bi da Bog zaboravlja neke krivice tvoje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Da li možeš da dokučiš Božije dubine",
            "poem": 1
          },
          {
            "text": "i granice Svemoćnog možeš li da nađeš?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Od nebesa su više!",
            "poem": 1
          },
          {
            "text": "I šta tu da uradiš?",
            "poem": 2
          },
          {
            "text": "Dublje su od Sveta mrtvih!",
            "poem": 1
          },
          {
            "text": "I šta tu da dokučiš?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "One su od zemlje duže",
            "poem": 1
          },
          {
            "text": "i merom su šire nego more.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ako on dođe, pa zatvori ili okupi sudište,",
            "poem": 1
          },
          {
            "text": "ko u tome da ga spreči?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Jer, on poznaje ljudsku prolaznost,",
            "poem": 1
          },
          {
            "text": "vidi pokvarenost i s pažnjom je prati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ipak, šupljoglavac će mudar postati",
            "poem": 1
          },
          {
            "text": "kad magare divlje okoti čoveka!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ako budeš srce svoje pripremio",
            "poem": 1
          },
          {
            "text": "i ruke svoje k njemu raširio;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "a zlo ti se u rukama nađe – odbaci ga –",
            "poem": 1
          },
          {
            "text": "nek nepravda ne prebiva u šatoru tvome!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Tada ćeš bez stida da podigneš lice svoje,",
            "poem": 1
          },
          {
            "text": "čvrst ćeš biti, strahovati nećeš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Zaboravićeš muku svoju,",
            "poem": 1
          },
          {
            "text": "pomišljaćeš na nju kao na lanjske snegove.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Svetliji od podneva život će ti biti,",
            "poem": 1
          },
          {
            "text": "a i kada noć nastupi, biće kao jutro.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Spokojan ćeš biti jer postoji nada!",
            "poem": 1
          },
          {
            "text": "Bićeš dobro zaštićen,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "u spokojstvu spavaćeš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ležaćeš i niko te neće plašiti,",
            "poem": 1
          },
          {
            "text": "mnogi će ti se dodvoravati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Zgasnuće oči zlikovačke,",
            "poem": 1
          },
          {
            "text": "utočište njihovo nestaće,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a nada jedina im je da izdahnu dušu.“",
            "poem": 2
          }
        ]
      }
    ],
