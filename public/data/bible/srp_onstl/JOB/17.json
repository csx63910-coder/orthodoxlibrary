  "chapter": {
    "number": 17,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Moj duh je satrven,",
            "poem": 1
          },
          {
            "text": "dani su moji zgasli",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i raka me čeka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Eto, podsmevači su sa mnom,",
            "poem": 1
          },
          {
            "text": "ne sklapa se oko moje zbog njihove svadljivosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Molim te, Bože, ti sam jamac moj budi!",
            "poem": 1
          },
          {
            "text": "Jer ko je taj ko bi mi se prihvatio ruke?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ti si sklonio mudrost od njihovih srca",
            "poem": 1
          },
          {
            "text": "zbog čega ih izdignuti nećeš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ko zbog dobiti izda prijatelje,",
            "poem": 1
          },
          {
            "text": "deci će mu oči usahnuti!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "On je mene učinio pričom za narode,",
            "poem": 1
          },
          {
            "text": "ja sam lice za pljuvanje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Tuga mi je oči zamutila,",
            "poem": 1
          },
          {
            "text": "svaki je moj ud poput senke.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Zbog toga se pravednici zgranu,",
            "poem": 1
          },
          {
            "text": "nedužni se groze nad bezbožnim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ali pravednik će istrajati na svom putu,",
            "poem": 1
          },
          {
            "text": "još više će ojačati čovek čistih ruku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Hajde, vratite se svi vi!",
            "poem": 1
          },
          {
            "text": "Dođite, molim vas,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ali mudrog među vama neću naći.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Prohujali su moji dani,",
            "poem": 1
          },
          {
            "text": "namere i želje srca moga su razbijene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Oni prave dan od noći,",
            "poem": 1
          },
          {
            "text": "a mraku u lice kažu:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "’Svetlo je blizu!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ako bih za Svetom mrtvih čeznuo kao za domom svojim",
            "poem": 1
          },
          {
            "text": "i u tami postelju svoju prostro,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "ako grobu viknem: ’Oče moj’,",
            "poem": 1
          },
          {
            "text": "a crvu: ’Majko moja’ ili ’sestro moja’,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "gde je onda nada moja?!",
            "poem": 1
          },
          {
            "text": "Vidi li ko nadu moju?!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Silazi li ona do vrata Sveta mrtvih?",
            "poem": 1
          },
          {
            "text": "Zajedno li ćemo u prah leći?“",
            "poem": 2
          }
        ]
      }
    ],
