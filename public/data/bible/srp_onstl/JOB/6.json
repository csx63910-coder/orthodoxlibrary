  "chapter": {
    "number": 6,
    "content": [
      {
        "type": "heading",
        "content": [
          "Jov"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "A Jov je odgovorio ovim rečima:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„O, kad bi se tuga moja izmeriti mogla",
            "poem": 1
          },
          {
            "text": "na terazijama, sa svom nesrećom mojom!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Od peska morskog bila bi teža",
            "poem": 1
          },
          {
            "text": "i zato su reči moje nepromišljene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Evo, strele su Svemoćnoga u meni",
            "poem": 1
          },
          {
            "text": "i njihov otrov duh moj ispija.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Božiji su se užasi postrojili protiv mene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Njače li divlji magarac kraj ispaše?",
            "poem": 1
          },
          {
            "text": "Muče li vo pokraj hrane svoje?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Jede li se neosoljeno jelo?",
            "poem": 1
          },
          {
            "text": "Ukusno li je belance jajeta?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ni da taknem tako nešto nisam hteo,",
            "poem": 1
          },
          {
            "text": "a sad mi se hrana moja ogadila.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Eh, kad bi se ispunila moja molba",
            "poem": 1
          },
          {
            "text": "i dao mi Bog čemu se nadam!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Kad bi hteo Bog da me skrši,",
            "poem": 1
          },
          {
            "text": "da zamahne rukom svojom i sreže me!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "I dalje bi za mene to uteha bila,",
            "poem": 1
          },
          {
            "text": "skakao bih veselo i u muci kojoj nema olakšanja,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer nisam prećutao reči Svetoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "A u čemu je to moja snaga da bih istrajao?",
            "poem": 1
          },
          {
            "text": "I kakav je to moj kraj, pa da mi se duša strpi?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Jesam li snažan kao što je kamen snažan?",
            "poem": 1
          },
          {
            "text": "Da nije moje telo od bronze?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Nije li svaka snaga u meni nestala?",
            "poem": 1
          },
          {
            "text": "Iz mene je istrgnut svaki napredak.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ko uskraćuje milost očajniku, prijatelju svome,",
            "poem": 1
          },
          {
            "text": "odbacio je strah od Svemoćnoga.",
            "poem": 2
          },
          {
            "noteId": 0
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "A moja su me braća izneverila kao potok nepostojan,",
            "poem": 1
          },
          {
            "text": "ko potoci suvih korita",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "mutnih od leda,",
            "poem": 1
          },
          {
            "text": "na kojima se sneg krije.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Kada se istope, oni nestanu.",
            "poem": 1
          },
          {
            "text": "Kada je toplo, oni ispare sa svog mesta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Vijugaju staze njihovih tokova,",
            "poem": 1
          },
          {
            "text": "odlaze u pustaru i nestaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Pogledom ih traže karavani Teme",
            "poem": 1
          },
          {
            "text": "i putnici iz Save željno ih pogledaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "I posramili su se, jer su se pouzdali,",
            "poem": 1
          },
          {
            "text": "došli su do njih i razočarali se.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "A sada ste vi za mene takvi – nikakvi –",
            "poem": 1
          },
          {
            "text": "videli ste užas i prepali se!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Da li sam vama rekao: ’Dajte!",
            "poem": 1
          },
          {
            "text": "Od svoga imanja dajte otkup za mene;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "izbavite me iz ruku zlotvora,",
            "poem": 1
          },
          {
            "text": "otkupite me iz ruku okrutnih?!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Naučite me, pa ću da zaćutim.",
            "poem": 1
          },
          {
            "text": "Objasnite mi šta sam sagrešio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Kako su bolne reči prikladne!",
            "poem": 1
          },
          {
            "text": "Ali koga to vaš prekor prekoreva?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Jelʼ mislite reči da prekorite",
            "poem": 1
          },
          {
            "text": "i vetar očajnikovih žalopojki?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Pa vi biste i siroče oborili",
            "poem": 1
          },
          {
            "text": "i pogađali se za prijatelja svoga!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Zato budite voljni da me pogledate,",
            "poem": 1
          },
          {
            "text": "da li ću vas lagati u lice.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Molim vas, okanite se,",
            "poem": 1
          },
          {
            "text": "nek ne bude nepravde! Prođite se,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pravednost je moja još uvek ovde!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Ima li nepravde na jeziku mome?",
            "poem": 1
          },
          {
            "text": "Zar usta moja ne prepoznaju zlo?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
    "footnotes": [
      {
        "noteId": 0,
        "caller": "+",
        "text": "6,14 Izvorni jezik je ovde nedokučiv, pa ovaj stih može da se prevede i ovako: Očajniku je potrebna odanost njegovog prijatelja makar da je zaboravio bogobojaznost.",
