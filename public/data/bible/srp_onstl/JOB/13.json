  "chapter": {
    "number": 13,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Eto, oko je moje sve videlo,",
            "poem": 1
          },
          {
            "text": "uho je moje čulo i to razabralo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "I ja imam znanje poput vašeg",
            "poem": 1
          },
          {
            "text": "i nisam od vas gori.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Pa ipak bih Svemoćnom da govorim,",
            "poem": 1
          },
          {
            "text": "sa Bogom bih da se pravdam.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ali vi smišljate neistine",
            "poem": 1
          },
          {
            "text": "i svi ste beskorisni lekari!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Kada biste sasvim zaćutali",
            "poem": 1
          },
          {
            "text": "možda biste i mudri postali!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ja vas molim, saslušajte moje opravdanje",
            "poem": 1
          },
          {
            "text": "i tvrdnjama mojih usta pažnju poklonite.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Pa zar ćete Boga braniti nepravdom,",
            "poem": 1
          },
          {
            "text": "svedočiti radi njega obmanu?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Zar ćete ga pristrasno zastupati?",
            "poem": 1
          },
          {
            "text": "Za Boga ćete slučaj da vodite?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Dobro li će biti kad vas on ispita?",
            "poem": 1
          },
          {
            "text": "Zar ćete ga prevariti ko što neko vara čoveka?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "A on će vas svakako prekoriti,",
            "poem": 1
          },
          {
            "text": "sve i da potajno budete pristrasni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Zar vas neće preplašiti veličanstvo njegovo?",
            "poem": 1
          },
          {
            "text": "Neće li vas spopasti jeza od njega?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Stavovi su vaši puste doskočice,",
            "poem": 1
          },
          {
            "text": "odbrane su vaše odbrane zemljane.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ne govorite mi više da bih i ja do reči došao,",
            "poem": 1
          },
          {
            "text": "pa neka me snađe šta god da me snađe!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Zašto bih sebe kidao zubima svojim",
            "poem": 1
          },
          {
            "text": "i glavu svoju u torbu stavljao?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Gle! Makar da me i ubije, nadaću se njemu;",
            "poem": 1
          },
          {
            "text": "još uvek bih pred njim puteve svoje branio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "I izbavljenje to će mi biti,",
            "poem": 1
          },
          {
            "text": "jer pred njega bezbožnik ne može da dođe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Poslušajte pažljivo besedu moju,",
            "poem": 1
          },
          {
            "text": "nek vam moje objašnjenje uđe u uši.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Evo, molim vas, izložiću slučaj svoj,",
            "poem": 1
          },
          {
            "text": "jer znam da sam u pravu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ko će da se parniči sa mnom?",
            "poem": 1
          },
          {
            "text": "Jer, ako sad ućutim mene neće biti!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Jedino mi dve stvari nemoj učiniti",
            "poem": 1
          },
          {
            "text": "da se ne bih sakrivao ja od lica tvoga:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Svoju ruku ukloni od mene",
            "poem": 1
          },
          {
            "text": "i tvoj užas neka me ne plaši!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Pozovi me i odgovaraću ti,",
            "poem": 1
          },
          {
            "text": "ili da se ja žalim, a ti mi odgovaraj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Koje su to moje krivice i gresi?",
            "poem": 1
          },
          {
            "text": "Pokaži mi prestup moj i greh moj!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Zašto lice svoje skrivaš",
            "poem": 1
          },
          {
            "text": "i smatraš me dušmaninom svojim?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "List oduvan zar ćeš da razdireš,",
            "poem": 1
          },
          {
            "text": "travku suvu zar ćeš da oduvaš?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Gorke stvari protiv mene zapisuješ,",
            "poem": 1
          },
          {
            "text": "krivice mladosti moje mi na teret stavljaš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Noge moje u okove stavljaš,",
            "poem": 1
          },
          {
            "text": "nadgledaš sve staze moje",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i beležiš svaki trag nogu mojih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "A ja propadam kao trulež,",
            "poem": 1
          },
          {
            "text": "kao odeća koju moljac jede!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
