  "chapter": {
    "number": 26,
    "content": [
      {
        "type": "heading",
        "content": [
          "Jov"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "A Jov je odgovorio ovim rečima:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„E, baš si pomogao bespomoćnom,",
            "poem": 1
          },
          {
            "text": "baš spasao ruku malaksalu!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Baš si nemudrome savet dao",
            "poem": 1
          },
          {
            "text": "i mudrosti pregršt obznanio!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "A kome si te reči objavio?",
            "poem": 1
          },
          {
            "text": "Čiji je to duh iz tebe izašao?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Pokojnici ispod voda drhte,",
            "poem": 1
          },
          {
            "text": "alʼ i oni što u njima žive.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "I Svet mrtvih pred njim je ogoljen,",
            "poem": 1
          },
          {
            "text": "i trulež je mrtvih neskrivena.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Nad bezdanom sever je on prostro,",
            "poem": 1
          },
          {
            "text": "okačio zemlju u praznini.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Vode je svezao nad oblake svoje,",
            "poem": 1
          },
          {
            "text": "ali se oblaci ne cepaju pod njima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Presto je svoj sakrio,",
            "poem": 1
          },
          {
            "text": "svoj je oblak nad njim razastro.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Povrh voda obzorje postavlja,",
            "poem": 1
          },
          {
            "text": "kao među svetlosti i mraku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Drmaju se stubovi nebeski,",
            "poem": 1
          },
          {
            "text": "užasnuti njegovim prekorom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Silom svojom on more uzburka,",
            "poem": 1
          },
          {
            "text": "čudovište Ravu mudrošću on smrska.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Njegov vetar razvedruje nebesa,",
            "poem": 1
          },
          {
            "text": "ruka mu probada zmiju vijugavu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Gle, ovo su obrisi puta njegovoga,",
            "poem": 1
          },
          {
            "text": "samo šapat reči što čujemo o njemu!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Grom moći njegove ko će da razume?“",
            "poem": 2
          }
        ]
      }
    ],
