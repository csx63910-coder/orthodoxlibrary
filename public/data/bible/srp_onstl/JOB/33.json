  "chapter": {
    "number": 33,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Zato, o, Jove, molim te čuj moja kazivanja",
            "poem": 1
          },
          {
            "text": "i sve reči moje poslušaj!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Molim te, vidi, jer otvaram usta svoja",
            "poem": 1
          },
          {
            "text": "da moj jezik progovori.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Iz čestitosti moga srca su reči moje",
            "poem": 1
          },
          {
            "text": "i po znanju moja će usta iskreno da govore.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Elem, Božiji Duh me je sazdao,",
            "poem": 1
          },
          {
            "text": "dah Svemoćnoga život mi je dao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Pa ako si kadar, ti mi odgovori;",
            "poem": 1
          },
          {
            "text": "spremi se, pa pred mene stani.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Znaj, i ja sam pred Bogom poput tebe;",
            "poem": 1
          },
          {
            "text": "i ja sam od ilovače oblikovan.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Neka te ništa u meni užasno ne plaši,",
            "poem": 1
          },
          {
            "text": "od mene nećeš biti pritisnut teško.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Dakle, govorio si na moje uši,",
            "poem": 1
          },
          {
            "text": "reči sam tvoje jasno čuo:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "’Ja sam čist, bez greha sam i bez mane!",
            "poem": 1
          },
          {
            "text": "U meni krivice nema!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ali, eto, Bog zadevicu sa mnom traži,",
            "poem": 1
          },
          {
            "text": "gleda me ko dušmanina svoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Noge moje u okove stavlja",
            "poem": 1
          },
          {
            "text": "pa nadgleda sve puteve moje.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ali ja ću da ti kažem – nisi u pravu –",
            "poem": 1
          },
          {
            "text": "jer Bog je od čoveka veći.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Zašto se ubeđuješ s Bogom",
            "poem": 1
          },
          {
            "text": "kada on ne odgovara na svaku čovekovu reč?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Jer Bog govori jednom ovako, drugi put onako –",
            "poem": 1
          },
          {
            "text": "ali niko za to ne pazi –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "u snu, u viđenju noćnom,",
            "poem": 1
          },
          {
            "text": "kada dubok san na ljude pada",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "dok spavaju na postelji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Tada on daje objavu ljudima,",
            "poem": 1
          },
          {
            "text": "upozorava ih opomenama;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "da bi čoveka odvratio od nedela",
            "poem": 1
          },
          {
            "text": "i sakrio oholost od njega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "On mu dušu čuva od rake,",
            "poem": 1
          },
          {
            "text": "život njegov od mača što seče.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Čoveka bolom kori na postelji njegovoj,",
            "poem": 1
          },
          {
            "text": "bez prestanka žigaju ga kosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Život mu se gadi hleba,",
            "poem": 1
          },
          {
            "text": "a duša omiljenog jela.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Naočigled telo mu propada,",
            "poem": 1
          },
          {
            "text": "još mu štrče kosti ogoljene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Duša mu je sve bliža raki,",
            "poem": 1
          },
          {
            "text": "a život vesniku smrti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Kad bi bilo poslanika,",
            "poem": 1
          },
          {
            "text": "posrednika jednog od hiljadu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da čoveku javi put njegove čestitosti,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "kad bi mu se Bog smilovao, pa rekao:",
            "poem": 1
          },
          {
            "text": "’Spasite ga od pada u raku!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Našao sam otkup!’;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "tad bi mu se ko detetu podmladilo telo,",
            "poem": 1
          },
          {
            "text": "vratio bi se u dane mladalačke snage.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Tad će se moliti Bogu i on će ga prihvatiti,",
            "poem": 1
          },
          {
            "text": "gledaće lice njegovo i klicaće.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Bog će obnoviti čoveku pravednost njegovu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "A on pogledaće ljude i kazaće:",
            "poem": 1
          },
          {
            "text": "’Grešio sam, pravdu izvrtao,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ali mi nije vraćeno po meri!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "On je dušu moju otkupio od pada u raku,",
            "poem": 1
          },
          {
            "text": "da mi život svetla vidi!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Eto, sve ovo Bog čini dvaput,",
            "poem": 1
          },
          {
            "text": "triput sa čovekom;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "da mu dušu iz rake povrati",
            "poem": 1
          },
          {
            "text": "i obasja svetlošću života.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Jove! Pazi, saslušaj me!",
            "poem": 1
          },
          {
            "text": "Ti ćuti, a ja ću da pričam.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Reci ako imaš reči da mi uzvratiš,",
            "poem": 1
          },
          {
            "text": "jer bih hteo da te opravdam.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Ako nemaš, ti saslušaj mene.",
            "poem": 1
          },
          {
            "text": "Ćuti, da te mudrošću poučim.“",
            "poem": 2
          }
        ]
      }
    ],
