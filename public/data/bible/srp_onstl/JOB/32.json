  "chapter": {
    "number": 32,
    "content": [
      {
        "type": "heading",
        "content": [
          "Elijuj"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "I tako su trojica ljudi prestali da uzvraćaju Jovu koji je u svojim očima bio pravedan."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Na to je na Jova u ljutnji planuo Elijuj iz Vuza, sin Varahilov iz Ramovog roda. Razljutio se, jer se ovaj činio pravednijim od Boga."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Razljutio se i na tri prijatelja što nisu imali odgovor, a opet su osudili Jova."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Naime, Elijuj je čekao da uzvrati Jovu, jer su ostali bili stariji po godinama od njega."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Razljutio se Elijuj kada je video da ova trojica ljudi nemaju šta da kažu i odgovore."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Tada je ovako odgovorio Elijuj iz Vuza, sin Varahilov:",
          {
            "text": "„Mlađi sam od vas po godinama.",
            "poem": 1
          },
          {
            "text": "Vi ste stariji,",
            "poem": 2
          },
          {
            "text": "pa sam se zato sklanjao u strahu",
            "poem": 1
          },
          {
            "text": "da vam kažem svoje mišljenje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Naime, rekao sam sebi:",
            "poem": 1
          },
          {
            "text": "’Starost neka govori",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i godine mnoge nek razglase mudrost!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Jer je duh u ljudima",
            "poem": 1
          },
          {
            "text": "i dah Svemoćnoga im daje razum.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Godine mnoge mudrost ne daju",
            "poem": 1
          },
          {
            "text": "i stari pravednost ne shvataju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Zato kažem: ’Poslušajte me,",
            "poem": 1
          },
          {
            "text": "pa da vam i ja iznesem svoje mišljenje.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Eto, čekao sam besede vaše,",
            "poem": 1
          },
          {
            "text": "saslušao mišljenja vaša",
            "poem": 2
          },
          {
            "text": "dok ste birali reči.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Da, pažljivo sam vas pratio.",
            "poem": 1
          },
          {
            "text": "Ali – gle – niko nije opovrgnuo Jova",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i nijedan od vas nije uzvratio na reči njegove!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "I ne govorite: ’Mudrost smo pronašli!",
            "poem": 1
          },
          {
            "text": "A njega neka Bog opovrgne, a ne čovek.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ali, nije on protiv mene govorio",
            "poem": 1
          },
          {
            "text": "pa ni ja neću da uzvratim njemu vašim dokazima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "A oni su se smeli i više ne uzvraćaju,",
            "poem": 1
          },
          {
            "text": "sasvim su ostali bez reči.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Zašto da čekam kada ne govore,",
            "poem": 1
          },
          {
            "text": "samo stoje i više ne uzvraćaju?!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "A sada ću ja svoje da kažem,",
            "poem": 1
          },
          {
            "text": "mišljenje ću svoje da iznesem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Jer prepun sam reči,",
            "poem": 1
          },
          {
            "text": "iz utrobe moje duh me na to tera.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Evo, poput vina bez oduška utroba je moja,",
            "poem": 1
          },
          {
            "text": "raspukla bi se ko mešina nova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Moram da govorim, da sebi oduška dam;",
            "poem": 1
          },
          {
            "text": "otvoriću usne svoje da bih uzvratio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Neću da gledam ko je ko,",
            "poem": 1
          },
          {
            "text": "nikome da laskam neću.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Pa ja i ne umem da laskam,",
            "poem": 1
          },
          {
            "text": "jer bi me odmah uzeo Sazdatelj moj!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
