  "chapter": {
    "number": 7,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ne kuluči li ljudski rod na zemlji",
            "poem": 1
          },
          {
            "text": "i nisu li mu dani kao dani najamnikovi?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Kao sluga što uzdiše za hladom",
            "poem": 1
          },
          {
            "text": "i kao najamnik što čezne za nadnicom svojom,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "tako su i meni dodeljeni meseci besmisla,",
            "poem": 1
          },
          {
            "text": "tegobne su mi noći određene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ako legnem, kažem: ’Kad ću da ustanem?’",
            "poem": 1
          },
          {
            "text": "Oduži se noć, dodija mi",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i prevrćem se do zore.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Telo mi se u crve i skoreno blato obuklo,",
            "poem": 1
          },
          {
            "text": "koža mi je krastava i gnojna.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Dani moji prohujaše brže nego tkanje na razboju,",
            "poem": 1
          },
          {
            "text": "do kraja se odmotala nada.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Priseti se da mi je život dašak,",
            "poem": 1
          },
          {
            "text": "da mi oči više neće gledati dobra!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Više me neće gledati oko koje me je gledalo.",
            "poem": 1
          },
          {
            "text": "Tvoje će me oči potražiti",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ali mene više biti neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Kao što se oblak raspline, nestane,",
            "poem": 1
          },
          {
            "text": "tako se ne diže onaj što u Svet mrtvih",
            "poem": 2
          },
          {
            "noteId": 1
          },
          {
            "text": "siđe;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "ne vraća se više kući svojoj,",
            "poem": 1
          },
          {
            "text": "zavičaj ga njegov više ne poznaje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Tako ni ja neću više da zatvaram usta svoja.",
            "poem": 1
          },
          {
            "text": "Zavapiću u teskobi duha svoga,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jadaću se u čemeru duše svoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Šta sam ja to – more ili morska neman –",
            "poem": 1
          },
          {
            "text": "da si stražu oko mene postavio?!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Jer kad kažem: ’Postelja će moja da uteši mene,",
            "poem": 1
          },
          {
            "text": "moj će ležaj da olakša žalopojke moje’,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "ti snovima tad me plašiš,",
            "poem": 1
          },
          {
            "text": "prestravljuješ viđenjima;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "pa su mi i vešala draža",
            "poem": 1
          },
          {
            "text": "i smrt više nego život.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Smučilo mi se!",
            "poem": 1
          },
          {
            "text": "Pa neću ja doveka da živim!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Prođi me se, jer su dašak dani moji!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Pa šta je čovek da ga tako uzdižeš,",
            "poem": 1
          },
          {
            "text": "da ti je za srce prirastao;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "da se baviš njime iz jutra u jutro,",
            "poem": 1
          },
          {
            "text": "da ga svakog trena iskušavaš?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Dokle?! Nećeš li da skreneš svoj pogled sa mene?",
            "poem": 1
          },
          {
            "text": "Nećeš li me pustiti nasamo, dok pljuvačku ja svoju progutam?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Sve i da sam sagrešio,",
            "poem": 1
          },
          {
            "text": "šta sam tebi učinio, o, čuvaru ljudi?!",
            "poem": 2
          },
          {
            "text": "Zašto si me sebi ko metu stavio,",
            "poem": 1
          },
          {
            "text": "pa sam ti postao teret?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Što mi ne bi prestup oprostio",
            "poem": 1
          },
          {
            "text": "i krivicu moju mimoišao?",
            "poem": 2
          },
          {
            "text": "Jer, ja ću leći u prašinu,",
            "poem": 1
          },
          {
            "text": "pa kad me potražiš –",
            "poem": 2
          },
          {
            "text": "mene više biti neće.“",
            "poem": 3
          }
        ]
      }
    ],
