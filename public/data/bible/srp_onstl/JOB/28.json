  "chapter": {
    "number": 28,
    "content": [
      {
        "type": "heading",
        "content": [
          "Gde je mudrost?"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Eto, i srebro ima svoj rudnik,",
            "poem": 1
          },
          {
            "text": "i zlato mesto na kom se ispira.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "I gvožđe se iz zemlje uzima",
            "poem": 1
          },
          {
            "text": "i kamen se pretapa u bronzu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "A čovek tamu dokrajčuje,",
            "poem": 1
          },
          {
            "text": "istražuje do krajnjih granica,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "traži rudu u tami najgušćoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Okno kopa daleko od bližnjeg",
            "poem": 1
          },
          {
            "text": "gde noga ne zalazi,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "penje se i klati daleko od ljudi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Zemlja sa koje hleb dolazi",
            "poem": 1
          },
          {
            "text": "iznutra se kovitla ko vatra.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "U njenim je stenama nalazište safira,",
            "poem": 1
          },
          {
            "text": "a ima i zlatne prašine.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Put do tamo ne zna ptica grabljivica,",
            "poem": 1
          },
          {
            "text": "oko sokolovo trag mu ne nazire.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ponosne se zveri njime ne šunjaju,",
            "poem": 1
          },
          {
            "text": "a ni lav po njemu ne prolazi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Čovek pruža ruku za kremenom,",
            "poem": 1
          },
          {
            "text": "prekopava korenje planina;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "u stenama tunele probija",
            "poem": 1
          },
          {
            "text": "i očima vidi svaku vrednost;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "obuzdava curenje voda",
            "poem": 1
          },
          {
            "text": "i ono skriveno na svetlo iznosi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ali gde se mudrost pronalazi?",
            "poem": 1
          },
          {
            "text": "Gde je mesto razboritosti?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Rod joj ljudski vrednost ne poznaje,",
            "poem": 1
          },
          {
            "text": "ne pronalazi se u zemlji živih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Tek, bezdan javlja: ’U meni nije!’",
            "poem": 1
          },
          {
            "text": "i more kaže: ’Nije ni sa mnom!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Suvo zlato za nju se ne daje,",
            "poem": 1
          },
          {
            "text": "za cenu njenu srebro se ne meri.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ne plaća se ni zlatom ofirskim,",
            "poem": 1
          },
          {
            "text": "ni skupocenim oniksom i safirom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Nisu joj ravni ni zlato ni kristal,",
            "poem": 1
          },
          {
            "text": "za ćup suvog zlata ne trampi se ona.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Korale i jaspis i ne spominjite,",
            "poem": 1
          },
          {
            "text": "od bisera mudrost je vrednija.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ne meri se sa njom ni topaz iz Kuša,",
            "poem": 1
          },
          {
            "text": "ni suvim se zlatom platiti ne može.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Pa odakle onda dolazi mudrost?",
            "poem": 1
          },
          {
            "text": "Gde je mesto razboritosti?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Od očiju svega živog je sklonjena,",
            "poem": 1
          },
          {
            "text": "od nebeskih ptica je skrivena.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Trulež mrtvih i smrt nam kazuju:",
            "poem": 1
          },
          {
            "text": "’Ušima smo svojim čuli kazivanje o njoj.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Bog razume put do nje",
            "poem": 1
          },
          {
            "text": "i poznaje njeno mesto,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "jer on vidi do krajeva zemlje",
            "poem": 1
          },
          {
            "text": "i on gleda ispod svih nebesa.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Kad je vetru podario snagu",
            "poem": 1
          },
          {
            "text": "i merama premerio vode;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "kad je kiši odredbu davao",
            "poem": 1
          },
          {
            "text": "i munje olujama;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "tada ju je pogledao, objavio, postavio,",
            "poem": 1
          },
          {
            "text": "tada ju je proverio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "A ljudima je rekao:",
            "poem": 1
          },
          {
            "text": "’Evo, mudrost je u bogobojaznosti",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a razboritost u uklanjanju od zla!’“",
            "poem": 2
          }
        ]
      }
    ],
