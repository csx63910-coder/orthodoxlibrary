  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "heading",
        "content": [
          "Jovova žalopojka"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Onda je Jov progovorio proklinjući dan svog rođenja."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Rekao je:"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "„Nek nestane dana u kome sam rođen",
            "poem": 1
          },
          {
            "text": "i noći kada je rečeno: ’Začelo se muško!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "U tamu neka se okrene taj dan.",
            "poem": 1
          },
          {
            "text": "Ne mario Bog odozgo za njega",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i svetlost ga nikada ne obasjala.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Zgrabili ga noć i tama najgušća,",
            "poem": 1
          },
          {
            "text": "oblak ga prekrio",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i sve ga pomrčine dnevne prestravile!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Nek noć onu tama proguta,",
            "poem": 1
          },
          {
            "text": "nek ne bude pridodana danima godišnjim,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "nek ne bude ubrojana mesecima!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Evo, noć ta jalova nek bude,",
            "poem": 1
          },
          {
            "text": "povik sreće ne ušao u nju!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Prokleli je oni koji dan proklinju,",
            "poem": 1
          },
          {
            "text": "što su voljni levijatana da bude.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Neka zgasnu zvezde svitanja njenoga,",
            "poem": 1
          },
          {
            "text": "čekajući zoru neka je ne dočeka,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ne videla pogled praskozorja;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "jer mi nije zatvorila vrata od majčinog krila",
            "poem": 1
          },
          {
            "text": "i sakrila nije muku od očiju mojih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Zašto nisam umro u utrobi",
            "poem": 1
          },
          {
            "text": "i skončao iz stomaka kad sam izašao?!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Zašto su me prihvatila kolena",
            "poem": 1
          },
          {
            "text": "i zašto grudi koje sam sisao?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Jer ja bih sada spokojno ležao,",
            "poem": 1
          },
          {
            "text": "spavao bih i u miru bio",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "s carevima i zemaljskim savetnicima,",
            "poem": 1
          },
          {
            "text": "sa onima što su sebi obnovili razvaline;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "s knezovima što imaju zlata,",
            "poem": 1
          },
          {
            "text": "što su srebrom kuće svoje ispunili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ili zašto nisam bio mrtvorođenče zamotano,",
            "poem": 1
          },
          {
            "text": "ili poput dojenčadi, što svetla videla nisu?!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Tamo zlobnici prestaju sa zlobom,",
            "poem": 1
          },
          {
            "text": "tamo počivaju iznureni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Zatvorenici su zajedno spokojni",
            "poem": 1
          },
          {
            "text": "i ne čuju povik tlačiteljev.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Tamo su i veliki i mali,",
            "poem": 1
          },
          {
            "text": "a rob se oslobodio gospodara svoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Zašto se stradalniku daje svetlo",
            "poem": 1
          },
          {
            "text": "i život ljudima ogorčene duše;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "onima što za smrti žude, a nje nema,",
            "poem": 1
          },
          {
            "text": "i traže je više nego blago zakopano;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "onima koji se bezmerno raduju i likuju",
            "poem": 1
          },
          {
            "text": "jer su grob pronašli;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "čoveku čiji je put sakriven",
            "poem": 1
          },
          {
            "text": "i koga je Bog odasvud zagradio?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Mome jelu prethodi ječanje moje",
            "poem": 1
          },
          {
            "text": "i moj se vapaj ko voda izliva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Jer me snađe čegʼ sam se bojao,",
            "poem": 1
          },
          {
            "text": "sustiglo me od čegʼ sam strepeo!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Nemam mira, nemam olakšanja,",
            "poem": 1
          },
          {
            "text": "nemam počivanja, muka me sustiže.“",
            "poem": 2
          }
        ]
      }
    ],
