  "chapter": {
    "number": 16,
    "content": [
      {
        "type": "heading",
        "content": [
          "Jov"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "A Jov je odgovorio ovim rečima:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Mnogo sam ja takvih stvari čuo,",
            "poem": 1
          },
          {
            "text": "svi vi ste mi mučni tešioci!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ima li kraja pričanju u vetar?",
            "poem": 1
          },
          {
            "text": "Šta te to tera da mi odgovaraš?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "I ja bih poput vas govorio",
            "poem": 1
          },
          {
            "text": "da ste vi na mome mestu,",
            "poem": 2
          },
          {
            "text": "podbadao bih vas rečima",
            "poem": 1
          },
          {
            "text": "i klimao glavom na vas.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ali bi vas usta moja ojačala,",
            "poem": 1
          },
          {
            "text": "usne moje donele utehu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ako bih govorio,",
            "poem": 1
          },
          {
            "text": "svoj bol ne bih ublažio;",
            "poem": 2
          },
          {
            "text": "ako bih ućutao,",
            "poem": 1
          },
          {
            "text": "koliko bola bi me napustilo?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ipak, on me je iznurio;",
            "poem": 1
          },
          {
            "text": "ti si mi zatro sve ukućane moje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Zgrabio si me,",
            "poem": 1
          },
          {
            "text": "bol je svedok protiv mene;",
            "poem": 2
          },
          {
            "text": "mršavost se moja podignula",
            "poem": 1
          },
          {
            "text": "da u lice me optuži.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Njegov me gnev razdire i spopada,",
            "poem": 1
          },
          {
            "text": "na mene zubima škrguće svojim,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "dušmanin moj je na mene upro oči svoje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Razjapili su svoja usta prema meni,",
            "poem": 1
          },
          {
            "text": "s prezirom mi šamaraju obraze,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "okupljaju se protiv mene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Zlotvoru me Bog je izručio,",
            "poem": 1
          },
          {
            "text": "bacio me u ruke zlobnika!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Mirno sam živeo, a on me je uzdrmao,",
            "poem": 1
          },
          {
            "text": "za vrat me je dočepao, smrskao me;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "sebi me je za metu stavio;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "strelci su me njegovi okružili,",
            "poem": 1
          },
          {
            "text": "nutrinu mi je rasparao bez milosti",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i žuč mi je po zemlji prosuo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Prolama kroz mene",
            "poem": 1
          },
          {
            "text": "sve prolom za prolomom,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kao ratnik prema meni tutnji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Za kožu sam svoju, ja zašio kostret,",
            "poem": 1
          },
          {
            "text": "u prašinu dostojanstvo svoje uvaljao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Od ridanja podbulo je lice moje,",
            "poem": 1
          },
          {
            "text": "kapci su mi poput smrti crni,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "premda nasilja nema u rukama mojim",
            "poem": 1
          },
          {
            "text": "i moja je molitva čista.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "O, zemljo, krv moju ne prekrivaj!",
            "poem": 1
          },
          {
            "text": "Ne bilo mesta za moj vapaj!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "A sada, na nebesima eno svedoka moga!",
            "poem": 1
          },
          {
            "text": "Da, moj branilac je na visinama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "A moji prijatelji – moji posrednici vajni!",
            "poem": 1
          },
          {
            "text": "Oko moje Bogu plače.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Eh, kad bi se čovek pravdao sa Bogom",
            "poem": 1
          },
          {
            "text": "kao čovek sa čovekom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Još godina koja prohujaće",
            "poem": 1
          },
          {
            "text": "i poći ću putem s kojeg povratka mi nema.",
            "poem": 2
          }
        ]
      }
    ],
