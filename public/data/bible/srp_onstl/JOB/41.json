  "chapter": {
    "number": 41,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ne divlja li kada ga probudiš?",
            "poem": 1
          },
          {
            "text": "A ko je taj što bi pred mene da stane?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Zar mi je ko ikada dao šta, da bi mu ja to vratio?",
            "poem": 1
          },
          {
            "text": "Pa sve je moje pod nebesima!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "O udovima njegovim ja da ćutim neću,",
            "poem": 1
          },
          {
            "text": "ni o njegovoj snazi, ni o skladu njegovog tela.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ko će da mu razotkrije površinu njegove odeće?",
            "poem": 1
          },
          {
            "text": "Dupli oklop ko da mu probije?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ko bi da mu čeljusti razjapi",
            "poem": 1
          },
          {
            "text": "kada je strava oko njegovih zuba?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Leđa su mu od nizova krljušti poređanih",
            "poem": 1
          },
          {
            "text": "i čvrsto spojenih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Prijanjaju jedna uz drugu,",
            "poem": 1
          },
          {
            "text": "ni vazduh među njima ne prolazi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Spojene su među sobom, jedna drugu drže,",
            "poem": 1
          },
          {
            "text": "razmaka nemaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Kad on kine, ko da munja sine;",
            "poem": 1
          },
          {
            "text": "oči mu se crvene ko zora.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Plamen mu iz usta suklja,",
            "poem": 1
          },
          {
            "text": "žeravice vatrene vrcaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Para mu se diže iz nozdrva,",
            "poem": 1
          },
          {
            "text": "ko kotao ključa i preliva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Svojim dahom ugalj raspiruje,",
            "poem": 1
          },
          {
            "text": "iz ždrela mu vatra plamti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Njemu snaga počiva u šiji,",
            "poem": 1
          },
          {
            "text": "ispred njega nastupa strahota.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Nabori mu na telu prijanjaju,",
            "poem": 1
          },
          {
            "text": "čvrsti su i nepomični.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Srce mu je kao kamen tvrdo,",
            "poem": 1
          },
          {
            "text": "tvrdo mu je kao donji žrvanj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Kad se digne, zastrepe delije,",
            "poem": 1
          },
          {
            "text": "pred lomnjavom odstupaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ko ga mačem i dohvati –",
            "poem": 1
          },
          {
            "text": "ništa mu ne vredi –",
            "poem": 2
          },
          {
            "text": "tako i kopljem,",
            "poem": 1
          },
          {
            "text": "strelom ilʼ ostvama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Gvožđe mu je poput pleve,",
            "poem": 1
          },
          {
            "text": "a bronza mu kao drvo trulo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Njega strela poterati neće,",
            "poem": 1
          },
          {
            "text": "a kamenje iz praćke za njega je pleva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Kao prutić njemu je toljaga,",
            "poem": 1
          },
          {
            "text": "fijuku se koplja on podsmeva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Stomak mu je ko od lomljenih crepova,",
            "poem": 1
          },
          {
            "text": "pa kroz blato prođe ko drljača.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Zbog njega dubina provri kao lonac,",
            "poem": 1
          },
          {
            "text": "more se peni kao kazan masti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Za sobom ostavlja trag od pene,",
            "poem": 1
          },
          {
            "text": "pa se čini da je dubina osedela.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Niko mu sličan na zemlji nije!",
            "poem": 1
          },
          {
            "text": "To je stvorenje koje straha nema!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "On gleda svakog ko je ponosan",
            "poem": 1
          },
          {
            "text": "jer on je car svih ponosnih!“",
            "poem": 2
          }
        ]
      }
    ],
