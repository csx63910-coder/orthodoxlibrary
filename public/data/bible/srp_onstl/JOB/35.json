  "chapter": {
    "number": 35,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "I još je kazao Elijuj:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Misliš li da je ispravno to što si rekao:",
            "poem": 1
          },
          {
            "text": "’Pravedan sam ja pred Bogom’?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Da, rekao si: ’Kakvu ti",
            "poem": 1
          },
          {
            "noteId": 6
          },
          {
            "text": "korist imaš?",
            "poem": 1
          },
          {
            "text": "Šta mi vredi to što ne grešim?’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Evo ja, ja ću da odgovorim i tebi",
            "poem": 1
          },
          {
            "text": "i tvojim prijateljima što su sa tobom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "U nebesa gledaj i videćeš;",
            "poem": 1
          },
          {
            "text": "posmatraj oblake, kako su samo viši od tebe!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ako si grešio, šta si njemu učinio?",
            "poem": 1
          },
          {
            "text": "Ako je tvojih prestupa mnogo,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jesi li njemu uradio nešto?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ako si pravedan, jesi li mu nešto dao?",
            "poem": 1
          },
          {
            "text": "Da nije primio nešto iz tvoje ruke?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Pokvarenost tvoja škodi onom poput tebe,",
            "poem": 1
          },
          {
            "text": "a pravednost tvoja koristi potomku čoveka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Zbog silnoga tlačenja vape ljudi,",
            "poem": 1
          },
          {
            "text": "preklinju za pomoć zbog ruke silnika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "I niko ne pita: ’A gde je Bog, Sazdatelj moj,",
            "poem": 1
          },
          {
            "text": "koji u noći pesme daje;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "koji nas poučava više nego zemaljske zveri",
            "poem": 1
          },
          {
            "text": "i mudrim nas čini više nego nebeske ptice?’",
            "poem": 2
          },
          {
            "noteId": 7
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Onda oni zapomažu, a on se ne odaziva",
            "poem": 1
          },
          {
            "text": "zbog ponosa zlobnika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Bog zacelo taštinu ne sluša,",
            "poem": 1
          },
          {
            "text": "Svemoćni i ne gleda na nju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "A koliko tek kad kažeš",
            "poem": 1
          },
          {
            "text": "kako ga ne vidiš,",
            "poem": 2
          },
          {
            "text": "kako je tvoj slučaj pred njim,",
            "poem": 1
          },
          {
            "text": "kako njega iščekuješ;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "kako gnev njegov ne kažnjava",
            "poem": 1
          },
          {
            "text": "i kako za greh i ne mari!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Elem, uzaludno Jov usta otvara",
            "poem": 1
          },
          {
            "text": "i gomila beznačajne reči.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 6,
        "caller": "+",
        "text": "35,3 Jov pita Boga.",
        "reference": {
          "chapter": 35,
          "verse": 3
        }
      },
      {
        "noteId": 7,
        "caller": "+",
        "text": "35,11 U duhu Jov 12,7-8ovaj stih može da se prevede i kao: koji nas poučava kroz zemaljske zveri i čini mudrim kroz nebeske ptice.",
        "reference": {
          "chapter": 35,
          "verse": 11
        }
      }
