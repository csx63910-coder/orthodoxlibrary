  "chapter": {
    "number": 22,
    "content": [
      {
        "type": "heading",
        "content": [
          "Elifas"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Tada je Elifas iz Temana uzvratio ovako:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Zar je čovek od koristi Bogu?",
            "poem": 1
          },
          {
            "text": "Da li mu je mudrac od koristi?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Zar se Svemoćni raduje što si pravedan?",
            "poem": 1
          },
          {
            "text": "Je li mu na korist kad puteve svoje učiniš bez mane?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Prekoreva li te za bogobojaznost tvoju",
            "poem": 1
          },
          {
            "text": "i da li se sudi s tobom?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Nije li golema zloba tvoja?",
            "poem": 1
          },
          {
            "text": "Zar nema kraja krivicama tvojim?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "A ti si braći svojoj bezrazložno zalog uzimao,",
            "poem": 1
          },
          {
            "text": "i sa njih si skidao haljine.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Iznemoglog vodom napojio nisi,",
            "poem": 1
          },
          {
            "text": "a ni gladnom hleba nisi dao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Jeste, ti si čovek silan, zemljoposednik si,",
            "poem": 1
          },
          {
            "text": "uglednik što u njoj živi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Tek, udovice si terao praznih ruku,",
            "poem": 1
          },
          {
            "text": "kršio si ruke siročadi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "I zato su oko tebe zamke,",
            "poem": 1
          },
          {
            "text": "nenadana strahota spopada te;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "ili mrak, pa ne vidiš ništa,",
            "poem": 1
          },
          {
            "text": "silna te je voda potopila.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Nije li Bog visoko na nebesima?",
            "poem": 1
          },
          {
            "text": "Pogledaj povrh zvezda, kako su visoko!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "A ti pitaš: ’Zna li šta Bog?",
            "poem": 1
          },
          {
            "text": "Da li sudi kroz tamu najgušću?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Oblaci su skrovište njegovo, pa ne vidi,",
            "poem": 1
          },
          {
            "text": "on korača po nebeskom svodu.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Puta drevnog zar ćeš se držati,",
            "poem": 1
          },
          {
            "text": "onog što ga utabaše ljudi pokvareni;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "oni što su odnešeni kad im vreme nije bilo,",
            "poem": 1
          },
          {
            "text": "kada im je temelje potopila reka?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Bogu su oni govorili: ’Prođi nas se!’",
            "poem": 1
          },
          {
            "text": "I: ’Šta će Svemoćni da nam radi?’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "A on im je dobrima kuće prepunio.",
            "poem": 1
          },
          {
            "text": "Zato je od mene podaleko savet zlikovaca!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Videće to pravednici i radovaće se,",
            "poem": 1
          },
          {
            "text": "rugaće im se nedužni:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "’Dušmani će naši baš zbrisani biti,",
            "poem": 1
          },
          {
            "text": "obilje njihovo progutaće plamen!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Izmiri se s Bogom, molim te,",
            "poem": 1
          },
          {
            "text": "i u miru budi, da na tebe dobro dođe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Prihvati, molim te, pouku njegovih usta",
            "poem": 1
          },
          {
            "text": "i njegove reči u srce svoje stavi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Vratiš li se Svemoćnome, obnovljen ćeš biti;",
            "poem": 1
          },
          {
            "text": "ukloniš li bezakonje iz šatora svoga,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "odbaciš li zlato u prašinu",
            "poem": 1
          },
          {
            "text": "i ofirsko zlato po potočnom kamenju;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Svemoćni biće zlato tvoje,",
            "poem": 1
          },
          {
            "text": "najčistije srebro tvoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Tada ćeš se radovati Svemoćnome,",
            "poem": 1
          },
          {
            "text": "lice svoje podignućeš Bogu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Molićeš se njemu i on će te čuti,",
            "poem": 1
          },
          {
            "text": "izvršićeš svoje zavete.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Ostvarićeš šta god da odlučiš,",
            "poem": 1
          },
          {
            "text": "svetlo će ti staze obasjati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Kad ponize ljude, ti ćeš reći:",
            "poem": 1
          },
          {
            "text": "’Uzvisite ih!’, i Bog će tada da spase skrušene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "On će da izbavi i onoga što nedužan nije,",
            "poem": 1
          },
          {
            "text": "zbog čistoće ruku tvojih izbaviće njega.“",
            "poem": 2
          }
        ]
      }
    ],
