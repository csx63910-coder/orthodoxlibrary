  "chapter": {
    "number": 10,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Duši mi se život ogadio!",
            "poem": 1
          },
          {
            "text": "Nad sobom ću žalopojkom zažaliti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jadaću se u čemeru duše svoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Bogu ću reći: ’Ne osuđuj me!",
            "poem": 1
          },
          {
            "text": "Objavi mi za šta me optužuješ",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Zar ti je milo da tlačiš,",
            "poem": 1
          },
          {
            "text": "da odbaciš delo svojih ruku,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a da se smešiš nad naumom zlikovačkim?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Zar ti imaš oči čovekove,",
            "poem": 1
          },
          {
            "text": "pa da vidiš to što ljudi gledaju?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Jesu li ti dani smrtnikovi dani",
            "poem": 1
          },
          {
            "text": "i godine tvoje kao vek čoveka;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "pa krivice moje ispituješ",
            "poem": 1
          },
          {
            "text": "i za grehom mojim tragaš?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "A ti znaš da krivac nisam,",
            "poem": 1
          },
          {
            "text": "da iz tvoje ruke izbavljenja nema!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Uobličiše me tvoje ruke, sazdaše me,",
            "poem": 1
          },
          {
            "text": "a ti me proždireš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Seti se, molim te,",
            "poem": 1
          },
          {
            "text": "da si me ko glinu stvorio,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pa zar ćeš u prašinu da me vratiš?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Nisi li me ko mleko izlio",
            "poem": 1
          },
          {
            "text": "i zgrušao poput sira?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Nisi li me obukao u kožu i meso;",
            "poem": 1
          },
          {
            "text": "nisi li me izatkao kostima i venama?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Dao si mi i život i milost,",
            "poem": 1
          },
          {
            "text": "svojim si staranjem duh mi očuvao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ali, sve ove stvari si sakrio u srcu svome,",
            "poem": 1
          },
          {
            "text": "i znam da je to bilo u tebi!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ako bih i zgrešio, ti bi bdeo nada mnom;",
            "poem": 1
          },
          {
            "text": "ne bi me pomilovao zbog krivice moje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ako sam bio zlotvor, jao meni!",
            "poem": 1
          },
          {
            "text": "Ako sam bio pravedan, glavu svoju uzdizao nisam.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ali ja se davim u sramoti",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i svestan sam bede svoje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Uzdignem li se, kao lav me loviš",
            "poem": 1
          },
          {
            "text": "i ponovo na meni veličanstvo svoje pokazuješ.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Protiv mene nove svedoke dovodiš,",
            "poem": 1
          },
          {
            "text": "ljutiš se na mene sve više",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i vojsku za vojskom protiv mene šalješ.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Zašto si me izvadio iz majčinog krila?",
            "poem": 1
          },
          {
            "text": "Da sam barem izdahnuo, da me oko ugledalo nije!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Bio bih kao da me nikad nije bilo,",
            "poem": 1
          },
          {
            "text": "od majčinog krila do groba bi me odneli.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Zar moji dani nisu malobrojni?",
            "poem": 1
          },
          {
            "text": "Dosta više! Prođi me se,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "daj mi da se malo razveselim;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "pre nego odem u zemlju nepovrata,",
            "poem": 1
          },
          {
            "text": "noći i mraka najgušćeg;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "u zemlju krajnje tame,",
            "poem": 1
          },
          {
            "text": "dubokog crnila i nereda,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "gde je i svetlo kao potpuni mrak.’“",
            "poem": 2
          }
        ]
      }
    ],
