  "chapter": {
    "number": 15,
    "content": [
      {
        "type": "heading",
        "content": [
          "Elifas"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Tada je Elifas iz Temana uzvratio ovako:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Zar mudar čovek odgovara u vetar,",
            "poem": 1
          },
          {
            "text": "zar svoj stomak puni istočnim vetrom?!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Raspravlja li rečima beznačajnim",
            "poem": 1
          },
          {
            "text": "i govorima koji nikome nisu na korist?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "A ti satireš pobožnost,",
            "poem": 1
          },
          {
            "text": "razmišljanje pred Bogom ometaš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Krivice tvoje pouku daju ustima tvojim,",
            "poem": 1
          },
          {
            "text": "jezikom se lukavim ti služiš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Sopstvena te usta osuđuju ko krivca,",
            "poem": 1
          },
          {
            "text": "a ne ja; sopstvene usne protiv tebe svedoče.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Da ti nisi prvorođeno ljudsko biće,",
            "poem": 1
          },
          {
            "text": "iznedren pre planina?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Da nisi slušao Božije tajne savete",
            "poem": 1
          },
          {
            "text": "i za sebe zadržao mudrost?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Šta to ti znaš, a mi da ne znamo?",
            "poem": 1
          },
          {
            "text": "Šta ti shvataš, a da nama to nije dano?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Među nama ima i sedih i starih,",
            "poem": 1
          },
          {
            "text": "starijih i od oca tvoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Šta, nisu ti dovoljne Božije utehe",
            "poem": 1
          },
          {
            "text": "i obzirno upućena ti reč?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Zašto ti se srce tvoje ponelo?",
            "poem": 1
          },
          {
            "text": "Zašto ti sevaju oči tvoje,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "pa se tvoj duh protiv Boga okrenuo",
            "poem": 1
          },
          {
            "text": "i ustima svojim prosipaš reči?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Pa šta je čovek da bi čist bio,",
            "poem": 1
          },
          {
            "text": "da bi pravedan bio onaj što ga žena rodi?!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "On se ni u svete",
            "poem": 1
          },
          {
            "noteId": 3
          },
          {
            "text": "svoje ne pouzdaje,",
            "poem": 1
          },
          {
            "text": "očima njegovim ni nebesa nisu čista,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "a kamoli gnusan i iskvaren čovek,",
            "poem": 1
          },
          {
            "text": "čovek što nepravdu kao vodu pije!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Elem, ja ću ti reći! Mene poslušaj,",
            "poem": 1
          },
          {
            "text": "objaviću ti ono što sam video;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "ono što su mudri ljudi predali od predaka svojih",
            "poem": 1
          },
          {
            "text": "i to nisu prikrili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "A samo je njima zemlja bila dana",
            "poem": 1
          },
          {
            "text": "i tuđinac nije prolazio među njima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Tek, zlobnik se u bolu previja kroz sve dane,",
            "poem": 1
          },
          {
            "text": "i malo godina je određeno okrutnome.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Zvuk strahote mu je u ušima",
            "poem": 1
          },
          {
            "text": "i dok je još mir zatirač mu dolazi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Ne nada se povratku iz tame,",
            "poem": 1
          },
          {
            "text": "jer je za mač obeležen.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Potuca se zbog hleba: ’Gde je?’",
            "poem": 1
          },
          {
            "text": "On zna da mu se bliži crni dan.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Plaše ga i zebnja i nevolja,",
            "poem": 1
          },
          {
            "text": "nadvladavaju ga kao car za napad spreman;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "jer na Boga ruku svoju diže,",
            "poem": 1
          },
          {
            "text": "pred Svemoćnim oholo se drži.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "On juriša drsko protiv Boga,",
            "poem": 1
          },
          {
            "text": "nosi štit veliki i jaki.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Lice mu je zadriglo,",
            "poem": 1
          },
          {
            "text": "bokovi mu usaljeni;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "živi u ruinama od gradova,",
            "poem": 1
          },
          {
            "text": "u kućama napuštenim",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "što postaće gomile kamenja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Bogat neće biti i blago mu potrajati neće,",
            "poem": 1
          },
          {
            "text": "imanje mu se neće širiti po zemlji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "On neće pobeći iz tame,",
            "poem": 1
          },
          {
            "text": "plamen će mu izdanak sparušiti",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i nestaće u dahu Božijih usta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Nek se ne uzda u bezvredno jer je zaveden,",
            "poem": 1
          },
          {
            "text": "jer će mu bezvredno postati nagrada;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "a nagrađen će biti i pre svoga dana",
            "poem": 1
          },
          {
            "text": "i grana mu neće ozeleneti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Kao loza otrešće svoj nezreli grozd",
            "poem": 1
          },
          {
            "text": "i kao maslina strešće cvat svoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Jer jalovo je društvo bezbožničko,",
            "poem": 1
          },
          {
            "text": "a šatore podmićenih vatra progutaće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Začeće nevolju, a rodiće zlobu,",
            "poem": 1
          },
          {
            "text": "stomaci im spremni za obmanu.“",
            "poem": 2
          }
        ]
      }
    ],
