  "book": {
    "id": "JOB",
    "translationId": "srp_onstl",
    "name": "Knjiga o Jovu",
    "commonName": "Knjiga o Jovu",
    "title": "Knjiga o Jovu",
    "order": 18,
    "numberOfChapters": 42,
    "sha256": "d1e46942f0c7e97d817f38ef6b8528c9892703f118754d74ed93a1134f467d32",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/JOB/1.json",
    "lastChapterNumber": 42,
    "lastChapterApiLink": "/api/srp_onstl/JOB/42.json",
    "totalNumberOfVerses": 1070
  },
  "chapter": {
    "number": 31,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Sa očima svojim savez sam sklopio,",
            "poem": 1
          },
          {
            "text": "pa kako bih onda zagledao devojku?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Pa šta to onda Bog odozgo deli?",
            "poem": 1
          },
          {
            "text": "Kakvo je sa visina nasledstvo Svemoćnog?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Nije li to propast za zlotvora",
            "poem": 1
          },
          {
            "text": "i nesreća za pokvarenjaka?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ne vidi li on puteve moje,",
            "poem": 1
          },
          {
            "text": "zar ne broji sve moje korake?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ako sam se družio s lažovima,",
            "poem": 1
          },
          {
            "text": "ako mi je noga žurila ka obmani;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "neka me izmeri na tasovima tačnim,",
            "poem": 1
          },
          {
            "text": "nek čestitost moju Bog otkrije.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ako je moj korak zašao sa puta,",
            "poem": 1
          },
          {
            "text": "srce moje povelo se za mojim očima,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "za ruke mi prionula ljaga;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "tad nek žanjem, a drugi nek jede,",
            "poem": 1
          },
          {
            "text": "nek se moja letina počupa.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ako li je žena srce mi zavela,",
            "poem": 1
          },
          {
            "text": "ako sam bližnjeg svoga na ulazu vrebao;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "nek tad drugom moja žena melje,",
            "poem": 1
          },
          {
            "text": "u postelji drugih neka bude.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ali to bi bila gadost,",
            "poem": 1
          },
          {
            "text": "baš krivica za osudu!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Da, bila bi to vatra koja guta sve do truleži mrtvih",
            "poem": 1
          },
          {
            "text": "i spaljuje svu letinu moju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Elem, ako sam se oglušio na tužbu",
            "poem": 1
          },
          {
            "text": "sluškinje svoje ili sluge svoga,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kada su se parničili sa mnom;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "šta bih uradio kada bi Bog ustao,",
            "poem": 1
          },
          {
            "text": "kad bi mi račun zatražio?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Šta li bih mu tada uzvratio?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Nije li onaj što me sazdao u utrobi i njih sazdao?",
            "poem": 1
          },
          {
            "text": "Zar nas nije jedan isti načinio u stomaku?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ako sam se oglušio na želju siromaha",
            "poem": 1
          },
          {
            "text": "i rasplakao oči udovici;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "ako sam svoj zalogaj hleba jeo u samoći,",
            "poem": 1
          },
          {
            "text": "a siroče nije uzelo od njega –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "jer je uz mene raslo kao uz oca još od mladosti moje,",
            "poem": 1
          },
          {
            "text": "a udovici sam pomagao još od kako me majka rodila –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "ako sam video stradalnika neodevenog,",
            "poem": 1
          },
          {
            "text": "ako nisam zaodenuo ubogog;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "ako me bedra njegova blagosiljala nisu,",
            "poem": 1
          },
          {
            "text": "ako se runom ovaca mojih utoplio nije;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "ako sam odmahnuo rukom protiv siročeta,",
            "poem": 1
          },
          {
            "text": "a znao sam da na sudu mogu da pomognem;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "neka mi ruka iz ramena otpadne",
            "poem": 1
          },
          {
            "text": "i nek mi se šaka prelomi u zglobu!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Jer, drhtao sam od Božije strahote,",
            "poem": 1
          },
          {
            "text": "pred njegovim veličanstvom ne bih to činio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Ako sam se u zlato uzdao,",
            "poem": 1
          },
          {
            "text": "suvom zlatu govorio: ’Pouzdanje moje!’;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "ako sam se radovao svom velikom blagu,",
            "poem": 1
          },
          {
            "text": "što mi je ruka toliko zgrnula;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "ako sam u sunce gledao dok sija",
            "poem": 1
          },
          {
            "text": "i u mesec sjajni dok putuje;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "ako mi se srce potajno zanosilo,",
            "poem": 1
          },
          {
            "text": "pa sam im rukom slao poljupce sa svojih usta;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "i to bi bila krivica što vapi za sudom,",
            "poem": 1
          },
          {
            "text": "jer bih tako porekao Boga sa visine!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Elem, ako sam se radovao nad nesrećom dušmanina moga,",
            "poem": 1
          },
          {
            "text": "likovao kad ga propast snađe;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "nisam dao ustima da zgreše,",
            "poem": 1
          },
          {
            "text": "da mu kletvu prizivam na dušu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Nisu li ljudi iz šatora rekli:",
            "poem": 1
          },
          {
            "text": "’Ko se još mesa njegovoga najeo nije?’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Pridošlica na ulici noć proveo nije,",
            "poem": 1
          },
          {
            "text": "putniku sam otvarao vrata.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Da li sam grehe svoje prikrivao kao Adam,",
            "poem": 1
          },
          {
            "text": "i krivicu krio u grudima svojim;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "jer sam se prepao velikog mnoštva,",
            "poem": 1
          },
          {
            "text": "strahovao od prezira u rodu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pa se ućutao i kroz vrata ne bih izlazio?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "O, kad bi me neko čuo!",
            "poem": 1
          },
          {
            "text": "Evo, ovo potpisujem,",
            "poem": 2
          },
          {
            "text": "pa neka me usliši Svemoćni,",
            "poem": 1
          },
          {
            "text": "a evo i optužnice što je tužilac protiv mene podigao!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Zar je ne bih ja poneo na ramenu svome,",
            "poem": 1
          },
          {
            "text": "na sebe je kao krunu pričvrstio?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Račun bih mu položio za korake svoje,",
            "poem": 1
          },
          {
            "text": "kao vladar bih mu pristupio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "Ako je zbog mene vapila zemlja moja",
            "poem": 1
          },
          {
            "text": "i u glas plakale brazde njene;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          {
            "text": "ako sam zabadava jeo plodove njene",
            "poem": 1
          },
          {
            "text": "i duši njihovih vlasnika zadao jade;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          {
            "text": "umesto pšenicom nek urodi trnjem",
            "poem": 1
          },
          {
            "text": "i korovom umesto ječma!“",
            "poem": 2
          },
          "Jov je završio svoja kazivanja."
        ]
      }
    ],
