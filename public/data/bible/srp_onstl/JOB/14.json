  "chapter": {
    "number": 14,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Čovek rođen od žene kratko živi",
            "poem": 1
          },
          {
            "text": "i pun je nevolja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Iznikne kao cvet, pa svene;",
            "poem": 1
          },
          {
            "text": "beži poput sene i ne traje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Zar na takvog pogled svoj obraćaš",
            "poem": 1
          },
          {
            "text": "i mene pred sebe na sud dovodiš!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ko će čistim nečisto da učini?",
            "poem": 1
          },
          {
            "text": "Niko!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Njegovi su dani određeni,",
            "poem": 1
          },
          {
            "text": "ti poznaješ broj njegovih meseci;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "međe si mu postavio da ih ne prelazi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Skreni pogled s njega, pa neka odahne,",
            "poem": 1
          },
          {
            "text": "dok kao najamnik svoj dan ne odradi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Jer postoji nada i za drvo posečeno;",
            "poem": 1
          },
          {
            "text": "ponovo će da iznikne",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i neće ostati bez mladica svojih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Nek mu se i koren u zemlji sparuši",
            "poem": 1
          },
          {
            "text": "i panj mu se u zemlji sasuši;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "propupeće čim oseti vodu,",
            "poem": 1
          },
          {
            "text": "pustiće izdanke kao da je zasad!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "A čovek skončava onemoćao;",
            "poem": 1
          },
          {
            "text": "izdahne smrtnik, i gde je on?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Iz mora ishlapi voda,",
            "poem": 1
          },
          {
            "text": "a potok presahne, presuši;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "tako i čovek legne da više ne ustane;",
            "poem": 1
          },
          {
            "text": "dok nebesa ne bude bilo ne bude se,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ne dižu se ljudi iz sna njihovoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "O, kada bi me u Svet mrtvih sakrio,",
            "poem": 1
          },
          {
            "text": "sklonio me dok gnev tvoj ne mine;",
            "poem": 2
          },
          {
            "text": "kada bi mi postavio rok",
            "poem": 1
          },
          {
            "text": "i tad me se setio!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Alʼ kad čovek umre, da li više živi?",
            "poem": 1
          },
          {
            "text": "Kroz sve dane svog kulučenja,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ja čekaću da mi stigne smena.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ti ćeš me pozvati i ja ću se odazvati,",
            "poem": 1
          },
          {
            "text": "zaželećeš delo ruku svojih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Tada ćeš mi korake brojati,",
            "poem": 1
          },
          {
            "text": "na moj greh se nećeš osvrtati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Prestup si moj svezao u vreću,",
            "poem": 1
          },
          {
            "text": "krivicu si moju izbelio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ali kao što se gora ruši, odranja se,",
            "poem": 1
          },
          {
            "text": "kao što se kamen sa svog mesta svalja;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "ko što vode razdrobe kamenje",
            "poem": 1
          },
          {
            "text": "i bujice tlo isperu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i ti tako uništavaš čovekovu nadu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Jednom zasvagda ti ga nadvladavaš i on odlazi,",
            "poem": 1
          },
          {
            "text": "lice mu menjaš i otpuštaš ga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "I on ne zna da li su mu sinovi u časti,",
            "poem": 1
          },
          {
            "text": "i ne vidi ako su neznatni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Samo mu je telo u bolu svome,",
            "poem": 1
          },
          {
            "text": "samo mu duša za sobom pati.“",
            "poem": 2
          }
        ]
      }
    ],
