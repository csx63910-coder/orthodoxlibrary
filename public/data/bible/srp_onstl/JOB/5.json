  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Hajde, pozivaj! Ko će ti se odazvati?",
            "poem": 1
          },
          {
            "text": "Kome od svetih ćeš da se okreneš?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Bezumnika ubija bezumlje,",
            "poem": 1
          },
          {
            "text": "a lakovernog satire zavist.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Lično sam video bezumnika kako se odomaćuje",
            "poem": 1
          },
          {
            "text": "i odmah sam prokleo njegovo gazdinstvo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Jer, deca su mu daleko od sigurnosti,",
            "poem": 1
          },
          {
            "text": "ginu na vratima, a nema ko da ih izbavi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Letinu njegovu jede ko je gladan,",
            "poem": 1
          },
          {
            "text": "kupi je čak i ispod trnja,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "dok žedan vreba na njihovo blago.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Jer šteta ne izlazi iz prašine",
            "poem": 1
          },
          {
            "text": "i iz zemlje ne niče nevolja;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "već se čovek rađa za nevolju",
            "poem": 1
          },
          {
            "text": "ko što u vis vrcaju varnice.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ali ja bih da Boga tražim",
            "poem": 1
          },
          {
            "text": "i Bogu svoj slučaj da iznesem;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "njemu, što velike stvari čini,",
            "poem": 1
          },
          {
            "text": "neistraživo mnoštvo čudesa njegovih;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "njemu, koji daje kišu zemlji",
            "poem": 1
          },
          {
            "text": "i koji šalje vodu poljima;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "njemu, koji ponižene na visinu stavlja",
            "poem": 1
          },
          {
            "text": "i žalosne na sigurno diže;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "njemu, koji mrsi naume lukavih",
            "poem": 1
          },
          {
            "text": "i ne daje da im ruke s uspehom posluju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Bog nadmudruje mudre njihovim lukavstvom,",
            "poem": 1
          },
          {
            "text": "sunovraćuje savet prepredenih",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "koji usred dana pomrčinu sreću",
            "poem": 1
          },
          {
            "text": "i u podne pipaju ko noću.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Da, Bog spasava od mača iz njihovih usta",
            "poem": 1
          },
          {
            "text": "i siromaha iz ruku jakoga!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Tad ubogi zadobija nadu,",
            "poem": 1
          },
          {
            "text": "a nepravda zatvara usta svoja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "O, kako je blagosloven čovek koga Bog prekoreva!",
            "poem": 1
          },
          {
            "text": "Zato ne preziri opomenu Svemoćnoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Jer on i rani i zavije;",
            "poem": 1
          },
          {
            "text": "on udara, ali ruke njegove leče.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Od šest će te nevolja spasti,",
            "poem": 1
          },
          {
            "text": "a i u sedmoj zlo te se neće dotaći.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "U gladi će te spasti, od smrti",
            "poem": 1
          },
          {
            "text": "i od snage mača u ratu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Sakriven ćeš biti od šibe jezika",
            "poem": 1
          },
          {
            "text": "i nećeš strepeti od propasti kad stigne.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Smejaćeš se razaranju i gladi",
            "poem": 1
          },
          {
            "text": "i nećeš strepeti od zemaljskih zveri,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "jer ćeš biti u savezu s kamenjem po polju",
            "poem": 1
          },
          {
            "text": "i zemaljske će zveri biti u miru sa tobom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Videćeš da si siguran u šatoru svome,",
            "poem": 1
          },
          {
            "text": "obilazićeš imanje svoje i ništa mu zafaliti neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Videćeš da će ti deca biti brojna,",
            "poem": 1
          },
          {
            "text": "da je tvojih naslednika kao trave po zemlji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Jedar ćeš otići u grob,",
            "poem": 1
          },
          {
            "text": "kao što se u pravo vreme sakuplja snop žita.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Eto, to smo proučili. To je tako.",
            "poem": 1
          },
          {
            "text": "A ti si čuo, pa primeni to na sebe!“",
            "poem": 2
          }
        ]
      }
    ],
