  },
  "chapter": {
    "number": 40,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Gospod još reče Jovu:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Kao muško opaši slabine svoje,",
            "poem": 1
          },
          {
            "text": "da te ja pitam, a ti da mi odgovaraš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Zar bi ti da pravednost moju obezvrediš?",
            "poem": 1
          },
          {
            "text": "Proglasio bi mene krivim",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da bi sebe proglasio pravim?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Imaš li ti ruku ko što je Božija?",
            "poem": 1
          },
          {
            "text": "Glas tvoj da li kao njegov grmi?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Hajde, veličanstvom i ugledom ukrasi se,",
            "poem": 1
          },
          {
            "text": "u čast i slavu obuci se!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Izlij poplavu srdžbe svoje!",
            "poem": 1
          },
          {
            "text": "Svakog gordog pogledaj i sruši ga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Pogledaj sve gorde, pa ih ponizi;",
            "poem": 1
          },
          {
            "text": "na licu mesta izgazi zle.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Zajedno ih u prašinu zatrpaj,",
            "poem": 1
          },
          {
            "text": "preko lica pokrov u grobnici sveži.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Tada ću ti ja priznati",
            "poem": 1
          },
          {
            "text": "da desnica tvoja može da te spase.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "A gle, čudovište behemota",
            "poem": 1
          },
          {
            "noteId": 10
          },
          {
            "text": "koje sam sa tobom zajedno stvorio!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "On poput vola pase,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "a vidi mu snage u bedrima njegovim!",
            "poem": 1
          },
          {
            "text": "Sila mu je u trbušnim mišićima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Rep ukruti kao kedar,",
            "poem": 1
          },
          {
            "text": "bedrene mu žile prepletene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Kosti su mu ko cevi bronzane,",
            "poem": 1
          },
          {
            "text": "a udovi ko metalne cevi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "On je prvo delo Božijeg stvaranja,",
            "poem": 1
          },
          {
            "text": "Sazdatelj mu njegov sa mačem prilazi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Njemu brda hranu daju,",
            "poem": 1
          },
          {
            "text": "tamo gde se igraju zveri poljske.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ispod lotosa on leži,",
            "poem": 1
          },
          {
            "text": "krije se u trski i močvari.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Lotosi ga zaklanjaju senkom,",
            "poem": 1
          },
          {
            "text": "okružen je potočnim vrbama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Gle, podivlja li reka, njega to ne straši;",
            "poem": 1
          },
          {
            "text": "nema straha ni kad Jordan jurne mu u usta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Može li ga iko zgrabiti dok gleda?",
            "poem": 1
          },
          {
            "text": "Može li mu iko njušku probosti kukama?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Zar ćeš levijatana udicom da izvučeš",
            "poem": 1
          },
          {
            "text": "i konopcem jezik da mu svežeš?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Hoćeš li mu uže kroz nos da provučeš",
            "poem": 1
          },
          {
            "text": "i čeljust mu kukom da probodeš?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Hoće li te preklinjati mnogo",
            "poem": 1
          },
          {
            "text": "i umilne pričati ti reči?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Zar će savez s tobom da načini?",
            "poem": 1
          },
          {
            "text": "Držaćeš ga doveka ko roba?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Igraćeš se sa njim ko sa pticom,",
            "poem": 1
          },
          {
            "text": "povocem svezati za svoje devojke?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Zar će se ortaci cenjkati za njega,",
            "poem": 1
          },
          {
            "text": "na komade podeliti trgovcima?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Hoćeš li mu kožu izbosti ostvama",
            "poem": 1
          },
          {
            "text": "i glavu harpunom?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Ako ruke na njega položiš –",
            "poem": 1
          },
          {
            "text": "sećaćeš se toga boja,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "alʼ ga više ponoviti nećeš!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Ali, uludo je nadati se tome!",
            "poem": 1
          },
          {
            "text": "Zar čovek ne pada samo kada ga ugleda?",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 10,
