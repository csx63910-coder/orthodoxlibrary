  "chapter": {
    "number": 20,
    "content": [
      {
        "type": "heading",
        "content": [
          "Sofar"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "A Sofar iz Namata je odgovorio ovim rečima:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Ako je tako, nemirne me misli moje teraju da odgovorim,",
            "poem": 1
          },
          {
            "text": "jer u meni vri.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Uvređen sam prekorom koji sam čuo,",
            "poem": 1
          },
          {
            "text": "pa sad uzvraćam u duhu mog razumevanja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Elem, znaš li da je tako od davnina,",
            "poem": 1
          },
          {
            "text": "od kako je ljudski rod na zemlju stavljen:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "prekratka je radost zlikovaca",
            "poem": 1
          },
          {
            "text": "i za časak sreća bezbožnika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Sve i da se stasom digne do nebesa,",
            "poem": 1
          },
          {
            "text": "da mu glava oblake dosegne,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "ishlapiće doveka ko sopstveni izmet,",
            "poem": 1
          },
          {
            "text": "i pitaće: ’Gde je?’, oni što su ga viđali.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Poput sna će ispariti i neće ga naći,",
            "poem": 1
          },
          {
            "text": "prognaće ga kao noćno priviđenje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Oko koje ga je gledalo videti ga više neće;",
            "poem": 1
          },
          {
            "text": "zavičaj ga njegov više neće videti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Njegovi će se sinovi dodvoravati siromasima,",
            "poem": 1
          },
          {
            "text": "a on će rukama svojim vraćati od bogatstva svoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Kosti su mu pune mladalačke snage",
            "poem": 1
          },
          {
            "text": "koja će sa njime u prah leći.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Neka mu je i slatko zlo u ustima njegovim,",
            "poem": 1
          },
          {
            "text": "što ga skriva pod jezikom svojim;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "neka ga štedi, neka ga ne pušta,",
            "poem": 1
          },
          {
            "text": "neka ga pod nepcem rastapa;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "ta njegova hrana u crevima,",
            "poem": 1
          },
          {
            "text": "u utrobi njegovoj će se pretvoriti u otrov kobre.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Povratiće iz stomaka svoga blago progutano,",
            "poem": 1
          },
          {
            "text": "Bog će mu ga izbaciti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Otrov kobri sisa,",
            "poem": 1
          },
          {
            "text": "ubiće ga jezik otrovnice.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "U potoke gledati neće,",
            "poem": 1
          },
          {
            "text": "u brzake reka od meda i masla.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Vratiće šta je oteo, neće moći to da proguta;",
            "poem": 1
          },
          {
            "text": "uživati neće dobra svoje trgovine.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Jer je tlačio i zapostavljao siromahe,",
            "poem": 1
          },
          {
            "text": "harao je kuću koju zidao nije.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Njegov stomak ne zna šta je dosta,",
            "poem": 1
          },
          {
            "text": "spokoja mu nema u onome za čim žudi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Neće imati šta više da proždere",
            "poem": 1
          },
          {
            "text": "i zato mu imanje neće potrajati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "I kada bude pun obilja biće u nevolji,",
            "poem": 1
          },
          {
            "text": "stići će ga ruka svakog stradalnika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Ali dok bude punio stomak svoj,",
            "poem": 1
          },
          {
            "text": "Bog će mu poslati plamen gneva svoga,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kao kišu na creva njegova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "I dok beži od gvozdenog oružja,",
            "poem": 1
          },
          {
            "text": "probošće ga strela luka bronzanoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Kada je izvuče,",
            "poem": 1
          },
          {
            "text": "kada mu izađe iz leđa",
            "poem": 2
          },
          {
            "text": "i ko munja iz žuči njegove,",
            "poem": 1
          },
          {
            "text": "doći će na njega užas.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Sva je tama sačuvana za njegovo blago,",
            "poem": 1
          },
          {
            "text": "proždraće ga plamen neraspiren,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "zlo naneće preživelom šatora njegovog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Nebesa će razotkriti njegovu krivicu,",
            "poem": 1
          },
          {
            "text": "zemlja će se podići na njega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Poplavljena biće letina kuće njegove,",
            "poem": 1
          },
          {
            "text": "otplavljena u dan Božijega gneva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Takva je od Boga sudbina za zlikovca,",
            "poem": 1
          },
          {
            "text": "bogomdano mu nasledstvo.“",
            "poem": 2
          }
        ]
      }
    ],
