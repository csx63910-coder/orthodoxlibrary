  "chapter": {
    "number": 37,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Stvarno, i moje srce zbog toga tuče,",
            "poem": 1
          },
          {
            "text": "otima se u grudima!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Slušajte! Počujte tutnjavu glasa njegovoga,",
            "poem": 1
          },
          {
            "text": "prolamanje što izlazi iz usta njegovih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ispod svih nebesa on ga pušta,",
            "poem": 1
          },
          {
            "text": "i munju svoju do krajeva zemlje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Za njom gromovi tuku",
            "poem": 1
          },
          {
            "text": "glasom slave njegove,",
            "poem": 2
          },
          {
            "text": "a kada se oglase tutnjavom svojom",
            "poem": 1
          },
          {
            "text": "ne vraća se više munja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "To Bog čudesno grmi glasom svojim",
            "poem": 1
          },
          {
            "text": "i velike, nama neshvatljive stvari čini!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Elem, on snegu kaže: ’Na zemlju padni!’",
            "poem": 1
          },
          {
            "text": "i obilnoj kiši: ’Pljušti!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Time svačiju ruku sputava u radu,",
            "poem": 1
          },
          {
            "text": "da bi svaki čovek znao za delo njegovo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Tada zveri idu u brloge svoje,",
            "poem": 1
          },
          {
            "text": "počivaju u svojim jazbinama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Oluja se sruči iz odaje svoje",
            "poem": 1
          },
          {
            "text": "i severci donose zimu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Dah Božiji led donosi",
            "poem": 1
          },
          {
            "text": "i široke vode ledi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Oblake tmurne je vlagom napunio",
            "poem": 1
          },
          {
            "text": "i sevne munjom po oblaku;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "i oni onda kruže,",
            "poem": 1
          },
          {
            "text": "valjaju se kako ih on vodi;",
            "poem": 2
          },
          {
            "text": "da urade što im je zapovedio",
            "poem": 1
          },
          {
            "text": "po licu sveta i zemlje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "A on to čini bilo kao prekor",
            "poem": 1
          },
          {
            "text": "ili kao milosrđe na dobro zemlje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "O, Jove, poslušaj ovo!",
            "poem": 1
          },
          {
            "text": "Stani pa razmotri čudesa Božija.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Znaš li kako ih je Bog poslagao,",
            "poem": 1
          },
          {
            "text": "kako zablešti munjom oblaka svoga?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Znaš li kako oblaci vise",
            "poem": 1
          },
          {
            "text": "i čudesa onog što je savršen u znanju?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ti, čije su haljine vruće",
            "poem": 1
          },
          {
            "text": "dok je zemlja mirna zbog južnog vetra;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "hoćeš li sa njim da razvlačiš oblake,",
            "poem": 1
          },
          {
            "text": "tvrde kao izliveno ogledalo?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Hajde nam kaži šta da mu kažemo!",
            "poem": 1
          },
          {
            "text": "Zbog tame svoj slučaj ne možemo da iznesemo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Da mu javimo da bih ja da progovorim?",
            "poem": 1
          },
          {
            "text": "Zar bi bilo ko govorio da bi proždran bio!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Sjajno svetlo na nebu ljudi sada ne mogu da vide,",
            "poem": 1
          },
          {
            "text": "ali vetar huji i razvejava oblake.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Sa severa stiže zlatni sjaj",
            "poem": 1
          },
          {
            "text": "i oko Boga je slava veličanstva!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Svemoćnoga ne možemo naći.",
            "poem": 1
          },
          {
            "text": "Uzvišen je u sili,",
            "poem": 2
          },
          {
            "text": "ali u pravdi i velikoj pravednosti svojoj",
            "poem": 1
          },
          {
            "text": "on ne tlači.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Zato ga se boje ljudi:",
            "poem": 1
          },
          {
            "text": "on ne mari za mudre u srcu.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
