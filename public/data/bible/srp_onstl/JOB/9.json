  "chapter": {
    "number": 9,
    "content": [
      {
        "type": "heading",
        "content": [
          "Jov"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "A Jov je odgovorio ovim rečima:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Zaista, ja znam da je tako,",
            "poem": 1
          },
          {
            "text": "jer kako da se čovek opravda pred Bogom?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ako bi neko hteo da se spori sa njim,",
            "poem": 1
          },
          {
            "text": "ne bi mogao da mu odgovori jednu od hiljadu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "On je mudrog srca i svemoguć,",
            "poem": 1
          },
          {
            "text": "pa ko da mu prkosi i ostane čitav?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "On pomera gore da one to i ne znaju,",
            "poem": 1
          },
          {
            "text": "prevrće ih u jarosti svojoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "On potresa zemlju iz osnova njenih,",
            "poem": 1
          },
          {
            "text": "pa stubovi njeni drhte.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "On zapovedi suncu i ono ne sija,",
            "poem": 1
          },
          {
            "text": "nad zvezdama pečat stavlja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Samo on je taj što nebesa razastire",
            "poem": 1
          },
          {
            "text": "i maršira po morskim talasima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "On je načinio Medveda, Orion,",
            "poem": 1
          },
          {
            "text": "Vlašiće i južna sazvežđa.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "On čini velike stvari,",
            "poem": 1
          },
          {
            "text": "neistraživo je mnoštvo čudesa njegovih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Gle! Pored mene on prolazi, a ja ga ne vidim.",
            "poem": 1
          },
          {
            "text": "On prolazi, a ja ga ne opažam.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Vidi – on otima i ko da ga spreči?",
            "poem": 1
          },
          {
            "text": "Ko će da mu kaže: ’A šta to radiš?’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Bog ne odvraća svoj gnev,",
            "poem": 1
          },
          {
            "text": "pod njim su prostrti pomoćnici čudovišta Rave.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "A šta bih ja još mogao da mu uzvratim?",
            "poem": 1
          },
          {
            "text": "Koje reči da odaberem protiv njega?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Čak i da sam nevin, pravdati se neću,",
            "poem": 1
          },
          {
            "text": "sudiju ću svoga za milost da molim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ako ga zazovem i on mi se javi,",
            "poem": 1
          },
          {
            "text": "neću verovati da je mom vapaju poklonio pažnju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Jer on me lomi u oluji,",
            "poem": 1
          },
          {
            "text": "bez povoda zadaje mi mnoge rane.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ne pušta mi da dođem do daha",
            "poem": 1
          },
          {
            "text": "jer me je gorkim jadima nalio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ako je do sile, nesumnjivo on je silan;",
            "poem": 1
          },
          {
            "text": "ali ako je do pravde, ko će da me brani?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Sve i da se pravdam,",
            "poem": 1
          },
          {
            "text": "moja će me usta proglasiti krivim;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "osudiće me i da sam bez mane.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "I da sam bez mane, samog sebe ne poznajem",
            "poem": 1
          },
          {
            "text": "i svoj život ja prezirem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Sve je to jedno te isto. Zato kažem:",
            "poem": 1
          },
          {
            "text": "’I onog bez mane i onog zloga,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Bog će da dokrajči.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Ako bi bič nenadano ubijao,",
            "poem": 1
          },
          {
            "text": "on bi se rugao očaju nedužnih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Zemlja je predana u ruke zlikovca,",
            "poem": 1
          },
          {
            "text": "a on zatvara oči njenim sudijama.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Jer, ako nije on, ko je onda?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Moji dani protrčaše brže nego glasnik brzi;",
            "poem": 1
          },
          {
            "text": "utekoše, dobra ne videše;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Skliznuli su ko brodovi trske,",
            "poem": 1
          },
          {
            "text": "sručili se poput lešinara na lešinu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Ako bih kazao: ’Zaboravljam žalopojku svoju,",
            "poem": 1
          },
          {
            "text": "menjam izraz svoga lica i biću veseo’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "opet bih strepeo u svim svojim jadima,",
            "poem": 1
          },
          {
            "text": "i znam da ti me opravdao ne bi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Jer ako ću biti kriv,",
            "poem": 1
          },
          {
            "text": "zašto bih se uzalud trudio?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Sve da se i umijem snežnom vodom,",
            "poem": 1
          },
          {
            "text": "ruke svoje lužinom da sperem;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "i tad bi me u glibavu jamu uronio",
            "poem": 1
          },
          {
            "text": "da sam gadan i odeći svojoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Nije on čovek poput mene, pa da mu uzvratim,",
            "poem": 1
          },
          {
            "text": "da zajedno dođemo na sud.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Među nama nema posrednika",
            "poem": 1
          },
          {
            "text": "što bi ruku svoju položio na nas obojicu;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "ko bi žezlo Božije sa mene sklonio,",
            "poem": 1
          },
          {
            "text": "da me užas njegov ne užasne!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Tada bih govorio i ne bih ga se plašio.",
            "poem": 1
          },
          {
            "text": "Ali, sada nisam takav.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
