  "chapter": {
    "number": 12,
    "content": [
      {
        "type": "heading",
        "content": [
          "Jov"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "A Jov je odgovorio ovim rečima:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Nesumnjivo, baš vi ste mi ljudi",
            "poem": 1
          },
          {
            "text": "s kojima će i mudrost da skonča!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ali i ja imam pamet poput vaše,",
            "poem": 1
          },
          {
            "text": "ništa gori od vas nisam.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "I ko još ne zna ove stvari?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ja sam na podsmeh prijatelju svome,",
            "poem": 1
          },
          {
            "text": "ja, koji sam zazvao Boga i on mi se odazvao.",
            "poem": 2
          },
          {
            "text": "Na podsmeh je čovek pravedan,",
            "poem": 1
          },
          {
            "text": "čovek besprekoran.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "’On je za propast i prezir’ –",
            "poem": 1
          },
          {
            "text": "stav je bezbrižnoga –",
            "poem": 2
          },
          {
            "text": "’Gurnuti treba onoga",
            "poem": 1
          },
          {
            "text": "što mu noge posrću!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "A u šatorima okrutnih je mir,",
            "poem": 1
          },
          {
            "text": "spokojni su oni što Boga izazivaju",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i oni što u ruci svojoj boga svoga nose",
            "poem": 2
          },
          {
            "noteId": 2
          },
          {
            "text": ".",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ali, molim te, pitaj životinje",
            "poem": 1
          },
          {
            "text": "i poučiće te;",
            "poem": 2
          },
          {
            "text": "i ptice na nebu",
            "poem": 1
          },
          {
            "text": "neka ti kažu!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Sa zemljom popričaj i poučiće te,",
            "poem": 1
          },
          {
            "text": "ribe u moru će ti kazivati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ko od njih još ne zna",
            "poem": 1
          },
          {
            "text": "da je ovo načinila Gospodnja ruka?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "U njegovoj je ruci duša svega živog",
            "poem": 1
          },
          {
            "text": "i dah tela čovečanstva celog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ne razaznaje li uho reči",
            "poem": 1
          },
          {
            "text": "ko što nepce hranu proba?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ne dolazi li mudrost s godinama",
            "poem": 1
          },
          {
            "text": "i razboritost sa danima mnogim?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Sa Bogom su i mudrost i snaga,",
            "poem": 1
          },
          {
            "text": "njegovi su i savet i razboritost.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Gle, što on razgradi, niko ne sagradi;",
            "poem": 1
          },
          {
            "text": "kad on čoveka zatvori i niko ga ne oslobodi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Gle, on vode zadržava i one presuše;",
            "poem": 1
          },
          {
            "text": "on ih oslobađa i zemlja je izrovana.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Sa njim su snaga i pouzdana mudrost,",
            "poem": 1
          },
          {
            "text": "zavedeni i zavodnik su njegovi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "On bosonoge odvodi savetnike",
            "poem": 1
          },
          {
            "text": "i sluđuje sudije.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Careve on raspojasava,",
            "poem": 1
          },
          {
            "text": "kaišom im opasuje bedra.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "On bosonoge odvodi sveštenike",
            "poem": 1
          },
          {
            "text": "i svrgava vlastodršce.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Pouzdanim usne on zatvara,",
            "poem": 1
          },
          {
            "text": "pronicljivost starcima odnosi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Na plemiće on prezir izliva,",
            "poem": 1
          },
          {
            "text": "delijama kaiš otkopčava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "On iz mraka objavljuje nedokučive stvari,",
            "poem": 1
          },
          {
            "text": "mrklu tamu iznosi na svetlo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Narode on velikim čini i satire ih;",
            "poem": 1
          },
          {
            "text": "umnoži narode, pa ih rasprši.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "On uzima razum starešinama naroda zemaljskih,",
            "poem": 1
          },
          {
            "text": "čini da lutaju pustarom besputnom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Oni u mraku pipaju, bez svetla,",
            "poem": 1
          },
          {
            "text": "a on čini da posrću ko pijanci.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 2,
        "caller": "+",
        "text": "12,6 Poslednji deo stiha može da se prevede i kao: premda ih Bog u šaci drži.",
