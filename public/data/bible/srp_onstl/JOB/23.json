  "chapter": {
    "number": 23,
    "content": [
      {
        "type": "heading",
        "content": [
          "Jov"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "A Jov je odgovorio ovim rečima:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Još i danas je jetka moja žalopojka",
            "poem": 1
          },
          {
            "text": "i s mukom se borim da ne bih ječao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "O, kada bih znao gde ću da ga nađem,",
            "poem": 1
          },
          {
            "text": "došao bih do njegovog mesta!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Pred njim bih izložio svoj slučaj,",
            "poem": 1
          },
          {
            "text": "dokazima usta svoja napunio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Da mi je da znam kojim bi mi rečima odgovorio;",
            "poem": 1
          },
          {
            "text": "da mi je da razumem šta bi mi rekao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Da li bi se silom velikom parničio sa mnom?",
            "poem": 1
          },
          {
            "text": "Ne bi, nego bi se zauzeo za me.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Onde bi se pravednik sa njim raspravio,",
            "poem": 1
          },
          {
            "text": "moj bi me sudija zauvek izbavio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Gle, odem li napred, njega nema;",
            "poem": 1
          },
          {
            "text": "ni pozadi njega ne opažam.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ne vidim ga ni na levo, tamo gde deluje;",
            "poem": 1
          },
          {
            "text": "ne vidim ga ni na desno, kada se okrene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ali on zna put kojim idem;",
            "poem": 1
          },
          {
            "text": "pretapa me da čist budem poput zlata.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Po njegovoj stopi moj je korak išao,",
            "poem": 1
          },
          {
            "text": "njegovog sam se puta držao i nisam skretao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Zapovest njegovih usana nisam napustio,",
            "poem": 1
          },
          {
            "text": "čuvao sam reči njegove više nego hleb nasušni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ali on je jedini i ko će da ga menja!",
            "poem": 1
          },
          {
            "text": "Šta god da poželi, on tako i čini.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Naume će svoje, meni namenjene, izvršiti,",
            "poem": 1
          },
          {
            "text": "a u njemu još je takvog mnogo čega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Zato sam preplašen od njega;",
            "poem": 1
          },
          {
            "text": "kad razmišljam, ježim se od njega!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Elem, Bog je moje srce smalaksao,",
            "poem": 1
          },
          {
            "text": "Svemoćni me je prestravio;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "ipak nisam bio satrt mrakom,",
            "poem": 1
          },
          {
            "text": "niti mi je gusta tama zaklonila lice.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
