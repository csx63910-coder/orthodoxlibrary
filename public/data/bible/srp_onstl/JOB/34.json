  },
  "chapter": {
    "number": 34,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Elijuj je nastavio svoje kazivanje:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Vi mudri, poslušajte reči moje;",
            "poem": 1
          },
          {
            "text": "vi učeni, obratite pažnju!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jer, besede se uhom propituju,",
            "poem": 1
          },
          {
            "text": "ko što nepcem probaju se jela.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Šta je pravo, sami razlučimo,",
            "poem": 1
          },
          {
            "text": "među sobom prepoznajmo dobro.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Eto, Jov je rekao: ’Pravedan sam,",
            "poem": 1
          },
          {
            "text": "a Bog mi je uskratio moju pravdu!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Zar bih o svojoj pravdi lagao?",
            "poem": 1
          },
          {
            "text": "Na smrt sam proboden,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a zgrešio nisam.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Poput Jova ima li čoveka,",
            "poem": 1
          },
          {
            "text": "što porugu pije kao da je voda;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "koji ide za društvom zlotvora,",
            "poem": 1
          },
          {
            "text": "prijateljuje s pokvarenjacima?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Jer je kazao: ’Nikakva je korist za čoveka",
            "poem": 1
          },
          {
            "text": "da Bogu ugađa!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Zato me čujte, ljudi razumnog srca:",
            "poem": 1
          },
          {
            "text": "daleko bila od Boga pokvarenost",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i nepravednost od Svemoćnog!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Jer po delu on čoveku vraća,",
            "poem": 1
          },
          {
            "text": "čoveku uzvraća po putu njegovom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Bog zaista ne radi zlobno",
            "poem": 1
          },
          {
            "text": "i Svemoćni ne izvrće pravdu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ko je njemu poverio zemlju?",
            "poem": 1
          },
          {
            "text": "Ko li ga je postavio nad čitavim svetom?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Kada bi se srcem tome posvetio,",
            "poem": 1
          },
          {
            "text": "pa svoj duh i dah svoj sebi zadržao,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "svako bi telo nestalo,",
            "poem": 1
          },
          {
            "text": "čovečanstvo celo u prah bi se vratilo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Saslušaj me ako razum imaš,",
            "poem": 1
          },
          {
            "text": "počuj dobro reči moje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Hoće li da vlada onaj koji pravdu mrzi?",
            "poem": 1
          },
          {
            "text": "Zar ćeš krivim da proglasiš svemogućeg Pravednika?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Pa on caru kaže: ’Ništarijo’,",
            "poem": 1
          },
          {
            "text": "i plemiću: ’Zlikovče!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "On pristrasan nije prema glavarima",
            "poem": 1
          },
          {
            "text": "i ne povlađuje bogatom pred sirotim,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer njegovih ruku svi su oni delo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Usred noći u trenu umiru,",
            "poem": 1
          },
          {
            "text": "skončavaju ljudi potrešeni,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "moćnik nestaje bez ičije ruke.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Jer oči njegove put čovekov prate,",
            "poem": 1
          },
          {
            "text": "svaki korak njegov on posmatra.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Nema mraka, nema pomrčine",
            "poem": 1
          },
          {
            "text": "zlotvora da skrije.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Jer Bog ne odlaže vreme",
            "poem": 1
          },
          {
            "text": "kad mu čovek na sud dođe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Bez istrage moćnike obara,",
            "poem": 1
          },
          {
            "text": "na njihovo mesto on druge postavlja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Jer dela njihova njemu su znana,",
            "poem": 1
          },
          {
            "text": "preko noći on ih odbacuje,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "satrveni budu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Potire ih zbog njihove zlobe,",
            "poem": 1
          },
          {
            "text": "tamo gde i drugi vide,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "jer su se od njega okrenuli,",
            "poem": 1
          },
          {
            "text": "jer nisu marili za sve njegove puteve;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "jer je zbog njih do njega došao vapaj siromaha",
            "poem": 1
          },
          {
            "text": "i plač ubogih on je čuo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "A kada on umiri, ko da uznemiri?",
            "poem": 1
          },
          {
            "text": "Kad lice sakrije, ko će da ga nađe?",
            "poem": 2
          },
          {
            "text": "A tako biva i za narod i za čoveka,",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "da bezbožnik ne zavlada",
            "poem": 1
          },
          {
            "text": "i narodu ne postavi zamke.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Zar sme neko Bogu da kaže:",
            "poem": 1
          },
          {
            "text": "’Trpeo sam, alʼ grešiti više neću.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Pouči me onom što ne vidim;",
            "poem": 1
          },
          {
            "text": "ako li sam činio nepravdu, više neću.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Hoće li ti po tvome uzvratiti",
            "poem": 1
          },
          {
            "text": "jer ti ovo odbijaš?",
            "poem": 2
          },
          {
            "text": "Ali ti biraš, a ne ja,",
            "poem": 1
          },
          {
            "text": "pa sada govori ono što znaš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Razumni ljudi će mi reći,",
            "poem": 1
          },
          {
            "text": "a i čovek mudar što me sluša:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "’Nemudro zbori Jov!",
            "poem": 1
          },
          {
            "text": "Bez pouke su njegove reči!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "O, da bi doveka Jov kušan bio",
            "poem": 1
          },
          {
            "text": "kad već odgovara kao jedan od pokvarenjaka!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Jer je grehu svome i prestup dodao,",
            "poem": 1
          },
          {
            "text": "među nama on pljeska rukama",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i rečima mnogim obasipa Boga.“",
            "poem": 2
          }
        ]
      }
    ],
