  },
  "chapter": {
    "number": 24,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Zašto Svemoćni nije odredio vremena suda?",
            "poem": 1
          },
          {
            "text": "Zašto oni koji ga poznaju ne vide dane njegove?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Pomeraju ljudi međe,",
            "poem": 1
          },
          {
            "text": "stada otimaju, pa ih napasaju;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "siročadi odvode magarca,",
            "poem": 1
          },
          {
            "text": "vola za zalog uzimaju od udovice.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Oni razgone uboge sa puta,",
            "poem": 1
          },
          {
            "text": "skrivaju se zajedno siromasi zemlje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Eno, kao divlji magarci u pustinji idu svojim poslom;",
            "poem": 1
          },
          {
            "text": "hranu sebi traže,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "u pustari hleb za sebe i za decu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Po polju kupe krmu,",
            "poem": 1
          },
          {
            "text": "pabirče po vinogradu zlobnika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Neodeveni su, noćivaju bez ogrtača,",
            "poem": 1
          },
          {
            "text": "na zimi su bez pokrivača.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Iskisli su od planinske kiše,",
            "poem": 1
          },
          {
            "text": "bez zaklona krije se pod stenu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Siroče od dojenja kradu",
            "poem": 1
          },
          {
            "text": "i od siromaha uzimaju zalog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Tumaraju obnaženi,",
            "poem": 1
          },
          {
            "text": "neodeveni snoplje nose, a gladni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Među svojim drvoredima cede ulje,",
            "poem": 1
          },
          {
            "text": "grožđe muljaju u kaci, a žedni su.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Stenje narod u gradu,",
            "poem": 1
          },
          {
            "text": "za pomoć vape smrtno ranjeni,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a Bogu to nije mrsko.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "A neki su u društvu onih što ratuju protiv svetla,",
            "poem": 1
          },
          {
            "text": "što ne mare za puteve svetla",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i ne žive na stazama njegovim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "U zoru se krvnik diže,",
            "poem": 1
          },
          {
            "text": "sirotana i ubogog da ubije,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a po noći je ko lopov.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Preljubnikovo oko čeka sumrak jer govori:",
            "poem": 1
          },
          {
            "text": "’Da me oko ne ugleda!’,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pa pokriva lice svoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Kad je tama, lopov kuće prokopava,",
            "poem": 1
          },
          {
            "text": "a po danu se zaključava",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da za svetlost ne zna.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Jer je svima njima jutro poput gustog mraka,",
            "poem": 1
          },
          {
            "text": "predani su užasima mraka gustog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Prolete oni povrh voda,",
            "poem": 1
          },
          {
            "text": "prokleto im nasledstvo u zemlji",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i neka nijedan ne krene ka vinogradima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Poput suše i vrućine snežne vode kad odnesu,",
            "poem": 1
          },
          {
            "text": "tako i Svet mrtvih nosi one što se ogrešiše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Zaboravlja ga majčina utroba,",
            "poem": 1
          },
          {
            "text": "crvima je hrana;",
            "poem": 2
          },
          {
            "text": "njega više ne spominju,",
            "poem": 1
          },
          {
            "text": "nepravda će biti kao stablo prelomljeno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "On navaljuje na jalovu, na nerotkinju;",
            "poem": 1
          },
          {
            "text": "zlostavlja udovicu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Silom svojom Bog moćnike odvlači,",
            "poem": 1
          },
          {
            "text": "podiže se i niko za život siguran nije.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Bog im spokojstvo daje, pa se osiliše;",
            "poem": 1
          },
          {
            "text": "ali njegove su oči na njihovim putevima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Tek za malo uzdignu se i već ih nema;",
            "poem": 1
          },
          {
            "text": "ko svi drugi propadaju, venu;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "odsecaju se kao vršci klasja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Ako nije tako, ko će da mi laž dokaže?",
            "poem": 1
          },
          {
            "text": "Ko će da obezvredi kazivanje moje?“",
            "poem": 2
          }
        ]
      }
    ],
