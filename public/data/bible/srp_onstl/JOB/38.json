  "chapter": {
    "number": 38,
    "content": [
      {
        "type": "heading",
        "content": [
          "Gospodnje besede"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Tada je Gospod uzvratio Jovu iz vihora ovim rečima:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Ko je taj što moj savet",
            "poem": 1
          },
          {
            "text": "pomračuje rečima neznanja?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Kao muško opaši slabine svoje,",
            "poem": 1
          },
          {
            "text": "da te ja pitam, a ti da mi odgovaraš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Gde si ti bio kada sam polagao temelje zemlji?",
            "poem": 1
          },
          {
            "text": "Kaži ako si pametan!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ko joj je odredio mere – ako to znaš –",
            "poem": 1
          },
          {
            "text": "ko je merno uže nad njom razvukao?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Na čemu su njene osnove uglavljene?",
            "poem": 1
          },
          {
            "text": "Ko li joj je postavio ugaoni kamen",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "kada su jutarnje zvezde pevale složno",
            "poem": 1
          },
          {
            "text": "i kad su klicali svi Božiji sinovi",
            "poem": 2
          },
          {
            "noteId": 9
          },
          {
            "text": "?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ko je more zatvorio vratima",
            "poem": 1
          },
          {
            "text": "kada je prokuljalo i iz utrobe izašlo;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "kada sam mu od oblaka haljinu skrojio",
            "poem": 1
          },
          {
            "text": "i povoje od gustoga mraka;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "i pobo mu graničnike svoje,",
            "poem": 1
          },
          {
            "text": "uglavio rešetku i vrata;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "kada sam mu rekao:",
            "poem": 1
          },
          {
            "text": "’Dolazićeš dovde ali ne i dalje,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ovde je međa obesti talasa tvojih!’?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Jesi li za života svoga zapovedao jutru",
            "poem": 1
          },
          {
            "text": "i kazao zori gde joj je mesto,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "da prihvati zemlju za uglove,",
            "poem": 1
          },
          {
            "text": "da s nje budu otreseni zlobni ljudi?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "A zemlja se oblikuje kao glina pod pečatom,",
            "poem": 1
          },
          {
            "text": "pa sve na njoj ko haljina stoji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Tada se od zlobnika uzima svetlo njihovo,",
            "poem": 1
          },
          {
            "text": "lomi im se ruka uzdignuta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Da li si išao do izvora mora?",
            "poem": 1
          },
          {
            "text": "Jesi li hodao dubinom bezdana?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Da li su ti pokazana vrata smrti?",
            "poem": 1
          },
          {
            "text": "Jesi li video vrata od najcrnje tame?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Jesi li sagledao zemljina prostranstva?",
            "poem": 1
          },
          {
            "text": "Reci, ako znaš sve to!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Koji je put do kuće svetla?",
            "poem": 1
          },
          {
            "text": "Na kom se mestu nalazi tama?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Zar možeš da ih poneseš do njihovog mesta?",
            "poem": 1
          },
          {
            "text": "Znaš li za staze do njihovog stana?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Ma, ti to znaš, ti si se tada rodio",
            "poem": 1
          },
          {
            "text": "i golem je broj tvojih dana!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Jesi li bio u riznicama snega?",
            "poem": 1
          },
          {
            "text": "Jesi li video oružarnicu grada",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "koju sam sačuvao za vreme nevolje,",
            "poem": 1
          },
          {
            "text": "za dan boja i vojevanja?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "U kojem se smeru račva munja",
            "poem": 1
          },
          {
            "text": "i gde se istočni vetar po zemlji raznosi?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Ko poplavu račva na kanale",
            "poem": 1
          },
          {
            "text": "i put tutnjavi groma,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "da donese kišu zemlji bez ikoga",
            "poem": 1
          },
          {
            "text": "i pustari bez žive duše;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "da napoji pustoš i pustinju",
            "poem": 1
          },
          {
            "text": "i učini da iznikne trava?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Da li kiša oca ima?",
            "poem": 1
          },
          {
            "text": "Kapi rose ko je izrodio?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Iz čije se utrobe led rodio",
            "poem": 1
          },
          {
            "text": "i inje s nebesa ko je porodio,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "kad ko kamen vode se skamene,",
            "poem": 1
          },
          {
            "text": "površinom sledi se dubina?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Jesi li ti svezao Vlašiće lancima?",
            "poem": 1
          },
          {
            "text": "Hoćeš li da odrešiš Orion?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Možeš li da na vreme izvedeš sazvežđa",
            "poem": 1
          },
          {
            "text": "i povedeš Medveda sa njegovim medvedićima?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Poznaješ li zakone nebesa",
            "poem": 1
          },
          {
            "text": "i postavljaš li njihova pravila na zemlji?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Zar ti možeš oblacima da dovikneš,",
            "poem": 1
          },
          {
            "text": "pa da te silnim vodama obliju?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Možeš li da pošalješ munje,",
            "poem": 1
          },
          {
            "text": "da one krenu i kažu ti: ’Tu smo!’?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Ko je petlu dao mudrost",
            "poem": 1
          },
          {
            "text": "i ko je razumu znanje dao?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Ko mudrošću oblake broji",
            "poem": 1
          },
          {
            "text": "i ko ih izliva ko nebeske mešine,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "da stvrdne grumenje zemlje",
            "poem": 1
          },
          {
            "text": "i zgrudva busenje?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
