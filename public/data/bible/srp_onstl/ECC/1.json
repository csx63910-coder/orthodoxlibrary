  },
  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "heading",
        "content": [
          "Sve je prolazno"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Reči propovednika, Davidovog sina i cara u Jerusalimu:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Prolaznost nad prolaznošću – vajka se propovednik –",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "prolaznost nad prolaznošću!",
            "poem": 1
          },
          {
            "text": "Sve je prolazno!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "U čemu je korist ljudima od sveg njihovog truda",
            "poem": 1
          },
          {
            "text": "kojim se upinju pod kapom nebeskom?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Pokolenje dolazi, pokolenje odlazi,",
            "poem": 1
          },
          {
            "text": "a zemlja traje doveka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Sunce izlazi, sunce zalazi,",
            "poem": 1
          },
          {
            "text": "žuri na svoje mesto odakle izlazi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Vetar ide na jug",
            "poem": 1
          },
          {
            "text": "i kruži na sever,",
            "poem": 2
          },
          {
            "text": "kovitla li kovitla,",
            "poem": 1
          },
          {
            "text": "da se ponovo kružeći vrati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Sve reke u more teku,",
            "poem": 1
          },
          {
            "text": "a more nije puno;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i tamo odakle teku reke,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "vraćaju se da opet teku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Sve je to zamorno",
            "poem": 1
          },
          {
            "text": "i niko to ne može da iskaže.",
            "poem": 2
          },
          {
            "text": "Oko se nije nagledalo",
            "poem": 1
          },
          {
            "text": "i uho se nije zasitilo slušanja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Jer šta se već zbilo, opet će da se zbude;",
            "poem": 1
          },
          {
            "text": "i šta se radilo, opet će da se radi.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Baš ništa novo nema pod kapom nebeskom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Zar ima nečeg da neko kaže:",
            "poem": 1
          },
          {
            "text": "„Vidi, ovo je novo.“",
            "poem": 2
          },
          {
            "text": "Već od davnina,",
            "poem": 1
          },
          {
            "text": "pre nas toga je bilo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Nema sećanja na ono prošlo,",
            "poem": 1
          },
          {
            "text": "kao što nema sećanja",
            "poem": 2
          },
          {
            "text": "kod onih koji tek dolaze",
            "poem": 1
          },
          {
            "text": "na ono što još nije došlo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Mudrost je prolazna"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ja, propovednik, bio sam car izrailjski u Jerusalimu."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Elem, srcem sam se predao proučavanju i mudrom istraživanju svega što se zbiva pod nebesima. A to je tegoban zadatak koji je Bog dao ljudima da se njime bave."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Posmatrao sam sva dela koja se čine pod kapom nebeskom – i gle – sve je prolazno i jurenje vetra!"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ono što je krivo ne može da se ispravi",
            "poem": 1
          },
          {
            "text": "i ono čega nema ne može da se izbroji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Kazao sam svome srcu: „Gle! Postao sam daleko mudriji od svih koji su pre mene vladali Jerusalimom, i srce mi se nagledalo tolike mudrosti i znanja.“"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Srcem sam se predao upoznavanju mudrosti, a upoznao sam i bezumlje i glupost. Shvatio sam – i to je jurenje vetra."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Jer, gde je mnogo mudrosti, mnogo je i strepnje,",
            "poem": 1
          },
          {
            "text": "i muku gomila ko gomila znanje.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
