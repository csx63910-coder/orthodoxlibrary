  },
  "chapter": {
    "number": 12,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Sećaj se Stvoritelja svoga",
            "poem": 1
          },
          {
            "text": "u danima mladosti svoje –",
            "poem": 2
          },
          {
            "text": "pre nego dođu dani zla",
            "poem": 1
          },
          {
            "text": "i pristignu godine za koje ćeš reći:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Ne mile mi se“;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "pre nego se zamrači sunce,",
            "poem": 1
          },
          {
            "text": "svetlo meseca i zvezda",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i odu oblaci nakon kiše;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "na dan kada se zaljuljaju čuvari kuće",
            "poem": 1
          },
          {
            "text": "i presamite se junaci,",
            "poem": 2
          },
          {
            "text": "kada stanu malobrojne drobilice",
            "poem": 1
          },
          {
            "text": "i zamagle se one što kroz prozore gledaju,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "kada se zatvore ulična vrata",
            "poem": 1
          },
          {
            "text": "i utiša zveket mlinskog kamena,",
            "poem": 2
          },
          {
            "text": "kada se čovek diže s cvrkutom ptica",
            "poem": 1
          },
          {
            "text": "i prorede se pesme;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "kada se čovek boji uzvišenja",
            "poem": 1
          },
          {
            "text": "i opasnosti na putu,",
            "poem": 2
          },
          {
            "text": "kada procveta badem",
            "poem": 1
          },
          {
            "text": "i skakavac se ulenji,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kada želja umine.",
            "poem": 2
          },
          {
            "text": "Jer čovek odlazi u svoju večnu kuću,",
            "poem": 1
          },
          {
            "text": "a na ulicu izlaze ožalošćeni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Sećaj ga se pre nego pukne srebrno uže",
            "poem": 1
          },
          {
            "text": "i polomi se zlatna čaša,",
            "poem": 2
          },
          {
            "text": "pre nego pukne krčag na vrelu",
            "poem": 1
          },
          {
            "text": "i skrši se točak na bunaru.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Tada se prah zemlji vraća, gde je i bio,",
            "poem": 1
          },
          {
            "text": "a duh se vraća Bogu koji ga je dao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Prolaznost nad prolaznošću – vajka se propovednik –",
            "poem": 1
          },
          {
            "text": "Sve je prolazno!",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Zaključak"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "I ne samo da je propovednik bio mudar nego je i narod poučavao znanju. Pažljivo je proučavao mnoge priče da bi ih sastavio."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Propovednik je tragao za prikladnim rečima, hteo je da tačno zapiše reči istine."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Reči mudrih su poput ostana, poput čvrsto prikucanih eksera su sakupljači priča, što ih je dao jedan pastir."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Čuvaj se, sine moj, preterivanja, jer nema kraja pisanju mnogih knjiga. A od silnog učenja i telo klone."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Zaključak svega što se čulo je:",
            "poem": 1
          },
          {
            "text": "Boga se boj",
            "poem": 2
          },
          {
            "text": "i njegove zapovesti drži.",
            "poem": 1
          },
          {
            "text": "To je sva čovekova dužnost.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Elem, Bog će svako delo dovesti na sud,",
            "poem": 1
          },
          {
            "text": "svaku skrivenu stvar,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "bilo dobro ili zlo.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
