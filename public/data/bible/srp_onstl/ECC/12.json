    "title": "Knjiga propovednikova",
    "order": 21,
    "numberOfChapters": 12,
    "sha256": "9bed273eea637cde9ca47a33df21674fb56a90cae1f87434c35944bbe5bb98a8",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/ECC/1.json",
