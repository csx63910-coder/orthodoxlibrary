  },
  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "heading",
        "content": [
          "Ispuni zavete koje si dao Bogu"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Pazi na svoje korake kada ideš u Dom Božiji. Pristupi da slušaš, jer je to bolje od žrtve bezumnika što ne znaju da zlo čine."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ne brzaj ustima,",
            "poem": 1
          },
          {
            "text": "ne srljaj srcem",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pred Boga sa rečima,",
            "poem": 2
          },
          {
            "text": "jer je Bog na nebesima,",
            "poem": 1
          },
          {
            "text": "a ti si na zemlji.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Zato ne govori mnoge reči.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jer san dolazi od obilja rada,",
            "poem": 1
          },
          {
            "text": "a glas bezumnika od obilja reči.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "A kada daš zavet Bogu, ne oklevaj da ga ispuniš, jer Bogu nisu mili bezumnici. Ispuni šta si se zavetovao."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Bolje je i da se ne zavetuješ nego da se zavetuješ, a ne ispuniš."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ne daj svojim ustima da te u greh vode i ne reci pred vesnikom",
          {
            "noteId": 0
          },
          "Božijim: „Ovo je bila nesmotrenost!“ Zašto da se Bog gnevi na tebe i uništi delo ruku tvojih?"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Jer kao što je prolaznost u obilju snova, tako je i u mnogim rečima. Zato – Boga se boj!"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Bogatstvo je prolazno"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Ako u okolnim oblastima vidiš da se tlači siromah i izvrću pravo i pravičnost, ne čudi se toj stvari. Jer i nad visokim ima ko je viši, a nad njima bdije uzvišeniji."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Dobrobit od zemlje je za svakog, jer i samom caru se služi od njive."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ko god voli srebro, srebrom neće biti zadovoljan;",
            "poem": 1
          },
          {
            "text": "ni zaradom onaj što bogatstvo voli.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "I to je prolazno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Gde je mnogo imovine,",
            "poem": 1
          },
          {
            "text": "mnogo je i onih što je troše.",
            "poem": 2
          },
          {
            "text": "U čemu je onda dobit njenim gazdama",
            "poem": 1
          },
          {
            "text": "osim što je svojim očima gledaju?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Trudbeniku je sladak san",
            "poem": 1
          },
          {
            "text": "bilo da je malo ili mnogo jeo;",
            "poem": 2
          },
          {
            "text": "a bogatstvo bogatome",
            "poem": 1
          },
          {
            "text": "miran san ne pruža.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Video sam da pod kapom nebeskom postoji zlo golemo:",
          {
            "text": "bogatstvo nagomilano za bedu vlasniku svome.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Elem, propalo je to bogatstvo u poslovima lošim,",
            "poem": 2
          },
          {
            "text": "pa takav rođenom sinu ništa",
            "poem": 1
          },
          {
            "text": "ne ostavlja u rukama svojim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Kakav je iz majčine utrobe izašao – go –",
            "poem": 1
          },
          {
            "text": "vratiće se kakav je i došao.",
            "poem": 2
          },
          {
            "text": "I ništa u rukama svojim od svog truda",
            "poem": 1
          },
          {
            "text": "neće uzeti i poneti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "I ovo je zlo golemo:",
          {
            "text": "kakav je došao, takav će i otići.",
            "poem": 1
          },
          {
            "text": "I u čemu je korist za njega",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "što se mučio u vetar?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Stvarno, jeo je sumoran kroz sve dane svoje,",
            "poem": 1
          },
          {
            "text": "uznemiren, veoma bolestan i srdit.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Eto, video sam nešto dobro i korisno za čoveka: da jede i pije, da uživa dobro sveg svog truda kojim se muči pod kapom nebeskom za malo dana svog života koje mu je Bog dao da su njegovi."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Svakom čoveku kome je Bog dao imetak i bogatstvo, dao je i ovlašćenje da od toga jede, da primi svoju nagradu i bude srećan u svom trudu – i to je Božiji dar."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Jer, on se ne seća često dana svog života, jer ga Bog zaokuplja radostima njegovog srca."
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 0,
        "caller": "+",
        "text": "5,6 Ili: anđelom, što je rešenje koje prate stariji prevodi, dok noviji ističu da je reč o svešteniku.",
        "reference": {
          "chapter": 5,
          "verse": 6
        }
      }
    ]
