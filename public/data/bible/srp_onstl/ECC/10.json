  },
  "chapter": {
    "number": 10,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Od uginule muve se usmrdi i užegne apotekarsko ulje.",
            "poem": 1
          },
          {
            "text": "Tako je i malo gluposti teže od mnogo mudrosti i od mnogo časti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Mudrom je srce s desne strane,",
            "poem": 1
          },
          {
            "text": "a bezumniku s leve strane.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Čak i kada putem ide,",
            "poem": 1
          },
          {
            "text": "luda je bez srca,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pa još kaže svima da je luda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ako se gnev vladarev na tebe podiže,",
            "poem": 1
          },
          {
            "text": "ne napuštaj svoje mesto,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer smirenost utišava goleme grehe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Video sam da pod kapom nebeskom",
            "poem": 1
          },
          {
            "text": "postoji zlo nalik grehu koji dolazi od vladara:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Glupaci su ustoličeni na mnogim visokim mestima,",
            "poem": 1
          },
          {
            "text": "dok poštovani zauzimaju niže mesto.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Video sam sluge na konjima",
            "poem": 1
          },
          {
            "text": "i glavare što pešače kao roblje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ko drugome jamu kopa sam u nju upada",
            "poem": 1
          },
          {
            "text": "i ko ruši zid uješće ga zmija.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Kamenje koje se kleše može da povredi klesara,",
            "poem": 1
          },
          {
            "text": "a drvo koje se teše može da ugrozi tesara.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ako je sekira tupa",
            "poem": 1
          },
          {
            "text": "i sečivo joj naoštreno nije,",
            "poem": 2
          },
          {
            "text": "čoveku golema snaga treba.",
            "poem": 1
          },
          {
            "text": "Znači, mudrost je korisna jer napredak daje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Slaba korist za bajača",
            "poem": 1
          },
          {
            "text": "pre bajanja ujede li zmija.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Blažene su reči mudrog,",
            "poem": 1
          },
          {
            "text": "a bezumnog njegova usta izjedaju;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "glupost je na početku njegovog govora,",
            "poem": 1
          },
          {
            "text": "a suludo zlo na njegovom svršetku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ludak silno brblja,",
            "poem": 1
          },
          {
            "text": "a čovek ne zna šta će da se zbude,",
            "poem": 2
          },
          {
            "text": "i ko će da mu kaže",
            "poem": 1
          },
          {
            "text": "šta dolazi nakon njega?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Bezumnike trud zamara,",
            "poem": 1
          },
          {
            "text": "pa ne znaju ni u grad da uđu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Jao tebi, zemljo, s neodraslim carem",
            "poem": 1
          },
          {
            "text": "i sa glavarima što se od jutra goste!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Blažena si, zemljo, s carem plemenitog roda,",
            "poem": 1
          },
          {
            "text": "s glavarima što se goste kad je tome vreme,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ko junaci, a ne ko pijanci.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Zbog lenjosti i krov se ugiba,",
            "poem": 1
          },
          {
            "text": "zbog nemarnih ruku prokišnjava kuća.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Radi slavlja hleb se mesi,",
            "poem": 1
          },
          {
            "text": "vino život uveseljava,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a novac svemu rešenje pruža.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Cara nemoj kleti u sebi,",
            "poem": 1
          },
          {
            "text": "a u odajama gde počivaš nemoj kleti bogataša;",
            "poem": 2
          },
          {
            "text": "jer će ptica nebeska odneti glas,",
            "poem": 1
          },
          {
            "text": "odaće stvar vlasnica krila.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
