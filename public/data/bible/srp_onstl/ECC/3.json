  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "heading",
        "content": [
          "Vreme za sve"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Sve ima svoje doba i svaka stvar pod nebesima ima prikladno vreme:",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "vreme rađanja i vreme umiranja;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "vreme sađenja i vreme vađenja posađenog;",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "vreme ubijanja i vreme lečenja;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "vreme rušenja i vreme građenja;",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "vreme plakanja i vreme smejanja;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "vreme žaljenja i vreme igranja;",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "vreme razbacivanja kamenja i vreme sakupljanja kamenja;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "vreme grljenja i vreme rastajanja;",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "vreme traganja i vreme mirenja sa gubitkom;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "vreme čuvanja i vreme bacanja;",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "vreme cepanja i vreme ušivanja;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "vreme ćutanja i vreme govora;",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "vreme ljubavi i vreme mržnje;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "vreme rata i vreme mira.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "I kakva je korist trudbeniku od njegovog truda?"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Posmatrao sam posao koji je Bog dao ljudima da se njime bave."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Naime, sve je predivno stvorio u prikladno vreme. Čak im je i večnost stavio u srca, ali ljudi ne mogu da dokuče dela koja Bog čini od početka do svršetka."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Otkrio sam da za njih ništa bolje nema nego da se raduju i čine dobro sav svoj život;"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "da svi ljudi jedu i piju, da uživaju korist truda svoga. I to je Božiji dar."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Saznao sam da sve što Bog čini ostaje doveka, da tome ništa ne može da se doda i da od toga ništa ne može da se oduzme, da sve što Bog čini jeste da bi ga se ljudi bojali."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "I sve što je bilo, jeste i sada,",
            "poem": 1
          },
          {
            "text": "i sve što će tek da bude, već je bilo,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a Bog traži ono što je minulo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Još sam video pod kapom nebeskom:",
          {
            "text": "da na mestu pravde stoji nepravednost",
            "poem": 1
          },
          {
            "text": "i na mestu pravednosti stoji nepravednost.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Kazao sam u svom srcu:",
          {
            "text": "„Bog će da sudi",
            "poem": 1
          },
          {
            "text": "i pravedniku i nepravedniku,",
            "poem": 2
          },
          {
            "text": "jer postoji prikladno vreme,",
            "poem": 1
          },
          {
            "text": "za svaku stvar i delo svako.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Još sam kazao u svom srcu u vezi ljudi: „Bog ih iskušava, da uvide da su kao stoka, baš oni sami.“"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Jer, sudbina ljudi i sudbina stoke je jednaka sudbina: umiru i oni, a umire i ona. U svima je isti dah i čovek nije bolji od stoke. Da, jer sve je prolazno."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Na isto mesto svi odlaze, jer su svi iz prašine i svi se u prašinu vraćaju."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Ko zna odlazi li gore duh ljudi, a duh stoke odlazi li dole, u zemlju?"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Shvatio sam da za ljude nema boljeg nego da se raduju u svom poslu, jer to im je dano. Elem, ko će ih vratiti da vide kako će nakon njih biti?"
        ]
      }
    ],
