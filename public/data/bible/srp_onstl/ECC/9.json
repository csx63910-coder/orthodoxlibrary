  "chapter": {
    "number": 9,
    "content": [
      {
        "type": "heading",
        "content": [
          "Jednaka sudbina za sve"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Dakle, svemu tome sam se srcem predao, da sve to razjasnim. Jer, i pravedan i mudar su sa svojim delima u Božijoj ruci. Voljen ili omražen – čovek ne zna ništa od onoga što ga čeka."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Svima je ista sudbina: pravednom kao i nepravednom, dobrom i čistom kao i nečistom, onome koji žrtvuje, kao i onome koji ne žrtvuje,",
          {
            "text": "dobrome kao i grešnome,",
            "poem": 1
          },
          {
            "text": "onome koji se zaklinje,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kao i onome koji se boji zaklinjanja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Ovo je zlo u svemu što se čini pod kapom nebeskom: svima je ista sudbina, a i srce ljudi je puno zla. Ludost je u njihovom srcu dok god su živi, a nakon toga umiru."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Ko god je među svim živima ima nadu, jer je i živom psu bolje nego uginulom lavu."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Živi znaju da će umreti,",
            "poem": 1
          },
          {
            "text": "a umrli ne znaju ništa;",
            "poem": 2
          },
          {
            "text": "nagrade za njih više nema",
            "poem": 1
          },
          {
            "text": "jer je iščeznuo spomen na njih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Odavno su propale njihove ljubavi,",
            "poem": 1
          },
          {
            "text": "mržnje i zavisti,",
            "poem": 2
          },
          {
            "text": "nemaju više udela doveka",
            "poem": 1
          },
          {
            "text": "u svemu što se dešava pod kapom nebeskom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Hajde, radosno hleb svoj jedi, pij svoje vino s milinom u srcu, jer je Bog već prihvatio dela tvoja!"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Neka ti odeća uvek bela bude i neka ti ulja na glavi uvek bude."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Sa ženom koju voliš uživaj kroz sve dane svog prolaznog života koji ti je dan pod kapom nebeskom u svim tvojim prolaznim danima. Jer ti je to nagrada u životu za tvoj trud koji ulažeš pod kapom nebeskom."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Čega god ti latile se ruke, čini koliko možeš, jer nema delovanja i rasuđivanja, znanja i mudrosti u Svetu mrtvih",
          {
            "noteId": 1
          },
          "u koji ideš."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Razmišljao sam i video da pod kapom nebeskom:",
          {
            "text": "brzi ne pobeđuje u trci",
            "poem": 1
          },
          {
            "text": "ni jaki u boju;",
            "poem": 2
          },
          {
            "text": "mudar ne dobija hleba",
            "poem": 1
          },
          {
            "text": "ni pametan bogatstvo;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "najučenijem ne sleduje naklonost.",
            "poem": 2
          },
          {
            "text": "Svakog stignu i vreme i događaji.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Čovek ne zna svoje vreme,",
          {
            "text": "poput ribe uhvaćene u mrežu zla",
            "poem": 1
          },
          {
            "text": "i poput ptice uhvaćene u zamku.",
            "poem": 2
          },
          {
            "text": "Da, poput njih su zarobljeni ljudi,",
            "poem": 1
          },
          {
            "text": "u zao čas koji se na njih nenadano spušta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Mudrost je bolja od ludosti"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Elem, pod kapom nebeskom video sam i ovu mudrost koja mi se učinila važnom:"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Mali grad, u njemu tek nešto žitelja, a veliki car ga napada, opkoljava i protiv njega diže velike nasipe."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Tek, u gradu se našao siromašan, ali mudar čovek, koji je mudrošću spasao grad. Pa opet niko ne pamti tog siromaha."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Zato sam rekao da je mudrost bolja od sile, ali mudrost siromaha je prezrena i njegove reči nisu poslušali."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Bolje se čuju tihe reči mudrih",
            "poem": 1
          },
          {
            "text": "od vladarevog povika među bezumnicima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Mudrost je bolja od ratnog oružja,",
            "poem": 1
          },
          {
            "text": "a jedan grešnik može da upropasti mnogo dobrog.",
            "poem": 2
          }
        ]
      }
    ],
