  "chapter": {
    "number": 7,
    "content": [
      {
        "type": "heading",
        "content": [
          "Mudrost"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Bolje je dobro ime od dobrog mirisnog ulja",
            "poem": 1
          },
          {
            "text": "i dan smrti od dana rođenja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Bolje je ići u kuću ožalošćenih",
            "poem": 1
          },
          {
            "text": "nego u kuću gde je gozba,",
            "poem": 2
          },
          {
            "text": "jer je to kraj svakom čoveku.",
            "poem": 1
          },
          {
            "text": "Neka to srcem svojim prigrli ko živi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Od smeha je strepnja bolja",
            "poem": 1
          },
          {
            "text": "jer je u tužnom licu milina srcu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Srce mudrih ljudi je u kući ožalošćenih,",
            "poem": 1
          },
          {
            "text": "a srce bezumnika u kući gde je gozba.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Bolje je slušati prekor mudrog",
            "poem": 1
          },
          {
            "text": "nego kad neko sluša pesmu bezumnika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Naime, smeh bezumnika",
            "poem": 1
          },
          {
            "text": "je poput praskanja trnovog granja pod loncem,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ali i to je prolazno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Nasilje i mudrog čini ludim,",
            "poem": 1
          },
          {
            "text": "a u mitu srce ogrezne.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Kraj neke stvari je bolji od njenog početka",
            "poem": 1
          },
          {
            "text": "i dugotrpeljivost od bahatosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ne nagli duhom do jarosti,",
            "poem": 1
          },
          {
            "text": "jer jarost počiva u nedrima bezumnika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ne pitaj: „Zašto su dani koji su prošli bolji od dana koji su došli?“,",
            "poem": 1
          },
          {
            "text": "jer takvo pitanje nije mudro.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Mudrost je dobra kao i nasledstvo",
            "poem": 1
          },
          {
            "text": "i na korist je onima koje sunce obasjava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Jer je u mudrosti zaklon",
            "poem": 1
          },
          {
            "text": "kao što je u novcu zaklon,",
            "poem": 2
          },
          {
            "text": "ali je prednost poznavanja mudrosti u tome",
            "poem": 1
          },
          {
            "text": "što čuva život mudrih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Razmisli o delu Božijem:",
          {
            "text": "ko je to kadar da ispravi",
            "poem": 1
          },
          {
            "text": "ono što on iskrivi?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "U danu dobrih stvari i ti dobar budi,",
            "poem": 1
          },
          {
            "text": "a u danu loših stvari razmisli o ovom:",
            "poem": 2
          },
          {
            "text": "Bog je načinio oboje s razlogom,",
            "poem": 1
          },
          {
            "text": "da čovek ne zna šta će biti nakon njega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Baš sam svašta video u danima svoje prolaznosti:",
          {
            "text": "pravednika koji strada u svojoj pravednosti",
            "poem": 1
          },
          {
            "text": "i nepravednika koji istrajava u svojoj nepravednosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ne budi preterano pravedan",
            "poem": 1
          },
          {
            "text": "i ne čini sebe premudrim.",
            "poem": 2
          },
          {
            "text": "Zašto bi se upropastio?",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ne budi preterano zao",
            "poem": 1
          },
          {
            "text": "i ne budi lud.",
            "poem": 2
          },
          {
            "text": "Zašto bi umro kad ti vreme nije?",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Dobro je da se držiš ovog saveta,",
            "poem": 1
          },
          {
            "text": "a i prethodni ne ispuštaj iz ruke.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Jer ko se boji Boga spasava se od svega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Mudrost mudrome pruža više snage",
            "poem": 1
          },
          {
            "text": "nego desetorici vladara što su u gradu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Stvarno, nema na zemlji pravednog čoveka",
            "poem": 1
          },
          {
            "text": "koji čini dobro i ne greši.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Elem, ne mari za priče što ih ljudi pričaju,",
            "poem": 1
          },
          {
            "text": "da ne bi čuo kako te tvoj sluga kune.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Jer, srce tvoje zna",
            "poem": 1
          },
          {
            "text": "da si često i ti kleo druge.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "I sve sam to iskušao mudrošću, pa rekoh:",
          {
            "text": "„Biću mudar!“",
            "poem": 1
          },
          {
            "text": "Ali, to je bilo daleko od mene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Šta god da se zbiva je daleko i preduboko.",
            "poem": 1
          },
          {
            "text": "Ko će to da dokuči?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Tako sam srcem nastojao da saznam,",
            "poem": 1
          },
          {
            "text": "da istražim, da nađem mudrost i smisao,",
            "poem": 2
          },
          {
            "text": "da otkrijem glupost nepravde",
            "poem": 1
          },
          {
            "text": "i ludost bezumlja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "I otkrio sam da je žena,",
            "poem": 1
          },
          {
            "text": "koja je kao zamka i čije je srce mreža,",
            "poem": 2
          },
          {
            "text": "od smrti gorča",
            "poem": 1
          },
          {
            "text": "i da su joj ruke kao lanci.",
            "poem": 2
          },
          {
            "text": "Bogougodnik od nje beži",
            "poem": 1
          },
          {
            "text": "dok grešnika ona hvata.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Gle, to sam otkrio – govori propovednik –",
          {
            "text": "dok sam stvari po stvari tražio smisao,",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "za kojim istrajno tragam dušom",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i ne nalazim ga:",
            "poem": 2
          },
          {
            "text": "od njih hiljadu čoveka jednog sam našao,",
            "poem": 1
          },
          {
            "text": "ali ženu među svim ovima našao nisam.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Eto, jedno sam otkrio:",
            "poem": 1
          },
          {
            "text": "Bog je ljude stvorio čestitima,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ali oni kojekakve spletke traže.",
            "poem": 2
          }
        ]
      }
    ],
