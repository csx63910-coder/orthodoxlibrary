  "chapter": {
    "number": 11,
    "content": [
      {
        "type": "heading",
        "content": [
          "Odvaži se i deluj"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Povrh voda hleb svoj baci",
            "poem": 1
          },
          {
            "text": "i naći ćeš ga posle dana mnogih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Daj imetak sedmorici, pa i osmorici,",
            "poem": 1
          },
          {
            "text": "jer ne znaš hoće li zemlju da stigne zlo?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ako su oblaci puni kiše,",
            "poem": 1
          },
          {
            "text": "na zemlju se izručuju;",
            "poem": 2
          },
          {
            "text": "padne li drvo na jug ili na sever,",
            "poem": 1
          },
          {
            "text": "tamo gde padne, tamo i ostaje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ko u vetar gleda, odustaje od setve;",
            "poem": 1
          },
          {
            "text": "ko oblake prati, odustaje od žetve.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Kao što ne znaš putanju vetra",
            "poem": 1
          },
          {
            "text": "ni kako nastaju kosti u utrobi trudnice,",
            "poem": 2
          },
          {
            "text": "tako i delo Boga",
            "poem": 1
          },
          {
            "text": "koji sve čini ne poznaješ.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Od jutra sej seme",
            "poem": 1
          },
          {
            "text": "i do večeri ne sklapaj ruke svoje.",
            "poem": 2
          },
          {
            "text": "Jer ne znaš hoće li da uspe",
            "poem": 1
          },
          {
            "text": "jedno ili drugo,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ili će oboje ispasti dobro.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Sećaj se svog Stvoritelja dok si mlad"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Slatko li je svetlo",
            "poem": 1
          },
          {
            "text": "i dobro li je kada oči u sunce gledaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Jer, ako čovek već i živi mnoge godine,",
            "poem": 1
          },
          {
            "text": "neka u svima njima radostan bude.",
            "poem": 2
          },
          {
            "text": "Ali neka se seti da će doći mnogi tmurni dani.",
            "poem": 1
          },
          {
            "text": "A prolazno je sve to što dolazi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "O, mladiću, raduj se u mladosti svojoj!",
            "poem": 1
          },
          {
            "text": "Neka ti srce uživa dok si mlad,",
            "poem": 2
          },
          {
            "text": "sledi njegove želje",
            "poem": 1
          },
          {
            "text": "i htenja očiju svojih.",
            "poem": 2
          },
          {
            "text": "Ali znaj da će te zbog svega toga",
            "poem": 1
          },
          {
            "text": "Bog dovesti na sud.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Odbaci strepnju iz svog srca",
            "poem": 1
          },
          {
            "text": "i zlo od tela svoga odbaci,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer su i mladost i crna kosa prolazni.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
