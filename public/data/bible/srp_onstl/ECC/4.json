  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "heading",
        "content": [
          "Tlačenje, mukotrpan rad, usamljenost"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Opet sam razmišljao o svem tom tlačenju koje se čini pod kapom nebeskom:",
          {
            "text": "I gle, suze potlačenih,",
            "poem": 1
          },
          {
            "text": "a za njih nema tešitelja!",
            "poem": 2
          },
          {
            "text": "Nema tešitelja",
            "poem": 1
          },
          {
            "text": "za one pod silom ruke tlačitelja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Hvalio sam mrtve,",
            "poem": 1
          },
          {
            "text": "one već preminule",
            "poem": 2
          },
          {
            "text": "više nego žive,",
            "poem": 1
          },
          {
            "text": "koji su još u životu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "I od jednih i od drugih",
            "poem": 1
          },
          {
            "text": "bolje je onome ko se rodio nije,",
            "poem": 2
          },
          {
            "text": "onome koji nije video zlodelo",
            "poem": 1
          },
          {
            "text": "koje se čini pod kapom nebeskom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Elem, razmišljao sam o svakom trudu, svakoj veštini u poslu: zbog toga svako zavidi bližnjemu svome. A i to je prolazno i jurenje vetra."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Bezumnik prekrsti svoje ruke",
            "poem": 1
          },
          {
            "text": "i onda jede sebe samog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Bolja je jedna puna šaka, a u miru",
            "poem": 1
          },
          {
            "text": "nego obe pune šake u muci",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i jurenju vetra.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Opet sam razmišljao o prolaznosti pod kapom nebeskom:"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Čovek samac, bez druga,",
            "poem": 1
          },
          {
            "text": "bez sina i brata pored sebe,",
            "poem": 2
          },
          {
            "text": "ali nema kraja njegovom mukotrpnom radu.",
            "poem": 1
          },
          {
            "text": "Oči mu nikada nisu site blaga, pa se vajka:",
            "poem": 2
          },
          {
            "text": "„Za koga ja to radim,",
            "poem": 1
          },
          {
            "text": "duši svojoj uskraćujem sreću?“",
            "poem": 2
          },
          {
            "text": "I to je prolazno",
            "poem": 1
          },
          {
            "text": "i tegoban je zadatak.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Dvojici je bolje nego jednom,",
            "poem": 1
          },
          {
            "text": "jer imaju dobru korist od svog truda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Jer, padne li jedan,",
            "poem": 1
          },
          {
            "text": "drug njegov će ga podignuti.",
            "poem": 2
          },
          {
            "text": "I jao onom koji padne,",
            "poem": 1
          },
          {
            "text": "a nema druga da ga podigne!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Elem, toplo im je kad leže udvoje,",
            "poem": 1
          },
          {
            "text": "a kako će se jedan ugrejati?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "I ako neko nadvlada jednoga,",
            "poem": 1
          },
          {
            "text": "dvojica mogu tog da nadvladaju.",
            "poem": 2
          },
          {
            "text": "Tek, trostruko se uže ne iskida brzo.",
            "poem": 1
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "I boljitak je prolazan"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Bolji je siromašan, a mudar mladić, od budalastog i ostarelog cara što se više ne da savetovati."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Jer on je izašao iz zatvora i zacario se, a u svom se carstvu rodio kao siromah."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Posmatrao sam sve živo što hoda pod kapom nebeskom i video da pristaju uz ovog drugog, uz mladića koji će ga naslediti."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Nebrojeni je sav taj narod, svi koji su bili pred njima. Ali oni što dolaze posle neće mu se radovati. I to je prolazno i jurenje vetra."
        ]
      }
    ],
