  "chapter": {
    "number": 7,
    "content": [
      {
        "type": "heading",
        "content": [
          "Predstojeća propast"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Dođe mi reč Gospodnja:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Sine čovečiji, govori Gospod Bog zemlji izrailjskoj:",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "’Kraj, došao je kraj",
            "poem": 1
          },
          {
            "text": "na četiri kraja zemlje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Sada ti je došao kraj,",
            "poem": 1
          },
          {
            "text": "jer ću poslati svoj gnev na tebe.",
            "poem": 2
          },
          {
            "text": "Sudiću ti po tvojim putevima",
            "poem": 1
          },
          {
            "text": "i platiću ti za sve tvoje gadosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Moje ti se oko neće sažaliti,",
            "poem": 1
          },
          {
            "text": "neću te poštedeti,",
            "poem": 2
          },
          {
            "text": "nego ću ti platiti za tvoje puteve",
            "poem": 1
          },
          {
            "text": "i za gadosti u tebi.",
            "poem": 2
          },
          "Tada ćete znati da sam ja Gospod.’"
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Govori Gospod Bog:",
          {
            "text": "’Dolazi zlo za zlom.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Došao je kraj!",
            "poem": 1
          },
          {
            "text": "Kraj je stigao!",
            "poem": 2
          },
          {
            "text": "Gle, došao je,",
            "poem": 1
          },
          {
            "text": "na tebe se namerio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Kucnuo ti je čas,",
            "poem": 1
          },
          {
            "text": "žitelju zemlje,",
            "poem": 2
          },
          {
            "text": "vreme je došlo,",
            "poem": 1
          },
          {
            "text": "blizu je dan;",
            "poem": 2
          },
          {
            "text": "strahota je u gorama,",
            "poem": 1
          },
          {
            "text": "a ne radost.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Svoj bes ću ubrzo izliti na tebe,",
            "poem": 1
          },
          {
            "text": "gnev ću svoj iskaliti na tebi.",
            "poem": 2
          },
          {
            "text": "Sudiću ti po tvojim putevima,",
            "poem": 1
          },
          {
            "text": "platiću ti za sve gadosti tvoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Moje ti se oko neće sažaliti,",
            "poem": 1
          },
          {
            "text": "neću te poštedeti,",
            "poem": 2
          },
          {
            "text": "nego ću ti platiti za tvoje puteve,",
            "poem": 1
          },
          {
            "text": "i za gadosti koje su u tebi.",
            "poem": 2
          },
          {
            "text": "Tada ćeš znati da to ja, Gospod, udaram.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Dan je, evo, došao!",
            "poem": 1
          },
          {
            "text": "Propast je iznikla,",
            "poem": 2
          },
          {
            "text": "štap je procvetao,",
            "poem": 1
          },
          {
            "text": "oholost napupela!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Nasilje je izraslo",
            "poem": 1
          },
          {
            "text": "u štap bezakonja.",
            "poem": 2
          },
          {
            "text": "Niko od njih neće ostati,",
            "poem": 1
          },
          {
            "text": "ništa od njihovog mnoštva,",
            "poem": 2
          },
          {
            "text": "ništa od njihovog blaga,",
            "poem": 1
          },
          {
            "text": "ničega vrednog među njima!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Došlo je vreme, prispeo je dan.",
            "poem": 1
          },
          {
            "text": "Ko kupuje, neka se ne veseli,",
            "poem": 2
          },
          {
            "text": "ko prodaje, neka ne žali,",
            "poem": 1
          },
          {
            "text": "jer gnev dolazi na sve mnoštvo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ko prodaje neće moći da povrati što je prodao,",
            "poem": 1
          },
          {
            "text": "dokle god su obojica živi,",
            "poem": 2
          },
          {
            "text": "jer je viđenje za sve mnoštvo",
            "poem": 1
          },
          {
            "text": "i neće biti opozvano.",
            "poem": 2
          },
          {
            "text": "Zbog svoje krivice",
            "poem": 1
          },
          {
            "text": "niko neće sačuvati svoj život.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "U trube su zatrubili,",
            "poem": 1
          },
          {
            "text": "sve je spremno,",
            "poem": 2
          },
          {
            "text": "ali nema nikog da u boj pođe,",
            "poem": 1
          },
          {
            "text": "jer moj je gnev nad svim mnoštvom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Napolju je mač,",
            "poem": 1
          },
          {
            "text": "a unutra zaraza i glad;",
            "poem": 2
          },
          {
            "text": "ko je napolju poginuće od mača,",
            "poem": 1
          },
          {
            "text": "a ko je unutra,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "njega će proždreti glad i zaraza.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "A njihovi preživeli koji umaknu,",
            "poem": 1
          },
          {
            "text": "biće po gorama,",
            "poem": 2
          },
          {
            "text": "kao golubovi po dolinama,",
            "poem": 1
          },
          {
            "text": "i svi će uzdisati,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "svaki za svoju krivicu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Sve će ruke malaksati,",
            "poem": 1
          },
          {
            "text": "a sva će kolena postati kao da su od vode.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Opasivaće se kostreću,",
            "poem": 1
          },
          {
            "text": "drhtanje će ih obuzeti,",
            "poem": 2
          },
          {
            "text": "na svakom će licu biti sram,",
            "poem": 1
          },
          {
            "text": "i svaka će glava oćelaviti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Izbaciće na ulice svoje srebro",
            "poem": 1
          },
          {
            "text": "i zlato kao smeće.",
            "poem": 2
          },
          {
            "text": "Njihovo srebro i zlato",
            "poem": 1
          },
          {
            "text": "neće moći da ih izbavi u dan gneva Gospodnjeg.",
            "poem": 2
          },
          {
            "text": "No, svoju glad neće utoliti,",
            "poem": 1
          },
          {
            "text": "svoje trbuhe neće napuniti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer su zbog toga posrnuli u krivicu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Dičili su se svojim divnim nakitom;",
            "poem": 1
          },
          {
            "text": "od njega su pravili likove svojih odvratnih i gadnih stvari.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Zato ću im ga pretvoriti u smeće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Onda ću ga predati u ruke tuđinaca da ga oplene,",
            "poem": 1
          },
          {
            "text": "i zlikovcima na zemlji da ga opljačkaju,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "koji će ga oskrnaviti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Okrenuću svoje lice od njih,",
            "poem": 1
          },
          {
            "text": "pa neka se skrnavi moje blago;",
            "poem": 2
          },
          {
            "text": "neka razbojnici upadaju u njega",
            "poem": 1
          },
          {
            "text": "i neka ga oskrnave!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Iskuj okove,",
            "poem": 1
          },
          {
            "text": "jer je zemlja puna krvi nepravedno osuđenih,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a grad pun nasilja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Zato ću dovesti najgore među narodima",
            "poem": 1
          },
          {
            "text": "da zaposednu njihove kuće.",
            "poem": 2
          },
          {
            "text": "Tako ću dokrajčiti ponos moćnih,",
            "poem": 1
          },
          {
            "text": "a njihova svetilišta će biti oskrnavljena.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Kad strahota dođe,",
            "poem": 1
          },
          {
            "text": "tražiće mir, a njega neće biti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Jedna će propast ići za drugom,",
            "poem": 1
          },
          {
            "text": "jedna loša vest stizaće za drugom.",
            "poem": 2
          },
          {
            "text": "Tada će tražiti viđenje od proroka,",
            "poem": 1
          },
          {
            "text": "ali će sveštenik ostati bez Zakona,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a starešine bez saveta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Car će tugovati,",
            "poem": 1
          },
          {
            "text": "knez biti obučen u očaj,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a ruke naroda zemlje će drhtati.",
            "poem": 2
          },
          {
            "text": "Postupaću s njima po njihovim putevima",
            "poem": 1
          },
          {
            "text": "i suditi im po njihovim sudovima.",
            "poem": 2
          },
          {
            "text": "Tada će znati da sam ja Gospod.’“",
            "poem": 3
          }
        ]
      }
    ],
    "footnotes": []
  },
