  "chapter": {
    "number": 28,
    "content": [
      {
        "type": "heading",
        "content": [
          "Proroštvo protiv tirskog kneza"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Dođe mi reč Gospodnja:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "„Sine čovečiji, reci tirskom vladaru: ’Govori Gospod Bog:",
          {
            "text": "Uzoholio si se u srcu govoreći:",
            "poem": 1
          },
          {
            "text": "„Ja sam bog;",
            "poem": 2
          },
          {
            "text": "sedim na Božijem prestolu",
            "poem": 1
          },
          {
            "noteId": 8
          },
          {
            "text": "u srcu mora.“",
            "poem": 2
          },
          {
            "text": "Ipak, ti si samo čovek, a ne Bog,",
            "poem": 1
          },
          {
            "text": "iako svoj um izjednačavaš s Božijim umom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Eto, mudriji si od Danila;",
            "poem": 1
          },
          {
            "text": "nijedna tajna ti nije skrivena.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Stekao si sebi bogatstvo",
            "poem": 1
          },
          {
            "text": "mudrošću i razumom,",
            "poem": 2
          },
          {
            "text": "nakupio si srebro i zlato",
            "poem": 1
          },
          {
            "text": "u svojim riznicama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Umnožio si svoje bogatstvo",
            "poem": 1
          },
          {
            "text": "velikom svojom mudrošću u trgovini,",
            "poem": 2
          },
          {
            "text": "ali si se uzoholio u srcu",
            "poem": 1
          },
          {
            "text": "zbog svog bogatstva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Zato govori Gospod Bog:",
          {
            "text": "Zato što izjednačavaš svoj um",
            "poem": 1
          },
          {
            "text": "s Božijim umom,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "evo, dovešću na tebe tuđince,",
            "poem": 1
          },
          {
            "text": "najnemilosrdnije među narodima,",
            "poem": 2
          },
          {
            "text": "a oni će isukati mačeve",
            "poem": 1
          },
          {
            "text": "na lepotu tvoje mudrosti",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i okaljati tvoj sjaj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Baciće te u jamu",
            "poem": 1
          },
          {
            "text": "i umrećeš smrću posečenih usred mora.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Hoćeš li pred svojim pogubiteljem da kažeš: „Ja sam Bog“?",
            "poem": 1
          },
          {
            "text": "Ti si čovek, a ne Bog,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kad padneš u ruke svojih pogubitelja!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Umrećeš smrću neobrezanih rukom tuđinaca,",
            "poem": 1
          },
          "jer sam ja to rekao – govori Gospod Bog.’“"
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Opet mi dođe reč Gospodnja:"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "„Sine čovečiji, ispevaj tužbalicu protiv tirskog cara. Reci mu: ’Govori Gospod Bog:",
          {
            "text": "Ti si pečat savršenstva,",
            "poem": 1
          },
          {
            "text": "pun mudrosti i savršen u lepoti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Bio si u Edenu, vrtu Božijem,",
            "poem": 1
          },
          {
            "text": "sav okićen dragim kamenjem:",
            "poem": 2
          },
          {
            "text": "rubinom, topazom, dijamantom,",
            "poem": 1
          },
          {
            "text": "hrisolitom, oniksom, jaspisom,",
            "poem": 2
          },
          {
            "text": "safirom, malahitom i smaragdom;",
            "poem": 1
          },
          {
            "text": "zlatom te uokvirili i izvezli,",
            "poem": 2
          },
          {
            "text": "učvrstili ih u dan kad si bio stvoren.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Učinih te heruvimom zaštitnikom,",
            "poem": 2
          },
          {
            "text": "postavih te na svetu goru Božiju,",
            "poem": 1
          },
          {
            "text": "hodio si posred ognjenog kamenja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Besprekoran beše na putevima svojim,",
            "poem": 1
          },
          {
            "text": "od dana kad si stvoren,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "do dana kad se nepravda našla na tebi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Zbog obilja tvoje trgovine",
            "poem": 1
          },
          {
            "text": "napunilo se nasilje u tebi; zgrešio si.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Zato te zbacih nečistog s gore Božije",
            "poem": 2
          },
          {
            "text": "i uklonih te, heruvime zaštitniče,",
            "poem": 1
          },
          {
            "text": "ispred ognjenog kamenja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ponelo se srce tvoje zbog tvoje lepote,",
            "poem": 1
          },
          {
            "text": "upropasti mudrost svoju zbog svog sjaja.",
            "poem": 2
          },
          {
            "text": "I bacio sam te na zemlju,",
            "poem": 1
          },
          {
            "text": "pred careve te zemaljske postavio",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da te oni gledaju s prezrenjem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Zbog mnogih tvojih krivica,",
            "poem": 1
          },
          {
            "text": "zbog trgovine tvoje nepoštene,",
            "poem": 2
          },
          {
            "text": "svetilište si svoje oskrnavio.",
            "poem": 1
          },
          {
            "text": "Zato sam zapalio oganj posred tebe,",
            "poem": 2
          },
          {
            "text": "i oganj te je progutao;",
            "poem": 1
          },
          {
            "text": "u pepeo sam te pretvorio",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "na oči svima što te gledaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Svi koji su te znali među narodima,",
            "poem": 1
          },
          {
            "text": "zgražaju se sad nad tobom,",
            "poem": 2
          },
          {
            "text": "postao si prizorom užasa,",
            "poem": 1
          },
          {
            "text": "i više te nikada neće biti.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Proroštvo protiv Sidona"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Dođe mi reč Gospodnja:"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "„Sine čovečiji, okreni se licem prema Sidonu i prorokuj protiv njega."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Reci: ’Govori Gospod Bog:",
          {
            "text": "Evo me protiv tebe, Sidone,",
            "poem": 1
          },
          {
            "text": "da se proslavim usred tebe.",
            "poem": 2
          },
          {
            "text": "I znaćete da sam ja Gospod,",
            "poem": 1
          },
          {
            "text": "kada nad njim izvršim sud,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i kada pokažem svoju svetost u njemu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Poslaću na njega pošast,",
            "poem": 1
          },
          {
            "text": "i krvi će biti na njegovim ulicama.",
            "poem": 2
          },
          {
            "text": "Posečeni će ginuti usred njega od mača,",
            "poem": 1
          },
          {
            "text": "koji će ih stizati sa svih strana.",
            "poem": 2
          },
          {
            "text": "Tada će znati da sam ja Gospod.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Dom Izrailjev neće više imati trn koji ubada, ni bodlju koja nanosi bol; niotkuda više neće biti onih koji ih preziru. Tada će znati da sam ja Gospod Bog."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Zato govori Gospod: kada skupim dom Izrailjev iz naroda gde su bili rasejani, i pokažem na njima svoju svetost pred pucima, tada će živeti na zemlji, koju sam ja dao svome sluzi Jakovu."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "I živeće spokojno na njoj: gradiće kuće, sadiće vinograde i živeće bezbedno, kada izvršim sud nad svima koji ih preziru sa svih strana. Tada će znati da sam ja, Gospod, njihov Bog.’“"
        ]
      },
      {
        "type": "line_break"
      }
    ],
