  "chapter": {
    "number": 18,
    "content": [
      {
        "type": "heading",
        "content": [
          "Svako je odgovoran za svoj greh"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "I dođe mi reč Gospodnja:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "„Šta vam znači poslovica kojom se služite za Izrailjevu zemlju:",
          {
            "text": "’Očevi su jeli kiselo grožđe,",
            "poem": 1
          },
          {
            "text": "a sinovima trnu zubi.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Života mi moga, govori Gospod Bog: nećete se više služiti ovom poslovicom u Izrailju!"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Evo, sve žive duše pripadaju meni; duša oca i duša sina meni pripadaju. Duša koja zgreši, ona će umreti."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ko je pravedan",
            "poem": 1
          },
          {
            "text": "i vrši što je pravo i pravedno,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "ne jede na gorama,",
            "poem": 1
          },
          {
            "text": "ne podiže oči prema idolima doma Izrailjevog,",
            "poem": 2
          },
          {
            "text": "ne skrnavi ženu svoga bližnjega,",
            "poem": 1
          },
          {
            "text": "i ne leže sa svojom ženom tokom njenog mesečnog reda;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "nikoga ne iskorištava,",
            "poem": 1
          },
          {
            "text": "vraća zalog svome dužniku,",
            "poem": 2
          },
          {
            "text": "ne pljačka, nego daje gladnome hleba",
            "poem": 1
          },
          {
            "text": "i gologa pokriva odećom;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "ne pozajmljuje zbog dobiti",
            "poem": 1
          },
          {
            "text": "i ne uzima kamatu,",
            "poem": 2
          },
          {
            "text": "kloni se nepravde,",
            "poem": 1
          },
          {
            "text": "i po istini deli pravdu",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "između jednog čoveka i drugog;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "i sledi moje uredbe",
            "poem": 1
          },
          {
            "text": "i drži moje propise postupajući po istini –",
            "poem": 2
          },
          {
            "text": "taj je pravedan;",
            "poem": 1
          },
          {
            "text": "on će zaista živeti",
            "poem": 2
          },
          {
            "text": "– govori Gospod Bog.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Ali ako ima sina nasilnika, koji proliva krv, i on učini jedno od ovoga –"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "iako otac nije učinio ništa od ovoga –",
          {
            "text": "pa jede na gorama,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "skrnavi ženu svoga bližnjega,",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "ugnjetava siromašnog i ubogog,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "pljačka, ne vraća zalog,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "i podiže oči prema idolima,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "taj čini gadno delo.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ako pozajmljuje zbog dobiti i uzima kamatu, hoće li živeti?",
            "poem": 1
          },
          "Neće živeti! Zato što je počinio sve te gadosti, zato će svakako umreti. Krv njegova na njegovu glavu!"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Ako li on ima sina koji vidi sve grehe koje njegov otac čini – ali ih sam ne čini, iako ih vidi –"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "te ne jede na gorama,",
            "poem": 1
          },
          {
            "text": "ne podiže oči prema idolima doma Izrailjevog,",
            "poem": 2
          },
          {
            "text": "ne skrnavi ženu svoga bližnjega;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "nikoga ne iskorištava,",
            "poem": 1
          },
          {
            "text": "vraća zalog svome dužniku,",
            "poem": 2
          },
          {
            "text": "ne pljačka,",
            "poem": 1
          },
          {
            "text": "nego daje gladnome od svoga hleba",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i gologa pokriva odećom;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "kloni se nepravde,",
            "poem": 1
          },
          {
            "text": "ne pozajmljuje radi koristi, niti s kamatom,",
            "poem": 2
          },
          {
            "text": "već izvršava moje propise",
            "poem": 1
          },
          {
            "text": "i sledi moje uredbe –",
            "poem": 2
          },
          "taj neće umreti zbog krivice svoga oca; on će zaista živeti."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "A njegov otac će umreti za svoju krivicu, zbog toga što je tlačio druge, pljačkao, i nije činio ništa dobro među svojim narodom."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "A vi kažete: ’Zašto da sin ne ispašta za krivicu svoga oca?’ Ako sin vrši pravo i pravdu i drži moje uredbe i vrši ih, zaista će živeti."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Umreće onaj koji zgreši. Sin neće ispaštati zbog krivice svoga oca, a ni otac neće ispaštati zbog krivice svoga sina. Pravedniku će se računati njegova pravda, a opakome njegova opakost."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Ali ako se opaki odvrati od svih svojih greha koje je učinio i bude držao sve moje uredbe i vršio pravo i pravdu, zaista će živeti, neće umreti."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Nijedan od njegovih prestupa neće mu se više spominjati; zaista će živeti, neće umreti."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Zar ja uživam da opaki umre – govori Gospod Bog – a ne da se odvrati od svojih puteva i da živi?"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Ali ako se pravednik odvrati od svoje pravednosti i stane da čini nepravdu i gadosti koje čini opaki, hoće li živeti? Sva njegova pravednost koju je učinio neće se više spominjati zbog neverstva i greha koje je učinio; zbog njih će umreti."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "A vi kažete: ’Put Gospodnji nije pravedan.’ Zato čuj, dome Izrailjev: zar je moj put nepravedan? Nisu li vaši putevi nepravedni?"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Ako se pravednik odvrati od svoje pravednosti i stane da čini nepravdu, pa umre zbog svoje nepravde, umreće zbog nepravde koju je učinio."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Ali ako se opaki odvrati od svoje opakosti koju je činio i počne vršiti pravo i pravdu, spašće sebi život."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Jer je uvideo sve svoje prestupe koje je učinio i odvratio se od njih, zaista će živeti i neće umreti."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "A dom Izrailjev kaže: ’Put Gospodnji nije pravedan.’ Zar moji putevi nisu pravedni, dome Izrailjev? Nisu li vaši putevi nepravedni?"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Zato ću vam, dome Izrailjev, suditi prema njegovim delima – govori Gospod Bog. Pokajte se i odvratite se od svih svojih prestupa, i više se nećete saplitati o svoju krivicu."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "Odbacite od sebe sve prestupe koje ste počinili i načinite sebi novo srce i novi duh! Zašto da izginete, dome Izrailjev?"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Jer ja ne uživam u ničijoj smrti – govori Gospod Bog. Zato se pokajte i živećete!"
        ]
      }
    ],
