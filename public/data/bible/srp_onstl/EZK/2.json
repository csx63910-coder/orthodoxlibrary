  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "heading",
        "content": [
          "Viđenje o svitku"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "On mi reče: „Sine čovečiji, ustani na noge da govorim s tobom.“"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "I kako mi to reče, uđe u mene Duh i postavi me na noge. Tada sam čuo kako mi govori."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Reče mi: „Sine čovečiji, šaljem te Izrailjcima, otpadničkom narodu koji se pobunio protiv mene. Oni su se, kao i njihovi očevi, bunili protiv mene sve do danas."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Šaljem te među tvrdoglave i nepokorne sinove da im kažeš: ’Govori Gospod Bog.’"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Poslušali ili ne – jer su otpadnički dom – znaće da je prorok bio među njima."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "A ti, sine čovečiji, nemoj se bojati ni njih ni njihovih reči, makar te pritisnuli dračem i trnjem, makar sedeo na škorpijama. Ne boj se njihovih reči i ne daj se smesti pred njima, jer su otpadnički dom."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Prenesi im moje reči, bilo da ih poslušaju ili ne, jer su otpadnici."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "A ti, sine čovečiji slušaj šta ti kažem. Ne buni se kao taj otpadnički dom. Otvori usta, pa ćeš jesti ono što ti ja dam.“"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Tada sam pogledao i video da je prema meni ispružena ruka, i u njoj svitak knjige."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Kada ga je raširio preda mnom, svitak je bio ispisan i iznutra i spolja. Bio je ispisan tužbalicama, naricaljkama i lelecima."
        ]
      }
    ],
