  "chapter": {
    "number": 30,
    "content": [
      {
        "type": "heading",
        "content": [
          "Teško Egiptu u dan Gospodnji!"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Dođe mi reč Gospodnja:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "„Sine čovečiji, prorokuj i reci: ’Govori Gospod:",
          {
            "text": "Zakukajte –",
            "poem": 1
          },
          {
            "text": "Jao, dane!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jer blizu je dan,",
            "poem": 1
          },
          {
            "text": "dan Gospodnji,",
            "poem": 2
          },
          {
            "text": "dan oblačni,",
            "poem": 1
          },
          {
            "text": "vreme za narode.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Doći će mač na Egipat,",
            "poem": 1
          },
          {
            "text": "strepnja će obuzeti Kuš",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kad poginuli stanu da padaju po Egiptu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kad mu otmu njegovo bogatstvo,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i kad mu sruše temelje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Kuš i Fut, Lud, Arabija i Huv, i narod zemlje saveza, pašće s njima od mača."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Govori Gospod Bog:",
          {
            "text": "Propašće oni koji pomažu Egiptu,",
            "poem": 1
          },
          {
            "text": "survaće se ponos njegove snage;",
            "poem": 2
          },
          {
            "text": "padaće od mača od Migdola do Siene",
            "poem": 1
          },
          {
            "text": "– govori Gospod Bog.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Biće opustošeni usred opustošenih zemalja,",
            "poem": 1
          },
          {
            "text": "a njegovi gradovi će ležati među razorenim gradovima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Tada će znati da sam ja Gospod",
            "poem": 1
          },
          {
            "text": "kada zapalim vatru u Egiptu",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i kada pretrpe slom svi njegovi pomagači.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "U taj dan izaći će preda mnom poslanici u brodovima da uplaše spokojni Kuš. I obuzeće ih užas u dan egipatski, jer on, evo, dolazi."
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Govori Gospod Bog:",
          {
            "text": "Ja ću istrebiti mnogobrojni narod",
            "poem": 1
          },
          {
            "text": "egipatski rukom Navuhodonosora, vavilonskog cara.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "On i njegov narod,",
            "poem": 1
          },
          {
            "text": "najnemilosrdniji među narodima,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "doći će da unište zemlju.",
            "poem": 2
          },
          {
            "text": "Oni će isukati svoje mačeve na Egipćane,",
            "poem": 1
          },
          {
            "text": "pa će ispuniti zemlju mrtvima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ja ću isušiti rukavce Nila,",
            "poem": 1
          },
          {
            "text": "a zemlju ću prodati zlikovcima.",
            "poem": 2
          },
          {
            "text": "Rukom tuđinaca opustošiću zemlju",
            "poem": 1
          },
          {
            "text": "i sve što je u njoj.",
            "poem": 2
          },
          {
            "text": "Ja sam, Gospod, govorio.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Govori Gospod Bog:",
          {
            "text": "Uništiću idole i istrebiti",
            "poem": 1
          },
          {
            "text": "ništavna božanstva iz Nofa.",
            "poem": 2
          },
          {
            "text": "Neće više biti kneza u Egiptu;",
            "poem": 1
          },
          {
            "text": "i predaću strahu zemlju egipatsku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Opustošiću Patros,",
            "poem": 1
          },
          {
            "text": "zapaliću Soan,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i izvršiti sud na Noi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Izliću svoj gnev na Sin,",
            "poem": 1
          },
          {
            "text": "tvrđavu egipatsku,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i istrebiti mnoštvo u Noi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Zapaliću vatru u Egiptu:",
            "poem": 1
          },
          {
            "text": "Sin će se previjati od muka,",
            "poem": 2
          },
          {
            "text": "Noa će biti osvojen,",
            "poem": 1
          },
          {
            "text": "a Nof će biti svakog dana u teskobi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Mladići Avina i Pi-Veseta pašće od mača,",
            "poem": 1
          },
          {
            "text": "a gradovi",
            "poem": 2
          },
          {
            "noteId": 9
          },
          {
            "text": "će otići u ropstvo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "U Tafnesu će se pomračiti dan",
            "poem": 1
          },
          {
            "text": "kada slomim jaram egipatski.",
            "poem": 2
          },
          {
            "text": "Tada će se ugasiti ponos njegove snage.",
            "poem": 1
          },
          {
            "text": "Prekriće ga oblak,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a njegove će ćerke otići u ropstvo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Tako ću izvršiti sudove na Egiptu,",
            "poem": 1
          },
          {
            "text": "pa će znati da sam ja Gospod.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Osuda faraona"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "U jedanaestoj godini, prvog meseca sedmog dana u mesecu, dođe mi reč Gospodnja:"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "„Sine čovečiji, ja sam slomio mišicu faraonu, egipatskom caru, a evo, niko mu na nju nije stavio povoj s melemima, niti je povio zavojima da se učvrsti, kako bi se latila mača."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Zato govori Gospod Bog: evo me protiv faraona, cara egipatskog; slomiću mu ruke, i zdravu i onu slomljenu, i učiniti da mu mač ispadne iz ruke."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Rasuću Egipćane među narode, i rasejati ih po zemljama."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Ja ću ojačati ruke vavilonskom caru i dati mu mač u ruku; slomiću ruke faraonu, a on će stenjati pred njim kao što stenje smrtno ranjen čovek."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Ojačaću ruke vavilonskom caru, a faraonove će ruke klonuti. Kada stavim mač u ruke vavilonskom caru, i on zamahne njime nad Egiptom, tada će znati da sam ja Gospod."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Ja ću rasuti Egipćane među narode i rasejati ih po zemljama. Tada će znati da sam ja Gospod.“"
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 9,
        "caller": "+",
        "text": "30,17 Septuaginta (kao i Daničić) prevodi a žene (devojke) će biti odvedene u ropstvo.",
        "reference": {
          "chapter": 30,
          "verse": 17
        }
      }
    ]
