  "chapter": {
    "number": 24,
    "content": [
      {
        "type": "heading",
        "content": [
          "Kotao s ključalom vodom"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Dođe mi reč Gospodnja devete godine, u desetom mesecu, desetog dana:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "„Sine čovečiji, zabeleži ovaj dan, upravo ovaj dan, jer je car vavilonski na ovaj isti dan opseo Jerusalim."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Ispričaj priču odmetničkom domu. Reci im: ’Govori Gospod Bog:",
          {
            "text": "Pristavi kotao; pristavi ga",
            "poem": 1
          },
          {
            "text": "i nalij vodu u njega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Stavi u njega komade mesa,",
            "poem": 1
          },
          {
            "text": "sve najbolje komade, but i plećku,",
            "poem": 2
          },
          {
            "text": "i napuni ga najboljim kostima.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Uzmi najbolje grlo sitne stoke",
            "poem": 2
          },
          {
            "text": "i naslaži kosti",
            "poem": 1
          },
          {
            "noteId": 7
          },
          {
            "text": "ispod njega.",
            "poem": 1
          },
          {
            "text": "Neka dobro uzavri,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "tako da se i kosti skuvaju u njemu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Zato govori Gospod Bog:",
          {
            "text": "Teško krvničkom gradu,",
            "poem": 1
          },
          {
            "text": "kotlu koji je zagoreo,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a čija zagorelina nije uklonjena!",
            "poem": 2
          },
          {
            "text": "Isprazni ga komad po komad;",
            "poem": 1
          },
          {
            "text": "za njega se neće bacati žreb.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Jer njegova je krv još u njemu:",
            "poem": 1
          },
          {
            "text": "stavio ju je na golu stenu;",
            "poem": 2
          },
          {
            "text": "nije je prolio na zemlju",
            "poem": 1
          },
          {
            "text": "da je pokrije prašina.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "I ja ću ostaviti njegovu krv",
            "poem": 1
          },
          {
            "text": "na goloj steni, nepokrivenu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da plane gnev i da se izvrši osveta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Zato govori Gospod Bog:",
          {
            "text": "Teško krvničkom gradu,",
            "poem": 1
          },
          {
            "text": "jer ću naložiti veliki oganj!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Stavi mnogo drva,",
            "poem": 1
          },
          {
            "text": "podloži vatru,",
            "poem": 2
          },
          {
            "text": "skuvaj meso,",
            "poem": 1
          },
          {
            "text": "umešaj začine;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "neka kosti zagore.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Zatim ga stavi praznog",
            "poem": 1
          },
          {
            "text": "na užareni ugalj da se zagreje,",
            "poem": 2
          },
          {
            "text": "tako da se bronza usija,",
            "poem": 1
          },
          {
            "text": "pa da zagorelina u njemu sagori.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Mukotrpan je to posao!",
            "poem": 1
          },
          {
            "text": "Zagorelina se ne skida s njega",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "čak ni ognjem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Razvratnost je u tvojoj nečistoti! Zato što sam te čistio, a ti se nisi dala očistiti od svoje nečistote, nećeš se više očistiti od svoje nečistote, dok ne iskalim svoj gnev na tebi."
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Ja, Gospod to sam rekao; to dolazi i to ću učiniti. Neću odustati, neću se sažaliti, neću se smilovati. Bićeš kažnjena zbog svojih puteva i svojih dela – govori Gospod Bog.’“"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Jezekilju umire žena"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Dođe mi opet reč Gospodnja:"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "„Sine čovečiji, uzeću od tebe želju tvojih očiju jednim udarcem. A ti ne tuguj, ne plači, niti roni suze."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Uzdiši tiho, ne nariči za mrtvima, obmotaj turban oko svoje glave, obuj sandale na noge, ne pokrivaj svoju bradu, i ne jedi što ti spreme ljudi.“"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "To sam ujutro rekao narodu, a uveče mi je umrla žena. Ujutro sam učinio kao što mi je bilo zapoveđeno."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Ljudi mi rekoše: „Zar nam nećeš reći šta za nas znači sve to što radiš?“"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Ja im rekoh: „Došla mi je reč Gospodnja:"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "’Reci domu Izrailjevom: govori Gospod Bog: evo, oskrnaviću svoje Svetilište, ponos vaše snage, uživanje vaših očiju, ono što vam duša želi, a vaši sinovi i ćerke koje ste ostavili, popadaće od mača."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Tada ćete učiniti kao što sam ja učinio; nećete pokrivati bradu i nećete jesti što vam spreme ljudi."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Turbani će vam biti na glavi a sandale na nogama. I nećete tugovati, ni plakati, nego ćete istrunuti zbog svojih krivica i uzdisati jedan pred drugim."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Jezekilj će vam biti znak; što je on radio, radićete i vi. A kad se to dogodi, znaćete da sam ja Gospod Bog."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "A ti, sine čovečiji, onoga dana kada im oduzmem ponos njihove snage, uživanje njihovih očiju i ono što im duša želi, njihove sinove i ćerke,"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "tog dana će doći begunac da ti donese vest."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Tog dana će ti se otvoriti usta pred tim beguncem, pa ćeš progovoriti i nećeš više biti nem; ti ćeš im biti znak. Tada će znati da sam ja Gospod.’“"
        ]
      }
    ],
