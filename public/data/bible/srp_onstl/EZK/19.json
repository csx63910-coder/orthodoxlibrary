  "chapter": {
    "number": 19,
    "content": [
      {
        "type": "heading",
        "content": [
          "Naricaljka o Izrailjevom padu"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "A ti izreci naricaljku za izrailjskim knezovima."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Reci:",
          {
            "text": "’Šta je bila mati tvoja? Lavica!",
            "poem": 1
          },
          {
            "text": "Među lavovima je ležala,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "među mladim lavovima mlade je hranila.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Kad jednog mladunca othrani,",
            "poem": 1
          },
          {
            "text": "mlad lav od njega postade.",
            "poem": 2
          },
          {
            "text": "Naučio se da plen razdire,",
            "poem": 1
          },
          {
            "text": "pa je ljude stao da proždire.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Narodi su za njega dočuli;",
            "poem": 1
          },
          {
            "text": "u njihovu se jamu uhvatio,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "u lancima ga u Egipat odvedoše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "A kad vide da uzalud čeka,",
            "poem": 1
          },
          {
            "text": "i da joj se nada razvejala,",
            "poem": 2
          },
          {
            "text": "ona uze drugoga mladunca,",
            "poem": 1
          },
          {
            "text": "i od njega učini lavića.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Među lavovima on je išao,",
            "poem": 1
          },
          {
            "text": "u mladoga je lava izrastao.",
            "poem": 2
          },
          {
            "text": "Naučio se da plen razdire,",
            "poem": 1
          },
          {
            "text": "pa je ljude stao da proždire.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Rušio je njihove dvorove,",
            "poem": 1
          },
          {
            "text": "pustošio njihove gradove,",
            "poem": 2
          },
          {
            "text": "Zemlja i svi što u njoj žive,",
            "poem": 1
          },
          {
            "text": "isprazni se od rike njegove.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Skupiše se narodi na njega,",
            "poem": 1
          },
          {
            "text": "iz okolnih krajeva dođoše,",
            "poem": 2
          },
          {
            "text": "svoje mreže razapeše nad njim,",
            "poem": 1
          },
          {
            "text": "i uhvati se u jamu njihovu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "U lancima ga u kavez metnuše,",
            "poem": 1
          },
          {
            "text": "dovedoše ga caru u Vavilon.",
            "poem": 2
          },
          {
            "text": "U tamnicu su njega bacili,",
            "poem": 1
          },
          {
            "text": "da se rika njegova više ne čuje",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "po gorama izrailjskim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Mati ti je bila kao loza,",
            "poem": 1
          },
          {
            "text": "zasađena kraj obilnih voda.",
            "poem": 2
          },
          {
            "text": "Plodna beše i sa puno lišća,",
            "poem": 1
          },
          {
            "text": "natapana obilnim vodama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Grane su joj bile moćne,",
            "poem": 1
          },
          {
            "text": "svaka beše kao žezlo carsko.",
            "poem": 2
          },
          {
            "text": "Visinom se više krošnji digla,",
            "poem": 1
          },
          {
            "text": "visina joj beše na vidiku",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "sa granama svojim mnogobrojnim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Iščupaše je gnevno,",
            "poem": 1
          },
          {
            "text": "i baciše na zemlju.",
            "poem": 2
          },
          {
            "text": "Osuši je vetar istočni,",
            "poem": 1
          },
          {
            "text": "rod joj bi pokidan, osušen,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a moćne grane oganj je proždro.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "A sada je u pustinji zasađena,",
            "poem": 1
          },
          {
            "text": "u zemlji suvoj i žednoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Planu oganj iz jednoga pruta,",
            "poem": 1
          },
          {
            "text": "rod joj proždra;",
            "poem": 2
          },
          {
            "text": "Ne osta joj moćna grana,",
            "poem": 1
          },
          {
            "text": "dostojna žezla vladarskog.’“",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          "To je naricaljka, i tako treba da se nariče."
        ]
      }
    ],
