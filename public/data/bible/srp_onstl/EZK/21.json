  "chapter": {
    "number": 21,
    "content": [
      {
        "type": "heading",
        "content": [
          "Protiv Jerusalima i okolnih naroda"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Dođe mi reč Gospodnja:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "„Sine čovečiji, okreni se licem prema jugu; izreci reč protiv juga, prorokuj protiv šumskog kraja u Negevu."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Reci šumi negevskoj: ’Čuj reč Gospodnju! Govori Gospod Bog: evo, razbuktaću u tebi oganj, koji će progutati svako drvo, zeleno i suvo. Razbuktali plamen neće se ugasiti, i svako će lice biti spaljeno od juga do severa."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Tada će svako videti da sam ga ja, Gospod, zapalio; i neće se ugasiti.’“"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "A ja rekoh: „Jao, Gospode Bože, oni govore za mene: ’Nije li to onaj što ispreda priče?’“"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Tada mi dođe reč Gospodnja:"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "„Sine čovečiji, okreni se licem prema Jerusalimu i propovedaj protiv Svetilišta, i prorokuj protiv zemlje Izrailjeve."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Reci zemlji Izrailjevoj: ’Govori Gospod: evo, ja sam protiv tebe; isukaću svoj mač iz korica i istrebiću iz tebe i pravednog i opakog."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "I pošto ću istrebiti iz tebe i pravednog i opakog, zato ću isukati mač iz korica na svakoga od juga do severa."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Tada će svi ljudi znati da sam ja, Gospod, isukao svoj mač iz korica, i da se tamo neće više vratiti.’"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "A ti, sine čovečiji, uzdiši kao da su ti polomljena bedra, gorko uzdiši na njihove oči."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Kada te budu pitali: ’Zašto uzdišeš?’, odgovori im: ’Zbog vesti koja će doći. Tada će svako srce izgubiti odvažnost i sve će ruke klonuti, svaki će duh zamreti i sva će kolena biti oduzeta.’ Evo, dolazi i ispuniće se – govori Gospod Bog.“"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "I dođe mi reč Gospodnja:"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "„Sine čovečiji, prorokuj i reci: ’Gospod kaže:",
          {
            "text": "Mač! Mač",
            "poem": 1
          },
          {
            "text": "naoštren i izglačan,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "naoštren za klanje,",
            "poem": 1
          },
          {
            "text": "uglačan da seva.",
            "poem": 2
          },
          {
            "text": "Zar da se radujemo vladarskoj palici, sine moj",
            "poem": 1
          },
          {
            "noteId": 3
          },
          {
            "text": "?",
            "poem": 1
          },
          {
            "text": "Mač ne mari ni za kakvo drvo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Dat je da se uglača,",
            "poem": 1
          },
          {
            "text": "da ga ruka prihvati;",
            "poem": 2
          },
          {
            "text": "naoštren je mač, izglačan,",
            "poem": 1
          },
          {
            "text": "da se ubici da u ruku!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Zaplači, zakukaj, sine čovečiji,",
            "poem": 1
          },
          {
            "text": "jer mač će stići narod moj",
            "poem": 2
          },
          {
            "text": "i sve knezove izrailjske;",
            "poem": 1
          },
          {
            "text": "s mojim narodom",
            "poem": 2
          },
          {
            "text": "maču su oni predani.",
            "poem": 1
          },
          {
            "text": "Zato se udaraj u grudi svoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "To će biti kušanje. A ako vladarskog štapa, za koga mač ne mari, ne bude više? – govori Gospod Bog."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Zato prorokuj, sine čovečiji,",
            "poem": 1
          },
          {
            "text": "udari dlanom o dlan,",
            "poem": 2
          },
          {
            "text": "neka mač udari dvaput, triput,",
            "poem": 1
          },
          {
            "text": "mač taj što služi za pokolj.",
            "poem": 2
          },
          {
            "text": "Mač je to velikog pokolja,",
            "poem": 1
          },
          {
            "text": "što ih odasvud vreba.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Da klonu srca i da mnogi padnu,",
            "poem": 1
          },
          {
            "text": "na svaka sam vrata njihova",
            "poem": 2
          },
          {
            "text": "postavio mač da zatire.",
            "poem": 1
          },
          {
            "text": "Jao! Načinjen je da seva kao munja,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "isukan je za klanje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Zamahni na desno,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "udri na levo,",
            "poem": 1
          },
          {
            "text": "gde god ti se sečivo nameri.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "I udariću dlanom o dlan,",
            "poem": 1
          },
          {
            "text": "i smiriće se gnev moj.",
            "poem": 2
          },
          {
            "text": "Ja, Gospod, sam govorio.’“",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Dođe mi reč Gospodnja:"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "„Sine čovečiji, označi dva puta kojim će doći mač cara vavilonskog. Neka oba izlaze iz iste zemlje. Zatim načini znak i postavi ga na početak puta koji vodi u grad."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Označi put kojim će mač doći u Ravu amonsku, i u Judu, u jerusalimsku tvrđavu."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Naime, car vavilonski će se zaustaviti na raskršću, gde počinju dva puta, da gata: trešće strele, pitaće idole i gledati u jetru."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "U desnoj će ruci držati gatarski žreb za Jerusalim, da postavi probojne sprave, da naredi pokolj, da podigne bojni poklik, da namesti probojne sprave prema vratima, da podigne nasip, i da sagradi opsadne kule."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "To će izgledati kao isprazno gatanje onima koji su položili zakletvu, ali on će im dozvati u pamet njihovu krivicu, pa će ih zarobiti.“"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Zato govori Gospod Bog: „Zato što dozivate u pamet svoju krivicu javno čineći svoje prestupe, te iznosite na videlo vaše grehe – sva vaša dela – zato ćete biti pohvatani njegovom rukom."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "A ti, nečisti, opaki kneže Izrailjev, došlo ti je vreme; kucnuo je čas da se stane na kraj tvom bezakonju!“"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "Govori Gospod Bog: „Skini turban i odloži krunu. Neće više biti kao pre: neka se niski uzvisi, a uzvišeni snizi."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Propast! Propast! Dovešću takvu propast kakve još nije bilo, dok ne dođe onaj kome pripada sud; njemu ću ga dati.“"
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "„A ti, sine čovečiji, prorokuj i reci: ’Govori Gospod Bog Amoncima za njihovo ruganje:",
          {
            "text": "Mač! Mač je isukan za klanje,",
            "poem": 1
          },
          {
            "text": "izglačan da proždere,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da seva kao munja!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Pošto ti donose isprazna viđenja",
            "poem": 1
          },
          {
            "text": "i proriču ti laži,",
            "poem": 2
          },
          {
            "text": "položiće se mač",
            "poem": 1
          },
          {
            "text": "na vratove opakih bezbožnika.",
            "poem": 2
          },
          {
            "text": "Njima je došlo vreme,",
            "poem": 1
          },
          {
            "text": "kucnuo je čas da se stane na kraj njihovom bezakonju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "A ti",
            "poem": 1
          },
          {
            "noteId": 4
          },
          {
            "text": "vrati svoj mač u korice!",
            "poem": 1
          },
          {
            "text": "Ja ću ti suditi u mestu gde si stvoren,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "sudiću ti u zemlji tvog porekla.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Izliću na tebe svoju jarost,",
            "poem": 1
          },
          {
            "text": "dunuću oganj svoga besa na tebe",
            "poem": 2
          },
          {
            "text": "i predaću te u ruke svirepim ljudima,",
            "poem": 1
          },
          {
            "text": "veštim u zatiranju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Bićeš hrana ognju,",
            "poem": 1
          },
          {
            "text": "a tvoja će krv teći u zemlji,",
            "poem": 2
          },
          {
            "text": "i pašćeš u zaborav,",
            "poem": 1
          },
          {
            "text": "jer sam ja, Gospod, progovorio.’“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
