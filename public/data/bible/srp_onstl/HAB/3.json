    "name": "Knjiga proroka Avakuma",
    "commonName": "Knjiga proroka Avakuma",
    "title": "Knjiga proroka Avakuma",
    "order": 35,
    "numberOfChapters": 3,
    "sha256": "d8f2e217fc16fd5c785084d2b48002abad41f8895a3545ef9f219d18187ce291",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/HAB/1.json",
    "lastChapterNumber": 3,
    "lastChapterApiLink": "/api/srp_onstl/HAB/3.json",
    "totalNumberOfVerses": 56
  },
  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "heading",
        "content": [
          "Avakumova molitva"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Molitva proroka Avakuma u obliku naricaljki:",
            "descriptive": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "O, Gospode, čuo sam vest o tebi",
            "poem": 1
          },
          {
            "text": "i uplašio sam se!",
            "poem": 2
          },
          {
            "text": "O, Gospode, oživi delo svoje u vremenu,",
            "poem": 1
          },
          {
            "text": "obnovi ga usred godina,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "seti se da se smiluješ u gnevu svome.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Sa Temana dolazi Bog",
            "poem": 1
          },
          {
            "text": "i Svetitelj sa Gore Farana. Sela",
            "poem": 2
          },
          {
            "noteId": 1
          },
          {
            "text": "Veličanstvo njegovo pokriva nebesa,",
            "poem": 1
          },
          {
            "text": "a slava njegova zemlju ispunjava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Njegovo svetlo blista,",
            "poem": 1
          },
          {
            "text": "a u ruci mu je dvokraka munja,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "gde je skrovište snage njegove.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Pred njim pomor ide,",
            "poem": 1
          },
          {
            "text": "a pošast ga sve u stopu prati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Kada stane, tad se zemlja trese;",
            "poem": 1
          },
          {
            "text": "kad pogleda, narodi poskaču;",
            "poem": 2
          },
          {
            "text": "rastresu se večiti vrhovi",
            "poem": 1
          },
          {
            "text": "i sležu se brda drevna,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer drevni su putevi njegovi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Video sam tugu pod šatorima Kušana,",
            "poem": 1
          },
          {
            "text": "podrhtavaju šatorski zastori zemlje madijanske.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "O, Gospode, jesi li na reke gnevan?",
            "poem": 1
          },
          {
            "text": "Gneviš li se ti na reke",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ili si na more jarostan?",
            "poem": 2
          },
          {
            "text": "Evo, jezdiš na konjima",
            "poem": 1
          },
          {
            "text": "svojih bojnih kola spasenja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Razotkriven i vidno je postavljen luk tvoj,",
            "poem": 1
          },
          {
            "text": "reč zakletve tvoje šiba. Sela",
            "poem": 2
          },
          {
            "text": "A reke brazdaju zemlju.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Gledaju te, grče se planine,",
            "poem": 2
          },
          {
            "text": "kuljaju bujične vode,",
            "poem": 1
          },
          {
            "text": "bezdan se javlja hukom svojim",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i ruke svoje visoko diže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Sunce i mesec miruju u svom prebivalištu,",
            "poem": 1
          },
          {
            "text": "uminu na svetlo strela tvojih",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i na blesak sjaja tvoga koplja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ti u ljutnji zemlju gaziš,",
            "poem": 1
          },
          {
            "text": "u jarosti ti narode vršeš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Izlaziš zbog spasenja svog naroda,",
            "poem": 1
          },
          {
            "text": "zbog spasenja pomazanika svoga drobiš glavara zlikovačkog doma,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "razotkrivaš od pete do vrata. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Njihovim kopljima probadaš glavara njihovih ratnika,",
            "poem": 1
          },
          {
            "text": "a oni jurišaju da nas zdrobe,",
            "poem": 2
          },
          {
            "text": "i likuju kao kad u potaji",
            "poem": 1
          },
          {
            "text": "proždiru siromaha.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ti gaziš po moru konjima svojim",
            "poem": 1
          },
          {
            "text": "i pene se velike vode.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "I ja sam to čuo i stomak mi se zgrčio,",
            "poem": 1
          },
          {
            "text": "od tog zvuka mi zadrhtaše usne,",
            "poem": 2
          },
          {
            "text": "trulež mi se uvuče u kosti,",
            "poem": 1
          },
          {
            "text": "a kolena mi zaklecaše.",
            "poem": 2
          },
          {
            "text": "Smiriću se sve do dana nevolje",
            "poem": 1
          },
          {
            "text": "što dolazi na narod koji nas napada.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ako smokva i ne propupi,",
            "poem": 1
          },
          {
            "text": "ako nema na čokotu ploda;",
            "poem": 2
          },
          {
            "text": "izneveri li trud oko masline,",
            "poem": 1
          },
          {
            "text": "ne rode li polja hranom,",
            "poem": 2
          },
          {
            "text": "nestane li stado iz tora",
            "poem": 1
          },
          {
            "text": "i iščezne stoka iz obora,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "u Gospodu ja ću da uskliknem",
            "poem": 1
          },
          {
            "text": "i veselim se u Bogu mog spasenja!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Gospod Bog je moja snaga!",
            "poem": 1
          },
          {
            "text": "Dade mi noge hitre ko u košute,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "po mom kršu dade mi da hodam.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          "Horovođi uz moje žičane instrumente."
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 1,
        "caller": "+",
        "text": "3,3 Osim na ovom mestu, na sredini 9. i na kraju 11. stiha, ovaj se pojam sreće sedamdesetak puta u psalmima. Njegovo značenje nije sigurno i smatra se da je ritmička odrednica.",
