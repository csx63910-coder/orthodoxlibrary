  },
  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Proroštvo koje je video prorok Avakum:"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Avakumova žalopojka"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "O, Gospode, dokle da vapim za pomoć,",
            "poem": 1
          },
          {
            "text": "a ti me ne čuješ!",
            "poem": 2
          },
          {
            "text": "Vičem o nasilju,",
            "poem": 1
          },
          {
            "text": "a ti ne spasavaš!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Zašto daješ da gledam pokvarenost,",
            "poem": 1
          },
          {
            "text": "da vidim nevolju?",
            "poem": 2
          },
          {
            "text": "Razaranje i nasilje su pred očima mojim.",
            "poem": 1
          },
          {
            "text": "Eno, i nasilje i nesloga se dižu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Zato Zakon gubi snagu,",
            "poem": 1
          },
          {
            "text": "zato pravdi nikada nema mesta.",
            "poem": 2
          },
          {
            "text": "Zlotvor opkoljava pravednika",
            "poem": 1
          },
          {
            "text": "i zato ima mesta za pravdu iskvarenu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Gospodnji odgovor"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "„U narode pogledajte,",
            "poem": 1
          },
          {
            "text": "čudite se i divite,",
            "poem": 2
          },
          {
            "text": "jer, evo, učiniću nešto u vaše dane,",
            "poem": 1
          },
          {
            "text": "u šta ne biste verovali",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da vam ko ispriča.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Jer, evo podižem Haldejce,",
            "poem": 1
          },
          {
            "text": "surov i nagao narod",
            "poem": 2
          },
          {
            "text": "da širom zemlje",
            "poem": 1
          },
          {
            "text": "osvaja tuđa naselja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Strahovit je i užasan;",
            "poem": 1
          },
          {
            "text": "on odlučuje šta je pravda,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a šta dostojanstvo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Konji su im hitriji od risova",
            "poem": 1
          },
          {
            "text": "i svirepiji od vukova u sumrak.",
            "poem": 2
          },
          {
            "text": "Konjanici im galopiraju,",
            "poem": 1
          },
          {
            "text": "dolaze izdaleka njihovi konjanici;",
            "poem": 2
          },
          {
            "text": "lete, obrušavaju se kao lešinar",
            "poem": 1
          },
          {
            "text": "što bi da ždere.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Svi dolaze zbog nasilja,",
            "poem": 1
          },
          {
            "text": "horde su im okrenute istoku,",
            "poem": 2
          },
          {
            "text": "a zarobljenike sakupljaju",
            "poem": 1
          },
          {
            "text": "kao da su pesak.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "On se ruga i carevima",
            "poem": 1
          },
          {
            "text": "i sa vladarima se šegači.",
            "poem": 2
          },
          {
            "text": "Svakom se utvrđenju smeje",
            "poem": 1
          },
          {
            "text": "dok zemljane nasipe pravi i osvaja ih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Kao vetar tada zaviori i mine,",
            "poem": 1
          },
          {
            "text": "ali kriv je taj kome je božanstvo njegova snaga.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Avakumova druga žalopojka"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "O, Gospode, zar ti nisi od davnina, moj Bože sveti?",
            "poem": 1
          },
          {
            "text": "Nećemo mi umreti!",
            "poem": 2
          },
          {
            "text": "O, Gospode, za sud si ih odredio.",
            "poem": 1
          },
          {
            "text": "O, Steno, za prekor si ih učvrstio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Prečiste su oči tvoje da bi zlo promatrale,",
            "poem": 1
          },
          {
            "text": "ti pakost ne možeš da gledaš.",
            "poem": 2
          },
          {
            "text": "Zašto onda trpiš nevernike,",
            "poem": 1
          },
          {
            "text": "ćutiš dok zlikovac proždire pravednijeg od sebe?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Stvorio si ljude kao ribe u moru",
            "poem": 1
          },
          {
            "text": "i kao gmizavce što vladara nemaju među sobom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "I on ih sve udicom vadi,",
            "poem": 1
          },
          {
            "text": "vuče ih svojom mrežom",
            "poem": 2
          },
          {
            "text": "i u mrežu ih skuplja.",
            "poem": 1
          },
          {
            "text": "Zato se i raduje i likuje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Zato svojoj mreži žrtvuje,",
            "poem": 1
          },
          {
            "text": "pali tamjan mreži svojoj,",
            "poem": 2
          },
          {
            "text": "jer mu ona daje mastan obrok",
            "poem": 1
          },
          {
            "text": "i obilje hrane.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "I hoće li zbog toga da prazni mrežu svoju,",
            "poem": 1
          },
          {
            "text": "da istrajno satirate narode bez zadrške?",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
