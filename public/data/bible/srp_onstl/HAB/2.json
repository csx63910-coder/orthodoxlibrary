  },
  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Stajaću na svojoj straži,",
            "poem": 1
          },
          {
            "text": "zauzeću mesto na bedemu.",
            "poem": 2
          },
          {
            "text": "Stražariću da vidim šta će po meni reći",
            "poem": 1
          },
          {
            "text": "i šta da mu odgovorim kada me ukori?",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Gospodnji odgovor"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "I Gospod mi je uzvratio rečima:",
          {
            "text": "„Čitko zapiši objavu na ploče,",
            "poem": 1
          },
          {
            "text": "da se lako čita.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jer ipak je ova objava za određeno vreme,",
            "poem": 1
          },
          {
            "text": "žuri se kraju",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i ne obmanjuje.",
            "poem": 2
          },
          {
            "text": "A ako i kasni, pričekaj,",
            "poem": 1
          },
          {
            "text": "jer će sigurno doći.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Doći će i neće zakasniti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Evo čoveka prkosnog!",
            "poem": 1
          },
          {
            "text": "U njemu je duša nepravedna,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a pravednik će živeti od svoje vere.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Pa još i vino izneverava oholog čoveka",
            "poem": 1
          },
          {
            "text": "i ne drži ga mesto kod kuće.",
            "poem": 2
          },
          {
            "text": "Zinuo je kao Svet mrtvih",
            "poem": 1
          },
          {
            "noteId": 0
          },
          {
            "text": ".",
            "poem": 1
          },
          {
            "text": "On je kao smrt i nikad mu dosta nije.",
            "poem": 2
          },
          {
            "text": "On za sebe okuplja sve narode",
            "poem": 1
          },
          {
            "text": "i sve ljude za sebe sabira.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "A neće li baš ti narodi, svaki od njih, da pokrenu priču, pesmu rugalicu i zagonetku o njemu? Reći će:",
          {
            "text": "’Teško onome što sabira što mu ne pripada",
            "poem": 1
          },
          {
            "text": "– i do kada tako misli –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "što je sebe nakrcao zalozima?’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Neće li se nenadano dići zajmodavci tvoji?",
            "poem": 1
          },
          {
            "text": "Probudiće se oni pred kojima ćeš strepeti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pa ćeš ti njima postati plen.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Zato što si mnoge narode poharao,",
            "poem": 1
          },
          {
            "text": "poharaće tebe ostatak naroda.",
            "poem": 2
          },
          {
            "text": "I to za krv ljudi,",
            "poem": 1
          },
          {
            "text": "za nasilje nad zemljom,",
            "poem": 2
          },
          {
            "text": "nad gradom",
            "poem": 1
          },
          {
            "text": "i nad svima koji u njemu žive.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Jao onom ko za svoju kuću nepoštenu dobit zgrće gramzivo,",
            "poem": 1
          },
          {
            "text": "da bi u visini svoje gnezdo svio,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da bi se spasao iz ruku propasti!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Kući si svojoj sramotu naneo ubijanjem mnogih naroda",
            "poem": 1
          },
          {
            "text": "i dušu svoju ogrešio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Jer će kamen iz zida vikati,",
            "poem": 1
          },
          {
            "text": "svedočiće greda iz krova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Jao onome koji na krvi grad gradi",
            "poem": 1
          },
          {
            "text": "i naselje osniva na nepravdi!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Pazi, zar nije od Gospoda nad vojskama",
            "poem": 1
          },
          {
            "text": "to što narodi rade za oganj",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i što se ljudi iscrpljuju nizašta?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Jer će se zemlja ispuniti poznavanjem Gospoda,",
            "poem": 1
          },
          {
            "text": "kao što je vodom ispunjeno more.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Jao onome ko napija svoga bližnjeg,",
            "poem": 1
          },
          {
            "text": "gnev svoj izliva",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i opija ga da bi mu gledao golotinju!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Nasitićeš se sramotom više nego čašću.",
            "poem": 1
          },
          {
            "text": "Pij sada i ti i pokaži svoju neobrezanost.",
            "poem": 2
          },
          {
            "text": "Stići će te čaša u desnici Gospodnjoj",
            "poem": 1
          },
          {
            "text": "i sramota će pokriti čast tvoju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Jer će te stići nasilje nad Livanom,",
            "poem": 1
          },
          {
            "text": "istrebljenje životinja preplašenih,",
            "poem": 2
          },
          {
            "text": "krv ljudi,",
            "poem": 1
          },
          {
            "text": "nasilje nad zemljom,",
            "poem": 2
          },
          {
            "text": "nad gradom",
            "poem": 1
          },
          {
            "text": "i nad svima koji u njemu žive.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Kakva je korist od lika koji je klesar isklesao,",
            "poem": 1
          },
          {
            "text": "od livenog idola, učitelja laži?",
            "poem": 2
          },
          {
            "text": "Jer onaj koji ga je napravio se pouzdaje u svoje delo,",
            "poem": 1
          },
          {
            "text": "praveći neme idole.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Jao onome koji drvetu govori: ’Budi se!’",
            "poem": 1
          },
          {
            "text": "I kamenu nemom: ’Podigni se!’",
            "poem": 2
          },
          {
            "text": "Taj li će da te poučava?",
            "poem": 1
          },
          {
            "text": "Evo, optočen je zlatom i srebrom,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ali u njemu nema daha.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Ali Gospod je u svom hramu svetom.",
            "poem": 1
          },
          {
            "text": "Tiho pred njim, zemljo sva!",
            "poem": 2
          }
        ]
      }
    ],
