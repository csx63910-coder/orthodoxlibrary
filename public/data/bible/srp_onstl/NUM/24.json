  "chapter": {
    "number": 24,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Kad je Valam video da je Gospodu po volji da blagosilja Izrailja, nije više išao da traži znamenja kao prethodna dva puta, nego se okrenuo licem prema pustinji."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Kad je Valam pogledao, video je kako Izrailj logoruje po svojim plemenima. Tada je Duh Gospodnji došao na njega,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "pa je izrekao svoju priču. Rekao je:",
          {
            "text": "„Proroštvo Valama, sina Veorovog,",
            "poem": 1
          },
          {
            "text": "proroštvo čoveka, koji jasno vidi,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "proroštvo onoga što reči Božije čuje.",
            "poem": 1
          },
          {
            "text": "On viđenje prima od Svemoćnoga,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "na tlo pada očima otvorenim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Kako su ti divni šatori, Jakove,",
            "poem": 1
          },
          {
            "text": "i tvoja boravišta, Izrailju!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Kao potoci granaju se,",
            "poem": 1
          },
          {
            "text": "kao vrtovi pokraj reke,",
            "poem": 2
          },
          {
            "text": "kao aloje koje Gospod posadi,",
            "poem": 1
          },
          {
            "text": "kao kedrovi što su pokraj vode.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Voda će poteći iz njegovih vedara,",
            "poem": 1
          },
          {
            "text": "potomstvo mu biti nad mnogim vodama.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Car će mu se uzdići nad Agagom,",
            "poem": 1
          },
          {
            "text": "i carstvo se njegovo uzvisiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Iz Egipta Bog ga je izveo,",
            "poem": 1
          },
          {
            "text": "on je njemu kao rozi bivolovi.",
            "poem": 2
          },
          {
            "text": "Neprijatelje će svoje proždreti,",
            "poem": 1
          },
          {
            "text": "kosti im slomiti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "strelama ih probosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Spustio se kao lav,",
            "poem": 1
          },
          {
            "text": "legao je kao lavica;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ko sme njega da izaziva?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Blaženi da su koji tebe blagosiljaju,",
            "poem": 1
          },
          {
            "text": "prokleti da su koji tebe proklinju!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Tu se Valak razgnevi na Valama, pljesnu dlanom o dlan, pa reče Valamu: „Pozvao sam te da prokuneš moje neprijatelje, a evo, ti si ih blagoslovio sva ova tri puta!"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Odlazi sada u svoje mesto! Rekao sam da ću te bogato nagraditi, ali Gospod ti je uskratio nagradu.“"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Valam odgovori Valaku: „Zar nisam rekao i tvojim glasnicima koje si poslao:"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "’Da mi Valak da svoju kuću punu srebra i zlata, ne bih mogao da prekršim zapovest Gospodnju, kako bih na svoju ruku učinio bilo dobro, bilo zlo – govoriću ono što mi Gospod bude rekao’?"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "A sad, evo, idem svome narodu, hajde da ti saopštim šta će ovaj narod učiniti tvom narodu u poslednjim danima.“"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Valamova četvrta priča"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Tada Valam izreče svoju priču:",
          {
            "text": "„Proroštvo Valama, sina Veorovog,",
            "poem": 1
          },
          {
            "text": "proroštvo čoveka koji jasno vidi,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "proroštvo onoga što Božije reči čuje,",
            "poem": 1
          },
          {
            "text": "i poznaje mudrost Svevišnjega.",
            "poem": 2
          },
          {
            "text": "On viđenje prima od Svemoćnoga,",
            "poem": 1
          },
          {
            "text": "na tlo pada očima otvorenim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Vidim ga, ali ne u sadašnjosti,",
            "poem": 1
          },
          {
            "text": "posmatram ga, ali ne iz bliza.",
            "poem": 2
          },
          {
            "text": "Zvezda će izaći od Jakova,",
            "poem": 1
          },
          {
            "text": "žezlo se podići od Izrailja;",
            "poem": 2
          },
          {
            "text": "on će satrti krajeve moavske,",
            "poem": 1
          },
          {
            "text": "i razbiti Sitove potomke.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Edom će postati tuđa imovina,",
            "poem": 1
          },
          {
            "text": "Sir, dušman njegov zaposednut biće,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kad Izrailj nastupi sa silom!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Vladar će od Jakova izaći,",
            "poem": 1
          },
          {
            "text": "i istrebiti preživele iz grada.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Valamova peta priča"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Zatim je pogledao prema Amaliku i izrekao svoju priču:",
          {
            "text": "„Amalik je bio prvi među narodima,",
            "poem": 1
          },
          {
            "text": "ali mu je kraj u propasti.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Valamova šesta priča"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Onda je pogledao prema Keneju i izrekao svoju priču:",
          {
            "text": "„Čvrsto stoji tvoje stanište,",
            "poem": 1
          },
          {
            "text": "gnezdo",
            "poem": 2
          },
          {
            "noteId": 26
          },
          {
            "text": "tvoje na steni počiva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "No, Kenej će biti istrebljen,",
            "poem": 1
          },
          {
            "text": "kad ga Asirija u roblje odvede.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Valamova sedma priča"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Ponovo Valam izreče svoju priču:",
          {
            "text": "„Jao! Ko će preživeti kad Bog učini ovo?",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Brodovi će doći iz Kitima,",
            "poem": 2
          },
          {
            "text": "ali će i on propasti zauvek,",
            "poem": 1
          },
          {
            "text": "kad pokori Asiriju i Evera.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Potom Valam ustane i vrati se u svoje mesto, a Valak ode svojim putem."
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 26,
        "caller": "+",
        "text": "24,21 Reč za gnezdo zvuči slično kao Kajin, što je igra reči u jevrejskom.",
        "reference": {
          "chapter": 24,
          "verse": 21
        }
      }
    ]
