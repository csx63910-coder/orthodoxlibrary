  "chapter": {
    "number": 23,
    "content": [
      {
        "type": "heading",
        "content": [
          "Valamova prva priča"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Valam reče Valaku: „Podigni mi ovde sedam žrtvenika i pripremi mi sedam junaca i sedam ovnova.“"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Valak učini onako kako mu je Valam rekao. Zatim su Valak i Valam prineli na žrtveniku jednog junca i jednog ovna."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Valam reče Valaku: „Ostani kod svoje svespalnice, a ja ću poći; možda će se Gospod sresti sa mnom, pa šta mi kaže, to ću govoriti.“ Tako ode on na uzvišicu."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Gospod je sreo Valama, i Valam mu je rekao: „Pripremio sam sedam žrtvenika i na svakom žrtveniku prineo jednog junca i jednog ovna.“"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Tada Gospod stavi reč u Valamova usta i reče: „Vrati se Valaku i govori tako.“"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Kad se vratio Valaku, ovaj je stajao kod svoje svespalnice sa svim moavskim knezovima."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Tada Valam izreče svoju priču:",
          {
            "text": "„Iz Arama me Valak dovede,",
            "poem": 1
          },
          {
            "text": "car moavski iz gorja istočnog:",
            "poem": 2
          },
          {
            "text": "’Dođi – reče – Jakova mi prokuni,",
            "poem": 1
          },
          {
            "text": "dođi i Izrailj prezri!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Kako da prokunem",
            "poem": 1
          },
          {
            "text": "koga Bog ne proklinje,",
            "poem": 2
          },
          {
            "text": "i prezrem",
            "poem": 1
          },
          {
            "text": "koga Gospod ne prezire?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Jer gledam ga s planinskih vrhova,",
            "poem": 1
          },
          {
            "text": "posmatram ga s gorskih uzvišenja;",
            "poem": 2
          },
          {
            "text": "gle naroda koji živi izdvojeno,",
            "poem": 1
          },
          {
            "text": "među narode on se ne računa.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ko će izbrojiti prah Jakovljev,",
            "poem": 1
          },
          {
            "text": "ko da izbroji četvrtinu Izrailja?",
            "poem": 2
          },
          {
            "text": "O, kad bih umro smrću pravedničkom,",
            "poem": 1
          },
          {
            "text": "kad bi i moj kraj bio kao njihov!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Tada Valak reče Valamu: „Šta si mi to učinio? Doveo sam te da prokuneš moje neprijatelje, a ti si ih obilno blagoslovio.“"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Valam odgovori: „Zar da ne kažem verno ono što mi je Gospod stavio u usta?“"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Valamova druga priča"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Valak mu reče: „Pođi sa mnom na drugo mesto; odatle ćeš videti samo jedan njegov deo, a ne sav narod. Odande mi ga prokuni.“"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Zatim ga je odveo u Zofimsko polje, na vrh Fasge. Tamo je podigao sedam žrtvenika i na svakom žrtveniku prineo po jednog junca i ovna."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Valam reče Valaku: „Stani tu kod svoje svespalnice, a ja idem onamo da se sretnem s Gospodom.“"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Gospod sretne Valama, stavi svoju reč u njegova usta i reče: „Vrati se Valaku i govori ovako.“"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Kada se vratio k njemu, Valak je stajao kod svoje svespalnice sa moavskim knezovima. Valak ga upita: „Šta je Gospod rekao?“"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Tada Valam izreče svoju priču:",
          {
            "text": "„Ustani, Valače,",
            "poem": 1
          },
          {
            "text": "poslušaj me, sine Seforov!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Bog nije čovek da bi slagao,",
            "poem": 1
          },
          {
            "text": "ili potomak ljudski da bi se kajao.",
            "poem": 2
          },
          {
            "text": "Zar je šta rekao da nije učinio,",
            "poem": 1
          },
          {
            "text": "izrekao da nije ispunio?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Zapovest mi dade da blagosiljam,",
            "poem": 1
          },
          {
            "text": "blagoslov je dao i neću ga povući.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Ne nazire se nesreća u Jakovu,",
            "poem": 1
          },
          {
            "text": "nevolja se ne vidi u Izrailju.",
            "poem": 2
          },
          {
            "text": "S njim je Gospod, Bog njegov,",
            "poem": 1
          },
          {
            "text": "carski mu poklik sred njega odzvanja!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Bog ih je iz Egipta izveo,",
            "poem": 1
          },
          {
            "text": "on je njemu kao rozi bivolovi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Protiv Jakova nema vračanja,",
            "poem": 1
          },
          {
            "text": "protiv Izrailja nema gatanja.",
            "poem": 2
          },
          {
            "text": "Nek se sada priča o Jakovu,",
            "poem": 1
          },
          {
            "text": "o Izrailju nek se pripoveda:",
            "poem": 2
          },
          {
            "text": "’Evo, šta je Bog učinio!’",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Kakav li je to samo narod!",
            "poem": 1
          },
          {
            "text": "Kao lavica ustaje,",
            "poem": 2
          },
          {
            "text": "kao lav se diže,",
            "poem": 1
          },
          {
            "text": "ne leže dok ulov ne proždere",
            "poem": 2
          },
          {
            "text": "i krvi se žrtava ne napije.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Tada Valak reče Valamu: „Kad ga već ne možeš prokleti, nemoj ga ni blagosiljati!“"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Valam odgovori Valaku: „Zar ti nisam rekao: ’Učiniću sve što mi Gospod bude rekao?’“"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Valamova treća priča"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Valam reče Valaku: „Hajde da te odvedem na drugo mesto; možda će Bogu biti po volji da mi ih prokuneš odande!“"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Valak povede Valama na vrh Fegora koji se nadvija nad pustarom."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Valam reče Valaku: „Podigni mi ovde sedam žrtvenika i pripremi mi sedam junaca i sedam ovnova.“"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Valak je uradio kako mu je Valam rekao, i prineo sedam junaca i sedam ovnova."
        ]
      }
    ],
    "footnotes": []
  },
