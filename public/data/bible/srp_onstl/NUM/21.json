  "chapter": {
    "number": 21,
    "content": [
      {
        "type": "heading",
        "content": [
          "Razorenje Arada"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Kad je car Arada, Hananac koji je živeo u Negevu, čuo da Izrailj dolazi iz pravca Atarina, napao je Izrailjce i zarobio neke od njih."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Tada se Izrailj zavetovao Gospodu, rekavši: „Ako predaš ovaj narod u naše ruke, izručićemo njegove gradove kletom uništenju.“"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Gospod je uslišio Izrailjev glas i predao im Hanance. Izručili su kletom uništenju i njih i njihove gradove. Zato se to mesto prozvalo Orma",
          {
            "noteId": 23
          },
          "."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Bronzana zmija"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Sa gore Or su se zaputili putem prema Crvenom moru, da bi zaobišli edomsku zemlju. Ali narod je na putu postao nestrpljiv."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Tada je narod rekao protiv Boga i protiv Mojsija: „Zašto ste nas izveli iz Egipta? Da pomremo u pustinji? Jer nema ni hleba ni vode, a ova jadna hrana nam se ogadila.“"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Tada je Gospod poslao na narod otrovne zmije",
          {
            "noteId": 24
          },
          "; one su ih ujedale, pa je pomrlo mnogo naroda u Izrailju."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Narod je došao k Mojsiju i rekao: „Zgrešili smo kad smo govorili protiv Gospoda i protiv tebe. Pomoli se Gospodu da ukloni zmije od nas!“ Mojsije se pomolio za narod."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Gospod reče Mojsiju: „Napravi zmiju otrovnicu i postavi je na stub. Bude li ko ujeden, neka pogleda na nju i preživeće.“"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Mojsije napravi bronzanu zmiju i postavi je na stub. I kad bi zmija ujela nekog, taj bi pogledao u zmiju i ozdravio."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Put za Moav"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Izrailjci su nastavili i utaborili se u Ovotu."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Napustivši Ovot, utaborili su se kod Ije-Avarima, u pustinji nasuprot Moava, prema istoku."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Odande su otišli i utaborili se kod potoka Zareda."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Kad su otišli odande, utaborili su se na drugoj strani Arnona, koji je u pustinji i izvire na amorejskoj međi. Naime, Arnon je moavska granica, između Moavaca i Amorejaca."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Zato se kaže u Knjizi Gospodnjih ratova:",
          {
            "text": "„Vajev kod Sufe i arnonski potoci,",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "s pritokama što dopiru do mesta Ara,",
            "poem": 2
          },
          {
            "text": "i naslanjaju se na moavsku granicu.“",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Odande odu do Vira, bunara gde je Gospod rekao Mojsiju: „Okupi narod da im dam vodu.“"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Tada je Izrailj zapevao ovu pesmu:",
          {
            "text": "„Pokuljaj, bunare! Zapojte mu:",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Bunar su knezovi iskopali,",
            "poem": 1
          },
          {
            "text": "izdubili ga velikaši narodni,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "žezlom i štapovima svojim.“",
            "poem": 2
          },
          "Iz pustinje odoše u Mantanain,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "iz Mantanaina u Nahaliel, a iz Nahaliela u Vamot;"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "iz Vamota u dolinu što je u moavskoj zemlji, kod vrhunca Fasge što se nadvija nad pustarom."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Ratovi protiv Sihona i Oga"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Izrailj je poslao glasnike Sihonu, amorejskom caru, s porukom:"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "„Dozvoli mi da prođem kroz tvoju zemlju. Nećemo skretati ni u polja ni u vinograde, i nećemo piti vodu iz bunara, nego ćemo ići carskim putem, dok ne prođemo tvoje područje.“"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Međutim, Sihon nije dozvolio Izrailju da prođe kroz njegovo područje. Sihon je skupio sav svoj narod i izašao da presretne Izrailja u pustinji. Kad je došao do Jase, stupio je u boj protiv Izrailja."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Izrailj ga je potukao oštrim mačem i osvojio njegovu zemlju od Arnona do Javoka, sve do Amonaca, jer je amonska granica bila utvrđena."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Izrailj je zauzeo sve te gradove i nastanio se u svim amorejskim gradovima, Esevonu i svim njegovim selima."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "A Esevon je bio grad amorejskog cara Sihona, koji je ratovao protiv pređašnjeg moavskog cara, od koga je oduzeo svu njegovu zemlju sve do Arnona."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Zato pesnici kažu:",
          {
            "text": "„Dođite u Esevon da se podigne",
            "poem": 1
          },
          {
            "text": "i utvrdi Sihonov grad!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Jer suknu oganj iz Esevona,",
            "poem": 1
          },
          {
            "text": "plamen iz grada Sihonovog,",
            "poem": 2
          },
          {
            "text": "te proguta Ar moavski",
            "poem": 1
          },
          {
            "text": "i stanovnike visina arnonskih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Teško tebi, Moave,",
            "poem": 1
          },
          {
            "text": "propao si, narode Hamosov.",
            "poem": 2
          },
          {
            "text": "Svoje je sinove učinio izbeglicama,",
            "poem": 1
          },
          {
            "text": "a ćerke svoje zatočenicama",
            "poem": 2
          },
          {
            "text": "Sihona, cara amorejskog.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "I potukosmo ih;",
            "poem": 1
          },
          {
            "text": "propade Esevon sve do Devona,",
            "poem": 2
          },
          {
            "text": "opustošismo ih do Nofa",
            "poem": 1
          },
          {
            "text": "što se pruža do Medeve.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "Tako se Izrailj nastanio u amorejskoj zemlji."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Nakon što je Mojsije poslao ljude da izvide Jazir, Izrailjci su osvojili njegova sela i izgnali Amorejce koji su tamo živeli."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "Potom su se okrenuli i krenuli gore putem za Vasan. Tada je Og, vasanski car, i sav njegov narod izašao protiv njih u boj kod Edrajina."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "Gospod reče Mojsiju: „Ne boj ga se, jer sam u tvoje ruke predao i njega, i sav njegov narod, i njegovu zemlju. Učini s njim kao što si učinio s amorejskim carem Sihonom, koji je živeo u Esevonu.“"
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "Tada su potukli njega, njegove sinove i sav njegov narod, tako da mu nije ostao nijedan preživeli; a njegovu zemlju su zaposeli."
        ]
      }
    ],
