  "chapter": {
    "number": 15,
    "content": [
      {
        "type": "heading",
        "content": [
          "Mojsijeva pesma"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Tada su Mojsije i Izrailjci zapevali ovu pesmu u slavu Gospoda:",
          {
            "text": "„Gospodu ću zapevati,",
            "poem": 1
          },
          {
            "text": "jer se silno proslavio,",
            "poem": 2
          },
          {
            "text": "konja i konjanika",
            "poem": 1
          },
          {
            "text": "u more je svalio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Gospod je moja sila i pesma,",
            "poem": 1
          },
          {
            "text": "on mi je spasenje.",
            "poem": 2
          },
          {
            "text": "On je moj Bog, slaviću Boga oca svoga,",
            "poem": 1
          },
          {
            "text": "njega ću ja uzvisivati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Gospod je ratnik,",
            "poem": 1
          },
          {
            "text": "Gospod mu je ime.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Kola je faraonova",
            "poem": 1
          },
          {
            "text": "i vojsku njegovu u more sručio,",
            "poem": 2
          },
          {
            "text": "čelnici se vojni",
            "poem": 1
          },
          {
            "text": "u moru Crvenom podavili.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Tama ih je prekrila,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "u dubine su morske",
            "poem": 1
          },
          {
            "text": "kao kamen potonuli.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Desnica se tvoja, Gospode,",
            "poem": 1
          },
          {
            "text": "proslavila silom,",
            "poem": 2
          },
          {
            "text": "desnica je tvoja, Gospode,",
            "poem": 1
          },
          {
            "text": "zatrla dušmana.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Veličanstvom svoje slave",
            "poem": 1
          },
          {
            "text": "oborio si one što se protiv tebe bune,",
            "poem": 2
          },
          {
            "text": "svoj gnev si kao oganj poslao,",
            "poem": 1
          },
          {
            "text": "proždro ih je kao slamu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Na dah tvojih nozdrva sabraše se vode,",
            "poem": 1
          },
          {
            "text": "stihije se morske kao zid uspraviše,",
            "poem": 2
          },
          {
            "text": "u srcu mora bezdan se morski",
            "poem": 1
          },
          {
            "text": "u tlo čvrsto pretvori.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Dušmanin reče:",
            "poem": 1
          },
          {
            "text": "’Goniću ih, uhvatiti,",
            "poem": 2
          },
          {
            "text": "plen svoj podeliti,",
            "poem": 1
          },
          {
            "text": "zasitiću njima svoju dušu;",
            "poem": 2
          },
          {
            "text": "svoj ću mač isukati",
            "poem": 1
          },
          {
            "text": "i silom ih porobiti.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Na dah tvojih usta",
            "poem": 1
          },
          {
            "text": "more ih je prekrilo,",
            "poem": 2
          },
          {
            "text": "potonuše kao olovo",
            "poem": 1
          },
          {
            "text": "u moćnim vodama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ko je kao ti,",
            "poem": 1
          },
          {
            "text": "Gospode, među bogovima?",
            "poem": 2
          },
          {
            "text": "Ko je kao ti,",
            "poem": 1
          },
          {
            "text": "veličanstven u svetosti,",
            "poem": 2
          },
          {
            "text": "strašan u slavi,",
            "poem": 1
          },
          {
            "text": "tvorac čudesa?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ispružio si svoju desnicu",
            "poem": 1
          },
          {
            "text": "i zemlja ih je progutala.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Svojom milošću ti si izveo narod,",
            "poem": 1
          },
          {
            "text": "njega si ti otkupio,",
            "poem": 2
          },
          {
            "text": "snagom si ga svojom poveo",
            "poem": 1
          },
          {
            "text": "k stanu svoje svetosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Čuće to narodi, od straha zadrhtaće,",
            "poem": 1
          },
          {
            "text": "strava obuzeće žitelje filistejske.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Smeli su se vladari edomski,",
            "poem": 1
          },
          {
            "text": "zastrepeli knezovi moavski,",
            "poem": 2
          },
          {
            "text": "klonuli su svi žitelji Hanana.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Užas i strah njih je obuzeo,",
            "poem": 2
          },
          {
            "text": "mišicom si ih svojom moćnom",
            "poem": 1
          },
          {
            "text": "zanemeo, skamenio,",
            "poem": 2
          },
          {
            "text": "dok tvoj narod, Gospode, ne prođe,",
            "poem": 1
          },
          {
            "text": "dok narod, koji si ti stekao, ne prođe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Dovešćeš ih i zasaditi",
            "poem": 1
          },
          {
            "text": "na gori koja tebi pripada,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "na mestu koje ti, o, Gospode,",
            "poem": 2
          },
          {
            "text": "boravištem svojim učini,",
            "poem": 1
          },
          {
            "text": "Svetilištem, Gospode,",
            "poem": 2
          },
          {
            "text": "što ga tvoje ruke utemeljiše.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Gospod će carevati",
            "poem": 1
          },
          {
            "text": "u veke vekova.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Kad su, dakle, faraonovi konji, bojna kola i konjanici pošli za njima u more, Gospod je vratio morske vode na njih, dok su Izrailjci hodali po suvom usred mora."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Potom je Aronova sestra Marija, proročica, uzela bubanj u ruku, a sve ostale žene su je pratile s bubnjevima i plešući."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Marija im je zapevala:",
          {
            "text": "„Zapevajte Gospodu",
            "poem": 1
          },
          {
            "text": "jer se silno proslavio,",
            "poem": 2
          },
          {
            "text": "konja i konjanika",
            "poem": 1
          },
          {
            "text": "u more je svalio.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Gorka voda kod Mare"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Mojsije je poveo Izrailjce od Crvenog mora. Krenuli su prema pustinji Sur. Tri dana su putovali pustinjom, ali nisu našli vodu."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Kad su došli u Maru, nisu mogli da piju vodu kod Mare, jer je bila gorka. Zato su to mesto nazvali Mara",
          {
            "noteId": 7
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Narod je gunđao Mojsiju: „Šta ćemo da pijemo?“"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Mojsije zavapi Gospodu. Gospod mu pokaže neko drvo. Mojsije baci to drvo u vodu i voda postane slatka. Tamo im je Gospod dao uredbe i pravo, i tamo ih je stavio na kušnju."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Rekao je: „Ako pažljivo slušaš glas Gospoda, Boga svoga, činiš što je pravo pred njim, i slušaš njegove zapovesti, te držiš sve njegove uredbe, nijedna od pošasti koje sam doveo na Egipat neće doći na tebe. Jer sam ja, Gospod, tvoj lekar.“"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Zatim su došli u Elim, gde je bilo dvanaest izvora i sedamdeset palmi. Utaborili su se tu, uz vodu."
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 7,
        "caller": "+",
        "text": "15,23 Mara znači gorka, gorčina.",
        "reference": {
          "chapter": 15,
          "verse": 23
        }
      }
    ]
