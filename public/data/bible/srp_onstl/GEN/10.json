  "chapter": {
    "number": 10,
    "content": [
      {
        "type": "heading",
        "content": [
          "Tablica naroda"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ovo je rodoslov Nojevih sinova: Sima, Hama i Jafeta. Njima su se rodili sinovi posle potopa."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Jafetovci"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Jafetovi sinovi su: Gomer, Magog, Midij, Javan, Tuval, Meseh i Tiras."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Gomerovi sinovi su: Ashenas, Rifat i Togarma."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Javanovi sinovi su: Elisa i Tarsis, Kitim i Dodanim."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "(Od njih su se razgranali ostrvski narodi po svojim zemljama; svaki sa svojim jezikom, svojim rodovima i svojim narodima.)"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Hamovci"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Hamovi sinovi su: Kuš i Misraim",
          {
            "noteId": 19
          },
          ", Fut i Hanan."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "A Kušovi sinovi su: Seva, Evila, Savata, Regma i Savataka. Regmini sinovi su: Sava i Dedan."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Kušu se rodio Nevrod. Ovaj je postao prvi moćnik na zemlji."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "On je bio i moćni lovac pred Gospodom. Zato se kaže: „Kao Nevrod, moćni lovac pred Gospodom.“"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Njegovo carstvo su u početku sačinjavali: Vavilon, Oreh, Arhad i Halani u zemlji Senar."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Iz te zemlje je otišao u Asiriju i podigao Ninivu, Rehovot Ir i Halah,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "te Resen između Ninive i velikog grada Halaha."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Od Misraima su, pak, potekli Ludejci, Enemejci, Lavejci i Naftuhijci,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "pa Patrošani, Haslonjani (od kojih su potekli Filistejci) i Kaftoreji."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Hananu se rodio Sidon, njegov prvenac, i Het."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Od Hanana vode poreklo Jevusejci, Amorejci, Gergešani,"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Evejci, Arukejci, Sinijci,"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Arvađani, Samarjani, i Amaćani. Posle su se hananska plemena rasejala,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "tako da se granica Hananaca protezala od Sidona prema Geraru, sve do Gaze, pa prema Sodomi i Gomori, Admi i Sevojimu, sve do Lasa."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "To su Hamovi potomci, prema svojim plemenima i jezicima, po svojim zemljama i narodima."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Simovci"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "A i Simu, praocu svih sinova Everovih, starijem bratu Jafetovom, rodili su se sinovi."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Simovi sinovi: Elam, Asur, Arfaksad, Lud i Aram."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "A Aramovi sinovi su: Uz, Ul, Geter i Mas."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Arfaksadu se, pak, rodio Sala, a Sali Ever."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Everu su se rodila dva sina: jedan se zvao Falek, jer su se za vreme njegovog života ljudi na zemlji podelili; a njegov brat se zvao Jektan."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Jektanu su se rodili Elmodad, Salef, Acarmavet i Jarah,"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Adoram, Uzal, Dikla,"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Oval, Avimail, Sava,"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Ofir, Evila i Jovav; svi ovi su bili Jektanovi sinovi."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Njihova su se naselja protezala od Mase do Safira, istočnog gorja."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "To su Simovi sinovi prema svojim plemenima i jezicima, zemljama i narodima."
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "To su plemena Nojevih sinova prema svojim rodoslovima i narodima. Od njih su se razgranali narodi posle potopa."
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 19,
        "caller": "+",
        "text": "10,6 Misraim je praotac svih Misiraca, svih Egipćana. (Misir je staro ime Egipta.)",
        "reference": {
          "chapter": 10,
          "verse": 6
        }
      }
    ]
