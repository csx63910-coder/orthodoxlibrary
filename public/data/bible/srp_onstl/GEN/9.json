  "chapter": {
    "number": 9,
    "content": [
      {
        "type": "heading",
        "content": [
          "Bog sklapa savez s Nojem"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Zatim Bog blagoslovi Noja i njegove sinove i reče im: „Plodite se i množite i napunite zemlju."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Bojaće vas se i strahovati od vas sve životinje na zemlji, sve ptice nebeske, sve što se kreće po zemlji, i sve ribe u moru; u vaše ruke su predate."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Sve što se kreće i živi biće vam za hranu, kao i zeleno bilje; sve vam to dajem."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Ali meso s njegovim životom, to jest, s njegovom krvlju ne smete jesti."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "A ko prolije vašu krv u kojoj je vaš život, tražiću da odgovara za to. Tražiću da odgovara svaka životinja i svaki čovek za svoga brata."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ko prolije krv čovekovu,",
            "poem": 1
          },
          {
            "text": "njegovu će krv čovek proliti,",
            "poem": 2
          },
          {
            "text": "jer po svome liku",
            "poem": 1
          },
          {
            "text": "stvori Bog čoveka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "A vi, plodite se i množite i raširite po zemlji množeći se na njoj.“"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Još reče Bog Noju i njegovim sinovima što su bili s njim:"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "„Evo, ja sklapam svoj savez s vama i s vašim potomstvom posle vas,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "i sa svim živim bićima s vama: s pticama, sa stokom i svim divljim životinjama na zemlji – s onima što su s vama izašle iz plovila – sa svim životinjama na zemlji."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ja ću se držati svog saveza s vama, te potopne vode nikad više neće uništiti sva živa bića, niti će ikad više potop pustošiti zemlju.“"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Još reče Bog: „Ovo je znak saveza koji sklapam između sebe i vas i svih živih bića što su s vama, savez za sva buduća pokolenja."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Svoju dugu postavljam u oblake da bude znak saveza između mene i zemlje."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "A kad navučem oblake nad zemljom i pojavi se duga u oblacima,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "tada ću se setiti svoga saveza između sebe i vas, i svakog živog bića, svakog stvorenja: neće više biti potopnih voda da zatru svako stvorenje."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Kad se duga pojavi u oblacima, ja ću na nju pogledati i setiti se večnog saveza između Boga i svakog živog bića, svakog stvorenja na zemlji.“"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Na kraju reče Bog Noju: „Ovo je znak saveza koji sam sklopio između sebe i svakog stvorenja na zemlji.“"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Noje i njegovi sinovi"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Nojevi sinovi, koji su izašli iz plovila, bili su: Sim, Ham i Jafet. Ham je otac Hananov."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Ova trojica su Nojevi sinovi; od njih je poteklo čovečanstvo koje se raširilo po celoj zemlji."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Noje počne da obrađuje zemlju i zasadi vinograd."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Jednom se on napije vina i opije, pa se svuče go nasred svog šatora."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Ham, otac Hananov, opazi golotinju svoga oca, pa javi to dvojici svoje braće napolju."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Tada Sim i Jafet uzmu ogrtač, prebace ga sebi preko ramena, pa hodajući natraške pokriju očevu golotinju. Licem su bili okrenuti na drugu stranu, tako da nisu videli očevu golotinju."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Kad se Noje otreznio od vina, doznao je šta mu je učinio najmlađi sin."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Tada Noje reče:",
          {
            "text": "„Proklet da je Hanan,",
            "poem": 1
          },
          {
            "text": "svojoj braći najniži sluga neka bude!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Potom je rekao:",
          {
            "text": "„Neka je blagosloven Gospod, Bog Simov,",
            "poem": 1
          },
          {
            "text": "Hanan neka mu sluga bude!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Neka Bog umnoži potomstvo Jafetovo,",
            "poem": 1
          },
          {
            "text": "neka živi među šatorima Simovim,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Hanan neka mu je sluga!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Noje je živeo još tri stotine pedeset godina nakon potopa."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Noje je ukupno živeo devet stotina pedeset godina i umro."
        ]
      }
    ],
