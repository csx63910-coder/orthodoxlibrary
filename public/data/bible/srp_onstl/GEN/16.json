  "chapter": {
    "number": 16,
    "content": [
      {
        "type": "heading",
        "content": [
          "Ismailovo rođenje"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "No, Avramova žena Saraja nije Avramu rađala dece. Ona je imala sluškinju Egipćanku koja se zvala Agara."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Saraja reče Avramu: „Evo, Gospod me je učinio nerotkinjom. Idi i lezi s mojom sluškinjom, možda ću preko nje steći potomstvo.“ Avram je poslušao što mu je Saraja rekla."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Tada je Avramova žena Saraja dovela Avramu svoju sluškinju Agaru Egipćanku i dala mu je za ženu (bilo je to deset godina nakon što se Avram naselio u Hananskoj zemlji)."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Avram legne sa Agarom i ona zatrudni. Kad je videla da je zatrudnela, s prezirom je gledala na svoju gospodaricu."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Saraja tada reče Avramu: „Tvoja je krivica što mi se nanosi ova nepravda. Predala sam svoju sluškinju u tvoj zagrljaj, ali otkako je opazila da je zatrudnela, počela je s prezirom da gleda na mene. Neka Gospod presudi ko je od nas dvoje kriv!“"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Avram odgovori Saraji: „Evo, tvoja sluškinja je u tvojoj vlasti. Kako ti se čini da je dobro, tako postupi prema njoj.“ Saraja poče tako zlostavljati Agaru, da je ova pobegla od nje."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "No, Anđeo Gospodnji je nađe kod izvora što je na putu za Sur,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "pa je zapita: „Agaro, sluškinjo Sarajina, odakle dolaziš i kuda ideš?“ Agara odgovori: „Bežim od svoje gospodarice Saraje.“"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Tada joj Anđeo Gospodnji reče: „Vrati se svojoj gospodarici i pokori joj se!“"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Anđeo Gospodnji joj uz to reče: „Veoma ću umnožiti tvoje potomstvo, tako da se neće moći prebrojiti!“"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Još joj reče Anđeo Gospodnji:",
          {
            "text": "„Evo, začela si",
            "poem": 1
          },
          {
            "text": "i rodićeš sina.",
            "poem": 2
          },
          {
            "text": "Daćeš mu ime ’Ismailo’",
            "poem": 1
          },
          {
            "noteId": 27
          },
          {
            "text": ",",
            "poem": 1
          },
          {
            "text": "jer je Gospod čuo za tvoju nevolju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "On će biti kao divlji magarac:",
            "poem": 1
          },
          {
            "text": "ruka će se njegova na svakoga dizati,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i svačija ruka na njega će se dizati,",
            "poem": 2
          },
          {
            "text": "sa svom svojom braćom",
            "poem": 1
          },
          {
            "text": "u neprijateljstvu će živeti.“",
            "poem": 2
          },
          {
            "noteId": 28
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Agara je nazvala Gospoda koji joj je govorio: „Ti si Bog koji me vidi!“ Agara je, naime, rekla: „Uistinu, videla sam onoga koji me vidi!“"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Zato se taj izvor zove „Vir Lahaj Roj“",
          {
            "noteId": 29
          },
          "i nalazi se između Kadisa i Varada."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Agara je Avramu rodila sina. Avram je sinu koga mu je Agara rodila, dao ime Ismailo."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Avramu je bilo osamdeset šest godina kada mu je Agara rodila Ismaila."
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 27,
        "caller": "+",
        "text": "16,11 Ismailo znači Bog je čuo.",
        "reference": {
          "chapter": 16,
          "verse": 11
        }
      },
      {
        "noteId": 28,
        "caller": "+",
        "text": "16,12 Doslovno: pred licem sve svoje braće će živeti.",
        "reference": {
          "chapter": 16,
          "verse": 12
        }
      },
      {
        "noteId": 29,
        "caller": "+",
        "text": "16,14 Vir Lahaj Roj znači Izvor onoga što živi i vidi me.",
        "reference": {
          "chapter": 16,
          "verse": 14
        }
      }
    ]
