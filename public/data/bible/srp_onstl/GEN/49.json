  "chapter": {
    "number": 49,
    "content": [
      {
        "type": "heading",
        "content": [
          "Jakovljevo zaveštanje"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Jakov zatim pozva svoje ostale sinove i reče: „Okupite se da vam kažem šta će se zbiti sa vama u poslednjim danima."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Okupite se i čujte, sinovi Jakovljevi,",
            "poem": 1
          },
          {
            "text": "čujte oca svoga Izrailja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ruvime, prvenče moj,",
            "poem": 1
          },
          {
            "text": "ti si moja snaga,",
            "poem": 2
          },
          {
            "text": "prvi plod si moje muževnosti.",
            "poem": 1
          },
          {
            "text": "Dostojanstvom druge nadmašuješ,",
            "poem": 2
          },
          {
            "text": "a po snazi ravna ti nema.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ipak, neobuzdan kao bujica,",
            "poem": 2
          },
          {
            "text": "ti prvenac nećeš više biti.",
            "poem": 1
          },
          {
            "text": "Jer na ležaj svoga oca si se popeo,",
            "poem": 2
          },
          {
            "text": "na postelju si se moju popeo",
            "poem": 1
          },
          {
            "text": "i tako je oskrnavio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Simeun i Levije braća su rođena,",
            "poem": 1
          },
          {
            "text": "mačevi njihovi oruđe su nasilja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Na većanja njihova ja ne silazio,",
            "poem": 1
          },
          {
            "text": "niti u savez sa njima ulazio.",
            "poem": 2
          },
          {
            "text": "Jer u srdžbi ljude su pobili,",
            "poem": 1
          },
          {
            "text": "iz obesti volove sakatili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Proklet bio gnev njihov",
            "poem": 1
          },
          {
            "text": "jer je prežestok,",
            "poem": 2
          },
          {
            "text": "i jarost njihova,",
            "poem": 1
          },
          {
            "text": "jer je preokrutna!",
            "poem": 2
          },
          {
            "text": "Zato ću ih razdeliti po Jakovu",
            "poem": 1
          },
          {
            "text": "i rasejati po Izrailju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Judo! Braća će te tvoja slaviti;",
            "poem": 1
          },
          {
            "text": "ruka će tvoja biti na vratu neprijatelja tvojih,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "braća tvoja tebi će se klanjati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Judo, laviću!",
            "poem": 1
          },
          {
            "text": "Od plena si, sine, sit otišao;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kao lav je polegao,",
            "poem": 2
          },
          {
            "text": "kao lavica se ispružio.",
            "poem": 1
          },
          {
            "text": "Ko sme njega da izaziva?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Žezlo se carsko od Jude odvojiti neće,",
            "poem": 1
          },
          {
            "text": "ni palica vladarska od njegovih nogu,",
            "poem": 2
          },
          {
            "text": "dok ne dođe onaj kome pripada,",
            "poem": 1
          },
          {
            "noteId": 101
          },
          {
            "text": "kome će se narodi pokoriti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Svoje magare za lozu privezuje,",
            "poem": 1
          },
          {
            "text": "ždrebe magarice za čokot loze.",
            "poem": 2
          },
          {
            "text": "Svoju odeću u vinu pere,",
            "poem": 1
          },
          {
            "text": "svoju haljinu u krvi od vina.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Oči su mu mutne od vina,",
            "poem": 1
          },
          {
            "text": "zubi su mu beli od mleka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Zavulon će živeti na obali mora,",
            "poem": 1
          },
          {
            "text": "utočište biće brodovima,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "do Sidona biće mu granica.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Isahar je magarac koščati",
            "poem": 1
          },
          {
            "text": "što pod svojim samarom",
            "poem": 2
          },
          {
            "noteId": 102
          },
          {
            "text": "leži.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Videće on da je odmorište zgodno",
            "poem": 1
          },
          {
            "text": "a zemlja prelepa,",
            "poem": 2
          },
          {
            "text": "pa će svoja leđa pod teret staviti,",
            "poem": 1
          },
          {
            "text": "i na službu ropsku će pristati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Dan će svome narodu suditi;",
            "poem": 1
          },
          {
            "text": "on je kao svako pleme Izrailjevo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Nek Dan bude zmija na putu,",
            "poem": 1
          },
          {
            "text": "ljuta guja pokraj staze",
            "poem": 2
          },
          {
            "text": "što će konja za petu ujesti,",
            "poem": 1
          },
          {
            "text": "a konjanik njegov nauznak će pasti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Tvome se spasenju nadam, Gospode!",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Gada će napadati pljačkaši,",
            "poem": 1
          },
          {
            "text": "no on će im za petama biti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "U Asira obilje je hrane,",
            "poem": 1
          },
          {
            "text": "za careve davaće poslastice.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Neftalim je košuta slobodna,",
            "poem": 1
          },
          {
            "text": "koja divnu lanad mladi.",
            "poem": 2
          },
          {
            "noteId": 103
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Josif je loza rodna,",
            "poem": 1
          },
          {
            "text": "loza rodna kraj izvora,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "koja grane preko zida pruža.",
            "poem": 2
          },
          {
            "noteId": 104
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Ljuto su ga strelci napali,",
            "poem": 1
          },
          {
            "text": "strelama se na njega okomili,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "ali luk on čvrsto zapet drži,",
            "poem": 1
          },
          {
            "text": "mišice mu krepke, ojačale,",
            "poem": 2
          },
          {
            "text": "rukom Boga, Jakog Jakovljevog,",
            "poem": 1
          },
          {
            "text": "zaslugom Pastira, Stene Izrailja,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Bogom tvoga oca, koji ti pomaže,",
            "poem": 1
          },
          {
            "text": "Svemoćnim koji te blagosilja",
            "poem": 2
          },
          {
            "text": "blagoslovima odozgo s nebesa,",
            "poem": 1
          },
          {
            "text": "blagoslovima odozdo iz bezdana,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "blagoslovima dojenja i rađanja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Blagoslovi tvoga oca",
            "poem": 1
          },
          {
            "text": "od blagoslova drevnih planina su obilniji",
            "poem": 2
          },
          {
            "noteId": 105
          },
          {
            "text": ",",
            "poem": 2
          },
          {
            "text": "od obilja večnih brda izdašniji.",
            "poem": 1
          },
          {
            "text": "Nek se oni spuste na glavu Josifovu,",
            "poem": 2
          },
          {
            "text": "na teme posvećenog među braćom.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Venijamin je vuk grabljivi,",
            "poem": 1
          },
          {
            "text": "jutrom jede lovinu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a naveče deli plen.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "To su sva Izrailjeva plemena, njih dvanaest. Ovo im je njihov otac rekao kad ih je blagosiljao. Svakoga od njih je blagoslovio posebnim blagoslovom."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Jakovljeva smrt"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Zatim im je zapovedio: „Uskoro ću se pridružiti svome narodu. Sahranite me sa mojim precima u pećinu koja se nalazi na polju Efrona Hetita."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "To je pećina na polju Makpeli, prema Mamriji u hananskoj zemlji, koju je Avraham, zajedno s poljem, kupio od Efrona Hetita za mesto sahranjivanja."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "Tamo su sahranjeni Avraham i njegova žena Sara, tamo su sahranjeni Isak i njegova žena Reveka, a tamo sam sahranio i Liju."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Polje i pećina na njemu su kupljeni od potomaka Hetita.“"
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "Kad je Jakov dao ova uputstva svojim sinovima, privukao je svoje noge na postelju i izdahnuo, pridruživši se tako svome narodu."
        ]
      }
    ],
    "footnotes": [
