  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "heading",
        "content": [
          "Ljudski planovi i Božiji planovi"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Jao onima koji zlo spremaju,",
            "poem": 1
          },
          {
            "text": "koji kuju nepravdu na posteljama svojim!",
            "poem": 2
          },
          {
            "text": "Kad osvane, onda to i čine,",
            "poem": 1
          },
          {
            "text": "jer je sila u ruci njihovoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Zažele njive – otimaju ih;",
            "poem": 1
          },
          {
            "text": "i kuće – oduzimaju ih.",
            "poem": 2
          },
          {
            "text": "Oni tlače čoveka i dom njegov,",
            "poem": 1
          },
          {
            "text": "čoveka i njegovo nasledstvo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Zato ovako kaže Gospod:",
          {
            "text": "„Evo, rodu ovom spremam zlo.",
            "poem": 1
          },
          {
            "text": "Iz njega nećete svoje vratove izvući",
            "poem": 2
          },
          {
            "text": "i nećete nadmeno ići,",
            "poem": 1
          },
          {
            "text": "jer će doći vreme zla.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Toga će dana o vama s podsmehom pričati,",
            "poem": 1
          },
          {
            "text": "naricaće naricaljku:",
            "poem": 2
          },
          {
            "text": "’Zbilo se – reći će. Satrveni smo sasvim.",
            "poem": 1
          },
          {
            "text": "Menjao je deo naroda moga.",
            "poem": 2
          },
          {
            "text": "Kako ga je otrgnuo od mene!",
            "poem": 1
          },
          {
            "text": "Naša je polja dao otpadnicima.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Zato nećeš imati nikoga ko bi ti žrebom",
            "poem": 1
          },
          {
            "text": "merio užetom zemlju u zboru Gospodnjem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Lažni proroci"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "„Ne penite proroštvima“ – prorokuju oni –",
            "poem": 1
          },
          {
            "text": "„Ne prorokujte o tim stvarima!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Neće se na nas obrušiti.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Kažeš li ti, o, dome Jakovljev:",
            "poem": 1
          },
          {
            "text": "„Je li Duh Gospodnji nestrpljiv?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "To li su njegova dela?“",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Ne čine li moje reči dobro",
            "poem": 1
          },
          {
            "text": "onome koji ispravno živi?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Koliko juče moj se narod podigao",
            "poem": 1
          },
          {
            "text": "kao neprijatelj.",
            "poem": 2
          },
          {
            "text": "Skidate sa haljine plašt",
            "poem": 1
          },
          {
            "text": "onima koji spokojno prolaze,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kao oni koji se iz bitke vraćaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Žene mog naroda terate",
            "poem": 1
          },
          {
            "text": "iz njihovih voljenih kuća,",
            "poem": 2
          },
          {
            "text": "od njihove dece slavu moju",
            "poem": 1
          },
          {
            "text": "doveka uzimate.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ustanite i idite",
            "poem": 1
          },
          {
            "text": "jer ovo nije mesto počinka.",
            "poem": 2
          },
          {
            "text": "Zato što je nečisto,",
            "poem": 1
          },
          {
            "text": "biće razoreno i biće to strahovito razaranje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ako čovek lažov, što ide niz vetar, slaže –",
            "poem": 1
          },
          {
            "text": "prorokovaću ti o vinu i žestokom piću –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "taj će biti prorok ovom narodu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Obećanje izbavljenja"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Zaista, okupiću, Jakove, sve vas.",
            "poem": 1
          },
          {
            "text": "Zaista, zajedno ću okupiti ostatak Izrailjev.",
            "poem": 2
          },
          {
            "text": "Učiniću ih poput ovaca u toru,",
            "poem": 1
          },
          {
            "text": "poput stada posred paše njegove,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da od ljudi bude larma.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Pred njima će ići onaj što prodire,",
            "poem": 1
          },
          {
            "text": "pa će i oni prodrti, proći kroz vrata i izaći kroz njih.",
            "poem": 2
          },
          {
            "text": "Njihov će car ići pred njima",
            "poem": 1
          },
          {
            "text": "i Gospod na njihovom čelu.“",
            "poem": 2
          }
        ]
      }
    ],
