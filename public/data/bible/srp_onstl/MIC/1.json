    "name": "Knjiga proroka Miheja",
    "commonName": "Knjiga proroka Miheja",
    "title": "Knjiga proroka Miheja",
    "order": 33,
    "numberOfChapters": 7,
    "sha256": "9108ac3172c9b88a367d199e3b0b65b09e834973d9f95495c9c4f8a9e2eeb2cd",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/MIC/1.json",
