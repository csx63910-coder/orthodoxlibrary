  },
  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ovo je Gospodnja reč koja je došla Miheju Morašćaninu, viđenje za Samariju i Jerusalim u vreme Jotama, Ahaza i Jezekije, careva Jude."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Čujte, o, narodi svi!",
            "poem": 1
          },
          {
            "text": "Poslušaj, zemljo, svi vi što je ispunjavate!",
            "poem": 2
          },
          {
            "text": "Neka Gospod Bog protiv vas svedok bude,",
            "poem": 1
          },
          {
            "text": "Gospod iz hrama svetosti svoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Sud nad Samarijom i Jerusalimom"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jer, gle, izlazi Gospod iz svog mesta,",
            "poem": 1
          },
          {
            "text": "sići će da gazi visine zemaljske.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Pod njim će se topiti planine,",
            "poem": 1
          },
          {
            "text": "raspuknuće se doline",
            "poem": 2
          },
          {
            "text": "kao vosak pred ognjem,",
            "poem": 1
          },
          {
            "text": "biće kao kada voda niz strminu teče.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Sve je to zbog Jakovljevog prestupa",
            "poem": 1
          },
          {
            "text": "i zbog greha kuće izrailjske.",
            "poem": 2
          },
          {
            "text": "A koji je Jakovljev prestup?",
            "poem": 1
          },
          {
            "text": "Zar to nije Samarija?",
            "poem": 2
          },
          {
            "text": "I koje su uzvišice Judine?",
            "poem": 1
          },
          {
            "text": "Zar to nije Jerusalim?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "„Samariju ću da pretvorim u hrpu kamenja nasred ledine,",
            "poem": 1
          },
          {
            "text": "u polje za zasad vinograda.",
            "poem": 2
          },
          {
            "text": "Kamenje ću njeno da izručim u dolinu,",
            "poem": 1
          },
          {
            "text": "ogoliću njene temelje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Biće satrveni svi njeni kipovi",
            "poem": 1
          },
          {
            "text": "i u vatri izgoreće svi njeni dobici.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Uništiću sve njene idole",
            "poem": 2
          },
          {
            "text": "jer ih je nakupila od dobiti bludničke,",
            "poem": 1
          },
          {
            "text": "pa će opet biti bludnička dobit.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Plač i žaljenje"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Žaliću ja zbog ovog, vapiću,",
            "poem": 1
          },
          {
            "text": "ići ću bos i go.",
            "poem": 2
          },
          {
            "text": "Zavijaću naricaljku kao šakal",
            "poem": 1
          },
          {
            "text": "i kliktaću kao ženka noja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Jer nema leka za njenu ranu",
            "poem": 1
          },
          {
            "text": "koja dođe sve do Jude,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "raširi se sve do vrata mog naroda u Jerusalimu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ne javljajte Gatu,",
            "poem": 1
          },
          {
            "text": "ne jecajte, ne plačite.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "U Vet-Afri u prašini valjajte se.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Beži, stanovnice safirska,",
            "poem": 1
          },
          {
            "text": "gola i osramoćena.",
            "poem": 2
          },
          {
            "text": "Neće izaći stanovnica sananska",
            "poem": 1
          },
          {
            "text": "jer zbog naricaljke Vet-Ezela",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "tamo nećete zaklon naći.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Dobro čeka zabrinuta stanovnica marotska,",
            "poem": 1
          },
          {
            "text": "jer je sišlo od Gospoda zlo na vrata Jerusalima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "U bojna kola upregni konje,",
            "poem": 1
          },
          {
            "text": "stanovnice Lahisa,",
            "poem": 2
          },
          {
            "text": "jer si početak greha ćerko sionska.",
            "poem": 1
          },
          {
            "text": "U tebi su se našli prestupi Izrailja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Zato ćeš dati darove Moreset-Gatu,",
            "poem": 1
          },
          {
            "text": "a kuće ahzivske izneveriće careve Izrailja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ipak ću ti dovesti osvajača,",
            "poem": 1
          },
          {
            "text": "stanovnice mariska,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a do Odolama će doći slava Izrailja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Oćelavi i kosu ošišaj",
            "poem": 1
          },
          {
            "text": "za decom svojom milom.",
            "poem": 2
          },
          {
            "text": "Raširi ćelu svoju kao lešinar,",
            "poem": 1
          },
          {
            "text": "jer će od tebe otići u izgnanstvo.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
