  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "heading",
        "content": [
          "Gora Gospodnja"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Dogodiće se u poslednje dane",
          {
            "text": "i gora Doma Gospodnjeg",
            "poem": 1
          },
          {
            "text": "biće postavljena vrh gora,",
            "poem": 2
          },
          {
            "text": "i uzvišena iznad bregova.",
            "poem": 1
          },
          {
            "text": "Puci prema njoj će se sticati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Mnogi narodi će hodati i govoriti:",
          {
            "text": "„Hajde, popnimo se na goru Gospodnju",
            "poem": 1
          },
          {
            "text": "i u Dom Boga Jakovljeva,",
            "poem": 2
          },
          {
            "text": "te da nas on nauči putevima svojim,",
            "poem": 1
          },
          {
            "text": "i da mi hodamo stazama njegovim.“",
            "poem": 2
          },
          {
            "text": "Jer će poučenje izaći sa Siona,",
            "poem": 1
          },
          {
            "text": "i reč Gospodnja iz Jerusalima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Pa će on biti sudija među mnogim narodima,",
            "poem": 1
          },
          {
            "text": "i on će biti merodavan za narode moćne i daleke;",
            "poem": 2
          },
          {
            "text": "te će oni mačeve prekovati u raonike,",
            "poem": 1
          },
          {
            "text": "a koplja u srpove.",
            "poem": 2
          },
          {
            "text": "Neće više narod protiv naroda podizati mačeve,",
            "poem": 1
          },
          {
            "text": "niti će se više učiti ratovanju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Svako će da prebiva pod svojom lozom",
            "poem": 1
          },
          {
            "text": "i pod svojom smokvom,",
            "poem": 2
          },
          {
            "text": "a neće biti nikog da ih plaši,",
            "poem": 1
          },
          {
            "text": "jer su tako kazala usta Gospoda nad vojskama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Jer svi će narodi hoditi,",
            "poem": 1
          },
          {
            "text": "svako u ime svoga boga,",
            "poem": 2
          },
          {
            "text": "a mi ćemo hoditi u ime Gospoda,",
            "poem": 1
          },
          {
            "text": "našeg Boga u veke vekova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Naum Gospodnji"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "„Toga dana – govori Gospod –",
            "poem": 1
          },
          {
            "text": "okupiću hrome,",
            "poem": 2
          },
          {
            "text": "sabraću proterane",
            "poem": 1
          },
          {
            "text": "kojima sam naudio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Od hromih ću načiniti ostatak",
            "poem": 1
          },
          {
            "text": "i od proteranih narod moćan.",
            "poem": 2
          },
          {
            "text": "I Gospod će nad njima da vlada",
            "poem": 1
          },
          {
            "text": "na gori Sion od sad pa doveka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "A ti, o, kulo stada,",
            "poem": 1
          },
          {
            "text": "uporište ćerke sionske,",
            "poem": 2
          },
          {
            "text": "tebi će doći i stići ti vlast,",
            "poem": 1
          },
          {
            "text": "pređašnje carstvo ćerke Jerusalima.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Zašto sada tako jako vičeš?",
            "poem": 1
          },
          {
            "text": "Zar u tebi nema cara?",
            "poem": 2
          },
          {
            "text": "Jesu li ti propali savetnici",
            "poem": 1
          },
          {
            "text": "pa te je obuzeo bol kao porodilju?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Savij se i napni, o, ćerko sionska,",
            "poem": 1
          },
          {
            "text": "kao porodilja,",
            "poem": 2
          },
          {
            "text": "jer ćeš sada izaći iz grada",
            "poem": 1
          },
          {
            "text": "i živećeš na polju.",
            "poem": 2
          },
          {
            "text": "Otići ćeš u Vavilon",
            "poem": 1
          },
          {
            "text": "i tamo će te izbaviti,",
            "poem": 2
          },
          {
            "text": "tamo će te otkupiti Gospod",
            "poem": 1
          },
          {
            "text": "iz ruku tvojih neprijatelja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "A sada su se protiv tebe",
            "poem": 1
          },
          {
            "text": "okupili narodi mnogi,",
            "poem": 2
          },
          {
            "text": "koji govore: „Oskrnavimo je!",
            "poem": 1
          },
          {
            "text": "I nek nam se oči naslađuju Sionom.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ali oni ne znaju naume Gospodnje",
            "poem": 1
          },
          {
            "text": "i njegove odluke ne shvataju,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer on ih sakuplja ko snoplje po gumnu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "„Ustani i vrši, o, ćerko sionska!",
            "poem": 1
          },
          {
            "text": "Načiniću ti gvozdeni rog",
            "poem": 2
          },
          {
            "text": "i bronzana kopita",
            "poem": 1
          },
          {
            "text": "da smrviš narode mnoge.“",
            "poem": 2
          },
          {
            "text": "Gospodu ćeš da posvetiš njihovu otimačinu,",
            "poem": 1
          },
          {
            "text": "i njihovo blago Gospodu sve zemlje.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
