  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "heading",
        "content": [
          "Obećani Vladar iz Vitlejema"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "A sada se u čete saberi, o, ti, ćerko čete!",
            "poem": 1
          },
          {
            "text": "Opsadu je protiv nas digao,",
            "poem": 2
          },
          {
            "text": "palicom udaraju po obrazu",
            "poem": 1
          },
          {
            "text": "sudiju Izrailja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„A ti, Vitlejeme Efrato,",
            "poem": 1
          },
          {
            "text": "premda si malen među hiljadama Jude,",
            "poem": 2
          },
          {
            "text": "iz tebe će mi izaći Vladar Izrailja,",
            "poem": 1
          },
          {
            "text": "a poreklo mu je od davnina,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "od večnosti.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Zato će ih predati",
            "poem": 1
          },
          {
            "text": "dok ne bude vreme da rodi ona što će da rodi,",
            "poem": 2
          },
          {
            "text": "a ostatak braće njegove će se vratiti",
            "poem": 1
          },
          {
            "text": "deci Izrailja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "I on će stajati i napasaće ih",
          {
            "text": "u sili Gospodnjoj",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i u slavi imena Gospoda, Boga svoga.",
            "poem": 2
          },
          {
            "text": "A oni će da počivaju, jer će se on tada veličati",
            "poem": 1
          },
          {
            "text": "do krajeva gde zemlja prestaje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "On će biti taj mir,",
            "poem": 1
          },
          {
            "text": "kad Asirac dođe u našu zemlju",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i stupi u dvorove naše.",
            "poem": 2
          },
          {
            "text": "A mi ćemo ustati protiv njega",
            "poem": 1
          },
          {
            "text": "sa sedam pastira i osam narodnih knezova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Oni će mačem potući zemlju asirsku",
            "poem": 1
          },
          {
            "text": "i zemlju Nevrodovu na vratima njegovim;",
            "poem": 2
          },
          {
            "text": "a on će da nas izbavi od Asirca",
            "poem": 1
          },
          {
            "text": "koji će doći u našu zemlju",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i zgaziće među našu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Jakovljev ostatak će biti među mnogim narodima",
            "poem": 1
          },
          {
            "text": "kao rosa Gospodnja,",
            "poem": 2
          },
          {
            "text": "kao sitna kiša po travi",
            "poem": 1
          },
          {
            "text": "što za čoveka ne mari",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i ne čeka nikoga od ljudi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Jakovljev ostatak će biti među mnogim narodima,",
            "poem": 1
          },
          {
            "text": "usred mnoštva ljudi",
            "poem": 2
          },
          {
            "text": "kao lav među šumskim zverima;",
            "poem": 1
          },
          {
            "text": "kao lavić među stadima ovaca.",
            "poem": 2
          },
          {
            "text": "A prođe li, satrće i rastrgnuti,",
            "poem": 1
          },
          {
            "text": "a nikoga da izbavi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Nek se digne ruka tvoja na neprijatelje tvoje!",
            "poem": 1
          },
          {
            "text": "Neka se istrebe svi dušmani tvoji!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "„I toga ću dana – govori Gospod –",
          {
            "text": "da potamanim tvoje konje iz tvoje sredine",
            "poem": 1
          },
          {
            "text": "i izlomim tvoja bojna kola!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Gradove tvoje zemlje ću da srušim",
            "poem": 1
          },
          {
            "text": "i sva utvrđenja tvoja ću da razorim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Istrebiću vračanje ruku tvojih",
            "poem": 1
          },
          {
            "text": "i ostaćeš bez gatara!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Izlomiću tvoje kipove",
            "poem": 1
          },
          {
            "text": "i svete stubove u tvojoj sredini,",
            "poem": 2
          },
          {
            "text": "pa se više nećeš klanjati",
            "poem": 1
          },
          {
            "text": "svojoj rukotvorini.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Izvaliću Aštartine stupove iz tvoje sredine",
            "poem": 1
          },
          {
            "text": "i tvoje ću gradove da porušim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "U gnevu i jarosti ću se osvetiti",
            "poem": 1
          },
          {
            "text": "ovim neposlušnim narodima.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
