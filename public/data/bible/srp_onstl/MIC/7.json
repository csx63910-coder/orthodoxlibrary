  "chapter": {
    "number": 7,
    "content": [
      {
        "type": "heading",
        "content": [
          "Nesreća Izrailja"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Jadan li sam!",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ja sam kao oni koji beru letnje voće",
            "poem": 1
          },
          {
            "text": "i pabirče grožđe,",
            "poem": 2
          },
          {
            "text": "a nema grozdova za jelo,",
            "poem": 1
          },
          {
            "text": "i nema ranih smokava za kojima mi duša žudi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Nestalo je vernika iz zemlje",
            "poem": 1
          },
          {
            "text": "i pravednika među ljudima nema.",
            "poem": 2
          },
          {
            "text": "Svako vreba krv da lije,",
            "poem": 1
          },
          {
            "text": "svako mrežom lovi brata svoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Rukama su vešti u zlu.",
            "poem": 1
          },
          {
            "text": "Glavar zahteva, sudija mito traži,",
            "poem": 2
          },
          {
            "text": "velikaš kazuje svoje prohteve",
            "poem": 1
          },
          {
            "text": "i zajedno spletkare.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Njihov je najbolji čovek poput trna,",
            "poem": 1
          },
          {
            "text": "a pravednik gori od trnovog žbuna.",
            "poem": 2
          },
          {
            "text": "Stiže ti tvoja kazna,",
            "poem": 1
          },
          {
            "text": "dan što ti je najavljen,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i sada će nastati njihova pometnja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Drugu ne veruj",
            "poem": 1
          },
          {
            "text": "i u prijatelja se ne pouzdaj.",
            "poem": 2
          },
          {
            "text": "Usta svoja ne otvaraj",
            "poem": 1
          },
          {
            "text": "ni pred onom u naručju svome.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Sin prezire oca,",
            "poem": 1
          },
          {
            "text": "ćerka se diže na majku svoju",
            "poem": 2
          },
          {
            "text": "i snaha na svekrvu svoju.",
            "poem": 1
          },
          {
            "text": "Čoveku će njegovi ukućani postati neprijatelji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "A ja Gospoda iščekujem,",
            "poem": 1
          },
          {
            "text": "čekam Boga mog spasenja!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Uslišiće mene Bog moj!",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Izrailj će se uzdignuti"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ne raduj se nada mnom, o, neprijateljice moja!",
            "poem": 1
          },
          {
            "text": "Jer, ako sam i pao, ustaću;",
            "poem": 2
          },
          {
            "text": "ako i u tami sedim,",
            "poem": 1
          },
          {
            "text": "Gospod mi je svetlost!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Gospodnju ću jarost da podnosim –",
            "poem": 1
          },
          {
            "text": "jer sam mu zgrešio –",
            "poem": 2
          },
          {
            "text": "dok moj slučaj ne odbrani",
            "poem": 1
          },
          {
            "text": "i parnicu moju pravedno ne reši.",
            "poem": 2
          },
          {
            "text": "Izvešće me on na svetlost",
            "poem": 1
          },
          {
            "text": "i ja ću gledati pravednost njegovu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Videće to moja neprijateljica",
            "poem": 1
          },
          {
            "text": "i sramota će pokriti onu što me pita:",
            "poem": 2
          },
          {
            "text": "„Gde je Gospod, tvoj Bog?“",
            "poem": 1
          },
          {
            "text": "A ja ću je posmatrati,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer će tada postati blato po drumu gaženo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "To je dan gradnje tvojih zidova,",
            "poem": 1
          },
          {
            "text": "toga dana će se tvoja međa proširiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Toga će ti dana dolaziti",
            "poem": 1
          },
          {
            "text": "od Asirije do gradova Egipta;",
            "poem": 2
          },
          {
            "text": "i od Egipta do reke Eufrat;",
            "poem": 1
          },
          {
            "text": "od mora do mora",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i od gore do gore.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "I zemlja će se pretvoriti u pustoš",
            "poem": 1
          },
          {
            "text": "zbog njenih stanovnika,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "zbog ploda dela njihovih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Molitva i slavopoj"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Palicom svojom napasaj svoj narod,",
            "poem": 1
          },
          {
            "text": "stado svog nasledstva",
            "poem": 2
          },
          {
            "text": "što prebiva sâmo u čestaru,",
            "poem": 1
          },
          {
            "text": "usred voćnjaka.",
            "poem": 2
          },
          {
            "text": "Napasaj ih po Vasanu i Galadu",
            "poem": 1
          },
          {
            "text": "kao u starim vremenima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "„Kao u danima tvog izlaska iz egipatske zemlje",
            "poem": 1
          },
          {
            "text": "pokazaću vam čudesa.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Narodi će gledati",
            "poem": 1
          },
          {
            "text": "i zastideće se sve svoje snage.",
            "poem": 2
          },
          {
            "text": "Zatvoriće usta svoja",
            "poem": 1
          },
          {
            "text": "i uši će im zagluveti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Lizaće prašinu poput zmije,",
            "poem": 1
          },
          {
            "text": "poput gmizavaca zemaljskih trešće se puzeći iz svojih utvrda.",
            "poem": 2
          },
          {
            "text": "Zbog Gospoda, našeg Boga,",
            "poem": 1
          },
          {
            "text": "prestravljeni biće",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i plašiće te se.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ko je Bog tebi nalik,",
            "poem": 1
          },
          {
            "text": "što krivice prašta",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i prelazi preko greha ostatka svog nasledstva?",
            "poem": 2
          },
          {
            "text": "Ne srdi se doveka",
            "poem": 1
          },
          {
            "text": "već uživa u milosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Opet će se smilovati na nas",
            "poem": 1
          },
          {
            "text": "i zgaziti naše krivice.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Da, ti ćeš baciti u dubine mora sve grehe njihove.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Pokazaćeš istinu Jakovu",
            "poem": 1
          },
          {
            "text": "i milost Avrahamu",
            "poem": 2
          },
          {
            "text": "kako si se od davnina",
            "poem": 1
          },
          {
            "text": "zakleo našim ocima.",
            "poem": 2
          }
        ]
      }
    ],
