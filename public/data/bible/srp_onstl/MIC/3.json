  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "heading",
        "content": [
          "Prekor vođama i prorocima"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Zato sam rekao:",
          {
            "text": "„Čujte, o, Jakova glavari",
            "poem": 1
          },
          {
            "text": "i vojvode doma Izrailjevog!",
            "poem": 2
          },
          {
            "text": "Nije li na vama da znate šta je pravda?",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "A vi mrzite dobro i volite zlo!",
            "poem": 2
          },
          {
            "text": "Kožu sa njih gulite",
            "poem": 1
          },
          {
            "text": "i meso sa njihovih kostiju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jedete meso mog naroda",
            "poem": 1
          },
          {
            "text": "i kožu sa njih derete;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "lomite im kosti na komade;",
            "poem": 2
          },
          {
            "text": "kasapite ih kao za lonac,",
            "poem": 1
          },
          {
            "text": "kao meso usred tiganja.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Tada će oni Gospodu da zavape,",
            "poem": 1
          },
          {
            "text": "a on im se odazvati neće.",
            "poem": 2
          },
          {
            "text": "Sakriće od njih lice svoje u ono vreme,",
            "poem": 1
          },
          {
            "text": "jer su počinili zlodela.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "„Ovako kaže Gospod",
          {
            "text": "protiv proroka koji zavode moj narod,",
            "poem": 1
          },
          {
            "text": "koji grizu zubima i objavljuju mir,",
            "poem": 2
          },
          {
            "text": "a rat najavljuju onome",
            "poem": 1
          },
          {
            "text": "ko im u usta ništa ne stavlja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Zato će vam noć pasti bez viđenja",
            "poem": 1
          },
          {
            "text": "i tama će vas obaviti bez gatanja;",
            "poem": 2
          },
          {
            "text": "sunce će nad prorocima zaći",
            "poem": 1
          },
          {
            "text": "i biće onog dana mrak nad njima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "I posramiće se videoci,",
            "poem": 1
          },
          {
            "text": "i zastideće se gatari.",
            "poem": 2
          },
          {
            "text": "Zatvoriće usta svoja svi do jednog",
            "poem": 1
          },
          {
            "text": "jer nema Božijeg odgovora.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "A ja sam pun snage Gospodnjeg Duha,",
            "poem": 1
          },
          {
            "text": "pravde i sile,",
            "poem": 2
          },
          {
            "text": "da objavim Jakovu prestup njegov",
            "poem": 1
          },
          {
            "text": "i Izrailju njegov greh.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Čujte, o, glavari Jakovljevog doma",
            "poem": 1
          },
          {
            "text": "i vojvode doma Izrailjevog,",
            "poem": 2
          },
          {
            "text": "vi što se gadite na pravdu",
            "poem": 1
          },
          {
            "text": "i izvrćete sve što je pravo;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "koji krvlju Sion gradite",
            "poem": 1
          },
          {
            "text": "i Jerusalim nepravdom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Njegovi glavari za mito sude,",
            "poem": 1
          },
          {
            "text": "za platu sveštenici njegovi uče.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Proroci gataju za srebro,",
            "poem": 2
          },
          {
            "text": "a na Gospoda se pozivaju govoreći:",
            "poem": 1
          },
          {
            "text": "„Nije li Gospod među nama?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Neće nas zlo zadesiti!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Zato će zbog vas",
            "poem": 1
          },
          {
            "text": "preoran biti Sion,",
            "poem": 2
          },
          {
            "text": "Jerusalim u ruševine pretvoren,",
            "poem": 1
          },
          {
            "text": "a brdo ovog Doma u zaraslu šumu.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
