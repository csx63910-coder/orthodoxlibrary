  "chapter": {
    "number": 6,
    "content": [
      {
        "type": "heading",
        "content": [
          "Gospodnja parnica protiv Izrailja"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Čujte sada šta govori Gospod:",
          {
            "text": "„Ustani, sa gorama se parniči.",
            "poem": 1
          },
          {
            "text": "Glas tvoj neka čuju brda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "O, brda i čvrsti temelji zemljini,",
            "poem": 1
          },
          {
            "text": "čujte Gospodnji slučaj!",
            "poem": 2
          },
          {
            "text": "Jer, Gospod se sudi sa svojim narodom",
            "poem": 1
          },
          {
            "text": "i sa Izrailjem se spori.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Šta sam ti uradio, narode moj?",
            "poem": 1
          },
          {
            "text": "Čime sam ti dojadio, odgovori mi?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Pa ja sam te izveo iz egipatske zemlje,",
            "poem": 1
          },
          {
            "text": "iz kuće ropstva sam te otkupio",
            "poem": 2
          },
          {
            "text": "i pred tobom poslao Mojsija,",
            "poem": 1
          },
          {
            "text": "Arona i Mariju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Seti se, molim te, narode moj,",
            "poem": 1
          },
          {
            "text": "šta je naumio moavski car Valak",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i šta mu je govorio Valam, sin Veorov,",
            "poem": 2
          },
          {
            "text": "šta se zbilo od Sitima do Galgala,",
            "poem": 1
          },
          {
            "text": "da biste shvatili Gospodnju pravednost.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Kako ću Gospodu da pristupim,",
            "poem": 1
          },
          {
            "text": "savijen ničice pred uzvišenim Bogom?",
            "poem": 2
          },
          {
            "text": "Da mu pristupim sa svespalnicama",
            "poem": 1
          },
          {
            "text": "i teladima od godinu dana?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Hoće li Gospod biti zadovoljan sa hiljadama ovnova,",
            "poem": 1
          },
          {
            "text": "sa desetinom hiljada potoka ulja?",
            "poem": 2
          },
          {
            "text": "Da li da prvenca dam za svoje prestupe,",
            "poem": 1
          },
          {
            "text": "plod utrobe svoje za greh duše moje?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Objavio ti je Gospod, o, čoveče, šta je dobro",
            "poem": 1
          },
          {
            "text": "i šta traži od tebe:",
            "poem": 2
          },
          {
            "text": "samo da činiš pravdu, voliš milosrđe",
            "poem": 1
          },
          {
            "text": "i pokorno hodaš sa svojim Bogom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Krivica i kazna Izrailja"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Glas Gospodnji viče gradu",
            "poem": 1
          },
          {
            "text": "i ko je mudar bojaće se imena tvoga.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Slušajte žezlo moći i onoga ko ga je ovlastio!",
            "poem": 2
          },
          {
            "noteId": 0
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ima li u kući nepoštenog još uvek nepoštenog blaga",
            "poem": 1
          },
          {
            "text": "i proklete nepoštene mere?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Zar ću da budem čist sa nepoštenim terazijama",
            "poem": 1
          },
          {
            "text": "i sa torbom netačnih tegova?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Jer su njihovi bogataši puni nasilja,",
            "poem": 1
          },
          {
            "text": "njegovi stanovnici govore prevaru,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "lažljiv im je jezik u ustima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "I još ću te razboleti udarajući te,",
            "poem": 1
          },
          {
            "text": "zbog greha ću te pustošiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ješćeš, a sit nećeš biti.",
            "poem": 1
          },
          {
            "text": "Bićeš prazan u nutrini svojoj.",
            "poem": 2
          },
          {
            "text": "Sklanjaćeš, a nećeš osigurati.",
            "poem": 1
          },
          {
            "text": "A ja ću mač poslati na ono što si osigurao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Sejaćeš, ali nećeš žeti,",
            "poem": 1
          },
          {
            "text": "gazićeš masline i grožđe,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ali se uljem nećeš mazati i vino nećeš piti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Držiš Amrijeve uredbe",
            "poem": 1
          },
          {
            "text": "i sva dela Ahavovog doma.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ideš po njihovim savetima",
            "poem": 2
          },
          {
            "text": "i zato sam te predao razaranju,",
            "poem": 1
          },
          {
            "text": "a tvoj živalj će podneti ruglo",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i pogrdu mog naroda.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 0,
        "caller": "+",
        "text": "6,9 Ovaj deo stiha može i ovako da se prevede: Slušaj, pleme (Judino)! Ko je onaj što ga je ustanovio (grad)?",
        "reference": {
          "chapter": 6,
          "verse": 9
        }
      }
    ]
