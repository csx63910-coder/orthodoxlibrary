  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "heading",
        "content": [
          "Jao Ninivi"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Jao gradu krvoločnom!",
            "poem": 1
          },
          {
            "text": "Pun je obmane,",
            "poem": 2
          },
          {
            "text": "pun je otimačine,",
            "poem": 1
          },
          {
            "text": "u njemu plena nema da nema.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Fijuče bič",
            "poem": 1
          },
          {
            "text": "i tutnje točkovi,",
            "poem": 2
          },
          {
            "text": "konji su u galopu,",
            "poem": 1
          },
          {
            "text": "a bojna kola poskakuju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Konjanici jure",
            "poem": 1
          },
          {
            "text": "dok mač seva",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i koplje blešti.",
            "poem": 2
          },
          {
            "text": "Eno mnoštva poklanih,",
            "poem": 1
          },
          {
            "text": "nema mere težini leševa,",
            "poem": 2
          },
          {
            "text": "pobijenima nema broja",
            "poem": 1
          },
          {
            "text": "i ljudi se o mrtve sapliću.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "A to je zbog mnogih bludništava bludnice,",
            "poem": 1
          },
          {
            "text": "zanosne i vešte u vračanju,",
            "poem": 2
          },
          {
            "text": "koja prodaje narode svojim bludničenjem",
            "poem": 1
          },
          {
            "text": "i plemena svojim vračanjima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "„Evo me protiv tebe – govori Gospod nad vojskama –",
            "poem": 1
          },
          {
            "text": "da ti preko lica zadignem skutove,",
            "poem": 2
          },
          {
            "text": "da narodima pokažem tvoju golotinju",
            "poem": 1
          },
          {
            "text": "i carstvima tvoju sramotu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Gadosti ću baciti na vas,",
            "poem": 1
          },
          {
            "text": "prezreću vas",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i učiniti prizorom u koji se zuri.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Pobeći će od tebe svi koji te budu gledali.",
            "poem": 1
          },
          {
            "text": "Reći će: ’Opustošena je Niniva!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ko će da je požali?’",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Gde da ti nađem utešitelje?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Zar si ti bolja od No-Amona",
            "poem": 1
          },
          {
            "text": "što prebiva na vodama Nila,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "okružen vodama,",
            "poem": 2
          },
          {
            "text": "kome je more bilo bedem",
            "poem": 1
          },
          {
            "text": "i kome su more zidine bile.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Kuš mu je bio snaga, Egipat kome kraja nije bilo,",
            "poem": 1
          },
          {
            "text": "a Futi i Luvimani su mu pomagali.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ipak je otišla u izgnanstvo, u ropstvo.",
            "poem": 1
          },
          {
            "text": "A i decu su joj smrskali",
            "poem": 2
          },
          {
            "text": "po uglovima svih ulica.",
            "poem": 3
          },
          {
            "text": "Za njihove su plemiće bacali žreb,",
            "poem": 1
          },
          {
            "text": "velikaše su im okovali lancima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "I još ćeš biti pijana i sakrivena,",
            "poem": 1
          },
          {
            "text": "tražićeš zaklon pred neprijateljem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Sva utvrđenja tvoja su smokve",
            "poem": 1
          },
          {
            "text": "sa prvim zrelim plodovima koji,",
            "poem": 2
          },
          {
            "text": "protresu li se,",
            "poem": 1
          },
          {
            "text": "padaju u usta onog ko bi da ih jede.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Evo, tvoj je narod",
            "poem": 1
          },
          {
            "text": "poput žena usred tebe.",
            "poem": 2
          },
          {
            "text": "Vrata tvoje zemlje će se širom otvoriti neprijateljima tvojim.",
            "poem": 1
          },
          {
            "text": "Tvoje će rešetke vatra da proguta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Nahvataj sebi vode za opsadu!",
            "poem": 1
          },
          {
            "text": "Ojačaj svoja utvrđenja!",
            "poem": 2
          },
          {
            "text": "Idi, gacaj u glini,",
            "poem": 1
          },
          {
            "text": "pravi cigle u kalupima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Tamo će te vatra progutati,",
            "poem": 1
          },
          {
            "text": "mač će te saseći,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "proždraće te kao skakavac.",
            "poem": 2
          },
          {
            "text": "Namnoži se poput skakavaca!",
            "poem": 1
          },
          {
            "text": "Namnoži se poput gusenica!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Umnožila si svoje trgovce",
            "poem": 1
          },
          {
            "text": "da ih je više od zvezda na nebu,",
            "poem": 2
          },
          {
            "text": "a oni su skakavci što su se izlegli",
            "poem": 1
          },
          {
            "text": "i odleteli.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Tvoji stražari su kao gusenice,",
            "poem": 1
          },
          {
            "text": "tvoje vojskovođe kao roj skakavaca",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "što se roje na zidinama po hladnom danu.",
            "poem": 2
          },
          {
            "text": "A kada sunce grane, oni odlete",
            "poem": 1
          },
          {
            "text": "i ne zna se mesto na kome su?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Pospani su tvoji pastiri, o, care asirski!",
            "poem": 1
          },
          {
            "text": "Dvorani tvoji dremaju,",
            "poem": 2
          },
          {
            "text": "tvoj je narod raštrkan po gorama",
            "poem": 1
          },
          {
            "text": "i nema ko da ih okupi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Stradanju tvome nema leka.",
            "poem": 1
          },
          {
            "text": "Opaka je tvoja rana.",
            "poem": 2
          },
          {
            "text": "Svi koji čuju vest o tebi",
            "poem": 1
          },
          {
            "text": "pljeskaju dlanovima nad tobom,",
            "poem": 2
          },
          {
            "text": "jer koga nije zahvatila",
            "poem": 1
          },
          {
            "text": "tvoja istrajna zloba?",
            "poem": 2
          }
        ]
      }
    ],
