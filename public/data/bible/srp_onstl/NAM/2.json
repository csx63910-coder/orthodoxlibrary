    "name": "Knjiga proroka Nauma",
    "commonName": "Knjiga proroka Nauma",
    "title": "Knjiga proroka Nauma",
    "order": 34,
    "numberOfChapters": 3,
    "sha256": "9116013e4b0a7f707bec7d3146435b3ca7298843a0813bb5de65eca36b249d16",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/NAM/1.json",
    "lastChapterNumber": 3,
    "lastChapterApiLink": "/api/srp_onstl/NAM/3.json",
    "totalNumberOfVerses": 47
  },
  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "heading",
        "content": [
          "Niniva će pasti"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Pred tebe je stao onaj što te rasejava!",
            "poem": 1
          },
          {
            "text": "Čuvaj utvrđenje,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pazi na put,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "učvrsti bedra,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "okrepi sasvim svoju snagu!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Jer, Gospod će da obnovi Jakovljev ponos",
            "poem": 1
          },
          {
            "text": "kao slavu Izrailja,",
            "poem": 2
          },
          {
            "text": "premda su ih opustošili dušmani",
            "poem": 1
          },
          {
            "text": "i posekli im loze.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Crven je štit ratnika njegovih,",
            "poem": 1
          },
          {
            "text": "junaci su obučeni u skerlet,",
            "poem": 2
          },
          {
            "text": "sijaju metalni okovi bojnih kola,",
            "poem": 1
          },
          {
            "text": "a u danu kad se spremi",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i čempresi se tresu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Po ulicama mahnitaju bojna kola,",
            "poem": 1
          },
          {
            "text": "vršljaju po trgovima,",
            "poem": 2
          },
          {
            "text": "izgledaju kao baklje,",
            "poem": 1
          },
          {
            "text": "galopiraju kao munje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Setiće se svojih vojskovođa",
            "poem": 1
          },
          {
            "text": "koji će se spoticati na svojim marševima,",
            "poem": 2
          },
          {
            "text": "žuriti njenim zidinama",
            "poem": 1
          },
          {
            "text": "i već spremnoj barikadi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ustave će se otvoriti",
            "poem": 1
          },
          {
            "text": "i dvor će se podlokati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Tako je urađeno:",
            "poem": 1
          },
          {
            "text": "razotkrivena je i odvedena.",
            "poem": 2
          },
          {
            "text": "Njene sluškinje zapevaju,",
            "poem": 1
          },
          {
            "text": "pijuču kao golubice, u prsa se tuku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Kao jezero je Niniva još od prvih dana,",
            "poem": 1
          },
          {
            "text": "ali oni sada beže.",
            "poem": 2
          },
          {
            "text": "„Stanite! Stanite!“",
            "poem": 1
          },
          {
            "text": "Ali niko se okrenuo nije.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Otimajte srebro!",
            "poem": 1
          },
          {
            "text": "Otimajte zlato!",
            "poem": 2
          },
          {
            "text": "Nema mere zalihama",
            "poem": 1
          },
          {
            "text": "i obilju svake dragocene stvari.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Opustelo, poharano i ojađeno!",
            "poem": 1
          },
          {
            "text": "Tope se srca, klecaju kolena i bedra sva,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "svima su smrknuta lica.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Gde je lavlja jazbina,",
            "poem": 1
          },
          {
            "text": "gde brlog za laviće?",
            "poem": 2
          },
          {
            "text": "Gde su išli lav, lavica i mladunče,",
            "poem": 1
          },
          {
            "text": "a da ih niko plašio nije?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Lav je lovio dovoljno za mladunce,",
            "poem": 1
          },
          {
            "text": "davio plen za svoje lavice,",
            "poem": 2
          },
          {
            "text": "svoju pećinu punio plenom",
            "poem": 1
          },
          {
            "text": "i svoj brlog mesom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "„Evo me protiv tebe",
            "poem": 1
          },
          {
            "text": "– govori Gospod nad vojskama –",
            "poem": 2
          },
          {
            "text": "da tvoja bojna kola pretvorim u dim.",
            "poem": 1
          },
          {
            "text": "Mač će da pojede laviće tvoje",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i tvoj ću plen da istrebim iz zemlje.",
            "poem": 2
          },
          {
            "text": "Povik glasnika tvojih",
            "poem": 1
          },
          {
            "text": "više se neće čuti.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
