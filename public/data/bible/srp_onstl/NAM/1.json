    "name": "Knjiga proroka Nauma",
    "commonName": "Knjiga proroka Nauma",
    "title": "Knjiga proroka Nauma",
    "order": 34,
    "numberOfChapters": 3,
    "sha256": "9116013e4b0a7f707bec7d3146435b3ca7298843a0813bb5de65eca36b249d16",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/NAM/1.json",
    "lastChapterNumber": 3,
    "lastChapterApiLink": "/api/srp_onstl/NAM/3.json",
    "totalNumberOfVerses": 47
  },
  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Proroštvo o Ninivi. Knjiga viđenja Nauma iz Elkoša."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Gospodnji gnev protiv Ninive"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Bog je ljubomoran i osvećuje se Gospod.",
            "poem": 1
          },
          {
            "text": "On je Gospod osvete i gospodar gneva.",
            "poem": 2
          },
          {
            "text": "Gospod se sveti svojim dušmanima",
            "poem": 1
          },
          {
            "text": "i gaji gnev prema svojim neprijateljima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Gospod se sporo gnevi, velike je sile,",
            "poem": 1
          },
          {
            "text": "ali krivca nipošto ne ostavlja nekažnjena.",
            "poem": 2
          },
          {
            "text": "U olujnom vetru, u vihoru put je njegov",
            "poem": 1
          },
          {
            "text": "i oblak mu je prašina pod nogama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Kad more prekori, on ga isušuje",
            "poem": 1
          },
          {
            "text": "i sve reke čini suvim.",
            "poem": 2
          },
          {
            "text": "Venu Vasan i Karmil,",
            "poem": 1
          },
          {
            "text": "vene cvat Livana.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Zbog njega se gore tresu,",
            "poem": 1
          },
          {
            "text": "a bregovi rastaču.",
            "poem": 2
          },
          {
            "text": "Zemlja se pred njim podiže",
            "poem": 1
          },
          {
            "text": "i sav svet i svi koji na njemu žive.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ko da stoji pred gnevom njegovim?",
            "poem": 1
          },
          {
            "text": "Ko da izdrži plamen srdnje njegove?",
            "poem": 2
          },
          {
            "text": "Jer gnev se njegov izlio kao lava",
            "poem": 1
          },
          {
            "text": "i stene se pred njim drobe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Gospod je dobar,",
            "poem": 1
          },
          {
            "text": "zaštita je u danu nevolje",
            "poem": 2
          },
          {
            "text": "i poznaje one što u njemu utočište traže.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "On će silnom poplavom",
            "poem": 2
          },
          {
            "text": "da dokrajči Ninivu,",
            "poem": 1
          },
          {
            "text": "a svoje će dušmane u mrak da odagna.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Šta god da spletkarite protiv Gospoda,",
            "poem": 1
          },
          {
            "text": "on će to da dokrajči.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Nevolja se neće podignuti dvaput.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Neka su i kao trnje spleteni",
            "poem": 1
          },
          {
            "text": "i kao pijani od svog pića,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "progutani biće sasvim ko strnjika suva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Od tebe će doći onaj",
            "poem": 1
          },
          {
            "text": "koji spletkari zlo protiv Gospoda,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "opaki savetnik.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ovako kaže Gospod:",
          {
            "text": "„Iako su Asirci i složni i iako brojni,",
            "poem": 1
          },
          {
            "text": "i takvi biće sasečeni i izgaženi.",
            "poem": 2
          },
          {
            "text": "A ja sam te tlačio, narode moj,",
            "poem": 1
          },
          {
            "text": "ali te više tlačiti neću.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Evo, sada ću da skršim njegov jaram na tebi,",
            "poem": 1
          },
          {
            "text": "izlomiću tvoje okove.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Gospod je zapovedio protiv tebe:",
            "poem": 1
          },
          {
            "text": "„Tvoje ime neće imati potomke.",
            "poem": 2
          },
          {
            "text": "Iz kuće tvojih bogova",
            "poem": 1
          },
          {
            "text": "srušiću kipove i livene idole.",
            "poem": 2
          },
          {
            "text": "Grob ti spremam",
            "poem": 1
          },
          {
            "text": "jer si bezvredan.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Evo, na gorama su noge blagovesnika",
            "poem": 1
          },
          {
            "text": "koji mir objavljuje!",
            "poem": 2
          },
          {
            "text": "Proslavljaj, Judo, praznike svoje!",
            "poem": 1
          },
          {
            "text": "Ispuni svoje zavete",
            "poem": 2
          },
          {
            "text": "jer te više neće gaziti opaki.",
            "poem": 1
          },
          {
            "text": "Satrće se sasvim.",
            "poem": 2
          }
        ]
      }
    ],
