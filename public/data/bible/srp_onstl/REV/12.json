  "chapter": {
    "number": 12,
    "content": [
      {
        "type": "heading",
        "content": [
          "Žena i crvena Aždaja"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Pojavi se veliki znak na nebu: žena odevena u sunce; mesec je bio pod njenim nogama, a na njenoj glavi bio je venac od dvanaest zvezda."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Bila je trudna i vikala od porođajnih bolova i muka."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Zatim se pojavi drugi znak na nebu: ogromna crvena Aždaja sa sedam glava i deset rogova, i sa sedam kruna na svojim glavama."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Svojim repom ona povuče trećinu zvezda sa neba i baci ih na zemlju. Zatim stade pred ženu koja je trebalo da rodi, da proždere njeno dete – kad rodi."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Žena je rodila muško dete, koje će vladati svim narodima gvozdenom palicom. Ali dete bi uzeto k Bogu i njegovom prestolu."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Žena pobegne u pustinju, u sklonište koje je Bog pripremio za nju, da se brinu za nju hiljadu dve stotine šezdeset dana."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Onda nastane rat na nebu: Mihailo sa svojim anđelima zarati protiv Aždaje. Aždaja sa svojim anđelima stupi u rat,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ali su bili poraženi, te im više nije bilo mesta na nebesima."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Velika Aždaja je bila zbačena sa neba. On je ona Stara zmija, koja se zove „Đavo“ i „Satana“, koja dovodi u zabludu sav svet. I Aždaja i njeni anđeli s njom bili su bačeni na zemlju."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Zatim sam čuo snažan glas na nebu kako govori:",
          {
            "text": "„Sad je nastupilo spasenje, sila i Carstvo našega Boga",
            "poem": 1
          },
          {
            "text": "i vlast njegovog Hrista!",
            "poem": 2
          },
          {
            "text": "Jer zbačen je optužitelj naše braće,",
            "poem": 1
          },
          {
            "text": "koji ih optužuje pred našim Bogom dan i noć.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ali oni su ga pobedili Jagnjetovom krvlju",
            "poem": 1
          },
          {
            "text": "i rečju svoga svedočanstva;",
            "poem": 2
          },
          {
            "text": "i umesto ljubavi prema životu,",
            "poem": 1
          },
          {
            "text": "izabrali su smrt!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Radujte se, stoga,",
            "poem": 1
          },
          {
            "text": "nebesa i vi što živite na njima!",
            "poem": 2
          },
          {
            "text": "Ali teško zemlji i moru,",
            "poem": 1
          },
          {
            "text": "jer je đavo s velikim gnevom sišao k vama,",
            "poem": 2
          },
          {
            "text": "znajući da mu je ostalo još malo vremena.“",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Kad je Aždaja videla da je bačena na zemlju, poče da proganja ženu koja je rodila muško dete."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Njoj su data dva krila velikog orla da odleti u pustinju, u svoje sklonište, gde će biti zbrinuta i zaštićena od zmije tri i po godine."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Zmija iz svojih usta izbaci za ženom reku vode da je odnese,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ali ženi priteče u pomoć zemlja, koja otvori svoje ždrelo i popi reku što je Aždaja izbaci iz svojih usta."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Aždaja se razbesni na ženu, pa ode da zarati na njeno ostalo potomstvo, na one koji vrše Božije zapovesti i drže svedočanstvo za Isusa."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Aždaja stade na obalu mora."
        ]
      }
    ],
