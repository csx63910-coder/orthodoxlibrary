  "chapter": {
    "number": 18,
    "content": [
      {
        "type": "heading",
        "content": [
          "Pad Vavilona"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Posle ovoga sam video drugog anđela kako silazi sa neba sa velikom vlašću. Njegova slava obasjala je celu zemlju."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Tada anđeo povika jakim glasom:",
          {
            "text": "„Pade, pade, veliki Vavilon,",
            "poem": 1
          },
          {
            "text": "i postade prebivalište zlih duhova",
            "poem": 2
          },
          {
            "text": "i sklonište svih nečistih duhova,",
            "poem": 1
          },
          {
            "text": "sklonište svim nečistim pticama",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i svim nečistim i mrskim zverima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jer svi su se narodi napojili",
            "poem": 1
          },
          {
            "text": "žestokim vinom njenoga bludničenja.",
            "poem": 2
          },
          {
            "text": "Carevi sveta s njom su bludničili,",
            "poem": 1
          },
          {
            "text": "a svetski se trgovci obogatili od njene silne raskoši!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Zatim sam čuo drugi glas sa neba kako govori:",
          {
            "text": "„Narode moj, izađi iz tog grada,",
            "poem": 1
          },
          {
            "text": "da ne budete učesnici u njegovim gresima,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i da vas ne snađu njegova zla.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Jer gresi se njeni nagomilaše do neba,",
            "poem": 1
          },
          {
            "text": "i Bog se setio njenih nepravdi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Vratite joj istom merom,",
            "poem": 1
          },
          {
            "text": "vratite joj dvostruko više za njena dela;",
            "poem": 2
          },
          {
            "text": "ulijte joj u čašu dvostruku meru onog",
            "poem": 1
          },
          {
            "text": "što je zamešala drugima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Zadajte joj muke i žalosti",
            "poem": 1
          },
          {
            "text": "onoliko koliko je sebi dala slave i raskoši!",
            "poem": 2
          },
          {
            "text": "Jer ona govori u svome srcu:",
            "poem": 1
          },
          {
            "text": "’Sedim na prestolu kao carica,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "nisam udovica i žalosti neću iskusiti.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Zato će se u jedan dan sručiti na nju sva ova zla:",
            "poem": 1
          },
          {
            "text": "smrt, žalost i glad.",
            "poem": 2
          },
          {
            "text": "I proždreće je vatra,",
            "poem": 1
          },
          {
            "text": "jer je silan Gospod Bog koji joj sudi.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Za njom će plakati i naricati svi carevi sveta koji su s njom bludničili i uživali u njenoj raskoši, kada vide dim i nju svu u plamenu."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Preplašeni njenim mukama, stajaće izdaleka i govoriti:",
          {
            "text": "„Jao, jao, veliki grade Vavilone, silni grade,",
            "poem": 1
          },
          {
            "text": "jer u jedan čas nasta tvoj sud!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "A svetski će trgovci plakati i naricati za njom, jer niko više ne kupuje njihovu robu:"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "zlato, srebro, drago kamenje, bisere, tanani lan, porfiru, svilu, skerlet, razna mirisna drveta, svakovrsne posude od slonovače, predmete načinjene od skupocenog drveta, bronze, gvožđa i mramora;"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "cimet, balzam, miomiris, mirisava ulja, tamjan, vino, ulje, belo brašno, pšenicu, stoku, ovce i konje, kola, robove i ljudske duše."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Ostala si bez voća za kojim si čeznula, sva tvoja raskoš i sjaj propali su i više ih nećeš povratiti."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Trgovci koji su ovim trgovali i obogatili se od nje, stajaće izdaleka obuzeti strahom zbog njenih muka, plačući i naričući."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Govoriće:",
          {
            "text": "„Jao, jao, veliki grade,",
            "poem": 1
          },
          {
            "text": "koji si se oblačio u lan, porfiru i skerlet,",
            "poem": 2
          },
          {
            "text": "i kitio se zlatom, dragim kamenjem i biserima!",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "U jedan čas opuste toliko bogatstvo!“",
            "poem": 2
          },
          "I svi kormilari, svi mornari i moreplovci, stajali su izdaleka."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Videvši dim koji se podiže iz grada u požaru, jadikovali su i govorili: „Koji je grad bio kao ovaj veliki grad?“"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Oni posuše prašinu na svoje glave jadikujući i plačući:",
          {
            "text": "„Jao, jao, veliki grade!",
            "poem": 1
          },
          {
            "text": "Od njegovog izobilja se obogatiše",
            "poem": 2
          },
          {
            "text": "svi koji su imali brodove na moru,",
            "poem": 1
          },
          {
            "text": "a u jedan je čas opusteo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Veseli se nad njim, nebo!",
            "poem": 1
          },
          {
            "text": "Veselite se nad njim, vi sveti, apostoli i proroci,",
            "poem": 2
          },
          {
            "text": "jer ga je Bog kaznio zbog onog što je učinio vama!“",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Tada je jedan moćni anđeo podigao kamen, velik kao mlinski, i bacio ga u more, govoreći:",
          {
            "text": "„Ovako će biti bačen veliki grad Vavilon",
            "poem": 1
          },
          {
            "text": "i neće ga više biti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Muzika kitariste, muzičara, flautista i trubača",
            "poem": 1
          },
          {
            "text": "neće se više čuti u tebi,",
            "poem": 2
          },
          {
            "text": "niti će se koji umetnik više naći u tebi,",
            "poem": 1
          },
          {
            "text": "a ni zvuk mlina se neće više čuti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Svetlost svetiljke",
            "poem": 1
          },
          {
            "text": "neće više zasjati u tebi,",
            "poem": 2
          },
          {
            "text": "niti će se glas mladoženje i neveste",
            "poem": 1
          },
          {
            "text": "ikad čuti u tebi,",
            "poem": 2
          },
          {
            "text": "zato što su tvoji trgovci bili svetski moćnici,",
            "poem": 1
          },
          {
            "text": "i zato što je tvoje vračanje dovelo u zabludu sve narode.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Uz to se u tebi prolila krv proroka i svetih,",
            "poem": 1
          },
          {
            "text": "i svih onih koji su ubijeni na zemlji.“",
            "poem": 2
          }
        ]
      }
    ],
