  "chapter": {
    "number": 15,
    "content": [
      {
        "type": "heading",
        "content": [
          "Poslednjih sedam pošasti"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Zatim sam video drugi veliki i čudesni znak na nebu: sedam anđela sa sedam poslednjih zala, jer se sa njima završava Božiji gnev."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Video sam i nešto nalik moru od stakla, pomešanom s ognjem, i tamo one koji su pobedili Zver, njen kip i broj njenog imena. Stajali su pokraj mora od stakla sa kitarama koje im je Bog dao."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Pevali su pesmu Mojsija, sluge Božijeg, i Jagnjetovu pesmu:",
          {
            "text": "„Velika su i čudesna tvoja dela,",
            "poem": 1
          },
          {
            "text": "Gospode Bože, Svedržitelju;",
            "poem": 2
          },
          {
            "text": "pravedni su i istiniti tvoji putevi,",
            "poem": 1
          },
          {
            "text": "Care naroda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ko se ne bi bojao tebe",
            "poem": 1
          },
          {
            "text": "i slavio ime tvoje, Gospode?",
            "poem": 2
          },
          {
            "text": "Jer ti si jedini svet.",
            "poem": 1
          },
          {
            "text": "Zato će svi narodi doći k tebi",
            "poem": 2
          },
          {
            "text": "i pokloniti se pred tobom,",
            "poem": 1
          },
          {
            "text": "jer se pokazaše tvoja pravedna dela!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Posle ovoga sam video da se otvorio hram na nebu, to jest, Šator svedočanstva."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Iz hrama izađoše sedam anđela sa sedam zala, obučeni u čist i svetao lan, i opasani zlatnim pojasevima oko prsiju."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "A jedno od četiri živa bića dade sedmorici anđela sedam zlatnih zdela ispunjenih gnevom Boga koji živi od sad i doveka."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Tada se hram ispuni dimom od Božije slave i od njegove sile, tako da niko nije mogao ući u hram dok se nisu završila sedam zala sedmorice anđela."
        ]
      }
    ],
