  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "heading",
        "content": [
          "Đavo iskušava Isusa"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Tada je Duh odveo Isusa u pustinju, da ga đavo kuša."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Pošto je Isus postio četrdeset dana i četrdeset noći, napokon ogladne."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Kušač mu tada priđe i reče mu: „Ako si Sin Božiji, reci neka ovi kamenovi postanu hlebovi.“"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Isus mu odgovori:",
          {
            "text": "„Neće čovek živeti samo od hleba,",
            "poem": 1
          },
          {
            "text": "već od svake reči koja izlazi iz Božijih usta.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Onda ga je đavo odveo u Sveti grad, postavio ga na vrh hrama"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "i rekao mu: „Ako si Sin Božiji, baci se dole jer je u Svetom pismu napisano:",
          {
            "text": "’On će zapovediti svojim anđelima za tebe,",
            "poem": 1
          },
          {
            "text": "da te svojim rukama ponesu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da nogom ne bi o kamen zapeo.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Isus mu odgovori: „Napisano je i ovo: ’Ne iskušavaj Gospoda, Boga svoga.’“"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Tada je đavo opet odveo Isusa na jednu veoma visoku goru, pokazao mu sva svetska carstva i njihovu slavu,"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "i rekao mu: „Sve ću ti ovo dati ako padneš preda mnom i pokloniš mi se.“"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Tada mu Isus odvrati: „Odlazi od mene, Satano! Jer u Pismu piše:",
          {
            "text": "’Gospodu Bogu svome klanjaj se,",
            "poem": 1
          },
          {
            "text": "i njemu jedinom služi.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Đavo je nakon ovoga otišao od Isusa, a anđeli su mu pristupili i služili mu."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Početak Isusovog javnog delovanja"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Kada je Isus čuo da je Jovan odveden u tamnicu, povukao se u Galileju."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Napustio je Nazaret i nastanio se u Kafarnaumu, kraj mora, na području Zavulonovog i Neftalimovog plemena,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "da bi se ispunilo ono što je Bog rekao preko proroka Isaije:"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "„Zemlja zavulonovska i zemlja neftalimska,",
            "poem": 1
          },
          {
            "text": "na putu što vodi ka moru,",
            "poem": 2
          },
          {
            "text": "s druge strane Jordana,",
            "poem": 1
          },
          {
            "text": "Galileja mnogobožačka;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "narod što u tami sedi,",
            "poem": 1
          },
          {
            "text": "veliku je svetlost ugledao,",
            "poem": 2
          },
          {
            "text": "onima što u kraju smrti žive,",
            "poem": 1
          },
          {
            "text": "i pod njenom senkom sede,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "svetlost jarka osvanu.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Od tada je Isus počeo da propoveda i govori: „Pokajte se, jer se približilo Carstvo nebesko!“"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Isus izabire sebi učenike"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "A kada je išao pored Galilejskog jezera, Isus vide dva brata, Simona, nazvanog Petar, i njegovog brata Andriju, kako bacaju mreže u more. Oni su, naime, bili ribari."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Isus im reče: „Pođite za mnom i ja ću vas učiniti ribarima ljudi.“"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Oni su odmah ostavili mreže i krenuli za njim."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Pošavši odatle dalje, video je braću Jakova i Jovana, Zavedejeve sinove, kako u brodiću sa svojim ocem Zavedejem, krpe ribarske mreže, pa ih pozva."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "I oni su odmah ostavili brodić i svog oca i krenuli za njim."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Isus – učitelj i iscelitelj"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Isus je obilazio svu Galileju. Poučavao je narod u njihovim sinagogama, objavljivao Radosnu vest o Carstvu i lečio svaku bolest i svaku nemoć u narodu."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Glas o njemu raširio se po svoj Siriji. Ljudi su mu donosili sve bolesnike koji su patili od različitih bolesti i muka, opsednute zlim duhovima, obolele od padavice i nepokretne, i on ih je izlečio."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Za njim je išlo mnoštvo sveta iz Galileje, Dekapolja, Jerusalima, Judeje, i s one strane Jordana."
        ]
      }
    ],
