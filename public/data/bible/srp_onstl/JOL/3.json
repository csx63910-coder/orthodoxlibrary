  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "heading",
        "content": [
          "Sud narodima"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Jer, gle, u tim danima i u to vreme",
            "poem": 1
          },
          {
            "text": "kada vratim izgnanike Jude i Jerusalima,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "okupiću sve narode.",
            "poem": 1
          },
          {
            "text": "Spustiću ih u dolinu Josafatovu",
            "poem": 2
          },
          {
            "noteId": 0
          },
          {
            "text": "da se tamo sudim s njima,",
            "poem": 1
          },
          {
            "text": "zbog mog naroda Izrailja, nasledstva moga,",
            "poem": 2
          },
          {
            "text": "koje su rasuli među narode",
            "poem": 1
          },
          {
            "text": "i moju zemlju razdelili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Za moj su narod bacali žreb,",
            "poem": 1
          },
          {
            "text": "dečake za bludnicu menjali,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "devojčice prodavali za vino, pa se opijali.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "I šta sad sa mnom vi imate, Tire i Sidone i svi krajevi filistejski? Da li biste da mi uzvratite? Ako li mi uzvraćate, brzo ću vam dela vaša olupati o glavu!"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Jer ste uzeli moje zlato i moje blago, moja ste dobra uneli u hramove svoje."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Judin narod i narod Jerusalima ste prodali Grcima, da biste ih odveli daleko od njihove međe."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Evo, podižem ih sa mesta gde ste ih prodali i dela ću vam vaša olupati o glavu vašu."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Prodaću vaše sinove i ćerke vaše u ruke Judejaca, a oni će ih prodati Savejcima, dalekom narodu“ – jer tako kaže Gospod."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Objavite ovo među narodima:",
            "poem": 1
          },
          {
            "text": "„Za rat se spremite!",
            "poem": 2
          },
          {
            "text": "Ljude snažne pozovite!",
            "poem": 1
          },
          {
            "text": "Nek pristupe i neka krenu ratnici.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Raonike svoje u mačeve prekujte",
            "poem": 1
          },
          {
            "text": "i srpove u koplja.",
            "poem": 2
          },
          {
            "text": "Neka nejaki čovek kaže:",
            "poem": 1
          },
          {
            "text": "’Snažan sam!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Požurite odasvud i dođite, o, narodi svi!",
            "poem": 1
          },
          {
            "text": "Okupite se tamo.“",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "O, Gospode, dovedi dole svoje junake!",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "„Nek se dignu narodi,",
            "poem": 1
          },
          {
            "text": "neka izađu u dolinu Josafatovu,",
            "poem": 2
          },
          {
            "text": "jer ću tamo sesti",
            "poem": 1
          },
          {
            "text": "da sudim svim narodima unaokolo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Latite se srpa",
            "poem": 1
          },
          {
            "text": "jer je žetva zrela.",
            "poem": 2
          },
          {
            "text": "Dođite, muljajte,",
            "poem": 1
          },
          {
            "text": "muljare su pune",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i kace se prelivaju",
            "poem": 2
          },
          {
            "text": "jer je velika njihova zloba.“",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Mnoštva su, mnoštva su",
            "poem": 1
          },
          {
            "text": "u dolini odluke",
            "poem": 2
          },
          {
            "text": "jer je blizu dan Gospodnji",
            "poem": 1
          },
          {
            "text": "u dolini odluke.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Pomračuju se sunce i mesec,",
            "poem": 1
          },
          {
            "text": "a zvezde gasnu sjajem svojim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Riknuće Gospod sa Siona i iz Jerusalima;",
            "poem": 1
          },
          {
            "text": "povikaće glasom svojim",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i potrešće se i nebo i zemlja.",
            "poem": 2
          },
          {
            "text": "Ali Gospod je utočište narodu svome",
            "poem": 1
          },
          {
            "text": "i zaštita deci Izrailjevoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Blagoslovi za Božiji narod"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "„Shvatićete da sam ja Gospod, vaš Bog",
            "poem": 1
          },
          {
            "text": "koji prebiva na Sionu, na mojoj svetoj gori.",
            "poem": 2
          },
          {
            "text": "I Jerusalim će biti sveto mesto",
            "poem": 1
          },
          {
            "text": "i tuđinci više neće njime prolaziti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "I toga će dana kapati planine slatkim vinom,",
            "poem": 1
          },
          {
            "text": "a brdima će teći mleko.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Svi Judini brzaci će brujati vodom,",
            "poem": 2
          },
          {
            "text": "teći će izvor od Doma Gospodnjeg",
            "poem": 1
          },
          {
            "text": "i natapati dolinu sitimsku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "U pustoš će se Egipat pretvoriti",
            "poem": 1
          },
          {
            "text": "i Edom u pustaru divlju,",
            "poem": 2
          },
          {
            "text": "zbog nasilja nad narodom Jude",
            "poem": 1
          },
          {
            "text": "u čijoj su zemlji krv nevinu prolili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Počivaće doveka Juda",
            "poem": 1
          },
          {
            "text": "i Jerusalim od naraštaja do naraštaja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Krv njihovu još neosvećenu",
            "poem": 1
          },
          {
            "text": "neosvećenom neću ostaviti.“",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          "Gospod na Sionu prebiva!"
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 0,
        "caller": "+",
        "text": "3,2 Igra reči na izvornom jeziku, jer ime Josafat znači: Gospod je sudio.",
        "reference": {
          "chapter": 3,
          "verse": 2
        }
      }
    ]
