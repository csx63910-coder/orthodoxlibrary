  },
  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "heading",
        "content": [
          "Vojska skakavaca"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Zatrubite trubom na Sionu!",
            "poem": 1
          },
          {
            "text": "Povičite na mojoj svetoj gori!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Neka zadrhte svi stanovnici zemlje.",
            "poem": 1
          },
          {
            "text": "Dolazi dan Gospodnji",
            "poem": 2
          },
          {
            "text": "i baš je blizu!",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Dan tamni i sumorni,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "dan oblaka i guste tame.",
            "poem": 2
          },
          {
            "text": "Ko što se svitanje širi preko brda,",
            "poem": 1
          },
          {
            "text": "takav je narod veliki i moćni",
            "poem": 2
          },
          {
            "text": "kakvog od davnina nije bilo",
            "poem": 1
          },
          {
            "text": "i neće ga biti godinama,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "iz naraštaja u naraštaj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Pred njim vatra proždire,",
            "poem": 1
          },
          {
            "text": "a za njim spaljuje plamen.",
            "poem": 2
          },
          {
            "text": "Pred njim je zemlja kao vrt edenski,",
            "poem": 1
          },
          {
            "text": "a za njim opustošena divljina",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i niko mu utekao nije.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Licem su slični licima konja",
            "poem": 1
          },
          {
            "text": "i jure kao konjanici.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Tutnje kao bojna kola",
            "poem": 1
          },
          {
            "text": "kad vrh gora poskakuju;",
            "poem": 2
          },
          {
            "text": "praskaju ko plamen vatre što strnjiku guta,",
            "poem": 1
          },
          {
            "text": "kao narod moćan što se za boj postrojava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Narodi pred njima drhte,",
            "poem": 1
          },
          {
            "text": "zažari se svako lice.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Trče kao ratnici,",
            "poem": 1
          },
          {
            "text": "ko borci se uz zidine penju;",
            "poem": 2
          },
          {
            "text": "i svaki svojim putem ide,",
            "poem": 1
          },
          {
            "text": "staze svoje ne menjaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Jedan drugog ne sapliću,",
            "poem": 1
          },
          {
            "text": "svojim putem koračaju",
            "poem": 2
          },
          {
            "text": "i neće stati,",
            "poem": 1
          },
          {
            "text": "sve i da na oružje nasrnu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Vršljaju po gradu,",
            "poem": 1
          },
          {
            "text": "po zidinama trče,",
            "poem": 2
          },
          {
            "text": "u kuće se penju",
            "poem": 1
          },
          {
            "text": "i kroz prozore provaljuju poput lopova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Pred njima zemlja drhti",
            "poem": 1
          },
          {
            "text": "i nebesa se potresaju;",
            "poem": 2
          },
          {
            "text": "pomračuju se sunce i mesec,",
            "poem": 1
          },
          {
            "text": "a zvezde gasnu sjajem svojim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "A Gospod će glas svoj da digne",
            "poem": 1
          },
          {
            "text": "pred vojskom svojom",
            "poem": 2
          },
          {
            "text": "jer je tabor njegov vrlo velik;",
            "poem": 1
          },
          {
            "text": "jer su moćni oni što reč njegovu čine;",
            "poem": 2
          },
          {
            "text": "jer je velik i veoma strašan dan Gospodnji,",
            "poem": 1
          },
          {
            "text": "ko da ga izdrži?",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Razdiranje srca"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "„Zato sada – govori Gospod –",
            "poem": 1
          },
          {
            "text": "vratite mi se svim srcem svojim,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "u postu, žaljenju i vapaju.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Srca svoja razderite,",
            "poem": 1
          },
          {
            "text": "a ne odeću svoju!",
            "poem": 2
          },
          {
            "text": "Vratite se Gospodu, Bogu svome,",
            "poem": 1
          },
          {
            "text": "jer je milosrdan i milostiv;",
            "poem": 2
          },
          {
            "text": "spor na srdžbu, bogat milosrđem",
            "poem": 1
          },
          {
            "text": "i sažaljiv na nesreću.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ko zna? Možda se odvrati, predomisli,",
            "poem": 1
          },
          {
            "text": "pa za sobom ostavi blagoslov –",
            "poem": 2
          },
          {
            "text": "žitnu žrtvu i izlivnicu za Gospoda, vašeg Boga.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Zatrubite trubom na Sionu!",
            "poem": 1
          },
          {
            "text": "Sveti post proglasite,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pozovite svečani sabor!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Okupite narod",
            "poem": 1
          },
          {
            "text": "i posvetite zbor.",
            "poem": 2
          },
          {
            "text": "Okupite starešine,",
            "poem": 1
          },
          {
            "text": "decu i odojčad.",
            "poem": 2
          },
          {
            "text": "Neka mladoženja izađe iz svoje sobe",
            "poem": 1
          },
          {
            "text": "i mlada iz odaje svoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Neka sveštenici, sluge Gospodnje,",
            "poem": 1
          },
          {
            "text": "plaču između trema i žrtvenika.",
            "poem": 2
          },
          {
            "text": "Neka kažu: „Gospode, poštedi svoj narod!",
            "poem": 1
          },
          {
            "text": "Ne daj sramotu na nasledstvo svoje,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da mu se rugaju narodi.",
            "poem": 2
          },
          {
            "text": "Zašto da se govori među narodima:",
            "poem": 1
          },
          {
            "text": "’Gde je Bog njihov?’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Gospodnji odgovor"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "I Gospod će da revnuje za svoju zemlju",
            "poem": 1
          },
          {
            "text": "i poštedi svoj narod.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Odgovoriće Gospod svom narodu i reći će mu:",
          {
            "text": "„Evo, daću vam žita, vina i ulja",
            "poem": 1
          },
          {
            "text": "da se time nasitite.",
            "poem": 2
          },
          {
            "text": "I više vas neću činiti ruglom među narodima.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Daleko od vas oteraću tog sa severa.",
            "poem": 1
          },
          {
            "text": "Rasejaću ga u zemlju pustu i bezvodnu:",
            "poem": 2
          },
          {
            "text": "lice njegovo prema moru na istok,",
            "poem": 1
          },
          {
            "text": "i njegov kraj prema moru na zapad.",
            "poem": 2
          },
          {
            "text": "Dizaće se njegov smrad,",
            "poem": 1
          },
          {
            "text": "širiće se njegova trulež,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer je velike stvari uradio.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "O, zemljo, ne strahuj!",
            "poem": 1
          },
          {
            "text": "Raduj se i veseli jer je Gospod velike stvari uradio!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Ne bojte se, o, poljske zveri,",
            "poem": 1
          },
          {
            "text": "jer se zelene pašnjaci pustinjski",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i stabla rađaju svoj plod.",
            "poem": 2
          },
          {
            "text": "Smokva i čokot su dali obilje svoje.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "I vi, narode sionski,",
            "poem": 1
          },
          {
            "text": "radujte se i veselite u Gospodu, svome Bogu,",
            "poem": 2
          },
          {
            "text": "jer vam je dao učitelja pravednosti.",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Izlio vam je rânu, jesenju kišu",
            "poem": 1
          },
          {
            "text": "i poznu, prolećnu kišu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Gumna biće puna žita,",
            "poem": 1
          },
          {
            "text": "vinom i uljem će se prelivati kace.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "„Nadoknadiću vam godine koje su pojeli skakavci,",
            "poem": 1
          },
          {
            "text": "crvi, gusenice i gubari,",
            "poem": 2
          },
          {
            "text": "ta moja velika vojska koju sam poslao među vas.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "I ješćete obilno i nasitićete se.",
            "poem": 1
          },
          {
            "text": "Slavićete ime Gospoda, svoga Boga,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "koji vam je učinio čudesne stvari.",
            "poem": 2
          },
          {
            "text": "Neće se stideti moj narod doveka.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Shvatićete da sam ja usred Izrailja,",
            "poem": 1
          },
          {
            "text": "da sam ja, Gospod, vaš Bog",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i da drugog nema!",
            "poem": 2
          },
          {
            "text": "I neće se stideti moj narod doveka.",
            "poem": 1
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Dan Gospodnji"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "A nakon toga",
            "poem": 1
          },
          {
            "text": "izliću na sve ljude svoga Duha,",
            "poem": 2
          },
          {
            "text": "pa će vaši sinovi i ćerke prorokovati,",
            "poem": 1
          },
          {
            "text": "starci će sanjati snove,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a mladi ljudi imati viđenja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Takođe ću u one dane",
            "poem": 1
          },
          {
            "text": "izliti svoga Duha na sluge i sluškinje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Učiniću da se pokažu čudne pojave",
            "poem": 1
          },
          {
            "text": "na nebu i na zemlji –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "krv, vatra i oblaci dima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Sunce će potamneti,",
            "poem": 1
          },
          {
            "text": "a mesec pocrveneti kao krv",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pre nego što dođe veliki i slavni dan Gospodnji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Svako ko zazove ime Gospodnje,",
            "poem": 1
          },
          {
            "text": "biće spasen.",
            "poem": 2
          },
          {
            "text": "Jer će na gori Sion i u Jerusalimu",
            "poem": 1
          },
          {
            "text": "biti spasenje,",
            "poem": 2
          },
          {
            "text": "baš kako je rekao Gospod,",
            "poem": 1
          },
          {
            "text": "i od ostatka koji Gospod pozove.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
