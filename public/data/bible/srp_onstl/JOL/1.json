  "book": {
    "id": "JOL",
    "translationId": "srp_onstl",
    "name": "Knjiga proroka Joila",
    "commonName": "Knjiga proroka Joila",
    "title": "Knjiga proroka Joila",
    "order": 29,
    "numberOfChapters": 3,
    "sha256": "ab1b466ad3037e59003322c814cb51994d8a1e5958a01e9a05d830448dfbc23a",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/JOL/1.json",
    "lastChapterNumber": 3,
    "lastChapterApiLink": "/api/srp_onstl/JOL/3.json",
