  },
  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ovo je Gospodnja reč koja je došla Joilu, Fatuilovom sinu."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Najezda skakavaca"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Čujte ovo, o, starešine;",
            "poem": 1
          },
          {
            "text": "poslušajte, svi stanovnici zemaljski:",
            "poem": 2
          },
          {
            "text": "Zar se ovo dogodilo u danima vašim",
            "poem": 1
          },
          {
            "text": "ili u danima vaših predaka?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Pričajte o ovom svojoj deci,",
            "poem": 1
          },
          {
            "text": "vaša deca svojoj deci",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a njihova deca novom pokolenju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ostatke gubara poješće skakavci;",
            "poem": 1
          },
          {
            "text": "ostatke skakavaca poješće crvi;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ostatke crva poješće gusenice!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Probudite se, o, vi pijani!",
            "poem": 1
          },
          {
            "text": "Zaplačite i zakukajte, vinopije, zbog šire,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "zato što vam se od usta otela!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Jer na moju zemlju izađe narod silan",
            "poem": 1
          },
          {
            "text": "i broja im nema.",
            "poem": 2
          },
          {
            "text": "Zubi su im kao lavlji zubi,",
            "poem": 1
          },
          {
            "text": "a očnjaci kao u lavice.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Moju je lozu počupao,",
            "poem": 1
          },
          {
            "text": "moju je smokvu izlomio;",
            "poem": 2
          },
          {
            "text": "potpuno je ogolio i bacio,",
            "poem": 1
          },
          {
            "text": "mladice joj ogulio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Nariči kao mlada žena",
            "poem": 1
          },
          {
            "text": "ogrnuta u kostret za mužem svoje mladosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Nestale su žitna žrtva i izlivnica",
            "poem": 1
          },
          {
            "text": "iz Doma Gospodnjeg.",
            "poem": 2
          },
          {
            "text": "U žalosti su sveštenici,",
            "poem": 1
          },
          {
            "text": "sluge Gospodnje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Polja su opustošena",
            "poem": 1
          },
          {
            "text": "i zemlja je u žalosti",
            "poem": 2
          },
          {
            "text": "jer je žito satrveno,",
            "poem": 1
          },
          {
            "text": "mlado vino je presahlo,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a urod ulja je podbacio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Stidite se, ratari,",
            "poem": 1
          },
          {
            "text": "kukajte, vinogradari, za pšenicom i za ječmom,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer je propala žetva na njivi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Loza je presahnula,",
            "poem": 1
          },
          {
            "text": "stablo smokve se sparušilo.",
            "poem": 2
          },
          {
            "text": "Presahnuli su nar, palma, jabuka",
            "poem": 1
          },
          {
            "text": "i sva stabla po polju,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer je presahla radost sinova ljudskih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Poziv na post i molitvu"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "O, sveštenici, opašite se i plačite!",
            "poem": 1
          },
          {
            "text": "Žalite, sluge žrtvenika!",
            "poem": 2
          },
          {
            "text": "Dođite, sluge Boga moga,",
            "poem": 1
          },
          {
            "text": "noć probdite u kostreti",
            "poem": 2
          },
          {
            "text": "jer je iz Doma Boga vašeg",
            "poem": 1
          },
          {
            "text": "nestalo žitne žrtve i izlivnice.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Sveti post proglasite,",
            "poem": 1
          },
          {
            "text": "pozovite svečani sabor!",
            "poem": 2
          },
          {
            "text": "Okupite sve starešine,",
            "poem": 1
          },
          {
            "text": "stanovnike zemlje u Domu Gospoda,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "vašeg Boga, pa vapite Gospodu!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Jao, kakvog li dana,",
            "poem": 1
          },
          {
            "text": "jer je blizu dan Gospodnji",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "što dolazi kao pustošenje od Svemoćnoga!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Zar nam nije pred očima ponestala hrana",
            "poem": 1
          },
          {
            "text": "i radosti i veselja iz Doma našeg Boga?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ugniliše smokve na vencima;",
            "poem": 1
          },
          {
            "text": "opustošene su žitnice;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "porušeni su ambari jer je žito propalo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "O, kako stoka riče!",
            "poem": 1
          },
          {
            "text": "Tumaraju krda goveda",
            "poem": 2
          },
          {
            "text": "jer ispaše za njih nema,",
            "poem": 1
          },
          {
            "text": "a i stada ovaca takođe skapavaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Gospode, ja tebe prizivam",
            "poem": 1
          },
          {
            "text": "jer je plamen suše progutao pustinjske pašnjake,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a požar je spalio sve poljsko drveće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "I poljske zveri ti cvile i žude",
            "poem": 1
          },
          {
            "text": "jer su presušila vodena vrela,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer je požar spalio pustinjske pašnjake.",
            "poem": 2
          }
        ]
      }
    ],
