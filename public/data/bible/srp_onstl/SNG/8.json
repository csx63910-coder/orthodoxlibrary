    "name": "Pesma nad pesmama",
    "commonName": "Pesma nad pesmama",
    "title": "Pesma nad pesmama",
    "order": 22,
    "numberOfChapters": 8,
    "sha256": "02972a6391a094f31dae45dd63c5b55921fd26e7e79a35193a813a5f4ebe4955",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/SNG/1.json",
    "lastChapterNumber": 8,
    "lastChapterApiLink": "/api/srp_onstl/SNG/8.json",
    "totalNumberOfVerses": 117
  },
  "chapter": {
    "number": 8,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "O, da si mi kao brat bio",
            "poem": 1
          },
          {
            "text": "što je grudi majke moje sisao!",
            "poem": 2
          },
          {
            "text": "Našla bih te na polju",
            "poem": 1
          },
          {
            "text": "i poljubila te",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i niko me prezirao ne bi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Vodila bih te",
            "poem": 1
          },
          {
            "text": "i dovela u dom majke svoje,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "koja me je podigla.",
            "poem": 2
          },
          {
            "text": "Dala bih ti da popiješ vino začinjeno",
            "poem": 1
          },
          {
            "text": "i sok od moga nara.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Levica mu je pod glavom mojom,",
            "poem": 1
          },
          {
            "text": "a desnicom me grli.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ćerke jerusalimske, zaklinjem vas,",
            "poem": 1
          },
          {
            "text": "ne budite i ne dižite moju ljubav",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "dok joj se ne prohte.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ko je ona što dolazi iz pustinje,",
            "poem": 1
          },
          {
            "text": "naslonjena na voljenog svoga?",
            "poem": 2
          },
          "Ona",
          {
            "text": "Pod jabukom sam te probudila,",
            "poem": 1
          },
          {
            "text": "tamo gde te je majka tvoja rodila,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "tamo gde te rodila u mukama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Stavi me kao žig na srce svoje,",
            "poem": 1
          },
          {
            "text": "kao prsten na ruku svoju.",
            "poem": 2
          },
          {
            "text": "Jer ljubav je ko smrt jaka,",
            "poem": 1
          },
          {
            "text": "a ljubomora strašna poput Sveta mrtvih",
            "poem": 2
          },
          {
            "noteId": 3
          },
          {
            "text": ".",
            "poem": 2
          },
          {
            "text": "Njen gorući plamen",
            "poem": 1
          },
          {
            "text": "je moćna vatra.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Silne vode nisu kadre da ugase ljubav",
            "poem": 1
          },
          {
            "text": "i reke je zgasnuti ne mogu.",
            "poem": 2
          },
          {
            "text": "Ako neko za ljubav daje",
            "poem": 1
          },
          {
            "text": "sve bogatstvo svoje kuće,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ljudi bi to prezreli.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Naša je sestra mala",
            "poem": 1
          },
          {
            "text": "i još nema grudi.",
            "poem": 2
          },
          {
            "text": "Šta za nju da uradimo",
            "poem": 1
          },
          {
            "text": "na dan kada o njoj bude reči?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ako kao zid bude,",
            "poem": 1
          },
          {
            "text": "na njoj ćemo dići grudobran od srebra;",
            "poem": 2
          },
          {
            "text": "ako bude kao vrata,",
            "poem": 1
          },
          {
            "text": "zagradićemo ih kedrovim daskama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ja sam zid!",
            "poem": 1
          },
          {
            "text": "Moje su grudi kao kule.",
            "poem": 2
          },
          {
            "text": "Tako sam postala ona",
            "poem": 1
          },
          {
            "text": "što je našla naklonost u njegovim očima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "U Val-Amonu Solomon je vinograd imao.",
            "poem": 1
          },
          {
            "text": "Vinograd je dao čuvarima,",
            "poem": 2
          },
          {
            "text": "da mu svaki od tog ploda",
            "poem": 1
          },
          {
            "text": "donosi po hiljadu srebrnika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Preda mnom je moj vinograd,",
            "poem": 1
          },
          {
            "text": "moje je vlasništvo.",
            "poem": 2
          },
          {
            "text": "Hiljadu srebrnika pripada tebi, o, Solomone,",
            "poem": 1
          },
          {
            "text": "a dve stotine onima koji mu plod čuvaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "O, ti koja prebivaš u vinogradima!",
            "poem": 1
          },
          {
            "text": "Glas tvoj ti drugovi pomno osluškuju,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pa daj da ga i ja čujem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Požuri, o, voljeni moj!",
            "poem": 1
          },
          {
            "text": "Budi kao jelen",
            "poem": 2
          },
          {
            "text": "ili ko jelenče",
            "poem": 1
          },
          {
            "text": "na brdima što mirišu.",
            "poem": 2
          }
        ]
      }
    ],
