  "chapter": {
    "number": 7,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Kako su ljupka stopala tvoja u sandalama,",
            "poem": 1
          },
          {
            "text": "o, ćerko velikaška!",
            "poem": 2
          },
          {
            "text": "Obline bokova tvojih su kao dragulji,",
            "poem": 1
          },
          {
            "text": "kao rukotvorina umetnika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Pupak ti je ko okrugli pehar",
            "poem": 1
          },
          {
            "text": "kome nikad ne zafali vina;",
            "poem": 2
          },
          {
            "text": "stomak ti je ko snopić pšenice",
            "poem": 1
          },
          {
            "text": "okružen ljiljanima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Grudi su tvoje kao lanad,",
            "poem": 1
          },
          {
            "text": "blizanci srnini.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Vrat ti je kao kula od slonovače,",
            "poem": 1
          },
          {
            "text": "oči jezerca Esevona na vratima vatravimskim;",
            "poem": 2
          },
          {
            "text": "nos ti je kao kula livanska",
            "poem": 1
          },
          {
            "text": "što gleda na Damask.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Glava je tvoja poput Karmila,",
            "poem": 1
          },
          {
            "text": "kosa ti je kao carski skerlet.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "U lokne se tvoje car upleo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Kako si lepa!",
            "poem": 1
          },
          {
            "text": "Kako si ljupka voljena u svojim čarima!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Stas ti je kao drvo palme,",
            "poem": 1
          },
          {
            "text": "a grudi ti ko grozdovi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Zato kažem: „Ja bih se na palmu peo,",
            "poem": 1
          },
          {
            "text": "držao se za stabljike njenog voća.“",
            "poem": 2
          },
          {
            "text": "Nek mi tvoje grudi budu ko grozdovi na vinovoj lozi,",
            "poem": 1
          },
          {
            "text": "dah nosa tvoga ko miris jabuka.",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Usta su tvoja kao dobro vino.",
            "poem": 2
          },
          "Ona",
          {
            "text": "Ono glatko klizi mome voljenome,",
            "poem": 1
          },
          {
            "text": "ono nežno curi sa usana onih što spavaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ja pripadam mome voljenome,",
            "poem": 1
          },
          {
            "text": "a on za mnom žudi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Dođi, voljeni moj! Hajdemo u polja,",
            "poem": 1
          },
          {
            "text": "hajde da noćimo po selima!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Dignimo se rano, hajdemo u vinograde",
            "poem": 1
          },
          {
            "text": "da vidimo je li propupila loza,",
            "poem": 2
          },
          {
            "text": "da li se rascvetala,",
            "poem": 1
          },
          {
            "text": "jesu li se rascvetali narovi.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "I tamo ću ti dati ljubav svoju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Mandragore odišu mirisom,",
            "poem": 1
          },
          {
            "text": "a na vratima je našim sve probrano voće.",
            "poem": 2
          },
          {
            "text": "A ja sam za tebe sačuvala i novo i staro,",
            "poem": 1
          },
          {
            "text": "o, voljeni moj!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
