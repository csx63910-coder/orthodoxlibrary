  },
  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Lepa si, voljena moja, lepa si!",
            "poem": 1
          },
          {
            "text": "Oči su tvoje golubice iza vela tvoga,",
            "poem": 2
          },
          {
            "text": "kosa ti je poput stada koza",
            "poem": 1
          },
          {
            "text": "što se spušta niz goru Galad.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Zubi su ti kao stado ostriganih ovaca što dolazi sa kupanja.",
            "poem": 1
          },
          {
            "text": "Svaka od njih blizance nosi i jalove među njima nema.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Usne su ti poput niti skerleta,",
            "poem": 1
          },
          {
            "text": "a usta su ti ljupka.",
            "poem": 2
          },
          {
            "text": "Kao kriška nara",
            "poem": 1
          },
          {
            "text": "čelo je tvoje iza vela tvoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Tvoj je vrat kao kula Davidova,",
            "poem": 1
          },
          {
            "text": "načinjena od poređanog kamenja.",
            "poem": 2
          },
          {
            "text": "Hiljadu štitova vise na njoj,",
            "poem": 1
          },
          {
            "text": "sve štitovi od ratnika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Grudi su tvoje kao lanad,",
            "poem": 1
          },
          {
            "text": "blizanci srnini",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "koji pasu među ljiljanima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Dok dan ne mine",
            "poem": 1
          },
          {
            "text": "i senke ne iščile",
            "poem": 2
          },
          {
            "text": "otići ću na brdo smirnino",
            "poem": 1
          },
          {
            "text": "i na goru od tamjana.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Sva si lepa, voljena moja,",
            "poem": 1
          },
          {
            "text": "i na tebi mane nema.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Hajde sa mnom sa Livana, nevesto,",
            "poem": 1
          },
          {
            "text": "hajde sa mnom sa Livana!",
            "poem": 2
          },
          {
            "text": "Siđi sa vrha Amana,",
            "poem": 1
          },
          {
            "text": "sa vrha Senira i Ermona;",
            "poem": 2
          },
          {
            "text": "iz brloga lavova",
            "poem": 1
          },
          {
            "text": "i s gora risovih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Srce si mi ukrala, sestro moja, nevesto!",
            "poem": 1
          },
          {
            "text": "Srce si mi ukrala",
            "poem": 2
          },
          {
            "text": "jednim pogledom očiju svojih,",
            "poem": 1
          },
          {
            "text": "jednim ukrasom ogrlice svoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Kako je lepa ljubav tvoja,",
            "poem": 1
          },
          {
            "text": "sestro moja, nevesto!",
            "poem": 2
          },
          {
            "text": "Ljubav je tvoja od vina bolja",
            "poem": 1
          },
          {
            "text": "i miris ulja tvojih od svih začina.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Sa usana tvojih med kaplje, o, nevesto!",
            "poem": 1
          },
          {
            "text": "Med i mleko pod tvojim su jezikom,",
            "poem": 2
          },
          {
            "text": "a miris haljina tvojih",
            "poem": 1
          },
          {
            "text": "je miris Livana.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Vrt zaključan ti si, sestro moja, nevesto;",
            "poem": 1
          },
          {
            "text": "vrelo zatvoreno, zapečaćen izvor.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Tvoji su izdanci carski vrt narova",
            "poem": 1
          },
          {
            "text": "s najboljim plodovima,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "sa kanom i nardom;",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "sa nardom i šafranom,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "sa mirisnom trskom i cimetom,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "sa svim stablima tamjana,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "smirne i aloje,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "sa svim probranim začinima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ti si vrelo vrtovima,",
            "poem": 1
          },
          {
            "text": "izvor vode što žubori",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i s Livana teče.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Probudi se, severni vetre!",
            "poem": 1
          },
          {
            "text": "Dođi, južni vetre!",
            "poem": 2
          },
          {
            "text": "Duni, vrtom mojim,",
            "poem": 1
          },
          {
            "text": "nek polete njegovi začini.",
            "poem": 2
          },
          {
            "text": "Neka dođe moj voljeni u svoj vrt,",
            "poem": 1
          },
          {
            "text": "neka jede od probranog voća.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
