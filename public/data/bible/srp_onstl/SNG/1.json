    "name": "Pesma nad pesmama",
    "commonName": "Pesma nad pesmama",
    "title": "Pesma nad pesmama",
    "order": 22,
    "numberOfChapters": 8,
    "sha256": "02972a6391a094f31dae45dd63c5b55921fd26e7e79a35193a813a5f4ebe4955",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/SNG/1.json",
    "lastChapterNumber": 8,
    "lastChapterApiLink": "/api/srp_onstl/SNG/8.json",
    "totalNumberOfVerses": 117
  },
  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Solomonova pesma nad pesmama."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Poljupcem usana svojih me poljubi,",
            "poem": 1
          },
          {
            "text": "jer je tvoja ljubav bolja od vina.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Miris je tvoje pomasti divan,",
            "poem": 1
          },
          {
            "text": "ime je tvoje kao ulje izliveno",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i zato te vole devojke.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Povedi me sa sobom, pobegnimo!",
            "poem": 1
          },
          {
            "text": "Nek me car uvede u odaje svoje.",
            "poem": 2
          },
          "Prijateljice",
          {
            "text": "Radovaćemo se i uživaćemo u tebi.",
            "poem": 1
          },
          {
            "text": "Slavićemo tvoju ljubav više nego vino.",
            "poem": 2
          },
          "Ona",
          {
            "text": "Dobro je što te one vole.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Tamnoputa sam ali ljupka,",
            "poem": 1
          },
          {
            "text": "ćerke jerusalimske,",
            "poem": 2
          },
          {
            "text": "kao šatori kedarski,",
            "poem": 1
          },
          {
            "text": "kao krila Solomonovih šatora.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ne gledajte me što sam tamnoputa,",
            "poem": 1
          },
          {
            "text": "jer me je sunce opalilo.",
            "poem": 2
          },
          {
            "text": "Moja su braća ljuta na mene.",
            "poem": 1
          },
          {
            "text": "Postavili su me da vinograde čuvam,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a ja svoj sopstveni vinograd sačuvala nisam.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Kaži mi, ti koga duša moja voli,",
            "poem": 1
          },
          {
            "text": "gde ti stado pase",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i gde ti u podne planduje?",
            "poem": 2
          },
          {
            "text": "Zašto da se velom pokrivam",
            "poem": 1
          },
          {
            "noteId": 0
          },
          {
            "text": "među stadima prijatelja tvojih?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ako ne znaš, o, najlepša među ženama,",
            "poem": 1
          },
          {
            "text": "idi po tragu stada",
            "poem": 2
          },
          {
            "text": "pa napasaj kozliće svoje",
            "poem": 1
          },
          {
            "text": "kraj pastirskih konačišta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "O, voljena moja, ti si kao moja ždrebica",
            "poem": 1
          },
          {
            "text": "među faraonovim upregnutim ždrepcima!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Lepi su ti obrazi okićeni lančićima,",
            "poem": 1
          },
          {
            "text": "a na vratu ti ogrlice.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Skovaćemo ti narukvice zlatne",
            "poem": 1
          },
          {
            "text": "i ukrasiti srebrom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Dok je car za stolom svojim,",
            "poem": 1
          },
          {
            "text": "mirisom svojim moj nard odaje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Smotuljak smirne što noći međʼ grudima mojim,",
            "poem": 1
          },
          {
            "text": "to je meni moj voljeni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Struk kane u cvatu iz vinograda En-Gedija,",
            "poem": 1
          },
          {
            "text": "to je meni moj voljeni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Kako li si lepa, o, voljena moja!",
            "poem": 1
          },
          {
            "text": "Lepa si, a oči su ti golubice.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Kako si zgodan, o, voljeni moj, i mio!",
            "poem": 1
          },
          {
            "text": "Evo, postelja je naša bujna trava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Kedrovi su grede kuće naše,",
            "poem": 1
          },
          {
            "text": "a čempresi rogovi krova.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 0,
