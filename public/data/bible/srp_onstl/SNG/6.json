  },
  "chapter": {
    "number": 6,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Gde je otišao voljeni tvoj,",
            "poem": 1
          },
          {
            "text": "o, najlepša među ženama?",
            "poem": 2
          },
          {
            "text": "Kuda se okrenuo voljeni tvoj",
            "poem": 1
          },
          {
            "text": "da ga tražimo sa tobom?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Voljeni je moj sišao u vrt svoj,",
            "poem": 1
          },
          {
            "text": "na leje začina,",
            "poem": 2
          },
          {
            "text": "da pase po vrtovima",
            "poem": 1
          },
          {
            "text": "i ljiljane bere.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ja pripadam mome voljenome",
            "poem": 1
          },
          {
            "text": "i meni pripada moj voljeni",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "koji pase među ljiljanima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Lepa si, voljena moja,",
            "poem": 1
          },
          {
            "text": "kao Tersa ljupka i kao Jerusalim,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "strahovita kao vojska s barjacima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Oči svoje s mene skreni",
            "poem": 1
          },
          {
            "text": "jer me zaluđuju,",
            "poem": 2
          },
          {
            "text": "a kosa ti je poput stada koza",
            "poem": 1
          },
          {
            "text": "što se spušta niz Galad.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Zubi su ti kao stado ovaca",
            "poem": 1
          },
          {
            "text": "što dolazi sa kupanja.",
            "poem": 2
          },
          {
            "text": "Svaka od njih blizance nosi",
            "poem": 1
          },
          {
            "text": "i jalove među njima nema.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Kao kriška nara",
            "poem": 1
          },
          {
            "text": "čelo je tvoje iza vela tvoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Neka je šezdeset carica,",
            "poem": 1
          },
          {
            "text": "osamdeset inoča",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i nebrojeno mladih žena;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "alʼ je jedna golubica moja bez mane.",
            "poem": 1
          },
          {
            "text": "Ona je ljubimica majke svoje,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "miljenica one što je rodi.",
            "poem": 2
          },
          {
            "text": "Videle su je devojke i blaženom je prozvale,",
            "poem": 1
          },
          {
            "text": "a carice i inoče su je hvalile.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ko je ona što se javlja kao zora,",
            "poem": 1
          },
          {
            "text": "lepa kao puni mesec, ko sunce bez mane,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "strahovita kao vojska s barjacima?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Sišao sam u orašnjak,",
            "poem": 1
          },
          {
            "text": "pregledao izdanke u dolu,",
            "poem": 2
          },
          {
            "text": "da vidim hoće li da propupi loza",
            "poem": 1
          },
          {
            "text": "i nar da procveta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Alʼ me duša, a da nisam znao,",
            "poem": 1
          },
          {
            "text": "posadi na kola mojih velikaša.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Vrati se! Vrati se, o, Sulamko!",
            "poem": 1
          },
          {
            "text": "Vrati se, vrati da te pogledamo!",
            "poem": 2
          },
          "On",
          {
            "text": "Zašto da gledate u Sulamku",
            "poem": 1
          },
          {
            "text": "kao u igru dva tabora.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
