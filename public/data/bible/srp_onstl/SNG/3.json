  },
  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Tražila sam u noćima na postelji svojoj",
            "poem": 1
          },
          {
            "text": "onog koga voli duša moja,",
            "poem": 2
          },
          {
            "text": "tražila sam",
            "poem": 1
          },
          {
            "text": "i nisam ga našla.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ustaću, grad ću obigrati,",
            "poem": 1
          },
          {
            "text": "po ulicama i po trgovima ću tražiti",
            "poem": 2
          },
          {
            "text": "onog koga duša moja voli.",
            "poem": 1
          },
          {
            "text": "I tražila sam ga, ali ga nisam našla.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Našli su me stražari što obilaze grad:",
            "poem": 1
          },
          {
            "text": "„Jeste li videli onoga",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "koga voli duša moja?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "I tek što sam ih malo prošla,",
            "poem": 1
          },
          {
            "text": "našla sam onog kog mi duša voli.",
            "poem": 2
          },
          {
            "text": "Zgrabila sam ga i puštala ga nisam",
            "poem": 1
          },
          {
            "text": "sve dok ga nisam dovela do kuće majke moje,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "do odaje one što me je rodila.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ćerke jerusalimske, zaklinjem vas",
            "poem": 1
          },
          {
            "text": "lanadima i košutama poljskim,",
            "poem": 2
          },
          {
            "text": "ne budite i ne dižite moju ljubav",
            "poem": 1
          },
          {
            "text": "dok joj se ne prohte.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Šta se to iz pustinje diže",
            "poem": 1
          },
          {
            "text": "ko oblaci dima,",
            "poem": 2
          },
          {
            "text": "namirisano smirnom, tamjanom",
            "poem": 1
          },
          {
            "text": "i svim mirisnim pomastima trgovačkim?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Gle, to je ležaljka Solomonova,",
            "poem": 1
          },
          {
            "text": "a oko nje su šezdeset delija,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "neki od junaka Izrailja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Svaki od njih mač je dograbio,",
            "poem": 1
          },
          {
            "text": "ratovanju su vični;",
            "poem": 2
          },
          {
            "text": "svakom od njih mač o bedru,",
            "poem": 1
          },
          {
            "text": "zbog noćnih strahota.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Od stabala livanskih je sebi",
            "poem": 1
          },
          {
            "text": "nosiljku načinio car Solomon.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Od srebra joj je načinio motke,",
            "poem": 1
          },
          {
            "text": "naslon od zlata,",
            "poem": 2
          },
          {
            "text": "sedište od skerleta,",
            "poem": 1
          },
          {
            "text": "a unutrašnjost su joj kožom",
            "poem": 2
          },
          {
            "noteId": 2
          },
          {
            "text": "obložile ćerke jerusalimske.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Izađite i gledajte,",
            "poem": 1
          },
          {
            "text": "o, ćerke sionske, cara Solomona",
            "poem": 2
          },
          {
            "text": "s krunom kojom ga okrunila majka njegova",
            "poem": 1
          },
          {
            "text": "na dan njegovog venčanja,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "na dan kada mu se srce radovalo!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 2,
        "caller": "+",
        "text": "3,10 Igra reči na izvornom jeziku: koža – sa ljubavlju.",
