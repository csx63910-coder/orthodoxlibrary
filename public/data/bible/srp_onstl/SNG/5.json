  },
  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Došao sam u vrt svoj, o, sestro moja, nevesto!",
            "poem": 1
          },
          {
            "text": "Pobrao sam smirnu moju sa začinima mojim,",
            "poem": 2
          },
          {
            "text": "pojeo sam saće moje s medom mojim,",
            "poem": 1
          },
          {
            "text": "popio sam vino moje sa mlekom mojim.",
            "poem": 2
          },
          "Prijatelji",
          {
            "text": "Jedite i pijte, o, prijatelji moji!",
            "poem": 1
          },
          {
            "text": "Opijte se, o, najmiliji!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Spavam, alʼ srce mi budno.",
            "poem": 1
          },
          {
            "text": "Čuj! Voljeni moj kuca:",
            "poem": 2
          },
          {
            "text": "„Otvori mi, sestro moja, voljena moja,",
            "poem": 1
          },
          {
            "text": "golubice bez mane!",
            "poem": 2
          },
          {
            "text": "Glava mi je natopljena rosom,",
            "poem": 1
          },
          {
            "text": "uvojke mi noć je ovlažila.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Odoru sam svoju svukla",
            "poem": 1
          },
          {
            "text": "i kako da je navučem?",
            "poem": 2
          },
          {
            "text": "Noge sam oprala svoje",
            "poem": 1
          },
          {
            "text": "i kako da ih isprljam?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Kroz otvor je moj voljeni provukao ruku svoju",
            "poem": 1
          },
          {
            "text": "i za njim je ustreptala utroba moja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ustala sam da otvorim voljenome svome",
            "poem": 1
          },
          {
            "text": "i s ruku mi je prokapala smirna,",
            "poem": 2
          },
          {
            "text": "na rezu je s prstiju mi",
            "poem": 1
          },
          {
            "text": "procurila smirna.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "I otvorila sam voljenom svom,",
            "poem": 1
          },
          {
            "text": "ali moj se voljeni okrenuo i otišao.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Duša mi je klonula što se udaljio.",
            "poem": 2
          },
          {
            "text": "Tražila sam ga i nisam ga našla,",
            "poem": 1
          },
          {
            "text": "dozivala sam ga i nije mi se odazvao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Našli su me stražari što obilaze grad.",
            "poem": 1
          },
          {
            "text": "Istukli su me, izranjavali,",
            "poem": 2
          },
          {
            "text": "uzeli su veo s mene",
            "poem": 1
          },
          {
            "text": "stražari sa zida.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ćerke jerusalimske, zaklinjem vas,",
            "poem": 1
          },
          {
            "text": "ako nađete voljenoga moga",
            "poem": 2
          },
          {
            "text": "šta da mu kažete?",
            "poem": 1
          },
          {
            "text": "Da bolujem od ljubavi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "A što je tvoj voljeni bolji od drugih voljenih,",
            "poem": 1
          },
          {
            "text": "o, ti najlepša među ženama?",
            "poem": 2
          },
          {
            "text": "Što je tvoj voljeni bolji od drugih",
            "poem": 1
          },
          {
            "text": "pa nas zaklinješ tako?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Moj voljeni blista, rumen je,",
            "poem": 1
          },
          {
            "text": "naočitiji od deset hiljada!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Glava mu je od zlata zlaćanog,",
            "poem": 1
          },
          {
            "text": "kosa uvojita",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i ko gavran crna.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Oči su njegove golubice",
            "poem": 1
          },
          {
            "text": "na vodenim brzacima,",
            "poem": 2
          },
          {
            "text": "mlekom umivene,",
            "poem": 1
          },
          {
            "text": "skladno ugneždene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Obrazi mu ko leje začina",
            "poem": 1
          },
          {
            "text": "i kule mirišljavih trava;",
            "poem": 2
          },
          {
            "text": "usne su mu ljiljani",
            "poem": 1
          },
          {
            "text": "sa kojih se cedi smirna.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ruke su mu ko palice zlatne",
            "poem": 1
          },
          {
            "text": "pune hrisolita,",
            "poem": 2
          },
          {
            "text": "stomak mu je ploča slonovače",
            "poem": 1
          },
          {
            "text": "pokrivena safirima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Njegove su noge mermerni stubovi",
            "poem": 1
          },
          {
            "text": "položeni na temelje od suvoga zlata;",
            "poem": 2
          },
          {
            "text": "stasit je ko Livan,",
            "poem": 1
          },
          {
            "text": "kao probrani kedrovi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Usta su mu zaslađena",
            "poem": 1
          },
          {
            "text": "i sav je poželjan;",
            "poem": 2
          },
          {
            "text": "takav je voljeni moj, takav je dragan moj,",
            "poem": 1
          },
          {
            "text": "o, ćerke jerusalimske!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
