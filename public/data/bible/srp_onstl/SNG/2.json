  },
  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ja sam šafran sa Sarona",
            "poem": 1
          },
          {
            "text": "i ljiljan iz dolina.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Kakav je ljiljan među trnjem,",
            "poem": 1
          },
          {
            "text": "takva je voljena moja među devojkama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Kao stablo jabuke među šumskim drvećem,",
            "poem": 1
          },
          {
            "text": "takav je voljeni moj među momcima.",
            "poem": 2
          },
          {
            "text": "Za hladom njegovim čeznem, da sednem,",
            "poem": 1
          },
          {
            "text": "da plodom njegovim osladim nepce svoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Uneo me je u kuću vina,",
            "poem": 1
          },
          {
            "text": "ljubav je njegova zastava nada mnom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Krepite me suvim grožđem,",
            "poem": 1
          },
          {
            "text": "jabukama me osvežite,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer sam od ljubavi klonula.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Levica mu je pod glavom mojom,",
            "poem": 1
          },
          {
            "text": "a desnicom me grli.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ćerke jerusalimske, zaklinjem vas",
            "poem": 1
          },
          {
            "text": "lanadima i košutama poljskim,",
            "poem": 2
          },
          {
            "text": "ne budite i ne dižite moju ljubav",
            "poem": 1
          },
          {
            "text": "dok joj se ne prohte.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Čuj glasa voljenog moga!",
            "poem": 1
          },
          {
            "text": "Evo, dolazi,",
            "poem": 2
          },
          {
            "text": "poskakuje po brdima",
            "poem": 1
          },
          {
            "text": "i gore preskače.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Kao gazela i kao srndać moj je voljeni.",
            "poem": 1
          },
          {
            "text": "Gle, eno ga stoji iza našeg zida,",
            "poem": 2
          },
          {
            "text": "proviruje sa prozora,",
            "poem": 1
          },
          {
            "text": "kroz rešetke gleda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "A moj voljeni mi odgovori, reče mi:",
            "poem": 1
          },
          {
            "text": "„Ustani, voljena moja,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "dođi, najlepša moja!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Evo, zima je prošla",
            "poem": 1
          },
          {
            "text": "i kiša uminu, prođe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Zemlja je procvetala,",
            "poem": 1
          },
          {
            "text": "stiže vreme orezivanja",
            "poem": 2
          },
          {
            "noteId": 1
          },
          {
            "text": ",",
            "poem": 2
          },
          {
            "text": "po našoj se zemlji",
            "poem": 1
          },
          {
            "text": "čuje cvrkut grlice.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Plodovi rani pupe na smokvinom stablu,",
            "poem": 1
          },
          {
            "text": "vinogradi cvatu i mirisom odišu.",
            "poem": 2
          },
          {
            "text": "Ustani i dođi,",
            "poem": 1
          },
          {
            "text": "o, voljena moja, dođi!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Golubice moja u raselini stene,",
            "poem": 1
          },
          {
            "text": "zaklonjena u vrleti.",
            "poem": 2
          },
          {
            "text": "Daj mi da ti vidim lice!",
            "poem": 1
          },
          {
            "text": "Daj mi glasa da ti čujem,",
            "poem": 2
          },
          {
            "text": "jer je glas tvoj meden",
            "poem": 1
          },
          {
            "text": "i lice je tvoje ljupko.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Lisice nam pohvatajte,",
            "poem": 1
          },
          {
            "text": "lisičiće što satiru vinograde,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer naš je vinograd u cvatu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Moj je dragi moj i ja sam njegova,",
            "poem": 1
          },
          {
            "text": "među ljiljanima on pase.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Vrati se dok dan ne mine",
            "poem": 1
          },
          {
            "text": "i senke ne iščile.",
            "poem": 2
          },
          {
            "text": "Kao srna budi, o, voljeni moj,",
            "poem": 1
          },
          {
            "text": "kao srndać na brdima što nas dele.",
            "poem": 2
          }
        ]
      }
    ],
