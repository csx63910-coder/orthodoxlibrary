  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "heading",
        "content": [
          "Optužba protiv Izrailja"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Čujte reč Gospodnju, o, narode izrailjski,",
            "poem": 1
          },
          {
            "text": "jer se Gospod parniči",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "sa stanovnicima zemlje:",
            "poem": 2
          },
          {
            "text": "„Nema istine, nema milosti",
            "poem": 1
          },
          {
            "text": "i nema bogopoznanja u zemlji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Proklinjanje i obmanjivanje, ubijanje,",
            "poem": 1
          },
          {
            "text": "krađe i preljube su prokuljali,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a krv se na krv proliva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Zato će zemlja da tuguje,",
            "poem": 1
          },
          {
            "text": "svenuće svako u njoj.",
            "poem": 2
          },
          {
            "text": "Uginuće zveri poljske, nebeske ptice,",
            "poem": 1
          },
          {
            "text": "pa i ribe u moru.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ipak, neka se niko ne parniči,",
            "poem": 1
          },
          {
            "text": "niko nikoga neka ne prekoreva,",
            "poem": 2
          },
          {
            "text": "jer narod je tvoj poput onih",
            "poem": 1
          },
          {
            "text": "koji se bune protiv sveštenika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Posrnućeš danju",
            "poem": 1
          },
          {
            "text": "ali će i prorok zajedno sa tobom da posrne noću.",
            "poem": 2
          },
          {
            "text": "A i majku tvoju pogubiću!",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Pogibe moj narod jer nema znanja.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Zato što si ti odbacio znanje",
            "poem": 1
          },
          {
            "text": "i ja ću tebe da odbacim,",
            "poem": 2
          },
          {
            "text": "da mi više ne budeš sveštenik.",
            "poem": 3
          },
          {
            "text": "Zaboravio si Zakon Boga svoga,",
            "poem": 1
          },
          {
            "text": "pa ću i ja da zaboravim decu tvoju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "I što ih je više bilo,",
            "poem": 1
          },
          {
            "text": "grešili su više protiv mene;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "sramotom ću da zamenim ja njihovu slavu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Grehom mog naroda se hrane,",
            "poem": 1
          },
          {
            "text": "krivica njihova glad im razgaljuje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Narodu će biti kao i sveštenicima;",
            "poem": 1
          },
          {
            "text": "i ja ću da mu sudim, da uzvratim po njegovim putevima",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i po delima njegovim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ješće oni, ali siti neće biti;",
            "poem": 1
          },
          {
            "text": "bludničili su, ali se neće umnožiti",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer su Gospodu prestali da služe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Bludničenje, vino i šira zaluđuju srce.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Sa drvetom se svojim savetuje moj narod",
            "poem": 1
          },
          {
            "text": "i štap mu njegov savet daje!",
            "poem": 2
          },
          {
            "text": "Zaveden je duhom bludništva.",
            "poem": 1
          },
          {
            "text": "Bludničili su i otpali od Boga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Žrtvuju na vrh gora;",
            "poem": 1
          },
          {
            "text": "kade po brdima",
            "poem": 2
          },
          {
            "text": "i ispod hrasta, topole i bresta",
            "poem": 1
          },
          {
            "text": "jer je tamo dobar hlad.",
            "poem": 2
          },
          {
            "text": "A ćerke vam bludniče",
            "poem": 1
          },
          {
            "text": "i snahe vam preljubu čine.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ali neću da sudim vašim ćerkama",
            "poem": 1
          },
          {
            "text": "jer bludniče",
            "poem": 2
          },
          {
            "text": "i snahama vašim",
            "poem": 1
          },
          {
            "text": "jer čine preljubu.",
            "poem": 2
          },
          {
            "text": "Jer, sami se muškarci odvajaju sa bludnicama",
            "poem": 1
          },
          {
            "text": "i žrtvuju sa hramskim bludnicama.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "A narod koji to ne shvata biće upropašćen.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ako ti bludničiš, o, Izrailju,",
            "poem": 1
          },
          {
            "text": "neka Juda ne sagreši!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ne idite u Galgal!",
            "poem": 1
          },
          {
            "text": "Ne penjite se u Vet-Aven",
            "poem": 2
          },
          {
            "noteId": 10
          },
          {
            "lineBreak": true
          },
          {
            "text": "i ne kunite se: ’Tako mi živog Gospoda!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Kao jogunasta junica",
            "poem": 1
          },
          {
            "text": "Izrailj je jogunast.",
            "poem": 2
          },
          {
            "text": "Hoće li ih sada Gospod voditi",
            "poem": 1
          },
          {
            "text": "kao jagnje na prostrano mesto?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Jefrem se udružio sa idolima.",
            "poem": 1
          },
          {
            "text": "Prođi ga se!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "A kada im ponestane pića",
            "poem": 1
          },
          {
            "text": "oni uporno bludniče,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a njihove starešine baš vole sramotu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Vetar ih je svojim krilima sapeo;",
            "poem": 1
          },
          {
            "text": "biće posramljeni zbog žrtava svojih.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 10,
        "caller": "+",
        "text": "4,15 Vet-Aven znači kuća pokvarenosti, što je pogrdni naziv za Vetilj, Dom Božiji.",
