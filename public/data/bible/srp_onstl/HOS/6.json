  "chapter": {
    "number": 6,
    "content": [
      {
        "type": "heading",
        "content": [
          "Izrailj se ne kaje"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "„Dođite! Hajde da se vratimo Gospodu,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer on nas je rastrgnuo,",
            "poem": 1
          },
          {
            "text": "i on će nas izlečiti;",
            "poem": 2
          },
          {
            "text": "on nas je udario,",
            "poem": 1
          },
          {
            "text": "i on će nas previti!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Oživeće nas za par dana,",
            "poem": 1
          },
          {
            "text": "a već trećeg će nas dići",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da pred njime mi živimo!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Hajde da ga upoznamo,",
            "poem": 1
          },
          {
            "text": "hajde da težimo bogopoznanju!",
            "poem": 2
          },
          {
            "text": "On sigurno stiže kao zora,",
            "poem": 1
          },
          {
            "text": "dolazi nam kao kiša, kao pozna kiša",
            "poem": 2
          },
          {
            "noteId": 13
          },
          {
            "text": "zemlju što natapa.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "„Šta da ti radim, Jefreme?",
            "poem": 1
          },
          {
            "text": "Judo, šta da ti radim?",
            "poem": 2
          },
          {
            "text": "Vaša je odanost kao oblak jutarnji,",
            "poem": 1
          },
          {
            "text": "kao rosa rana nestaje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Seći ću ih u komade preko proroka,",
            "poem": 1
          },
          {
            "text": "ubiću ih rečima svojih usta,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a propisi će moji biti svetlo što se javlja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Jer ja milosrđe hoću, a ne žrtvu;",
            "poem": 1
          },
          {
            "text": "bogopoznanje, a ne svespalnice!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Poput Adama su savez prekršili.",
            "poem": 1
          },
          {
            "text": "O, kako su me izdali!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Galad je grad zločinaca krvavih tragova.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Družina je sveštenička banda ubica",
            "poem": 1
          },
          {
            "text": "što čoveka vreba.",
            "poem": 2
          },
          {
            "text": "Ubijaju na putu za Sihem,",
            "poem": 1
          },
          {
            "text": "grozote su počinili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Video sam strašne stvari u domu Izrailjevom:",
            "poem": 1
          },
          {
            "text": "Jefrem tamo bludniči,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a Izrailj se opoganio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Judo, i za tebe je određena žetva,",
            "poem": 1
          },
          {
            "text": "iz izgnanstva narod svoj kad vratim.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 13,
        "caller": "+",
        "text": "6,3 Jesenja, rana kiša, od poznog septembra do ranog novembra i prolećna, pozna kiša, od aprila do početka maja.",
        "reference": {
          "chapter": 6,
          "verse": 3
        }
      }
    ]
