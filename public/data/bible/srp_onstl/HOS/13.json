  "chapter": {
    "number": 13,
    "content": [
      {
        "type": "heading",
        "content": [
          "Gospodnji gnev protiv Izrailja"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Strah je vladao dok je Jefrem govorio.",
            "poem": 1
          },
          {
            "text": "Uzdigao se on u Izrailju,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ali je zgrešio zbog Vala i umro.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "A i sada grehe množe",
            "poem": 1
          },
          {
            "text": "jer su sebi izlili idole",
            "poem": 2
          },
          {
            "text": "od svog srebra i svojom veštinom.",
            "poem": 1
          },
          {
            "text": "Idoli su delo livca, svi do jednog!",
            "poem": 2
          },
          {
            "text": "I još za njih kažu:",
            "poem": 1
          },
          {
            "text": "„Ljudi koji žrtvuju neka ljube telad!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Biće zato ko jutarnji oblak",
            "poem": 1
          },
          {
            "text": "i kao rosa rana što nestaje,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kao pleva s gumna olujom nošena",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i dim iz odžaka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "„A ja sam bio Gospod,",
            "poem": 1
          },
          {
            "text": "Bog tvoj, još od zemlje egipatske,",
            "poem": 2
          },
          {
            "text": "osim mene ne znaš za druge bogove.",
            "poem": 1
          },
          {
            "text": "Osim mene Spasitelja nema.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ja sam tebe posmatrao u pustinji,",
            "poem": 1
          },
          {
            "text": "u zemlji sasušenoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Nasitili su se na pašnjaku svome.",
            "poem": 1
          },
          {
            "text": "Nasitili su se, srcem ogordili",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i zato me zaboravili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Poput lava ja ću za njih biti,",
            "poem": 1
          },
          {
            "text": "poput risa što kraj puta vreba.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Presrešću ih kao medvedica kojoj su oteli medvediće,",
            "poem": 1
          },
          {
            "text": "do srca im grudi rastrgnuti.",
            "poem": 2
          },
          {
            "text": "Proždraću ih onde kao lav,",
            "poem": 1
          },
          {
            "text": "raskomadaće ih divlje zveri.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Satrven si, Izrailju,",
            "poem": 1
          },
          {
            "text": "jer si protiv mene, protiv svoga pomoćnika!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Gde je sada car tvoj da te spase",
            "poem": 1
          },
          {
            "text": "u svim tvojim gradovima, tvoje sudije?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "A za njih si govorio: ’Daj mi cara i glavare!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "I u gnevu svome cara sam ti dao,",
            "poem": 1
          },
          {
            "text": "ali sam ga i uzeo u jarosti svojoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Svezana je krivica Jefremova",
            "poem": 1
          },
          {
            "text": "i prikriven greh je njegov.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Spopašće ga bolovi ko da se porađa.",
            "poem": 1
          },
          {
            "text": "Ali on je dete što mudrosti nema,",
            "poem": 2
          },
          {
            "text": "jer on ne bi da se rodi,",
            "poem": 1
          },
          {
            "text": "da izađe iz utrobe kad je tome vreme.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Od prevlasti Sveta mrtvih",
            "poem": 1
          },
          {
            "noteId": 17
          },
          {
            "text": "otkupiću ih",
            "poem": 1
          },
          {
            "text": "i od smrti izbaviću ih.",
            "poem": 2
          },
          {
            "text": "Gde je, smrti, tvoje razaranje?",
            "poem": 1
          },
          {
            "text": "Gde je, Svete mrtvih, žalac tvoj?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Samilost je sakrivena od očiju mojih.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Sve i da procveta među braćom svojom,",
            "poem": 2
          },
          {
            "text": "istočni će vetar doći,",
            "poem": 1
          },
          {
            "text": "iz pustinje vetar Gospodnji se diže",
            "poem": 2
          },
          {
            "text": "da presuši njegove izvore,",
            "poem": 1
          },
          {
            "text": "da presahne njegova vrela",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i da otme blago, sve dragocenosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Biće kriva Samarija",
            "poem": 1
          },
          {
            "text": "za pobunu protiv Boga svoga.",
            "poem": 2
          },
          {
            "text": "Od mača će oni pasti,",
            "poem": 1
          },
          {
            "text": "decu će im razmrskati",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i trudnice rasporiti.“",
            "poem": 2
          }
        ]
      }
    ],
