  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "heading",
        "content": [
          "Sud nad Izrailjem"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Čujte ovo, sveštenici",
            "poem": 1
          },
          {
            "text": "i pazi, dome Izrailjev!",
            "poem": 2
          },
          {
            "text": "I ti, dvore carev, poslušaj,",
            "poem": 1
          },
          {
            "text": "jer ti je određen sud,",
            "poem": 2
          },
          {
            "text": "jer ste bili zamka za Mispu",
            "poem": 1
          },
          {
            "text": "i mreža razapeta preko Tavora.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ogrezli su u klanju, buntovnici,",
            "poem": 1
          },
          {
            "text": "i sve sam ih pokarao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Poznajem ja Jefrema",
            "poem": 1
          },
          {
            "text": "i Izrailj od mene skriven nije.",
            "poem": 2
          },
          {
            "text": "Jer ti sada bludničiš, Jefreme,",
            "poem": 1
          },
          {
            "text": "ti sebe opogani, Izrailju!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Dela im njihova ne puštaju",
            "poem": 1
          },
          {
            "text": "da se svome Bogu vrate,",
            "poem": 2
          },
          {
            "text": "jer im je u srcu duh bludništva",
            "poem": 1
          },
          {
            "text": "i Gospoda ne poznaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Izrailju ponos svedoči u lice,",
            "poem": 1
          },
          {
            "text": "pa će se i Izrailj i Jefrem spotaknuti u svojoj krivici.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "A i Juda će se spotaknuti s njima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Sa stadima i krdima će ići",
            "poem": 1
          },
          {
            "text": "Gospoda da traže,",
            "poem": 2
          },
          {
            "text": "ali ga pronaći neće",
            "poem": 1
          },
          {
            "text": "jer se on izmaknuo od njih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Gospoda su izneverili",
            "poem": 1
          },
          {
            "text": "jer su decu tuđu izrodili,",
            "poem": 2
          },
          {
            "text": "i sad će ih praznik mladina",
            "poem": 1
          },
          {
            "text": "pojesti sve sa imanjem njihovim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Duvajte u trubu u Gavaji,",
            "poem": 1
          },
          {
            "text": "zatrubite u Rami,",
            "poem": 2
          },
          {
            "text": "vičite u Vet-Avenu –",
            "poem": 1
          },
          {
            "text": "za tobom, o, Venijamine!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Jefrem će postati pustoš",
            "poem": 1
          },
          {
            "text": "na dan kazne,",
            "poem": 2
          },
          {
            "text": "i ja plemenima izrailjskim",
            "poem": 1
          },
          {
            "text": "otkrivam stvari pouzdane.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Judini su glavari postali",
            "poem": 1
          },
          {
            "text": "kao oni što pomeraju među,",
            "poem": 2
          },
          {
            "text": "i ja ću na njih kao vodu",
            "poem": 1
          },
          {
            "text": "da izlijem jarost svoju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Jefrem je potlačen,",
            "poem": 1
          },
          {
            "text": "sud ga je skršio",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer mu je baš po volji bilo da ide za idolima",
            "poem": 2
          },
          {
            "noteId": 11
          },
          {
            "text": ".",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "A ja sam Jefremu kao moljac,",
            "poem": 1
          },
          {
            "text": "i kao trulež domu Judinom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "A kada je Jefrem video svoju bolest",
            "poem": 1
          },
          {
            "text": "i Juda ranu svoju,",
            "poem": 2
          },
          {
            "text": "otišao je Jefrem Asiriji",
            "poem": 1
          },
          {
            "text": "i poslao po velikog cara.",
            "poem": 2
          },
          {
            "text": "Ali on ne može da vas izleči,",
            "poem": 1
          },
          {
            "text": "on ne može da isceli ranu vašu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Jer ja sam Jefremu poput lava",
            "poem": 1
          },
          {
            "text": "i Judi sam poput lavića.",
            "poem": 2
          },
          {
            "text": "Ja, ja ću da rastrgnem, da odjurim",
            "poem": 1
          },
          {
            "text": "i odvučem, i niko ne može da izbavi!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Odjuriću, vratiću se na svoje stanište",
            "poem": 1
          },
          {
            "text": "dok ne podnesu sud.",
            "poem": 2
          },
          {
            "noteId": 12
          },
          {
            "text": "I tražiće lice moje u nevolji svojoj,",
            "poem": 1
          },
          {
            "text": "i tražiće me željno.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 11,
        "caller": "+",
        "text": "5,11 Ova izvorna reč je nesigurnog značenja i može da se prevede: za ljudskim zapovestima; za protivnikom; za nečistoćom.",
        "reference": {
