  "chapter": {
    "number": 11,
    "content": [
      {
        "type": "heading",
        "content": [
          "Božija ljubav za Izrailj"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "„Voleo sam Izrailj još dok je dete bio",
            "poem": 1
          },
          {
            "text": "i iz Egipta pozvah sina svoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ali što su ih",
            "poem": 1
          },
          {
            "noteId": 15
          },
          {
            "text": "više pozivali,",
            "poem": 1
          },
          {
            "text": "od njih su više odlazili,",
            "poem": 2
          },
          {
            "text": "Valima su žrtvovali,",
            "poem": 1
          },
          {
            "text": "idolima su kadili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jefrema sam učio da hoda,",
            "poem": 1
          },
          {
            "text": "ja sam ih za ruke prihvatao.",
            "poem": 2
          },
          {
            "text": "Ali oni prepoznali nisu",
            "poem": 1
          },
          {
            "text": "da sam ja taj što sam ih lečio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Sponama ljudskim, vezama ljubavi",
            "poem": 1
          },
          {
            "text": "ja sam ih privlačio.",
            "poem": 2
          },
          {
            "text": "Bio sam im kao onaj što im u ustima žvale raslabljuje.",
            "poem": 1
          },
          {
            "text": "Saginjao sam se da bih ih hranio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Neće se vratiti u Egipat,",
            "poem": 1
          },
          {
            "text": "nego će Asirca za cara imati",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer su odbili da se pokaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Vitlaće im mač po gradovima,",
            "poem": 1
          },
          {
            "text": "kapije će im razoriti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "proždraće ih zbog njihovih spletki.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Moj je narod odlučan da me se odriče.",
            "poem": 1
          },
          {
            "text": "Zovu ga ka Višnjem,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "alʼ ga niko ne uzvisi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "O, Jefreme, kako da te predam?",
            "poem": 1
          },
          {
            "text": "O, Izrailju, kako da te izručim?",
            "poem": 2
          },
          {
            "text": "Kako da te učinim kao Admu,",
            "poem": 1
          },
          {
            "text": "da te učinim kao Sevojim?",
            "poem": 2
          },
          {
            "text": "Tuče u meni srce moje,",
            "poem": 1
          },
          {
            "text": "razgorelo se moje smilovanje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Plamen svoga gneva neću da izlijem,",
            "poem": 1
          },
          {
            "text": "neću opet Jefrema da zatrem.",
            "poem": 2
          },
          {
            "text": "Jer, Bog ja jesam, nisam čovek;",
            "poem": 1
          },
          {
            "text": "Svetac među vama",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i u gnevu neću da vam dođem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Oni će slediti Gospoda",
            "poem": 1
          },
          {
            "text": "i kao lav on će da riče.",
            "poem": 2
          },
          {
            "text": "Zarikaće on,",
            "poem": 1
          },
          {
            "text": "zadrhtaće i doći će oni, deca sa zapada.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Zadrhtaće i doći kao ptica iz Egipta,",
            "poem": 1
          },
          {
            "text": "kao golubica iz zemlje asirske.",
            "poem": 2
          },
          {
            "text": "Daću im da žive u kućama njinim",
            "poem": 1
          },
          {
            "text": "– govori Gospod.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Izrailjev greh"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Jefrem me je lažju okružio,",
            "poem": 1
          },
          {
            "text": "a obmanom dom Izrailjev.",
            "poem": 2
          },
          {
            "text": "Ali Juda još s Bogom korača,",
            "poem": 1
          },
          {
            "text": "sa svetima ostao je veran.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 15,
        "caller": "+",
        "text": "11,2 Ovako je u jevrejskom tekstu dok je u Septuaginti i aramejskom prevodu jednina.",
