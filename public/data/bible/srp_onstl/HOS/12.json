  },
  "chapter": {
    "number": 12,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Jefrem se vetrom hrani,",
            "poem": 1
          },
          {
            "text": "za istočnim vetrom stalno hrli.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Umnožio je laž i nasilje.",
            "poem": 2
          },
          {
            "text": "Sa Asirijom savez su sklopili,",
            "poem": 1
          },
          {
            "text": "a ulje se u Egipat nosi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Gospod se parniči sa Judom.",
            "poem": 1
          },
          {
            "text": "Jakova kažnjava, uzvratiće mu po njegovim putevima",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i po delima njegovim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Za petu je svoga brata u utrobi uhvatio,",
            "poem": 1
          },
          {
            "text": "i sa Bogom se borio u muževnoj snazi svojoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Sa Anđelom se borio i pobedio.",
            "poem": 1
          },
          {
            "text": "Plakao je, naklonost mu je tražio",
            "poem": 2
          },
          {
            "text": "i u Vetilju ga je našao.",
            "poem": 1
          },
          {
            "text": "I tamo mu",
            "poem": 2
          },
          {
            "noteId": 16
          },
          {
            "text": "je on govorio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "On – Gospod Bog nad vojskama –",
            "poem": 1
          },
          {
            "text": "Gospod mu je ime za spominjanje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "A ti, ti se vrati svome Bogu.",
            "poem": 1
          },
          {
            "text": "Vernost i pravednost čuvaj.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "U svog Boga stalno se pouzdaj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "U ruci trgovca terazije nepoštene,",
            "poem": 1
          },
          {
            "text": "voli da zakine.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Jefrem reče: „Obogatio sam se,",
            "poem": 1
          },
          {
            "text": "zgrnuo sam sebi blago.",
            "poem": 2
          },
          {
            "text": "I u svemu mome trudu",
            "poem": 1
          },
          {
            "text": "krivicu mi neće naći a da je greh.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "„A ja, Gospod, Bog tvoj ja sam bio",
            "poem": 1
          },
          {
            "text": "još od zemlje egipatske.",
            "poem": 2
          },
          {
            "text": "I opet ću ti dati da u šatorima svojim prebivaš",
            "poem": 1
          },
          {
            "text": "kao u danima praznika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Prorocima sam se objavio",
            "poem": 1
          },
          {
            "text": "i viđenja im umnožio.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Po prorocima sam poređenja davao.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ima li zla u Galadu?",
            "poem": 1
          },
          {
            "text": "Baš su ništa svi koji su u njemu.",
            "poem": 2
          },
          {
            "text": "U Galgalu volove žrtvuju,",
            "poem": 1
          },
          {
            "text": "njihovi su žrtvenici gomile kamenja po brazdama njive.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "U zemlju aramejsku Jakov je pobegao.",
            "poem": 1
          },
          {
            "text": "Za ženu je služio Izrailj",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i za ženu čuvao je stada.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Gospod je preko proroka izveo Izrailja iz Egipta",
            "poem": 1
          },
          {
            "text": "i čuvao ga je preko proroka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "A Jefrem ga je gorko razdraživao.",
            "poem": 1
          },
          {
            "text": "Krv što je proli na njemu ostaje.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Gospod njegov uzvratiće mu pogrde njegove.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 16,
        "caller": "+",
        "text": "12,4 Ovako je u aramejskom i u grčkim rukopisima, dok je u jevrejskom množina, nama.",
