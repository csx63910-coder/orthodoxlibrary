  "chapter": {
    "number": 8,
    "content": [
      {
        "type": "heading",
        "content": [
          "Izrailj žanje oluju"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Trubu na usta!",
            "poem": 1
          },
          {
            "text": "Eno lešinara nad Domom Gospodnjim",
            "poem": 2
          },
          {
            "text": "jer su prekršili moj savez,",
            "poem": 1
          },
          {
            "text": "pobunili se protiv mog Zakona.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Meni vape:",
            "poem": 1
          },
          {
            "text": "’O, moj Bože!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Mi, Izrailj, znamo tebe!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ali Izrailj je odbacio dobro",
            "poem": 1
          },
          {
            "text": "i dušman će ga progoniti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Postavljaju careve koji nisu moji,",
            "poem": 1
          },
          {
            "text": "postavljaju glavare koje ne poznajem.",
            "poem": 2
          },
          {
            "text": "Od svog srebra i od zlata svoga",
            "poem": 1
          },
          {
            "text": "idole su sebi napravili,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da bi mogli biti istrebljeni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Samarijo, tvoje je tele odbačeno",
            "poem": 1
          },
          {
            "text": "jer se na njih moj gnev raspalio.",
            "poem": 2
          },
          {
            "text": "Koliko još nećete moći da budete neokaljani?",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Jer je od Izrailja i ta rukotvorina,",
            "poem": 2
          },
          {
            "text": "livac ju je izlio i nije Bog.",
            "poem": 1
          },
          {
            "text": "Zato će se u parčiće pretvoriti",
            "poem": 2
          },
          {
            "text": "tele Samarije.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Zato što su sejali vetar,",
            "poem": 1
          },
          {
            "text": "požnjeće oluju.",
            "poem": 2
          },
          {
            "text": "Nema klasa na tom snopu,",
            "poem": 1
          },
          {
            "text": "neće biti brašna.",
            "poem": 2
          },
          {
            "text": "Možda rodi za tuđince",
            "poem": 1
          },
          {
            "text": "koji će ga progutati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Izrailj će progutati!",
            "poem": 1
          },
          {
            "text": "Oni su sada među narodima",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kao krčag bezvredan koji niko neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Jer su u Asiriju otišli",
            "poem": 1
          },
          {
            "text": "poput divljeg magarca što se sam skita,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a Jefrem ljubavnike plaća.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Iako ih i među narodima plaća,",
            "poem": 1
          },
          {
            "text": "sada ću ih okupiti",
            "poem": 2
          },
          {
            "text": "i za malo će biti",
            "poem": 1
          },
          {
            "text": "pod teretom cara i glavara.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Jefrem je umnožio žrtvenike za grehe,",
            "poem": 1
          },
          {
            "text": "a za njega su oni postali žrtvenici greha.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Napisao sam mu mnogo toga u svome Zakonu,",
            "poem": 1
          },
          {
            "text": "ali za njega je to kao nešto tuđe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Za žrtve, za prinose moje",
            "poem": 1
          },
          {
            "text": "oni žrtvuju meso i jedu ga,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a Gospodu to nije ugodno.",
            "poem": 2
          },
          {
            "text": "Sada će se opomenuti njihove krivice",
            "poem": 1
          },
          {
            "text": "i kazniće grehe njihove,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a oni će se vratiti u Egipat.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Zaboravio je Izrailj Sazdatelja svoga",
            "poem": 1
          },
          {
            "text": "i sagradio dvorove,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a Juda je umnožio utvrđene gradove.",
            "poem": 2
          },
          {
            "text": "Ja ću da pošaljem oganj na njegove gradove",
            "poem": 1
          },
          {
            "text": "i on će da proždere njegova utvrđenja.“",
            "poem": 2
          }
        ]
      }
    ],
