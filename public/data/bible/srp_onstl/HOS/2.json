  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Recite svojoj braći: ’Narode moj!’",
          {
            "noteId": 3
          },
          "; i svojoj sestri: ’Pomilovana!’",
          {
            "noteId": 4
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Izrailj kažnjen i obnovljen"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Parničite se sa majkom svojom!",
            "poem": 1
          },
          {
            "text": "Sudite se, jer mi ona više nije žena,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a ja muž njen nisam.",
            "poem": 2
          },
          {
            "text": "Nek sa lica svoga skine svoje bludništvo",
            "poem": 1
          },
          {
            "text": "i svoje preljube sa grudi svojih,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "da je ne bih skinuo,",
            "poem": 1
          },
          {
            "text": "golotinju njenu razotkrio kao na dan kada se rodila.",
            "poem": 2
          },
          {
            "text": "Pretvoriću je u pustinju,",
            "poem": 1
          },
          {
            "text": "pretvoriću je u zemlju suvu",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i ubiti žeđu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "I neću se smilovati na njenu decu,",
            "poem": 1
          },
          {
            "text": "jer su kopilad!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Njihova je majka bludničila,",
            "poem": 1
          },
          {
            "text": "osramotila se ona što ih je začela.",
            "poem": 2
          },
          {
            "text": "Jer, rekla je: ’Idem ja za svojim ljubavnicima,",
            "poem": 1
          },
          {
            "text": "za onima što mi hranu i vodu daju;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "što mi daju vunu i lan, ulje i piće.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Zato ću, evo, da pregradim njen put trnjem;",
            "poem": 1
          },
          {
            "text": "zidom ću je obzidati da ne nađe svoj put.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "I ona će juriti za svojim ljubavnicima,",
            "poem": 1
          },
          {
            "text": "ali ih neće stići;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "tražiće ih, ali ih neće naći.",
            "poem": 2
          },
          {
            "text": "Reći će:",
            "poem": 1
          },
          {
            "text": "’Otići ću, vratiću se svome prvom mužu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer mi je bilo bolje tada nego sada.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ona ne zna da sam joj ja",
            "poem": 1
          },
          {
            "text": "dao žito i vino, ulje i srebro;",
            "poem": 2
          },
          {
            "text": "ja sam joj umnožio zlato",
            "poem": 1
          },
          {
            "text": "što ga je dala da slije Vala.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Zato ću sada da uzmem natrag svoje žito u vreme žetve,",
            "poem": 1
          },
          {
            "text": "i svoje vino u doba berbe;",
            "poem": 2
          },
          {
            "text": "skloniću svoju vunu i svoj lan,",
            "poem": 1
          },
          {
            "text": "čime bi pokrila nagost njenu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Razotkriću sada njenu nagost",
            "poem": 1
          },
          {
            "text": "na oči njenim ljubavnicima",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i iz ruku mojih je niko izbaviti neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ućutkaću sve veselje",
            "poem": 1
          },
          {
            "text": "njenih sabora, njenih mladina,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "njenih subota i svih njenih praznika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Opustošiću njenu lozu i njene smokve,",
            "poem": 1
          },
          {
            "text": "za koje je rekla:",
            "poem": 2
          },
          {
            "text": "’To je plata moja koju su mi dali ljubavnici moji.’",
            "poem": 1
          },
          {
            "text": "Pretvoriću sve to u šumu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da ih jedu poljske zveri.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Sudiću joj ja zbog dana Vala,",
            "poem": 1
          },
          {
            "text": "kada im je palila tamjan;",
            "poem": 2
          },
          {
            "text": "kada se nagizdala svojim prstenjem i nakitom svojim,",
            "poem": 1
          },
          {
            "text": "kada je otišla za svojim ljubavnicima,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a mene je zaboravila",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Zato ću je, evo, namamiti;",
            "poem": 1
          },
          {
            "text": "u pustinju odvešću je",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i blago joj govoriti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Vratiću joj ja odande vinograde njene",
            "poem": 1
          },
          {
            "text": "i dolinu Ahor",
            "poem": 2
          },
          {
            "noteId": 5
          },
          {
            "text": "kao vrata nade.",
            "poem": 2
          },
          {
            "text": "Odazvaće se ona s onog mesta,",
            "poem": 1
          },
          {
            "text": "kao kad je bila mlada",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i kao kada je dolazila iz Egipta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Toga ćeš me dana – govori Gospod –",
            "poem": 1
          },
          {
            "text": "zvati: ’Mužu moj’,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i nećeš me više zvati: ’Gospodaru moj.",
            "poem": 2
          },
          {
            "noteId": 6
          },
          {
            "text": "’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ukloniću imena Vala iz njenih usta",
            "poem": 1
          },
          {
            "text": "da im ime više nikad ne spomene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Toga ću dana za njih sačiniti savez",
            "poem": 1
          },
          {
            "text": "sa poljskim zverima,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "sa nebeskim pticama i sa gmizavcima.",
            "poem": 2
          },
          {
            "text": "Ukloniću luk, mač i bitku iz zemlje",
            "poem": 1
          },
          {
            "text": "i daću im da bezbrižno leže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Veriću te doveka sa sobom;",
            "poem": 1
          },
          {
            "text": "veriću te sa sobom u pravednosti i pravdi,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "u milosti i milosrđu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Veriću te sa sobom u vernosti",
            "poem": 1
          },
          {
            "text": "i poznaćeš Gospoda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "I ja ću toga dana da poslušam",
            "poem": 1
          },
          {
            "text": "– govori Gospod –",
            "poem": 2
          },
          {
            "text": "da poslušam nebesa,",
            "poem": 1
          },
          {
            "text": "a ona će poslušati zemlju;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "zemlja će poslušati žito",
            "poem": 1
          },
          {
            "text": "i novo vino i sveže ulje.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "A oni će poslušati Jezrael.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Posejaću je za sebe po zemlji",
            "poem": 1
          },
          {
            "text": "i smilovaću se Lo-Ruhami",
            "poem": 2
          },
          {
            "noteId": 7
          },
          {
            "text": ",",
            "poem": 2
          },
          {
            "text": "a Lo-Amiju",
            "poem": 1
          },
          {
            "noteId": 8
          },
          {
            "text": "ću reći: ’Ti si moj narod’,",
            "poem": 1
          },
          {
            "text": "a on će reći meni: ’Moj Bog.’“",
            "poem": 2
          }
        ]
      }
    ],
