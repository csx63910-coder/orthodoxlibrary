    "title": "Knjiga proroka Osije",
    "order": 28,
    "numberOfChapters": 14,
    "sha256": "c109237200d31d7fbcacf8b05352160d229d21ec7c23d2f542c600299a3d6cdb",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/HOS/1.json",
