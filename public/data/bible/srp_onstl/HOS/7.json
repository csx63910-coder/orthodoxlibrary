  },
  "chapter": {
    "number": 7,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Kada bih da lečim Izrailja,",
            "poem": 1
          },
          {
            "text": "otkriva se Jefremova krivica",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i zlo Samarije;",
            "poem": 2
          },
          {
            "text": "jer su prevrtljivci,",
            "poem": 1
          },
          {
            "text": "lopov provaljuje",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i banda je ubica na ulici.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "A u srcu svome oni i ne misle",
            "poem": 1
          },
          {
            "text": "da ja pamtim sva zlodela njina.",
            "poem": 2
          },
          {
            "text": "Sada su ih okružila sva njihova dela,",
            "poem": 1
          },
          {
            "text": "evo ih pred licem mojim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Zlodelima cara razgaljuju",
            "poem": 1
          },
          {
            "text": "i lažima svojim glavare.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Svi su oni preljubnici,",
            "poem": 1
          },
          {
            "text": "kao peć su usplamtela",
            "poem": 2
          },
          {
            "text": "koju pekar prestaje da žari",
            "poem": 1
          },
          {
            "text": "od kada je zamesio testo,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pa dokle mu ne uskisne od kvasca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Na dan našega cara",
            "poem": 1
          },
          {
            "text": "klonuli su glavari razgaljeni vinom",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i on pruži svoju ruku podsmevačima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Prišli su mu i plamteli srcem",
            "poem": 1
          },
          {
            "text": "u svojoj obmani.",
            "poem": 2
          },
          {
            "text": "Spavala je kao pekar jarost njina cele noći,",
            "poem": 1
          },
          {
            "text": "a ujutro se razgnevila kao plamen vatre.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Svi su oni zažareni kao peć",
            "poem": 1
          },
          {
            "text": "i progutaće svoje sudije;",
            "poem": 2
          },
          {
            "text": "padaju svi njihovi carevi,",
            "poem": 1
          },
          {
            "text": "a među njima nema nikog da pozove mene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Jefrem je sa narodima, sebe je izmešao.",
            "poem": 1
          },
          {
            "text": "Jefrem je postao pogača neokrenuta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Tuđinci mu snagu jedu,",
            "poem": 1
          },
          {
            "text": "a on to i ne zna;",
            "poem": 2
          },
          {
            "text": "sede kose posuše ga,",
            "poem": 1
          },
          {
            "text": "a on to i ne zna.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Izrailju ponos svedoči u lice,",
            "poem": 1
          },
          {
            "text": "alʼ se ne okreću Gospodu, svom Bogu;",
            "poem": 2
          },
          {
            "text": "i u svemu tome",
            "poem": 1
          },
          {
            "text": "oni ga ne traže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "A Jefrem je postao kao golubica",
            "poem": 1
          },
          {
            "text": "lakoverna što razuma nema!",
            "poem": 2
          },
          {
            "text": "Eno, zovu Egipat",
            "poem": 1
          },
          {
            "text": "i odlaze u Asiriju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ali kada odu, nad njima ću da raširim svoju mrežu.",
            "poem": 1
          },
          {
            "text": "Kao ptice nebeske zbaciću ih,",
            "poem": 2
          },
          {
            "text": "kazniću ih kad ih čujem",
            "poem": 1
          },
          {
            "text": "u njihovom zboru.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Jao njima, jer su od mene pobegli!",
            "poem": 1
          },
          {
            "text": "Opustošiće jer su se protiv mene pobunili.",
            "poem": 2
          },
          {
            "text": "Ja bi da ih otkupim,",
            "poem": 1
          },
          {
            "text": "a oni o meni laži objavljuju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Nisu srcem vapili meni,",
            "poem": 1
          },
          {
            "text": "nego su kukali na svojim posteljama.",
            "poem": 2
          },
          {
            "text": "Zbog žita i mladog vina sebe seku",
            "poem": 1
          },
          {
            "text": "i od mene se okreću.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "A ja sam ih krepio, snažio im ruke,",
            "poem": 1
          },
          {
            "text": "a oni su mi zlo mislili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "I oni se nisu okrenuli Višnjem;",
            "poem": 1
          },
          {
            "text": "postali su kao luk labavi.",
            "poem": 2
          },
          {
            "text": "Pašće oni od mača,",
            "poem": 1
          },
          {
            "text": "a njihove vođe od gorčine sopstvenog jezika.",
            "poem": 2
          },
          {
            "text": "A to će im u Egiptu biti na porugu.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
