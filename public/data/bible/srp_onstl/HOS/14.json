  "chapter": {
    "number": 14,
    "content": [
      {
        "type": "heading",
        "content": [
          "Pokajanje donosi blagoslov"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Gospodu se, Bogu svome, Izrailju vrati,",
            "poem": 1
          },
          {
            "text": "jer si posrnuo u krivici svojoj!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ponesite sa sobom reči,",
            "poem": 1
          },
          {
            "text": "Gospodu se vratite.",
            "poem": 2
          },
          {
            "text": "Kažite mu:",
            "poem": 1
          },
          {
            "text": "„Krivicu nam svaku ti oprosti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "molitvu usliši;",
            "poem": 2
          },
          {
            "text": "kako bismo ti prineli",
            "poem": 1
          },
          {
            "text": "plod usana svojih",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kao junce kada žrtvujemo!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Asirija nas spasti neće",
            "poem": 1
          },
          {
            "text": "i na konjima nećemo jahati.",
            "poem": 2
          },
          {
            "text": "Nećemo opet govoriti, delu ruku naših: ’Bože naš!’",
            "poem": 1
          },
          {
            "text": "Jer siroče smilovanje u tebi nalazi.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "„Izlečiću otpadništvo njihovo,",
            "poem": 1
          },
          {
            "text": "dobrovoljno voleću ih",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer se od njih jarost moja odvratila.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Izrailju biću kao zora,",
            "poem": 1
          },
          {
            "text": "procvetaće kao ljiljan,",
            "poem": 2
          },
          {
            "text": "pustiće korenje kao kedar livanski.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Nicaće mu mladice,",
            "poem": 1
          },
          {
            "text": "kao maslina raskošan će biti,",
            "poem": 2
          },
          {
            "text": "mirisaće kao kedar livanski.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Vratiće se da žive u senci njegovoj.",
            "poem": 1
          },
          {
            "text": "Proklijaće kao žito,",
            "poem": 2
          },
          {
            "text": "raširiti kao loza,",
            "poem": 1
          },
          {
            "text": "pročuće se kao vino sa Livana.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "O, Jefreme, šta ja imam s idolima?",
            "poem": 1
          },
          {
            "text": "Ja, ja ću da uslišim,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ja ću da se staram,",
            "poem": 2
          },
          {
            "text": "ja sam kao zelen čempres.",
            "poem": 1
          },
          {
            "text": "Od mene ćeš ti svoj plod da primiš.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ko je mudar nek ovo razume,",
            "poem": 1
          },
          {
            "text": "ove stvari nek umni razazna:",
            "poem": 2
          },
          {
            "text": "Gospodnji su ispravni putevi.",
            "poem": 1
          },
          {
            "text": "Pravednici hodaju po njima,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "odmetnici na njima posrću.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
