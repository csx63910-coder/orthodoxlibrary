  "chapter": {
    "number": 10,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Izrailj je bio loza razgranata.",
            "poem": 1
          },
          {
            "text": "Rađao je plod za sebe",
            "poem": 2
          },
          {
            "text": "i po obilju svojih plodova",
            "poem": 1
          },
          {
            "text": "umnožavao žrtvenike,",
            "poem": 2
          },
          {
            "text": "podizao je ukrašene svete stubove",
            "poem": 1
          },
          {
            "text": "prema napretku svoje zemlje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Srce im je ljigavo",
            "poem": 1
          },
          {
            "text": "i sada im sledi kazna od njega",
            "poem": 2
          },
          {
            "noteId": 14
          },
          {
            "text": ":",
            "poem": 2
          },
          {
            "text": "razbiće im žrtvenike",
            "poem": 1
          },
          {
            "text": "i polomiće im svete stubove.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jer oni sad govore: „Nemamo cara",
            "poem": 1
          },
          {
            "text": "jer se ni Gospoda ne bojimo!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Jer, kakva korist i od cara?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Govore besmislice",
            "poem": 1
          },
          {
            "text": "dok se kunu lažno",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i zavetuju se,",
            "poem": 2
          },
          {
            "text": "parnice se ko otrovni korov šire",
            "poem": 1
          },
          {
            "text": "po brazdama njihove njive.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Za teletom Vet-Avenovim",
            "poem": 1
          },
          {
            "text": "strepe stanovnici Samarije.",
            "poem": 2
          },
          {
            "text": "Žaliće za njim njegov narod,",
            "poem": 1
          },
          {
            "text": "njegovi sveštenici će strepeti nad njim,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer je od njega otišla slava njegova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "U Asiriju će ga odneti",
            "poem": 1
          },
          {
            "text": "na dar velikom caru;",
            "poem": 2
          },
          {
            "text": "stid će da spopadne Jefrema,",
            "poem": 1
          },
          {
            "text": "a Izrailj će se zastideti zbog namere svoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Samarija će se razoriti",
            "poem": 1
          },
          {
            "text": "sa sve carem ko sa trunkom povrh vode.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Biće oborene uzvišice Vet-Avena,",
            "poem": 1
          },
          {
            "text": "taj greh Izrailja;",
            "poem": 2
          },
          {
            "text": "trnje i korov će pokriti",
            "poem": 1
          },
          {
            "text": "njihove žrtvenike,",
            "poem": 2
          },
          {
            "text": "a oni će reći gorama: „Prekrijte nas“,",
            "poem": 1
          },
          {
            "text": "i bregovima: „Padnite na nas.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "O, Izrailju, grešio si još od gavajskih dana!",
            "poem": 1
          },
          {
            "text": "Onde su i ostali.",
            "poem": 2
          },
          {
            "text": "Ali, tamo u Gavaji,",
            "poem": 1
          },
          {
            "text": "neće li rat zahvatiti sinove nepravde?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Kazniću ih kad mi je po volji.",
            "poem": 1
          },
          {
            "text": "Okupiće se na njih narod da ih okuju",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "zbog njihovog dvostukoga greha.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Jefrem je ukroćena junica",
            "poem": 1
          },
          {
            "text": "koja voli da vrše.",
            "poem": 2
          },
          {
            "text": "Lepu ću joj šiju jarmom ukrasiti.",
            "poem": 1
          },
          {
            "text": "Ujarmiću Jefrema,",
            "poem": 2
          },
          {
            "text": "oraće Juda,",
            "poem": 1
          },
          {
            "text": "drljaće Jakov.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Pravednost sejte,",
            "poem": 1
          },
          {
            "text": "žanjite milost",
            "poem": 2
          },
          {
            "text": "i tlo neuzorano orite!",
            "poem": 1
          },
          {
            "text": "Vreme je da Gospoda tražite,",
            "poem": 2
          },
          {
            "text": "dok se ne vrati",
            "poem": 1
          },
          {
            "text": "i ne da vam kišu pravednosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "A vi ste opakost orali,",
            "poem": 1
          },
          {
            "text": "nepravdu požnjeli",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i plod laganja jeli,",
            "poem": 2
          },
          {
            "text": "jer ste se u svoj put pouzdali,",
            "poem": 1
          },
          {
            "text": "u ratnike svoje mnogobrojne.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Zaoriće se ratna vika u narodu tvome,",
            "poem": 1
          },
          {
            "text": "satrvena biće utvrđenja tvoja sva;",
            "poem": 2
          },
          {
            "text": "kao što je Salman satro Vet-Arvel,",
            "poem": 1
          },
          {
            "text": "kada je na dan boja majka s decom na komade bila razmrskana.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ovo će ti učiniti, o, Vetilju,",
            "poem": 1
          },
          {
            "text": "zbog velike zlobe tvoje.",
            "poem": 2
          },
          {
            "text": "Kada dan bude okončan,",
            "poem": 1
          },
          {
            "text": "okončaće i car Izrailja.",
            "poem": 2
          }
        ]
      }
    ],
