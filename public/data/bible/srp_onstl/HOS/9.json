  "chapter": {
    "number": 9,
    "content": [
      {
        "type": "heading",
        "content": [
          "Kazna za Izrailj"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Izrailju, ne raduj se!",
            "poem": 1
          },
          {
            "text": "Ne likuj kao narodi",
            "poem": 2
          },
          {
            "text": "jer si bludničio i otišao od Boga svoga.",
            "poem": 1
          },
          {
            "text": "Zavoleo si zaradu bludničku",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "sa pšeničnih gumna.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Gumno i vinska kaca ih neće nahraniti,",
            "poem": 1
          },
          {
            "text": "izneveriće u njima šira.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Oni neće ostati u Gospodnjoj zemlji.",
            "poem": 1
          },
          {
            "text": "Jefrem će se vratiti u Egipat",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i u Asiriji će jesti nečistu hranu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Neće Gospodu izlivati vino",
            "poem": 1
          },
          {
            "text": "i neće mu biti ugodne njihove žrtve.",
            "poem": 2
          },
          {
            "text": "Biće im kao hleb žalosti",
            "poem": 1
          },
          {
            "text": "i svi koji ga jedu će se onečistiti.",
            "poem": 2
          },
          {
            "text": "Jer je njihov hleb za njihovu gušu",
            "poem": 1
          },
          {
            "text": "i neće ući u Dom Gospodnji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Šta ćeš da radiš na dan određenog praznika,",
            "poem": 1
          },
          {
            "text": "na dan Gospodnje svetkovine?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Jer, gle, pobegli su od propasti,",
            "poem": 1
          },
          {
            "text": "a Egipat će ih okupiti",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i u Memfisu će ih sahraniti.",
            "poem": 2
          },
          {
            "text": "Dragocenosti njihovog srebra zarašće u koprivu",
            "poem": 1
          },
          {
            "text": "i trnje će im biti u šatorima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Došli su dani kazne!",
            "poem": 1
          },
          {
            "text": "Došli su dani osvete!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Neka zna Izrailj:",
            "poem": 2
          },
          {
            "text": "Prorok je lud",
            "poem": 1
          },
          {
            "text": "i sumanut je čovek duhovan,",
            "poem": 2
          },
          {
            "text": "od veličine krivice tvoje",
            "poem": 1
          },
          {
            "text": "i velike mržnje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Jefrem je sa Bogom mojim bio stražar,",
            "poem": 1
          },
          {
            "text": "a prorok ptičareva zamka na svim njegovim putevima.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Mržnja je u Domu Boga njegovoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "U pokvarenosti su ogrezli",
            "poem": 1
          },
          {
            "text": "kao u danima Gavaje.",
            "poem": 2
          },
          {
            "text": "Ali setiće se on krivice njihove",
            "poem": 1
          },
          {
            "text": "i kazniće grehe njihove.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "„U pustinji sam našao Izrailj kao grožđe;",
            "poem": 1
          },
          {
            "text": "kao rani plod na tek stasalom smokvinom stablu",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "video sam vaše pretke.",
            "poem": 2
          },
          {
            "text": "I oni su došli u Val-Fegor",
            "poem": 1
          },
          {
            "text": "i posvetili se sramoti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "postali su poput gadosti kakve su voleli.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Jefremova slava će kao ptica da odleti –",
            "poem": 1
          },
          {
            "text": "nema rađanja, nema trudnoće, nema začeća.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Jer ako i odgaje decu svoju",
            "poem": 1
          },
          {
            "text": "ja ću ih ostaviti bez ijednog čoveka.",
            "poem": 2
          },
          {
            "text": "I još: jao njima,",
            "poem": 1
          },
          {
            "text": "kada budem otišao od njih!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Jefrem je, koliko vidim, kao Tir,",
            "poem": 1
          },
          {
            "text": "zasađen na pašnjaku.",
            "poem": 2
          },
          {
            "text": "Ali Jefrem izvodi ubicama",
            "poem": 1
          },
          {
            "text": "svoju decu.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "O, Gospode, podaj im,",
            "poem": 1
          },
          {
            "text": "alʼ šta da im daš?",
            "poem": 2
          },
          {
            "text": "Utrobu koja pobacuje",
            "poem": 1
          },
          {
            "text": "i grudi usahle podaj im.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "„U Galgalu su sva njihova zla",
            "poem": 1
          },
          {
            "text": "i tamo ih mrzim.",
            "poem": 2
          },
          {
            "text": "Zbog njihovih zlobnih dela",
            "poem": 1
          },
          {
            "text": "isteraću ih iz svoga Doma.",
            "poem": 2
          },
          {
            "text": "Više neću da ih volim.",
            "poem": 1
          },
          {
            "text": "Svi su njihovi glavari odmetnici.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Razoren je Jefrem,",
            "poem": 1
          },
          {
            "text": "koren mu je sasušen",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i ploda neće imati.",
            "poem": 2
          },
          {
            "text": "A ako i nešto rodi,",
            "poem": 1
          },
          {
            "text": "to predrago njegove utrobe ja ću da pogubim!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Moj Bog će ih odbaciti",
            "poem": 1
          },
          {
            "text": "jer ga nisu poslušali,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pa će biti lutalice među narodima.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
