  "chapter": {
    "number": 6,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Kao Hristovi saradnici, molimo vas da ne uzimate olako milost Božiju."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Jer Bog govori:",
          {
            "text": "„U vreme povoljno sam te uslišio,",
            "poem": 1
          },
          {
            "text": "i u dan spasenja sam ti pomogao.“",
            "poem": 2
          },
          "Evo, sada je pravo vreme, sada je dan spasenja."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Mi nikome ne postavljamo prepreke, da niko ne pokudi našu službu."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Naprotiv, u svemu pokazujemo da smo sluge Božije: u velikoj postojanosti, nevoljama, nuždama, teškoćama,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "pod batinama, u tamnicama, pred razjarenom svetinom, u naporima, bdenjima, i postovima,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "u čistoti, znanju, strpljivosti, dobroti, u Svetom Duhu, iskrenoj ljubavi,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "iskrenom govoru, u Božijoj snazi, s oružjem pravednosti s desne i leve strane;"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "u slavi i sramoti, sa zlim i dobrim glasom. Smatraju nas varalicama, a iskreni smo."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Mi smo kao neznanci, a ipak nas poznaju; naizgled umiremo, ali, evo, živimo; kao kažnjeni smo, ali nismo pogubljeni;"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "naizgled smo žalosni, ali smo uvek radosni; naizgled siromašni, a ipak obogaćujemo mnoge; naizgled kao oni koji nemaju ništa, a ipak imaju sve."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Govorimo vam iskreno, Korinćani, srce smo širom otvorili za vas."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Naše srce nije tesno za vas, ali je vaše srce tesno za nas."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Govorim vam kao svojoj deci: proširite, zauzvrat, i vi svoja srca."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Ne vucite jaram s nevernicima"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Ne vucite jaram s nevernicima. Jer, šta ima pravednost s bezakonjem? Ili kakvo zajedništvo dele svetlo i tama?"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "U čemu se Hristos slaže s Velijarom? Ili šta je zajedničko verniku i neverniku?"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Ima li ikakve saglasnosti između Božijeg hrama i idola? Mi smo, naime, hram živoga Boga, jer Bog je rekao:",
          {
            "text": "„Ja ću živeti u njima i hoditi među njima;",
            "poem": 1
          },
          {
            "text": "ja ću biti njihov Bog,",
            "poem": 2
          },
          {
            "text": "a oni će biti moj narod.“",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Zato,",
          {
            "text": "„Izađite iz njihove sredine! Odvojte se!",
            "poem": 1
          },
          {
            "text": "– govori Gospod.",
            "poem": 2
          },
          {
            "text": "Nečistote ne dotičite,",
            "poem": 1
          },
          {
            "text": "i ja ću vas primiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ja ću vam biti Otac,",
            "poem": 1
          },
          {
            "text": "a vi ćete mi biti sinovi i ćerke",
            "poem": 2
          },
          {
            "text": "– govori Gospod Svedržitelj.“",
            "poem": 3
          }
        ]
      }
    ],
    "footnotes": []
  },
