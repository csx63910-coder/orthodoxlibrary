  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "heading",
        "content": [
          "Juda i Jerusalim osuđeni sa narodima"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Juda sabrana na pokajanje"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Saberite se! Saberite se,",
            "poem": 1
          },
          {
            "text": "o, narode koji stida nemaš,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "pre nego se osuda ostvari",
            "poem": 1
          },
          {
            "text": "i dan prođe kao pleva;",
            "poem": 2
          },
          {
            "text": "pre nego na vas dođe",
            "poem": 1
          },
          {
            "text": "plamen gneva Gospodnjeg,",
            "poem": 2
          },
          {
            "text": "pre nego na vas dođe",
            "poem": 1
          },
          {
            "text": "dan gneva Gospodnjeg.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Tražite Gospoda, o, svi ponizni u zemlji,",
            "poem": 1
          },
          {
            "text": "koji izvršavate njegove sudove.",
            "poem": 2
          },
          {
            "text": "Tražite pravednost! Tražite poniznost,",
            "poem": 1
          },
          {
            "text": "pa možda na dan gneva Gospodnjeg",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "skriveni budete.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Filisteja"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Jer Gaza će biti napuštena,",
            "poem": 1
          },
          {
            "text": "Askalon će pustoš postati,",
            "poem": 2
          },
          {
            "text": "Azotu će narod isterati u po bela dana,",
            "poem": 1
          },
          {
            "text": "a Akaron će biti iskorenjen.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Jao Herećanima,",
            "poem": 1
          },
          {
            "text": "stanovnicima primorskog kraja!",
            "poem": 2
          },
          {
            "text": "O, Hanane,",
            "poem": 1
          },
          {
            "text": "reč je Gospodnja protiv tebe,",
            "poem": 2
          },
          {
            "text": "zemljo filistejska:",
            "poem": 1
          },
          {
            "text": "„Uništiću ti svakog živog!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Primorski će kraj postati pašnjaci,",
            "poem": 1
          },
          {
            "text": "pastirske livade",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i torovi za ovce.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Zato će ovaj kraj pripasti",
            "poem": 1
          },
          {
            "text": "ostatku doma Judinog",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i po njemu će se napasati.",
            "poem": 2
          },
          {
            "text": "Uveče će legati",
            "poem": 1
          },
          {
            "text": "po kućama Askalona",
            "poem": 2
          },
          {
            "text": "jer će ih se setiti Gospod, Bog njihov,",
            "poem": 1
          },
          {
            "text": "i vratiće njihove izgnanike.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Moav i Amon"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "„Čuo sam ruganje Moavaca",
            "poem": 1
          },
          {
            "text": "i ponižavanje Amonaca.",
            "poem": 2
          },
          {
            "text": "Oni hule na moj narod,",
            "poem": 1
          },
          {
            "text": "osilili su se na njihovoj granici.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Zato, života mi moga",
            "poem": 1
          },
          {
            "text": "– govori Gospod nad vojskama,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Bog Izrailjev –",
            "poem": 2
          },
          {
            "text": "Moavci će biti kao Sodoma,",
            "poem": 1
          },
          {
            "text": "a Amonci kao Gomora:",
            "poem": 2
          },
          {
            "text": "carstvo kopriva, slana jama",
            "poem": 1
          },
          {
            "text": "i večna pustoš.",
            "poem": 2
          },
          {
            "text": "Poharaće ih ostatak mog naroda,",
            "poem": 1
          },
          {
            "text": "preostali od moga naroda će ih zaposesti.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "I ovo im je umesto njihovog ponosa,",
            "poem": 1
          },
          {
            "text": "jer su osiono ponižavali",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "narod Gospoda nad vojskama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Biće Gospod strašan prema njima",
            "poem": 1
          },
          {
            "text": "jer će pomesti sve bogove zemaljske.",
            "poem": 2
          },
          {
            "text": "Sva ostrva naroda će mu se pokloniti,",
            "poem": 1
          },
          {
            "text": "baš svako sa svog mesta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Kuš"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "„A i vi, o, Kušani,",
            "poem": 1
          },
          {
            "text": "bićete sasečeni mačem mojim!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Asirija"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Pružiće on ruku svoju na sever",
            "poem": 1
          },
          {
            "text": "i uništiće Asiriju.",
            "poem": 2
          },
          {
            "text": "Ninivu će učiniti pustarom",
            "poem": 1
          },
          {
            "text": "sprženom kao pustinja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Krda će ležati po njoj",
            "poem": 1
          },
          {
            "text": "i sve vrste životinja.",
            "poem": 2
          },
          {
            "text": "Buljina i sova",
            "poem": 1
          },
          {
            "text": "po njenim stubovima noć provode,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "huču na prozoru.",
            "poem": 2
          },
          {
            "text": "Razvaljen će biti prag",
            "poem": 1
          },
          {
            "text": "jer je on izlomio dasku od kedra.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Takav će biti oholi grad",
            "poem": 1
          },
          {
            "text": "što spokojno počiva,",
            "poem": 2
          },
          {
            "text": "koji u svom srcu kaže:",
            "poem": 1
          },
          {
            "text": "„Ja jedini i niko kao ja!“",
            "poem": 2
          },
          {
            "text": "Kako si postao pustoš,",
            "poem": 1
          },
          {
            "text": "brlog svake zveri!",
            "poem": 2
          },
          {
            "text": "Ko god mimo njega prođe zviždaće,",
            "poem": 1
          },
          {
            "text": "odmahnuće rukom.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
