  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "heading",
        "content": [
          "Jerusalim"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Jao poganom i oskrnavljenom gradu siledžiji!",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "On ne sluša glas",
            "poem": 1
          },
          {
            "text": "i ne prihvata prekor Gospodnji.",
            "poem": 2
          },
          {
            "text": "Ne pouzdaje se u Boga svoga",
            "poem": 1
          },
          {
            "text": "i ne prilazi mu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Usred njega glavari njegovi",
            "poem": 1
          },
          {
            "text": "su lavovi što riču,",
            "poem": 2
          },
          {
            "text": "sudije su mu noćni vuci",
            "poem": 1
          },
          {
            "text": "što do jutra sve kosti oglođu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Njegovi proroci su bahati,",
            "poem": 1
          },
          {
            "text": "ljudi izdajnici.",
            "poem": 2
          },
          {
            "text": "Sveštenici njegovi svetinju skrnave",
            "poem": 1
          },
          {
            "text": "i Zakon krše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Pravedan je Gospod usred njega!",
            "poem": 1
          },
          {
            "text": "On ne čini nepravdu.",
            "poem": 2
          },
          {
            "text": "Svako jutro svoju pravdu daje",
            "poem": 1
          },
          {
            "text": "i kad svane on se ne povlači.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ali zlotvor ni tad za sramotu ne zna.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Jerusalim se ne kaje"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "„Zatro sam narode",
            "poem": 1
          },
          {
            "text": "i srušio im kule.",
            "poem": 2
          },
          {
            "text": "Ulice sam im opustošio",
            "poem": 1
          },
          {
            "text": "da ni prolaznika nema.",
            "poem": 2
          },
          {
            "text": "Gradove im zarušio",
            "poem": 1
          },
          {
            "text": "i nikoga nema,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "nema stanovnika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "A rekoh:",
            "poem": 1
          },
          {
            "text": "’Svakako ćeš me se uplašiti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "prihvatićeš prekor.’",
            "poem": 2
          },
          {
            "text": "Tada mu se neće porušiti prebivalište",
            "poem": 1
          },
          {
            "text": "svim onim što sam naumio za njega.",
            "poem": 2
          },
          {
            "text": "Ipak, uporno su grešili",
            "poem": 1
          },
          {
            "text": "svim delima svojim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Zato me čekajte",
            "poem": 1
          },
          {
            "text": "– govori Gospod –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "do dana kada ću se dići zbog plena.",
            "poem": 2
          },
          {
            "text": "Jer je moja odluka da okupim narode,",
            "poem": 1
          },
          {
            "text": "da saberem carstva",
            "poem": 2
          },
          {
            "text": "i na njih izlijem svoju jarost",
            "poem": 1
          },
          {
            "text": "i sav plamen gneva svoga.",
            "poem": 2
          },
          {
            "text": "Tako će u vatri revnosti moje",
            "poem": 1
          },
          {
            "text": "sva zemlja biti progutana.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Obnova ostatka Izrailja"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Tada ću da dam narodima čista usta",
            "poem": 1
          },
          {
            "text": "da svaki od njih priziva ime Gospodnje",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i rame uz rame mu služe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "S druge strane, od reka kušanskih,",
            "poem": 1
          },
          {
            "text": "doneće mi žitne žrtve moji molioci,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ćerka mojih rasejanih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Nećeš se stideti toga dana svih svojih postupaka",
            "poem": 1
          },
          {
            "text": "kojima si se bunio protiv mene.",
            "poem": 2
          },
          {
            "text": "Tada ću ukloniti od tebe one ohole,",
            "poem": 1
          },
          {
            "text": "tvoje ponosite,",
            "poem": 2
          },
          {
            "text": "pa se više nećeš bahatiti",
            "poem": 1
          },
          {
            "text": "na mojoj svetoj gori.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "U tebi ću ostaviti",
            "poem": 1
          },
          {
            "text": "narod krotak i siromašan,",
            "poem": 2
          },
          {
            "text": "i oni će utočište naći",
            "poem": 1
          },
          {
            "text": "u imenu Gospodnjem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ostatak Izrailja neće činiti nepravdu",
            "poem": 1
          },
          {
            "text": "i laži neće govoriti.",
            "poem": 2
          },
          {
            "text": "Neće im u ustima biti jezik obmane",
            "poem": 1
          },
          {
            "text": "nego će se napasati i počivaće.",
            "poem": 2
          },
          {
            "text": "Neće biti nikog da ih plaši.“",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Kliči, ćerko sionska!",
            "poem": 1
          },
          {
            "text": "Podvikuj, Izrailju!",
            "poem": 2
          },
          {
            "text": "Raduj se i veličaj od sveg srca,",
            "poem": 1
          },
          {
            "text": "o, ćerko jerusalimska!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Uklonio je Gospod presudu protiv tebe,",
            "poem": 1
          },
          {
            "text": "pomeo je dušmane tvoje.",
            "poem": 2
          },
          {
            "text": "Car Izrailja – Gospod je u sredini tvojoj!",
            "poem": 1
          },
          {
            "text": "Od zla se ti više ne plaši.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Tog dana će se reći Jerusalimu:",
            "poem": 1
          },
          {
            "text": "„O, Sione, ne plaši se!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Neka ti ruke ne klonu!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Gospod, Bog tvoj je usred tebe,",
            "poem": 1
          },
          {
            "text": "ratnik što ti pobedu daje.",
            "poem": 2
          },
          {
            "text": "Radovaće se silno zbog tebe,",
            "poem": 1
          },
          {
            "text": "utišaće te ljubavlju svojom.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Klicaće zbog tebe radosnim povikom.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "„Ojađene, odstranjene od praznika",
            "poem": 1
          },
          {
            "text": "ja ću da okupim.",
            "poem": 2
          },
          {
            "text": "Bili su daleko od tebe,",
            "poem": 1
          },
          {
            "text": "obremenjeni sramotom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Evo, okrećem se svim tvojim tlačiteljima u vreme ovo.",
            "poem": 1
          },
          {
            "text": "Spašću hrome i sabraću proterane.",
            "poem": 2
          },
          {
            "text": "Daću čast i ime osramoćenima",
            "poem": 1
          },
          {
            "text": "što su bili po celoj zemlji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Dovešću vas u ono vreme,",
            "poem": 1
          },
          {
            "text": "u to vreme ja ću vas sabrati.",
            "poem": 2
          },
          {
            "text": "Jer ja ću vam dati i ime i čast",
            "poem": 1
          },
          {
            "text": "među svim zemaljskim narodima,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kada na vaše oči vratim izgnane vaše“ –",
            "poem": 2
          },
          {
            "text": "kaže Gospod.",
            "poem": 3
          }
        ]
      }
    ],
