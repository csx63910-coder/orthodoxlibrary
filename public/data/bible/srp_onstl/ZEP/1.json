  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Reč Gospodnja koja je došla Sofoniji, Kušijevom sinu i potomku Godolije, Amarije i Jezekije u vreme Amonovog sina Josije, cara Jude."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Sud cele zemlje na dan Gospodnji"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Zbrisaću, dokrajčiću",
            "poem": 1
          },
          {
            "text": "sve sa lica zemlje",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Dokrajčiću i čoveka i zver,",
            "poem": 1
          },
          {
            "text": "dokrajčiću ptice s neba,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ribe iz mora",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i pakosti sa sve pakosnima.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Istrebiću ljude sa lica zemlje",
            "poem": 1
          },
          {
            "text": "– govori Gospod.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Podignuću svoju ruku na Judu",
            "poem": 1
          },
          {
            "text": "i na sav živalj Jerusalima.",
            "poem": 2
          },
          {
            "text": "Istrebiću sa ovog mesta Valov ostatak",
            "poem": 1
          },
          {
            "text": "i spomen na idolopokloničke sveštenike",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "s drugim sveštenicima;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "one što se po krovovima",
            "poem": 1
          },
          {
            "text": "klanjaju vojsci nebeskoj,",
            "poem": 2
          },
          {
            "text": "one koji se klanjaju i zaklinju Gospodu",
            "poem": 1
          },
          {
            "text": "ali se zaklinju i Molohu",
            "poem": 2
          },
          {
            "noteId": 0
          },
          {
            "text": ";",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "one što se okreću od Gospoda,",
            "poem": 1
          },
          {
            "text": "one što ne traže Gospoda i za njega ne pitaju.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Tišina pred Gospodom Bogom",
            "poem": 1
          },
          {
            "text": "jer je blizu dan Gospodnji!",
            "poem": 2
          },
          {
            "text": "Spremio je Gospod žrtvu,",
            "poem": 1
          },
          {
            "text": "sazvao je goste svoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "„A na dan Gospodnje žrtve",
            "poem": 1
          },
          {
            "text": "sudiću glavare,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "careve sinove",
            "poem": 2
          },
          {
            "text": "i sve koji nose",
            "poem": 1
          },
          {
            "text": "odelo tuđinca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Kazniću sve koji toga dana",
            "poem": 1
          },
          {
            "text": "preskaču preko praga,",
            "poem": 2
          },
          {
            "text": "koji kuće svojih gospodara",
            "poem": 1
          },
          {
            "text": "pune nasiljem i prevarom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Toga će se dana čuti",
            "poem": 1
          },
          {
            "text": "– govori Gospod –",
            "poem": 2
          },
          {
            "text": "plač nevolje sa Ribljih vrata,",
            "poem": 1
          },
          {
            "text": "zapomaganje sa drugog kraja",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i velika lomljava sa brda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Kukajte, o, stanovnici Maktesa,",
            "poem": 1
          },
          {
            "text": "jer gine sav narod koji trguje,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "biće pobijeni svi koji mere srebro.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "U to vreme ću svetiljkama da pretražim Jerusalim.",
            "poem": 1
          },
          {
            "text": "Sudiću narodu poleglom ko vino po talogu svome,",
            "poem": 2
          },
          {
            "text": "koji u srcu svom govori:",
            "poem": 1
          },
          {
            "text": "’Gospod ne čini dobro, a ni zlo ne čini!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Blago će im plen postati",
            "poem": 1
          },
          {
            "text": "i opusteće im kuće.",
            "poem": 2
          },
          {
            "text": "Kuće će zidati,",
            "poem": 1
          },
          {
            "text": "ali živeti u njima neće,",
            "poem": 2
          },
          {
            "text": "sadiće vinograde,",
            "poem": 1
          },
          {
            "text": "ali vino njihovo neće piti.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Blizu je veliki dan Gospodnji!",
            "poem": 1
          },
          {
            "text": "Blizu je i sve je bliži i bliži!",
            "poem": 2
          },
          {
            "text": "Gorak je povik dana Gospodnjeg",
            "poem": 1
          },
          {
            "text": "i eno viče ratnik.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Taj dan će biti dan gneva,",
            "poem": 1
          },
          {
            "text": "dan nevolje i stradanja,",
            "poem": 2
          },
          {
            "text": "dan razaranja i pustošenja,",
            "poem": 3
          },
          {
            "text": "dan mrklog mraka,",
            "poem": 2
          },
          {
            "text": "dan oblaka i guste tame;",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "dan truba i bojnog pokliča",
            "poem": 2
          },
          {
            "text": "nad gradovima utvrđenim,",
            "poem": 1
          },
          {
            "text": "nad kulama visokim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "„Naneću bol ljudima",
            "poem": 1
          },
          {
            "text": "pa će ići kao da su slepi,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer su Gospodu sagrešili.",
            "poem": 2
          },
          {
            "text": "Prosuće se krv njihova kao prah",
            "poem": 1
          },
          {
            "text": "i kao đubrivo njihove utrobe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ni njihovo srebro ni zlato njihovo",
            "poem": 1
          },
          {
            "text": "neće moći da ih spase",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "na dan gneva Gospodnjeg.“",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Plamen njegove revnosti",
            "poem": 1
          },
          {
            "text": "proždraće svu zemlju,",
            "poem": 2
          },
          {
            "text": "jer će sigurno i strašno dokrajčiti",
            "poem": 1
          },
          {
            "text": "sav živalj zemaljski.",
            "poem": 2
          }
        ]
      }
    ],
