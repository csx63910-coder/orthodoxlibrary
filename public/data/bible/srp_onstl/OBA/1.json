  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "heading",
        "content": [
          "Avdijina vizija"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Viđenje Avdijino:",
          {
            "lineBreak": true
          },
          "Ovako Gospod Bog kaže o Edomu:",
          {
            "lineBreak": true
          },
          {
            "text": "Čuli smo vest od Gospoda",
            "poem": 1
          },
          {
            "text": "i glasnik je poslan među narode:",
            "poem": 2
          },
          {
            "text": "„Ustanite! Dignimo se u boj protiv njega!“",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Evo, učinio sam te neznatnim među narodima",
            "poem": 1
          },
          {
            "text": "i vrlo prezrenim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Drskost srca tvoga te je obmanula,",
            "poem": 1
          },
          {
            "text": "ti što živiš u raselini stene,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "stanovniče gorskih visina.",
            "poem": 2
          },
          {
            "text": "Govoriš u srcu svome:",
            "poem": 1
          },
          {
            "text": "’Ko da me dole, na zemlju sruši?!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Sve i da se ko orao vineš,",
            "poem": 1
          },
          {
            "text": "svoje gnezdo među zvezde sviješ,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "strovaliću te ja i odande",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ako ti lopovi dođu",
            "poem": 1
          },
          {
            "text": "i po noći zatirači,",
            "poem": 2
          },
          {
            "text": "zar neće nakrasti koliko im treba?",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ako ti dođu berači grožđa,",
            "poem": 1
          },
          {
            "text": "zar neće ostaviti za pabirčenje?",
            "poem": 2
          },
          {
            "text": "Ali ti ćeš biti poharan!",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "O, kako će Isava da pretresu!",
            "poem": 1
          },
          {
            "text": "Naći će mu sva skrivena blaga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Sve do granice poterali te svi tvoji saveznici.",
            "poem": 1
          },
          {
            "text": "Obmanuli su te, nadvladali te tvoji vajni prijatelji.",
            "poem": 2
          },
          {
            "text": "Ti što tvoj hleb jedu, ispod tebe kopaju ti jamu,",
            "poem": 1
          },
          {
            "text": "a ti o tome pojma nemaš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Neću li onog dana – govori Gospod –",
            "poem": 1
          },
          {
            "text": "satrti mudrace edomske",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i učene s gore Isavove?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "O, Temane, prepašće se tvoji ratnici,",
            "poem": 1
          },
          {
            "text": "svi sa gore Isavove biće pobijeni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Zbog nasilja nad Jakovom, bratom tvojim,",
            "poem": 1
          },
          {
            "text": "prekriće te stid",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i doveka satrven ćeš biti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Onog dana kada si stajao po strani,",
            "poem": 1
          },
          {
            "text": "od dana kad su mu tuđinci blago zarobili,",
            "poem": 2
          },
          {
            "text": "kad neznanci grunuše na vrata njegova",
            "poem": 1
          },
          {
            "text": "i za Jerusalim žreb bacaše,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ti si bio kao jedan od njih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Nisi smeo da posmatraš dan brata svoga,",
            "poem": 1
          },
          {
            "text": "dan njegove kobi;",
            "poem": 2
          },
          {
            "text": "nisi smeo da likuješ nad narodom Jude,",
            "poem": 1
          },
          {
            "text": "onog dana kad su razoreni,",
            "poem": 2
          },
          {
            "text": "i zlurado da se ceriš",
            "poem": 1
          },
          {
            "text": "na dan njinog jada.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Nisi smeo da prođeš kroz vrata mog naroda",
            "poem": 1
          },
          {
            "text": "u onaj dan njihove propasti.",
            "poem": 2
          },
          {
            "text": "Nisi smeo da posmatraš zlo njihovo",
            "poem": 1
          },
          {
            "text": "u taj kobni dan,",
            "poem": 2
          },
          {
            "text": "da se pružaš za njihovim blagom",
            "poem": 1
          },
          {
            "text": "na dan njinog jada.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Nisi smeo da stojiš na raskršćima,",
            "poem": 1
          },
          {
            "text": "begunce njegove da ubijaš,",
            "poem": 2
          },
          {
            "text": "da njegove izdaješ preživele",
            "poem": 1
          },
          {
            "text": "u tom danu jada.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Blizu je dan Gospodnji",
            "poem": 1
          },
          {
            "text": "svim narodima.",
            "poem": 2
          },
          {
            "text": "Šta si činio, činiće se tebi.",
            "poem": 1
          },
          {
            "text": "Obiće ti se o glavu dela tvoja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Jer, kao što ste pili na mojoj svetoj gori",
            "poem": 1
          },
          {
            "text": "i svi narodi će istrajno piti.",
            "poem": 2
          },
          {
            "text": "I piće i gutaće",
            "poem": 1
          },
          {
            "text": "i biće kao da ih nije bilo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "A na gori Sion spasenje će biti",
            "poem": 1
          },
          {
            "text": "i biće ona svetinja,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a dom će Jakovljev zaposesti posede svoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Vatra će postati dom Jakovljev,",
            "poem": 1
          },
          {
            "text": "dom Josifov biće plamen,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a dom Isavov postaće strnjika.",
            "poem": 2
          },
          {
            "text": "I spaliće ih, progutaće ih,",
            "poem": 1
          },
          {
            "text": "i neće se spasti niko",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "iz doma Isavovog.“",
            "poem": 2
          },
          {
            "text": "Jer tako kaže Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Oni iz Negeva će osvojiti goru Isavovu,",
            "poem": 1
          },
          {
            "text": "a oni iz ravnice Filisteju.",
            "poem": 2
          },
          {
            "text": "Osvojiće i područje Jefremovo i područje Samarije,",
            "poem": 1
          },
          {
            "text": "a Venijamin će osvojiti Galad.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "I izgnanici sa bedema naroda izrailjskog",
            "poem": 1
          },
          {
            "text": "naslediće zemlju Hananaca do Sarepte.",
            "poem": 2
          },
          {
            "text": "A izgnanici iz Jerusalima,",
            "poem": 1
          },
          {
            "text": "koji su u Sefardu, zaposešće gradove Negeva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "I izaći će izbavljeni na goru Sion",
            "poem": 1
          },
          {
            "text": "da sude gori Isavovoj",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i Carstvo će pripadati Gospodu.",
            "poem": 2
          }
        ]
      }
    ],
