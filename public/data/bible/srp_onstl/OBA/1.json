    "translationId": "srp_onstl",
    "name": "Knjiga proroka Avdije",
    "commonName": "Knjiga proroka Avdije",
    "title": "Knjiga proroka Avdije",
    "order": 31,
    "numberOfChapters": 1,
    "sha256": "1db7ddfe9dd5faedb1351e63161743536e1282c71eadfe55cfbf209c411e9419",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/OBA/1.json",
