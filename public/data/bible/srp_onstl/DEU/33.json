    "name": "Ponovljeni Zakon (5. Moj)",
    "commonName": "Ponovljeni Zakon (5. Moj)",
    "title": "Ponovljeni Zakon ili Peta knjiga Mojsijeva",
    "order": 5,
    "numberOfChapters": 34,
    "sha256": "7cf110d4bc48acfb66fcfb6d3b12d09845bd6f9e91fdaa6a27ee7d6c115b0e8c",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/DEU/1.json",
