  },
  "chapter": {
    "number": 33,
    "content": [
      {
        "type": "heading",
        "content": [
          "Mojsije blagosilja izrailjska plemena"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ovo je blagoslov, kojim je Mojsije, čovek Božiji, blagoslovio narod izrailjski pred svoju smrt."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Reče:",
          {
            "text": "„Siđe Gospod sa Sinaja,",
            "poem": 1
          },
          {
            "text": "sa Sira se njemu objavi,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "zablista s gore Farana,",
            "poem": 2
          },
          {
            "text": "s hiljadama svojih svetih dođe,",
            "poem": 1
          },
          {
            "text": "u desnici mu plamen Zakona.",
            "poem": 2
          },
          {
            "noteId": 13
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Da, ti voliš narode,",
            "poem": 1
          },
          {
            "text": "svi sveti njegovi u ruci su tvojoj!",
            "poem": 2
          },
          {
            "text": "Pred tvoje su noge pali,",
            "poem": 1
          },
          {
            "text": "učeći se tvojim rečima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Mojsije nam Zakon predade,",
            "poem": 1
          },
          {
            "text": "u nasledstvo zbora Jakovljeva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Neka bude cara u Ješurunu,",
            "poem": 1
          },
          {
            "text": "kad glavari se narodni sakupe,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "zajedno s plemenima Izrailjevim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Neka živi Ruvim, neka ne izumre,",
            "poem": 1
          },
          {
            "text": "nek mu uvek šačica preostane!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "A za Judu reče ovo:",
          {
            "text": "„Usliši, Gospode, glas Judin,",
            "poem": 1
          },
          {
            "text": "i dovedi ga njegovom narodu.",
            "poem": 2
          },
          {
            "text": "Nek rukama svojim pravo svoje brani,",
            "poem": 1
          },
          {
            "text": "pomoć mu budi protiv dušmana njegovih.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "A za Levija reče:",
          {
            "text": "„Tumimi i Urimi tvoji, Gospode,",
            "poem": 1
          },
          {
            "text": "pripadaju tvom vernom čoveku.",
            "poem": 2
          },
          {
            "text": "Njega si kušao kod Mase,",
            "poem": 1
          },
          {
            "text": "s njim se svađao kod voda merivskih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "On kaže o ocu svome i majci svojoj:",
            "poem": 1
          },
          {
            "text": "’Ne vidim ih!’",
            "poem": 2
          },
          {
            "text": "Braću svoju ne prepoznaje,",
            "poem": 1
          },
          {
            "text": "decu svoju ne primećuje;",
            "poem": 2
          },
          {
            "text": "jer tvoje je naredbe vršio",
            "poem": 1
          },
          {
            "text": "i tvoj savez čuvao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "On Jakova uči tvojim odredbama,",
            "poem": 1
          },
          {
            "text": "i Izrailja tvome Zakonu.",
            "poem": 2
          },
          {
            "text": "On kad prinosi tvojim nozdrvama,",
            "poem": 1
          },
          {
            "text": "i svespalnicu na tvoj žrtvenik.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Blagoslovi, Gospode, snagu njegovu,",
            "poem": 1
          },
          {
            "text": "i prihvati dela ruku njegovih.",
            "poem": 2
          },
          {
            "text": "Slomi bedra onih što ustaju na njega,",
            "poem": 1
          },
          {
            "text": "da ne ustanu više njegovi mrzitelji.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Za Venijamina reče:",
          {
            "text": "„Gospodnji je on miljenik,",
            "poem": 1
          },
          {
            "text": "spokojno kod njega počiva;",
            "poem": 2
          },
          {
            "text": "On ga štiti svakodnevno,",
            "poem": 1
          },
          {
            "text": "u naručju njegovom prebiva.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Za Josifa reče:",
          {
            "text": "„Nek Gospod blagoslovi zemlju njegovu,",
            "poem": 1
          },
          {
            "text": "obiljem rose sa nebesa,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "te vodom iz dubine što leži pod zemljom;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "obiljem plodova koje daje sunce,",
            "poem": 1
          },
          {
            "text": "obiljem uroda što daju meseci;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "prvinom drevnih gora,",
            "poem": 1
          },
          {
            "text": "i obiljem večnih brda;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "obiljem zemlje i njene punine,",
            "poem": 1
          },
          {
            "text": "dobrom voljom onog što u grmu prebiva.",
            "poem": 2
          },
          {
            "text": "Sve to nek se spusti na glavu Josifovu,",
            "poem": 1
          },
          {
            "text": "na teme posvećenog među svojom braćom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Veličanstvom je kao vo prvenac,",
            "poem": 1
          },
          {
            "text": "rogovi mu kao bivolovi.",
            "poem": 2
          },
          {
            "text": "Njima on probada narode,",
            "poem": 1
          },
          {
            "text": "sve do krajeva zemaljskih.",
            "poem": 2
          },
          {
            "text": "Takvo je mnoštvo hiljada Jefremovih,",
            "poem": 1
          },
          {
            "text": "takve su hiljade Manasijine.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Za Zavulona reče:",
          {
            "text": "„Raduj se, Zavulone, u svojim pohodima,",
            "poem": 1
          },
          {
            "text": "i ti, Isahare, u svojim šatorima!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Na planinu će pozvati narode,",
            "poem": 1
          },
          {
            "text": "da prinesu žrtve pravedne;",
            "poem": 2
          },
          {
            "text": "crpiće od obilja mora,",
            "poem": 1
          },
          {
            "text": "od blaga koje pesak krije.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "A za Gada reče:",
          {
            "text": "„Nek je blagosloven onaj",
            "poem": 1
          },
          {
            "text": "što širi granice Gadove!",
            "poem": 2
          },
          {
            "text": "Kao lav u zasedi leži,",
            "poem": 1
          },
          {
            "text": "te razdire rame i glavu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Izabrao je za sebe prvinu,",
            "poem": 1
          },
          {
            "text": "određenu za glavara.",
            "poem": 2
          },
          {
            "text": "Došao je s glavarima naroda",
            "poem": 1
          },
          {
            "text": "i pravdu Gospodnju izvršio,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i odredbe njegove s Izrailjem.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Za Dana reče:",
          {
            "text": "„Dan je lavić,",
            "poem": 1
          },
          {
            "text": "što skače iz Vasana.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Za Neftalima reče:",
          {
            "text": "„Neftalim je milošću nasićen,",
            "poem": 1
          },
          {
            "text": "i ispunjen blagoslovom Gospodnjim,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "zapad i jug on će zauzeti.",
            "poem": 2
          },
          {
            "noteId": 14
          },
          {
            "text": "“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Za Asira reče:",
          {
            "text": "„Blagosloven bio Asir među sinovima,",
            "poem": 1
          },
          {
            "text": "nek miljenik bude među svojom braćom,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i nek svoje noge u ulje umače.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Nek ti brave budu od železa i bronze,",
            "poem": 1
          },
          {
            "text": "nek ti snaga traje u sve tvoje dane.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Niko nije kao Bog Ješurunov,",
            "poem": 1
          },
          {
            "text": "koji po nebesima jezdi",
            "poem": 2
          },
          {
            "text": "da ti u pomoć stigne,",
            "poem": 1
          },
          {
            "text": "i po oblacima u svome veličanstvu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Bog iskonski tvoje je utočište,",
            "poem": 1
          },
          {
            "text": "večne mišice njegove podižu te;",
            "poem": 2
          },
          {
            "text": "on pred tobom tera tvoga dušmana,",
            "poem": 1
          },
          {
            "text": "i govori: ’Istrebi!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "U spokojstvu živi Izrailj,",
            "poem": 1
          },
          {
            "text": "izdvojen je izvor Jakovljev",
            "poem": 2
          },
          {
            "text": "u zemlji žita i mladog vina,",
            "poem": 1
          },
          {
            "text": "gde nebesa rosom dažde.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Srećan li si, Izrailju!",
            "poem": 1
          },
          {
            "text": "Ko je kao ti, narode,",
            "poem": 2
          },
          {
            "text": "koga Gospod izbavlja?",
            "poem": 1
          },
          {
            "text": "On ti je štit – tvoja odbrana,",
            "poem": 2
          },
          {
            "text": "On je mač tvoj – tvoja pobeda.",
            "poem": 1
          },
          {
            "text": "Dušmani tvoji puziće pred tobom,",
            "poem": 2
          },
          {
            "text": "a ti ćeš im po leđima gaziti.",
            "poem": 1
          },
          {
            "noteId": 15
          },
          {
            "text": "“",
            "poem": 1
          }
        ]
      }
    ],
