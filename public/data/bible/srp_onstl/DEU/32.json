  },
  "chapter": {
    "number": 32,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Čujte, nebesa, govoriću,",
            "poem": 1
          },
          {
            "text": "slušaj, zemljo, besedu usta mojih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Kao kiša neka daždi pouka moja,",
            "poem": 1
          },
          {
            "text": "kao rosa nek se spusti beseda moja,",
            "poem": 2
          },
          {
            "text": "kao pljusak na mladu travu,",
            "poem": 1
          },
          {
            "text": "kao sitna kiša na mlado bilje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jer, objaviću ime Gospodnje,",
            "poem": 1
          },
          {
            "text": "veličajte Boga našega!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "On je Stena, bez mane je delo njegovo,",
            "poem": 1
          },
          {
            "text": "jer pravedni su svi putevi njegovi.",
            "poem": 2
          },
          {
            "text": "Bog je veran, on je besprekoran,",
            "poem": 1
          },
          {
            "text": "pravedan je on i pravičan.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "A oni se iskvariše,",
            "poem": 1
          },
          {
            "text": "nisu više deca njegova,",
            "poem": 2
          },
          {
            "text": "jer srama nemaju,",
            "poem": 1
          },
          {
            "text": "naraštaj su opak i izopačen.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Zar ovako vraćaš Gospodu,",
            "poem": 1
          },
          {
            "text": "narode bezumni i nemudri?",
            "poem": 2
          },
          {
            "text": "Nije li on tvoj otac koji te je stvorio,",
            "poem": 1
          },
          {
            "text": "koji te je načinio i ojačao?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Spomenite se davnih dana,",
            "poem": 1
          },
          {
            "text": "rasudite o godinama minulih vekova.",
            "poem": 2
          },
          {
            "text": "Upitaj svog oca,",
            "poem": 1
          },
          {
            "text": "on će ti objasniti,",
            "poem": 2
          },
          {
            "text": "i svoje starešine,",
            "poem": 1
          },
          {
            "text": "oni će ti reći.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Kad je Svevišnji delio nasledstvo narodima,",
            "poem": 1
          },
          {
            "text": "kad je delio potomke ljudske,",
            "poem": 2
          },
          {
            "text": "postavio je granice narodima,",
            "poem": 1
          },
          {
            "text": "prema broju sinova Izrailjevih",
            "poem": 2
          },
          {
            "noteId": 9
          },
          {
            "text": ".",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Jer, nasledstvo Gospodnje,",
            "poem": 1
          },
          {
            "text": "narod je njegov,",
            "poem": 2
          },
          {
            "text": "Jakov je deo njegov,",
            "poem": 1
          },
          {
            "text": "njegovo je on nasledstvo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Našao ga je u zemlji pustinjskoj,",
            "poem": 1
          },
          {
            "text": "u pustari strašnoj gde ničega nema.",
            "poem": 2
          },
          {
            "text": "Branio ga je, zbrinuo ga",
            "poem": 1
          },
          {
            "text": "i zaštitio ko zenicu oka svoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Kao što orao bdi nad svojim gnezdom,",
            "poem": 1
          },
          {
            "text": "i lebdi nad svojim ptićima,",
            "poem": 2
          },
          {
            "text": "kao što širi svoja krila i uzima ih,",
            "poem": 1
          },
          {
            "text": "te ih nosi na svojim perima,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "tako ih je sam Gospod vodio;",
            "poem": 1
          },
          {
            "text": "drugog boga ne bi pored njega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Na visine ga je zemaljske posadio,",
            "poem": 1
          },
          {
            "text": "te je jeo urod sa polja,",
            "poem": 2
          },
          {
            "text": "hranio ga medom iz litice,",
            "poem": 1
          },
          {
            "text": "i uljem iz najtvrđe stene;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "maslom od stoke,",
            "poem": 1
          },
          {
            "text": "mlekom od stada,",
            "poem": 2
          },
          {
            "text": "ovnovima i jarcima vasanskim",
            "poem": 1
          },
          {
            "text": "i pšenicom ponajboljom.",
            "poem": 2
          },
          {
            "text": "Pio si vino, krv grožđa.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ugojio se Ješurun",
            "poem": 1
          },
          {
            "noteId": 10
          },
          {
            "text": ",",
            "poem": 1
          },
          {
            "text": "uzjogunio se,",
            "poem": 2
          },
          {
            "text": "usalio si se, okrupnjao i nasitio,",
            "poem": 1
          },
          {
            "text": "ostavio je Boga koji ga je načinio,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "otpao je od Stene svoga spasenja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Bogovima tuđim ljubomoru mu izazvaše,",
            "poem": 1
          },
          {
            "text": "i idolima odvratnim gnev mu raspališe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Zlodusima, a ne Bogu, žrtve su prinosili,",
            "poem": 1
          },
          {
            "text": "bogovima koje nisu poznavali,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "bogovima novim, skoro prispelim,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "koje preci vaši poznavali nisu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Zanemario si Stenu koja te je začela,",
            "poem": 1
          },
          {
            "text": "zaboravio Boga, koji te je rodio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Video je to Gospod, pa ih je odbacio,",
            "poem": 1
          },
          {
            "text": "jer sinovi ga i ćerke razgneviše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Tada reče: „Svoje lice ću od njih sakriti,",
            "poem": 1
          },
          {
            "text": "da vidim kako će svršiti;",
            "poem": 2
          },
          {
            "text": "jer naraštaj su oni izopačeni,",
            "poem": 1
          },
          {
            "text": "deca koja nemaju vernosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Na ljubomoru su me izazvali,",
            "poem": 1
          },
          {
            "text": "bogom koji Bog nije,",
            "poem": 2
          },
          {
            "text": "razgnevili me svojim ništavilima.",
            "poem": 1
          },
          {
            "text": "Zato ću ih učiniti ljubomornim",
            "poem": 2
          },
          {
            "text": "narodom koji nije narod,",
            "poem": 1
          },
          {
            "text": "razdražiću ih narodom bezumnim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Jer, moj gnev je vatru zapalio,",
            "poem": 1
          },
          {
            "text": "i goreće sve do dubina Sveta mrtvih",
            "poem": 2
          },
          {
            "noteId": 11
          },
          {
            "text": ";",
            "poem": 2
          },
          {
            "text": "progutaće i zemlju i plod njen,",
            "poem": 1
          },
          {
            "text": "spaliće temelje gorske.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Stoga, nevolje ću na njih zgrnuti,",
            "poem": 1
          },
          {
            "text": "na njih ću svoje odapeti strele.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Glad će ih poharati,",
            "poem": 1
          },
          {
            "text": "satrće ih pošasti i ljute zaraze!",
            "poem": 2
          },
          {
            "text": "Čeljusti zverske na njih ću poslati,",
            "poem": 1
          },
          {
            "text": "s otrovom gmizavaca što puze u prašini.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Napolju će mač uzimati decu,",
            "poem": 1
          },
          {
            "text": "a unutra će užas obuzimati",
            "poem": 2
          },
          {
            "text": "kako momka, tako i devojku,",
            "poem": 1
          },
          {
            "text": "kako dojenče, tako sedu glavu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Rekao bih: ’U prah ću ih smrviti,",
            "poem": 1
          },
          {
            "text": "njih ću izbrisati iz sećanja ljudi’,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "da mi nije do gnevnoga neprijatelja:",
            "poem": 1
          },
          {
            "text": "dušmani bi se njihovi mogli prevariti,",
            "poem": 2
          },
          {
            "text": "govoreći: ’Naša ih je ruka nadjačala,",
            "poem": 1
          },
          {
            "text": "sve to Gospod nije učinio.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Jer, oni su narod što nema razuma,",
            "poem": 1
          },
          {
            "text": "rasuđivanja među njima nema.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Kad bi samo bili mudri,",
            "poem": 1
          },
          {
            "text": "to bi oni razmotrili,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "shvatili bi svoj svršetak.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Zar bi jedan mogao da goni hiljadu,",
            "poem": 1
          },
          {
            "text": "i da dvojica deset hiljada poteraju,",
            "poem": 2
          },
          {
            "text": "da ih Stena njihova nije prodala,",
            "poem": 1
          },
          {
            "text": "da ih Gospod njima nije izručio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Jer, stena njihova nije kao naša Stena;",
            "poem": 1
          },
          {
            "text": "to i dušmani naši mogu da prosude.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Jer, vino njihovo,",
            "poem": 1
          },
          {
            "text": "od loze je sodomske, a sa polja gomorskih.",
            "poem": 2
          },
          {
            "text": "Grožđe je njegovo, grožđe otrovano,",
            "poem": 1
          },
          {
            "text": "grozdovi mu sama gorčina.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Vino je njihovo otrov zmijin",
            "poem": 1
          },
          {
            "text": "i ljuti je otrov aspidin.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "„Nije li on bezbedan kod mene,",
            "poem": 1
          },
          {
            "text": "zapečaćen u mojim riznicama?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Moja je osveta! Ja ću uzvratiti,",
            "poem": 1
          },
          {
            "text": "kad im noga bude posrnula.",
            "poem": 2
          },
          {
            "text": "Jer blizu je dan njihove nesreće,",
            "poem": 1
          },
          {
            "text": "propast njihova brzo se primiče.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Gospod će suditi svome narodu,",
            "poem": 1
          },
          {
            "text": "na svoje će se sluge sažaliti,",
            "poem": 2
          },
          {
            "text": "kad vidi da ih snaga napušta,",
            "poem": 1
          },
          {
            "text": "da kraj dođe robu i slobodnom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Pitaće: „Gde su sada bogovi njihovi,",
            "poem": 1
          },
          {
            "text": "gde li stena kojom se zaklanjaše?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "Jeli su salo njihovih žrtava,",
            "poem": 1
          },
          {
            "text": "i pili vino njihovih izlivnica.",
            "poem": 2
          },
          {
            "text": "Neka ustanu da vam pomognu,",
            "poem": 1
          },
          {
            "text": "nek vam oni budu zaštita.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          {
            "text": "Vidite sada da sam ja onaj,",
            "poem": 1
          },
          {
            "text": "i da drugog boga pored mene nema.",
            "poem": 2
          },
          {
            "text": "Ja usmrćujem i ja oživljujem,",
            "poem": 1
          },
          {
            "text": "ja ranjavam i ja zaceljujem;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "iz moje se ruke niko ne izbavlja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          {
            "text": "Dižem svoju ruku prema nebu i kažem:",
            "poem": 1
          },
          {
            "text": "Ne bio ja živ do veka,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          {
            "text": "ako ne naoštrim mač svoj sjajni,",
            "poem": 1
          },
          {
            "text": "da sud uzmem u svoje ruke,",
            "poem": 2
          },
          {
            "text": "da odmazdom vratim dušmanima,",
            "poem": 1
          },
          {
            "text": "i otplatim onima koji mene mrze.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          {
            "text": "Svoje strele napojiću krvlju,",
            "poem": 1
          },
          {
            "text": "mač moj naješće se mesa:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "krvlju poklanih i zarobljenih,",
            "poem": 2
          },
          {
            "text": "i dugokosim glavama",
            "poem": 1
          },
          {
            "text": "čelnika dušmanskih.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          {
            "text": "Radujte se, puci, narode njegov,",
            "poem": 1
          },
          {
            "text": "jer krv će slugu svojih osvetiti,",
            "poem": 2
          },
          {
            "text": "odmazdom će uzvratiti svojim dušmanima,",
            "poem": 1
          },
          {
            "text": "i otkupiće svoju zemlju i svoj narod.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "Mojsije dođe sa Osijom",
          {
            "noteId": 12
          },
          ", sinom Navinovim, i izgovori sve reči ove pesme na uši sveg naroda."
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "Kad je Mojsije završio da saopštava sve ove reči celom Izrailju,"
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "rekao im je: „Uzmite k srcu sve reči kojima vas upozoravam danas. Naredićeš svojoj deci da drže i vrše sve reči ovoga Zakona."
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          "Ovo nisu prazne reči; one su vaš život. Vršeći ih, dugo ćete živeti u zemlji koju ćete zauzeti kad pređete preko Jordana.“"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Napomena Mojsijeve smrti"
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          "Tog istog dana, Gospod reče Mojsiju:"
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          "„Popni se na ovu goru Avarim, goru Navav, koja je u zemlji moavskoj, kod Jerihona, i pogledaj zemlju hanansku, koju dajem sinovima Izrailjevim u nasledstvo."
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          "Tamo na gori na koju se penješ ćeš umreti i pridružiti se svome narodu, kao što je tvoj brat Aron umro na gori Or, pridruživši se svome narodu."
        ]
      },
      {
        "type": "verse",
        "number": 51,
        "content": [
          "Jer vi ste mi se izneverili pred Izrailjcima, u vreme Merive kadiske u pustinji Cin, kad niste pokazali moju svetost pred Izrailjcima."
        ]
      },
      {
        "type": "verse",
        "number": 52,
        "content": [
          "Zato ćeš samo izdaleka videti zemlju, ali u tu zemlju, koju dajem narodu izrailjskom, nećeš ući.“"
        ]
      }
    ],
