  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "heading",
        "content": [
          "Nadglednici"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ovo je istina: ako neko želi da bude nadglednik, dobru službu želi."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Nadglednik, naime treba da bude besprekoran, oženjen jednom ženom, trezven, razborit, poštovan, gostoljubiv, kadar da poučava."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "On ne sme da bude pijanica ili nasilnik, nego blag, ne svađalica, i ne pohlepan na novac."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Takođe treba da dobro upravlja svojom porodicom, i da ima poslušnu decu koja ga u potpunosti poštuju."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Jer ako neko ne zna da upravlja svojim domom, kako će se brinuti o Crkvi Božijoj?"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Nadglednik ne sme da bude novoobraćenik, da se ne bi uzoholio, te pao pod Božiju osudu, kao đavo."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Uz to treba da bude poštovan i od ljudi izvan Crkve, da se ne osramoti te upadne u đavolsku zamku."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Đakoni"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Isto tako i đakoni treba da budu čestiti, a ne dvolični, ne koji su skloni opijanju, ne gramzivi."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Oni treba da čistom savešću slede veru koju je Bog otkrio."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Đakone najpre treba proveriti, pa tek onda, ako se pokažu besprekornima, poveriti im službu."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Njihove žene takođe treba da budu čestite, a ne sklone ogovaranju, trezvene, u svemu verne."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Đakoni treba da imaju samo jednu ženu, i da dobro upravljaju svojom decom i porodicom."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Naime, oni koji dobro obavljaju đakonsku službu, stiču sebi dobar ugled, i priliku da slobodno govore o svojoj veri u Hrista Isusa."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Pišem ti ovo u nadi da ću uskoro doći k tebi."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Ali ako okasnim, ti znaš kako treba da se vladaš u Božijem domu, koji je Crkva živoga Boga, stub i uporište istine."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Nesumnjivo, tajna pobožnosti je velika:",
          {
            "text": "On",
            "poem": 1
          },
          {
            "noteId": 1
          },
          {
            "text": "se pojavi u telu,",
            "poem": 1
          },
          {
            "text": "Duhom se pokaza pravednim,",
            "poem": 2
          },
          {
            "text": "anđeli ga videše,",
            "poem": 1
          },
          {
            "text": "narodima bi propovedan.",
            "poem": 2
          },
          {
            "text": "Ljudi u njega poverovaše,",
            "poem": 1
          },
          {
            "text": "i u slavu bi vaznet.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 1,
        "caller": "+",
        "text": "3,16 U mnogim manuskriptima stoji Bog.",
