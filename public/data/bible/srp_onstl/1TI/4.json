  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "heading",
        "content": [
          "Upozorenje protiv lažnih učitelja"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Duh izričito govori da će u poslednja vremena neki odstupiti od vere, i povesti se za duhovima prevare i za učenjima zlih duhova."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Ova učenja šire licemerni lažljivci, čija je savest otupela."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Oni zabranjuju stupanje u brak, i govore da se treba uzdržavati od jelâ, koja je Bog stvorio da ih sa zahvalnošću uzimaju oni koji veruju i poznaju istinu."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Naime, sve što je Bog stvorio dobro je, i ništa što se uzima sa zahvalnošću ne treba odbacivati,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "jer se uz Božiju reč i molitvu posvećuje Bogu."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Dobar sluga Isusa Hrista"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ako ovome budeš poučavao braću i sestre, bićeš dobar sluga Hrista Isusa, hranjen rečima vere i dobrog učenja za kojim si pošao."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Kloni se bezbožnih i bapskih priča. Vežbaj se u pobožnosti."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Jer telesno vežbanje donosi malu korist, a pobožnost je dobra za sve, jer u sebi nosi obećanje i za sadašnji i za budući život."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Ova poruka je istinita i vredna da je svi prihvate."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Zbog ovoga se trudimo i borimo, jer smo se pouzdali u živoga Boga, koji je Spasitelj svih ljudi, naročito onih verujućih."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ovo zapovedaj i naučavaj."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Neka te niko ne prezire zbog tvoje mladosti, nego budi uzor vernima u govoru, vladanju, ljubavi, veri, i čistoti."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Dok ne dođem, posveti se čitanju, savetovanju i poučavanju."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Ne zanemaruj milosni dar koji si dobio po proroštvu, nakon što su starešine položile ruke na tebe."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Ovo upražnjavaj, tome se posveti, da bi tvoj napredak postao svima očigledan."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Pazi na samoga sebe i na poučavanje, jer čineći ovo, spašćeš i sebe i one koji te slušaju."
        ]
      }
    ],
