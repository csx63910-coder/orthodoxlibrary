  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Pre svega, molim vas da se prošnje, molitve, molbe i zahvaljivanja prinose za sve ljude;"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "za careve, i za sve koji su na vlasti, da proživimo tih i spokojan život u svakovrsnoj pobožnosti i čestitosti."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Ovo je dobro i ugodno Bogu, našem Spasitelju,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "koji hoće da se svi ljudi spasu, i da upoznaju istinu."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Jer jedan je Bog, i jedan je posrednik između Boga i ljudi – čovek Isus Hristos."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "On je dao svoj život kao otkup za sve ljude, što je bilo posvedočeno u pravo vreme."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Zato me je Bog postavio za vesnika i apostola, kao i za učitelja mnogobožaca u veri i istini. Ne lažem, nego govorim istinu!"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Želim, dakle, da se posvećeni ljudi svuda mole, podižući ruke bez gneva i rasprave."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Takođe, žene neka se uzorno oblače, kraseći se čednošću i razboritošću, a ne pletenicama, zlatom, biserjem ili raskošnom odećom."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Umesto toga, neka čine dobra dela, kao što priliči ženama koje ispovedaju pobožnost."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Žene neka se poučavaju u tišini i potpunoj pokornosti."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Takođe im ne dopuštam da poučavaju, niti da vladaju nad mužem, nego da budu mirne."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Jer je prvo stvoren Adam, pa onda Eva."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "I nije Adam taj koji je bio prevaren; Eva je bila prevarena, te je prestupila Božiju zapovest."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Ipak, spašće se",
          {
            "noteId": 0
          },
          "rađanjem dece, ako smerno ostanu u veri, ljubavi i posvećenju."
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 0,
        "caller": "+",
        "text": "2,15 Reč koju je apostol Pavle upotrebio ovde najverovatnije znači da će žena biti sačuvana, to jest, da joj rađanje dece neće nauditi.",
        "reference": {
          "chapter": 2,
          "verse": 15
        }
      }
    ]
