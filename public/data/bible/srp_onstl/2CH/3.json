  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "heading",
        "content": [
          "Solomon zida Dom Gospodnji"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Solomon je počeo da zida Dom Gospodnji u Jerusalimu, na brdu Moriji, gde se Gospod objavio njegovom ocu Davidu. To je mesto David već pripremio na gumnu Jevusejca Orne."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "On je počeo da zida drugog dana, drugog meseca, četvrte godine svoje vladavine."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "I postavi temelje Solomon za Dom Gospodnji, po starim merama u dužinu šezdeset lakata a u širinu dvadeset lakata.",
          {
            "noteId": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Trem se nalazio s pročelja Doma i odgovarao je njegovoj širini – dvadeset lakata",
          {
            "noteId": 3
          },
          "– a bio je visok stotinu dvadeset lakata.",
          {
            "noteId": 4
          },
          "Iznutra je bio obložen čistim zlatom."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Najveće površine Doma je obložio čempresovim drvetom i čistim zlatom, a svodove ukrasio palmama i lancima."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Radi lepote, Dom je ukrasio dragim kamenjem i zlatom iz Parvaima."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Zlatom obloži i grede, pragove, zidove, vrata, a na zidovima je izrezbario zlatne heruvime."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "U Domu je, po njegovoj dužini sazidao Svetinju nad svetinjama. Njena dužina i širina su bili dvadeset lakata",
          {
            "noteId": 5
          },
          ". Obložio ju je sa šest stotina talanata",
          {
            "noteId": 6
          },
          "čistog zlata."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Pozlaćeni ekseri su težili pedeset šekela,",
          {
            "noteId": 7
          },
          "a i gornje prostorije je obložio zlatom."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "U Svetinji nad svetinjama umetnici su izlili dva heruvima i obložili ih zlatom."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Krila heruvima su bila duga dvadeset lakata, a svako od njih pet lakata",
          {
            "noteId": 8
          },
          ". Prvi je jednim krilom doticao krilo drugog, a drugim krilom zid odaje."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "I drugi je krilom, pet lakata",
          {
            "noteId": 9
          },
          "dugim, doticao zid, a drugim se spajao sa isto toliko dugim krilom prvog."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Dvadeset lakata",
          {
            "noteId": 10
          },
          "u dužinu imaju krila kad su raširena, a heruvimi su stajali na nogama licem okrenuti prema Domu."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Sašio je zavesu od raskošnog grimiznog i skerletnog platna, od finog lana i izvezao po njemu heruvime."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Ispred Doma je podigao dva stuba visoka trideset pet lakata, koji su na vrhu imali pet lakata duga oglavlja",
          {
            "noteId": 11
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Postavio je lance u Svetinji nad svetinjama i njima opleo vrh stubova, a lance je ukrasio sa stotinu narova."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Stubove je postavio ispred Doma, jedan s leve, a drugi s desne strane. Desnog je nazvao Jakin a levog Voaz."
        ]
      }
    ],
