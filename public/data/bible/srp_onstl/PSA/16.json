  "chapter": {
    "number": 16,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Davidova pesma pouzdanja u Boga."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Čuvaj me, o, Bože,",
            "poem": 1
          },
          {
            "text": "jer u tebi je utočište moje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Kažem Gospodu:",
            "poem": 1
          },
          {
            "text": "„Ti si moj Gospod,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "bez tebe mi nema dobra.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Uzvišeni su sveti u zemlji,",
            "poem": 1
          },
          {
            "text": "u njima mi je sva milina.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Mnoge muke stižu one,",
            "poem": 1
          },
          {
            "text": "što za drugim bogovima hrle.",
            "poem": 2
          },
          {
            "text": "Zato neću njima krvne žrtve liti,",
            "poem": 1
          },
          {
            "text": "niti će mi usne prizivati im ime.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Gospod mi je baština, moja čaša;",
            "poem": 1
          },
          {
            "text": "ti čvrsto držiš moj deo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Zemlja mi je dana na prijatnom mestu;",
            "poem": 1
          },
          {
            "text": "kako li je divna moja baština!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Blagosiljam Gospoda koji me savetuje,",
            "poem": 1
          },
          {
            "text": "i u noćno doba opominje me nutrina.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Gospod mi je uvek pred očima.",
            "poem": 1
          },
          {
            "text": "Pošto mi je on sa desne strane,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ništa mene uzdrmati neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Zato mi je srce ushićeno,",
            "poem": 1
          },
          {
            "text": "a biće moje tome se raduje;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "celo moje telo počiva spokojno,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "što mi dušu nećeš prepustiti Svetu mrtvih,",
            "poem": 1
          },
          {
            "text": "niti dati da tvoj verni truli.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Stazu života ti si mi otkrio,",
            "poem": 1
          },
          {
            "text": "pun radosti pred tobom ću biti.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Večne su divote u tvojoj desnici!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
