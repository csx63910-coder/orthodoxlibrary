  "chapter": {
    "number": 36,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Sluge Gospodnjeg Davida."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Prestup progovara iz srca opakog,",
            "poem": 1
          },
          {
            "text": "za strah Božiji oči mu ne znaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Jer on laska sebi",
            "poem": 1
          },
          {
            "text": "i očima svojim ne nalazi svoju krivicu da bi je mrzeo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Zlobne su i zavodljive reči njegovih usta,",
            "poem": 1
          },
          {
            "text": "prestao je da pokazuje mudrost, da čini dobro.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "On zlobu smišlja na postelji svojoj,",
            "poem": 1
          },
          {
            "text": "predao se putu nevaljalom,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "zla se ne odriče.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "O, Gospode, milost ti je do nebesa,",
            "poem": 1
          },
          {
            "text": "a vernost ti je do oblaka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Pravednost je tvoja poput gore Božije,",
            "poem": 1
          },
          {
            "text": "a tvoja je pravda dubina golema.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ti, Gospode, čuvaš i ljude i zveri.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Kako je skupocena milost tvoja, Bože,",
            "poem": 1
          },
          {
            "text": "potomci ljudi u senci krila tvojih utočište nalaze.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Site se izobiljem tvoga Doma,",
            "poem": 1
          },
          {
            "text": "napajaš ih rekom tvojih dobara.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Jer u tebi je vrelo života,",
            "poem": 1
          },
          {
            "text": "u tvom svetlu mi vidimo svetlo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Milost svoju pruži onima koji te poznaju,",
            "poem": 1
          },
          {
            "text": "i pravednost svoju onima srca čestitoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Noga ponosita nek mi ne prilazi,",
            "poem": 1
          },
          {
            "text": "ruka zlikovaca nek me ne protera.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Eno, padoše oni koji rade zlobno,",
            "poem": 1
          },
          {
            "text": "srušeni su i dići se neće moći.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
