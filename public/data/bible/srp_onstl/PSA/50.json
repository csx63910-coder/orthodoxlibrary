  "chapter": {
    "number": 50,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Psalam Asafov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Gospod, Bog Svevišnji, govori,",
            "poem": 1
          },
          {
            "text": "doziva zemlju od izlaska sunca",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pa do njegovog zalaska.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Od Siona, savršeno lepog,",
            "poem": 1
          },
          {
            "text": "Bog je zablistao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Dolazi naš Bog i ćutati neće;",
            "poem": 1
          },
          {
            "text": "pred njim plamen guta,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "oko njega buči nepogoda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "On s visina poziva nebesa,",
            "poem": 1
          },
          {
            "text": "a i zemlju, da sudi svom narodu:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "„Okupite mi moj verni narod",
            "poem": 1
          },
          {
            "text": "što uz žrtvu savez sa mnom sklopi.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Nebesa javljaju njegovu pravednost;",
            "poem": 1
          },
          {
            "text": "jer je sam Bog sudija. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "„Čuj, moj narode, govoriću,",
            "poem": 1
          },
          {
            "text": "o, Izrailju, protiv tebe svedočiću;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ja sam Bog, tvoj Bog jesam.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ne korim te zbog tvojih žrtava",
            "poem": 1
          },
          {
            "text": "i tvojih svespalnica što su stalno preda mnom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ne primam bika iz tvoje štale",
            "poem": 1
          },
          {
            "text": "i jarce iz tvojih stada.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Jer moja je svaka šumska životinja,",
            "poem": 1
          },
          {
            "text": "stoka sa hiljadu gora.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Svaka gorska ptica meni je poznata,",
            "poem": 1
          },
          {
            "text": "pripada mi što po polju miče.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Da ogladnim, ne bih tebi kazao;",
            "poem": 1
          },
          {
            "text": "jer su moji i svet i šta ga ispunjava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Jedem li ja meso bikova",
            "poem": 1
          },
          {
            "text": "i pijem li krv jaraca?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Žrtvuj Bogu zahvalnicu,",
            "poem": 1
          },
          {
            "text": "ispuni Svevišnjem zavete svoje;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "pozovi me u danu nevolje;",
            "poem": 1
          },
          {
            "text": "izbaviću te, a ti ćeš me proslaviti.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "A zlikovcu govori Bog:",
          {
            "text": "„Zašto propise moje recituješ",
            "poem": 1
          },
          {
            "text": "i moj savez uzimaš u usta?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ti, koji mrziš ukor,",
            "poem": 1
          },
          {
            "text": "i moje si reči odbacio od sebe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Kad vidiš lopova, s njim pod ruku ideš,",
            "poem": 1
          },
          {
            "text": "ortačiš s preljubnicima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Zlu prepuštaš usta svoja,",
            "poem": 1
          },
          {
            "text": "jezik ti se s klevetom upleo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Sediš i ocrnjuješ brata svoga,",
            "poem": 1
          },
          {
            "text": "sina majke svoje ogovaraš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Takve stvari si činio,",
            "poem": 1
          },
          {
            "text": "a ja sam ćutao;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "zamišljao si me sebi ravnim;",
            "poem": 2
          },
          {
            "text": "a ja ću te ukoriti,",
            "poem": 1
          },
          {
            "text": "slučaj svoj ti redom predočiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Razmislite o ovome,",
            "poem": 1
          },
          {
            "text": "vi što Boga zaboravljate;",
            "poem": 2
          },
          {
            "text": "ili ću vas rastrgnuti,",
            "poem": 1
          },
          {
            "text": "i neće biti izbavitelja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Mene slavi ko žrtvuje zahvalnicu;",
            "poem": 1
          },
          {
            "text": "ko se puta drži",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pokazaću mu Božije spasenje.“",
            "poem": 2
          }
        ]
      }
    ],
