  "chapter": {
    "number": 67,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi, uz žičane instrumente. Psalam. Pesma."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Smilovao nam se Bog i blagoslovio nas,",
            "poem": 1
          },
          {
            "text": "licem svojim obasjao nas; Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "da bi se na zemlji znalo za put tvoj,",
            "poem": 1
          },
          {
            "text": "za spasenje tvoje u svim narodima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Nek te hvale narodi, o, Bože,",
            "poem": 1
          },
          {
            "text": "nek te hvale svi narodi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Neka se raduju i nek se vesele ljudi,",
            "poem": 1
          },
          {
            "text": "jer pravedno sudiš narodima",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i vodiš ljude na zemlji. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Nek te hvale narodi, o, Bože,",
            "poem": 1
          },
          {
            "text": "nek te hvale svi narodi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Zemlja rađa svojim plodovima;",
            "poem": 1
          },
          {
            "text": "blagoslovio nas Bog, Bog naš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Blagoslovio nas Bog",
            "poem": 1
          },
          {
            "text": "da bi ga se bojali svi krajevi zemlje.",
            "poem": 2
          }
        ]
      }
    ],
