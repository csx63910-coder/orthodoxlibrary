  "chapter": {
    "number": 69,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Napev: „Ljiljani“. Davidov"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Spasi me, o, Bože,",
            "poem": 1
          },
          {
            "text": "dođoše do grla vode!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Potonuo sam u blato duboko,",
            "poem": 1
          },
          {
            "text": "a nigde oslonca;",
            "poem": 2
          },
          {
            "text": "dospeo sam u vode duboke,",
            "poem": 1
          },
          {
            "text": "bujica me zahvatila.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Klonuo sam zovući te,",
            "poem": 1
          },
          {
            "text": "promuče mi grlo;",
            "poem": 2
          },
          {
            "text": "oči su mi usahnule",
            "poem": 1
          },
          {
            "text": "čekajući Boga moga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Brojniji su ti što me bez razloga mrze",
            "poem": 1
          },
          {
            "text": "od kose na glavi mojoj,",
            "poem": 2
          },
          {
            "text": "ti moćnici što bi da me zbrišu,",
            "poem": 1
          },
          {
            "text": "bezrazložni protivnici.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Vraćam, a ukrao nisam.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ludost moju ti poznaješ, Bože;",
            "poem": 1
          },
          {
            "text": "gresi moji skriveni ti nisu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Neka se zbog mene ne postide oni",
            "poem": 1
          },
          {
            "text": "koji u tebe nadu svoju polažu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Gospode, Bože nad vojskama.",
            "poem": 2
          },
          {
            "text": "Neka se zbog mene ne osramote oni",
            "poem": 1
          },
          {
            "text": "koji te traže,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Bože Izrailjev.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Jer ja zbog tebe trpim prezir,",
            "poem": 1
          },
          {
            "text": "lice moje prekrila je bruka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Braći svojoj neznanac postadoh,",
            "poem": 1
          },
          {
            "text": "tuđinac sam deci moje majke.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Izjeda me revnost za tvoj Dom.",
            "poem": 1
          },
          {
            "text": "Uvrede onih koji tebe vređaju,",
            "poem": 2
          },
          {
            "text": "pale su na mene.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Plakao sam i postio,",
            "poem": 1
          },
          {
            "text": "i to mi je na prezir bilo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Za odeću sebi kostret ogrnuh,",
            "poem": 1
          },
          {
            "text": "i postadoh ruglo za njih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "O meni pričaju oni što sede na gradskim vratima",
            "poem": 1
          },
          {
            "text": "i pevaju pesme pijanice.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "A ja se samo tebi molim, o, Gospode,",
            "poem": 1
          },
          {
            "text": "u vreme povoljno;",
            "poem": 2
          },
          {
            "text": "Bože, usliši me po obilnom tvome smilovanju,",
            "poem": 1
          },
          {
            "text": "po vernosti svog spasenja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Iz blata me oslobodi,",
            "poem": 1
          },
          {
            "text": "ne daj da potonem;",
            "poem": 2
          },
          {
            "text": "oslobodi me od onih što me mrze,",
            "poem": 1
          },
          {
            "text": "od dubokih voda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Bujica vode nek me ne zahvati,",
            "poem": 1
          },
          {
            "text": "nek me ne proguta dubina",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i ždrelo njeno nada mnom ne zatvori se.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Usliši me, Gospode,",
            "poem": 1
          },
          {
            "text": "jer je dobra milost tvoja;",
            "poem": 2
          },
          {
            "text": "po golemom milosrđu svome",
            "poem": 1
          },
          {
            "text": "na mene se osvrni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Lice svoje od svog sluge ne sakrivaj,",
            "poem": 1
          },
          {
            "text": "jer sam na mukama;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pohitaj, usliši me.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Priđi bliže duši mojoj, otkupi je;",
            "poem": 1
          },
          {
            "text": "radi mojih protivnika, izbavi me.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ti znaš da sam prezren, osramoćen i obrukan;",
            "poem": 1
          },
          {
            "text": "pred tobom su svi dušmani moji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Prezir mi je srce slomio,",
            "poem": 1
          },
          {
            "text": "razboleh se;",
            "poem": 2
          },
          {
            "text": "žudeo sam za utehom –",
            "poem": 1
          },
          {
            "text": "nikog niotkuda;",
            "poem": 2
          },
          {
            "text": "za utešiteljima –",
            "poem": 1
          },
          {
            "text": "našao ih nisam.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Pelen su mi u hranu stavili,",
            "poem": 1
          },
          {
            "text": "sirće su mi žednom dali da pijem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Nek im sto postane zamka,",
            "poem": 1
          },
          {
            "text": "odmazda i klopka;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "nek im oči potamne, da ne vide,",
            "poem": 1
          },
          {
            "text": "i leđa im se zauvek pogrbe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Srdžbu svoju na njih izlij,",
            "poem": 1
          },
          {
            "text": "jarka ljutnja tvoja neka ih sustigne.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Tabor nek im opustoši;",
            "poem": 1
          },
          {
            "text": "ne živeo niko u njihovim šatorima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Jer oni gone one što si udario",
            "poem": 1
          },
          {
            "text": "i javljaju jade onih koje si ranio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Krivicu im na krivicu dodaj,",
            "poem": 1
          },
          {
            "text": "da ne uđu u pravednost tvoju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Izbrisani bili iz Knjige života,",
            "poem": 1
          },
          {
            "text": "da sa pravednima ne budu zapisani.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "A ja sam siromah, u bolovima sam;",
            "poem": 1
          },
          {
            "text": "spasenje tvoje, Bože, neka me zaštiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Ime Božije pesmom ću da slavim,",
            "poem": 1
          },
          {
            "text": "veličaću ga hvalospevom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "To će biti Gospodu milije od vola",
            "poem": 1
          },
          {
            "text": "i od bika, rogatog papkara.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Videće to ponizni,",
            "poem": 1
          },
          {
            "text": "radovaće se;",
            "poem": 2
          },
          {
            "text": "vi, što Boga tražite,",
            "poem": 1
          },
          {
            "text": "nek vam srce bude živo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Jer uboge Gospod čuje,",
            "poem": 1
          },
          {
            "text": "ne prezire zatočene svoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Nek ga slave nebesa, zemlja, mora",
            "poem": 1
          },
          {
            "text": "i sve što se u njima kreće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Jer Sion će Bog da spase,",
            "poem": 1
          },
          {
            "text": "sazidaće judejske gradove;",
            "poem": 2
          },
          {
            "text": "i oni će ih zaposesti",
            "poem": 1
          },
          {
            "text": "i živeće tamo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "I potomci njegovih sluga",
            "poem": 1
          },
          {
            "text": "to će da naslede,",
            "poem": 2
          },
          {
            "text": "i oni što ime njegovo vole",
            "poem": 1
          },
          {
            "text": "boraviće tamo.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
