  "chapter": {
    "number": 89,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Poučna pesma Etan Ezraita."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "O milosti Gospodnjoj ja doveka pevam;",
            "poem": 1
          },
          {
            "text": "ustima svojim vernost tvoju razglašavam",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "naraštaju svakom!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Jer rekao sam: „Doveka je milost čvrsta,",
            "poem": 1
          },
          {
            "text": "vernost ti je postavljena u nebesa.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "A ti: „Savez sam sklopio sa izabranikom svojim,",
            "poem": 1
          },
          {
            "text": "zakleo se svom sluzi Davidu:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "’Potomstvo ću tvoje doveka da učvrstim,",
            "poem": 1
          },
          {
            "text": "tvoj će presto da potraje kroz pokolenje svako!’“ Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "O, Gospode, nebesa slave čudesa tvoja",
            "poem": 1
          },
          {
            "text": "i tvoju vernost u zboru svetih!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Jer ko je taj na nebu da je Gospodu nalik,",
            "poem": 1
          },
          {
            "text": "da je kao Gospod među sinovima Božijim?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Bog je veličanstven na saboru svetih,",
            "poem": 1
          },
          {
            "text": "strašniji je od svih što ga okružuju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Gospode, Bože nad vojskama,",
            "poem": 1
          },
          {
            "text": "ko je poput tebe moćan Gospod?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Vernošću si svojom obavijen.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ti upravljaš morem ponositim,",
            "poem": 1
          },
          {
            "text": "ti mu spuštaš talase nemirne.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Skršio si Ravu kao da je zaklan,",
            "poem": 1
          },
          {
            "text": "dušmane si svoje rasterao silom ruke svoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Tvoja su nebesa, baš kao i zemlja;",
            "poem": 1
          },
          {
            "text": "svet i ono što ga čini ti si postavio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Jug i sever ti si načinio,",
            "poem": 1
          },
          {
            "text": "i Tavor i Ermon tvom imenu kliču.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Mišica je tvoja jaka, ruka ti je moćna,",
            "poem": 1
          },
          {
            "text": "desnica je tvoja podignuta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Tvog prestola temelji su pravednost i pravda;",
            "poem": 1
          },
          {
            "text": "milost i istina idu ispred tvoga lica.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Blago narodu kome je klicanje znano,",
            "poem": 1
          },
          {
            "text": "koji živi u svetlosti lica tvoga, o, Gospode!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Imenu se tvome oni povazdan raduju,",
            "poem": 1
          },
          {
            "text": "pravednošću tvojom oni se uzdižu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Jer ti si slava njihove jakosti,",
            "poem": 1
          },
          {
            "text": "naklonošću tvojom naš se rog",
            "poem": 2
          },
          {
            "noteId": 7
          },
          {
            "text": "uzdiže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Jer naš je štit od Gospoda,",
            "poem": 1
          },
          {
            "text": "naš je car od Svetitelja Izrailjevog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Tada si u viđenju govorio",
            "poem": 1
          },
          {
            "text": "svom vernom narodu i rekao:",
            "poem": 2
          },
          {
            "text": "„Svoju pomoć dao sam junaku,",
            "poem": 1
          },
          {
            "text": "izabranog iz naroda digoh.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Našao sam Davida, slugu svoga,",
            "poem": 1
          },
          {
            "text": "uljem svojim svetim pomazao sam ga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Na njemu će moja ruka da počiva,",
            "poem": 1
          },
          {
            "text": "mišica će moja da ga jača.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Neće ga varati neprijatelj,",
            "poem": 1
          },
          {
            "text": "neće mu nauditi nepravednik.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Izlomiću pred njim dušmane njegove,",
            "poem": 1
          },
          {
            "text": "i potući one što ga mrze.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Moja vernost i milost moja biće sa njim,",
            "poem": 1
          },
          {
            "text": "u moje će se ime podići rog njegov.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Njegovu ću ruku dignuti na more",
            "poem": 1
          },
          {
            "text": "i na reke desnicu njegovu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "A on će me zvati: ’Oče moj, Bože moj,",
            "poem": 1
          },
          {
            "text": "Steno mog spasenja!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "A ja ću ga postaviti za prvorođenog,",
            "poem": 1
          },
          {
            "text": "za najuzvišenijeg među carevima zemlje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Doveka ću mu očuvati milost svoju",
            "poem": 1
          },
          {
            "text": "i svoj ću savez da učvrstim sa njim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Doveka ću da učvrstim potomstvo njegovo,",
            "poem": 1
          },
          {
            "text": "presto njegov biće dok je dana nebu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "A ako sinovi njegovi moj Zakon napuste",
            "poem": 1
          },
          {
            "text": "i ne žive po mojim uredbama;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "ako prekrše odredbe moje",
            "poem": 1
          },
          {
            "text": "i zapovesti moje ne drže;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "kazniću im prestupe šibom",
            "poem": 1
          },
          {
            "text": "i krivicu udarcima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Ali milost svoju nikad neću da im uzmem,",
            "poem": 1
          },
          {
            "text": "vernost svoju neću da poreknem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Neću da pogazim svoj savez,",
            "poem": 1
          },
          {
            "text": "neću da poreknem ono što ustima obećao sam.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Jednom sam se zakleo Davidu svetošću svojom",
            "poem": 1
          },
          {
            "text": "i poreći neću!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Potomstvo će njegovo doveka da traje",
            "poem": 1
          },
          {
            "text": "i preda mnom poput sunca presto njegov;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "kao mesec zauvek će potrajati,",
            "poem": 1
          },
          {
            "text": "poput neba svedok verni.“ Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "A sada si ga svrgnuo, zgrozio se",
            "poem": 1
          },
          {
            "text": "i razjario na svog pomazanika;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          {
            "text": "Porekao si savez sa slugom svojim,",
            "poem": 1
          },
          {
            "text": "u prašini mu krunu oskrnavio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          {
            "text": "Zarušio si mu sve zidine",
            "poem": 1
          },
          {
            "text": "i utvrđenja mu u ruine pretvorio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          {
            "text": "Haraju ga svi što putem prođu,",
            "poem": 1
          },
          {
            "text": "komšijama svojim postao je ruglo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          {
            "text": "Digao si desnicu dušmana njegovih,",
            "poem": 1
          },
          {
            "text": "krvnika njegovog ti činiš veselim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          {
            "text": "Još si mu oštricu mača otupio,",
            "poem": 1
          },
          {
            "text": "u boju mu pomogao nisi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          {
            "text": "Njegov sjaj si okončao,",
            "poem": 1
          },
          {
            "text": "srušio mu presto u prašinu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          {
            "text": "Skratio si dane mladosti njegove",
            "poem": 1
          },
          {
            "text": "i zagrnuo ga sramotom. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          {
            "text": "O, Gospode, dokle ćeš se kriti?",
            "poem": 1
          },
          {
            "text": "Doveka ti srdžba kao vatra bukti?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          {
            "text": "Priseti se dužine mog života.",
            "poem": 1
          },
          {
            "text": "Zar uzalud stvorio si sve potomke ljudi?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          {
            "text": "Ko je čovek koji je živeo, a da smrti ugledao nije?",
            "poem": 1
          },
          {
            "text": "Iz ruku Sveta mrtvih ko je život izbavio? Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          {
            "text": "O, Gospode, gde su tvoja milosrđa davna",
            "poem": 1
          },
          {
            "text": "kojima si se u vernosti svojoj zakleo Davidu?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          {
            "text": "Seti se, o, Gospode, sramoćenja svojih slugu,",
            "poem": 1
          },
          {
            "text": "koja nosim u nedrima od naroda mnogih!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 51,
        "content": [
          {
            "text": "Gospode, njima su nas sramotili protivnici tvoji;",
            "poem": 1
          },
          {
            "text": "njima su sramotili korake tvog pomazanika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 52,
        "content": [
          {
            "text": "Blagosloven doveka da je Gospod!",
            "poem": 1
          },
          "Amin! Amin!"
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 7,
        "caller": "+",
        "text": "89,17 Rog je simbol, metafora vojne snage, dostojanstva.",
        "reference": {
          "chapter": 89,
          "verse": 17
        }
      }
    ]
