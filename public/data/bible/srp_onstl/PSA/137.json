  "chapter": {
    "number": 137,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Sedeli smo tamo, pored reka Vavilona",
            "poem": 1
          },
          {
            "text": "i plakali kad bi se setili Siona.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "O tamošnje smo vrbe",
            "poem": 1
          },
          {
            "text": "povešali harfe svoje,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "jer su naši tlačitelji od nas zahtevali pesmu;",
            "poem": 1
          },
          {
            "text": "mučitelji naši da se veselimo:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Pevajte nam pesmu o Sionu!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Kako da pevamo Gospodnju pesmu",
            "poem": 1
          },
          {
            "text": "u tuđinskoj zemlji?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "O, Jerusalime, ako bih tebe zaboravio,",
            "poem": 1
          },
          {
            "text": "zaboravljena bila i desnica moja!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Jezik mi se za nepce slepio",
            "poem": 1
          },
          {
            "text": "ako te se ne setio,",
            "poem": 2
          },
          {
            "text": "ako se ne radovao Jerusalimu",
            "poem": 1
          },
          {
            "text": "više nego i najboljem svome!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "O, Gospode, seti se Edomaca",
            "poem": 1
          },
          {
            "text": "što su na dan pada Jerusalima govorili:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Razvaljujte! Razvaljujte ga do temelja!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "O, ćerko vavilonska,",
            "poem": 1
          },
          {
            "text": "što ćeš biti razorena!",
            "poem": 2
          },
          {
            "text": "Blago onom koji ti uzvrati istom merom,",
            "poem": 1
          },
          {
            "text": "onako kako si činila nama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Blago onom ko ti nejač zgrabi",
            "poem": 1
          },
          {
            "text": "i o stenu smrska!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
