  "chapter": {
    "number": 55,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi, uz žičane instrumente. Davidova poučna pesma."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Poslušaj, Bože, molitvu moju;",
            "poem": 1
          },
          {
            "text": "od moje se molbe ne sakrivaj.",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Dobro me počuj i usliši me.",
            "poem": 2
          },
          {
            "text": "Nespokojan sam i smeten u žalopojci svojoj;",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "od glasa protivnika,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "zbog pritiska zlikovca,",
            "poem": 2
          },
          {
            "text": "jer navališe na mene nevolju",
            "poem": 1
          },
          {
            "text": "i u gnevu zamrzeše me.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "U meni je srce moje ustreptalo",
            "poem": 1
          },
          {
            "text": "i smrtni užas na mene je pao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Strah i strepnja došli su na mene,",
            "poem": 1
          },
          {
            "text": "jeza me je ophrvala.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Govorim: „Ko će mi dati krila golubice?",
            "poem": 1
          },
          {
            "text": "Ja bih da odletim i skrasim se.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Baš daleko ja bih odleteo,",
            "poem": 1
          },
          {
            "text": "skrasio se u pustinji. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Pohitaću u sklonište svoje,",
            "poem": 1
          },
          {
            "text": "zbog vetra što kovitla i zbog oluje.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Smeti ih, Gospode,",
            "poem": 1
          },
          {
            "text": "jezik im rascepi;",
            "poem": 2
          },
          {
            "text": "jer vidim nasilje",
            "poem": 1
          },
          {
            "text": "i sukob u gradu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Dan i noć zidine mu obilaze,",
            "poem": 1
          },
          {
            "text": "u njemu su zloba i stradanje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "U njemu je razaranje,",
            "poem": 1
          },
          {
            "text": "s trgova mu ne nestaju tlačenje i prevara.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Jer nije neprijatelj taj koji me vređa –",
            "poem": 1
          },
          {
            "text": "ja bih to pretrpeo;",
            "poem": 2
          },
          {
            "text": "ni onaj što me mrzi nije taj koji mi čini šta veliko –",
            "poem": 1
          },
          {
            "text": "od njega bih se ja sakrio;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "već ti – čovek meni ravan –",
            "poem": 1
          },
          {
            "text": "prijatelj moj bliski koji me poznaje;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "sa kim sam se rado savetovao,",
            "poem": 1
          },
          {
            "text": "u Dom Božiji išao u mnoštvu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Smrt neka ih zaskoči;",
            "poem": 1
          },
          {
            "text": "u Svet mrtvih neka živi odu,",
            "poem": 2
          },
          {
            "text": "jer je zlo tamo gde borave,",
            "poem": 1
          },
          {
            "text": "u njima samima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ja ću Boga da zazovem",
            "poem": 1
          },
          {
            "text": "i Gospod će da me spase.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Jadaću se, uzdisaću uveče, ujutro i u podne;",
            "poem": 1
          },
          {
            "text": "i on moj glas čuće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Otkupiće u miru dušu moju",
            "poem": 1
          },
          {
            "text": "iz boja protiv mene,",
            "poem": 2
          },
          {
            "text": "jer je mnogo onih",
            "poem": 1
          },
          {
            "text": "što mi se protive.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Čuće Bog,",
            "poem": 1
          },
          {
            "text": "poniziće ih onaj što stoluje od davnina; Sela",
            "poem": 2
          },
          {
            "text": "one što se ne menjaju",
            "poem": 1
          },
          {
            "text": "i koji se Boga ne boje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Svoju ruku diže na one s kojima je u miru,",
            "poem": 1
          },
          {
            "text": "svoj savez raskida.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Usta su mu meka kao maslo,",
            "poem": 1
          },
          {
            "text": "a rat mu je u srcu;",
            "poem": 2
          },
          {
            "text": "reči su mu od ulja mekše,",
            "poem": 1
          },
          {
            "text": "a ipak su mačevi isukani.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Na Gospoda tovar svoj prebaci",
            "poem": 1
          },
          {
            "text": "i on će te podržati;",
            "poem": 2
          },
          {
            "text": "pravedniku neće dati",
            "poem": 1
          },
          {
            "text": "nikad da se zatetura.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "A ti ćeš ih, Bože, oboriti u ždrelo, u jamu;",
            "poem": 1
          },
          {
            "text": "krvoloci i varalice ni polovinu svojih dana doživeti neće.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "A ja se u tebe uzdam.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
