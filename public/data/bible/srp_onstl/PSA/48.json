  "chapter": {
    "number": 48,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Pesma. Psalam potomaka Korejevih."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Velik je Gospod,",
            "poem": 1
          },
          {
            "text": "mnoge hvale vredan,",
            "poem": 2
          },
          {
            "text": "u gradu Boga našeg,",
            "poem": 1
          },
          {
            "text": "na njegovoj svetoj gori.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Prelepa je njena visina,",
            "poem": 1
          },
          {
            "text": "radost je cele zemlje;",
            "poem": 2
          },
          {
            "text": "gora Sion, na ivicama severa,",
            "poem": 1
          },
          {
            "text": "grad je velikog cara.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Bog je u utvrđenjima svojim,",
            "poem": 1
          },
          {
            "text": "za zaklon je sebe obznanio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Jer, gle, carevi su okupljeni,",
            "poem": 1
          },
          {
            "text": "zajedno napreduju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "I kad su ga videli, zapanjiše se,",
            "poem": 1
          },
          {
            "text": "užasnuše se i umakoše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Trepet ih je tamo obuzeo",
            "poem": 1
          },
          {
            "text": "i bol kao porodilju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Vetrom sa istoka",
            "poem": 1
          },
          {
            "text": "skršio si lađe tarsiske.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Kao što smo čuli,",
            "poem": 1
          },
          {
            "text": "tako smo i videli",
            "poem": 2
          },
          {
            "text": "u gradu Gospoda nad vojskama,",
            "poem": 1
          },
          {
            "text": "u gradu Boga našega,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Boga koji ga je doveka osnovao. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Bože, usred Doma tvoga razmišljamo",
            "poem": 1
          },
          {
            "text": "o milosti tvojoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Poput tvog imena, Bože,",
            "poem": 1
          },
          {
            "text": "slava ti prelazi krajeve zemlje,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "desnica ti obiluje pravednošću.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Gora Sion neka se raduje,",
            "poem": 1
          },
          {
            "text": "neka se vesele Judina naselja",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "zbog tvojih propisa.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Obiđite Sion,",
            "poem": 1
          },
          {
            "text": "oko njega koračajte,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kule mu prebrojte;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "proverite njegove zidine,",
            "poem": 1
          },
          {
            "text": "utvrđenja mu pregledajte,",
            "poem": 2
          },
          {
            "text": "da pokolenju novom",
            "poem": 1
          },
          {
            "text": "o tome pričate.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Jer, ovo je Bog,",
            "poem": 1
          },
          {
            "text": "naš Bog u veke vekova;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "on nas vodi i do smrti!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
