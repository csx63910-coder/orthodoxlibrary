  "chapter": {
    "number": 58,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Davidov napev: „Ne pogubi.“ Pesma pouzdanja u Boga."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Zar ćutanjem pravednost javljate?",
            "poem": 1
          },
          {
            "text": "Sudite li podjednako potomcima ljudi?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Štaviše, smišljate nepravdu da je činite;",
            "poem": 1
          },
          {
            "text": "rukama svojim nasilje zemljom razmeravate.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Zastraniše zlikovci od majčinog krila,",
            "poem": 1
          },
          {
            "text": "zalutaše govornici laži od stomaka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Njihov otrov nalikuje zmijskom otrovu;",
            "poem": 1
          },
          {
            "text": "poput kobrinog je, što je gluva, zatvorenog uva;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "što ne čuje glas šaptača,",
            "poem": 1
          },
          {
            "text": "vračara veštog u bacanju vrački.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Zube im, Bože, u ustima polomi;",
            "poem": 1
          },
          {
            "text": "Gospode, čeljusti lavićima skrši.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Nek ispare poput voda što otiču svojim putem;",
            "poem": 1
          },
          {
            "text": "strele svoje nek odapnu kao da su polomljene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Nek iscure poput puža koji puzi,",
            "poem": 1
          },
          {
            "text": "nek su poput mrtvorođenčeta što ne vidi sunca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Pre nego ti lonci osete potpalu od trnja –",
            "poem": 1
          },
          {
            "text": "sirovog ilʼ svelog –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "biće razvejano.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "A pravednik će se radovati kad vidi osvetu;",
            "poem": 1
          },
          {
            "text": "noge će oprati u krvi zlikovca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "I kazaće svako:",
            "poem": 1
          },
          {
            "text": "„Pravedniku stvarno plod pripada.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Stvarno ima Boga koji sudi zemlji.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
