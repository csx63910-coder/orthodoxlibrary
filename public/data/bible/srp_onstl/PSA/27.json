  },
  "chapter": {
    "number": 27,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Gospod mi je svetlost i spasenje,",
            "poem": 1
          },
          {
            "text": "koga da se bojim?",
            "poem": 2
          },
          {
            "text": "Gospod je moja tvrđava,",
            "poem": 1
          },
          {
            "text": "od koga da strahujem?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Kad na mene navale opaki",
            "poem": 1
          },
          {
            "text": "da mi telo žderu,",
            "poem": 2
          },
          {
            "text": "moji protivnici i dušmani,",
            "poem": 1
          },
          {
            "text": "oni se spotiču i padaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Pa da i vojska krene protiv mene,",
            "poem": 1
          },
          {
            "text": "moje se srce neće uplašiti.",
            "poem": 2
          },
          {
            "text": "Da se i rat povede protiv mene,",
            "poem": 1
          },
          {
            "text": "i tada ću biti pun pouzdanja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Jedno tražim od Gospoda",
            "poem": 1
          },
          {
            "text": "i za time žudim:",
            "poem": 2
          },
          {
            "text": "da prebivam u Domu Gospodnjem",
            "poem": 1
          },
          {
            "text": "kroz sve dane svog života;",
            "poem": 2
          },
          {
            "text": "da posmatram lepotu Gospodnju,",
            "poem": 1
          },
          {
            "text": "i savet potražim u njegovom Domu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Jer on me sklanja pod senicu svoju",
            "poem": 1
          },
          {
            "text": "u dan nevolje,",
            "poem": 2
          },
          {
            "text": "skriva me u skrovištu svog šatora,",
            "poem": 1
          },
          {
            "text": "na stenu me podiže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Uzvisila se sada moja glava",
            "poem": 1
          },
          {
            "text": "iznad mojih dušmana oko mene:",
            "poem": 2
          },
          {
            "text": "u njegovom šatoru žrtve ću hvale prineti,",
            "poem": 1
          },
          {
            "text": "pevaću Gospodu, pesmom ga slaviti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Čuj, Gospode, glas moj,",
            "poem": 1
          },
          {
            "text": "smiluj mi se, usliši me!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Moje me srce upućuje k tebi:",
            "poem": 1
          },
          {
            "text": "„Traži lice moje.“",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Tvoje lice tražim, Gospode.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ne krij svoje lice od mene,",
            "poem": 1
          },
          {
            "text": "ne izruči gnevu slugu svoga,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ti si uvek bio moja pomoć,",
            "poem": 2
          },
          {
            "text": "ne napuštaj me, ne ostavljaj me,",
            "poem": 1
          },
          {
            "text": "Bože spasenja moga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ako me napuste i otac i majka,",
            "poem": 1
          },
          {
            "text": "Gospod će me primiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Uči me, Gospode, svome putu,",
            "poem": 1
          },
          {
            "text": "ravnom me stazom vodi,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "radi mrzitelja mojih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ne predaj me volji moga protivnika,",
            "poem": 1
          },
          {
            "text": "jer lažni svedoci ustaju na mene,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "koji odišu nasiljem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ja verujem da ću videti dobrotu Gospodnju",
            "poem": 1
          },
          {
            "text": "u zemlji živih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Čekaj na Gospoda:",
            "poem": 1
          },
          {
            "text": "budi jak i odvažna srca,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i čekaj na Gospoda.",
            "poem": 2
          }
        ]
      }
    ],
