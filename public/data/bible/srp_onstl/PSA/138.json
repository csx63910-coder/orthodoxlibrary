  "chapter": {
    "number": 138,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Hvaliću te od sveg srca,",
            "poem": 1
          },
          {
            "text": "pred bogovima pevaću ti slavopoje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Klanjaću se u Domu svetosti tvoje;",
            "poem": 1
          },
          {
            "text": "hvaliću ime tvoje za milost tvoju i istinu tvoju;",
            "poem": 2
          },
          {
            "text": "za obećanje tvoje, za reč tvoju",
            "poem": 1
          },
          {
            "text": "što je iznad sveg imena svoga diže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Na dan kada sam vapio, ti si me uslišio;",
            "poem": 1
          },
          {
            "text": "smelost si mi dao, dušu ojačao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Nek te hvale, o, Gospode, svi carevi zemlje,",
            "poem": 1
          },
          {
            "text": "kada čuju reči tvojih usta!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Opevaće puteve Gospodnje,",
            "poem": 1
          },
          {
            "text": "jer je slava Gospodnja velika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Uzvišen je Gospod ali gleda poniženog,",
            "poem": 1
          },
          {
            "text": "a bahatog nadaleko prepoznaje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Makar se i našao usred nevolje,",
            "poem": 1
          },
          {
            "text": "život ćeš mi sačuvati;",
            "poem": 2
          },
          {
            "text": "na bes moga protivnika ispružićeš ruku svoju,",
            "poem": 1
          },
          {
            "text": "spašće mene desna ruka tvoja!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Gospod će me osvetiti!",
            "poem": 1
          },
          {
            "text": "O, Gospode, milost tvoja je doveka;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "dela svojih ruku ne napuštaj!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
