  "chapter": {
    "number": 7,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Tužbalica Davidova, koju je ispevao Gospodu zbog reči Huša, Venijaminovca."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Gospode, Bože moj,",
            "poem": 1
          },
          {
            "text": "u tebi je moje utočište,",
            "poem": 2
          },
          {
            "text": "spasi me, izbavi,",
            "poem": 1
          },
          {
            "text": "od svih koji me gone,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "da mi dušu kao lav ne razderu,",
            "poem": 1
          },
          {
            "text": "rastrgnu me, a spasa ni od koga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Gospode, Bože moj, ako sam ovo učinio,",
            "poem": 1
          },
          {
            "text": "ako sam ruke svoje nepravdom okaljao,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "ako sam prijatelju zlom uzvratio,",
            "poem": 1
          },
          {
            "text": "a protivnika bez razloga pljačkao,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "neka me neprijatelj goni i sustigne,",
            "poem": 1
          },
          {
            "text": "neka život moj na zemlju zgazi,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a slavu moju u prašinu baci. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "U svom gnevu ustani, Gospode,",
            "poem": 1
          },
          {
            "text": "digni se na bes mojih dušmana,",
            "poem": 2
          },
          {
            "text": "probudi se, u pomoć mi dođi,",
            "poem": 1
          },
          {
            "text": "jer ti si svoj sud zakazao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Neka se zbor naroda skupi oko tebe,",
            "poem": 1
          },
          {
            "text": "pa nad njima vladaj sa visina.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Gospod sudi narodima,",
            "poem": 1
          },
          {
            "text": "sudi mi, Gospode, po pravednosti",
            "poem": 2
          },
          {
            "text": "i neporočnosti mojoj.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Bog je pravedan,",
            "poem": 1
          },
          {
            "text": "on ispituje i srca i nutrinu;",
            "poem": 2
          },
          {
            "text": "neka dođe kraj zlu opakih,",
            "poem": 1
          },
          {
            "text": "a pravednoga ti učvrsti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Bog je moj štit,",
            "poem": 1
          },
          {
            "text": "on spasava ispravnog u srcu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Bog je pravedni sudija,",
            "poem": 1
          },
          {
            "text": "svakog dana Bog gnev svoj izliva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "A za onog ko se ne pokaje,",
            "poem": 1
          },
          {
            "text": "on će svoj mač naoštriti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i luk svoj zapeti, uperiti;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "takvom sprema oružje smrtno,",
            "poem": 1
          },
          {
            "text": "strele svoje pravi zapaljive.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Eto, opaki je zlom bremenit,",
            "poem": 1
          },
          {
            "text": "začinje nevolju, a rađa prevaru.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Kopa jamu, izdubi je,",
            "poem": 1
          },
          {
            "text": "i pada u jamu koju je načinio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Nevolja njegova neka mu se na glavu vrati,",
            "poem": 1
          },
          {
            "text": "nasilje njegovo neka mu na teme padne.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Hvaliću Gospoda radi njegove pravednosti,",
            "poem": 1
          },
          {
            "text": "slaviću pesmom ime Gospoda Svevišnjeg!",
            "poem": 2
          }
        ]
      }
    ],
