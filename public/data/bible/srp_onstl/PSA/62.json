  "chapter": {
    "number": 62,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Za Jedutuna. Psalam Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Samo u Bogu duša moja počiva,",
            "poem": 1
          },
          {
            "text": "od njega je spasenje moje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Samo on je stena moja i spasenje moje;",
            "poem": 1
          },
          {
            "text": "zaklon moj, ništa mene neće uzdrmati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Dokle ćete se obrušavati na čoveka?",
            "poem": 1
          },
          {
            "text": "Pobiće vas, sve vas,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "poput zida nakrivljenog",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i ograde polegnute.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Zacelo, dogovoriše se",
            "poem": 1
          },
          {
            "text": "sa visina njegovih da ga obore.",
            "poem": 2
          },
          {
            "text": "Oni vole laž,",
            "poem": 1
          },
          {
            "text": "pa ustima svojim blagosiljaju,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a nutrinom svojom proklinju. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Samo se u Bogu smiri, dušo moja,",
            "poem": 1
          },
          {
            "text": "jer je od njega nadanje moje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Samo on je stena moja",
            "poem": 1
          },
          {
            "text": "i spasenje moje;",
            "poem": 2
          },
          {
            "text": "zaklon moj,",
            "poem": 1
          },
          {
            "text": "mene neće uzdrmati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Od Boga je spasenje moje",
            "poem": 1
          },
          {
            "text": "i slava moja;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "stena snage moje,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "utočište moje je u Bogu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "U njega se uzdaj uvek, narode;",
            "poem": 1
          },
          {
            "text": "pred njim srce svoje izlivajte,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Bog je naše utočište. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Samo su dah potomci ljudi,",
            "poem": 1
          },
          {
            "text": "laž su potomci čovekovi;",
            "poem": 2
          },
          {
            "text": "na terazijama mereni zajedno",
            "poem": 1
          },
          {
            "text": "oni su od daha lakši.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ne uzdajte se u otimačinu",
            "poem": 1
          },
          {
            "text": "i u grabež taštu nadu ne stavljajte;",
            "poem": 2
          },
          {
            "text": "a bogatstvo kada se umnoži,",
            "poem": 1
          },
          {
            "text": "srcem se za njega ne vezujte.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Bog je jedno objavio,",
            "poem": 1
          },
          {
            "text": "a dve stvari ja sam čuo:",
            "poem": 2
          },
          {
            "text": "da je sila jedino Božija,",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "da je milost jedino Gospodnja;",
            "poem": 2
          },
          {
            "text": "jer, ti uzvraćaš čoveku",
            "poem": 1
          },
          {
            "text": "po delu njegovom.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
