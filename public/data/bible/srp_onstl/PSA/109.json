  },
  "chapter": {
    "number": 109,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Psalam Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "O, Bože slavljenja mojega,",
            "poem": 1
          },
          {
            "text": "nemoj da zaćutiš!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Eno, usta zlobna i usta pakosna",
            "poem": 1
          },
          {
            "text": "na mene su razjapljena;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kleveću me jezikom lažljivim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Okružili su me rečima mržnje,",
            "poem": 1
          },
          {
            "text": "bez razloga napali me.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Tužbama mi uzvraćaju ljubav,",
            "poem": 1
          },
          {
            "text": "ali ja se predajem molitvi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Na dobro mi uzvraćaju zlobom",
            "poem": 1
          },
          {
            "text": "i mržnju mi vraćaju za ljubav.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Protiv takvog postavi zlikovca,",
            "poem": 1
          },
          {
            "text": "tužitelja, nek mu stoji s desna!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Kada mu se sudi, krivac neka bude;",
            "poem": 1
          },
          {
            "text": "neka mu se i molitva u greh preokrene!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Nek mu dani budu malobrojni,",
            "poem": 1
          },
          {
            "text": "neka se njegova služba da drugome.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Nek mu deca siročad postanu",
            "poem": 1
          },
          {
            "text": "i žena mu udovica!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Neka mu se deca potucaju, neka prose;",
            "poem": 1
          },
          {
            "text": "neka mole kada odu iz svojih ruina!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Nek mu pleni zajmodavac sve što je njegovo,",
            "poem": 1
          },
          {
            "text": "neka mu tuđinac imanje opljačka!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Nemao nikoga da mu se smiluje,",
            "poem": 1
          },
          {
            "text": "siročad mu nemala nikoga koji bi ih požalio!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Neka mu se seme zatre,",
            "poem": 1
          },
          {
            "text": "ime im se izbrisalo u kolenu drugom!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Nek se pamte krivice njegovih predaka pred Gospodom,",
            "poem": 1
          },
          {
            "text": "greh majke njegove nek se ne izbriše!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Neka budu trajno pred Gospodom,",
            "poem": 1
          },
          {
            "text": "a on sa zemlje nek im zbriše spomen!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Jer se nije setio milost da iskaže,",
            "poem": 1
          },
          {
            "text": "već je kinjio siromaha, nevoljnika,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ubijao očajnika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Voleo je kletvu,",
            "poem": 1
          },
          {
            "text": "pa neka ga stigne;",
            "poem": 2
          },
          {
            "text": "blagoslov mu nije bio mio,",
            "poem": 1
          },
          {
            "text": "pa neka je daleko od njega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ko odelom u kletvu se oblačio,",
            "poem": 1
          },
          {
            "text": "pa nek se ona kao voda u njega ulije",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i kao ulje u njegove kosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Nek mu ona bude ko ogrtač u koga se zamotava,",
            "poem": 1
          },
          {
            "text": "kao pojas koji stalno opasuje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Neka tako Gospod plati mojim tužiteljima",
            "poem": 1
          },
          {
            "text": "i onima što o meni govore zlobno!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "A ti, o, Gospode Bože,",
            "poem": 1
          },
          {
            "text": "čini sa mnom kako dolikuje tvom imenu;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "izbavi me jer je milost tvoja dobra.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Evo, i siromah i nevoljnik ja sam,",
            "poem": 1
          },
          {
            "text": "probodeno srce je u meni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Bledim kao senka izdužena,",
            "poem": 1
          },
          {
            "text": "oduvan sam ko skakavac.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Od posta mi kolena klecaju;",
            "poem": 1
          },
          {
            "text": "telo mi je mršavo, bez sala.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Postao sam ruglo za njih,",
            "poem": 1
          },
          {
            "text": "odmahuju glavom kad me vide.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "O, Gospode, pomozi mi!",
            "poem": 1
          },
          {
            "text": "Spasi mene, o, moj Bože, po milosti svojoj!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Neka znaju ljudi da je ovo ruka tvoja;",
            "poem": 1
          },
          {
            "text": "da si to ti, o, Gospode, učinio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Oni neka kunu a ti blagosiljaj;",
            "poem": 1
          },
          {
            "text": "a kada se dignu neka se zastide,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a tvoj će se sluga radovati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Neka se tužitelji moji u bruku obuku,",
            "poem": 1
          },
          {
            "text": "sramotom svojom neka se pokriju ko plaštom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Hvaliću Gospoda na sav glas!",
            "poem": 1
          },
          {
            "text": "Slaviću ga usred mnoštva;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "jer je ubogome stao s desne strane",
            "poem": 1
          },
          {
            "text": "da ga spase od onih što mu duši presuđuju!",
            "poem": 2
          }
        ]
      }
    ],
