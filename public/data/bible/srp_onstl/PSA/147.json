  "chapter": {
    "number": 147,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Slavite Gospoda!",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Baš je dobro Bogu našem zapevati slavopoje;",
            "poem": 1
          },
          {
            "text": "baš je milo prikladno slaviti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Gospod gradi Jerusalim",
            "poem": 1
          },
          {
            "text": "i okuplja izgnane Izrailjce.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "On leči srca ucveljenih",
            "poem": 1
          },
          {
            "text": "i rane im previja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Zvezde on prebrojava",
            "poem": 1
          },
          {
            "text": "i svaku od njih poimence zove.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Velik je naš Gospod i sile goleme,",
            "poem": 1
          },
          {
            "text": "njegova je mudrost bezgranična.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Gospod diže ponizne,",
            "poem": 1
          },
          {
            "text": "a zlikovce do zemlje srozava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Zapevajte hvalospev Gospodu!",
            "poem": 1
          },
          {
            "text": "Zapevajte slavopoj na harfi Bogu našem!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "On je nebo zastro oblacima,",
            "poem": 1
          },
          {
            "text": "za zemlju se kišom postarao,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "dao travi da raste po gorju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "On zverima hranu daje kad zatreba,",
            "poem": 1
          },
          {
            "text": "i gavrančićima kada mu zagrakću.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ne zadivljuje se snagom konja,",
            "poem": 1
          },
          {
            "text": "ne oduševljava se bedrima junaka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Gospodu su mili ti što ga se boje,",
            "poem": 1
          },
          {
            "text": "oni što se nadaju milosti njegovoj!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "O, Jerusalime, veličaj Gospoda!",
            "poem": 1
          },
          {
            "text": "O, Sione, slavi Boga svoga!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Jer on je ojačao krila vrata tvojih,",
            "poem": 1
          },
          {
            "text": "blagoslovio je decu tvoju u tebi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Zemlji tvojoj on mir donosi",
            "poem": 1
          },
          {
            "text": "i siti te pšenicom najboljom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Reč odluke svoje on pošalje zemlji,",
            "poem": 1
          },
          {
            "text": "i reč mu već hita, ne zastaje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "On sneg daje kao da je vuna,",
            "poem": 1
          },
          {
            "text": "razbacuje inje ko da je pepeo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Grad svoj baca kao da su mrve",
            "poem": 1
          },
          {
            "text": "i mraz njegov ko može da trpi?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Reč pošalje svoju, pa ih onda topi;",
            "poem": 1
          },
          {
            "text": "vetrom svojim dune i poteku vode.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Jakovu je reči svoje objavio",
            "poem": 1
          },
          {
            "text": "i Izrailju uredbe svoje i svoja pravila.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "A to nije uradio nijednom narodu,",
            "poem": 1
          },
          {
            "text": "pravila njegova nisu im poznata.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Slavite Gospoda!",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
