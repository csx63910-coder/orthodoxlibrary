  },
  "chapter": {
    "number": 144,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Blagosloven da je Gospod, stena moja,",
            "poem": 1
          },
          {
            "text": "što mi ruke za rat",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i prste za borbu uvežbava;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "milosrđe moje i tvrđava moja;",
            "poem": 1
          },
          {
            "text": "moje utočište i moj izbavitelj;",
            "poem": 2
          },
          {
            "text": "moj štit, onaj u kome utočište nalazim",
            "poem": 1
          },
          {
            "text": "i koji mi moj narod pokorava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "O, Gospode, šta je čovek da za njega mariš",
            "poem": 1
          },
          {
            "text": "i ljudski potomak da se sa njim baviš?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Čovek tek je dahu nalik",
            "poem": 1
          },
          {
            "text": "i dani mu blede kao senka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "O, Gospode, nebesa svoja spusti, pa da siđeš",
            "poem": 1
          },
          {
            "text": "i dotakneš brda da se puše!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Zasevaj munjom,",
            "poem": 1
          },
          {
            "text": "neka se rasprše!",
            "poem": 2
          },
          {
            "text": "Strele svoje baci,",
            "poem": 1
          },
          {
            "text": "neka se razbeže!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Sa visina ruke pruži,",
            "poem": 1
          },
          {
            "text": "izbavi me;",
            "poem": 2
          },
          {
            "text": "izvadi me iz bujica",
            "poem": 1
          },
          {
            "text": "i iz ruku dece tuđinaca;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "onih što ustima svojim obmanjuju",
            "poem": 1
          },
          {
            "text": "i desnicom svojom zaklinju se lažno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "O, Bože, pevaću ti novu pesmu,",
            "poem": 1
          },
          {
            "text": "na liri sa deset struna ja sviraću tebi;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "tebi koji carevima izbavljenje daješ;",
            "poem": 1
          },
          {
            "text": "koji Davida, slugu svoga,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "spasavaš od mača opakoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Oslobodi me, izbavi me",
            "poem": 1
          },
          {
            "text": "iz ruke dece tuđinaca,",
            "poem": 2
          },
          {
            "text": "onih što ustima svojim obmanjuju",
            "poem": 1
          },
          {
            "text": "i desnicom svojom zaklinju se lažno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Tad sinovi naši neka budu",
            "poem": 1
          },
          {
            "text": "kao stablo gorostasno u mladosti svojoj;",
            "poem": 2
          },
          {
            "text": "naše ćerke neka budu",
            "poem": 1
          },
          {
            "text": "poput šara stubova palate.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ambari će naši biti puni",
            "poem": 1
          },
          {
            "text": "raznovrsnog roda;",
            "poem": 2
          },
          {
            "text": "hiljade će ojagnjiti ovce naše,",
            "poem": 1
          },
          {
            "text": "i deset hiljada po pašnjacima našim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Volovi će tegliti, neće biti razaranja,",
            "poem": 1
          },
          {
            "text": "neće biti bežanije",
            "poem": 2
          },
          {
            "text": "i vriska se neće čuti",
            "poem": 1
          },
          {
            "text": "po trgovima našim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Blago narodu kome tako bude!",
            "poem": 1
          },
          {
            "text": "Blago narodu kome Bog je Gospod!",
            "poem": 2
          }
        ]
      }
    ],
