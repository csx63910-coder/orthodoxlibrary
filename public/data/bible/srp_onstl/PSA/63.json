  "chapter": {
    "number": 63,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Psalam Davidov. Kada je bio u judejskoj pustinji."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Bože, moj Bog ti si",
            "poem": 1
          },
          {
            "text": "i ja tebe tražim.",
            "poem": 2
          },
          {
            "text": "Moja je duša tebe žedna,",
            "poem": 1
          },
          {
            "text": "telo je moje tebe željno,",
            "poem": 2
          },
          {
            "text": "u zemlji suvoj,",
            "poem": 1
          },
          {
            "text": "ogoljenoj i bezvodnoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Zaista, u Svetinji sam te video,",
            "poem": 1
          },
          {
            "text": "gledao ti i silu i slavu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Milost je tvoja bolja od života,",
            "poem": 1
          },
          {
            "text": "usne moje veličaće tebe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Zato ću te blagosiljati kroz život svoj,",
            "poem": 1
          },
          {
            "text": "u ime ću tvoje podizati ruke svoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Sita će mi biti duša",
            "poem": 1
          },
          {
            "text": "ko od sala i obilja;",
            "poem": 2
          },
          {
            "text": "sa veseljem na usnama",
            "poem": 1
          },
          {
            "text": "usta moja proslavljaće te.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Na postelji svojoj setim te se,",
            "poem": 1
          },
          {
            "text": "o stražama noćnim razmišljam o tebi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Jer si ti pomoć moja",
            "poem": 1
          },
          {
            "text": "u senci krila tvojih ja se veselim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Uz tebe mi je duša prionula,",
            "poem": 1
          },
          {
            "text": "desnica me tvoja podržava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "A oni žude da mi dušu upropaste,",
            "poem": 1
          },
          {
            "text": "oni će otići u dubine zemlje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Biće predani maču,",
            "poem": 1
          },
          {
            "text": "biće hrana lisicama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "A car će se u Bogu veseliti,",
            "poem": 1
          },
          {
            "text": "hvaliće se svako ko se njime zakune,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer će se zatvoriti usta onima što govore laži.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
