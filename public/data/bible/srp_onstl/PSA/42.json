  "chapter": {
    "number": 42,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Za horovođu. Poučna pesma sinova Korejevih."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Kao što košuta čezne za potocima,",
            "poem": 1
          },
          {
            "text": "tako duša moja čezne za tobom, Bože.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Žedna mi je duša Boga, Boga živoga.",
            "poem": 1
          },
          {
            "text": "Kada ću doći i pred Bogom se pojaviti?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Suze su mi hrana i danju i noću,",
            "poem": 1
          },
          {
            "text": "dok mi povazdan govore: „Gde ti je Bog tvoj?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Duša mi vene kad se setim kako sam hodio s mnogima,",
            "poem": 1
          },
          {
            "text": "predvodeći ih k Domu Božijem uz klicanje i hvalospeve,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "s mnoštvom koje slavi praznik.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Što si mi klonula, dušo moja,",
            "poem": 1
          },
          {
            "text": "i što uzdišeš u meni?",
            "poem": 2
          },
          {
            "text": "Bogu se nadaj, jer opet ću ga slaviti,",
            "poem": 1
          },
          {
            "text": "Spasitelja mog, Boga mog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Klonula je duša u meni,",
            "poem": 1
          },
          {
            "text": "zato te spominjem iz kraja jordanskog,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i s Ermona, na gori Misaru.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Dubina dubinu doziva hukom slapova tvojih,",
            "poem": 1
          },
          {
            "text": "sve bujice i talasi tvoji pređoše preko mene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Danju Gospod šalje svoju milost,",
            "poem": 1
          },
          {
            "text": "a noću je pesma njegova sa mnom –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "molitva Bogu života mog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Reći ću Bogu: „Steno moja, zašto si me zaboravio?",
            "poem": 1
          },
          {
            "text": "Zašto žalim pod tlakom neprijatelja svog?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Kosti mi se lome od ruganja dušmana mojih,",
            "poem": 1
          },
          {
            "text": "dok mi povazdan govore: „Gde ti je Bog tvoj?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Što si mi klonula, dušo moja,",
            "poem": 1
          },
          {
            "text": "što uzdišeš u meni?",
            "poem": 2
          },
          {
            "text": "Bogu se nadaj, jer opet ću ga slaviti,",
            "poem": 1
          },
          {
            "text": "Spasitelja i Boga svog.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
