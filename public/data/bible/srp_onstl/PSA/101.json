  "chapter": {
    "number": 101,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Davidov Psalam."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "O milosti i o pravdi pevam!",
            "poem": 1
          },
          {
            "text": "Ja tebi, Gospode, pevam pohvale.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Predaću se putu besprekornom!",
            "poem": 1
          },
          {
            "text": "Kada ćeš mi doći?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "U čestitosti srca svoga",
            "poem": 1
          },
          {
            "text": "živeću u svom domu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Stvari gnusne",
            "poem": 1
          },
          {
            "text": "ne stavljam pred oči svoje;",
            "poem": 2
          },
          {
            "text": "otpadničke stvari mrzim,",
            "poem": 1
          },
          {
            "text": "na njih ne pristajem!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ništa nemam s podlacima",
            "poem": 1
          },
          {
            "text": "i za zlo neću da znam.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ko svog bližnjeg iza leđa ocrnjuje,",
            "poem": 1
          },
          {
            "text": "ja toga satirem;",
            "poem": 2
          },
          {
            "text": "ko je prkosnog pogleda i nadmenog srca,",
            "poem": 1
          },
          {
            "text": "ja toga ne trpim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Moje su oči na vernima u zemlji",
            "poem": 1
          },
          {
            "text": "da bi sa mnom boravili;",
            "poem": 2
          },
          {
            "text": "nek mi služi onaj",
            "poem": 1
          },
          {
            "text": "koji ide putem besprekornim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "U mom domu mesta",
            "poem": 1
          },
          {
            "text": "nema za prepredenjaka,",
            "poem": 2
          },
          {
            "text": "pred očima mojim lažov",
            "poem": 1
          },
          {
            "text": "potrajati neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Iz jutra u jutro satirem",
            "poem": 1
          },
          {
            "text": "sve neverne iz zemlje,",
            "poem": 2
          },
          {
            "text": "sve zlotvore istrebljujem",
            "poem": 1
          },
          {
            "text": "iz Gospodnjeg grada.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
