  },
  "chapter": {
    "number": 71,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "U tebi je utočište moje, Gospode;",
            "poem": 1
          },
          {
            "text": "o, da se nikad ne postidim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Oslobodi me po svojoj pravednosti i izbavi me,",
            "poem": 1
          },
          {
            "text": "prigni uho svoje k meni i spasi me.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Budi mi stena prebivališta",
            "poem": 1
          },
          {
            "text": "kojoj uvek dolazim;",
            "poem": 2
          },
          {
            "text": "spasenje moje ti si zapovedio,",
            "poem": 1
          },
          {
            "text": "jer si moja stena i tvrđava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Izbavi me, Bože moj, iz ruke zlikovačke,",
            "poem": 1
          },
          {
            "text": "od ruke prestupnika i okrutnoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Jer, ti si moja nada, o, Bože Gospode,",
            "poem": 1
          },
          {
            "text": "pouzdanje si mi od mladosti moje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Na tebe se oslanjam od utrobe,",
            "poem": 1
          },
          {
            "text": "iz krila majke moje si me izvukao;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "slaviću te neprestano.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Poput znaka postao sam mnogima,",
            "poem": 1
          },
          {
            "text": "a ti si mi utočište jako.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Usta si mi slavom svojom ispunio",
            "poem": 1
          },
          {
            "text": "i krasotom svojom od jutra do sutra.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ne odbaci me u doba starosti,",
            "poem": 1
          },
          {
            "text": "kad mi snaga klone ne zaboravi me.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Jer o meni govore protivnici moji,",
            "poem": 1
          },
          {
            "text": "oni što mi život vrebaju",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "zajedno se savetuju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Kažu: „Bog je njega ostavio!",
            "poem": 1
          },
          {
            "text": "Gonite ga, uhvatite,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer izbavitelja nema!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Bože, od mene se ne udaljuj!",
            "poem": 1
          },
          {
            "text": "O, moj Bože, požuri mi u pomoć!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Neka se postide i neka propadnu",
            "poem": 1
          },
          {
            "text": "tužitelji moje duše;",
            "poem": 2
          },
          {
            "text": "i prezir i bruka nek pokriju",
            "poem": 1
          },
          {
            "text": "one koji mi o glavi rade.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "A ja ću uvek da se nadam,",
            "poem": 1
          },
          {
            "text": "sve više i više slaviću te.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Usta će moja o pravednosti tvojoj da govore,",
            "poem": 1
          },
          {
            "text": "o delima tvog spasenja od jutra do sutra,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer im broja ne znam.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "U moćnim delima Boga Gospoda ja ću doći,",
            "poem": 1
          },
          {
            "text": "tvoju pravednost ću spominjati, samo tvoju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Od mladosti moje, Bože, ti si me učio;",
            "poem": 1
          },
          {
            "text": "i čudesa tvoja dosad javljao sam.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Čak i kada ostarim i osedim,",
            "poem": 1
          },
          {
            "text": "Bože, ne ostavljaj me,",
            "poem": 2
          },
          {
            "text": "dok ti silu ne objavim naraštaju novom;",
            "poem": 1
          },
          {
            "text": "silu tvoju svakom što dolazi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Pravednost je tvoja, Bože, do visina,",
            "poem": 1
          },
          {
            "text": "velika si dela učinio;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ko je poput tebe, Bože?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Ti – dao si da gledam mnoge nevolje i muke –",
            "poem": 1
          },
          {
            "text": "ti ćeš mi opet obnoviti život;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "iz dubina zemlje podićeš me opet.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Ti ojačaj dostojanstvo moje",
            "poem": 1
          },
          {
            "text": "i ponovo uteši me.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "I ja ću harfom da te hvalim",
            "poem": 1
          },
          {
            "text": "zbog vernosti tvoje;",
            "poem": 2
          },
          {
            "text": "Bože moj, sviraću ti na liri,",
            "poem": 1
          },
          {
            "text": "Svetitelju Izrailjev.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Klicaće radosno usne moje,",
            "poem": 1
          },
          {
            "text": "jer ću ti svirati,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i duša moja što si je otkupio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "I moj će jezik od jutra do sutra",
            "poem": 1
          },
          {
            "text": "pričati o tvojoj pravednosti;",
            "poem": 2
          },
          {
            "text": "jer će se postideti, jer će se osramotiti",
            "poem": 1
          },
          {
            "text": "ti što mi o glavi rade.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
