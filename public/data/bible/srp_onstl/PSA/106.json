  },
  "chapter": {
    "number": 106,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Slavite Gospoda!",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Hvalite Gospoda jer je dobar,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ko će da iskaže silna Gospodnja dela,",
            "poem": 1
          },
          {
            "text": "da mu svu slavu razglasi?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Blago onima što se drže pravde,",
            "poem": 1
          },
          {
            "text": "onima što uvek postupaju pravedno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Seti me se, o, Gospode,",
            "poem": 1
          },
          {
            "text": "kada si milostiv svom narodu;",
            "poem": 2
          },
          {
            "text": "u spasenju svome",
            "poem": 1
          },
          {
            "text": "i mene se seti;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "da vidim napredak tvojih izabranih,",
            "poem": 1
          },
          {
            "text": "da se radujem u radosti naroda tvoga",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i hvalim se sa tvojim nasledstvom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Zgrešili smo kao preci naši;",
            "poem": 1
          },
          {
            "text": "učinili smo nepravdu, skrivili smo!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Naši preci u Egiptu nisu razumeli čudesa tvoja,",
            "poem": 1
          },
          {
            "text": "nisu spominjali tvoju veliku milost,",
            "poem": 2
          },
          {
            "text": "pa su se pobunili kraj mora,",
            "poem": 1
          },
          {
            "text": "kraj Crvenog mora.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "A on ih je izbavio zarad svog imena,",
            "poem": 1
          },
          {
            "text": "da bi silu svoju pokazao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Zapretio je Crvenom moru",
            "poem": 1
          },
          {
            "text": "i ono je presušilo,",
            "poem": 2
          },
          {
            "text": "pa ih je vodio dubinama",
            "poem": 1
          },
          {
            "text": "kao po pustinji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Spasao ih je od ruke mrzitelja,",
            "poem": 1
          },
          {
            "text": "otkupio iz ruke dušmana.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "I vode su preplavile njihove krvnike,",
            "poem": 1
          },
          {
            "text": "niko od njih preostao nije.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Tada su poverovali njegovim rečima",
            "poem": 1
          },
          {
            "text": "i pevali mu hvalospeve.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ali brzo su mu dela zaboravili,",
            "poem": 1
          },
          {
            "text": "na savet njegov čekali nisu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "U pustinji ih spopade žudnja,",
            "poem": 1
          },
          {
            "text": "u pustari su iskušavali Boga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "I on je dao kako su tražili,",
            "poem": 1
          },
          {
            "text": "ali im je duše razboleo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "U taboru su zavideli Mojsiju i Aronu,",
            "poem": 1
          },
          {
            "text": "svecu Gospodnjem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Na to se zemlja raspukla,",
            "poem": 1
          },
          {
            "text": "progutala je Datana",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i zatrpala Avironovu družinu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Buknula je vatra u družini,",
            "poem": 1
          },
          {
            "text": "suknuo je plamen na zlobnike.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Na Horivu izlili su tele,",
            "poem": 1
          },
          {
            "text": "klanjali se livenom idolu;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "zamenuli su Slavu svoju",
            "poem": 1
          },
          {
            "text": "za lik vola koji pase travu!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Zaboravili su Boga, svog izbavitelja,",
            "poem": 1
          },
          {
            "text": "koji je u Egiptu velika učinio dela;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "čudesa u Hamovoj zemlji",
            "poem": 1
          },
          {
            "text": "i strahote na Crvenom moru.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Rekao je da bi ih istrebio,",
            "poem": 1
          },
          {
            "text": "da njegov izabranik Mojsije",
            "poem": 2
          },
          {
            "text": "nije stao pred njega u procep,",
            "poem": 1
          },
          {
            "text": "i odvratio njegov razorni gnev.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Prezreli su zemlju milu",
            "poem": 1
          },
          {
            "text": "i nisu verovali njegovoj reči.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Gunđali su u svojim šatorima",
            "poem": 1
          },
          {
            "text": "i glas Gospodnji slušali nisu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "A on im se zakleo",
            "poem": 1
          },
          {
            "text": "da će ih pobiti u pustinji;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "da će im pobiti decu među narodima",
            "poem": 1
          },
          {
            "text": "i raseliti po zemljama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Ali oni su se priklonili Val-Fegoru",
            "poem": 1
          },
          {
            "text": "i jeli žrtve za mrtve.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Svojim su ga postupcima na gnev izazvali",
            "poem": 1
          },
          {
            "text": "pa je pošast buknula među njima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Ali ustao je Fines da posreduje",
            "poem": 1
          },
          {
            "text": "i pošast je stala.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "To mu se uračunalo kao pravednost",
            "poem": 1
          },
          {
            "text": "kroz sva pokolenja, doveka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Gnevili su ga i na vodama Merive,",
            "poem": 1
          },
          {
            "text": "pa je i Mojsije zbog njih nastradao;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "jer su mu duh razdražili",
            "poem": 1
          },
          {
            "text": "pa je nepromišljeno govorio usnama svojim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Nisu istrebili narode",
            "poem": 1
          },
          {
            "text": "za koje im je Gospod zapovedio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Pomešali su se s narodima,",
            "poem": 1
          },
          {
            "text": "naviknuli na njihova dela.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Služili su njihovim idolima",
            "poem": 1
          },
          {
            "text": "i oni su im postali zamka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Žrtvovali su svoje sinove",
            "poem": 1
          },
          {
            "text": "i svoje ćerke zlodusima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "Prolivali su nevinu krv,",
            "poem": 1
          },
          {
            "text": "krv svojih sinova i svojih ćerki",
            "poem": 2
          },
          {
            "text": "koje su žrtvovali idolima Hanana;",
            "poem": 1
          },
          {
            "text": "krvlju su opoganili zemlju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          {
            "text": "Oskrnavili su se delima svojim,",
            "poem": 1
          },
          {
            "text": "odali se bludu postupcima svojim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          {
            "text": "Tada je planuo gnev Gospodnji na njegov narod,",
            "poem": 1
          },
          {
            "text": "zgadilo mu se njegovo nasledstvo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          {
            "text": "Predavao ih je u ruke naroda",
            "poem": 1
          },
          {
            "text": "pa su nad njima vladali oni što ih mrze;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          {
            "text": "tlačili ih njihovi dušmani,",
            "poem": 1
          },
          {
            "text": "ponizili pod njihovom vlašću.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          {
            "text": "Mnogo puta ih je izbavljao,",
            "poem": 1
          },
          {
            "text": "ali su bili buntovnih namera,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pa su propadali u svojim krivicama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          {
            "text": "Ali on bi ih pogledao u njihovoj muci,",
            "poem": 1
          },
          {
            "text": "čuo bi im preklinjanje;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          {
            "text": "pa se zbog njih podsetio svog saveza",
            "poem": 1
          },
          {
            "text": "i sažalio po velikoj milosti svojoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          {
            "text": "Čak je učinio da im se smiluju",
            "poem": 1
          },
          {
            "text": "svi tlačitelji njihovi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          {
            "text": "Spasi nas, Gospode, Bože naš,",
            "poem": 1
          },
          {
            "text": "skupi nas od naroda,",
            "poem": 2
          },
          {
            "text": "da hvalimo tvoje sveto ime,",
            "poem": 1
          },
          {
            "text": "da se dičimo tvojom slavom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          {
            "text": "Blagosloven da je Gospod, Bog Izrailjev,",
            "poem": 1
          },
          {
            "text": "od veka do veka.",
            "poem": 2
          },
          {
            "text": "I sav narod neka kaže:",
            "poem": 1
          },
          {
            "text": "„Amin.“",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Slavite Gospoda!",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
