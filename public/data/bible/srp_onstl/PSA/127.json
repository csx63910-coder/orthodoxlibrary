  "chapter": {
    "number": 127,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Pesma poklonička. Solomonova."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ako Gospod ne podiže kuću,",
            "poem": 1
          },
          {
            "text": "uzalud se na njoj graditelji muče;",
            "poem": 2
          },
          {
            "text": "ako Gospod nad gradom ne bdije,",
            "poem": 1
          },
          {
            "text": "uzalud je nad njim stražar budan.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Uzaludno je i vama da se rano podižete,",
            "poem": 1
          },
          {
            "text": "da kasno ležete",
            "poem": 2
          },
          {
            "text": "i jedete hleb sa mukom stečen,",
            "poem": 1
          },
          {
            "text": "jer on san svom miljeniku daje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Gle, sinovi su poklon od Gospoda,",
            "poem": 1
          },
          {
            "text": "plod utrobe je nagrada!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Slični su strelama u ruci ratnika,",
            "poem": 1
          },
          {
            "text": "baš su takvi u mladosti rođeni sinovi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Blago čoveku",
            "poem": 1
          },
          {
            "text": "koji njima tobolac svoj napuni!",
            "poem": 2
          },
          {
            "text": "Takvi se crveneti neće",
            "poem": 1
          },
          {
            "text": "kad se budu s dušmanima",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "na vratima grada raspravljali!",
            "poem": 2
          }
        ]
      }
    ],
