  },
  "chapter": {
    "number": 21,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Psalam Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Gospode, po tvojoj se snazi car veseli,",
            "poem": 1
          },
          {
            "text": "kako se mnogo raduje tvome spasenju!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Dao si mu što mu srce želi,",
            "poem": 1
          },
          {
            "text": "prošnju njegovu nisi odbio. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jer susreo si ga dobrim blagoslovima,",
            "poem": 1
          },
          {
            "text": "na glavu mu stavio krunu od suvoga zlata.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Život je od tebe tražio i život si mu dao;",
            "poem": 1
          },
          {
            "text": "duge dane zauvek i doveka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Velika je tvoja slava u tvome spasenju,",
            "poem": 1
          },
          {
            "text": "podario si mu sjaj i veličanstvo,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Jer ti mu podari blagoslove doveka,",
            "poem": 1
          },
          {
            "text": "dao mu da se veseli u radosti tvog lica.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Jer car se uzda u Gospoda,",
            "poem": 1
          },
          {
            "text": "i milošću se Svevišnjega neće uzdrmati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ruka će ti naći sve tvoje dušmane,",
            "poem": 1
          },
          {
            "text": "desnica ti naći one što te mrze.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Učinićeš da budu kao peć ognjena kad se pojaviš,",
            "poem": 1
          },
          {
            "text": "Gospod će ih progutati u svome gnevu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "oganj proždraće ih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Istrebićeš im potomke sa zemlje,",
            "poem": 1
          },
          {
            "text": "i seme njihovo među potomcima ljudi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Jer zlo su naumili protiv tebe,",
            "poem": 1
          },
          {
            "text": "zaveru skovaše, alʼ neće im uspeti,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "jer ti ćeš ih u beg naterati,",
            "poem": 1
          },
          {
            "text": "kad im strelu uperiš u lice.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Uzvisi se, Gospode, u svojoj sili!",
            "poem": 1
          },
          {
            "text": "A mi ćemo pevati i slaviti tvoju snagu.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
