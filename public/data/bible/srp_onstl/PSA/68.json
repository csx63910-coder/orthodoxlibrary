  "book": {
    "id": "PSA",
    "translationId": "srp_onstl",
    "name": "Psalam",
    "commonName": "Psalam",
    "title": "Psalmi",
    "order": 19,
    "numberOfChapters": 150,
    "sha256": "c6f7504dab6884191b78dc06d3be4895eca6e432bb5bba347779cdd7d9f9c58d",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/PSA/1.json",
    "lastChapterNumber": 150,
    "lastChapterApiLink": "/api/srp_onstl/PSA/150.json",
    "totalNumberOfVerses": 2461
  },
  "chapter": {
    "number": 68,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Davidov. Psalam. Pesma."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Neka Bog ustane,",
            "poem": 1
          },
          {
            "text": "neka se raziđu njegovi dušmani!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Neka se razbeže pred njim oni što ga mrze!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Razvej ih poput dima razvejanog;",
            "poem": 1
          },
          {
            "text": "nek propadnu zlikovci pred Bogom",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kao vosak istopljen u vatri.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "A pravedni neka se raduju,",
            "poem": 1
          },
          {
            "text": "nek pred Bogom kliču,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "nek likuju u veselju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Pevajte Bogu,",
            "poem": 1
          },
          {
            "text": "pevajte slavopoj njegovom imenu;",
            "poem": 2
          },
          {
            "text": "uzdignite onog što na oblacima jaše.",
            "poem": 1
          },
          {
            "text": "Njegovo je ime Gospod,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "uskliknite pred njim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Otac siročadi i sudija udovica –",
            "poem": 1
          },
          {
            "text": "to je Bog u svom svetom Prebivalištu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Bog usamljenima daje da u kući žive,",
            "poem": 1
          },
          {
            "text": "zatočene vodi blagostanju,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a buntovnici boraviće u sparušenoj zemlji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Bože, kad si išao ispred svog naroda,",
            "poem": 1
          },
          {
            "text": "kada si stupao pustinjom, Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "zemlja se tresla, nebesa su pljuštala,",
            "poem": 1
          },
          {
            "text": "pred Bogom, Bogom sinajskim,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pred Bogom, Bogom Izrailjevim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Bože, obilje si kiše poslao nasledstvu svome;",
            "poem": 1
          },
          {
            "text": "umorno je ono bilo, a ti si ga ojačao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Živalj tvoj se onde nastanio,",
            "poem": 1
          },
          {
            "text": "snabdevaš ubogog dobrima svojim, Bože.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Gospod objavljuje,",
            "poem": 1
          },
          {
            "text": "a žena što nose vesti veliko je mnoštvo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Carevi i vojske beže li beže,",
            "poem": 1
          },
          {
            "text": "a lepotica kuće plen razdeljuje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ako i legneš između torova,",
            "poem": 1
          },
          {
            "text": "ti si golubica krila obloženih srebrom,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i perja svetlucavo zlatnog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Kad Svemoćni rasprši careve u zemlji,",
            "poem": 1
          },
          {
            "text": "pade sneg na Salmonu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Gora Božija vasanska je gora,",
            "poem": 1
          },
          {
            "text": "gora s vrhovima vasanska je gora.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Zašto zavidno gledate, o, gore,",
            "poem": 1
          },
          {
            "text": "vrhove gore koju Bog želi za boravište svoje;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "gde će Gospod zacelo doveka da prebiva?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Božijih je kola na hiljade,",
            "poem": 1
          },
          {
            "text": "na mnoge hiljade;",
            "poem": 2
          },
          {
            "text": "a Gospod je među njima,",
            "poem": 1
          },
          {
            "text": "na Sinaju, u svetosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ti se pope na visinu,",
            "poem": 1
          },
          {
            "text": "povede roblje silno,",
            "poem": 2
          },
          {
            "text": "primi darove od ljudi,",
            "poem": 1
          },
          {
            "text": "pa čak i od buntovnika;",
            "poem": 2
          },
          {
            "text": "da prebivaš tamo,",
            "poem": 1
          },
          {
            "text": "Gospode Bože.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Blagosloven da je Gospod,",
            "poem": 1
          },
          {
            "text": "što terete naše dan za danom nosi,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Bog našeg spasenja. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Bog naš Bog je dela spasonosnih,",
            "poem": 1
          },
          {
            "text": "od Gospoda Boga izbavljenje je od smrti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Zacelo će Bog razbiti glavu svojih protivnika,",
            "poem": 1
          },
          {
            "text": "i kosmato teme onog koji živi u svojim gresima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Gospod kaže: „Sa Vasana vratiću ih,",
            "poem": 1
          },
          {
            "text": "iz dubina mora vratiću ih,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "pa da ti noga gaca u krvi",
            "poem": 1
          },
          {
            "text": "i jezik tvojih pasa dobije svoj deo od tvojih protivnika.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Videše povorke tvoje, Bože;",
            "poem": 1
          },
          {
            "text": "povorke Boga moga, moga cara ka Svetinji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Napred su išli pevači, potom svirači,",
            "poem": 1
          },
          {
            "text": "a u sredini su devojke udarale daire.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Blagosiljajte u zborovima Boga Gospoda,",
            "poem": 1
          },
          {
            "text": "vi sa vrela Izrailjeva!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Eno, mladi Venijamin predvodi ih,",
            "poem": 1
          },
          {
            "text": "glavari Jude sa mnoštvom,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "glavari Zavulona i glavari Neftalima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Tvoj Bog snagu ti je odredio;",
            "poem": 1
          },
          {
            "text": "pokaži snagu svoju, Bože, što si za nas delovao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Zbog tvog Doma u Jerusalimu",
            "poem": 1
          },
          {
            "text": "carevi će ti darove donositi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Zapreti zverima u trsci,",
            "poem": 1
          },
          {
            "text": "krdu bikova među teladima naroda;",
            "poem": 2
          },
          {
            "text": "pa nek se ponize i donesu komade srebra,",
            "poem": 1
          },
          {
            "text": "a on će rasuti narode što u ratu uživaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Doći će izaslanici iz Egipta,",
            "poem": 1
          },
          {
            "text": "Kuš žurno pruža ruke svoje Bogu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "O, carstva zemaljska, pevajte Bogu;",
            "poem": 1
          },
          {
            "text": "pevajte slavopoj Gospodu; Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "onome što jaše nebom, drevnim nebesima!",
            "poem": 1
          },
          {
            "text": "Eno, on tutnji glasom svojim, glasom silnim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Prepoznajte silu Božiju nad Izrailjem,",
            "poem": 1
          },
          {
            "text": "veličanstvo njegovo",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i njegovu silu u nebesima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Ti si strašan, Bože, u Svetilištu svome;",
            "poem": 1
          },
          {
            "text": "Bog Izrailjev sam daje silu i snagu narodu.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Blagosloven da je Bog!",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
