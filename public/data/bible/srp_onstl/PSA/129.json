  "chapter": {
    "number": 129,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Pesma poklonička."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "„Mnogo su me tlačili još od kako mlad sam bio“ –",
            "poem": 1
          },
          {
            "text": "nek kaže Izrailj –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Mnogo su me tlačili još od kako mlad sam bio,",
            "poem": 1
          },
          {
            "text": "a ipak me nisu nadvladali.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Preko mojih leđa su orali orači",
            "poem": 1
          },
          {
            "text": "svoje duge brazde.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Pravedan je Gospod,",
            "poem": 1
          },
          {
            "text": "presekao je konopce zlotvora!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Nek se stide, nek ustuknu",
            "poem": 1
          },
          {
            "text": "svi što Sion mrze.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Nek su kao trava po krovovima,",
            "poem": 1
          },
          {
            "text": "koja svene pre nego se počupa;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "koja žeteocu ruku ne ispuni,",
            "poem": 1
          },
          {
            "text": "ni naručje onom koji snoplje veže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "A ni prolaznici nek ne kažu:",
            "poem": 1
          },
          {
            "text": "„Blagosloveni od Gospoda da ste!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Blagosiljamo vas u Gospodnje ime!“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
