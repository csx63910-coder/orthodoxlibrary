  "chapter": {
    "number": 20,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Psalam Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Neka te Gospod usliši u dan nevolje,",
            "poem": 1
          },
          {
            "text": "neka te ime Boga Jakovljevog štiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Neka ti pošalje pomoć iz Svetinje,",
            "poem": 1
          },
          {
            "text": "sa Siona neka te podupre.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Neka se seti svih tvojih prinosa,",
            "poem": 1
          },
          {
            "text": "i svespalnicu tvoju neka primi. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Neka ti da što ti srce hoće,",
            "poem": 1
          },
          {
            "text": "i svaku zamisao tvoju neka ispuni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "A mi ćemo klicati radi tvog spasenja,",
            "poem": 1
          },
          {
            "text": "i u ime Boga našega dizati zastave.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Neka Gospod ispuni sve tvoje molbe.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Sada znam da Gospod spasava svoga pomazanika,",
            "poem": 1
          },
          {
            "text": "i uslišava ga sa svog svetog neba,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "silnim spasenjem svoje desnice.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Jedni se hvale kolima, drugi konjima,",
            "poem": 1
          },
          {
            "text": "a mi imenom Gospoda, Boga našega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Oni posrću i padaju,",
            "poem": 1
          },
          {
            "text": "mi se dižemo i stojimo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Gospode, spasi cara,",
            "poem": 1
          },
          {
            "text": "usliši nas kad te prizovemo!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
