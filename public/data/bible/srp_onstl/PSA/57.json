  "chapter": {
    "number": 57,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Davidov napev: „Ne pogubi.“ Pesma pouzdanja u Boga, kada je pred Saulom pobegao u pećinu."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Smiluj mi se, Bože, smiluj mi se,",
            "poem": 1
          },
          {
            "text": "jer u tebi duša moja utočište traži;",
            "poem": 2
          },
          {
            "text": "i u seni tvojih krila utočište tražim",
            "poem": 1
          },
          {
            "text": "dok nevolje prođu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Vapim Bogu Svevišnjemu,",
            "poem": 1
          },
          {
            "text": "Bogu koji mi sve čini.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Posegnuće sa nebesa, spašće me;",
            "poem": 1
          },
          {
            "text": "prekoriće tog koji me gazi; Sela",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "poslaće Bog milost svoju i vernost svoju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Duša mi je među lavovima,",
            "poem": 1
          },
          {
            "text": "ležim među proždrljivcima;",
            "poem": 2
          },
          {
            "text": "potomcima ljudi zuba ko koplja i strele,",
            "poem": 1
          },
          {
            "text": "jezika kao mača oštrog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Neka si uzvišen vrh nebesa, Bože;",
            "poem": 1
          },
          {
            "text": "slava tvoja nek je nad svom zemljom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Nozi mojoj spremili su mrežu,",
            "poem": 1
          },
          {
            "text": "duša mi se povila;",
            "poem": 2
          },
          {
            "text": "ispred mene jamu iskopaše",
            "poem": 1
          },
          {
            "text": "i u nju sami upadoše. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Srce mi je voljno, Bože,",
            "poem": 1
          },
          {
            "text": "srce mi je voljno, da ti pevam,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i da ti sviram!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Probudi se, biće moje;",
            "poem": 1
          },
          {
            "text": "budite se, o, liro i harfo,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ja bih zoru da probudim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "O, Gospode, hvaliću te među narodima,",
            "poem": 1
          },
          {
            "text": "slaviću te među tuđincima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Jer velika je milost tvoja; do nebesa,",
            "poem": 1
          },
          {
            "text": "i do oblaka seže vernost tvoja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Neka si uzvišen vrh nebesa, Bože;",
            "poem": 1
          },
          {
            "text": "slava tvoja nek je nad svom zemljom.",
            "poem": 2
          }
        ]
      }
    ],
