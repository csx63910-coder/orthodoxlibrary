  "chapter": {
    "number": 83,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Pesma. Psalam Asafov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "O, Bože, nemoj da zaćutiš!",
            "poem": 1
          },
          {
            "text": "Ne onemi,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "nemoj da miruješ, o Bože!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Gle, eno ih buče tvoji dušmani,",
            "poem": 1
          },
          {
            "text": "glavu dižu oni što te mrze!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Spletke kuju protiv tvog naroda",
            "poem": 1
          },
          {
            "text": "i zaveru prave tvome štićeniku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Rekli su: „Dođite, dajte da ih satremo kao narod,",
            "poem": 1
          },
          {
            "text": "da se ime Izrailja više ne spomene!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Eno, svi su složni u zamisli",
            "poem": 1
          },
          {
            "text": "da protiv tebe savez sklope:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "šatori Edoma i Ismaila,",
            "poem": 1
          },
          {
            "text": "Moava i Agarina;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Gevala, Amona i Amalika,",
            "poem": 1
          },
          {
            "text": "Filistejci s žiteljima Tira.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Još im je i Asirija prišla,",
            "poem": 1
          },
          {
            "text": "pristala ko vojska uz decu Lotovu. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Učini im kao Madijanu i kao Siseri,",
            "poem": 1
          },
          {
            "text": "kao Javinu na potoku Kisonu!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Bili su potrveni kod En-Dora,",
            "poem": 1
          },
          {
            "text": "pretvoreni u đubrivo za njivu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "S plemićima im postupi kao s Orivom i Zivom,",
            "poem": 1
          },
          {
            "text": "a sa knezovima njihovim kao sa Zevejem i Salmanom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Jer oni govore:",
            "poem": 1
          },
          {
            "text": "„Zauzmimo Božije pašnjake!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "O, moj Bože, pretvori ih u klupko korova,",
            "poem": 1
          },
          {
            "text": "u plevu na vetru!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ko kad vatra šumu pali",
            "poem": 1
          },
          {
            "text": "i ko kad plamen gore žari,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "tako ih poteraj vihorom svojim,",
            "poem": 1
          },
          {
            "text": "užasni ih svojom olujom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Beščašćem im lice pokrij,",
            "poem": 1
          },
          {
            "text": "pa nek vape za imenom tvojim, o, Gospode!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Nek se stide i smetu doveka!",
            "poem": 1
          },
          {
            "text": "Nek propadnu srameći se!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Pa neka se zna – ime ti je Gospod –",
            "poem": 1
          },
          {
            "text": "nad zemljom si celom ti jedini Svevišnji!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
