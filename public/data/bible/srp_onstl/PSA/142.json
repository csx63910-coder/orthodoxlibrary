  "chapter": {
    "number": 142,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Davidova poučna pesma, kad je bio u pećini. Molitva."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Glasom svojim ja Gospodu vapim,",
            "poem": 1
          },
          {
            "text": "glasom svojim ja Gospoda za milost preklinjem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Žalopojku svoju pred njega izlivam,",
            "poem": 1
          },
          {
            "text": "muku svoju njemu obrazlažem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Kada duh mi na izmaku beše,",
            "poem": 1
          },
          {
            "text": "ti si znao stazu moju;",
            "poem": 2
          },
          {
            "text": "put kojim sam išao,",
            "poem": 1
          },
          {
            "text": "na kome su mi zamku postavili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Udesno pogledaj pa vidi",
            "poem": 1
          },
          {
            "text": "da niko na me ne obraća pažnju;",
            "poem": 2
          },
          {
            "text": "meni više utočišta nema,",
            "poem": 1
          },
          {
            "text": "nema nikog da za mene mari.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "O, Gospode, tebi vapim! Govorim ti:",
            "poem": 1
          },
          {
            "text": "„Utočište moje ti si",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i nasledstvo moje u zemlji živih!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Jecaj moj pažljivo počuj,",
            "poem": 1
          },
          {
            "text": "jer sam jadan preko svake mere;",
            "poem": 2
          },
          {
            "text": "od tlačitelja me oslobodi,",
            "poem": 1
          },
          {
            "text": "jer za mene su prejaki.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Dušu moju iz tamnice vadi",
            "poem": 1
          },
          {
            "text": "pa da hvalim ime tvoje;",
            "poem": 2
          },
          {
            "text": "pa neka me okruže pravedni,",
            "poem": 1
          },
          {
            "text": "jer si meni blagonaklon bio!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
