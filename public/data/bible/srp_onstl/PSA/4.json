  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi, uz žičane instrumente. Davidov psalam."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Odgovori kad te zovnem, Bože, moja pravdo,",
            "poem": 1
          },
          {
            "text": "u mojoj teskobi, daj mi da odahnem,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "smiluj mi se, počuj mi molitvu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Dokle će, o, ljudski sinovi,",
            "poem": 1
          },
          {
            "text": "slava moja biti u sramoti?",
            "poem": 2
          },
          {
            "text": "Dokle ćete voleti ispraznost,",
            "poem": 1
          },
          {
            "text": "dokle ćete ići za prevarom? Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Znajte, verne je Gospod odvojio za sebe,",
            "poem": 1
          },
          {
            "text": "Gospod sluša kad god ga pozovem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Gnevite se, ali ne grešite,",
            "poem": 1
          },
          {
            "text": "na postelji srcem razmišljajte, utihnite. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Prinesite žrtve pravedne,",
            "poem": 1
          },
          {
            "text": "u Gospoda se uzdajte.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Mnogi kažu: „Ko će nam pokazati sreću?“",
            "poem": 1
          },
          {
            "text": "Obasjaj nas, Gospode, svetlom svoga lica!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ti si mi veseljem ispunio srce,",
            "poem": 1
          },
          {
            "text": "više ga ima od njihovog žita,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i od mladoga vina njihovog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ja spokojno ležem,",
            "poem": 1
          },
          {
            "text": "spokojno i spavam,",
            "poem": 2
          },
          {
            "text": "jer ti sam, Gospode,",
            "poem": 1
          },
          {
            "text": "daješ mi spokoja. Sela",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
