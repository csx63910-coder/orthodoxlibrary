  "chapter": {
    "number": 78,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Asafova poučna pesma."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "O, narode moj, poslušaj pouku moju",
            "poem": 1
          },
          {
            "text": "i rečima mojih usta uho priklonite!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Moj govor biće u priči,",
            "poem": 1
          },
          {
            "text": "objaviću zagonetke od davnina.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ono što smo čuli, ono što smo naučili",
            "poem": 1
          },
          {
            "text": "i što su nam stari naši ispričali;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "to nećemo da krijemo od njihove dece.",
            "poem": 1
          },
          {
            "text": "Objavićemo novom naraštaju hvale Gospodnje,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "njegovu silu i čudesa koja je učinio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "On je u Jakovu učvrstio svedočanstvo,",
            "poem": 1
          },
          {
            "text": "Izrailju je dao Zakon",
            "poem": 2
          },
          {
            "text": "i zapovedio našim precima",
            "poem": 1
          },
          {
            "text": "da ih predaju svojim potomcima,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "da bi novi naraštaj znao,",
            "poem": 1
          },
          {
            "text": "deca što će se roditi,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pa kad odrastu da to prenesu deci svojoj;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "da se u Boga pouzdaju,",
            "poem": 1
          },
          {
            "text": "da dela Božija ne zaboravljaju",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i zapovesti njegove da izvršavaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Da ne budu ko njihovi stari,",
            "poem": 1
          },
          {
            "text": "naraštaj buntovni,",
            "poem": 2
          },
          {
            "text": "neposlušno pokolenje nestalnoga srca",
            "poem": 1
          },
          {
            "text": "i duha koju nije veran Bogu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Jefremovci su bili lukovima naoružani",
            "poem": 1
          },
          {
            "text": "ali su pobegli na dan boja!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Nisu održali savez sa Bogom,",
            "poem": 1
          },
          {
            "text": "odbili su da postupe po njegovom Zakonu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Zaboravili su njegova dela,",
            "poem": 1
          },
          {
            "text": "čudesa njegova koja im je pokazao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "A on je pred njihovim precima učinio čudo,",
            "poem": 1
          },
          {
            "text": "u egipatskoj zemlji, u oblasti Soan.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "More je razdelio i proveo ih,",
            "poem": 1
          },
          {
            "text": "vode je uspravio da su poput zida.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Danju ih je vodio oblakom",
            "poem": 1
          },
          {
            "text": "i svetlošću vatre cele noći.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Stene je u pustinji rascepio,",
            "poem": 1
          },
          {
            "text": "obilno ih napojio kao iz dubina.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Brzake im je izveo iz raseline stene,",
            "poem": 1
          },
          {
            "text": "učinio da im vode kao reke teku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "A oni su mu uporno grešili,",
            "poem": 1
          },
          {
            "text": "prkosili Svevišnjem u pustinji;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "u srcima kušali su Boga,",
            "poem": 1
          },
          {
            "text": "izvoljevali tražeći hranu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Prigovarali su Bogu i rekli:",
            "poem": 1
          },
          {
            "text": "„Kadar li je Bog da u pustinji prostre trpezu?!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Jeste, stenu je udario,",
            "poem": 1
          },
          {
            "text": "potekla je voda i potoci se razlili.",
            "poem": 2
          },
          {
            "text": "Ali kadar li je da nam da i hranu,",
            "poem": 1
          },
          {
            "text": "da svoj narod mesom snabde?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Zato se Gospod razjario kada je to čuo,",
            "poem": 1
          },
          {
            "text": "pa je požar planuo na Jakova",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i gnev je buknuo na Izrailj;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "jer u Boga verovali nisu,",
            "poem": 1
          },
          {
            "text": "nisu se pouzdali da će da ih spase.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "I on je zapovedio oblacima",
            "poem": 1
          },
          {
            "text": "i otvorio odgore vrata nebeska,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "da ih zapljusne mana,",
            "poem": 1
          },
          {
            "text": "dade im žito sa neba da jedu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "I svi su jeli hleb moćnika,",
            "poem": 1
          },
          {
            "text": "obilje hrane im je poslao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Doveo je istočni vetar sa nebesa,",
            "poem": 1
          },
          {
            "text": "doneo je južni vetar snagom svojom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Mesom ih je ko prašinom zasuo",
            "poem": 1
          },
          {
            "text": "i krilatim pticama kao morskim peskom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Dao je da padaju po njihovom taboru,",
            "poem": 1
          },
          {
            "text": "oko njihovih šatora.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "I oni su jeli, najeli se do sitosti,",
            "poem": 1
          },
          {
            "text": "jer on im je dao kako su žudeli.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Ali još ih žudnja nije prošla",
            "poem": 1
          },
          {
            "text": "i još im je hrana u ustima bila,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "kada se gnev Božiji digao na njih.",
            "poem": 1
          },
          {
            "text": "I on pobi njihove najjače",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i obori mladiće Izrailja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "I pored toga opet su grešili,",
            "poem": 1
          },
          {
            "text": "nisu verovali njegovim čudima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Uzaludne dane im je prekratio",
            "poem": 1
          },
          {
            "text": "i nevoljom naglom njihove godine.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "A kad ih je ubijao, tražili su ga",
            "poem": 1
          },
          {
            "text": "i vraćali se, za Bogom čeznuli.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Tada bi se prisetili da im je Bog bio stena,",
            "poem": 1
          },
          {
            "text": "Bog Svevišnji njihov Otkupitelj!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Ali bi ga ustima varali",
            "poem": 1
          },
          {
            "text": "i lagali jezicima svojim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Srcem mu nisu bili odani,",
            "poem": 1
          },
          {
            "text": "nisu bili verni njegovom savezu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "Ipak, on se smilovao,",
            "poem": 1
          },
          {
            "text": "krivicu im opraštao",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i nije ih uništio.",
            "poem": 2
          },
          {
            "text": "Uporno je susprezao gnev svoj,",
            "poem": 1
          },
          {
            "text": "ljutnju svoju nije podsticao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          {
            "text": "Sećao se da su telo,",
            "poem": 1
          },
          {
            "text": "da su dah što isparava",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i što se ne vraća.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          {
            "text": "A kako su se često bunili u pustinji",
            "poem": 1
          },
          {
            "text": "i žalostili ga u pustari!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          {
            "text": "Uporno su iskušavali Boga,",
            "poem": 1
          },
          {
            "text": "vređali su Svetitelja Izrailjevog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          {
            "text": "Nisu se sećali njegove ruke",
            "poem": 1
          },
          {
            "text": "i dana kada ih je otkupio od tlačitelja,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          {
            "text": "kada je u Egiptu znakove svoje izveo",
            "poem": 1
          },
          {
            "text": "i čudesa svoja u oblasti Soan.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          {
            "text": "Reke je njihove u krv pretvorio,",
            "poem": 1
          },
          {
            "text": "a njihovi se potoci nisu mogli piti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          {
            "text": "Na njih je poslao komarce, da ih ujedaju,",
            "poem": 1
          },
          {
            "text": "žabe da ih upropaste.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          {
            "text": "Useve njihove dade gusenicama",
            "poem": 1
          },
          {
            "text": "i skakavcima sav trud njihov.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          {
            "text": "Gradom im je stukao vinograde,",
            "poem": 1
          },
          {
            "text": "a smokve slanom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          {
            "text": "Stoku im je gradu izložio",
            "poem": 1
          },
          {
            "text": "i njihova goveda munjama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          {
            "text": "Poslao je na njih vrelinu svog gneva,",
            "poem": 1
          },
          {
            "text": "srdžbu i jarost,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "nevolju i četu anđela propasti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          {
            "text": "Svom je gnevu stazu pripremio",
            "poem": 1
          },
          {
            "text": "i život im od smrti poštedeo nije,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "život im je pomoru predao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 51,
        "content": [
          {
            "text": "Pobio je sve prvence u Egiptu,",
            "poem": 1
          },
          {
            "text": "prve od muških u šatorima Hamovim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 52,
        "content": [
          {
            "text": "Svoj je narod izveo ko ovce,",
            "poem": 1
          },
          {
            "text": "vodio ih poput stada kroz pustinju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 53,
        "content": [
          {
            "text": "Vodio ih je sigurno i plašili se nisu,",
            "poem": 1
          },
          {
            "text": "a njihove dušmane je preplavilo more.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 54,
        "content": [
          {
            "text": "Tada ih je doveo na svoje sveto tlo,",
            "poem": 1
          },
          {
            "text": "na ovu goru, osvojenu njegovom desnicom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 55,
        "content": [
          {
            "text": "Pred njima je oterao narode,",
            "poem": 1
          },
          {
            "text": "dodelio im je razmereno nasledstvo",
            "poem": 2
          },
          {
            "text": "i nastanio plemena Izrailja",
            "poem": 1
          },
          {
            "text": "po njihovim šatorima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 56,
        "content": [
          {
            "text": "Ali oni su ponovo iskušavali",
            "poem": 1
          },
          {
            "text": "i bunili se protiv Boga Svevišnjega,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "propise njegovi nisu držali.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 57,
        "content": [
          {
            "text": "Okrenuli su se, izneverili poput očeva svojih,",
            "poem": 1
          },
          {
            "text": "izdali su kao luk slomljeni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 58,
        "content": [
          {
            "text": "Izazivali su ga svojim žrtvenim bregovima,",
            "poem": 1
          },
          {
            "text": "činili ga ljubomornim svojim idolima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 59,
        "content": [
          {
            "text": "Bog je to čuo, razjario se",
            "poem": 1
          },
          {
            "text": "i sasvim odbacio Izrailj,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 60,
        "content": [
          {
            "text": "pa je napustio Prebivalište u Silomu,",
            "poem": 1
          },
          {
            "text": "stan koji je podigao među ljudima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 61,
        "content": [
          {
            "text": "Tako je ropstvu prepustio snagu svoju",
            "poem": 1
          },
          {
            "text": "i svoju krasotu rukama dušmana.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 62,
        "content": [
          {
            "text": "I narod je svoj on predao maču",
            "poem": 1
          },
          {
            "text": "jer se razjario na svoje nasledstvo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 63,
        "content": [
          {
            "text": "Njegove mladiće proždrala je vatra,",
            "poem": 1
          },
          {
            "text": "pa su mu device ko usedelice.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 64,
        "content": [
          {
            "text": "Od mača su mu sveštenici pali,",
            "poem": 1
          },
          {
            "text": "a udovice ih ožalile nisu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 65,
        "content": [
          {
            "text": "Probudi se tada Gospod ko da je spavao,",
            "poem": 1
          },
          {
            "text": "kao junak kojega je savladalo vino!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 66,
        "content": [
          {
            "text": "Dušmane je svoje nazad odvukao",
            "poem": 1
          },
          {
            "text": "i doveka ih osramotio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 67,
        "content": [
          {
            "text": "Josifov je šator odbacio,",
            "poem": 1
          },
          {
            "text": "pleme Jefremovo nije izabrao,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 68,
        "content": [
          {
            "text": "već je izabrao Judino pleme",
            "poem": 1
          },
          {
            "text": "i goru Sion koju zavoli!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 69,
        "content": [
          {
            "text": "I tu je podigao Svetilište svoje, visoko ko nebo,",
            "poem": 1
          },
          {
            "text": "poput zemlje doveka ga učvrstio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 70,
        "content": [
          {
            "text": "Izabrao je svog slugu Davida,",
            "poem": 1
          },
          {
            "text": "uzeo ga je od stada ovaca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 71,
        "content": [
          {
            "text": "Doveo ga je od ovaca dojilica da napasa Jakova, njegov narod",
            "poem": 1
          },
          {
            "text": "i Izrailj, njegovo nasledstvo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 72,
        "content": [
          {
            "text": "I on im je Pastir bio po čestitosti svoga srca,",
            "poem": 1
          },
          {
            "text": "vodio ih je svojim umešnim rukama.",
            "poem": 2
          }
        ]
      }
    ],
