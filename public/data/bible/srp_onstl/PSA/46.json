  "chapter": {
    "number": 46,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Za potomke Korejeve. Pesma za visoke glasove."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Bog nam je utočište i sila,",
            "poem": 1
          },
          {
            "text": "trajni pomoćnik u nevolji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ne bojmo se, zato, kad se zemlja ljulja,",
            "poem": 1
          },
          {
            "text": "kad se gore ruše u dubine mora.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ma, nek buče i pene se njegove vode,",
            "poem": 1
          },
          {
            "text": "nek se gore tresu od njegove sile. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Teče reka i njene pritoke,",
            "poem": 1
          },
          {
            "text": "gradu Božijem radost donose,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "svetom mestu gde Svevišnji živi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Bog je usred njega, pomaći se neće,",
            "poem": 1
          },
          {
            "text": "Bog će mu pomoći u sam osvit jutra.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Bune se narodi, propadaju carstva,",
            "poem": 1
          },
          {
            "text": "kad glas povisi zemlja se rastvara.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "S nama je Gospod nad vojskama,",
            "poem": 1
          },
          {
            "text": "Bog Jakovljev naša je tvrđava. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Dođite, razmotrite dela Gospodnja,",
            "poem": 1
          },
          {
            "text": "koji pustoš po zemlji ostavlja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "On prekida ratove do na kraj zemlje,",
            "poem": 1
          },
          {
            "text": "luk krši, koplje prelama,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "bojna kola ognju izručuje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Utihnite i znajte da sam ja Bog,",
            "poem": 1
          },
          {
            "text": "uzvišen među narodima,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "uzvišen na zemlji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "S nama je Gospod nad vojskama,",
            "poem": 1
          },
          {
            "text": "Bog Jakovljev naša je tvrđava. Sela",
            "poem": 2
          }
        ]
      }
    ],
