  "chapter": {
    "number": 22,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi, po napevu košuta u zori. Davidov psalam."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Bože moj, Bože moj, zašto si me ostavio?!",
            "poem": 1
          },
          {
            "text": "Daleko si od moga spasenja,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i od reči vapaja mojega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Bože moj, vapim danju, a ti ne odgovaraš;",
            "poem": 1
          },
          {
            "text": "noću, ali nema mi odmora.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "A ti si onaj Sveti,",
            "poem": 1
          },
          {
            "text": "presto ti je na hvalama Izrailjevim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "U tebe su se naši preci uzdali,",
            "poem": 1
          },
          {
            "text": "uzdali se i ti ih izbavi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Tebi su vapili i izbavljeni bili,",
            "poem": 1
          },
          {
            "text": "u tebe se uzdali i nisu se osramotili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "A ja sam crv, a ne čovek,",
            "poem": 1
          },
          {
            "text": "ruglo ljudima, prezir naroda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ko god me vidi, taj mi se ruga,",
            "poem": 1
          },
          {
            "text": "cere mi se i mašu glavama:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "„U Gospoda se uzdao, neka ga on izbavi,",
            "poem": 1
          },
          {
            "text": "kad u njemu radost nalazi.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Jer ti si me izvukao iz utrobe majčine,",
            "poem": 1
          },
          {
            "text": "na grudima majke dao mi počinak.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Tebi sam predan od majčina krila,",
            "poem": 1
          },
          {
            "text": "od utrobe majčine ti si Bog moj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ne udaljuj se od mene,",
            "poem": 1
          },
          {
            "text": "jer nevolja je blizu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a pomoćnika nema.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Okružiše me mnogi bikovi,",
            "poem": 1
          },
          {
            "text": "bikovi me vasanski opkoliše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Na mene su čeljust raširili,",
            "poem": 1
          },
          {
            "text": "kao lav što razdire i riče.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Poput vode život mi ističe,",
            "poem": 1
          },
          {
            "text": "sve su mi se kosti razglavile,",
            "poem": 2
          },
          {
            "text": "srce mi je ko vosak postalo,",
            "poem": 1
          },
          {
            "text": "i topi se u mojim grudima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Snaga mi se kao crep sasuši,",
            "poem": 1
          },
          {
            "text": "jezik mi je uz nepce prionuo;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "u smrtni si me prah stavio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Jer psi su me, evo, opkolili,",
            "poem": 1
          },
          {
            "text": "okružila me četa zlikovaca,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ruke su mi i noge probili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Sve kosti svoje izbrojati mogu,",
            "poem": 1
          },
          {
            "text": "a oni me gledaju i zure u mene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Moje haljine dele među sobom,",
            "poem": 1
          },
          {
            "text": "kocku bacaju za moju odeću.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ne udaljuj se od mene, Gospode,",
            "poem": 1
          },
          {
            "text": "snago moja, požuri mi u pomoć,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "dušu moju izbavi od mača,",
            "poem": 1
          },
          {
            "text": "i moj život od kandži pasa.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Izbavi me od lavlje čeljusti,",
            "poem": 1
          },
          {
            "text": "i od rogova bivolovih!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "A ja ću pričati o tvom imenu braći svojoj,",
            "poem": 1
          },
          {
            "text": "hvaliću te usred zbora.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Hvalite Gospoda, vi što ga se bojite,",
            "poem": 1
          },
          {
            "text": "slavite ga, sve seme Jakovljevo,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "sav rod Izrailjev, nek od njega strepi!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Jer patnju ugnjetenog nije prezreo,",
            "poem": 1
          },
          {
            "text": "niti mu je postala odvratna,",
            "poem": 2
          },
          {
            "text": "nije svoje lice sakrio od njega,",
            "poem": 1
          },
          {
            "text": "nego mu je vapaj uslišio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "O tebi ću pevati na velikom zboru,",
            "poem": 1
          },
          {
            "text": "ispuniću zavete svoje pred onima koji ga se boje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Ponizni će jesti i biti siti,",
            "poem": 1
          },
          {
            "text": "hvaliće Gospoda koji ga traže.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Neka srca vaša žive doveka!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Setiće se i vratiti Gospodu,",
            "poem": 1
          },
          {
            "text": "svi krajevi zemaljski,",
            "poem": 2
          },
          {
            "text": "pašće ničice pred tobom",
            "poem": 1
          },
          {
            "text": "sva plemena naroda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Jer Gospodnje je Carstvo,",
            "poem": 1
          },
          {
            "text": "on vlada nad narodima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Njemu će se klanjati svi bogati",
            "poem": 1
          },
          {
            "text": "i siti na zemlji,",
            "poem": 2
          },
          {
            "text": "pred njim će kleknuti svi koji u prah silaze,",
            "poem": 1
          },
          {
            "text": "kojima se život ugasio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Potomstvo njemu će služiti,",
            "poem": 1
          },
          {
            "text": "pričaće o Gospodu budućem naraštaju,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "doći će i objaviti pravednost njegovu",
            "poem": 1
          },
          {
            "text": "narodu koji se još nije rodio,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da je on to učinio.",
            "poem": 2
          }
        ]
      }
    ],
