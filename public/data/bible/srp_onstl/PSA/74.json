  "chapter": {
    "number": 74,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Asafova poučna pesma."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Zašto si nas, o, Bože, odbacio doveka?",
            "poem": 1
          },
          {
            "text": "Zašto da se jarost tvoja puši na stado tvoje paše?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Priseti se svoje zajednice što si je od davnina stekao,",
            "poem": 1
          },
          {
            "text": "plemena svoga nasledstva koje si otkupio –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "gore Sion na kojoj si prebivao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Korake svoje okreni ka ruinama večnim,",
            "poem": 1
          },
          {
            "text": "svemu čemu je naudio protivnik u Svetinji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Dušmani tvoji riču usred tvog mesta sastanka,",
            "poem": 1
          },
          {
            "text": "postaviše zastave svoje za znakove.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Poznati su kao čovek",
            "poem": 1
          },
          {
            "text": "što sekiru na šipražje diže;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "i onda sekirom i polugama",
            "poem": 1
          },
          {
            "text": "sve rezbarije lomi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Svetilište tvoje do tla spališe,",
            "poem": 1
          },
          {
            "text": "opoganiše Prebivalište imena tvog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "U srcu su svome rekli: „Hajde da ih sasvim potlačimo!“",
            "poem": 1
          },
          {
            "text": "Spalili su sva Božija mesta sastanka u zemlji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "A naše znakove videli nismo,",
            "poem": 1
          },
          {
            "text": "ni proroka još nema,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i nikoga s nama ko bi znao – dokle?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Dokle će se, o, Bože, rugati dušmanin?",
            "poem": 1
          },
          {
            "text": "Hoće li protivnik doveka tvoje ime da prezire?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Zašto ruku svoju, baš svoju desnicu, povlačiš?",
            "poem": 1
          },
          {
            "text": "Iz nedara svojih izvuci je i satri ih!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "A Bog car moj je od davnina,",
            "poem": 1
          },
          {
            "text": "posred zemlje spasonosna dela čini.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Silom svojom ti si more razdelio,",
            "poem": 1
          },
          {
            "text": "u vodama smrskao si glave morskim nemanima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Levijatanu si glave razdrobio,",
            "poem": 1
          },
          {
            "text": "narodima uz obalu za hranu si ga dao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ti si dao da nabuja i vrelo i potok,",
            "poem": 1
          },
          {
            "text": "ti si nepresušne presušio reke.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Tvoj je dan, baš kao i noć;",
            "poem": 1
          },
          {
            "text": "ti si postavio i mesec i sunce.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ti si zemlji odredio svaku među;",
            "poem": 1
          },
          {
            "text": "i leto i zimu načinio ti si.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Seti se tog protivnika koji te prezire, Gospode,",
            "poem": 1
          },
          {
            "text": "i bezumnih što preziru ti ime.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ne daj zveri život golubice svoje,",
            "poem": 1
          },
          {
            "text": "doveka ne zaboravi na život svojih siromaha.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Pogledaj na savez,",
            "poem": 1
          },
          {
            "text": "jer se mračni krajevi zemlje napuniše mestima nasilja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Ne daj ugnjetenom da se ponižen vrati,",
            "poem": 1
          },
          {
            "text": "neka ime tvoje slave i siromah i ubogi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Ustani, o, Bože, svoj slučaj odbrani!",
            "poem": 1
          },
          {
            "text": "Seti se prezira bezumnog prema tebi od jutra do sutra.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Ne zaboravi glas dušmana svojih,",
            "poem": 1
          },
          {
            "text": "poklič što se neprestano diže,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "onih što se protiv tebe bune.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
