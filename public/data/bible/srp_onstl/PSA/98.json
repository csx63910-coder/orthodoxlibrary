  "chapter": {
    "number": 98,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Psalam."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Pevajte Gospodu novu pesmu,",
            "poem": 1
          },
          {
            "text": "jer je čudesa učinio!",
            "poem": 2
          },
          {
            "text": "Desnica mu donese pobedu",
            "poem": 1
          },
          {
            "text": "i mišica njegova sveta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Spasenje je svoje Gospod obznanio,",
            "poem": 1
          },
          {
            "text": "naočigled naroda je objavio pravednost svoju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Setio se svoje milosti",
            "poem": 1
          },
          {
            "text": "i svoje vernosti prema domu Izrailjevom,",
            "poem": 2
          },
          {
            "text": "i svi su krajevi zemlje",
            "poem": 1
          },
          {
            "text": "videli spasenje Boga našeg.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Usklikni Gospodu, zemljo sva!",
            "poem": 1
          },
          {
            "text": "Podvikujte, zapevajte i zasvirajte!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Zasvirajte Gospodu uz harfu;",
            "poem": 1
          },
          {
            "text": "i uz harfu, i uz zvuke pesme.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Uz trube, uz jeku rogova",
            "poem": 1
          },
          {
            "text": "uskliknite pred carem Gospodom!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Neka huči more i sve što je u njemu,",
            "poem": 1
          },
          {
            "text": "svet i njegovi stanovnici.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Nek rukama zapljeskaju reke,",
            "poem": 1
          },
          {
            "text": "s njima gore nek radosno kliču",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "pred Gospodom;",
            "poem": 1
          },
          {
            "text": "jer dolazi da sudi zemlji,",
            "poem": 2
          },
          {
            "text": "da pošteno sudi svetu",
            "poem": 1
          },
          {
            "text": "i ljudima po pravdi.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
