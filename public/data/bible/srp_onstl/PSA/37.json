  "chapter": {
    "number": 37,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ne žesti se zbog zlotvora,",
            "poem": 1
          },
          {
            "text": "ne zavidi onim što nepravdu čine.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Jer će poput trave brzo da uvenu,",
            "poem": 1
          },
          {
            "text": "ko zeleno bilje osušiće se.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "U Gospoda se uzdaj i čini dobro,",
            "poem": 1
          },
          {
            "text": "prebivaj na zemlji i vernošću napasaj se.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Raduj se u Gospodu",
            "poem": 1
          },
          {
            "text": "i daće ti po željama srca tvoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Gospodu prepusti put svoj,",
            "poem": 1
          },
          {
            "text": "pouzdaj se u njega i on će učiniti:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "pravednost će tvoju poput svetla da izvede,",
            "poem": 1
          },
          {
            "text": "i pravdu tvoju poput podneva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Umiri se pred Gospodom,",
            "poem": 1
          },
          {
            "text": "iščekuj ga sa strpljenjem;",
            "poem": 2
          },
          {
            "text": "ne žesti se na onoga što mu dobro ide na njegovom putu,",
            "poem": 1
          },
          {
            "text": "na čoveka koji spliće spletke.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Od jarosti suzdrži se",
            "poem": 1
          },
          {
            "text": "i gneva se okani;",
            "poem": 2
          },
          {
            "text": "ne žesti se,",
            "poem": 1
          },
          {
            "text": "to samo zlo donosi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Jer, zlikovce će istrebiti,",
            "poem": 1
          },
          {
            "text": "a zemlju će naslediti oni što Gospoda očekuju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Još samo malo,",
            "poem": 1
          },
          {
            "text": "i zlikovca više neće biti;",
            "poem": 2
          },
          {
            "text": "pomno ćeš da gledaš po njegovom mestu,",
            "poem": 1
          },
          {
            "text": "a njega neće biti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ponizni će naslediti zemlju,",
            "poem": 1
          },
          {
            "text": "radovaće se zbog obilja mira.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Zlikovac spletkari protiv pravednika,",
            "poem": 1
          },
          {
            "text": "i zubima svojim škrguće na njega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "A Gospod mu se smeje,",
            "poem": 1
          },
          {
            "text": "jer vidi da dan njegov stiže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Zlikovci su mač isukali,",
            "poem": 1
          },
          {
            "text": "luk su svoj nategnuli;",
            "poem": 2
          },
          {
            "text": "da obore siromaha i ubogog,",
            "poem": 1
          },
          {
            "text": "da zakolju ljude pravednih puteva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Srce će im mač probosti,",
            "poem": 1
          },
          {
            "text": "njihov luk će biti slomljen.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Bolje je i malo pravednikovo",
            "poem": 1
          },
          {
            "text": "nego blago zlikovaca mnogih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Jer, snaga će zlikovaca biti polomljena,",
            "poem": 1
          },
          {
            "text": "a pravedne Gospod potpomaže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Gospodu su znani dani besprekornih,",
            "poem": 1
          },
          {
            "text": "nasledstvo njihovo ostaje doveka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "U vremenu lošem neće se stideti,",
            "poem": 1
          },
          {
            "text": "i siti će biti u danima gladi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "A zlikovci će propasti;",
            "poem": 1
          },
          {
            "text": "dušmani Gospodnji biće kao pašnjaci najbolji –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "okončaće, u dimu će okončati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Zlikovac pozajmljuje i ne vraća,",
            "poem": 1
          },
          {
            "text": "a pravednik je darežljiv i daje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Jer, oni koje on blagoslovi,",
            "poem": 1
          },
          {
            "text": "naslediće zemlju;",
            "poem": 2
          },
          {
            "text": "a koje on prokune,",
            "poem": 1
          },
          {
            "text": "biće istrebljeni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Od Gospoda su čovekovi koraci,",
            "poem": 1
          },
          {
            "text": "i na putu njegovom on uživa.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Pa ako i padne, on odbačen neće biti,",
            "poem": 1
          },
          {
            "text": "jer mu Gospod ruku drži.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Bio sam mlad, sada sam star,",
            "poem": 1
          },
          {
            "text": "i nisam video pravednika napuštenog,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ni njegove potomke da prosjače hleba.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Darežljiv je povazdan, pozajmljuje,",
            "poem": 1
          },
          {
            "text": "potomstvo mu je blaženo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Od zla se odvrati, čini dobro",
            "poem": 1
          },
          {
            "text": "i živećeš doveka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Jer Gospod voli pravdu i svoje verne neće napustiti,",
            "poem": 1
          },
          {
            "text": "doveka će biti sačuvani;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a potomci zlikovaca biće istrebljeni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Pravedni će zemlju da naslede,",
            "poem": 1
          },
          {
            "text": "prebivaće na njoj trajno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Mudrost zbore usta pravednoga",
            "poem": 1
          },
          {
            "text": "i jezik mu objavljuje pravdu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "U srcu mu je Zakon Boga njegovoga,",
            "poem": 1
          },
          {
            "text": "koraci mu se ne klizaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Zlikovac pravednika vreba",
            "poem": 1
          },
          {
            "text": "i nastoji da ga ubije.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Ali njegovoj ga ruci Gospod prepustiti neće;",
            "poem": 1
          },
          {
            "text": "kada mu se sudi, osuditi ga neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Čekaj na Gospoda,",
            "poem": 1
          },
          {
            "text": "puta se njegovoga drži;",
            "poem": 2
          },
          {
            "text": "da te uzvisi, da naslediš zemlju",
            "poem": 1
          },
          {
            "text": "i gledaš kada se zlikovci budu istrebili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Video sam zlikovca bezdušnog,",
            "poem": 1
          },
          {
            "text": "grana se kao domaće stablo zeleno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Ali prošao je; pogledao sam,",
            "poem": 1
          },
          {
            "text": "a njega nema;",
            "poem": 2
          },
          {
            "text": "potražio sam ga,",
            "poem": 1
          },
          {
            "text": "i nisam ga pronašao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Posmatraj onoga bez mane, gledaj u čestitoga;",
            "poem": 1
          },
          {
            "text": "jer budućnost pripada mirotvorcu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "Svi će prestupnici biti razoreni,",
            "poem": 1
          },
          {
            "text": "istrebljenje je budućnost zlikovaca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          {
            "text": "Od Gospoda je spasenje pravednih,",
            "poem": 1
          },
          {
            "text": "u vreme nevolje on im je tvrđava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          {
            "text": "Gospod im pomaže,",
            "poem": 1
          },
          {
            "text": "on ih izbavlja;",
            "poem": 2
          },
          {
            "text": "od zlikovaca izbavlja ih,",
            "poem": 1
          },
          {
            "text": "spasava ih jer u njemu utočište traže.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
