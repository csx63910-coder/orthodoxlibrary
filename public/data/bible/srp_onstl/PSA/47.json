  "chapter": {
    "number": 47,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Psalam potomaka Korejevih."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Svi narodi, zapljeskajte dlanovima;",
            "poem": 1
          },
          {
            "text": "kličite Bogu veselim uzvikom!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Jer je strašan Svevišnji Gospod,",
            "poem": 1
          },
          {
            "text": "car veliki nad svom zemljom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "On nam je pokorio narode",
            "poem": 1
          },
          {
            "text": "i ljude pod noge naše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Nasledstvo je za nas odabrao,",
            "poem": 1
          },
          {
            "text": "ponos za Jakova koga voli. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Podiže se Bog uz poklik;",
            "poem": 1
          },
          {
            "text": "Gospod, uz zvuk trube.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Pevajte slavopoje Bogu,",
            "poem": 1
          },
          {
            "text": "pevajte slavopoje;",
            "poem": 2
          },
          {
            "text": "pevajte slavopoje caru našem,",
            "poem": 1
          },
          {
            "text": "pevajte slavopoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Jer, Bog je car cele zemlje;",
            "poem": 1
          },
          {
            "text": "pevajte pesmu poučnu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Bog vlada nad narodima,",
            "poem": 1
          },
          {
            "text": "Bog stoluje na prestolu svom svetom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Plemići naroda se okupljaju,",
            "poem": 1
          },
          {
            "text": "sa narodom Boga Avrahamovog;",
            "poem": 2
          },
          {
            "text": "Božiji su štitovi zemlje",
            "poem": 1
          },
          {
            "text": "i on je preuzvišen.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
