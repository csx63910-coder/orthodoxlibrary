  "chapter": {
    "number": 6,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi, uz žičane instrumente. Za duboke glasove. Psalam Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ne karaj me, Gospode, u svome gnevu,",
            "poem": 1
          },
          {
            "text": "u srdžbi me svojoj ne kažnjavaj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Smiluj mi se, Gospode, jer sam klonuo,",
            "poem": 1
          },
          {
            "text": "isceli me, Gospode, kosti mi se tresu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Duša mi je vrlo ustreptala,",
            "poem": 1
          },
          {
            "text": "dokle, Gospode, dokle ćeš čekati?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Okreni se, Gospode, izbavi mi dušu,",
            "poem": 1
          },
          {
            "text": "spasi mene zbog milosti svoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Jer, mrtav čovek tebe ne spominje,",
            "poem": 1
          },
          {
            "text": "ko će te iz Sveta mrtvih",
            "poem": 2
          },
          {
            "noteId": 2
          },
          {
            "text": "proslavljati?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Od jecanja sasvim sam klonuo;",
            "poem": 1
          },
          {
            "text": "svu noć ležaj ja plačem natapam,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i svoj krevet suzama oblivam.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Oko moje od muke se gasi,",
            "poem": 1
          },
          {
            "text": "iščezava zbog svih mojih dušmana.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Odbijte od mene, svi prestupnici,",
            "poem": 1
          },
          {
            "text": "jer čuo je Gospod glas mog vapaja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Čuo je Gospod moju molbu,",
            "poem": 1
          },
          {
            "text": "Gospod prima moju molitvu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Nek se osramote svi moji dušmani,",
            "poem": 1
          },
          {
            "text": "nek velikoj smutnji podlegnu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "nek se odmah povuku u sramu.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 2,
