  "chapter": {
    "number": 25,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "K tebi, Gospode, uzdižem dušu svoju,",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "u tebe se pouzdajem, moj Bože,",
            "poem": 1
          },
          {
            "text": "ne daj da se osramotim;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ne daj da dušmani moji likuju nada mnom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Neće se stideti ni jedan od onih",
            "poem": 1
          },
          {
            "text": "koji u tebe nadu svoju polažu;",
            "poem": 2
          },
          {
            "text": "stideće se oni",
            "poem": 1
          },
          {
            "text": "koji svoju veru krše bez razloga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Objavi mi, Gospode, svoje puteve,",
            "poem": 1
          },
          {
            "text": "nauči me svojim stazama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Vodi me svojom istinom, uči me,",
            "poem": 1
          },
          {
            "text": "jer ti si moj Bog, moj Spasitelj,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "tebi se nadam povazdan.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Seti se, Gospode, milosrđa",
            "poem": 1
          },
          {
            "text": "i milosti svoje, jer su od večnosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ne sećaj se greha moje mladosti,",
            "poem": 1
          },
          {
            "text": "ni mojih prestupa;",
            "poem": 2
          },
          {
            "text": "sećaj me se po milosti svojoj,",
            "poem": 1
          },
          {
            "text": "radi svoje dobrote, Gospode.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Gospod je dobar i pravedan,",
            "poem": 1
          },
          {
            "text": "zato pokazuje put grešnicima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "On vodi ponizne po pravdi,",
            "poem": 1
          },
          {
            "text": "i uči ponizne svome putu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Sve staze Gospodnje milost su i istina,",
            "poem": 1
          },
          {
            "text": "onima što čuvaju savez njegov i propise.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Oprosti mi krivicu, jer je velika,",
            "poem": 1
          },
          {
            "text": "radi svoga imena, Gospode.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ko je čovek što se boji Gospoda?",
            "poem": 1
          },
          {
            "text": "On će ga uputiti na put, koji on izabra za njega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Duša će mu počivati u dobru,",
            "poem": 1
          },
          {
            "text": "a seme mu naslediti zemlju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Prisan je Gospod s onima",
            "poem": 1
          },
          {
            "text": "koji ga se boje,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "njima svoj savez obznanjuje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Stalno oči upirem ka Gospodu,",
            "poem": 1
          },
          {
            "text": "jer mi noge iz mreže izvlači.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Okreni se k meni, smiluj mi se,",
            "poem": 1
          },
          {
            "text": "jer sam usamljen i jadan.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Množe se muke srca moga;",
            "poem": 1
          },
          {
            "text": "izvuci me iz mojih nevolja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Pogledaj na moju muku i patnju,",
            "poem": 1
          },
          {
            "text": "i oprosti sve grehe moje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Pogledaj koliko je dušmana mojih,",
            "poem": 1
          },
          {
            "text": "koji mene mrze iz dubine duše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Čuvaj moju dušu, izbavi me,",
            "poem": 1
          },
          {
            "text": "ne daj da se postidim,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer u tebi nađoh utočište.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Neka me nedužnost i poštenje čuvaju,",
            "poem": 1
          },
          {
            "text": "jer sam svoju nadu stavio u tebe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Otkupi, Bože, Izrailj,",
            "poem": 1
          },
          {
            "text": "od svih njegovih nevolja.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
