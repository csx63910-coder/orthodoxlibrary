    "commonName": "Psalam",
    "title": "Psalmi",
    "order": 19,
    "numberOfChapters": 150,
    "sha256": "c6f7504dab6884191b78dc06d3be4895eca6e432bb5bba347779cdd7d9f9c58d",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/PSA/1.json",
    "lastChapterNumber": 150,
    "lastChapterApiLink": "/api/srp_onstl/PSA/150.json",
    "totalNumberOfVerses": 2461
  },
  "chapter": {
    "number": 140,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Davidov Psalam."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "O, Gospode, izbavi me od čoveka zlobnog,",
            "poem": 1
          },
          {
            "text": "od čoveka nasilnika ti mene zaštiti;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "onog što mu srce zlobu smišlja,",
            "poem": 1
          },
          {
            "text": "onih što povazdan započinju svađe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Poput zmije oštre jezik,",
            "poem": 1
          },
          {
            "text": "otrov im je zmijski pod usnama. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Zaštiti me, o, Gospode,",
            "poem": 1
          },
          {
            "text": "od šaka pokvarenog,",
            "poem": 2
          },
          {
            "text": "od čoveka nasilnika ti mene zaštiti",
            "poem": 1
          },
          {
            "text": "i od onih što bi da me sa nogu pometu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Oholi su mi zamku i omče sakrili,",
            "poem": 1
          },
          {
            "text": "kraj puta mi mrežu raširili",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i klopke stavili. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Gospodu govorim: „Bog moj ti si!“",
            "poem": 1
          },
          {
            "text": "O, Gospode, prigni uho glasu mojih preklinjanja!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "O, Gospode Bože, silo mog spasenja,",
            "poem": 1
          },
          {
            "text": "u dan ratni glavu moju pokrij.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "O, Gospode, ne daj zlobnom po željama;",
            "poem": 1
          },
          {
            "text": "zlu nameru mu ne ostvari, da se ne oholi. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Eno glava onih što me okružuju!",
            "poem": 1
          },
          {
            "text": "Zlo usana njihovih nek se na njih sruči!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Neka na njih padne žar ugljeni;",
            "poem": 1
          },
          {
            "text": "u vatru neka ih gurne,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "u rake, i nek se ne dignu!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Neka se klevetnik ne ukoreni na zemlji;",
            "poem": 1
          },
          {
            "text": "nasilnika neka zloba lovi,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "neka ga nadvlada.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "A ja znam da će Gospod sud doneti siromahu",
            "poem": 1
          },
          {
            "text": "i pravdu za ubogoga!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Nek pravedni hvale tvoje ime!",
            "poem": 1
          },
          {
            "text": "Čestiti će pred tobom živeti!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
