  "chapter": {
    "number": 113,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Slavite Gospoda!",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "O, slavite, sluge Gospodnje,",
            "poem": 1
          },
          {
            "text": "slavite ime Gospodnje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Nek ime Gospodnje proslavljano bude",
            "poem": 1
          },
          {
            "text": "od sad pa doveka!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Od izlaska sunca pa do njegovog zalaska,",
            "poem": 1
          },
          {
            "text": "proslavljano bilo ime Gospodnje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Nad svim narodima uzvišen je Gospod,",
            "poem": 1
          },
          {
            "text": "slava mu je vrh nebesa.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ko je kao Gospod, Bog naš,",
            "poem": 1
          },
          {
            "text": "što stoluje u visini;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "što se sagne da pogleda",
            "poem": 1
          },
          {
            "text": "i po nebu i po zemlji?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Siromaha diže iz prašine,",
            "poem": 1
          },
          {
            "text": "iz bunjišta diže ubogoga;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "da ga posadi s plemićima,",
            "poem": 1
          },
          {
            "text": "s plemićima njegovog naroda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Od nerotkinje u kući",
            "poem": 1
          },
          {
            "text": "čini srećnu majku dece.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Slavite Gospoda!",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
