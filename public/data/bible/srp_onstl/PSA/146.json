  "chapter": {
    "number": 146,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Slavite Gospoda!",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Dušo moja, proslavljaj Gospoda!",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Gospoda ću proslavljati dokle živim,",
            "poem": 1
          },
          {
            "text": "dok me ima Bogu svome pevaću pohvale!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ne uzdajte se u vladare, u čovekov izdanak,",
            "poem": 1
          },
          {
            "text": "jer u njemu izbavljenja nema.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Napusti ga duh njegov, u zemlju se vraća",
            "poem": 1
          },
          {
            "text": "i tog dana propadne mu što je naumio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Blago onom kom pomaže Bog Jakovljev;",
            "poem": 1
          },
          {
            "text": "onom što se Gospodu, Bogu nada!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "On je stvorio nebo, zemlju",
            "poem": 1
          },
          {
            "text": "i more i sve što je u njima;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "on istine doveka se drži.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Potlačenim on pravedno uzvraća",
            "poem": 1
          },
          {
            "text": "i gladnima hranu daje;",
            "poem": 2
          },
          {
            "text": "Gospod oslobađa utamničene.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Gospod slepima oči otvara,",
            "poem": 2
          },
          {
            "text": "Gospod podiže ponižene,",
            "poem": 1
          },
          {
            "text": "Gospod voli pravednike.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Gospod štiti pridošlice,",
            "poem": 1
          },
          {
            "text": "olakšava siročetu i udovici,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a put zlikovcima osujećuje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Doveka vladaće Gospod,",
            "poem": 1
          },
          {
            "text": "tvoj Bog, Sione, kroz naraštaj svaki!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Slavite Gospoda!",
            "poem": 1
          }
        ]
      }
    ],
