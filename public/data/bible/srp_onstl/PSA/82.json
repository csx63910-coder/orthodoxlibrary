  "chapter": {
    "number": 82,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Psalam Asafov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Bog je stao u Božijem zboru,",
            "poem": 1
          },
          {
            "text": "pa sad sudi među bogovima:",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Dokle ćete suditi nečasno",
            "poem": 1
          },
          {
            "text": "i držati stranu zlotvorima? Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Zastupajte pravo ubogoga i sirotoga,",
            "poem": 1
          },
          {
            "text": "opravdajte siromaha i nevoljnika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Spasavajte slabog i tlačenog,",
            "poem": 1
          },
          {
            "text": "izbavite ih iz ruke zlikovaca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ali nisu znali, nisu razumeli;",
            "poem": 1
          },
          {
            "text": "u tami su posrtali",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i temelje zemlji zadrmali.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ja rekoh: ’Bogovi ste,",
            "poem": 1
          },
          {
            "text": "svi ste deca Svevišnjega!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ipak ćete pomreti ko ljudi,",
            "poem": 1
          },
          {
            "text": "propašćete ko i glavar svaki.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ustani, Bože, i sudi zemlji,",
            "poem": 1
          },
          {
            "text": "jer svi su narodi nasledstvo tvoje!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
