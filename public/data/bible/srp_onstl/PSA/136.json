  "chapter": {
    "number": 136,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Hvalite Gospoda jer je dobar,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Hvalite Boga nad bogovima,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Hvalite Gospodara nad gospodarima,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka;",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "onog što ko niko čudesa velika čini,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "onog što umešno načini nebesa,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "onog što je zemlju razastro na vodama,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "onog što načini velika svetleća tela,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "sunce da upravlja danom,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "mesec i zvezde da upravljaju noću;",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka;",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "onog što je pobio prvence Egipta,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "i iz njega izveo Izrailja,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "moćnom rukom i ispruženom mišicom,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka;",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "onog što je razdelio Crveno more napola,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "i kroz njega proveo Izrailja,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "i sručio faraona i njegovu vojsku u Crveno more,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka;",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "onog što je svoj narod po pustinji vodio,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka;",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "onog što je pogubio careve velike,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "i pobio careve silne,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Sihona, amorejskog cara,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "i Oga, vasanskoga cara,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "i njihovu je zemlju dao u nasledstvo,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "u nasledstvo za svog slugu, za Izrailj,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka;",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "onoga što nas se poniženih setio,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "i od dušmana nas izbavio naših,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "onog koji daje hranu stvorenju svakom,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Hvalite Boga nebeskog,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka!",
            "poem": 2
          }
        ]
      }
    ],
