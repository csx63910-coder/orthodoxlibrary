  "chapter": {
    "number": 80,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Prema „Ljiljanima“. Svedočenja. Psalam Asafov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "O, Pastiru Izrailja, čuj nas!",
            "poem": 1
          },
          {
            "text": "Ti što Josifa si vodio ko stado!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Zablistaj ti, što sediš nad heruvimima!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ustani u sili svojoj pred Jefremom, Venijaminom i Manasijom.",
            "poem": 1
          },
          {
            "text": "Dođi i izbavi nas.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Obnovi nas, o, Bože!",
            "poem": 1
          },
          {
            "text": "Ozari lice svoje",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da bismo se izbavili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "O, Gospode, Bože nad vojskama,",
            "poem": 1
          },
          {
            "text": "do kada ćeš srdit biti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a tvoj ti se narod moli?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Suznim hlebom ti ih hraniš,",
            "poem": 1
          },
          {
            "text": "suzama iz čanka pojiš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Od nas si napravio razdor među komšijama našim,",
            "poem": 1
          },
          {
            "text": "među sobom šegače se dušmani sa nama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "O, Bože nad vojskama, povrati nas!",
            "poem": 1
          },
          {
            "text": "Ozari lice svoje",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da bismo se izbavili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Čokot si iz Egipta iskorenio",
            "poem": 1
          },
          {
            "text": "i narode oterao da bi ga usadio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Pred njime si raskrčio i on se ukorenio,",
            "poem": 1
          },
          {
            "text": "svud po zemlji pružio je žile.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Hlad je njegov brda zasenio,",
            "poem": 1
          },
          {
            "text": "a lozama Božije kedrove.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Do mora su se granale njegove loze,",
            "poem": 1
          },
          {
            "text": "izdanci njegovi sve do Eufrata.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Zašto si mu srušio ograde",
            "poem": 1
          },
          {
            "text": "da ga bere svako ko prolazi putem?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Rovari ga divlji vepar,",
            "poem": 1
          },
          {
            "text": "glođe ga sve što se po polju miče.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Bože nad vojskama, molimo te, vrati se!",
            "poem": 1
          },
          {
            "text": "Sa nebesa pogledaj i vidi,",
            "poem": 2
          },
          {
            "text": "pobrini se za čokot ovaj;",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "za koren što si ga desnicom svojom usadio",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i mladice što si sebi ojačao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Eto, sažežen je vatrom i posečen,",
            "poem": 1
          },
          {
            "text": "oni ginu od prekornog lica tvoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Neka ruka tvoja bude nad čovekom desnice tvoje,",
            "poem": 1
          },
          {
            "text": "nad potomkom ljudi kojega si sebi ojačao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Tada se od tebe više odvratiti nećemo.",
            "poem": 1
          },
          {
            "text": "Ti nas oživi, mi ime tvoje prizivamo!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Obnovi nas Gospode, Bože nad vojskama!",
            "poem": 1
          },
          {
            "text": "Ozari lice svoje",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da bismo se izbavili.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
