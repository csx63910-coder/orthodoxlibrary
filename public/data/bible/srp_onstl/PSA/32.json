  "chapter": {
    "number": 32,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Davidov. Poučna pesma."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Blago onome kome je oprošten prestup,",
            "poem": 1
          },
          {
            "text": "kome je pokriven greh.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Blago čoveku kome Gospod ne uračunava greh",
            "poem": 1
          },
          {
            "text": "i u čijem duhu nema prevare.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Htedoh da prećutim, alʼ kosti mi usahnuše,",
            "poem": 1
          },
          {
            "text": "jer dan čitavi u vapaju sam provodio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Jer danju i noću",
            "poem": 1
          },
          {
            "text": "ruka me je tvoja teško pritiskala,",
            "poem": 2
          },
          {
            "text": "snaga mi je sahnula",
            "poem": 1
          },
          {
            "text": "kao na letnjoj žezi. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Tada priznah tebi greh svoj,",
            "poem": 1
          },
          {
            "text": "i prestup svoj nisam krio.",
            "poem": 2
          },
          {
            "text": "Rekoh: „Priznaću Gospodu svoje prestupe.“",
            "poem": 1
          },
          {
            "text": "I ti si mi prestup greha oprostio. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Zato neka ti se svaki verni moli",
            "poem": 1
          },
          {
            "text": "u vremenu kad se možeš naći;",
            "poem": 2
          },
          {
            "text": "čak i potop da jurne na njega,",
            "poem": 1
          },
          {
            "text": "silne vode sustići ga neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ti si meni utočište,",
            "poem": 1
          },
          {
            "text": "čuvaj me od nevolje;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ti me zaogrćeš radošću izbavljenja. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "„Ja ću te umudriti i poučiti",
            "poem": 1
          },
          {
            "text": "kojim putem ti valja krenuti;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "savet ću ti dati i nad tobom bdeti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ne budite kao konj ili mazga bez razuma,",
            "poem": 1
          },
          {
            "text": "koji se krote vođicama i uzdom,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "inače ti neće prići blizu.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Mnogi jadi snalaze opakoga,",
            "poem": 1
          },
          {
            "text": "a onog ko se uzda u Gospoda okružuje milost.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Radujte se u Gospodu,",
            "poem": 1
          },
          {
            "text": "veselite se, vi pravedni,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kličite, vi s čestitim srcem!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
