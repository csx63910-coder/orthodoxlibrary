  },
  "chapter": {
    "number": 40,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Za horovođu. Psalam Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Strpljivo sam čekao na Gospoda,",
            "poem": 1
          },
          {
            "text": "i on se prignuo i čuo mi vapaj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Podigao me je iz jame očaja,",
            "poem": 1
          },
          {
            "text": "iz gliba blatnjavog,",
            "poem": 2
          },
          {
            "text": "noge mi je postavio na stenu,",
            "poem": 1
          },
          {
            "text": "i učvrstio korake moje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "U usta mi je stavio novu pesmu,",
            "poem": 1
          },
          {
            "text": "hvalospev Bogu našem.",
            "poem": 2
          },
          {
            "text": "Mnogi će to videti, bojati se,",
            "poem": 1
          },
          {
            "text": "i pouzdati se u Gospoda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Blago čoveku koji se uzda u Gospoda,",
            "poem": 1
          },
          {
            "text": "a ne okreće se oholima,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ili onima što idu za prevarom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Mnoga si svoja čudesa učinio za nas, Gospode, Bože moj,",
            "poem": 1
          },
          {
            "text": "i naumi su tvoji za nas neizbrojivi.",
            "poem": 2
          },
          {
            "text": "A ja ću javljati, govoriti o njima,",
            "poem": 1
          },
          {
            "text": "kojima nema broja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Žrtve i prinose nisi poželeo,",
            "poem": 1
          },
          {
            "text": "ali si mi zato uši otvorio.",
            "poem": 2
          },
          {
            "text": "U žrtvama svespalnicama",
            "poem": 1
          },
          {
            "text": "i žrtvama za greh nisi uživao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Tada rekoh: „Evo, dolazim,",
            "poem": 1
          },
          {
            "text": "jer je tako napisano za mene u svitku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Želim da izvršim volju tvoju, Bože moj;",
            "poem": 1
          },
          {
            "text": "Zakon je tvoj u mom srcu.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Objavljujem pravednost u velikom zboru,",
            "poem": 1
          },
          {
            "text": "ustima svojim to ne branim, Gospode,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i ti to znaš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Pravednost tvoju ne krijem u srcu,",
            "poem": 1
          },
          {
            "text": "već govorim o vernosti i spasenju tvome,",
            "poem": 2
          },
          {
            "text": "ne skrivam milost i istinu tvoju od velikog zbora.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Gospode, ne uskraćuj mi milosrđe tvoje;",
            "poem": 1
          },
          {
            "text": "neka me milost i vernost tvoja štite doveka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Jer okružiše me nevolje nebrojene,",
            "poem": 1
          },
          {
            "text": "bezakonja me moja sustigoše, videti ne mogu.",
            "poem": 2
          },
          {
            "text": "Brojni su kao kosa na mojoj glavi,",
            "poem": 1
          },
          {
            "text": "pa me srce moje izdaje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Neka ti je milo, Gospode, da me izbaviš!",
            "poem": 1
          },
          {
            "text": "U pomoć mi požuri, Gospode!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Neka se postide zajedno, neka se osramote",
            "poem": 1
          },
          {
            "text": "oni što mi o glavi rade da je smaknu;",
            "poem": 2
          },
          {
            "text": "neka se povuku u sramoti, neka budu poniženi",
            "poem": 1
          },
          {
            "text": "ti što im je mila nevolja moja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Neka se zapanje nad sramotom svojom,",
            "poem": 1
          },
          {
            "text": "ti što mi dovikuju: „Aha! Aha!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Nek likuju i nek se raduju u tebi",
            "poem": 1
          },
          {
            "text": "svi koji te traže;",
            "poem": 2
          },
          {
            "text": "neka uvek govore oni što spasenje tvoje vole:",
            "poem": 1
          },
          {
            "text": "„Velik je Gospod!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "A ja sam siromah i ubog,",
            "poem": 1
          },
          {
            "text": "neka Gospod misli na mene.",
            "poem": 2
          },
          {
            "text": "Ti si mi pomoćnik i izbavitelj.",
            "poem": 1
          },
          {
            "text": "O, moj Bože, ne oklevaj!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
