  "chapter": {
    "number": 13,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Psalam Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Dokle više, dokle, o, Gospode?",
            "poem": 1
          },
          {
            "text": "Zar ćeš me ti vazdan zaboravljati?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Dokle ćeš od mene svoje lice kriti?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Dokle više da se pitam u duši,",
            "poem": 1
          },
          {
            "text": "i svaki dan u srcu tugujem?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Dokle će dušmanin da bude nada mnom?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Pogledaj, usliši me, Gospode,",
            "poem": 1
          },
          {
            "text": "Bože moj, oči mi prosvetli,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da u san smrtni ja ne utonem,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "da ne kaže neprijatelj:",
            "poem": 1
          },
          {
            "text": "„Ja sam ga nadjačao“,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i protivnici ne likuju nada mnom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "A ja ću se u tvoju milost uzdati,",
            "poem": 1
          },
          {
            "text": "tvome se spasenju u srcu radovati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Pevaću Gospodu, jer mi je bio dobrostiv.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
