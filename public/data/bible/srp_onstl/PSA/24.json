  "chapter": {
    "number": 24,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Psalam Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Gospodu pripada zemlja i sve što je na njoj,",
            "poem": 1
          },
          {
            "text": "svet i svi koji žive na njemu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Jer on ga je utemeljio na morima,",
            "poem": 1
          },
          {
            "text": "na vodama ga osnovao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ko će da se uspne na goru Gospodnju?",
            "poem": 1
          },
          {
            "text": "Ko će da stane na sveto mesto njegovo?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Onaj kome su ruke nedužne,",
            "poem": 1
          },
          {
            "text": "čovek koji ima srce bez mane,",
            "poem": 2
          },
          {
            "text": "čija duša ne sledi ispraznost,",
            "poem": 1
          },
          {
            "text": "i koji se ne zaklinje lažno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "On će požnjeti blagoslov od Gospoda,",
            "poem": 1
          },
          {
            "text": "i pravednost od Boga, svog Spasitelja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Takav je naraštaj onih koji ga traže,",
            "poem": 1
          },
          {
            "text": "koji traže lice tvoje, Bože Jakovljev. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Dignite, o, vrata, svoje nadvratnike,",
            "poem": 1
          },
          {
            "text": "dignite se, dveri večne,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da uđe Car slave.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ko je taj Car slave?",
            "poem": 1
          },
          {
            "text": "Gospod jak i junačan,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Gospod silan u boju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Dignite, o, vrata, svoje nadvratnike,",
            "poem": 1
          },
          {
            "text": "dignite se, dveri večne,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da uđe Car slave.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ko je taj Car slave?",
            "poem": 1
          },
          {
            "text": "Gospod nad vojskama,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "on je taj Car slave. Sela",
            "poem": 2
          }
        ]
      }
    ],
