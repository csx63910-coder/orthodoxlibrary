  "chapter": {
    "number": 54,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi, uz žičane instrumente. Davidova poučna pesma, kada su Zifejci došli Saulu i rekli: „Ne krije li se David kod nas?“"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Bože, imenom me svojim spasi",
            "poem": 1
          },
          {
            "text": "i snagom me svojom ti odbrani.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Bože, čuj molitvu moju;",
            "poem": 1
          },
          {
            "text": "reči usta mojih poslušaj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jer, protiv mene ustaju tuđinci;",
            "poem": 1
          },
          {
            "text": "moju dušu traže bezdušnici;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "oni Boga nemaju pred sobom. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Gle, Bog mi je pomoćnik;",
            "poem": 1
          },
          {
            "text": "Gospod je među onima što mi dušu podupiru.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Vratilo se zlo mrzitelju mome;",
            "poem": 1
          },
          {
            "text": "ti ih satri u vernosti svojoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Rado ću ti žrtvovati;",
            "poem": 1
          },
          {
            "text": "hvaliću ime tvoje, Gospode,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer je dobro.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Jer ono me je izbavilo iz svake nevolje",
            "poem": 1
          },
          {
            "text": "i oko mi pobednički gleda protivnike moje.",
            "poem": 2
          }
        ]
      }
    ],
