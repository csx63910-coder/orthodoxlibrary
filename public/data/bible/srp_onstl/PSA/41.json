  "chapter": {
    "number": 41,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Za horovođu. Psalam Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Blago onom koji misli na siromaha,",
            "poem": 1
          },
          {
            "text": "Gospod ga izbavlja u dan nevolje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Gospod ga čuva i drži u životu,",
            "poem": 1
          },
          {
            "text": "on će ga blagosloviti u zemlji,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "neće ga izručiti želji dušmana njegovih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Gospod će ga krepiti na postelji boli;",
            "poem": 1
          },
          {
            "text": "ti ćeš ga od bolesti oporaviti na ležaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Rekoh: „Gospode, smiluj mi se,",
            "poem": 1
          },
          {
            "text": "isceli mi dušu, jer sam ti zgrešio.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Neprijatelji zlurado govore o meni:",
            "poem": 1
          },
          {
            "text": "„Kada će umreti? Kada će mu se ime zatrti?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Kad mi ko u posetu dođe, govori koješta,",
            "poem": 1
          },
          {
            "text": "a u srcu skuplja pakost;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kad izađe onda javno kaže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Zajedno protiv mene šapuću svi što me mrze,",
            "poem": 1
          },
          {
            "text": "nesreću mi predviđaju:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "„Kobna ga je bolest udarila;",
            "poem": 1
          },
          {
            "text": "legao je i dići se više neće.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Pa i bližnji moj kome sam verovao,",
            "poem": 1
          },
          {
            "text": "onaj koji sa mnom jede, okrenu se protiv mene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "A ti, Gospode, smiluj mi se,",
            "poem": 1
          },
          {
            "text": "podigni me, da im vratim milo za drago.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Po ovome znam da sam ti ugodan,",
            "poem": 1
          },
          {
            "text": "jer moj neprijatelj ne likuje nada mnom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "U mome me poštenju podrži,",
            "poem": 1
          },
          {
            "text": "pred svoje me lice postavi doveka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Blagosloven da je Gospod, Bog Izrailjev,",
            "poem": 1
          },
          {
            "text": "od veka i do veka. Amin. Amin.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
