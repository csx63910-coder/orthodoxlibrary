  "chapter": {
    "number": 33,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Uskliknite u Gospodu, pravedni,",
            "poem": 1
          },
          {
            "text": "slaviti ga priliči poštenima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Hvalite Gospoda harfom,",
            "poem": 1
          },
          {
            "text": "svirajte mu na liri od deset struna,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Pevajte mu novu pesmu,",
            "poem": 1
          },
          {
            "text": "svirajte skladno uz klicanje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Jer prava je reč Gospodnja,",
            "poem": 1
          },
          {
            "text": "dosledan je on u svakom delu svome.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "On voli pravednost i pravdu,",
            "poem": 1
          },
          {
            "text": "puna je zemlja milosti Gospodnje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Rečju Gospodnjom nebesa su stvorena,",
            "poem": 1
          },
          {
            "text": "i dahom usta njegovih sva vojska njihova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "On sabire vode morske kao gomilu,",
            "poem": 1
          },
          {
            "text": "dubine on stavlja u skladišta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Cela zemlja nek se boji Gospoda,",
            "poem": 1
          },
          {
            "text": "nek strepe pred njim svi žitelji sveta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Jer on reče, i sve postade,",
            "poem": 1
          },
          {
            "text": "on naredi, i sve se stvori.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Gospod razbija namere pucima,",
            "poem": 1
          },
          {
            "text": "i remeti naume narodima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Namera Gospodnja ostaje doveka,",
            "poem": 1
          },
          {
            "text": "misli srca njegovog od kolena do kolena.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Blago narodu kome je Bog Gospod,",
            "poem": 1
          },
          {
            "text": "narodu koji izabra sebi za baštinu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Gospod posmatra sa nebesa,",
            "poem": 1
          },
          {
            "text": "on sve ljude vidi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Iz svog boravišta",
            "poem": 1
          },
          {
            "text": "on motri sve žitelje zemlje,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "on oblikuje srce njihovo,",
            "poem": 1
          },
          {
            "text": "on proniče sva njihova dela.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ne spasava cara vojska mnogobrojna,",
            "poem": 1
          },
          {
            "text": "silna snaga ne izbavlja junaka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Zaludno je u konju tražiti spasenje,",
            "poem": 1
          },
          {
            "text": "velika sila neće ga izbaviti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Oko je Gospodnje nad onima što ga se boje,",
            "poem": 1
          },
          {
            "text": "nad onima koji očekuju milost njegovu,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "da im dušu od smrti izbavi,",
            "poem": 1
          },
          {
            "text": "život im sačuva u vreme gladi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Naša duša čeka na Gospoda;",
            "poem": 1
          },
          {
            "text": "on je naša pomoć, štit naš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "U njemu se srce naše raduje,",
            "poem": 1
          },
          {
            "text": "jer se uzdamo u sveto ime njegovo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Neka milost tvoja bude nad nama, Gospode,",
            "poem": 1
          },
          {
            "text": "jer smo nadu svoju položili u tebe.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
