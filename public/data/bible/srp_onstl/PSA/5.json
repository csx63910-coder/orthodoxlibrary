  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi, uz frule: Davidov psalam."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "O, Gospode, počuj moje reči,",
            "poem": 1
          },
          {
            "text": "i razmotri uzdisaje moje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Čuj moj vapaj, care moj i Bože,",
            "poem": 1
          },
          {
            "text": "jer tebi svoju upravljam molitvu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jutrom, Gospode, ti glas mi čuješ,",
            "poem": 1
          },
          {
            "text": "jutrom tebi prinosim molitvu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "netremice pazim, iščekujem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Jer ti nisi Bog kome zločin prija,",
            "poem": 1
          },
          {
            "text": "zlo ne može tvojim gostom biti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Oholi ti na oči ne mogu izaći,",
            "poem": 1
          },
          {
            "text": "mrziš sve što čine nepravdu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ti zatireš one što govore laži,",
            "poem": 1
          },
          {
            "text": "krvožedne i podmukle Gospod ne podnosi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "A ja ću u Dom tvoj doći,",
            "poem": 1
          },
          {
            "text": "po obilnom tvome smilovanju,",
            "poem": 2
          },
          {
            "text": "pred tvojim ću svetim Domom biti,",
            "poem": 1
          },
          {
            "text": "u strahu se tebi pokloniti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Svojom me pravdom vodi, Gospode,",
            "poem": 1
          },
          {
            "text": "zbog mrzitelja koji mi zasedu spremaju;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "put svoj poravnaj preda mnom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Istine im nema na usnama,",
            "poem": 1
          },
          {
            "text": "srce im je ispunjeno zlobom,",
            "poem": 2
          },
          {
            "text": "grob otvoren grlo je njihovo,",
            "poem": 1
          },
          {
            "text": "a jezik im laska prevrtljivo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "O, Bože, krivim ih proglasi,",
            "poem": 1
          },
          {
            "text": "spletke njihove nek ih upropaste.",
            "poem": 2
          },
          {
            "text": "Za grehe ih mnoge izagnaj,",
            "poem": 1
          },
          {
            "text": "jer na tebe oni ustadoše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Neka se raduju svi što u tebi utočište traže,",
            "poem": 1
          },
          {
            "text": "neka se doveka vesele koje ti zaklanjaš,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "neka kliču oni koji ime tvoje ljube.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Jer ti, Gospode, blagosiljaš pravednog,",
            "poem": 1
          },
          {
            "text": "milošću ga kao štitom zaklanjaš.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
