  "chapter": {
    "number": 8,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi, „Radosnica“. Psalam Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "O, Gospode, naš Bože,",
            "poem": 1
          },
          {
            "text": "kako je uzvišeno ime tvoje po svoj zemlji!",
            "poem": 2
          },
          {
            "text": "Ti si hvalu sebi",
            "poem": 1
          },
          {
            "text": "dao na nebesima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Sa usana dece i dojenčadi,",
            "poem": 1
          },
          {
            "text": "ti si sebi moć podigao",
            "poem": 2
          },
          {
            "text": "radi svojih neprijatelja;",
            "poem": 1
          },
          {
            "text": "da ućutkaš dušmanina i osvetnika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Kad pogledam tvoja nebesa,",
            "poem": 1
          },
          {
            "text": "koje tvoji prsti načiniše,",
            "poem": 2
          },
          {
            "text": "mesec i zvezde koje ti postavi…",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Šta je čovek da ga se sećaš,",
            "poem": 1
          },
          {
            "text": "šta li sin čovečiji da brineš za njega?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ti si ga malo manjim od Boga učinio,",
            "poem": 1
          },
          {
            "text": "slavom i čašću njega si ovenčao,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "dela ruku svojih u vlast si mu dao,",
            "poem": 1
          },
          {
            "text": "njemu pod noge sve si pokorio:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "sve ovce i goveda,",
            "poem": 1
          },
          {
            "text": "i zverinje poljsko,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "ptice nebeske, i ribe morske,",
            "poem": 1
          },
          {
            "text": "što plivaju morskim stazama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "O, Gospode, naš Bože,",
            "poem": 1
          },
          {
            "text": "kako je uzvišeno ime tvoje po svoj zemlji!",
            "poem": 2
          }
        ]
      }
    ],
