  "chapter": {
    "number": 114,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Kada je iz Egipta izašao Izrailj,",
            "poem": 1
          },
          {
            "text": "dom Jakovljev iz naroda tuđinskog jezika,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Juda je postao njegovo Svetilište",
            "poem": 1
          },
          {
            "text": "i Izrailj carstvo njegovo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Videlo to more, pa ustuknu,",
            "poem": 1
          },
          {
            "text": "a i Jordan poteče unazad.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ko ovnovi poskakaše gore",
            "poem": 1
          },
          {
            "text": "i brežuljci poput jaganjaca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "More, što si uteklo?",
            "poem": 1
          },
          {
            "text": "Jordane, što si unazad potekao?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Gore, što skačete ko ovnovi",
            "poem": 1
          },
          {
            "text": "i vi, brežuljci, poput jaganjaca?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Pred Gospodom potresi se, zemljo,",
            "poem": 1
          },
          {
            "text": "pred Jakovljevim Bogom;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "što pretvara stenu u jezero,",
            "poem": 1
          },
          {
            "text": "kremen-kamen u svoj izvor vode.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
