  "chapter": {
    "number": 11,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Utočište je meni u Gospodu.",
            "poem": 1
          },
          {
            "text": "Zašto onda meni govorite:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Kao ptica u goru uteci!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Jer, gle, opaki luk svoj natežu,",
            "poem": 1
          },
          {
            "text": "na tetivu strelu postavljaju,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da poštene iz mraka gađaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Kada se temelji raspadaju,",
            "poem": 1
          },
          {
            "text": "šta pravednik može da učini?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Gospod je u svom svetom hramu,",
            "poem": 1
          },
          {
            "text": "Gospodnji je presto na nebesima,",
            "poem": 2
          },
          {
            "text": "očima on pomno posmatra,",
            "poem": 1
          },
          {
            "text": "on proniče potomke ljudi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Pravednoga ispituje Gospod,",
            "poem": 1
          },
          {
            "text": "ali duša njegova mrzi onoga,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ko je opak i voli nasilje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Na opakog on će sručiti",
            "poem": 1
          },
          {
            "text": "užareno ugljevlje i sumpor;",
            "poem": 2
          },
          {
            "text": "plamenovi ognjenog vihora,",
            "poem": 1
          },
          {
            "text": "to je deo njihov, to im je u čaši.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Jer pravedan je Gospod,",
            "poem": 1
          },
          {
            "text": "pravednost on voli,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pošteni će gledati mu lice.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
