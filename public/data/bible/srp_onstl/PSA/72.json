  },
  "chapter": {
    "number": 72,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Solomonu."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "O, Bože, propise svoje caru podaj",
            "poem": 1
          },
          {
            "text": "i pravednost svoju sinu carevome!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Nek narodu tvome on pravedno sudi",
            "poem": 1
          },
          {
            "text": "i siromasima prema propisima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Neka gore narodu mir donesu",
            "poem": 1
          },
          {
            "text": "i brda pravednost.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "On će siromasima da sudi,",
            "poem": 1
          },
          {
            "text": "deci ubogih pobedu daće",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i skršiće tlačitelja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Bojaće te se ljudi dok je sunca i meseca,",
            "poem": 1
          },
          {
            "text": "od roda do roda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Spustiće se kao kiša na košenu travu",
            "poem": 1
          },
          {
            "text": "i poput pljuskova natapaće zemlju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "U njegovim danima procvetaće pravednik",
            "poem": 1
          },
          {
            "text": "i obilje mira dok meseca bude bilo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Vladaće od mora do mora",
            "poem": 1
          },
          {
            "text": "i od reke do krajeva gde zemlja prestaje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Kleknuće pred njim pustinjska plemena,",
            "poem": 1
          },
          {
            "text": "protivnici njegovi lizaće prašinu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Prineće mu prinos",
            "poem": 1
          },
          {
            "text": "carevi tarsiski i ostrvski;",
            "poem": 2
          },
          {
            "text": "carevi Save i Seve",
            "poem": 1
          },
          {
            "text": "danak će da daju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Pokloniće mu se svi carevi,",
            "poem": 1
          },
          {
            "text": "svi narodi služiće mu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Jer on će da izbavi ubogog što za pomoć vapi,",
            "poem": 1
          },
          {
            "text": "i siromaha bez pomoći niotkuda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Poštedeće slabog i ubogog,",
            "poem": 1
          },
          {
            "text": "živote ubogih spasti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Od tlačenja i nasilja život njihov otkupiće,",
            "poem": 1
          },
          {
            "text": "očima njegovim krv njihova dragocena će biti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Živ nek bude!",
            "poem": 1
          },
          {
            "text": "Nek mu daju od zlata savskoga;",
            "poem": 2
          },
          {
            "text": "neka stalno za njega se mole,",
            "poem": 1
          },
          {
            "text": "od jutra do sutra blagosiljaju ga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Nek pšenicom obiluje zemlja,",
            "poem": 1
          },
          {
            "text": "nek se rod njegov povija na vrhu gora, kao na Livanu;",
            "poem": 2
          },
          {
            "text": "nek procveta narod iz gradova",
            "poem": 1
          },
          {
            "text": "ko trava zemaljska.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Njegovo ime nek bude doveka,",
            "poem": 1
          },
          {
            "text": "neka traje dokle je i sunca.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Nek u njemu svi narodi blagoslove se",
            "poem": 1
          },
          {
            "text": "i blaženim nek ga nazivaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Blagosloven bio Gospod Bog, Bog Izrailja,",
            "poem": 1
          },
          {
            "text": "on jedini čudesa čini.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "I blagosloveno doveka bilo njegovo slavno ime,",
            "poem": 1
          },
          {
            "text": "nek svu zemlju slava mu ispuni.",
            "poem": 2
          },
          "Amin! Amin!"
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Dovršiše se molitve Davida, sina Jesejevog.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
