  "chapter": {
    "number": 14,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Za horovođu. Davidov psalam."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Bezumnik u svom srcu kaže:",
            "poem": 1
          },
          {
            "text": "„Nema Boga!“",
            "poem": 2
          },
          {
            "text": "Dela su im opaka i gadna,",
            "poem": 1
          },
          {
            "text": "nema nikoga da čini dobro.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Gospod s neba gleda potomke ljudi,",
            "poem": 1
          },
          {
            "text": "da vidi ima li razumnoga,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "takvoga koji traži Boga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Od Boga se svi odvratiše,",
            "poem": 1
          },
          {
            "text": "pokvareni svi postadoše;",
            "poem": 2
          },
          {
            "text": "nema toga koji čini dobro,",
            "poem": 1
          },
          {
            "text": "takvoga nijednoga nema.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Zar ne znaju svi ti zlikovci,",
            "poem": 1
          },
          {
            "text": "da moj narod kao hleb proždiru,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a ni samog Gospoda ne prizivaju?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Tu će njih strah silni spopasti,",
            "poem": 1
          },
          {
            "text": "jer je Bog s rodom pravedničkim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Rugate se onom što ubogi misli,",
            "poem": 1
          },
          {
            "text": "ali utočište je njemu u Gospodu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ko će sa Siona dati spasenje Izrailju?",
            "poem": 1
          },
          {
            "text": "Kada Gospod vrati svoj narod izgnani,",
            "poem": 2
          },
          {
            "text": "radovaće se Jakov,",
            "poem": 1
          },
          {
            "text": "veseliće se Izrailj.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
