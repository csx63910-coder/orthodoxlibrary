  "chapter": {
    "number": 60,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Prema „Ljiljanima“. Svedočenja. Davidova pesma pouzdanja u Boga. Za pouku: kada se borio protiv Aram-Naharajima i Aram-Sove i kada se Joav vratio, pa u Slanoj dolini pobio dvanaest hiljada Edomaca."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Odbacio si nas, Bože,",
            "poem": 1
          },
          {
            "text": "srušio nas, razgnevio se.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Oporavi nas!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ti si zemlju uzdrmao,",
            "poem": 1
          },
          {
            "text": "rascepao si je;",
            "poem": 2
          },
          {
            "text": "raseline njene spoji",
            "poem": 1
          },
          {
            "text": "jer je uzdrmana.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Pustio si da tvoj narod vidi strahotu,",
            "poem": 1
          },
          {
            "text": "primorao da pijemo vino što opija.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Zastavu si bogobojaznima dao",
            "poem": 1
          },
          {
            "text": "da se zbog istine",
            "poem": 2
          },
          {
            "noteId": 5
          },
          {
            "text": "razvije. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Desnicom nas svojom spasi, usliši nas,",
            "poem": 1
          },
          {
            "text": "pa da tvoji miljenici izbavljeni budu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "U svom Svetilištu Bog je objavio:",
            "poem": 1
          },
          {
            "text": "„Zaklicaću, podeliću Sihem,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "premeriću dolinu Sokota.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Moj je Galad, moj je Manasija;",
            "poem": 1
          },
          {
            "text": "Jefrem mi je kaciga na glavi,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a Juda mi carsko žezlo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Moav mi je korito za pranje,",
            "poem": 1
          },
          {
            "text": "na Edom sam bacio sandalu;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Filistejo, zbog mene usklikni!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ko će mene da otprati u grad utvrđeni?",
            "poem": 1
          },
          {
            "text": "A na Edom ko će me povesti?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Nećeš li ti, o, Bože,",
            "poem": 1
          },
          {
            "text": "koji si nas odbacio,",
            "poem": 2
          },
          {
            "text": "pa s vojskama našim, Bože,",
            "poem": 1
          },
          {
            "text": "više ne koračaš?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Pomoć daj nam ispred protivnika,",
            "poem": 1
          },
          {
            "text": "uzalud je ljudsko izbavljenje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Silno ćemo stupati sa Bogom,",
            "poem": 1
          },
          {
            "text": "izgaziće naše protivnike!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 5,
        "caller": "+",
        "text": "60,4 Ili: zbog luka.",
        "reference": {
          "chapter": 60,
          "verse": 4
        }
      }
    ]
