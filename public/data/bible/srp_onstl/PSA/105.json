  },
  "chapter": {
    "number": 105,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Hvalite Gospoda, prizivajte mu ime,",
            "poem": 1
          },
          {
            "text": "objavite njegova dela među narodima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Pevajte mu, slavite ga pesmom,",
            "poem": 1
          },
          {
            "text": "govorite o svim njegovim čudesima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Hvalite se svetim imenom njegovim,",
            "poem": 1
          },
          {
            "text": "nek se raduju srca onih koji traže Gospoda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Tražite Gospoda i njegovu snagu,",
            "poem": 1
          },
          {
            "text": "tražite svagda lice njegovo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Pamtite čudesa koja je učinio,",
            "poem": 1
          },
          {
            "text": "čuda i sudove usta njegovih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "O, seme Avrahamovo, slugo njegov,",
            "poem": 1
          },
          {
            "text": "deco Jakovljeva, izabranici njegovi!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "On je Gospod, Bog naš,",
            "poem": 1
          },
          {
            "text": "sudovi su njegovi po svoj zemlji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "On se seća uvek njegovog saveza,",
            "poem": 1
          },
          {
            "text": "reči što je zapovedi za hiljadu naraštaja,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "koji je sklopio sa Avrahamom,",
            "poem": 1
          },
          {
            "text": "i kojim se zakleo Isaku,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "za uredbu ga je postavio Jakovu,",
            "poem": 1
          },
          {
            "text": "Izrailju za večni savez,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "govoreći: „Tebi ću dati zemlju hanansku,",
            "poem": 1
          },
          {
            "text": "kao deo vašega nasledstva.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Dok ih je još bilo malo,",
            "poem": 1
          },
          {
            "text": "tek šačica došljaka u zemlji,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "lutajući od naroda do naroda,",
            "poem": 1
          },
          {
            "text": "od jednog carstva do drugog,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "nije dao nikom da ih tlači,",
            "poem": 1
          },
          {
            "text": "radi njih je kažnjavao careve:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "„Ne dirajte moje pomazanike,",
            "poem": 1
          },
          {
            "text": "mojim prorocima zlobu ne činite!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "On je glad prizvao na zemlju,",
            "poem": 1
          },
          {
            "text": "ukinuo svako snabdevanje hlebom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Čoveka je poslao pred njima,",
            "poem": 1
          },
          {
            "text": "Josifa, prodanog u roblje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Noge su mu sputali lancima,",
            "poem": 1
          },
          {
            "text": "a vrat su mu okovali gvožđem;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "sve do časa kad se ispunila reč o njemu,",
            "poem": 1
          },
          {
            "text": "reč Gospodnja ga je prokušala.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Car je zapovedio da ga puste,",
            "poem": 1
          },
          {
            "text": "vladar naroda ga je oslobodio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Postavio ga je za gospodara kuće,",
            "poem": 1
          },
          {
            "text": "za upravitelja svih svojih dobara;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "da po svojoj volji vodi mu glavare,",
            "poem": 1
          },
          {
            "text": "starešine mu mudro savetuje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Tako je Izrailj došao u Egipat;",
            "poem": 1
          },
          {
            "text": "Jakov, došljak u Hamovoj zemlji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "I on je veoma umnožio svoj narod,",
            "poem": 1
          },
          {
            "text": "brojniji su bili od svojih dušmana.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Okrenuo im je srce da zamrze njegov narod,",
            "poem": 1
          },
          {
            "text": "da mu se na sluge pakosno okome.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Poslao je Mojsija, svog slugu,",
            "poem": 1
          },
          {
            "text": "i Arona, svog izabranika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "I oni su pred njima prikazali njegove znakove",
            "poem": 1
          },
          {
            "text": "i čudesa po Hamovoj zemlji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Spustio je tamu na nju, pomračio je,",
            "poem": 1
          },
          {
            "text": "i oni",
            "poem": 2
          },
          {
            "noteId": 10
          },
          {
            "text": "nisu bili neposlušni njegovoj reči.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Vode im je u krv pretvorio",
            "poem": 1
          },
          {
            "text": "i ribe im pomorio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Zemlja im je vrvela od žaba,",
            "poem": 1
          },
          {
            "text": "čak i odaje njihovih careva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Zapovedio je, pa su obadi i komarci",
            "poem": 1
          },
          {
            "text": "navalili na sve njihove krajeve.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Grad im je kao kišu dao",
            "poem": 1
          },
          {
            "text": "i plamene munje po njihovoj zemlji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Loze im je i smokve slomio,",
            "poem": 1
          },
          {
            "text": "skršio im stabla po njihovom kraju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Zapovedio je, pa su grunuli",
            "poem": 1
          },
          {
            "text": "bezbrojni skakavci i gusenice.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Obrstili su sve bilje njihove zemlje,",
            "poem": 1
          },
          {
            "text": "pojeli im letinu sa polja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Pobio je sve prvence njihove zemlje,",
            "poem": 1
          },
          {
            "text": "prvi plod sve njihove muževnosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Izveo ih je sa srebrom i zlatom,",
            "poem": 1
          },
          {
            "text": "među njegovim plemenima nije bilo posrnulih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "Egipat je odahnuo kada su izašli,",
            "poem": 1
          },
          {
            "text": "jer ih je od njih spopala strahota.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          {
            "text": "Oblak je kao zaklon razastro",
            "poem": 1
          },
          {
            "text": "i plamen da noću svetli.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          {
            "text": "Molili su ga i on im dovede prepelice,",
            "poem": 1
          },
          {
            "text": "hlebom s neba ih nasiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          {
            "text": "Otvorio je stenu i vode prokuljaše,",
            "poem": 1
          },
          {
            "text": "potekle su kao potok u zemlji suvoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          {
            "text": "Jer se setio svog svetog obećanja Avrahamu,",
            "poem": 1
          },
          {
            "text": "sluzi svome.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          {
            "text": "Izveo je svoj narod u radosti,",
            "poem": 1
          },
          {
            "text": "uz klicanje svoje izabrane.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          {
            "text": "Dao im je zemlje tuđinske,",
            "poem": 1
          },
          {
            "text": "zaposeli su trud naroda;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          {
            "text": "da bi se držali njegovih propisa",
            "poem": 1
          },
          {
            "text": "i zakone njegove slušali.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Slavite Gospoda!",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": [
