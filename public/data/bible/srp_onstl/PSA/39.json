  "chapter": {
    "number": 39,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi, za Jedutuna. Psalam Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Zarekoh se: „Paziću na put svoj da ne zgrešim jezikom,",
            "poem": 1
          },
          {
            "text": "držaću uzde na ustima, sve dok je opaki preda mnom.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Zanemeh, zaćutah, čak ni što je dobro ne rekoh,",
            "poem": 1
          },
          {
            "text": "ali bol moj samo žešći posta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Zapalilo se srce u meni,",
            "poem": 1
          },
          {
            "text": "u mislima mojim planuo je oganj,",
            "poem": 2
          },
          {
            "text": "te ja progovorih svojim jezikom:",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "„Objavi mi, Gospode, moj svršetak",
            "poem": 1
          },
          {
            "text": "i kolika je dužina mojih dana,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da bih znao kako sam prolazan.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Eto, dao si mi dane ne duže od pedlja,",
            "poem": 1
          },
          {
            "text": "i vek je moj kao ništa pred tobom;",
            "poem": 2
          },
          {
            "text": "svaki čovek, naizgled siguran,",
            "poem": 1
          },
          {
            "text": "tek je dašak. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Baš kao senka čovek prolazi;",
            "poem": 1
          },
          {
            "text": "uzalud se kida i skuplja bogatstvo,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a ne zna ko će ga pobrati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Čemu sada da se nadam, Gospode?",
            "poem": 1
          },
          {
            "text": "Moja nada je u tebi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Izbavi me od svih mojih prestupa,",
            "poem": 1
          },
          {
            "text": "ne daj da budem na podsmeh bezumniku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ja sam nem, ne otvaram usta,",
            "poem": 1
          },
          {
            "text": "jer ti si to sam učinio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ukloni svoj bič od mene,",
            "poem": 1
          },
          {
            "text": "izgiboh od siline ruke tvoje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Kad opomenama karaš čoveka zbog greha,",
            "poem": 1
          },
          {
            "text": "kao moljac rastačeš što mu je najdraže;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da, svaki čovek je tek dašak. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Poslušaj, Gospode, moju molitvu i čuj moj vapaj,",
            "poem": 1
          },
          {
            "text": "ne ogluši se o moje suze,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer kao došljak kod tebe prebivam, kao svi preci moji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Odvrati svoj pogled od mene, da odahnem,",
            "poem": 1
          },
          {
            "text": "pre nego što odem i ne bude me više.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
