  "chapter": {
    "number": 108,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Pesma. Psalam Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Srce mi je voljno, Bože,",
            "poem": 1
          },
          {
            "text": "da ti pevam,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da ti sviram bićem svojim!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Budite se, o, liro i harfo,",
            "poem": 1
          },
          {
            "text": "ja bih zoru da probudim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "O, Gospode, hvaliću te među narodima,",
            "poem": 1
          },
          {
            "text": "slaviću te među tuđincima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Jer je velika milost tvoja, povrh je nebesa;",
            "poem": 1
          },
          {
            "text": "do oblaka seže vernost tvoja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Neka si uzvišen vrh nebesa, Bože;",
            "poem": 1
          },
          {
            "text": "slava tvoja nek je nad svom zemljom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Desnicom nas svojom spasi, usliši nas,",
            "poem": 1
          },
          {
            "text": "pa da tvoji miljenici izbavljeni budu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "U svom Svetilištu Bog je objavio:",
            "poem": 1
          },
          {
            "text": "„Zaklicaću, podeliću Sihem,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "premeriću dolinu Sokota.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Moj je Galad, moj je Manasija;",
            "poem": 1
          },
          {
            "text": "Jefrem mi je kaciga na glavi,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a Juda mi carsko žezlo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Moav mi je korito za pranje,",
            "poem": 1
          },
          {
            "text": "na Edom sam bacio sandalu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "uskliknuću povrh Filisteje!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ko će mene da otprati u grad utvrđeni?",
            "poem": 1
          },
          {
            "text": "A na Edom ko će me povesti?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Nećeš li ti, o, Bože,",
            "poem": 1
          },
          {
            "text": "koji si nas odbacio,",
            "poem": 2
          },
          {
            "text": "pa s vojskama našim, Bože,",
            "poem": 1
          },
          {
            "text": "više ne koračaš?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Pomoć daj nam ispred protivnika,",
            "poem": 1
          },
          {
            "text": "uzalud je ljudsko izbavljenje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Silno ćemo stupati sa Bogom,",
            "poem": 1
          },
          {
            "text": "izgaziće naše protivnike!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
