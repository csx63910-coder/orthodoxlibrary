  "chapter": {
    "number": 76,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi, uz žičane instrumente. Asafov psalam. Pesma."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Bog je poznat u Judi,",
            "poem": 1
          },
          {
            "text": "ime mu je uzvišeno u Izrailju!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Salim mu je konak,",
            "poem": 1
          },
          {
            "text": "na Sionu mu stan.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Tamo je slomio strelu zapaljenu,",
            "poem": 1
          },
          {
            "text": "štit i mač i sprave ratničke. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ti blistaš,",
            "poem": 1
          },
          {
            "text": "slavniji si od tih brda sa plenom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ljudi hrabrog srca su oplenjeni,",
            "poem": 1
          },
          {
            "text": "pozaspaše;",
            "poem": 2
          },
          {
            "text": "jaki ljudi,",
            "poem": 1
          },
          {
            "text": "alʼ ni ruku da podignu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Zaspaše doveka od pokliča tvoga,",
            "poem": 1
          },
          {
            "text": "o, Bože Jakovljev, i konj i konjanik!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ti! Ti si strašan!",
            "poem": 1
          },
          {
            "text": "Kad se gneviš, ko pred tobom može da opstane?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Sa nebesa ti sud javljaš.",
            "poem": 1
          },
          {
            "text": "Zemlja se preplaši, onemi,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "kad ustaje Bog da sudi",
            "poem": 1
          },
          {
            "text": "i da spase sve ponizne na zemlji. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Proslavljaš se i ljudskim gnevom,",
            "poem": 1
          },
          {
            "text": "opasuješ se preživelima od gneva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Zavetujte se i zavete izvršite Gospodu, svome Bogu;",
            "poem": 1
          },
          {
            "text": "svi koji su oko njega,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "nek Strašnome dar donesu!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Vladarima on duh obara,",
            "poem": 1
          },
          {
            "text": "od njega strepe carevi zemaljski!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
