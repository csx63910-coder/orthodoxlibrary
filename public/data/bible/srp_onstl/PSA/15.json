  "chapter": {
    "number": 15,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Psalam Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ko to sme, o, Gospode,",
            "poem": 1
          },
          {
            "text": "da prebiva u tvom šatoru,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i da živi na svetoj gori tvojoj?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Onaj koji hoda besprekorno,",
            "poem": 1
          },
          {
            "text": "i čini što pravda zahteva;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ko iz srca govori istinu,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "i svoj jezik čuva od pakosti;",
            "poem": 1
          },
          {
            "text": "ko svom bližnjem ne čini zla,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "niti ocrnjuje svoga bližnjega;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "ko s prezirom gleda na opake,",
            "poem": 1
          },
          {
            "text": "a poštuje one što se boje Gospoda;",
            "poem": 2
          },
          {
            "text": "ko svoju zakletvu ne poriče",
            "poem": 1
          },
          {
            "text": "makar mu to i na zlo izašlo;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "ko ne pozajmljuje novac s kamatom,",
            "poem": 1
          },
          {
            "text": "niti prima mito protiv nevinog.",
            "poem": 2
          },
          {
            "text": "Ko to čini, neće se poljuljati doveka.",
            "poem": 1
          }
        ]
      }
    ],
