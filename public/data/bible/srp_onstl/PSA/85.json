  "chapter": {
    "number": 85,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Potomaka Korejevih. Psalam."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ti si, Gospode, blagonaklon zemlji svojoj;",
            "poem": 1
          },
          {
            "text": "Jakovu si sreću povratio;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "svom narodu krivicu oprostio,",
            "poem": 1
          },
          {
            "text": "sve njihove grehe si pokrio. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Svu si srdžbu svoju utihnuo",
            "poem": 1
          },
          {
            "text": "i zgasnuo jaru svoga gneva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Obnovi nas, Bože našega spasenja",
            "poem": 1
          },
          {
            "text": "i ne budi na nas više gnevan.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Hoćeš li doveka da se gneviš na nas,",
            "poem": 1
          },
          {
            "text": "srdžbu svoju da preneseš",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "s naraštaja na naraštaj?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Nećeš li nam opet doći i oživeti nas,",
            "poem": 1
          },
          {
            "text": "pa da ti se raduje tvoj narod?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Milost svoju pokaži nam, o, Gospode!",
            "poem": 1
          },
          {
            "text": "Svoje nam spasenje ti podari!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Poslušaću šta god da mi Gospod Bog objavi.",
            "poem": 1
          },
          {
            "text": "Jer, on najavljuje mir narodu svome,",
            "poem": 2
          },
          {
            "text": "svojim vernima;",
            "poem": 1
          },
          {
            "text": "alʼ na ludost nek se ne vraćaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Zaista je njegovo spasenje blizu bogobojaznima,",
            "poem": 1
          },
          {
            "text": "kad će slava našu zemlju da nastani.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Sreću se milost i istina,",
            "poem": 1
          },
          {
            "text": "pravda i mir ljube se!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Iz zemlje istina buja,",
            "poem": 1
          },
          {
            "text": "a pravda s nebesa dole gleda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Još će Gospod dobra dati,",
            "poem": 1
          },
          {
            "text": "našoj zemlji daće njenog roda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Pravda pred njim ide",
            "poem": 1
          },
          {
            "text": "i stazu sprema po koracima njegovim.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
