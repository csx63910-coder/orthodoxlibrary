  "chapter": {
    "number": 51,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Davidov Psalam, kada mu je, nakon posete Vitsaveji, došao prorok Natan."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Po milosti svojoj, Bože,",
            "poem": 1
          },
          {
            "text": "smiluj mi se;",
            "poem": 2
          },
          {
            "text": "po golemom milosrđu svome,",
            "poem": 1
          },
          {
            "text": "obriši mi prestupe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Od krivice moje operi me sasvim",
            "poem": 1
          },
          {
            "text": "i od greha moga očisti me.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Prestupa sam svojih svestan,",
            "poem": 1
          },
          {
            "text": "preda mnom je greh moj neprestano.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Tebi, tebi samom zgrešio sam;",
            "poem": 1
          },
          {
            "text": "u očima tvojim zlo sam učinio.",
            "poem": 2
          },
          {
            "text": "Zato si pravedan kada progovoriš,",
            "poem": 1
          },
          {
            "text": "i čist kada sudiš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Gle, u krivici sam se i rodio",
            "poem": 1
          },
          {
            "text": "i u grehu začela me moja majka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Gle, mila ti je istina u srcu;",
            "poem": 1
          },
          {
            "text": "u nutrini učiš me mudrosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Očisti me izopom da čist budem;",
            "poem": 1
          },
          {
            "text": "operi me da od snega belji budem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Veselje i radost mi daj da slušam;",
            "poem": 1
          },
          {
            "text": "nek se obraduju kosti koje si smrskao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Sakrij lice svoje od greha mojih,",
            "poem": 1
          },
          {
            "text": "sve krivice moje ti očisti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Čisto srce stvori meni, Bože;",
            "poem": 1
          },
          {
            "text": "u nutrini mojoj postojan duh obnovi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Od sebe me ne odbacuj",
            "poem": 1
          },
          {
            "text": "i od mene ne uzimaj svoga Duha Svetog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Radost svog spasenja obnovi u meni,",
            "poem": 1
          },
          {
            "text": "i duhom voljnim ti mene obodri.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Tvojim putevima naučiću prestupnike",
            "poem": 1
          },
          {
            "text": "i grešnici tebi će se vratiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Od krvoprolića me oslobodi,",
            "poem": 1
          },
          {
            "text": "Bože, Bože Spasitelju moj;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i klicaće moj jezik o pravednosti tvojoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Gospode, usne mi otvori;",
            "poem": 1
          },
          {
            "text": "i usta će moja slavu tvoju da javljaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Jer ti žrtvu ne želiš, jer ja bih je prineo;",
            "poem": 1
          },
          {
            "text": "ne mili ti se svespalnica.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Bogu je žrtva duh potrešen;",
            "poem": 1
          },
          {
            "text": "potrešeno i skrhano srce ti ne prezri, Bože.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Naklonošću svojom čini dobro Sionu;",
            "poem": 1
          },
          {
            "text": "sazidaj zidine Jerusalimu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Tada ćeš se zaželeti pravednih žrtava,",
            "poem": 1
          },
          {
            "text": "svespalnice i paljenih žrtava;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "tada će ti na žrtveniku prineti bikove.",
            "poem": 2
          }
        ]
      }
    ],
