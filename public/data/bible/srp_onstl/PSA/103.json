  },
  "chapter": {
    "number": 103,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Blagosiljaj, dušo moja, Gospoda",
            "poem": 1
          },
          {
            "text": "i ime mu sveto sve što je u meni!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Blagosiljaj, dušo moja, Gospoda,",
            "poem": 1
          },
          {
            "text": "ne zaboravi sva dobročinstva njegova!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "On ti krivice sve tvoje oprašta",
            "poem": 1
          },
          {
            "text": "i leči ti sve bolesti tvoje;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "od propasti spasava ti život,",
            "poem": 1
          },
          {
            "text": "ovenčava milošću i milosrđem;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "život ti dobrotom hrani,",
            "poem": 1
          },
          {
            "text": "mladost ti je sveža ko u orla.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Gospod čini ono što je pravo,",
            "poem": 1
          },
          {
            "text": "presuđuje u korist tlačenih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Puteve je svoje otkrio Mojsiju,",
            "poem": 1
          },
          {
            "text": "dela svoja deci Izrailja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Milostiv i milosrdan je Gospod,",
            "poem": 1
          },
          {
            "text": "dugotrpljiv, bogat milosrđem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ne tuži nas bez prestanka,",
            "poem": 1
          },
          {
            "text": "doveka se on ne gnevi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Po gresima našim on nam ne uzvraća,",
            "poem": 1
          },
          {
            "text": "ne plaća nam prema krivicama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Jer koliko je nebo nad zemljom visoko,",
            "poem": 1
          },
          {
            "text": "tolika je nad bogobojaznima milost njegova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Koliko je istok od zapada daleko,",
            "poem": 1
          },
          {
            "text": "toliko je prestupe naše od nas udaljio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Kao kad se otac na decu sažali,",
            "poem": 1
          },
          {
            "text": "sažali se Gospod bogobojaznima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Jer on zna kako smo građeni",
            "poem": 1
          },
          {
            "text": "i seća se da smo tek prašina.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Poput trave čovekovi su dani,",
            "poem": 1
          },
          {
            "text": "poput cveta na livadi što cveta;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "vetar zaduva i već je nestao,",
            "poem": 1
          },
          {
            "text": "više ga se i ne seća mesto gde je bio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "A milost je Gospodnja oduvek",
            "poem": 1
          },
          {
            "text": "i zauvek na bogobojaznima",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i pravednost njegova na njihovim potomcima;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "na onima koji drže njegov savez,",
            "poem": 1
          },
          {
            "text": "koji pamte njegove propise i izvršavaju ih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Gospod je na nebesima postavio svoj presto",
            "poem": 1
          },
          {
            "text": "i nad svim carstvom svojim vlada.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Blagosiljajte Gospoda, anđeli njegovi,",
            "poem": 1
          },
          {
            "text": "jaki i snažni,",
            "poem": 2
          },
          {
            "text": "koji činite po njegovoj reči",
            "poem": 1
          },
          {
            "text": "i slušate njegove naredbe!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Blagosiljajte Gospoda, sve vojske njegove,",
            "poem": 1
          },
          {
            "text": "sluge njegove, što činite kako mu je drago!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Blagosiljate Gospoda, sva dela njegova,",
            "poem": 1
          },
          {
            "text": "gde god da je mesto u kome on vlada!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Blagosiljaj, dušo moja, Gospoda!",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
