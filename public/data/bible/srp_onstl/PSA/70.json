  "chapter": {
    "number": 70,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Davidov. Za spomen."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Bože, izbavi me! U pomoć mi požuri, Gospode!",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Neka se postide,",
            "poem": 1
          },
          {
            "text": "neka se osramote ti što mi o glavi rade.",
            "poem": 2
          },
          {
            "text": "Neka se povuku u sramoti,",
            "poem": 1
          },
          {
            "text": "neka budu poniženi ti što im je mila nevolja moja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Nek ustuknu zbog sramote svoje",
            "poem": 1
          },
          {
            "text": "ti što dovikuju: „Aha! Aha!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Nek likuju i nek se raduju u tebi",
            "poem": 1
          },
          {
            "text": "svi koji te traže;",
            "poem": 2
          },
          {
            "text": "neka uvek govore oni što spasenje tvoje vole:",
            "poem": 1
          },
          {
            "text": "„Velik je Bog!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "A ja sam siromah i ubog,",
            "poem": 1
          },
          {
            "text": "Bože, požuri k meni.",
            "poem": 2
          },
          {
            "text": "Ti si moja pomoć i moj izbavitelj.",
            "poem": 1
          },
          {
            "text": "O, Gospode, ne oklevaj!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
