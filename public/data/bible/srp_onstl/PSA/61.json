  "chapter": {
    "number": 61,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi na žičanim instrumentima. Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Bože, čuj moj vapaj;",
            "poem": 1
          },
          {
            "text": "molitvu mi dobro počuj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ja te zovem sa krajeva zemlje",
            "poem": 1
          },
          {
            "text": "dok mi srce klone;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "povedi me na stenu od mene višu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jer ti si mi utočište,",
            "poem": 1
          },
          {
            "text": "moćna kula ispred protivnika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "U šatoru tvome",
            "poem": 1
          },
          {
            "text": "doveka bih da prebivam,",
            "poem": 2
          },
          {
            "text": "utočište da mi bude",
            "poem": 1
          },
          {
            "text": "zaklon tvojih krila. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Jer ti si, Bože, čuo zavete moje;",
            "poem": 1
          },
          {
            "text": "dao si mi nasledstvo onih koji strepe od imena tvoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Caru dane na dane nadodaj,",
            "poem": 1
          },
          {
            "text": "godina njegovih neka bude od naraštaja do naraštaja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Neka ga ima doveka pred Bogom,",
            "poem": 1
          },
          {
            "text": "odredi mu i milost i vernost, neka ga čuvaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Imenu ću tvome zato slavopoj da pevam doveka;",
            "poem": 1
          },
          {
            "text": "da ispunim zavete svoje dan za danom.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
