  "chapter": {
    "number": 45,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Za horovođu, po napevu „Ljiljani“, sinova Korejevih. Pouka. Pesma ljubavi."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Iz srca mi teku reči umilne,",
            "poem": 1
          },
          {
            "text": "caru upravljam svoje stihove;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jezik je moj pisaljka hitroga pisara.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ti si lepši od svih potomaka ljudi,",
            "poem": 1
          },
          {
            "text": "s tvojih usta milost se preliva,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer Bog te je blagoslovio doveka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Uz bok pripaši mač svoj, junače,",
            "poem": 1
          },
          {
            "text": "u sjaju i veličanstvu svome.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Izjaši pobednički u veličanstvu svome,",
            "poem": 1
          },
          {
            "text": "za istinu, krotkost i pravednost;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "nek desnica tvoja strašna dela pokaže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Nek strele tvoje zašiljene",
            "poem": 1
          },
          {
            "text": "probiju srce carevih dušmana,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i narodi nek padaju pod noge tvoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Tvoj je presto, Bože, u veke vekova!",
            "poem": 1
          },
          {
            "text": "Žezlo je pravde žezlo tvoga carstva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Voliš pravdu, a mrziš nepravdu.",
            "poem": 1
          },
          {
            "text": "Zato te je Bog, tvoj Bog,",
            "poem": 2
          },
          {
            "text": "pomazao uljem radosti,",
            "poem": 1
          },
          {
            "text": "više nego tvoje drugove;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Sva ti odeća miriše na smirnu, aloju i kasiju,",
            "poem": 1
          },
          {
            "text": "iz dvorova od slonovače harfom te vesele.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ćerke carske tvoje su dvorkinje,",
            "poem": 1
          },
          {
            "text": "s desna ti carica stoji u ofirskom zlatu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Poslušaj, ćerko, pogledaj, dobro slušaj,",
            "poem": 1
          },
          {
            "text": "zaboravi narod svoj i dom oca svog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Kad car poželi lepotu tvoju,",
            "poem": 1
          },
          {
            "text": "pokloni mu se, jer on je gospodar tvoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ćerka tirska doći će ti s darom,",
            "poem": 1
          },
          {
            "text": "bogati ljudi tražiće tvoju naklonost.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Sva slavna, ćerka careva čeka u sobi,",
            "poem": 1
          },
          {
            "text": "u haljini zlatom izvezenoj,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "da je ukrašenu dovedu pred cara,",
            "poem": 1
          },
          {
            "text": "Device je prate, drugarice njene,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da i njih dovedu pred tebe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Dovode ih radosno, s veseljem,",
            "poem": 1
          },
          {
            "text": "te stupaju u careve dvore.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Tvoji sinovi zauzeće mesto očeva tvojih,",
            "poem": 1
          },
          {
            "text": "postavićeš ih za knezove po svoj zemlji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ime ću ti ovekovečiti kroz sva pokolenja;",
            "poem": 1
          },
          {
            "text": "zato će te narodi slaviti u veke vekova.",
            "poem": 2
          }
        ]
      }
    ],
