  "chapter": {
    "number": 126,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Pesma poklonička."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Kad je Gospod prognanike na Sion vraćao,",
            "poem": 1
          },
          {
            "text": "bilo nam je kao da sanjamo!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Usta su nam praskala od smeha,",
            "poem": 1
          },
          {
            "text": "jezik nam je klicao",
            "poem": 2
          },
          {
            "text": "kada se među narodima pričalo:",
            "poem": 1
          },
          {
            "text": "„Njima je Gospod veliko delo učinio!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Gospod nam je veliko delo učinio",
            "poem": 1
          },
          {
            "text": "i kako smo samo razdragani bili!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "O, Gospode, sreću našu ti povrati",
            "poem": 1
          },
          {
            "text": "ko brzake na ispucalu zemlju!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Oni koji sa suzama seju,",
            "poem": 1
          },
          {
            "text": "žanju sa klicanjem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Plačući ide čovek",
            "poem": 1
          },
          {
            "text": "i zobnicu sa semenom nosi,",
            "poem": 2
          },
          {
            "text": "ali će se vratiti sigurno,",
            "poem": 1
          },
          {
            "text": "i klicaće, svoje snoplje",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "dok bude nosio!",
            "poem": 2
          }
        ]
      }
    ],
