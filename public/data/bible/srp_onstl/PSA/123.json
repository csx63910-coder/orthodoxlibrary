  "chapter": {
    "number": 123,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Pesma poklonička."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Oči svoje ja podižem tebi,",
            "poem": 1
          },
          {
            "text": "koji sediš na nebesima!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Gle, kao što su oči slugu",
            "poem": 1
          },
          {
            "text": "na rukama njihovih gazda;",
            "poem": 2
          },
          {
            "text": "kao što su sluškinjine oči",
            "poem": 1
          },
          {
            "text": "na rukama njene gazdarice;",
            "poem": 2
          },
          {
            "text": "tako su i naše oči",
            "poem": 1
          },
          {
            "text": "na Gospodu Bogu našem,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "dok se na nas ne sažali.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Sažali se, o, Gospode,",
            "poem": 1
          },
          {
            "text": "sažali se na nas,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer prezira smo siti!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Duša naša dovoljno je sita",
            "poem": 1
          },
          {
            "text": "ruganja bahatih",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i prezira osionih ljudi!",
            "poem": 2
          }
        ]
      }
    ],
