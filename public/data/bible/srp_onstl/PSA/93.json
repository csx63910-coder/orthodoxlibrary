  "chapter": {
    "number": 93,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Gospod vlada veličanstvom zaodeven!",
            "poem": 1
          },
          {
            "text": "Zagrnut je i opasan Gospod snagom;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a svet je utvrđen, nepomičan.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Utvrđen je od davnina presto tvoj,",
            "poem": 1
          },
          {
            "text": "a i ti si od iskona.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Reke dižu, o, Gospode,",
            "poem": 1
          },
          {
            "text": "reke dižu svoju huku;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "reke dižu svoju buku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "I od huke voda mnogih,",
            "poem": 1
          },
          {
            "text": "i od silnih talasa morskih,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "silniji je Gospod uzvišeni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Propisi su tvoji čvrsti, pouzdani;",
            "poem": 1
          },
          {
            "text": "Dolikuje svetost tvome Domu, Gospode,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kroz dane mnoge.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
