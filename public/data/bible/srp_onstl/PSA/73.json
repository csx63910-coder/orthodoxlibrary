  "chapter": {
    "number": 73,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Psalam Asafov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Zacelo je Bog dobar Izrailju,",
            "poem": 1
          },
          {
            "text": "i onima čije srce je bez mane.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Što se mene tiče, zamalo mi noge nisu zašle s puta;",
            "poem": 1
          },
          {
            "text": "koraci se moji skoro isklizaše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jer sam zavideo bahatima",
            "poem": 1
          },
          {
            "text": "gledajući blagostanje zlikovaca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Eto, strepnju od smrti nemaju,",
            "poem": 1
          },
          {
            "text": "telo im je zadriglo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ljudske muke ne poznaju,",
            "poem": 1
          },
          {
            "text": "ne stradaju sa ljudima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Nadmenost je zato njima kao ogrlica,",
            "poem": 1
          },
          {
            "text": "ogrće ih odeća nasilja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Od debljine oči svoje izbečiše,",
            "poem": 1
          },
          {
            "text": "zlo im srce za granicu ne zna.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ismevaju se, govore zlobno",
            "poem": 1
          },
          {
            "text": "i nasiljem prete ponosito.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Njihova su usta okrenuta nebesima,",
            "poem": 1
          },
          {
            "text": "a njihov jezik zemljom šeta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Zato im se njihov narod vraća",
            "poem": 1
          },
          {
            "text": "i obilje vode ispijaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "I govore: „Kako bi Bog znao?",
            "poem": 1
          },
          {
            "text": "Postoji li znanje Svevišnjega?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Gle, takvi su zlikovci:",
            "poem": 1
          },
          {
            "text": "spokojni doveka",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i bogatstvo gomilaju!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Zacelo sam uzalud svoje srce čistim očuvao,",
            "poem": 1
          },
          {
            "text": "svoje ruke nevinošću očistio!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Od jutra do sutra ojađen sam bio,",
            "poem": 1
          },
          {
            "text": "jutra su mi donosila kaznu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "A da sam kazao da ću i ja tako da pričam,",
            "poem": 1
          },
          {
            "text": "izneverio bih naraštaj tvoje dece.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Razmišljao sam da razaznam ovo,",
            "poem": 1
          },
          {
            "text": "i očima mojim to je mučno bilo;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "dok nisam ušao u Božije Svetilište,",
            "poem": 1
          },
          {
            "text": "i shvatio njihov svršetak.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Zacelo ih stavljaš na klizavo mesto,",
            "poem": 1
          },
          {
            "text": "obaraš ih u ruine.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Kako su opustošeni, u trenu su okončali",
            "poem": 1
          },
          {
            "text": "i naglom strahotom dokrajčeni!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Oni su poput sna kada se neko probudi.",
            "poem": 1
          },
          {
            "text": "O, Gospode, kada se probudiš, lik njihov prezrećeš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Kada ogorčeno beše srce moje",
            "poem": 1
          },
          {
            "text": "i nutrina moja beše probodena,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "bez pameti i bez znanja sam bio,",
            "poem": 1
          },
          {
            "text": "pred tobom sam bio životinja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Ipak sam ja sa tobom stalno,",
            "poem": 1
          },
          {
            "text": "ti mi držiš desnu ruku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Savetom me svojim vodiš,",
            "poem": 1
          },
          {
            "text": "naposletku ćeš me u slavu uzeti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Koga ja imam na nebesima?",
            "poem": 1
          },
          {
            "text": "Pored tebe na zemlji mi ništa milo nije.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Neka mi okopne i telo i srce,",
            "poem": 1
          },
          {
            "text": "Bog je doveka stena moga srca",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i baština moja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Gle, eno propašće oni od tebe daleki,",
            "poem": 1
          },
          {
            "text": "ti satireš svakog ko ti je neveran.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Što se mene tiče,",
            "poem": 1
          },
          {
            "text": "dobra mi je Božija blizina.",
            "poem": 2
          },
          {
            "text": "U Gospodu Bogu sebi načiniću utočište",
            "poem": 1
          },
          {
            "text": "i sva dela tvoja objaviću.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
