  "chapter": {
    "number": 145,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Davidova pohvalna pesma."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "O, moj Bože, o, care, veličaću tebe,",
            "poem": 1
          },
          {
            "text": "ime tvoje blagosiljaću u veke vekova!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Svakog dana blagosiljaću te,",
            "poem": 1
          },
          {
            "text": "ime ću ti proslavljati u veke vekova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Veliki je Gospod, predostojan slave,",
            "poem": 1
          },
          {
            "text": "veličanstva nedokučivoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Pokolenje pokolenju tvoja dela razglašava,",
            "poem": 1
          },
          {
            "text": "obznanjuje silu tvoju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "O krasoti slave veličanstva tvoga,",
            "poem": 1
          },
          {
            "text": "o stvarima čudnim tvojim ja ću da razmišljam",
            "poem": 2
          },
          {
            "noteId": 13
          },
          {
            "text": ".",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Govoriće ljudi o snazi tvojih strašnih dela,",
            "poem": 1
          },
          {
            "text": "a i ja ću da svedočim o tvom veličanstvu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Kazivaće sećanje o tvojoj velikoj dobroti,",
            "poem": 1
          },
          {
            "text": "klicaće radosno o pravednosti tvojoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Milosrdan i milostiv je Gospod,",
            "poem": 1
          },
          {
            "text": "spor na srdžbu i bogat milošću!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Svakome je Gospod dobar,",
            "poem": 1
          },
          {
            "text": "milosrdan svim svojim delima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "O, Gospode, slaviće te svako delo tvoje;",
            "poem": 1
          },
          {
            "text": "tvoji verni blagosiljaće te!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "O slavi tvoga carstva govoriće,",
            "poem": 1
          },
          {
            "text": "o snazi tvojoj svedočiće;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "dela će mu silna objaviti ljudima,",
            "poem": 1
          },
          {
            "text": "i slavnu krasotu njegovoga carstva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Carstvo svih vremena jeste carstvo tvoje,",
            "poem": 1
          },
          {
            "text": "tvoja vladavina za sve naraštaje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Gospod je oslonac za sve koji padnu,",
            "poem": 1
          },
          {
            "text": "uzdanica za sve ponižene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Tebe očekuju baš svačije oči",
            "poem": 1
          },
          {
            "text": "i ti im daješ hranu kad je tome vreme.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ruku svoju ti otvaraš",
            "poem": 1
          },
          {
            "text": "i sitiš želju svakog živog bića.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Na svim putevima svojim pravedan je Gospod",
            "poem": 1
          },
          {
            "text": "i veran je u svakom poduhvatu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Gospod je blizak svima što ga prizivaju,",
            "poem": 1
          },
          {
            "text": "svima što ga u istini zovu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ispunjava čežnju bogobojaznima,",
            "poem": 1
          },
          {
            "text": "spasava ih kada čuje kako vape.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Gospod brani sve koji ga vole,",
            "poem": 1
          },
          {
            "text": "a zlotvore sve će da razori.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Gospodu će usta moja uskliknuti slavopoje!",
            "poem": 1
          },
          {
            "text": "Nek sve živo blagosilja to sveto mu ime,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "u veke vekova!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 13,
        "caller": "+",
        "text": "145,5 Ovaj glagol, ova misao se može prevesti i ovako: ja ću da govorim.",
        "reference": {
          "chapter": 145,
          "verse": 5
        }
      }
    ]
