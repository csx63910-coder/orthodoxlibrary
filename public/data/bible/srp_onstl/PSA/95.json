  "chapter": {
    "number": 95,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Dođite! Kličimo Gospodu!",
            "poem": 1
          },
          {
            "text": "Uskliknimo Steni našega spasenja!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Dođimo pred njega s pohvalama,",
            "poem": 1
          },
          {
            "text": "u pesmama kličimo mu!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jer Gospod je velik Bog,",
            "poem": 1
          },
          {
            "text": "car je velik nad svim bogovima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "U njegovoj su ruci dubine zemaljske,",
            "poem": 1
          },
          {
            "text": "njegovi su vrhovi planina.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Njegovo je more, on ga je stvorio;",
            "poem": 1
          },
          {
            "text": "ruke su mu kopno načinile.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Dođite da ničice popadamo!",
            "poem": 1
          },
          {
            "text": "Hajde da se poklonimo i kleknemo",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pred Gospodom, Sazdateljem našim!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Jer on je naš Bog,",
            "poem": 1
          },
          {
            "text": "a mi narod njegove ispaše,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "stado koje vodi.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Danas kad glas njegov čujete:",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "„Tvrda srca ne budite kao na Merivi,",
            "poem": 1
          },
          {
            "text": "u pustinji u dan Mase",
            "poem": 2
          },
          {
            "noteId": 8
          },
          {
            "text": ".",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Oci vaši mene su kušali,",
            "poem": 1
          },
          {
            "text": "izazivali me, iako su dela moja gledali.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Četrdeset leta sam se gnušao onog naraštaja i rekoh:",
            "poem": 1
          },
          {
            "text": "’Vernosti nema u njima nikakve,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "puteve moje oni ne poznaju.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "U gnevu sam se tada zakleo:",
            "poem": 1
          },
          {
            "text": "’Neće oni ući u moj počinak.’“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 8,
        "caller": "+",
        "text": "95,8 Prema 2. Moj 17,7Masa i Meriva su mesta čija imena, svađa i iskušavanje imaju slikovito značenje.",
        "reference": {
          "chapter": 95,
          "verse": 8
        }
      }
    ]
