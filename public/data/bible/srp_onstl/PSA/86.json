  "chapter": {
    "number": 86,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Davidova molitva."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Svoje uho prigni, o, Gospode!",
            "poem": 1
          },
          {
            "text": "Usliši me, jer siromah",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i nevoljnik ja sam.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Dušu moju ti sačuvaj, jer sam veran;",
            "poem": 1
          },
          {
            "text": "svoga slugu spasi,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer ti si moj Bog u koga se uzdam.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Smiluj mi se, o, Gospode,",
            "poem": 1
          },
          {
            "text": "jer ti vapim od jutra do sutra!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Razgali dušu sluge svoga,",
            "poem": 1
          },
          {
            "text": "jer ja tebi, o, Gospode, dušu svoju dižem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ti si dobar, Gospode;",
            "poem": 1
          },
          {
            "text": "voljan si da praštaš,",
            "poem": 2
          },
          {
            "text": "milošću si bogat",
            "poem": 1
          },
          {
            "text": "za sve što te prizivaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "O, Gospode, čuj molitvu moju!",
            "poem": 1
          },
          {
            "text": "Pokloni pažnju glasu moga preklinjanja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ja ću tebe zvati u danu moje nevolje",
            "poem": 1
          },
          {
            "text": "jer ti ćeš se odazvati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Nema, Gospode, nikog poput tebe među bogovima,",
            "poem": 1
          },
          {
            "text": "ne postoje dela kao što su tvoja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Svi narodi koje si stvorio će doći,",
            "poem": 1
          },
          {
            "text": "pred tobom se pokloniti, Gospode,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ime tvoje proslaviti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Jer ti si velik,",
            "poem": 1
          },
          {
            "text": "čudesa ti tvoriš,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ti si Bog jedini.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Nauči me svome putu, Gospode,",
            "poem": 1
          },
          {
            "text": "da postupam po istini tvojoj,",
            "poem": 2
          },
          {
            "text": "da se srcem celim",
            "poem": 1
          },
          {
            "text": "tvog imena bojim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "I ja ću da te hvalim, Gospode, moj Bože,",
            "poem": 1
          },
          {
            "text": "srcem svojim celim!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Doveka ću da veličam ime tvoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Jer velika je milost tvoja prema meni,",
            "poem": 1
          },
          {
            "text": "jer si dušu moju izbavio",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "iz najdubljeg Sveta mrtvih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Bože, protiv mene ustaju oholi;",
            "poem": 1
          },
          {
            "text": "moju dušu traže bezdušnici;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "oni tebe nemaju pred sobom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "A ti si, Gospode, Bog milostiv i milosrdan,",
            "poem": 1
          },
          {
            "text": "spor na srdžbu, bogat milošću i istinom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Na mene se osvrni,",
            "poem": 1
          },
          {
            "text": "milostiv mi budi;",
            "poem": 2
          },
          {
            "text": "svoju snagu podaj sluzi svome,",
            "poem": 1
          },
          {
            "text": "spasi sina sluškinje svoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Na meni pokaži znak dobrote,",
            "poem": 1
          },
          {
            "text": "pa nek vide oni što me mrze;",
            "poem": 2
          },
          {
            "text": "neka se zastide tebe, o, Gospode,",
            "poem": 1
          },
          {
            "text": "jer si mi pomogao i utešio me.",
            "poem": 2
          }
        ]
      }
    ],
