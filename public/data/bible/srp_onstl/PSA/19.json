  },
  "chapter": {
    "number": 19,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Psalam Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Nebesa pričaju o slavi Božijoj,",
            "poem": 1
          },
          {
            "text": "nebo objavljuje delo ruku njegovih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Jedan dan drugom danu javlja,",
            "poem": 1
          },
          {
            "text": "a noć noći prenosi saznanje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Nema govora, nema ni jezika,",
            "poem": 1
          },
          {
            "text": "gde se glas njihov nije začuo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Glas je celom odjeknuo zemljom,",
            "poem": 1
          },
          {
            "text": "reči su im do nakraj sveta stigle.",
            "poem": 2
          },
          {
            "text": "Suncu je na nebu šator razapeo,",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "pa ono kao ženik iz sobe izlazi,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "veselo kao junak što trči po putu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Izlazak mu je na jednom kraju neba,",
            "poem": 1
          },
          {
            "text": "a hod mu je do njegovog kraja;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "nema skrivanja od njegove jare.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Zakon je Gospodnji besprekoran – obnavlja dušu,",
            "poem": 1
          },
          {
            "text": "pouzdano je svedočanstvo Gospodnje – umudruje lakovernog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Pravedne su odluke Gospodnje – vesele srce;",
            "poem": 1
          },
          {
            "text": "bez mane su sudovi Gospodnji – prosvetljuju oči.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Čist je strah Gospodnji – traje doveka;",
            "poem": 1
          },
          {
            "text": "istiniti su sudovi Gospodnji – pravedni su svi zajedno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Poželjniji od zlata, zlata žeženog,",
            "poem": 1
          },
          {
            "text": "slađi su od meda što teče iz saća.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Njima se tvoj sluga opominje,",
            "poem": 1
          },
          {
            "text": "ko njih čuva veliku nagradu prima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ko će razaznati svoje pogreške?",
            "poem": 1
          },
          {
            "text": "Očisti me i od onih skrivenih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "I od voljnih greha čuvaj slugu svoga;",
            "poem": 1
          },
          {
            "text": "ne dozvoli da ovladaju mnome.",
            "poem": 2
          },
          {
            "text": "Tada ću ja biti bez krivice,",
            "poem": 1
          },
          {
            "text": "i nedužan za veliki prestup.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Neka reči mojih usta i misli moga srca,",
            "poem": 1
          },
          {
            "text": "tebi budu ugodne, Gospode, steno moja, otkupitelju moj.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
