  },
  "chapter": {
    "number": 94,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "O, Bože osvete!",
            "poem": 1
          },
          {
            "text": "Sevni, Gospode, Bože osvetniče!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ustani, sudijo zemlje,",
            "poem": 1
          },
          {
            "text": "pa uzvrati bahatima istom merom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Dokle će zlikovci, o, Gospode,",
            "poem": 1
          },
          {
            "text": "dokle će zlikovci da likuju?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Brbljivci su, bahati hvalisavci",
            "poem": 1
          },
          {
            "text": "svi ti što opako rade.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Oni satiru tvoj narod, Gospode,",
            "poem": 1
          },
          {
            "text": "i nasledstvo tvoje tlače.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ubijaju udovicu, došljaka",
            "poem": 1
          },
          {
            "text": "i siročad kolju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "I još kažu: „Gospod ne vidi,",
            "poem": 1
          },
          {
            "text": "ne opaža Bog Jakovljev!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Razmislite, vi svirepi ljudi! Budale!",
            "poem": 1
          },
          {
            "text": "Kad ćete se opametiti?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ne čuje li onaj što je tvorac uha?",
            "poem": 1
          },
          {
            "text": "Ne vidi li onaj što je tvorac oka?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Zar narode on da ne kori?",
            "poem": 1
          },
          {
            "text": "Zar da ne pokara onaj koji ljude znanju uči?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Gospod zna da su misli čovekove bezvredne.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Blago onome koga ti učiš, Gospode,",
            "poem": 1
          },
          {
            "text": "koga poučavaš o Zakonu svome;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "da bude spokojan u danima patnje,",
            "poem": 1
          },
          {
            "text": "dok se za zlikovca jama ne iskopa.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Jer Gospod ne ostavlja svoj narod",
            "poem": 1
          },
          {
            "text": "i nasledstva svoga on se ne odriče.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Jer pravednost se sudu vraća",
            "poem": 1
          },
          {
            "text": "i slede je sva srca čestita.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ko će mene da zastupa protiv zlikovaca?",
            "poem": 1
          },
          {
            "text": "Ko će protiv zločinaca uz mene da stane?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Da mi Gospod nije bio pomoć,",
            "poem": 1
          },
          {
            "text": "ubrzo bi duša moja u grobu ćutala.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Kada kažem – „Moja noga kleca!“ –",
            "poem": 1
          },
          {
            "text": "nek me tvoja milost okrepi, Gospode!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Kada su u meni samom mnogobrojne brige,",
            "poem": 1
          },
          {
            "text": "utehe mi tvoje razgaljuju dušu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Zar okrutni vladari da ti budu saveznici,",
            "poem": 1
          },
          {
            "text": "i oni koji krše zapovesti?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Urotu prave protiv duše pravednika,",
            "poem": 1
          },
          {
            "text": "krv nevinih osude ko krivu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Gospod mi je zaklon na visini!",
            "poem": 1
          },
          {
            "text": "Moj je Bog stena utočišta!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "On će njima da uzvrati za zlobu njihovu,",
            "poem": 1
          },
          {
            "text": "zbrisaće ih zbog zala njihovih;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "zbrisaće ih, Gospod, Bog naš.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
