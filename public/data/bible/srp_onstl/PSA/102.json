  "chapter": {
    "number": 102,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Molitva ojađenog čoveka pred Gospodom, kad izliva svoju muku."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "O, Gospode, čuj molitvu moju",
            "poem": 1
          },
          {
            "text": "i moj vapaj nek do tebe dođe!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Svoje lice ne skrivaj od mene u danu nevolje,",
            "poem": 1
          },
          {
            "text": "uho svoje prigni meni;",
            "poem": 2
          },
          {
            "text": "ti požuri,",
            "poem": 1
          },
          {
            "text": "usliši me u dan kad te zovem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Moji dani nestaju u dimu,",
            "poem": 1
          },
          {
            "text": "poput peći kosti mi spečene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Srce je moje kao trava košena, uvela,",
            "poem": 1
          },
          {
            "text": "pa ni hleb se ne setim da jedem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Od jecanja moga silnog",
            "poem": 1
          },
          {
            "text": "koža mi se slepila za kosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Na pustinjsku buljinu ličim",
            "poem": 1
          },
          {
            "text": "i na ćuka s ruševina pustih!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Budan ležim,",
            "poem": 1
          },
          {
            "text": "postao sam ptica što samuje na krovu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Povazdan mi se rugaju dušmani,",
            "poem": 1
          },
          {
            "text": "imenom mojim proklinju oni što me ruže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Pepeo jedem kao da je hleb;",
            "poem": 1
          },
          {
            "text": "to što pijem sa suzama mešam,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "zbog tvog gneva i ljutine tvoje;",
            "poem": 1
          },
          {
            "text": "jer si me podigao, pa onda bacio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Kao senka blede dani moji,",
            "poem": 1
          },
          {
            "text": "ja sam kao trava sparušena.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "A ti si, Gospode, doveka! Ti traješ,",
            "poem": 1
          },
          {
            "text": "spominješ se kroz naraštaj svaki.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ti ustaješ da Sionu se smiluješ,",
            "poem": 1
          },
          {
            "text": "jer je vreme da ga pomiluješ,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer je došlo vreme određeno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Jer sluge tvoje vole mu zidine,",
            "poem": 1
          },
          {
            "text": "žao im je njegovih ruina.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Drhtaće narodi od imena Gospodnjeg",
            "poem": 1
          },
          {
            "text": "i od tvoje slave svi carevi zemaljski;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "jer će Gospod da izgradi Sion",
            "poem": 1
          },
          {
            "text": "i objavi se u njegovoj slavi;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "kada čuje molitvu jadnika",
            "poem": 1
          },
          {
            "text": "njihove vapaje prezreti neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Nek se to zapiše za naraštaj novi,",
            "poem": 1
          },
          {
            "text": "za narod sazdan da Gospoda slavi!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Jer će s visine svetosti svoje gledati Gospod,",
            "poem": 1
          },
          {
            "text": "s nebesa će zemlju da pogleda;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "čuće ropac zatočenih",
            "poem": 1
          },
          {
            "text": "i od smrti spasti osuđenike;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "da objavi sa Siona ime Gospodnje",
            "poem": 1
          },
          {
            "text": "i hvalu svoju u Jerusalimu;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "kada se zajedno okupe narodi,",
            "poem": 1
          },
          {
            "text": "i carstva da Gospodu služe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Sred života snagu mi je oduzeo",
            "poem": 1
          },
          {
            "text": "i dane mi prekratio!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Rekao sam:",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Ne uzmi me usred mojih dana",
            "poem": 1
          },
          {
            "text": "kad već živiš od roda do roda!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Ti si u početku utemeljio zemlju,",
            "poem": 1
          },
          {
            "text": "i nebesa su delo tvojih ruku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Ona će propasti, ali ti ćeš ostati,",
            "poem": 1
          },
          {
            "text": "i sve će se ishabati kao iznošena odeća,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "izmenićeš ih kao odeću i proći će.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "A ti si uvek isti,",
            "poem": 1
          },
          {
            "text": "veku tvome nigde kraja nema.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Sinovi tvojih slugu živeće",
            "poem": 1
          },
          {
            "text": "i potomci njihovi pred tobom spokojni će biti.“",
            "poem": 2
          }
        ]
      }
    ],
