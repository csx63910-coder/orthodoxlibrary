  "chapter": {
    "number": 143,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Psalam Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "O, Gospode, čuj molitvu moju",
            "poem": 1
          },
          {
            "text": "i poslušaj preklinjanja moja!",
            "poem": 2
          },
          {
            "text": "Usliši me po vernosti,",
            "poem": 1
          },
          {
            "text": "po pravednosti svojoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Sa slugom svojim nemoj na sud ići,",
            "poem": 1
          },
          {
            "text": "jer pred tobom nema živog,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a da je pravedan.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jer dušmanin dušu moju goni,",
            "poem": 1
          },
          {
            "text": "živog me o zemlju lomi;",
            "poem": 2
          },
          {
            "text": "tera me da živim po mračnim mestima,",
            "poem": 1
          },
          {
            "text": "kao one što su odavno pokojni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Klonuo je duh moj u meni,",
            "poem": 1
          },
          {
            "text": "srce mi je ucveljeno u grudima!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Prohujalih dana prisećam se,",
            "poem": 1
          },
          {
            "text": "unosim se u sva tvoja dela",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i razmatram delo tvojih ruku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ruke svoje k tebi širim,",
            "poem": 1
          },
          {
            "text": "duša moja te je žedna",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kao zemlja suva. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Požuri se, usliši me!",
            "poem": 1
          },
          {
            "text": "O, Gospode, duh moj kopni!",
            "poem": 2
          },
          {
            "text": "Lice svoje od mene ne skrivaj,",
            "poem": 1
          },
          {
            "text": "da ne budem poput onih što idu u raku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Kad je jutro objavi mi svoju milost,",
            "poem": 1
          },
          {
            "text": "jer u tebe uzdajem se;",
            "poem": 2
          },
          {
            "text": "objavi mi put kojim ću poći",
            "poem": 1
          },
          {
            "text": "jer je moja duša tebe željna.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "O, Gospode, izbavi me od dušmana mojih!",
            "poem": 1
          },
          {
            "text": "K tebi bežim da se skrijem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Pouči me da po tvojoj volji činim,",
            "poem": 1
          },
          {
            "text": "jer Bog moj ti si;",
            "poem": 2
          },
          {
            "text": "ti si dobrog duha,",
            "poem": 1
          },
          {
            "text": "povedi me gde je zemlja ravna.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "O, Gospode, zbog imena svoga",
            "poem": 1
          },
          {
            "text": "sačuvaj me živog!",
            "poem": 2
          },
          {
            "text": "Pravednošću svojom dušu moju",
            "poem": 1
          },
          {
            "text": "od nevolje spasi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Po milosti svojoj",
            "poem": 1
          },
          {
            "text": "zatri protivnike moje;",
            "poem": 2
          },
          {
            "text": "iskoreni sve dušmane duše moje,",
            "poem": 1
          },
          {
            "text": "jer ja sam tvoj sluga!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
