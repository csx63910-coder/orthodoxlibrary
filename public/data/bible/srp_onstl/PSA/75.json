  "chapter": {
    "number": 75,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Napev: „Ne pogubi“. Psalam Asafov. Pesma."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Hvalimo te, Bože,",
            "poem": 1
          },
          {
            "text": "hvalimo te, jer nam je ime tvoje blisko;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "čudesa tvoja spominje narod.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Ja određujem zakazano vreme,",
            "poem": 1
          },
          {
            "text": "ja podjednako sudim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Rastapa se zemlja i sav njezin živalj,",
            "poem": 1
          },
          {
            "text": "a ja stubove njene postavljam. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Bahatima kažem:",
            "poem": 1
          },
          {
            "text": "’Nemojte se bahatiti’;",
            "poem": 2
          },
          {
            "text": "i zlikovcima:",
            "poem": 1
          },
          {
            "text": "’Rog svoj ne dižite.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Rog svoj u visine ne dižite,",
            "poem": 1
          },
          {
            "text": "drsko ne pričajte.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Jer uzdizanje ne dolazi ni sa zapada,",
            "poem": 1
          },
          {
            "text": "ni sa istoka, ni iz pustinje;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "već je Bog sudija:",
            "poem": 1
          },
          {
            "text": "jednog ruši, jednog diže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Eno, čaša je u Gospodnjoj ruci",
            "poem": 1
          },
          {
            "text": "i vino puno začina se peni.",
            "poem": 2
          },
          {
            "text": "I izliće iz nje, i zaista će piti,",
            "poem": 1
          },
          {
            "text": "do taloga iskapiće je svi zemaljski zlikovci.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "O tome ću doveka da javljam,",
            "poem": 1
          },
          {
            "text": "pevaću pohvale Bogu Jakovljevom!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "„Sve rogove zlikovačke ja ću da izlomim,",
            "poem": 1
          },
          {
            "text": "a rogovi pravednika uzdignuti biće.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
