  "chapter": {
    "number": 65,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Psalam Davidov. Pesma."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Bože, na Sionu te hvala očekuje,",
            "poem": 1
          },
          {
            "text": "tebi dani zavet ispunjen će biti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Tebi, što čuješ molitvu,",
            "poem": 1
          },
          {
            "text": "svaki čovek stiže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Krivice me nadvladaše,",
            "poem": 1
          },
          {
            "text": "ti oprosti prestupe nam naše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Kako je blažen izabranik, onaj kog privučeš,",
            "poem": 1
          },
          {
            "text": "što prebiva u tvojim dvorištima.",
            "poem": 2
          },
          {
            "text": "Siti bili od dobara Doma tvoga,",
            "poem": 1
          },
          {
            "text": "od tvog svetog hrama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Čudesnim i pravednim delima si nas uslišio,",
            "poem": 1
          },
          {
            "text": "Bože spasenja našeg,",
            "poem": 2
          },
          {
            "text": "pouzdanje svih krajeva zemlje",
            "poem": 1
          },
          {
            "text": "i mora dalekih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ti si snagom svojom osnovao gore,",
            "poem": 1
          },
          {
            "text": "silom si se opasao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ti stišavaš huk mora,",
            "poem": 1
          },
          {
            "text": "huk talasa njihovih",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i vrevu naroda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Preplašiše se od čudesa tvojih stanovnici svih krajeva;",
            "poem": 1
          },
          {
            "text": "i jutro i veče od radosti kliču.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Zemljom prolaziš i natapaš je;",
            "poem": 1
          },
          {
            "text": "izobilno ti je gizdaš potocima Božijim punim vode;",
            "poem": 2
          },
          {
            "text": "za žito se njeno brineš.",
            "poem": 1
          },
          {
            "text": "Eto, to si tako uredio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Brazde joj natapaš,",
            "poem": 1
          },
          {
            "text": "oranje joj poravnavaš;",
            "poem": 2
          },
          {
            "text": "pljuskovima omekšavaš",
            "poem": 1
          },
          {
            "text": "i njen urod blagosiljaš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Godinu si okrunio urodom svojim,",
            "poem": 1
          },
          {
            "text": "staze tvoje kipe izobiljem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Bujaju pašnjaci pustinjski,",
            "poem": 1
          },
          {
            "text": "veseljem se brda opasuju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Stadima se oblače pašnjaci,",
            "poem": 1
          },
          {
            "text": "doline se ogrću pšenicom,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pa pevaju, pa još usklikuju.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
