  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Zašto li se bune narodi,",
            "poem": 1
          },
          {
            "text": "šta to ljudi uzalud smišljaju?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Carevi se sveta prikupljaju,",
            "poem": 1
          },
          {
            "text": "knezovi se s njima savetuju,",
            "poem": 2
          },
          {
            "text": "da navale složno na Gospoda",
            "poem": 1
          },
          {
            "text": "i na njegovog Pomazanika",
            "poem": 2
          },
          {
            "noteId": 0
          },
          {
            "text": ":",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "„Zbacimo sa sebe okove njihove,",
            "poem": 1
          },
          {
            "text": "strgnimo sa sebe sveze njihove!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Smeje se onaj što na nebesima stoluje,",
            "poem": 1
          },
          {
            "text": "Gospod se to njima podruguje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "On im onda u gnevu progovara,",
            "poem": 1
          },
          {
            "text": "jarošću ih svojom užasava:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "„Cara svoga ja sam postavio,",
            "poem": 1
          },
          {
            "text": "na Sionu, svetoj gori svojoj.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Objaviću odluku Gospodnju.",
            "poem": 1
          },
          {
            "text": "On mi reče:",
            "poem": 2
          },
          {
            "text": "„Ti si Sin moj,",
            "poem": 1
          },
          {
            "text": "danas si se meni rodio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Traži od mene, i daću ti u nasledstvo puke,",
            "poem": 1
          },
          {
            "text": "i krajeve zemaljske da ti budu imovina.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Slomićeš ih gvozdenom palicom,",
            "poem": 1
          },
          {
            "text": "razbićeš ih kao posudu od gline.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Zato, carevi, budite razumni,",
            "poem": 1
          },
          {
            "text": "primite nauk, vladari zemaljski!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Služite Gospodu u strahu,",
            "poem": 1
          },
          {
            "text": "s trepetom se radujte.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Volite Sina, da mu gnev ne plane,",
            "poem": 1
          },
          {
            "text": "pa da propadnete na svom putu,",
            "poem": 2
          },
          {
            "text": "jer gnev njegov za tren oka plane.",
            "poem": 1
          },
          {
            "text": "Blago svakom ko u njemu utočište traži!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 0,
        "caller": "+",
        "text": "2,2 Prevod grčke imenice Hristos, prema Dal 4,26, gde je ovaj deo Psalma naveden.",
        "reference": {
          "chapter": 2,
          "verse": 2
        }
      }
    ]
