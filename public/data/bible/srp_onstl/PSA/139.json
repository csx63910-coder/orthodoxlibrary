  "chapter": {
    "number": 139,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Davidov Psalam."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "O, Gospode, ti me proničeš",
            "poem": 1
          },
          {
            "text": "i tebi sam poznat!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Znaš me i kad sedim i kad stojim,",
            "poem": 1
          },
          {
            "text": "poznaješ mi misli izdaleka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Posmatraš me dok hodam, dok ležim,",
            "poem": 1
          },
          {
            "text": "i svestan si svih mojih puteva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Elem, još mi reči na jeziku nema,",
            "poem": 1
          },
          {
            "text": "a ti, eto, o, Gospode, poznaješ baš svaku!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Obuhvataš me i spreda i straga,",
            "poem": 1
          },
          {
            "text": "ruku svoju na mene polažeš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Čudesno mi je to saznanje, uzvišeno,",
            "poem": 1
          },
          {
            "text": "nemoćan sam da ga shvatim!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Od tvog Duha gde da odem?",
            "poem": 1
          },
          {
            "text": "Od tvog lica kuda da pobegnem?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Dignem li se do nebesa – ti si tamo;",
            "poem": 1
          },
          {
            "text": "spustim li se u Svet mrtvih – i tamo si!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Vinem li se zorinim krilima",
            "poem": 1
          },
          {
            "text": "i preselim na kraj mora;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "i tamo me ruka tvoja vodi,",
            "poem": 1
          },
          {
            "text": "pridržava me desnica tvoja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Sve i da kažem –",
            "poem": 1
          },
          {
            "text": "„Tama će me svakako prekriti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "svetlo oko mene ko noć će postati“ –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "od tebe me ni tama ne skriva",
            "poem": 1
          },
          {
            "text": "i noć poput dana sija,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer i tama ti je kao svetlo!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Da, ti si mi nutrinu stvorio,",
            "poem": 1
          },
          {
            "text": "satkao me u utrobi majke moje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Hvaliću te što sam takav sazdan,",
            "poem": 1
          },
          {
            "text": "zapanjujuće divan,",
            "poem": 2
          },
          {
            "text": "što su ti dela čudesna;",
            "poem": 1
          },
          {
            "text": "a duša je moja toga dobro svesna.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Moje kosti tebi nisu sakrivene bile,",
            "poem": 1
          },
          {
            "text": "dok sam bio stvaran na tajnome mestu;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "dok sam bio oblikovan u dubini zemlje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Oči su me tvoje ko zametak gledale;",
            "poem": 1
          },
          {
            "text": "u tvojoj su knjizi zapisani dani moji određeni,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a da još ni jedan od njih postojao nije!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "I kako su mi dragocene tvoje misli, Bože!",
            "poem": 1
          },
          {
            "text": "Kako ih je mnogo kad se zbroje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Da ih brojim,",
            "poem": 1
          },
          {
            "text": "više ih je nego peska;",
            "poem": 2
          },
          {
            "text": "a kada se probudim,",
            "poem": 1
          },
          {
            "text": "još uvek sam sa tobom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "O, Bože, kad bi hteo zlikovca da smakneš!",
            "poem": 1
          },
          {
            "text": "Odlazite od mene, krvnici!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Oni protiv tebe spletkare,",
            "poem": 1
          },
          {
            "text": "laži o tebi šire tvoji protivnici.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "O, Gospode, zar da ne mrzim te što tebe mrze?",
            "poem": 1
          },
          {
            "text": "Bogoboraca se gnušam!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Mržnjom krajnjom ja ih mrzim!",
            "poem": 1
          },
          {
            "text": "Dušmani su oni moji!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Pronikni me, o, Bože! Srce mi upoznaj,",
            "poem": 1
          },
          {
            "text": "okušaj me, zabrinute misli moje saznaj!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Vidi da li idem putem zastranjenja",
            "poem": 1
          },
          {
            "text": "i vodi me putem iz davnina.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
