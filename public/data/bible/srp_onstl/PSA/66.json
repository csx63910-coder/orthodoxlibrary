  },
  "chapter": {
    "number": 66,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Psalam. Pesma."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Kliči Bogu, zemljo sva!",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Pevajte slavi njegovog imena;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "slavu mu i hvalu dajte.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Recite Bogu: „Kako su strašna dela tvoja!",
            "poem": 1
          },
          {
            "text": "Zbog velike sile tvoje",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pred tobom puze tvoji protivnici.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Sva ti se zemlja klanja;",
            "poem": 1
          },
          {
            "text": "slavopoj pevaju tebi,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "slavopoj pevaju imenu tvome.“ Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Dođite i vidite dela Božija,",
            "poem": 1
          },
          {
            "text": "strašna dela prema potomcima ljudi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "On od mora čini suvu zemlju,",
            "poem": 1
          },
          {
            "text": "pa su vode pregazili nogom;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "hajde da se tamo radujemo njemu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Snagom svojom on doveka vlada;",
            "poem": 1
          },
          {
            "text": "njegove oči na narode motre,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pa dušmani nek se ne uzdižu. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Blagosiljaj našeg Boga, narode,",
            "poem": 1
          },
          {
            "text": "nek se čuje glas hvale o njemu;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "o njemu koji nam život u dušu stavi",
            "poem": 1
          },
          {
            "text": "i ne dade nogama našim da posrnu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Oprobao si nas, Bože,",
            "poem": 1
          },
          {
            "text": "pretopio nas kao srebro što se topi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "U mrežu si nas doveo,",
            "poem": 1
          },
          {
            "text": "teret si nam na bedra stavio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Pustio si da nam čovek vrat zajaše,",
            "poem": 1
          },
          {
            "text": "prošli smo i kroz vatru i kroz vodu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ali si nas doveo do izobilja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ući ću sa svespalnicama u Dom tvoj;",
            "poem": 1
          },
          {
            "text": "ispuniću što sam ti se zavetovao,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "što su usne moje izustile,",
            "poem": 1
          },
          {
            "text": "i što su mi usta u nevolji mojoj rekla.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Prineću ti tovnu stoku",
            "poem": 1
          },
          {
            "text": "na svespalnicu sa kadom ovnova;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "prineću ti i junce i jarce. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Dođite i slušajte,",
            "poem": 1
          },
          {
            "text": "vi koji se Boga bojite,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "reći ću vam šta je duši mojoj učinio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Njemu sam vapio ustima svojim,",
            "poem": 1
          },
          {
            "text": "moj ga je jezik uzdizao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Da sam zlobu u svom srcu pazio,",
            "poem": 1
          },
          {
            "text": "ne bi me Gospod uslišio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Zaista je Gospod čuo,",
            "poem": 1
          },
          {
            "text": "na zov molitve moje se osvrnuo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Blagosloven da je Bog",
            "poem": 1
          },
          {
            "text": "što molitvu moju nije uklonio,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a ni milost svoju od mene.",
            "poem": 2
          }
        ]
      }
    ],
