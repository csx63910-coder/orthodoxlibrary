  },
  "chapter": {
    "number": 77,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Za Jedutuna od Asafa. Psalam."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Glas svoj Bogu dižem,",
            "poem": 1
          },
          {
            "text": "glasom svojim vapim Bogu i on me usliši!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "U danu nevolje svoje Gospoda sam tražio,",
            "poem": 1
          },
          {
            "text": "ruke neumorno noću sam pružao.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ali duša moja neće utehu!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Spominjem Boga i jecam,",
            "poem": 1
          },
          {
            "text": "jadam se, a duh mi malakše. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Kapke očne ne daš mi da sklopim!",
            "poem": 1
          },
          {
            "text": "Nemiran sam, da pričam ne mogu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Mislim na minule dane",
            "poem": 1
          },
          {
            "text": "i godine davne.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Noću se sećam svoje pesme",
            "poem": 1
          },
          {
            "text": "pa srcem svojim razmišljam",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i duhom svojim ispitujem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Odbacuje li Gospod doveka?",
            "poem": 1
          },
          {
            "text": "Zar se neće opet prikloniti?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Je li mu ljubav doveka iščezla?",
            "poem": 1
          },
          {
            "text": "Je li propalo obećanje dano naraštaju svakom?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Zar je Bog zaboravio da se smiluje",
            "poem": 1
          },
          {
            "text": "ili je milosrđe svoje u svom gnevu ugušio? Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Rekao sam: „Ovo je moja rana –",
            "poem": 1
          },
          {
            "text": "desnica Svevišnjeg više nije ista!“",
            "poem": 2
          },
          {
            "noteId": 6
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Spominjem dela Gospodnja,",
            "poem": 1
          },
          {
            "text": "čuda tvoja od starina pamtim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Na sva dela tvoja mislim,",
            "poem": 1
          },
          {
            "text": "razmatram to što si učinio!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "O, Bože, u Svetinji je put tvoj!",
            "poem": 1
          },
          {
            "text": "Koji je bog velik poput Boga našeg?!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ti si Bog što čudesa činiš,",
            "poem": 1
          },
          {
            "text": "silu svoju obznanjuješ među narodima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Svoj si narod otkupio snagom svojom,",
            "poem": 1
          },
          {
            "text": "sinove Jakova i Josifa. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Kad te vode ugledaše, Bože,",
            "poem": 1
          },
          {
            "text": "kad te vode ugledaše,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "skupiše se, a dubine uzburkaše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Oblaci se provališe kišom,",
            "poem": 1
          },
          {
            "text": "iz oblaka grmljavina dođe",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i sevnuše tvoje munje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Prolom tvoga groma beše u vihoru,",
            "poem": 1
          },
          {
            "text": "munje svetom zasvetliše,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a zemlja se drmala i tresla.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Po moru je staza tvoja prošla,",
            "poem": 1
          },
          {
            "text": "prošao si nemirnim vodama,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a stopama tvojim traga nema.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Vodio si svoj narod ko stado,",
            "poem": 1
          },
          {
            "text": "Mojsijevom i Aronovom rukom.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 6,
        "caller": "+",
        "text": "77,10 Ovaj stih može i ovako da se prevede: I za ovim žalim: za godinama kada je desnica Gospodnja bila ispružena.",
        "reference": {
          "chapter": 77,
          "verse": 10
        }
      }
    ]
  },
