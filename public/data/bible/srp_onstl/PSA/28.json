  "chapter": {
    "number": 28,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "K tebi, Gospode, vapim, steno moja,",
            "poem": 1
          },
          {
            "text": "ne budi gluv prema meni,",
            "poem": 2
          },
          {
            "text": "da neuslišen ne budem",
            "poem": 1
          },
          {
            "text": "kao oni što u raku silaze.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Počuj glas moga preklinjanja",
            "poem": 1
          },
          {
            "text": "kad zavapim k tebi,",
            "poem": 2
          },
          {
            "text": "kad podignem ruke svoje",
            "poem": 1
          },
          {
            "text": "k tvom najsvetijem mestu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ne odvedi me s opakima,",
            "poem": 1
          },
          {
            "text": "s onima koji čine bezakonje.",
            "poem": 2
          },
          {
            "text": "Oni pričaju blago s bližnjima svojim,",
            "poem": 1
          },
          {
            "text": "a u srcu zloba im počiva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Vrati im po delima njihovim,",
            "poem": 1
          },
          {
            "text": "i po njihovim zlim postupcima.",
            "poem": 2
          },
          {
            "text": "Plati im po delima ruku njihovih,",
            "poem": 1
          },
          {
            "text": "ti im vrati što su zaslužili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Pošto ne mare za dela Gospodnja,",
            "poem": 1
          },
          {
            "text": "niti za dela ruku njegovih,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "srušiće ih, podići ih neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Neka je blagosloven Gospod,",
            "poem": 1
          },
          {
            "text": "jer je čuo glas moga preklinjanja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Gospod je moja snaga i moj štit,",
            "poem": 1
          },
          {
            "text": "u njega se pouzdaje moje srce.",
            "poem": 2
          },
          {
            "text": "On mi je pomogao, pa mi kliče srce,",
            "poem": 1
          },
          {
            "text": "svojom pesmom davaću mu hvale.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Gospod je snaga svom narodu,",
            "poem": 1
          },
          {
            "text": "tvrđava spasenja svom pomazaniku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Spasi svoj narod! Blagoslovi svoje nasledstvo!",
            "poem": 1
          },
          {
            "text": "Napasaj ga i nosi zauvek!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
