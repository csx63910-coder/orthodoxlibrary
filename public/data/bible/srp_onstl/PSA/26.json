  "chapter": {
    "number": 26,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Opravdaj me, Gospode,",
            "poem": 1
          },
          {
            "text": "jer sam živeo u nedužnosti,",
            "poem": 2
          },
          {
            "text": "u Gospoda sam se pouzdao,",
            "poem": 1
          },
          {
            "text": "pokolebao se nisam.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Istraži me, Gospode, iskušaj me,",
            "poem": 1
          },
          {
            "text": "ispitaj mi i nutrinu i srce.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Hod svoj upravljam po tvojoj istini,",
            "poem": 1
          },
          {
            "text": "jer mi je tvoja milost pred očima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ja ne sedim s lažljivcima,",
            "poem": 1
          },
          {
            "text": "s licemerima se ja ne družim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ja mrzim zbor zlikovaca,",
            "poem": 1
          },
          {
            "text": "s opakima neću ni da sednem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ruke perem u svojoj nevinosti,",
            "poem": 1
          },
          {
            "text": "i idem oko tvog žrtvenika, Gospode,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "da glasno uzdignem glas hvalospeva,",
            "poem": 1
          },
          {
            "text": "i drugima pričam o svim tvojim čudima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Volim, Gospode, Prebivalište tvoje,",
            "poem": 1
          },
          {
            "text": "mesto u kome prebiva tvoja slava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ne pogubi moju dušu s grešnicima,",
            "poem": 1
          },
          {
            "text": "ni moj život s ljudima krvoločnim;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "na rukama je njima bezakonje,",
            "poem": 1
          },
          {
            "text": "a desnica puna im je mita.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "A ja ću hodati u nedužnosti;",
            "poem": 1
          },
          {
            "text": "otkupi me, smiluj mi se!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Moja noga stoji na ravnom mestu:",
            "poem": 1
          },
          {
            "text": "na zborovima blagosiljaću Gospoda.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
