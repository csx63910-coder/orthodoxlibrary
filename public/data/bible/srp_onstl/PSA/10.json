  },
  "chapter": {
    "number": 10,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Zašto, Gospode, stojiš daleko?",
            "poem": 1
          },
          {
            "text": "Što se skrivaš u vreme nevolje?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Opaki, nadmeni, ljuto goni ubogog,",
            "poem": 1
          },
          {
            "text": "u spletke ga hvata koje je ispleo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jer opaki se hvali žudnjama svog srca,",
            "poem": 1
          },
          {
            "text": "pohlepni proklinje, prezire Gospoda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "U svojoj ga oholosti on ne traži,",
            "poem": 1
          },
          {
            "text": "nema Boga ni u jednoj misli svojoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Taj uvek uspeva na svojim stazama,",
            "poem": 1
          },
          {
            "text": "na sudove tvoje on s visoka gleda,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i svojim se dušmanima ruga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "On u srcu kaže:",
            "poem": 1
          },
          {
            "text": "„Ništa mene neće uzdrmati,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "zlo me nikad zadesiti neće.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Usta su mu puna kletve, laži i uvrede,",
            "poem": 1
          },
          {
            "text": "a muka i nevolja pod jezikom njegovim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "U dvorištu vreba iz zasede,",
            "poem": 1
          },
          {
            "text": "iz potaje ubija nevinoga,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "iz skrovišta motri nemoćnoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Kao lav on vreba u šipražju,",
            "poem": 1
          },
          {
            "text": "u zasedi čeka da ulovi ubogoga;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "u svoju ga mrežu hvata i odvlači.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Bespomoćne lomi i obara,",
            "poem": 1
          },
          {
            "text": "oni mu u kandže dopadaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "On govori u srcu:",
            "poem": 1
          },
          {
            "text": "„Bog zaboravlja, skriva lice,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "nikada on to neće videti.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ustani, Gospode,",
            "poem": 1
          },
          {
            "text": "digni svoju ruku, Bože,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ponizne nemoj zaboraviti!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Zašto opaki da prezire Boga,",
            "poem": 1
          },
          {
            "text": "zašto da u svom srcu kaže:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Ti me nećeš za to pitati“?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ali, ti to ipak vidiš,",
            "poem": 1
          },
          {
            "text": "jer posmatraš muku i nevolju,",
            "poem": 2
          },
          {
            "text": "da stvar uzmeš u svoje ruke.",
            "poem": 1
          },
          {
            "text": "Nemoćni se oslanja na tebe,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "sirotome ti si pomoćnik.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Slomi ruku opakome, zlome,",
            "poem": 1
          },
          {
            "text": "pa kad tražiš njegovu opakost,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ni traga od nje da ne nađeš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Gospod je car u veke vekova,",
            "poem": 1
          },
          {
            "text": "nestaće narodi sa njegove zemlje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ti, Gospode, čuješ čežnju poniznih,",
            "poem": 1
          },
          {
            "text": "hrabriš ih, uho svoje priklanjaš,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "da daš pravo sirotome i ugnjetenom,",
            "poem": 1
          },
          {
            "text": "da čovek na zemlji ne zadaje više strah.",
            "poem": 2
          }
        ]
      }
    ],
