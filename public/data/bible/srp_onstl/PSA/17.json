  "chapter": {
    "number": 17,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Davidova molitva."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Čuj, Gospode, pravednosti radi,",
            "poem": 1
          },
          {
            "text": "okreni se k mome vapaju,",
            "poem": 2
          },
          {
            "text": "prigni uho mojoj molitvi,",
            "poem": 1
          },
          {
            "text": "jer na mojim usnama nema prevare.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Nek mi sud s tvoga lica dođe;",
            "poem": 1
          },
          {
            "text": "tvoje oči čestitost nek vide.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ti si meni ispitao srce,",
            "poem": 1
          },
          {
            "text": "došao mi noću u posetu,",
            "poem": 2
          },
          {
            "text": "misli si mi ognjem iskušao,",
            "poem": 1
          },
          {
            "text": "ali ništa tamo nisi našao;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a ja reših da ustima ne zgrešim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Po čemu će čovek da postupa?",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Prema reči sa tvojih usana,",
            "poem": 1
          },
          {
            "text": "ja se čuvam staza nasilnika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Održi mi stope na svojim stazama,",
            "poem": 1
          },
          {
            "text": "da se moje noge ne okliznu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Prizivam te, Bože, jer mi odgovaraš,",
            "poem": 1
          },
          {
            "text": "prigni uho k meni, počuj moje reči.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Pokaži milost svoju čudesnu,",
            "poem": 1
          },
          {
            "text": "ti što desnicom svojom izbavljaš one,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "koji traže utočište od svojih zlotvora.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Čuvaj me kao zenicu svog oka,",
            "poem": 1
          },
          {
            "text": "pod senku me svojih krila skloni,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "od opakih koji me napadaju,",
            "poem": 1
          },
          {
            "text": "od dušmana što me opkoljuju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Srce im je postalo bezdušno",
            "poem": 1
          },
          {
            "noteId": 3
          },
          {
            "text": ",",
            "poem": 1
          },
          {
            "text": "a usta im govore uznosito.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Oni mene gone, opkoljuju,",
            "poem": 1
          },
          {
            "text": "a oči im pažljivo gledaju,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kako da me na tlo obore.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Kao lav su što žudi da rastrgne,",
            "poem": 1
          },
          {
            "text": "kao mladi lav što vreba iz potaje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ustani na njih, Gospode,",
            "poem": 1
          },
          {
            "text": "baci ih na kolena,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "mačem me svojim izbavi od opakog!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Izbavi me svojom rukom, Gospode,",
            "poem": 1
          },
          {
            "text": "od ljudi kojima je deo ovaj svet prolazni;",
            "poem": 2
          },
          {
            "text": "neka im trbuh puni ono",
            "poem": 1
          },
          {
            "text": "što si zlima namenio;",
            "poem": 2
          },
          {
            "text": "siti će im biti i sinovi,",
            "poem": 1
          },
          {
            "text": "i za potomstvo će im još ostati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "A ja ću u pravednosti lice tvoje videti,",
            "poem": 1
          },
          {
            "text": "kad se probudim tvoga ću se lika nasititi.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 3,
        "caller": "+",
        "text": "17,10 Ili: Svojim salom su optočeni – slika otvrdlog srca u kome nema sažaljenja.",
        "reference": {
          "chapter": 17,
          "verse": 10
        }
      }
    ]
