  },
  "chapter": {
    "number": 88,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Pesma. Psalam. Potomaka Korejevih. Horovođi. Žalosno. Peva se naizmenično. Poučna pesma Emana Ezraita."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "O, Gospode, Bože mog spasenja,",
            "poem": 1
          },
          {
            "text": "i danju i noću ja pred tobom vapim!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Nek pred tebe dođe molitva moja,",
            "poem": 1
          },
          {
            "text": "mome preklinjanju ti uho prikloni!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Duša mi je prepuna očaja,",
            "poem": 1
          },
          {
            "text": "Svetu mrtvih život mi sve bliži.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "U društvu sam onih što idu u raku,",
            "poem": 1
          },
          {
            "text": "ja sam kao čovek koji snage nema;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "položen sam među mrtve,",
            "poem": 1
          },
          {
            "text": "poput mrtvih što leže u grobu,",
            "poem": 2
          },
          {
            "text": "kao oni koje više ne spominješ",
            "poem": 1
          },
          {
            "text": "i što su daleko od tvoje pomoći.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ti si me položio u najdublju raku,",
            "poem": 1
          },
          {
            "text": "u tamne dubine.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Srdžba tvoja na mene je legla",
            "poem": 1
          },
          {
            "text": "i plave me svi talasi tvoji. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Od mene si odvojio prijatelje moje,",
            "poem": 1
          },
          {
            "text": "gadnim si me njima učinio;",
            "poem": 2
          },
          {
            "text": "sada sam sputan, napolje ne mogu!",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Oči su mi usahle od bede.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Prizivam te svakog dana,",
            "poem": 1
          },
          {
            "text": "o, Gospode, tebi širim ruke svoje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Zar ćeš čuda za mrtve da činiš?",
            "poem": 1
          },
          {
            "text": "Hoće li pokojni ustati da te slave? Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Da li se u grobu tvoja milost razglašava,",
            "poem": 1
          },
          {
            "text": "i vernost tvoja u truležu mrtvih?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Pa zar se u tami zna za čuda tvoja,",
            "poem": 1
          },
          {
            "text": "za pravednost tvoju u zemlji zaborava?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "A ja tebe, o, Gospode, prizivam u pomoć;",
            "poem": 1
          },
          {
            "text": "molitva se moja jutrom podiže do tebe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Gospode, zašto me odbacuješ?",
            "poem": 1
          },
          {
            "text": "Zašto svoje lice od mene sakrivaš?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ojađen sam, od mladosti blizu smrti;",
            "poem": 1
          },
          {
            "text": "očajan sam, natovaren užasima tvojim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Srdžba tvoja me je pregazila,",
            "poem": 1
          },
          {
            "text": "strahote me tvoje uništile.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Okružiše me poput vode povazdan,",
            "poem": 1
          },
          {
            "text": "navaljuju jednodušno na me.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Voljene i bliske od mene si uklonio",
            "poem": 1
          },
          {
            "text": "i ja sada drugujem sa tamom.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
