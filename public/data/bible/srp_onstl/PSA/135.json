  "chapter": {
    "number": 135,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Slavite Gospoda!",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Slavite ime Gospodnje!",
            "poem": 1
          },
          {
            "text": "Slavite, o, sluge Gospodnje;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "vi što stojite u Gospodnjem Domu,",
            "poem": 1
          },
          {
            "text": "u dvorištima Doma Boga našeg!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Slavite Gospoda jer je dobar Gospod.",
            "poem": 1
          },
          {
            "text": "Pesmom mu proslavljajte ime,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer je milo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Jer, Jakova je sebi izabrao,",
            "poem": 1
          },
          {
            "text": "Izrailja za svoju dragocenu svojinu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Zaista, ja znam da je velik Gospod,",
            "poem": 1
          },
          {
            "text": "naš je Gospod veći od svih božanstava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Sve što hoće, to Gospod i čini –",
            "poem": 1
          },
          {
            "text": "na nebesima i na zemlji,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "u morima i u svim dubinama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "On podiže oblake s kraja zemlje,",
            "poem": 1
          },
          {
            "text": "kiši munje daje",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i izvodi vetar iz svojih riznica.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "On je pobio prvence u Egiptu,",
            "poem": 1
          },
          {
            "text": "kako ljude, tako životinje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Poslao je znakove i čudesa usred tebe, Egipte,",
            "poem": 1
          },
          {
            "text": "na faraona i sve njegove sluge.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Pobio je narode mnoge,",
            "poem": 1
          },
          {
            "text": "pogubio je careve silne –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Sihona, amorejskog cara;",
            "poem": 1
          },
          {
            "text": "Oga, vasanskoga cara",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i sva carstva u Hananu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Njihovu je zemlju dao u nasledstvo,",
            "poem": 1
          },
          {
            "text": "u nasledstvo za svoj narod, za Izrailj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "O, Gospode, večito je ime tvoje!",
            "poem": 1
          },
          {
            "text": "O, Gospode, spominješ se kroz naraštaj svaki!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Gospod će suditi",
            "poem": 1
          },
          {
            "noteId": 12
          },
          {
            "text": "svome narodu,",
            "poem": 1
          },
          {
            "text": "na svoje će se sluge sažaliti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Srebro su i zlato idoli naroda,",
            "poem": 1
          },
          {
            "text": "ljudskih ruku delo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Sa ustima – a nemi,",
            "poem": 1
          },
          {
            "text": "sa očima – a slepi;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "sa ušima – a gluvi,",
            "poem": 1
          },
          {
            "text": "u ustima im nema daha.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Takvi će da budu ti što su ih načinili,",
            "poem": 1
          },
          {
            "text": "svi koji se u njih pouzdaju!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Blagosiljaj Gospoda, o, dome Izrailjev!",
            "poem": 1
          },
          {
            "text": "Blagosiljaj Gospoda, o, dome Aronov!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Blagosiljaj Gospoda, o, dome Levijev!",
            "poem": 1
          },
          {
            "text": "Blagosiljajte Gospoda, o, svi što strepite od Gospoda!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Blagosloven nek je sa Siona Gospod,",
            "poem": 1
          },
          {
            "text": "u Jerusalimu što prebiva!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Slavite Gospoda!",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 12,
        "caller": "+",
        "text": "135,14 Ovo je sud na kome Bog brani, opravdava.",
        "reference": {
          "chapter": 135,
          "verse": 14
        }
      }
    ]
