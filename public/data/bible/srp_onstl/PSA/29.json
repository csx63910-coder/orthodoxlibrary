  "chapter": {
    "number": 29,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Psalam Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Dajte slavu Gospodu, sinovi Božiji,",
            "poem": 1
          },
          {
            "text": "dajte Gospodu slavu i silu,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "dajte Gospodu slavu imena njegovog,",
            "poem": 1
          },
          {
            "text": "klanjajte se Gospodu u veličanstvu svetinje njegove.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Glas je Gospodnji nad vodama,",
            "poem": 1
          },
          {
            "text": "on to tutnji, on, Bog slave,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "on, Gospod, nad mnogim vodama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Glas je Gospodnji silan,",
            "poem": 1
          },
          {
            "text": "glas je Gospodnji veličanstven.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Glas Gospodnji lomi kedrove,",
            "poem": 1
          },
          {
            "text": "Gospod lomi kedrove livanske.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Od njega poskakuju kao tele,",
            "poem": 1
          },
          {
            "text": "a Livan i Sirjon",
            "poem": 2
          },
          {
            "noteId": 4
          },
          {
            "text": "kao bivolče.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Glas Gospodnji sipa munje ognjene,",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "glas Gospodnji potresa pustinju,",
            "poem": 1
          },
          {
            "text": "trese Gospod pustinju kadisku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Od glasa Gospodnjeg košute se mlade,",
            "poem": 1
          },
          {
            "text": "šumama on skida koru sa stabala,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a u Domu njegovom svi govore „Slava!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Gospod stoluje nad potopom,",
            "poem": 1
          },
          {
            "text": "Gospod stoluje kao Car doveka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Gospod daje silu svom narodu,",
            "poem": 1
          },
          {
            "text": "Gospod mirom blagosilja svoj narod.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 4,
        "caller": "+",
        "text": "29,6 Drugo ime gore Ermon, vidi 5. Moj 3,9.",
        "reference": {
          "chapter": 29,
          "verse": 6
        }
      }
    ]
