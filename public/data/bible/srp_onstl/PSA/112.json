  "chapter": {
    "number": 112,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Slavite Gospoda!",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Blago čoveku što se Gospoda boji",
            "poem": 1
          },
          {
            "text": "i u zapovestima njegovim rado uživa.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Moćno će mu potomstvo biti po zemlji,",
            "poem": 1
          },
          {
            "text": "naraštaj će pravednika blagosloven biti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "U kući mu blago i imetak,",
            "poem": 1
          },
          {
            "text": "pravednost mu postojana vavek.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Svetlo i u tami sija pravednima,",
            "poem": 1
          },
          {
            "text": "milosrdnima, milostivima i pravičnima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Sažaljiv je dobar čovek, pozajmljuje,",
            "poem": 1
          },
          {
            "text": "pravedno se u poslu ophodi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Taj se nikad uzdrmati neće,",
            "poem": 1
          },
          {
            "text": "sećanje na pravednika trajaće doveka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "On ne strepi pred lošim vestima,",
            "poem": 1
          },
          {
            "text": "pouzdanog srca u Gospoda se uzda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Pribranog je srca, ne strahuje",
            "poem": 1
          },
          {
            "text": "dok ne zalikuje nad dušmanima svojim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "On neštedimice deli,",
            "poem": 1
          },
          {
            "text": "daje sirotinji,",
            "poem": 2
          },
          {
            "text": "pravednost njegova ostaje doveka;",
            "poem": 1
          },
          {
            "text": "rog će mu se u časti uzdići.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Videće to zlotvor, ozlojediće se,",
            "poem": 1
          },
          {
            "text": "škripaće zubima i grišće se;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "propašće žudnja zlotvora!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
