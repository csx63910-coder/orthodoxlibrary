  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Psalam Davidov, kad je bežao pred svojim sinom Avesalomom."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Gospode, koliko li je mojih protivnika,",
            "poem": 1
          },
          {
            "text": "koliko li je onih što ustaju na mene!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Mnogo je onih što o meni kažu:",
            "poem": 1
          },
          {
            "text": "„Nema njemu spasenja od Boga.“ Sela",
            "poem": 2
          },
          {
            "noteId": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "A ti, Gospode, štit si oko mene,",
            "poem": 1
          },
          {
            "text": "slavo moja, ti mi glavu dižeš!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Glasom svojim prizivam Gospoda,",
            "poem": 1
          },
          {
            "text": "odgovara on mi s gore svoje svete. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ja ležem i spavam, i opet se budim,",
            "poem": 1
          },
          {
            "text": "jer On, Gospod, pruža mi oslonac.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ne bojim se ni hiljada ljudi,",
            "poem": 1
          },
          {
            "text": "što odasvud nadiru na mene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ustani, Gospode,",
            "poem": 1
          },
          {
            "text": "spasi me, moj Bože;",
            "poem": 2
          },
          {
            "text": "sve dušmane moje udari u bradu,",
            "poem": 1
          },
          {
            "text": "opakima sve zube polomi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Spasenje pripada Gospodu,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "tvoj blagoslov na tvom je narodu. Sela",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 1,
        "caller": "+",
        "text": "3,2 Jevrejski muzički pojam nesigurnog značenja koji se u Septuaginti prevodi kao prekid, pauza.",
        "reference": {
          "chapter": 3,
          "verse": 2
        }
      }
    ]
