  "chapter": {
    "number": 110,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Psalam Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Reče Gospod Gospodu mome:",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Sedi meni s moje desne strane,",
            "poem": 2
          },
          {
            "text": "dok dušmane ne položim tvoje,",
            "poem": 1
          },
          {
            "text": "za tvoje noge postolje da budu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Žezlo snage tvoje pruža Gospod sa Siona:",
            "poem": 1
          },
          {
            "text": "Sred dušmana svojih vladaj!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Tvoj će ti se narod rado dati u danu tvog pohoda;",
            "poem": 1
          },
          {
            "text": "u sjaju slave, u ciku zore mladići su tvoji kao rosa.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Gospod je dao zakletvu",
            "poem": 1
          },
          {
            "text": "i neće je povući:",
            "poem": 2
          },
          {
            "text": "„Ti si doveka sveštenik",
            "poem": 1
          },
          {
            "text": "po redu Melhisedekovom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Gospod ti je s desne strane",
            "poem": 1
          },
          {
            "text": "i careve lomi u danu svog gneva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "On narodima sudi, sve je puno leševa;",
            "poem": 1
          },
          {
            "text": "širom polja on glave razbija.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "On iz potoka kraj puta pije",
            "poem": 1
          },
          {
            "text": "i zbog toga diže glavu.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
