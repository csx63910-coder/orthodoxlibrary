  "chapter": {
    "number": 59,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Davidov napev: „Ne pogubi.“ Pesma pouzdanja u Boga, kada je Saul poslao ljude da motre na Davidovu kuću i ubiju ga."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Bože moj, oslobodi me od protivnika mojih;",
            "poem": 1
          },
          {
            "text": "skloni me od onih što se dižu protiv mene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Od zlotvora me oslobodi,",
            "poem": 1
          },
          {
            "text": "od krvoloka me spasi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jer, eno, iz potaje vrebaju mi život;",
            "poem": 1
          },
          {
            "text": "moćnici protiv mene pokreću nevolju,",
            "poem": 2
          },
          {
            "text": "ali ne zbog prestupa,",
            "poem": 1
          },
          {
            "text": "ne zbog greha moga, Gospode.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Bez krivice moje oni jure, spremaju se.",
            "poem": 1
          },
          {
            "text": "Podigni se, susretni me i primeti!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "A ti, Gospode, Bože nad vojskama,",
            "poem": 1
          },
          {
            "text": "Bože Izrailjev,",
            "poem": 2
          },
          {
            "text": "probudi se da sve narode kazniš;",
            "poem": 1
          },
          {
            "text": "ne smiluj se nijednom zlotvoru zlobnom. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Uveče se vraćaju,",
            "poem": 1
          },
          {
            "text": "poput pseta reže",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i šunjaju oko grada.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Eno, ustima brbljaju,",
            "poem": 1
          },
          {
            "text": "a mačevi im na usnama,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer govore: „Ko još sluša?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "A ti im se, o, Gospode, smeješ;",
            "poem": 1
          },
          {
            "text": "ti se rugaš svim tim narodima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ti si moja snaga, tebe iščekujem;",
            "poem": 1
          },
          {
            "text": "jer Bog je moj zaklon.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Bog milosti će me sresti,",
            "poem": 1
          },
          {
            "text": "daće mi Bog da likujem",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "nad mrziteljima svojim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ne ubij ih,",
            "poem": 1
          },
          {
            "text": "da moj narod zaboravio ne bi;",
            "poem": 2
          },
          {
            "text": "snagom svojom rasprši ih i obori,",
            "poem": 1
          },
          {
            "text": "Gospode, štite naš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Za grehe svojih usta",
            "poem": 1
          },
          {
            "text": "i reč usana svojih,",
            "poem": 2
          },
          {
            "text": "neka budu uhvaćeni u svome ponosu,",
            "poem": 1
          },
          {
            "text": "zbog kletve i laži što iznose.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Satri ih u gnevu,",
            "poem": 1
          },
          {
            "text": "satri da ih nema,",
            "poem": 2
          },
          {
            "text": "pa da narod shvati da Bog vlada",
            "poem": 1
          },
          {
            "text": "u Jakovu do krajeva zemlje. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Uveče se vraćaju,",
            "poem": 1
          },
          {
            "text": "poput pseta reže",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i šunjaju oko grada.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Raspršeni lutaju za jelom,",
            "poem": 1
          },
          {
            "text": "noć probdeju ako nisu siti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "A ja ću da pevam o tvojoj sili,",
            "poem": 1
          },
          {
            "text": "veseliću se jutrom zbog milosti tvoje;",
            "poem": 2
          },
          {
            "text": "jer si moj zaklon,",
            "poem": 1
          },
          {
            "text": "utočište u danu nevolje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Silo moja, slavopoj ti pevam;",
            "poem": 1
          },
          {
            "text": "jer Bog je moj zaklon,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Bog milosti moje.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
