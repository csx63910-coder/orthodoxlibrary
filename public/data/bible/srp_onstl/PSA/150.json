  "chapter": {
    "number": 150,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Slavite Gospoda!",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Slavite Boga u Svetilištu njegovom,",
            "poem": 1
          },
          {
            "text": "slavite ga pod nebeskim svodom sile njegove!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Slavite ga zbog njegovih silnih dela,",
            "poem": 1
          },
          {
            "text": "slavite ga zbog njegove silne veličine!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Slavite ga uz jeku truba,",
            "poem": 1
          },
          {
            "text": "slavite ga i lirom i harfom!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Slavite ga i bubnjem i kolom,",
            "poem": 1
          },
          {
            "text": "slavite ga strunama i sviralama!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Slavite ga cimbalima gromkim,",
            "poem": 1
          },
          {
            "text": "slavite ga cimbalima zvonkim!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Nek Gospoda slavi sve što diše!",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Slavite Gospoda!",
            "poem": 1
          }
        ]
      }
    ],
