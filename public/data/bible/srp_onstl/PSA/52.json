  "chapter": {
    "number": 52,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Davidova poučna pesma, kada je Doik Edomac došao i dojavio Saulu, rekavši mu: „David je otišao u Ahimelekovu kuću.“"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Što se hvališ zlobom, silniče?",
            "poem": 1
          },
          {
            "text": "Milost je Božija od jutra do sutra.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Razaranja ti smišlja jezik",
            "poem": 1
          },
          {
            "text": "poput britve oštar,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "o, prevrtljivče!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ti zlo voliš više nego dobro,",
            "poem": 1
          },
          {
            "text": "i laž više nego pravo da govoriš. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ti voliš sve reči proždrljive,",
            "poem": 1
          },
          {
            "text": "o, jeziče obmanjivi!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ali tebe će Bog doveka oboriti;",
            "poem": 1
          },
          {
            "text": "zgrabiće te, od šatora otrgnuti;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "iz zemlje živih iščupaće te. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "I videće to pravednici i bojaće se,",
            "poem": 1
          },
          {
            "text": "pa će mu se smejati:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "„Gle čoveka što Boga nije uzeo za tvrđavu,",
            "poem": 1
          },
          {
            "text": "rušitelja silnog,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "što se pouzdao u obilje svoga blaga!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "A ja sam kao zelena maslina",
            "poem": 1
          },
          {
            "text": "u Domu Božijem;",
            "poem": 2
          },
          {
            "text": "u milost se Božiju uzdam",
            "poem": 1
          },
          {
            "text": "od veka do veka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Hvaliću te u veke vekova",
            "poem": 1
          },
          {
            "text": "za dela tvoja;",
            "poem": 2
          },
          {
            "text": "nadaću se imenu tvome",
            "poem": 1
          },
          {
            "text": "jer je dobro pred tvojim vernima.",
            "poem": 2
          }
        ]
      }
    ],
