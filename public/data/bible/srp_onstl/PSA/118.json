  "chapter": {
    "number": 118,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Hvalite Gospoda jer je dobar,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Nek Izrailj kaže:",
            "poem": 1
          },
          {
            "text": "„Jer je milost njegova doveka!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Neka dom Aronov kaže:",
            "poem": 1
          },
          {
            "text": "„Jer je milost njegova doveka!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Neka kažu oni koji strepe od Gospoda:",
            "poem": 1
          },
          {
            "text": "„Jer je milost njegova doveka!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "U teskobi Gospoda sam zvao;",
            "poem": 1
          },
          {
            "text": "čuo me je Gospod,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "izveo me na prostrano mesto.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Gospod je na mojoj strani, neću se bojati;",
            "poem": 1
          },
          {
            "text": "šta mi može učiniti čovek?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Gospod je na mojoj strani,",
            "poem": 1
          },
          {
            "text": "među mojim pomagačima;",
            "poem": 2
          },
          {
            "text": "ja ću samo da likujem",
            "poem": 1
          },
          {
            "text": "nad onima što me mrze.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Bolje je u Gospodu utočište naći,",
            "poem": 1
          },
          {
            "text": "nego u čoveku oslonac pronaći.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Bolje je u Gospodu utočište naći,",
            "poem": 1
          },
          {
            "text": "nego u plemićima oslonac pronaći.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Svi narodi opkoliše mene,",
            "poem": 1
          },
          {
            "text": "ali sam ih potisnuo u ime Gospodnje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Opkoliše me, baš me okružiše,",
            "poem": 1
          },
          {
            "text": "ali sam ih potisnuo u ime Gospodnje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Prekriše me kao pčele,",
            "poem": 1
          },
          {
            "text": "alʼ zgasnuše ko plamen u trnju,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer baš sam ih potisnuo u ime Gospodnje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Divlje su me gurnuli da padnem,",
            "poem": 1
          },
          {
            "text": "ali mi je Gospod pomogao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Gospod je moja sila i pesma,",
            "poem": 1
          },
          {
            "text": "on mi je spasenje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Povik klicanja i spasenja",
            "poem": 1
          },
          {
            "text": "u šatoru je pravednika,",
            "poem": 2
          },
          {
            "text": "silna je na delu desnica Gospodnja.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Podigla se desnica Gospodnja!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Silna je na delu desnica Gospodnja!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ja umreti neću, živeću",
            "poem": 1
          },
          {
            "text": "dela Gospodnja da objavim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "A korio me je Gospod, baš me je korio;",
            "poem": 1
          },
          {
            "text": "ali smrti predao me nije.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Vrata pravednosti otvorite meni,",
            "poem": 1
          },
          {
            "text": "da kroz njih prođem i hvalim Gospoda!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "To su vrata Gospodnja,",
            "poem": 1
          },
          {
            "text": "pravedni će kroz njih proći.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Hvaliću te, jer si mi se odazvao,",
            "poem": 1
          },
          {
            "text": "jer si meni Spasitelj postao!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Kamen što su zidari odbacili,",
            "poem": 1
          },
          {
            "text": "postade kamen ugaoni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Od Gospoda ovo beše",
            "poem": 1
          },
          {
            "text": "i to je divno u našim očima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Ovo je dan sazdan od Gospoda;",
            "poem": 1
          },
          {
            "text": "radujmo se i kličimo u njemu!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "O, Gospode, vapimo ti, spasi!",
            "poem": 1
          },
          {
            "text": "O, Gospode, vapimo ti, uspeh daj nam!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Blagosloven onaj koji dolazi u ime Gospodnje!",
            "poem": 1
          },
          {
            "text": "Blagosiljamo vas iz Doma Gospodnjeg!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Gospod je Bog,",
            "poem": 1
          },
          {
            "text": "nas je obasjao.",
            "poem": 2
          },
          {
            "text": "Žrtvu prazničnu konopcima zavežite",
            "poem": 1
          },
          {
            "text": "za rogove žrtvenika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Bog moj ti si, tebe ću da hvalim;",
            "poem": 1
          },
          {
            "text": "o, moj Bože, tebe da veličam!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Hvalite Gospoda jer je dobar,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka!",
            "poem": 2
          }
        ]
      }
    ],
