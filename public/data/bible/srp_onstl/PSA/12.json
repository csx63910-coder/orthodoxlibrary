  "chapter": {
    "number": 12,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi: prema Šeminitu. Psalam Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Spasavaj, Gospode,",
            "poem": 1
          },
          {
            "text": "jer nestade verni,",
            "poem": 2
          },
          {
            "text": "iščeznuše pobožni",
            "poem": 1
          },
          {
            "text": "među potomcima ljudi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Svako vara svoga bližnjega,",
            "poem": 1
          },
          {
            "text": "usne njihove govore laskavo,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a u srcu drugačije misle.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Nek zatre Gospod usne prevrtljive,",
            "poem": 1
          },
          {
            "text": "nek istrebi jezik hvalisavi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "„Naš je jezik, naša snaga“ – kažu,",
            "poem": 1
          },
          {
            "text": "„usne su nam naša uzdanica.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ko će onda da vlada nad nama?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "„Radi siromaha što su potlačeni,",
            "poem": 1
          },
          {
            "text": "i ubogoga što stenje pod mukom,",
            "poem": 2
          },
          {
            "text": "ja ću sad ustati – govori Gospod –",
            "poem": 1
          },
          {
            "text": "spasenje mu dati za kojim uzdiše.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Reči Gospodnje čiste su reči,",
            "poem": 1
          },
          {
            "text": "srebro kaljeno u peći od gline,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "sedam puta one su topljene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ti ćeš ih, o, Gospode, sačuvati,",
            "poem": 1
          },
          {
            "text": "zauvek nas štititi od tog naraštaja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Opaki se nesputano šire unaokolo,",
            "poem": 1
          },
          {
            "text": "kad se zlo veliča među potomcima ljudi.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
