  "chapter": {
    "number": 84,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Radosnica potomaka Korejevih. Psalam."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "O, Gospode nad vojskama,",
            "poem": 1
          },
          {
            "text": "divno li je boravište tvoje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Čezne mi i kopni duša",
            "poem": 1
          },
          {
            "text": "za dvorištem Gospodnjim!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Srce mi i telo kliču živom Bogu!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Kraj tvojih žrtvenika –",
            "poem": 1
          },
          {
            "text": "o, Gospode nad vojskama,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Care moj i Bože moj –",
            "poem": 2
          },
          {
            "text": "ptica dom svoj nađe",
            "poem": 1
          },
          {
            "text": "i lastavica gnezdo svoje,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "u koje ptiće svoje stavi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Kako su blaženi oni što borave u tvom Domu,",
            "poem": 1
          },
          {
            "text": "oni što te slave bez prestanka. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Kako je blažen čovek kome je u tebi snaga,",
            "poem": 1
          },
          {
            "text": "onaj čije srce želi k tebi da putuje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Oni što prolaze suznom dolinom",
            "poem": 1
          },
          {
            "text": "čine je izvorom,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "blagoslove joj rana kiša nosi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Putuju, i sve su silniji,",
            "poem": 1
          },
          {
            "text": "dok se svako ne pokaže Bogu na Sionu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "O, Gospode, Bože nad vojskama, čuj molitvu moju!",
            "poem": 1
          },
          {
            "text": "Prigni uho, o, Jakovljev Bože!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Štit naš pogledaj, o, Bože,",
            "poem": 1
          },
          {
            "text": "i zapazi lice svog pomazanika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Jer bolji je i jedan dan u tvojim dvorištima",
            "poem": 1
          },
          {
            "text": "nego hiljadu drugih;",
            "poem": 2
          },
          {
            "text": "bolje i da stojim na pragu Doma Boga moga,",
            "poem": 1
          },
          {
            "text": "nego da boravim u šatorima zloga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Jer Gospod Bog je i sunce i štit,",
            "poem": 1
          },
          {
            "text": "Gospod daje i naklonost i čast.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ne uzima dobro besprekornim ljudima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "O, Gospode nad vojskama,",
            "poem": 1
          },
          {
            "text": "blago svakom ko se u tebe pouzda!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
