  "chapter": {
    "number": 79,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Psalam Asafov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "O, Bože, tuđinci su došli u nasledstvo tvoje!",
            "poem": 1
          },
          {
            "text": "Opoganili su Dom tvoje svetosti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Jerusalim učinili ruševinom!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Mrtva tela tvojih slugu",
            "poem": 1
          },
          {
            "text": "kao hranu pticama nebeskim su dali",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i zverima zemaljskim tela tvojih vernih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Krv njihovu izlili su oko Jerusalima",
            "poem": 1
          },
          {
            "text": "kao da je voda, i niko ih sahranio nije.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Svojim komšijama postali smo ruglo,",
            "poem": 1
          },
          {
            "text": "na podsmeh smo i na prezir svojoj okolini.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Dokle ćeš se gneviti, Gospode? Do kada?",
            "poem": 1
          },
          {
            "text": "Zar će doveka da gori plamen ljubomore tvoje?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Jarost svoju izlij na tuđince što te ne poznaju",
            "poem": 1
          },
          {
            "text": "i na carstva koja tvoje ime ne prizivaju!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Jer oni su proždrali Jakova",
            "poem": 1
          },
          {
            "text": "i naselje mu uništili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ne pamti nam pređašnje krivice! Pohitaj!",
            "poem": 1
          },
          {
            "text": "Milosrđem svojim presretni nas",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer smo u velikoj bedi!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Pomozi nam, o, Bože spasenja našega!",
            "poem": 1
          },
          {
            "text": "Izbavi nas radi svog imena slavnog!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Oprosti nam grehe naše zbog imena svoga!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Zašto da tuđinci kažu:",
            "poem": 1
          },
          {
            "text": "„Gde je njihov Bog?“",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Daj da nam oči vide osvetu među narodima",
            "poem": 1
          },
          {
            "text": "zbog prolivene krvi slugu tvojih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Nek pred tebe dopre jecaj zatočenih,",
            "poem": 1
          },
          {
            "text": "pa velikom snagom svojom spasi na smrt osuđene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Osveti se sedmostruko po nedrima komšijama našim",
            "poem": 1
          },
          {
            "text": "prezirom njihovim kojim su te, Gospode, prezreli!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "A mi, tvoj narod i stado tvoje paše,",
            "poem": 1
          },
          {
            "text": "u vekove hvalićemo tebe!",
            "poem": 2
          },
          {
            "text": "Slavu tvoju javićemo",
            "poem": 1
          },
          {
            "text": "svakom naraštaju!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
