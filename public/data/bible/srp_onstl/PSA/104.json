  },
  "chapter": {
    "number": 104,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Blagosiljaj, dušo moja, Gospoda!",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "O, Gospode, o, moj Bože, ti si od svih veći;",
            "poem": 1
          },
          {
            "text": "odenut si i sjajem i slavom!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Svetlošću je kao plaštom zaogrnut,",
            "poem": 1
          },
          {
            "text": "kao šator prostireš nebesa.",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Grede gornjih odaja svojih u vode polaže,",
            "poem": 2
          },
          {
            "text": "oblake u kočije svoje preže,",
            "poem": 1
          },
          {
            "text": "na krilima vetra jezdi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "On svoje anđele čini vetrovima,",
            "poem": 1
          },
          {
            "text": "i svoje sluge ognjenim plamenovima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "On je zemlju postavio na njene temelje,",
            "poem": 1
          },
          {
            "text": "u veke vekova neće se pomaći.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Dubinama si je pokrio kao pokrivačem,",
            "poem": 1
          },
          {
            "text": "a vode su joj bile nad gorama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Povlače se od prekora tvoga,",
            "poem": 1
          },
          {
            "text": "odtekle su od tutnjave groma tvoga –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "kada su se gore digle i doline slegle –",
            "poem": 1
          },
          {
            "text": "tamo gde si im i odredio mesto;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "ne prelaze među što si im stavio,",
            "poem": 1
          },
          {
            "text": "vratiti se neće da zemlju prekriju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ti izvore šalješ dolinama",
            "poem": 1
          },
          {
            "text": "da poteku među planinama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Oni poje svaku poljsku zverku",
            "poem": 1
          },
          {
            "text": "i žeđ gase divljim magarcima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Nebeske se ptice kraj njih gnezde",
            "poem": 1
          },
          {
            "text": "i pevaju u rastinju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Iz gornjih odaja svojih natapaš gore",
            "poem": 1
          },
          {
            "text": "i zemlja je puna ploda dela tvojih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ti činiš da za stoku trava raste,",
            "poem": 1
          },
          {
            "text": "bilje što ga čovek obrađuje,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da bi zemlja urodila hlebom;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "i vino što čoveku razgaljuje srce,",
            "poem": 1
          },
          {
            "text": "ulje što lice ozari",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i hleb što hrani čoveku srce.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Gospodnja su stabla nalivena,",
            "poem": 1
          },
          {
            "text": "kedrovi što ih je usadio na Livanu;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "na njima se ptice gnezde,",
            "poem": 1
          },
          {
            "text": "u čempresima roda im se skući.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Na visokim gorama žive divokoze,",
            "poem": 1
          },
          {
            "text": "a kamenjari damanima utočište daju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "On je mesec načinio da se meri vreme,",
            "poem": 1
          },
          {
            "text": "a i sunce zna kada da zađe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Ti spuštaš tamu i noć biva,",
            "poem": 1
          },
          {
            "text": "pa izmile sve šumske živuljke.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Lavovi za plenom riču",
            "poem": 1
          },
          {
            "text": "tražeći od Boga za sebe hranu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Kad sunce zarudi",
            "poem": 1
          },
          {
            "text": "oni se okupe u jazbini svojoj i ležu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "A čovek ide za poslom svojim",
            "poem": 1
          },
          {
            "text": "i radi do večeri.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "O, Gospode, kako je mnogo dela tvojih!",
            "poem": 1
          },
          {
            "text": "Svako si od njih učinio mudro",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i tvojih je stvorenja puna zemlja!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Eno mora, velikog i širokih obala,",
            "poem": 1
          },
          {
            "text": "vrve od bezbrojnih stvorenja,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "životinja malih i velikih;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Po njemu brodovi brode",
            "poem": 1
          },
          {
            "text": "i Levijatan",
            "poem": 2
          },
          {
            "noteId": 9
          },
          {
            "text": "koga si načinio u njemu igra.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Svi oni čekaju tebe",
            "poem": 1
          },
          {
            "text": "da im na vreme daš ono što jedu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Ti im daješ",
            "poem": 1
          },
          {
            "text": "i oni to sakupe;",
            "poem": 2
          },
          {
            "text": "ti otvaraš ruku svoju",
            "poem": 1
          },
          {
            "text": "i oni su siti dobra.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Kad sakriješ lice svoje",
            "poem": 1
          },
          {
            "text": "oni se prepadnu;",
            "poem": 2
          },
          {
            "text": "kad im uzmeš dah, oni skapavaju",
            "poem": 1
          },
          {
            "text": "i ponovo idu u prašinu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Kad im pošalješ svoj dah oni nastaju;",
            "poem": 1
          },
          {
            "text": "ti obnavljaš lice zemlje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Nek doveka bude slava Gospodnja!",
            "poem": 1
          },
          {
            "text": "Nek delima svojim raduje se Gospod!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "On u zemlju gleda i ona se trese;",
            "poem": 1
          },
          {
            "text": "on dotiče gore i one se dime.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Kroz svoj život pevaću Gospodu,",
            "poem": 1
          },
          {
            "text": "dok me ima Boga moga proslavljaću!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Ugodne mu bile misli moje,",
            "poem": 1
          },
          {
            "text": "a ja ću da se radujem u Gospodu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Nek grešnici nestanu sa zemlje",
            "poem": 1
          },
          {
            "text": "i zlobnika neka više nema!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Blagosiljaj, dušo moja, Gospoda!",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Slavite Gospoda!",
            "poem": 1
          }
        ]
      }
    ],
