  "chapter": {
    "number": 91,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "U zaklonu Svevišnjeg ko prebiva,",
            "poem": 1
          },
          {
            "text": "u senci Svemoćnog taj počiva!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Gospodu ću reći:",
            "poem": 1
          },
          {
            "text": "„Moj zaklone i tvrđavo moja!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Moj Bože u koga se uzdam.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jer on će te izbaviti",
            "poem": 1
          },
          {
            "text": "iz ptičarske omče",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i pomora kobnog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Svojim perjem pokriće te,",
            "poem": 1
          },
          {
            "text": "sakrićeš se pod njegova krila;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "štit i bedem istina je njegova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Strahote noćne nećeš se plašiti,",
            "poem": 1
          },
          {
            "text": "a ni strele koja danju leti;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "ni pomora što se mrakom šunja,",
            "poem": 1
          },
          {
            "text": "ni zaraze što kosi u podne.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Pored tebe hiljada će pasti,",
            "poem": 1
          },
          {
            "text": "tebi zdesna i deset hiljada,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a tebi se približiti neće!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Samo ćeš rođenim očima da gledaš,",
            "poem": 1
          },
          {
            "text": "nad opakim videćeš osvetu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Zato što si u Gospodu, u utočištu mome,",
            "poem": 1
          },
          {
            "text": "u Svevišnjem prebivalište sebi našao",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "zlo te zadesiti neće,",
            "poem": 1
          },
          {
            "text": "i ni blizu tvog šatora pošast prići neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Jer on će zapovediti svojim anđelima",
            "poem": 1
          },
          {
            "text": "da te čuvaju na svim tvojim putevima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Oni će te poneti na svojim rukama,",
            "poem": 1
          },
          {
            "text": "da nogom ne bi o kamen zapeo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Izgazićeš i lava i zmiju,",
            "poem": 1
          },
          {
            "text": "pregazićeš lavića i guju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "„Izbaviću ga jer mi je privržen;",
            "poem": 1
          },
          {
            "text": "na visinu, u zaklon ga stavljam,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer poznaje moje ime.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "On će mene zvati, a ja ću mu se odazvati;",
            "poem": 1
          },
          {
            "text": "biću sa njim u nevolji da ga spasem",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i učinim časnim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Životom dugim ću ga nasititi,",
            "poem": 1
          },
          {
            "text": "daću mu da vidi izbavljenje moje.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
