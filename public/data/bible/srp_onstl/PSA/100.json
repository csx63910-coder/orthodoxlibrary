  "chapter": {
    "number": 100,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Psalam zahvalnosti."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Kliči Gospodu, zemljo sva!",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Rado Gospodu služite,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "priđite mu pevajući!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Znajte: Gospod je Bog, on nas je sazdao",
            "poem": 1
          },
          {
            "text": "i njemu pripadamo;",
            "poem": 2
          },
          {
            "text": "mi smo njegov narod",
            "poem": 1
          },
          {
            "text": "i stado njegove ispaše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Sa hvalama ulazite na vrata njegova",
            "poem": 1
          },
          {
            "text": "i s pesmama u njegova dvorišta;",
            "poem": 2
          },
          {
            "text": "hvalite ga,",
            "poem": 1
          },
          {
            "text": "ime mu slavite.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Jer je dobar Gospod,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i veran je naraštaju svakom!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
