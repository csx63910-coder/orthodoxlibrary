  "chapter": {
    "number": 133,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Pesma poklonička. Davidova."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Gle! Kako je dobro, kakva je milina",
            "poem": 1
          },
          {
            "text": "kada su braća zajedno i složno!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ko na glavi dobro ulje,",
            "poem": 1
          },
          {
            "text": "koje se na bradu sliva,",
            "poem": 2
          },
          {
            "text": "na Aronovu bradu;",
            "poem": 1
          },
          {
            "text": "što se sliva na porube odeće njegove;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "kao rosa sa Ermona,",
            "poem": 1
          },
          {
            "text": "koja rosi na sionske gore;",
            "poem": 2
          },
          {
            "text": "tamo gde je Gospod odredio",
            "poem": 1
          },
          {
            "text": "blagoslov života večnog.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
