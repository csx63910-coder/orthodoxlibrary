  },
  "chapter": {
    "number": 64,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Psalam Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Čuj, o, Bože, glas moj, žalopojku moju;",
            "poem": 1
          },
          {
            "text": "od strahote protivnika život mi sačuvaj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Zakloni me od spletki zlotvora,",
            "poem": 1
          },
          {
            "text": "od halabuke počinitelja zlobe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jezike svoje poput mača oni oštre,",
            "poem": 1
          },
          {
            "text": "odapinju strele svoje – reči zajedljive –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "da iz skrivenih mesta",
            "poem": 1
          },
          {
            "text": "gađaju čoveka bez mane;",
            "poem": 2
          },
          {
            "text": "i najednom gađaju ga",
            "poem": 1
          },
          {
            "text": "i straha nemaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Sokole se među sobom na zle stvari,",
            "poem": 1
          },
          {
            "text": "dogovaraju se da prikriju klopke,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pa govore: „Ko će da ih vidi?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Spliću nepravdu:",
            "poem": 1
          },
          {
            "text": "„Smislili smo! Spletka je spletena.“",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Duboki su čovekova nutrina i srce.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ali Bog će ih strelom gađati",
            "poem": 1
          },
          {
            "text": "i najednom ranjeni će biti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "O svoj jezik sapleće se,",
            "poem": 1
          },
          {
            "text": "zadrhtaće svako ko ih gleda;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "prepašće se sav rod ljudski,",
            "poem": 1
          },
          {
            "text": "objaviće delo Božije",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i njegovo delo razmatraće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Radovaće se pravednik u Gospodu,",
            "poem": 1
          },
          {
            "text": "u njemu će utočište naći,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pa će se hvaliti svako srca čestitoga.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
