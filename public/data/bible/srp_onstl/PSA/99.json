  "chapter": {
    "number": 99,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Gospod vlada –",
            "poem": 1
          },
          {
            "text": "nek narodi drhte!",
            "poem": 2
          },
          {
            "text": "Nad heruvimima on sedi –",
            "poem": 1
          },
          {
            "text": "nek se zemlja trese!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Veliki je Gospod na Sionu,",
            "poem": 1
          },
          {
            "text": "uzvišen je nad svim narodima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Veliko ti ime neka slave,",
            "poem": 1
          },
          {
            "text": "jer je strašno –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "on je svet!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Moćan je car koji voli pravdu;",
            "poem": 1
          },
          {
            "text": "Jakovu si učvrstio podjednako",
            "poem": 2
          },
          {
            "text": "i pravdu i pravednost,",
            "poem": 1
          },
          {
            "text": "ti si to učinio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Uzdižite Gospoda, Boga našeg!",
            "poem": 1
          },
          {
            "text": "Poklonite se pred podnožjem njegovih nogu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer je on svet.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Mojsije i Aron, sveštenici njegovi;",
            "poem": 1
          },
          {
            "text": "Samuilo, jedan od onih što su mu se molili,",
            "poem": 2
          },
          {
            "text": "zvali su Gospoda",
            "poem": 1
          },
          {
            "text": "i on ih je uslišio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "U stubu od oblaka im je govorio,",
            "poem": 1
          },
          {
            "text": "a oni su držali propise",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i uredbe koje im je dao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "O, Gospode, Bože naš,",
            "poem": 1
          },
          {
            "text": "ti si ih uslišio!",
            "poem": 2
          },
          {
            "text": "Bio si im Bog koji oprašta",
            "poem": 1
          },
          {
            "text": "ali i onaj što kažnjava njihova zlodela.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Uzdižite Gospoda, Boga našeg!",
            "poem": 1
          },
          {
            "text": "Poklonite se na njegovoj svetoj gori,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer naš Gospod, Bog je sveti.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
