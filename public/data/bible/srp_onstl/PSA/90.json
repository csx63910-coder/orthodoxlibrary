  "chapter": {
    "number": 90,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Molitva Mojsija, čoveka Božijega."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "O, Gospode, ti si nama bio prebivalište",
            "poem": 1
          },
          {
            "text": "kroz sva pokolenja!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Pre rođenja planina,",
            "poem": 1
          },
          {
            "text": "pre nego si sazdao zemlju i svet,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "od veka do veka, ti si Bog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ti smrtnika vraćaš u prašinu",
            "poem": 1
          },
          {
            "text": "i govoriš: „Vratite se, o, potomci ljudi!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Jer je u tvojim očima hiljadu godina",
            "poem": 1
          },
          {
            "text": "poput minulog, jučerašnjeg dana",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i poput smene noćne straže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Odnosiš ih ko bujica, poput sna su,",
            "poem": 1
          },
          {
            "text": "jutrom su ko trava izniknuli;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "ujutro cvetaju i rastu,",
            "poem": 1
          },
          {
            "text": "a uveče suše se i venu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Tako i mi nestajemo u tvom gnevu",
            "poem": 1
          },
          {
            "text": "i tvoja nas srdžba prestravljuje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Naše si krivice pred sebe stavio,",
            "poem": 1
          },
          {
            "text": "naše tajne licem svojim obasjao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Tako su minuli dani naši svi u tvome gnevu,",
            "poem": 1
          },
          {
            "text": "poput daha godine su naše isparile.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "U našem je veku sedamdeset leta,",
            "poem": 1
          },
          {
            "text": "osamdeset leta ako smo u snazi;",
            "poem": 2
          },
          {
            "text": "njihovo najbolje – tegoba i muka –",
            "poem": 1
          },
          {
            "text": "brzo prođu i mi odletimo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ko je upoznao silu tvoga gneva?",
            "poem": 1
          },
          {
            "text": "Koliko si strašan, toliko si srdit.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Nauči nas da brojimo svoje dane tako,",
            "poem": 1
          },
          {
            "text": "da bismo srce mudro zadobili!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "O, Gospode, okreni se! Dokle više?",
            "poem": 1
          },
          {
            "text": "Smiluj se na svoje sluge.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Milošću nas svojom ujutro nahrani;",
            "poem": 1
          },
          {
            "text": "da kličemo, da se veselimo kroz sve svoje dane!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Obraduj nas za sve one dane kad si nas tlačio,",
            "poem": 1
          },
          {
            "text": "za godine gledane nedaće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Nek slugama tvojim prikaže se delo tvoje",
            "poem": 1
          },
          {
            "text": "i njihovoj deci veličanstvo tvoje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Nek naklonost Gospoda, Boga našeg, počiva na nama.",
            "poem": 1
          },
          {
            "text": "Šta radili u tome uspeli!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Šta radili u tome uspeli!",
            "poem": 2
          }
        ]
      }
    ],
