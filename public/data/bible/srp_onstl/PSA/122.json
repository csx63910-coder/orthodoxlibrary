  "chapter": {
    "number": 122,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Pesma poklonička. Davidova."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Obradovao sam se kada su mi rekli:",
            "poem": 1
          },
          {
            "text": "„Idemo u Dom Gospodnji!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Evo nas, stojimo na vratima tvojim,",
            "poem": 1
          },
          {
            "text": "o, Jerusalime!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jerusalim, grad podignut,",
            "poem": 1
          },
          {
            "text": "postojan i skladan.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Plemena se u njega uspinju,",
            "poem": 1
          },
          {
            "text": "Gospodnja plemena",
            "poem": 2
          },
          {
            "text": "prema propisu za Izrailj,",
            "poem": 1
          },
          {
            "text": "da hvalospev daju Gospodnjem imenu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Jer prestoli suda su postavljeni tamo,",
            "poem": 1
          },
          {
            "text": "prestoli doma Davidovog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Molite se za mir Jerusalima!",
            "poem": 1
          },
          {
            "text": "Oni što te vole neka napreduju!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Neka bude mira među tvojim zidinama,",
            "poem": 1
          },
          {
            "text": "blagostanja među tvojim dvorovima!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Radi braće moje, prijatelja mojih,",
            "poem": 1
          },
          {
            "text": "kažem: „Mir u tebi bio!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Radi Doma Gospoda, Boga našeg,",
            "poem": 1
          },
          {
            "text": "tvoje dobro tražim!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
