  "chapter": {
    "number": 92,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Psalam. Pesma za dan subotnji."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Baš je dobro hvaliti Gospoda,",
            "poem": 1
          },
          {
            "text": "tvom imenu pevati, Svevišnji;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "milost tvoju ujutru javljati,",
            "poem": 1
          },
          {
            "text": "svake noći vernost tvoju;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "lirom sa deset struna",
            "poem": 1
          },
          {
            "text": "i harfinom melodijom!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Jer ti si me, o, Gospode,",
            "poem": 1
          },
          {
            "text": "obradovo delom svojim;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kličem trudu ruku tvojih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Kako su velika dela tvoja, o, Gospode!",
            "poem": 1
          },
          {
            "text": "Kako su duboki naumi tvoji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Čovek bez pameti ne zna",
            "poem": 1
          },
          {
            "text": "i bezumnik ovo ne razume;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Kad zlikovci niču kao trava",
            "poem": 1
          },
          {
            "text": "i kad svaki zlotvor cveta,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "to je da bi zauvek propali!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "A ti si doveka uzvišen, o, Gospode!",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "O, Gospode, eno tvojih dušmana;",
            "poem": 1
          },
          {
            "text": "eno tvojih dušmana, ginu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i svi što zlobno rade biće oduvani.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ti si moj rog uzdigao kao u bivola,",
            "poem": 1
          },
          {
            "text": "pomazan sam svežim uljem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Očima gledam po zidinama mojim",
            "poem": 1
          },
          {
            "text": "one što se protiv mene dižu;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ušima svojim slušam zlotvore.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Kao palma grana se pravednik,",
            "poem": 1
          },
          {
            "text": "kao kedar raste na Livanu!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Posađeni u Domu Gospodnjem",
            "poem": 1
          },
          {
            "text": "cvetaće u dvorištima Boga našeg.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Biće plodonosni i kada ostare,",
            "poem": 1
          },
          {
            "text": "jedri i zeleni biće;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "i javljaće: pravedan je Gospod, stena moja,",
            "poem": 1
          },
          {
            "text": "nepravde u njemu nema!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
