  "chapter": {
    "number": 121,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Pesma poklonička."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Svoje oči ka gorama dižem.",
            "poem": 1
          },
          {
            "text": "Odakle će meni pomoć doći?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Doći će mi pomoć od Gospoda,",
            "poem": 1
          },
          {
            "text": "Sazdatelja nebesa i zemlje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Nozi tvojoj da posrne ne da,",
            "poem": 1
          },
          {
            "text": "tvoj zaštitnik zadremati neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Gle, ne drema i ne spava",
            "poem": 1
          },
          {
            "text": "zaštitnik Izrailja!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Gospod je zaštitnik tvoj!",
            "poem": 1
          },
          {
            "text": "Gospod ti je senka s tvoje desne strane.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Neće ti škoditi ni sunce po danu",
            "poem": 1
          },
          {
            "text": "ni mesec po noći.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Od svakoga zla Gospod će te zaštititi,",
            "poem": 1
          },
          {
            "text": "zaštitiće dušu tvoju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Gospod će te zaštititi kada budeš odlazio",
            "poem": 1
          },
          {
            "text": "i kad budeš dolazio,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "od sada pa doveka!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
