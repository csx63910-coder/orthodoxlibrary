  "chapter": {
    "number": 56,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Prema napevu: „Nema golubica u daljini.“ Davidova pesma pouzdanja u Boga, kada su ga Filistejci uhvatili u Gatu."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Smiluj mi se, Bože,",
            "poem": 1
          },
          {
            "text": "jer me čovek gazi;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "od jutra do sutra napadač me ugnjetava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Gaze me mrzitelji moji od jutra do sutra;",
            "poem": 1
          },
          {
            "text": "jer mnogo je napadača protiv mene, Uzvišeni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "U dan bojazni ja ću u tebe da se uzdam.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "U Boga, čiju reč ja slavim,",
            "poem": 1
          },
          {
            "text": "u Boga se uzdam;",
            "poem": 2
          },
          {
            "text": "neću da se plašim.",
            "poem": 1
          },
          {
            "text": "Šta mi može puki smrtnik?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Od jutra do sutra reči mi izvrću,",
            "poem": 1
          },
          {
            "text": "pogubno je sve što protiv mene smisle.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Započinju svađe, skrivaju se,",
            "poem": 1
          },
          {
            "text": "na korake mi paze dok mi dušu vrebaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Zar im od krivice ima izbavljenja?",
            "poem": 1
          },
          {
            "text": "U gnevu obori narode, Bože.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Potucanja moja izbroj,",
            "poem": 1
          },
          {
            "text": "u mešinu svoju suze moje stavi;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "nisu li one u knjizi tvojoj?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Onda će moji protivnici da se vrate,",
            "poem": 1
          },
          {
            "text": "ustuknuće kad zazovem;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "znam to, jer je Bog uz mene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "U Boga, čiju reč ja slavim;",
            "poem": 1
          },
          {
            "text": "u Gospoda, čiju reč ja slavim;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "u Boga se uzdam;",
            "poem": 1
          },
          {
            "text": "neću da se plašim.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Šta mi može puki smrtnik?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Na meni su, Bože, zaveti tvoji;",
            "poem": 1
          },
          {
            "text": "prineću ti zahvalnice,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "jer si dušu moju od smrti izbavio,",
            "poem": 1
          },
          {
            "text": "korake moje od spoticanja;",
            "poem": 2
          },
          {
            "text": "da hodam pred Bogom",
            "poem": 1
          },
          {
            "text": "u svetlu života.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
