  "chapter": {
    "number": 34,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Davidov. Kada se David pretvarao da je lud pred Avimelehom. Ovaj ga je, zatim, oterao, pa je David otišao."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Blagosiljaću Gospoda neprestano,",
            "poem": 1
          },
          {
            "text": "stalno će ga usne moje hvaliti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Hvaliće se Gospodom moja duša;",
            "poem": 1
          },
          {
            "text": "neka čuju ponizni, neka se raduju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Veličajte sa mnom Gospoda,",
            "poem": 1
          },
          {
            "text": "zajedno mu uzvisujmo ime.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Tražio sam Gospoda, i on mi odgovori,",
            "poem": 1
          },
          {
            "text": "od svih me je strahova izbavio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Vedri su oni koji gledaju u njega,",
            "poem": 1
          },
          {
            "text": "lice se njihovo neće postideti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Kad je ovaj siromah vapio, Gospod ga je čuo,",
            "poem": 1
          },
          {
            "text": "i od svih ga je nevolja izbavio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Anđeo Gospodnji taborom okružuje",
            "poem": 1
          },
          {
            "text": "one koji ga se boje; izbavlja ih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Iskusite i vidite da je Gospod dobar,",
            "poem": 1
          },
          {
            "text": "blago čoveku što u njemu utočište nađe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Bojte se Gospoda, vi sveti njegovi,",
            "poem": 1
          },
          {
            "text": "jer nema oskudice za one koji ga se boje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "I mladi lavovi trpe i gladuju,",
            "poem": 1
          },
          {
            "text": "ali onima što traže Gospoda,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "njima dobra nikakvog ne manjka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Dođite, o, deco, i čujte me,",
            "poem": 1
          },
          {
            "text": "bogobojaznosti ću vas poučiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Koji čovek voli život?",
            "poem": 1
          },
          {
            "text": "Ko želi da dobre dane vidi?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Nek se tvoj jezik od zla uzdrži,",
            "poem": 1
          },
          {
            "text": "nek ti usne ne govore laži,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "zla se kloni, a dobro čini,",
            "poem": 1
          },
          {
            "text": "traži mir i za njim ti idi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Oči Gospodnje motre na pravedne,",
            "poem": 1
          },
          {
            "text": "i uši njegove vapaj im čuju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Lice se Gospodnje mršti na zlikovce,",
            "poem": 1
          },
          {
            "text": "da sa zemlje pomen im istrebi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Gospod čuje kad pravedni zavape,",
            "poem": 1
          },
          {
            "text": "od svih nevolja on ih izbavlja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Blizu je Gospod onima sa slomljenim srcem,",
            "poem": 1
          },
          {
            "text": "on spasava one sa klonulim duhom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Mnoga zla snalaze pravednika,",
            "poem": 1
          },
          {
            "text": "ali Gospod ga izbavlja od svih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "On čuva sve kosti njegove,",
            "poem": 1
          },
          {
            "text": "nijedna mu se neće polomiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Zlo će ubiti opakoga,",
            "poem": 1
          },
          {
            "text": "a koji mrze pravednika biće okrivljeni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Gospod otkupljuje život svojih slugu;",
            "poem": 1
          },
          {
            "text": "neće biti kriv niko ko u njemu utočište nađe.",
            "poem": 2
          }
        ]
      }
    ],
