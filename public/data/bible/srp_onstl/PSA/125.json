  "chapter": {
    "number": 125,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Pesma poklonička."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Oni što se u Gospoda uzdaju,",
            "poem": 1
          },
          {
            "text": "jesu kao gora Sion – postojana,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "doveka se pomaknuti ne da!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Poput gora što Jerusalim okružuju,",
            "poem": 1
          },
          {
            "text": "tako je i Gospod oko svog naroda,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "sve od sada pa za večnost celu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Uistinu, neće žezlo zločinaca vladati",
            "poem": 1
          },
          {
            "text": "nad zemljom što pripada pravednima;",
            "poem": 2
          },
          {
            "text": "da pravedni ruke svoje ne bi",
            "poem": 1
          },
          {
            "text": "nepravdi pružali.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "O, Gospode, dobro čini dobrima",
            "poem": 1
          },
          {
            "text": "i onima čestitoga srca!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "A one što na svoje krive staze skreću,",
            "poem": 1
          },
          {
            "text": "Gospod će odagnati sa zlotvorima.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Mir Izrailju!",
            "poem": 1
          }
        ]
      }
    ],
