  "chapter": {
    "number": 38,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Psalam Davidov. Za sećanje."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ne karaj me u gnevu svom, Gospode,",
            "poem": 1
          },
          {
            "text": "ne kažnjavaj u jarosti svojoj,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "jer tvoje su se strele zabole u mene,",
            "poem": 1
          },
          {
            "text": "i tvoja me je ruka pritisnula.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Na mom telu zdravog mesta nema od tvoje srdžbe,",
            "poem": 1
          },
          {
            "text": "radi mog greha kosti mi nemaju počinka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Jer moje me nepravde preplaviše,",
            "poem": 1
          },
          {
            "text": "navališe se na mene kao teret preteški.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Moje rane smrde, gnoje se",
            "poem": 1
          },
          {
            "text": "zbog moje ludosti,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "pognuo sam se, sasvim se zgurio,",
            "poem": 1
          },
          {
            "text": "pa povazdan hodam u žalosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Jer bedra su moja puna bola ljutog,",
            "poem": 1
          },
          {
            "text": "na telu mi zdravog mesta nema.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Potpuno sam ukočen i slomljen,",
            "poem": 1
          },
          {
            "text": "urlam jer mi srce stenje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "O, Gospode, znana ti je svaka želja moja,",
            "poem": 1
          },
          {
            "text": "uzdisanje moje nije ti skriveno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Srce moje silno udara,",
            "poem": 1
          },
          {
            "text": "snaga me moja napušta,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "nema više svetla u mojim očima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Prijatelji i bližnji moji",
            "poem": 1
          },
          {
            "text": "odstupaju od mene zbog bolesti moje,",
            "poem": 2
          },
          {
            "text": "pa i oni koji su mi rod rođeni,",
            "poem": 1
          },
          {
            "text": "i oni od mene stoje daleko.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Oni što mi o glavi rade,",
            "poem": 1
          },
          {
            "text": "oni meni zamke postavljaju;",
            "poem": 2
          },
          {
            "text": "ti što hoće meni da naude,",
            "poem": 1
          },
          {
            "text": "takvi meni prete uništenjem,",
            "poem": 2
          },
          {
            "text": "pa povazdan smišljaju podlosti.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "A ja sam kao gluv i ne čujem ništa,",
            "poem": 1
          },
          {
            "text": "kao nem sam koji ne otvara usta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Postao sam kao čovek koji ne čuje,",
            "poem": 1
          },
          {
            "text": "i kao onaj čija usta nemaju odgovor.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Jer na tebe ja čekam, Gospode,",
            "poem": 1
          },
          {
            "text": "ti odgovori, Gospode, moj Bože.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ja rekoh: „Ne daj da se raduju nada mnom,",
            "poem": 1
          },
          {
            "text": "da likuju nada mnom kad mi noga posrne.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Jer moj pad već se primakao,",
            "poem": 1
          },
          {
            "text": "bol moj stalno je preda mnom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ja priznajem svoje bezakonje,",
            "poem": 1
          },
          {
            "text": "zabrinut sam zbog svog greha.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "A dušmani moji puni su života,",
            "poem": 1
          },
          {
            "text": "moćni su i brojni oni što me nepravedno mrze.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Oni koji uzvraćaju zlo za dobro",
            "poem": 1
          },
          {
            "text": "optužuju me što sledim dobro.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Ne ostavljaj me, Gospode,",
            "poem": 1
          },
          {
            "text": "ne udaljuj se od mene, Bože moj!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Požuri mi u pomoć, Gospode, Spasitelju moj!",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
