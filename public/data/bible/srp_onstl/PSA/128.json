  "chapter": {
    "number": 128,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Pesma poklonička."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Blago svakom što se Gospoda boji,",
            "poem": 1
          },
          {
            "text": "onom koji puteve mu sledi!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Zato ćeš jesti plod svojih ruku;",
            "poem": 1
          },
          {
            "text": "blago tebi, dobro nek ti bude!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Žena će ti biti kao loza plodonosna",
            "poem": 1
          },
          {
            "text": "usred kuće tvoje,",
            "poem": 2
          },
          {
            "text": "sinovi ti kao izdanci masline",
            "poem": 1
          },
          {
            "text": "oko tvoga stola!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Gle! Tako će biti blagosloven čovek",
            "poem": 1
          },
          {
            "text": "što se Gospoda boji!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Nek te sa Siona blagoslovi Gospod,",
            "poem": 1
          },
          {
            "text": "pa da svakog dana svog života",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "gledaš blagostanje Jerusalima;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "pa da gledaš decu dece svoje.",
            "poem": 1
          },
          {
            "text": "Mir Izrailju!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
