  "chapter": {
    "number": 81,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Radosnica. Asafova."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Radujte se Bogu, snazi našoj!",
            "poem": 1
          },
          {
            "text": "Kličite Bogu Jakovljevom!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Pesmu zapevajte, daire dajte,",
            "poem": 1
          },
          {
            "text": "liru i harfu umilnu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "O mladini u rog zaduvajte,",
            "poem": 1
          },
          {
            "text": "u dan praznika našeg kada je pun mesec.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Jer takav je propis Izrailju",
            "poem": 1
          },
          {
            "text": "i zapovest Jakovljevog Boga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "On je Josifu dao to svedočanstvo",
            "poem": 1
          },
          {
            "text": "kada je krenuo protiv egipatske zemlje.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Slušao sam jezik neznan što kazuje:",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "„S pleća sam mu uklonio teret",
            "poem": 1
          },
          {
            "text": "i iz ruku uzeo košaru.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Vapio si u nevolji i ja sam te izbavio,",
            "poem": 1
          },
          {
            "text": "odazvao sam ti se iz groma i mraka;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "iskušao na vodama Merive. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Poslušaj me, moj narode, ja te opominjem!",
            "poem": 1
          },
          {
            "text": "O, Izrailju, kada bi me poslušao;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "među vama ne bi bilo drugog boga",
            "poem": 1
          },
          {
            "text": "i ne bi se ti klanjao bogu tuđinskome.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ja sam Gospod, Bog tvoj,",
            "poem": 1
          },
          {
            "text": "koji sam te izveo iz zemlje egipatske.",
            "poem": 2
          },
          {
            "text": "Otvori širom usta svoja",
            "poem": 1
          },
          {
            "text": "i ja ću da ih napunim!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ali moj narod nije poslušao glas moj,",
            "poem": 1
          },
          {
            "text": "Izrailj mi se pokorio nije.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "I ja sam ih prepustio samovolji njihovoga srca,",
            "poem": 1
          },
          {
            "text": "živeli su kako su želeli.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "O, kad bi me poslušao narod moj",
            "poem": 1
          },
          {
            "text": "i puteve moje Izrailj sledio!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ja bih brzo savladao njihove dušmane,",
            "poem": 1
          },
          {
            "text": "na njihove zlotvore bih ruku svoju podigao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Puzali bi pred njim oni što Gospoda mrze",
            "poem": 1
          },
          {
            "text": "i takvo bi stanje za njih trajalo doveka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "A ja bih da ih hranim najboljom pšenicom,",
            "poem": 1
          },
          {
            "text": "iz kamena sitiću ih medom.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
