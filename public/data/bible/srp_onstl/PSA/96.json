  "chapter": {
    "number": 96,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Pevajte Gospodu novu pesmu!",
            "poem": 1
          },
          {
            "text": "Pevaj Gospodu, sva zemljo!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Pevajte Gospodu i ime mu blagosiljajte;",
            "poem": 1
          },
          {
            "text": "dan za danom navešćujte njegovo spasenje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Objavite mu slavu među pucima,",
            "poem": 1
          },
          {
            "text": "njegova čudesa među svim narodima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Jer velik je Gospod, mnoge hvale vredan;",
            "poem": 1
          },
          {
            "text": "strašniji od svih bogova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Jer ništavni su svi bogovi naroda,",
            "poem": 1
          },
          {
            "text": "ali Gospod je sazdao nebesa.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Pred njim su slava i veličanstvo,",
            "poem": 1
          },
          {
            "text": "sila i lepota u njegovom Svetilištu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Dajte Gospodu, plemena narodna,",
            "poem": 1
          },
          {
            "text": "dajte Gospodu slavu i silu,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "dajte Gospodu slavu radi njegovog imena,",
            "poem": 1
          },
          {
            "text": "donesite mu prinos, dođite u njegova dvorišta,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "klanjajte se Gospodu sjajnom u svetosti,",
            "poem": 1
          },
          {
            "text": "drhti pred njim, sva zemljo!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Govorite među narodima: „Gospod vlada!",
            "poem": 1
          },
          {
            "text": "Čvrsto stoji svet, neće se poljuljati.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "On pravedno sudi narodima.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Neka se raduju nebesa, neka se veseli zemlja,",
            "poem": 1
          },
          {
            "text": "Neka huči more i sve što je u njemu,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "nek se raduje polje i sve što je na njemu.",
            "poem": 1
          },
          {
            "text": "Tada će pevati šumsko drveće",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "pred Gospodom, jer on dolazi da sudi zemlji.",
            "poem": 1
          },
          {
            "text": "On će da sudi svetu po pravdi,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "narodima po vernosti svojoj.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
