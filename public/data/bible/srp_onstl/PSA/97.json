  "chapter": {
    "number": 97,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Gospod vlada! Neka se raduje zemlja,",
            "poem": 1
          },
          {
            "text": "neka se raduju ostrva mnoga!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Okružen je oblacima, gustom tamom;",
            "poem": 1
          },
          {
            "text": "na pravednosti i na pravu presto mu počiva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Pred njim oganj suklja,",
            "poem": 1
          },
          {
            "text": "na sve strane pali njegove dušmane.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Njegove munje blešte svetom,",
            "poem": 1
          },
          {
            "text": "a zemlja zadrhti kada to ugleda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Kao vosak tope se planine pred Gospodom,",
            "poem": 1
          },
          {
            "text": "pred Gospodarem zemlje cele.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Pravednost njegovu nebesa javljaju",
            "poem": 1
          },
          {
            "text": "i slavu njegovu svi narodi vide.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Neka se postide sve sluge kipova,",
            "poem": 1
          },
          {
            "text": "svi koji se idolima hvale;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "o, božanstva razna, njemu se klanjajte!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Sion čuje pa se raduje;",
            "poem": 1
          },
          {
            "text": "vesele se Judina naselja",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "zbog sudova tvojih, Gospode.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Jer, Gospode, ti si Svevišnji sve zemlje;",
            "poem": 1
          },
          {
            "text": "neizmerno uzvišen si nad svim božanstvima!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "O, vi što Gospoda volite, zlo zamrzite!",
            "poem": 1
          },
          {
            "text": "On je čuvar duše svojih vernih;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "on otima dušu njinu iz zlikovačkih ruku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Po pravedniku rasipa se svetlo",
            "poem": 1
          },
          {
            "text": "i veselje u srca čestitih!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Pravednici, radujte se u Gospodu!",
            "poem": 1
          },
          {
            "text": "Zahvaljujte mu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "svetost njegovu spominjite!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
