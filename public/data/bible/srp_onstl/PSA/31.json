  "chapter": {
    "number": 31,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Za horovođu. Psalam Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "U tebi je utočište moje, Gospode;",
            "poem": 1
          },
          {
            "text": "o, da se nikad ne postidim;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "izbavi me po svojoj pravednosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Prigni uho svoje k meni,",
            "poem": 1
          },
          {
            "text": "brzo me izbavi,",
            "poem": 2
          },
          {
            "text": "budi mi stena, utočište,",
            "poem": 1
          },
          {
            "text": "jaka tvrđava za moje spasenje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ti si moja stena i tvrđava,",
            "poem": 1
          },
          {
            "text": "radi svog imena vodi me, usmeravaj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Izvuci me iz mreže koju mi postaviše,",
            "poem": 1
          },
          {
            "text": "jer ti si moja tvrđava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "U tvoje ruke predajem svoj duh,",
            "poem": 1
          },
          {
            "text": "otkupi me, Gospode, verni Bože.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Mrzim služitelje bezvrednih idola;",
            "poem": 1
          },
          {
            "text": "pouzdajem se jedino u Gospoda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Klicaću i radovaću se po tvojoj milosti,",
            "poem": 1
          },
          {
            "text": "jer ti si video moju muku;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ti si znao teskobu moje duše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Nisi me dao u ruke dušmaninu,",
            "poem": 1
          },
          {
            "text": "nego si mi noge postavio na prostrano mesto.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Smiluj mi se, Gospode, jer sam u nevolji,",
            "poem": 1
          },
          {
            "text": "moje oko od žalosti kopni,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "vene moja duša i nutrina.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Život mi se troši u žalosti,",
            "poem": 1
          },
          {
            "text": "u jecanju odmiču godine,",
            "poem": 2
          },
          {
            "text": "snaga me izdaje zbog moje nepravde,",
            "poem": 1
          },
          {
            "text": "i kosti se moje raspadaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Poruga postadoh zbog svih svojih dušmana:",
            "poem": 1
          },
          {
            "text": "susedima teret, a znancima strašilo;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "beže od mene kad me vide na ulici.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Padoh u zaborav, kao da sam umro,",
            "poem": 1
          },
          {
            "text": "postao sam kao razbijeni sud.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Jer ja čujem klevete mnogih,",
            "poem": 1
          },
          {
            "text": "užas me je opkolio odasvud.",
            "poem": 2
          },
          {
            "text": "A oni se udružuju protiv mene,",
            "poem": 1
          },
          {
            "text": "kuju zaveru da mi život uzmu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ali ja se u tebe uzdam, Gospode,",
            "poem": 1
          },
          {
            "text": "i kažem: „Ti si Bog moj.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Vreme je moje u ruci tvojoj;",
            "poem": 1
          },
          {
            "text": "izbavi me iz ruku dušmana,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i od onih koji me progone.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Neka lice tvoje obasja slugu tvoga,",
            "poem": 1
          },
          {
            "text": "milošću me svojom izbavi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ne daj da se postidim, Gospode,",
            "poem": 1
          },
          {
            "text": "jer tebi zavapih;",
            "poem": 2
          },
          {
            "text": "neka se opaki postide,",
            "poem": 1
          },
          {
            "text": "u Svetu mrtvih nek umuknu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Neka umuknu usta lažljiva,",
            "poem": 1
          },
          {
            "text": "koja protiv pravednika govore",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "obesno, oholo i prezrivo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Kako je obilna dobrota tvoja,",
            "poem": 1
          },
          {
            "text": "koju čuvaš za one koji te se boje;",
            "poem": 2
          },
          {
            "text": "iskazuješ je pred potomcima ljudi,",
            "poem": 1
          },
          {
            "text": "onima što u tebi utočište nađu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Ti ih skrivaš u zaklonu svog lica,",
            "poem": 1
          },
          {
            "text": "od zavera koje ljudi kuju,",
            "poem": 2
          },
          {
            "text": "zaklanjaš ih pod svoju senicu,",
            "poem": 1
          },
          {
            "text": "od jezika koji optužuju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Blagosloven bio Gospod,",
            "poem": 1
          },
          {
            "text": "jer mi iskaza divnu milost svoju,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kad sam bio u gradu pod opsadom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Tada rekoh uznemiren:",
            "poem": 1
          },
          {
            "text": "„Odbačen sam od tvog pogleda.“",
            "poem": 2
          },
          {
            "text": "Ali ti si čuo glas moga preklinjanja,",
            "poem": 1
          },
          {
            "text": "kada sam zavapio k tebi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Volite Gospoda, svi verni njegovi,",
            "poem": 1
          },
          {
            "text": "Gospod čuva one koji veruju,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a oholima plaća punom merom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Budite jaki i hrabra srca,",
            "poem": 1
          },
          {
            "text": "svi vi što se nadate Gospodu!",
            "poem": 2
          }
        ]
      }
    ],
