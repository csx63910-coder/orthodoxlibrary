  },
  "chapter": {
    "number": 115,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Nemoj nama, o, Gospode, nemoj nama,",
            "poem": 1
          },
          {
            "text": "već imenu svome slavu podaj,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "zbog milosti svoje i istine svoje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Zašto narodi da govore:",
            "poem": 1
          },
          {
            "text": "„Taj Bog njihov, gde je?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "A Bog naš je na nebesima",
            "poem": 1
          },
          {
            "text": "i on čini sve što mu se prohte!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Srebro su i zlato njihovi idoli,",
            "poem": 1
          },
          {
            "text": "ljudskih ruku delo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Sa ustima – a nemi,",
            "poem": 1
          },
          {
            "text": "sa očima – a slepi;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "sa ušima – a gluvi",
            "poem": 1
          },
          {
            "text": "i sa nosem koji ne miriše;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "sa rukama koje ne pipaju,",
            "poem": 1
          },
          {
            "text": "sa nogama koje se ne kreću",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i sa grlom što ni glas da pusti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Takvi će da budu ti što su ih načinili,",
            "poem": 1
          },
          {
            "text": "svi koji se u njih pouzdaju!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Izrailju, u Gospoda se uzdaj!",
            "poem": 1
          },
          {
            "text": "On im je pomoćnik, on im je štit!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Dome Aronov, u Gospoda se uzdaj!",
            "poem": 1
          },
          {
            "text": "On im je pomoćnik, on im je zaštitnik!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Vi što strepite od Gospoda,",
            "poem": 1
          },
          {
            "text": "u Gospoda se uzdajte!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "On im je pomoćnik, on im je zaštitnik!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Setio se i nas Gospod!",
            "poem": 1
          },
          {
            "text": "Nek nas blagoslovi,",
            "poem": 2
          },
          {
            "text": "neka blagoslovi dom Izrailjev;",
            "poem": 1
          },
          {
            "text": "neka blagoslovi dom Aronov!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Blagosloviće one što strepe od Gospoda,",
            "poem": 1
          },
          {
            "text": "kako male tako i velike.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Umnožio vas Gospod,",
            "poem": 1
          },
          {
            "text": "i vas i decu vašu!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Blagoslovio vas Gospod,",
            "poem": 1
          },
          {
            "text": "Sazdatelj nebesa i zemlje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Nebesa su Gospodnja nebesa,",
            "poem": 1
          },
          {
            "text": "a zemlju je dao potomcima ljudi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Preminuli ne slave Gospoda,",
            "poem": 1
          },
          {
            "text": "ni svi što u pokoj idu;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "a mi Gospoda slavimo",
            "poem": 1
          },
          {
            "text": "sada i doveka!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Slavite Gospoda!",
            "poem": 1
          }
        ]
      }
    ],
