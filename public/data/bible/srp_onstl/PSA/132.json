  "chapter": {
    "number": 132,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Pesma poklonička."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "O, Gospode, Davida se seti",
            "poem": 1
          },
          {
            "text": "i svih muka njegovih;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "kako se Gospodu zakleo",
            "poem": 1
          },
          {
            "text": "i zavetovao Silnom Jakovljevom:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "„U šator doma svoga neću ući,",
            "poem": 1
          },
          {
            "text": "na postelju kreveta svog neću leći;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "očima sna neću dati,",
            "poem": 1
          },
          {
            "text": "ni kapcima da se spuste;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "dok ne nađem mesto za Gospoda,",
            "poem": 1
          },
          {
            "text": "Prebivalište Silnom Jakovljevom!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Gle! Mi smo za to u Efrati čuli,",
            "poem": 1
          },
          {
            "text": "u poljima jarimskim našli smo ga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Pođimo u Prebivalište njegovo!",
            "poem": 1
          },
          {
            "text": "Poklonimo se kod podnožja njegovih nogu!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Uzdigni se, o, Gospode, na mesto svog počinka;",
            "poem": 1
          },
          {
            "text": "ti i Kovčeg Sile tvoje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Sveštenici nek ogrnu pravdu,",
            "poem": 1
          },
          {
            "text": "tvoji verni nek radosno kliču.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Zbog Davida, sluge svoga,",
            "poem": 1
          },
          {
            "text": "ne okreći se od lica svog pomazanika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Davidu se istinski zakleo Gospod",
            "poem": 1
          },
          {
            "text": "i poreći neće:",
            "poem": 2
          },
          {
            "text": "„Jednog od tvojih potomaka",
            "poem": 1
          },
          {
            "text": "postaviću na tvoj presto.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ako sinovi tvoji budu držali moj savez",
            "poem": 1
          },
          {
            "text": "i propise moje, što ću ih učiti,",
            "poem": 2
          },
          {
            "text": "i sinovi će njihovi doveka sedeti",
            "poem": 1
          },
          {
            "text": "na prestolu tvome.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Da, Gospod je Sion izabrao,",
            "poem": 1
          },
          {
            "text": "za Prebivalište svoje poželeo ga je:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "„Doveka je ovo mesto mog počinka,",
            "poem": 1
          },
          {
            "text": "tu ću da boravim jer sam tako poželeo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Šta mu treba, daću izobilno;",
            "poem": 1
          },
          {
            "text": "uboge mu nahraniću hlebom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "U spasenje ću mu obući sveštenike,",
            "poem": 1
          },
          {
            "text": "verni će mu podcikivati, klicati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Daću da Davidu rog moći uzraste,",
            "poem": 1
          },
          {
            "text": "svetiljku ću da postavim za svog pomazanika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "U sramotu ja zaviću dušmane njegove,",
            "poem": 1
          },
          {
            "text": "a na njemu njegova će kruna da zablista!“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
