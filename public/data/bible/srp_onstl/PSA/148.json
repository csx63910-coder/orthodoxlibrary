  "chapter": {
    "number": 148,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Slavite Gospoda!",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Slavite Gospoda sa nebesa,",
            "poem": 1
          },
          {
            "text": "slavite ga na visinama!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "O, anđeli svi njegovi, slavite ga,",
            "poem": 1
          },
          {
            "text": "slavite ga, sve vojske njegove!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Slavite ga, sunce i meseče,",
            "poem": 1
          },
          {
            "text": "slavite ga, sve blistave zvezde!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Slavite ga, nebesa najviša,",
            "poem": 1
          },
          {
            "text": "i vi, vode vrh nebesa!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Nek Gospodnje ime slave,",
            "poem": 1
          },
          {
            "text": "jer on zapovedi i oni postaše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Za svu večnost njih je postavio,",
            "poem": 1
          },
          {
            "text": "uredbu je dao koja proći neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Vi sa zemlje slavite Gospoda –",
            "poem": 1
          },
          {
            "text": "nemani morske i dubino svaka;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "grome i grade, sneže i maglo,",
            "poem": 1
          },
          {
            "text": "olujo što reč njegovu ostvaruješ;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "gore i sva brda, svako stablo rodno",
            "poem": 1
          },
          {
            "text": "i svi kedrovi;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "zveri i sva stoko,",
            "poem": 1
          },
          {
            "text": "gmizavci i ptice krilate;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "zemaljski carevi i svi ljudi,",
            "poem": 1
          },
          {
            "text": "glavari i vladari zemlje;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "mladići, a i devojke;",
            "poem": 1
          },
          {
            "text": "stari sa mladima!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Nek Gospodnje ime slave,",
            "poem": 1
          },
          {
            "text": "jer samo je njegovo ime uzvišeno;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "veličanstvo mu je i nad zemljom i nad nebesima!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Svom narodu on će rog uzdići –",
            "poem": 1
          },
          {
            "text": "slavu svakog koji mu je veran –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "narodu izrailjskom, narodu njemu bliskom.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Slavite Gospoda!",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
