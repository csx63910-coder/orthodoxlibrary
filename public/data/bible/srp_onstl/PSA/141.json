  "chapter": {
    "number": 141,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Psalam Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "O, Gospode, tebi vapim: brzo meni dođi,",
            "poem": 1
          },
          {
            "text": "glas mi počuj kada te dozivam!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Molitva moja nek pred tobom kao tamjan bude,",
            "poem": 1
          },
          {
            "text": "moje ruke podignute ko večernji prinos.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "O, Gospode, pred usta mi stražu stavi,",
            "poem": 1
          },
          {
            "text": "čuvaj vrata usana mojih!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Mome srcu ne daj zloj reči da skrene,",
            "poem": 1
          },
          {
            "text": "da se predam zlobi sa zlobnim ljudima;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ne daj da se sladim slastima njihovim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Nek pravednik milošću udara me;",
            "poem": 1
          },
          {
            "text": "nek me kori, nek mi glava ne odbije ulje odabrano;",
            "poem": 2
          },
          {
            "text": "još uvek se molim",
            "poem": 1
          },
          {
            "text": "protiv zlih dela zlotvora.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Niz liticu baciše ih njihove sudije",
            "poem": 1
          },
          {
            "text": "što su čule reči moje,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer su milozvučne.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ko kad neko ore i po zemlji rije,",
            "poem": 1
          },
          {
            "text": "rasute su kosti naše sve do ždrela Sveta mrtvih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "A ja tebi, o, Gospode Bože,",
            "poem": 1
          },
          {
            "text": "oči svoje dižem;",
            "poem": 2
          },
          {
            "text": "ti si moje utočište,",
            "poem": 1
          },
          {
            "text": "dušu moju ne satiri!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Čuvaj me, da me ne zgrabi zamka",
            "poem": 1
          },
          {
            "text": "što su mi je postavili",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i klopke zločinaca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "U mreže svoje nek padnu zlobnici,",
            "poem": 1
          },
          {
            "text": "a ja nek ih prođem!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
