    "name": "Psalam",
    "commonName": "Psalam",
    "title": "Psalmi",
    "order": 19,
    "numberOfChapters": 150,
    "sha256": "c6f7504dab6884191b78dc06d3be4895eca6e432bb5bba347779cdd7d9f9c58d",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/PSA/1.json",
    "lastChapterNumber": 150,
    "lastChapterApiLink": "/api/srp_onstl/PSA/150.json",
    "totalNumberOfVerses": 2461
  },
  "chapter": {
    "number": 107,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Hvalite Gospoda jer je dobar,",
            "poem": 1
          },
          {
            "text": "jer je milost njegova doveka!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Nek govore tako oni što ih je Gospod otkupio,",
            "poem": 1
          },
          {
            "text": "oni otkupljeni iz ruke dušmana;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "koje je okupio iz zemalja istoka i zapada,",
            "poem": 1
          },
          {
            "text": "sa severa i s mora.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Tek, tumarali su po pustinji,",
            "poem": 1
          },
          {
            "text": "po bespuću i nisu našli mesto da se skrase.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "A bili su i gladni i žedni,",
            "poem": 1
          },
          {
            "text": "dušu svoju da ispuste.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Gospodu su zavapili u čemeru svome",
            "poem": 1
          },
          {
            "text": "i on ih je izbavio od njihovih muka!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ravnim putem ih je poveo",
            "poem": 1
          },
          {
            "text": "da se skrase, da se skuće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Nek Gospoda oni hvale za njegovu milost,",
            "poem": 1
          },
          {
            "text": "za čudesa nad potomcima ljudi!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Jer on poji grlo žednom,",
            "poem": 1
          },
          {
            "text": "dobrim siti dušu gladnom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Čame u mraku, u tami;",
            "poem": 1
          },
          {
            "text": "okovani i bedom i gvožđem;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "jer Božijim rečima prkose,",
            "poem": 1
          },
          {
            "text": "prezreli su savet Svevišnjega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "A on im je patnjom srca ponizio;",
            "poem": 1
          },
          {
            "text": "srljali su, a pomoći niotkuda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Gospodu su zavapili u čemeru svome",
            "poem": 1
          },
          {
            "text": "i on ih je spasao od njihovih muka!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Izveo ih je iz mraka, iz tame,",
            "poem": 1
          },
          {
            "text": "okove im polomio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Nek Gospoda oni hvale za njegovu milost,",
            "poem": 1
          },
          {
            "text": "za čudesa nad potomcima ljudi!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Jer je on razbio bronzana vrata,",
            "poem": 1
          },
          {
            "text": "izlomio gvozdene vratnice.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Pobudališe zbog svojih prestupničkih puteva,",
            "poem": 1
          },
          {
            "text": "mučiše se zbog svojih krivica.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Duši im se sva hrana zgadila",
            "poem": 1
          },
          {
            "text": "i do samih vrata smrti su pristigli.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Gospodu su zavapili u čemeru svome",
            "poem": 1
          },
          {
            "text": "i on ih je spasao od njihovih muka!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Reč svoju im je poslao, pa su ozdravili;",
            "poem": 1
          },
          {
            "text": "iz raka njihovih ih je izvukao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Nek Gospoda oni hvale za njegovu milost,",
            "poem": 1
          },
          {
            "text": "za čudesa nad potomcima ljudi!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Nek žrtvuju žrtve zahvalnice;",
            "poem": 1
          },
          {
            "text": "nek mu dela objavljuju, neka kliču!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Oni što su morem brodovima plovili,",
            "poem": 1
          },
          {
            "text": "što su trgovali na velikim vodama;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "oni su videli dela Gospodnja,",
            "poem": 1
          },
          {
            "text": "njegova čudesa u dubini;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "kada je zapovedio, vetru naredio",
            "poem": 1
          },
          {
            "text": "da talase mora oluja podigne.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "I oni se dižu do nebesa,",
            "poem": 1
          },
          {
            "text": "lome se do dubina,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pa im se duša topi od zebnje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Ljuljaju se, teturaju ko pijani,",
            "poem": 1
          },
          {
            "text": "nestaje im sva veština.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Gospodu su zavapili u čemeru svome",
            "poem": 1
          },
          {
            "text": "i on ih je izveo iz njihovih muka!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Oluju je umirio",
            "poem": 1
          },
          {
            "text": "i talasi mora utihnuše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "A kada se stišaju, pomorci se raduju;",
            "poem": 1
          },
          {
            "text": "on ih vodi do željene luke.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Nek Gospoda oni hvale za njegovu milost,",
            "poem": 1
          },
          {
            "text": "za čudesa nad potomcima ljudi!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Neka ga uzdižu na narodnom saboru",
            "poem": 1
          },
          {
            "text": "i neka ga slave u starešinskom zboru!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "On pretvara reke u pustinju,",
            "poem": 1
          },
          {
            "text": "vrela vode u tlo sparušeno;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "plodnu zemlju u slatinu",
            "poem": 1
          },
          {
            "text": "zbog zla onih koji na njoj žive.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Od pustinje on jezero čini,",
            "poem": 1
          },
          {
            "text": "od zemlje puste vodene izvore.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Tu je gladne naselio",
            "poem": 1
          },
          {
            "text": "i oni su grad podigli;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "polja su zasejali, vinograde posadili",
            "poem": 1
          },
          {
            "text": "i oni obilje plodova rađaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "I on ih je blagoslovio",
            "poem": 1
          },
          {
            "text": "pa su se veoma umnožili;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ni stoka im se proredila nije.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          {
            "text": "Ali zbog tlačenja, nevolje i jada",
            "poem": 1
          },
          {
            "text": "oni se prorediše, poguriše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          {
            "text": "On izliva prezir na plemiće,",
            "poem": 1
          },
          {
            "text": "pušta da tumaraju pustarom besputnom;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          {
            "text": "dok ubogog uzdiže, od nevolje sklanja,",
            "poem": 1
          },
          {
            "text": "poput stada njegov porod množi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          {
            "text": "Vide to pravedni pa se raduju,",
            "poem": 1
          },
          {
            "text": "a svi nepravedni zatvaraju svoja usta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          {
            "text": "Ko je mudar? Taj nek ovo pamti,",
            "poem": 1
          },
          {
            "text": "u Gospodnju milost nek proniče!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
