  "chapter": {
    "number": 149,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Slavite Gospoda!",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Novu pesmu zapevajte Gospodu",
            "poem": 1
          },
          {
            "text": "i njegove hvalospeve u zboru vernika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Nek Izrailj raduje se svome Stvoritelju!",
            "poem": 1
          },
          {
            "text": "Neka kliče svome Caru narod sa Siona!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Nek mu ime slave igrajući kolo,",
            "poem": 1
          },
          {
            "text": "nek mu zasviraju na bubnju i liri.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Jer Gospodu je njegov narod mio,",
            "poem": 1
          },
          {
            "text": "on ponizne ovenčava spasenjem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Neka narod verni likuje u časti!",
            "poem": 1
          },
          {
            "text": "Neka kliču sa ležaja svojih!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "U grlima nek im budu hvalospevi Božiji,",
            "poem": 1
          },
          {
            "text": "u rukama im mač s obe strane oštar;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "da se osvete narodima",
            "poem": 1
          },
          {
            "text": "i donesu kaznu tuđincima;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "da lancima careve im svežu",
            "poem": 1
          },
          {
            "text": "i okuju gvožđem njihove plemiće;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "da na njima izvrše zapisanu presudu,",
            "poem": 1
          },
          {
            "text": "što je na čast svih njegovih vernih.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Slavite Gospoda!",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
