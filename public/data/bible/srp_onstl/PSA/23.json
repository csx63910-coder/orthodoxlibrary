  "chapter": {
    "number": 23,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Psalam Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Gospod je meni Pastir,",
            "poem": 1
          },
          {
            "text": "ni u čemu ja ne oskudevam.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Na zelenoj paši odmara me,",
            "poem": 1
          },
          {
            "text": "vodi me na vode počinka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Dušu moju oporavlja,",
            "poem": 1
          },
          {
            "text": "vodi me stazama pravednosti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "radi svog imena.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Pa da i dolinom smrtne sene hodam,",
            "poem": 1
          },
          {
            "text": "neću se bojati zla, jer si ti sa mnom;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "štap tvoj i palica tvoja daju mi utehu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ti prostireš sto preda mnom",
            "poem": 1
          },
          {
            "text": "u prisustvu mojih dušmana,",
            "poem": 2
          },
          {
            "text": "namazao si uljem glavu moju,",
            "poem": 1
          },
          {
            "text": "i čaša se moja preliva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Da, dobrota i milost tvoja",
            "poem": 1
          },
          {
            "text": "pratiće me u sve dane života moga",
            "poem": 2
          },
          {
            "text": "i ja ću stanovati u Domu Gospodnjem",
            "poem": 1
          },
          {
            "text": "u danima mnogim.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
