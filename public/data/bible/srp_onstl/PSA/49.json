    "name": "Psalam",
    "commonName": "Psalam",
    "title": "Psalmi",
    "order": 19,
    "numberOfChapters": 150,
    "sha256": "c6f7504dab6884191b78dc06d3be4895eca6e432bb5bba347779cdd7d9f9c58d",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/PSA/1.json",
    "lastChapterNumber": 150,
    "lastChapterApiLink": "/api/srp_onstl/PSA/150.json",
    "totalNumberOfVerses": 2461
  },
  "chapter": {
    "number": 49,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Horovođi. Potomaka Korejevih. Psalam."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Čujte ovo, o, svi narodi;",
            "poem": 1
          },
          {
            "text": "poslušajte, svi žitelji sveta;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "potomci ljudi, potomci čovekovi; bogati i siromasi.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Moja će usta objaviti mudrost",
            "poem": 1
          },
          {
            "text": "i razmišljanje srca moga biće razborito.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Uho svoje prikloniću poslovici,",
            "poem": 1
          },
          {
            "text": "zagonetku svoju izložiću uz harfu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Od zlih dana zašto da strahujem,",
            "poem": 1
          },
          {
            "text": "kad krivica zlikovačka opkoli me;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "baš onih što se u imanje svoje uzdaju,",
            "poem": 1
          },
          {
            "text": "i obiljem se svog bogatstva hvale?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ne može čovek brata svog da otkupi,",
            "poem": 1
          },
          {
            "text": "ne može za njega Bogu naknadu da plati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Elem, visok je otkup za njegov život;",
            "poem": 1
          },
          {
            "text": "doveka je neizmiriv",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "da bi doveka živeo",
            "poem": 1
          },
          {
            "text": "i groba ne bi video.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Jer čovek vidi da mudar umire;",
            "poem": 1
          },
          {
            "text": "da i bezumnik i onaj bez pameti propadaju,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da drugima imanja svoja ostavljaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "U sebi misle da im domovi doveka ostaju,",
            "poem": 1
          },
          {
            "text": "i njihova mesta od pokolenja do pokolenja;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "imenom svojim zemlje nazivaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Tek, čovek ni u raskoši ne istrajava,",
            "poem": 1
          },
          {
            "text": "već je poput stoke što ugine.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "To je put njihov – ludilo –",
            "poem": 1
          },
          {
            "text": "ali i onih što nakon njih",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "uživaju u njihovim govorima. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Poput ovaca određeni su za Svet mrtvih,",
            "poem": 1
          },
          {
            "text": "smrt će ih napasati.",
            "poem": 2
          },
          {
            "text": "Pravedni će jutrom vladati nad njima.",
            "poem": 1
          },
          {
            "text": "Lik će im progutati Svet mrtvih,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "daleko od njihovog doma.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Zacelo će Bog dušu moju da otkupi iz ruku Sveta mrtvih,",
            "poem": 1
          },
          {
            "text": "jer on će me prihvatiti. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ne plaši se kad se bilo ko bogati,",
            "poem": 1
          },
          {
            "text": "kada raste slava doma njegovoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Jer kad umre, poneti ništa neće;",
            "poem": 1
          },
          {
            "text": "slava njegova za njim neće sići.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "A on sebe u životu blagosilja –",
            "poem": 1
          },
          {
            "text": "i ljudi te hvale kad si sebi dobro učinio –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "ali će poći pokolenju svojih predaka,",
            "poem": 1
          },
          {
            "text": "gde doveka svetlo videti neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Čovek u raskoši, a bez razuma",
            "poem": 1
          },
          {
            "text": "je poput stoke što ugine.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
