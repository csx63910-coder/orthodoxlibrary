  "chapter": {
    "number": 111,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Slavite Gospoda!",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Hvaliću Gospoda celim srcem svojim,",
            "poem": 1
          },
          {
            "text": "na saboru pravednika i u zajednici!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Velika su dela Gospodnja,",
            "poem": 1
          },
          {
            "text": "željan ih je svako ko uživa u njima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Veličanstveno i slavno delo je njegovo,",
            "poem": 1
          },
          {
            "text": "pravednost njegova trajaće doveka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Čudesa je svoja učinio da se pamte,",
            "poem": 1
          },
          {
            "text": "milosrdan je i milostiv Gospod.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Hranu daje bogobojaznima,",
            "poem": 1
          },
          {
            "text": "svog saveza doveka se seća.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Svom narodu javio je silu dela svojih,",
            "poem": 1
          },
          {
            "text": "dajući im nasledstvo naroda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Verodostojna su i pravedna dela njegovih ruku,",
            "poem": 1
          },
          {
            "text": "svi njegovi propisi su pouzdani;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "postavljeni od veka do veka,",
            "poem": 1
          },
          {
            "text": "učinjeni istinito i pravedno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Za svoj narod otkup je poslao",
            "poem": 1
          },
          {
            "text": "i svoj savez večno postavio;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ime mu je i sveto i strašno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Mudrost otpočinje bogobojaznošću.",
            "poem": 1
          },
          {
            "text": "Baš su razboriti svi koji tako čine",
            "poem": 2
          },
          {
            "noteId": 11
          },
          {
            "lineBreak": true
          },
          {
            "text": "i slava im traje za vek veka.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 11,
        "caller": "+",
        "text": "111,10 Oni koji drže savez i bogobojazni su, prema kontekstu ovog i prethodnog stiha.",
        "reference": {
          "chapter": 111,
          "verse": 10
        }
      }
    ]
  },
