  },
  "chapter": {
    "number": 9,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Za horovođu, po napevu „Smrt sina“. Psalam Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Slaviću Gospoda svim srcem svojim,",
            "poem": 1
          },
          {
            "text": "pričaću o svim tvojim čudesima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Veseliću se, tebi ću klicati,",
            "poem": 1
          },
          {
            "text": "tvome ću imenu pevati, Svevišnji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Kad se moji neprijatelji povuku u begu,",
            "poem": 1
          },
          {
            "text": "neka se sapletu i propadnu pred tobom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Jer ti si odbranio moje pravo i sud,",
            "poem": 1
          },
          {
            "text": "seo si na presto da sudiš po pravdi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ukorio si narode, uništio opake,",
            "poem": 1
          },
          {
            "text": "zatro si im ime u veke vekova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Dokrajčen je dušmanin,",
            "poem": 1
          },
          {
            "text": "u ruševinama je doveka,",
            "poem": 2
          },
          {
            "text": "gradove si mu istrebio,",
            "poem": 1
          },
          {
            "text": "spomen na njih izbrisao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ali Gospod stoluje do veka,",
            "poem": 1
          },
          {
            "text": "presto je svoj postavio da sudi,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "i svetu će suditi po pravdi,",
            "poem": 1
          },
          {
            "text": "jednako će suditi narodima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Gospod je zaklon ugnjetenom,",
            "poem": 1
          },
          {
            "text": "zaklon u vreme nevolje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Neka se uzdaju u tebe oni koji tvoje ime znaju,",
            "poem": 1
          },
          {
            "text": "jer ti, Gospode, ne ostavljaš one što te traže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Pevajte Gospodu, koji stoluje na Sionu!",
            "poem": 1
          },
          {
            "text": "Pričajte narodima o delima njegovim!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Jer onaj što se sveti za prolivenu krv,",
            "poem": 1
          },
          {
            "text": "on pamti, ne zaboravlja vapaj poniznih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Smiluj mi se, o, Gospode,",
            "poem": 1
          },
          {
            "text": "vidi kako me kinje mrzitelji moji",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "– ti što me izvlačiš iz vrata smrti –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "da bih naveštao sva slavna dela tvoja",
            "poem": 1
          },
          {
            "text": "na dverima ćerke sionske,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i tamo se radovao tvojemu spasenju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Narodi jamu iskopaše, alʼ u nju sami upadoše,",
            "poem": 1
          },
          {
            "text": "noga im se uhvati u mrežu koju sakriše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Gospod je sebe učinio znanim,",
            "poem": 1
          },
          {
            "text": "on postupa po pravu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a opaki se hvata u zamku svoje ruke. Misli. Sela",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Neka se opaki vrate u Svet mrtvih,",
            "poem": 1
          },
          {
            "text": "svi narodi koji Boga zaboravljaju,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "jer ubogi neće uvek biti zaboravljen,",
            "poem": 1
          },
          {
            "text": "niti propasti nada poniznih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ustani, Gospode,",
            "poem": 1
          },
          {
            "text": "neka čovek ne nadvlada,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "neka se sudi narodima pred tobom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Uteraj im strah u kosti, Gospode,",
            "poem": 1
          },
          {
            "text": "neka znaju puci da su samo ljudi. Sela",
            "poem": 2
          }
        ]
      }
    ],
