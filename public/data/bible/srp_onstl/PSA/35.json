  "chapter": {
    "number": 35,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Davidov."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Osudi, Gospode, moje tužioce,",
            "poem": 1
          },
          {
            "text": "i vojuj protiv mojih napadača.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Uzmi oružje i štit,",
            "poem": 1
          },
          {
            "text": "ustani, pomozi mi!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Potegni koplje dugo i kratko,",
            "poem": 1
          },
          {
            "text": "protiv onih koji me progone.",
            "poem": 2
          },
          {
            "text": "Reci mojoj duši:",
            "poem": 1
          },
          {
            "text": "„Ja sam ti spasenje!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Nek se postide i osramote",
            "poem": 1
          },
          {
            "text": "oni koji mi o glavi rade,",
            "poem": 2
          },
          {
            "text": "nek se povuku u sramoti",
            "poem": 1
          },
          {
            "text": "oni što mi zlo smišljaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Nek budu kao pleva na vetru,",
            "poem": 1
          },
          {
            "text": "tako nek ih Anđeo Gospodnji goni,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "nek je taman i klizav put njihov,",
            "poem": 1
          },
          {
            "text": "kad ih goni Anđeo Gospodnji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Bez povoda mi razapeše mrežu,",
            "poem": 1
          },
          {
            "text": "bez razloga mi iskopaše jamu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Nek ih snađe propast iznenada,",
            "poem": 1
          },
          {
            "text": "nek se uhvate u mrežu koju su sakrili,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "nek u nju padnu na svoju propast.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "A moja će se duša radovati u Gospodu,",
            "poem": 1
          },
          {
            "text": "veseliće se u njegovom spasenju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Sve će moje kosti govoriti:",
            "poem": 1
          },
          {
            "text": "„Ko je kao ti, o, Gospode?",
            "poem": 2
          },
          {
            "text": "Ti izbavljaš siromaha od moćnijeg od njega,",
            "poem": 1
          },
          {
            "text": "siromaha i ubogoga od onoga što ga pljačka.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Istupaju okrutni svedoci,",
            "poem": 1
          },
          {
            "text": "pitaju me za ono što ne znam.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Za dobro mi zlom plaćaju,",
            "poem": 1
          },
          {
            "text": "dušu moju u bedu guraju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "A kad su oni bili u bolesti,",
            "poem": 1
          },
          {
            "text": "u kostret sam se zbog njih oblačio,",
            "poem": 2
          },
          {
            "text": "dušu svoju postom sam mučio,",
            "poem": 1
          },
          {
            "text": "a molitva mi se u krilo vraćala.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Kao za drugom ili bratom,",
            "poem": 1
          },
          {
            "text": "šetao sam gore-dole;",
            "poem": 2
          },
          {
            "text": "kao kad se žali za majkom,",
            "poem": 1
          },
          {
            "text": "tako sam se u žalosti svio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "A kad ja posrnem, oni se raduju,",
            "poem": 1
          },
          {
            "text": "skupljaju se protiv mene bednici,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "oni koje ne znam razdiru me neprestano.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Kao bezbožni zlobno se rugaju,",
            "poem": 1
          },
          {
            "text": "i zubima svojim škrguću na mene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Dokle ćeš to gledati, Gospode?",
            "poem": 1
          },
          {
            "text": "Spasi me od njihovih napada,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i moj život od mladih lavova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Hvaliću te u velikom zboru,",
            "poem": 1
          },
          {
            "text": "slaviću te među mnogim narodom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ne daj da se vesele nada mnom",
            "poem": 1
          },
          {
            "text": "podmukli moji dušmani,",
            "poem": 2
          },
          {
            "text": "da ne namiguju očima",
            "poem": 1
          },
          {
            "text": "oni što me bez razloga mrze.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Oni ne govore o miru,",
            "poem": 1
          },
          {
            "text": "već smišljaju prevare",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "protiv mirnih u zemlji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Usta svoja razjapljuju na mene,",
            "poem": 1
          },
          {
            "text": "i govore: „Evo! Evo! Svojim smo to očima videli!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Ti vidiš to, Gospode, ne ćuti!",
            "poem": 1
          },
          {
            "text": "Ne udaljuj se, Gospode, od mene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Probudi se, ustani, radi moga prava,",
            "poem": 1
          },
          {
            "text": "moj spor odbrani, Bože moj, Gospode.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Opravdaj me, Gospode, moj Bože, po pravednosti svojoj,",
            "poem": 1
          },
          {
            "text": "ne daj da se oni raduju nada mnom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Ne daj da u srcu oni kažu: „Eto, to smo hteli!“",
            "poem": 1
          },
          {
            "text": "Da ne kažu: „Progutali smo ga!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Nek se postide i osramote",
            "poem": 1
          },
          {
            "text": "oni što se nevolji mojoj raduju;",
            "poem": 2
          },
          {
            "text": "nek stid i sram pokrije one,",
            "poem": 1
          },
          {
            "text": "koji sebe uzdižu nada mnom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Neka kliču i raduju se oni,",
            "poem": 1
          },
          {
            "text": "kojima je milo moje opravdanje;",
            "poem": 2
          },
          {
            "text": "neka oni govore stalno:",
            "poem": 1
          },
          {
            "text": "„Velik je Gospod!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Mio mu je napredak sluge njegovog.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Jezik će mi pričati o pravednosti tvojoj,",
            "poem": 1
          },
          {
            "text": "povazdan ću proslavljati tebe.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
