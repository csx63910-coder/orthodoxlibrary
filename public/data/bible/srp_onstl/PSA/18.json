  "chapter": {
    "number": 18,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "David je ispevao Gospodu reči ove pesme onoga dana kada ga je Gospod izbavio iz ruku svih njegovih neprijatelja i iz Saulove ruke. Rekao je:"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Volim te, Gospode, moja snago.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Gospode, steno moja,",
            "poem": 1
          },
          {
            "text": "tvrđavo moja, izbavitelju moj.",
            "poem": 2
          },
          {
            "text": "Moj Bog je meni stena,",
            "poem": 1
          },
          {
            "text": "gde zaklon nalazim.",
            "poem": 2
          },
          {
            "text": "Štite moj, rože mog spasenja,",
            "poem": 1
          },
          {
            "text": "zaklone moj, utočište moje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Prizvaću Gospoda slave predostojnog,",
            "poem": 1
          },
          {
            "text": "i on će me spasti od mojih dušmana.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Smrtna su se užad splela oko mene,",
            "poem": 1
          },
          {
            "text": "užasnut sam razornim rekama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Užad su me Sveta mrtvih opkolila,",
            "poem": 1
          },
          {
            "text": "smrt me vreba sa svojim zamkama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "U nevolji zavapih Gospodu,",
            "poem": 1
          },
          {
            "text": "i povikah ka Bogu svojemu.",
            "poem": 2
          },
          {
            "text": "Iz svog hrama glas je moj čuo,",
            "poem": 1
          },
          {
            "text": "moj vapaj stiže do njega,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "do njegovih ušiju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Tad se zemlja uzdrma, zatrese,",
            "poem": 1
          },
          {
            "text": "zadrhtaše temelji planina,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "stresoše se zbog njegovog gneva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Dim se diže njemu iz nozdrva,",
            "poem": 1
          },
          {
            "text": "oganj plamti iz njegovih usta,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "žar ugljeni iz njega izbija.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "On nebesa presavi i siđe,",
            "poem": 1
          },
          {
            "text": "pod nogama gusta mu je tama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Heruvima uzjaha, polete,",
            "poem": 1
          },
          {
            "text": "i zaplovi na krilima vetra.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Od tame načini oko sebe šator,",
            "poem": 1
          },
          {
            "text": "senicu za sebe od tamnih voda",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i od oblaka tamnih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Od sjaja pred njim prođoše oblaci,",
            "poem": 1
          },
          {
            "text": "pljušti grad i ugalj užareni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Tada Gospod zagrme s nebesa,",
            "poem": 1
          },
          {
            "text": "razleže se glas Svevišnjega,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "grad i ugalj užareni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Strele svoje odape i dušmane rasu,",
            "poem": 1
          },
          {
            "text": "bljesnu munjama, u pometnju ih baci.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Kad si Gospode počeo da karaš,",
            "poem": 1
          },
          {
            "text": "kad ti dah iz nozdrva planu,",
            "poem": 2
          },
          {
            "text": "doline se vodne pokazaše,",
            "poem": 1
          },
          {
            "text": "otkriše se temelji sveta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ruku pruži sa visina, dohvati me,",
            "poem": 1
          },
          {
            "text": "iz voda me moćnih izvuče,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "od moćnog me izbavi dušmana,",
            "poem": 1
          },
          {
            "text": "i od onih jačih što me mrze.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Navališe na mene u dan moje muke,",
            "poem": 1
          },
          {
            "text": "ali Gospod mi je bio oslonac.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Izvede me na prostrano mesto,",
            "poem": 1
          },
          {
            "text": "izbavi me jer sam mu po volji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Gospod mi po pravdi mojoj plati,",
            "poem": 1
          },
          {
            "text": "nagradi mi čistoću ruku mojih,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "jer puteve Gospodnje sačuvah;",
            "poem": 1
          },
          {
            "text": "Bogu svome ja nisam skrivio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Sudovi njegovi svi su mi pred očima,",
            "poem": 1
          },
          {
            "text": "od odredbi njegovih odvratio se nisam.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Pred njim sam ja bio besprekoran,",
            "poem": 1
          },
          {
            "text": "sačuvao sam sebe od krivice,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "po pravdi me je mojoj Gospod nagradio,",
            "poem": 1
          },
          {
            "text": "ruke su mi nedužne pred njegovim očima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Ti vernima iskazuješ vernost,",
            "poem": 1
          },
          {
            "text": "besprekornima uzvraćaš poštenjem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "S čistima ti postupaš čisto,",
            "poem": 1
          },
          {
            "text": "a s opakima postupaš lukavo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Ti izbavljaš krotak narod,",
            "poem": 1
          },
          {
            "text": "a obaraš pogled uznositi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Jer ti, Gospode, svetiljku mi pališ,",
            "poem": 1
          },
          {
            "text": "moj Bog moju tamu rasvetljuje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Jer sa tobom ja razbijam četu,",
            "poem": 1
          },
          {
            "text": "s Bogom mojim preskačem zidine.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Put je Božiji besprekoran,",
            "poem": 1
          },
          {
            "text": "reč je Gospodnja u vatri prekaljena;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "štit je svima što u njemu utočište traže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Jer ko je Bog osim Gospoda?",
            "poem": 1
          },
          {
            "text": "Ko je stena osim našeg Boga?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "On je Bog koji me snagom oprema,",
            "poem": 1
          },
          {
            "text": "on put moj čini besprekornim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Dade mi noge hitre ko u košute,",
            "poem": 1
          },
          {
            "text": "postavi me čvrsto na visine.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Ruke moje uči vojevanju,",
            "poem": 1
          },
          {
            "text": "da luk bronzani natežem mišicama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Ti mi daješ štit spasenja svoga,",
            "poem": 1
          },
          {
            "text": "desnica me tvoja podupire,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "tvoj odaziv čini me velikim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Širiš tlo pod korakom mojim,",
            "poem": 1
          },
          {
            "text": "da mi noge ne bi posrnule.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Dušmane svoje gonim i sustižem,",
            "poem": 1
          },
          {
            "text": "ne vraćam se dok ih ne dokrajčim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "Razbijam ih i ne mogu ustati,",
            "poem": 1
          },
          {
            "text": "i padaju pod moje noge.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          {
            "text": "Ti me opremaš snagom za bitku,",
            "poem": 1
          },
          {
            "text": "i obaraš poda mnom moje protivnike.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          {
            "text": "Ti učini da dušmani moji",
            "poem": 1
          },
          {
            "text": "rep svoj podviju preda mnom,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da mrzitelje svoje iskorenim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          {
            "text": "Zavapiše, ali im spasa nema niotkuda;",
            "poem": 1
          },
          {
            "text": "Gospodu zavapiše, ali on im ne odgovara.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          {
            "text": "Izmrvih ih kao prah pred vetar,",
            "poem": 1
          },
          {
            "text": "izbacih ih kao blato sa ulica.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          {
            "text": "Ti si me izbavio od sukoba s narodom,",
            "poem": 1
          },
          {
            "text": "i postavio me za glavu pucima.",
            "poem": 2
          },
          {
            "text": "Narod koji nisam znao,",
            "poem": 1
          },
          {
            "text": "taj mi narod služi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          {
            "text": "Tuđinci mi laskaju,",
            "poem": 1
          },
          {
            "text": "čim me čuju, oni me slušaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          {
            "text": "Tuđinci gube srčanost,",
            "poem": 1
          },
          {
            "text": "iz svojih tvrđava izlaze drhćući.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          {
            "text": "Živeo Gospod! Blagoslovena bila stena moja!",
            "poem": 1
          },
          {
            "text": "Uzvišen bio Bog moga spasenja!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          {
            "text": "To je Bog što me osvećuje,",
            "poem": 1
          },
          {
            "text": "on meni pokorava narode;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          {
            "text": "izbavlja me od mojih dušmana.",
            "poem": 1
          },
          {
            "text": "Nad mojim si me mrziteljima uzvisio,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "izbavio me od čoveka nasilnog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          {
            "text": "Zato ću te hvaliti, Gospode, među pucima,",
            "poem": 1
          },
          {
            "text": "tvoje ću ime pesmom proslavljati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          {
            "text": "Veliko spasenje daje svome caru;",
            "poem": 1
          },
          {
            "text": "iskazuje milost pomazaniku svome, Davidu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i njegovom potomstvu doveka.",
            "poem": 2
          }
        ]
      }
    ],
