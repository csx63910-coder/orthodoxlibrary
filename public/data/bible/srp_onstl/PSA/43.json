  "chapter": {
    "number": 43,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Dosudi mi pravdu, Bože,",
            "poem": 1
          },
          {
            "text": "odbrani moj spor od bezbožnog sveta,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "izbavi me od čoveka podlog i nepravednog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Jer ti si Bog moj, tvrđava moja.",
            "poem": 1
          },
          {
            "text": "Zašto si me odbacio?",
            "poem": 2
          },
          {
            "text": "Zašto idem okolo u žalosti",
            "poem": 1
          },
          {
            "text": "pod tlakom neprijatelja moga?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Pošalji svetlost i istinu tvoju da me vode,",
            "poem": 1
          },
          {
            "text": "da me dovedu na svetu goru tvoju,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i do mesta gde ti prebivaš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Pristupiću tada k žrtveniku Božijem,",
            "poem": 1
          },
          {
            "text": "k Bogu radosti i užitka svog;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da te harfom hvalim, Bože, Bože moj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Zašto si mi klonula, dušo moja,",
            "poem": 1
          },
          {
            "text": "zašto uzdišeš u meni?",
            "poem": 2
          },
          {
            "text": "Bogu se nadaj, jer opet ću ga slaviti,",
            "poem": 1
          },
          {
            "text": "Spasitelja i Boga svog.",
            "poem": 2
          }
        ]
      }
    ],
