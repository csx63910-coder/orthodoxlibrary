  "chapter": {
    "number": 44,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Za horovođu. Poučna pesma sinova Korejevih."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "O, Bože, svojim smo ušima čuli,",
            "poem": 1
          },
          {
            "text": "naši nam preci rekoše,",
            "poem": 2
          },
          {
            "text": "za delo koje ti učini u dane njihove,",
            "poem": 1
          },
          {
            "text": "u dane pradavne.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Svojom si rukom izgnao narode, a njih posadio,",
            "poem": 1
          },
          {
            "text": "puke si razbio, a njih umnožio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Nisu oni zemlju mačem osvojili,",
            "poem": 1
          },
          {
            "text": "niti ih je ruka njihova izbavila,",
            "poem": 2
          },
          {
            "text": "nego tvoja ruka desnica,",
            "poem": 1
          },
          {
            "text": "i svetlo tvoga lica, jer si ih zavoleo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ti si moj car, Bože!",
            "poem": 1
          },
          {
            "text": "Naredi, i Jakov će biti spasen.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "S tobom probadamo dušmane svoje,",
            "poem": 1
          },
          {
            "text": "u ime tvoje gazimo neprijatelje svoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Jer ja se ne uzdam u luk svoj,",
            "poem": 1
          },
          {
            "text": "mač moj mene ne spasava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Jer ti nas izbavi od naših dušmana,",
            "poem": 1
          },
          {
            "text": "ti osramoti naše mrzitelje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Bogom smo se hvalili povazdan,",
            "poem": 1
          },
          {
            "text": "ime tvoje slavili povazdan.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "No, ti si nas odbacio i ponizio,",
            "poem": 1
          },
          {
            "text": "i ne ideš u boj s vojskom našom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Činiš da se povlačimo pred dušmaninom,",
            "poem": 1
          },
          {
            "text": "da nas pljačkaju naši mrzitelji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Izručio si nas kao ovce za klanje,",
            "poem": 1
          },
          {
            "text": "rasejao nas među narode.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Prodao si svoj narod u bescenje,",
            "poem": 1
          },
          {
            "text": "a od prodaje se nisi obogatio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Učinio si nas ruglom našim susedima,",
            "poem": 1
          },
          {
            "text": "na podsmeh smo i ruganje onima oko nas.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Učinio si nas rugalicom među narodima,",
            "poem": 1
          },
          {
            "text": "mašu glavom narodi nad nama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Sramota je moja stalno preda mnom,",
            "poem": 1
          },
          {
            "text": "stid mi je lice pokrio",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "od glasa rugača i podsmevača,",
            "poem": 1
          },
          {
            "text": "pred dušmaninom, osvetnikom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Sve nas to snađe, alʼ nismo te zaboravili,",
            "poem": 1
          },
          {
            "text": "a ni savez tvoj nismo izneverili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Srce nam se nije odvratilo,",
            "poem": 1
          },
          {
            "text": "niti su nam stope s tvog puta skrenule,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "kad si nas razbio u kraju šakalskom,",
            "poem": 1
          },
          {
            "text": "i u smrtnu nas tamu zavio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Ako zaboravimo ime Boga našega,",
            "poem": 1
          },
          {
            "text": "i raširimo ruke prema tuđem bogu,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "neće li Bog to otkriti,",
            "poem": 1
          },
          {
            "text": "kad poznaje tajne srca?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Jer zbog tebe nas ubijaju svagda,",
            "poem": 1
          },
          {
            "text": "smatraju nas ovcama za klanje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Probudi se, zašto spavaš, Gospode?",
            "poem": 1
          },
          {
            "text": "Ustani, ne odbacuj nas doveka!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Zašto kriješ svoje lice?",
            "poem": 1
          },
          {
            "text": "Zašto zaboravljaš muku i potlačenost našu?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Jer duša naša leži u prašini,",
            "poem": 1
          },
          {
            "text": "stomak nam se prilepio uz zemlju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Ustani, pomozi nam,",
            "poem": 1
          },
          {
            "text": "otkupi nas zbog milosti svoje!",
            "poem": 2
          }
        ]
      }
    ],
