  "chapter": {
    "number": 30,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Psalam Davidov. Pesma za posvećenje hrama."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Uzvisujem te, Gospode, jer si me podigao,",
            "poem": 1
          },
          {
            "text": "nisi dao da se dušmani nada mnom raduju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Tebi zavapih, Gospode, Bože moj,",
            "poem": 1
          },
          {
            "text": "i ti si me iscelio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Gospode, iz Sveta mrtvih ti si me izveo,",
            "poem": 1
          },
          {
            "text": "moju si dušu spasao od rake.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Zapojte Gospodu, verni njegovi,",
            "poem": 1
          },
          {
            "text": "hvalite ga, spominjite svetost njegovu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Jer gnev njegov traje za tren,",
            "poem": 1
          },
          {
            "text": "a čitav život milost njegova.",
            "poem": 2
          },
          {
            "text": "Veče donosi plač,",
            "poem": 1
          },
          {
            "text": "a jutro klicanje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "U svom spokojstvu rekao sam sebi:",
            "poem": 1
          },
          {
            "text": "„Nikada me ništa neće uzdrmati.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Milošću si me svojom, Gospode,",
            "poem": 1
          },
          {
            "text": "učvrstio kao moćnu goru;",
            "poem": 2
          },
          {
            "text": "kad si lice svoje sakrio,",
            "poem": 1
          },
          {
            "text": "svega me je strah obuzeo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "K tebi vapim, Gospode,",
            "poem": 1
          },
          {
            "text": "od svoga Boga tražim milost.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "„Kakva korist od moje smrti,",
            "poem": 1
          },
          {
            "text": "ako siđem u raku?",
            "poem": 2
          },
          {
            "text": "Hoće li te prah proslavljati?",
            "poem": 1
          },
          {
            "text": "Zar će prah o tvojoj vernosti da priča?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Počuj, Gospode, smiluj mi se,",
            "poem": 1
          },
          {
            "text": "budi moja pomoć, o, Gospode!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Moj si plač okrenuo u kolo,",
            "poem": 1
          },
          {
            "text": "skinuo si s mene ruho žalosti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i u ruho me radosti obukao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Zato te duša moja slavi bez prestanka.",
            "poem": 1
          },
          {
            "text": "O, Gospode, Bože moj, hvaliću te večno!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
