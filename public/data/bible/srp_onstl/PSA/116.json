  },
  "chapter": {
    "number": 116,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ja volim Gospoda, jer je čuo moj glas",
            "poem": 1
          },
          {
            "text": "i preklinjanja moja;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "prignuo je uho svoje k meni",
            "poem": 1
          },
          {
            "text": "i dokle živim ja ću da mu vapim!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Smrtna su se užad splela oko mene",
            "poem": 1
          },
          {
            "text": "i zamka Sveta mrtvih spopala me;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "snađoše me i muka i čemer.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ali ime sam Gospodnje zvao:",
            "poem": 1
          },
          {
            "text": "„O, Gospode, preklinjem te,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "izbavi mi dušu!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Milostiv je i pravedan Gospod,",
            "poem": 1
          },
          {
            "text": "naš je Bog milosrdan!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Gospod brani prostodušne,",
            "poem": 1
          },
          {
            "text": "jer kada sam bio lakoveran, on me je spasao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ti se opet smiri, dušo moja,",
            "poem": 1
          },
          {
            "text": "jer ti Gospod obilno uzvrati!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Da, ti si dušu moju od smrti spasao,",
            "poem": 1
          },
          {
            "text": "oko moje od plakanja,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "nogu moju od spoticanja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "U zemlji živih",
            "poem": 1
          },
          {
            "text": "pred Gospodom ja ću ići.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Poverovao sam, makar i govorim:",
            "poem": 1
          },
          {
            "text": "„Ojađen sam jako!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "A rekao sam brzopleto:",
            "poem": 1
          },
          {
            "text": "„Svaki čovek je lažljivac!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Čime Gospodu da uzvratim",
            "poem": 1
          },
          {
            "text": "za sve njegovo dobro prema meni?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Čašu ću spasenja da podignem,",
            "poem": 1
          },
          {
            "text": "Gospodnje ću ime da prizovem!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Zavete svoje izvršiću Gospodu",
            "poem": 1
          },
          {
            "text": "pred celim njegovim narodom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Skupocena je u očima Gospodnjim",
            "poem": 1
          },
          {
            "text": "smrt njegovih vernih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "O, Gospode, ja sam sluga tvoj!",
            "poem": 1
          },
          {
            "text": "Tvoj sam sluga, sin tvoje sluškinje,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "sa mene si raskovo okove!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Prineću ti žrtvu zahvalnicu",
            "poem": 1
          },
          {
            "text": "i prizvaću ja ime Gospodnje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Zavete svoje izvršiću Gospodu",
            "poem": 1
          },
          {
            "text": "pred celim njegovim narodom;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "u dvorištima Doma Gospodnjeg,",
            "poem": 1
          },
          {
            "text": "usred tebe, o, Jerusalime.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Slavite Gospoda!",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
