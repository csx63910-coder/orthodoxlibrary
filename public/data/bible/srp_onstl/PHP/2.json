  },
  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ako ste, dakle, primili ikakvu utehu po Hristu, ikakvo ljubavlju prožeto ohrabrenje, ako imate ikakvo zajedništvo sa Duhom, ako ste primili ikakvo milosrđe i saosećanje,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ispunite me, onda, radošću: svoj um usmerite na isto, imajte istu ljubav, budite jednodušni, na jedno misleći."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Ništa ne činite radi sebičnog isticanja, niti iz bezvrednog častoljublja, nego u poniznosti smatrajte jedni druge većim od sebe."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Ne gledajte samo na vlastitu korist, nego svako da gleda i na korist drugih."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "U sebi nosite istu misao koju je Hristos Isus nosio:"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "On, po obličju Bog,",
            "poem": 1
          },
          {
            "text": "nije smatrao da biti jednak Bogu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jeste plen koji treba otimati,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "nego je lišio sebe časti,",
            "poem": 1
          },
          {
            "text": "uzevši obličje sluge,",
            "poem": 2
          },
          {
            "text": "postavši sličan ljudima.",
            "poem": 1
          },
          {
            "text": "Kao čovek se pojavi,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "te ponizi sebe samog,",
            "poem": 1
          },
          {
            "text": "i posta poslušan do smrti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "do smrti na krstu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Bog ga zato preuzvisi,",
            "poem": 1
          },
          {
            "text": "i darova mu ime,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ime koje je nad svakim imenom,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "da se pred imenom Isusovim,",
            "poem": 1
          },
          {
            "text": "svako koleno prikloni,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "onih na nebu, na zemlji, i pod zemljom,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "i da svaki jezik prizna da je Isus Hristos Gospod,",
            "poem": 1
          },
          {
            "text": "na slavu Boga Oca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Hrišćani – svetlost sveta"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Shodno tome, voljeni moji, vi koji ste uvek bili poslušni, ne samo u mome prisustvu, nego još više sad, u mom odsustvu, sa strahom i trepetom sprovodite u delo svoje spasenje."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Bog je, naime, taj koji čini u vama da želite i činite ono što je njemu ugodno."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Sve činite bez gunđanja i raspravljanja,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "da budete bez mane i čisti, neokaljana deca Božija usred iskvarenog i izopačenog naraštaja, među kojima svetlite kao zvezde u svemiru,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "čvrsto držeći reč života, da bih se ponosio u dan Hristov, da nisam uzalud trčao, niti se uzalud trudio."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "No, ako se i prinosim kao žrtva izlivnica za vas u službi vaše vere, radostan sam i radujem se sa svima vama."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Tako i vi budite radosni i radujte se sa mnom."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Timotej i Epafrodit"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Nadam se u Gospodu Isusu da ću vam uskoro poslati Timoteja, da se i ja ohrabrim kada saznam kako ste vi."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Nemam, naime, nikog toliko bliskog sebi ko bi se tako valjano brinuo o vašim potrebama."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Jer svi traže svoje, a ne ono što pripada Hristu Isusu."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Ali vi znate za njegovu prokušanost, da je, kao dete sa ocem, zajedno sa mnom služio u naveštavanju Radosne vesti."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Nadam se, dakle, da ću vam njega poslati čim vidim kako stoje stvari sa mnom."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Uveren sam u Gospodu da ću uskoro i ja lično doći."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Ipak, smatram za potrebno da vam pošaljem Epafrodita, mog brata, saradnika i saborca, koji je od vas poslan da mi se nađe u potrebama."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Jer, on je čeznuo za svima vama i bio uznemiren što ste čuli da je bolestan."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "I zaista je tako oboleo da je skoro umro, ali Bog mu se smilovao, i ne samo njemu, nego i meni, da mi ne dođe žalost na žalost."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Utoliko više želim da ga pošaljem, da biste se obradovali kada ga vidite, i da bih ja manje brinuo."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Primite ga, stoga, sa svom radošću i cenite takve."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Jer on je radi Hristovog dela skoro umro, izloživši svoj život pogibelji da nadopuni ono u čemu mi vi niste mogli poslužiti."
        ]
      }
    ],
