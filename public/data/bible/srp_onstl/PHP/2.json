    "translationId": "srp_onstl",
    "name": "Filipljanima",
    "commonName": "Filipljanima",
    "title": "Poslanica Filipljanima",
    "order": 50,
    "numberOfChapters": 4,
    "sha256": "a7d54ce09842d200feeac3522a09f2e231db720fd652e31df4ae30579ff00703",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/PHP/1.json",
    "lastChapterNumber": 4,
    "lastChapterApiLink": "/api/srp_onstl/PHP/4.json",
