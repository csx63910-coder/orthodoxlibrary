  },
  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Mudre priče",
          {
            "noteId": 0
          },
          "Solomona, Davidovog sina, cara Izrailja:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "da se steknu mudrost i ukor,",
            "poem": 1
          },
          {
            "text": "pouka razumnim rečima;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "da se primi ukor,",
            "poem": 1
          },
          {
            "text": "razmišlja o pravdi, o pravednosti i čestitosti;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "da se razboritost lakovernima, znanje",
            "poem": 1
          },
          {
            "text": "i domišljatost mladima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Neka sluša ko je mudar i neka još više shvati,",
            "poem": 1
          },
          {
            "text": "neka učeni dobije mudar savet:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "da pronikne pouku, zagonetku,",
            "poem": 1
          },
          {
            "text": "reči mudrih i njihove priče.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Znanje otpočinje bogobojaznošću,",
            "poem": 1
          },
          {
            "text": "a mudrost i prekor budale preziru.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Upozorenje na poziv grešnika"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Sine moj, poslušaj pouku oca svoga",
            "poem": 1
          },
          {
            "text": "i majke svoje savet ne odbacuj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Jer, oni će biti prelepi venac na tvojoj glavi",
            "poem": 1
          },
          {
            "text": "i privesci oko tvoga vrata.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Sine moj, ako li te grešnici zavode,",
            "poem": 1
          },
          {
            "text": "ti ne pristaj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Kažu li: „Hajde s nama,",
            "poem": 1
          },
          {
            "text": "u zasedu da legnemo, krv nevinog",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i nedužnog hajde da vrebamo!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Hajde da ih poput Sveta mrtvih",
            "poem": 1
          },
          {
            "noteId": 1
          },
          {
            "text": "progutamo,",
            "poem": 1
          },
          {
            "text": "i žive i jedre, kao one što u raku idu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Pokupimo sva dobra, sve blago!",
            "poem": 1
          },
          {
            "text": "Nakrcajmo svoje kuće plenom!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Sa nama ćeš dobitak da deliš,",
            "poem": 1
          },
          {
            "text": "nek nam svima bude jedna kesa.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Sine moj, nemoj ići putem s njima,",
            "poem": 1
          },
          {
            "text": "ne daj nozi na njihove staze.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Jer im noge ka zlu trče",
            "poem": 1
          },
          {
            "text": "i srljaju da krv liju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Uzalud se širi mreža",
            "poem": 1
          },
          {
            "text": "naočigled ptice.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ali oni čekaju u zasedi krv svoju,",
            "poem": 1
          },
          {
            "text": "vrebaju svoj život.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Takve su staze svakog ko grabi nepošten dobitak,",
            "poem": 1
          },
          {
            "text": "života koštaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Mudrost prekoreva"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Mudrost po ulicama viče,",
            "poem": 1
          },
          {
            "text": "po trgovima diže glas svoj;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "po raskršćima, u najvećoj vrevi objavljuje,",
            "poem": 1
          },
          {
            "text": "na ulazima gradskih vrata kazivanja svoja daje:",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "„Dokle ćete, lakoverni, voleti lakovernost;",
            "poem": 1
          },
          {
            "text": "dokle ćete, rugači, u ruganju uživati;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "dokle ćete, tupoglavi, mrzeti znanje?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Obratite se po prekoru mome.",
            "poem": 1
          },
          {
            "text": "Evo, izliću vam duha svoga,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "objaviću vam svoje reči.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Jer ja sam vas zvala, a vi ste se oglušili,",
            "poem": 1
          },
          {
            "text": "pružala sam ruku, a niko mario nije;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "sve moje savete ste zanemarili",
            "poem": 1
          },
          {
            "text": "i prekore moje niste prihvatili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Sada ću se i ja smejati propasti vašoj,",
            "poem": 1
          },
          {
            "text": "rugaću se kad bude došla strahota vaša;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "kad vaša strahota prođe kao razaranje",
            "poem": 1
          },
          {
            "text": "i propast vaša kao oluja kada huči,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kada vas zadese muka i nevolja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Tada će me zvati, a ja se neću odazivati,",
            "poem": 1
          },
          {
            "text": "tražiće me željno alʼ me neće naći.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Zato što su mrzeli znanje",
            "poem": 1
          },
          {
            "text": "i nisu izabrali bogobojaznost;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "moj savet nisu poslušali",
            "poem": 1
          },
          {
            "text": "i odbacili su svaki moj prekor.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Zato će jesti plod svog puta,",
            "poem": 1
          },
          {
            "text": "preješće se saveta svojih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Jer lakoverne će upropastiti otpadništvo,",
            "poem": 1
          },
          {
            "text": "a budale satrće lakomislenost.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "A ko mene sluša živeće spokojno,",
            "poem": 1
          },
          {
            "text": "siguran, bez bojazni od nedaća.“",
            "poem": 2
          }
        ]
      }
    ],
