  },
  "chapter": {
    "number": 20,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Vino je podsmevač i žestoko piće svađalica,",
            "poem": 1
          },
          {
            "text": "nemudar je ko se zbog njih tetura.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Carevo je nasilje kao rika lavića,",
            "poem": 1
          },
          {
            "text": "ko ga razdražuje sebi samom škodi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Na čast je čoveku da se kloni svađe,",
            "poem": 1
          },
          {
            "text": "a svaki se bezumnik izbezumi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Kad je jesen – lenština ne ore,",
            "poem": 1
          },
          {
            "text": "kad je žetva – on prosi i oskudeva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Duboka je voda zamisao čovekovog srca,",
            "poem": 1
          },
          {
            "text": "alʼ je crpsti može samo čovek razboriti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Mnogi ljudi objavljuju svima svoju dobrotu,",
            "poem": 1
          },
          {
            "text": "ali ko će naći odanog čoveka?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Pravednik živi čestitost svoju",
            "poem": 1
          },
          {
            "text": "i kako su samo blagoslovena deca nakon njega!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Car koji sedi na sudskom prestolu",
            "poem": 1
          },
          {
            "text": "pogledom svojim sve zlo rasipa.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Može li ko reći: „Srce sam svoje očistio,",
            "poem": 1
          },
          {
            "text": "čist sam od greha svoga“?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Nejednaki tegovi i mera dvojaka –",
            "poem": 1
          },
          {
            "text": "oboje su ogavni Gospodu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "I dete se po delima svojim prepoznaje,",
            "poem": 1
          },
          {
            "text": "da li su mu dela ispravna i čista.",
            "poem": 2
          },
          {
            "noteId": 4
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "I uho što čuje i oko što vidi,",
            "poem": 1
          },
          {
            "text": "i jedno i drugo stvorio je Gospod.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ne voli spavanje da ne osiromašiš,",
            "poem": 1
          },
          {
            "text": "probudi se i naješćeš se hleba.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "„Bezvredno! Bezvredno!“ – govori kupac –",
            "poem": 1
          },
          {
            "text": "a onda se hvali kada ode svojim putem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Postoji zlato i mnoštvo dragulja,",
            "poem": 1
          },
          {
            "text": "ali učene usne su kao dragoceni nakit.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Uzmi haljinu onome što jamči za tuđinca,",
            "poem": 1
          },
          {
            "text": "i zalog mu uzmi kad jamči za neznanca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Čoveku je sladak nepošteni hleb,",
            "poem": 1
          },
          {
            "text": "ali su mu posle usta peska puna.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Namere osmisli savetom",
            "poem": 1
          },
          {
            "text": "i mudrim vođenjem ratuj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ogovarač skita i odaje tajne,",
            "poem": 1
          },
          {
            "text": "zato se ne petljaj sa brbljivcem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Ko proklinje i oca i majku,",
            "poem": 1
          },
          {
            "text": "svetiljka mu dogoreva u najcrnjoj tami.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "U početku naglo zgrnuto nasledstvo",
            "poem": 1
          },
          {
            "text": "ostaje neblagosloveno na svom kraju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Nemoj reći: „Uzvratiću zlu!“",
            "poem": 1
          },
          {
            "text": "Čekaj Gospoda da te izbavi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Gospodu su mrski nejednaki tegovi",
            "poem": 1
          },
          {
            "text": "i strašne su terazije nejednake.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Od Gospoda su čovekovi koraci,",
            "poem": 1
          },
          {
            "text": "pa kako bi neko dokučio svoj vlastiti put?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Čoveku je zamka kad nepromišljeno kaže da je nešto posvećeno,",
            "poem": 1
          },
          {
            "text": "a da posle zavete razmatra.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Car će mudar razvejati zlikovce,",
            "poem": 1
          },
          {
            "text": "vršidbenim točkom preko njih će preći.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Svetiljka Gospodnja je čovekov dah,",
            "poem": 1
          },
          {
            "text": "ispituje dubine nutrine.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Odanost i istina čuvaju cara,",
            "poem": 1
          },
          {
            "text": "on odanošću ostaje na prestolu svome.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Mladiću je čast u njegovoj snazi",
            "poem": 1
          },
          {
            "text": "a seda je kosa dostojanstvo starih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Rane i masnice čiste od zla,",
            "poem": 1
          },
          {
            "text": "a šiba čisti dubine nutrine.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 4,
        "caller": "+",
        "text": "20,11 Ovaj stih može i ovako da se prevede: Čak i dete delima svojim sakriva svoje prave motive, da ne znaš jesu li mu dela ispravna i čista.",
