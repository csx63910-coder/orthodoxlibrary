  "chapter": {
    "number": 6,
    "content": [
      {
        "type": "heading",
        "content": [
          "Upozorenje protiv bezumlja"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Sine moj, ako jamčiš za bližnjega svoga",
            "poem": 1
          },
          {
            "text": "i ruku si pružio tuđincu;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "vezan si rečima usta svojih,",
            "poem": 1
          },
          {
            "text": "obavezan svojim obećanjem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ti onda učini ovo, sine moj, da slobodan budeš,",
            "poem": 1
          },
          {
            "text": "jer si dopao rukama svog bližnjeg:",
            "poem": 2
          },
          {
            "text": "Idi, ponizi se",
            "poem": 1
          },
          {
            "text": "i saleći bližnjeg svog!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ne daj sna očima svojim",
            "poem": 1
          },
          {
            "text": "i svojim kapcima da dremaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Otmi se kao srna lovcu,",
            "poem": 1
          },
          {
            "text": "kao ptica iz ruku ptičara.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "O, lenjivče, idi mravu,",
            "poem": 1
          },
          {
            "text": "sagledaj njegove puteve i postani mudar!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "On nema ni vojvodu,",
            "poem": 1
          },
          {
            "text": "ni zapovednika, ni vladara,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "ali sprema sebi hranu tokom leta,",
            "poem": 1
          },
          {
            "text": "tokom žetve skuplja sebi jelo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "O, lenjivče, dokle ćeš da planduješ,",
            "poem": 1
          },
          {
            "text": "kada ćeš od sna da se preneš?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Još malo snova, još malo dremeža,",
            "poem": 1
          },
          {
            "text": "još malo dokono da sklopiš ruke;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "i doći će tvoje siromaštvo kao skitnica",
            "poem": 1
          },
          {
            "text": "i nemaština kao nasilnik.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ništarija i pokvarenjak se skita",
            "poem": 1
          },
          {
            "text": "i nepošteno govori;",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "namiguje svojim očima,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "podgurkuje nogama,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "upire prstima;",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "izopačenosti su mu u srcu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "svakog časa smišlja zlo i unosi razdor.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Zato će nenadano stići njegova propast,",
            "poem": 1
          },
          {
            "text": "u trenu će biti slomljen, a leka mu neće biti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Šest je stvari koje Gospod mrzi",
            "poem": 1
          },
          {
            "text": "i sedam mu se duši ogadilo:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "oči uznosite,",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "jezik lažljiv,",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "ruke koje liju nevinu krv;",
            "poem": 3
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "srce što smišlja opake naume,",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "noge što srljaju i na zlo su brze;",
            "poem": 3
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Lažljiv svedok što laže čim zine",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "i ko seje razdor među braćom.",
            "poem": 3
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Upozorenje protiv preljube"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Sine moj, drži zapovest oca svoga",
            "poem": 1
          },
          {
            "text": "i ne zaboravljaj pouku majke svoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Vezuj ih istrajno za srce svoje",
            "poem": 1
          },
          {
            "text": "i obmotaj oko svoga vrata.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Vodiće te dok budeš hodao,",
            "poem": 1
          },
          {
            "text": "čuvaće te dok budeš spavao",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i govoriće ti kada se probudiš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Jer je zapovest svetiljka i pouka je svetlo,",
            "poem": 1
          },
          {
            "text": "a prekori odgoja staza su života.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Čuvaće te od opake žene,",
            "poem": 1
          },
          {
            "text": "od laskavog jezika žene preljubnice.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Ne poželi u svom srcu njenu lepotu,",
            "poem": 1
          },
          {
            "text": "ne daj da te pogledom opčini;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "jer zbog bludnice čovek spadne na komad hleba",
            "poem": 1
          },
          {
            "text": "i tuđa žena lovi dragocenu dušu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Može li čovek da u nedra žeravicu stavi,",
            "poem": 1
          },
          {
            "text": "a da mu se odeća ne zapali?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Može li čovek da hoda po uglju vrelom,",
            "poem": 1
          },
          {
            "text": "a da ne opeče stopala svoja?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Tako je i sa onim ko odlazi ženi svoga bližnjeg,",
            "poem": 1
          },
          {
            "text": "neće proći nekažnjeno svaki koji je se dotiče.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Ljudi ne sramote lopova kada krade",
            "poem": 1
          },
          {
            "text": "da nasiti svoju dušu, jer je gladan;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "ali kad uhvaćen bude, nadoknadiće sedmostruko,",
            "poem": 1
          },
          {
            "text": "daće svako dobro iz kuće svoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Bezuman je ko sa ženom preljubu čini,",
            "poem": 1
          },
          {
            "text": "a to radi onaj ko satire samog sebe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Takav dopada i rana i srama,",
            "poem": 1
          },
          {
            "text": "njegova se bruka neće izbrisati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Zbog ljubomore je muž gnevan",
            "poem": 1
          },
          {
            "text": "i nema milosti u danu osvete.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "On ne gleda ni na kakav otkup,",
            "poem": 1
          },
          {
            "text": "ne pristaje ni na velik mito.",
            "poem": 2
          }
        ]
      }
    ],
