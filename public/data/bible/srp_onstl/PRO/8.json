  "chapter": {
    "number": 8,
    "content": [
      {
        "type": "heading",
        "content": [
          "Mudrost poziva"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Zar to mudrost ne poziva,",
            "poem": 1
          },
          {
            "text": "ne diže li razboritost glas svoj?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Eno je na uzvišicama, pokraj puta,",
            "poem": 1
          },
          {
            "text": "na raskršćima se postavila;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "na kapijama, na ulazima u grad,",
            "poem": 1
          },
          {
            "text": "na ulaznim vratima ona viče:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "„Ljudi, vas dozivam",
            "poem": 1
          },
          {
            "text": "i glas dižem celom čovečanstvu!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Razboritosti se naučite, lakoverni ljudi,",
            "poem": 1
          },
          {
            "text": "urazumite srce, nerazumni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Slušajte, jer ja objavljujem dragocene stvari,",
            "poem": 1
          },
          {
            "text": "čestite će biti izreke usana mojih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Baš istinu kazivaću",
            "poem": 1
          },
          {
            "text": "jer je zloba mrska usnama mojim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Pravedne su sve reči mojih usta",
            "poem": 1
          },
          {
            "text": "i nema u njima izopačenosti i nepoštenja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Sve su one jasne razboritom",
            "poem": 1
          },
          {
            "text": "i ispravne onima što znanje stiču.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Prihvatite pouku moju, a ne srebro,",
            "poem": 1
          },
          {
            "text": "izaberite znanje pre nego suvo zlato.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Jer je mudrost od dragulja bolja",
            "poem": 1
          },
          {
            "text": "i sva joj uživanja ni prineti nisu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ja, mudrost, s razboritošću živim,",
            "poem": 1
          },
          {
            "text": "pronalazim znanje i domišljatost.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Bogobojaznost znači mrzeti zlo,",
            "poem": 1
          },
          {
            "text": "jer ja mrzim bahati ponos,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "put zlobe i usta pokvarena.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "U meni je savet, pouzdana mudrost.",
            "poem": 1
          },
          {
            "text": "U meni je umnost, ja imam snagu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Carevi vladaju uz moju pomoć",
            "poem": 1
          },
          {
            "text": "i vladari dele pravdu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Glavari, knezovi i sve pravedne sudije",
            "poem": 1
          },
          {
            "text": "vladaju uz moju pomoć.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ja volim sve koji vole mene,",
            "poem": 1
          },
          {
            "text": "nalaze me svi koji me pomno traže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Čast, imetak, trajno blagostanje",
            "poem": 1
          },
          {
            "text": "i pravednost su sa mnom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Od zlata, od suvoga zlata je rod moj bolji,",
            "poem": 1
          },
          {
            "text": "i dobit moja bolja od probranog srebra.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Ja hodam putem pravednosti",
            "poem": 1
          },
          {
            "text": "i posred staza pravde,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "da onima koji me vole dam nasledstvo",
            "poem": 1
          },
          {
            "text": "i njihove riznice napunim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Mene je imao Gospod na početku njegovog puta,",
            "poem": 1
          },
          {
            "text": "još pre dela svojih drevnih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Postavljena sam od davnina,",
            "poem": 1
          },
          {
            "text": "od iskona, pre postanja zemlje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Rođena sam kad bezdana još nije bilo,",
            "poem": 1
          },
          {
            "text": "kada nije bilo ni izvora obilnih voda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Pre planina postavljenih",
            "poem": 1
          },
          {
            "text": "i pre brda rođena sam,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "dok još zemlju on stvorio nije,",
            "poem": 1
          },
          {
            "text": "ni polja, ni prvo tlo sveta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Kada je stvorio nebesa, ja sam bila tamo,",
            "poem": 1
          },
          {
            "text": "kada je ocrtavao horizont nad licem bezdana;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "kada je gore učvršćivao oblake",
            "poem": 1
          },
          {
            "text": "i kada su nabujali izvori bezdana;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "kada je moru postavio njegove obale,",
            "poem": 1
          },
          {
            "text": "kako voda ne bi prelazila njegovu zapovest,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i kada je označio temelje zemljine.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Bila sam uz njega kao graditeljka,",
            "poem": 1
          },
          {
            "text": "bila sam mu radost svakodnevna,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "veselila se pred njim stalno;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "veselila se po svetu, po njegovoj zemlji",
            "poem": 1
          },
          {
            "text": "i radovala se sa potomcima ljudi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Zato me, deco, poslušajte.",
            "poem": 1
          },
          {
            "text": "O, kako su blagosloveni oni koji se drže mojih puteva!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Poslušajte pouku moju,",
            "poem": 1
          },
          {
            "text": "radite mudro i ne odbacujte je.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Kako je blagosloven čovek koji me sluša,",
            "poem": 1
          },
          {
            "text": "koji svakodnevno bdije na mojim vratima",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i pazi na dovracima vrata mojih!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Jer ko mene nađe, našao je život",
            "poem": 1
          },
          {
            "text": "i dobio naklonost Gospodnju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Ali ko mene ne nađe, sebi samom škodi,",
            "poem": 1
          },
          {
            "text": "a svi koji me mrze vole smrt.“",
            "poem": 2
          }
        ]
      }
    ],
