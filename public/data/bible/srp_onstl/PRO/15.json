  "chapter": {
    "number": 15,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Blagi odgovor utišava gnev,",
            "poem": 1
          },
          {
            "text": "a gruba reč pokreće jarost.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Jezik mudrih dobro vlada znanjem,",
            "poem": 1
          },
          {
            "text": "a usta bezumnih bljuju bezumljem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Gospodnje su oči na svakome mestu,",
            "poem": 1
          },
          {
            "text": "motreći na zle i na dobre.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Zdrav je jezik ko drvo života,",
            "poem": 1
          },
          {
            "text": "a duh slama jezik pogan.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Bezumnik prezire opomenu svoga oca,",
            "poem": 1
          },
          {
            "text": "a razborit je ko mari za ukor.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Veliko je blago u domu pravednika,",
            "poem": 1
          },
          {
            "text": "a zlobniku je muka da zaradi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Znanje rasipaju usta mudrih ljudi,",
            "poem": 1
          },
          {
            "text": "što ne čini srce bezumnika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Gadna je Gospodu žrtva zlikovaca,",
            "poem": 1
          },
          {
            "text": "molitva čestitih njemu je milina.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Gospodu je mrzak put zlobnika,",
            "poem": 1
          },
          {
            "text": "a voli onoga koji pravdu sledi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Nemilo je poučenje za onoga ko se odriče puta,",
            "poem": 1
          },
          {
            "text": "a umreće onaj ko mrzi prekor.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Pred Gospodom su i Svet mrtvih i trulež mrtvih,",
            "poem": 1
          },
          {
            "text": "a kamoli srca ljudskih potomaka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Podrugljivac ne voli onoga koji ga kori",
            "poem": 1
          },
          {
            "text": "i ne ide kod mudrih ljudi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Veselo srce vedri lice,",
            "poem": 1
          },
          {
            "text": "žalosno srce slama duh.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Razborito srce teži znanju,",
            "poem": 1
          },
          {
            "text": "a usta se bezumnika bezumljem hrane.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Nemili su svi dani nevoljnika,",
            "poem": 1
          },
          {
            "text": "a čovek se dobrog srca gosti neprestano.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Bolje je i malo u bogobojaznosti,",
            "poem": 1
          },
          {
            "text": "nego blago silno i sa njim strepnja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Bolji je tanjir povrća u ljubavi,",
            "poem": 1
          },
          {
            "text": "nego utovljeni vo u mržnji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Gnevan čovek raspaljuje svađu,",
            "poem": 1
          },
          {
            "text": "a smireni čovek utišava sukob.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Put lenštine je obrastao trnjem,",
            "poem": 1
          },
          {
            "text": "a put je čestitih poravnan.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Mudar sin raduje oca,",
            "poem": 1
          },
          {
            "text": "a bezuman čovek prezire majku svoju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Bezumnika raduje bezumlje,",
            "poem": 1
          },
          {
            "text": "a razborit čovek ravno ide putem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Naumi se izjalove kad nema saveta,",
            "poem": 1
          },
          {
            "text": "a ostvare s mnoštvom savetnika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Čovek se raduje kad odgovori tačno;",
            "poem": 1
          },
          {
            "text": "kako je dobra reč u pravo vreme!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Staza života za razumnog prema gore vodi,",
            "poem": 1
          },
          {
            "text": "i ne da mu prema dole, u Svet mrtvih da skrene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Gospod ruši kuću gordih ljudi",
            "poem": 1
          },
          {
            "text": "i jača među udovice.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Namere zlikovca gadne su Gospodu,",
            "poem": 1
          },
          {
            "text": "a čiste su mu reči ljubaznosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Kući svojoj bedu navaljuje ko nečasno i lakomo stiče,",
            "poem": 1
          },
          {
            "text": "a živeće onaj čovek kom se mito gadi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Srce pravednika promišlja odgovor,",
            "poem": 1
          },
          {
            "text": "a usta pokvarenih ljudi zlom bljuju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Gospod je daleko od pokvarenjaka,",
            "poem": 1
          },
          {
            "text": "a sluša molitvu pravednika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Bistar pogled i srce veseli,",
            "poem": 1
          },
          {
            "text": "a dobre vesti podmlađuju kosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Uho koje sluša pouku života,",
            "poem": 1
          },
          {
            "text": "trajaće u društvu mudrih ljudi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Ko ne mari za opomenu, prezire sam sebe,",
            "poem": 1
          },
          {
            "text": "a ko sluša ukor stiče razboritost.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Bogobojaznost je pouka mudrosti,",
            "poem": 1
          },
          {
            "text": "a pre časti dolazi poniznost.",
            "poem": 2
          }
        ]
      }
    ],
