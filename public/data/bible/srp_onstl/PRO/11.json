  "chapter": {
    "number": 11,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Gospodu su gadne terazije lažne,",
            "poem": 1
          },
          {
            "text": "a tegovi tačni njemu su milina.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Kada gordost dođe, dođe i sramota,",
            "poem": 1
          },
          {
            "text": "a mudrost je u krotkim ljudima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Čestitost vodi poštene,",
            "poem": 1
          },
          {
            "text": "a nevernike upropašćuje dvoličnost njihova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Nema koristi od bogatstva u dan gneva,",
            "poem": 1
          },
          {
            "text": "a pravednost od smrti izbavlja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Pravednost besprekornom put ravna,",
            "poem": 1
          },
          {
            "text": "a zlobnik pada zbog zlobe svoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Pravednost izbavlja neporočne,",
            "poem": 1
          },
          {
            "text": "a pokvareni se hvataju u žudnji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Kada umre pokvarenjak, umire i nada,",
            "poem": 1
          },
          {
            "text": "propada mu nadanje u snagu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Od nevolje je izbavljen pravednik,",
            "poem": 1
          },
          {
            "text": "a zlikovac stiže na njegovo mesto.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Bezbožnik ustima ruši bližnjeg svoga,",
            "poem": 1
          },
          {
            "text": "a znanje spasava pravednika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "U napretku pravednika grad se raduje,",
            "poem": 1
          },
          {
            "text": "a od sreće kliče kada stradaju zlikovci.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Blagoslovom čestitih grad se uzdiže,",
            "poem": 1
          },
          {
            "text": "a ruši se zbog usta pokvarenih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Bezuman je ko prezire bližnjeg svoga,",
            "poem": 1
          },
          {
            "text": "a razborit čovek ćuti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Klevetnik se skita i otkriva tajne,",
            "poem": 1
          },
          {
            "text": "a ko je vernog duha taj ćuti o tome.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Narod propada gde nema mudrog saveta,",
            "poem": 1
          },
          {
            "text": "i uspeh je u mnogim savetnicima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Zlopati se onaj ko jamči za tuđinca,",
            "poem": 1
          },
          {
            "text": "a bezbedan je čovek koji mrzi da jamči.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Blagonaklona žena zavređuje čast,",
            "poem": 1
          },
          {
            "text": "a okrutni ljudi blago osvajaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Milostiv čovek čini dobro duši svojoj,",
            "poem": 1
          },
          {
            "text": "a silnik samom sebi škodi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Pokvarenjak zadobija nepoštenu nadnicu,",
            "poem": 1
          },
          {
            "text": "a ko seje pravdu dobija poštenu nadnicu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Život daje stamena pravednost,",
            "poem": 1
          },
          {
            "text": "a u smrt hrli onaj što zlo čini.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Gospodu je gadno srce pokvarenih,",
            "poem": 1
          },
          {
            "text": "a uživanje su mu ljudi besprekornog puta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Nesumnjivo je da zlikovac neće proći nekažnjeno,",
            "poem": 1
          },
          {
            "text": "a potomci pravednika biće izbavljeni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Lepa žena koja se odrekla pameti,",
            "poem": 1
          },
          {
            "text": "zlatna je brnjica na njušci krmače.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Želja pravednika je samo na dobro,",
            "poem": 1
          },
          {
            "text": "a gnevna je nada zlikovaca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Neko prosipa, a opet ima više,",
            "poem": 1
          },
          {
            "text": "a neko čuva i ne da šta bi trebalo, pa ipak osiromaši.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Darežljiva duša biće nagrađena",
            "poem": 1
          },
          {
            "text": "i napojen onaj koji druge poji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Ljudi kunu onog ko zadržava žito,",
            "poem": 1
          },
          {
            "text": "a blagoslov daju onom što ga prodaje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Ko predano traži dobro, traži naklonosti,",
            "poem": 1
          },
          {
            "text": "a ko traga za zlom, ono ga i stiže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Pašće svako ko se uzda u svoje bogatstvo,",
            "poem": 1
          },
          {
            "text": "a pupiće pravednici ko zelena grana.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Ko zapusti porodicu naslediće vetar,",
            "poem": 1
          },
          {
            "text": "bezumnik će biti sluga srcu mudrom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Plod pravednika je drvo života",
            "poem": 1
          },
          {
            "text": "i mudar je onaj koji zadobija duše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Gle, već je i pravednik na zemlji nagrađen,",
            "poem": 1
          },
          {
            "text": "a kamoli zločinac i grešnik neće biti!",
            "poem": 2
          }
        ]
      }
    ],
