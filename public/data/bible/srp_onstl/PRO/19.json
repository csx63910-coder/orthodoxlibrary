  },
  "chapter": {
    "number": 19,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Bolji je i siromah što čestito živi,",
            "poem": 1
          },
          {
            "text": "nego čovek nečistih usana i bezumnik.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "I čovek bez znanja je opak",
            "poem": 1
          },
          {
            "text": "i onaj što srlja, taj luta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ludost čoveku podriva put",
            "poem": 1
          },
          {
            "text": "i srce mu se na Gospoda gnevi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Bogatstvo donosi mnogo prijatelja,",
            "poem": 1
          },
          {
            "text": "a siromah je napušten od svog prijatelja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Lažljiv svedok neće proći bez kazne",
            "poem": 1
          },
          {
            "text": "i ko laži širi izbaviti se neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Mnogi se dodvoravaju velikodušnom",
            "poem": 1
          },
          {
            "text": "i svi su prijatelji sa darežljivim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Siromaha mrze sva braća njegova,",
            "poem": 1
          },
          {
            "text": "njegovi ga prijatelji još više napuštaju!",
            "poem": 2
          },
          {
            "text": "On ih traži,",
            "poem": 1
          },
          {
            "text": "doziva ih, a njih nema.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ko srce ispituje, samog sebe voli;",
            "poem": 1
          },
          {
            "text": "ko se drži razboritosti pronalazi dobro.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Lažljiv svedok neće proći bez kazne,",
            "poem": 1
          },
          {
            "text": "nastradaće taj što laži širi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Budalastom raskoš ne pristaje,",
            "poem": 1
          },
          {
            "text": "a kamoli sluzi da vlada glavarima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Čovekova obazrivost čuva ga od srdžbe,",
            "poem": 1
          },
          {
            "text": "na čast mu je da pređe preko uvrede.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Careva je srdžba lavić koji riče,",
            "poem": 1
          },
          {
            "text": "a njegova naklonost je ko rosa po travi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Bezuman sin upropaštava oca svoga,",
            "poem": 1
          },
          {
            "text": "a ženine su svađe kao stalno prokišnjavanje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Kuća i imanje nasledstvo su od otaca,",
            "poem": 1
          },
          {
            "text": "a od Gospoda je žena obazriva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Lenjost vodi u duboki san,",
            "poem": 1
          },
          {
            "text": "a dokoni će gladovati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Život svoj čuva ko zapovest drži,",
            "poem": 1
          },
          {
            "text": "a umreće onaj ko prezire puteve svoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Gospodu pozajmljuje ko daje siromahu,",
            "poem": 1
          },
          {
            "text": "on će da mu uzvrati za to dobročinstvo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Sina svoga kažnjavaj dokle ima nade,",
            "poem": 1
          },
          {
            "text": "ali srcem ne poželi da ga do smrti dovedeš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Besan čovek plaća globu",
            "poem": 1
          },
          {
            "text": "i ako ga od nje spaseš, moraćeš to ponovo da radiš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Slušaj savet i prihvati ukor",
            "poem": 1
          },
          {
            "text": "da postaneš mudar u zrelim danima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "U srcu čoveka mnoge su namere,",
            "poem": 1
          },
          {
            "text": "ali Gospodnji se naum ostvaruje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Odanost je poželjna za čoveka",
            "poem": 1
          },
          {
            "noteId": 3
          },
          {
            "text": ";",
            "poem": 1
          },
          {
            "text": "bolje i siromašan nego lažljiv.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Bogobojaznost znači život,",
            "poem": 1
          },
          {
            "text": "pa ispunjen čovek počiva nepoharan zlom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Lenština umače ruku u čanak,",
            "poem": 1
          },
          {
            "text": "ali je ustima svojim ne prinosi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Šibaj podrugljivca pa će lakoverni postati mudar,",
            "poem": 1
          },
          {
            "text": "prekori razumnog i shvatiće pouku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Ko oca zlostavlja i tera majku,",
            "poem": 1
          },
          {
            "text": "sin je koji donosi bruku i sramotu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Sine, prestani, i slušaj ukor",
            "poem": 1
          },
          {
            "text": "da ne zastraniš od pouka znanja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Bezvredan se svedok ruga pravdi",
            "poem": 1
          },
          {
            "text": "i usta zlih ljudi proždiru zlobu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Za podsmevače spremljena je kazna",
            "poem": 1
          },
          {
            "text": "i batina za leđa bezumnika.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 3,
        "caller": "+",
        "text": "19,22 Ovaj deo stiha može da se prevede i ovako: Čoveku je na sramotu njegova pohlepa.",
        "reference": {
          "chapter": 19,
          "verse": 22
        }
      }
    ]
