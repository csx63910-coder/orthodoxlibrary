  "chapter": {
    "number": 28,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Nepravednik beži, a niko ga ne goni,",
            "poem": 1
          },
          {
            "text": "a pravednik je kao lavić hrabar.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Zemlja zbog prestupa ima mnoge glavare,",
            "poem": 1
          },
          {
            "text": "ali traje dugo sa čovekom poučenim i razumnim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Siromah koji ubogoga tlači",
            "poem": 1
          },
          {
            "text": "je kao pljusak koji nosi, a roda ne donosi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Zlog hvale oni koji Zakon",
            "poem": 1
          },
          {
            "noteId": 6
          },
          {
            "text": "zaboravljaju,",
            "poem": 1
          },
          {
            "text": "a na njih su kivni oni koji Zakon čuvaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Zlotvori ne shvataju pravdu,",
            "poem": 1
          },
          {
            "text": "a sve razume onaj što Gospoda traži.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Bolji je i siromah koji časno živi",
            "poem": 1
          },
          {
            "text": "od bogataša što nečasno živi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Razuman je sin koji Zakon drži,",
            "poem": 1
          },
          {
            "text": "a svog oca sramoti onaj što se druži s izelicama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ko imetak sebi zgrće od kamate i zelenaštva,",
            "poem": 1
          },
          {
            "text": "sakuplja onome koji je milostiv ubogima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Uho svoje ko odvrati i ne sluša Zakon,",
            "poem": 1
          },
          {
            "text": "njegova je molitva odvratna.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "U svoju će jamu pasti",
            "poem": 1
          },
          {
            "text": "ko zavodi pravedne na put zla,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a dobro će besprekorni da naslede.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Bogati je sebi samom mudar,",
            "poem": 1
          },
          {
            "text": "ali ga razumni siromah istražuje pomno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Velika je slava u radosti pravednika,",
            "poem": 1
          },
          {
            "text": "a kada se zli osile, čovek se sakriva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ko sakriva sagrešenja svoja, nema mu napretka;",
            "poem": 1
          },
          {
            "text": "pomilovan biva ko se zbog njih kaje i odriče ih se.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Blažen li je čovek što je stalno na oprezu,",
            "poem": 1
          },
          {
            "text": "a u zlo će pasti onaj što je srce svoje skamenio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Lav što riče, medved raspomamljen,",
            "poem": 1
          },
          {
            "text": "takav je i zlobni vladar ubogom narodu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Golemi je iznuđivač nerazborit vladar,",
            "poem": 1
          },
          {
            "text": "a ko se gnuša iznuđenog dobitka produžava svoje dane.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Krvoprolićem opterećen čovek hrli jami",
            "poem": 1
          },
          {
            "text": "i neka mu niko ne pomogne.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Izbavljen će biti onaj što besprekorno živi,",
            "poem": 1
          },
          {
            "text": "a u trenu pašće onaj što nečasno živi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Izobilje hrane ima onaj koji svoju zemlju radi,",
            "poem": 1
          },
          {
            "text": "a izobilje siromaštva onaj koji teži bezvrednim stvarima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Veran će čovek obilno biti blagosloven,",
            "poem": 1
          },
          {
            "text": "a nekažnjeno neće proći ko srlja da se obogati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Strahota je kad se gleda ko je ko,",
            "poem": 1
          },
          {
            "text": "jer će čovek da sagreši i za parče hleba.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Škrtica srlja da se obogati,",
            "poem": 1
          },
          {
            "text": "a i ne zna da mu stiže oskudica.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Veću blagonaklonost naposletku nalazi onaj koji kori čoveka",
            "poem": 1
          },
          {
            "text": "nego onaj koji laska jezikom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Ko potkrada majku svoju i oca svojega,",
            "poem": 1
          },
          {
            "text": "pa još kaže da tu greha nema,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "taj se druži sa dželatom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Bahat čovek otpočinje svađu,",
            "poem": 1
          },
          {
            "text": "a napreduje ko se uzda u Gospoda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Bezuman je čovek što veruje srcu svome,",
            "poem": 1
          },
          {
            "text": "a ko mudro živi izbavljen će biti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Nema oskudice ko siromahu pruža,",
            "poem": 1
          },
          {
            "text": "a ko sa njega skreće pogled prepun je prokletstva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Kada se osile zlikovci, svako se sklanja,",
            "poem": 1
          },
          {
            "text": "a kada stradaju, množe se pravednici.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 6,
        "caller": "+",
        "text": "28,4 Osim značenja Zakon jevrejski izraz tora se odnosi i na pouku, uputstvo u smislu širem od Mojsijevog Zakona.",
        "reference": {
          "chapter": 28,
          "verse": 4
        }
      }
    ]
