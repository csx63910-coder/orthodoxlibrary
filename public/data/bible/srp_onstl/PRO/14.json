  },
  "chapter": {
    "number": 14,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Svaka mudra žena kući svoju kuću,",
            "poem": 1
          },
          {
            "text": "a bezumna je žena raskućuje rukama svojim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Gospoda se boji ko čestito živi,",
            "poem": 1
          },
          {
            "text": "a prezire ga onaj ko pokvareno živi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Bezumnikov govor je batina za leđa njegova,",
            "poem": 1
          },
          {
            "text": "a mudre čuvaju usta njihova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Gde volova nema i jasle su čiste,",
            "poem": 1
          },
          {
            "text": "u snazi je vola obilje plodova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Veran svedok ne govori laži,",
            "poem": 1
          },
          {
            "text": "a lažljivi svedok odiše lažima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Podrugljivac mudrost traži i ne nalazi je,",
            "poem": 1
          },
          {
            "text": "a poučen čovek znanje pronalazi lako.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Idi od bezumnika,",
            "poem": 1
          },
          {
            "text": "od njega nećeš čuti pametne reči.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Mudrošću obazriv čovek shvata put svoj,",
            "poem": 1
          },
          {
            "text": "a bezumlje bezumnih je obmana.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Bezumnici se rugaju grehu,",
            "poem": 1
          },
          {
            "text": "a među čestitima je dobra volja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Srcu je poznata gorčina njegova",
            "poem": 1
          },
          {
            "text": "i tuđinac ne deli njegovo veselje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Kuća će zlobnika biti razorena,",
            "poem": 1
          },
          {
            "text": "a šator pravednika će procvetati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Neki put pred čovekom kao da je prav,",
            "poem": 1
          },
          {
            "text": "ali završava na putevima smrti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Srce boli i u smehu,",
            "poem": 1
          },
          {
            "text": "a i radost na svom kraju ponekad je žalost.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Svojih će se puteva nasititi otpadnik,",
            "poem": 1
          },
          {
            "text": "a i dobar čovek biće sit od svojih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Lakoverni svačemu veruje,",
            "poem": 1
          },
          {
            "text": "a obazriv pazi na svoj korak.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Mudar se čovek boji greha, kloni ga se,",
            "poem": 1
          },
          {
            "text": "a nemudar je raspojasan, u sebe siguran.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Budalasto radi čovek koji brzo plane,",
            "poem": 1
          },
          {
            "text": "a i spletkaroš je omražen.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Lakovernim sleduje bezumlje,",
            "poem": 1
          },
          {
            "text": "a obazrivi se znanjem kite.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Pred dobrim će se ljudima zlobnici klanjati",
            "poem": 1
          },
          {
            "text": "i pokvarenjaci pred vratima pravednih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "I susedu svome mrzak je siromah,",
            "poem": 1
          },
          {
            "text": "a mnogo je onih što vole bogatoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Grešan je čovek što prezire bližnjeg svoga,",
            "poem": 1
          },
          {
            "text": "a blagosloven je onaj koji je naklonjen poniznima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Ne zastranjuju li spletkaroši?",
            "poem": 1
          },
          {
            "text": "Milost i istina onima što dobro smišljaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Od svakog vrednoga rada dolazi zarada,",
            "poem": 1
          },
          {
            "text": "a od praznih priča samo oskudica.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Mudrima je kruna njihovo bogatstvo,",
            "poem": 1
          },
          {
            "text": "nemudrost je nemudrog glupava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Istinoljubiv svedok spasava živote,",
            "poem": 1
          },
          {
            "text": "a lažljivi slaže čim zine.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "U bogobojaznosti je pouzdanje jakom",
            "poem": 1
          },
          {
            "text": "i utočište deci njegovoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Vrelo je života bogobojaznost",
            "poem": 1
          },
          {
            "text": "i odvraća od smrtnih zamki.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Careva je slava u mnoštvu naroda,",
            "poem": 1
          },
          {
            "text": "a kad življa nema, tad vladar propada.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Ko se sporo srdi vrlo je razborit,",
            "poem": 1
          },
          {
            "text": "a ko brzo plane veliča bezumlje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Zdravo srce – zdravo telo;",
            "poem": 1
          },
          {
            "text": "ljubomora – trulež u kostima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Ko tlači ubogog sramoti mu Sazdatelja,",
            "poem": 1
          },
          {
            "text": "a slavi ga onaj što se ubogom smiluje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Opaki će srušen biti opakošću svojom,",
            "poem": 1
          },
          {
            "text": "a pravednik i u smrti utočište ima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Mudrost počiva u srcu razumnog čoveka,",
            "poem": 1
          },
          {
            "text": "čak je i u nutrini bezumnika obelodanjena.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Pravednost uzdiže narod,",
            "poem": 1
          },
          {
            "text": "a greh je sramota narodu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Car poštuje slugu što čestito radi,",
            "poem": 1
          },
          {
            "text": "a gnevan je na onoga što radi sramotno.",
            "poem": 2
          }
        ]
      }
    ],
