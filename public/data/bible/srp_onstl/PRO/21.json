  "chapter": {
    "number": 21,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ko potoci vode carevo je srce u ruci Gospodnjoj,",
            "poem": 1
          },
          {
            "text": "on ga vodi kako njemu godi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "U sopstvenim očima čoveku je čist svaki put,",
            "poem": 1
          },
          {
            "text": "ali Gospod proverava namere srca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Da se čini po pravu i pravdi",
            "poem": 1
          },
          {
            "text": "Gospodu je milije od žrtve.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Uznosite oči i oholo srce",
            "poem": 1
          },
          {
            "text": "svetiljka su pokvarenih, a to je greh.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Namere marljivog jedino obilju vode,",
            "poem": 1
          },
          {
            "text": "a svih onih što srljaju samo siromaštvu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Sticanje bogatstva jezikom lažljivim",
            "poem": 1
          },
          {
            "text": "je poput pare lelujave; u smrt srljaju takvi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Nasilnike će pomesti nasilje njihovo,",
            "poem": 1
          },
          {
            "text": "jer su odbili da čine po pravdi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Kriv je put krivca,",
            "poem": 1
          },
          {
            "text": "a nedužno je delo nedužnoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Bolje je sedeti na uglu krova",
            "poem": 1
          },
          {
            "text": "nego sa ženom svadljivom u zajedničkoj kući.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Za zlom žudi duša zlotvora,",
            "poem": 1
          },
          {
            "text": "samilost mu bližnji njegov ne vidi u oku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Kazni podrugljivca, pa će lakoverni postati mudar,",
            "poem": 1
          },
          {
            "text": "pouči razumnog i shvatiće pouku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Svepravedni motri na kuću zloga,",
            "poem": 1
          },
          {
            "text": "on obara zle u propast.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ko zatvara uho svoje od plača ubogog",
            "poem": 1
          },
          {
            "text": "i sam će plakati, a uslišen neće biti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Tajni poklon ljutnju utišava",
            "poem": 1
          },
          {
            "text": "i mito u nedrima pogolemu srdžbu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Pravedniku je radost da radi po pravdi,",
            "poem": 1
          },
          {
            "text": "a jeza je za one što nepravdu rade.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Čovek što zaluta s puta razumnoga",
            "poem": 1
          },
          {
            "text": "završiće u društvu pokojnih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Siromašan čovek biće ko voli veselje,",
            "poem": 1
          },
          {
            "text": "ko vino i ulje voli bogat biti neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Zlobnik je otkup za pravednika",
            "poem": 1
          },
          {
            "text": "i nevernik za ispravnoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Bolje biti i u zemlji pustoj,",
            "poem": 1
          },
          {
            "text": "nego sa ženom svadljivom i goropadnom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Primamljivo blago i ulje su u domu mudrog,",
            "poem": 1
          },
          {
            "text": "a bezumni čovek sve to proćerda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Ko pravdi i ljubavi teži",
            "poem": 1
          },
          {
            "text": "nalazi i život i pravdu i čast.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Mudar se uspinje u grad junaka",
            "poem": 1
          },
          {
            "text": "i obara bedem njihovog uzdanja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Usta svoja i jezik svoj ko čuva,",
            "poem": 1
          },
          {
            "text": "od nevolja sebe brani.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Bahati i oholi – ime mu podrugljivac –",
            "poem": 1
          },
          {
            "text": "onaj je što radi u obesti bezmernoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Lenštinu ubija njegova želja,",
            "poem": 1
          },
          {
            "text": "jer odbija da radi rukama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "On mahnito traži od jutra do sutra,",
            "poem": 1
          },
          {
            "text": "a pravednik deli i ne cicijaši.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Mrske su žrtve zlobnika,",
            "poem": 1
          },
          {
            "text": "a još više kad ih prinosi u zlobi!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Lažljivi svedok će nastradati,",
            "poem": 1
          },
          {
            "text": "a čovek koji sluša s uspehom će da svedoči.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Zlobnik na licu pokazuje drskost,",
            "poem": 1
          },
          {
            "text": "a čestiti put svoj razaznaje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Ni mudrosti ni znanja,",
            "poem": 1
          },
          {
            "text": "ni saveta nema nasuprot Gospodu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Za dan boja konj je spreman,",
            "poem": 1
          },
          {
            "text": "ali pobeda je od Gospoda.",
            "poem": 2
          }
        ]
      }
    ],
