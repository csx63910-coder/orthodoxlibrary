  "book": {
    "id": "PRO",
    "translationId": "srp_onstl",
    "name": "Priče Solomonove",
    "commonName": "Priče Solomonove",
    "title": "Priče Solomonove",
    "order": 20,
    "numberOfChapters": 31,
    "sha256": "7b49ed94789804258b7501c117fe02085c14f2eb48b2dc64d2ec6d6a27099e44",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/PRO/1.json",
    "lastChapterNumber": 31,
    "lastChapterApiLink": "/api/srp_onstl/PRO/31.json",
    "totalNumberOfVerses": 915
  },
  "chapter": {
    "number": 30,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Poruke Agura, Jekajevog sina,",
          {
            "text": "proroštvo ovog čoveka kazano Itilu,",
            "poem": 1
          },
          {
            "text": "Itilu i Ukalu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Elem, ja sam prostiji od bilo koga",
            "poem": 1
          },
          {
            "text": "i nemam pameti ljudske;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "nisam se poučio mudrosti",
            "poem": 1
          },
          {
            "text": "i znanje Svetog nemam.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ko se to uspeo na nebesa pa sišao?",
            "poem": 1
          },
          {
            "text": "Ko je sabrao vetar u šake svoje?",
            "poem": 2
          },
          {
            "text": "Ko je to uvio vode u plašt?",
            "poem": 1
          },
          {
            "text": "Ko je postavio sve zemljine krajeve?",
            "poem": 2
          },
          {
            "text": "Kako mu je ime",
            "poem": 1
          },
          {
            "text": "i kako mu se sin zove,",
            "poem": 2
          },
          {
            "text": "znaš li?",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Svaka je Božija reč oprobana.",
            "poem": 1
          },
          {
            "text": "On je štit onima koji u njemu utočište nalaze.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ne dodaji rečima njegovim",
            "poem": 1
          },
          {
            "text": "da te ne bi prekorio,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da se ne bi pokazalo da si lažov.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Dve stvari od tebe tražim,",
            "poem": 1
          },
          {
            "text": "ne uskrati mi ih dok sam živ:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "beskorisnu, lažljivu reč od mene udalji;",
            "poem": 1
          },
          {
            "text": "ne daj mi siromaštva i bogatstva,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "daj mi hleba da jedem tek da se najedem;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "da se ne bih zasitio, pa se odrekao",
            "poem": 1
          },
          {
            "text": "i rekao ’Ko je Gospod?’",
            "poem": 2
          },
          {
            "text": "Ili da ne bih osiromašio, pa krao",
            "poem": 1
          },
          {
            "text": "i ružio ime Boga svoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ne kleveći slugu gospodaru njegovom",
            "poem": 1
          },
          {
            "text": "da te ne bi proklinjao, pa bi kriv bio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Neki soj proklinje oca svoga",
            "poem": 1
          },
          {
            "text": "i majku svoju ne blagosilja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Neki je soj sebi samom čist",
            "poem": 1
          },
          {
            "text": "pa od izmeta svog ostaje neopran.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "O, kako neki soj uzdiže oči",
            "poem": 1
          },
          {
            "text": "i kako mu je pogled nadmen!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Nekom su soju zubi ko mačevi",
            "poem": 1
          },
          {
            "text": "a vilice ko noževi,",
            "poem": 2
          },
          {
            "text": "da sa zemlje prožderu uboge",
            "poem": 1
          },
          {
            "text": "i nesrećnike ljudskog roda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Pijavica ima dve ćerke –",
            "poem": 1
          },
          {
            "text": "Daj i Daj.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Tri su stvari nezasite",
            "poem": 1
          },
          {
            "text": "i četiri nikada ne kažu ’Dosta!’:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Svet mrtvih,",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "jalova utroba,",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "zemlja vode nikad sita",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "i vatra što ne kaže ’Dosta!’",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Oko što se ocu ruga",
            "poem": 1
          },
          {
            "text": "i prezire poslušnost majci,",
            "poem": 2
          },
          {
            "text": "iskljucaće potočni gavrani",
            "poem": 1
          },
          {
            "text": "i poješće orlići.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Tri su mi stvari začuđujuće",
            "poem": 1
          },
          {
            "text": "i četiri su mi nepoznate:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "orlov let po nebesima,",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "puzanje zmije po steni,",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "plovidba lađe posred mora",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "i put muškarca sa devojkom.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "A put žene preljubnice je ovakav:",
            "poem": 1
          },
          {
            "text": "ona jede, obriše usta pa kaže:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "’Nikakvo zlo nisam uradila!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Pod tri stvari zemlja se potresa",
            "poem": 1
          },
          {
            "text": "i četiri ne može da nosi:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "slugu kada se zacari,",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "budalu kad je sita hleba,",
            "poem": 3
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "nevoljenu, a udatu ženu,",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "i sluškinju kad zameni gazdaricu svoju.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Četiri su stvora malena na zemlji,",
            "poem": 1
          },
          {
            "text": "a opet su preko mere učinjena mudrim:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "mravi, nejak narod,",
            "poem": 1
          },
          {
            "text": "ali leti sebi pripremaju hranu;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "damani, nejak narod,",
            "poem": 1
          },
          {
            "text": "ali dom svoj na stenama prave;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "skakavci, iako bez cara,",
            "poem": 1
          },
          {
            "text": "alʼ svi lete u poretku;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "gušter, iako ga s obe ruke hvataš,",
            "poem": 1
          },
          {
            "text": "eno ga u odajama carskim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Tri su stvora koraka ponosnog",
            "poem": 1
          },
          {
            "text": "i četiri što otmeno gaze:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "lav, od svih zveri jači, ni pred čim ne uzmiče;",
            "poem": 3
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "petao kada se šepuri,",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "jarac",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "i car sa vojskom pored sebe.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Ako si budalast bio sebe uzdižući,",
            "poem": 1
          },
          {
            "text": "ako li si spletkario,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ruku na usta stavi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Jer kada se mleko bućka, nastaje maslo;",
            "poem": 1
          },
          {
            "text": "i kada se nos istrlja, krv procuri;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a kada bes uskipi, to donosi svađu.“",
            "poem": 2
          }
        ]
      }
    ],
