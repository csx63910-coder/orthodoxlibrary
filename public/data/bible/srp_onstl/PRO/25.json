  },
  "chapter": {
    "number": 25,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "I ovo su Solomonove mudre priče koje su prepisali ljudi Jezekije, Judinog cara:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Božija je slava da sakriva stvari,",
            "poem": 1
          },
          {
            "text": "a caru je slava da stvar istražuje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Nebo je visoko, zemlja je duboka,",
            "poem": 1
          },
          {
            "text": "a i srca carska niko ne istraži.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ukloni sa srebra zguru",
            "poem": 1
          },
          {
            "text": "i eto ga čanak za kovača:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "ukloni zloga od cara",
            "poem": 1
          },
          {
            "text": "i u pravdi presto njegov utvrđen će biti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Pred carem se ne veličaj",
            "poem": 1
          },
          {
            "text": "i ne stoj na mestu velikaša;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "jer je bolje da ti kaže – „Gore dođi!“ –",
            "poem": 1
          },
          {
            "text": "nego da te ponizi pred plemićem.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "A to",
            "poem": 1
          },
          {
            "noteId": 5
          },
          {
            "text": "što su ti oči videle",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "ne dovodi žurno na suđenje,",
            "poem": 2
          },
          {
            "text": "jer šta ćeš kada te na kraju",
            "poem": 1
          },
          {
            "text": "posrami bližnji tvoj?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Reši spor sa bližnjem svojim",
            "poem": 1
          },
          {
            "text": "i tajnu drugoga ne otkrivaj;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "da te ne bi osramotio onaj koji sluša",
            "poem": 1
          },
          {
            "text": "i zao glas ostao na tebi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Blagovremeno kazana reč",
            "poem": 1
          },
          {
            "text": "je poput zlatnih jabuka u srebrnim činijama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Minđuša zlatna i ukras od čistog zlata",
            "poem": 1
          },
          {
            "text": "je ukor mudrog onome koji sluša.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Kao studen snega na dan žetve",
            "poem": 1
          },
          {
            "text": "je verni glasnik onom ko ga šalje –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "osvežava dušu svoga gospodara.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Poput oblaka i vetra bez kiše",
            "poem": 1
          },
          {
            "text": "čovek je što se hvali darom nedarovanim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Strpljivošću se nagovara vladar,",
            "poem": 1
          },
          {
            "text": "a i jezik blagi može kost da slomi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Kad nađeš med, jedi dok se ne najedeš,",
            "poem": 1
          },
          {
            "text": "jer ćeš ga povratiti ako se prejedeš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Neka ti je noga retko u kući bližnjeg tvoga,",
            "poem": 1
          },
          {
            "text": "da te se ne zasiti i ne zamrzi te.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Poput buzdovana, mača i strele oštre",
            "poem": 1
          },
          {
            "text": "je čovek koji svedoči protiv bližnjeg svoga, a lažov je.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Zub pokvaren i klecava noga",
            "poem": 1
          },
          {
            "text": "je poverenje u izdajnika u danu nevolje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Kao čovek što haljinu skida po zimskome danu",
            "poem": 1
          },
          {
            "text": "i kao sirće na šalitri,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "takav je onaj koji pesme peva srcu žalosnome.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Ako je tvoj neprijatelj gladan, nahrani ga,",
            "poem": 1
          },
          {
            "text": "i ako je žedan, napoj ga vodom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Jer ako tako činiš, zgrnućeš žar ugljeni na njegovu glavu,",
            "poem": 1
          },
          {
            "text": "a Gospod će da ti plati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Severac kišu donosi,",
            "poem": 1
          },
          {
            "text": "a jezik ogovarački srdita lica.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Bolje je sedeti na uglu krova",
            "poem": 1
          },
          {
            "text": "nego sa ženom svadljivom u zajedničkoj kući.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Što je studena voda duši iznurenoj,",
            "poem": 1
          },
          {
            "text": "to je dobra vest iz daleke zemlje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Zamućen izvor i bunar zarušeni",
            "poem": 1
          },
          {
            "text": "je pravednik što tetura pred nepravednikom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Nije dobro preždrati se meda",
            "poem": 1
          },
          {
            "text": "i ljudima na čast nije da čast svoju traže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Grad provaljen i bez zida",
            "poem": 1
          },
          {
            "text": "je čovek koji ne zna sebe samog da obuzda.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 5,
        "caller": "+",
        "text": "25,7 Misli se na plemića iz prethodnog stiha.",
