  "chapter": {
    "number": 26,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Kao sneg leti i kiša o žetvi,",
            "poem": 1
          },
          {
            "text": "tako čast ne stoji bezumnom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Kao kad prhne vrabac i lasta kad odleti,",
            "poem": 1
          },
          {
            "text": "tako i kletva ne stiže bez povoda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Bič je za konja, uzde za magarca,",
            "poem": 1
          },
          {
            "text": "a batina za leđa bezumnog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ne uzvraćaj bezumnome po bezumlju njegovome,",
            "poem": 1
          },
          {
            "text": "da i sam ne bi bio njemu nalik.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Uzvrati bezumnome po bezumlju njegovome,",
            "poem": 1
          },
          {
            "text": "da sam sebi ne bi bio mudar.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Noge svoje sam saseca, nasiljem se podnapija",
            "poem": 1
          },
          {
            "text": "ko poruku šalje rukama bezumnog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Kako noge vise oduzetom,",
            "poem": 1
          },
          {
            "text": "takva je mudra priča u ustima bezumnoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Kamen u praćku veže",
            "poem": 1
          },
          {
            "text": "ko bezumnom počast daje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Trnova grana u ruci pijanca",
            "poem": 1
          },
          {
            "text": "je mudra priča u ustima bezumnoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Poput strelca što ranjava koga stigne,",
            "poem": 1
          },
          {
            "text": "takav je čovek što unajmljuje bezumnika",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i onaj što unajmljuje prolaznika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Vraća se pas na svoju bljuvotinu",
            "poem": 1
          },
          {
            "text": "kao što se i bezumnik vraća bezumlju svome.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Vidiš li čoveka koji misli za sebe da je mudar?",
            "poem": 1
          },
          {
            "text": "Više je nade za bezumnika nego za njega!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Lenština govori: „Lav je na ulici!",
            "poem": 1
          },
          {
            "text": "Lav je nasred trga!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Na šarkama okreću se vrata,",
            "poem": 1
          },
          {
            "text": "a lenština na krevetu svome.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Lenština umače ruku u čanak,",
            "poem": 1
          },
          {
            "text": "ali je preumoran da ustima svojim je prinese.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Samom sebi lenština je mudriji",
            "poem": 1
          },
          {
            "text": "od sedmorice što razborito odgovaraju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Psa za uši hvata",
            "poem": 1
          },
          {
            "text": "ko se u prolazu ljuti zbog tuđe rasprave.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Kao mahnitavi što baklje,",
            "poem": 1
          },
          {
            "text": "strele i smrt seje,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "takav je čovek što vara bližnjeg svoga,",
            "poem": 1
          },
          {
            "text": "pa još kaže: „Nisam li se našalio?!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Kada nema drva i vatra se gasi,",
            "poem": 1
          },
          {
            "text": "kada nema klevetnika i svađa se stiša.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Ugalj je za žeravicu i drvo za vatru,",
            "poem": 1
          },
          {
            "text": "a čovek svađalica da potpali svađu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Reči klevetnika su kao poslastice",
            "poem": 1
          },
          {
            "text": "što u stomak klize.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Posrebrena grnčarija –",
            "poem": 1
          },
          {
            "text": "to su usne uglađene i zlo srce.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Onaj koji mrzi skriva se usnama svojim,",
            "poem": 1
          },
          {
            "text": "a u sebi sakuplja prevaru.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Ne veruj čoveku umilnog glasa",
            "poem": 1
          },
          {
            "text": "kome je u srcu sedmostruka gadost.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "On se skriva, mržnju prikriva,",
            "poem": 1
          },
          {
            "text": "ali će se razotkriti u zboru pokvarenost njegova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Ko jamu kopa, sam u nju pada",
            "poem": 1
          },
          {
            "text": "i ko kamen valja, na njega se svalja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Lažljiv jezik mrzi one koje drobi",
            "poem": 1
          },
          {
            "text": "i usta laskava ruševine prave.",
            "poem": 2
          }
        ]
      }
    ],
