  },
  "chapter": {
    "number": 29,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Kada tvrdoglavi još više otvrdoglavi uprkos karanju,",
            "poem": 1
          },
          {
            "text": "slomiće se nenadano i neće mu biti leka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Kad se množe pravednici, narod se raduje,",
            "poem": 1
          },
          {
            "text": "a kad zlikovac zavlada, narod uzdiše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Oca svog raduje čovek koji voli mudrost,",
            "poem": 1
          },
          {
            "text": "a s bludnicom ko se druži, imetak svoj ruži.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Car po pravdi zemlju gradi,",
            "poem": 1
          },
          {
            "text": "a gramzivi tlačitelj je razgrađuje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Čovek što laska bližnjem svome",
            "poem": 1
          },
          {
            "text": "mrežu širi nogama njegovim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "U grehu je zamka zlikovačka,",
            "poem": 1
          },
          {
            "text": "a pravednik kliče i veseli se.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Pravednik razume slučaj siromaha,",
            "poem": 1
          },
          {
            "text": "a nepravednik za tu stvar ne mari.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Podsmevači grad razjare,",
            "poem": 1
          },
          {
            "text": "a mudri stišavaju gnev.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Kad se mudar čovek sudi s čovekom nemudrim,",
            "poem": 1
          },
          {
            "text": "ljutio se ilʼ smejao, počinka mu nema.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Krvnici mrze čoveka bez mane,",
            "poem": 1
          },
          {
            "text": "a pravedni mu dušu štite.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Svu ćud svoju istresa bezumnik,",
            "poem": 1
          },
          {
            "text": "a mudar se povlači i stišava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Vladar koji sluša laži",
            "poem": 1
          },
          {
            "text": "imaće za sluge sve same zlikovce.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "I siromahu i tlačitelju jedno je zajedničko:",
            "poem": 1
          },
          {
            "text": "obojici Gospod prosvetljuje oči.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Doveka će stajati presto cara",
            "poem": 1
          },
          {
            "text": "što ubogom sudi po istini.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Šiba prekora donosi mudrost,",
            "poem": 1
          },
          {
            "text": "a dete raspušteno sramoti svoju majku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Kad se zlobnici umnožavaju, umnožavaju se i gresi,",
            "poem": 1
          },
          {
            "text": "ali će pravednici gledati njihovu propast.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Opomeni svoga sina i doneće ti spokoj,",
            "poem": 1
          },
          {
            "text": "i doneće radost duši tvojoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Gde viđenja nema, narod se razuzda;",
            "poem": 1
          },
          {
            "text": "a kako je blagosloven čovek što se pouke drži!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Rečima se ne popravlja sluga,",
            "poem": 1
          },
          {
            "text": "jer ako ih i razume, on se ne odaziva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Vidiš li čoveka brzopletog u govoru?",
            "poem": 1
          },
          {
            "text": "Više je nade za bezumnog nego za njega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Ko svom sluzi od malena povlađuje",
            "poem": 1
          },
          {
            "text": "za nevolju kraj mu sprema.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Razjareni svađu započinje,",
            "poem": 1
          },
          {
            "text": "goropadni obiluje gresima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Bahatost unižava čoveka,",
            "poem": 1
          },
          {
            "text": "a ponizni zavređuje čast.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Ko se druži sa lopovom mrzi dušu svoju,",
            "poem": 1
          },
          {
            "text": "jer on čuje kletvu, ali je prećuti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Strah čoveku zamku postavlja,",
            "poem": 1
          },
          {
            "text": "a zbrinut je onaj što se u Gospoda uzda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Mnogi traže vladarevu naklonost,",
            "poem": 1
          },
          {
            "text": "ali od Gospoda je pravda za čoveka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Nepravednik je mrzak pravednicima,",
            "poem": 1
          },
          {
            "text": "a zlobnicima je mrzak čovek čestitog života.",
            "poem": 2
          }
        ]
      }
    ],
