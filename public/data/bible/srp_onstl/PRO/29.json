    "order": 20,
    "numberOfChapters": 31,
    "sha256": "7b49ed94789804258b7501c117fe02085c14f2eb48b2dc64d2ec6d6a27099e44",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/PRO/1.json",
