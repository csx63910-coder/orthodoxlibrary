  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "heading",
        "content": [
          "Upozorenje protiv preljube"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Sine moj, pazi na moju mudrost",
            "poem": 1
          },
          {
            "text": "i poslušaj dobro razboritost moju,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "domišljatost da očuvaš",
            "poem": 1
          },
          {
            "text": "i usta da ti očuvaju znanje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jer sa usana bludnice med curi,",
            "poem": 1
          },
          {
            "text": "zavodljive reči mekše od ulja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ali na kraju je kao pelen gorka",
            "poem": 1
          },
          {
            "text": "i oštra kao mač dvosekli.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Noge joj silaze u smrt,",
            "poem": 1
          },
          {
            "text": "do Sveta mrtvih noge joj dopiru.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ona ne mari za put života,",
            "poem": 1
          },
          {
            "text": "staze joj vrludaju, a ona to ne zna.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Zato me poslušajte, deco,",
            "poem": 1
          },
          {
            "text": "i ne odstupajte od onoga što vam kazujem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Zaobiđi je nadaleko",
            "poem": 1
          },
          {
            "text": "i ne primiči se ulazu njene kuće,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "da ne bi drugima dao obraz svoj",
            "poem": 1
          },
          {
            "text": "i okrutnom čoveku godine svoje;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "da tuđinci ne bi ispili ti snagu",
            "poem": 1
          },
          {
            "text": "i trud ti ostao u kući tuđina;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "da ne bi kukao na svome svršetku",
            "poem": 1
          },
          {
            "text": "kada ti propadnu i telo i zdravlje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "I ti ćeš reći: „Kako sam mrzeo opomenu,",
            "poem": 1
          },
          {
            "text": "dok mi je srce preziralo ukor.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Nisam slušao glas svoga učitelja,",
            "poem": 1
          },
          {
            "text": "nisam poslušao vaspitače svoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Umalo nisam pao u svakojako zlo",
            "poem": 1
          },
          {
            "text": "usred zbora i usred zajednice.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Pij vodu sa svoga bunara,",
            "poem": 1
          },
          {
            "text": "žubor vodu sa izvora svoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Zar će se razlivati izvori tvoji po poljima",
            "poem": 1
          },
          {
            "text": "i potoci vode po trgovima?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Neka oni budu samo tvoji,",
            "poem": 1
          },
          {
            "text": "a ne tuđinaca što su sa tobom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Da je blagosloven izvor tvoj!",
            "poem": 1
          },
          {
            "text": "Radovao se ti sa ženom mladosti svoje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ona ti je košuta voljena i srna mila.",
            "poem": 1
          },
          {
            "text": "Naslađuj se uvek grudima njenim,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ljubavlju njenom se opijaj stalno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Zašto bi se opijao, sine moj,",
            "poem": 1
          },
          {
            "text": "sa preljubnicom i grlio nedra tuđe žene?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Jer su svi čovekovi putevi pred Gospodnjim očima",
            "poem": 1
          },
          {
            "text": "i on ih odmerava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Pokvarenjaka će porobiti krivice njegove,",
            "poem": 1
          },
          {
            "text": "biće sputan vezama njegovog greha.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "I umreće, jer nije imao odgoj,",
            "poem": 1
          },
          {
            "text": "zastraniće zbog veličine svoje budalaštine.",
            "poem": 2
          }
        ]
      }
    ],
