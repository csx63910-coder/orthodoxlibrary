    "order": 20,
    "numberOfChapters": 31,
    "sha256": "7b49ed94789804258b7501c117fe02085c14f2eb48b2dc64d2ec6d6a27099e44",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/PRO/1.json",
    "lastChapterNumber": 31,
    "lastChapterApiLink": "/api/srp_onstl/PRO/31.json",
    "totalNumberOfVerses": 915
  },
  "chapter": {
    "number": 31,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Poruke cara Lemuila, proroštva kojim ga je poučila njegova majka:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Čuj, sine moj! Čuj, sine utrobe moje!",
            "poem": 1
          },
          {
            "text": "Čuj, sine zaveta mojih!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ne daj svoju snagu ženama,",
            "poem": 1
          },
          {
            "text": "ni puteve svoje onima što ruše careve.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Nije za careve, Lemuilo,",
            "poem": 1
          },
          {
            "text": "nije za careve da piju vino",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i za vladare sklonost žestokom piću.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Da ne bi uz piće zaboravili šta su odredbe,",
            "poem": 1
          },
          {
            "text": "pa onda uskratili pravo svim ojađenima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Žestoko piće ostavi za umirućeg",
            "poem": 1
          },
          {
            "text": "i vino za unesrećenu dušu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Neka takav pije, neka zaboravi svoju bedu",
            "poem": 1
          },
          {
            "text": "i svog jada neka se ne seća.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Govori umesto bezglasnog",
            "poem": 1
          },
          {
            "text": "i zastupaj sve ljude koji umiru.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Govori i sudi pravedno,",
            "poem": 1
          },
          {
            "text": "odbrani pravo siromaha i ubogog.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ko da nađe čestitu ženu?",
            "poem": 1
          },
          {
            "text": "Takva vredi mnogo više od dragulja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "U nju se pouzdaje srce njenog muža",
            "poem": 1
          },
          {
            "text": "i neće ostati bez dobitka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Dobro, a ne zlo ona mu čini",
            "poem": 1
          },
          {
            "text": "kroz sve dane života svoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Prihvata se vune i lana",
            "poem": 1
          },
          {
            "text": "pa uživa u radu ruku svojih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ona je poput trgovačkih galija,",
            "poem": 1
          },
          {
            "text": "jer izdaleka donosi sebi hleba.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Diže se dok je još mrklo,",
            "poem": 1
          },
          {
            "text": "hranu deli ukućanima",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i poslove sluškinjama svojim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Razgleda njivu pa je kupi,",
            "poem": 1
          },
          {
            "text": "od zarade svojih ruku sadi vinograd.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Odvažno se prihvata posla",
            "poem": 1
          },
          {
            "text": "i mišice svoje jača.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Uviđa da dobro zarađuje",
            "poem": 1
          },
          {
            "text": "i svetiljka joj se po noći ne gasi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Rukama se preslice dohvata,",
            "poem": 1
          },
          {
            "text": "dlanovima prihvata vreteno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Siromahu otvara šaku,",
            "poem": 1
          },
          {
            "text": "ruke pruža ubogome.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Ne strahuje za ukućane kada je sneg,",
            "poem": 1
          },
          {
            "text": "jer svi u domu nose dvostruku odeću",
            "poem": 2
          },
          {
            "noteId": 7
          },
          {
            "text": ".",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Pokrivače sebi šije",
            "poem": 1
          },
          {
            "text": "i odeću od tankoga platna i skerleta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Poznaje se njen muž na vratima",
            "poem": 1
          },
          {
            "text": "kada sedi sa starešinama zemlje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Ona šije lanene košulje i prodaje ih,",
            "poem": 1
          },
          {
            "text": "pojasevima snabdeva trgovce.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Oblači se u čast i u diku",
            "poem": 1
          },
          {
            "text": "i smeje se danu što dolazi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Mudro otvara usta svoja,",
            "poem": 1
          },
          {
            "text": "a na jeziku su joj pouke istine.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Nadgleda kako joj ukućani žive",
            "poem": 1
          },
          {
            "text": "i ne jede hleb u dokolici.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Sinovi njeni se dižu i blagosiljaju je,",
            "poem": 1
          },
          {
            "text": "a njen je muž hvali:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "„Čestite su mnoge žene",
            "poem": 1
          },
          {
            "text": "ali ti ih sve nadmašuješ!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Dopadljivost je zavodljiva i lepota je prolazna,",
            "poem": 1
          },
          {
            "text": "ali će hvaljena biti žena koja se Gospoda boji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Podajte joj nešto od ploda njenih ruku",
            "poem": 1
          },
          {
            "text": "i neka je na vratima grada hvale dela njena!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 7,
        "caller": "+",
        "text": "31,21 Ovo je prevod prema Septuaginti, a prema jevrejskom tekstu reč je o grimiznoj odeći.",
        "reference": {
          "chapter": 31,
          "verse": 21
        }
      }
    ]
