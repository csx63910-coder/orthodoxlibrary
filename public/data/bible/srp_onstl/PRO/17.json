  },
  "chapter": {
    "number": 17,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Bolji je i zalogaj suvog hleba u spokoju,",
            "poem": 1
          },
          {
            "text": "nego kuća puna žrtvenog mesa u svađi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Čestiti sluga će vladati nad nečasnim naslednikom",
            "poem": 1
          },
          {
            "text": "i deliće nasledstvo sa braćom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Topionica je za srebro i peć je za zlato,",
            "poem": 1
          },
          {
            "text": "a Gospod ispituje srca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Zlotvor pazi na usne zlikovačke,",
            "poem": 1
          },
          {
            "text": "a zavodnik sluša jezik razdora.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ko se ruga siromahu sramoti mu Sazdatelja,",
            "poem": 1
          },
          {
            "text": "nekažnjeno neće proći ko likuje zbog propasti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Unuci su starcima ko kruna",
            "poem": 1
          },
          {
            "text": "i dika su roditelji deci.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Budali ne stoje usne besedničke,",
            "poem": 1
          },
          {
            "text": "a kamoli knezu usne lažljivice.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Mito je za davaoca kao dragi kamen,",
            "poem": 1
          },
          {
            "text": "jer mu čini da uspeva gde se god okrene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ko prestup pokriva, teži ljubavi,",
            "poem": 1
          },
          {
            "text": "a ko priču prepričava razdvaja bliske prijatelje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ukor razumnoga proniče duboko,",
            "poem": 1
          },
          {
            "text": "više nego nerazumnog stotinu udaraca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Zlikovcu je samo do meteža stalo,",
            "poem": 1
          },
          {
            "text": "ali će mu biti poslan surovi poslanik.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Bolje je čoveku da nabasa na medvedicu kojoj su oteli medvediće,",
            "poem": 1
          },
          {
            "text": "nego na bezumnika u ludosti njegovoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ko na dobro zlom uzvraća,",
            "poem": 1
          },
          {
            "text": "nikada mu od zla neće počinuti kuća.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ko prepirku otpočinje, taj bujicu oslobađa.",
            "poem": 1
          },
          {
            "text": "Zato se zavade kloni pre nego što šikne.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "I onaj što opravdava krivog i onaj što okrivljuje pravog –",
            "poem": 1
          },
          {
            "text": "obojica su mrski Gospodu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Čemu blago u ruci nemudrog,",
            "poem": 1
          },
          {
            "text": "kad namere nema da mudrost zatraži?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Prijatelj voli u svako doba,",
            "poem": 1
          },
          {
            "text": "a i brat se za nevolju rađa.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Nerazuman čovek ruku pruža",
            "poem": 1
          },
          {
            "text": "i sigurno jamči za bližnjega svoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ko voli razdor voli i prestup,",
            "poem": 1
          },
          {
            "text": "posrnuće traži ko podiže vrata svoja u visine.",
            "poem": 2
          },
          {
            "noteId": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Čovek srca pokvarenog ne nalazi dobro,",
            "poem": 1
          },
          {
            "text": "a kome je pogan jezik u nevolju pada.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Žalostan je ko rodi bezumnog",
            "poem": 1
          },
          {
            "text": "i nema radosti ocu neukoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Veselo srce dobro zdravlje daje,",
            "poem": 1
          },
          {
            "text": "a duh potišteni suši kosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Pokvarenjak prima mito iz nedara",
            "poem": 1
          },
          {
            "text": "da pokvari staze pravednosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Mudrost je pred licem razumnog čoveka,",
            "poem": 1
          },
          {
            "text": "a oči bezumnog na kraju su zemlje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Budalasti sin tuga je svom ocu,",
            "poem": 1
          },
          {
            "text": "ogorčenje onoj što ga je rodila.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Nije dobro globiti pravednika",
            "poem": 1
          },
          {
            "text": "ni šibati čestite zbog pravde.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Istinski je mudar čovek štedljiv na rečima,",
            "poem": 1
          },
          {
            "text": "a ko je plemenitog duha razuman je čovek.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "I bezumnik čak se čini mudrim kada ćuti,",
            "poem": 1
          },
          {
            "text": "kad zatvara usne svoje razumnim ga drže.",
            "poem": 2
          }
        ]
      }
    ],
