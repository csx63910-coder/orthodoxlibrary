  "chapter": {
    "number": 24,
    "content": [
      {
        "type": "heading",
        "content": [
          "Dvadeseta priča"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ne zavidi zlima,",
            "poem": 1
          },
          {
            "text": "ne poželi da si s njima;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "jer u srcu svome smišljaju nasilje,",
            "poem": 1
          },
          {
            "text": "najavljuju usnama nevolju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Dvadeset prva priča"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Mudrošću se podiže kuća,",
            "poem": 1
          },
          {
            "text": "a razboritošću je osnovana;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "znanjem su joj sobe napunjene",
            "poem": 1
          },
          {
            "text": "svakim blagom poželjnim i vrednim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Dvadeset druga priča"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Čovek ratnik je jak,",
            "poem": 1
          },
          {
            "text": "ali onaj koji zna jača snagu svoju;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "jer ćeš rat dobiti mudrim savetima",
            "poem": 1
          },
          {
            "text": "i pobeda je u mnogim savetnicima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Dvadeset treća priča"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Visoka je mudrost nemudrome,",
            "poem": 1
          },
          {
            "text": "on usta svoja ne otvara na sudskim vratima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Dvadeset četvrta priča"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ko je predan da zlo smišlja",
            "poem": 1
          },
          {
            "text": "nazvaće ga spletkarošem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Greh su bezumni naumi",
            "poem": 1
          },
          {
            "text": "i podrugljivac je oduran ljudima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Dvadeset peta priča"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Kloneš li u danu nevolje,",
            "poem": 1
          },
          {
            "text": "klonuće i tvoja snaga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Spasavaj one koje u smrt vuku,",
            "poem": 1
          },
          {
            "text": "izvlači one što teturaju na pogubljenje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Jer, kažeš li – „Ali, mi to nismo znali!“ –",
            "poem": 1
          },
          {
            "text": "neće li shvatiti onaj što proniče srca?",
            "poem": 2
          },
          {
            "text": "Neće li znati onaj koji ti život čuva",
            "poem": 1
          },
          {
            "text": "i uzvratiti čoveku po delu njegovom?",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Dvadeset šesta priča"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Jedi med, sine moj, jer je zdrav",
            "poem": 1
          },
          {
            "text": "i nepcu je tvome sladak med iz saća.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Takvo je poznanje mudrosti duši tvojoj",
            "poem": 1
          },
          {
            "text": "ako je pronađeš; tada budućnost postoji",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i tvoja nada neće propasti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Dvadeset sedma priča"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ne vrebaj ko zlikovac u potaji na dom pravednika",
            "poem": 1
          },
          {
            "text": "i konačište njegovo ne ruši.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Jer padne li pravednik i sedam puta, ustaće,",
            "poem": 1
          },
          {
            "text": "a zlikovac će posrnuti u nevolji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Dvadeset osma priča"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ne raduj se dok se ruši dušmanin tvoj,",
            "poem": 1
          },
          {
            "text": "kad posrne neka ti se srce ne veseli;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "da Gospod to ne vidi i to bude zlo pred njime,",
            "poem": 1
          },
          {
            "text": "pa sa dušmanina povuče svoj gnev.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Dvadeset deveta priča"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ne žesti se zbog zlotvora,",
            "poem": 1
          },
          {
            "text": "ne zavidi zlikovcima;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "jer budućnost ne pripada zlotvoru,",
            "poem": 1
          },
          {
            "text": "dogoreva svetiljka zlikovcu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Trideseta priča"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Boj se Gospoda, sine moj, baš kao i cara;",
            "poem": 1
          },
          {
            "text": "ne druži se s buntovnima;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "jer iznenadna dolazi njihova propast",
            "poem": 1
          },
          {
            "text": "i ko će da sazna svršetak ove dvojice?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "I ovo se tiče mudrih ljudi:",
          {
            "text": "Strahota je kad se gleda ko je ko na sudu.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Naime, ko kaže zlome – „Ti si pravedan!“ –",
            "poem": 1
          },
          {
            "text": "ljudi će ga proklinjati,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "narodi ga prezirati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "A onima koji ga prekore uživanje će biti,",
            "poem": 1
          },
          {
            "text": "na njih će doći blagoslov dobra.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Usne voli onaj ko uzvraća pravednim rečima.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Posao svoj na polju završi,",
            "poem": 1
          },
          {
            "text": "pripremi njivu svoju, a onda izgradi kuću svoju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Ne svedoči bez razloga protiv bližnjeg svoga,",
            "poem": 1
          },
          {
            "text": "zar ćeš da obmanjuješ usnama svojim?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Ne reci – „Kako je on uradio meni, tako ću i ja da uradim njemu.",
            "poem": 1
          },
          {
            "text": "Uzvratiću mu po delu njegovom!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Prošao sam pored polja lenštine",
            "poem": 1
          },
          {
            "text": "i pored vinograda bezumnika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "I gle, u trnje je sve zaraslo,",
            "poem": 1
          },
          {
            "text": "koprivama sve obraslo,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "zid kameni beše srušen.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Kada sam to video, srcem sam shvatio,",
            "poem": 1
          },
          {
            "text": "video sam i prihvatio pouku:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Još malo snova, još malo dremeža,",
            "poem": 1
          },
          {
            "text": "još malo dokono da sklopiš ruke;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "i doći će tvoje siromaštvo kao skitnica",
            "poem": 1
          },
          {
            "text": "i nemaština kao nasilnik.",
            "poem": 2
          }
        ]
      }
    ],
