    "title": "Priče Solomonove",
    "order": 20,
    "numberOfChapters": 31,
    "sha256": "7b49ed94789804258b7501c117fe02085c14f2eb48b2dc64d2ec6d6a27099e44",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/PRO/1.json",
    "lastChapterNumber": 31,
    "lastChapterApiLink": "/api/srp_onstl/PRO/31.json",
    "totalNumberOfVerses": 915
  },
  "chapter": {
    "number": 23,
    "content": [
      {
        "type": "heading",
        "content": [
          "Sedma priča"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Kad sa vladarom sedaš da jedeš",
            "poem": 1
          },
          {
            "text": "pažljivo razmotri šta je pred tobom;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "nož ćeš staviti pod grlo svoje",
            "poem": 1
          },
          {
            "text": "ako si alav.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ne žudi za njegovim đakonijama,",
            "poem": 1
          },
          {
            "text": "jer je to varljiva hrana.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Osma priča"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ne napinji se da stekneš bogatstvo",
            "poem": 1
          },
          {
            "text": "i svoje se pameti prođi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Pustiš li na njega oči svoje, gle njega nema,",
            "poem": 1
          },
          {
            "text": "jer je sebi načinilo krila poput orla,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "što se vine u nebesa.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Deveta priča"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ne jedi hranu samoživca,",
            "poem": 1
          },
          {
            "text": "ne poželi đakonije njegove.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Jer kako se on u sebi preračunava,",
            "poem": 1
          },
          {
            "text": "baš je takav kada ti kaže –",
            "poem": 2
          },
          {
            "text": "„Jedi i pij!“ –",
            "poem": 1
          },
          {
            "text": "a srce mu nije s tobom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Izbljuvaćeš zalogaj koji si pojeo,",
            "poem": 1
          },
          {
            "text": "proćerdaćeš sve ljubazne reči svoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Deseta priča"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ne govori ušima bezumnog,",
            "poem": 1
          },
          {
            "text": "jer će prezreti poruku tvojih reči.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Jedanaesta priča"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ne pomiči drevni međaš,",
            "poem": 1
          },
          {
            "text": "ne zalazi u njive siročadi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Jer je jak njihov Otkupitelj,",
            "poem": 1
          },
          {
            "text": "odbraniće njihov slučaj od tebe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Dvanaesta priča"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Srce svoje predaj opomeni,",
            "poem": 1
          },
          {
            "text": "svoje uši poučnim rečima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Trinaesta priča"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ne uskraćuj kaznu detetu,",
            "poem": 1
          },
          {
            "text": "jer neće da umre ako ga i udariš šibom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Tuci ga šibom",
            "poem": 1
          },
          {
            "text": "i dušu mu od Sveta mrtvih spasi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Četrnaesta priča"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "O, moj sine, ako ti je srce mudro",
            "poem": 1
          },
          {
            "text": "i moje se srce raduje;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "raduje se nutrina moja,",
            "poem": 1
          },
          {
            "text": "kad ti usne čestito govore.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Petnaesta priča"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Nek ti srce grešnicima ne zavidi,",
            "poem": 1
          },
          {
            "text": "u bogobojaznosti ti povazdan budi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Nema sumnje, budućnost postoji,",
            "poem": 1
          },
          {
            "text": "tvoja nada neće propasti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Šesnaesta priča"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Sine moj, poslušaj i mudar budi,",
            "poem": 1
          },
          {
            "text": "svoje srce ti na put usmeri.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Ne druži se sa onima što se vinom opijaju,",
            "poem": 1
          },
          {
            "text": "sa onima koji žderu meso.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Jer, osiromašiće i pijanica i izelica,",
            "poem": 1
          },
          {
            "text": "mamurluk će ih obući u dronjke.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Sedamnaesta priča"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Slušaj oca svoga što te je rodio,",
            "poem": 1
          },
          {
            "text": "majku svoju ne preziri ni kada ostari.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Istinu kupuj i ne prodaji",
            "poem": 1
          },
          {
            "text": "mudrost, prekor i pouku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Jako se raduje otac pravednog sina,",
            "poem": 1
          },
          {
            "text": "ko je rodio mudrog sina uživa u njemu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Neka se raduju i otac tvoj i majka tvoja,",
            "poem": 1
          },
          {
            "text": "neka se veseli ona koja te je rodila.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Osamnaesta priča"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Srce mi svoje daj, sine moj,",
            "poem": 1
          },
          {
            "text": "i neka ti oči počivaju na putevima mojim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Jer bludnica je duboka jama,",
            "poem": 1
          },
          {
            "text": "tuđinka je uzano ždrelo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Ona je ko lopov što vreba iz potaje",
            "poem": 1
          },
          {
            "text": "i među muškarcima umnožava neverne.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Devetnaesta priča"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Ko to kuka? Ko to ječi?",
            "poem": 1
          },
          {
            "text": "Ko se svađa? Ko to prigovara?",
            "poem": 2
          },
          {
            "text": "Ko ima rane bezrazložne",
            "poem": 1
          },
          {
            "text": "i kome su zakrvavljene oči?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Onima što se izležavaju kraj vina,",
            "poem": 1
          },
          {
            "text": "onima što idu da probaju vino izmešano.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Ne gledaj vino dok se rumeni,",
            "poem": 1
          },
          {
            "text": "dok se svetluca u čaši,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "dok lagano klizi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Kao zmija na kraju ujeda,",
            "poem": 1
          },
          {
            "text": "kao otrovnica ubada.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Čudne će prizore da vide oči tvoje",
            "poem": 1
          },
          {
            "text": "i srce govoriće ludorije.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Bićeš kao onaj što leži usred mora,",
            "poem": 1
          },
          {
            "text": "kao onaj što leži navrh jarbola.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "I reći ćeš: „Udarili su me, a bolestan nisam,",
            "poem": 1
          },
          {
            "text": "tukli su me, osetio nisam.",
            "poem": 2
          },
          {
            "text": "Kada ću se probuditi",
            "poem": 1
          },
          {
            "text": "da ponovo potražim piće?“",
            "poem": 2
          }
        ]
      }
    ],
