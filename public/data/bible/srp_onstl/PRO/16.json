  "chapter": {
    "number": 16,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Čovek nešto srcem namerava,",
            "poem": 1
          },
          {
            "text": "ali od Gospoda je jezika odgovor.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "U očima svojim čoveku su čisti putevi,",
            "poem": 1
          },
          {
            "text": "ali Gospod proverava namere srca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Svoja dela prepusti Gospodu",
            "poem": 1
          },
          {
            "text": "i učvrstiće tvoje naume.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Gospod je načinio sve za svoju svrhu,",
            "poem": 1
          },
          {
            "text": "pa čak i zlobnika za dan stradanja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Gospodu je mrsko svako uznosito srce.",
            "poem": 1
          },
          {
            "text": "Nema sumnje da taj neće proći nekažnjeno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Milošću i istinom otkupljuje se krivica",
            "poem": 1
          },
          {
            "text": "i bogobojaznost odvraća od zla.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Kada su Gospodu mili čovekovi putevi,",
            "poem": 1
          },
          {
            "text": "on ga i sa neprijateljima njegovim miri.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Bolje je i malo, a po pravdi,",
            "poem": 1
          },
          {
            "text": "nego obilje stečenog, a po nepravdi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Srce čovekovo smera svojim putem,",
            "poem": 1
          },
          {
            "text": "ali Gospod usmerava njegove korake.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Car presuđuje nadahnutom objavom",
            "poem": 1
          },
          {
            "text": "i odluke mu nisu nepravedne.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Pravedne su Gospodnje mere i terazije,",
            "poem": 1
          },
          {
            "text": "svi tegovi u torbi njegovo su delo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Gadost je kad carevi pokvareno rade,",
            "poem": 1
          },
          {
            "text": "jer se pravednošću učvršćuje presto.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Carevi cene pravdoljubiva usta,",
            "poem": 1
          },
          {
            "text": "oni vole onog ko iskreno zbori.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Careva je srdžba kao vesnik smrti",
            "poem": 1
          },
          {
            "text": "i mudar je čovek gasi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Život je u vedrini carevog lica,",
            "poem": 1
          },
          {
            "text": "naklonost je njegova kao oblak prolećne kiše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Koliko je bolje težiti mudrosti nego zlatu,",
            "poem": 1
          },
          {
            "text": "težiti umnosti više nego težiti srebru!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Put čestitih je odvraćanje od zla,",
            "poem": 1
          },
          {
            "text": "život svoj čuva onaj ko svoj put sačuva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Pred propašću ide ponos",
            "poem": 1
          },
          {
            "text": "i pred padom ide duh nadmeni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "S poniznima bolje biti ponizan,",
            "poem": 1
          },
          {
            "text": "nego plen deliti s bahatima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Dobro nalazi ko na reč pripazi",
            "poem": 1
          },
          {
            "text": "i kako je blagosloven onaj ko se u Gospoda pouzda!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Promućurnim zovu onog srca mudrog",
            "poem": 1
          },
          {
            "text": "i ljubazne usne su uverljivije.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Vrelo je života pronicljivost onima što je imaju,",
            "poem": 1
          },
          {
            "text": "a bezumlje je šiba bezumnima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Srce mudrome daje šta će da kaže",
            "poem": 1
          },
          {
            "text": "i usnama njegovim jača ubedljivu pouku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Medeno saće su reči ljubazne,",
            "poem": 1
          },
          {
            "text": "slast su duši i zdravlje kostima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Neki put pred čovekom kao da je prav,",
            "poem": 1
          },
          {
            "text": "ali završava na putevima smrti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Sebi radi ko god da radi,",
            "poem": 1
          },
          {
            "text": "jer ga gladna usta nagone na to.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Ništarija iskopava zlo",
            "poem": 1
          },
          {
            "text": "i usne su mu poput vatre koja prlji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Spletkaroš spletke spliće",
            "poem": 1
          },
          {
            "text": "i klevetnik razdvaja bliske prijatelje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Nasilnik mami bližnjeg svoga",
            "poem": 1
          },
          {
            "text": "i groznim ga putem vodi;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "namiguje očima i gadosti smišlja,",
            "poem": 1
          },
          {
            "text": "stiska usta i zlo postiže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Prelepa je kruna kosa seda",
            "poem": 1
          },
          {
            "text": "kad se nađe na pravednom putu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Bolji je dugotrpljiv čovek od junaka,",
            "poem": 1
          },
          {
            "text": "i onaj koji sobom vlada od osvajača grada.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "U krilo se kocka baca,",
            "poem": 1
          },
          {
            "text": "ali od Gospoda dolazi svaka odluka njena.",
            "poem": 2
          }
        ]
      }
    ],
