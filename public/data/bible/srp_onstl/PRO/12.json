  },
  "chapter": {
    "number": 12,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ko voli opomenu voli znanje,",
            "poem": 1
          },
          {
            "text": "a prostak je ko prezire ukor.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Dobar čovek dobija Gospodnju naklonost,",
            "poem": 1
          },
          {
            "text": "a on proklinje čoveka koji pravi spletke.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Pokvarenošću se niko neće učvrstiti,",
            "poem": 1
          },
          {
            "text": "a koren je pravednika nepokolebljiv.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Čestita je žena kruna mužu svome,",
            "poem": 1
          },
          {
            "text": "a žena raskalašna mu je kao trulež u kostima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Pravedni su naumi pravednika,",
            "poem": 1
          },
          {
            "text": "a saveti pokvarenih su obmana.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Reči zlih ljudi krv vrebaju u zasedi,",
            "poem": 1
          },
          {
            "text": "a čestiti se ustima svojim oslobađaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Zlikovci se ruše i više ih nema,",
            "poem": 1
          },
          {
            "text": "a dom pravednika istrajava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Čovek se ceni prema razboritosti svojoj,",
            "poem": 1
          },
          {
            "text": "a srce pokvarenjaka biće prezreno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Bolji je neugledan čovek, a sa slugom,",
            "poem": 1
          },
          {
            "text": "nego onaj što uzdiže sebe, a nema da jede.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Pravednik se brine i za dobro svojih životinja,",
            "poem": 1
          },
          {
            "text": "a zlobnici su okrutni i kad se smiluju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Izobilje hrane ima onaj koji svoju zemlju radi,",
            "poem": 1
          },
          {
            "text": "a šupljoglavac teži bezvrednim stvarima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Zlobnik žudi za zlim plenom,",
            "poem": 1
          },
          {
            "text": "a koren pravednika je plodonosan.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Zlobniku je zamka u grehu usana,",
            "poem": 1
          },
          {
            "text": "a pravednik se kloni nevolje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Čovek se nasiti dobra plodom usta svojih",
            "poem": 1
          },
          {
            "text": "i vrati mu se sve što rukama radi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Bezumnik smatra da živi ispravno,",
            "poem": 1
          },
          {
            "text": "ali je mudar onaj ko sluša savet.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Bezumnikov se gnev odmah prepozna,",
            "poem": 1
          },
          {
            "text": "a ko je obazriv pokriva sramotu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Kad verni svedok svedoči, on objavljuje pravdu,",
            "poem": 1
          },
          {
            "text": "a lažljivi svedok obmanjuje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ima ljudi koji govore nesmotreno kao da bodu mačem,",
            "poem": 1
          },
          {
            "text": "a jezik mudrih leči.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Istinoljubiva usta će doveka utvrđena biti,",
            "poem": 1
          },
          {
            "text": "a lažljivi jezik će nestati dok trepnem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Obmana je u srcu onih što smišljaju zlo,",
            "poem": 1
          },
          {
            "text": "a radost sleduje one što zovu na mir.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Pravednika ne snalazi nikakva nevolja,",
            "poem": 1
          },
          {
            "text": "a zlikovci su puni nemira.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Lažljive su usne odurne Gospodu,",
            "poem": 1
          },
          {
            "text": "a milina su mu istinotvorci.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Obazriv čovek ne otkriva znanje,",
            "poem": 1
          },
          {
            "text": "a srce budalastih razglašava bezumlje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Ruka marljivih ljudi će vladati,",
            "poem": 1
          },
          {
            "text": "a lenština mora da robuje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Srce što strepi povija čoveka,",
            "poem": 1
          },
          {
            "text": "a dobra reč ga vedri.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Pravednik bira sebi prijatelja,",
            "poem": 1
          },
          {
            "text": "a nepravednike zavodi put njihov.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Nema pečenja za lenštinu,",
            "poem": 1
          },
          {
            "text": "čoveku je blago marljivost njegova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Život je na putu pravednosti",
            "poem": 1
          },
          {
            "text": "i nema smrti na njenoj stazi.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
