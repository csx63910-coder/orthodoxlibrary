    "name": "Priče Solomonove",
    "commonName": "Priče Solomonove",
    "title": "Priče Solomonove",
    "order": 20,
    "numberOfChapters": 31,
    "sha256": "7b49ed94789804258b7501c117fe02085c14f2eb48b2dc64d2ec6d6a27099e44",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/PRO/1.json",
    "lastChapterNumber": 31,
    "lastChapterApiLink": "/api/srp_onstl/PRO/31.json",
    "totalNumberOfVerses": 915
  },
  "chapter": {
    "number": 22,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Bolje je izabrati ime nego bogatstvo golemo",
            "poem": 1
          },
          {
            "text": "i blagonaklonost je bolja od srebra i zlata.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "I bogataš i siromah se sreću,",
            "poem": 1
          },
          {
            "text": "jer sve ih je Gospod sazdao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Obazriv čovek primeti nevolju, pa se skrije,",
            "poem": 1
          },
          {
            "text": "a lakoverni idu dalje i budu kažnjeni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Obilje, čast i život su nagrada",
            "poem": 1
          },
          {
            "text": "za poniznost i bogobojaznost.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Zamke su i trnje na stazi podlaca",
            "poem": 1
          },
          {
            "text": "a od njih je podaleko onaj koji čuva dušu svoju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Vaspitaj dete za put kojim mu valja ići",
            "poem": 1
          },
          {
            "text": "pa i kada ostari od njega se odmaknuti neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Bogati vlada siromasima,",
            "poem": 1
          },
          {
            "text": "a ko zajmi služi zajmodavcu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ko nepravdu seje nevolju će žeti,",
            "poem": 1
          },
          {
            "text": "slomiće se šiba gneva njegovoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Blagosloven biće darežljivi,",
            "poem": 1
          },
          {
            "text": "jer daje siromahu parče svoga hleba.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Oteraš li podrugljivca, svađa prestaće,",
            "poem": 1
          },
          {
            "text": "parničenje i sramota nestaće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ko voli čisto srce i milost mu je na usnama",
            "poem": 1
          },
          {
            "text": "ima cara za prijatelja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Oči Gospodnje čuvaju znanje,",
            "poem": 1
          },
          {
            "text": "on obara reči onih što nepravdu čine.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Lenština govori: „Lav je na ulici!",
            "poem": 1
          },
          {
            "text": "Zaklaće me nasred trga!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Jama duboka usta su bludnice,",
            "poem": 1
          },
          {
            "text": "u nju pašće onaj na koga je Gospod srdit.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Dečije je srce svezano bezumljem",
            "poem": 1
          },
          {
            "text": "koje šiba opomene nadaleko od njega uklanja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "I ko tlači siromaha da za sebe zgrne",
            "poem": 1
          },
          {
            "text": "i ko daje bogatome, sigurno im sledi nemaština.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Prva priča"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Prikloni uho, poslušaj reči mudrih ljudi",
            "poem": 1
          },
          {
            "text": "i srce prikloni mom znanju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Jer će ti biti zadovoljstvo da ih držiš u sebi,",
            "poem": 1
          },
          {
            "text": "da budu spremne na usnama tvojim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "A da ti u Gospodu pouzdanje bude,",
            "poem": 1
          },
          {
            "text": "ja ti ih danas objavljujem, baš tebi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Nisam li ih za tebe zapisao",
            "poem": 1
          },
          {
            "text": "trideset mudrih priča",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kroz savete i znanje;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "da te upoznam s istinitošću pouzdanih reči,",
            "poem": 1
          },
          {
            "text": "kako bi uzvratio pouzdanim rečima onima koji te šalju?",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Druga priča"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Ne otimaj siromahu jer je siromah,",
            "poem": 1
          },
          {
            "text": "ne satiri ubogoga na sudskim vratima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Jer Gospod će braniti njegov slučaj",
            "poem": 1
          },
          {
            "text": "i oteće dušu onima što njima otimaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Treća priča"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Ne druži se s razjarenim,",
            "poem": 1
          },
          {
            "text": "ne idi sa besnim čovekom;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "jer ćeš naviknuti na puteve njegove",
            "poem": 1
          },
          {
            "text": "i sebe ćeš uplesti u zamku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Četvrta priča"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Ne budi od onih koji ruku daju",
            "poem": 1
          },
          {
            "text": "i od onih koji jamče za dugove.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Ako nemaš dovoljno da platiš,",
            "poem": 1
          },
          {
            "text": "zašto da ti neko uzme i postelju ispod tebe?",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Peta priča"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Ne pomiči drevni međaš",
            "poem": 1
          },
          {
            "text": "što su tvoji preci postavili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Šesta priča"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Da li si video čoveka veštog u svom poslu?",
            "poem": 1
          },
          {
            "text": "Pred carevima će on stajati,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a neće stajati pred beznačajnim.",
            "poem": 2
          }
        ]
      }
    ],
