  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "heading",
        "content": [
          "Zadobij mudrost po svaku cenu"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Deco, poslušajte očev prekor",
            "poem": 1
          },
          {
            "text": "i budite pažljivi da se naučite iz pouke.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Jer ja vam dobar savet dajem,",
            "poem": 1
          },
          {
            "text": "stoga ne zapostavljajte pouku moju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jer ja sam bio očev sin",
            "poem": 1
          },
          {
            "text": "i mili jedinac majke svoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "On me je učio i govorio mi:",
            "poem": 1
          },
          {
            "text": "„Neka ti srce prione čvrsto uz reči moje,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "drži se mojih zapovesti i živećeš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Stiči mudrost! Stiči razumevanje!",
            "poem": 1
          },
          {
            "text": "Ne zaboravljaj i ne otuđuj se od onoga što ti kazujem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ne napuštaj mudrost i ona će te čuvati,",
            "poem": 1
          },
          {
            "text": "voli je i braniće te.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Mudrost je najvažnija! Stiči mudrost!",
            "poem": 1
          },
          {
            "text": "Sa svom svojom stečevinom ti stiči razumevanje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Uzdiži je i uzdignuće te,",
            "poem": 1
          },
          {
            "text": "veličaće te jer si je prigrlio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Prelepi venac će ti staviti na glavu,",
            "poem": 1
          },
          {
            "text": "daće ti slavnu krunu.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Sine moj, poslušaj i prihvati reči moje",
            "poem": 1
          },
          {
            "text": "i mnogo će godina života tvoga biti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Upućujem te putem mudrosti",
            "poem": 1
          },
          {
            "text": "i pravednim te stazama vodim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Noge ti neće klecati dok hodaš",
            "poem": 1
          },
          {
            "text": "i nećeš posrtati dok budeš trčao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Drži se opomene i ne napuštaj je.",
            "poem": 1
          },
          {
            "text": "Brani je, jer ti je ona život.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ne idi stazom pokvarenjaka",
            "poem": 1
          },
          {
            "text": "i ne sledi put zlikovaca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Kloni ga se i ne idi njime,",
            "poem": 1
          },
          {
            "text": "okreni se od njega i idi dalje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Jer oni ne spavaju ako zlo ne nanesu,",
            "poem": 1
          },
          {
            "text": "san im je ukraden ako koga ne sapletu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Jer oni jedu hleb bezakonja",
            "poem": 1
          },
          {
            "text": "i nasilja vino piju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "A staza je pravednika poput svetla zore koje osvaja",
            "poem": 1
          },
          {
            "text": "i svetli dok dan ne osvane.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Dok je staza pokvarenih mračna,",
            "poem": 1
          },
          {
            "text": "pa oni i ne znaju o šta se sve spotiču.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Sine moj, pazi na moje reči",
            "poem": 1
          },
          {
            "text": "i prikloni uho svoje kazivanjima mojim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Neka se ne odmiču od očiju tvojih",
            "poem": 1
          },
          {
            "text": "i čuvaj ih usred srca svoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Jer su one život onima što ih nađu",
            "poem": 1
          },
          {
            "text": "i zdravlje su celom telu njihovome.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Od svega što se čuva ti najviše čuvaj srce svoje,",
            "poem": 1
          },
          {
            "text": "jer su u njemu izvori života.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Od sebe odbaci nepošten govor",
            "poem": 1
          },
          {
            "text": "i obmanu usana daleko baci od sebe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Oči tvoje nek gledaju pravo,",
            "poem": 1
          },
          {
            "text": "ispred sebe ti prikuj svoj pogled.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Poravnaj stazu koraka svoga",
            "poem": 1
          },
          {
            "text": "i bezbedni će biti svi tvoji putevi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Ne skreći ni desno ni levo",
            "poem": 1
          },
          {
            "text": "i korak svoj ukloni od zla.",
            "poem": 2
          }
        ]
      }
    ],
