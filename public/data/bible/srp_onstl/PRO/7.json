  "chapter": {
    "number": 7,
    "content": [
      {
        "type": "heading",
        "content": [
          "Upozorenje protiv preljubnice"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Sine moj, drži se mojih reči",
            "poem": 1
          },
          {
            "text": "i zapovesti mojih, u sebi ih čuvaj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Moje zapovesti čuvaj i živećeš,",
            "poem": 1
          },
          {
            "text": "pouku moju ko zenicu svoga oka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Veži ih oko prstiju svojih,",
            "poem": 1
          },
          {
            "text": "upiši ih na ploču srca!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Mudrosti kaži „Sestro moja!“",
            "poem": 1
          },
          {
            "text": "i „rođenom“ pronicljivost zovi;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "da te čuvaju od žene tuđinke,",
            "poem": 1
          },
          {
            "text": "od preljubnice slatkorečive.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Elem, na prozoru kuće svoje,",
            "poem": 1
          },
          {
            "text": "kroz rešetke gledao sam,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "posmatrao sam lakoverne",
            "poem": 1
          },
          {
            "text": "i među mladićima zapazio bezumnoga momka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Prolazio je ulicom, pored njenog ugla",
            "poem": 1
          },
          {
            "text": "i išao prema njenoj kući,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "potkraj dana, kad je sumrak,",
            "poem": 1
          },
          {
            "text": "usred noći i pomrčine.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "I gle, presrete ga žena u odeći bludnice",
            "poem": 1
          },
          {
            "text": "i prevejanog srca;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "napadna, jogunasta,",
            "poem": 1
          },
          {
            "text": "noge je u kući ne drže;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "sad je na ulici, sad je na trgu,",
            "poem": 1
          },
          {
            "text": "na svakom ugla vreba u zasedi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "I zgrabi ga, poljubi ga bez stida na licu",
            "poem": 1
          },
          {
            "text": "i reče mu:",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "„Imam kući meso žrtava mira,",
            "poem": 1
          },
          {
            "text": "jer sam danas ispunila zavete svoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Zato sam izašla da te sretnem,",
            "poem": 1
          },
          {
            "text": "baš tebe da tražim.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "I našla sam te.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Svoj sam krevet ukrasila zastorima,",
            "poem": 1
          },
          {
            "text": "šarenim lanom iz Egipta;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "smirnom, alojom i cimetom",
            "poem": 1
          },
          {
            "text": "ležaj sam namirisala.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Dođi! Do jutra se opijajmo ljubavlju svojom.",
            "poem": 1
          },
          {
            "text": "Hajde da se nauživamo u ljubavi!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Jer muž nije u kući svojoj,",
            "poem": 1
          },
          {
            "text": "na daleki put je otišao;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "sa sobom je poneo kesu s novcem",
            "poem": 1
          },
          {
            "text": "i neće doći kući do dana punog meseca.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Tako ga je namamila svojom uverljivom pričom,",
            "poem": 1
          },
          {
            "text": "nagovorila ga svojim zavodljivim usnama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "I on je odmah krenuo za njom,",
            "poem": 1
          },
          {
            "text": "kao vo na klanje išao je",
            "poem": 2
          },
          {
            "text": "i kao bezumnik okovan za kaznu;",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "dok mu strela ne probode jetru,",
            "poem": 2
          },
          {
            "text": "kao ptica što u zamku srlja",
            "poem": 1
          },
          {
            "text": "on i ne zna da tu glavu gubi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Zato me poslušajte, sinovi,",
            "poem": 1
          },
          {
            "text": "i pazite na ono što vam govorim!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Neka ti srce ne zastrani na puteve njene",
            "poem": 1
          },
          {
            "text": "i ne lutaj po njenim stazama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Jer mnoge smrtno ranjene je oborila",
            "poem": 1
          },
          {
            "text": "i nema broja ljudima koje je pobila.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Kuća je njena na putevima za Svet mrtvih,",
            "poem": 1
          },
          {
            "text": "a oni silaze u odaje smrti.",
            "poem": 2
          }
        ]
      }
    ],
