  "chapter": {
    "number": 9,
    "content": [
      {
        "type": "heading",
        "content": [
          "Poziv mudrosti i ludosti"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Mudrost je kuću svoju sazidala",
            "poem": 1
          },
          {
            "text": "i za nju sedam stubova isklesala.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Poklala je svoju stoku, vino svoje začinila,",
            "poem": 1
          },
          {
            "text": "svoju trpezu postavila;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "poslala je sluškinje svoje",
            "poem": 1
          },
          {
            "text": "i poziva sa najviših gradskih mesta:",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "„Neka ovde svrati ko god je lakoveran!“",
            "poem": 2
          },
          {
            "text": "A bezumnome govori:",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "„Dođite, jedite moju hranu",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i pijte vino koje sam začinila!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Okanite se lakoverja i živećete,",
            "poem": 1
          },
          {
            "text": "napredujte razumnim putem.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Sramotu na sebe navlači ko podsmevača savetuje,",
            "poem": 1
          },
          {
            "text": "sebi škodi onaj ko kori zlikovca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ne prekorevaj podsmevača da te ne bi zamrzeo,",
            "poem": 1
          },
          {
            "text": "prekorevaj mudrog i voleće te.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Reci mudrom i biće mudriji,",
            "poem": 1
          },
          {
            "text": "pouči pravednoga i učeniji će biti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Mudrost otpočinje bogobojaznošću",
            "poem": 1
          },
          {
            "text": "i znanje poznavanjem Svetog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Sa mnom će se dani tvoji umnožiti",
            "poem": 1
          },
          {
            "text": "i godina tvog života biće mnogo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ako si mudar, mudar si za svoje dobro,",
            "poem": 1
          },
          {
            "text": "a ako si podsmevač, to ti je na teret.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Bezumlje je žena goropadna,",
            "poem": 1
          },
          {
            "text": "lakoverna i ničem poučena.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ona sedi na vratima svoje kuće,",
            "poem": 1
          },
          {
            "text": "na gradskim uzvišenjima,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "dovikuje onima što putem prolaze",
            "poem": 1
          },
          {
            "text": "i stazama svojim pravo idu:",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "„Neka ovde svrati ko god je lakoveran!“",
            "poem": 2
          },
          {
            "text": "A bezumnome govori:",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "„Slatke li su ukradene vode,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ukusan li je hleb iz potaje!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ali on ne zna da su tamo pokojnici,",
            "poem": 1
          },
          {
            "text": "da su njene zvanice u dubinama Sveta mrtvih.",
            "poem": 2
          }
        ]
      }
    ],
