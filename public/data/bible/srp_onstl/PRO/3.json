  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "heading",
        "content": [
          "Blagodati mudrosti"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Sine moj, pouku moju ne zaboravljaj",
            "poem": 1
          },
          {
            "text": "i u srcu čuvaj zapovesti moje,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "jer će ti produžiti dane i godine života,",
            "poem": 1
          },
          {
            "text": "mir će ti pridodati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Milost i istina neka ne odlaze od tebe.",
            "poem": 1
          },
          {
            "text": "Veži ih oko vrata,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "upiši ih na ploču srca!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "I tad ćeš naći milost i naklonost",
            "poem": 1
          },
          {
            "text": "i u Božijim i u ljudskim očima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "U Gospoda pouzdaj se svim srcem svojim",
            "poem": 1
          },
          {
            "text": "i nemoj se oslanjati na mudrost svoju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Misli na njega na svojim putevima",
            "poem": 1
          },
          {
            "text": "da bi tvoje staze učinio ravnim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "U očima svojim nemoj biti mudar,",
            "poem": 1
          },
          {
            "text": "boj se Gospoda i beži od zla.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "To će ti telu doneti zdravlje,",
            "poem": 1
          },
          {
            "text": "kosti će ti podmladiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Daj čast Gospodu svojim dobrima",
            "poem": 1
          },
          {
            "text": "i prvinama svega što si stekao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Tada će se obilno napuniti ambari tvoji,",
            "poem": 1
          },
          {
            "text": "prelivaće se širom kace tvoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Sine moj, ne uzimaj olako Gospodnji odgoj,",
            "poem": 1
          },
          {
            "text": "i ne kloni kada te on kori,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "jer Gospod kori onog koga voli,",
            "poem": 1
          },
          {
            "text": "baš kao i otac sina u kome mu je milina.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Kako je blagosloven čovek koji je našao mudrost,",
            "poem": 1
          },
          {
            "text": "čovek koji je dobio razboritost!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Jer je ona dragocenija nego dobit od srebra,",
            "poem": 1
          },
          {
            "text": "korist je njena od zlata veća.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Vrednija je od dragulja",
            "poem": 1
          },
          {
            "text": "i ravna joj nisu sva uživanja tvoja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "U desnici njenoj je dugi život,",
            "poem": 1
          },
          {
            "text": "a u njenoj levici su bogatstvo i ugled.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Putevi su njeni putevi blagi",
            "poem": 1
          },
          {
            "text": "i sve njene staze su mirne.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ona je drvo života onima koji je se drže",
            "poem": 1
          },
          {
            "text": "i blagosloveni su oni koji su čvrsto prionuli uz nju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Mudrošću je Gospod utemeljio zemlju",
            "poem": 1
          },
          {
            "text": "i razboritošću je postavio nebesa.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Znanje je njegovo provalilo bezdane",
            "poem": 1
          },
          {
            "text": "i oblaci su prokapali rosom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Sine moj, ne skreći pogled sa toga",
            "poem": 1
          },
          {
            "text": "i očuvaj istinsku mudrost i domišljatost;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "biće to život tvojoj duši",
            "poem": 1
          },
          {
            "text": "i privezak oko tvoga vrata.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Tada ćeš spokojno koračati svojim putem",
            "poem": 1
          },
          {
            "text": "i noga se tvoja neće spotaknuti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Kad počineš, nećeš se bojati,",
            "poem": 1
          },
          {
            "text": "kada legneš slatko ćeš da spavaš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Nećeš se bojati kad strahota bane,",
            "poem": 1
          },
          {
            "text": "kada zlikovačko razaranje dođe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Jer će Gospod pored tebe biti",
            "poem": 1
          },
          {
            "text": "i čuvaće tvoj korak od zamke.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Ne uskraćuj pomoć nevoljnicima",
            "poem": 1
          },
          {
            "text": "kada su ti ruke kadre da učine.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Nemoj reći svome bližnjem –",
            "poem": 1
          },
          {
            "text": "„Sutra dođi i daću ti“ –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kada imaš to kod sebe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Ne smišljaj zlobu bližnjemu svome,",
            "poem": 1
          },
          {
            "text": "jer on sa tobom spokojno živi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Ne svađaj se s bilo kime bez razloga",
            "poem": 1
          },
          {
            "text": "ako ti nije naneo zlo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Ne zavidi nasilniku",
            "poem": 1
          },
          {
            "text": "i ne biraj bilo koju od staza njegovih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Jer je Gospodu oduran pokvarenjak,",
            "poem": 1
          },
          {
            "text": "a blizak je s čestitima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Na kući je zlikovačkoj Gospodnje prokletstvo,",
            "poem": 1
          },
          {
            "text": "a njegovi blagoslovi na kući pravednika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Rugačima Bog se ruga,",
            "poem": 1
          },
          {
            "text": "a poniznima iskazuje milost.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Mudri ljudi naslediće ugled,",
            "poem": 1
          },
          {
            "text": "a bezumnima sleduje sramota.",
            "poem": 2
          }
        ]
      }
    ],
