  },
  "chapter": {
    "number": 18,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Za željom svojom žudi samoživi čovek,",
            "poem": 1
          },
          {
            "text": "na mudrost se svaku iznervira.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Bezumnik ne uživa u razboritosti,",
            "poem": 1
          },
          {
            "text": "nego u razotkrivanju svoga srca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Kada dođe zao čovek dolaze i prezir",
            "poem": 1
          },
          {
            "text": "i bruka sa sramotom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Duboke su vode reči u ustima ljudskim",
            "poem": 1
          },
          {
            "text": "i vrelo mudrosti potok je nabujali.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Strašno je držati stranu nepravedniku",
            "poem": 1
          },
          {
            "text": "da bi pravedniku oduzeli pravdu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "U svađu srljaju usne bezumnika",
            "poem": 1
          },
          {
            "text": "i batine mu usta prizivaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Bezumnika ruše sopstvena usta",
            "poem": 1
          },
          {
            "text": "i usne mu život vrebaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Reči klevetnika su kao poslastice",
            "poem": 1
          },
          {
            "text": "što u stomak klize.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ko je lenj u poslu svome",
            "poem": 1
          },
          {
            "text": "pobratim je velikom rasipniku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ime je Gospodnje moćna kula",
            "poem": 1
          },
          {
            "text": "u koju se na visinu sklanja pravednik.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Bogatstvo je bogatome poput utvrđenja,",
            "poem": 1
          },
          {
            "text": "poput zida visokoga u mašti njegovoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Srce se čoveka uznese pred propast,",
            "poem": 1
          },
          {
            "text": "a pre časti dolazi poniznost.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Budalast je i sramotan onaj",
            "poem": 1
          },
          {
            "text": "koji uzvraća reč pre nego je čuo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "S bolešću se svojom nosi duh u čoveku.",
            "poem": 1
          },
          {
            "text": "Ali ko se nosi s duhom utučenim?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Znanju teži srce promućurnog,",
            "poem": 1
          },
          {
            "text": "a i uho mudrog predano je njemu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Čovek darom sebi put otvara",
            "poem": 1
          },
          {
            "text": "i on ga odvodi pred velike ljude.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "U pravu je ko je prvi u svojoj parnici,",
            "poem": 1
          },
          {
            "text": "ali onda dođe njegov bližnji pa ga ispituje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Žreb prekida razmirice",
            "poem": 1
          },
          {
            "text": "i neslogu među moćnicima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Uvređeni brat je tvrđi od utvrđenog grada",
            "poem": 1
          },
          {
            "text": "i razmirice su kao rešetka tvrđave.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Plodom usta svojih siti čovek stomak svoj,",
            "poem": 1
          },
          {
            "text": "siti ga plodom usana svojih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Jezik vlada i životom i smrću;",
            "poem": 1
          },
          {
            "text": "ko ga voli, ješće njegov plod.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Ko nađe ženu, našao je blago,",
            "poem": 1
          },
          {
            "text": "blagodat je dobio od Gospoda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Molećivo siromah besedi,",
            "poem": 1
          },
          {
            "text": "a bogataš oštro odgovara.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Čovek s mnogo prijatelja može i da strada,",
            "poem": 1
          },
          {
            "text": "ali ima prijatelja prisnijih od brata.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
