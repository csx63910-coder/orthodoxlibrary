  "chapter": {
    "number": 10,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Mudre priče Solomona:",
          {
            "text": "Mudar sin raduje svog oca,",
            "poem": 1
          },
          {
            "text": "a bezuman sin je žalost majci svojoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Beskorisno je nepošteno bogatstvo,",
            "poem": 1
          },
          {
            "text": "a pravednost izbavlja od smrti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ne da Gospod da je gladna duša pravednika,",
            "poem": 1
          },
          {
            "text": "a žudnju zlikovca odbacuje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Siromah je ko god radi rukama lenjivim,",
            "poem": 1
          },
          {
            "text": "a bogatstvo stiču ruke marljivih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Mudar je sin koji leti sakuplja,",
            "poem": 1
          },
          {
            "text": "a sramotno radi sin što o žetvi spava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Blagoslovi su nad glavom pravednika,",
            "poem": 1
          },
          {
            "text": "a usta zlikovaca nasilje skrivaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Blaženo je sećanje na pravednika,",
            "poem": 1
          },
          {
            "text": "a spomen na zlikovca će istruliti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Čovek mudrog srca prihvata zapovesti,",
            "poem": 1
          },
          {
            "text": "a blebetavi bezumnik će satrven biti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Spokojno živi ko čestito živi,",
            "poem": 1
          },
          {
            "text": "a ko nakaradno živi biće razotkriven.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Jad zadaje ko okom namiguje,",
            "poem": 1
          },
          {
            "text": "a blebetalo će satrveno biti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Usta su pravednikova vrelo života,",
            "poem": 1
          },
          {
            "text": "a usta zlikovaca nasilje skrivaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Mržnja zameće svađu,",
            "poem": 1
          },
          {
            "text": "a ljubav sve grehe pokriva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Mudrost ćeš naći na usnama oštroumnog,",
            "poem": 1
          },
          {
            "text": "a batina je za leđa bezumnoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Mudri ljudi sabiraju znanje,",
            "poem": 1
          },
          {
            "text": "a brbljiva usta blizu su propasti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Bogatstvo je bogatome poput utvrđenja,",
            "poem": 1
          },
          {
            "text": "a siromasima siromaštvo njihovo poput ruševine.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Pravedniku je život nagrada,",
            "poem": 1
          },
          {
            "text": "a kazna za grehe naknada zlikovcu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Na stazi života je onaj ko pazi na opomenu,",
            "poem": 1
          },
          {
            "text": "a tumara onaj ko ne mari za ukor.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Bezumnik je ko prikriva mržnju lažljivim usnama,",
            "poem": 1
          },
          {
            "text": "a širi klevetu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Kad je reči mnogo, greh je neizbežan;",
            "poem": 1
          },
          {
            "text": "razborito čini onaj ko zauzda usta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Srebro je probrano pravednikov jezik,",
            "poem": 1
          },
          {
            "text": "a srce zlikovca male je vrednosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Mnoge hrane usta pravednika,",
            "poem": 1
          },
          {
            "text": "a bezumni ginu zbog bezumlja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Gospodnji blagoslov obogaćuje",
            "poem": 1
          },
          {
            "text": "i tegobu sa sobom ne nosi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Zlobniku je zloba ko zabava,",
            "poem": 1
          },
          {
            "text": "a mudrost je za promišljenog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Zlikovca stiže ono čega se boji,",
            "poem": 1
          },
          {
            "text": "a pravednom se želja ispunjava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Kao kad prohuji vihor vetar, tako ni zlikovca nema,",
            "poem": 1
          },
          {
            "text": "a pravednikovi temelji su večni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Kao sirće zubima i dim očima,",
            "poem": 1
          },
          {
            "text": "takav je lenština onome ko ga uposli.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Bogobojaznost umnožava dane,",
            "poem": 1
          },
          {
            "text": "a godine zlikovaca će se skratiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Pravedni se raduju u nadi,",
            "poem": 1
          },
          {
            "text": "a nada će zlobnih da ishlapi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Put Gospodnji je tvrđava čestitome,",
            "poem": 1
          },
          {
            "text": "a propast za zlotvore.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Pravednika neće doveka poljuljati,",
            "poem": 1
          },
          {
            "text": "a zlotvori neće naseliti zemlju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Mudrošću rađaju usta pravednika,",
            "poem": 1
          },
          {
            "text": "a jezik će razvratnika iščupan da bude.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Uživanje nije strano pravednim usnama,",
            "poem": 1
          },
          {
            "text": "a ni razvrat ustima zlikovca.",
            "poem": 2
          }
        ]
      }
    ],
