  },
  "chapter": {
    "number": 27,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ne hvali se sutrašnjim danom,",
            "poem": 1
          },
          {
            "text": "jer ne znaš šta donosi taj dan.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Drugi nek te hvali, a ne ti sebe samog;",
            "poem": 1
          },
          {
            "text": "neznanac, a ne usne tvoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Težak je kamen i pesak je težak,",
            "poem": 1
          },
          {
            "text": "ali od oboje je teži bezobrazluk bezočnoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Okrutan je bes, srdžba je goropadna",
            "poem": 1
          },
          {
            "text": "i sa ljubomorom ko da se suoči?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Javni ukor je bolji",
            "poem": 1
          },
          {
            "text": "od tajne ljubavi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Pouzdanije su modrice od onoga koji te voli",
            "poem": 1
          },
          {
            "text": "od mnogih poljubaca onoga koji te mrzi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Sita duša saće meda gazi,",
            "poem": 1
          },
          {
            "text": "a gladnoj je duši slatko i sve gorko.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Poput ptice proterane iz gnezda,",
            "poem": 1
          },
          {
            "text": "takav je i čovek proteran iz svog zavičaja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ulje i miris dragi su srcu",
            "poem": 1
          },
          {
            "text": "i sladak je prijatelj koji od srca savetuje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ne napuštaj prijatelja i prijatelja svog oca;",
            "poem": 1
          },
          {
            "text": "ne odlazi u dom svoga brata na dan svoje nevolje;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "bolji je sused koji je blizu, nego brat koji je daleko.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Mudar budi, sine moj, i srce mi razveseli,",
            "poem": 1
          },
          {
            "text": "pa da mogu podrugljivcu rečju da uzvratim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Obazriv čovek primeti nevolju, pa se skrije,",
            "poem": 1
          },
          {
            "text": "a lakoverni idu dalje i budu kažnjeni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Uzmi haljinu onome što jamči za tuđinca,",
            "poem": 1
          },
          {
            "text": "i zalog mu uzmi kad jamči za tuđinku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ko od ranog jutra svoga bližnjeg blagosilja na sav glas,",
            "poem": 1
          },
          {
            "text": "to će mu se računati kao kletva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Žena svadljiva je poput stalnog prokišnjavanja",
            "poem": 1
          },
          {
            "text": "po kišnom danu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ko nju obuzdava, vetar obuzdava",
            "poem": 1
          },
          {
            "text": "i kao da drži ulje u desnici.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Gvožđe se o gvožđe oštri,",
            "poem": 1
          },
          {
            "text": "a čovek se oštri o čoveka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Od smokvinog ploda ješće ko se za nju brine;",
            "poem": 1
          },
          {
            "text": "poštovan će biti onaj koji štiti svoga gospodara.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Kao što se lice odslikava u vodi",
            "poem": 1
          },
          {
            "text": "tako se i srce čoveka u čoveku vidi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Kao što su i Svet mrtvih i trulež mrtvih nezasiti,",
            "poem": 1
          },
          {
            "text": "tako su nezasite i oči čoveka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Topionica je za srebro i peć je za zlato,",
            "poem": 1
          },
          {
            "text": "a čovek se iskušava pohvalama koje prima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Istucaš li tučkom nerazumnog",
            "poem": 1
          },
          {
            "text": "sa prekrupom u avanu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "njegova se ludost neće skinuti sa njega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Svoje stado dobro pazi,",
            "poem": 1
          },
          {
            "text": "pobrini se dobro za krda svoja;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "jer imetak ne traje doveka,",
            "poem": 1
          },
          {
            "text": "a ni kruna kroz sva pokolenja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Kosi se trava da nova nikne,",
            "poem": 1
          },
          {
            "text": "sakupi se seno po brdima;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "jagnjad te oblače,",
            "poem": 1
          },
          {
            "text": "a jarcima plaćaš za polja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Tad imaš obilje kozjeg mleka sebi za hranu,",
            "poem": 1
          },
          {
            "text": "za hranu ukućana, za život sluškinja svojih.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
