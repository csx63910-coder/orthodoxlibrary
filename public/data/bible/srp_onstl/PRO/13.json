  "chapter": {
    "number": 13,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Mudar sin prihvata očevo vaspitanje,",
            "poem": 1
          },
          {
            "text": "a podrugljivac ne sluša ukor.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Čovek se nasiti dobra od ploda usta svojih,",
            "poem": 1
          },
          {
            "text": "a pokvarenjaci su gladni nasilja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ko god čuva usta svoja čuva život svoj,",
            "poem": 1
          },
          {
            "text": "a propast sleduje onome ko širi svoje usne.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Duša lenštine je gladna, ali nema ništa,",
            "poem": 1
          },
          {
            "text": "a duša se marljivih ljudi nahrani.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Pravednik mrzi laž,",
            "poem": 1
          },
          {
            "text": "a zlobnik odurno i sramno postupa.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Pravednost čuva put čestitog,",
            "poem": 1
          },
          {
            "text": "a nepravda obara grešnika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Neko sebe predstavlja bogatim, ali nema ništa,",
            "poem": 1
          },
          {
            "text": "a neko sebe predstavlja siromašnim, a prebogat je.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Čovek bogatstvom otkupljuje dušu svoju,",
            "poem": 1
          },
          {
            "text": "a siromah i ne čuje pretnju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Svetlo pravednika blešti,",
            "poem": 1
          },
          {
            "text": "a svetiljka zlikovaca gasne.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Bahatost jedino razdor izaziva,",
            "poem": 1
          },
          {
            "text": "a mudrost je kod onih koji primaju savet.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Naglo stečeno bogatstvo se umanjuje,",
            "poem": 1
          },
          {
            "text": "a uvećava se ono sakupljano radom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Dugotrajno nadanje žalosti srce,",
            "poem": 1
          },
          {
            "text": "a ispunjena želja je kao drvo života.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ko prezire reč sebi samom škodi,",
            "poem": 1
          },
          {
            "text": "a ko strahuje od zapovesti nagrađen će biti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Mudračeva pouka vrelo je života",
            "poem": 1
          },
          {
            "text": "i odvraća od smrtnih zamki.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Pronicljivost stiče naklonost,",
            "poem": 1
          },
          {
            "text": "a put nevernih je nepromenjiv.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Svaki obazriv čovek radi prema znanju,",
            "poem": 1
          },
          {
            "text": "a bezumni širi bezumlje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Glasnik zla u zlo pada,",
            "poem": 1
          },
          {
            "text": "a svedok istine leči.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Siromaštvo i sramota stižu onog ko ne mari za opomenu,",
            "poem": 1
          },
          {
            "text": "a počašćen će biti onaj ko prihvata ukor.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Slatka je duši želja ispunjena,",
            "poem": 1
          },
          {
            "text": "a bezumniku je mrsko da se od zla odvrati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Biće mudar ko ide s mudrima,",
            "poem": 1
          },
          {
            "text": "a nastradaće ko se druži s bezumnima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Grešnike propast progoni,",
            "poem": 1
          },
          {
            "text": "a pravednici su dobrom nagrađeni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Dobar čovek ostavlja nasledstvo unucima,",
            "poem": 1
          },
          {
            "text": "a grešnikova se dobra čuvaju za pravednika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Obilje je hrane na neuzoranom polju siromaha,",
            "poem": 1
          },
          {
            "text": "ali ga nepravda odnosi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Ko svoj prut štedi mrzi svoga sina,",
            "poem": 1
          },
          {
            "text": "a voli ga ko ga na vreme kori.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Kada jede, pravedniku se duša najede,",
            "poem": 1
          },
          {
            "text": "a stomak zlobnika ostaje gladan.",
            "poem": 2
          }
        ]
      }
    ],
