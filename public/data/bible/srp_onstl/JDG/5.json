  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "heading",
        "content": [
          "Devorina pesma"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Tog dana su Devora i Varak, sin Avinoamov, ispevali pesmu:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Zato što su vođe izrailjske na čelo stupile,",
            "poem": 1
          },
          {
            "text": "zato što se narod voljno odazvao – blagosiljajte Gospoda!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Čujte, carevi, slušajte, vladari!",
            "poem": 1
          },
          {
            "text": "Zapevaću Gospodu, ispevaću pesmu Gospodu, Bogu Izrailjevu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Kad si silazio sa Sira, Gospode,",
            "poem": 1
          },
          {
            "text": "kad si stupao sa polja edomskih,",
            "poem": 2
          },
          {
            "text": "zemlja se tresla, nebesa su pljuštala,",
            "poem": 1
          },
          {
            "text": "oblaci su vodom zapljuštali.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Gore su se tresle",
            "poem": 1
          },
          {
            "noteId": 2
          },
          {
            "text": "pred Gospodom,",
            "poem": 1
          },
          {
            "text": "pred Gospodom sinajskim, Bogom Izrailjevim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "U dane Samegara, sina Anatova, u dane Jaile,",
            "poem": 1
          },
          {
            "text": "putevi su opusteli, te su putnici",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "hodali po stazama krivudavim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Sela izrailjska opusteše,",
            "poem": 1
          },
          {
            "text": "dok ne ustah ja, Devora, dok ne ustah",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da Izrailju budem majka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Kad su bogove nove birali,",
            "poem": 1
          },
          {
            "text": "rat im stiže na gradske kapije.",
            "poem": 2
          },
          {
            "text": "Zar se štit video u Izrailju,",
            "poem": 1
          },
          {
            "text": "ili koplje među četrdeset hiljada?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Srce je moje uz vođe Izrailjeve,",
            "poem": 1
          },
          {
            "text": "i uz one što se voljno odazvaše.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Blagosiljajte Gospoda!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Vi što jašete bele magarice,",
            "poem": 1
          },
          {
            "text": "i sedite na prostirkama,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "vi što putevima hodite,",
            "poem": 2
          },
          {
            "text": "razaberite",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "glas pevača kod bunara.",
            "poem": 1
          },
          {
            "text": "Tamo oni poju o pravednim delima Gospodnjim,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "o pravednim delima njegovih meštana u Izrailju.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Tada narod Gospodnji siđe k vratima.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Probudi se, probudi, Devoro,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "probudi se i pesmu zapevaj!",
            "poem": 2
          },
          {
            "text": "Ustani, Varače, i roblje povedi,",
            "poem": 1
          },
          {
            "text": "ti sine Avinoamov!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Šačica je moćni narod nadvladala,",
            "poem": 1
          },
          {
            "text": "narod se Gospodnji sabrao k meni na moćne.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Od Jefrema izađoše oni što ponikoše među Amaličanima,",
            "poem": 1
          },
          {
            "text": "za tobom je Venijamin s tvojim mnoštvima,",
            "poem": 2
          },
          {
            "text": "od Mahira su izašli zapovednici,",
            "poem": 1
          },
          {
            "text": "a od Zavulona oni što štap pisarski nose.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Knezovi su Isaharovi sa Devorom,",
            "poem": 1
          },
          {
            "text": "Isahar se za Varakom u dolinu sjurio,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "u stopu ga je verno pratio.",
            "poem": 2
          },
          {
            "text": "Među četama Ruvimovim,",
            "poem": 1
          },
          {
            "text": "dugo se na odluku nakanjuju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Zašto sediš među torovima?",
            "poem": 1
          },
          {
            "text": "Da čuješ kako dozivaju stada?",
            "poem": 2
          },
          {
            "text": "Među četama Ruvimovim,",
            "poem": 1
          },
          {
            "text": "dugo se na odluku nakanjuju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Galad počiva s one strane Jordana;",
            "poem": 1
          },
          {
            "text": "a što Dan još sedi u lađama?",
            "poem": 2
          },
          {
            "text": "Asir sedi uz obalu morsku,",
            "poem": 1
          },
          {
            "text": "mirno živi u svojim lukama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Zavulon je narod što se narugao smrti,",
            "poem": 1
          },
          {
            "text": "kao i Neftalim sa polja visokih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Carevi su došli i ratovali,",
            "poem": 1
          },
          {
            "text": "u boj stupiše carevi hananski",
            "poem": 2
          },
          {
            "text": "kod Tanaha, kraj voda megidskih,",
            "poem": 1
          },
          {
            "text": "alʼ se plena – srebra ne domogoše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "S neba su zvezde ratovale,",
            "poem": 1
          },
          {
            "text": "sa svojih su staza sa Siserom ratovale.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Odnese ih potok Kison, potok drevni, potok Kison.",
            "poem": 1
          },
          {
            "text": "Stupaj smelo, dušo moja!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Kopita su tad konjska zatutnjala,",
            "poem": 1
          },
          {
            "text": "u galop, u galop udariše pastuvi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "’Proklinjite Meroz!’ – reče Anđeo Gospodnji.",
            "poem": 1
          },
          {
            "text": "’Ljuto proklinjite njegove meštane,",
            "poem": 2
          },
          {
            "text": "jer ne pritekoše u pomoć Gospodu,",
            "poem": 1
          },
          {
            "text": "ne pomogoše Gospodu protiv moćnih.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Blagoslovena nek je Jaila među ženama,",
            "poem": 1
          },
          {
            "text": "žena Hevera Kenejca,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "blagoslovenija nek je od svih žena šatora.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Kad je tražio vode, mleka mu nali,",
            "poem": 1
          },
          {
            "text": "u zdelu kneževsku masla mu dade.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Levicom se mašila za kolac,",
            "poem": 1
          },
          {
            "text": "a desnicom za malj kovački,",
            "poem": 2
          },
          {
            "text": "pa udari Siseru i glavu mu smrska,",
            "poem": 1
          },
          {
            "text": "zdrobi mu, probi mu slepoočnice.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Kod njenih nogu savi se i pade,",
            "poem": 1
          },
          {
            "text": "pružio se podno njenih nogu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "gde se savi, tamo mrtav pade.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Siserina majka kroz prozor pogledava,",
            "poem": 1
          },
          {
            "text": "kroz rešetku ona sa suzama zbori:",
            "poem": 2
          },
          {
            "text": "’Zašto mu kola još ne pristižu?",
            "poem": 1
          },
          {
            "text": "Zašto topot kola njegovih kasni?’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Najmudrija joj odgovara dvorkinja,",
            "poem": 1
          },
          {
            "text": "samoj sebi ona odgovara:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "’Plen su našli, pa ga sada dele,",
            "poem": 1
          },
          {
            "text": "po devojku, pa i dve na ratnika,",
            "poem": 2
          },
          {
            "text": "bojeno i istkano za plen Siseri,",
            "poem": 1
          },
          {
            "text": "bojeno i istkano, to mu je plen,",
            "poem": 2
          },
          {
            "text": "za vratove onih koji plene.’",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Tako nek propadnu svi tvoji dušmani, Gospode,",
            "poem": 1
          },
          {
            "text": "kao sunce u punom sjaju neka sinu koji tebe vole!“",
            "poem": 2
          },
          "Zemlja je bila mirna četrdeset godina."
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 2,
        "caller": "+",
        "text": "5,5 Ovako je prema Septuaginti, Targumu i sirijskom rukopisu.",
