    "name": "Knjiga o sudijama",
    "commonName": "Knjiga o sudijama",
    "title": "Knjiga o sudijama",
    "order": 7,
    "numberOfChapters": 21,
    "sha256": "a6c8e567445ffbf155c07ad4757354699de7711017f27aa545b631f18b3c7011",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/JDG/1.json",
