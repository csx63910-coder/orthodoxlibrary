  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "heading",
        "content": [
          "Anin hvalospev"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ana se zatim pomolila ovim rečima:",
          {
            "text": "„Veseli se moje srce u Gospodu,",
            "poem": 1
          },
          {
            "text": "Podiže se rog",
            "poem": 2
          },
          {
            "noteId": 1
          },
          {
            "text": "moj u Gospodu.",
            "poem": 2
          },
          {
            "text": "Usta moja likuju nad dušmanima mojim,",
            "poem": 1
          },
          {
            "text": "jer se radujem tvojemu spasenju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Niko nije svet kao što je Gospod;",
            "poem": 1
          },
          {
            "text": "nema nikog osim tebe,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i nema Stene kao što je Bog naš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ne množite reči uznosite,",
            "poem": 1
          },
          {
            "text": "nek iz vaših usta oholost ne izlazi,",
            "poem": 2
          },
          {
            "text": "jer Gospod je Bog Sveznajući,",
            "poem": 1
          },
          {
            "text": "on prosuđuje dela čovekova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Luk se lomi junacima,",
            "poem": 1
          },
          {
            "text": "a posrnuli se opasuju snagom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Nekad siti za hleb se unajmljuju,",
            "poem": 1
          },
          {
            "text": "a nekad gladni ne gladuju više.",
            "poem": 2
          },
          {
            "text": "Nerotkinja rađa sedmoro,",
            "poem": 1
          },
          {
            "text": "a majka mnogih sinova sahne.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Gospod usmrćuje i oživljuje,",
            "poem": 1
          },
          {
            "text": "u Svet mrtvih",
            "poem": 2
          },
          {
            "noteId": 2
          },
          {
            "text": "spušta i odande podiže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Gospod daje siromaštvo i bogatstvo,",
            "poem": 1
          },
          {
            "text": "ponižuje i uzvisuje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Siromaha diže iz prašine,",
            "poem": 1
          },
          {
            "text": "iz bunjišta diže ubogoga,",
            "poem": 2
          },
          {
            "text": "da ih posadi s plemićima,",
            "poem": 1
          },
          {
            "text": "i dodeli im počasna mesta.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Jer Gospodnji su stupovi zemlje,",
            "poem": 1
          },
          {
            "text": "na njima je osnovao vaseljenu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "On čuva stope svojih vernih,",
            "poem": 1
          },
          {
            "text": "a opaki će propasti u tami,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer snagom čovek neće nadvladati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Propašće oni što se protive Gospodu,",
            "poem": 1
          },
          {
            "text": "Gospod će na njih zagrmeti s nebesa.",
            "poem": 2
          },
          {
            "text": "On će suditi krajevima zemlje,",
            "poem": 1
          },
          {
            "text": "svome caru on će dati snagu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "uzvisiće rog pomazaniku svome.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Gresi Ilijevih sinova"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Elkana se vratio svojoj kući u Ramu, a dečak je služio Gospodu pod nadzorom Ilija sveštenika."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "A Ilijevi sinovi bili su opaki ljudi i nisu poznavali Gospoda."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ti sveštenici su ovako običavali da postupaju s narodom: kad je neko prinosio žrtvu dolazio bi sveštenikov sluga s trorogom viljuškom u ruci, i dok se meso još kuvalo,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "zabadao njom u kotao, lonac, tiganj, ili šerpu, i što god bi se nabolo na viljušku, sveštenik bi uzimao sebi. Ovako su postupali sa svim Izrailjcima koji su dolazili tamo, u Silom."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Osim toga, pre nego što se palilo salo, došao bi sveštenikov sluga i rekao čoveku koji je žrtvovao: „Daj meso da se ispeče za sveštenika, jer on od tebe neće primiti kuvano meso, nego sirovo.“"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Ako bi mu čovek odgovorio: „Neka prvo spale salo, pa onda uzmi šta ti duša želi“, sluga bi mu rekao: „Ne, nego mi daj sad, a ako nećeš, uzeću silom!“"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Greh mladića je bio vrlo velik pred Gospodom, jer su ljudi prezrivo postupali s prinosom Gospodnjim."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "A Samuilo je služio pred Gospodom, tek dečak pripasan lanenim oplećkom."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Njegova majka bi mu načinila malu odoru i donosila mu svake godine kad bi dolazila sa svojim mužem da prinesu godišnju žrtvu."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Tada bi Ilije blagoslovio Elkanu i rekao: „Neka ti Gospod da dece od ove žene umesto onoga koje je izmolila od Gospoda.“ Potom bi se vratili kući."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Gospod je pohodio Anu te je zatrudnela i rodila tri sina i dve ćerke. A dečak Samuilo je rastao pred Gospodom."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Ilije opominje svoje sinove"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Ilije je bio veoma star. Tek, čuo je sve što su njegovi sinovi činili svemu Izrailju, i to da spavaju sa ženama koje služe kod ulaza Šatora od sastanka."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Rekao im je: „Zašto radite takve stvari? Jer slušam o vašim opakim delima od sveg ovog naroda."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Nemojte, sinovi moji! Nije dobra vest koju čujem da narod Gospodnji širi."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Ako čovek zgreši protiv čoveka, Bog će posredovati za njega, ali ako čovek zgreši protiv Gospoda, ko će posredovati za njega?“ Ali oni nisu poslušali glas svoga oca jer je Gospod rešio da ih pogubi."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "A dečak Samuilo je stasavao i sticao naklonost Gospoda i ljudi."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Božija kazna nad Ilijevim domom"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Tada dođe Božiji čovek k Iliju i reče mu: „Govori Gospod: ’Ja sam se objavio domu tvoga pretka dok su bili u Egiptu robujući faraonovom domu."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Izabrao sam ga između svih Izrailjevih plemena sebi za sveštenika, da prinosi žrtve na mom žrtveniku, da pali kad, i da nosi oplećak preda mnom. Domu tvoga oca dao sam i sve paljene žrtve naroda izrailjskog."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Zašto gazite moju žrtvu i moj prinos, koje sam odredio za moje Prebivalište? Ti častiš svoje sinove više nego mene hraneći ih prvinama svakog prinosa mog naroda, Izrailja.’"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Zato Gospod, Bog Izrailjev objavljuje: ’Rekao sam tvome domu i domu tvoga oca da će stupati pred mojim licem doveka.’ Ali, sada kaže Gospod: ’Daleko to bilo od mene! Jer ja poštujem one koji mene poštuju, a oni koji me preziru, biće osramoćeni."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "Evo, dolaze dani kada ću odseći tvoju mišicu i mišicu doma tvoga oca, tako da neće biti starca u tvome domu."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Ti ćeš gledati nesreću u mom Prebivalištu, a umesto sveg obilja koje će se dati Izrailju, u tvome domu neće biti starca doveka."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "A koga od tvojih ne istrebim ispred svoga žrtvenika ostaviću samo zato da ti sahnu oči i da ti duša vene, a sve mnoštvo potomaka u tvome domu poumiraće u najboljim godinama."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "Ovo će ti biti znak; to će zadesiti oba tvoja sina, Ofnija i Finesa: obojica će poginuti istog dana."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "A sebi ću postaviti vernog sveštenika koji će raditi po mome srcu i po mojoj volji. Ja ću mu podići trajni dom, a on će stupati pred mojim pomazanikom doveka."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "A ko preostane u tvome domu doći će da mu se pokloni za srebrnjak i komad hleba, govoreći: primi me, molim te, u kakvu svešteničku službu da imam zalogaj hleba.’“"
        ]
      }
    ],
