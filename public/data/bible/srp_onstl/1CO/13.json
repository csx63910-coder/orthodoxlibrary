  "chapter": {
    "number": 13,
    "content": [
      {
        "type": "heading",
        "content": [
          "Himna ljubavi"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ako govorim ljudskim i anđeoskim jezicima, a nemam ljubavi, onda sam kao metal što odjekuje i činele što zveče."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "I ako imam i dar proroštva, i da znam sve tajne i sva znanja, i povrh toga da imam svu veru planine da premeštam, a ljubavi da nemam – ništa sam."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Pa da i razdelim sve što imam, da i telo svoje predam, da bih se hvalio, a ljubavi nemam – ništa mi ne koristi."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Ljubav je strpljiva, ljubazna, ne zavidi, ne hvali se, nije ohola,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ne ponaša se nepristojno, ne traži svoje, ne žesti se, ne pamti zlo,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ne raduje se nepravdi, a raduje se istini,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "sve podnosi, nikada ne prestaje da veruje, svemu se nada, sve izdržava;"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ljubav nikad ne prestaje. Proroštva će se ugasiti, jezici će prestati, znanje će se okončati."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Jer nepotpuno znamo i nepotpuno prorokujemo."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "A kad dođe ono potpuno, okončaće se ono nepotpuno."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Kad sam bio dete, govorio sam kao dete, mislio sam i razmišljao kao dete. A kad sam odrastao, završio sam sa detinjstvom."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Sada vidimo nejasno, kao u ogledalu",
          {
            "noteId": 2
          },
          ", a onda ćemo videti licem u lice. Sada znam nepotpuno, a onda ću znati potpuno, kao što sam i sam sebi poznat."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "A sada ostaje ovo troje: vera, nada i ljubav; a najveća od njih je ljubav."
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 2,
        "caller": "+",
        "text": "13,12 Ogledala u drevna vremena se nisu pravila od istog materijala kao danas, već od fino obrađenog i izglačanog metala. Odraz koji je takvo ogledalo davalo nije bio jasan kao u modernim ogledalima.",
        "reference": {
          "chapter": 13,
          "verse": 12
        }
      }
    ]
  },
