  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "heading",
        "content": [
          "Odnos pastira prema crkvi"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "One koji su starešine među vama molim ja, koji sam i sam starešina i svedok Hristovih muka, te učesnik u slavi koja treba da se otkrije,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "da napasate Božije stado koje vam je povereno. Ali ne činite to prisilno, nego dragovoljno, kako je Bogu po volji, i ne iz koristoljublja, nego iz oduševljenja."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Ne ponašajte se despotski prema onima koji su vam povereni, nego budite primeri stadu."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "A kad se pojavi vrhovni Pastir, primićete slavni venac koji ne vene."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Tako i vi, mladići, pokoravajte se starešinama. A svi se zaodenite poniznošću, da služite jedni drugima, jer:",
          {
            "text": "„Bog se suprotstavlja oholima,",
            "poem": 1
          },
          {
            "text": "a poniznima iskazuje milost.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Stoga se ponizite pod moćnu ruku Božiju, da vas uzvisi u pravo vreme."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Prebacite svu svoju brigu na njega, jer se on brine za vas."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Budite trezveni, bdite, jer vaš neprijatelj, đavo, obilazi kao ričući lav i traži koga da proždere."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Budite čvrsti u veri, te mu se oduprite, znajući da i vaša braća po veri širom sveta prolaze kroz iste patnje."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "A Bog, milostiv u svemu, koji vas je po Hristu Isusu pozvao u večnu slavu, on će vas, nakon vaše kratke patnje usavršiti, učvrstiti, osnažiti i utemeljiti."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Njegova je sila doveka. Amin."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Zaključak i pozdrav"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Napisao sam vam ovo kratko pismo uz pomoć Silvana, koga smatram vernim bratom, da vas opomenem i potvrdim da je ovo prava milost Božija. Nje se držite."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Pozdravlja vas crkva u Vavilonu, koja je zajedno sa vama izabrana od Boga, i moj sin Marko."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Pozdravite jedni druge poljupcem ljubavi. Mir sa svima vama koji ste u Hristu."
        ]
      }
    ],
    "footnotes": []
  },
