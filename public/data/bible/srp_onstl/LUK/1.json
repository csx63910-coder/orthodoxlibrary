  "book": {
    "id": "LUK",
    "translationId": "srp_onstl",
    "name": "Luka",
    "commonName": "Luka",
    "title": "Evanđelje po Luki",
    "order": 42,
    "numberOfChapters": 24,
    "sha256": "581bdcb253005741d6aa95ad02d476b10d4ac82cba05d93c926f94db572706c7",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/LUK/1.json",
