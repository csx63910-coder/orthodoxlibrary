  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "heading",
        "content": [
          "Svrha Lukinog pisanja"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Pošto su već mnogi preduzeli da opišu događaje koji su se ispunili među nama,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "onako kako su nam preneli oni koji su od početka bili očevici i sluge Božije reči,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "stoga sam i ja smatrao za shodno, pošto sam sve podrobno od početka ispitao, da ti to napišem po redu, uvaženi Teofile,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "da se uveriš u verodostojnost onoga čemu si poučen."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Rođenje Jovana Krstitelja"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "U vreme kada je car Irod vladao nad Judejom, bio je jedan sveštenik po imenu Zaharija. On je pripadao Avijinom redu. Žena mu je vodila poreklo od Arona. Zvala se Jelisaveta."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Oboje su bili pravedni pred Bogom, besprekorno živeći po zapovestima i zahtevima Gospodnjim."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Dece nisu imali, jer je Jelisaveta bila nerotkinja, a oboje su već bili u poodmaklim godinama."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Jednom je Zaharija, po redosledu svog reda, vršio službu u hramu pred Bogom."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "On je, po svešteničkom običaju, kockom bio izabran da uđe u hram Gospodnji i prinese kad."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Dok se kad prinosio, mnogo naroda se molilo u predvorju."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Tada se pojavi anđeo Gospodnji i stade s desne strane kadionog žrtvenika."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Zaharija se uznemiri i silno se prepadne ugledavši anđela."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Anđeo mu reče: „Ne boj se, Zaharija! Tvoja molitva je uslišena. Tvoja žena Jelisaveta će ti roditi sina, i ti ćeš mu dati ime ’Jovan’."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "On će ti biti na radost i veselje i mnogi će se radovati njegovom rođenju."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Jer, on će biti veliki pred Gospodom. On neće piti ni vina, ni žestoka pića, a Duhom Svetim biće ispunjen još u majčinoj utrobi."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Mnoge će Izrailjce okrenuti Gospodu, njihovom Bogu."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Stupaće kao vesnik pred Gospodom, u Ilijinom duhu i sili; da izmiri očeve sa sinovima i da vrati neposlušne na put razboritosti pravedničke, te da pripremi narod za Gospoda.“"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Zaharija reče anđelu: „Po čemu ću to znati? Ja sam, evo, star čovek, a i moja žena je već zašla u godine.“"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Anđeo mu odgovori: „Ja sam Gavrilo koji stojim u Božijem prisustvu. Bog me je poslao da govorim s tobom i da ti saopštim ovu radosnu vest."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Budući da nisi poverovao mojim rečima, zanemećeš i nećeš moći da govoriš sve do dana kada će se ovo dogoditi. Ovo će se ispuniti u pravo vreme.“"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "A narod koji je čekao Zahariju, čudio se što se on tako dugo zadržao u hramu."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Kada je Zaharija izašao iz hrama, nije mogao da im govori. Oni su onda shvatili da je imao viđenje u hramu. Davao im je znakove; nije mogao da govori."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Kad je isteklo vreme njegove službe, Zaharija se vratio kući."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Nešto nakon toga, njegova žena Jelisaveta zatrudni. Krila se pet meseci, govoreći:"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "„Ovo je Gospod učinio za mene u vreme kada mu se svidelo da ukloni moju sramotu pred ljudima.“"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Nagoveštaj Isusovog rođenja"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "A šestog meseca, Bog pošalje anđela Gavrila u galilejski grad Nazaret"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "devojci po imenu Marija. Ona je bila isprošena za čoveka koji se zvao Josif, poreklom iz loze cara Davida."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Došavši k njoj, rekao je: „Raduj se, ti kojoj je iskazana milost! Gospod je s tobom!“"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Marija se smete na te reči i poče da razmišlja: kakav je ovo pozdrav?"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Anđeo nastavi: „Ne boj se, Marija, jer si našla milost pred Bogom."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "I evo, zatrudnećeš i rodićeš sina, pa ćeš mu dati ime ’Isus’."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "On će biti silan i zvaće ga ’Sin Svevišnjega’. Njemu će Gospod Bog predati presto njegovoga oca Davida."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "On će doveka vladati nad potomstvom Jakovljevim i njegovom Carstvu neće biti kraja.“"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "Marija upita anđela: „Po čemu ću to znati, kad još nisam udata?“"
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "Anđeo joj odgovori: „Duh Sveti će sići na tebe i sila Svevišnjeg će te oseniti. Zato će to dete biti sveto i zvaće se ’Sin Božiji’."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "A evo i tvoja rođaka Jelisaveta nosi sina u svojoj starosti. Ona je već u šestom mesecu, a nju su nazivali nerotkinjom."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "Bogu ništa nije nemoguće.“"
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "Marija reče: „Evo služiteljke Gospodnje, neka mi bude kako si rekao.“ Anđeo tada ode od nje."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Susret Marije i Jelisavete"
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "Tih dana, Marija se spremi i žurno ode u grad Judin."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "Ušla je u Zaharijinu kuću i pozdravila Jelisavetu."
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "Kad je Jelisaveta čula Marijin pozdrav, zaigra dete u njenoj utrobi i Sveti Duh je ispuni,"
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "te ona uskliknu: „O, najblagoslovenija među ženama, blagosloven je plod utrobe tvoje!"
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "Čime sam to zaslužila da majka moga Gospoda dođe k meni?"
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "Jer, čim sam čula tvoj pozdrav, od radosti zaigra dete u mojoj utrobi."
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "Blažena je ona koja je poverovala da će se ispuniti što joj Gospod reče.“"
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "Onda Marija reče:",
          {
            "text": "„Veliča duša moja Gospoda,",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          {
            "text": "veseli se duh moj Bogu, mome Spasitelju,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          {
            "text": "jer pogleda na poniznost svoje sluškinje.",
            "poem": 1
          },
          {
            "text": "Evo, od sada će me svi naraštaji zvati blaženom;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          {
            "text": "jer velika je dela Svesilni učinio po meni,",
            "poem": 1
          },
          {
            "text": "sveto je ime njegovo!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          {
            "text": "Milost je njegova nad onima što ga poštuju,",
            "poem": 1
          },
          {
            "text": "od kolena do kolena.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 51,
        "content": [
          {
            "text": "Moćna dela učini mišicom svojom,",
            "poem": 1
          },
          {
            "text": "rastera uznosite što su puni sebe,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 52,
        "content": [
          {
            "text": "zbaci vladare sa prestola",
            "poem": 1
          },
          {
            "text": "i uzvisi ponižene,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 53,
        "content": [
          {
            "text": "gladne nasiti dobrima,",
            "poem": 1
          },
          {
            "text": "a bogate bez ičega otpusti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 54,
        "content": [
          {
            "text": "Pridiže Izrailja, slugu svoga,",
            "poem": 1
          },
          {
            "text": "setivši se svoga milosrđa,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 55,
        "content": [
          {
            "text": "kako reče precima našim,",
            "poem": 1
          },
          {
            "text": "Avrahamu i njegovom potomstvu doveka.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 56,
        "content": [
          "Marija ostade sa Jelisavetom oko tri meseca, pa se vrati svojoj kući."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Rođenje Jovana Krstitelja"
        ]
      },
      {
        "type": "verse",
        "number": 57,
        "content": [
          "Dođe vreme da Jelisaveta rodi, i ona rodi sina."
        ]
      },
      {
        "type": "verse",
        "number": 58,
        "content": [
          "Njeni susedi i rođaci su čuli da joj je Gospod bio veoma milostiv, pa su se radovali sa njom."
        ]
      },
      {
        "type": "verse",
        "number": 59,
        "content": [
          "Osmoga dana dođu da obrežu dete. Hteli su da mu daju očevo ime – Zaharija,"
        ]
      },
      {
        "type": "verse",
        "number": 60,
        "content": [
          "ali majka reče: „Nikako, ime će mu biti Jovan!“"
        ]
      },
      {
        "type": "verse",
        "number": 61,
        "content": [
          "Oni joj rekoše: „Ali, u tvojoj rodbini niko ne nosi to ime.“"
        ]
      },
      {
        "type": "verse",
        "number": 62,
        "content": [
          "Onda znakovima upitaju oca da kaže kako bi on hteo da se dete zove."
        ]
      },
      {
        "type": "verse",
        "number": 63,
        "content": [
          "Zaharija zatraži tablicu i napiše: „Njegovo ime je Jovan.“ Svi su se tome čudili."
        ]
      },
      {
        "type": "verse",
        "number": 64,
        "content": [
          "Odjednom, Zaharija poče da govori i da proslavlja Boga."
        ]
      },
      {
        "type": "verse",
        "number": 65,
        "content": [
          "Strah je obuzeo sve njihove susede, tako da se ovo pročulo po celom gorskom kraju Judeje."
        ]
      },
      {
        "type": "verse",
        "number": 66,
        "content": [
          "Svi koji su ovo čuli, razmišljali su o tome pitajući se: „Šta će biti sa ovim detetom?“ Jer je ruka Gospodnja bila sa njim."
        ]
      },
      {
        "type": "verse",
        "number": 67,
        "content": [
          "A Zaharija, otac Jovanov, ispunjen Svetim Duhom, poče da prorokuje:"
        ]
      },
      {
        "type": "verse",
        "number": 68,
        "content": [
          {
            "text": "„Blagosloven da je Gospod, Bog Izrailjev,",
            "poem": 1
          },
          {
            "text": "što dođe među svoj narod i otkupi ga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 69,
        "content": [
          {
            "text": "Podiže nam silnoga Spasitelja,",
            "poem": 1
          },
          {
            "text": "od roda Davidova, sluge svoga,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 70,
        "content": [
          {
            "text": "kako obeća davno",
            "poem": 1
          },
          {
            "text": "preko svojih svetih proroka:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 71,
        "content": [
          {
            "text": "da nas spase od naših dušmana",
            "poem": 1
          },
          {
            "text": "i od ruku onih koji nas mrze;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 72,
        "content": [
          {
            "text": "da će iskazati milost precima našim",
            "poem": 1
          },
          {
            "text": "i setiti se svoga svetog saveza,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 73,
        "content": [
          {
            "text": "po zakletvi datoj praocu našem Avrahamu,",
            "poem": 1
          },
          {
            "text": "da će nam dati:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 74,
        "content": [
          {
            "text": "da mu bez straha služimo,",
            "poem": 1
          },
          {
            "text": "od dušmanske ruke izbavljeni,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 75,
        "content": [
          {
            "text": "živeći sveto i pravedno",
            "poem": 1
          },
          {
            "text": "pred njim u sve dane naše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 76,
        "content": [
          {
            "text": "A ti, dete moje, zvaćeš se ’prorok Svevišnjega’,",
            "poem": 1
          },
          {
            "text": "jer ćeš ići pred Gospodom",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da pripremiš puteve za njega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 77,
        "content": [
          {
            "text": "Ti ćeš dovesti do spoznaje njegov narod",
            "poem": 1
          },
          {
            "text": "da je spasenje u oproštenju njihovih greha,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 78,
        "content": [
          {
            "text": "po milostivom srcu Boga našega,",
            "poem": 1
          },
          {
            "text": "od kojeg će nam doći",
            "poem": 2
          },
          {
            "noteId": 0
          },
          {
            "text": "svetlost zore sa visine,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 79,
        "content": [
          {
            "text": "da obasja one što žive u tami",
            "poem": 1
          },
          {
            "text": "i pod senkom smrti borave,",
            "poem": 2
          },
          {
            "text": "i da naše stope na put mira usmeri.“",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 80,
        "content": [
          "Kada je dečak odrastao i duhovno ojačao, otišao je da živi u pustinji, sve do dana kada se pojavio u javnosti izrailjskog naroda."
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 0,
        "caller": "+",
        "text": "1,78 Doslovno: izlazak zvezde i izdanak biljke. Septuaginta prevodi ovu reč sa izlazak, što može da se odnosi i na jedno i na drugo. Moguće je da Luka ima na umu obe slike, i izlazak zvezde i izdanak biljke. Slika proročki govori o dolasku Davidovog izdanka, to jest, Hrista. (Zah 3,8; 6,12; Jer 23,5; 4. Moj 24,17; Mal 3,2.)",
        "reference": {
          "chapter": 1,
          "verse": 78
        }
      }
    ]
  },
