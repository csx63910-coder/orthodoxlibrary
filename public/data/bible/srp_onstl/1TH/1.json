    "title": "Prva poslanica Solunjanima",
    "order": 52,
    "numberOfChapters": 5,
    "sha256": "00661afc21cd63cf8079bb4329deecfd33b443f6e9bced666e8d343b2e4ab66b",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/1TH/1.json",
