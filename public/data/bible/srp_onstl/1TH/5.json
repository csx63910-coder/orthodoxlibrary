  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "heading",
        "content": [
          "Budite spremni za Gospodnji dolazak"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "A što se tiče vremena i časa, o tome nema potrebe da vam se piše."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Vi, naime, vrlo dobro znate da će dan Gospodnji doći kao što lopov dolazi noću."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Kad ljudi budu govorili: „Mir i sigurnost“, tada će ih iznenada zadesiti propast, kao trudovi trudnicu, i neće moći da pobegnu."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Ali vi, braćo, niste u tami da bi vas ovaj dan zatekao kao lopov,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "jer vi ste svi sinovi svetla i sinovi dana. Mi ne pripadamo tami i noći."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Zato ne spavajmo kao drugi, već bdijmo i budimo trezni."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Jer, oni koji spavaju, noću spavaju, i koji se opijaju, noću se opijaju."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Ali, pošto pripadamo danu, budimo trezni, obučeni u oklop vere i ljubavi i s kacigom nade na spasenje."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Bog nas, naime, nije odredio da iskusimo gnev, već da dobijemo spasenje posredstvom našeg Gospoda Isusa Hrista."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "On je umro za nas da bismo mi sa njim živeli, bilo da smo još živi ili smo već umrli."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Zato, bodrite jedni druge i izgrađujte se međusobno, kao što to već i činite."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Poslednja uputstva i pozdravi"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Molimo vas, braćo, da poštujete one koji se trude među vama, one koji vas, po Gospodnjoj volji, vode i opominju."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Cenite ih iznad svega i volite zbog službe koju obavljaju. Živite među sobom u miru."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Zaklinjemo vas, braćo, opominjite neuredne, bodrite malodušne, pomažite slabima, budite strpljivi sa svakim."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Gledajte da niko nikome ne vraća zlo za zlo, nego se uvek trudite da činite dobro jedni drugima i svima."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Uvek se radujte!"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Molite se bez prestanka!"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Zahvaljujte na svemu, jer je to Božija volja za vas u Hristu Isusu."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Ne sputavajte Duha."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Ne prezirite proroštva,"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "nego sve proveravajte, pa što je dobro, zadržite."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Klonite se svakog zla."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "A Bog mira neka dovrši vaše posvećenje, te da se celo vaše biće – duh, duša i telo – sačuvaju besprekornim za dolazak Gospoda našeg Isusa Hrista."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Veran je Bog koji vas poziva, on će to i učiniti."
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Braćo, molite se za nas."
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Pozdravite svu braću svetim poljupcem."
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Zaklinjem vas pred Gospodom da pročitate ovu poslanicu svoj braći."
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Milost Gospoda našega Isusa Hrista s vama!"
        ]
      }
    ],
    "footnotes": []
  },
