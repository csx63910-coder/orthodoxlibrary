    "numberOfChapters": 16,
    "sha256": "6ce4f43f339637ed7f86d499c6d8eafe64c73650c5aa8c0b726b3cb3f5707c8a",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/ROM/1.json",
