  "chapter": {
    "number": 10,
    "content": [
      {
        "type": "heading",
        "content": [
          "Obnovljenje saveza"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Oni koji su zapečatili su bili:",
          {
            "lineBreak": true
          },
          "Nemija Tirsata, Ahalijin sin.",
          {
            "lineBreak": true
          },
          "Zatim Sedekija,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Soraja, Azarija, Jeremija,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Pashor, Amarija, Malhija,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Hatuš, Sevanija, Maluh,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Harim, Merimot, Ovadija,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Danilo, Gineton, Varuh,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Mesulam, Avija, Mijamin,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Mazija, Vilgaj i Semaja. To su bili sveštenici."
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "I Leviti: Isus, Azanijin sin; Vinuj, jedan od Inadadovih sinova, zatim Kadmilo i njegova braća:"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Sevanija, Odija, Kelita, Felaja, Anan,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Miha, Reov, Asavija,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Zahur, Serevija, Sevanija,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Odija, Vanije i Veninuj."
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "A od narodnih glavara: Faros, Fat-Moav, Elam, Zatuj, Vanija,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Vunije, Azgad, Vivaj,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Adonija, Vigvaj, Adin,"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Atir, Jezekija, Azur,"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Odija, Asum, Visaj,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Arif, Anatot, Navaj,"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Magpija, Mesulam, Ezir,"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Mesizaveilo, Sadok, Jadva,"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Felatija, Anan, Anaja,"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Osija, Hananija, Asuv,"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Lois, Fileja, Sovik,"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Reum, Asavana, Masija,"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Ahija, Anan, Ganan,"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Maluh, Harim, Vana."
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "„A ostali narod – sveštenici, Leviti, vratari, pevači, hramske sluge, i svako ko se odvojio od naroda zemaljskih ka Božijem Zakonu sa svojim ženama, svojim sinovima i svojim ćerkama, i svako ko je znao i razumeo –"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "podržao je svoje sunarodnike i svoje glavare, pa su se obavezali kletvom i zakletvom da će hodati u Božijem Zakonu, koji je dan preko Božijeg sluge Mojsija, da će čuvati i izvršavati zapovesti Gospoda, našeg Boga, i njegove propise i uredbe."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Nećemo davati svoje ćerke zemaljskim narodima i njihove ćerke nećemo uzimati za naše sinove."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "I ako neki od zemaljskih naroda budu doneli robu i razno žito za prodaju u subotnji dan, mi je nećemo uzimati od njih u subotu, ili na neki sveti dan. Još ćemo se sedme godine odreći obrađivanja zemlje i zelenaštva."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Još smo sebi odredili zapovest da dajemo trećinu šekela godišnje za službu Doma našeg Boga."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "I to za poređane hlebove, za svakodnevnu žitnu žrtvu, za svakodnevnu svespalnicu, za subote, za mladine, za propisane praznike, za svete stvari, za žrtve za greh, da se izvrši otkupljenje nad Izrailjem i svim poslovima na Domu našeg Boga."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "Mi – sveštenici, Leviti i narod – bacili smo žreb za prinos drva koja se donose u Dom našeg Boga; prema našim otačkim domovima na određene praznike, godinu za godinom, da se pali na žrtveniku Gospoda, našeg Boga, kako je zapisano u Zakonu."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "Takođe, da se iz godine u godinu donose prvine sa polja, prvine od svih plodova svakog stabla u Gospodnji Dom."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "Zatim prvorođene od naših sinova i naše stoke, kako je zapisano u Zakonu; i prvinu od naših krda i naših stada da ćemo donositi u Dom našeg Boga, sveštenicima koji služe u Domu našeg Boga."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "Pored toga: prvinu testa, naše prinose, plodove svakog stabla, mlado vino i ulje ćemo donositi sveštenicima za riznice Doma našeg Boga; i desetak sa naših polja za Levite. A Leviti sakupljaju desetak u svim gradovima gde obrađujemo polja."
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "Neka sveštenik, Aronov potomak, bude sa Levitima kada Leviti budu sakupljali desetak. I neka Leviti odnesu desetak od desetka u Dom našeg Boga, u odaje skladišta Doma."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "Jer, u skladišta će donositi Izrailjci i potomci Levita prinose u žitu, mlado vino i ulje. Tamo je posuđe Svetilišta, sveštenici koji služe, vratari i pevači. Nećemo da zapostavimo Dom našeg Boga!“"
        ]
      }
    ],
