  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "heading",
        "content": [
          "Bog šalje ribu da proguta Jonu"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ali Gospod posla veliku ribu da proguta Jonu. Jona je bio u utrobi ribe tri dana i tri noći."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Tada se Jona pomolio Gospodu, svome Bogu, iz utrobe ribe."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Jonina molitva"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Rekao je:",
          {
            "text": "„Iz nevolje svoje prizvah Gospoda",
            "poem": 1
          },
          {
            "text": "i on mi je odgovorio,",
            "poem": 2
          },
          {
            "text": "iz utrobe Sveta mrtvih",
            "poem": 1
          },
          {
            "noteId": 0
          },
          {
            "text": "zavapih,",
            "poem": 1
          },
          {
            "text": "i ti si čuo glas moj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ti si me bacio u dubine,",
            "poem": 1
          },
          {
            "text": "u središte mora,",
            "poem": 2
          },
          {
            "text": "bujica me opkolila,",
            "poem": 1
          },
          {
            "text": "svi talasi tvoji i vrtlozi preplaviše me.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Pomislih: ’Oteran sam od tvojih očiju,",
            "poem": 1
          },
          {
            "text": "no, opet ću sveti Dom tvoj gledati.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Vode mi dođoše do grla,",
            "poem": 1
          },
          {
            "text": "bezdan me je okružio,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "trave mi se oko glave spletoše,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "spustih se do temelja gorskih,",
            "poem": 1
          },
          {
            "text": "zauvek se brave zemaljske sklopiše nada mnom,",
            "poem": 2
          },
          {
            "text": "ali ti si podigao iz jame život moj,",
            "poem": 1
          },
          {
            "text": "Gospode, Bože moj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Kad mi život na izmaku beše,",
            "poem": 1
          },
          {
            "text": "setih se Gospoda,",
            "poem": 2
          },
          {
            "text": "i molitva mi dopre do Gospoda,",
            "poem": 1
          },
          {
            "text": "do svetoga Doma tvojega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Oni što se drže ništavnih idola,",
            "poem": 1
          },
          {
            "text": "milost Božiju sebi uskraćuju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Glasom hvalospevnim",
            "poem": 1
          },
          {
            "text": "žrtvu ću ti prineti,",
            "poem": 2
          },
          {
            "text": "što zavetovah, to ću izvršiti.",
            "poem": 1
          },
          {
            "text": "Spasenje je od Gospoda!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Tada je Gospod zapovedio ribi, te je ona izbacila Jonu na kopno."
        ]
      }
    ],
