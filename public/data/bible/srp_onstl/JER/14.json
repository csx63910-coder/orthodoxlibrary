  "chapter": {
    "number": 14,
    "content": [
      {
        "type": "heading",
        "content": [
          "Suša, glad, rat"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Jeremiji je došla od Gospoda poruka o suši:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Juda plače.",
            "poem": 1
          },
          {
            "text": "Gradovi joj propadaju,",
            "poem": 2
          },
          {
            "text": "a oni leže po zemlji u crno zavijeni.",
            "poem": 1
          },
          {
            "text": "Plač Jerusalima se razleže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Moćnici šalju svoje sluge po vodu,",
            "poem": 1
          },
          {
            "text": "ali kada oni stignu do čatrnja,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "vode nema.",
            "poem": 2
          },
          {
            "text": "A onda se vraćaju praznih posuda,",
            "poem": 1
          },
          {
            "text": "posramljeni i zbunjeni,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pokrivenih glava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Tlo je ispucalo,",
            "poem": 1
          },
          {
            "text": "jer nema kiše u zemlji,",
            "poem": 2
          },
          {
            "text": "ratari su posramljeni",
            "poem": 1
          },
          {
            "text": "i pokrivaju svoje glave.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "I košuta se olanila u polju",
            "poem": 1
          },
          {
            "text": "i napustila mlado,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer nema trave.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Divlji magarci stoje po ogolelim visovima",
            "poem": 1
          },
          {
            "text": "i kao šakali dahću.",
            "poem": 2
          },
          {
            "text": "Iskolačili su oči",
            "poem": 1
          },
          {
            "text": "jer nema paše.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Naše krivice svedoče protiv nas.",
            "poem": 1
          },
          {
            "text": "A ti ipak, Gospode, deluj radi svoga imena,",
            "poem": 2
          },
          {
            "text": "jer su mnoga naša otpadništva.",
            "poem": 1
          },
          {
            "text": "Protiv tebe smo sagrešili!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Nado Izrailjeva,",
            "poem": 1
          },
          {
            "text": "Spasitelju njegov u času nevolje!",
            "poem": 2
          },
          {
            "text": "Zašto si poput došljaka u zemlji",
            "poem": 1
          },
          {
            "text": "i putnika što bi tek usput da prenoći?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Zašto si kao smeten čovek,",
            "poem": 1
          },
          {
            "text": "kao junak nemoćan da spase?",
            "poem": 2
          },
          {
            "text": "A ti si među nama, o, Gospode,",
            "poem": 1
          },
          {
            "text": "i tvoje je ime prizvano na nas.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ne napuštaj nas!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Evo šta kaže Gospod ovom narodu:",
          {
            "text": "„Oni baš vole da lutaju,",
            "poem": 1
          },
          {
            "text": "ne sputavaju u tome korake svoje.",
            "poem": 2
          },
          {
            "text": "I Gospod ih nije prihvatio",
            "poem": 1
          },
          {
            "text": "i sada se seća njihovih krivica",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i kazniće njihove grehe.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Gospod mi je rekao: „Ne moli se za dobro ovog naroda."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Postiće oni, ali ja neću slušati njihov vapaj. Žrtvovaće oni svespalnice i žitne žrtve, ali ja ih neću prihvatiti. Dokrajčiću ih mačem, glađu i pomorom.“"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "A ja sam uzvratio: „O, Gospode Bože! Evo proroci im govore: ’Rat i glad nećete gledati! Neće vas to zadesiti! Jer ja ću da vam dam siguran mir na ovom mestu.’“"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Gospod mi je odgovorio: „Ti proroci prorokuju laž u moje ime! Ja ih nisam poslao i nisam ih ovlastio. Nisam im objavio lažno viđenje i obmanjivačku gatalicu, jer to oni prorokuju po svom srcu."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Zato ovako kaže Gospod o tim prorocima koji prorokuju u moje ime. Ja ih nisam poslao da vam kažu: ’Rat i glad vas neće zadesiti u ovoj zemlji.’ Skončaće ti proroci i od rata i od gladi!"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "A narod kome je prorokovano će od rata i gladi biti pobacan po ulicama Jerusalima. Neće biti koga da ih sahrani – njih, njihove žene, njihove sinove i njihove ćerke – i ja ću po njima da izlijem njihovu zlobu."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "I ovu ću poruku još da im kažem:",
          {
            "text": "’Rone suze oči moje",
            "poem": 1
          },
          {
            "text": "i noću i danju bez prestanka,",
            "poem": 2
          },
          {
            "text": "jer je devica mog naroda",
            "poem": 1
          },
          {
            "text": "razorena velikim razaranjem.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Jako je ranjena.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ako odem u polje –",
            "poem": 1
          },
          {
            "text": "tamo mačem poklani!",
            "poem": 2
          },
          {
            "text": "Ako odem u grad –",
            "poem": 1
          },
          {
            "text": "tamo od gladi bolesni!",
            "poem": 2
          },
          {
            "text": "I prorok i sveštenik",
            "poem": 1
          },
          {
            "text": "tumaraju zemljom i ništa ne shvataju.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Zar si Judu sasvim odbacio?",
            "poem": 1
          },
          {
            "text": "Da li ti je Sion duši mrzak?",
            "poem": 2
          },
          {
            "text": "Zašto si nas udario",
            "poem": 1
          },
          {
            "text": "i nema nam ozdravljenja?",
            "poem": 2
          },
          {
            "text": "Nadali smo se miru –",
            "poem": 1
          },
          {
            "text": "a ničeg dobroga;",
            "poem": 2
          },
          {
            "text": "i vremenu ozdravljenja –",
            "poem": 1
          },
          {
            "text": "a ono strava!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Gospode, mi smo svesni naše opakosti",
            "poem": 1
          },
          {
            "text": "i krivice naših predaka,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer smo ti zgrešili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Ne prezri nas zbog svog imena!",
            "poem": 1
          },
          {
            "text": "Ne ponizi presto svoje slave.",
            "poem": 2
          },
          {
            "text": "Seti se svog saveza sa nama",
            "poem": 1
          },
          {
            "text": "i nemoj ga raskinuti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Da li neki od idola drugih naroda šalju kišu?",
            "poem": 1
          },
          {
            "text": "A nebesa zar daju pljuskove?",
            "poem": 2
          },
          {
            "text": "Zar nisi to ti, Gospode naš Bože?",
            "poem": 1
          },
          {
            "text": "Ti sve to činiš",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i mi te željno iščekujemo.",
            "poem": 2
          }
        ]
      }
    ],
