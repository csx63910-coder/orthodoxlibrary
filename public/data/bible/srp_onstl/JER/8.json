  "chapter": {
    "number": 8,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "U to će vreme – govori Gospod – izvaditi kosti Judinih careva, kosti glavara, kosti sveštenika, kosti proroka i kosti stanovnika Jerusalima iz njihovih grobova."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Razasuće ih pred suncem, mesecom, pred svom nebeskom vojskom, pred onima koje su voleli i služili im, koje su sledili, težili im i kojima su se klanjali. Neće ih sakupiti i neće ih sahraniti. Biće kao gnojivo po tlu."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "A svem ostatku ovog zlog roda, koji preživi po svim mestima u koja ću ih prognati, smrt će biti draža od života – govori Gospod nad vojskama."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Greh i kazna"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Reci im: ’Govori Gospod:",
          {
            "text": "Zar ne ustaju oni koji padaju?",
            "poem": 1
          },
          {
            "text": "Zar se ne vraća onaj koji se odvraća?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "A zašto se odvratio ovaj narod,",
            "poem": 1
          },
          {
            "text": "Jerusalim, uporan u odmetništvu?",
            "poem": 2
          },
          {
            "text": "Drži se obmane",
            "poem": 1
          },
          {
            "text": "i odbija da se vrati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Pazio sam i čuo: ne govore dobro,",
            "poem": 1
          },
          {
            "text": "nijedan se ne kaje za svoja zla",
            "poem": 2
          },
          {
            "text": "i ne kaže – Šta sam to uradio?",
            "poem": 1
          },
          {
            "text": "Svi su se odvratili na svoju stranu",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kao konj što grabi u bitku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Čak i roda na nebesima zna svoje vreme;",
            "poem": 1
          },
          {
            "text": "golub, lasta i ždral paze na vreme kada dolaze;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a samo moj narod ne zna Gospodnje propise.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Kako možete da kažete: mudri smo!",
            "poem": 1
          },
          {
            "text": "Imamo Gospodnji Zakon?",
            "poem": 2
          },
          {
            "text": "Gle, stvarno ga je lažnim načinilo",
            "poem": 1
          },
          {
            "text": "lažljivo pero znalaca Svetog pisma!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Mudraci su se osramotili,",
            "poem": 1
          },
          {
            "text": "uplašili su se i zarobljeni su.",
            "poem": 2
          },
          {
            "text": "Evo, prezreli su reč Gospodnju,",
            "poem": 1
          },
          {
            "text": "pa kakva im to mudrost preostaje?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Zato ću njihove žene da dam drugima,",
            "poem": 1
          },
          {
            "text": "a njihova polja novim gazdama.",
            "poem": 2
          },
          {
            "text": "Jer baš svi, od najmanjeg do najvećeg,",
            "poem": 1
          },
          {
            "text": "grabe nepošteni dobitak.",
            "poem": 2
          },
          {
            "text": "Od proroka, pa do sveštenika,",
            "poem": 1
          },
          {
            "text": "baš svi varaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Oni prelom ćerke mog naroda",
            "poem": 1
          },
          {
            "text": "olako leče pričajući:",
            "poem": 2
          },
          {
            "text": "Mir! Mir!",
            "poem": 1
          },
          {
            "text": "A nema mira.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Jesu li se zastideli zato što su učinili gadost?",
            "poem": 1
          },
          {
            "text": "Baš se nimalo nisu zastideli",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i ne znaju za stid.",
            "poem": 2
          },
          {
            "text": "Zato će pasti među one što padaju",
            "poem": 1
          },
          {
            "text": "i u času kada ih kaznim biće sapleteni",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Pokupiću ih i dokrajčiću ih –",
            "poem": 1
          },
          {
            "text": "govori Gospod –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "neće više biti grožđa na lozi,",
            "poem": 2
          },
          {
            "text": "neće više biti plodova smokve na njenom stablu",
            "poem": 1
          },
          {
            "text": "i lišće će se osušiti.",
            "poem": 2
          },
          {
            "text": "A ja ću da ih dam onima",
            "poem": 1
          },
          {
            "text": "što će ih pregaziti.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "I zašto sada sedimo?",
            "poem": 1
          },
          {
            "text": "Okupite se,",
            "poem": 2
          },
          {
            "text": "pođimo u utvrđene gradove",
            "poem": 1
          },
          {
            "text": "pa da tamo izginemo,",
            "poem": 2
          },
          {
            "text": "jer nas je Gospod, naš Bog, odredio za propast.",
            "poem": 1
          },
          {
            "text": "Dao nam je da pijemo zatrovanu vodu",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer smo Gospodu zgrešili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Nadali smo se miru,",
            "poem": 1
          },
          {
            "text": "ali ničeg dobrog;",
            "poem": 2
          },
          {
            "text": "i vremenu zdravlja,",
            "poem": 1
          },
          {
            "text": "a ono strava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Od Dana se još čulo rzanje njihovih konja,",
            "poem": 1
          },
          {
            "text": "a od njištanja njihovih ždrebaca tresla se zemlja.",
            "poem": 2
          },
          {
            "text": "Došli su, poharali zemlju",
            "poem": 1
          },
          {
            "text": "i sve što je u njoj,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i grad i stanovnike u njemu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "„Evo, šaljem na vas zmije otrovnice",
            "poem": 1
          },
          {
            "text": "protiv kojih nema bajalice,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pa će vas ujedati",
            "poem": 2
          },
          {
            "text": "– govori Gospod.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "O, kad bih se nasmejao!",
            "poem": 1
          },
          {
            "text": "Alʼ tužan sam i srce me boli.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Gle, vapaj ćerke moga naroda",
            "poem": 1
          },
          {
            "text": "iz zemlje daleke:",
            "poem": 2
          },
          {
            "text": "„Zar Gospod nije na Sionu?",
            "poem": 1
          },
          {
            "text": "Njen car nije tu?“",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Ali zašto me gneve njihovim idolima,",
            "poem": 1
          },
          {
            "text": "tim tuđinskim ništavilima?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "„I žetva je prošla",
            "poem": 1
          },
          {
            "text": "i leto je kraju došlo,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a mi spaseni nismo!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Razorilo me je razaranje ćerke moga naroda.",
            "poem": 1
          },
          {
            "text": "U crnini sam jer me je grozota obuzela!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Zar u Galadu nema melema?",
            "poem": 1
          },
          {
            "text": "Zar tamo nema lekara?",
            "poem": 2
          },
          {
            "text": "Pa zašto onda nije ozdravila",
            "poem": 1
          },
          {
            "text": "ćerka moga naroda?",
            "poem": 2
          }
        ]
      }
    ],
