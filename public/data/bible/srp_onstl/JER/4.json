  "book": {
    "id": "JER",
    "translationId": "srp_onstl",
    "name": "Knjiga proroka Jeremije",
    "commonName": "Knjiga proroka Jeremije",
    "title": "Knjiga proroka Jeremije",
    "order": 24,
    "numberOfChapters": 52,
    "sha256": "f524605fccd8c4fcf3d7c13525a61de115cadf8732f9e1d29cc1e095a3436657",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/JER/1.json",
    "lastChapterNumber": 52,
    "lastChapterApiLink": "/api/srp_onstl/JER/52.json",
    "totalNumberOfVerses": 1364
  },
  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "„Ako se vratiš, o, Izrailju",
            "poem": 1
          },
          {
            "text": "– govori Gospod – meni se vrati;",
            "poem": 2
          },
          {
            "text": "i ako skloniš svoje gadosti od mene",
            "poem": 1
          },
          {
            "text": "nećeš lutati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Zaklinjaćeš se:",
            "poem": 1
          },
          {
            "text": "’Tako mi živog Gospoda!’",
            "poem": 2
          },
          {
            "text": "u istini, u pravdi i u pravednosti.",
            "poem": 1
          },
          {
            "text": "I blagosloviće se njime narodi",
            "poem": 2
          },
          {
            "noteId": 5
          },
          {
            "lineBreak": true
          },
          {
            "text": "i njime će se hvaliti.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Govori Gospod Judejcima i Jerusalimu:",
          {
            "text": "„Uzorite svoje neuzorano tlo",
            "poem": 1
          },
          {
            "text": "i ne sejte u trnje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Obrežite se Gospodu",
            "poem": 1
          },
          {
            "text": "i uklonite obreske sa svojih srca –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "o, Judejci i stanovnici Jerusalima –",
            "poem": 2
          },
          {
            "text": "da se ne bi kao vatra obrušio moj gnev",
            "poem": 1
          },
          {
            "text": "i rasplamteo se, a nikog nema da gasi zbog zala vaših dela.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Propast sa severa"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Objavite u Judi i u Jerusalimu, najavite i recite:",
            "poem": 1
          },
          {
            "text": "’Zatrubite u trubu po zemlji!’",
            "poem": 2
          },
          {
            "text": "Ispunite je povicima i recite:",
            "poem": 1
          },
          {
            "text": "’Okupimo se!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Hajdemo u utvrđene gradove!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Podignite zastavu prema Sionu.",
            "poem": 1
          },
          {
            "text": "Bežite i ne stajte!",
            "poem": 2
          },
          {
            "text": "Jer ja sa severa donosim propast",
            "poem": 1
          },
          {
            "text": "i veliko razaranje.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Podigao se lav iz svog šipražja,",
            "poem": 1
          },
          {
            "text": "zatirač naroda je krenuo",
            "poem": 2
          },
          {
            "text": "i izašao iz svog mesta,",
            "poem": 1
          },
          {
            "text": "da ti zemlju pretvori u pustoš.",
            "poem": 2
          },
          {
            "text": "A tvoji gradovi će pasti u ruine",
            "poem": 1
          },
          {
            "text": "bez stanovnika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Zato opašite kostret,",
            "poem": 1
          },
          {
            "text": "žalite i kukajte,",
            "poem": 2
          },
          {
            "text": "jer se od nas nije okrenuo",
            "poem": 1
          },
          {
            "text": "plamen Gospodnjeg gneva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "„I tog će dana – govori Gospod –",
            "poem": 1
          },
          {
            "text": "da nestane srčanosti u caru i u glavarima.",
            "poem": 2
          },
          {
            "text": "Sveštenici će se užasnuti,",
            "poem": 1
          },
          {
            "text": "a proroci preneraziti.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "A ja sam rekao: „Jao, Gospode Bože, zaista si sasvim zavarao ovaj narod i Jerusalim govoreći: ’Mir vam pripada’, a evo mač je došao do grla.“"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "U to će se vreme reći ovom narodu i Jerusalimu: „Zažareni pustinjski vetar sa ogolelih visova duvaće na ćerku mog naroda, ali ne da razveje i očisti."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Vetar prejak za sve to dolazi za mene, pa ću sada i ja da im objavim sudove.“"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Vidi! Kao oblaci on se valja,",
            "poem": 1
          },
          {
            "text": "kao oluja su bojna kola njegova",
            "poem": 2
          },
          {
            "text": "i konji su mu od orlova brži.",
            "poem": 1
          },
          {
            "text": "Teško nama! Propadosmo!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Operi od zla svoje srce – o, Jerusalime – da bi bio spasen.",
            "poem": 1
          },
          {
            "text": "Dokle će u tebi da ostaju misli tvojih zlodela?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Jer glas objavljuje iz Dana,",
            "poem": 1
          },
          {
            "text": "najavljuje nevolju iz gorja Jefremovih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "„Obznanite narodima.",
            "poem": 1
          },
          {
            "text": "Evo, najavite Jerusalimu:",
            "poem": 2
          },
          {
            "text": "’Vojnici opsadnici dolaze iz daleke zemlje,",
            "poem": 1
          },
          {
            "text": "da buče pokličima protiv Judinih gradova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Kao stražari na polju ga napadaju, opsedaju ga",
            "poem": 1
          },
          {
            "text": "jer se protiv mene pobunio",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Tvoji putevi i tvoja dela",
            "poem": 1
          },
          {
            "text": "su ti doneli ovo.",
            "poem": 2
          },
          {
            "text": "Ovo je tvoja zloba –",
            "poem": 1
          },
          {
            "text": "gorko je",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i do srca ti je proniklo.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Moja utroba! Moja utroba!",
            "poem": 1
          },
          {
            "text": "Previjam se jer mi srce uzdiše.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "A moje srce neće da ćuti",
            "poem": 2
          },
          {
            "text": "jer je zvuk trube koji si čula, dušo moja,",
            "poem": 1
          },
          {
            "text": "bojni poklič.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Javljaju o razaranju za razaranjem,",
            "poem": 1
          },
          {
            "text": "jer su svu zemlju opustošili.",
            "poem": 2
          },
          {
            "text": "Naprečac su opustošili moje šatore",
            "poem": 1
          },
          {
            "text": "i za čas moje zavese.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Dokle ću da gledam zastavu",
            "poem": 1
          },
          {
            "text": "i da slušam zvuk trube?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "„Baš je lud moj narod jer me ne poznaje.",
            "poem": 1
          },
          {
            "text": "Oni su budalasta, neurazumljena deca.",
            "poem": 2
          },
          {
            "text": "Vešti su da čine zlo",
            "poem": 1
          },
          {
            "text": "a ne znaju da čine dobro.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Kad sam pogledao po zemlji –",
            "poem": 1
          },
          {
            "text": "pustoš i praznina.",
            "poem": 2
          },
          {
            "text": "I na nebo –",
            "poem": 1
          },
          {
            "text": "ostalo bez svoga svetla.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Pogledao sam brda – a ona se tresu;",
            "poem": 1
          },
          {
            "text": "i sve uzvišice – i one se ljuljaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Pogledao sam – a ono nema ni čoveka,",
            "poem": 1
          },
          {
            "text": "i sve su nebeske ptice odletele.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Pogledao sam – plodna dolina je bila kao pustinja;",
            "poem": 1
          },
          {
            "text": "i svi njeni gradovi su bili oboreni pred Gospodom",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i pred plamenom njegovog gneva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Jer govori Gospod:",
          {
            "text": "„Pustoš će biti po svoj zemlji,",
            "poem": 1
          },
          {
            "text": "ali neću da je sasvim uništim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Zbog ovoga će zemlja da tuguje",
            "poem": 1
          },
          {
            "text": "i nebo će gore da pocrni.",
            "poem": 2
          },
          {
            "text": "Rekao sam, odlučio sam i neću se pokajati.",
            "poem": 1
          },
          {
            "text": "Ne povlačim se od toga.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Od pokliča konjanika i strelaca",
            "poem": 1
          },
          {
            "text": "beži sav grad.",
            "poem": 2
          },
          {
            "text": "Ljudi se zavlače u čestare",
            "poem": 1
          },
          {
            "text": "i veru se po krševima.",
            "poem": 2
          },
          {
            "text": "Svaki grad je napušten",
            "poem": 1
          },
          {
            "text": "i u njima niko ne prebiva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "A ti – o, poharana – šta ti radiš?",
            "poem": 1
          },
          {
            "text": "Makar se i oblačiš u skerlet,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kitiš se zlatnim nakitom",
            "poem": 2
          },
          {
            "text": "i bojama bojiš svoje oči –",
            "poem": 1
          },
          {
            "text": "uzalud se ulepšavaš.",
            "poem": 2
          },
          {
            "text": "Prezreli su te tvoji ljubavnici",
            "poem": 1
          },
          {
            "text": "i traže ti glavu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Čujem: zvuči kao žena u bolovima,",
            "poem": 1
          },
          {
            "text": "kao vrisak prvorotkinje glas je ćerke sionske.",
            "poem": 2
          },
          {
            "text": "Ona sopće i širi ruke:",
            "poem": 1
          },
          {
            "text": "„Teško meni jer sam iznurena,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i moj je život u rukama ubica!“",
            "poem": 2
          }
        ]
      }
    ],
