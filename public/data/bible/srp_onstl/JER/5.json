  "book": {
    "id": "JER",
    "translationId": "srp_onstl",
    "name": "Knjiga proroka Jeremije",
    "commonName": "Knjiga proroka Jeremije",
    "title": "Knjiga proroka Jeremije",
    "order": 24,
    "numberOfChapters": 52,
    "sha256": "f524605fccd8c4fcf3d7c13525a61de115cadf8732f9e1d29cc1e095a3436657",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/JER/1.json",
    "lastChapterNumber": 52,
    "lastChapterApiLink": "/api/srp_onstl/JER/52.json",
    "totalNumberOfVerses": 1364
  },
  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "heading",
        "content": [
          "Niko nije pravedan"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "„Protrčite po trgovima Jerusalima.",
            "poem": 1
          },
          {
            "text": "Gledajte, posmatrajte,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "tražite po ulicama:",
            "poem": 2
          },
          {
            "text": "da li ćete pronaći čoveka,",
            "poem": 1
          },
          {
            "text": "ijednog koji postupa po pravdi i koji teži vernosti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pa da oprostim gradu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "’Tako mi živog Gospoda!’, ako tako i govori narod,",
            "poem": 1
          },
          {
            "text": "zapravo se lažno zaklinju.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "O, Gospode, ne traže li tvoje oči vernost?",
            "poem": 1
          },
          {
            "text": "Ti si ih udarao, ali nisu popustili;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "dokrajčio si ih, ali su odbili da prihvate karanje.",
            "poem": 2
          },
          {
            "text": "Okamenili su svoje obraze da su tvrđi nego stena",
            "poem": 1
          },
          {
            "text": "i odbijaju da se vrate.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ja sam rekao: „Baš su siromasi,",
            "poem": 1
          },
          {
            "text": "i baš su ludo postupili",
            "poem": 2
          },
          {
            "text": "jer ne poznaju Gospodnji put",
            "poem": 1
          },
          {
            "text": "i propise Boga svoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "I sebi sam rekao da ću ići velikašima,",
            "poem": 1
          },
          {
            "text": "pa ću njima da govorim,",
            "poem": 2
          },
          {
            "text": "jer oni poznaju Gospodnji put i propise Boga svoga.“",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ali su i oni složno skršili jaram",
            "poem": 1
          },
          {
            "text": "i izlomili okove.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Zato će ih napasti šumski lav,",
            "poem": 1
          },
          {
            "text": "pustinjski vuk će ih opustošiti",
            "poem": 2
          },
          {
            "text": "i ris će vrebati kod njihovih gradova.",
            "poem": 1
          },
          {
            "text": "I svako ko izađe od njih biće rastrgnut u komade,",
            "poem": 2
          },
          {
            "text": "jer su mnogi njihovi prestupi",
            "poem": 1
          },
          {
            "text": "i brojna su njihova otpadništva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "„I kako ću sve to da ti oprostim?",
            "poem": 1
          },
          {
            "text": "Tvoja su me deca ostavila",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i zaklela se lažnim bogovima.",
            "poem": 2
          },
          {
            "text": "Ja sam ih nasitio,",
            "poem": 1
          },
          {
            "text": "a oni su učinili preljubu",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i žurili u kuću bludnice.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Oni su kao ugojeni, jedri ždrepci,",
            "poem": 1
          },
          {
            "text": "pa svaki rže za ženom svog bližnjeg.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Zar zbog toga da ih ne kaznim?",
            "poem": 1
          },
          {
            "text": "– govori Gospod.",
            "poem": 2
          },
          {
            "text": "Nad narodom poput ovog",
            "poem": 1
          },
          {
            "text": "zar da se ne osveti moja duša?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Idite među redove njegove loze i iskidajte ih,",
            "poem": 1
          },
          {
            "text": "ali ne činite potpuno uništenje.",
            "poem": 2
          },
          {
            "text": "Odstranite posečene lozice",
            "poem": 1
          },
          {
            "text": "jer ne pripadaju Gospodu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Jer su me sasvim izneverili",
            "poem": 1
          },
          {
            "text": "dom Izrailjev i dom Judin",
            "poem": 2
          },
          {
            "text": "– govori Gospod.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Lagali su o Gospodu",
            "poem": 1
          },
          {
            "text": "jer su rekli: „Nije on takav!",
            "poem": 2
          },
          {
            "text": "Neće nas da zadese ni zlo ni mač,",
            "poem": 1
          },
          {
            "text": "a ni gladi nećemo videti!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Proroci su postali poput vetra",
            "poem": 1
          },
          {
            "text": "jer reč nije u njima,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pa neka im tako i bude učinjeno.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Zato govori Gospod Bog nad vojskama:",
          {
            "text": "„Zato što su tako izjavili,",
            "poem": 1
          },
          {
            "text": "evo, moje ću reči u tvojim ustima da pretvorim u vatru,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a ovaj narod u drva, pa će ih progutati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Evo, dovodim na tebe narod izdaleka,",
            "poem": 1
          },
          {
            "text": "dome Izrailjev – govori Gospod.",
            "poem": 2
          },
          {
            "text": "To je krepak narod, drevni narod,",
            "poem": 1
          },
          {
            "text": "narod čiji jezik ne razumeš šta god da govore.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Tobolac im je poput groba otvoren",
            "poem": 1
          },
          {
            "text": "i svi su ratnici.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Progutaće ti i letinu i hranu.",
            "poem": 1
          },
          {
            "text": "Progutaće ti sinove i ćerke.",
            "poem": 2
          },
          {
            "text": "Progutaće ti stada i krda.",
            "poem": 1
          },
          {
            "text": "Progutaće ti vino i smokve.",
            "poem": 2
          },
          {
            "text": "Razoriće ti mačem utvrđene gradove",
            "poem": 1
          },
          {
            "text": "u koje si se uzdao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Ali tih dana – govori Gospod – neću te sasvim satrti."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Jer tada ćete upitati: ’Zašto nam čini sve to Gospod, naš Bog?’ A ti ćeš im odgovoriti: ’Kao što ste napustili mene i služili tuđim bogovima u svojoj zemlji, tako ćete sada da služite tuđincima u zemlji koja nije vaša.’"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Najavite ovo u domu Jakovljevom",
            "poem": 1
          },
          {
            "text": "i objavite u Judi. Recite:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "’Čujte sad ovo, ludi i nerazumni narode,",
            "poem": 1
          },
          {
            "text": "koji ima oči, a ne vidi",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i koji ima uši, a ne čuje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Zar se mene ne bojite? – govori Gospod.",
            "poem": 1
          },
          {
            "text": "Ne drhtite li od mene",
            "poem": 2
          },
          {
            "text": "koji sam večnom uredbom postavio pesak za granicu moru,",
            "poem": 1
          },
          {
            "text": "i ono ga ne prelazi?",
            "poem": 2
          },
          {
            "text": "Ako se i ustalasa,",
            "poem": 1
          },
          {
            "text": "ono se ne izliva;",
            "poem": 2
          },
          {
            "text": "talasi mu huče,",
            "poem": 1
          },
          {
            "text": "ali se ne prelivaju.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Ali ovaj narod ima srce prkosno i odmetničko,",
            "poem": 1
          },
          {
            "text": "skrenuli su i udaljili se.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Nisu rekli od srca:",
            "poem": 1
          },
          {
            "text": "’Sad se bojmo Gospoda, našeg Boga",
            "poem": 2
          },
          {
            "text": "koji nam daje ranu i poznu kišu na vreme,",
            "poem": 1
          },
          {
            "text": "koji nam čuva sedmice određene za žetvu.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Vaše su krivice sve ovo uskratile",
            "poem": 1
          },
          {
            "text": "i vaši su gresi zadržali ovo dobro.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Jer se u mom narodu nalaze zlikovci",
            "poem": 1
          },
          {
            "text": "što vrebaju kao ptičari iz zasede,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "što postavljaju zamke da hvataju ljude.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "I kao što je kavez pun ptica,",
            "poem": 1
          },
          {
            "text": "tako su njihove kuće pune prevare.",
            "poem": 2
          },
          {
            "text": "Zato su postali silni i nagrabili su blaga.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Ugojeni su i uglađeni.",
            "poem": 2
          },
          {
            "text": "Oni preteruju u zlu, ne mare za pravo sirotinje,",
            "poem": 1
          },
          {
            "text": "napreduju, ne sude za pravo siromaha.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Zar zbog toga da ih ne kaznim?",
            "poem": 1
          },
          {
            "text": "– govori Gospod.",
            "poem": 2
          },
          {
            "text": "Nad narodom poput ovog",
            "poem": 1
          },
          {
            "text": "zar da se ne osveti moja duša?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Grozota i strahota",
            "poem": 1
          },
          {
            "text": "se događaju po zemlji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Proroci prorokuju laž",
            "poem": 1
          },
          {
            "text": "i sveštenici vladaju po svome,",
            "poem": 2
          },
          {
            "text": "a moj narod sve to voli!",
            "poem": 1
          },
          {
            "text": "Ali šta ćete na kraju da radite?!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
