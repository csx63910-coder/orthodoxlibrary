  "chapter": {
    "number": 49,
    "content": [
      {
        "type": "heading",
        "content": [
          "Poruka Amonu"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Za Amonce ovako kaže Gospod:",
          {
            "text": "„Zar Izrailj nema decu?",
            "poem": 1
          },
          {
            "text": "Zar Izrailj nema naslednika?",
            "poem": 2
          },
          {
            "text": "Zašto je onda Malhom",
            "poem": 1
          },
          {
            "noteId": 28
          },
          {
            "text": "zauzeo Gad",
            "poem": 1
          },
          {
            "text": "i njegov narod prebiva u tamošnjim gradovima?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Zato, evo, dolaze dani",
            "poem": 1
          },
          {
            "text": "– govori Gospod –",
            "poem": 2
          },
          {
            "text": "uzviknuću Ravi",
            "poem": 1
          },
          {
            "text": "sinova Amonovih bojni poklič.",
            "poem": 2
          },
          {
            "text": "Postaće pusta ruševina,",
            "poem": 1
          },
          {
            "text": "naselja će joj vatrom spaliti,",
            "poem": 2
          },
          {
            "text": "a Izrailj će da zauzme",
            "poem": 1
          },
          {
            "text": "ono što su njemu zauzeli",
            "poem": 2
          },
          {
            "text": "– ovako kaže Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Zakukaj, Esevone, jer je Gaj opustošen;",
            "poem": 1
          },
          {
            "text": "zapomažite, naselja Ravina,",
            "poem": 2
          },
          {
            "text": "opašite kostret, žalite,",
            "poem": 1
          },
          {
            "text": "tumarajte među zidinama,",
            "poem": 2
          },
          {
            "text": "jer će Malhom u izgnanstvo.",
            "poem": 1
          },
          {
            "text": "Otići će zajedno sa svojim sveštenicima",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i svojim glavarima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Zašto se hvališ dolinama?",
            "poem": 1
          },
          {
            "text": "Doline su tvoje potopljene,",
            "poem": 2
          },
          {
            "text": "o, ćerko odmetnička,",
            "poem": 1
          },
          {
            "text": "što se hvališ svojim blagom:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "’Ko će da udari na mene?’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Evo, na tebe puštam strahotu",
            "poem": 1
          },
          {
            "text": "od svih oko tebe",
            "poem": 2
          },
          {
            "text": "– govori Gospod Bog nad vojskama –",
            "poem": 3
          },
          {
            "text": "na sve strane sve će proterati,",
            "poem": 1
          },
          {
            "text": "a begunce neće imati ko da okupi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ali posle ovoga ću vratiti izgnane sinove Amonove",
            "poem": 1
          },
          {
            "text": "– govori Gospod.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Poruka Edomu"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Za Edomce ovako kaže Gospod nad vojskama:",
          {
            "text": "„Zar nema više mudrosti u Temanu?",
            "poem": 1
          },
          {
            "text": "Zar je iščezao savet mudraca",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i zar su pokvarili njihovu mudrost?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Bežite! Okrenite se,",
            "poem": 1
          },
          {
            "text": "u dubine nastanite, stanovnici Dedana.",
            "poem": 2
          },
          {
            "text": "Propast na Isava donosim,",
            "poem": 1
          },
          {
            "text": "vreme kada ću ga kazniti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "I berači grožđa da ti dođu,",
            "poem": 1
          },
          {
            "text": "pabirke zar ne bi ostavili?",
            "poem": 2
          },
          {
            "text": "Da lopovi haraju te noću,",
            "poem": 1
          },
          {
            "text": "zar poneli ne bi koliko im treba?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ali ja ću da ogolim Isava,",
            "poem": 1
          },
          {
            "text": "da otkrijem skrivena mu mesta,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a on sebe da sakrije neće moći.",
            "poem": 2
          },
          {
            "text": "Uništiću mu potomstvo, braću, susede",
            "poem": 1
          },
          {
            "text": "i više ga neće biti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ostavi svoju siročad i ja ću ih sačuvati žive;",
            "poem": 1
          },
          {
            "text": "udovice tvoje neka se u mene pouzdaju.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Jer ovako kaže Gospod: „Evo, iz čaše će zacelo piti i oni kojima nije suđeno da piju, pa zašto bi sasvim kazne ti pošteđen bio? Bićeš kažnjen i zacelo ćeš i ti piti."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Jer sobom se zaklinjem – govori Gospod – ruševina i ruglo, pustoš i kletva postaće Vosora; i svi njeni gradovi će postati ruine doveka.“"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Od Gospoda sam čuo vesti",
            "poem": 1
          },
          {
            "text": "i glasnik je poslan među narode:",
            "poem": 2
          },
          {
            "text": "„Okupite se! Udarite na njega!",
            "poem": 1
          },
          {
            "text": "Ustanite u boj!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "„Jer, evo, učinio sam te neznatnim među narodima",
            "poem": 1
          },
          {
            "text": "i prezrenim među ljudima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Strahovitost te je tvoja obmanula",
            "poem": 1
          },
          {
            "text": "i oholost tvoga srca,",
            "poem": 2
          },
          {
            "text": "ti što živiš u raselini stene,",
            "poem": 1
          },
          {
            "text": "stanovniče gorskih visina.",
            "poem": 2
          },
          {
            "text": "Sve i da kao orao svoje gnezdo u visine sviješ,",
            "poem": 1
          },
          {
            "text": "strovaliću te ja i odande",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Edom će postati pustoš,",
            "poem": 1
          },
          {
            "text": "i svako ko pored njega prođe užasnut će biti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i zviždaće zbog svih rana njegovih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Kao kad su opustošeni Sodoma i Gomora",
            "poem": 1
          },
          {
            "text": "i okolni gradovi –",
            "poem": 2
          },
          {
            "text": "kaže Gospod –",
            "poem": 3
          },
          {
            "text": "tamo niko prebivati neće,",
            "poem": 1
          },
          {
            "text": "neće biti potomaka ljudi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Gle, kao lav što skače iz jordanskog čestara",
            "poem": 1
          },
          {
            "text": "na pašnjak plodan,",
            "poem": 2
          },
          {
            "text": "ja ću Edom poterati odatle u trenu.",
            "poem": 1
          },
          {
            "text": "I ko god da je izabrani, tu ću ga staviti.",
            "poem": 2
          },
          {
            "text": "Jer, ko je kao ja i ko će protiv mene?",
            "poem": 1
          },
          {
            "text": "Ko je taj pastir koji će izaći pred mene?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Zato čujte namere Gospodnje što ih je za Edom namerio,",
            "poem": 1
          },
          {
            "text": "i njegove naume što je za Temance naumio:",
            "poem": 2
          },
          {
            "text": "stvarno će odvući najmlađe iz stada,",
            "poem": 1
          },
          {
            "text": "opustošiće stvarno zbog njih pašnjak njihov.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "A od praska pada njihovoga potrešće se zemlja;",
            "poem": 1
          },
          {
            "text": "vapaj njihovoga glasa će se čuti do Crvenog mora.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Gle, kao orao se diže i obrušava se,",
            "poem": 1
          },
          {
            "text": "krila svoja širi nad Vosorom!",
            "poem": 2
          },
          {
            "text": "A srce će edomskih ratnika",
            "poem": 1
          },
          {
            "text": "onoga dana biti kao srce porodilje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Poruka Damasku"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "O Damasku:",
          {
            "text": "„Osramotiće se i Amat i Arfad",
            "poem": 1
          },
          {
            "text": "zbog glasova loših što su čuli.",
            "poem": 2
          },
          {
            "text": "Istopi ih strepnja;",
            "poem": 1
          },
          {
            "text": "na moru je loše, nema mu spokoja!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Klonulo je srce u Damasku.",
            "poem": 1
          },
          {
            "text": "Okrenuo se da beži.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Užas ga je obuzeo,",
            "poem": 2
          },
          {
            "text": "nemir i bolovi su ga spopali",
            "poem": 1
          },
          {
            "text": "kao porodilju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Kako to da nije napušten grad slave,",
            "poem": 1
          },
          {
            "text": "grad radosti moje?!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Zato će da popadaju njegovi mladići po njegovim trgovima;",
            "poem": 1
          },
          {
            "text": "nastradaće toga dana svi ljudi ratnici",
            "poem": 2
          },
          {
            "text": "– govori Gospod nad vojskama.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Ja ću vatrom da zapalim zidine Damaska",
            "poem": 1
          },
          {
            "text": "i ona će da sagori Ven-Adadove dvorove.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Poruka Kedru i Asoru"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "O Kedru i o carstvima Asora koje je osvojio Navuhodonosor, car Vavilona:",
          {
            "lineBreak": true
          },
          "„Ovako kaže Gospod:",
          {
            "text": "Ustanite i idite u Kedar",
            "poem": 1
          },
          {
            "text": "i satrite istočne narode!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Uzeće i njihove šatore i njihova stada,",
            "poem": 1
          },
          {
            "text": "njihove šatorske zastore i sve njihove stvari;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "njihove će kamile uzeti za sebe",
            "poem": 2
          },
          {
            "text": "i vikaće na njih:",
            "poem": 1
          },
          {
            "text": "’Užas odasvud!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Bežite, utecite odmah,",
            "poem": 1
          },
          {
            "text": "u dubine se nastanite, stanovnici Asora",
            "poem": 2
          },
          {
            "text": "– govori Gospod –",
            "poem": 3
          },
          {
            "text": "jer je za vas osmislio naume,",
            "poem": 1
          },
          {
            "text": "namerio se na vas Navuhodonosor, car Vavilona.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Ustanite! Idite krotkom narodu",
            "poem": 1
          },
          {
            "text": "što spokojno živi",
            "poem": 2
          },
          {
            "text": "– govori Gospod –",
            "poem": 3
          },
          {
            "text": "bez vrata i bez krila na njima,",
            "poem": 1
          },
          {
            "text": "i žive sami.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Njihove će kamile postati plen,",
            "poem": 1
          },
          {
            "text": "a obilje njihove stoke grabež;",
            "poem": 2
          },
          {
            "text": "i ja ću ih razvejati svakim vetrom, te što izbrijavaju zulufe;",
            "poem": 1
          },
          {
            "text": "sa svih strana ću doneti propast njihovu na njih",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Asor će postati jazbina šakala,",
            "poem": 1
          },
          {
            "text": "pustoš doveka.",
            "poem": 2
          },
          {
            "text": "Tamo niko prebivati neće,",
            "poem": 1
          },
          {
            "text": "potomaka ljudi neće biti.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Poruka Elamu"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "Reč Gospodnja koja je došla proroku Jeremiji za Elam, na početku vladavine Sedekije, cara Jude:"
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "Ovako kaže Gospod nad vojskama:",
          {
            "text": "„Evo, lomim luk Elamov,",
            "poem": 1
          },
          {
            "text": "njihovu najveću snagu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Na Elam dovodim četiri vetra,",
            "poem": 1
          },
          {
            "text": "sa četiri strane nebeske.",
            "poem": 2
          },
          {
            "text": "Razvejaću ih svim ovim vetrovima",
            "poem": 1
          },
          {
            "text": "i neće biti naroda",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "u koji neće otići razvejani iz Elama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Poraziću Elam pred njihovim neprijateljima",
            "poem": 1
          },
          {
            "text": "i pred onima što im rade o glavi.",
            "poem": 2
          },
          {
            "text": "Propast donosim na njih,",
            "poem": 1
          },
          {
            "text": "žar svog gneva",
            "poem": 2
          },
          {
            "text": "– govori Gospod –",
            "poem": 3
          },
          {
            "text": "poslaću za njima mač",
            "poem": 1
          },
          {
            "text": "sve dok ih ne istrebim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "Presto svoj u Elamu postaviću,",
            "poem": 1
          },
          {
            "text": "cara tamošnjeg i glavare istrebiću",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
