  "chapter": {
    "number": 46,
    "content": [
      {
        "type": "heading",
        "content": [
          "Poruka Egiptu"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Reč Gospodnja koja je došla proroku Jeremiji za narode:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Za Egipat, za vojsku cara Egipta, faraona Nehaona, što je na reci Eufrat u Harkemisu i koju je porazio Navuhodonosor, car Vavilona. A to je bilo četvrte godine Josijinog sina Joakima, cara Jude."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "„Poređajte štitove i male i velike!",
            "poem": 1
          },
          {
            "text": "Spremite se za bitku!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Upregnite konje!",
            "poem": 1
          },
          {
            "text": "Uzjašite konjanici!",
            "poem": 2
          },
          {
            "text": "Zauzmite položaj sa kacigama!",
            "poem": 1
          },
          {
            "text": "Uglačajte koplja",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i oklope na sebe!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Je lʼ ja to vidim da su prestravljeni",
            "poem": 1
          },
          {
            "text": "i da su potisnuti unazad?",
            "poem": 2
          },
          {
            "text": "Njihovi su ratnici razbijeni,",
            "poem": 1
          },
          {
            "text": "povlače se, beže i ne vraćaju se.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Užas odasvud",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ne daj brzom da pobegne,",
            "poem": 1
          },
          {
            "text": "ni ratniku da se spase.",
            "poem": 2
          },
          {
            "text": "Na severu, pored reke Eufrat,",
            "poem": 1
          },
          {
            "text": "će se spotaknuti i pasti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ko je taj što poput Nila plavi",
            "poem": 1
          },
          {
            "text": "i vodom svojom nadolazi kao reka?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Egipat plavi poput Nila",
            "poem": 1
          },
          {
            "text": "i kao reka vodom nadolazi.",
            "poem": 2
          },
          {
            "text": "I još kaže: ’Nadoći ću, preplaviću zemlju,",
            "poem": 1
          },
          {
            "text": "razoriću grad i sve koji u njemu žive.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Propnite se, konji!",
            "poem": 1
          },
          {
            "text": "Jurišajte, bojna kola!",
            "poem": 2
          },
          {
            "text": "Ratnici neka iskorače: i Kuši i Futi sa štitovima",
            "poem": 1
          },
          {
            "text": "i Ludeji s lukovima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "To je dan koji pripada Gospodu, Bogu nad vojskama,",
            "poem": 1
          },
          {
            "text": "dan osvete, da se osveti svojim dušmanima.",
            "poem": 2
          },
          {
            "text": "Mač će ih proždirati dok se ne zasiti,",
            "poem": 1
          },
          {
            "text": "napiće se njihove krvi,",
            "poem": 2
          },
          {
            "text": "jer će žrtva za Gospoda, Boga nad vojskama,",
            "poem": 1
          },
          {
            "text": "biti u severnoj zemlji kraj reke Eufrat.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Popni se u Galad i kupi melem,",
            "poem": 1
          },
          {
            "text": "o, device, ćerko egipatska!",
            "poem": 2
          },
          {
            "text": "Uzalud su ti melemi brojni,",
            "poem": 1
          },
          {
            "text": "jer za tebe nema izlečenja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Narodi su čuli za tvoju sramotu",
            "poem": 1
          },
          {
            "text": "i tvoga se plača ispunila zemlja,",
            "poem": 2
          },
          {
            "text": "jer se ratnik o ratnika spotiče",
            "poem": 1
          },
          {
            "text": "i obojica padaju.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Reč koju je Gospod objavio proroku Jeremiji o pohodu Navuhodonosora, cara Vavilona, i o napadu na Egipat:"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "„Najavi u Egiptu, proglasi u Migdolu,",
            "poem": 1
          },
          {
            "text": "u Nofu i Tafnesu proglasi.",
            "poem": 2
          },
          {
            "text": "Reci: ’Postavi se i spremi se",
            "poem": 1
          },
          {
            "text": "jer mač proždire unaokolo!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Zašto su polegli tvoji ratnici?",
            "poem": 1
          },
          {
            "text": "Nisu se održali jer ih je Gospod gurnuo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Mnoge je spotaknuo",
            "poem": 1
          },
          {
            "text": "i oni padaju jedan na drugoga,",
            "poem": 2
          },
          {
            "text": "pa govore: ’Ustanimo i vratimo se",
            "poem": 1
          },
          {
            "text": "našem narodu i u svoj rodni kraj",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pred mačem tlačiteljevim.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "I narod će tamo nazvati faraona,",
            "poem": 1
          },
          {
            "text": "cara Egipta: ’Galamdžija",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kome je prošlo vreme!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Života mi moga – govori car,",
            "poem": 1
          },
          {
            "text": "Gospod nad vojskama mu je ime –",
            "poem": 2
          },
          {
            "text": "doći će kao Tavor među planinama",
            "poem": 1
          },
          {
            "text": "i kao Karmil pored mora.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Spremaj sebi prtljag za izgnanstvo,",
            "poem": 1
          },
          {
            "text": "stanovnice, ćerko egipatska.",
            "poem": 2
          },
          {
            "text": "Jer će Nof postati ruina,",
            "poem": 1
          },
          {
            "text": "opusteće od stanovnika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Egipat je prelepa junica,",
            "poem": 1
          },
          {
            "text": "a obadi sa severa dolaze i dolaze.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Plaćenici su njegovi usred njega",
            "poem": 1
          },
          {
            "text": "kao tovna telad.",
            "poem": 2
          },
          {
            "text": "Okrenuće se i pobeći će zajedno,",
            "poem": 1
          },
          {
            "text": "neće ostati na položajima.",
            "poem": 2
          },
          {
            "text": "Jer stiže na njih dan njihove propasti,",
            "poem": 1
          },
          {
            "text": "vreme njihove kazne.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "On sikće kao zmija",
            "poem": 1
          },
          {
            "text": "što je odmigoljila",
            "poem": 2
          },
          {
            "text": "jer oni dolaze u snazi,",
            "poem": 1
          },
          {
            "text": "dolaze na njega sa sekirama kao drvoseče.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Poseći će mu šumu",
            "poem": 1
          },
          {
            "text": "– govori Gospod –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ako je i nepregledna.",
            "poem": 2
          },
          {
            "text": "Više ih je nego skakavaca",
            "poem": 1
          },
          {
            "text": "što im nema broja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Biće osramoćena ćerka Egipta",
            "poem": 1
          },
          {
            "text": "i predana u ruke naroda sa severa.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Ovako kaže Gospod nad vojskama, Bog Izrailja: „Evo, ja ću da kaznim Amona u Noi, faraona, Egipat i njegove bogove, njegove careve i faraona i one što se u njega pouzdaju."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Daću ih u ruke onih koji im rade o glavi, u ruke Navuhodonosora, cara Vavilona, i u ruke njegovih slugu. A nakon toga će ga naseliti kao u starim vremenima – govori Gospod."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "A ti se ne plaši, slugo moj Jakove!",
            "poem": 1
          },
          {
            "text": "Ne strahuj, Izrailju,",
            "poem": 2
          },
          {
            "text": "jer te ja spasavam izdaleka;",
            "poem": 1
          },
          {
            "text": "iz zemlje njihovog izgnanstva vraćam tvoje potomke.",
            "poem": 2
          },
          {
            "text": "I Jakov će se vratiti, biće spokojan",
            "poem": 1
          },
          {
            "text": "i siguran jer ga niko neće plašiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Ne plaši se, slugo moj Jakove",
            "poem": 1
          },
          {
            "text": "– govori Gospod – jer sam ja s tobom.",
            "poem": 2
          },
          {
            "text": "Ja ću da istrebim sve narode",
            "poem": 1
          },
          {
            "text": "gde sam te rasejao,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ali tebe neću da istrebim.",
            "poem": 2
          },
          {
            "text": "Tebe ću pravedno da pokaram",
            "poem": 1
          },
          {
            "text": "i neću te ostaviti nekažnjenog.“",
            "poem": 2
          }
        ]
      }
    ],
