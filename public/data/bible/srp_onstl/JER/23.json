  },
  "chapter": {
    "number": 23,
    "content": [
      {
        "type": "heading",
        "content": [
          "Pravedni izdanak"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Teško pastirima što satiru i rasteruju stado moje paše – govori Gospod."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Zato ovako kaže Gospod, Bog Izrailja, pastirima koji napasaju moj narod: ’Vi ste stado moje rasterali, vi ste ih raštrkali i niste se pobrinuli za njih! Evo, sada ću ja da se pobrinem za vas zbog vaših zlih dela – govori Gospod."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Sakupiću ostatak svog stada iz svih zemalja u koje sam ih prognao. Vratiću ih na njihovu pašu, pa će biti plodni i množiće se."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Postaviću nad njima pastire koji će ih napasati, pa više neće strahovati i neće biti prestrašeni. Neće se izgubiti – govori Gospod.’"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Evo, dolaze dani – govori Gospod –",
            "poem": 1
          },
          {
            "text": "da Davidu podignem pravedni Izdanak.",
            "poem": 2
          },
          {
            "text": "On će da vlada kao car, biće mudar,",
            "poem": 1
          },
          {
            "text": "činiće pravedno i pravično po zemlji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "U njegovo vreme Juda će biti spasena,",
            "poem": 1
          },
          {
            "text": "a Izrailj će spokojno počivati.",
            "poem": 2
          },
          {
            "text": "A ovo će mu biti ime kojim će ga svako zvati:",
            "poem": 1
          },
          {
            "text": "’Gospod, naša pravednost!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Zato dolaze dani – govori Gospod – kada više neće govoriti: ’Živ bio Gospod koji je izveo izrailjski narod iz egipatske zemlje!’"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Nego: ’Živ bio Gospod koji je izveo potomke doma Izrailjevog i doveo ih iz zemlje severne i iz svih zemalja u koje sam ih izagnao!’ I oni će da prebivaju u svojoj zemlji.“"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Lažni proroci"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Zbog proroka je u meni slomljeno srce.",
          {
            "text": "Ustreptaše sve kosti moje,",
            "poem": 1
          },
          {
            "text": "postao sam kao pijanica,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kao čovek kog je stuklo vino.",
            "poem": 2
          },
          {
            "text": "A sve zbog Gospoda",
            "poem": 1
          },
          {
            "text": "i sve zbog njegovih svetih reči.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Jer sva je zemlja puna preljubnika!",
            "poem": 1
          },
          {
            "text": "Zbog kletve se osušila zemlja,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a pašnjaci pustinjski svenuli.",
            "poem": 2
          },
          {
            "text": "Zlo im je postalo životno predanje,",
            "poem": 1
          },
          {
            "text": "a nepravda snaga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "„I prorok i sveštenik su opoganjeni,",
            "poem": 1
          },
          {
            "text": "čak i u svom sam Domu pronašao zla njihova",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Zato će im put postati klizav,",
            "poem": 1
          },
          {
            "text": "u tamu će biti proterani",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i tamo će pasti.",
            "poem": 2
          },
          {
            "text": "Jer ja na njih propast nosim,",
            "poem": 1
          },
          {
            "text": "godinu njihove kazne",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Video sam: proroci Samarije po Valu",
            "poem": 1
          },
          {
            "text": "odurnosti prorokuju,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "navode moj narod Izrailj da greši.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "I među prorocima Jerusalima",
            "poem": 1
          },
          {
            "text": "sam video strahotu.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Preljubu čine, žive u laži,",
            "poem": 2
          },
          {
            "text": "rukama zlikovaca snagu daju",
            "poem": 1
          },
          {
            "text": "da se niko ne odvrati od svog zla.",
            "poem": 2
          },
          {
            "text": "Svi su mi postali kao Sodoma,",
            "poem": 1
          },
          {
            "text": "stanovnici tamošnji su mi kao Gomora.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Zato ovako kaže Gospod nad vojskama o tim prorocima:",
          {
            "text": "„Evo, nahraniću ih pelenom",
            "poem": 1
          },
          {
            "text": "i napojiću ih zatrovanom vodom,",
            "poem": 2
          },
          {
            "text": "jer je od proroka Jerusalima",
            "poem": 1
          },
          {
            "text": "po svoj zemlji krenula opoganjenost.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Zato ovako kaže Gospod nad vojskama:",
          {
            "text": "„Ne slušajte reči koje vam proroci prorokuju!",
            "poem": 1
          },
          {
            "text": "Oni vas obmanjuju,",
            "poem": 2
          },
          {
            "text": "govore vam viđenja iz svoga srca,",
            "poem": 1
          },
          {
            "text": "a ne iz usta Gospodnjih!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Uporno govore onima koji me preziru:",
            "poem": 1
          },
          {
            "text": "’Gospod je kazao: mir vam pripada!’",
            "poem": 2
          },
          {
            "text": "I svakom ko živi po samovolji svog srca",
            "poem": 1
          },
          {
            "text": "kažu: ’Neće propast na vas doći!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "A ko je bio na Gospodnjem veću?",
            "poem": 1
          },
          {
            "text": "Ko je video i ko je čuo njegovu reč?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ko je pazio na njegovu reč i poslušao je?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Evo vihora Gospodnjeg što gnevom planu!",
            "poem": 1
          },
          {
            "text": "Kovitla vihor nad glavom zlikovaca,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "baš kovitla.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Neće se povući gnev Gospodnji",
            "poem": 1
          },
          {
            "text": "dok on ne izvrši,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "dok ne učini po naumima svog srca.",
            "poem": 2
          },
          {
            "text": "A u poslednjim danima",
            "poem": 1
          },
          {
            "text": "ovo ćete sasvim shvatiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Ja nisam poslao te proroke,",
            "poem": 1
          },
          {
            "text": "a oni trče.",
            "poem": 2
          },
          {
            "text": "Ja im nisam govorio,",
            "poem": 1
          },
          {
            "text": "a oni prorokuju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "A da su bili na mom veću,",
            "poem": 1
          },
          {
            "text": "moj bi narod čuo reči moje",
            "poem": 2
          },
          {
            "text": "i oni bi ih odvratili od njihovih zlih puteva",
            "poem": 1
          },
          {
            "text": "i od njihovih zlih dela.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Jesam li ja Bog izbliza –",
            "poem": 1
          },
          {
            "text": "govori Gospod –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a nisam Bog izdaleka?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Može li neko da se sakrije na tajnim mestima,",
            "poem": 1
          },
          {
            "text": "a ja da ga ne vidim?",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          },
          {
            "text": "Ne ispunjavam li ja i nebesa i zemlju?",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Čuo sam šta govore proroci koji u moje ime prorokuju laž. Oni govore: ’Sanjao sam! Sanjao sam!’"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Dokle misle to da rade proroci što iz srca laž prorokuju, proroci sa obmanom u srcu;"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "ti što teraju moj narod da zaboravi moje ime zbog njihovih snova koje jedni drugima prepričavaju? Tako su i njihovi preci zaboravili moje ime zbog Vala."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Prorok koji je sanjao san samo neka priča o njemu, a onaj koji ima moju reč neka je tačno objavi. Jer, šta imaju slama i pšenica?! – govori Gospod."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Nije li moja reč kao oganj – govori Gospod – kao malj što razbija stenu?"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Zato ja dolazim na proroke – govori Gospod – što jedan drugom reč moju kradu."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "Evo me na proroke – govori Gospod – što jezikom govore: ’Gospodnji je ovo govor!’"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Evo me na one što proriču lažne snove – govori Gospod – što ih prepričavaju i navode moj narod da greši po njihovim lažima i njihovoj bahatosti. A ja ih nisam poslao i nisam ih ovlastio. Oni su sasvim beskorisni mom narodu – govori Gospod."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Lažna proroštva"
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "A ako te zapita ovaj narod, prorok ili sveštenik, pa ti kažu: ’Šta je breme",
          {
            "noteId": 12
          },
          "Gospodnje?’, a ti im reci: ’Vi ste breme! Odbaciću vas – govori Gospod.’"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "Proroku i svešteniku i narodu koji kaže: ’Breme Gospodnje’, sudiću takvome i njegovom domu."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "Ovako neka kaže svako svome bližnjem i svako svome bratu: ’Šta je odgovorio Gospod?’ I: ’Šta je kazao Gospod?’"
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "Ali breme Gospodnje više ne spominjite! Svakom će čoveku breme biti njegova sopstvena reč, jer ste izvrnuli reči živog Boga, našeg Boga, Gospoda nad vojskama."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "Ovako reci proroku: ’Šta ti je odgovorio Gospod?’ I: ’Šta ti je kazao Gospod?’"
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "A pošto govorite – ’Breme Gospodnje’ – zato vam ovako kaže Gospod: ’Zato što govorite ovu reč – ’Breme Gospodnje’ – a ja sam vam poslao poruku: ’Ne smete više da govorite: ’Breme Gospodnje’."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "Zato, evo me, da vas zaboravim! Sasvim ću da vas zaboravim i napustim i vas i grad koji sam dao vama i vašim precima. Odbaciću vas od svoga lica."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "Staviću na vas večno ruglo i večnu sramotu koji se ne zaboravljaju.“"
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 12,
        "caller": "+",
        "text": "23,33 Ovaj pojam može da znači i poruka (vidi Isa 13,1; 15,1).",
