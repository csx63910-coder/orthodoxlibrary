  },
  "chapter": {
    "number": 9,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "O, kad bi mi glava bila voda,",
            "poem": 1
          },
          {
            "text": "a moje oko vrelo suza,",
            "poem": 2
          },
          {
            "text": "pa da oplakujem i danju i noću",
            "poem": 1
          },
          {
            "text": "izginule od ćerki moga naroda!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "O, kad bih u pustinji imao",
            "poem": 1
          },
          {
            "text": "prenoćište za putnike,",
            "poem": 2
          },
          {
            "text": "mogao bih da napustim svoj narod",
            "poem": 1
          },
          {
            "text": "i da odem od njih.",
            "poem": 2
          },
          {
            "text": "Jer, svi su preljubnici",
            "poem": 1
          },
          {
            "text": "i sabor nevernika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "„Kao svoj luk oni zapinju jezik lažima.",
            "poem": 1
          },
          {
            "text": "Ali nisu zbog istine",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "postali jaki u zemlji,",
            "poem": 2
          },
          {
            "text": "jer hrle od zla do zla",
            "poem": 1
          },
          {
            "text": "i mene ne poznaju",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Svako nek se pazi od svoga bližnjeg",
            "poem": 1
          },
          {
            "text": "i ne verujte nijednom bratu.",
            "poem": 2
          },
          {
            "text": "Jer svaki brat uporno vara",
            "poem": 1
          },
          {
            "text": "i svaki bližnji kleveće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "I svako vara svoga bližnjeg",
            "poem": 1
          },
          {
            "text": "i ne govore istinu.",
            "poem": 2
          },
          {
            "text": "Svoj su jezik naučili da govori lažno.",
            "poem": 1
          },
          {
            "text": "Iznureni su od grešenja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ti živiš usred prevare,",
            "poem": 1
          },
          {
            "text": "a baš zbog prevare oni odbijaju da me znaju",
            "poem": 2
          },
          {
            "text": "– govori Gospod.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Zato ovako kaže Gospod nad vojskama:",
          {
            "text": "„Evo, pretopiću ih i oprobaću ih.",
            "poem": 1
          },
          {
            "text": "Jer, kako da postupim",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "sa ćerkom svog naroda?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Njihov je jezik strela što ubija",
            "poem": 1
          },
          {
            "text": "i govori prevaru.",
            "poem": 2
          },
          {
            "text": "Svojim ustima o miru sa svojim bližnjim čovek govori,",
            "poem": 1
          },
          {
            "text": "ali u sebi kuje spletku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Zar zbog toga da ih ne kaznim?",
            "poem": 1
          },
          {
            "text": "– govori Gospod.",
            "poem": 2
          },
          {
            "text": "Nad narodom poput ovog",
            "poem": 1
          },
          {
            "text": "zar da se ne osveti moja duša?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Nad brdima ću da vapim,",
            "poem": 1
          },
          {
            "text": "naricaću naricaljku nad pustinjskim pašnjacima",
            "poem": 2
          },
          {
            "text": "jer su opustošeni. Niko tuda ne prolazi,",
            "poem": 1
          },
          {
            "text": "i ne čuje se rika stoke.",
            "poem": 2
          },
          {
            "text": "Od ptica pa do životinja,",
            "poem": 1
          },
          {
            "text": "sve je pobeglo i nestalo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "„Od Jerusalima ću da učinim gomilu kamenja",
            "poem": 1
          },
          {
            "text": "i brlog šakala.",
            "poem": 2
          },
          {
            "text": "Od Judinih gradova ću da napravim",
            "poem": 1
          },
          {
            "text": "pustoš u kojoj niko ne živi.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ko je mudar čovek da razume ovo i kome su usta Gospodnja govorila da to rastumači? Zbog čega je zemlja nastradala i kao pustinja opustošena da kroz nju niko ne prolazi?"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "I Gospod reče: „Zato što su ostavili moj Zakon koji sam pred njih postavio, i zato što nisu slušali moj glas ni po njemu išli."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Nego su išli po samovolji svog srca za Valima, kako su ih njihovi preci naučili.“"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Zato ovako kaže Gospod nad vojskama, Bog Izrailjev: „Evo, ja ću da nahranim ovaj narod pelenom i napojim ga zatrovanom vodom."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Rasuću ih među narode koje nisu znali, ni oni, ni njihovi preci. Poslaću za njima mač dok ih ne dokrajčim.“"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "I ovo kaže Gospod nad vojskama:",
          {
            "text": "„Razmotrite, pa sazovite narikače neka dođu.",
            "poem": 1
          },
          {
            "text": "Ali pošalji po one koje su vešte, neka dođu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ali neka požure,",
            "poem": 1
          },
          {
            "text": "neka nariču nad nama,",
            "poem": 2
          },
          {
            "text": "pa da nam oči suzama rone",
            "poem": 1
          },
          {
            "text": "i da nam kapci budu uplakani.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Evo, čuje se naricanje sa Siona:",
            "poem": 1
          },
          {
            "text": "’O, kako smo propali!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Strahovito smo osramoćeni,",
            "poem": 2
          },
          {
            "text": "jer smo napustili svoju zemlju",
            "poem": 1
          },
          {
            "text": "i domovi su nam porušeni.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Čujte, žene, reč Gospodnju.",
            "poem": 1
          },
          {
            "text": "Neka vaše uho primi reč njegovih usta.",
            "poem": 2
          },
          {
            "text": "Naučite svoje ćerke da nariču",
            "poem": 1
          },
          {
            "text": "i svaka žena svoju susetku da leleče.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Smrt se uspuzala na naše prozore.",
            "poem": 1
          },
          {
            "text": "Došla je u naše dvorove,",
            "poem": 2
          },
          {
            "text": "istrebila decu sa ulica",
            "poem": 1
          },
          {
            "text": "i mladiće sa trgova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Reci: „Govori Gospod:",
          {
            "text": "’Leševi će ljudi po tlu popadati",
            "poem": 1
          },
          {
            "text": "kao gnojivo po polju,",
            "poem": 2
          },
          {
            "text": "kao snop za žeteocem,",
            "poem": 1
          },
          {
            "text": "a neće imati ko da ga sakupi.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Ovako kaže Gospod:",
          {
            "text": "„Neka se mudrac ne hvali svojom mudrošću,",
            "poem": 1
          },
          {
            "text": "neka se junak ne hvali svojim junaštvom,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i bogataš neka se bogatstvom svojim ne hvali.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "A ko hoće da se hvali,",
            "poem": 1
          },
          {
            "text": "neka se hvali time što mene poznaje,",
            "poem": 2
          },
          {
            "text": "što proniče da sam ja Gospod koji čini milost,",
            "poem": 1
          },
          {
            "text": "pravdu i pravednost na zemlji,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i da u tome uživam –",
            "poem": 2
          },
          {
            "text": "ovako kaže Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Evo, dolaze dani – govori Gospod – kada ću kazniti sve one samo po telu obrezane:"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Egipat i Judu, Edom zajedno sa Amoncima i Moavcima; koji izbrijavaju zulufe i koji žive u pustinji. Jer svi su ti narodi neobrezani i sav je Izrailjev dom neobrezanog srca.“"
        ]
      }
    ],
