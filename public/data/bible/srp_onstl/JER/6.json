  },
  "chapter": {
    "number": 6,
    "content": [
      {
        "type": "heading",
        "content": [
          "Jerusalim pod opsadom"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Beži i sklanjaj se iz Jerusalima,",
            "poem": 1
          },
          {
            "text": "narode Venijaminov!",
            "poem": 2
          },
          {
            "text": "U Tekuji zatrubi u trubu,",
            "poem": 1
          },
          {
            "text": "a u Vet-Keremu vatrom dajte znak,",
            "poem": 2
          },
          {
            "text": "jer se sa severa nadvija propast",
            "poem": 1
          },
          {
            "text": "i veliko razaranje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Razoriću lepuškastu i razmaženu ćerku sionsku!",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Njoj dolaze pastiri sa svojim stadima,",
            "poem": 1
          },
          {
            "text": "oko nje podižu šatore",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i svaki će da pase po svom delu.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "„Pozivajte na boj protiv nje!",
            "poem": 1
          },
          {
            "text": "Ustanimo i krenimo na njih usred bela dana.",
            "poem": 2
          },
          {
            "text": "Jao nama! Dan izmače",
            "poem": 1
          },
          {
            "text": "i večernje senke su se izdužile.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ustanimo i krenimo",
            "poem": 1
          },
          {
            "text": "da joj po noći razorimo dvorove!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Jer govori Gospod nad vojskama:",
          {
            "text": "„Secite stabla",
            "poem": 1
          },
          {
            "text": "i naspite bedem protiv Jerusalima.",
            "poem": 2
          },
          {
            "text": "Grad će taj da odgovara",
            "poem": 1
          },
          {
            "text": "zbog tlačenja što je svud po njemu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Kao što bunar čuva hladnu vodu",
            "poem": 1
          },
          {
            "text": "tako i on čuva zlo svoje.",
            "poem": 2
          },
          {
            "text": "Nasilje i pustoš se čuju u njemu,",
            "poem": 1
          },
          {
            "text": "a preda mnom stalno bolest su i rane.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Pouči se, Jerusalime,",
            "poem": 1
          },
          {
            "text": "da se ne bi od tebe odvojila moja duša,",
            "poem": 2
          },
          {
            "text": "da te ne bih pretvorio u opustošenu zemlju",
            "poem": 1
          },
          {
            "text": "u kojoj niko ne boravi.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Govori Gospod nad vojskama:",
          {
            "text": "„Temeljno će kao lozu popabirčiti",
            "poem": 1
          },
          {
            "text": "ostatak Izrailjev.",
            "poem": 2
          },
          {
            "text": "Vrati svoju ruku",
            "poem": 1
          },
          {
            "text": "kao berač grožđa nad mladicu.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Kome da govorim, da upozoravam,",
            "poem": 1
          },
          {
            "text": "a da čuju?",
            "poem": 2
          },
          {
            "text": "Evo, neobrezano im je uho",
            "poem": 1
          },
          {
            "text": "i ne mogu da sa pažnjom čuju.",
            "poem": 2
          },
          {
            "text": "Evo, Gospodnja se reč za njih pretvorila u ruglo",
            "poem": 1
          },
          {
            "text": "i u njoj ne uživaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Pun sam gneva Gospodnjeg,",
            "poem": 1
          },
          {
            "text": "iznurilo me je da ga zadržavam.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Izlij ga po deci na ulici",
            "poem": 1
          },
          {
            "text": "i na skup mladića.",
            "poem": 2
          },
          {
            "text": "I muža i ženu će zahvatiti,",
            "poem": 1
          },
          {
            "text": "i stare i vremenite.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Njihove će se kuće predati drugima,",
            "poem": 1
          },
          {
            "text": "baš kao i polja i žene,",
            "poem": 2
          },
          {
            "text": "jer ja ću podići svoju ruku",
            "poem": 1
          },
          {
            "text": "na stanovnike zemlje",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Baš svi, od malog pa do velikog među njima",
            "poem": 1
          },
          {
            "text": "grabe nepošteni dobitak.",
            "poem": 2
          },
          {
            "text": "Od proroka pa do sveštenika,",
            "poem": 1
          },
          {
            "text": "baš svi varaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Oni mom narodu",
            "poem": 1
          },
          {
            "text": "olako leče prelom pričajući:",
            "poem": 2
          },
          {
            "text": "’Mir! Mir!’",
            "poem": 1
          },
          {
            "text": "A nema mira.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Jesu li se zastideli zato što su učinili gadost?",
            "poem": 1
          },
          {
            "text": "Baš se nimalo nisu zastideli",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i ne znaju za stid.",
            "poem": 2
          },
          {
            "text": "Zato će pasti među one što padaju",
            "poem": 1
          },
          {
            "text": "i u času kada ih kaznim biće sapleteni",
            "poem": 2
          },
          {
            "text": "– govori Gospod.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Ovako kaže Gospod:",
          {
            "text": "„Stanite na puteve, gledajte",
            "poem": 1
          },
          {
            "text": "i pitajte za staze od davnina.",
            "poem": 2
          },
          {
            "text": "Pa koji je put dobar, idite njime,",
            "poem": 1
          },
          {
            "text": "i nađite spokoj svojim dušama.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ali oni rekoše: ’Nećemo da idemo!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Stražare sam postavio nad vama:",
            "poem": 1
          },
          {
            "text": "’Pazite na zvuk trube!’",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ali su mi oni rekli: ’Nećemo da pazimo!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Zato slušajte, narodi,",
            "poem": 1
          },
          {
            "text": "i poznaj, zajednico, šta je s njima:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Poslušaj zemljo!",
            "poem": 1
          },
          {
            "text": "Evo donosim propast na ovaj narod,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "plod samih njihovih spletki.",
            "poem": 2
          },
          {
            "text": "Jer za moje reči nisu marili",
            "poem": 1
          },
          {
            "text": "i moj su Zakon prezreli.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Šta će meni tamjan što dolazi iz Save",
            "poem": 1
          },
          {
            "text": "i cimet iz daleke zemlje?",
            "poem": 2
          },
          {
            "text": "Ne prihvatam vaše svespalnice.",
            "poem": 1
          },
          {
            "text": "I u ostalim žrtvama ne uživam.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "I zato kaže Gospod:",
          {
            "text": "„Evo, daću ovom narodu kamenje spoticanja,",
            "poem": 1
          },
          {
            "text": "pa će se spoticati o njih.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Nastradaće i očevi i sinovi, sused i njegov prijatelj.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Evo kako govori Gospod:",
          {
            "text": "„Gle, narod dolazi",
            "poem": 1
          },
          {
            "text": "iz severne zemlje!",
            "poem": 2
          },
          {
            "text": "Veliki će narod biti podignut",
            "poem": 1
          },
          {
            "text": "iz najdaljih zemljinih krajeva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Oni drže luk i koplje.",
            "poem": 1
          },
          {
            "text": "Okrutni su i nemilosrdni,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a glas im huči kao more.",
            "poem": 2
          },
          {
            "text": "Jašu konje spremni kao ratnik",
            "poem": 1
          },
          {
            "text": "protiv tebe, ćerko sionska.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Čuli smo o njima glas",
            "poem": 1
          },
          {
            "text": "i ruke su nam klonule,",
            "poem": 2
          },
          {
            "text": "obuzeli su nas zebnja",
            "poem": 1
          },
          {
            "text": "i bol kao porodilju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Ne izlazi u polje",
            "poem": 1
          },
          {
            "text": "i ne idi putem,",
            "poem": 2
          },
          {
            "text": "jer je užas odasvud",
            "poem": 1
          },
          {
            "text": "i mač neprijateljev.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Ćerko mog naroda, opaši kostret",
            "poem": 1
          },
          {
            "text": "i valjaj se u pepelu.",
            "poem": 2
          },
          {
            "text": "Žali kao za jedincem, gorko plači",
            "poem": 1
          },
          {
            "text": "jer će nenadano doći na nas zatirač.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "„Postavio sam te kao ispitivača metala među moj narod,",
            "poem": 1
          },
          {
            "text": "kao utvrđenje, da ispitaš",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i oprobaš njihov put.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Svi su oni najgori odmetnici,",
            "poem": 1
          },
          {
            "text": "idu pa kleveću.",
            "poem": 2
          },
          {
            "text": "Oni su od bronze i gvožđa,",
            "poem": 1
          },
          {
            "text": "svi su zatirači.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Mehovi se zapališe od vreline",
            "poem": 1
          },
          {
            "text": "i vatra je spalila olovo.",
            "poem": 2
          },
          {
            "text": "Zalud neko pretapa i kali,",
            "poem": 1
          },
          {
            "text": "jer zlikovce ne može da odvoji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "’Srebro odbačeno’, zvaće se,",
            "poem": 1
          },
          {
            "text": "jer ih je Gospod odbacio.“",
            "poem": 2
          }
        ]
      }
    ],
