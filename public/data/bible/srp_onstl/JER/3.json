  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ako muž otpusti svoju ženu",
            "poem": 1
          },
          {
            "text": "i ona ode od njega i pripadne drugom čoveku,",
            "poem": 2
          },
          {
            "text": "hoće li on da je vrati i ponovo uzme nazad?",
            "poem": 1
          },
          {
            "text": "Zar neće biti sasvim oskrnavljena ta zemlja?",
            "poem": 2
          },
          {
            "text": "A ti si bludničila sa mnogim drugima",
            "poem": 1
          },
          {
            "text": "i meni ćeš li se vratiti?",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Podigni svoje oči na ogolele visove i osmotri:",
            "poem": 1
          },
          {
            "text": "Gde još nisi napastvovana?",
            "poem": 2
          },
          {
            "text": "Na putevima si sedela zbog njih",
            "poem": 1
          },
          {
            "text": "kao Arapin u pustinji.",
            "poem": 2
          },
          {
            "text": "Oskrnavila si zemlju",
            "poem": 1
          },
          {
            "text": "svojim bludničenjem i svojom pokvarenošću.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Zato su zaustavljeni pljuskovi",
            "poem": 1
          },
          {
            "text": "i nije bilo poznih kiša.",
            "poem": 2
          },
          {
            "text": "A ti si dobila obraz žene bludnice,",
            "poem": 1
          },
          {
            "text": "ali si odbila da se postidiš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Nećeš li od sada da me dozivaš:",
            "poem": 1
          },
          {
            "text": "’Oče moj, prijatelju mladosti moje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Hoće li se gneviti doveka?",
            "poem": 1
          },
          {
            "text": "Zar će neprestano da se ljuti?’",
            "poem": 2
          },
          {
            "text": "Čuj, rekla si,",
            "poem": 1
          },
          {
            "text": "a učinila si zla koliko si mogla.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Neverni Izrailj"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Gospod mi je rekao za vreme cara Josije: „Jesi li video šta je učinila otpadnica Izrailj? Išla je na svaku uzvišicu i pod svako zeleno drvo i onde bludničila."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "A mislio sam, posle svega toga što je učinila, da će mi se vratiti, a nije mi se vratila. I to je videla Judeja, njena prevrtljiva sestra."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Naime, video sam da je u svim tim slučajevima bludničila otpadnica Izrailj, pa sam je otpustio i dao joj potvrdu o razvodu. Ali se nije uplašila Judeja, njena prevrtljiva sestra, nego i ona ode da takođe bludniči."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Eto, svojim je lakomislenim bludničenjem opoganila zemlju. Počinila je preljubu i na kamenu i na drvetu."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Ali i pored svega toga nije mi se svim svojim srcem vratila njena prevrtljiva sestra Judeja, nego prividno – govori Gospod.“"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Na to mi je rekao Gospod: „Otpadnica Izrailj se pokazala pravednijom nego prevrtljiva Judeja!"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Idi i objavi ove reči severu pa reci:",
          {
            "text": "’Vrati se, otpadnice Izrailju – govori Gospod –",
            "poem": 1
          },
          {
            "text": "neću da te gledam gnevno.",
            "poem": 2
          },
          {
            "text": "Jer ja sam veran – govori Gospod –",
            "poem": 1
          },
          {
            "text": "i neću da se gnevim doveka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Samo shvati svoje krivice.",
            "poem": 1
          },
          {
            "text": "Jer, protiv Gospoda, svog Boga, si se pobunila",
            "poem": 2
          },
          {
            "text": "i rasula svoje puteve tuđincima pod svakim zelenim drvetom,",
            "poem": 1
          },
          {
            "text": "a glas moj niste poslušali",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Vrati se, o, narode odmetnički – govori Gospod – jer ja sam oženjen vama i ja ću da vas uzmem: jednog iz grada i dvoje iz roda i odvešću vas na Sion."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Daću vam pastire po mom srcu i oni će vas napasati znanjem i razboritošću."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "I biće ovako: kada se umnožite i budete plodni u zemlji tih dana – govori Gospod – narod više neće govoriti: „Kovčeg Gospodnjeg saveza!“ Neće im dolaziti na um i narod ga se neće sećati, jer im više neće nedostajati ili opet biti pravljen."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "U to vreme narod će Jerusalim zvati prestolom Gospodnjim. I u njemu, u Jerusalimu, će se svi narodi okupiti ka imenu Gospodnjem i neće više hodati po samovolji svog zlog srca."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "U to će vreme dom Judin ići sa domom Izrailjevim, i zajedno će doći iz severne zemlje u zemlju koju sam dao u nasledstvo vašim precima."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "I pomislio sam:",
          {
            "text": "„Kako da te postavim među sinove?",
            "poem": 1
          },
          {
            "text": "Kako da ti dam zemlju čežnje,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "preslavno nasledstvo naroda?“",
            "poem": 2
          },
          {
            "text": "Pomislio sam: zvaćeš me „Oče moj!“",
            "poem": 1
          },
          {
            "text": "i od mene otići nećeš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Ipak, kao što žena izneveri svog muža",
            "poem": 1
          },
          {
            "text": "tako ste i vi izneverili mene, o, dome Izrailjev",
            "poem": 2
          },
          {
            "text": "– govori Gospod.’“",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Na ogolelim visovima se čuje vapaj",
            "poem": 1
          },
          {
            "text": "preklinjanja izrailjskog naroda,",
            "poem": 2
          },
          {
            "text": "jer su izopačili svoje puteve",
            "poem": 1
          },
          {
            "text": "i zaboravili su Gospoda, svog Boga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "„Vrati se, o, narode odmetnički!",
            "poem": 1
          },
          {
            "text": "Ja ću da izlečim vaše otpadništvo.“",
            "poem": 2
          },
          {
            "text": "„Evo nas! Tebi smo došli",
            "poem": 1
          },
          {
            "text": "jer ti si Gospod, naš Bog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Zaista, sa uzvišica stiže obmana,",
            "poem": 1
          },
          {
            "text": "a metež sa planina.",
            "poem": 2
          },
          {
            "text": "Zaista, u Gospodu, našem Bogu",
            "poem": 1
          },
          {
            "text": "je spasenje Izrailja!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Bog sramote",
            "poem": 1
          },
          {
            "noteId": 4
          },
          {
            "text": "je proždro",
            "poem": 1
          },
          {
            "text": "trud naših otaca još od naše mladosti,",
            "poem": 2
          },
          {
            "text": "i njihova stada, njihova krda,",
            "poem": 1
          },
          {
            "text": "njihove sinove i njihove ćerke.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Lezimo u sramotu svoju",
            "poem": 1
          },
          {
            "text": "i neka nas pokrije naš stid!",
            "poem": 2
          },
          {
            "text": "Zgrešili smo Gospodu, našem Bogu,",
            "poem": 1
          },
          {
            "text": "mi i naši preci",
            "poem": 2
          },
          {
            "text": "još od svoje mladosti, sve do danas,",
            "poem": 1
          },
          {
            "text": "i nismo poslušali glas Gospoda, našeg Boga.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 4,
        "caller": "+",
        "text": "3,24 Stih 24 pokazuje ironiju pouzdanja u lažnog boga. Pokajnik u ispovesti Vala naziva sramotom.",
        "reference": {
