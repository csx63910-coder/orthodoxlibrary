  "chapter": {
    "number": 47,
    "content": [
      {
        "type": "heading",
        "content": [
          "Poruka Filistejcima"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Reč Gospodnja koja je došla proroku Jeremiji za Filistejce, pre nego je faraon udario na Gazu:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Ovako kaže Gospod:",
          {
            "text": "„Evo, dižu se vode sa severa,",
            "poem": 1
          },
          {
            "text": "postaju bujični potoci i plave zemlju",
            "poem": 2
          },
          {
            "text": "i sve što je u njoj,",
            "poem": 1
          },
          {
            "text": "grad i one što žive u njemu.",
            "poem": 2
          },
          {
            "text": "I svako će da zavapi,",
            "poem": 1
          },
          {
            "text": "zakukaće svaki stanovnik zemlje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Od topota kopita njihovih ždrebaca,",
            "poem": 1
          },
          {
            "text": "od vreve njihovih kola",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i praska točkova njihovih",
            "poem": 2
          },
          {
            "text": "ni očevi se, nemoćni od straha",
            "poem": 1
          },
          {
            "text": "neće vratiti po svoju decu;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "zbog dana što dolazi",
            "poem": 1
          },
          {
            "text": "da satre sve Filistejce,",
            "poem": 2
          },
          {
            "text": "da istrebi Tiru i Sidonu",
            "poem": 1
          },
          {
            "text": "sve preživele pomoćnike.",
            "poem": 2
          },
          {
            "text": "Jer Gospod će da pohara Filistejce,",
            "poem": 1
          },
          {
            "text": "ostatak ostrva Kaftor",
            "poem": 2
          },
          {
            "noteId": 26
          },
          {
            "text": ".",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Oćelaviće Gaza!",
            "poem": 1
          },
          {
            "text": "Opustošiće Askalon!",
            "poem": 2
          },
          {
            "text": "O, ostače njihove doline,",
            "poem": 1
          },
          {
            "text": "dokle ćeš sebe parati?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "’Jao, maču Gospodnji,",
            "poem": 1
          },
          {
            "text": "koliko se još primiriti nećeš?!",
            "poem": 2
          },
          {
            "text": "Priberi se, u korice usuči se",
            "poem": 1
          },
          {
            "text": "i ostani miran.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Kako da se primiri",
            "poem": 1
          },
          {
            "text": "kada mu je Gospod zapovedio?",
            "poem": 2
          },
          {
            "text": "Za Askalon i za obalu morsku,",
            "poem": 1
          },
          {
            "text": "tamo ga je on odredio.“",
            "poem": 2
          }
        ]
      }
    ],
