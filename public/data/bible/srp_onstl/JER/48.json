  "chapter": {
    "number": 48,
    "content": [
      {
        "type": "heading",
        "content": [
          "Poruka Moavu"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ovako kaže Moavu, Gospod nad vojskama, Bog Izrailja:",
          {
            "text": "„Jao Navavu, jer će se opustošiti!",
            "poem": 1
          },
          {
            "text": "Kirijatajim će se posramiti i porobiti;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "posramiće se utvrđenje i razvaliti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Neće se više Moav dičiti",
            "poem": 1
          },
          {
            "text": "jer mu zlo spremaju u Esevonu:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "’Hajde da ga istrebimo kao narod.’",
            "poem": 2
          },
          {
            "text": "A i ti, Madmane, ćeš ućutati,",
            "poem": 1
          },
          {
            "text": "jer mač na tebe kreće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Čuje se vrisak iz Oronajima.",
            "poem": 1
          },
          {
            "text": "Pustošenje, razaranje veliko!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Moav je slomljen",
            "poem": 1
          },
          {
            "text": "i čuje se plač njegove nejači.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Na usponu luitskom",
            "poem": 1
          },
          {
            "text": "penjaće se neprestano plačući,",
            "poem": 2
          },
          {
            "text": "i slušaće vapaj razaranja",
            "poem": 1
          },
          {
            "text": "na padini Oronajima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Bežite! Živote spasavajte",
            "poem": 1
          },
          {
            "text": "i budite ko grm smreke u pustinji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Zato što se pouzdaješ u svoja dela",
            "poem": 1
          },
          {
            "text": "i u blago svoje, i ti ćeš biti porobljen.",
            "poem": 2
          },
          {
            "text": "I Hamos",
            "poem": 1
          },
          {
            "noteId": 27
          },
          {
            "text": "će otići u ropstvo,",
            "poem": 1
          },
          {
            "text": "njegovi sveštenici i njegovi glavari zajedno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Zatirač će proći od grada do grada",
            "poem": 1
          },
          {
            "text": "i nijedan neće izmaći.",
            "poem": 2
          },
          {
            "text": "Propašće dolina",
            "poem": 1
          },
          {
            "text": "i visoravan će biti uništena",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kako je kazao Gospod.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Dajte krila Moavu da poleti,",
            "poem": 1
          },
          {
            "text": "da ode iz svojih gradova",
            "poem": 2
          },
          {
            "text": "što će postati ruševine",
            "poem": 1
          },
          {
            "text": "bez stanovnika u njima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Proklet svako ko nemarno radi Gospodnji posao!",
            "poem": 1
          },
          {
            "text": "Proklet onaj što od krvi mač svoj usteže!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Spokojan i siguran je bio Moav",
            "poem": 1
          },
          {
            "text": "od svoje mladosti,",
            "poem": 2
          },
          {
            "text": "kao talog nepretakan iz bureta u bure.",
            "poem": 1
          },
          {
            "text": "U izgnanstvo nije išao,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ukus i miris mu se nisu menjali.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Zato, evo dolaze dani",
            "poem": 1
          },
          {
            "text": "– govori Gospod –",
            "poem": 2
          },
          {
            "text": "kada ću im poslati pretakače",
            "poem": 1
          },
          {
            "text": "da ih pretoče u svoju burad,",
            "poem": 2
          },
          {
            "text": "a da isprazne njihove krčage",
            "poem": 1
          },
          {
            "text": "i skrše ih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Osramotiće se Moavci zbog Hamosa",
            "poem": 1
          },
          {
            "text": "kao što se zbog Vetilja,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "svoje uzdanice, osramotio dom Izrailjev.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Kako možeš da govoriš: ’Ratnici smo,",
            "poem": 1
          },
          {
            "text": "bitke smo junaci!’?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Moav je poharan, gradovi mu osvojeni,",
            "poem": 1
          },
          {
            "text": "a najbolji mladići njegovi sišli su na klanje",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "– govori car, Gospod nad vojskama mu je ime.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Blizu je, dolazi propast Moava.",
            "poem": 1
          },
          {
            "text": "Žuri, ne zastaje njegovo zlo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Žalite ga, svi vi oko njega,",
            "poem": 1
          },
          {
            "text": "svi što znate za njegovo ime.",
            "poem": 2
          },
          {
            "text": "Pa kažite: ’Žezlo moći, žezlo slavonosno –",
            "poem": 1
          },
          {
            "text": "kako ga slomiše!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Spusti se iz časti svoje,",
            "poem": 1
          },
          {
            "text": "na tlo sedi isušeno, stanovnice,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ćerko devonska.",
            "poem": 2
          },
          {
            "text": "Onaj što je poharao Moav",
            "poem": 1
          },
          {
            "text": "uspinje se k tebi",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da i tvoja utvrđenja skrši.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Na put stani i posmatraj, stanovnice,",
            "poem": 1
          },
          {
            "text": "ćerko Aroira.",
            "poem": 2
          },
          {
            "text": "Čoveka što beži i ženu izbeglu ti upitaj:",
            "poem": 1
          },
          {
            "text": "’Šta se dogodilo?’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Moav je osramoćen jer je srušen.",
            "poem": 1
          },
          {
            "text": "Vapite, plačite",
            "poem": 2
          },
          {
            "text": "i objavite u Arnonu",
            "poem": 1
          },
          {
            "text": "da je Moav poharan.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Sud dolazi na visoravan,",
            "poem": 1
          },
          {
            "text": "na Olon, na Jasu i Mifat;",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "na Devon, na Navav i Vet-Devlataim;",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "na Kirijatajim, na Vet-Gamul i na Vet-Meon;",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "na Keriot i na Vosoru,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "na sve gradove moavske zemlje koji su daleko i koji su blizu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Slomljena je Moavova sila,",
            "poem": 1
          },
          {
            "text": "polomljena ruka je njegova",
            "poem": 2
          },
          {
            "text": "– govori Gospod.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Opijte ga,",
            "poem": 1
          },
          {
            "text": "jer je sebe nad Gospodom uzdigao.",
            "poem": 2
          },
          {
            "text": "Ali valjaće se Moav u izbljuvku svome",
            "poem": 1
          },
          {
            "text": "i postaće priča drugima za podsmeh.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Nije li i tebi Izrailj bio priča za podsmeh,",
            "poem": 1
          },
          {
            "text": "kao lopov uhvaćeni,",
            "poem": 2
          },
          {
            "text": "pa vrtiš glavom",
            "poem": 1
          },
          {
            "text": "kad o njemu pričaš?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Napustite gradove i živite u vrletima,",
            "poem": 1
          },
          {
            "text": "stanovnici Moava.",
            "poem": 2
          },
          {
            "text": "Postanite kao golub što se gnezdi",
            "poem": 1
          },
          {
            "text": "u visokoj raselini.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Za Moavov smo ponos čuli,",
            "poem": 1
          },
          {
            "text": "za ponos veliki, za njegovu oholost,",
            "poem": 2
          },
          {
            "text": "za njegovu osornost i hvalisanje,",
            "poem": 1
          },
          {
            "text": "i za gordost njegovog srca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "„Znam ja – govori Gospod –",
            "poem": 1
          },
          {
            "text": "obest njegovu.",
            "poem": 2
          },
          {
            "text": "Lažno je njegovo hvalisanje",
            "poem": 1
          },
          {
            "text": "i lažima ništa neće da postigne.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Kukam zato za Moavom,",
            "poem": 1
          },
          {
            "text": "plačem za svima njima, Moavcima.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ječim za ljudima u Kir-Eresu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Plakaću za tobom više, lozo sivamska,",
            "poem": 1
          },
          {
            "text": "nego što sam plakao za Jazirom.",
            "poem": 2
          },
          {
            "text": "Mladice tvoje su bile pružene do mora,",
            "poem": 1
          },
          {
            "text": "sve do mora jazirskog.",
            "poem": 2
          },
          {
            "text": "A sada se na tvoje, tek pristiglo letnje voće,",
            "poem": 1
          },
          {
            "text": "i na berbu tvoju, ustremio zatirač.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Nestali su radost i veselje",
            "poem": 1
          },
          {
            "text": "iz voćnjaka i iz zemlje moavske.",
            "poem": 2
          },
          {
            "text": "Učinio sam da nestane vina iz kaca,",
            "poem": 1
          },
          {
            "text": "da gazilac ne gazi grožđe u kaci radujući se.",
            "poem": 2
          },
          {
            "text": "Biće vriske,",
            "poem": 1
          },
          {
            "text": "ali ne od radosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Od Esevona do Elealije i Jase",
            "poem": 1
          },
          {
            "text": "se čuje naricanje,",
            "poem": 2
          },
          {
            "text": "viču od Soara do Oronajima i Eglat-Selisija",
            "poem": 1
          },
          {
            "text": "jer su se isušile vode nimrimske.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Istrebiću u Moavu",
            "poem": 1
          },
          {
            "text": "– govori Gospod –",
            "poem": 2
          },
          {
            "text": "onog što žrtvuje po uzvišicama",
            "poem": 1
          },
          {
            "text": "i onog koji kadi svojim bogovima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Za Moavom kao frula jeca srce moje.",
            "poem": 1
          },
          {
            "text": "Za ljudima Kir-Eresa kao frula jeca srce moje,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "zato što je nastradalo ono što su stekli.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Sve su glave ogolele",
            "poem": 1
          },
          {
            "text": "i sve brade obrijane.",
            "poem": 2
          },
          {
            "text": "Sve su ruke izbrazdane,",
            "poem": 1
          },
          {
            "text": "a kostret je na bedrima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "Na svim krovovima Moava",
            "poem": 1
          },
          {
            "text": "i na njegovim trgovima",
            "poem": 2
          },
          {
            "text": "samo žalopojke,",
            "poem": 1
          },
          {
            "text": "jer sam skršio Moav",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kao krčag koji niko neće",
            "poem": 2
          },
          {
            "text": "– govori Gospod.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          {
            "text": "Žaliće: „O, kako je skršen!",
            "poem": 1
          },
          {
            "text": "Kako je Moav okrenuo glavu jer je posramljen.",
            "poem": 2
          },
          {
            "text": "Postao je Moav priča za podsmeh",
            "poem": 1
          },
          {
            "text": "i užasavanje svim mestima unaokolo.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "Jer ovako kaže Gospod:",
          {
            "text": "„Evo, kao orao se obrušava",
            "poem": 1
          },
          {
            "text": "i krila svoja širi nad Moavom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          {
            "text": "Keriot je osvojen,",
            "poem": 1
          },
          {
            "text": "utvrđenja opkoljena,",
            "poem": 2
          },
          {
            "text": "a srce će moavskih ratnika",
            "poem": 1
          },
          {
            "text": "onoga dana biti kao srce porodilje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          {
            "text": "Moav će istrebljen biti kao narod,",
            "poem": 1
          },
          {
            "text": "jer je sebe nad Gospodom uzdigao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          {
            "text": "Čekaju te strahota,",
            "poem": 1
          },
          {
            "text": "jama i zamka, stanovniče Moava!",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          {
            "text": "Ko utekne od strahote,",
            "poem": 1
          },
          {
            "text": "u jamu će pasti;",
            "poem": 2
          },
          {
            "text": "ko se iz jame izvuče,",
            "poem": 1
          },
          {
            "text": "u zamku će se uhvatiti!",
            "poem": 2
          },
          {
            "text": "Jer ja sam taj što na Moav donosim",
            "poem": 1
          },
          {
            "text": "godinu njihove kazne",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          {
            "text": "U senci su Esevona",
            "poem": 1
          },
          {
            "text": "zastali begunci onemoćali,",
            "poem": 2
          },
          {
            "text": "jer je požar krenuo od Esevona",
            "poem": 1
          },
          {
            "text": "i plamen iz samoga Sihona,",
            "poem": 2
          },
          {
            "text": "da proguta čelo Moavovo",
            "poem": 1
          },
          {
            "text": "i teme buntovnicima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          {
            "text": "Jao tebi, Moave!",
            "poem": 1
          },
          {
            "text": "Propašće Hamosov narod!",
            "poem": 2
          },
          {
            "text": "Sinove će tvoje odvesti u ropstvo",
            "poem": 1
          },
          {
            "text": "i tvoje ćerke u izgnanstvo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          {
            "text": "Ali vratiću izgnanike moavske",
            "poem": 1
          },
          {
            "text": "u poslednjim danima",
            "poem": 2
          },
          {
            "text": "– govori Gospod.“",
            "poem": 3
          },
          "Dovde je sud nad Moavom."
        ]
      }
    ],
