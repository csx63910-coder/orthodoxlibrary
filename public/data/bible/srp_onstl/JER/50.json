  "chapter": {
    "number": 50,
    "content": [
      {
        "type": "heading",
        "content": [
          "Poruka Vavilonu"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Reč koju je rukom proroka Jeremije Gospod objavio o Vavilonu i o zemlji haldejskoj:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Objavite među narodima i proglasite;",
            "poem": 1
          },
          {
            "text": "podignite zastavu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "proglasite i ne sakrivajte.",
            "poem": 2
          },
          {
            "text": "Recite: ’Osvojen je Vavilon,",
            "poem": 1
          },
          {
            "text": "osramoćen je Vil",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i Merodah",
            "poem": 2
          },
          {
            "noteId": 29
          },
          {
            "text": "je skršen.",
            "poem": 2
          },
          {
            "text": "Osramoćeni su njihovi idoli",
            "poem": 1
          },
          {
            "text": "i slomljeni njihovi odurni likovi.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jer protiv njega dolazi narod sa severa",
            "poem": 1
          },
          {
            "text": "koji će mu opustošiti zemlju.",
            "poem": 2
          },
          {
            "text": "Tamo neće biti potomaka ljudi, a ni stoke,",
            "poem": 1
          },
          {
            "text": "jer će pobeći i otići.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "U tim danima i u to vreme",
            "poem": 1
          },
          {
            "text": "– govori Gospod –",
            "poem": 2
          },
          {
            "text": "doći će zajedno Izrailjci i Judejci.",
            "poem": 1
          },
          {
            "text": "Ići će plačući i Gospoda, Boga svoga tražiće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Pitaće za put za Sion, lice svoje će k njemu okrenuti:",
            "poem": 1
          },
          {
            "text": "Prionimo uz Gospoda",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i večni savez koji se neće zaboraviti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Moj je narod sad postao stado izgubljeno,",
            "poem": 1
          },
          {
            "text": "na greh su ih zavodili njihovi pastiri.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Zavodili su ga po gorama,",
            "poem": 2
          },
          {
            "text": "išli od brda do brda.",
            "poem": 1
          },
          {
            "text": "Zaboravili su svoje počivalište.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Proždire ih svako ko ih nađe,",
            "poem": 1
          },
          {
            "text": "a njihovi dušmani govore: ’Mi za ovo nismo krivi!",
            "poem": 2
          },
          {
            "text": "Oni su zgrešili Gospodu, prebivalištu pravde;",
            "poem": 1
          },
          {
            "text": "Gospodu, nadi njihovih otaca.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Bežite iz Vavilona",
            "poem": 1
          },
          {
            "text": "i iz zemlje haldejske!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Izađite i budite kao jarac predvodnik.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Evo, ja podižem i dovodim na Vavilon",
            "poem": 1
          },
          {
            "text": "zbor naroda velikih iz severne zemlje.",
            "poem": 2
          },
          {
            "text": "Postrojiće se prema njemu",
            "poem": 1
          },
          {
            "text": "i odande ga zarobiti.",
            "poem": 2
          },
          {
            "text": "Strele su im kao u ratnika što decu odvodi",
            "poem": 1
          },
          {
            "text": "i koji se ne vraća bez plena.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Haldeja će plen postati,",
            "poem": 1
          },
          {
            "text": "a oni što je plene činiće to koliko im je po volji",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Jer vi ste se radovali, vi ste i likovali",
            "poem": 1
          },
          {
            "text": "dok ste plenili moje nasledstvo.",
            "poem": 2
          },
          {
            "text": "Ritali ste se ko junica po proplanku,",
            "poem": 1
          },
          {
            "text": "njištali ste ko obesni konji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Vaša je majka jako posramljena,",
            "poem": 1
          },
          {
            "text": "zacrvenela se ona što vas rodi.",
            "poem": 2
          },
          {
            "text": "Evo, poslednja među narodima",
            "poem": 1
          },
          {
            "text": "je kao divljina, pustoš i pustara.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Zbog gneva Gospodnjeg tamo se ne živi,",
            "poem": 1
          },
          {
            "text": "sva će biti opustošena.",
            "poem": 2
          },
          {
            "text": "I svako ko pored Vavilona prođe užasnut će biti",
            "poem": 1
          },
          {
            "text": "i zviždaće zbog svih rana njegovih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Postrojte se na Vavilon svud unaokolo!",
            "poem": 1
          },
          {
            "text": "Gađajte ga, četo s lukovima,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ne štedite strele jer je Gospodu zgrešio!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Pokličem sad protiv njega svud unaokolo!",
            "poem": 1
          },
          {
            "text": "Ruke diže, kule mu padaju,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "strovaljene zidine njegove",
            "poem": 2
          },
          {
            "text": "jer ovo je Gospodnja osveta.",
            "poem": 1
          },
          {
            "text": "Osvetite se:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kao što je on činio, tako njemu učinite.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Istrebite sejača iz Vavilona",
            "poem": 1
          },
          {
            "text": "i onoga što o žetvi zamahuje srpom.",
            "poem": 2
          },
          {
            "text": "Neka se od mača tlačiteljskog",
            "poem": 1
          },
          {
            "text": "svako u svoj narod vrati,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "neka svako svojoj zemlji beži.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Izrailj je ovca oterana",
            "poem": 1
          },
          {
            "text": "koju su lavovi poterali.",
            "poem": 2
          },
          {
            "text": "Prvi lav, car asirski,",
            "poem": 1
          },
          {
            "text": "ga je prožderao;",
            "poem": 2
          },
          {
            "text": "a ovaj zadnji, Navuhodonosor,",
            "poem": 1
          },
          {
            "text": "car Vavilona, mu je kosti oglodao.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Zato ovako kaže Gospod nad vojskama, Bog Izrailja:",
          {
            "text": "„Evo, kazniću cara Vavilona u njegovoj zemlji",
            "poem": 1
          },
          {
            "text": "kao što sam kaznio cara Asirije.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Vratiću Izrailj na njegovu pašu,",
            "poem": 1
          },
          {
            "text": "da pase po Karmilu, po Vasanu,",
            "poem": 2
          },
          {
            "text": "po Jefremovom gorju i po Galadu",
            "poem": 1
          },
          {
            "text": "dok mu se duša ne napase.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "U tim danima i u to vreme",
            "poem": 1
          },
          {
            "text": "– govori Gospod –",
            "poem": 2
          },
          {
            "text": "neće biti krivice na Izrailju",
            "poem": 1
          },
          {
            "text": "koja se traži,",
            "poem": 2
          },
          {
            "text": "i neće biti greha na Judi",
            "poem": 1
          },
          {
            "text": "koji se traži;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer ja opraštam onima koji su ostatak.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Na meratajimsku zemlju",
            "poem": 1
          },
          {
            "noteId": 30
          },
          {
            "text": "izađi",
            "poem": 1
          },
          {
            "text": "i na stanovnike Fekoda.",
            "poem": 2
          },
          {
            "text": "Pobij ih, izruči za njima sve kletom uništenju",
            "poem": 1
          },
          {
            "text": "– govori Gospod –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i učini sve kako sam ti zapovedio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Bojni poklič i razaranje veliko",
            "poem": 1
          },
          {
            "text": "su po zemlji!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Kako je presečen i slomljen",
            "poem": 1
          },
          {
            "text": "malj čitave zemlje!",
            "poem": 2
          },
          {
            "text": "Kako je Vavilon postao ruglo",
            "poem": 1
          },
          {
            "text": "među narodima!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Zamku sam ti postavio",
            "poem": 1
          },
          {
            "text": "i ti si se uhvatio, Vavilone.",
            "poem": 2
          },
          {
            "text": "Ti i ne znaš da si razotkriven",
            "poem": 1
          },
          {
            "text": "i uhvaćen jer si protiv Gospoda zaratio.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Gospod je otvorio svoju oružarnicu",
            "poem": 1
          },
          {
            "text": "i izneo oružje svoje jarosti,",
            "poem": 2
          },
          {
            "text": "jer to u haldejskoj zemlji",
            "poem": 1
          },
          {
            "text": "je poduhvat Gospoda, Boga nad vojskama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Na nju dođite sa svih krajeva,",
            "poem": 1
          },
          {
            "text": "otvorite njene žitnice",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i zgrnite je na gomile!",
            "poem": 2
          },
          {
            "text": "Izručite je kletom uništenju",
            "poem": 1
          },
          {
            "text": "da joj niko ne preživi!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Pokoljite sve njene nasilnike kao bikove,",
            "poem": 1
          },
          {
            "text": "na klanje ih povedite!",
            "poem": 2
          },
          {
            "text": "Jao njima, jer stiže njihov dan,",
            "poem": 1
          },
          {
            "text": "vreme njihove kazne!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Glas begunaca i izbeglih iz vavilonske zemlje",
            "poem": 1
          },
          {
            "text": "javlja po Sionu",
            "poem": 2
          },
          {
            "text": "o osveti Gospoda, našeg Boga,",
            "poem": 1
          },
          {
            "text": "o osveti za njegov Dom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "„Okupi strelce na Vavilon,",
            "poem": 1
          },
          {
            "text": "utabori četu s lukovima",
            "poem": 2
          },
          {
            "text": "protiv njih svuda unaokolo.",
            "poem": 1
          },
          {
            "text": "Neka niko ne pobegne.",
            "poem": 2
          },
          {
            "text": "Uzvrati mu po delima njegovim,",
            "poem": 1
          },
          {
            "text": "prema svemu što je učinio ti mu učini,",
            "poem": 2
          },
          {
            "text": "jer se poneo drsko protiv Gospoda,",
            "poem": 1
          },
          {
            "text": "protiv Sveca Izrailjeva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Zato će da popadaju njegovi mladići po njegovim trgovima;",
            "poem": 1
          },
          {
            "text": "nastradaće toga dana svi ljudi ratnici",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Evo, dolazim na tebe, o, drzniče",
            "poem": 1
          },
          {
            "text": "– govori Gospod Bog nad vojskama –",
            "poem": 2
          },
          {
            "text": "jer je došao tvoj dan",
            "poem": 1
          },
          {
            "text": "i vreme da te kaznim!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Posrnuće drznik, pašće,",
            "poem": 1
          },
          {
            "text": "a niko ga podignuti neće.",
            "poem": 2
          },
          {
            "text": "Zapaliću vatru u njegovim gradovima",
            "poem": 1
          },
          {
            "text": "da proguta sve unaokolo.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "Ovako kaže Gospod nad vojskama:",
          {
            "text": "„Potlačeni su zajedno narod Izrailja",
            "poem": 1
          },
          {
            "text": "i narod Jude.",
            "poem": 2
          },
          {
            "text": "Svi njihovi tlačitelji su ih zgrabili,",
            "poem": 1
          },
          {
            "text": "odbijaju da ih oslobode.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Ali je jak njihov Otkupitelj!",
            "poem": 1
          },
          {
            "text": "’Gospod nad vojskama’ mu je ime.",
            "poem": 2
          },
          {
            "text": "On će ih braniti u njihovoj parnici",
            "poem": 1
          },
          {
            "text": "da zemlji da spokoj,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a nespokoj svim stanovnicima Vavilona.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Mač na Haldejce",
            "poem": 1
          },
          {
            "text": "– govori Gospod –",
            "poem": 2
          },
          {
            "text": "i na sve stanovnike Vavilona,",
            "poem": 1
          },
          {
            "text": "na njegove glavare i mudrace njegove!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Mač na lažne proroke –",
            "poem": 1
          },
          {
            "text": "neka budu budale.",
            "poem": 2
          },
          {
            "text": "Mačem na njihove ratnike –",
            "poem": 1
          },
          {
            "text": "neka se užasnu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Mač na njihove konje, na njihova kola",
            "poem": 1
          },
          {
            "text": "i na sve koji su među njima, a mešanog su porekla.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Postaće kao žene!",
            "poem": 2
          },
          {
            "text": "Mač na njihove riznice –",
            "poem": 1
          },
          {
            "text": "neka budu oplenjene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "Suša vodama njegovim!",
            "poem": 1
          },
          {
            "text": "Neka presuše,",
            "poem": 2
          },
          {
            "text": "jer je to zemlja idola",
            "poem": 1
          },
          {
            "text": "od čijeg užasa ludo rade.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          {
            "text": "Zato će u njemu boraviti zveri pustinjske sa hijenama,",
            "poem": 1
          },
          {
            "text": "i nojevi će se nastaniti.",
            "poem": 2
          },
          {
            "text": "On doveka neće biti naseljen,",
            "poem": 1
          },
          {
            "text": "od kolena do kolena biće nenastanjen.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          {
            "text": "Kao kad je Bog opustošio Sodomu i Gomoru",
            "poem": 1
          },
          {
            "text": "i okolne gradove",
            "poem": 2
          },
          {
            "text": "– govori Gospod –",
            "poem": 3
          },
          {
            "text": "tamo niko prebivati neće,",
            "poem": 1
          },
          {
            "text": "neće biti potomaka ljudi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          {
            "text": "Gle, narod dolazi sa severa!",
            "poem": 1
          },
          {
            "text": "Veliki narod i carevi mnogi",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "biće podignuti iz najdaljih zemljinih krajeva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          {
            "text": "Oni drže luk i koplje.",
            "poem": 1
          },
          {
            "text": "Okrutni su i nemilosrdni,",
            "poem": 2
          },
          {
            "text": "a glas im huči kao more.",
            "poem": 1
          },
          {
            "text": "Jašu konje spremni kao ratnik",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "protiv tebe, ćerko vavilonska.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          {
            "text": "Čuo je o njima glas car Vavilona",
            "poem": 1
          },
          {
            "text": "i ruke su mu klonule,",
            "poem": 2
          },
          {
            "text": "obuzeli su ga zebnja",
            "poem": 1
          },
          {
            "text": "i bol kao porodilju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          {
            "text": "Gle, kao lav što skače iz jordanskog čestara",
            "poem": 1
          },
          {
            "text": "na pašnjak plodan,",
            "poem": 2
          },
          {
            "text": "ja ću ih poterati odatle u trenu.",
            "poem": 1
          },
          {
            "text": "I ko god da je izabrani, tu ću ga staviti.",
            "poem": 2
          },
          {
            "text": "Jer, ko je kao ja i ko će protiv mene?",
            "poem": 1
          },
          {
            "text": "Ko je taj pastir koji će izaći pred mene?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          {
            "text": "Zato čujte namere Gospodnje što ih je za Vavilon namerio,",
            "poem": 1
          },
          {
            "text": "i njegove naume što je za zemlju haldejsku naumio:",
            "poem": 2
          },
          {
            "text": "stvarno će odvući najmlađe iz stada,",
            "poem": 1
          },
          {
            "text": "opustošiće stvarno zbog njih pašnjak njihov.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          {
            "text": "Od povika „Osvojen je Vavilon“ potrešće se zemlja",
            "poem": 1
          },
          {
            "text": "i vapaj će se čuti među narodima.",
            "poem": 2
          }
        ]
      }
    ],
