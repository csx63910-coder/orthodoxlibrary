  "chapter": {
    "number": 10,
    "content": [
      {
        "type": "heading",
        "content": [
          "Bog i idoli"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Dome Izrailjev, čujte reč koju vam govori Gospod!"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "„Ovako kaže Gospod:",
          {
            "text": "’Ne učite se putu naroda",
            "poem": 1
          },
          {
            "text": "i ne plašite se nebeskih znakova",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kojih se plaše narodi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jer su običaji tih naroda prazni.",
            "poem": 1
          },
          {
            "text": "Eto, to je tek drvo iz šume koje je neko posekao,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "delo umetnikove alatke.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ukrasio ga je srebrom i zlatom.",
            "poem": 1
          },
          {
            "text": "Klinovima i čekićima ga učvršćuju",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da se ne klati!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Liče na strašilo u leji za krastavce.",
            "poem": 1
          },
          {
            "text": "Ne govore,",
            "poem": 2
          },
          {
            "text": "i moraju da se nose, jer ne hodaju.",
            "poem": 1
          },
          {
            "text": "Ne plaši ih se!",
            "poem": 2
          },
          {
            "text": "Oni ne mogu da naude,",
            "poem": 1
          },
          {
            "text": "a ne mogu ni šta dobro da urade.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Niko nije kao ti, o, Gospode!",
            "poem": 1
          },
          {
            "text": "Veliki si,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i veliko je tvoje silno ime.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ko se ne bi bojao tebe,",
            "poem": 1
          },
          {
            "text": "Care naroda?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Jer tebi to dolikuje.",
            "poem": 2
          },
          {
            "text": "Među svim mudracima naroda",
            "poem": 1
          },
          {
            "text": "i po svim njihovim carstvima",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "nema nikog kao što si ti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Svi su glupi i bezumni,",
            "poem": 1
          },
          {
            "text": "jer je ništa pouka od drveta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Iz Tarsisa donose kovano srebro",
            "poem": 1
          },
          {
            "text": "i zlato iz Ufaza,",
            "poem": 2
          },
          {
            "text": "delo umetnika i rukotvorinu zlatara.",
            "poem": 1
          },
          {
            "text": "Odeća im je ljubičasta i skerletna",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i sve je to delo veštih ljudi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "A Gospod je istinski Bog!",
            "poem": 1
          },
          {
            "text": "On je Bog živi i večni car.",
            "poem": 2
          },
          {
            "text": "Od njegovog gneva trese se zemlja,",
            "poem": 1
          },
          {
            "text": "i narodi ne mogu da istrpe jarost njegovu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "„Ovako im recite: ’Bogovi koji nisu načinili nebesa i zemlju će nestati i sa zemlje i ispod nebesa.’“"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "On je silom svojom načinio zemlju.",
            "poem": 1
          },
          {
            "text": "Mudrošću svojom on je osnovao vaseljenu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i svojom je razboritošću razapeo nebesa.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Glas on kada pusti, vode huče na nebesima.",
            "poem": 1
          },
          {
            "text": "On podiže oblake s kraja zemlje,",
            "poem": 2
          },
          {
            "text": "kiši munje daje",
            "poem": 1
          },
          {
            "text": "i izvodi vetar iz svojih riznica.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Baš je od svog znanja glup svaki čovek.",
            "poem": 1
          },
          {
            "text": "Zbog idola se svaki zlatar stidi,",
            "poem": 2
          },
          {
            "text": "jer su obmana njegovi liveni idoli.",
            "poem": 1
          },
          {
            "text": "Nema daha u njima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Oni su isprazni, tvorevine rugla.",
            "poem": 1
          },
          {
            "text": "Propašće kad dođe vreme za njihovu kaznu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ne slede Jakovu takvi kao ovi.",
            "poem": 1
          },
          {
            "text": "Jer on je taj koji je sve načinio.",
            "poem": 2
          },
          {
            "text": "Pleme Izrailj njegovo je nasledstvo,",
            "poem": 1
          },
          {
            "text": "a on se zove Gospod nad vojskama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Razaranje dolazi"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Pokupi sa zemlje svoj zavežljaj,",
            "poem": 1
          },
          {
            "text": "ti koja živiš pod opsadom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Jer ovako kaže Gospod:",
            "poem": 1
          },
          {
            "text": "„Evo, sad ću kao praćkom",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da iz zemlje izbacim stanovnike.",
            "poem": 2
          },
          {
            "text": "Stisnuću ih, da mogu da shvate.“",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Jao meni zbog mog loma!",
            "poem": 1
          },
          {
            "text": "Teška je moja rana.",
            "poem": 2
          },
          {
            "text": "A ja sam rekao:",
            "poem": 1
          },
          {
            "text": "„Ovo je samo bolest, izdržaću je ja.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Moj je šator poharan",
            "poem": 1
          },
          {
            "text": "i šatorska užad pokidana.",
            "poem": 2
          },
          {
            "text": "Deca su moja od mene otišla i nema ih.",
            "poem": 1
          },
          {
            "text": "Nema nikoga da opet postavi moj šator,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "nikoga da podigne zavese na njemu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Pastiri su se glupo poneli",
            "poem": 1
          },
          {
            "text": "i nisu tražili Gospoda.",
            "poem": 2
          },
          {
            "text": "Zato i nisu napredovali",
            "poem": 1
          },
          {
            "text": "i raštrkana su sva njihova stada.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Evo vesti! Dolazi glas",
            "poem": 1
          },
          {
            "text": "i lomljava velika iz severne zemlje:",
            "poem": 2
          },
          {
            "text": "da će gradovi Jude postati pustoš",
            "poem": 1
          },
          {
            "text": "i jazbina šakala.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Jeremijina molitva"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Znam ja, o, Gospode, da čovek nije vladar svog puta,",
            "poem": 1
          },
          {
            "text": "i da onaj koji hoda ne upravlja svojim koracima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Pokaraj me, Gospode, alʼ samo po pravdi;",
            "poem": 1
          },
          {
            "text": "ne u svom gnevu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da me ne nestane.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Izlij svoj gnev na narode",
            "poem": 1
          },
          {
            "text": "što te ne poznaju,",
            "poem": 2
          },
          {
            "text": "na rodove koji tvoje ime ne prizivaju.",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Jer su oni gutali Jakova i progutali,",
            "poem": 1
          },
          {
            "text": "i proždrli su ga,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "naselje mu u pustoš pretvorili.",
            "poem": 2
          }
        ]
      }
    ],
