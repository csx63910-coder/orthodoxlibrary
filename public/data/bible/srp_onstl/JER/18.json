  "chapter": {
    "number": 18,
    "content": [
      {
        "type": "heading",
        "content": [
          "Kod grnčara"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Reč od Gospoda je došla Jeremiji:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "„Ustani i siđi u grnčarevu kuću. Tamo ću ti reći svoje reči.“"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Otišao sam u grnčarevu kuću, a tamo, on radi nešto na grnčarskom točku."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "A posuda od gline, koju je grnčar vajao rukama se pokvarila. I on ju je vratio, pa je oblikovao drugu posudu, baš kakvu je želeo da napravi."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Došla mi je reč Gospodnja i rekla:"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "„Dome Izrailjev! Zar ja ne mogu da uradim sa vama kao ovaj grnčar? – govori Gospod. Evo, poput gline u rukama grnčara, i vi ste u mojim rukama, dome Izrailjev!"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "U času kad objavim narodu i carstvu da ću da ih iščupam, srušim i razorim;"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "a taj se narod odvrati od svog zla za koje sam govorio, ja ću se sažaliti zbog propasti koju sam naumio da im nanesem."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Ili u času kad objavim narodu i carstvu da ću da ih gradim i sadim;"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "a oni na moje oči čine zlo i ne slušaju moj glas, ja ću da odustanem od dobra koje sam naumio da im učinim."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Zato sad reci svima u Judi i svim stanovnicima Jerusalima: ’Ovako kaže Gospod: evo, vajam propast na vas, protiv vas zamisao smišljam. Nek se svako vrati sa svog puta zloga, molim vas. Neka popravi i svoje puteve i dela svoja.’"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "A oni će reći: ’Ništa od toga! Živećemo po mislima svojim i svako će da postupa samovoljno po zlobi svog srca!’“"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Zato ovako kaže Gospod:",
          {
            "text": "„Raspitaj se među narodima",
            "poem": 1
          },
          {
            "text": "je li iko ikad čuo za ovako nešto,",
            "poem": 2
          },
          {
            "text": "nečuveno strašno",
            "poem": 1
          },
          {
            "text": "što je učinila devica izrailjska?!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Da li kopni sneg",
            "poem": 1
          },
          {
            "text": "sa kamenitih livanskih strmina,",
            "poem": 2
          },
          {
            "text": "presuše li hladne vode",
            "poem": 1
          },
          {
            "text": "tuđinskih brzaka?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "A moj je narod mene zaboravio!",
            "poem": 1
          },
          {
            "text": "Ništavilu kade,",
            "poem": 2
          },
          {
            "text": "koje ih je i saplelo na njihovim putevima,",
            "poem": 1
          },
          {
            "text": "na starim tragovima,",
            "poem": 2
          },
          {
            "text": "da slede staze",
            "poem": 1
          },
          {
            "text": "puta nenasutog;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "da zemlju svoju opustoše,",
            "poem": 1
          },
          {
            "text": "pa da doveka zviždi svako ko pored nje prođe,",
            "poem": 2
          },
          {
            "text": "pa da se užasne",
            "poem": 1
          },
          {
            "text": "i da klima glavom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Kao istočni vetar",
            "poem": 1
          },
          {
            "text": "ću ih rasejati pred neprijateljem.",
            "poem": 2
          },
          {
            "text": "Gledaću im leđa, a ne lice,",
            "poem": 1
          },
          {
            "text": "u dan njihove propasti.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "A oni su rekli: „Hajde da zaveru skujemo protiv Jeremije! Jer neće nestati pouka sveštenika, savet mudrog i poruka proroka. Hajde da ga oklevećemo i da ne marimo na njegove reči!“"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ali ti za mene mari, Gospode,",
            "poem": 1
          },
          {
            "text": "i poslušaj viku mojih krvnika!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Dobro li se zlom odužuje?",
            "poem": 1
          },
          {
            "text": "A meni su jamu iskopali!",
            "poem": 2
          },
          {
            "text": "Ti se seti kada sam pred tobom stajao",
            "poem": 1
          },
          {
            "text": "i dobro za njih tražio:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da okreneš svoj gnev od njih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Neka im deca gladuju!",
            "poem": 1
          },
          {
            "text": "U bitkama na mač nek nalete.",
            "poem": 2
          },
          {
            "text": "Nek im žene ojalove, udovice budu.",
            "poem": 1
          },
          {
            "text": "Muževe njihove neka smrt pokosi,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a mladiće nek im mač satre u boju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Nek se čuje naricanje iz njihovih kuća,",
            "poem": 1
          },
          {
            "text": "jer ćeš na njih iznenada dovesti pljačkaše.",
            "poem": 2
          },
          {
            "text": "Jer su jamu iskopali da me zarobe,",
            "poem": 1
          },
          {
            "text": "i sakrili zamke ispred mojih nogu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Ali ti, Gospode, znaš",
            "poem": 1
          },
          {
            "text": "šta su protiv mene naumili – da me ubiju.",
            "poem": 2
          },
          {
            "text": "Ne pokrivaj im krivicu",
            "poem": 1
          },
          {
            "text": "i njihov greh ne briši pred sobom,",
            "poem": 2
          },
          {
            "text": "nek se zbog njih sruše tu pred tobom;",
            "poem": 1
          },
          {
            "text": "pa se s njima obračunaj u dan gneva svoga.",
            "poem": 2
          }
        ]
      }
    ],
