  },
  "chapter": {
    "number": 17,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Judin je greh zapisan gvozdenim perom,",
            "poem": 1
          },
          {
            "text": "urezan dijamantskim šiljkom",
            "poem": 2
          },
          {
            "text": "na ploču njihovog srca",
            "poem": 1
          },
          {
            "text": "i na rogove vaših žrtvenika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Deca njihova razmišljaju",
            "poem": 1
          },
          {
            "text": "o njihovim žrtvenicima i Aštartinim stupovima,",
            "poem": 2
          },
          {
            "text": "pod zelenim drvećem",
            "poem": 1
          },
          {
            "text": "na visokim brdima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "A ti što se penješ na planinu u polju:",
            "poem": 1
          },
          {
            "text": "tvoje dobro i sva imanja tvoja",
            "poem": 2
          },
          {
            "text": "dajem kao plen,",
            "poem": 1
          },
          {
            "text": "i tvoje uzvišice za greh",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "po svim tvojim granicama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "I ti sam ćeš da izgubiš nasledstvo",
            "poem": 1
          },
          {
            "text": "koje sam ti dao.",
            "poem": 2
          },
          {
            "text": "Učiniću da robuješ svojim neprijateljima",
            "poem": 1
          },
          {
            "text": "u zemlji koju ne znaš,",
            "poem": 2
          },
          {
            "text": "jer si zapalio vatru moga gneva",
            "poem": 1
          },
          {
            "text": "i doveka ona bukti.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Ovako kaže Gospod:",
          {
            "text": "„Proklet je čovek u čoveka što se uzda,",
            "poem": 1
          },
          {
            "text": "snagu svoju što u telu traži,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a od Gospoda okreće srce svoje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Biće kao grm u pustinji",
            "poem": 1
          },
          {
            "text": "što i ne zna kad mu dobro dođe.",
            "poem": 2
          },
          {
            "text": "Tavoriće u bezvodnoj pustari,",
            "poem": 1
          },
          {
            "text": "u slatini gde niko ne živi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Blagosloven je čovek što se uzda u Gospoda",
            "poem": 1
          },
          {
            "text": "i kome je Gospod uzdanica!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "On će biti kao drvo posađeno pored voda,",
            "poem": 1
          },
          {
            "text": "što korenje pruža ka živome toku.",
            "poem": 2
          },
          {
            "text": "Pripeka kad dođe, ono se ne boji;",
            "poem": 1
          },
          {
            "text": "lišće mu zeleno kroz godinu celu.",
            "poem": 2
          },
          {
            "text": "Od suše ne strepi,",
            "poem": 1
          },
          {
            "text": "ploda uvek ima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Srce je varljivo više od sveg drugog.",
            "poem": 1
          },
          {
            "text": "Nepopravljivo je,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i ko će ga znati!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ja, Gospod, ispitujem srce,",
            "poem": 1
          },
          {
            "text": "nutrinu proveravam;",
            "poem": 2
          },
          {
            "text": "pa svakome dajem po njegovom putu,",
            "poem": 1
          },
          {
            "text": "a i prema plodu od njegovih dela.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Kao jarebica što se leže, ali ne izleže,",
            "poem": 1
          },
          {
            "text": "onaj je što blago nepošteno zgrće:",
            "poem": 2
          },
          {
            "text": "na pola mu života blaga više nema,",
            "poem": 1
          },
          {
            "text": "a on na svome kraju ispada budala.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Presto slave od davnina uzvišen,",
            "poem": 1
          },
          {
            "text": "mesto je našeg Svetilišta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Nado Izrailjeva, Gospode,",
            "poem": 1
          },
          {
            "text": "postideće se svi koji te ostave.",
            "poem": 2
          },
          {
            "text": "Oni koji su se okrenuli od mene u prašinu biće upisani,",
            "poem": 1
          },
          {
            "text": "jer su ostavili Gospoda,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "izvor svežih voda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Izleči me, Gospode, da budem izlečen!",
            "poem": 1
          },
          {
            "text": "Spasi me da i spasen budem,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer si ti moja slava!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Gle njih, govore mi:",
            "poem": 1
          },
          {
            "text": "„Gde je reč Gospodnja?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Hajde, nek se zbude!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ja se nisam ustezao da ti pastir budem, da za tobom idem.",
            "poem": 1
          },
          {
            "text": "Priželjkivao ti nisam taj dan nesnosni.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "I ti znaš šta su moje usne rekle u prisustvu tvome.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ne budi mi ti na užas,",
            "poem": 1
          },
          {
            "text": "jer si moje utočište u danu propasti!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Nek se stide moji gonitelji,",
            "poem": 1
          },
          {
            "text": "a ne ja da se stidim.",
            "poem": 2
          },
          {
            "text": "Neka oni budu zaplašeni,",
            "poem": 1
          },
          {
            "text": "a ne ja da zaplašen budem.",
            "poem": 2
          },
          {
            "text": "Sruči na njih dan propasti",
            "poem": 1
          },
          {
            "text": "i slomi ih dvaput jačim slomom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Subota – posvećeni dan"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Gospod mi je ovako rekao: „Idi i stani na Vrata sinova naroda, kroz koja ulaze Judini carevi i kroz koja izlaze, i na sva vrata Jerusalima."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Reci im: ’Čujte reč Gospodnju, o, carevi Judini i sva Judo i svi stanovnici Jerusalima koji ulazite kroz ova vrata!"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Ovako kaže Gospod: čuvajte živote svoje pa ne nosite robu u subotu i ne unosite je na jerusalimska vrata."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Ni iz svojih kuća ne iznosite robu u subotu i ne radite nikakvog posla. Posvetite subotu kao što sam zapovedio vašim precima."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Ali oni nisu poslušali i nisu prignuli svoje uho. Tvrdoglavi su postali, nisu slušali i nisu prihvatili karanje."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Ali, budete li me pažljivo slušali – govori Gospod – i subotom ne budete nosili robu kroz gradska vrata, već posvetite subotu i ne radite nikakav posao:"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "tada će na gradska vrata ulaziti carevi i knezovi, koji sede na prestolu Davidovom, na bojnim kolima i na konjima – oni, njihovi glavari, svi Judejci i svi stanovnici Jerusalima. A grad će ovaj ostati doveka."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "I doći će iz Judinih gradova, svi što su oko Jerusalima, iz Venijaminove zemlje, iz ravnice, sa brda i iz Negeva oni što donose svespalnice, žrtve, žitne žrtve i tamjan, i oni što donose zahvalnice u Dom Gospodnji."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Ali ako me ne poslušate – da posvetite subotu, da ne nosite robu i prolazite kroz jerusalimska vrata u subotu – zapaliću vatru na njegovim vratima da proguta dvorove Jerusalima, i neće se ugasiti.’“"
        ]
      }
    ],
