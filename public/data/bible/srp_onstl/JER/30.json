  "chapter": {
    "number": 30,
    "content": [
      {
        "type": "heading",
        "content": [
          "Obnova Izrailja"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Reč koja je Jeremiji došla od Gospoda:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "„Ovako kaže Gospod, Bog Izrailja: ’Zapiši sebi u knjigu sve reči koje ti objavljujem."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Jer, evo, dolaze dani – govori Gospod – kada ću da vratim iz izgnanstva moj narod, Izrailj i Judu. Gospod kaže: dovešću ih u zemlju koju sam dao njihovim precima i oni će je zaposesti.’“"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "A ovo je poruka koju je Gospod objavio Izrailju i Judi:"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "„Ovako kaže Gospod:",
          {
            "text": "’Čuli ste strašne, grozne vapaje,",
            "poem": 1
          },
          {
            "text": "a mira nema!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Raspitajte se i razmotrite:",
            "poem": 1
          },
          {
            "text": "Da li muškarac rađa?",
            "poem": 2
          },
          {
            "text": "Pa kako onda vidim da se svako muško",
            "poem": 1
          },
          {
            "text": "drži za bedra, kao porodilja,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da su svima lica izobličena od bledila!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Jao! Velik će biti taj dan",
            "poem": 1
          },
          {
            "text": "i nema takvog.",
            "poem": 2
          },
          {
            "text": "Biće to vreme nevolje za Jakova,",
            "poem": 1
          },
          {
            "text": "ali i od nje će biti spasen.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "I toga dana – govori Gospod nad vojskama –",
            "poem": 1
          },
          {
            "text": "slomiću mu jaram s vrata,",
            "poem": 2
          },
          {
            "text": "pokidaću mu okove",
            "poem": 1
          },
          {
            "text": "i neće više služiti tuđincima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Služiće Gospodu, svome Bogu,",
            "poem": 1
          },
          {
            "text": "i svome caru Davidu",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "koga ću im podignuti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "A ti se ne plaši, slugo moj Jakove",
            "poem": 1
          },
          {
            "text": "– govori Gospod –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ne strahuj, Izrailju, jer te ja spasavam izdaleka;",
            "poem": 2
          },
          {
            "text": "iz zemlje njihovog izgnanstva vraćam tvoje potomke.",
            "poem": 1
          },
          {
            "text": "I Jakov će se vratiti, biće spokojan",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i siguran jer ga niko neće plašiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Jer sam ja s tobom",
            "poem": 1
          },
          {
            "text": "– govori Gospod – da te spasem.",
            "poem": 2
          },
          {
            "text": "Ja ću da istrebim sve narode",
            "poem": 1
          },
          {
            "text": "gde sam te rasejao,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ali tebe neću da istrebim.",
            "poem": 2
          },
          {
            "text": "Tebe ću pravedno da pokaram",
            "poem": 1
          },
          {
            "text": "i neću te ostaviti nekažnjenog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Jer ovako kaže Gospod:",
          {
            "text": "’Prelom je tvoj neizlečiv",
            "poem": 1
          },
          {
            "text": "i teška je tvoja rana!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Niko te ne brani",
            "poem": 1
          },
          {
            "text": "i za tvoju ranu nema leka",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "što ti zdravlje nosi!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Svi ljubavnici tvoji su te zaboravili",
            "poem": 1
          },
          {
            "text": "i nije ih briga;",
            "poem": 2
          },
          {
            "text": "jer sam te oborio naletom neprijatelja",
            "poem": 1
          },
          {
            "text": "i kaznom okrutnoga",
            "poem": 2
          },
          {
            "text": "zbog tvojih velikih krivica",
            "poem": 1
          },
          {
            "text": "i mnogih greha tvojih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Zašto plačeš zbog svog loma?",
            "poem": 1
          },
          {
            "text": "Bol je tvoj neizlečiv",
            "poem": 2
          },
          {
            "text": "zbog tvojih velikih krivica i mnogih tvojih greha.",
            "poem": 1
          },
          {
            "text": "A sve to ja sam ti učinio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "I zato će biti progutani svi ti što tebe gutaju.",
            "poem": 1
          },
          {
            "text": "Svi tvoji neprijatelji, baš svi će otići u ropstvo.",
            "poem": 2
          },
          {
            "text": "Oni koji te pljačkaju biće opljačkani,",
            "poem": 1
          },
          {
            "text": "a one koji te plene u plen ću da pretvorim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Jer ti ja zdravlje donosim",
            "poem": 1
          },
          {
            "text": "i lečim te od svih rana",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          },
          {
            "text": "Jer, zvali su te ’Oterana’,",
            "poem": 1
          },
          {
            "text": "’Sion za koji nikog više nije briga.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Ovako kaže Gospod:",
          {
            "text": "’Evo, vratiću izgnane Jakovljevih šatora",
            "poem": 1
          },
          {
            "text": "i smilovaću se na njihova prebivališta!",
            "poem": 2
          },
          {
            "text": "Obnoviću grad na njegovim ruševinama",
            "poem": 1
          },
          {
            "text": "i dvor će da počiva gde mu je i mesto.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Iz njih će se čuti zahvaljivanje",
            "poem": 1
          },
          {
            "text": "i povik radosnih.",
            "poem": 2
          },
          {
            "text": "Umnožiću ih",
            "poem": 1
          },
          {
            "text": "i neće biti neznatni;",
            "poem": 2
          },
          {
            "text": "učiniću ih časnim",
            "poem": 1
          },
          {
            "text": "i poniženi neće biti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Njihove će dece biti kao nekad davno,",
            "poem": 1
          },
          {
            "text": "a njihova će zajednica preda mnom biti osnovana.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "I ja ću da kaznim sve njihove tlačitelje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Od njega će poteći vladar njihov,",
            "poem": 1
          },
          {
            "text": "njihov će vođa od svojih izaći.",
            "poem": 2
          },
          {
            "text": "Ja ću ga privući i on će mi pristupiti.",
            "poem": 1
          },
          {
            "text": "Jer, ko je taj što bi srcem",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i pomislio da mi drugačije pristupi",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "I vi ćete biti meni narod",
            "poem": 1
          },
          {
            "text": "a ja vama biću Bog.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Evo vihora gneva Gospodnjeg!",
            "poem": 1
          },
          {
            "text": "Kovitla vihor nad glavom zlikovaca,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "baš kovitla.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Gospodnji usplamteli gnev neće uminuti",
            "poem": 1
          },
          {
            "text": "dok ne ispuni",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i dok ne uradi po naumima svog srca.",
            "poem": 2
          },
          {
            "text": "A to ćete shvatiti",
            "poem": 1
          },
          {
            "text": "u poslednjim danima.",
            "poem": 2
          }
        ]
      }
    ],
