  "chapter": {
    "number": 12,
    "content": [
      {
        "type": "heading",
        "content": [
          "Jeremijina tužbalica"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Pravedan si, Gospode,",
            "poem": 1
          },
          {
            "text": "kad god ti se tužim,",
            "poem": 2
          },
          {
            "text": "ali ću ipak da ti govorim o pravdi:",
            "poem": 1
          },
          {
            "text": "Zašto su napredni putevi pokvarenjaka?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Zašto likuju svi podli zlotvori?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ti si ih posadio i već se ukoreniše,",
            "poem": 1
          },
          {
            "text": "napreduju i već donose plod.",
            "poem": 2
          },
          {
            "text": "Blizu si njihovih usta,",
            "poem": 1
          },
          {
            "text": "ali daleko od nutrine njihove.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "A ti me, Gospode, poznaješ,",
            "poem": 1
          },
          {
            "text": "vidiš me i ispituješ srce moje spram tebe.",
            "poem": 2
          },
          {
            "text": "Poteraj ih ko ovce na klanje,",
            "poem": 1
          },
          {
            "text": "odvoji ih za dan klanja!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Dokle će zemlja da tuguje,",
            "poem": 1
          },
          {
            "text": "da sahne rastinje po svim poljima",
            "poem": 2
          },
          {
            "text": "od zla onih što tu prebivaju?",
            "poem": 1
          },
          {
            "text": "Propale su i životinje i ptice",
            "poem": 2
          },
          {
            "text": "jer je narod rekao:",
            "poem": 1
          },
          {
            "text": "„Neće on da vidi naše skončanje!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Božiji odgovor"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "„Ako si se umorio trčeći s pešacima,",
            "poem": 1
          },
          {
            "text": "kako li ćeš se tek ogledati s konjima?",
            "poem": 2
          },
          {
            "text": "Kada u spokojnoj zemlji padaš,",
            "poem": 1
          },
          {
            "text": "šta li ćeš da radiš na jordanskom čestaru?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Jer i braća tvoja",
            "poem": 1
          },
          {
            "text": "i dom tvoga oca su te izneverili",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i na sav glas su vikali za tobom.",
            "poem": 2
          },
          {
            "text": "Ne veruj im",
            "poem": 1
          },
          {
            "text": "čak i kada ti ljubazno govore.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Dom sam svoj napustio",
            "poem": 1
          },
          {
            "text": "i svoje nasledstvo ostavio.",
            "poem": 2
          },
          {
            "text": "Voljenu sam svoju predao",
            "poem": 1
          },
          {
            "text": "u ruke njenih neprijatelja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "A sada je moje nasledstvo",
            "poem": 1
          },
          {
            "text": "kao lav u šumi",
            "poem": 2
          },
          {
            "text": "što na mene rikom riče.",
            "poem": 1
          },
          {
            "text": "I zato ga mrzim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Je lʼ nasledstvo moje",
            "poem": 1
          },
          {
            "text": "pirgava ptica grabljivica?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Lešinari, sjatite se na nju svud unaokolo!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Idite, sakupite sve životinje na polje,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "dovedite ih na hranu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Mnogi su pastiri izlomili moj vinograd",
            "poem": 1
          },
          {
            "text": "i izgazili moj deo.",
            "poem": 2
          },
          {
            "text": "Pretvorili su moj mili deo",
            "poem": 1
          },
          {
            "text": "u golu pustinju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Da, pretvorili su je u pustinju",
            "poem": 1
          },
          {
            "text": "i sada preda mnom opustošena tuguje.",
            "poem": 2
          },
          {
            "text": "U pustaru je pretvorena zemlja",
            "poem": 1
          },
          {
            "text": "i to nikoga ne potresa.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Preko pustinjskih ogolelih visova",
            "poem": 1
          },
          {
            "text": "došli su zatirači,",
            "poem": 2
          },
          {
            "text": "jer Gospodnji mač satire",
            "poem": 1
          },
          {
            "text": "s kraja na kraj zemlje",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i nema mira ni za koga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Sejaće pšenicu, a trnje će žeti.",
            "poem": 1
          },
          {
            "text": "Iznuriše se, a nikakve koristi.",
            "poem": 2
          },
          {
            "text": "Stidite se svojih uroda",
            "poem": 1
          },
          {
            "text": "zbog Gospodnjeg plamtećeg gneva!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Ovako kaže Gospod svim mojim zlim susedima koji napadaju zemlju koju sam dao mom narodu Izrailju u nasledstvo: evo, počupaću ih iz njihove zemlje, a iz njihove ću sredine da iščupam Judin dom."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "A kada ih iščupam, vratiću se da im se smilujem i dovedem svakog na njegovo nasledstvo i svakog na njegovu zemlju."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "I ako se istinski nauče putevima moga naroda, da se zaklinju mojim imenom – ’Tako nam živog Gospoda’ – onako kako su oni moj narod naučili da se kunu Valom, naseliće se usred mog naroda."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Ali ako ne poslušaju, ja ću da iščupam taj narod, da iščupam i da zatrem – govori Gospod.“"
        ]
      }
    ],
