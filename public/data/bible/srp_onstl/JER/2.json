  },
  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "heading",
        "content": [
          "Izrailj je zaboravio Boga"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Došla mi je reč Gospodnja govoreći:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "„Idi i objavi u uši Jerusalima:",
          {
            "lineBreak": true
          },
          "’Govori Gospod:",
          {
            "text": "„Sećam te se po privrženosti tvoje",
            "poem": 1
          },
          {
            "text": "mladosti i ljubavi tvog vereništva.",
            "poem": 2
          },
          {
            "text": "Išla si za mnom u pustinju,",
            "poem": 1
          },
          {
            "text": "u nezasejanu zemlju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Svet je Izrailj bio Gospodu,",
            "poem": 1
          },
          {
            "text": "prvina njegovog uroda",
            "poem": 2
          },
          {
            "text": "i svi koji su ga gutali bili bi krivi",
            "poem": 1
          },
          {
            "text": "i propast bi ih stigla",
            "poem": 2
          },
          {
            "text": "– govori Gospod.“’“",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Čujte Gospodnju reč, dome Jakovljev",
            "poem": 1
          },
          {
            "text": "i svi rodovi Izrailjevog doma.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Govori Gospod:",
          {
            "text": "„Kakvu su nepravdu u meni našli tvoji preci",
            "poem": 1
          },
          {
            "text": "kada su se udaljili od mene,",
            "poem": 2
          },
          {
            "text": "išli za taštinom",
            "poem": 1
          },
          {
            "text": "i postali tašti?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Nisu pitali: ’Gde je Gospod",
            "poem": 1
          },
          {
            "text": "koji nas je doveo iz egipatske zemlje,",
            "poem": 2
          },
          {
            "text": "koji nas je vodio u pustinji,",
            "poem": 1
          },
          {
            "text": "po zemlji pustoši i jama,",
            "poem": 2
          },
          {
            "text": "po zemlji sušnoj i mračnoj,",
            "poem": 1
          },
          {
            "text": "po zemlji kojom niko kročio nije",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i u kojoj niko prebivao nije?’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "A ja sam vas doveo u zemlju voćnjaka,",
            "poem": 1
          },
          {
            "text": "da jedete njeno voće i njena dobra.",
            "poem": 2
          },
          {
            "text": "I došli ste i opoganili ste moju zemlju,",
            "poem": 1
          },
          {
            "text": "i moje ste nasledstvo pretvorili u gadost.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Sveštenici nisu rekli:",
            "poem": 1
          },
          {
            "text": "’Gde je Gospod?’",
            "poem": 2
          },
          {
            "text": "Oni koji se bave Zakonom me nisu poznali,",
            "poem": 1
          },
          {
            "text": "i pastiri se pobuniše protiv mene.",
            "poem": 2
          },
          {
            "text": "Proroci su proricali uz pomoć Vala",
            "poem": 1
          },
          {
            "text": "i išli za onim od čega nema koristi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "I još ću da se parničim s vama",
            "poem": 1
          },
          {
            "text": "– govori Gospod –",
            "poem": 3
          },
          {
            "text": "i sa decom vaše dece ću da se parničim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Jer, pređite na kitimska ostrva i vidite,",
            "poem": 1
          },
          {
            "text": "i u Kedar pošaljite pa onda dobro razmotrite.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Vidite da li se ovako nešto već dogodilo:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Da li je neki narod zamenio bogove",
            "poem": 1
          },
          {
            "text": "ako oni i nisu bogovi?",
            "poem": 2
          },
          {
            "text": "A moj narod je zamenio svoju Slavu",
            "poem": 1
          },
          {
            "noteId": 1
          },
          {
            "text": "za ono od čega nema koristi!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "O, nebesa, užasnite se zbog ovoga,",
            "poem": 1
          },
          {
            "text": "zgrozite se i opustošite",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Jer je dva zla učinio moj narod:",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Zaboravio je mene, izvor svežih voda,",
            "poem": 1
          },
          {
            "text": "i sebi isklesao bunare,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "napukle bunare što ne drže vodu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Pa zar je Izrailj rob, jedan od onih rođenih u kući?",
            "poem": 1
          },
          {
            "text": "Zašto je postao plen?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Na njega riču lavići, urliču rikom;",
            "poem": 1
          },
          {
            "text": "njegovu su zemlju pretvorili u pustoš,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "njegovi gradovi su porušeni",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i tu više niko ne prebiva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Čak ti je i narod iz Nofa i Tafnesa",
            "poem": 1
          },
          {
            "text": "obrijao teme.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Zar to nisi sam sebi uradio",
            "poem": 1
          },
          {
            "text": "napustivši Gospoda, svog Boga,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "u vreme kada te je vodio putem?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "I zato šta ti znači put egipatski",
            "poem": 1
          },
          {
            "text": "da piješ vodu sihorsku",
            "poem": 2
          },
          {
            "noteId": 2
          },
          {
            "text": "?",
            "poem": 2
          },
          {
            "text": "I šta ti znači put asirski",
            "poem": 1
          },
          {
            "text": "da piješ vodu iz reke",
            "poem": 2
          },
          {
            "noteId": 3
          },
          {
            "text": "?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Kazniće te tvoje zlo",
            "poem": 1
          },
          {
            "text": "i tvoje otpadništvo će te prekoriti.",
            "poem": 2
          },
          {
            "text": "Pa znaj i vidi, jer je zlo i gorko",
            "poem": 1
          },
          {
            "text": "što si napustio Gospoda, svog Boga,",
            "poem": 2
          },
          {
            "text": "i što nema u tebi moga straha –",
            "poem": 1
          },
          {
            "text": "govori Gospod, Bog nad vojskama.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Jer ja sam odavno skršio tvoj jaram",
            "poem": 1
          },
          {
            "text": "i tvoje sam okove izlomio.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ali ti si rekla: ’Neću da ti služim.’",
            "poem": 2
          },
          {
            "text": "I na svakoj uzvišici,",
            "poem": 1
          },
          {
            "text": "i pod svakim zelenim drvetom",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "si polegla kao bludnica.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "A ja, ja sam te posadio kao plemenitu lozu,",
            "poem": 1
          },
          {
            "text": "baš pouzdano seme.",
            "poem": 2
          },
          {
            "text": "I kako si mi se promenila",
            "poem": 1
          },
          {
            "text": "i izrodila u vinjagu?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Sve i da se šalitrom pereš",
            "poem": 1
          },
          {
            "text": "i da pribaviš mnogo ceđi,",
            "poem": 2
          },
          {
            "text": "štrčaće fleka tvoje krivice preda mnom",
            "poem": 1
          },
          {
            "text": "– govori Gospod Bog.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Kako onda govoriš: ’Nisam oskrnavljena",
            "poem": 1
          },
          {
            "text": "i nisam išla Valima?’",
            "poem": 2
          },
          {
            "text": "Sagledaj svoje tragove u dolini",
            "poem": 1
          },
          {
            "text": "i shvati šta si uradila.",
            "poem": 2
          },
          {
            "text": "Ti si mlada i brza kamila",
            "poem": 1
          },
          {
            "text": "što tumaraš kojekuda;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "mlada magarica navikla na divljinu",
            "poem": 1
          },
          {
            "text": "što u svojoj žudnji njuši vetar.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "I ko će da je vrati kad je u teranju?",
            "poem": 2
          },
          {
            "text": "Neće malaksati svi koji je traže,",
            "poem": 1
          },
          {
            "text": "jer će je pronaći u njenom mesecu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Ne dozvoli da ti noga bude bosa,",
            "poem": 1
          },
          {
            "text": "da ti grlo bude suvo.",
            "poem": 2
          },
          {
            "text": "Ali ti si rekla: ’Ništa od toga!",
            "poem": 1
          },
          {
            "text": "Ne, jer volim tuđe bogove",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i ići ću za njima.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Kao lopov što se stidi kada ga uhvate,",
            "poem": 1
          },
          {
            "text": "tako će da se osramoti dom Izrailjev.",
            "poem": 2
          },
          {
            "text": "Oni – njegovi carevi, njegovi glavari,",
            "poem": 1
          },
          {
            "text": "njegovi sveštenici i njegovi proroci –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "koji govore drvetu: ’Ti si moj otac!’",
            "poem": 1
          },
          {
            "text": "I kamenu: ’Ti si me rodio!’",
            "poem": 2
          },
          {
            "text": "Jer su meni okrenuli leđa a ne lice,",
            "poem": 1
          },
          {
            "text": "a u vreme svoje propasti će reći:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "’Ustani i spasi nas!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Pa gde su tvoji bogovi koje si napravio za sebe?",
            "poem": 1
          },
          {
            "text": "Neka ustanu ako mogu da te spasu",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "u vreme tvoje propasti.",
            "poem": 2
          },
          {
            "text": "Jer, koliki je broj tvojih gradova –",
            "poem": 1
          },
          {
            "text": "o, Judo – toliko je tvojih bogova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Zašto se parničite sa mnom?",
            "poem": 1
          },
          {
            "text": "Pa svi ste se vi pobunili protiv mene",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Uzalud sam udarao tvoje sinove",
            "poem": 1
          },
          {
            "text": "jer nisu prihvatili karanje,",
            "poem": 2
          },
          {
            "text": "a tvoj je mač progutao tvoje proroke",
            "poem": 1
          },
          {
            "text": "kao kad lav proždire.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "O, naraštaju, razmotrite reč Gospodnju:",
          {
            "text": "Zar sam Izrailju bio pustinja",
            "poem": 1
          },
          {
            "text": "ili zemlja mrklog mraka?",
            "poem": 2
          },
          {
            "text": "Zašto moj narod govori: ’Naskitasmo se",
            "poem": 1
          },
          {
            "text": "pa nećemo ponovo da ti dođemo’?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Zaboravlja li devica svoj nakit",
            "poem": 1
          },
          {
            "text": "i nevesta svoj pojas?",
            "poem": 2
          },
          {
            "text": "A moj narod zaboravlja mene",
            "poem": 1
          },
          {
            "text": "danima bez broja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Kako si dobro uredila svoj put da tražiš ljubav,",
            "poem": 1
          },
          {
            "text": "da si i pokvarenice naučila svojim putevima!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Još se i krv našla na tvojim skutima,",
            "poem": 1
          },
          {
            "text": "sve životi ubogih i nevinih,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "iako ih nisi zatekla dok provaljuju.",
            "poem": 2
          },
          {
            "text": "Ali za sve to ti kažeš:",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "’Ja sam nedužna!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Njegov se gnev svakako odvratio od mene.’",
            "poem": 2
          },
          {
            "text": "I evo, sporiću se s tobom",
            "poem": 1
          },
          {
            "text": "jer govoriš: ’Sagrešila nisam.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Zašto tako tumarajući",
            "poem": 1
          },
          {
            "text": "menjaš svoj put?",
            "poem": 2
          },
          {
            "text": "I od Egipta ćeš se zastideti",
            "poem": 1
          },
          {
            "text": "kao što si se zastidela Asirije.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "I od njega ćeš da odeš",
            "poem": 1
          },
          {
            "text": "s rukama svojim na glavi svojoj,",
            "poem": 2
          },
          {
            "text": "jer je Gospod odbacio tvoje uzdanice",
            "poem": 1
          },
          {
            "text": "da zbog njih ne napreduješ.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
