  },
  "chapter": {
    "number": 31,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "„U one dane – govori Gospod – biću Bog svim rodovima Izrailjevim, a oni će biti moj narod.“"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Ovako kaže Gospod:",
          {
            "text": "„Narod koji je preživeo mač",
            "poem": 1
          },
          {
            "text": "našao je naklonost u pustinji,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kada je Izrailj otišao da nađe svoj počinak.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Gospod mi",
          {
            "noteId": 16
          },
          "se izdaleka objavio:",
          {
            "text": "„Ja te volim ljubavlju večnom",
            "poem": 1
          },
          {
            "text": "i zato te milošću privlačim!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Opet ću te sazidati,",
            "poem": 1
          },
          {
            "text": "obnovljena bićeš, o, device izrailjska.",
            "poem": 2
          },
          {
            "text": "Dairama ćeš se opet okititi,",
            "poem": 1
          },
          {
            "text": "igraćeš u kolu s radosnima!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Opet ćeš da sadiš vinograde",
            "poem": 1
          },
          {
            "text": "na brdima Samarije.",
            "poem": 2
          },
          {
            "text": "A oni koji sade,",
            "poem": 1
          },
          {
            "text": "ti će i da jedu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Jer dolazi dan kada će zvati stražari",
            "poem": 1
          },
          {
            "text": "po Jefremovom gorju:",
            "poem": 2
          },
          {
            "text": "’Ustanite! Idemo Gospodu,",
            "poem": 1
          },
          {
            "text": "našem Bogu na Sion!’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ovako kaže Gospod:",
          {
            "text": "„Radosno kličite zbog Jakova!",
            "poem": 1
          },
          {
            "text": "Podvriskujte kličući zbog glave naroda!",
            "poem": 2
          },
          {
            "text": "Objavljujte, proslavljajte i govorite:",
            "poem": 1
          },
          {
            "text": "’O, Gospode, spasi svoj narod,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ostatak Izrailjev!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Evo, dovodim ih iz severne zemlje,",
            "poem": 1
          },
          {
            "text": "okupljam ih iz najdaljih zemljinih krajeva.",
            "poem": 2
          },
          {
            "text": "I među njima će biti slepi i hromi,",
            "poem": 1
          },
          {
            "text": "trudnica i porodilja.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Baš veliki zbor će se vratiti ovamo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Doći će s preklinjanjima,",
            "poem": 1
          },
          {
            "text": "dovešću ih dok budu vapili.",
            "poem": 2
          },
          {
            "text": "Vodiću ih na nabujale potoke,",
            "poem": 1
          },
          {
            "text": "na puteve ravne na kojima se neće spotaknuti.",
            "poem": 2
          },
          {
            "text": "Jer ja sam Izrailju otac",
            "poem": 1
          },
          {
            "text": "i Jefrem je moj prvenac.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "„Narodi, čujte reč Gospodnju,",
            "poem": 1
          },
          {
            "text": "javite po dalekim ostrvima i recite:",
            "poem": 2
          },
          {
            "text": "’Onaj koji je raštrkao Izrailj, taj će ga i sakupiti",
            "poem": 1
          },
          {
            "text": "i čuvaće ih kao pastir svoje stado.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Jer, Gospod je otkupio Jakova,",
            "poem": 1
          },
          {
            "text": "iskupio ga je iz ruku jačega od njega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "A oni će doći na brdo Sion kličući radosno.",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Likovaće zbog dobra Gospodnjeg, zbog žita",
            "poem": 1
          },
          {
            "text": "i vina, zbog ulja, jaganjaca i teladi.",
            "poem": 2
          },
          {
            "text": "Život će im biti kao vrt zaliven",
            "poem": 1
          },
          {
            "text": "i više nikad neće malaksati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Devojka će se u kolu radovati",
            "poem": 1
          },
          {
            "text": "zajedno sa mladićima i starcima.",
            "poem": 2
          },
          {
            "text": "Preokrenuću njihovu žalost u radost.",
            "poem": 1
          },
          {
            "text": "Utešiću ih i obradovati ih nakon tuge njihove.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Nasitiću izobiljem duše sveštenika",
            "poem": 1
          },
          {
            "text": "a i moj će narod sit biti od dobara mojih",
            "poem": 2
          },
          {
            "text": "– govori Gospod.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Ovako kaže Gospod:",
          {
            "text": "„U Rami se glas čuje,",
            "poem": 1
          },
          {
            "text": "jecaj i lelek glasni:",
            "poem": 2
          },
          {
            "text": "to Rahilja za decom svojom nariče,",
            "poem": 1
          },
          {
            "text": "i neće da se uteši,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer njih više nema.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Ovako kaže Gospod:",
          {
            "text": "„Grlo stegni da ne plače,",
            "poem": 1
          },
          {
            "text": "ne daj oku da zasuzi!",
            "poem": 2
          },
          {
            "text": "Jer, evo nagrade za delo tvoje",
            "poem": 1
          },
          {
            "text": "– govori Gospod –",
            "poem": 3
          },
          {
            "text": "vratiće se oni iz zemlje neprijatelja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Za tvoje sutra postoji nada",
            "poem": 1
          },
          {
            "text": "– govori Gospod –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "vratiće se deca u svoj zavičaj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Jesam, čuo sam Jefrema što nad sobom žali:",
            "poem": 1
          },
          {
            "text": "’Kaznio si me",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i bio sam kažnjen kao tele neukroćeno.",
            "poem": 2
          },
          {
            "text": "Povrati me da mogu da se vratim,",
            "poem": 1
          },
          {
            "text": "jer si ti, Gospode, Bog moj!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "I kad sam ti se vratio,",
            "poem": 1
          },
          {
            "text": "pokajao sam se;",
            "poem": 2
          },
          {
            "text": "i kad sam poučen bio,",
            "poem": 1
          },
          {
            "text": "tukao sam se u bedra.",
            "poem": 2
          },
          {
            "text": "Sramota me je i ponižen sam",
            "poem": 1
          },
          {
            "text": "jer nosim ruglo svoje mladosti.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Nije li Jefrem moj dragi sin",
            "poem": 1
          },
          {
            "text": "i dete najmilije?",
            "poem": 2
          },
          {
            "text": "Iako sam često govorio protiv njega,",
            "poem": 1
          },
          {
            "text": "stalno mislim o njemu.",
            "poem": 2
          },
          {
            "text": "Zato mi je za njim ustreptala utroba",
            "poem": 1
          },
          {
            "text": "i stvarno ću da mu se smilujem",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Postavi sebi putokaze.",
            "poem": 1
          },
          {
            "text": "Stavi sebi znakove",
            "poem": 2
          },
          {
            "text": "i srce usmeri na put,",
            "poem": 1
          },
          {
            "text": "na stazu kojom si išla.",
            "poem": 2
          },
          {
            "text": "Pa se vrati, o, device izrailjska,",
            "poem": 1
          },
          {
            "text": "vrati se ovim svojim gradovima!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Dokle ćeš da tumaraš,",
            "poem": 1
          },
          {
            "text": "o, ćerko odmetnička?!",
            "poem": 2
          },
          {
            "text": "Jer Gospod je stvorio na zemlji nešto novo,",
            "poem": 1
          },
          {
            "text": "kao kad bi žena pristupila muškarcu.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Ovako kaže Gospod nad vojskama, Bog Izrailja: „Ljudi će opet govoriti ovu izreku u judejskoj zemlji i po njenim gradovima, kad im vratim njihove izgnanike: ’Neka te Gospod blagoslovi Prebivalište pravde, svetosti goro!’"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Prebivaće Juda i svi njeni gradovi zajedno u njoj, i ratari i oni što idu za stadom."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Napojiću duše malaksale, okrepiću svakog iznemoglog.“"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "I tada sam se probudio i pogledao: moj je san bio tako sladak."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "„Evo, dolaze dani – govori Gospod – kada ću dom Izrailjev i dom Judin zasejati ljudskim semenom i stočnim semenom."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "I kao što sam bdeo nad njima da ih čupam, da ih obaram i rušim, da ih razaram i kažnjavam; tako ću da bdim nad njima da ih gradim i da ih sadim – govori Gospod."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "U danima onim neće više govoriti:",
          {
            "text": "’Očevi su jeli nedozrelo grožđe,",
            "poem": 1
          },
          {
            "text": "ali zato zubi trnu sinovima!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Ipak, za svoju krivicu svako će da umre; utrnuće zubi svakom koji grožđe nedozrelo jede!"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Evo, dolaze dani – govori Gospod –",
            "poem": 1
          },
          {
            "text": "kada ću sklopiti novi savez",
            "poem": 2
          },
          {
            "text": "s narodom izrailjskim",
            "poem": 1
          },
          {
            "text": "i s narodom Judinim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "To neće biti kao kad sam",
            "poem": 1
          },
          {
            "text": "sklopio savez sa njihovim ocima,",
            "poem": 2
          },
          {
            "text": "onoga dana kad sam ih uzeo za ruku",
            "poem": 1
          },
          {
            "text": "i izveo iz Egipta.",
            "poem": 2
          },
          {
            "text": "Ali nisu bili verni mome savezu,",
            "poem": 1
          },
          {
            "text": "a ja sam im bio muž",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "A ovo je savez koji ću sklopiti",
            "poem": 1
          },
          {
            "text": "s narodom izrailjskim nakon tih dana:",
            "poem": 2
          },
          {
            "text": "staviću svoj Zakon u njih same,",
            "poem": 1
          },
          {
            "text": "i upisaću ga u njihova srca.",
            "poem": 2
          },
          {
            "text": "Ja ću biti njihov Bog,",
            "poem": 1
          },
          {
            "text": "a oni će biti moj narod",
            "poem": 2
          },
          {
            "text": "– govori Gospod!",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Tada niko neće poučavati svoga sugrađanina",
            "poem": 1
          },
          {
            "text": "ili brata govoreći: ’Upoznaj Gospoda’,",
            "poem": 2
          },
          {
            "text": "jer će me poznavati svi od malog do velikog",
            "poem": 1
          },
          {
            "text": "– govori Gospod.",
            "poem": 2
          },
          {
            "text": "Jer oprostiću njihove krivice,",
            "poem": 1
          },
          {
            "text": "i neću se sećati njihovih greha.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "Ovako kaže Gospod",
          {
            "text": "koji daje sunce da svetli danju,",
            "poem": 1
          },
          {
            "text": "odredbe mesecu i zvezdama da svetle noću;",
            "poem": 2
          },
          {
            "text": "koji more uzburka i talasi mu ključaju",
            "poem": 1
          },
          {
            "text": "i kome je ime Gospod nad vojskama:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "„Ako bi ove odredbe i nestale preda mnom",
            "poem": 1
          },
          {
            "text": "– govori Gospod –",
            "poem": 2
          },
          {
            "text": "prestaće i Izrailjevo potomstvo",
            "poem": 1
          },
          {
            "text": "da bude narod preda mnom doveka.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "Ovako kaže Gospod:",
          {
            "text": "„Kada bi mogla da se premere nebesa gornja,",
            "poem": 1
          },
          {
            "text": "i kada bi mogli da se istraže temelji zemljini donji,",
            "poem": 2
          },
          {
            "text": "tako bih i ja mogao da odbacim sve potomke Izrailja",
            "poem": 1
          },
          {
            "text": "zbog svega onoga što su učinili",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "Evo, dolaze dani – govori Gospod – kada će se obnoviti grad za Gospoda, od Ananilove kule pa do Ugaonih vrata."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "A uže za merenje će se protegnuti sve do brda Gariv i nazad prema Goahu."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "I sva dolina leševa i pepela, sva polja doline Kidron, do ugla Konjskih vrata ka istoku biće sveta Gospodu. Grad nikad više i doveka neće biti razvaljivan i rušen.“"
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 16,
        "caller": "+",
        "text": "31,3 U Septuaginti stoji Gospod mu. Ovde prorok govori u ime sveg naroda.",
        "reference": {
          "chapter": 31,
          "verse": 3
        }
      }
    ]
