  "chapter": {
    "number": 15,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Gospod mi je rekao: „Ako bi Mojsije i Samuilo stali pred mene ne bi se moja duša priklonila ovom narodu. Oteraj ih od mene! Neka idu."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "A ako ti kažu: ’A gde da idemo?’, ti im odgovori: ’Ovako kaže Gospod:",
          {
            "text": "U smrt, ko je za smrt;",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "pod mač, ko je za mač;",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "u glad, ko je za glad;",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "u izgnanstvo, ko je za izgnanstvo.’",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Navaliću na njih četiri stvari – govori Gospod – mač što ubija, pse što trgaju, ptice nebeske i zveri zemaljske što proždiru i tamane."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Učiniću ih prizorom grozote za sva carstva sveta zbog Judinog cara Manasije, sina Jezekijinog, zbog onog što je uradio u Jerusalimu."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "O, Jerusalime, ko će da ti se smiluje?!",
            "poem": 1
          },
          {
            "text": "Ko će da te požali",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i ko da ti svrati i upita te za zdravlje?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ti si mene napustio – govori Gospod –",
            "poem": 1
          },
          {
            "text": "ustuknuo si,",
            "poem": 2
          },
          {
            "text": "a ja ću zamahnuti rukom na tebe",
            "poem": 1
          },
          {
            "text": "i razoriću te.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Umorilo me je da ti popuštam.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Razvejaću ih vilama na vratima zemlje.",
            "poem": 1
          },
          {
            "text": "Pobiću decu mom narodu,",
            "poem": 2
          },
          {
            "text": "satrću ih jer se ne kaju",
            "poem": 1
          },
          {
            "text": "zbog svojih puteva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Više nego morskog peska",
            "poem": 1
          },
          {
            "text": "biće preda mnom udovica,",
            "poem": 2
          },
          {
            "text": "majki mladića protiv kojih ću dovesti",
            "poem": 1
          },
          {
            "text": "zatirača usred dana.",
            "poem": 2
          },
          {
            "text": "Učiniću da se iznenada na njih",
            "poem": 1
          },
          {
            "text": "strovale muka i užas.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Klonula je ona što je sedmoro rodila,",
            "poem": 1
          },
          {
            "text": "dah je ispustila,",
            "poem": 2
          },
          {
            "text": "sunce joj je zašlo još za dana.",
            "poem": 1
          },
          {
            "text": "Posramljena je, zacrvenela se,",
            "poem": 2
          },
          {
            "text": "a njihov ostatak ću dati maču njihovih neprijatelja",
            "poem": 1
          },
          {
            "text": "– govori Gospod.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Kuku majko, što si me rodila!",
            "poem": 1
          },
          {
            "text": "Čovek sam nesloge,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "čovek oko kog se gloži cela zemlja!",
            "poem": 2
          },
          {
            "text": "Nitʼ sam pozajmljivao, nitʼ su mi pozajmljivali,",
            "poem": 1
          },
          {
            "text": "a svaki me proklinje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Gospod odgovori:",
          {
            "text": "„Oslobodiću te zaista za tvoje dobro.",
            "poem": 1
          },
          {
            "text": "Zaista ću dati da te neprijatelj moli",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "u vreme pogroma i u vreme nevolje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Slomi li ko gvožđe,",
            "poem": 1
          },
          {
            "text": "gvožđe sa severa i bronzu",
            "poem": 2
          },
          {
            "noteId": 7
          },
          {
            "text": "?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Tvoja dobra i imanja tvoja",
            "poem": 1
          },
          {
            "text": "dajem kao plen, u bescenje,",
            "poem": 2
          },
          {
            "text": "za sve tvoje grehe",
            "poem": 1
          },
          {
            "text": "po svim tvojim granicama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Predaću te neprijateljima tvojim",
            "poem": 1
          },
          {
            "text": "u zemlji koju ne znaš,",
            "poem": 2
          },
          {
            "text": "da im služiš;",
            "poem": 1
          },
          {
            "text": "jer moj gnev je vatru zapalio",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i protiv tebe ona bukti.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "O, Gospode, ti znaš, ti me se seti.",
            "poem": 1
          },
          {
            "text": "Seti me se i osveti se za mene onima što me kinje.",
            "poem": 2
          },
          {
            "text": "Ne daj da me zbriše sporost tvoga gneva.",
            "poem": 1
          },
          {
            "text": "Ti znaš da za tebe trpim ruglo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Tvoje reči su se našle i ja sam ih pojeo!",
            "poem": 1
          },
          {
            "text": "Tvoje reči su postale radost i veselje mome srcu!",
            "poem": 2
          },
          {
            "text": "Jer, tvoje je ime prizvano na mene,",
            "poem": 1
          },
          {
            "text": "o, Gospode, Bože nad vojskama!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ja ne sedim u društvu veseljaka",
            "poem": 1
          },
          {
            "text": "i ne veselim se.",
            "poem": 2
          },
          {
            "text": "Sedim sam, baš zbog ruke tvoje,",
            "poem": 1
          },
          {
            "text": "jer si me jarošću preplavio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Zašto mome bolu nema kraja?",
            "poem": 1
          },
          {
            "text": "Zašto mojoj rani nema leka, što odbija da bude izlečena?",
            "poem": 2
          },
          {
            "text": "A ti si mi stvarno kao potok nepostojan,",
            "poem": 1
          },
          {
            "text": "voda što presuši.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "I zato ovako kaže Gospod:",
          {
            "text": "„Ako se vratiš, izlečiću te",
            "poem": 1
          },
          {
            "text": "i preda mnom ćeš stajati.",
            "poem": 2
          },
          {
            "text": "I ako razdvojiš vredno od bezvrednog",
            "poem": 1
          },
          {
            "text": "bićeš kao moja usta.",
            "poem": 2
          },
          {
            "text": "I oni će se okretati tebi",
            "poem": 1
          },
          {
            "text": "ali ti ne smeš da se okrećeš k njima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Napraviću od tebe",
            "poem": 1
          },
          {
            "text": "utvrđeni bronzani zid za narod ovaj.",
            "poem": 2
          },
          {
            "text": "Boriće se protiv tebe,",
            "poem": 1
          },
          {
            "text": "ali te neće nadvladati.",
            "poem": 2
          },
          {
            "text": "Jer ja sam s tobom",
            "poem": 1
          },
          {
            "text": "da te spasem i izbavljam",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Izbaviću te iz ruku zlikovaca!",
            "poem": 1
          },
          {
            "text": "Iz šaka svirepih otkupiću te!“",
            "poem": 2
          }
        ]
      }
    ],
