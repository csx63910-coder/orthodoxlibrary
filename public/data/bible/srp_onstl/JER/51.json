  "chapter": {
    "number": 51,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ovako kaže Gospod:",
          {
            "text": "„Evo, podižem na Vavilon i na stanovnike Lev-Kamaja",
            "poem": 1
          },
          {
            "noteId": 31
          },
          {
            "text": "vetar što razara.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Na Vavilon šaljem tuđince da ih razveju,",
            "poem": 1
          },
          {
            "text": "da opustoše njihovu zemlju.",
            "poem": 2
          },
          {
            "text": "Napašće ih sa svih strana",
            "poem": 1
          },
          {
            "text": "na dan propasti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Neka strelac luk svoj ne zapinje,",
            "poem": 1
          },
          {
            "text": "neka se ne šepuri u oklopu svome.",
            "poem": 2
          },
          {
            "text": "Ne štedite njegove mladiće,",
            "poem": 1
          },
          {
            "text": "izručite kletom uništenju svu vojsku njegovu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Popadaće pobijeni u zemlji haldejskoj",
            "poem": 1
          },
          {
            "text": "i probodeni po njegovim ulicama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Izrailj i Juda nisu udovica zaboravljena",
            "poem": 1
          },
          {
            "text": "od njihovog Boga, Gospoda nad vojskama,",
            "poem": 2
          },
          {
            "text": "makar je njihova",
            "poem": 1
          },
          {
            "noteId": 32
          },
          {
            "text": "zemlja puna greha",
            "poem": 1
          },
          {
            "text": "pred Svecem Izrailjevim.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Bežite iz Vavilona!",
            "poem": 1
          },
          {
            "text": "Svako živu glavu nek spasava",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da ne nastradate u njegovoj krivici.",
            "poem": 2
          },
          {
            "text": "Jer je vreme Gospodnje osvete.",
            "poem": 1
          },
          {
            "text": "On uzvraća, on će da mu naplati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Čaša zlatna je Vavilon bio u Gospodnjoj ruci,",
            "poem": 1
          },
          {
            "text": "svu je zemlju opijao.",
            "poem": 2
          },
          {
            "text": "Od njenog vina su se napili narodi",
            "poem": 1
          },
          {
            "text": "i zato su se poneli ludo narodi ti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "I odjednom je pao Vavilon i razbio se.",
            "poem": 1
          },
          {
            "text": "Kukajte nad njim!",
            "poem": 2
          },
          {
            "text": "Donesite melem za njegovu bol,",
            "poem": 1
          },
          {
            "text": "možda i ozdravi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Lečili smo mi Vavilon,",
            "poem": 1
          },
          {
            "text": "ali nije ozdravio.",
            "poem": 2
          },
          {
            "text": "Ostavite ga! Svako svojoj zemlji neka ide,",
            "poem": 1
          },
          {
            "text": "jer do neba je dospeo njegov sud,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "do oblaka se uzdigao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "A Gospod je za nas pravedna dela učinio.",
            "poem": 1
          },
          {
            "text": "Dođite, objavimo na Sionu",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "delo Gospoda, našeg Boga!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Strele naoštrite!",
            "poem": 1
          },
          {
            "text": "Štitove podignite!",
            "poem": 2
          },
          {
            "text": "Na Vavilon je Gospod podigao duh midijskih careva",
            "poem": 1
          },
          {
            "text": "jer hoće da ga razori,",
            "poem": 2
          },
          {
            "text": "jer je Gospodnja osveta,",
            "poem": 1
          },
          {
            "text": "odmazda za njegov Dom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Podignite zastavu protiv zidina Vavilona!",
            "poem": 1
          },
          {
            "text": "Ojačajte stražu,",
            "poem": 2
          },
          {
            "text": "postavite stražare,",
            "poem": 1
          },
          {
            "text": "spremite zasede.",
            "poem": 2
          },
          {
            "text": "Ono što je Gospod naumio, to je i uradio,",
            "poem": 1
          },
          {
            "text": "baš kako je najavio stanovnicima Vavilona.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "O, ti što živiš kraj mnogih voda",
            "poem": 1
          },
          {
            "text": "i obiluješ bogatstvom,",
            "poem": 2
          },
          {
            "text": "kraj ti je došao",
            "poem": 1
          },
          {
            "text": "i tvoj je dobitak prestao!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Gospod nad vojskama se sobom zakleo:",
            "poem": 1
          },
          {
            "text": "„Ispuniću te ljudima kao skakavcima",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da na tebe pobednički kliču.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "On je silom svojom načinio zemlju.",
            "poem": 1
          },
          {
            "text": "Mudrošću svojom on je osnovao vaseljenu",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i svojom je razboritošću razapeo nebesa.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Glas on kada pusti, vode huče na nebesima.",
            "poem": 1
          },
          {
            "text": "On podiže oblake s kraja zemlje,",
            "poem": 2
          },
          {
            "text": "kiši munje daje",
            "poem": 1
          },
          {
            "text": "i izvodi vetar iz svojih riznica.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Baš je od svog znanja glup svaki čovek.",
            "poem": 1
          },
          {
            "text": "Zbog idola se svaki zlatar stidi",
            "poem": 2
          },
          {
            "text": "jer su obmana njegovi liveni idoli.",
            "poem": 1
          },
          {
            "text": "Nema daha u njima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Oni su isprazni, tvorevine rugla.",
            "poem": 1
          },
          {
            "text": "Propašće kad dođe vreme za njihovu kaznu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ne slede Jakovu takvi kao ovi.",
            "poem": 1
          },
          {
            "text": "Jer on je taj koji je sve načinio.",
            "poem": 2
          },
          {
            "text": "Pleme je njegovo nasledstvo,",
            "poem": 1
          },
          {
            "text": "a on se zove Gospod nad vojskama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "„Ti si mi malj,",
            "poem": 1
          },
          {
            "text": "ratno oružje;",
            "poem": 2
          },
          {
            "text": "tobom razbijam narode",
            "poem": 1
          },
          {
            "text": "i carstva tobom satirem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Tobom razbijam i konja i njegovog jahača;",
            "poem": 1
          },
          {
            "text": "tobom razbijam kola i njihovog vozača.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Tobom razbijam muškarca i ženu;",
            "poem": 1
          },
          {
            "text": "tobom razbijam starca i dete;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "tobom razbijam mladića i devojku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Tobom razbijam pastira i stado njegovo;",
            "poem": 1
          },
          {
            "text": "tobom razbijam ratara i njegovu zapregu;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "tobom razbijam gospodara i dostojanstvenika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Naplatiću Vavilonu i svim stanovnicima Haldeje sve njihove opačine koje su počinili na Sionu vama naočigled – govori Gospod."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Evo me na tebe, goro što satireš",
            "poem": 1
          },
          {
            "text": "– govori Gospod –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "koja satireš svu zemlju.",
            "poem": 2
          },
          {
            "text": "Na tebe ću ruku svoju da ispružim,",
            "poem": 1
          },
          {
            "text": "da te svaljam sa litice",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i od tebe da napravim goru sagorelu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Od tebe neće uzimati ni ugaoni kamen,",
            "poem": 1
          },
          {
            "text": "ni kamen temeljac,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer ćeš biti pustoš doveka",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Podignite zastavu u zemlji!",
            "poem": 1
          },
          {
            "text": "Duvajte u trube među narodima!",
            "poem": 2
          },
          {
            "text": "Spremite protiv njega narode,",
            "poem": 1
          },
          {
            "text": "okupite na njega carstva Ararata,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Minije i Ashenasa.",
            "poem": 2
          },
          {
            "text": "Postrojte na njega vojskovođu,",
            "poem": 1
          },
          {
            "text": "dovedite konje čekinjaste kao skakavci.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Spremite na njega narode",
            "poem": 1
          },
          {
            "text": "i midijske careve,",
            "poem": 2
          },
          {
            "text": "njihove gospodare, sve njihove glavare",
            "poem": 1
          },
          {
            "text": "i svaku zemlju njihove vladavine.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "I zemlja će se tresti i uvijati,",
            "poem": 1
          },
          {
            "text": "jer se na Vavilonu ispunjavaju Gospodnje namere,",
            "poem": 2
          },
          {
            "text": "da zemlju vavilonsku pretvori",
            "poem": 1
          },
          {
            "text": "u pustoš nenaseljenu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Prestali su da se bore ratnici Vavilona,",
            "poem": 1
          },
          {
            "text": "ostali su u utvrđenjima",
            "poem": 2
          },
          {
            "text": "i presahnula im je snaga.",
            "poem": 1
          },
          {
            "text": "Postali su kao žene!",
            "poem": 2
          },
          {
            "text": "Domove su im spalili,",
            "poem": 1
          },
          {
            "text": "a vrata polomili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Stiže glasnik za glasnikom,",
            "poem": 1
          },
          {
            "text": "trči vesnik za vesnikom,",
            "poem": 2
          },
          {
            "text": "javlja caru Vavilona:",
            "poem": 1
          },
          {
            "text": "grad su njegov sasvim osvojili;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "gazove su opkolili,",
            "poem": 1
          },
          {
            "text": "ritove su vatrom popalili",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i sve ratnike preplašili.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "Jer ovako kaže Gospod nad vojskama, Bog Izrailja:",
          {
            "text": "„Ćerka vavilonska će biti kao gumno",
            "poem": 1
          },
          {
            "text": "kome je vreme da se omlati.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Još malo i za nju će doći vreme žetve.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "„Mene je Navuhodonosor, car Vavilona,",
            "poem": 1
          },
          {
            "text": "i proždrao i pomeo.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Izložio me je kao posudu praznu,",
            "poem": 2
          },
          {
            "text": "proždrao me kao morska neman.",
            "poem": 1
          },
          {
            "text": "Mojim je dobrima napunio",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "trbušinu svoju, a mene je ojadio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Neka na Vavilon dođe nasilje učinjeno nada mnom i mojom rodbinom",
            "poem": 1
          },
          {
            "text": "– reći će stanovnica Siona.",
            "poem": 2
          },
          {
            "text": "I moja krv na stanovnike Haldeje",
            "poem": 1
          },
          {
            "text": "– reći će Jerusalim.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "Zato ovako kaže Gospod:",
          {
            "text": "„Braniću te u parnici tvojoj.",
            "poem": 1
          },
          {
            "text": "Osvetiću te!",
            "poem": 2
          },
          {
            "text": "Presušiću more njegovo",
            "poem": 1
          },
          {
            "text": "i izvor mu isušiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Vavilon će postati gomila kamenja",
            "poem": 1
          },
          {
            "text": "i brlog šakala,",
            "poem": 2
          },
          {
            "text": "ruglo i pustoš",
            "poem": 1
          },
          {
            "text": "u kojoj niko ne živi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "Zajedno će rikati kao mladi lavovi,",
            "poem": 1
          },
          {
            "text": "režaće kao lavići.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          {
            "text": "A kada se razdraže",
            "poem": 1
          },
          {
            "text": "daću im njihove gozbe",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i napiću ih;",
            "poem": 2
          },
          {
            "text": "pa neka slave",
            "poem": 1
          },
          {
            "text": "i spavaju doveka, neka se ne bude",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          {
            "text": "Odvešću ih",
            "poem": 1
          },
          {
            "text": "kao jagnjad na klanje",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i kao ovnove i jarce.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          {
            "text": "Kako je porobljen Sisak",
            "poem": 1
          },
          {
            "noteId": 33
          },
          {
            "text": "i uhvaćena slava sve zemlje!",
            "poem": 2
          },
          {
            "text": "Kako je Vavilon postao",
            "poem": 1
          },
          {
            "text": "ruglo među narodima!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          {
            "text": "More se diglo hukom talasa svojih na Vavilon.",
            "poem": 1
          },
          {
            "text": "Prekrilo ga je!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          {
            "text": "Njegovi su gradovi postali pustoš,",
            "poem": 1
          },
          {
            "text": "zemlja osušena,",
            "poem": 2
          },
          {
            "text": "pustara bez ikoga u njima.",
            "poem": 1
          },
          {
            "text": "Tamo neće biti potomaka ljudi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          {
            "text": "Kazniću Vila u Vavilonu,",
            "poem": 1
          },
          {
            "text": "iz usta ću da mu otmem ono što je progutao.",
            "poem": 2
          },
          {
            "text": "Neće mu ponovo hrliti narodi,",
            "poem": 1
          },
          {
            "text": "a i zidine će vavilonske pasti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          {
            "text": "Izađite iz sredine njegove, o, narode moj!",
            "poem": 1
          },
          {
            "text": "Svako neka spasava glavu",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "od rasplamtelog gneva Gospodnjeg.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          {
            "text": "Da vam ne klone srce,",
            "poem": 1
          },
          {
            "text": "ne plašite se glasa što se čuje po zemlji.",
            "poem": 2
          },
          {
            "text": "Jer će jedne godine stići jedan glas,",
            "poem": 1
          },
          {
            "text": "pa druge godine drugi glas.",
            "poem": 2
          },
          {
            "text": "A u zemlji će biti nasilje",
            "poem": 1
          },
          {
            "text": "i boriće se vladar sa vladarom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          {
            "text": "Zato, evo, dolaze dani",
            "poem": 1
          },
          {
            "text": "kada ću da kaznim idole Vavilona;",
            "poem": 2
          },
          {
            "text": "sva će njegova zemlja biti posramljena,",
            "poem": 1
          },
          {
            "text": "a svi njegovi pobijeni će padati usred njega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          {
            "text": "Klicaće nebesa i zemlja",
            "poem": 1
          },
          {
            "text": "i sve u njima nad Vavilonom,",
            "poem": 2
          },
          {
            "text": "jer sa severa dolaze zatirači",
            "poem": 1
          },
          {
            "text": "– govori Gospod.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          {
            "text": "Vavilon će pasti zbog pobijenih Izrailjaca",
            "poem": 1
          },
          {
            "text": "kao što su zbog Vavilona",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "padali pobijeni cele zemlje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          {
            "text": "Idite vi, koji ste pobegli od mača,",
            "poem": 1
          },
          {
            "text": "ne ostajte!",
            "poem": 2
          },
          {
            "text": "Setite se Gospoda tamo daleko,",
            "poem": 1
          },
          {
            "text": "i Jerusalim u srcu nosite.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 51,
        "content": [
          {
            "text": "Osramoćeni smo,",
            "poem": 1
          },
          {
            "text": "jer smo čuli za ruglo.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Lica nam je pokrila sramota,",
            "poem": 2
          },
          {
            "text": "jer su tuđinci došli",
            "poem": 1
          },
          {
            "text": "u Svetilišta Gospodnjeg Doma.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 52,
        "content": [
          {
            "text": "„Zato, evo, dolaze dani – govori Gospod –",
            "poem": 1
          },
          {
            "text": "kazniću njegove idole",
            "poem": 2
          },
          {
            "text": "i po svoj zemlji svojoj",
            "poem": 1
          },
          {
            "text": "roptaće na samrti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 53,
        "content": [
          {
            "text": "U nebesa neka se Vavilon digne,",
            "poem": 1
          },
          {
            "text": "neka se utvrdi u visini u svoj sili svojoj,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ali ja šaljem zatirače na njega",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 54,
        "content": [
          {
            "text": "Čujte vapaj iz Vavilona!",
            "poem": 1
          },
          {
            "text": "Razaranje veliko iz zemlje haldejske!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 55,
        "content": [
          {
            "text": "Jer Gospod satire Vavilon,",
            "poem": 1
          },
          {
            "text": "vrevu njegovu ućutkuje.",
            "poem": 2
          },
          {
            "text": "I bučaće njegovi talasi kao mnoge vode,",
            "poem": 1
          },
          {
            "text": "galamiće glasovi njihovi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 56,
        "content": [
          {
            "text": "Zatirač dolazi na Vavilon.",
            "poem": 1
          },
          {
            "text": "Porobiće njegove ratnike,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "polomiće lukove njihove,",
            "poem": 2
          },
          {
            "text": "jer Gospod je Bog koji plaća",
            "poem": 1
          },
          {
            "text": "i sigurno istom merom vraća.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 57,
        "content": [
          {
            "text": "Opiću njegove glavare i mudrace njegove,",
            "poem": 1
          },
          {
            "text": "njegove gospodare, dostojanstvenike njegove i njegove ratnike.",
            "poem": 2
          },
          {
            "text": "I zaspaće doveka i buditi se neće –",
            "poem": 1
          },
          {
            "text": "govori Car,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Gospod nad vojskama mu je ime.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 58,
        "content": [
          "Ovako kaže Gospod nad vojskama:",
          {
            "text": "„Široke zidine Vavilona će srušiti,",
            "poem": 1
          },
          {
            "text": "a vrata njegova visoka će vatrom spaliti.",
            "poem": 2
          },
          {
            "text": "Narodi su radili uzalud,",
            "poem": 1
          },
          {
            "text": "ljudi su za vatru rintali.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 59,
        "content": [
          "Ovo je nalog koji je prorok Jeremija izdao Soraji, Nirijinom sinu i Masijinom unuku, kada je sa Judinim carem Sedekijom otišao u Vavilon, četvrte godine njegove vladavine. A Soraja je bio glavni komornik."
        ]
      },
      {
        "type": "verse",
        "number": 60,
        "content": [
          "Naime, Jeremija mu je u jednu knjigu zapisao sve zlo koje će stići Vavilon, baš sve ove poruke koje su zapisane o Vavilonu."
        ]
      },
      {
        "type": "verse",
        "number": 61,
        "content": [
          "A onda je Jeremija rekao Soraji: „Čim dođeš u Vavilon pazi da naglas pročitaš sve ove reči."
        ]
      },
      {
        "type": "verse",
        "number": 62,
        "content": [
          "Reci: ’O, Gospode! Ti si objavio da ćeš razoriti ovo mesto, da u njemu ne ostane potomaka ljudi ni stoke, već da bude pustoš doveka.’"
        ]
      },
      {
        "type": "verse",
        "number": 63,
        "content": [
          "I kada završiš sa čitanjem, veži ovu knjigu za kamen i baci je posred Eufrata."
        ]
      },
      {
        "type": "verse",
        "number": 64,
        "content": [
          "A onda reci: ’Ovako će Vavilon da potone i neće se dići, zbog zla koje donosim na njega! Malaksaće!’“ Ovde se završavaju Jeremijine poruke."
        ]
      }
    ],
