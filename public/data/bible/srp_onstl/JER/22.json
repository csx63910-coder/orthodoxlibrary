  "chapter": {
    "number": 22,
    "content": [
      {
        "type": "heading",
        "content": [
          "Sud nad zlim carevima Jude"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Gospod je ovako rekao: „Siđi do carevog dvora u Judi i tamo im objavi ovu reč."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Reci: ’Čuj Gospodnju reč, care Judin, što sediš na Davidovom prestolu – ti, tvoje sluge i tvoj narod što ulazi na ova vrata!"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Ovako kaže Gospod: postupajte pravo i pravedno. Od tlačitelja izbavljajte pokradenog. Došljaka, siroče i udovicu ne zlostavljajte i ne tlačite. Ne prolivajte krv nevinih na ovom mestu!"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Jer ako ovo budete predano radili, tada će na vrata dvora ovog ulaziti carevi koji sede na prestolu Davidovom, na bojnim kolima i na konjima – oni, njihove sluge i njihov narod."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "A ne budete li poslušali ove reči, sobom se zaklinjem – govori Gospod – ovaj će dvor postati pustoš!’“"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Jer ovako kaže Gospod za dvor Judinog cara:",
          {
            "text": "„Meni si ti kao Galad i vrh Livana,",
            "poem": 1
          },
          {
            "text": "ali ću te stvarno pretvoriti u pustinju,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "u gradove raseljene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Zatirača spremam na tebe,",
            "poem": 1
          },
          {
            "text": "sve do jednog naoružanog!",
            "poem": 2
          },
          {
            "text": "Najbolje će tvoje kedrove poseći",
            "poem": 1
          },
          {
            "text": "i u vatru baciti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Mnogi će narodi prolaziti pored ovog grada, pa će se međusobno pitati: ’Zašto je Gospod postupio ovako sa velikim gradom ovim?’"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "I odgovoriće: ’Zato što su napustili savez Gospoda, Boga svoga, pa su se klanjali drugim bogovima i služili su im.’“"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ne oplakujte mrtvog i ne žalite za njim!",
            "poem": 1
          },
          {
            "text": "Nego gorko jecajte za onim što odlazi,",
            "poem": 2
          },
          {
            "text": "da se više ne vrati",
            "poem": 1
          },
          {
            "text": "i ne vidi svoj rodni kraj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ovako kaže Gospod o Salumu",
          {
            "noteId": 10
          },
          ", sinu Judinog cara Josije, postavljenom na mesto svog oca Josije i koji je otišao iz ovog mesta: „On se nikada više neće vratiti."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Tamo gde su ga odveli, u izgnanstvo, tamo će i da umre. Ovu zemlju on nikada više neće videti."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Teško onome što kuću nepravedno kući,",
            "poem": 1
          },
          {
            "text": "i odaje gornje, ali ne po pravdi;",
            "poem": 2
          },
          {
            "text": "kome sunarodnik radi bez naknade",
            "poem": 1
          },
          {
            "text": "i koji ne daje trudbeniku platu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Jer taj kaže: ’Sazidaću sebi kuću poveliku",
            "poem": 1
          },
          {
            "text": "i prostrane gornje sobe.’",
            "poem": 2
          },
          {
            "text": "Otvoriće za sebe prozore,",
            "poem": 1
          },
          {
            "text": "pa kedrom oblaže i crvenim boji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Zar ti vladaš",
            "poem": 1
          },
          {
            "text": "da bi se kedrovinom razmetao?",
            "poem": 2
          },
          {
            "text": "Zar tvoj otac nije i jeo i pio,",
            "poem": 1
          },
          {
            "text": "zar nije pravedno i pravično radio,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pa mu je bilo dobro?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Branio je siromaha i ubogog.",
            "poem": 1
          },
          {
            "text": "I onda je bilo dobro.",
            "poem": 2
          },
          {
            "text": "Ne znači li to poznavati mene?",
            "poem": 1
          },
          {
            "text": "– govori Gospod.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ali tvoje oči i tvoje srce",
            "poem": 1
          },
          {
            "text": "ne teže ničem sem nepoštenom dobitku",
            "poem": 2
          },
          {
            "text": "i prolivanju krvi nevinoga,",
            "poem": 1
          },
          {
            "text": "da bi tlačio i iznuđivao.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Ovako kaže Gospod o Joakimu, sinu Judinog cara Josije:",
          {
            "text": "„Neće za njim zažaliti:",
            "poem": 1
          },
          {
            "text": "’Jao, brate moj! Jao, sestro!’",
            "poem": 2
          },
          {
            "text": "Neće za njim zažaliti:",
            "poem": 1
          },
          {
            "text": "’Jao, gospodaru! Jao njegovo veličanstvo!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Sahraniće ga kao što magarca sahranjuju.",
            "poem": 1
          },
          {
            "text": "Odvući će ga i baciti",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "podalje od vrata Jerusalima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Popni se na Livan i viči!",
            "poem": 1
          },
          {
            "text": "Na Vasanu glasom zaječi",
            "poem": 2
          },
          {
            "text": "i zaviči sa Avarima,",
            "poem": 1
          },
          {
            "text": "jer su satrveni svi tvoji ljubavnici.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "A ja sam ti govorio u tvom blagostanju,",
            "poem": 1
          },
          {
            "text": "a ti si rekao: ’Neću da slušam!’",
            "poem": 2
          },
          {
            "text": "I to ti je bio put još od mladosti tvoje –",
            "poem": 1
          },
          {
            "text": "da ne slušaš moj glas.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Svim tvojim pastirima vetar pastir će da bude,",
            "poem": 1
          },
          {
            "text": "a i tvoji ljubavnici će otići u izgnanstvo.",
            "poem": 2
          },
          {
            "text": "A onda ćeš se baš zastideti i ponižen ćeš biti",
            "poem": 1
          },
          {
            "text": "zbog svih svojih zala.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Ti što sediš na ’Livanu’,",
            "poem": 1
          },
          {
            "text": "ugnežden u kedrovinu:",
            "poem": 2
          },
          {
            "text": "kako ćeš stenjati kad te spopadnu trudovi",
            "poem": 1
          },
          {
            "text": "i bol kao porodilju!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Života mi moga – govori Gospod – sve da Jehonija",
          {
            "noteId": 11
          },
          ", sin Judinog cara Joakima, bude i pečatni prsten na desnoj ruci mojoj, i odande ću te strgnuti."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Predaću te u ruke onima koji ti o glavi rade, u ruke onih od kojih strepiš, u ruke vavilonskog cara Navuhodonosora i u ruke Haldejaca."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Izbaciću i tebe i majku tvoju koja te rodila u drugu zemlju, tamo gde se niste rodili. I tamo ćete umreti."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "A u zemlju u koju im duša žudi da se vrati, vratiti se neće.“"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Je li krčag prezren i polupan ovaj čovek Jehonija?",
            "poem": 1
          },
          {
            "text": "Ili je posuda koju niko neće?",
            "poem": 2
          },
          {
            "text": "Zašto su odbačeni i on i njegovo potomstvo,",
            "poem": 1
          },
          {
            "text": "isterani u zemlju koja im je tuđa?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "O, zemljo! O, zemljo!",
            "poem": 1
          },
          {
            "text": "O, zemljo, čuj reč Gospodnju!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Ovako kaže Gospod:",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Zapiši: ovaj čovek je kao bez poroda",
            "poem": 1
          },
          {
            "text": "i neće napredovati za života svoga.",
            "poem": 2
          },
          {
            "text": "Neće napredovati niko od njegovih potomaka,",
            "poem": 1
          },
          {
            "text": "niko neće sedeti na prestolu Davidovom",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da bi ponovo vladao Judom.",
            "poem": 2
          }
        ]
      }
    ],
