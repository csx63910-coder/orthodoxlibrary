  "chapter": {
    "number": 20,
    "content": [
      {
        "type": "heading",
        "content": [
          "Jeremija i Pashor"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "A Pashor – Imirov sin, sveštenik i glavni nadglednik u Domu Gospodnjem – je čuo kako Jeremija prorokuje sve te reči."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Tada je Pashor udario proroka Jeremiju i bacio ga u okove, u tamnicu kod gornjih Venijaminovih vrata, gde je Dom Gospodnji."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Sutradan je Pashor doveo Jeremiju iz tamnice, a Jeremija mu je rekao: „Neće te više Gospod zvati ’Pashor!’ Ime će ti biti Magor-Misaviv",
          {
            "noteId": 9
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Jer ovako kaže Gospod: ’Evo, od tebe ću užas da napravim i za tebe samog i za sve prijatelje tvoje! Pašće svi oni od mača njihovih neprijatelja, a ti ćeš sve to gledati. I svu ću Judu dati u ruke cara vavilonskog. On će da ih odvede u izgnanstvo, u Vavilon, i pobiće ih mačem."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Daću sve bogatstvo ovog grada, sav njegov trud, sve njegove dragocenosti, sve imanje careva Judinih u ruke njihovih neprijatelja. Oni će to opleniti, pokupiti i odneti u Vavilon."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "A ti ćeš, Pashore, i svi domaći tvoji otići u izgnanstvo, u Vavilon. Tamo ćeš otići i umrećeš tamo. Tamo će da sahrane i tebe i sve tvoje prijatelje kojima si prorokovao laž.’“"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Jeremijina tužbalica"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Zaveo si me, o, Gospode, i ja sam zaveden!",
            "poem": 1
          },
          {
            "text": "Nadjačao si me i nadvladao me.",
            "poem": 2
          },
          {
            "text": "Svako mi se ruga, celodnevna sam im",
            "poem": 1
          },
          {
            "text": "i priča i podsmeh.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Kad god govorim, ja vapim.",
            "poem": 1
          },
          {
            "text": "„Nasilje i pustoš“ vičem!",
            "poem": 2
          },
          {
            "text": "A Gospodnja reč mi je postala ruglo",
            "poem": 1
          },
          {
            "text": "i celodnevni cerek.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "A rekao sam: „Ne spominjem ga više!",
            "poem": 1
          },
          {
            "text": "Više ne govorim u njegovo ime!“",
            "poem": 2
          },
          {
            "text": "Ali u srcu mi je bilo kao vatra,",
            "poem": 1
          },
          {
            "text": "kao plamen stešnjen u kostima.",
            "poem": 2
          },
          {
            "text": "Iznurilo me je i više nisam mogao",
            "poem": 1
          },
          {
            "text": "da se suzdržavam.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Čujem šapat mnogih oko mene",
            "poem": 1
          },
          {
            "text": "i užas je svuda unaokolo:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Odajte ga! Hajde da ga odamo!“",
            "poem": 2
          },
          {
            "text": "Sada svako s kim sam bio u miru",
            "poem": 1
          },
          {
            "text": "vreba na moj pad:",
            "poem": 2
          },
          {
            "text": "„Možda se i da zavesti,",
            "poem": 1
          },
          {
            "text": "pa ćemo ga nadvladati",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i osvetićemo mu se!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "A Gospod je sa mnom kao ratnik svirep.",
            "poem": 1
          },
          {
            "text": "Zato će da posrnu gonitelji moji, ništa mi ne mogu!",
            "poem": 2
          },
          {
            "text": "Posramiće se silno jer neće uspeti,",
            "poem": 1
          },
          {
            "text": "za nezaborav večni biće njihova sramota.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "O, Gospode nad vojskama, koji pravednika ispituješ,",
            "poem": 1
          },
          {
            "text": "koji vidiš i nutrinu i srce;",
            "poem": 2
          },
          {
            "text": "nek nad njima i ja vidim tu osvetu tvoju,",
            "poem": 1
          },
          {
            "text": "jer parnicu svoju ja sam izložio tebi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Pevajte Gospodu!",
            "poem": 1
          },
          {
            "text": "Slavite Gospoda",
            "poem": 2
          },
          {
            "text": "jer iz zlikovačkih ruku",
            "poem": 1
          },
          {
            "text": "dušu ubogog izbavlja!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Proklet da je dan kad sam se rodio!",
            "poem": 1
          },
          {
            "text": "Ne bio blagosloven dan kad me majka rodi!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "A i nek je proklet čovek",
            "poem": 1
          },
          {
            "text": "što mom ocu blagovesti –",
            "poem": 2
          },
          {
            "text": "„Muško je! Sin ti se rodio!“ –",
            "poem": 1
          },
          {
            "text": "i tako ga silno obradovao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Nek taj čovek bude poput gradova",
            "poem": 1
          },
          {
            "text": "što je Gospod satro,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "na koje se smilovao nije.",
            "poem": 2
          },
          {
            "text": "Neka jutrom naricanje sluša,",
            "poem": 1
          },
          {
            "text": "a u podne poklič od ratnika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Što me ne usmrti u materici",
            "poem": 1
          },
          {
            "text": "i zašto mi moja majka grob nije postala!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Što za veke vekova ne osta utroba joj trudna!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Zašto sam izašao iz materice,",
            "poem": 1
          },
          {
            "text": "muku i tugu da gledam,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "moji dani u sramoti da dođu svom kraju.",
            "poem": 2
          }
        ]
      }
    ],
