  "chapter": {
    "number": 8,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Glavno u ovom izlaganju jeste: imamo Prvosveštenika koji je seo s desne strane prestola Božijeg veličanstva na nebesima."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "On je službenik Svetinje i pravog Šatora koji je postavio Gospod, a ne čovek."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "A pošto se svaki Prvosveštenik postavlja da prinosi darove i žrtve, bilo je neophodno da i ovaj Prvosveštenik ima šta da prinese."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Zaista, da je na zemlji, on ne bi ni bio sveštenik, zato što ima sveštenika koji po Zakonu prinose darove."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Oni služe u svetinji koja je tek slika i senka nebeske Svetinje. Jer kada je Šator trebalo podignuti, Mojsije je dobio stroga uputstva. Bog mu je rekao: „Gledaj da sve napraviš prema nacrtu koji ti je pokazan na gori.“"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "A sada je Hristos dobio uzvišeniju službu od njihove, pošto je i savez, čiji je on posrednik, bolji, budući da je utemeljen na boljim obećanjima."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Da je, naime, prvi savez bio besprekoran, ne bi bilo potrebno tražiti drugi."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Jer Bog, koreći svoj narod, kaže:",
          {
            "text": "„Evo dolaze dani – govori Gospod –",
            "poem": 1
          },
          {
            "text": "kada ću sklopiti novi savez",
            "poem": 2
          },
          {
            "text": "s narodom izrailjskim",
            "poem": 1
          },
          {
            "text": "i s narodom Judinim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "To neće biti kao kad sam",
            "poem": 1
          },
          {
            "text": "sklopio savez sa njihovim ocima,",
            "poem": 2
          },
          {
            "text": "onoga dana kad sam ih uzeo za ruku",
            "poem": 1
          },
          {
            "text": "i izveo iz Egipta.",
            "poem": 2
          },
          {
            "text": "Ali pošto nisu bili verni mome savezu,",
            "poem": 1
          },
          {
            "text": "ni ja se nisam obazirao na njih – govori Gospod.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ovo je savez koji ću sklopiti",
            "poem": 1
          },
          {
            "text": "s narodom izrailjskim nakon tih dana, govori Gospod:",
            "poem": 2
          },
          {
            "text": "staviću svoje zakone u njihov razum,",
            "poem": 1
          },
          {
            "text": "i upisaću ih u njihova srca.",
            "poem": 2
          },
          {
            "text": "Ja ću biti njihov Bog,",
            "poem": 1
          },
          {
            "text": "a oni će biti moj narod.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Tada niko neće poučavati svoga sugrađanina",
            "poem": 1
          },
          {
            "text": "ili brata govoreći: ’Upoznaj Gospoda’,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer će me poznavati svi od malog do velikog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Jer smilovaću se nad njihovim nepravdama,",
            "poem": 1
          },
          {
            "text": "i neću se više sećati njihovih greha.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Govoreći o novom savezu, Bog je proglasio prvi savez zastarelim. A ono što zastareva, na putu je da iščezne."
        ]
      }
    ],
    "footnotes": []
  },
