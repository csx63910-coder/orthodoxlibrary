    "name": "Jevrejima",
    "commonName": "Jevrejima",
    "title": "Poslanica Jevrejima",
    "order": 58,
    "numberOfChapters": 13,
    "sha256": "1a71e3b758b711245d516bb018d35b63dd22d9e26292d898e816780614e2a001",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/HEB/1.json",
    "lastChapterNumber": 13,
    "lastChapterApiLink": "/api/srp_onstl/HEB/13.json",
    "totalNumberOfVerses": 303
  },
  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Stoga, sveta braćo, koji ste sudeonici u nebeskom pozivu, obratite pažnju na Isusa, Apostola i Prvosveštenika vere koju ispovedamo."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "On je bio veran Bogu koji ga je postavio u službu, kao što je i Mojsije bio veran Bogu koji ga je postavio nad celim domom svojim."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Ipak, Isus zaslužuje veću čast nego Mojsije, kao što i graditelj zaslužuje veću čast od kuće koju je sagradio."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Naime, svaka kuća ima graditelja, ali Bog je sve sagradio."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Mojsije je bio veran u Božijem domu kao sluga, da bi svedočio o stvarima koje će se tek objaviti."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ali Hristos ima upravu nad domom Božijim u svojstvu Sina. A njegov dom smo mi, ako smelo održimo pouzdanje u nadu kojom se ponosimo."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Zato, kao što Duh Sveti kaže:",
          {
            "text": "„Danas, kad glas njegov čujete,",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "tvrda srca ne budite,",
            "poem": 2
          },
          {
            "text": "kao kad se digla buna,",
            "poem": 1
          },
          {
            "text": "u pustinji u dan kušanja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Oci vaši mene su kušali i izazivali,",
            "poem": 1
          },
          {
            "text": "iako su dela moja gledali četrdeset leta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Tada planuh gnevom na onaj naraštaj",
            "poem": 1
          },
          {
            "text": "i rekoh: ’Vernosti nema u njima nikakve,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "puteve moje oni ne poznaju.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "U gnevu sam se tada zakleo:",
            "poem": 1
          },
          {
            "text": "’Neće oni ući u moj počinak.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Braćo, pazite da kome od vas srce ne postane zlo i neverno, pa da se okrene od živoga Boga."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Zato bodrite jedan drugog svakoga dana, dok god se kaže „danas“, da koga od vas ne zavede greh, te mu otvrdne srce."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Mi smo, naime, sudeonici Hristovi, samo ako do kraja čvrsto održimo ono prvobitno pouzdanje u Boga."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Kao što Pismo kaže:",
          {
            "text": "„Danas, kad glas njegov čujete,",
            "poem": 1
          },
          {
            "text": "tvrda srca ne budite,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kao kad se digla buna.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Ko su ti što su čuli Božiji glas, a ipak se pobunili? Nisu li to svi oni koje je Mojsije izveo iz Egipta?"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "I na koga li se gnevio, ako ne na one koji su sagrešili, čija su tela popadala po pustinji?"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Kome drugom se zakleo da neće ući u počinak, ako ne onima koji su bili nepokorni?"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Tako vidimo da nisu mogli da uđu u počinak zbog svoje nevere."
        ]
      }
    ],
    "footnotes": []
  },
