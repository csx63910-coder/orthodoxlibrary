  },
  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Bog je mnogo puta i na mnogo načina govorio našim precima preko proroka,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ali u ove poslednje dane progovorio nam je preko Sina, koga je odredio za vlasnika svega, čijim posredstvom je i svet stvorio."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "On je odsjaj Božije slave, i verni odraz njegovoga bića, on koji sve održava silom svoje reči. Pa pošto izvrši očišćenje greha, sede u nebu s desne strane Boga veličanstvenoga."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Tako postade toliko moćniji od anđela, koliko mu Bog dade ime uzvišenije od njihovog."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Zar je kome od anđela ikad rekao:",
          {
            "text": "„Ti si Sin moj,",
            "poem": 1
          },
          {
            "text": "danas si se meni rodio“,",
            "poem": 2
          },
          "i ponovo:",
          {
            "text": "„Ja ću mu biti Otac,",
            "poem": 1
          },
          {
            "text": "a on će mi biti Sin“?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "A zatim, kad je slao Prvorođenca na svet, reče:",
          {
            "text": "„Neka mu se poklone svi anđeli Božiji.“",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Za anđele, pak, kaže:",
          {
            "text": "„On svoje anđele čini vetrovima",
            "poem": 1
          },
          {
            "noteId": 0
          },
          {
            "text": ",",
            "poem": 1
          },
          {
            "text": "i svoje sluge ognjenim plamenovima.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "A za Sina kaže:",
          {
            "text": "„Tvoj je presto, Bože, u veke vekova!",
            "poem": 1
          },
          {
            "text": "Žezlo je pravde žezlo tvoga carstva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Voliš pravdu, a mrziš nepravdu.",
            "poem": 1
          },
          {
            "text": "Zato te je Bog, tvoj Bog,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pomazao uljem radosti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "više nego tvoje drugove.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Takođe kaže:",
          {
            "text": "„Ti si, Gospode, u početku utemeljio zemlju,",
            "poem": 1
          },
          {
            "text": "i nebesa su delo tvojih ruku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ona će propasti, ali ti ćeš ostati,",
            "poem": 1
          },
          {
            "text": "i sve će se ishabati kao iznošena odeća.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Složićeš ih kao ogrtač,",
            "poem": 1
          },
          {
            "text": "izmeniće se kao odeća.",
            "poem": 2
          },
          {
            "text": "A ti si uvek isti,",
            "poem": 1
          },
          {
            "text": "veku tvome nigde kraja nema.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "I kome je od anđela ikad rekao:",
          {
            "text": "„Sedi meni s moje desne strane,",
            "poem": 1
          },
          {
            "text": "dok dušmane ne položim tvoje,",
            "poem": 2
          },
          {
            "text": "za tvoje noge postolje da budu“?",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Nisu li svi anđeli – duhovi poslati od Boga da služe onima koji treba da prime u posed spasenje?"
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 0,
        "caller": "+",
        "text": "1,7 Vetrovima ili duhovima.",
        "reference": {
          "chapter": 1,
          "verse": 7
        }
      }
    ]
