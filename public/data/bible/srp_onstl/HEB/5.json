  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Jer svaki Prvosveštenik koji se bira između ljudi, postavlja se da zastupa ljude pred Bogom, da prinosi darove i žrtve za grehe."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "On može da bude obziran prema onima koji su u neznanju i zabludi, zato što je i sam podložan slabostima."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Zbog toga on mora da prinosi žrtve za grehe kako za narod, tako i za sebe."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Tu čast niko ne može da prisvoji za sebe, nego ga Bog poziva u tu službu, kao što je to bio slučaj sa Aronom."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Tako ni Hristos nije sam sebi dao čast da bude Prvosveštenik, već ga je postavio onaj koji mu je rekao:",
          {
            "text": "„Ti si Sin moj,",
            "poem": 1
          },
          {
            "text": "danas si se meni rodio.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Tako i na drugom mestu kaže:",
          {
            "text": "„Ti si doveka sveštenik",
            "poem": 1
          },
          {
            "text": "po redu Melhisedekovom.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "On je za vreme svog zemaljskog života uz glasni vapaj i suze, prineo molitve i prošnje Bogu koji ga je mogao spasti od smrti. I pošto je bio pokoran, Bog ga je uslišio."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Iako je bio Sin, kroz patnje se naučio da bude poslušan."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Pa postigavši savršenstvo, postao je začetnik večnog spasenja svima koji su mu poslušni,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "te ga Bog proglasi Prvosveštenikom po redu Melhisedekovom."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Ukor primaocima poruke"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ima još mnogo teško objašnjivih stvari o kojima treba da govorimo, ali ste postali lenji da slušate."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "I umesto da ste do sada već učitelji, ponovo vas treba poučavati osnovama Božije poruke. Još uvek vam je potrebno mleko, a ne čvrsta hrana!"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Svako, naime, ko se hrani mlekom, ne snalazi se dobro u učenju o pravednosti, jer je dete."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Čvrsta hrana je za one zrele, čija su čula navikom izvežbana da razlikuju zlo i dobro."
        ]
      }
    ],
    "footnotes": []
  },
