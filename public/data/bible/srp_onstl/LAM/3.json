  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "heading",
        "content": [
          "Pesnikov bol"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ja sam čovek koji je upoznao bedu;",
            "poem": 1
          },
          {
            "text": "iskusio sam kako Bog kažnjava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Mene odvede, mene primora;",
            "poem": 1
          },
          {
            "text": "hodam bez svetlosti, a tmina sve gušća.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Lično mene on bije i tuče,",
            "poem": 1
          },
          {
            "text": "njegovi udarci ne prestaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Meso mi se cepa, koža mi puca;",
            "poem": 1
          },
          {
            "text": "on lomi kosti moje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "U ropski me jaram upregao,",
            "poem": 1
          },
          {
            "text": "teškoće je na mene navalio,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "naterao da živim u tmini,",
            "poem": 1
          },
          {
            "text": "mrtvac zatvoren doveka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Zazida me, izlaza mi nema;",
            "poem": 1
          },
          {
            "text": "ja sam sužanj s teškim okovima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Vičem, vapim da mi on pomogne,",
            "poem": 1
          },
          {
            "text": "ali on mi molitvu odbija.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Tesanim kamenom me je zazidao,",
            "poem": 1
          },
          {
            "text": "na sve strane zakrčio drumove, puteve.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Kao medved na me vreba,",
            "poem": 1
          },
          {
            "text": "kao lav se na me baca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Po bespuću goni me i komada,",
            "poem": 1
          },
          {
            "text": "ostavlja me da bih tamo umro.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Zapinje luk svoj i gađa,",
            "poem": 1
          },
          {
            "text": "kao da sam ja meta njegovih strela.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "U nutrinu strele mi je sasuo,",
            "poem": 1
          },
          {
            "text": "u moje telo duboko ih zario.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Narod mi se vazda podsmeva,",
            "poem": 1
          },
          {
            "text": "za porugu služim svima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "On gorčinom mene hrani,",
            "poem": 1
          },
          {
            "text": "pelenom me on napaja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Tera me da grizem kamen i zube moje lomi;",
            "poem": 1
          },
          {
            "text": "u pepeo mene zakopava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Zaboravih šta je mir i zdravlje,",
            "poem": 1
          },
          {
            "text": "više ne znam šta je život dobri.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Nema meni još mnogo življenja,",
            "poem": 1
          },
          {
            "text": "iščezla je moja nada u Gospoda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Hoće li Bog pomoći?"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Mislim na svoje muke i potucanja,",
            "poem": 1
          },
          {
            "text": "to mi je slično pelenu, slično otrovu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Mislim na to bez prestanka,",
            "poem": 1
          },
          {
            "text": "duša moja sahne u meni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Nevolju nosim u srcu svome,",
            "poem": 1
          },
          {
            "text": "ali gajim nadu u mislima:",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Nije nas nestalo jer nije prestala ljubav Gospodnja,",
            "poem": 1
          },
          {
            "text": "jer nije presušilo milosrđe njegovo,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "oni se obnavljaju svakog jutra,",
            "poem": 1
          },
          {
            "text": "vernost mu je zajamčena kao izlazak sunca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Kad Gospoda imam, ništa mi ne treba,",
            "poem": 1
          },
          {
            "text": "i zato se uzdam u njega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Bog – jedino uzdanje"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Gospod je dobar prema čoveku",
            "poem": 1
          },
          {
            "text": "koji se u Boga uzda, koji ga traži.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Dobro je čekati ga smireno,",
            "poem": 1
          },
          {
            "text": "očekivati spasenje od Gospoda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Najbolje je u mladosti",
            "poem": 1
          },
          {
            "text": "svome se jarmu naučiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Patniče, sedi usamljen i ćuti,",
            "poem": 1
          },
          {
            "text": "Bog je to nametnuo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Poklonimo se do tla prašnjavoga,",
            "poem": 1
          },
          {
            "text": "možda još ima nade.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Ako nas tuče, neka tuče;",
            "poem": 1
          },
          {
            "text": "ako nam se ruga, neka se ruga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Gospod ipak ima milosrđa,",
            "poem": 1
          },
          {
            "text": "za večnost nas neće odbaciti;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "smilovaće se iako nas je rastužio,",
            "poem": 1
          },
          {
            "text": "njegova je milost postojana;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "njemu nije milo da nas ponižava",
            "poem": 1
          },
          {
            "text": "i da na ljude navaljuje tugu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Kada sužnje gaze mučitelji,",
            "poem": 1
          },
          {
            "text": "kada duh im lome u tamnici,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "kada ljude lišavaju prava,",
            "poem": 1
          },
          {
            "text": "kada se ukida što je Svevišnji ustanovio,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "kada se pravda izvrće na sudu,",
            "poem": 1
          },
          {
            "text": "zar Gospod sve to ne vidi?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Čovek kaže pa se i ne zbude,",
            "poem": 1
          },
          {
            "text": "ali Gospod zapoveda i to biti mora.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "Kada Svevišnji odredi",
            "poem": 1
          },
          {
            "text": "onda i nesreća i dobro dolazi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          {
            "text": "Zašto se buni čovek?",
            "poem": 1
          },
          {
            "text": "Svako dobija prema grehu svome.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Priznanje pred Bogom"
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          {
            "text": "Ispitajmo, razmotrimo puteve svoje,",
            "poem": 1
          },
          {
            "text": "vratimo se Gospodu svome.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          {
            "text": "Otvorimo svoja srca,",
            "poem": 1
          },
          {
            "text": "molimo se Bogu nebeskome.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          {
            "text": "Mi smo otpadnici, mi smo nepokorni,",
            "poem": 1
          },
          {
            "text": "a ti nam praštao nisi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          {
            "text": "Gnevom si se zaogrnuo,",
            "poem": 1
          },
          {
            "text": "gonio nas, ubijao, nisi štedeo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          {
            "text": "Oblakom si se zaogrnuo,",
            "poem": 1
          },
          {
            "text": "naša molitva nije prodrla do tebe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          {
            "text": "Smetlište si od nas načinio,",
            "poem": 1
          },
          {
            "text": "svi narodi su nas prezreli.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          {
            "text": "Na nas su se iskezili",
            "poem": 1
          },
          {
            "text": "svi naši dušmani.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          {
            "text": "Prošli smo kroz propast i ruševine,",
            "poem": 1
          },
          {
            "text": "živimo u strahu i zatiranju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          {
            "text": "Potoci suza iz mojih očiju teku",
            "poem": 1
          },
          {
            "text": "zbog razaranja moga naroda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Paćenička žalost"
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          {
            "text": "Suze moje teku bez prestanka,",
            "poem": 1
          },
          {
            "text": "iz očiju liju i stati neće,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          {
            "text": "dok nas ne pogleda",
            "poem": 1
          },
          {
            "text": "i ne vidi Gospod sa nebesa.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 51,
        "content": [
          {
            "text": "Žalost me razdire kad gledam očima",
            "poem": 1
          },
          {
            "text": "šta se događa u gradu ženama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 52,
        "content": [
          {
            "text": "Kao pticu progone me stalno,",
            "poem": 1
          },
          {
            "text": "a nemaju zašto da me mrze.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 53,
        "content": [
          {
            "text": "Živoga me u jamu baciše",
            "poem": 1
          },
          {
            "text": "i kamenjem zatrpaše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 54,
        "content": [
          {
            "text": "Voda mi se sklopi iznad glave,",
            "poem": 1
          },
          {
            "text": "te pomislih: „Sa mnom je svršeno.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Bog izbavlja i plaća"
        ]
      },
      {
        "type": "verse",
        "number": 55,
        "content": [
          {
            "text": "Iz dubine, iz jame, o, Gospode,",
            "poem": 1
          },
          {
            "text": "prizvah ime tvoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 56,
        "content": [
          {
            "text": "Glas moj ti si čuo,",
            "poem": 1
          },
          {
            "text": "poslušaj vapaje moje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 57,
        "content": [
          {
            "text": "Kad zavapih, ti se nađe blizu.",
            "poem": 1
          },
          {
            "text": "Ti mi reče: „Nemoj se bojati!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 58,
        "content": [
          {
            "text": "Ti si mi, Gospode, izvojevao pravdu,",
            "poem": 1
          },
          {
            "text": "ti si mi život otkupio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 59,
        "content": [
          {
            "text": "Ti, Gospode, vidiš, nasilje mi čine.",
            "poem": 1
          },
          {
            "text": "Ti mi pravdu na sudu dosudi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 60,
        "content": [
          {
            "text": "Ti znaš kako mi se svete neprijatelji,",
            "poem": 1
          },
          {
            "text": "kakve spletke protiv mene pletu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 61,
        "content": [
          {
            "text": "Ti, Gospode, čuješ kako me ismevaju,",
            "poem": 1
          },
          {
            "text": "kakve spletke protiv mene pletu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 62,
        "content": [
          {
            "text": "Kad govore i kad misle protivnici,",
            "poem": 1
          },
          {
            "text": "povazdan su protiv mene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 63,
        "content": [
          {
            "text": "Kad sedaju i kad ustaju,",
            "poem": 1
          },
          {
            "text": "ti ih vidiš, meni se rugaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 64,
        "content": [
          {
            "text": "Ti, Gospode, kazni kako dolikuje,",
            "poem": 1
          },
          {
            "text": "prema onome što su učinili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 65,
        "content": [
          {
            "text": "Ti prokuni srca njihova,",
            "poem": 1
          },
          {
            "text": "ti ih ispuni očajnim mukama.",
