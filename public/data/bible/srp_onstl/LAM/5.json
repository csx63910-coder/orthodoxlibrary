  },
  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "heading",
        "content": [
          "Narod plače pred Bogom"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Opomeni se, Gospode, šta nam se dogodilo;",
            "poem": 1
          },
          {
            "text": "pogledaj, vidi našu sramotu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "U tuđinske ruke pala je baština naša,",
            "poem": 1
          },
          {
            "text": "stranci se šire po našim domovima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Očeva naših nema, siročad smo postali,",
            "poem": 1
          },
          {
            "text": "majke su naše sada udovice.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Vodu za piće novcem plaćamo,",
            "poem": 1
          },
          {
            "text": "drva za gorivo takođe kupujemo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Gone nas kao tegleće živinče;",
            "poem": 1
          },
          {
            "text": "iscepani smo, a ne daju nam odmora.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Idemo, prosjačimo po Egiptu i Asiriji",
            "poem": 1
          },
          {
            "text": "da bismo imali hleba da preživimo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Naši preci zgrešiše, ali njih nema,",
            "poem": 1
          },
          {
            "text": "pa mi ispaštamo za krivice njihove.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Nad nama vladaju prostaci robovi",
            "poem": 1
          },
          {
            "text": "i od njihove sile niko da nas izbavi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ubice haraju po zemlji,",
            "poem": 1
          },
          {
            "text": "stavljamo život na kocku idući po hranu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Od gladi gorimo kao u groznici,",
            "poem": 1
          },
          {
            "text": "i koža je naša kao peć užarena.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Na svetinji, na Sionu, siluju žene,",
            "poem": 1
          },
          {
            "text": "po Judinim naseljima devojke.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Naše glavare rukama svojim hvataju i vešaju,",
            "poem": 1
          },
          {
            "text": "ni starce naše neće da poštuju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Mladići kao robovi okreću žrvnjeve,",
            "poem": 1
          },
          {
            "text": "dečaci padaju pod bremenima drva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Starci više ne sede pred vratima,",
            "poem": 1
          },
          {
            "text": "mladih ljudi svirka više se ne čuje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Iščezla je radost iz naših života:",
            "poem": 1
          },
          {
            "text": "umesto da igramo, mi smo ojađeni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Sa glave je naše kruna pala.",
            "poem": 1
          },
          "Narod priznaje grehe",
          {
            "text": "Zgrešili smo, sada teško nama.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Eto zato srce naše boluje!",
            "poem": 1
          },
          {
            "text": "Eto, zato se oči naše zamutiše!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Zato je sionska gora opustošena.",
            "poem": 1
          },
          {
            "text": "Zato se šakali šunjaju po toj pustoši.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Molitva za izbavljenje"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ti, Gospode, ostaješ doveka,",
            "poem": 1
          },
          {
            "text": "tvoj je presto od kolena do kolena.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Nemoj nas zanavek zaboraviti,",
            "poem": 1
          },
          {
            "text": "nemoj nas za dugo vreme ostaviti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Vrati nas k sebi! Obrati nas, Gospode!",
            "poem": 1
          },
          {
            "text": "Obnovi slavu našu iz negdašnjih dana.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Zar da nas odbaciš potpuno?",
            "poem": 1
          },
          {
            "text": "Da se na nas srdiš beskrajno?",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
