  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "heading",
        "content": [
          "Jad i beda posle pada"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Kako potamne zlato,",
            "poem": 1
          },
          {
            "text": "naše žeženo zlato!",
            "poem": 2
          },
          {
            "text": "Leži kamenje hramovno",
            "poem": 1
          },
          {
            "text": "po ulicama razbacano.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Sionski mladići, nekad skupoceni",
            "poem": 1
          },
          {
            "text": "kao zlato najčistije,",
            "poem": 2
          },
          {
            "text": "sada su – ah! – kao obična grnčarija,",
            "poem": 1
          },
          {
            "text": "kao proizvod lončarski.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "I vučica hoće da doji,",
            "poem": 1
          },
          {
            "text": "da vučiće svoje neguje,",
            "poem": 2
          },
          {
            "text": "a žene u narodu mome",
            "poem": 1
          },
          {
            "text": "okrutne su kao noj u pustinji:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "odojčad ostaviše žednu,",
            "poem": 1
          },
          {
            "text": "jezik im se za nepce lepi;",
            "poem": 2
          },
          {
            "text": "decu pustiše da pište,",
            "poem": 1
          },
          {
            "text": "nikoga nema da im hranu pruži.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Nekad sami sladiše jela odabrana,",
            "poem": 1
          },
          {
            "text": "sada skapavaju po ulicama.",
            "poem": 2
          },
          {
            "text": "Nekad su u raskoši odrastali,",
            "poem": 1
          },
          {
            "text": "sada po smetlištu prebiru.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Primio je kaznu narod moj",
            "poem": 1
          },
          {
            "text": "težu nego stanovnici sodomski,",
            "poem": 2
          },
          {
            "text": "jer njih razori za tren oka",
            "poem": 1
          },
          {
            "text": "i pritom na njih ne podiže ljude.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Nekad su bili naši junaci",
            "poem": 1
          },
          {
            "text": "čistiji od snega, belji od mleka;",
            "poem": 2
          },
          {
            "text": "bili su rumeni i glatki,",
            "poem": 1
          },
          {
            "text": "kao od brega odvaljeni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Sad su im lica crnja od čađi,",
            "poem": 1
          },
          {
            "text": "po ulicama ih ne poznaje niko;",
            "poem": 2
          },
          {
            "text": "koža im se smežurala oko očiju,",
            "poem": 1
          },
          {
            "text": "sasušila se kao drvo suvo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Sretniji su koji u ratu pogiboše,",
            "poem": 1
          },
          {
            "text": "teže je onima koje glad pomori:",
            "poem": 2
          },
          {
            "text": "iscrpeni, skapavali su lagano,",
            "poem": 1
          },
          {
            "text": "nije bilo plodova sa polja da ostanu u životu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Žene tako nežne behu,",
            "poem": 1
          },
          {
            "text": "pa kuvaju decu svoju",
            "poem": 2
          },
          {
            "text": "da nahrane sebe njima –",
            "poem": 1
          },
          {
            "text": "o, užasno je naroda moga stradanje!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Silinom je provalio gnev Gospodnji,",
            "poem": 1
          },
          {
            "text": "on izli svoju srdžbu jarosnu,",
            "poem": 2
          },
          {
            "text": "zapali požar na sionskom gradu,",
            "poem": 1
          },
          {
            "text": "te mu spali i temelje same.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Krivica sveštenika i proroka"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Nisu verovali ni strani vladari,",
            "poem": 1
          },
          {
            "text": "ni svi stanovnici zemlje,",
            "poem": 2
          },
          {
            "text": "da će moći osvajač i dušman",
            "poem": 1
          },
          {
            "text": "kroz kapije jerusalimske da uđu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ipak to se dogodilo",
            "poem": 1
          },
          {
            "text": "zbog greha proročkih,",
            "poem": 2
          },
          {
            "text": "zbog krivica svešteničkih,",
            "poem": 1
          },
          {
            "text": "zbog nevine krvi",
            "poem": 2
          },
          {
            "noteId": 0
          },
          {
            "text": "usred grada prolivene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Tumaraju po ulicama kao slepi,",
            "poem": 1
          },
          {
            "text": "krvlju su umrljani,",
            "poem": 2
          },
          {
            "text": "niko se ne usuđuje da ih dotakne,",
            "poem": 1
          },
          {
            "text": "oskrnavljena je odeća njihova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Narod viče: „Odlazite!",
            "poem": 1
          },
          {
            "text": "Oskrnavljeni, natrag! Ne dotičite!“",
            "poem": 2
          },
          {
            "text": "Tako lutahu od naroda do naroda,",
            "poem": 1
          },
          {
            "text": "a među narodima su govorili:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Ovde više ne mogu da borave.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Rasprši ih Gospod da ih ne gleda,",
            "poem": 1
          },
          {
            "text": "da o njima više ne brine.",
            "poem": 2
          },
          {
            "text": "Na sveštenike više ne pazi,",
            "poem": 1
          },
          {
            "text": "starešine više ne žali.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Malaksalost potlačenih"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "A nama su se oči umorile,",
            "poem": 1
          },
          {
            "text": "iščekujemo pomoć, a nje nema.",
            "poem": 2
          },
          {
            "text": "S kula naših zurimo do na kraj obzorja,",
            "poem": 1
          },
          {
            "text": "čekamo narod koji nas ne može izbaviti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Neprijatelj nam je svaki korak vrebao,",
            "poem": 1
          },
          {
            "text": "po trgovima svojim ne mogosmo prolaziti,",
            "poem": 2
          },
          {
            "text": "ali dani naši prolažahu,",
            "poem": 1
          },
          {
            "text": "kraj nam se približi, stiže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Brže od grabljivica koje s neba sleću,",
            "poem": 1
          },
          {
            "text": "gonitelji naši stigoše,",
            "poem": 2
          },
          {
            "text": "hvatali su nas po brdima,",
            "poem": 1
          },
          {
            "text": "u pustinji u zasedi čekali.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Zarobiše naše životno uzdanje,",
            "poem": 1
          },
          {
            "text": "Gospodnjeg pomazanika, cara,",
            "poem": 2
          },
          {
            "text": "a mi smo se uzdali:",
            "poem": 1
          },
          {
            "text": "car će nas od svakog osvajača sačuvati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Ipak – ima Boga"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Raduješ se i veseliš, o, ćerko edomska,",
            "poem": 1
          },
          {
            "text": "i ti, narode iz zemlje Uz.",
            "poem": 2
          },
          {
            "text": "Čas propasti i vama dolazi,",
            "poem": 1
          },
          {
            "text": "i vi ćete se teturati goli,",
            "poem": 2
          },
          {
            "text": "otkriće se i vaša sramota.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Za svoju krivicu si, ćerko sionska, ispaštala,",
            "poem": 1
          },
          {
            "text": "više te neće u izgnanstvo terati.",
            "poem": 2
          },
          {
            "text": "Ćerko edomska, tebe će Gospod kazniti,",
            "poem": 1
          },
          {
            "text": "tvoje će krivice razotkriti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
