  },
  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "heading",
        "content": [
          "Gnev Božiji je velik"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Kada se Gospod razgnevio,",
            "poem": 1
          },
          {
            "text": "ćerku je sionsku u tamu zavio.",
            "poem": 2
          },
          {
            "text": "Sjajni grad svetlosti nebeske,",
            "poem": 1
          },
          {
            "text": "u ruševine pretvori zemaljske.",
            "poem": 2
          },
          {
            "text": "Slavni Dom, diku Izrailjevu,",
            "poem": 1
          },
          {
            "text": "on napusti u dan gneva svoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Gospod je satro bez milosti,",
            "poem": 1
          },
          {
            "text": "sva sela u Jakovljevoj zemlji.",
            "poem": 2
          },
          {
            "text": "Kad se razgnevio, on je razorio",
            "poem": 1
          },
          {
            "text": "sve tvrđave što drže Judejci;",
            "poem": 2
          },
          {
            "text": "sa zemljom je sravnio i prokleo",
            "poem": 1
          },
          {
            "text": "carstvo i njegove glavare.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "U raspaljenoj svojoj jarosti,",
            "poem": 1
          },
          {
            "text": "svu moć izrailjsku on je skrhao.",
            "poem": 2
          },
          {
            "text": "Kad je neprijatelj nasrnuo,",
            "poem": 1
          },
          {
            "text": "desnicu svoju Bog nam je uskratio.",
            "poem": 2
          },
          {
            "text": "Kao oganj planuo je u Jakovu,",
            "poem": 1
          },
          {
            "text": "oko sebe sve je popalio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Kao neprijatelj luk je svoj zategao,",
            "poem": 1
          },
          {
            "text": "kao dušman je navalio,",
            "poem": 2
          },
          {
            "text": "ubijao sve što nam je oku drago,",
            "poem": 1
          },
          {
            "text": "sve čemu se radovasmo.",
            "poem": 2
          },
          {
            "text": "Na šatore ćerke sionske",
            "poem": 1
          },
          {
            "text": "sasu svoju srdžbu raspaljenu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Gospod je kao neprijatelj postao:",
            "poem": 1
          },
          {
            "text": "Izrailjev narod razorio,",
            "poem": 2
          },
          {
            "text": "sve njegove dvore porušio,",
            "poem": 1
          },
          {
            "text": "sve tvrđave njemu razorio;",
            "poem": 2
          },
          {
            "text": "Judinom narodu umnožio je jade,",
            "poem": 1
          },
          {
            "text": "nagomilao jecanje i uzdisaje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Odbačeni, ukinuti, razoreni…"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Senicu je rasturio u komade,",
            "poem": 1
          },
          {
            "text": "razorio mesto za službe Božije.",
            "poem": 2
          },
          {
            "text": "Na Sionu Gospod u zaborav baci",
            "poem": 1
          },
          {
            "text": "i praznik i subotu;",
            "poem": 2
          },
          {
            "text": "razgnevio se i prezreo",
            "poem": 1
          },
          {
            "text": "i cara i sveštenika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Gospod je svoj žrtvenik odbacio,",
            "poem": 1
          },
          {
            "text": "Svetilište svoje je oskrnavio;",
            "poem": 2
          },
          {
            "text": "predao u ruke dušmanske",
            "poem": 1
          },
          {
            "text": "da ruše bedeme i dvore,",
            "poem": 2
          },
          {
            "text": "da urlaju po Gospodnjem Domu,",
            "poem": 1
          },
          {
            "text": "gde mi nekad praznovasmo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Gospod je odlučio da ruši,",
            "poem": 1
          },
          {
            "text": "da popadaju zidovi ćerke sionske;",
            "poem": 2
          },
          {
            "text": "odredio je meru rušenja",
            "poem": 1
          },
          {
            "text": "i nije se ustezala ruka njegova.",
            "poem": 2
          },
          {
            "text": "Spoljni zidovi, drugi red zidova,",
            "poem": 1
          },
          {
            "text": "oronuli tužno leže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Vratnice su spaljene i polomljene,",
            "poem": 1
          },
          {
            "text": "on im je zdrobio reze i grede.",
            "poem": 2
          },
          {
            "text": "Car i knezovi su u progonstvu,",
            "poem": 1
          },
          {
            "text": "nema nikog da nas uči Zakonu,",
            "poem": 2
          },
          {
            "text": "niti se javljaju viđenja,",
            "poem": 1
          },
          {
            "text": "dar Gospodnji prorocima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Starešine ćerke sionske",
            "poem": 1
          },
          {
            "text": "po zemlji su posedali i ćute,",
            "poem": 2
          },
          {
            "text": "glave svoje prašinom posipaju,",
            "poem": 1
          },
          {
            "text": "obavili kostret oko tela.",
            "poem": 2
          },
          {
            "text": "Sve do zemlje spustile su glave",
            "poem": 1
          },
          {
            "text": "jerusalimske devojke mlade.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Od plakanja iščileše mi oči,",
            "poem": 1
          },
          {
            "text": "u ropcu mi duša grca,",
            "poem": 2
          },
          {
            "text": "žalost me je iscrpla potpuno,",
            "poem": 1
          },
          {
            "text": "jer posmatram slom naroda moga:",
            "poem": 2
          },
          {
            "text": "deca i odojčad umiru",
            "poem": 1
          },
          {
            "text": "po trgovima grada srušenoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Govorahu svojim materama:",
            "poem": 1
          },
          {
            "text": "„Gde je žito? Gde je piće?“",
            "poem": 2
          },
          {
            "text": "i slično ranjenicima obamiru",
            "poem": 1
          },
          {
            "text": "po trgovima grada srušenoga",
            "poem": 2
          },
          {
            "text": "i duše svoje ispuštaju",
            "poem": 1
          },
          {
            "text": "na grudima svojih majki.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Stvarnost je surova"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "O, Jerusalime, o, mili grade,",
            "poem": 1
          },
          {
            "text": "kome si sličan, nalik si na koga?",
            "poem": 2
          },
          {
            "text": "Kako da te utešim, o, device, ćerko sionska?",
            "poem": 1
          },
          {
            "text": "Da li je ovako postradao iko?",
            "poem": 2
          },
          {
            "text": "Nesreća je tvoja bezgranična, kao more.",
            "poem": 1
          },
          {
            "text": "Da te isceli neko?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Tvoji proroci nemaju proroštva",
            "poem": 1
          },
          {
            "text": "osim obmana i laži.",
            "poem": 2
          },
          {
            "text": "Na krivicu tvoju ne ukazuju,",
            "poem": 1
          },
          {
            "text": "zavaravaju te,",
            "poem": 2
          },
          {
            "text": "od izgnanstva odvraćaju.",
            "poem": 1
          },
          {
            "text": "Lažnim te proroštvima ubeđuju,",
            "poem": 2
          },
          {
            "text": "te izbegavaš pokajanje.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ruga ti se, pljeska rukama",
            "poem": 1
          },
          {
            "text": "narod koji prolazi kraj grada.",
            "poem": 2
          },
          {
            "text": "Zvižde i glavom odmahuju",
            "poem": 1
          },
          {
            "text": "nad ruševinama jerusalimskim:",
            "poem": 2
          },
          {
            "text": "„Je li to ta varoš savršeno lepa?",
            "poem": 1
          },
          {
            "text": "Je li to radost cele zemlje?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Smeju ti se, nad tobom se cerekaju",
            "poem": 1
          },
          {
            "text": "svi neprijatelji tvoji.",
            "poem": 2
          },
          {
            "text": "Krive usne, keze zube,",
            "poem": 1
          },
          {
            "text": "pa govore: „Mi smo ga slistili!",
            "poem": 2
          },
          {
            "text": "Ovo je ono što smo čekali!",
            "poem": 1
          },
          {
            "text": "Dočekasmo. Oči naše videše!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Gospod je izvršio svoju nameru,",
            "poem": 1
          },
          {
            "text": "održao je reč svoju.",
            "poem": 2
          },
          {
            "text": "Od davnina nas je on opominjao,",
            "poem": 1
          },
          {
            "text": "sad nas bez milosti razorio.",
            "poem": 2
          },
          {
            "text": "Neprijatelj pobednički likuje,",
            "poem": 1
          },
          {
            "text": "protivnik se našem porazu veseli.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Vapaj i molitva – to ostaje pred Bogom"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "I zidovi tvoji neka vape,",
            "poem": 1
          },
          {
            "text": "jecaj, ćerko sionska, prizivaj Gospoda!",
            "poem": 2
          },
          {
            "text": "Neka teku suze tvoje",
            "poem": 1
          },
          {
            "text": "kao potoci i danju i noću.",
            "poem": 2
          },
          {
            "text": "Ne daj sebi odmora, nariči!",
            "poem": 1
          },
          {
            "text": "Ne daj mira zenicama, plači!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Tokom noći diži se i viči,",
            "poem": 1
          },
          {
            "text": "prizivaj ga svakog časa,",
            "poem": 2
          },
          {
            "text": "izlivaj srce kao vodu pred licem Gospoda,",
            "poem": 1
          },
          {
            "text": "da se smiluje nejači tvojoj,",
            "poem": 2
          },
          {
            "text": "deci što od gladi skapavaju",
            "poem": 1
          },
          {
            "text": "po uglovima svih ulica.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Pogledaj, pogledaj, o, Gospode!",
            "poem": 1
          },
          {
            "text": "Koga si to na muke bacio?",
            "poem": 2
          },
          {
            "text": "Zar žene da porod svoj jedu?",
            "poem": 1
          },
          {
            "text": "Zar one što u naručju njišu?",
            "poem": 2
          },
          {
            "text": "Zar u samom Svetilištu kolju",
            "poem": 1
          },
          {
            "text": "sveštenike tvoje i proroke tvoje?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Po ulici leže u prašini,",
            "poem": 1
          },
          {
            "text": "mrtva leže deca sa starcima;",
            "poem": 2
          },
          {
            "text": "devojke moje i mladići",
            "poem": 1
          },
          {
            "text": "leže mačem pobijeni.",
            "poem": 2
          },
          {
            "text": "Ti ih pobi u dan gneva svoga,",
            "poem": 1
          },
          {
            "text": "ti ih pokla bez milosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Kao da je dan praznika, sa svih strana",
            "poem": 1
          },
          {
            "text": "sabrao si sve užase na me.",
            "poem": 2
          },
          {
            "text": "U dan gneva tvoga",
            "poem": 1
          },
          {
            "text": "niko nije preživeo, niko utekao.",
            "poem": 2
          },
          {
            "text": "Decu moju odnjihanu i odraslu",
            "poem": 1
          },
          {
            "text": "pobio je dušmanin kleti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
