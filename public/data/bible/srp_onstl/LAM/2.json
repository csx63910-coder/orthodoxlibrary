  "book": {
    "id": "LAM",
    "translationId": "srp_onstl",
    "name": "Plač Jeremijin",
    "commonName": "Plač Jeremijin",
    "title": "Plač Jeremijin",
    "order": 25,
    "numberOfChapters": 5,
    "sha256": "71b55ff28044b09e143940bb8b7de348abeddf2cac6bdf970efde0536f1f8aef",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/LAM/1.json",
