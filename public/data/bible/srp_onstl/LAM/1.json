  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "heading",
        "content": [
          "Nesrećni grad"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Kako sedi prestonica usamljena!",
            "poem": 1
          },
          {
            "text": "A nekad je puna ljudi bila.",
            "poem": 2
          },
          {
            "text": "Grad postade kao udovica,",
            "poem": 1
          },
          {
            "text": "a nekad je svet ga poštovao.",
            "poem": 2
          },
          {
            "text": "Ta carica među gradovima",
            "poem": 1
          },
          {
            "text": "robinja je sada potlačena.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Groznim plačem svu noć plače,",
            "poem": 1
          },
          {
            "text": "niz obraze suze roni.",
            "poem": 2
          },
          {
            "text": "Nikog nema da je teši sada,",
            "poem": 1
          },
          {
            "text": "a nekada svi joj prijatelji behu.",
            "poem": 2
          },
          {
            "text": "Saveznici svi je izdadoše,",
            "poem": 1
          },
          {
            "text": "postali su njeni neprijatelji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Narod Judin, roblje bespomoćno,",
            "poem": 1
          },
          {
            "text": "u nevolji, u teškom progonstvu,",
            "poem": 2
          },
          {
            "text": "po tuđinskim sad žive zemljama.",
            "poem": 1
          },
          {
            "text": "Nema mesta gde bi da počinu.",
            "poem": 2
          },
          {
            "text": "Odasvud ih okružuju gonitelji,",
            "poem": 1
          },
          {
            "text": "iz tesnaca nikud da pobegnu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Tužni su putevi ka sionskom Domu,",
            "poem": 1
          },
          {
            "text": "na praznike ne dolazi niko.",
            "poem": 2
          },
          {
            "text": "Sva su vrata razvaljena,",
            "poem": 1
          },
          {
            "text": "sveštenici uzdišu jednako,",
            "poem": 2
          },
          {
            "text": "uplakane su devojke koje su nekad pevale.",
            "poem": 1
          },
          {
            "text": "Sion je u gorkom ropcu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Nad njim sada gospodare tlačitelji,",
            "poem": 1
          },
          {
            "text": "zbog pobede likuju neprijatelji.",
            "poem": 2
          },
          {
            "text": "Mnogobrojni su gresi sionski,",
            "poem": 1
          },
          {
            "text": "zato ga je Gospod izložio patnjama.",
            "poem": 2
          },
          {
            "text": "Nasilnici zarobiše decu sa Siona",
            "poem": 1
          },
          {
            "text": "i odvedoše ih u izgnanstvo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Povukla se od ćerke sionske,",
            "poem": 1
          },
          {
            "text": "povukla se sva slava njegova.",
            "poem": 2
          },
          {
            "text": "Knezovi mu postadoše kao srne",
            "poem": 1
          },
          {
            "text": "iscrpene od gladi,",
            "poem": 2
          },
          {
            "text": "u bežanju izgubiše snagu",
            "poem": 1
          },
          {
            "text": "ispred lovaca koji ih gone.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Jerusalim, ruševina usamljena,",
            "poem": 1
          },
          {
            "text": "svog se sjaja opominje,",
            "poem": 2
          },
          {
            "text": "a kad pade neprijateljima u ruke,",
            "poem": 1
          },
          {
            "text": "nikog nema da mu pomoć pruži.",
            "poem": 2
          },
          {
            "text": "Gledaju ga tlačitelji,",
            "poem": 1
          },
          {
            "text": "smeju mu se zato što je pao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Teški gresi i stradanja teška"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Teški li su ovog grada gresi!",
            "poem": 1
          },
          {
            "text": "Gadan li je, nečist li je!",
            "poem": 2
          },
          {
            "text": "Ceniše ga, a sad ga preziru:",
            "poem": 1
          },
          {
            "text": "Grad bez časti, go je u sramoti.",
            "poem": 2
          },
          {
            "text": "Samo ječi, lice krije,",
            "poem": 1
          },
          {
            "text": "osvrće se, iza sebe gleda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Vidi mu se da je nečist jako,",
            "poem": 1
          },
          {
            "text": "ali on ne mari što ga ovo snađe.",
            "poem": 2
          },
          {
            "text": "Užasno je kako on propada,",
            "poem": 1
          },
          {
            "text": "a nikoga nema da ga teši.",
            "poem": 2
          },
          {
            "text": "Pogledaj, Gospode, njegovu nevolju,",
            "poem": 1
          },
          {
            "text": "jer neprijatelji likuju li, likuju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Neprijatelj grabi, pljačka,",
            "poem": 1
          },
          {
            "text": "sve riznice ovog grada.",
            "poem": 2
          },
          {
            "text": "Jerusalim gleda kako stranci",
            "poem": 1
          },
          {
            "text": "provaljuju Domu u Svetilište,",
            "poem": 2
          },
          {
            "text": "a njima si, Gospode, zabranio",
            "poem": 1
          },
          {
            "text": "da stupaju gde ti zbor stupa.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Cvili narod, kako da ne tuguje!",
            "poem": 1
          },
          {
            "text": "Traže hleba, trampe dragocenosti svoje za hranu,",
            "poem": 2
          },
          {
            "text": "ne bi li živnuli nekako.",
            "poem": 1
          },
          {
            "text": "„Smiluj mi se – plaču – o, Gospode!",
            "poem": 2
          },
          {
            "text": "Smiluj mi se,",
            "poem": 1
          },
          {
            "text": "jer padoh u bedu.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Jerusalim u tuzi"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Pogledajte me, svi što prolazite",
            "poem": 1
          },
          {
            "text": "– grad dovikuje tužno –",
            "poem": 2
          },
          {
            "text": "Ima li bola sličnog ovom bolu",
            "poem": 1
          },
          {
            "text": "što pogodi mene?",
            "poem": 2
          },
          {
            "text": "Kako me je Gospod udario",
            "poem": 1
          },
          {
            "text": "u dan kad se na me razgnevio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Poslao je oganj sa visine,",
            "poem": 1
          },
          {
            "text": "razgore ga po mojim kostima.",
            "poem": 2
          },
          {
            "text": "Razapeo mrežu ispred mojih nogu",
            "poem": 1
          },
          {
            "text": "i na zemlju oborio.",
            "poem": 2
          },
          {
            "text": "Ucvilio me je i ožalostio",
            "poem": 1
          },
          {
            "text": "u mukama za sva vremena.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Sve moje grehe na mene navalio,",
            "poem": 1
          },
          {
            "text": "rukom ih svojom u breme svezao,",
            "poem": 2
          },
          {
            "text": "na moj ga je vrat natovario.",
            "poem": 1
          },
          {
            "text": "Oslabih od ovog tereta.",
            "poem": 2
          },
          {
            "text": "Gospod me je predao mojim dušmanima,",
            "poem": 1
          },
          {
            "text": "ja im se pak ne mogu suprotstaviti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Svim mojim junacima",
            "poem": 1
          },
          {
            "text": "Gospod se narugao.",
            "poem": 2
          },
          {
            "text": "Digao je ratnike protiv mene,",
            "poem": 1
          },
          {
            "text": "da pobije moje uzdanice mlade.",
            "poem": 2
          },
          {
            "text": "Kao grožđe u muljari",
            "poem": 1
          },
          {
            "text": "izgazio je Gospod lepu zemlju Judinu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Zato iz mojih očiju kao potok liju suze.",
            "poem": 1
          },
          {
            "text": "Utešiti ne može me niko;",
            "poem": 2
          },
          {
            "text": "ohrabriti ne može me niko.",
            "poem": 1
          },
          {
            "text": "Sinovi su moji pobeđeni,",
            "poem": 2
          },
          {
            "text": "neprijatelj ništa narodu ne ostavi.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Sion ruke svoje pruža,",
            "poem": 1
          },
          {
            "text": "ali pomoć niko mu ne pruža.",
            "poem": 2
          },
          {
            "text": "Gospod posta protivnik narodu Jakovljevu,",
            "poem": 1
          },
          {
            "text": "sa svih strana navaljuju tlačitelji;",
            "poem": 2
          },
          {
            "text": "s Jerusalimom postupaju",
            "poem": 1
          },
          {
            "text": "kao da je gadost među njima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Reč o pravednom Bogu"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Gospod me je pravedno kaznio,",
            "poem": 1
          },
          {
            "text": "jer njegovu reč nisam poslušao.",
            "poem": 2
          },
          {
            "text": "O, čujte me, odasvud narodi,",
            "poem": 1
          },
          {
            "text": "jade moje gledajte, vidite;",
            "poem": 2
          },
          {
            "text": "devojke moje, mladiće moje,",
            "poem": 1
          },
          {
            "text": "u progonstvo oteraše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Pozvah svoje saveznike,",
            "poem": 1
          },
          {
            "text": "a oni mi pomoć uskratiše.",
            "poem": 2
          },
          {
            "text": "Sveštenici moji i starešine",
            "poem": 1
          },
          {
            "text": "po gradskim ulicama pomreše,",
            "poem": 2
          },
          {
            "text": "a samo su hranu tražili",
            "poem": 1
          },
          {
            "text": "ne bi li u životu ostali.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Na moj ropac pogledaj, Gospode,",
            "poem": 1
          },
          {
            "text": "na izmučenost duše moje.",
            "poem": 2
          },
          {
            "text": "U grudima srce mi se grči,",
            "poem": 1
          },
          {
            "text": "žalostan sam zbog svoga prkosa.",
            "poem": 2
          },
          {
            "text": "Po ulicama sinove moje ubijaju,",
            "poem": 1
          },
          {
            "text": "a unutra, po kućama, smrt kosi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Kako cvilim, čuj me.",
            "poem": 1
          },
          {
            "text": "Nema nikog da me uteši.",
            "poem": 2
          },
          {
            "text": "Za moju nesreću dušmani su čuli,",
            "poem": 1
          },
          {
            "text": "te likuju zato što si mi je ti poslao.",
            "poem": 2
          },
          {
            "text": "Daj da i meni svane!",
            "poem": 1
          },
          {
            "text": "Neka slično meni i dušmani pate.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Prokuni njihove opačine sve,",
            "poem": 1
          },
          {
            "text": "računaj im zlo za zlo;",
            "poem": 2
          },
          {
            "text": "mene si već za grehe kaznio,",
            "poem": 1
          },
          {
            "text": "i njih kazni tako.",
            "poem": 2
          },
          {
            "text": "Samo ječim ja u jadu sada,",
            "poem": 1
          },
          {
            "text": "u mom je srcu tuga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
