  "chapter": {
    "number": 32,
    "content": [
      {
        "type": "heading",
        "content": [
          "Carska pravednost"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Evo, po pravdi caruje car,",
            "poem": 1
          },
          {
            "text": "pravedno vladaju vladari.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "I svaki je kao zavetrina,",
            "poem": 1
          },
          {
            "text": "te zaklanja od oluje,",
            "poem": 2
          },
          {
            "text": "i on je kao potoci vodeni u sušnoj zemlji,",
            "poem": 1
          },
          {
            "text": "kao hladovina iza velike stene u žednoj pustinji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "I oči onih koji vide neće više biti zamućene,",
            "poem": 1
          },
          {
            "text": "i uši onih koji čuju slušaće pažljivo,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "i srce brzopletih shvatiće znanje,",
            "poem": 1
          },
          {
            "text": "i mucavci će požuriti da govore razgovetno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Pokvarenjaka više neće zvati plemićem,",
            "poem": 1
          },
          {
            "text": "varalicu više neće smatrati uglednim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Ko je pokvaren, a ko je plemenit?"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Naime, bezumnik govori bezumno,",
            "poem": 1
          },
          {
            "text": "i srce njegovo smišlja bezakonje,",
            "poem": 2
          },
          {
            "text": "da počini zlodela,",
            "poem": 1
          },
          {
            "text": "da o Gospodu oholo govori,",
            "poem": 2
          },
          {
            "text": "da gladnoga ostavi prazna želuca,",
            "poem": 1
          },
          {
            "text": "da žednome uskrati piće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "I varalica je naoružan zlobom;",
            "poem": 1
          },
          {
            "text": "on spletke smišlja",
            "poem": 2
          },
          {
            "text": "da upropasti ponizne rečima lažljivim,",
            "poem": 1
          },
          {
            "text": "i siromaha kad traži pravo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "A plemić smišlja plemenitosti,",
            "poem": 1
          },
          {
            "text": "i on plemenitosti ostvaruje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Opomena i promena"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ustajte, žene lakomislene,",
            "poem": 1
          },
          {
            "text": "počujte glas moj;",
            "poem": 2
          },
          {
            "text": "ćerke lakoverne,",
            "poem": 1
          },
          {
            "text": "poslušajte besedu moju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Kroz godinu i nešto dana",
            "poem": 1
          },
          {
            "text": "drhtaćete, lakoverne,",
            "poem": 2
          },
          {
            "text": "jer propada berba,",
            "poem": 1
          },
          {
            "text": "ne dolazi žetva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Strepite, lakomislene!",
            "poem": 1
          },
          {
            "text": "Drhćite, lakoverne!",
            "poem": 2
          },
          {
            "text": "Svucite se i razgolitite se,",
            "poem": 1
          },
          {
            "text": "i opašite se po bedrima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Udarajte se u grudi i naričite za poljima ljupkim,",
            "poem": 1
          },
          {
            "text": "za vinogradima rodnim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Nad tlom naroda moga",
            "poem": 1
          },
          {
            "text": "trnje bodljikavo će rasti,",
            "poem": 2
          },
          {
            "text": "kao i nad svim domovima veselim,",
            "poem": 1
          },
          {
            "text": "naseljem razdraganim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Jer dvor je napušten, grad bučni zapušten.",
            "poem": 1
          },
          {
            "text": "Umesto nasipa i kule biće pećina doveka,",
            "poem": 2
          },
          {
            "text": "uživanje za divlje magarce,",
            "poem": 1
          },
          {
            "text": "pašnjak za stada.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Dok se na nas ne izlije Duh s visina,",
            "poem": 1
          },
          {
            "text": "te pretvori pustinju u voćnjak,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a voćnjak će se računati kao šuma.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Tad će u pustinji stanovati pravo,",
            "poem": 1
          },
          {
            "text": "a u voćnjaku boraviti pravednost.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Iz pravednosti će se mir roditi,",
            "poem": 1
          },
          {
            "text": "a pravednosti će na službi biti",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pouzdanje i spokojstvo doveka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Moj će narod tada boraviti u zgradama mirnim,",
            "poem": 1
          },
          {
            "text": "i u stanovima bezbednim,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i u počivalištima pouzdanim,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "iako će šuma biti oborena",
            "poem": 1
          },
          {
            "text": "i grad nisko spušten.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Blago vama,",
            "poem": 1
          },
          {
            "text": "sejete pored svih voda,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "puštate volove i magarce.",
            "poem": 2
          }
        ]
      }
    ],
