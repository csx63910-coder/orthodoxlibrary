  "chapter": {
    "number": 46,
    "content": [
      {
        "type": "heading",
        "content": [
          "Nemoćna božanstva i svemoćni Gospod"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Pade Vil! Sruši se Navav!",
            "poem": 1
          },
          {
            "text": "Stavljaju svoje rukotvorine na životinje i na stoku.",
            "poem": 2
          },
          {
            "text": "Nose ih kao bremena,",
            "poem": 1
          },
          {
            "text": "teret što zamara.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ruše se i padaju zajedno.",
            "poem": 1
          },
          {
            "text": "Ne mogu izbaviti nosioce.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "I duše svoje u ropstvo odvode.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "„Slušajte me, dome Jakovljev,",
            "poem": 1
          },
          {
            "text": "i svi ostaci doma Izrailjeva!",
            "poem": 2
          },
          {
            "text": "Ja sam vas nosio od rođenja;",
            "poem": 1
          },
          {
            "text": "Ja sam vas podizao od utrobe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "I kad ostarite, ja ostajem isti;",
            "poem": 1
          },
          {
            "text": "i kad osedite, ja ću biti potpora.",
            "poem": 2
          },
          {
            "text": "Ja sam činio i ja ću podizati,",
            "poem": 1
          },
          {
            "text": "i ja ću podupirati i dopremati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "S kim biste me uporedili,",
            "poem": 1
          },
          {
            "text": "i sličnim i izglednim učinili i poredili?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Vade zlato iz torbe,",
            "poem": 1
          },
          {
            "text": "i srebro mere na vagi,",
            "poem": 2
          },
          {
            "text": "u najam uzimaju livca",
            "poem": 1
          },
          {
            "text": "da im od toga načini boga,",
            "poem": 2
          },
          {
            "text": "da padaju ničice,",
            "poem": 1
          },
          {
            "text": "čelom i telom da se prostiru.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Podižu ga na rame, podupiru ga,",
            "poem": 1
          },
          {
            "text": "spuštaju ga dole i stoji,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "iz mesta svojega i ne pomera se,",
            "poem": 2
          },
          {
            "text": "niti viče na njih i ne odgovara;",
            "poem": 1
          },
          {
            "text": "ne spasava nikoga iz nevolje njegove.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Pomoć je blizu"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Setite se toga i budite ljudi;",
            "poem": 1
          },
          {
            "text": "odmetnici, uzmite to k srcu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Setite se početaka iz drevnosti.",
            "poem": 1
          },
          {
            "text": "Ta, ja sam Bog i nema drugoga,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Bog jesam i niko nije kao ja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Na početku posledice najavljujem,",
            "poem": 1
          },
          {
            "text": "i unapred što se nije zbilo.",
            "poem": 2
          },
          {
            "text": "Kažem: ’Odluka će se moja izvršiti,",
            "poem": 1
          },
          {
            "text": "i učiniću sve što hoću.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Pozvaću sa istoka grabljivicu,",
            "poem": 1
          },
          {
            "text": "iz daleke zemlje čoveka po odluci svojoj.",
            "poem": 2
          },
          {
            "text": "Što rekoh, to ću i dovesti.",
            "poem": 1
          },
          {
            "text": "Što iskazah, to ću učiniti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Slušajte me, srcem uporni,",
            "poem": 1
          },
          {
            "text": "od pravednosti udaljeni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Pravednost svoju primičem,",
            "poem": 1
          },
          {
            "text": "nije se udaljila;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i spasenje moje okasniti neće.",
            "poem": 2
          },
          {
            "text": "I na Sion ću spasenje staviti,",
            "poem": 1
          },
          {
            "text": "Izrailju proslavljenje svoje.“",
            "poem": 2
          }
        ]
      }
    ],
