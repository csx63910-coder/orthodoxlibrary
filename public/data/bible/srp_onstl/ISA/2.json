  },
  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "heading",
        "content": [
          "Mir neuzdrmani"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Viđenje Isaije sina Amocova za Judu i Jerusalim."
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Dogodiće se u poslednje dane",
          {
            "text": "i gora Doma Gospodnjeg",
            "poem": 1
          },
          {
            "text": "biće postavljena vrh gora,",
            "poem": 2
          },
          {
            "text": "i uzvišena iznad bregova.",
            "poem": 1
          },
          {
            "text": "Svi puci prema njoj će se sticati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Mnogi narodi će hodati i govoriti:",
          {
            "text": "„Hajde, popnimo se na goru Gospodnju,",
            "poem": 1
          },
          {
            "text": "u Dom Boga Jakovljeva,",
            "poem": 2
          },
          {
            "text": "te da nas on nauči putevima svojim,",
            "poem": 1
          },
          {
            "text": "i da mi hodamo stazama njegovim.“",
            "poem": 2
          },
          {
            "text": "Jer će poučenje izaći sa Siona,",
            "poem": 1
          },
          {
            "text": "i reč Gospodnja iz Jerusalima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Pa će on biti sudija među pucima,",
            "poem": 1
          },
          {
            "text": "i on će biti merodavan za narode mnoge;",
            "poem": 2
          },
          {
            "text": "te će oni mačeve prekovati u raonike,",
            "poem": 1
          },
          {
            "text": "a koplja u srpove.",
            "poem": 2
          },
          {
            "text": "Neće više narod protiv naroda podizati mačeve,",
            "poem": 1
          },
          {
            "text": "niti će se više učiti ratovanju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Dome Jakovljev, hajdemo,",
            "poem": 1
          },
          {
            "text": "u svetlosti Gospodnjoj da hodamo!",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Dolazak Gospodnji"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ta, ti si napustio svoj narod,",
            "poem": 1
          },
          {
            "text": "dom Jakovljev.",
            "poem": 2
          },
          {
            "text": "Zato što su puni vračanja sa istoka",
            "poem": 1
          },
          {
            "text": "i gatara kao Filistejci,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i deci tuđinaca oni se umiljavaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Njegova zemlja je srebra i zlata puna,",
            "poem": 1
          },
          {
            "text": "i riznicama njegovim nema broja;",
            "poem": 2
          },
          {
            "text": "njegova zemlja je konja puna,",
            "poem": 1
          },
          {
            "text": "i kolima njegovim nema broja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Njegova je zemlja idola puna,",
            "poem": 1
          },
          {
            "text": "i pred delom ruku svojih oni ničice padaju,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pred onim što prsti njihovi načiniše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ipak, čovek će se saviti,",
            "poem": 1
          },
          {
            "text": "i muž će se poniziti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a ti im nećeš oprostiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Uđi u stenu, sakrij se u prašinu",
            "poem": 1
          },
          {
            "text": "pred strahom Gospodnjim,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pred sjajem veličanstva njegova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Oholi čovekov pogled biće skrhan",
            "poem": 1
          },
          {
            "text": "i bahatost ljudska ponižena.",
            "poem": 2
          },
          {
            "text": "Gospod će biti uzvišen, on jedini – u dan onaj.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Jer biće to dan Gospoda nad vojskama",
            "poem": 1
          },
          {
            "text": "protiv svih ponositih i nadmenih,",
            "poem": 2
          },
          {
            "text": "protiv svih što se uzvisiše",
            "poem": 1
          },
          {
            "text": "da ih on obori;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "protiv svih kedrova livanskih, visokih i uzdignutih,",
            "poem": 1
          },
          {
            "text": "i protiv svih hrastova vasanskih,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "i protiv svih gora visokih,",
            "poem": 1
          },
          {
            "text": "i svih bregova uzdignutih;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "i protiv svake kule visoke,",
            "poem": 1
          },
          {
            "text": "i protiv svih zidina utvrđenih;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "protiv svega brodovlja tarsiskog,",
            "poem": 1
          },
          {
            "text": "i protiv svih brodova raskošnih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Oholost ljudska biće skršena,",
            "poem": 1
          },
          {
            "text": "i nadmenost ljudska ponižena.",
            "poem": 2
          },
          {
            "text": "Gospod će biti uzvišen,",
            "poem": 1
          },
          {
            "text": "on jedini – u dan onaj,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "a idoli će nestati potpuno.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Neka uđu u pećine stenovite,",
            "poem": 1
          },
          {
            "text": "i u zemunice u prašini,",
            "poem": 2
          },
          {
            "text": "pred strahom Gospodnjim,",
            "poem": 1
          },
          {
            "text": "pred sjajem veličanstva njegova,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kad ustane da potrese zemlju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "U dan onaj čovek će pobacati",
            "poem": 1
          },
          {
            "text": "svoje idole srebrne i svoje idole zlatne,",
            "poem": 2
          },
          {
            "text": "što su ih njemu načinili,",
            "poem": 1
          },
          {
            "text": "da se klanja ničice",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "krticama i slepim miševima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Ulaziće u pećinske šupljine",
            "poem": 1
          },
          {
            "text": "i u raspukline u stenama",
            "poem": 2
          },
          {
            "text": "pred strahom Gospodnjim,",
            "poem": 1
          },
          {
            "text": "pred sjajem veličanstva njegova,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kad ustane da potrese zemlju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Čuvajte se, dakle, od čoveka!",
            "poem": 1
          },
          {
            "text": "On dah ima u nozdrvama.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ta, šta on vredi?",
            "poem": 2
          }
        ]
      }
    ],
