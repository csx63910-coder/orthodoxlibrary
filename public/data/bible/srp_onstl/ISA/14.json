  "chapter": {
    "number": 14,
    "content": [
      {
        "type": "heading",
        "content": [
          "Gospod priprema povratak"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ta, smilovaće se Gospod Jakovu,",
            "poem": 1
          },
          {
            "text": "i opet će izabrati Izrailja;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i daće im da se odmore na svom tlu.",
            "poem": 2
          },
          {
            "text": "Pa će im se pridružiti došljak",
            "poem": 1
          },
          {
            "text": "i priključiće se plemenima Jakovljevim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "I uzeće ih narodi",
            "poem": 1
          },
          {
            "text": "i odvešće ih u njihov kraj,",
            "poem": 2
          },
          {
            "text": "a potomstvo Izrailjevo njih će naseliti na Gospodnjem tlu,",
            "poem": 1
          },
          {
            "text": "kao robove i sluškinje.",
            "poem": 2
          },
          {
            "text": "I zarobiće one koji su njih zarobljavali,",
            "poem": 1
          },
          {
            "text": "i biće gospodari nad svojim tlačiteljima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Kako nestade Vavilon"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "I biće onog dana: Gospod će ti dati počinak od napora tvojih i od nevolja tvojih i robovanja teškog, čime su te bili tlačili."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Tad ćeš sastaviti izreku protiv vavilonskog cara, ti ćeš govoriti:",
          {
            "text": "Kako nestade tlačitelj!",
            "poem": 1
          },
          {
            "text": "Kako nestade mučilište!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Gospod je slomio palicu opakih",
            "poem": 1
          },
          {
            "text": "i žezlo vladarsko",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "što je besno tuklo narode",
            "poem": 1
          },
          {
            "text": "udarcima što ne prestajahu,",
            "poem": 2
          },
          {
            "text": "što je gnevno potčinjavalo puke,",
            "poem": 1
          },
          {
            "text": "nemilice ih progonilo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Sva zemlja se odmara, počiva,",
            "poem": 1
          },
          {
            "text": "prolama se klicanje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Nad tobom se raduju čempresi",
            "poem": 1
          },
          {
            "text": "i kedri livanski:",
            "poem": 2
          },
          {
            "text": "„Od kako si pao,",
            "poem": 1
          },
          {
            "text": "ne dolaze na nas drvoseče.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Dole se zbog tebe Svet mrtvih uskolebao,",
            "poem": 1
          },
          {
            "text": "kada dođeš, da te on pozdravi;",
            "poem": 2
          },
          {
            "text": "zato on budi preminule,",
            "poem": 1
          },
          {
            "text": "sve moćnike zemaljske;",
            "poem": 2
          },
          {
            "text": "sa svojih prestola ustaju",
            "poem": 1
          },
          {
            "text": "svi carevi raznih narodnosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Svi ti oni kazuju i govore:",
            "poem": 1
          },
          {
            "text": "„Ti si onemoćao kao i mi što smo.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ti si nama sličan postao.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Oholost se tvoja u Svet mrtvih sruši,",
            "poem": 1
          },
          {
            "text": "buka tvojih lauta;",
            "poem": 2
          },
          {
            "text": "pod tobom je ležaj truleži,",
            "poem": 1
          },
          {
            "text": "a nad tobom pokrivač od crva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Kako pade sa nebesa,",
            "poem": 1
          },
          {
            "text": "Svetlonošo, sine Zorin?",
            "poem": 2
          },
          {
            "text": "Oboren si ti na zemlju,",
            "poem": 1
          },
          {
            "text": "razoritelj nad pucima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "A u svom si srcu govorio:",
            "poem": 1
          },
          {
            "text": "„Popeću se na nebesa,",
            "poem": 2
          },
          {
            "text": "iznad zvezda Božijih.",
            "poem": 1
          },
          {
            "text": "Presto svoj ću podići",
            "poem": 2
          },
          {
            "text": "i sešću na gori sabornoj,",
            "poem": 1
          },
          {
            "text": "na ivicama severa.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Uzneću se na visine nad oblacima,",
            "poem": 1
          },
          {
            "text": "izjednačiću se sa Svevišnjim.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "A ti si u Svet mrtvih bačen,",
            "poem": 1
          },
          {
            "text": "u dubine bezdana.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Koji te vide, oni te posmatraju,",
            "poem": 1
          },
          {
            "text": "i o tebi razmišljaju:",
            "poem": 2
          },
          {
            "text": "„Je li to taj čovek",
            "poem": 1
          },
          {
            "text": "koji je zemlju tresao, carstva drmao;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "koji je vaseljenu u pustinju pretvarao",
            "poem": 1
          },
          {
            "text": "i njene gradove rušio;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "koji zatvorenike svoje kući nije puštao?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Carevi raznih naroda svi počivaju u časti,",
            "poem": 1
          },
          {
            "text": "svaki je u svojoj grobnici;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "a ti si izbačen iz groba svog",
            "poem": 1
          },
          {
            "text": "kao neki izdanak odurni,",
            "poem": 2
          },
          {
            "text": "pokriven si poklanima,",
            "poem": 1
          },
          {
            "text": "mačem probodenima,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "na ploče od rake pobacanima,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kao izgažena lešina.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Ni tvoj pogreb neće biti",
            "poem": 1
          },
          {
            "text": "kao što je pogreb njihov,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "zato što si svoju zemlju razorio,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "zato što si svoj narod poklao.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Neka se nikad više",
            "poem": 1
          },
          {
            "text": "potomstvo zlikovačko ne pominje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Spremite pokolj potomcima",
            "poem": 1
          },
          {
            "text": "zbog krivice njihovih otaca,",
            "poem": 2
          },
          {
            "text": "da se više ne podižu, da svet osvajaju,",
            "poem": 1
          },
          {
            "text": "te će sva vaseljena biti pokrivena gradovima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Slom Vavilona"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "„Ustaću na njih",
            "poem": 1
          },
          {
            "text": "– govori Gospod nad vojskama –",
            "poem": 2
          },
          {
            "text": "i zatrću Vavilonu ime",
            "poem": 1
          },
          {
            "text": "i ostatak i rod i porod",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Pa ću njega u posed predati",
            "poem": 1
          },
          {
            "text": "ježevima i močvarama.",
            "poem": 2
          },
          {
            "text": "Počistiću ga metlom-zatiralicom",
            "poem": 1
          },
          {
            "text": "– govori Gospod nad vojskama.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Slom zemlje Asirije"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Zakleo se Gospod nad vojskama govoreći:",
          {
            "text": "„Što zamislih, to se ima zbiti,",
            "poem": 1
          },
          {
            "text": "što naumih, to će se dogoditi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Skršiću Asirca na mojoj zemlji,",
            "poem": 1
          },
          {
            "text": "izgaziću na mojim gorama.",
            "poem": 2
          },
          {
            "text": "Njen će jaram sa njih pasti;",
            "poem": 1
          },
          {
            "text": "njeno breme sa njihovih pleća.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Takva je odluka donesena protiv čitave zemlje;",
            "poem": 1
          },
          {
            "text": "takva je ruka ispružena protiv svih narodnosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "A kad Gospod nad vojskama odluči,",
            "poem": 1
          },
          {
            "text": "ko će se usprotiviti?",
            "poem": 2
          },
          {
            "text": "Kad on ruku ispruži,",
            "poem": 1
          },
          {
            "text": "ko će je odvratiti?",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Opomena Filistejcima"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Godine kad je umro car Ahaz bilo je ovo proroštvo:"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Ne raduj se, Filistejo cela,",
            "poem": 1
          },
          {
            "text": "što se slomi štap što te udara,",
            "poem": 2
          },
          {
            "text": "jer će otrovnica izaći iz zmijskog klupka",
            "poem": 1
          },
          {
            "text": "i ona će izleći zmaja krilatoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "I napasaće se prvenci ubogih,",
            "poem": 1
          },
          {
            "text": "i u spokojstvu počivaće siromasi;",
            "poem": 2
          },
          {
            "text": "a tvoj rod ću pomoriti glađu,",
            "poem": 1
          },
          {
            "text": "i pobiću što od tebe ostane.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Kukajte, vratnice! Zapomaži, grade!",
            "poem": 1
          },
          {
            "text": "Strepi, sva filistejska zemljo!",
            "poem": 2
          },
          {
            "text": "Jer najezda sa severa dolazi,",
            "poem": 1
          },
          {
            "text": "i čete njezine niko ne napušta!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Šta će se tada odgovoriti",
            "poem": 1
          },
          {
            "text": "glasnicima bilo koga puka?",
            "poem": 2
          },
          {
            "text": "„Gospod je osnovao Sion,",
            "poem": 1
          },
          {
            "text": "i u njemu će biti zaštićeni siromasi iz njegova naroda.“",
            "poem": 2
          }
        ]
      }
    ],
