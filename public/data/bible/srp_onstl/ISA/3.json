  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "heading",
        "content": [
          "Bezvlašće u Jerusalimu"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Gle, Gospodar,",
            "poem": 1
          },
          {
            "text": "Gospod nad vojskama,",
            "poem": 2
          },
          {
            "text": "oduzima Jerusalimu i Judi",
            "poem": 1
          },
          {
            "text": "snabdevanje i izdržavanje,",
            "poem": 2
          },
          {
            "text": "snabdevanje hlebom i snabdevanje vodom,",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "junaka i ratnika,",
            "poem": 2
          },
          {
            "text": "sudija i proroka,",
            "poem": 1
          },
          {
            "text": "rukovodioca i starešinu,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "pedesetnika i pretpostavljenog,",
            "poem": 1
          },
          {
            "text": "savetnika i veštog stručnjaka,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i onoga koji se predviđanjem bavi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "„I dajem im dečake za glavare;",
            "poem": 1
          },
          {
            "text": "i ćudljive da nad njima upravljaju.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Narod gonjen biva: čovek na čoveka,",
            "poem": 1
          },
          {
            "text": "i čovek na bližnjeg svojeg;",
            "poem": 2
          },
          {
            "text": "drski su: dečak na starešinu,",
            "poem": 1
          },
          {
            "text": "i prostak na odličnika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "A svako će hvatati brata svojega",
            "poem": 1
          },
          {
            "text": "u domu oca svojega:",
            "poem": 2
          },
          {
            "text": "„Ti plašt imaš! Dođi! Poglavar budi naš!",
            "poem": 1
          },
          {
            "text": "Ovo rasulo uzmi u ruke svoje!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "A on će se braniti u onaj dan:",
            "poem": 1
          },
          {
            "text": "„Neću to da ispravljam.",
            "poem": 2
          },
          {
            "text": "U Domu mome hleba nema, ni plašta nema.",
            "poem": 1
          },
          {
            "text": "Nemoj mene postavljati za narodnog glavara.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Jer Jerusalim se ruši,",
            "poem": 1
          },
          {
            "text": "i Juda pada,",
            "poem": 2
          },
          {
            "text": "zato što su reči njihove",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "i dela njihova protiv Gospoda",
            "poem": 1
          },
          {
            "text": "prkošenje u lice Slavi njegovoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Izraz lica njihovog protiv njih svedoči;",
            "poem": 1
          },
          {
            "text": "i kao Sodoma grehom svojim",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "razmeću se i ne kriju.",
            "poem": 2
          },
          {
            "text": "Teško duši njihovoj!",
            "poem": 1
          },
          {
            "text": "Sami sebi propast pripremaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Kažite pravedniku: biće mu dobro,",
            "poem": 1
          },
          {
            "text": "jer će se hraniti plodom dela svojih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Teško opakome na zlo,",
            "poem": 1
          },
          {
            "text": "jer dela ruku njegovih na njega će pasti!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Narode moj!",
            "poem": 1
          },
          {
            "text": "Maloletnici su njihovi tlačitelji",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i žene nad njim vladaju.",
            "poem": 2
          },
          {
            "text": "Narode moj!",
            "poem": 1
          },
          {
            "text": "Koji te vode, oni te zavode,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i puteve tvojih staza oni su zapetljali.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Na parnicu Gospod se podiže",
            "poem": 1
          },
          {
            "text": "i stao je na sud s narodima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Gospod će na sud doći",
            "poem": 1
          },
          {
            "text": "protiv starešina naroda svojega",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i protiv glavara njihovih:",
            "poem": 2
          },
          {
            "text": "„To ste vi vinograd moj opustošili;",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "u vašim kućama ste zadržali",
            "poem": 1
          },
          {
            "text": "što ste od siromaha oteli.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Šta vam je, te narod moj tlačite",
            "poem": 1
          },
          {
            "text": "i lice siromaha drobite?",
            "poem": 2
          },
          {
            "text": "– govori Gospodar, Gospod nad vojskama.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Prigovor Sionkama"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "I reče Gospod:",
            "poem": 1
          },
          {
            "text": "„Šta se to šepure ćerke sionske,",
            "poem": 2
          },
          {
            "text": "te hodaju ispruženih vratova,",
            "poem": 1
          },
          {
            "text": "i očima namiguju,",
            "poem": 2
          },
          {
            "text": "koracima sitnim koračaju,",
            "poem": 1
          },
          {
            "text": "lančićima na nogama zveckaju?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Gospodar će učiniti da teme ćerki sionskih oćelavi.",
            "poem": 1
          },
          {
            "text": "Gospod će razgolititi stidna mesta njina.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "U dan onaj će Gospodar strgnuti bleštavost lančića i grivni i mesečića"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "i naušnica i narukvica i koprena"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "i turbana i ogrlica i pojasića i stakalaca s mirisima i amajlija"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "i prstenja i nosnih kolutića"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "i skupocenih haljina i plašteva i ogrtača i torbica"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "i šljokica i košuljica i povezača i kapica."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Mesto miomirisa biće smrad;",
            "poem": 1
          },
          {
            "text": "mesto pojasa biće vrpca,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "mesto kovrdža biće obrijano teme,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "mesto gizdave haljine biće kostret,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "mesto lepote biće žig.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Jerusalimske udovice"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Muževi će tvoji od mača poginuti,",
            "poem": 1
          },
          {
            "text": "u okršajima junaci tvoji,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Na vratnicama tvojim će se kukati i tugovati,",
            "poem": 1
          },
          {
            "text": "na zemlji ćeš sedeti napuštena.",
            "poem": 2
          }
        ]
      }
    ],
