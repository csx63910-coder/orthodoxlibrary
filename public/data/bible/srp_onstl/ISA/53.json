  "chapter": {
    "number": 53,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ko je poverovao našoj poruci,",
            "poem": 1
          },
          {
            "text": "i mišica Gospodnja kome se otkrila?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "I kao izdanak pred njim je izrastao,",
            "poem": 1
          },
          {
            "text": "i kao koren iz zemlje suhe.",
            "poem": 2
          },
          {
            "text": "Nije imao krasote ni izgleda;",
            "poem": 1
          },
          {
            "text": "ni da bude viđen ni poželjan.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Bio je prezren i od ljudi odbačen,",
            "poem": 1
          },
          {
            "text": "čovek u bolovima i stradanju vičan,",
            "poem": 2
          },
          {
            "text": "i kao onaj od kog zaklanjaju lice,",
            "poem": 1
          },
          {
            "text": "bio je prezren i za nas beznačajan.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "A on je naše bolove poneo,",
            "poem": 1
          },
          {
            "text": "i naše bolesti na sebe uzeo.",
            "poem": 2
          },
          {
            "text": "Mi smo, pak, smatrali",
            "poem": 1
          },
          {
            "text": "da ga Bog tuče, udara i ponižava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "A on je proboden zbog naših prestupa,",
            "poem": 1
          },
          {
            "text": "satrven zbog naših krivica,",
            "poem": 2
          },
          {
            "text": "karanje je na njemu zbog našeg mira",
            "poem": 1
          },
          {
            "text": "i ranama svojim nas je iscelio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Svi smo mi kao ovce zavrljali,",
            "poem": 1
          },
          {
            "text": "svaki je krenuo svojim putem;",
            "poem": 2
          },
          {
            "text": "a Gospod je na njega svalio",
            "poem": 1
          },
          {
            "text": "krivicu svih nas.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Tlačen je bio i ponizio se on,",
            "poem": 1
          },
          {
            "text": "i nije otvorio usta svoja;",
            "poem": 2
          },
          {
            "text": "kao jagnje na klanje je vođen,",
            "poem": 1
          },
          {
            "text": "i kao ovca nema pred onima koji je strižu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i nije otvorio usta svoja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Od vlasti i od suda on je izuzet.",
            "poem": 1
          },
          {
            "text": "I ko će da ispriča šta je posle bilo?",
            "poem": 2
          },
          {
            "text": "Jer iz zemlje živih je izdvojen,",
            "poem": 1
          },
          {
            "text": "zbog greha mog naroda on je tučen.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Odredili su mu grob među opakima,",
            "poem": 1
          },
          {
            "text": "a u smrti bi s bogatašima.",
            "poem": 2
          },
          {
            "text": "Ipak, niti je učinio nasilje,",
            "poem": 1
          },
          {
            "text": "niti prevaru ustima svojim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Međutim, Gospodu se svidelo",
            "poem": 1
          },
          {
            "text": "da ga satire bolom.",
            "poem": 2
          },
          {
            "text": "Ako prineseš život njegov",
            "poem": 1
          },
          {
            "text": "kao žrtvu za prestup,",
            "poem": 2
          },
          {
            "text": "potomstvo će se postarati",
            "poem": 1
          },
          {
            "text": "da se produže dani,",
            "poem": 2
          },
          {
            "text": "i što je Gospodu ugodno",
            "poem": 1
          },
          {
            "text": "napredovaće rukom njegovom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "„Iz onog što je iskusio",
            "poem": 1
          },
          {
            "text": "videće svetlo i znanjem svojim će se nasititi.",
            "poem": 2
          },
          {
            "text": "Svojim poznanjem pravedni sluga moj opravdaće mnoge.",
            "poem": 1
          },
          {
            "text": "I njihove krivice sam će izneti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Zato ću mu mnoge u baštinu dati",
            "poem": 1
          },
          {
            "text": "i s moćnicima će plen deliti.",
            "poem": 2
          },
          {
            "text": "I sam je sebe ponudio da umre,",
            "poem": 1
          },
          {
            "text": "pa je u grešnike ubrojen,",
            "poem": 2
          },
          {
            "text": "i sam je poneo grehe mnogih",
            "poem": 1
          },
          {
            "text": "i zauzima se za grešnike.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
