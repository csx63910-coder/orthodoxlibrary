  "chapter": {
    "number": 31,
    "content": [
      {
        "type": "heading",
        "content": [
          "Protiv Egipta"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Teško onima koji silaze u Egipat po pomoć,",
            "poem": 1
          },
          {
            "text": "i nadu u konje polažu,",
            "poem": 2
          },
          {
            "text": "i u kola se uzdaju mnoga,",
            "poem": 1
          },
          {
            "text": "i u konjanike vrlo jake,",
            "poem": 2
          },
          {
            "text": "a ne gledaju s pouzdanjem u Svetitelja Izrailjeva,",
            "poem": 1
          },
          {
            "text": "a ne traže Gospoda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ipak, on je mudar i navaliće zlo,",
            "poem": 1
          },
          {
            "text": "i neće preinačiti što je rekao,",
            "poem": 2
          },
          {
            "text": "te će ustati protiv doma zlikovačkog",
            "poem": 1
          },
          {
            "text": "i protiv pomoći od prestupnika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Egipćanin je čovek, on nije Bog;",
            "poem": 1
          },
          {
            "text": "konji njegovi su meso, oni nisu duh.",
            "poem": 2
          },
          {
            "text": "Kada Gospod ispruži ruku svoju,",
            "poem": 1
          },
          {
            "text": "posrnuće onaj koji pomaže",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i pašće onaj kome on pomaže",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "– svi zajedno će propasti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Gospod se bori protiv Asirije"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Evo, Gospod mi je ovako rekao:",
          {
            "text": "„Kao što lav ili lavić",
            "poem": 1
          },
          {
            "text": "nad plenom svojim reži,",
            "poem": 2
          },
          {
            "text": "i onda kad na njega poviče pastira mnoštvo,",
            "poem": 1
          },
          {
            "text": "on se ne plaši od glasova njihovih,",
            "poem": 2
          },
          {
            "text": "niti on strepi od graje njihove –",
            "poem": 1
          },
          {
            "text": "tako će Gospod nad vojskama",
            "poem": 2
          },
          {
            "text": "sići da se bori",
            "poem": 1
          },
          {
            "text": "za goru Sion, za uzvišenje njeno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Kako ptica krilima,",
            "poem": 1
          },
          {
            "text": "tako će Gospod nad vojskama Jerusalim zaklanjati,",
            "poem": 2
          },
          {
            "text": "zaklon biti, izbaviti,",
            "poem": 1
          },
          {
            "text": "poštedeti i spasti.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Vratite se onome protiv koga ste se duboko pobunili, sinovi Izrailjevi."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ta, u onaj dan će svako prezreti idole svoje srebrne i zlatne, likove svoje rezane, što ih sebi ruke vaše na greh načiniše."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "„Asirac će pasti od mača što nije od ljudi,",
            "poem": 1
          },
          {
            "text": "prožderaće ga mač što nije od čoveka.",
            "poem": 2
          },
          {
            "text": "On će od mača bežati,",
            "poem": 1
          },
          {
            "text": "a mladići njegovi će biti pod nasiljem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Užasnut, ostaviće svoju tvrđavu;",
            "poem": 1
          },
          {
            "text": "njegovi glavari će se prestraviti pod zastavom –",
            "poem": 2
          },
          {
            "text": "tako je rekao Gospod,",
            "poem": 1
          },
          {
            "text": "njegova je vatra na Sionu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i njegova je peć u Jerusalimu.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
