  "chapter": {
    "number": 43,
    "content": [
      {
        "type": "heading",
        "content": [
          "Oslobođenje jevrejskog naroda"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Sada govori Gospod,",
            "poem": 1
          },
          {
            "text": "koji te je stvorio, Jakove,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "koji te je načinio, Izrailju:",
            "poem": 2
          },
          {
            "text": "„Ne boj se, jer ja sam te otkupio,",
            "poem": 1
          },
          {
            "text": "po imenu te pozvao: ti si moj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Kad preko vode prelaziš,",
            "poem": 1
          },
          {
            "text": "ja sam s tobom;",
            "poem": 2
          },
          {
            "text": "preko reka,",
            "poem": 1
          },
          {
            "text": "neće te preplaviti.",
            "poem": 2
          },
          {
            "text": "Prođeš li kroz vatru,",
            "poem": 1
          },
          {
            "text": "nećeš izgoreti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i plamen te opaliti neće,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "jer ja sam Gospod, Bog tvoj,",
            "poem": 1
          },
          {
            "text": "Izrailjev Svetitelj, tvoj Spasitelj.",
            "poem": 2
          },
          {
            "text": "Da tebe otkupim, dajem Egipat;",
            "poem": 1
          },
          {
            "text": "umesto tebe dajem Kuš i Sevu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Jer ti si dragocen u mojim očima,",
            "poem": 1
          },
          {
            "text": "cenjen si i ja te volim.",
            "poem": 2
          },
          {
            "text": "Zato i dajem čoveka umesto tebe,",
            "poem": 1
          },
          {
            "text": "i narode trampim za život tvoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ne boj se, jer ja sam s tobom.",
            "poem": 1
          },
          {
            "text": "Sa istoka ću potomstvo tvoje dovesti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i sa zapada ću te sakupiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Reći ću severu: ’Daj mi!’",
            "poem": 1
          },
          {
            "text": "i jugu: ’Ne zadržavaj ga!’",
            "poem": 2
          },
          {
            "text": "Sinove moje dovedi izdaleka,",
            "poem": 1
          },
          {
            "text": "i ćerke moje s kraja zemlje,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "svakog ko se imenom mojim zove,",
            "poem": 1
          },
          {
            "text": "i koga sam na slavu svoju stvorio,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "zamislio ga, pa ga načinio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Gospod je jedini Bog"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Izvedi narod slep, premda ima oči,",
            "poem": 1
          },
          {
            "text": "i gluv, premda ima uši.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Neka se zajedno saberu sva plemena,",
            "poem": 1
          },
          {
            "text": "i neka se sakupe narodi.",
            "poem": 2
          },
          {
            "text": "Je li ko od njih ovo najavio,",
            "poem": 1
          },
          {
            "text": "i od davnina nam predskazao?",
            "poem": 2
          },
          {
            "text": "Nek dovedu svoje svedoke i opravdaju se.",
            "poem": 1
          },
          {
            "text": "Neka se čuje, pa nek kažu: ’Istina je!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Vi ste svedoci moji – govori Gospod –",
            "poem": 1
          },
          {
            "text": "i sluge moje koje sam izabrao,",
            "poem": 2
          },
          {
            "text": "da biste znali i meni verovali,",
            "poem": 1
          },
          {
            "text": "i shvatili da sam to ja.",
            "poem": 2
          },
          {
            "text": "Pre mene nijedan bog sazdan ne bi,",
            "poem": 1
          },
          {
            "text": "a neće ni posle mene biti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ja, ja sam Gospod,",
            "poem": 1
          },
          {
            "text": "osim mene spasitelja nema.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ja sam najavio i spasao i predskazao,",
            "poem": 1
          },
          {
            "text": "i među vama tuđinaca nema!",
            "poem": 2
          },
          {
            "text": "A vi ste svedoci moji – govori Gospod –",
            "poem": 1
          },
          {
            "text": "i ja sam Bog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Od večnosti ja to jesam,",
            "poem": 1
          },
          {
            "text": "i niko iz moje ruke izbaviti neće.",
            "poem": 2
          },
          {
            "text": "Učiniću, a ko će izmeniti?“",
            "poem": 1
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Bog će uništiti Vavilon"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Govori Gospod,",
            "poem": 1
          },
          {
            "text": "vaš Otkupitelj, Izrailjev Svetitelj:",
            "poem": 2
          },
          {
            "text": "„Vas radi poslao sam prema Vavilonu,",
            "poem": 1
          },
          {
            "text": "i oboriću begunce, sve njih;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a Haldejci će klicati u lađama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ja sam Gospod, vaš Svetitelj,",
            "poem": 1
          },
          {
            "text": "Izrailjev stvoritelj, vaš car!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Novi izlazak"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Govori Gospod,",
            "poem": 1
          },
          {
            "text": "koji načini put po moru,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i po vodama silnim prolaz,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "koji je izveo bojna kola i konje,",
            "poem": 1
          },
          {
            "text": "vojsku i junake zajedno,",
            "poem": 2
          },
          {
            "text": "i oni padoše da više ne ustanu,",
            "poem": 1
          },
          {
            "text": "zgasnuše, kao fitilj utrnuše:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "„Ne spominjite ono što je davnašnje,",
            "poem": 1
          },
          {
            "text": "ne mislite na ono što je zastarelo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Evo, činim nešto novo;",
            "poem": 1
          },
          {
            "text": "već nastaje, zar ne opažate?",
            "poem": 2
          },
          {
            "text": "Da, napraviću put u pustinji,",
            "poem": 1
          },
          {
            "text": "i reke u pustoši.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Slaviće me zveri poljske,",
            "poem": 1
          },
          {
            "text": "šakali i nojevi mladi,",
            "poem": 2
          },
          {
            "text": "jer sam dao vodu u pustinji,",
            "poem": 1
          },
          {
            "text": "reke u pustari,",
            "poem": 2
          },
          {
            "text": "da napojim svoj narod,",
            "poem": 1
          },
          {
            "text": "izabranika svojega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Ovaj narod što sam ga sebi sazdao,",
            "poem": 1
          },
          {
            "text": "kazivaće meni pohvalu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Nezahvalnost Božijeg naroda"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Ali ti mene nisi prizivao, Jakove;",
            "poem": 1
          },
          {
            "text": "dosadio sam ti, Izrailju!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Nisi mi prinosio ovcu na svespalnicu,",
            "poem": 1
          },
          {
            "text": "nisi me proslavljao prinoseći žrtve;",
            "poem": 2
          },
          {
            "text": "a ja te nisam terao da prinosiš prinose,",
            "poem": 1
          },
          {
            "text": "niti sam ti dosađivao da mi kadiš;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "nisi mi za novac kupovao mirisni štapić;",
            "poem": 1
          },
          {
            "text": "nisi me sitio salom svojih žrtava;",
            "poem": 2
          },
          {
            "text": "nego si me opterećivao svojim gresima,",
            "poem": 1
          },
          {
            "text": "dosađivao si mi svojom krivicom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "A ja, ja sam taj,",
            "poem": 1
          },
          {
            "text": "sebe radi brišem tvoje prestupe,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i ne spominjem tvoje grehe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Podseti me,",
            "poem": 1
          },
          {
            "text": "sporićemo se zajedno,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "saberi se da se opravdaš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Prvo je sagrešio otac tvoj,",
            "poem": 1
          },
          {
            "text": "a od mene su se odmetnuli posrednici tvoji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "I ja ću oskrnaviti glavare Svetilišta,",
            "poem": 1
          },
          {
            "text": "te Jakova izručiti prokletstvu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a Izrailja poruzi.",
            "poem": 2
          }
        ]
      }
    ],
