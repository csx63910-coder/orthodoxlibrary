  "chapter": {
    "number": 66,
    "content": [
      {
        "type": "heading",
        "content": [
          "Upozorenje"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Govori Gospod:",
          {
            "text": "„Nebesa su presto moj,",
            "poem": 1
          },
          {
            "text": "a zemlja postolje za noge moje.",
            "poem": 2
          },
          {
            "text": "Kakvu kuću ćete mi sagraditi?",
            "poem": 1
          },
          {
            "text": "I gde je mesto moga počivanja?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Pa sve je to ruka moja načinila",
            "poem": 1
          },
          {
            "text": "i sve je to postalo",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "A na koga ću pogledati?",
            "poem": 1
          },
          {
            "text": "Na iscrpljenoga i na duhovno slomljenoga,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i onoga koji drhti pred mojom reči.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Protiv naopakih žrtava"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Taj što kolje vola,",
            "poem": 1
          },
          {
            "text": "ko čoveka da ubija,",
            "poem": 2
          },
          {
            "text": "i ko žrtvuje ovcu,",
            "poem": 1
          },
          {
            "text": "kao da se psom skrnavi;",
            "poem": 2
          },
          {
            "text": "taj što donosi prinos,",
            "poem": 1
          },
          {
            "text": "ko da krv svinjsku prinosi,",
            "poem": 2
          },
          {
            "text": "ko kadi tamjanom,",
            "poem": 1
          },
          {
            "text": "taj idola blagosilja.",
            "poem": 2
          },
          {
            "text": "To su oni izabrali za svoje puteve",
            "poem": 1
          },
          {
            "text": "i gadosti njihove po volji su duši njihovoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ja ću takođe izabrati da im dodijavam:",
            "poem": 1
          },
          {
            "text": "dovešću na njih to od čega zaziru.",
            "poem": 2
          },
          {
            "text": "Zato što sam zvao, a odgovora nije bilo;",
            "poem": 1
          },
          {
            "text": "govorio sam, a slušali nisu;",
            "poem": 2
          },
          {
            "text": "nego su činili što ja zlom smatram,",
            "poem": 1
          },
          {
            "text": "i birali ono što mi nije ugodno.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Gospod dolazi da uskoro sudi"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Poslušajte reč Gospodnju,",
            "poem": 1
          },
          {
            "text": "vi, koji drhtite od njegove reči:",
            "poem": 2
          },
          {
            "text": "„Govore vaša braća, mrzitelji vaši,",
            "poem": 1
          },
          {
            "text": "koji vas gone zbog imena mojega:",
            "poem": 2
          },
          {
            "text": "’Neka se proslavi Gospod,",
            "poem": 1
          },
          {
            "text": "te da vidimo vašu radost.’",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "I oni će postiđeni biti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Glas graje iz grada,",
            "poem": 1
          },
          {
            "text": "glas iz hrama –",
            "poem": 2
          },
          {
            "text": "glas je Gospoda koji namiruje",
            "poem": 1
          },
          {
            "text": "naknadu neprijateljima svojim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Pre nego što ju je zabolelo,",
            "poem": 1
          },
          {
            "text": "ona je rodila;",
            "poem": 2
          },
          {
            "text": "pre nego što je bol na nju došao,",
            "poem": 1
          },
          {
            "text": "ona je na svet muškarca donela.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ko je tako nešto čuo?",
            "poem": 1
          },
          {
            "text": "Ko je ovako nešto video?",
            "poem": 2
          },
          {
            "text": "Može li zemlja u jednom danu",
            "poem": 1
          },
          {
            "text": "da rodi čitavi puk?",
            "poem": 2
          },
          {
            "text": "Da bol odjedanput žacne,",
            "poem": 1
          },
          {
            "text": "pa da Sion sinove svoje rodi?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "’Zar ja, koji otvaram matericu,",
            "poem": 1
          },
          {
            "text": "pa da ne rađam? – govori Gospod.",
            "poem": 2
          },
          {
            "text": "Zar ja, koji dajem da se rađa,",
            "poem": 1
          },
          {
            "text": "pa da budem jalov? – govori Bog tvoj.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Radujte se zbog Jerusalima,",
            "poem": 1
          },
          {
            "text": "i kličite u njemu, svi koji ga volite.",
            "poem": 2
          },
          {
            "text": "Veselite se s njim, veselite se",
            "poem": 1
          },
          {
            "text": "svi koji ste tugovali nad njim;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "da budete nadojeni i nasićeni",
            "poem": 1
          },
          {
            "text": "na dojkama utehe njegove,",
            "poem": 2
          },
          {
            "text": "da se nasišete i nasladite",
            "poem": 1
          },
          {
            "text": "iz obilja slave njegove.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Jer govori Gospod:",
          {
            "text": "„Evo, ja ću ga dosegnuti mirom koji je kao reka,",
            "poem": 1
          },
          {
            "text": "i slavom naroda koja je kao potok nabujali.",
            "poem": 2
          },
          {
            "text": "I njegovu odojčad će u naručju nositi",
            "poem": 1
          },
          {
            "text": "i na kolenima milovati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Kao čoveka koga majka njegova teši,",
            "poem": 1
          },
          {
            "text": "tako ću i ja vas tešiti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i bićete utešeni u Jerusalimu.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "I videćete i veseliće se srce vaše,",
            "poem": 1
          },
          {
            "text": "i kao trava procvetaće kosti vaše,",
            "poem": 2
          },
          {
            "text": "i poznaće se ruka Gospodnja",
            "poem": 1
          },
          {
            "text": "na slugama njegovim, i posledice njihove",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "na neprijateljima njegovim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Jer, gle, Gospod u ognju dolazi,",
            "poem": 1
          },
          {
            "text": "kao oluja su bojna kola njegova,",
            "poem": 2
          },
          {
            "text": "vratiće u gnevnoj razjarenosti svojoj",
            "poem": 1
          },
          {
            "text": "i karanju njegovom, u ognju raspaljenom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Jer će Gospod suditi ognjem",
            "poem": 1
          },
          {
            "text": "i mačem svojim svakom ljudskom biću,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "te će mnogi od Gospoda poginuti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Protiv otpadnika"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "„Posvećuju i pročišćavaju sami sebe u vrtovima iza ’one jedne u sredini’; jedu svinjetinu i gadosti i miševe: zajedno će skončati – govori Gospod."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "A ja znam dela njihova i namere njihove. Gospodnja slava među pucima Dolazi vreme da se saberu svi puci i svi jezici, pa će doći i slavu moju gledati."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "I njima ću postaviti znak, te od onih koji su se izmakli, od njih ću poslati pucima: u Tarsis, Ful i Lud – poznatim strelcima – u Tuval i Grčku, na ostrva daleka gde se nije čulo što se o meni čuje, i gde se slava moja nije videla. I oni će pucima slavu moju objavljivati."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "I oni će dovesti svu braću vašu iz svih tuđinskih naroda, prinos za Gospoda: na konjima i na kolima i u nosiljkama i na mazgama i na jednogrbim kamilama na svetu goru moju, Jerusalim – govori Gospod – kao što sinovi Izrailjevi prinose prinos u čistoj posudi u Domu Gospodnjem."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Pa ću i od njih uzeti za sveštenike, za Levite – govori Gospod."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Jer kao što će preda mnom stajati nebesa nova i zemlja nova, što ću ja načiniti – govori Gospod – tako će stajati potomstvo vaše i ime vaše."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "I od mladog meseca do mladog meseca, i od subote do subote, dolaziće svako biće na poklonjenje pred licem mojim – govori Gospod;"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "i izlaziće i gledaće leševe ljudi koji su se od mene odmetnuli, jer crv njihov ne umire i oganj se njihov ne gasi; i biće za prezir svakom stvorenju.“"
        ]
      }
    ],
