  "chapter": {
    "number": 45,
    "content": [
      {
        "type": "heading",
        "content": [
          "Proroštvo o Kiru"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Govori Gospod o pomazaniku svom,",
            "poem": 1
          },
          {
            "text": "Kiru, kog prihvatih za desnicu",
            "poem": 2
          },
          {
            "text": "da pred njim oborim narode",
            "poem": 1
          },
          {
            "text": "i careve lišim njihovog ugleda:",
            "poem": 2
          },
          {
            "text": "„Pred njim dvostruka vrata otvaram,",
            "poem": 1
          },
          {
            "text": "i neće vratnice pred njim zatvorene biti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ja ću marširati pred tobom",
            "poem": 1
          },
          {
            "text": "da poravnam neravnine,",
            "poem": 2
          },
          {
            "text": "da razlomim vrata bronzana,",
            "poem": 1
          },
          {
            "text": "i pokršim prevornice gvozdene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Dajem ti blaga iz mračnih odaja",
            "poem": 1
          },
          {
            "text": "i bogatstva iz skrovišta,",
            "poem": 2
          },
          {
            "text": "da shvatiš da sam ja Gospod,",
            "poem": 1
          },
          {
            "text": "koji te zove po imenu, Bog Izrailjev.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Radi sluge svoga Jakova,",
            "poem": 1
          },
          {
            "text": "i izabranika Izrailja,",
            "poem": 2
          },
          {
            "text": "i tebe pozvah po imenu,",
            "poem": 1
          },
          {
            "text": "naimenovah te, iako me nisi znao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ja sam Gospod i drugoga nema,",
            "poem": 1
          },
          {
            "text": "osim mene drugog Boga nema.",
            "poem": 2
          },
          {
            "text": "Iako mene ne poznaješ,",
            "poem": 1
          },
          {
            "text": "ja sam te naoružao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Neka se zna od istoka i od zapada",
            "poem": 1
          },
          {
            "text": "da je ništavilo sve što je mimo mene.",
            "poem": 2
          },
          "Bog obećava spasenje",
          {
            "text": "Ja sam Gospod i drugoga nema:",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "ja tvorim svetlost i stvaram tamu,",
            "poem": 1
          },
          {
            "text": "činim mir i nesreću stvaram;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ja, Gospod, sve to činim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Rosite, nebesa, odozgo,",
            "poem": 1
          },
          {
            "text": "i pravednost, oblaci, neka iz vas pada.",
            "poem": 2
          },
          {
            "text": "Neka se otvori zemlja",
            "poem": 1
          },
          {
            "text": "i spasenje neka bude plod,",
            "poem": 2
          },
          {
            "text": "te zajedno proklija pravednost;",
            "poem": 1
          },
          {
            "text": "ja, Gospod, to sam stvorio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Gospod je svesilan"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Teško onom ko raspravlja sa Sazdateljem svojim,",
            "poem": 1
          },
          {
            "text": "a grne je među grnčarijom!",
            "poem": 2
          },
          {
            "text": "Kaže li glina grnčaru:",
            "poem": 1
          },
          {
            "text": "’Šta radiš?’",
            "poem": 2
          },
          {
            "text": "ili delo njegovo:",
            "poem": 1
          },
          {
            "text": "’On nema obe ruke’?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Teško onom koji ocu kaže:",
            "poem": 1
          },
          {
            "text": "’Zašto si rodio?’",
            "poem": 2
          },
          {
            "text": "ili ženi:",
            "poem": 1
          },
          {
            "text": "’Zašto si na svet donela?’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Govori Gospod,",
            "poem": 1
          },
          {
            "text": "Izrailjev Svetitelj i njegov Sazdatelj:",
            "poem": 2
          },
          {
            "text": "„Zar je vaše da me pitate",
            "poem": 1
          },
          {
            "text": "o znacima nad decom mojom,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i da mi zapovedate nad delom mojih ruku?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ja sam zemlju načinio",
            "poem": 1
          },
          {
            "text": "i čoveka na njoj stvorio;",
            "poem": 2
          },
          {
            "text": "svojim sam rukama nebesa rasprostro",
            "poem": 1
          },
          {
            "text": "i svim vojskama njihovim zapovedam.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ja sam ga podigao u pravednosti",
            "poem": 1
          },
          {
            "text": "i poravnao sve puteve njegove.",
            "poem": 2
          },
          {
            "text": "On će obnoviti moj grad",
            "poem": 1
          },
          {
            "text": "i osloboditi zarobljene moje",
            "poem": 2
          },
          {
            "text": "bez otkupnine i bez naknade –",
            "poem": 1
          },
          {
            "text": "govori Gospod nad vojskama.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Obraćenje tuđinaca"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Govori Gospod:",
          {
            "text": "„Trud egipatski i dobitak kuški,",
            "poem": 1
          },
          {
            "text": "i Savajci, ljudi povisoki,",
            "poem": 2
          },
          {
            "text": "tebi će preći i tvoji će biti,",
            "poem": 1
          },
          {
            "text": "za tobom će ići, u okovima prethoditi,",
            "poem": 2
          },
          {
            "text": "i tebi će se klanjati,",
            "poem": 1
          },
          {
            "text": "i tebe moliti:",
            "poem": 2
          },
          {
            "text": "’O, samo kod tebe je Božanstvo,",
            "poem": 1
          },
          {
            "text": "i osim Boga drugi ne postoji.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Zaista, ti si Božanstvo skriveno,",
            "poem": 1
          },
          {
            "text": "Bog Izrailjev, Spasitelj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Postideće se i osramotiće se svi,",
            "poem": 1
          },
          {
            "text": "zajedno će se povući pokunjeni oni koji prave kipove.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Gospod će spasti Izrailja",
            "poem": 1
          },
          {
            "text": "spasenjem večnim,",
            "poem": 2
          },
          {
            "text": "nećete se postideti,",
            "poem": 1
          },
          {
            "text": "i do vekova večnih nećete se osramotiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Gospod ukazuje na svoja dela"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ta, govori Gospod,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "stvoritelj nebesa",
            "poem": 1
          },
          {
            "text": "– on je Bog –",
            "poem": 2
          },
          {
            "text": "koji je oblikovao zemlju",
            "poem": 1
          },
          {
            "text": "i izgled joj dao,",
            "poem": 2
          },
          {
            "text": "koji je učvrstio,",
            "poem": 1
          },
          {
            "text": "i nije je stvorio da bude pustoš,",
            "poem": 2
          },
          {
            "text": "nego je uobličio da se na njoj stanuje:",
            "poem": 1
          },
          {
            "text": "„Ja sam Gospod i drugog nema.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Nisam govorio u tajnosti,",
            "poem": 1
          },
          {
            "text": "u zakutku zemlje tamne.",
            "poem": 2
          },
          {
            "text": "Nisam rekao potomstvu Jakovljevu:",
            "poem": 1
          },
          {
            "text": "’Tražite me u pustoši.’",
            "poem": 2
          },
          {
            "text": "Ja, Gospod, govorim pravdu",
            "poem": 1
          },
          {
            "text": "i blagovestim čestitosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Gospod je Bog za sve ljude"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Saberite se i dođite,",
            "poem": 1
          },
          {
            "text": "zajedno pristupite, izbeglice iz drugih naroda.",
            "poem": 2
          },
          {
            "text": "Neznalice su koji nose drvo idolsko",
            "poem": 1
          },
          {
            "text": "i mole se božanstvu koje ne spasava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Objavite i predočite,",
            "poem": 1
          },
          {
            "text": "hajde, posavetujte se zajednički.",
            "poem": 2
          },
          {
            "text": "Ko je ovo od davnina izjavio",
            "poem": 1
          },
          {
            "text": "i još tada predskazao?",
            "poem": 2
          },
          {
            "text": "Nisam li ja, Gospod?",
            "poem": 1
          },
          {
            "text": "Osim mene drugog boga nema;",
            "poem": 2
          },
          {
            "text": "pravednog Božanstva i Spasitelja",
            "poem": 1
          },
          {
            "text": "osim mene nema.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Obratite se meni i bićete spaseni,",
            "poem": 1
          },
          {
            "text": "svi krajevi zemljini,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jer ja sam Božanstvo i drugog nema.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Zaklinjem se samim sobom:",
            "poem": 1
          },
          {
            "text": "iz mojih usta izlazi reč pravedna",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i neću je opozvati:",
            "poem": 2
          },
          {
            "text": "da će se preda mnom svako koleno saviti,",
            "poem": 1
          },
          {
            "text": "svaki jezik mnome zaklinjati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "’Samo u Gospodu imam – veli –",
            "poem": 1
          },
          {
            "text": "pravednost i snagu.’“",
            "poem": 2
          },
          {
            "text": "K njemu će doći i stideće se",
            "poem": 1
          },
          {
            "text": "svi koji su besneli protiv njega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "U Gospodu će imati",
            "poem": 1
          },
          {
            "text": "pravednost i proslavljanje",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "sve potomstvo Izrailjevo.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
