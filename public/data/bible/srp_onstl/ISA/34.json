  "chapter": {
    "number": 34,
    "content": [
      {
        "type": "heading",
        "content": [
          "Propast zemlje edomske"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Pristupite, puci, da čujete;",
            "poem": 1
          },
          {
            "text": "i narodi, slušajte!",
            "poem": 2
          },
          {
            "text": "Neka čuje zemlja i što je ispunjava,",
            "poem": 1
          },
          {
            "text": "svet i sve što po njemu raste.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Jer se razjario Gospod na sve puke,",
            "poem": 1
          },
          {
            "text": "rasrdio se protiv sve vojske njihove;",
            "poem": 2
          },
          {
            "text": "izručio ih je,",
            "poem": 1
          },
          {
            "text": "predao ih je pokolju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Njihovi pobijeni leže,",
            "poem": 1
          },
          {
            "text": "i od leševa njihovih smrad se podiže,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i krv njihova gorja natapa.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "I rasula se sva vojska nebeska,",
            "poem": 1
          },
          {
            "text": "i nebesa se savijaju kao svitak,",
            "poem": 2
          },
          {
            "text": "i sva vojska njihova klone,",
            "poem": 1
          },
          {
            "text": "kao što klone list na lozi,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kao što klone na stablu smokvinu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "„Jer mač moj se natopio na nebesima.",
            "poem": 1
          },
          {
            "text": "Gle, na Edom on se spušta,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i na narod kome sam odredio da sudim.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Mač za Gospoda napunjen je krvlju,",
            "poem": 1
          },
          {
            "text": "podmazan je lojem;",
            "poem": 2
          },
          {
            "text": "krvlju od jaganjaca i jaraca,",
            "poem": 1
          },
          {
            "text": "lojem s bubrega ovnujskih,",
            "poem": 2
          },
          {
            "text": "jer Gospod ima žrtvu u Vosori,",
            "poem": 1
          },
          {
            "text": "i veliko klanje u zemlji edomskoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "I s njima će se to spustiti",
            "poem": 1
          },
          {
            "text": "na bivole i na volove s juncima.",
            "poem": 2
          },
          {
            "text": "I zemlja njihova će se krvlju natopiti,",
            "poem": 1
          },
          {
            "text": "i prašina njihova lojem omastiti,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "jer Gospod ima dan za odmazdu,",
            "poem": 1
          },
          {
            "text": "godinu da se namire računi za Sion.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "I prevratiće se potoci njezini u smolu,",
            "poem": 1
          },
          {
            "text": "i prašina njena u sumpor,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i zemlja će njena biti smola u plamenu,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "neće se gasiti ni noću ni danju,",
            "poem": 1
          },
          {
            "text": "dim njen će se dizati doveka.",
            "poem": 2
          },
          {
            "text": "Od kolena do kolena ležaće pustoš zasvagda.",
            "poem": 1
          },
          {
            "text": "Nikad više niko njome prolaziti neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Nju će zaposesti buljina i jež,",
            "poem": 1
          },
          {
            "text": "u njoj će boraviti ušara i gavran.",
            "poem": 2
          },
          {
            "text": "I on će na njoj rastegnuti",
            "poem": 1
          },
          {
            "text": "mernu traku za pustoš",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i visak za prazninu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Njeno plemstvo tamo neće biti, carstvom da ga zovu,",
            "poem": 1
          },
          {
            "text": "i svi njeni zapovednici biće uništeni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Po zdanjima njenim prorastaće trnje,",
            "poem": 1
          },
          {
            "text": "po tvrđavama njenim kopriva i čkalj,",
            "poem": 2
          },
          {
            "text": "te će postati jazbina za šakale,",
            "poem": 1
          },
          {
            "text": "ležaj za nojeve ženke.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Tamo će se sresti divlje mačke s hijenama,",
            "poem": 1
          },
          {
            "text": "i dlakavci će dozivati jedan drugog;",
            "poem": 2
          },
          {
            "text": "tamo će se smestiti noćnica-veštica",
            "poem": 1
          },
          {
            "text": "i naći će sebi počivalište;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "tamo će se gnezditi guja,",
            "poem": 1
          },
          {
            "text": "polagaće svoja jaja,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ležaće na njima,",
            "poem": 2
          },
          {
            "text": "izleći će ih u senu svom;",
            "poem": 1
          },
          {
            "text": "tamo će takođe sletati jastrebovi",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jedan za drugim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Istražujte u Knjizi Gospodnjoj, i čitajte:",
          {
            "text": "Nijedno od njih nedostajati neće,",
            "poem": 1
          },
          {
            "text": "mužjak ženki neće zafaliti,",
            "poem": 2
          },
          {
            "text": "zato što su usta moja",
            "poem": 1
          },
          {
            "text": "tako zapovedila,",
            "poem": 2
          },
          {
            "text": "i Duh njegov",
            "poem": 1
          },
          {
            "text": "tako ih je sakupio;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "zato što je on za njih bacio žreb,",
            "poem": 1
          },
          {
            "text": "i njegova ruka im je odmerila zemlju:",
            "poem": 2
          },
          {
            "text": "oni će je posedovati doveka,",
            "poem": 1
          },
          {
            "text": "nju će nastanjivati od kolena do kolena.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
