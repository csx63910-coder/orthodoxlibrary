  "chapter": {
    "number": 57,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Pravednik gine",
            "poem": 1
          },
          {
            "text": "i nikoga to ne uzbuđuje.",
            "poem": 2
          },
          {
            "text": "I smerni ljudi bivaju odvođeni",
            "poem": 1
          },
          {
            "text": "i niko ne razabire",
            "poem": 2
          },
          {
            "text": "da pravednik biva odveden pred zlo,",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "da uđe u mir.",
            "poem": 1
          },
          {
            "text": "Počivaju na ležajima svojim",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ko je išao ispravno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "„A sad se primaknite amo,",
            "poem": 1
          },
          {
            "text": "sinovi gatarini,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "potomstvo preljubničko, smrdljivo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Nad kim se šegačite?",
            "poem": 1
          },
          {
            "text": "Nad kim se bekeljite?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Plazite jezik?",
            "poem": 2
          },
          {
            "text": "Niste li vi deca buntovna,",
            "poem": 1
          },
          {
            "text": "potomstvo lažljivaca,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "koji se uspaljuju među hrastovima,",
            "poem": 1
          },
          {
            "text": "pod svakim drvetom zelenim,",
            "poem": 2
          },
          {
            "text": "žrtvujući decu po dolinama,",
            "poem": 1
          },
          {
            "text": "pod kamenim raselinama?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Prorok tuguje zbog idolopoklonstva"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "„Na vododerini tvoja je raka.",
            "poem": 1
          },
          {
            "text": "One, one su tvoji međaši.",
            "poem": 2
          },
          {
            "text": "Upravo njima izlivaš žrtve nalivne,",
            "poem": 1
          },
          {
            "text": "spaljuješ žitnu žrtvu.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Zar one da mi se svide?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Na goru visoku i uzdignutu",
            "poem": 1
          },
          {
            "text": "svoj si ležaj postavila,",
            "poem": 2
          },
          {
            "text": "pa si se tamo popela",
            "poem": 1
          },
          {
            "text": "da kolješ žrtvu zaklanicu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Uz vrata i dovratke",
            "poem": 1
          },
          {
            "text": "svoj si zapis postavila.",
            "poem": 2
          },
          {
            "text": "Daleko od mene si razotkrila",
            "poem": 1
          },
          {
            "text": "i na visine ležaj svoj namestila,",
            "poem": 2
          },
          {
            "text": "te se pogađala sa onima koje voliš",
            "poem": 1
          },
          {
            "text": "da legneš s njima, da osetiš snagu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "I hodočastiš caru u pomazanju,",
            "poem": 1
          },
          {
            "text": "i umnožavaš svoja mira;",
            "poem": 2
          },
          {
            "text": "i poslala si svoje izvestioce izdaleka",
            "poem": 1
          },
          {
            "text": "i spustila do Sveta mrtvih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Iznurila si sebe mnogim putovanjima svojim.",
            "poem": 1
          },
          {
            "text": "Nisi rekla: ’To je taština!’",
            "poem": 2
          },
          {
            "text": "Stekla si jakost novu,",
            "poem": 1
          },
          {
            "text": "zato oslabila nisi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Pa koga si se uplašila i pobojala,",
            "poem": 1
          },
          {
            "text": "te si slagala?",
            "poem": 2
          },
          {
            "text": "I nisi se mene setila,",
            "poem": 1
          },
          {
            "text": "nisi sebi na srce stavila.",
            "poem": 2
          },
          {
            "text": "Nisam li ja ćutao i od veka,",
            "poem": 1
          },
          {
            "text": "pa se mene pobojala nisi?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ja ću objaviti tvoju pravdu,",
            "poem": 1
          },
          {
            "text": "i dela ti tvoja koristiti neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Kad zavičeš, neka te izvedu čete tvoje.",
            "poem": 1
          },
          {
            "text": "A sve njih će vetar odneti, taština uzeti.",
            "poem": 2
          },
          {
            "text": "Međutim, koji se u mene uzdaju",
            "poem": 1
          },
          {
            "text": "zemlju će baštiniti",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i moju svetu goru posedovati.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Pesma utešna"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Tada će se govoriti:",
          {
            "text": "„Nasipajte! Nasipajte! Put poravnajte!",
            "poem": 1
          },
          {
            "text": "Mom narodu smetnje s puta uklonite!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Jer govori Višnji i Uzdignuti,",
            "poem": 1
          },
          {
            "text": "nastanjeni trajno, a ime mu je Svetitelj:",
            "poem": 2
          },
          {
            "text": "„Moj stan je uzvišenost i svetinja,",
            "poem": 1
          },
          {
            "text": "a sa skrušenim sam i s duhom poniženim,",
            "poem": 2
          },
          {
            "text": "da oživim poniženima duh,",
            "poem": 1
          },
          {
            "text": "da oživim skrušenima srce.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Jer se neću prepirati doveka,",
            "poem": 1
          },
          {
            "text": "niti ću se ljutiti neprestano,",
            "poem": 2
          },
          {
            "text": "jer bi ispred lica mojega oslabio duh",
            "poem": 1
          },
          {
            "text": "i duše koje sam sazdao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Krivica njegova je grabež.",
            "poem": 1
          },
          {
            "text": "Zato sam se naljutio,",
            "poem": 2
          },
          {
            "text": "i zato ga udario, i u ljutini se sakrio;",
            "poem": 1
          },
          {
            "text": "a on je otišao odmetnički,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kako ga srce njegovo odvuče.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Puteve njegove sam video.",
            "poem": 1
          },
          {
            "text": "I izlečiću ga i dovesti,",
            "poem": 2
          },
          {
            "text": "i umiriću srce onih koji ga teše",
            "poem": 1
          },
          {
            "text": "i koji s njim tuguju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Stvaram reči usnama da progovore:",
            "poem": 1
          },
          {
            "text": "Mir! Mir udaljenome i bliskome",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "– govori Gospod, i njega ću izlečiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "A opaki su kao more ustalasalo,",
            "poem": 1
          },
          {
            "text": "što se uspokojiti ne može,",
            "poem": 2
          },
          {
            "text": "i iz voda svojih istalasava",
            "poem": 1
          },
          {
            "text": "mulj i blato.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Nema mira opakima",
            "poem": 1
          },
          {
            "text": "– govori Bog moj.",
            "poem": 2
          }
        ]
      }
    ],
