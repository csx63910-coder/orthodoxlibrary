  "chapter": {
    "number": 61,
    "content": [
      {
        "type": "heading",
        "content": [
          "Prorokovo poslanje"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Duh je Gospodnji nada mnom;",
            "poem": 1
          },
          {
            "text": "on me je pomazao,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da javim Radosnu vest poniznima.",
            "poem": 2
          },
          {
            "text": "Poslao me je da previjem u srcu slomljene,",
            "poem": 1
          },
          {
            "text": "da najavim slobodu zarobljenicima,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "utamničenima da će im prestati sužanjstvo;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "da od Gospoda najavim godinu pomilovanja,",
            "poem": 1
          },
          {
            "text": "i od Boga našega dan osvete;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da utešim sve ožalošćene,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "da uspravim ožalošćene na Sionu,",
            "poem": 1
          },
          {
            "text": "da im dam nakit umesto pepela,",
            "poem": 2
          },
          {
            "text": "ulje za veselje umesto žalosti,",
            "poem": 1
          },
          {
            "text": "odeću za pohvalu umesto duha tužnoga;",
            "poem": 2
          },
          {
            "text": "i njih će zvati:",
            "poem": 1
          },
          {
            "text": "’Hrastovi pravdini,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Zasad Gospodnje slavnosti’.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "I sagradiće drevne razvaline,",
            "poem": 1
          },
          {
            "text": "i podići mesta poharana,",
            "poem": 2
          },
          {
            "text": "i obnoviće gradove,",
            "poem": 1
          },
          {
            "text": "pustošene od kolena do kolena.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "I tuđinci će stajati",
            "poem": 1
          },
          {
            "text": "i stada vaša napasati,",
            "poem": 2
          },
          {
            "text": "i sinovi stranaca biće ratari vaši",
            "poem": 1
          },
          {
            "text": "i vinogradari vaši.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "A vi ćete se zvati: ’Sveštenici Gospodnji’.",
            "poem": 1
          },
          {
            "text": "Govoriće vam se: ’Služitelji Boga našega’.",
            "poem": 2
          },
          {
            "text": "Ješćete blago tuđinskih naroda",
            "poem": 1
          },
          {
            "text": "i zagospodarićete slavom njihovom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Umesto vašeg dvostrukog nipodaštavanja i sramote,",
            "poem": 1
          },
          {
            "text": "odrediće im se da se vesele za vas,",
            "poem": 2
          },
          {
            "text": "koji ćete u njihovoj zemlji",
            "poem": 1
          },
          {
            "text": "naslediti dvostruko,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kojima će biti radost večna.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Jer ja, Gospod, volim pravo,",
            "poem": 1
          },
          {
            "text": "mrzim grabež uz žrtvu svespalnicu,",
            "poem": 2
          },
          {
            "text": "a daću im platu odistinsku,",
            "poem": 1
          },
          {
            "text": "i sklopiću s njima savez večni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "I znaće se među pucima potomstvo njihovo,",
            "poem": 1
          },
          {
            "text": "usred naroda naraštaji njihovi.",
            "poem": 2
          },
          {
            "text": "Svi koji ih vide shvatiće da su oni potomstvo",
            "poem": 1
          },
          {
            "text": "što ga je blagoslovio Gospod.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ushićen sam vrlo u Gospodu,",
            "poem": 1
          },
          {
            "text": "kliče duša moja u Bogu mome,",
            "poem": 2
          },
          {
            "text": "jer me je odenuo haljinom spasenja,",
            "poem": 1
          },
          {
            "text": "ogrnuo me je plaštom pravednosti,",
            "poem": 2
          },
          {
            "text": "kao ženik kad na sebe venac stavi",
            "poem": 1
          },
          {
            "text": "i nevesta kad se nakitom ukrasi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Jer kao što zemlja isteruje klice svoje,",
            "poem": 1
          },
          {
            "text": "i kao što seme u vrtu klija,",
            "poem": 2
          },
          {
            "text": "tako će Gospodar Gospod učiniti",
            "poem": 1
          },
          {
            "text": "da proklija pravda i pohvala pred svim pucima.",
            "poem": 2
          }
        ]
      }
    ],
