  "chapter": {
    "number": 8,
    "content": [
      {
        "type": "heading",
        "content": [
          "Isaija dobija sina"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Rekao mi je Gospod: „Uzmi veliku ploču i na njoj napiši narodnim pismom: ’Brz na grabež – hitar na plen.’“"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Potom sam za overu zapisa uzeo pouzdane svedoke: sveštenika Uriju i Zahariju sina Jeverehijina."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Onda sam se približio proročici te je ona začela i rodila sina. Tada mi je Gospod rekao: „Nadeni mu ime ’Brz na grabež – hitar na plen’,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "jer pre nego što dečak nauči ’tata’ i ’mama’, nosiće se pred cara asirskog bogatstvo iz Damaska i plen iz Samarije.“"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Siloam i Eufrat"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Opet mi Gospod uputi reč govoreći:"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "„Zato što ovaj narod odbacuje",
            "poem": 1
          },
          {
            "text": "spokojne tokove siloamskih voda,",
            "poem": 2
          },
          {
            "text": "a veseli se pred Resinom",
            "poem": 1
          },
          {
            "text": "i pred sinom Remalijinim,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "gle, zato će Gospodar na vas navesti",
            "poem": 1
          },
          {
            "text": "vode s Eufrata, silne i velike –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "cara asirskog i svu slavu njegovu –",
            "poem": 2
          },
          {
            "text": "i one će se izliti iz korita svoga",
            "poem": 1
          },
          {
            "text": "i preliće se preko svih obala;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "provaliće u Judu, razliće se",
            "poem": 1
          },
          {
            "text": "i poplaviće je, popeće se do grla njezina,",
            "poem": 2
          },
          {
            "text": "i krila će raširiti svoja preko zemlje tvoje,",
            "poem": 1
          },
          {
            "text": "o, Emanuile!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Bog je protiv zavojevača"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Udružujte se na zlo, o, narodi, ali bićete smrvljeni!",
            "poem": 1
          },
          {
            "text": "Poslušajte vi, daljine zemaljske.",
            "poem": 2
          },
          {
            "text": "Opašite se,",
            "poem": 1
          },
          {
            "text": "i bićete smrvljeni.",
            "poem": 2
          },
          {
            "text": "Opašite se,",
            "poem": 1
          },
          {
            "text": "i bićete smrvljeni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Smišljajte zaveru – biće uništena;",
            "poem": 1
          },
          {
            "text": "samo se vi dogovarajte – biće uzalud;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "zato što je s nama Bog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Spoticanje i posrtanje"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Jer Gospod mi je ovako govorio kad me je rukom uhvatio i kad me je opomenuo da ne idem putem kojim ovaj narod ide. Rekao je:"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "„Ne zovite zaverom",
            "poem": 1
          },
          {
            "text": "sve što narod ovaj naziva zaverom;",
            "poem": 2
          },
          {
            "text": "ne bojte se čega se on boji",
            "poem": 1
          },
          {
            "text": "i neka u vama straha ne bude.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Gospod nad vojskama, neka vam svetinja bude on,",
            "poem": 1
          },
          {
            "text": "bojte se njega,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "neka vas prožima strah od njega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Svetilište biće on,",
            "poem": 1
          },
          {
            "text": "i kamen za spoticanje",
            "poem": 2
          },
          {
            "text": "i stena za posrtanje",
            "poem": 1
          },
          {
            "text": "obema dinastijama izrailjskim,",
            "poem": 2
          },
          {
            "text": "zamka i mreža",
            "poem": 1
          },
          {
            "text": "za sve stanovnike jerusalimske.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Mnogi će se od njih saplesti",
            "poem": 1
          },
          {
            "text": "i pašće i razbiće se,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "zaplešće se i uhvatiće se.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Svedočenje, otkrivenje, Zakon"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Sačuvaj svedočenje,",
            "poem": 1
          },
          {
            "text": "zapečati Zakon među učenicima mojim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ja ću se pouzdati u Gospoda",
            "poem": 1
          },
          {
            "text": "koji je lice svoje sakrio od potomaka Jakovljevih, njemu se ja nadam.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Evo mene i dece koju mi je dao Gospod za znak i čudesa u Izrailju od Gospoda nad vojskama, koji boravi na gori Sion."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Tama prelazi u svetlo"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "A kad vam budu govorili: „Pitajte prizivače duhova i vidovnjake koji šapuću i mrmljaju…!“ Ne treba li narod da pita svog Boga, nego da se kod mrtvih raspituju za žive?"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Uz Zakon i uz svedočenje! Ko ovo ne rekne, zoru neka ne dočeka."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Lutaće po njoj potlačen i gladan; kad izgladni razjariće se i psovaće svoga cara i Boga svojega, bude li lice prema gore okrenuo."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Bude li po zemlji poglédao, videće strahotu i tamu i mrak kako guši, i zagnatog u stravu."
        ]
      }
    ],
