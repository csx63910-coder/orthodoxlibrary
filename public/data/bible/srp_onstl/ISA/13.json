  "chapter": {
    "number": 13,
    "content": [
      {
        "type": "heading",
        "content": [
          "Protiv Vavilona"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Proroštvo o Vavilonu što ga vide Isaija sin Amocov:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Na goletnom brdu podignite zastavu,",
            "poem": 1
          },
          {
            "text": "njima iz glasa vičite,",
            "poem": 2
          },
          {
            "text": "rukom mašite:",
            "poem": 1
          },
          {
            "text": "i neka uđu na kneževska vrata.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ja sam zapovedio svojim posvećenima,",
            "poem": 1
          },
          {
            "text": "pa sam pozvao junake svoje za gnev moj,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "koji se vesele veličanstvu mome.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Glas je mnoštva na gorama,",
            "poem": 1
          },
          {
            "text": "kao da je puno naroda.",
            "poem": 2
          },
          {
            "text": "Glas je buke od carstava,",
            "poem": 1
          },
          {
            "text": "od sakupljenih gomila.",
            "poem": 2
          },
          {
            "text": "To Gospod nad vojskama",
            "poem": 1
          },
          {
            "text": "vrši smotru vojske za boj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Dolaze iz daleke zemlje,",
            "poem": 1
          },
          {
            "text": "s nebeske granice,",
            "poem": 2
          },
          {
            "text": "Gospod i oruđa ljutine njegove,",
            "poem": 1
          },
          {
            "text": "da svu zemlju razore.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Kukajte, jer je blizu dan Gospodnji,",
            "poem": 1
          },
          {
            "text": "pustošenje od Svemoćnog dolazi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Sve su ruke zato malaksale,",
            "poem": 1
          },
          {
            "text": "svako ljudsko srce obamrlo,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "pa su se ustrašili,",
            "poem": 1
          },
          {
            "text": "žiganje i bolovi ih spopadaju,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "grče se kao porodilja;",
            "poem": 2
          },
          {
            "text": "jedan zazire od drugoga,",
            "poem": 1
          },
          {
            "text": "lica su im lica od plamena.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Evo dolazi dan Gospodnji,",
            "poem": 1
          },
          {
            "text": "svirepost moja i ljutina i jarost gneva mojega,",
            "poem": 2
          },
          {
            "text": "da u pustoš zemlju pretvori,",
            "poem": 1
          },
          {
            "text": "da iz nje grešnike istrebi;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "jer nebeske zvezde i sazvežđa njina",
            "poem": 1
          },
          {
            "text": "neće više svetlošću sijati,",
            "poem": 2
          },
          {
            "text": "sunce će da zgasne čim grane",
            "poem": 1
          },
          {
            "text": "i mesec svetlost svoju neće više odsjajivati;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "jer ću kazniti vaseljenu za zloću,",
            "poem": 1
          },
          {
            "text": "i opake za krivicu;",
            "poem": 2
          },
          {
            "text": "i zaustaviću ponos oholih,",
            "poem": 1
          },
          {
            "text": "i poniziću nadmenost nasilničku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Čovek će biti ređi od zlata žeženoga,",
            "poem": 1
          },
          {
            "text": "ljudski stvor ređi od zlata ofirskoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Zato ću nebesa potresti",
            "poem": 1
          },
          {
            "text": "i zemlja će se s mesta svoga pomeriti",
            "poem": 2
          },
          {
            "text": "zbog srdžbe Gospoda nad vojskama,",
            "poem": 1
          },
          {
            "text": "u dan kad se gnev njegov razjari.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "I tada, kao srna pred hajkačima,",
            "poem": 1
          },
          {
            "text": "kao ovce koje niko ne sabira,",
            "poem": 2
          },
          {
            "text": "svako će gledati prema svom narodu,",
            "poem": 1
          },
          {
            "text": "i svako će pobeći u svoju zemlju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Oni će probosti svakog koga stignu,",
            "poem": 1
          },
          {
            "text": "i od mača će pasti svako koga uhvate;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "pred očima njihovim",
            "poem": 1
          },
          {
            "text": "odojčad će im smrskati,",
            "poem": 2
          },
          {
            "text": "kuće njine opljačkati,",
            "poem": 1
          },
          {
            "text": "žene njihove silovati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Evo, na njih Midijce podižem.",
            "poem": 1
          },
          {
            "text": "Oni srebro ne cene",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i oni u zlatu ne uživaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Oni će lukom postreljati mladiće,",
            "poem": 1
          },
          {
            "text": "na plod utrobe se smilovati neće,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "nad dečacima oko im se sažaliti neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Vavilon, ukras carstvima,",
            "poem": 1
          },
          {
            "text": "ponos gordosti haldejske,",
            "poem": 2
          },
          {
            "text": "biće kao Sodoma i Gomora",
            "poem": 1
          },
          {
            "text": "kada ih je Bog opustošio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "On doveka neće biti naseljen,",
            "poem": 1
          },
          {
            "text": "od kolena do kolena biće nenastanjen.",
            "poem": 2
          },
          {
            "text": "I Arapin onde neće podizati šatora,",
            "poem": 1
          },
          {
            "text": "niti će pastiri onde počivati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Onde će zveri pustinjske boraviti,",
            "poem": 1
          },
          {
            "text": "i sovuljage će im kuće napuniti,",
            "poem": 2
          },
          {
            "text": "i nojevi će onde stanovati,",
            "poem": 1
          },
          {
            "text": "a jarci će tamo skakutati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Po njihovim napuštenim zgradama zavijaće hijene,",
            "poem": 1
          },
          {
            "text": "a po njihovim raskošnim dvorovima šakali.",
            "poem": 2
          },
          {
            "text": "Bliži se vreme njegovo,",
            "poem": 1
          },
          {
            "text": "a dani mu se produžiti neće.",
            "poem": 2
          }
        ]
      }
    ],
