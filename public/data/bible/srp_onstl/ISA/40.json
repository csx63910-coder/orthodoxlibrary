  },
  "chapter": {
    "number": 40,
    "content": [
      {
        "type": "heading",
        "content": [
          "Uteha od Gospoda"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "„Tešite, tešite narod moj",
            "poem": 1
          },
          {
            "text": "– govori Bog vaš –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Govorite Jerusalimu srdačno,",
            "poem": 1
          },
          {
            "text": "i vičite mu:",
            "poem": 2
          },
          {
            "text": "ratovanje mu je okončano,",
            "poem": 1
          },
          {
            "text": "krivica mu okajana,",
            "poem": 2
          },
          {
            "text": "jer on iz ruke Gospodnje primi",
            "poem": 1
          },
          {
            "text": "dvaput više nego što sagreši.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Glas viče:",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Put Gospodnji",
            "poem": 1
          },
          {
            "text": "kroz pustinju pripravite;",
            "poem": 2
          },
          {
            "text": "drum za Boga našega",
            "poem": 1
          },
          {
            "text": "u pustoši poravnajte.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Svaka dolina neka se podigne,",
            "poem": 1
          },
          {
            "text": "a svaka gora i brežuljak neka se spusti;",
            "poem": 2
          },
          {
            "text": "i što je strmo nek bude ravnica,",
            "poem": 1
          },
          {
            "text": "i hrapavo neka bude glatko.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Tada će se otkriti slava Gospodnja,",
            "poem": 1
          },
          {
            "text": "i svaki čovek će je videti –",
            "poem": 2
          },
          {
            "text": "jer su to kazala usta Gospodnja.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Glas reče: „Viči!“",
            "poem": 1
          },
          {
            "text": "A on odgovori: „Šta da vičem?“",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Svako je telo kao trava,",
            "poem": 1
          },
          {
            "text": "i sva mu je milina kao cvet poljski.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Sahne trava, vene cvet,",
            "poem": 1
          },
          {
            "text": "kad preko njih Gospodnji pređe dah.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Zaista, narod je trava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Sahne trava, vene cvet,",
            "poem": 1
          },
          {
            "text": "ali reč Boga našega ostaje doveka.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Bog najavljuje svoju naklonost"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Na visoku goru se uspni,",
            "poem": 1
          },
          {
            "text": "Sione, glasniče radosne vesti.",
            "poem": 2
          },
          {
            "text": "Glas svoj snažno podigni,",
            "poem": 1
          },
          {
            "text": "Jerusalime, glasniče radosne vesti.",
            "poem": 2
          },
          {
            "text": "Podigni ga, ne boj se,",
            "poem": 1
          },
          {
            "text": "kaži gradovima Judinim:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Evo Boga vašega!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Evo, Gospodar Gospod dolazi u sili,",
            "poem": 1
          },
          {
            "text": "vlada on mišicom svojom!",
            "poem": 2
          },
          {
            "text": "Evo, s njim je i plata od njega,",
            "poem": 1
          },
          {
            "text": "a ispred njega nagrada od njega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Kao Pastir on svoje stado napasa,",
            "poem": 1
          },
          {
            "text": "u svoje ruke jaganjce sabira,",
            "poem": 2
          },
          {
            "text": "u naručju svome ih nosi,",
            "poem": 1
          },
          {
            "text": "a dojilice neguje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Bog objavljuje svoju slavu"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ko je vode pregrštima izmerio,",
            "poem": 1
          },
          {
            "text": "i nebesa pedljem premerio?",
            "poem": 2
          },
          {
            "text": "A ko je sav prah zemaljski razmerio mericom,",
            "poem": 1
          },
          {
            "text": "i planine tegovima,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i bregove terazijama?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Duha Gospodnjeg ko je premerio,",
            "poem": 1
          },
          {
            "text": "i koji savetnik je njega uputio?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "S kim se savetovao i izgrađivao,",
            "poem": 1
          },
          {
            "text": "i ko ga je stazama pravde naučio?",
            "poem": 2
          },
          {
            "text": "I naučio ga znanju",
            "poem": 1
          },
          {
            "text": "i upoznao ga s putem razboritosti?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Gle, narodi su kao kap iz vedra,",
            "poem": 1
          },
          {
            "text": "i vrede kao prah na terazijama.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Gle, ostrva kao zrnce podiže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ni Livan nije dovoljan za lomaču,",
            "poem": 1
          },
          {
            "text": "a njegovih zveri nema dovoljno za svespalnicu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Svi narodi pred njim su kao ništa,",
            "poem": 1
          },
          {
            "text": "ništavilom i prazninom on ih smatra.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Kome ćete Boga sličnim učiniti",
            "poem": 1
          },
          {
            "text": "i s kakvim ćete ga likom uporediti?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Livac izliva idola,",
            "poem": 1
          },
          {
            "text": "zlatar ga pozlatom oblaže",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i od srebra lančiće izliva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Siromah za prinos",
            "poem": 1
          },
          {
            "text": "drvo netruležno bira,",
            "poem": 2
          },
          {
            "text": "i za to veštog umetnika traži",
            "poem": 1
          },
          {
            "text": "da za njega kip nepomični načini.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Zar ne znate?",
            "poem": 1
          },
          {
            "text": "Zar niste čuli?",
            "poem": 2
          },
          {
            "text": "Zar vam nije od iskona objavljeno?",
            "poem": 1
          },
          {
            "text": "Zar niste shvatili od osnivanja zemlje?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Nad krugom zemaljskim on stoluje",
            "poem": 1
          },
          {
            "text": "i stanovnici su njeni na skakavce nalik;",
            "poem": 2
          },
          {
            "text": "nebesa je razastro kao koprenu,",
            "poem": 1
          },
          {
            "text": "razapeo ih kao šator za stanovanje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "On moćnike pretvara u ništavilo,",
            "poem": 1
          },
          {
            "text": "sudije po zemlji čini da su kao ništa.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Tek što su zasađeni,",
            "poem": 1
          },
          {
            "text": "tek što su posejani,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "tek što im stabljika u zemlju koren pustila",
            "poem": 2
          },
          {
            "text": "– on na njih dune, i oni usahnu,",
            "poem": 1
          },
          {
            "text": "kao slamu vihor ih razveje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "„Kome ćete mene sličnim učiniti?",
            "poem": 1
          },
          {
            "text": "Ko je kao ja?“ – pita Svetitelj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Podignite pogled svoj i gledajte:",
            "poem": 1
          },
          {
            "text": "Ko je ovo stvorio?",
            "poem": 2
          },
          {
            "text": "Onaj koji na broj vojsku nebesku izvodi,",
            "poem": 1
          },
          {
            "text": "i koji po imenu sve njih proziva.",
            "poem": 2
          },
          {
            "text": "Zbog njegove velike moći i silne jačine",
            "poem": 1
          },
          {
            "text": "niko ne izostaje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Božije svemoćno sveznanje"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Zašto kažeš, Jakove,",
            "poem": 1
          },
          {
            "text": "i ti govoriš, Izrailju:",
            "poem": 2
          },
          {
            "text": "„Moj put je skriven Gospodu,",
            "poem": 1
          },
          {
            "text": "i moja pravica izmiče Bogu mojem“?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Zar ne znaš",
            "poem": 1
          },
          {
            "text": "i zar nisi čuo?",
            "poem": 2
          },
          {
            "text": "Gospod je Bog večni,",
            "poem": 1
          },
          {
            "text": "stvoritelj krajeva zemljinih.",
            "poem": 2
          },
          {
            "text": "On se ne umara i ne sustaje,",
            "poem": 1
          },
          {
            "text": "i um se njegov ne da ograničiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "On snagu umornome daje,",
            "poem": 1
          },
          {
            "text": "i nemoćnome moć on jača.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Mladići se umaraju i sustaju,",
            "poem": 1
          },
          {
            "text": "i momci moraju da posrću,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "ali onima koji se u Gospoda uzdaju",
            "poem": 1
          },
          {
            "text": "snaga se obnavlja,",
            "poem": 2
          },
          {
            "text": "krila im rastu kao orlovima,",
            "poem": 1
          },
          {
            "text": "trče i ne sustaju,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "hodaju i ne umaraju se.",
            "poem": 2
          }
        ]
      }
    ],
