  "chapter": {
    "number": 23,
    "content": [
      {
        "type": "heading",
        "content": [
          "Reč o Tiru i Sidonu"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Proroštvo o Tiru.",
          {
            "text": "Ridajte, lađe tarsiske,",
            "poem": 1
          },
          {
            "text": "jer je raskopan,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "nema kuće, nema ulaska.",
            "poem": 2
          },
          {
            "text": "Objavljeno im je",
            "poem": 1
          },
          {
            "text": "iz zemlje kitimske.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Umuknite, stanovnici primorski,",
            "poem": 1
          },
          {
            "text": "trgovci sidonski",
            "poem": 2
          },
          {
            "text": "brodili su morem",
            "poem": 1
          },
          {
            "text": "– oni su te snabdevali –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "i vodama velikim.",
            "poem": 1
          },
          {
            "text": "Seme sihorsko i žetva kraj Nila",
            "poem": 2
          },
          {
            "text": "bili su bogatstvo njegovo.",
            "poem": 1
          },
          {
            "text": "On je narodima bio sajmište.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Stidi se, Sidone, jer more govori, sila morska kazuje:",
            "poem": 1
          },
          {
            "text": "„Ne spopadaju mene bolovi trudnički,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "niti rađam,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i ne odgajam mladiće,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ne podižem devojke.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Kada su vesti stigle u Egipat,",
            "poem": 1
          },
          {
            "text": "spopadoše ih bolovi kao kad su čuli o Tiru.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Otplovite u Tarsis,",
            "poem": 1
          },
          {
            "text": "ridajte, stanovnici primorski.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Je li to vaš grad veseli,",
            "poem": 1
          },
          {
            "text": "što postoji od starinskih dana?",
            "poem": 2
          },
          {
            "text": "Noge su ga njegove nosile",
            "poem": 1
          },
          {
            "text": "da se daleko naseli.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ko li je to odlučio?",
            "poem": 1
          },
          {
            "text": "protiv Tira koji krune deli,",
            "poem": 2
          },
          {
            "text": "čiji trgovci behu glavari",
            "poem": 1
          },
          {
            "text": "i prodavci njegovi poštovani po svetu?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Gospod nad vojskama je to odlučio,",
            "poem": 1
          },
          {
            "text": "da osramoti nadutost gordu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da ponizi sve po svetu poštovane.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Prođi svojom zemljom kao Nil,",
            "poem": 1
          },
          {
            "text": "ljupki Tarsise:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "nema više luke.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ruku svoju na more je podigao,",
            "poem": 1
          },
          {
            "text": "carstva zatresao.",
            "poem": 2
          },
          {
            "text": "Gospod je zapovedio za Hanan:",
            "poem": 1
          },
          {
            "text": "da se razore tvrđave njegove.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "I rekao je: „Nećeš više klicati,",
            "poem": 1
          },
          {
            "text": "silovana devojko, ljupki Sidone.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ustani, pređi u Kitim;",
            "poem": 1
          },
          {
            "text": "ali ni tamo nećeš imati počinka.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Evo zemlje haldejske,",
            "poem": 1
          },
          {
            "text": "taj narod ne postoji,",
            "poem": 2
          },
          {
            "text": "Asirci je osnovali za one iz pustinje,",
            "poem": 1
          },
          {
            "text": "razaraju utvrđenja njena.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ridajte, lađe tarsiske,",
            "poem": 1
          },
          {
            "text": "jer je raskopana vaša tvrđava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Tir – grad porobljeni"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "I biće u onaj dan, pa će Tir biti zaboravljen sedamdeset godina, kao dani jednog kralja. Posle sedamdeset godina, Tiru će biti kao bludnici iz pesme:"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "„Uzmi citru, te se skitaj gradom,",
            "poem": 1
          },
          {
            "text": "bludnice zaboravljena!",
            "poem": 2
          },
          {
            "text": "Sviraj lepo, pevaj mnogo,",
            "poem": 1
          },
          {
            "text": "ne bi li se setili tebe!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "I biće posle sedamdeset godina: Gospod će pohoditi Tir; i grad će ponovo uzimati svoju platu i bludničiće sa svim carstvima na svetu, po licu zemlje."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Ipak, njegova dobit i plata biće posvećeni Gospodu. Neće se zgrtati ni čuvati, nego će njegova dobit biti za one koji borave pred Gospodom, te da imaju hrane do sitosti i otmenu odeću."
        ]
      }
    ],
