  "chapter": {
    "number": 27,
    "content": [
      {
        "type": "heading",
        "content": [
          "Izbavljenje Izrailja"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "U dan onaj",
          {
            "text": "pohodiće Gospod mačem svojim,",
            "poem": 1
          },
          {
            "text": "ljutim i velikim i jakim",
            "poem": 2
          },
          {
            "text": "levijatana, zmiju vijugavu,",
            "poem": 1
          },
          {
            "text": "i zaklaće neman morsku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Vinograd Gospodnji"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "U dan onaj",
          {
            "text": "„Vinograde vinorodni – odgovoriće mu.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ja, Gospod, bdim nad njim,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "zalivam ga neprestano;",
            "poem": 2
          },
          {
            "text": "da ga neko ne ošteti,",
            "poem": 1
          },
          {
            "text": "danju i noću stražarim nad njim.",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Nema jarosti u meni.",
            "poem": 2
          },
          {
            "text": "Trnovitim bodljama, ko će me napasti?",
            "poem": 1
          },
          {
            "text": "Nastupiću protiv njega;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "spaliću ga svega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ili: neka se pouzda u moje utočište:",
            "poem": 1
          },
          {
            "text": "mir sa mnom neka sklopi,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "sa mnom mir neka sklopi!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Milost narodu i kazna tlačitelju"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ide vreme, Jakov će se ukoreniti,",
            "poem": 1
          },
          {
            "text": "Izrailj će se razgranati i procvetati,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i oni će plodovima lice sveta prekriti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Da li je on udario",
            "poem": 1
          },
          {
            "text": "onog što je njega udario?",
            "poem": 2
          },
          {
            "text": "Da li je on klao",
            "poem": 1
          },
          {
            "text": "onog što je njega klao?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Isterao si ga, izgnao si ga –",
            "poem": 1
          },
          {
            "text": "ti si njega karao.",
            "poem": 2
          },
          {
            "text": "On će ga oduvati dahom svojim olujnim",
            "poem": 1
          },
          {
            "text": "u dan vetra istočnoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Tako će se otkupiti krivica Jakovljeva,",
            "poem": 1
          },
          {
            "text": "a sve ovo je zato što je njemu oprošten greh:",
            "poem": 2
          },
          {
            "text": "on će učiniti da svi kameni žrtvenici",
            "poem": 1
          },
          {
            "text": "budu kao zdrobljeni krečnjak,",
            "poem": 2
          },
          {
            "text": "da se više ne podižu",
            "poem": 1
          },
          {
            "text": "Aštartini stupovi i stubovi u čast sunca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Jer će grad utvrđeni ostati sam,",
            "poem": 1
          },
          {
            "text": "napušten i zaboravljen kao pustinja.",
            "poem": 2
          },
          {
            "text": "Onde telad pase,",
            "poem": 1
          },
          {
            "text": "onde leži",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i brsti mu grane.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Kad mu se kruna osuši, onda se lome;",
            "poem": 1
          },
          {
            "text": "žene dolaze i one ih spaljuju,",
            "poem": 2
          },
          {
            "text": "jer je to narod nerazuman.",
            "poem": 1
          },
          {
            "text": "Zato im se neće smilovati njegov Sazdatelj,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i neće mu biti naklonjen njegov Graditelj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Zov velike trube"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "U dan onaj ovršiće Gospod klasje od toka Eufrata do Egipatskog potoka, i vi ćete se skupiti, jedan po jedan, potomci Izrailjevi."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "U dan onaj velika će zatrubiti truba i doći će raseljeni po zemlji asirskoj, i izgnani u zemlju egipatsku, i klanjaće se Gospodu na svetoj gori, u Jerusalimu."
        ]
      }
    ],
    "footnotes": []
  },
