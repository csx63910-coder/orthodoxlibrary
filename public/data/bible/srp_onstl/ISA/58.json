  "chapter": {
    "number": 58,
    "content": [
      {
        "type": "heading",
        "content": [
          "Beseda o postu"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Viči koliko te grlo nosi!",
            "poem": 1
          },
          {
            "text": "Nemoj se ustezati.",
            "poem": 2
          },
          {
            "text": "Slično rogu glas svoj podigni,",
            "poem": 1
          },
          {
            "text": "i narodu mom zločine njegove objavi,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i domu Jakovljevom grehe njegove.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "A mene dan za danom traže",
            "poem": 1
          },
          {
            "text": "i poznavanju puteva mojih žude,",
            "poem": 2
          },
          {
            "text": "kao puk što deluje po pravdi",
            "poem": 1
          },
          {
            "text": "i presude Boga svoga ne zanemaruje.",
            "poem": 2
          },
          {
            "text": "Ištu od mene pravednost na sudu,",
            "poem": 1
          },
          {
            "text": "za blizinom Božijom žude.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "’Zašto smo postili,",
            "poem": 1
          },
          {
            "text": "kad ti ne vidiš?",
            "poem": 2
          },
          {
            "text": "Zašto smo mučili dušu svoju,",
            "poem": 1
          },
          {
            "text": "a ti ne znaš?’",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Gle, u dan posta vašega vi zgrćete kako vam se hoće,",
            "poem": 1
          },
          {
            "text": "a sve vaše radnike tlačite.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Gle, vi postite da biste se prepirali i nametali,",
            "poem": 1
          },
          {
            "text": "da biste zlehudoga pesnicom udarali.",
            "poem": 2
          },
          {
            "text": "Nemojte kao danas postiti,",
            "poem": 1
          },
          {
            "text": "onda će se na visinama čuti glas vaš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Zar je takav post što sam ga izabrao,",
            "poem": 1
          },
          {
            "text": "dan kad muči čovek dušu svoju,",
            "poem": 2
          },
          {
            "text": "da se glavom svojom savija ničice kao rogoz,",
            "poem": 1
          },
          {
            "text": "i kostret i pepeo prospe pod sebe?",
            "poem": 2
          },
          {
            "text": "Zar ćeš to postom zvati",
            "poem": 1
          },
          {
            "text": "i danom što je Gospodu po volji?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Nije li ovo post što sam ga izabrao:",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "odrešiti veze nad zlehudim,",
            "poem": 1
          },
          {
            "text": "razvezati u jaram svezane,",
            "poem": 2
          },
          {
            "text": "dati slobodu potrvenima,",
            "poem": 1
          },
          {
            "text": "i svaki jaram da bude izlomljen?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Nije li da udeliš hleb svoj gladnome,",
            "poem": 1
          },
          {
            "text": "da u dom dovedeš beskućnika,",
            "poem": 2
          },
          {
            "text": "kad vidiš gola da ga odeneš,",
            "poem": 1
          },
          {
            "text": "i od rodbine svoje da se ne kriješ?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Tada će kao zora sijati svetlost tvoja",
            "poem": 1
          },
          {
            "text": "i zdravlje će tvoje brzo bujati,",
            "poem": 2
          },
          {
            "text": "i pravda će tvoja ispred tebe ići,",
            "poem": 1
          },
          {
            "text": "a slava Gospodnja će te pratiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Kad povičeš, Gospod će odgovoriti;",
            "poem": 1
          },
          {
            "text": "zavapićeš, a on će reći: ’Evo me!’",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ako iz svoje sredine ukloniš jaram,",
            "poem": 1
          },
          {
            "text": "prst preteći i besedu prestupničku,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "i zbog gladnog se uzbudi tvoja duša,",
            "poem": 1
          },
          {
            "text": "i nasitiš dušu namučenu;",
            "poem": 2
          },
          {
            "text": "tada će se svetlost tvoja podići u tami,",
            "poem": 1
          },
          {
            "text": "i tamnina tvoja biće kao podne.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "I Gospod će te voditi bez prestanka,",
            "poem": 1
          },
          {
            "text": "i po suhim tlima nasitiće ti dušu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i kosti će tvoje gipkijima učiniti;",
            "poem": 2
          },
          {
            "text": "i bićeš kao vrt zalivan",
            "poem": 1
          },
          {
            "text": "i kao studenac čije vode usahnuti neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "I vekovne razvaline sagradiće za sebe,",
            "poem": 1
          },
          {
            "text": "utemeljene od kolena do kolena,",
            "poem": 2
          },
          {
            "text": "a tebe će zvati ’Onaj koji pukotine zaziđuje’,",
            "poem": 1
          },
          {
            "text": "’Obnovitelj drumova prema naseljima.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Zapis o suboti"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ako odvratiš svoju nogu od subote,",
            "poem": 1
          },
          {
            "text": "da u sveti dan moj ne radiš što se tebi sviđa,",
            "poem": 2
          },
          {
            "text": "i da subotu nazoveš milinom,",
            "poem": 1
          },
          {
            "text": "svetinju Gospodnju proslavljenom,",
            "poem": 2
          },
          {
            "text": "a slavu njegovu odvojenom od poslova,",
            "poem": 1
          },
          {
            "text": "da na svojim putevima",
            "poem": 2
          },
          {
            "text": "ne obavljaš što ti se prohte,",
            "poem": 1
          },
          {
            "text": "i da ne govoriš nepromišljene reči;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "tada će ti omiliti ono što je Gospodnje,",
            "poem": 1
          },
          {
            "text": "projahaćeš sa mnom po uzvišicama na zemlji,",
            "poem": 2
          },
          {
            "text": "pa ću te hraniti onim što si nasledio",
            "poem": 1
          },
          {
            "text": "od Jakova, pretka tvojega –",
            "poem": 2
          },
          {
            "text": "jer su to kazala usta Gospodnja.“",
            "poem": 3
          }
        ]
      }
    ],
