  "chapter": {
    "number": 11,
    "content": [
      {
        "type": "heading",
        "content": [
          "Dolazak pravednog cara"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Iz panja Jesejeva mladica će izrasti,",
            "poem": 1
          },
          {
            "text": "iz njegova bokora Izdanak će plod doneti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Na njemu će počivati Duh Gospodnji,",
            "poem": 1
          },
          {
            "text": "Duh mudrosti i razuma,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Duh saveta i jakosti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Duh znanja i bogobojaznosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Njega će prodahnuti bogobojaznost:",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "te on neće suditi prema onome što vidi,",
            "poem": 1
          },
          {
            "text": "niti ceniti prema onome što čuje,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "nego će on po pravdi suditi, i poniznima na zemlji",
            "poem": 1
          },
          {
            "text": "pravednu procenu izricati;",
            "poem": 2
          },
          {
            "text": "šibom reči svoje ošinuće zemlju,",
            "poem": 1
          },
          {
            "text": "a dahom iz usta ubiće opakoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "On će opasati bedra pravdom,",
            "poem": 1
          },
          {
            "text": "i bokove će povezati vernošću.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Vuk će boraviti s jagnjetom",
            "poem": 1
          },
          {
            "text": "i ris će ležati s jaretom,",
            "poem": 2
          },
          {
            "text": "tele i lav zajedno će pasti,",
            "poem": 1
          },
          {
            "text": "a dečak će ih voditi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Krava i medvedica će se napasati,",
            "poem": 1
          },
          {
            "text": "i mladunčad njihova zajedno će ležati;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "slično volu, i lav će se slamom hraniti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Iznad jame gujine igraće se odojče,",
            "poem": 1
          },
          {
            "text": "a detence će ručicu zavlačiti u leglo zmijino.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Zlo se više neće činiti, niti će biti nasilja",
            "poem": 1
          },
          {
            "text": "na svetoj gori mojoj,",
            "poem": 2
          },
          {
            "text": "jer će se zemlja ispuniti poznavanjem Gospoda,",
            "poem": 1
          },
          {
            "text": "kao što je vodom ispunjeno more.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Povratak prognanih sunarodnika"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "U dan onaj Jesejev koren će se podići kao zastava na narode, puci će tražiti njega i odmorište njegovo biće slavno."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "U onaj dan Gospodar će po drugi put ispružiti ruku da otkupi ostatak svog naroda, one što su preostali iz Asirije i iz Egipta i iz Patrosa i iz Kuša i iz Elama i iz Senara i iz Amata i sa obala morskih."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Podići će zastavu za puke",
            "poem": 1
          },
          {
            "text": "i sabraće raspršene Izrailjce,",
            "poem": 2
          },
          {
            "text": "i sakupiće raseljene Judejce,",
            "poem": 1
          },
          {
            "text": "sa zemljina sva četiri krila.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Zavist plemena Jefremova nestaće,",
            "poem": 1
          },
          {
            "text": "neprijatelji Jude istrebljeni biće:",
            "poem": 2
          },
          {
            "text": "Jefrem više Judi zavideti neće,",
            "poem": 1
          },
          {
            "text": "niti će Juda Jefremu neprijatelj biti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Oni će za vrat sesti Filistejcima na zapadu;",
            "poem": 1
          },
          {
            "text": "oni će zajedno pleniti plemena na istoku;",
            "poem": 2
          },
          {
            "text": "rukom će svojom držati Edomce i Moavce;",
            "poem": 1
          },
          {
            "text": "njima će biti poslušni potomci Amonovi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Gospod će isušiti",
            "poem": 1
          },
          {
            "text": "zaliv mora egipatskog,",
            "poem": 2
          },
          {
            "text": "rukom će zamahnuti protiv Eufrata,",
            "poem": 1
          },
          {
            "text": "jarom vetra on će nju razbiti",
            "poem": 2
          },
          {
            "text": "na sedam suvih tokova,",
            "poem": 1
          },
          {
            "text": "te će je ljudi prelaziti u obući.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "I biće put ostatku naroda njegova,",
            "poem": 1
          },
          {
            "text": "preživelima iz Asirije,",
            "poem": 2
          },
          {
            "text": "kao što je bio Izrailjcima",
            "poem": 1
          },
          {
            "text": "kad su se podigli iz zemlje egipatske.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
