  "chapter": {
    "number": 30,
    "content": [
      {
        "type": "heading",
        "content": [
          "Protiv izaslanstva u Egipat (I)"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Teško sinovima odmetničkim!",
            "poem": 1
          },
          {
            "text": "– govori Gospod.",
            "poem": 2
          },
          {
            "text": "Oni provode namere što nisu od mene,",
            "poem": 1
          },
          {
            "text": "sklapaju saveze što nisu po Duhu mom;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i greh na greh gomilaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Krenuli su u Egipat dole,",
            "poem": 1
          },
          {
            "text": "a nisu pitali šta ću ja reći;",
            "poem": 2
          },
          {
            "text": "da uteknu u utočište faraonsko,",
            "poem": 1
          },
          {
            "text": "i da se uzdaju u senku egipatsku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Utočište faraonsko biće im na sramotu,",
            "poem": 1
          },
          {
            "text": "i uzdanje u senku egipatsku na porugu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ta glavari njegovi već su u Soanu,",
            "poem": 1
          },
          {
            "text": "poslanici njegovi stigli su u Hanes:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "svi će se posramiti",
            "poem": 1
          },
          {
            "text": "nad narodom beskorisnim,",
            "poem": 2
          },
          {
            "text": "neće im biti na pomoć ni na korist,",
            "poem": 1
          },
          {
            "text": "već na sramotu, pa i za ukor.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Protiv izaslanstva u Egipat (II)"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Proroštvo protiv životinja negevskih:",
          {
            "text": "Kroz zemlju nevolje i bede,",
            "poem": 1
          },
          {
            "text": "lavice i lava koji riču,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ljute guje i krilate zmije ognjene,",
            "poem": 2
          },
          {
            "text": "nose oni blaga svoja na leđima mladih magaraca,",
            "poem": 1
          },
          {
            "text": "i bogatstva svoja na grbama kamila –",
            "poem": 2
          },
          {
            "text": "nose ga narodu beskorisnom.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Zato što je egipatska pomoć prazna i ništavna,",
            "poem": 2
          },
          {
            "text": "zbog toga sam ih nazvao:",
            "poem": 1
          },
          {
            "text": "„Iznemogla Rava",
            "poem": 2
          },
          {
            "noteId": 10
          },
          {
            "text": ".“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Zaveštanje"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Sad dođi, upiši na ploči pred njima",
            "poem": 1
          },
          {
            "text": "i zabeleži u knjizi,",
            "poem": 2
          },
          {
            "text": "te da ostane za budućnost,",
            "poem": 1
          },
          {
            "text": "za vek vekova;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "jer ovo je narod odmetnički, sinovi lažljivi,",
            "poem": 1
          },
          {
            "text": "sinovi koji neće da slušaju Zakon Gospodnji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Oni govore vidovitima:",
            "poem": 1
          },
          {
            "text": "„Okanite se viđenja!“,",
            "poem": 2
          },
          {
            "text": "a videocima:",
            "poem": 1
          },
          {
            "text": "„Ne prorokujte nam poštenje!",
            "poem": 2
          },
          {
            "text": "Govorite što je nama ugodno!",
            "poem": 1
          },
          {
            "text": "Prorokujte nam privide!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Zastranite s puta,",
            "poem": 1
          },
          {
            "text": "skrenite sa staze,",
            "poem": 2
          },
          {
            "text": "uklonite nam sa očiju",
            "poem": 1
          },
          {
            "text": "Svetitelja Izrailjeva!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Zato Svetitelj Izrailjev govori:",
          {
            "text": "„Zato što reč ovu prezirete,",
            "poem": 1
          },
          {
            "text": "a oslanjate se na opakost i prevaru,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i na njih se podupirete,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "zato će vam ta krivica biti kao pukotina,",
            "poem": 1
          },
          {
            "text": "što se izbočila na zidu visokom,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "koji će se srušiti iznenada, u trenutku,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "i srušiće se kao što se ruši sud grnčarski,",
            "poem": 1
          },
          {
            "text": "razbije se i niko ga ne žali,",
            "poem": 2
          },
          {
            "text": "te među krhotinama njegovim ni ulomak se ne nađe,",
            "poem": 1
          },
          {
            "text": "da se uzme žeravica sa ognjišta",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ili zagrabi voda sa studenca.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Jer govori Gospodar Gospod, Svetitelj Izrailjev:",
          {
            "text": "„U pokajanju i spokojstvu bićete spaseni;",
            "poem": 1
          },
          {
            "text": "u smirenosti i osloncu vaša je sila;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ali vi niste hteli.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Rekli ste: ’Ne, jer ćemo na konjima pobeći.’",
            "poem": 1
          },
          {
            "text": "Zato ćete bežati.",
            "poem": 2
          },
          {
            "text": "’Jahaćemo onda u galopu.’",
            "poem": 1
          },
          {
            "text": "Zato će vaši gonioci brži biti:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "vas hiljadu bežaće",
            "poem": 1
          },
          {
            "text": "kad jedan podvikne;",
            "poem": 2
          },
          {
            "text": "kad podviknu petorica,",
            "poem": 1
          },
          {
            "text": "trkom ćete bežati,",
            "poem": 2
          },
          {
            "text": "dok od vas ne ostane",
            "poem": 1
          },
          {
            "text": "kao kolac na vrhu gore",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ili kao oznaka na brdu.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ipak, Gospod čezne da vam se smiluje,",
            "poem": 1
          },
          {
            "text": "i zato čezne da vas oblagodati,",
            "poem": 2
          },
          {
            "text": "jer Gospod je Bog pravedni.",
            "poem": 1
          },
          {
            "text": "Blago svima koji čeznu za njim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Buduće blagostanje"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "O, narode sionski, koji stanuješ u Jerusalimu. Nemoj nikako plakati. On će jamačno biti naklonjen glasu vapaja tvojega. Čim te čuje, odgovoriće ti."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "I Gospodar će vam dati hleb patnički i vodu nevolje, pa se više neće kriti tvoji učitelji, i tvoje će oči gledati učitelje tvoje."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "I uši tvoje slušaće reč iza leđa tvojih gde se govori: „To je put, njime idite!“, bilo da skrećete nadesno ili nalevo."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Tada ćeš smatrati nečistima svoje kumire posrebrene i svoje idole zlatom optočene. Odbacićeš ih kao izliv ženski i reći ćeš: „Napolje!“"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Tada će dati kišu tvom semenu što poseješ na njivi, a hleb što će ga njiva roditi biće obilat i hranljiv. Stoka tvoja će pasti u onaj dan, po prostranim pašnjacima."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Volovi i magarci koji služe za njivu ješće osoljenu hranu, ovejanu lopatom i rešetom."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "I na svakoj gori i na svakoj uzvišici biće potoka i tokova, u dan silnoga pokolja kad se kule budu rušile."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Tada će mesečina biti kao sunčeva svetlost, a sunčeva svetlost će biti sedam puta jača, kao svetlost sedam dana – u dan kad Gospod zavije prelome narodu svome, i izleči rane udaraca njegovih."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Propast Asirije"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Gle, Gospod lično iz daleka dolazi,",
            "poem": 1
          },
          {
            "text": "gnev njegov gori, breme biva otežano.",
            "poem": 2
          },
          {
            "text": "Usne njegove jarosti su pune,",
            "poem": 1
          },
          {
            "text": "jezik mu je vatra što proždire,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "a Duh je njegov kao potok nabujali,",
            "poem": 1
          },
          {
            "text": "što se do grla popeo.",
            "poem": 2
          },
          {
            "text": "On dolazi da svetinu prorešeta rešetom pogubnim,",
            "poem": 1
          },
          {
            "text": "i da postavi uzde zavodljive",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "u čeljust narodima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Pesma će vam biti",
            "poem": 1
          },
          {
            "text": "kao u pretprazničkim noćima,",
            "poem": 2
          },
          {
            "text": "kad su srca vesela",
            "poem": 1
          },
          {
            "text": "kao kod onog koji ide uz zvuke frule",
            "poem": 2
          },
          {
            "text": "da dođe na Goru Gospodnju,",
            "poem": 1
          },
          {
            "text": "na Stenu Izrailjevu,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "i začuće se veličanstveni glas Gospodnji,",
            "poem": 1
          },
          {
            "text": "i pokazaće se udar ruke njegove",
            "poem": 2
          },
          {
            "text": "u jarosnom gnevu, u vatri što proždire,",
            "poem": 1
          },
          {
            "text": "iz provale oblaka i oluje,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i iz grada koji je kao tucanik,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "jer od glasa Gospodnjeg prepašće se Asirac,",
            "poem": 1
          },
          {
            "text": "šibom kojom on šiba.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "I kad god udari palica određena",
            "poem": 1
          },
          {
            "text": "kojom će se Gospod odmoriti na njemu,",
            "poem": 2
          },
          {
            "text": "s bubnjevima i harfama, u borbenim pokličima,",
            "poem": 1
          },
          {
            "text": "protiv njega on se bori.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Već je pripravljen Tofet,",
            "poem": 1
          },
          {
            "text": "upravo je spreman za cara,",
            "poem": 2
          },
          {
            "text": "mnogo vatre i mnogo drva.",
            "poem": 1
          },
          {
            "text": "On je produbio, proširio lomaču za njega,",
            "poem": 2
          },
          {
            "text": "povećao vatru i drva.",
            "poem": 1
          },
          {
            "text": "Dah Gospodnji je kao potok od sumpora,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "razgara se na njemu.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 10,
        "caller": "+",
        "text": "30,7 Ime morske nemani koje odslikava haos, a ponekad Egipat.",
