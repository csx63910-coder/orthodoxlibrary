  "chapter": {
    "number": 48,
    "content": [
      {
        "type": "heading",
        "content": [
          "Gospod – gospodar budućnosti"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "„Slušaj ovo, dome Jakovljev,",
            "poem": 1
          },
          {
            "text": "koji se nazivate imenom Izrailjevim",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i koji ste izašli iz voda Judinih,",
            "poem": 2
          },
          {
            "text": "koji se zaklinjete imenom Gospodnjim,",
            "poem": 1
          },
          {
            "text": "spominjete Boga Izrailjeva",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ne u istini i ne u pravednosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Jer po Svetom Gradu vi se nazivate",
            "poem": 1
          },
          {
            "text": "i na Boga Izrailjeva vi se oslanjate,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "njegovo je ime: Gospod nad vojskama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Od početka, od davnina obaveštavam,",
            "poem": 1
          },
          {
            "text": "iz mojih usta je izašlo",
            "poem": 2
          },
          {
            "text": "i objaviću što se čini iznenada,",
            "poem": 1
          },
          {
            "text": "i to se zbilo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Iako sam znao da si tvrdokoran,",
            "poem": 1
          },
          {
            "text": "i da je vrat tvoj žila gvozdena,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i da je čelo tvoje bronza;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "ipak sam ti već onda najavio,",
            "poem": 1
          },
          {
            "text": "obavestio te pre nego se zbude;",
            "poem": 2
          },
          {
            "text": "da ne rekneš:",
            "poem": 1
          },
          {
            "text": "’Moj kip to učini,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i moj lik rezani i moj lik liveni to zapovediše.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Čuo si, pogledaj sve to.",
            "poem": 1
          },
          {
            "text": "Zar nećete objavljivati?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "I novo ćeš od sada slušati od mene,",
            "poem": 1
          },
          {
            "text": "tajanstveno, što znao nisi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Sada je stvoreno,",
            "poem": 1
          },
          {
            "text": "a nije od ranije i pre ovog dana,",
            "poem": 2
          },
          {
            "text": "što ni čuo nisi; da ne rekneš:",
            "poem": 1
          },
          {
            "text": "’Gle, to sam već znao.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Niti si čuo, niti si znao,",
            "poem": 1
          },
          {
            "text": "niti se uši tvoje od pre otvoriše.",
            "poem": 2
          },
          {
            "text": "Ta, znao sam da ćeš izneveriti",
            "poem": 1
          },
          {
            "text": "i da su te nazvali otpadnikom čim si se rodio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Zbog imena svojega sputavam gnev svoj,",
            "poem": 1
          },
          {
            "text": "i zbog časti svoje uzdržavam se prema tebi,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "inače bih te istrebio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Evo, pretopiću te, ali ne kao srebro;",
            "poem": 1
          },
          {
            "text": "pročišćavam te u topionici nevoljničkoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Zbog sebe, zbog sebe ću učiniti.",
            "poem": 1
          },
          {
            "text": "Zar da se bogohuli?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "I slavu svoju drugom dati neću.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Gospod blagovesti svog miljenika"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "„Čuj mene, Jakove,",
            "poem": 1
          },
          {
            "text": "i Izrailju, koga sam pozvao:",
            "poem": 2
          },
          {
            "text": "Ja jesam,",
            "poem": 1
          },
          {
            "text": "ja sam Prvi, ja sam i Poslednji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ruka je moja i zemlju utemeljila,",
            "poem": 1
          },
          {
            "text": "a desnica moja nebesa je rasprostrla,",
            "poem": 2
          },
          {
            "text": "kad ja njih pozovem,",
            "poem": 1
          },
          {
            "text": "skupa će se postrojiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Skupite se svi i poslušajte:",
            "poem": 1
          },
          {
            "text": "Ko je od njih to najavio?",
            "poem": 2
          },
          {
            "text": "Onaj koga Gospod voli",
            "poem": 1
          },
          {
            "text": "volju njegovu će učiniti nad Vavilonom",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i nad potomstvom njegovim, Haldejcima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ja, ja sam rekao,",
            "poem": 1
          },
          {
            "text": "njega sam pozvao,",
            "poem": 2
          },
          {
            "text": "njega vodio,",
            "poem": 1
          },
          {
            "text": "i njegov put unapredio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Pristupite mi i poslušajte ovo:",
          {
            "text": "Nisam vam od početka u tajnosti govorio,",
            "poem": 1
          },
          {
            "text": "i bio sam tamo kad se to događalo.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "A sad me šalje Gospodar Gospod",
            "poem": 1
          },
          {
            "text": "i Duh njegov.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Šta će biti sa Izrailjem?"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Govori Gospod, Otkupitelj tvoj,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Svetitelj Izrailjev:",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Ja, Gospod Bog tvoj,",
            "poem": 1
          },
          {
            "text": "učim te na dobrobit,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "upućujem te kojim ćeš putem ići.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "O, da si se pokorio mojim zapovestima,",
            "poem": 1
          },
          {
            "text": "mir bi tvoj bio kao reka,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i pravednost tvoja kao talasi morski.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Potomstva bi tvojeg bilo kao peska,",
            "poem": 1
          },
          {
            "text": "a poroda tvoga kao njegovih zrnaca.",
            "poem": 2
          },
          {
            "text": "Ne bi se zatrlo i ne bi se izbrisalo",
            "poem": 1
          },
          {
            "text": "ime njegovo pred licem mojim.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Pesma o izlasku iz Vavilona"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Izađite iz Vavilona!",
            "poem": 1
          },
          {
            "text": "Bežite iz Haldeje!",
            "poem": 2
          },
          {
            "text": "Glasom uskliktalim blagoslovite;",
            "poem": 1
          },
          {
            "text": "ovo objavljujte;",
            "poem": 2
          },
          {
            "text": "to razglasite do kraja zemlje.",
            "poem": 1
          },
          {
            "text": "Govorite: „Otkupio je Gospod svog slugu Jakova!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "I nisu bili žedni dok su išli pustošima,",
            "poem": 1
          },
          {
            "text": "vodu im je iz stene natočio,",
            "poem": 2
          },
          {
            "text": "i stenu je rascepio",
            "poem": 1
          },
          {
            "text": "i voda je potekla.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "„Nema mira!",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "– govori Gospod opakima.",
            "poem": 1
          }
        ]
      }
    ],
