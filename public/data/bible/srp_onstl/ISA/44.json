  "chapter": {
    "number": 44,
    "content": [
      {
        "type": "heading",
        "content": [
          "Bog će blagosloviti Jevreje"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "A sad poslušaj, Jakove, slugo moj,",
            "poem": 1
          },
          {
            "text": "i Izrailju, kog sam izabrao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Govori Gospod",
            "poem": 1
          },
          {
            "text": "koji te je načinio, i koji te je od utrobe sazdao,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "tebi pomaže:",
            "poem": 2
          },
          {
            "text": "Ne boj se, Jakove, moj slugo,",
            "poem": 1
          },
          {
            "text": "Ješurune, kog sam izabrao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jer ću vodu izliti na žedno tle,",
            "poem": 1
          },
          {
            "text": "i vrela na sušnu zemlju.",
            "poem": 2
          },
          {
            "text": "Izliću Duh svoj na potomstvo tvoje,",
            "poem": 1
          },
          {
            "text": "i blagoslov na pokolenja tvoja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "I rašće kao da su među travom,",
            "poem": 1
          },
          {
            "text": "kao vrbe iz tekuće vode.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Jedan će reći: ’Ja sam Gospodnji!’",
            "poem": 1
          },
          {
            "text": "drugi će se zvati imenom Jakovljevim,",
            "poem": 2
          },
          {
            "text": "treći će sebi na ruci ispisati: ’Gospodnji’,",
            "poem": 1
          },
          {
            "text": "i usvojiće ime Izrailjevo.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Nema Boga osim Gospoda"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Govori Gospod,",
            "poem": 1
          },
          {
            "text": "Car Izrailjev i njegov Otkupitelj,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Gospod nad vojskama:",
            "poem": 2
          },
          {
            "text": "„Ja sam Prvi i ja sam Poslednji,",
            "poem": 1
          },
          {
            "text": "osim mene drugog Boga nema.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ko je kao ja? Neka ustane i kaže,",
            "poem": 1
          },
          {
            "text": "neka se javi i nek to objavi,",
            "poem": 2
          },
          {
            "text": "i nek to razloži preda mnom.",
            "poem": 1
          },
          {
            "text": "Otkad postavih narod od večnosti,",
            "poem": 2
          },
          {
            "text": "i stvari što će doći,",
            "poem": 1
          },
          {
            "text": "neka najavi šta će se zbiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ne plašite se i ne bojte se:",
            "poem": 1
          },
          {
            "text": "nisam li vam odavno objavio i najavio?",
            "poem": 2
          },
          {
            "text": "I vi ste moji svedoci:",
            "poem": 1
          },
          {
            "text": "ima li Boga osim mene?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ne, nema Stene za koju ja znam.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Protiv kipova i likova"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Koji prave kipove,",
            "poem": 1
          },
          {
            "text": "svi su oni ništavila,",
            "poem": 2
          },
          {
            "text": "i dragocenosti njihove ne koriste ničemu.",
            "poem": 1
          },
          {
            "text": "Svedoci njihovi ne vide i ne znaju, te će biti na sramotu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ko pravi boga i lije kip,",
            "poem": 1
          },
          {
            "text": "da od toga koristi nema?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Gle, osramotiće se svi drugovi njegovi i umetnici.",
            "poem": 1
          },
          {
            "text": "Neka se saberu svi: i oni su delo ljudsko.",
            "poem": 2
          },
          {
            "text": "Neka se postave:",
            "poem": 1
          },
          {
            "text": "zajedno će se prestraviti i postideti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Oblikuje gvožđe alatkom",
            "poem": 1
          },
          {
            "text": "i radi na žaru uglja,",
            "poem": 2
          },
          {
            "text": "čekićima ga doteruje",
            "poem": 1
          },
          {
            "text": "i snažnom ga rukom obrađuje.",
            "poem": 2
          },
          {
            "text": "Ne hrani se i nema snage,",
            "poem": 1
          },
          {
            "text": "vode ne pije i iscrpljuje se.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Oblikuje drvo, uzima meru,",
            "poem": 1
          },
          {
            "text": "pisaljkom ga obeležava,",
            "poem": 2
          },
          {
            "text": "obrađuje ga dletom, ocrtava ga šestarom,",
            "poem": 1
          },
          {
            "text": "i delje ga po uzoru na ljudski lik,",
            "poem": 2
          },
          {
            "text": "kao lepotu ljudsku,",
            "poem": 1
          },
          {
            "text": "da bude postavljen u domu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Za sebe je nasekao kedre",
            "poem": 1
          },
          {
            "text": "i uzeo kiparise i hrast,",
            "poem": 2
          },
          {
            "text": "što je za sebe negovao među drvetima šumskim,",
            "poem": 1
          },
          {
            "text": "zasadio bor što je porastao na kiši.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "I čoveku je to kao gorivo;",
            "poem": 1
          },
          {
            "text": "uzima od toga da se ogreje;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pa loži i peče hleb.",
            "poem": 2
          },
          {
            "text": "Međutim, od toga delje i boga",
            "poem": 1
          },
          {
            "text": "pred kojim pada ničice",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i pravi kip i klanja mu se.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Polovinom loži vatru,",
            "poem": 1
          },
          {
            "text": "tom polovinom peče meso na žaru,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jede pečenje i biva sit,",
            "poem": 2
          },
          {
            "text": "te se greje i govori:",
            "poem": 1
          },
          {
            "text": "„Ah, grejem se i kraj vatre uživam.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "A od ostatka pravi boga, idola svoga;",
            "poem": 1
          },
          {
            "text": "pada pred njim ničice",
            "poem": 2
          },
          {
            "text": "i klanja mu se i moli mu se:",
            "poem": 1
          },
          {
            "text": "„Izbavi me, jer ti si moj bog.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ne znaju i ne rasuđuju,",
            "poem": 1
          },
          {
            "text": "jer su im oči zamazane pa ne vide;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i srca njihova pa ne razumeju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Takav ne razmišlja i nema u njega znanja",
            "poem": 1
          },
          {
            "text": "ni rasuđivanja da kaže:",
            "poem": 2
          },
          {
            "text": "„Polovinom od ovoga ložio sam vatru,",
            "poem": 1
          },
          {
            "text": "pa sam na žaru ispekao hleb,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ispržio sam meso i pojeo ga.",
            "poem": 2
          },
          {
            "text": "A od ostatka sam načinio gnusobu.",
            "poem": 1
          },
          {
            "text": "Zar da se klanjam komadu drveta?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Taj se stara za pepeo.",
            "poem": 1
          },
          {
            "text": "Njega zavodi prevarno srce,",
            "poem": 2
          },
          {
            "text": "te ne može da izbavi svoj život,",
            "poem": 1
          },
          {
            "text": "a neće da kaže:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Nije li obmana u mojoj desnici?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Bog će se smilovati"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "„Seti se ovoga, Jakove,",
            "poem": 1
          },
          {
            "text": "i Izrailju, jer si sluga moj!",
            "poem": 2
          },
          {
            "text": "Ja sam te sazdao i ti si sluga moj;",
            "poem": 1
          },
          {
            "text": "Izrailju, ja tebe da zaboravim neću!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Kao maglu rasterao sam tvoje prestupe,",
            "poem": 1
          },
          {
            "text": "i grehe tvoje kao da su oblak.",
            "poem": 2
          },
          {
            "text": "Meni se vrati,",
            "poem": 1
          },
          {
            "text": "jer ja sam te otkupio.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Radosnica"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Kličite, nebesa, ovo je delo Gospodnje!",
            "poem": 1
          },
          {
            "text": "Orite se, dubine zemljine!",
            "poem": 2
          },
          {
            "text": "Odjekujte radosno, planine,",
            "poem": 1
          },
          {
            "text": "i vi, šume, sa svim svojim drvećem!",
            "poem": 2
          },
          {
            "text": "Jer Gospod je otkupio Jakova,",
            "poem": 1
          },
          {
            "text": "i proslavio se u Izrailju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Pesma o sili Gospodnjoj"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Govori Gospod, Otkupitelj tvoj,",
            "poem": 1
          },
          {
            "text": "i Sazdatelj tvoj od utrobe:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Ja sam Gospod koji sam sve učinio,",
            "poem": 1
          },
          {
            "text": "ja sam lično razapeo nebesa,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i bez ikoga zasvodio zemlju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Ja sprečavam vračarska znamenja,",
            "poem": 1
          },
          {
            "text": "i gatare pretvaram u ludake;",
            "poem": 2
          },
          {
            "text": "teram mudrace da ustuknu",
            "poem": 1
          },
          {
            "text": "i znanje preobraćam u bezumlje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Potvrđujem što sluga mu kaže,",
            "poem": 1
          },
          {
            "text": "ispunjavam svojih glasnika namere.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "’Naseli se!’ – govorim Jerusalimu,",
            "poem": 1
          },
          {
            "text": "i gradovima Judinim: ’Sagradite se!’",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "A ja ću podići što je razrušeno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Govorim okeanu: ’Presahni!",
            "poem": 1
          },
          {
            "text": "Tvoje reke presušujem.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "’Pastiru moj’ – govorim Kiru,",
            "poem": 1
          },
          {
            "text": "i on će sve moje želje ispuniti.",
            "poem": 2
          },
          {
            "text": "’Sagradi se!’ – govoriće Jerusalimu,",
            "poem": 1
          },
          {
            "text": "a Domu: ’Utemelji se!’“",
            "poem": 2
          }
        ]
      }
    ],
