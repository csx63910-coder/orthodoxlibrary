  "chapter": {
    "number": 47,
    "content": [
      {
        "type": "heading",
        "content": [
          "Tužbalica nad Vavilonom"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "„Spusti se i sedi u prašinu,",
            "poem": 1
          },
          {
            "text": "device, ćerko vavilonska.",
            "poem": 2
          },
          {
            "text": "Sedi na zemlju.",
            "poem": 1
          },
          {
            "text": "Nema prestola, ćerko haldejska!",
            "poem": 2
          },
          {
            "text": "Jer neće te više zvati",
            "poem": 1
          },
          {
            "text": "nežnom i osećajnom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Uhvati mlinsko kamenje i melji brašno,",
            "poem": 1
          },
          {
            "text": "svuci svoj ogrtač,",
            "poem": 2
          },
          {
            "text": "skut podigni, svuci s bedara,",
            "poem": 1
          },
          {
            "text": "prelazi reke.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Neka se pojavi golotinja tvoja,",
            "poem": 1
          },
          {
            "text": "još neka se pokaže sramota tvoja.",
            "poem": 2
          },
          {
            "text": "Osvetiću se",
            "poem": 1
          },
          {
            "text": "i neće me sprečiti niko.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Otkupitelj naš, njegovo je ime:",
            "poem": 1
          },
          {
            "text": "Gospod nad vojskama, Svetitelj Izrailjev.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "„Sedi ćutke i povuci se u tamu,",
            "poem": 1
          },
          {
            "text": "ćerko haldejska,",
            "poem": 2
          },
          {
            "text": "jer te više neće zvati",
            "poem": 1
          },
          {
            "text": "gospodaricom nad carstvima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Na svoj sam se narod razgnevio,",
            "poem": 1
          },
          {
            "text": "svoju sam baštinu oskrnavio,",
            "poem": 2
          },
          {
            "text": "i tebi ih u ruke predao;",
            "poem": 1
          },
          {
            "text": "a ti prema njima milost ne pokaza:",
            "poem": 2
          },
          {
            "text": "jarmom tvojim",
            "poem": 1
          },
          {
            "text": "starce si pretovarila.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "I govorila si:",
            "poem": 1
          },
          {
            "text": "’Doveka ću biti gospodarica!’,",
            "poem": 2
          },
          {
            "text": "a u tvoje srce to nije dospelo,",
            "poem": 1
          },
          {
            "text": "nisi se setila šta na kraju biva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "A sada slušaj ovo, razvratnice,",
            "poem": 1
          },
          {
            "text": "koja boraviš u spokojstvu,",
            "poem": 2
          },
          {
            "text": "te u srcu progovaraš svome:",
            "poem": 1
          },
          {
            "text": "’Ja sam i druge nema,",
            "poem": 2
          },
          {
            "text": "neću postati udovica,",
            "poem": 1
          },
          {
            "text": "niti decu izgubiti svoju.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Pa oboje će doći na tebe,",
            "poem": 1
          },
          {
            "text": "trenutno, u istom danu:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "izgubićeš i decu i muža;",
            "poem": 2
          },
          {
            "text": "u celini će doći na tebe,",
            "poem": 1
          },
          {
            "text": "iako vračaš mnogostruko",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i čaraš veoma.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "U zloću svoju i ti si se pouzdala",
            "poem": 1
          },
          {
            "text": "govoreći: ’Ne vidi me niko.’",
            "poem": 2
          },
          {
            "text": "Mudrost tvoja i znanje tvoje, one te zavedoše,",
            "poem": 1
          },
          {
            "text": "te govoriš u srcu svojemu:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "’Ja sam i druge nema.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Doći će zloća i na tebe,",
            "poem": 1
          },
          {
            "text": "i nećeš znati da ih sprečiš;",
            "poem": 2
          },
          {
            "text": "i stuštiće se nevolja na te,",
            "poem": 1
          },
          {
            "text": "i nećeš moći odvratiti;",
            "poem": 2
          },
          {
            "text": "i doći će na te iznenada",
            "poem": 1
          },
          {
            "text": "propast za koju ne znaš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "De, ostani na tvojim čaranjima,",
            "poem": 1
          },
          {
            "text": "i na mnoštvu tvojih vračanja,",
            "poem": 2
          },
          {
            "text": "na kojima se trudiš od mladosti;",
            "poem": 1
          },
          {
            "text": "možda se i okoristiš, možda strah doneseš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Rintala si zbog mnogih savetnika tvojih.",
            "poem": 1
          },
          {
            "text": "Hajde, neka ustanu i spasu te:",
            "poem": 2
          },
          {
            "text": "oni ’premeravaju’ po nebesima,",
            "poem": 1
          },
          {
            "text": "oni ’vide’ po zvezdama,",
            "poem": 2
          },
          {
            "text": "oni ’saznavaju’ po mladom mesecu;",
            "poem": 1
          },
          {
            "text": "šta će tebe snaći.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ta, oni će biti kao strnjika,",
            "poem": 1
          },
          {
            "text": "oganj će ih spaliti;",
            "poem": 2
          },
          {
            "text": "sami sebe izbaviti neće",
            "poem": 1
          },
          {
            "text": "iz plamene ruke;",
            "poem": 2
          },
          {
            "text": "neće ostati ni žeravice da se neko ogreje,",
            "poem": 1
          },
          {
            "text": "ni vatre da kraj nje posedi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Takvi će postati oni",
            "poem": 1
          },
          {
            "text": "oko kojih si se zamarala,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "tvoji trgovčići od mladosti:",
            "poem": 2
          },
          {
            "text": "svaki će na svoju stranu otperjati,",
            "poem": 1
          },
          {
            "text": "nikog neće biti da te spase.“",
            "poem": 2
          }
        ]
      }
    ],
