  "chapter": {
    "number": 21,
    "content": [
      {
        "type": "heading",
        "content": [
          "Propast Vavilona"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Proroštvo primorskoj pustinji.",
          {
            "text": "Kao što vihori po Negevu huje,",
            "poem": 1
          },
          {
            "text": "iz pustinje pristižu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "iz zemlje strahotne.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Otkriveno mi je strašno viđenje –",
            "poem": 1
          },
          {
            "text": "podlac podlost čini, pustošnik pustoši:",
            "poem": 2
          },
          {
            "text": "„Na juriš, Elame! Na opsadu, Midijo!",
            "poem": 1
          },
          {
            "text": "Dokrajčiću sve uzdahe njene!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Zato bedra moja probadaju probadi;",
            "poem": 1
          },
          {
            "text": "bolovi me spopadaju kao porodilju;",
            "poem": 2
          },
          {
            "text": "smućen sam nad onim što čujem,",
            "poem": 1
          },
          {
            "text": "užasnut sam pred onim što vidim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Zbunjeno je srce moje,",
            "poem": 1
          },
          {
            "text": "groza me snađe.",
            "poem": 2
          },
          {
            "text": "Suton mog uživanja",
            "poem": 1
          },
          {
            "text": "pretvori se u jezivost.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Postavi sto!",
            "poem": 1
          },
          {
            "text": "Prostiri prostirku!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Jedi! Pij!",
            "poem": 2
          },
          {
            "text": "Ustajte, glavari!",
            "poem": 1
          },
          {
            "text": "Mažite štitove!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Jer Gospod je meni ovako rekao:",
          {
            "text": "„Idi, postavi stražara!",
            "poem": 1
          },
          {
            "text": "Pa što vidi, to neka ti javi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ako vidi konjanike,",
            "poem": 1
          },
          {
            "text": "kako jašu po dvojica,",
            "poem": 2
          },
          {
            "text": "jahače na magarcima,",
            "poem": 1
          },
          {
            "text": "jahače na kamilama,",
            "poem": 2
          },
          {
            "text": "neka dobro pazi,",
            "poem": 1
          },
          {
            "text": "neka pazi što pažljivije.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "I povika stražar",
          {
            "noteId": 7
          },
          "sa stražarnice:",
          {
            "text": "„Gospodaru moj, stojim danju neprestano,",
            "poem": 1
          },
          {
            "text": "i celu noć na banku gde sam postavljen.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "I gle ovo: dolaze konjanici,",
            "poem": 1
          },
          {
            "text": "jašu po dvojica.",
            "poem": 2
          },
          {
            "text": "Tada on progovori i reče:",
            "poem": 1
          },
          {
            "text": "’Pade, pade Vavilon!",
            "poem": 2
          },
          {
            "text": "Svi kipovi njegovih bogova",
            "poem": 1
          },
          {
            "text": "o zemlju se razbiše.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Vršeno moje, zrno s gumna mojeg! –",
            "poem": 1
          },
          {
            "text": "što sam čuo",
            "poem": 2
          },
          {
            "text": "od Gospoda nad vojskama, Boga Izrailjeva,",
            "poem": 1
          },
          {
            "text": "to vam objavljujem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Reč za Dumu21,11 Duma znači tišina, i igra je reči sa imenom Edom."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Proroštvo o Dumi.",
          {
            "text": "Dođe mi zov iz Sira:",
            "poem": 1
          },
          {
            "text": "„Stražari, koje je doba noći?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Stražari, koje je doba noći?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Stražar odgovara:",
            "poem": 1
          },
          {
            "text": "„Dolazi jutro, pa opet noć.",
            "poem": 2
          },
          {
            "text": "Ako ćete iskati, ištite!",
            "poem": 1
          },
          {
            "text": "Vratite se! Dođite!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Opomena Arapima"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Proroštvo Arapima.",
          {
            "text": "U čestarima arapskim počivate,",
            "poem": 1
          },
          {
            "text": "karavani dedanski.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Pristupite žednom, iznesite vodu,",
            "poem": 1
          },
          {
            "text": "stanovnici zemlje temeske,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "s hlebom svojim pred begunce izađite.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Jer oni beže pred mačevima,",
            "poem": 1
          },
          {
            "text": "ispred mača isukanog,",
            "poem": 2
          },
          {
            "text": "i ispred luka napetoga,",
            "poem": 1
          },
          {
            "text": "i ispred boja žestokoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Reč protiv Kidra"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Da, ovako mi je rekao Gospodar: „Još jedna godina, kao što su godine najamničke, i iščeznuće sva slava kedarska."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Od mnogobrojnih strelaca među muškarcima iz Kedra, malo će ih ostati. Jer je to rekao Gospod, Bog Izrailjev.“"
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 7,
        "caller": "+",
        "text": "21,8 U izvornom tekstu stoji lav, što čini teškoću u razumevanju, posebno prema postavljanju stražara u st. 6. Najverovatnije je zbog sličnosti ove dve reči na jevrejskom došlo do greške u prepisivanju.",
        "reference": {
          "chapter": 21,
          "verse": 8
        }
      }
    ]
