  "chapter": {
    "number": 19,
    "content": [
      {
        "type": "heading",
        "content": [
          "Reč protiv Egipta"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Proroštvo protiv Egipta.",
          {
            "text": "Evo, Gospod jaše na laku oblaku,",
            "poem": 1
          },
          {
            "text": "i u Egipat stiže.",
            "poem": 2
          },
          {
            "text": "Drhću pred njim egipatski idoli,",
            "poem": 1
          },
          {
            "text": "Egipćanima srce u grudima obamire.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Podbošću Egipćane protiv Egipćana,",
            "poem": 1
          },
          {
            "text": "i čovek će se boriti protiv brata svojega,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i čovek protiv druga svojega,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "grad protiv grada,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "carstvo protiv carstva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Egipat će klonuti duhom.",
            "poem": 1
          },
          {
            "text": "Ja ću sprečiti njegove namere,",
            "poem": 2
          },
          {
            "text": "te će tražiti kod idola i kod vračara,",
            "poem": 1
          },
          {
            "text": "kod prizivača duhova i kod vidovnjaka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Egipćane ću ja predati",
            "poem": 1
          },
          {
            "text": "u ruke okrutnom gospodaru;",
            "poem": 2
          },
          {
            "text": "car žestoki nad njima će vladati",
            "poem": 1
          },
          {
            "text": "– govori Gospodar Gospod nad vojskama.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Iz reke će ispariti vode,",
            "poem": 1
          },
          {
            "text": "korita će rečna presahnuti i presušiti,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "usmrdeće se prokopi,",
            "poem": 1
          },
          {
            "text": "sahnuće rukavci egipatski i presušiće.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Uvenuće trska i rogoz.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Livade kraj Nila, kraj ušća Nila,",
            "poem": 1
          },
          {
            "text": "i svi usevi kraj Nila usahnuće;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "biće odbačeni i neće ih više biti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "I tugovaće ribari,",
            "poem": 1
          },
          {
            "text": "i jadikovaće koji bacaju u Nil udicu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i biće uplakani koji mreže po vodi bacaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "I postideće se koji obrađuju lan,",
            "poem": 1
          },
          {
            "text": "vlačari i tkači platna beloga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Srušene su ustave njegove,",
            "poem": 1
          },
          {
            "text": "rastužiće se koji grade za platu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ah, glavari soanski su ludaci,",
            "poem": 1
          },
          {
            "text": "mudri savetnici faraonovi savetuju glupavo.",
            "poem": 2
          },
          {
            "text": "Kako to govorite faraonu:",
            "poem": 1
          },
          {
            "text": "„Učenik sam mudrih ljudi,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "učenik sam drevnih careva.“?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Gde li su ti tvoji mudraci?",
            "poem": 1
          },
          {
            "text": "Neka ti dojave i neka obznane:",
            "poem": 2
          },
          {
            "text": "Šta je Gospod nad vojskama",
            "poem": 1
          },
          {
            "text": "za Egipat naumio?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Glavari soanski su ludi,",
            "poem": 1
          },
          {
            "text": "prevariše se knezovi nofski,",
            "poem": 2
          },
          {
            "text": "oni zavode Egipat,",
            "poem": 1
          },
          {
            "text": "njegove plemenske uglednike.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Gospod je u njih ulio duha zabune,",
            "poem": 1
          },
          {
            "text": "te Egipat smućuju",
            "poem": 2
          },
          {
            "text": "u svemu što on čini,",
            "poem": 1
          },
          {
            "text": "jer se tetura kao pijanica kad povraća.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Više neće biti u Egiptu rada,",
            "poem": 1
          },
          {
            "text": "bilo da ga čini glava ili rep,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "bilo palma ili sita.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Egipat i Asirija dolaze Bogu"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "U dan onaj Egipćani će biti kao žene, drhtaće i strepeće kad Gospod nad vojskama na njih rukom zamahne, kojom on maše nad njima."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Tle judejsko na užas Egiptu će biti; bojaće se ko god mu ga pomene, zbog namere što je Gospod nad vojskama za Egipat naumio."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "U dan onaj biće u zemlji egipatskoj pet gradova gde će se jezikom hananskim govoriti i gde će se Gospodu nad vojskama zaklinjati; „grad Aheres",
          {
            "noteId": 6
          },
          "“ reći će za jednoga."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "U dan onaj biće žrtvenik Gospodnji usred zemlje egipatske, i stub posvećen Gospodu blizu granice njegove."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "I biće znak i svedočanstvo za Gospoda nad vojskama u zemlji egipatskoj: kad protiv tlačitelja prizovu Gospoda, on će im poslati spasitelja i vojskovođu – izbavitelja."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "I Gospod će sebe obznaniti Egipćanima, i Egipćani će poznati Gospoda u dan onaj, i služiće mu žrtvama i prinosima, zavetovaće Gospodu zavete i izvršavaće."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Gospod će Egipćane udariti teško, ali će ih isceliti; i oni će se Gospodu obratiti, i on će ih uslišiti i izlečiti."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "U dan onaj drum će biti od Egipta do Asirije: Asirci će dolaziti u Egipat i Egipćani u Asiriju. Egipćani i Asirci služiće Gospodu."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "U dan onaj Izrailj će biti treći sa Egiptom i Asirijom, da budu blagoslov usred zemlje."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Blagosloviće ih Gospod nad vojskama:",
          {
            "text": "„Neka je blagosloven – govoriće se –",
            "poem": 1
          },
          {
            "text": "moj narod egipatski,",
            "poem": 2
          },
          {
            "text": "i delo ruku mojih, Asirija,",
            "poem": 1
          },
          {
            "text": "i dostojanje moje, Izrailj.“",
            "poem": 2
          }
        ]
      }
    ],
