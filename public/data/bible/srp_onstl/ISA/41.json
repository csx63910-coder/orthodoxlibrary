  "chapter": {
    "number": 41,
    "content": [
      {
        "type": "heading",
        "content": [
          "Vladar sa istoka – opomena od Gospoda"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "„Umuknite preda mnom, ostrva,",
            "poem": 1
          },
          {
            "text": "i neka snagu obnove narodi.",
            "poem": 2
          },
          {
            "text": "Neka se primaknu, pa neka progovore;",
            "poem": 1
          },
          {
            "text": "pristupimo na sud zajedno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ko je sa istoka podigao pravednost,",
            "poem": 1
          },
          {
            "text": "pozvao ga do svojih stopa,",
            "poem": 2
          },
          {
            "text": "daje mu pred sobom narode",
            "poem": 1
          },
          {
            "text": "i careve pokorava?",
            "poem": 2
          },
          {
            "text": "Maču njegovom ih kao prašinu daje,",
            "poem": 1
          },
          {
            "text": "lukom njegovim su raspršeni kao slama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "On njih goni, bezbedno napreduje,",
            "poem": 1
          },
          {
            "text": "noge mu na drumove ne dolaze.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ko to čini i ko to postiže,",
            "poem": 1
          },
          {
            "text": "koji od početka priziva naraštaje?",
            "poem": 2
          },
          {
            "text": "Ja, Gospod, koji sam Prvi i Poslednji, to sam ja.“",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ostrva gledaju i strah ih obuzima,",
            "poem": 1
          },
          {
            "text": "drhću krajevi zemaljski,",
            "poem": 2
          },
          {
            "text": "oni se približavaju i već su tu.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Čovek svom drugu pomaže",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i svom bratu govori: „Budi jak!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Livac bodri zlatare,",
            "poem": 1
          },
          {
            "text": "onaj koji čekićem tanji",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "bodri onog koji kuje na nakovnju.",
            "poem": 2
          },
          {
            "text": "On govori o spoju: „To je dobro“,",
            "poem": 1
          },
          {
            "text": "i kip utvrđuje klinovima da se ne pomiče.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Bog je sa svojim narodom"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "„A ti, Izrailju, slugo moj,",
            "poem": 1
          },
          {
            "text": "Jakove, izabraniče moj,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "potomče Avrahama, mog ljubimca!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ti, koga osnažih sa zemljinih krajeva",
            "poem": 1
          },
          {
            "text": "i koga pozvah s njenih rubova;",
            "poem": 2
          },
          {
            "text": "ti, kome sam rekao: ’Ti si sluga moj’,",
            "poem": 1
          },
          {
            "text": "tebe sam izabrao i neću te odbaciti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ne boj se, jer ja sam s tobom,",
            "poem": 1
          },
          {
            "text": "ne obziri se zastrašeno, jer ja sam Bog tvoj.",
            "poem": 2
          },
          {
            "text": "Ja te krepim i zaista ti pomažem,",
            "poem": 1
          },
          {
            "text": "zaista te podupirem desnicom pravde svoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Gle, postideće se i posramiće se",
            "poem": 1
          },
          {
            "text": "svi koji su protiv tebe besneli",
            "poem": 2
          },
          {
            "text": "i biće kao ništa,",
            "poem": 1
          },
          {
            "text": "i propašće koji se s tobom parničiše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Tražićeš svoje protivnike,",
            "poem": 1
          },
          {
            "text": "ali ih nećeš naći.",
            "poem": 2
          },
          {
            "text": "Biće kao ništa i iščeznuće",
            "poem": 1
          },
          {
            "text": "oni koji protiv tebe vojuju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Jer ja, Gospod, Bog tvoj,",
            "poem": 1
          },
          {
            "text": "krepim desnicu tvoju, govorim ti:",
            "poem": 2
          },
          {
            "text": "Ne boj se,",
            "poem": 1
          },
          {
            "text": "ja ti pomažem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ne boj se, crviću Jakove, ljudstvo Izrailjevo,",
            "poem": 1
          },
          {
            "text": "ja ću ti pomoći – govori Gospod.",
            "poem": 2
          },
          {
            "text": "Izrailjev Svetitelj,",
            "poem": 1
          },
          {
            "text": "On je tvoj Otkupitelj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Gle, načinio sam te da budeš oštri mlat,",
            "poem": 1
          },
          {
            "text": "novi, sa zupcima jakim;",
            "poem": 2
          },
          {
            "text": "mlatićeš brda i satiraćeš,",
            "poem": 1
          },
          {
            "text": "a od bregova ćeš plevu načiniti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ti ćeš njih vejati, i vetar će ih odneti,",
            "poem": 1
          },
          {
            "text": "vihor će ih raspršiti.",
            "poem": 2
          },
          {
            "text": "A ti ćeš kliktati Gospodu,",
            "poem": 1
          },
          {
            "text": "slavićeš Svetitelja Izrailjevog.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Čudesne promene od Boga dolaze"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ubogi i bedni vodu traže, a nje nema.",
            "poem": 1
          },
          {
            "text": "Jezik im se od žeđi osušio.",
            "poem": 2
          },
          {
            "text": "Ja, Gospod, njih ću uslišiti.",
            "poem": 1
          },
          {
            "text": "Ja, Bog Izrailjev, njih neću zaboraviti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Otvoriću reke u goletima,",
            "poem": 1
          },
          {
            "text": "i izvore posred dolina.",
            "poem": 2
          },
          {
            "text": "Pustinju ću u rit pretvoriti,",
            "poem": 1
          },
          {
            "text": "a sušnu zemlju u vrelo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "U pustinji posadiću kedar,",
            "poem": 1
          },
          {
            "text": "bagrem i mirtu i maslinu.",
            "poem": 2
          },
          {
            "text": "Pustinju ću pošumiti čempresom,",
            "poem": 1
          },
          {
            "text": "brestom i šimširom zajedno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Neka ljudi vide i neka znaju,",
            "poem": 1
          },
          {
            "text": "i neka promisle i neka shvate zajedno,",
            "poem": 2
          },
          {
            "text": "da je to učinila ruka Gospodnja,",
            "poem": 1
          },
          {
            "text": "i stvorio Svetitelj Izrailjev.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Gospod je provereni Bog"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Svoj spor izložite! – govori Gospod.",
            "poem": 1
          },
          {
            "text": "Dokaze predočite! – govori car Izrailjev.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Neka pristupe i nek nam objave",
            "poem": 1
          },
          {
            "text": "ono što će se dogoditi.",
            "poem": 2
          },
          {
            "text": "Prošlost – šta su otkrili?",
            "poem": 1
          },
          {
            "text": "da o tome razmišljamo",
            "poem": 2
          },
          {
            "text": "i znamo što se ispunilo?",
            "poem": 1
          },
          {
            "text": "Nego objavite šta će doći.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Otkrijte nam šta će posle biti,",
            "poem": 1
          },
          {
            "text": "pa ćemo poznati da ste bogovi.",
            "poem": 2
          },
          {
            "text": "Hajde, učinite nešto, dobro ili zlo,",
            "poem": 1
          },
          {
            "text": "pa da se zadivimo i zajedno uvidimo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Gle, vi ste ništa,",
            "poem": 1
          },
          {
            "text": "i dela su vaša kao izdisaj;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ko vas izabere, taj je odvratan.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Proroštvo o nepristrasnom osvajaču"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Podigao sam ga sa severa,",
            "poem": 1
          },
          {
            "text": "i on je došao sa istoka sunčanoga;",
            "poem": 2
          },
          {
            "text": "te će doći na dostojanstvenike kao po kaljuzi,",
            "poem": 1
          },
          {
            "text": "i gaziće ih kao grnčar glinu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Ko je od iskona objavio pa da znamo,",
            "poem": 1
          },
          {
            "text": "unapred, pa da kažemo: ’U pravu je!’?",
            "poem": 2
          },
          {
            "text": "Zaista, nema ko da objavljuje.",
            "poem": 1
          },
          {
            "text": "Zaista, nema ko da obaveštava.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Zaista, nema ko da čuje reči vaše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Prvo Sionu rekoh: ’Gle, evo ih!’",
            "poem": 1
          },
          {
            "text": "i Jerusalimu ću dati vesnika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "I ja gledam, a čoveka nema,",
            "poem": 1
          },
          {
            "text": "i među njima, a savetnika nema,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pa ja ih pitam, a ne odgovaraju ni reč.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Gle, svi su oni zli;",
            "poem": 1
          },
          {
            "text": "ništavilo su dela njihova,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "vetar i praznina kipovi su njihovi.",
            "poem": 2
          }
        ]
      }
    ],
