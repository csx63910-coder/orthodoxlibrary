  "chapter": {
    "number": 54,
    "content": [
      {
        "type": "heading",
        "content": [
          "Velik je Jerusalim"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Kliči, nerotkinjo, koja ne rađaš,",
            "poem": 1
          },
          {
            "text": "podvriskuj kličući;",
            "poem": 2
          },
          {
            "text": "veseli se koja za porođaj ne znaš,",
            "poem": 1
          },
          {
            "text": "jer više sinova ima samotna",
            "poem": 2
          },
          {
            "text": "nego li udata –",
            "poem": 1
          },
          {
            "text": "govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Raširi mesto za svoj šator,",
            "poem": 1
          },
          {
            "text": "razastri platna za svoje konačište.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ne štedi!",
            "poem": 2
          },
          {
            "text": "Užad svoju produži,",
            "poem": 1
          },
          {
            "text": "kočiće svoje učvrsti!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jer desno i levo ćeš se probiti",
            "poem": 1
          },
          {
            "text": "i potomstvo će tvoje puke zaposesti",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i nastaniće opustele gradove.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Gospodnja ljubav"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ne boj se, nećeš se postideti.",
            "poem": 1
          },
          {
            "text": "Ne stidi se, jer nećeš crveneti.",
            "poem": 2
          },
          {
            "text": "Jer ćeš zaboraviti sramotu mladosti svoje,",
            "poem": 1
          },
          {
            "text": "i nećeš više spominjati",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "što su te ponižavali dok si bila udovica.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Jer tvoj suprug je Sazdatelj tvoj,",
            "poem": 1
          },
          {
            "text": "njegovo je ime Gospod nad vojskama,",
            "poem": 2
          },
          {
            "text": "i tvoj Otkupitelj je Svetitelj Izrailjev,",
            "poem": 1
          },
          {
            "text": "on se zove Bog zemlje svekolike.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Naime, kao ženu ostavljenu",
            "poem": 1
          },
          {
            "text": "i duhovno ucveljenu pozvao te je Gospod,",
            "poem": 2
          },
          {
            "text": "i otpuštenu ženu",
            "poem": 1
          },
          {
            "text": "s kojom si od mladosti svoje“ –",
            "poem": 2
          },
          {
            "text": "govori Bog tvoj.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "„Za tren kratki sam te ostavio,",
            "poem": 1
          },
          {
            "text": "a u velikim milosrđima tebe ću prigrliti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Iz mene je srdžba provalila,",
            "poem": 1
          },
          {
            "text": "i za časak sam zaklonio lice svoje od tebe,",
            "poem": 2
          },
          {
            "text": "a smilovao sam ti se po večnoj milosti –",
            "poem": 1
          },
          {
            "text": "govori Otkupitelj tvoj, Gospod.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Jer ovo im je kao vode Nojeve,",
            "poem": 1
          },
          {
            "text": "kad se zakleh da vode Nojeve",
            "poem": 2
          },
          {
            "text": "više zemlju preplavljati neće:",
            "poem": 1
          },
          {
            "text": "tako se zaklinjem",
            "poem": 2
          },
          {
            "text": "da na tebe srditi se neću",
            "poem": 1
          },
          {
            "text": "i da tebe prekoriti neću.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Neka se planine pomaknu",
            "poem": 1
          },
          {
            "text": "i neka se brda uzdrmaju,",
            "poem": 2
          },
          {
            "text": "ipak se moja milost od tebe odmaći neće,",
            "poem": 1
          },
          {
            "text": "niti će se uzdrmati moj savez mirovni",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "– govori Gospod koji ti se smilovao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Jerusalim obnovljen i blagosloven"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Nevoljnice, vihorom vitlana, neutešena,",
            "poem": 1
          },
          {
            "text": "gle, ja ću složiti na mermer kamenje tvoje,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i na safire temelj tvoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "I od rubina dići ću ti na tvrđavi zupce;",
            "poem": 1
          },
          {
            "text": "i od karbunkula tvoje vratnice,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i sve ograde tvoje od kamenja dragoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "I svi sinovi tvoji biće učeni od Gospoda,",
            "poem": 1
          },
          {
            "text": "i obilan mir imaće sinovi tvoji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Bićeš sazdana na pravdi.",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Odbaci strah,",
            "poem": 1
          },
          {
            "text": "jer nemaš se čega bojati.",
            "poem": 2
          },
          {
            "text": "Odbaci strah,",
            "poem": 1
          },
          {
            "text": "jer on ti se ni primaći neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Gle, postrojiće se protiv tebe",
            "poem": 1
          },
          {
            "text": "kao da je to od mene.",
            "poem": 2
          },
          {
            "text": "Ko se postroji protiv tebe",
            "poem": 1
          },
          {
            "text": "propašće zbog tebe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Gle, ja sam kovača stvorio,",
            "poem": 1
          },
          {
            "text": "koji žeravicu raspaljuje,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "vadi iz nje oružje da ga iskuje,",
            "poem": 2
          },
          {
            "text": "a ja sam i zatirača stvorio da zatire.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Nijedno oružje iskovano protiv tebe neće uspeti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i svaki jezik koji se protiv tebe podigne",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "na sudu ćeš oboriti.",
            "poem": 2
          },
          {
            "text": "To je baština slugu Gospodnjih",
            "poem": 1
          },
          {
            "text": "i pravda njihova od mene – govori Gospod.",
            "poem": 2
          }
        ]
      }
    ],
