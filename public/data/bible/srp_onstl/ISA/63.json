  "chapter": {
    "number": 63,
    "content": [
      {
        "type": "heading",
        "content": [
          "Gnev i pogibija"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ko je taj što iz Edoma dolazi,",
            "poem": 1
          },
          {
            "text": "iz Vosore u ogrtaču jarkom,",
            "poem": 2
          },
          {
            "text": "onaj ukrašeni u odeći svojoj,",
            "poem": 1
          },
          {
            "text": "koji korača u punoj snazi?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "– „Ja sam koji govori o pravdi,",
            "poem": 1
          },
          {
            "text": "velik kad spasava.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Zašto ti je odelo crveno",
            "poem": 1
          },
          {
            "text": "i haljine tvoje kao da si u muljari gazio?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "– „Cedio sam, po kaci gazio,",
            "poem": 1
          },
          {
            "text": "od naroda sa mnom ni čoveka,",
            "poem": 2
          },
          {
            "text": "i u gnevu njih sam izgazio,",
            "poem": 1
          },
          {
            "text": "i u jari svojoj njih sam izgnječio.",
            "poem": 2
          },
          {
            "text": "A što je iz njih šikljalo moj ogrtač je poprskalo,",
            "poem": 1
          },
          {
            "text": "te sam isprljao svu odeću svoju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Jer je u mom srcu dan kada se svetim,",
            "poem": 1
          },
          {
            "text": "i došla je godina kada otkupljujem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "I gledam, a nema ko da pomogne;",
            "poem": 1
          },
          {
            "text": "zbunjen bivam, a oslonca nema.",
            "poem": 2
          },
          {
            "text": "I spasla me je desnica moja,",
            "poem": 1
          },
          {
            "text": "i srdžba moja oslonac mi bila,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "te satirem narode u gnevu svom,",
            "poem": 1
          },
          {
            "text": "i srdžbom svojom sam ih opio,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a onim što iz njih šiklja zemlju sam natopio.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Bog i njegov narod"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Gospodnje ću milosti pominjati,",
            "poem": 1
          },
          {
            "text": "pohvalu Gospodnju prema svemu",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "što nam je uradio Gospod,",
            "poem": 2
          },
          {
            "text": "i dobro umnoženo domu Izrailjevu,",
            "poem": 1
          },
          {
            "text": "što nam ga je uradio po samilosti svojoj",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "po obilju milosti svoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "I rekao je: „Doista su moj narod,",
            "poem": 1
          },
          {
            "text": "sinovi koji neće izneveriti“,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pa je njima Spasitelj postao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "U svim nevoljama njihovim i on beše u nevolji;",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "anđeo što pred njim stoji ih je spasao.",
            "poem": 1
          },
          {
            "text": "Svojom ljubavlju ih je spasao",
            "poem": 2
          },
          {
            "text": "i sam ih svojim milosrđem otkupio",
            "poem": 1
          },
          {
            "text": "i digao i nosio u sve dane od veka.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "A oni se sami odmetnuše,",
            "poem": 1
          },
          {
            "text": "Svetog Duha njegovog žalostiše.",
            "poem": 2
          },
          {
            "text": "I on im se preokrenu u neprijatelja;",
            "poem": 1
          },
          {
            "text": "on lično protiv njih zarati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Tad se davnih prisetiše dana,",
            "poem": 1
          },
          {
            "text": "Mojsija, njegovog naroda.",
            "poem": 2
          },
          {
            "text": "Gde je onaj koji im iz mora izvlači",
            "poem": 1
          },
          {
            "text": "pastira za svoje stado?",
            "poem": 2
          },
          {
            "text": "Gde je onaj koji će u njega smestiti",
            "poem": 1
          },
          {
            "text": "svoga Duha Svetoga?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Koji je Mojsijevom desnicom upravljao",
            "poem": 1
          },
          {
            "text": "preko svoje mišice slavnosne?",
            "poem": 2
          },
          {
            "text": "Koji vodu pred njima raspoluti",
            "poem": 1
          },
          {
            "text": "da svoje ime večnim učini?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Koji njima upravlja po dnu morskome",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "kao konjem po pustinji,",
            "poem": 1
          },
          {
            "text": "nije bilo spoticanja?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Slično stoci što u dolinu silazi,",
            "poem": 1
          },
          {
            "text": "Duh Gospodnji ih je uspokojio.",
            "poem": 2
          },
          {
            "text": "Ti si tako vodio narod svoj,",
            "poem": 1
          },
          {
            "text": "i preslavno ime stekao si sebi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Pogledaj s nebesa i vidi",
            "poem": 1
          },
          {
            "text": "iz tvoga svetog i preslavnog Prebivališta.",
            "poem": 2
          },
          {
            "text": "Gde je tvoja revnost i tvoja sila,",
            "poem": 1
          },
          {
            "text": "navala ožalošćenosti tvoje",
            "poem": 2
          },
          {
            "text": "i milosrđa tvojega?",
            "poem": 1
          },
          {
            "text": "Meni li se uskraćuju?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ta, ti si Otac naš,",
            "poem": 1
          },
          {
            "text": "jer Avraham nas spoznao nije,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i Izrailj nas prepoznao nije,",
            "poem": 2
          },
          {
            "text": "ipak, Gospode, ti si Otac naš,",
            "poem": 1
          },
          {
            "text": "Otkupitelj naš, od večnosti je ime tvoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Zašto nas, Gospode, odvodiš od tvojih puteva,",
            "poem": 1
          },
          {
            "text": "tvrdim činiš srce naše spram straha od tebe?",
            "poem": 2
          },
          {
            "text": "Vrati se zbog svojih slugu,",
            "poem": 1
          },
          {
            "text": "zbog plemena što su ti baština.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Nju je narod tvoj tek za kratko zaposeo,",
            "poem": 1
          },
          {
            "text": "ali izgaziše Svetilište tvoje protivnici tvoji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Već odavna slični smo postali",
            "poem": 1
          },
          {
            "text": "onima nad kojima ti nisi,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "nad kojima se tvoje ime ne priziva.",
            "poem": 2
          }
        ]
      }
    ],
