  "chapter": {
    "number": 25,
    "content": [
      {
        "type": "heading",
        "content": [
          "Molitva zahvalna"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Gospode, ti si Bog moj,",
            "poem": 1
          },
          {
            "text": "uzvisujem te, slavim tvoje ime,",
            "poem": 2
          },
          {
            "text": "zato što si ostvario divotu,",
            "poem": 1
          },
          {
            "text": "od davnina smišljenu vernost vernu,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "jer si grad pretvorio u hrpu,",
            "poem": 1
          },
          {
            "text": "naselje utvrđeno u ruševinu;",
            "poem": 2
          },
          {
            "text": "tvrđava tuđinaca više nije grad –",
            "poem": 1
          },
          {
            "text": "doveka se obnoviti neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Tebe zato narod snažni slavi,",
            "poem": 1
          },
          {
            "text": "od tebe se boji grad svirepih plemena,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "a ti si utočište sirotom,",
            "poem": 1
          },
          {
            "text": "utočište ubogom u nevolji njegovoj;",
            "poem": 2
          },
          {
            "text": "ti si sklonište od nepogode,",
            "poem": 1
          },
          {
            "text": "zaklon od žege,",
            "poem": 2
          },
          {
            "text": "jer ćud je svirepih",
            "poem": 1
          },
          {
            "text": "kao nepogoda sa strane;",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "kao žega nad sušnim tlom,",
            "poem": 2
          },
          {
            "text": "ti gušiš graju odvratnih,",
            "poem": 1
          },
          {
            "text": "kao žegu senkom oblaka",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "svirepima se prekinulo pevanje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Mesijanska svečanost"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "A Gospod nad vojskama spremiće na ovoj gori",
            "poem": 1
          },
          {
            "text": "gozbu od sala za sve narode,",
            "poem": 2
          },
          {
            "text": "gozbu od sala, gozbu od vina,",
            "poem": 1
          },
          {
            "text": "od vina odležalog, od moždine masne,",
            "poem": 2
          },
          {
            "text": "od prečišćenog vina odležalog.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "I na ovoj gori on će zderati",
            "poem": 1
          },
          {
            "text": "zastor što sve narode zastire",
            "poem": 2
          },
          {
            "text": "i koprenu što sve puke obavija.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "On će smrt pobedonosno zderati,",
            "poem": 2
          },
          {
            "text": "i Gospodar Gospod će suzu otrti",
            "poem": 1
          },
          {
            "text": "sa lica svakoga,",
            "poem": 2
          },
          {
            "text": "i sramotu će skinuti",
            "poem": 1
          },
          {
            "text": "sa svog naroda po svoj zemlji –",
            "poem": 2
          },
          {
            "text": "zato što je Gospod rekao.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "I govoriće se u dan onaj:",
          {
            "text": "„Gle, ovo je Bog naš.",
            "poem": 1
          },
          {
            "text": "Njega smo očekivali i on nas je spasao.",
            "poem": 2
          },
          {
            "text": "Ovo je Gospod kog smo očekivali;",
            "poem": 1
          },
          {
            "text": "kličimo i radujmo se, jer on spasava.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Jer ruka Gospodnja počiva na gori ovoj,",
            "poem": 1
          },
          {
            "text": "i Moav će biti izgažen pod njim",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kao što se slama u đubrištu gazi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "I širiće ruke svoje posred njega",
            "poem": 1
          },
          {
            "text": "kao što širi plivač kada pliva.",
            "poem": 2
          },
          {
            "text": "I poniziće njegov ponos",
            "poem": 1
          },
          {
            "text": "veštinom ruku njegovih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "I oboriće na visokoj tvrđavi tvoje zidove,",
            "poem": 1
          },
          {
            "text": "i oboriće ih na zemlju,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "poniziće ih, baciće ih u prašinu.",
            "poem": 2
          }
        ]
      }
    ],
