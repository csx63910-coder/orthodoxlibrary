  "book": {
    "id": "ISA",
    "translationId": "srp_onstl",
    "name": "Knjiga proroka Isaije",
    "commonName": "Knjiga proroka Isaije",
    "title": "Knjiga proroka Isaije",
    "order": 23,
    "numberOfChapters": 66,
    "sha256": "52a276d08639ef24ff1f18ac3ddbdf0d0026f3b82a6b643d2c93493f58e95dd5",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/ISA/1.json",
    "lastChapterNumber": 66,
    "lastChapterApiLink": "/api/srp_onstl/ISA/66.json",
    "totalNumberOfVerses": 1292
  },
  "chapter": {
    "number": 10,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Teško onima koji nepravedne odredbe određuju",
            "poem": 1
          },
          {
            "text": "i propise tlačiteljske propisuju",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "da bi ubogome pravdu uskratili",
            "poem": 1
          },
          {
            "text": "i siromasima naroda mog pravo oteli,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kako bi sirotinju opljačkali.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "I šta ćete u dan kazne činiti,",
            "poem": 1
          },
          {
            "text": "kada propast iz daleka dođe?",
            "poem": 2
          },
          {
            "text": "Kome ćete za pomoć uteći?",
            "poem": 1
          },
          {
            "text": "Kamo ćete blago svoje ostaviti?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Kao roblje jamačno puzati",
            "poem": 1
          },
          {
            "text": "i među poklane pasti…",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Uza sve to gnev se njegov umiriti neće",
            "poem": 1
          },
          {
            "text": "i ruka mu ispružena ostaje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Protiv neimenovanog asirskog vladara"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "„Teško Asircu!",
            "poem": 1
          },
          {
            "text": "On je gneva moga šiba.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "On je u njihovoj ruci prut srdžbe moje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Na puk otpadnički njega sam poslao,",
            "poem": 1
          },
          {
            "text": "na narod koji me je rasrdio.",
            "poem": 2
          },
          {
            "text": "On neka ga opleni i opljačka,",
            "poem": 1
          },
          {
            "text": "kao blato drumsko neka ga izgazi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ali on nije tako nameravao,",
            "poem": 1
          },
          {
            "text": "i u srcu svom nije tako smišljao,",
            "poem": 2
          },
          {
            "text": "nego je u srcu svom za zatiranje,",
            "poem": 1
          },
          {
            "text": "za istrebljivanje ne malog broja naroda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Jer on je govorio:",
            "poem": 1
          },
          {
            "text": "’Svaki od mojih glavara nije li kao car?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Nije li Halani kao Harkemis?",
            "poem": 1
          },
          {
            "text": "I nije li Amat kao Arfad?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Nije li Samarija kao Damask?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Kao što moja ruka dohvati carstva idolska i njihove likove",
            "poem": 1
          },
          {
            "text": "od Jerusalima i od Samarije;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "kao što učinih sa Samarijom",
            "poem": 1
          },
          {
            "text": "i njenim idolima,",
            "poem": 2
          },
          {
            "text": "zar da ne učinim s Jerusalimom",
            "poem": 1
          },
          {
            "text": "i njegovim ikonama?’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "I kad Gospodar izbubnja sve što namerava činiti na gori Sion i u Jerusalimu, onda ću kazniti plod oholog srca cara asirskog, i drskost njegovih ponositih očiju,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "zato što je rekao:",
          {
            "text": "„Snagom svoje ruke učinih,",
            "poem": 1
          },
          {
            "text": "i mudrošću svojom, jer uman jesam;",
            "poem": 2
          },
          {
            "text": "granice narodima uklonih,",
            "poem": 1
          },
          {
            "text": "i blaga njihova opljačkah;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kao junak pokorih stolujuće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ruka moja kao gnezdo zgrabi",
            "poem": 1
          },
          {
            "text": "bogatstva tih naroda.",
            "poem": 2
          },
          {
            "text": "I kao što se kupe ostavljena jaja",
            "poem": 1
          },
          {
            "text": "svu sam zemlju pokupio;",
            "poem": 2
          },
          {
            "text": "i nikog ne bi da krilo pokrene,",
            "poem": 1
          },
          {
            "text": "da kljun otvori, da zapijuče.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Zar sekira da se hvališe nad čovekom koji njome seče?",
            "poem": 1
          },
          {
            "text": "Hoće li se veličati testera nad čovekom koji njom testeri?",
            "poem": 2
          },
          {
            "text": "Zar palica maše čovekom koji je poteže,",
            "poem": 1
          },
          {
            "text": "i štap li podiže onog koji drvo nije?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Zato će Gospodar Gospod nad vojskama",
            "poem": 1
          },
          {
            "text": "poslati skapavanje među njegove zadrigle,",
            "poem": 2
          },
          {
            "text": "i njegovu će slavu popaliti",
            "poem": 1
          },
          {
            "text": "kao što se vatra raspaljuje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Svetlost Izrailjeva biće ta vatra,",
            "poem": 1
          },
          {
            "text": "i Svetitelj njegov biće taj plamen:",
            "poem": 2
          },
          {
            "text": "on će goreti i proždirati bodlje njegove",
            "poem": 1
          },
          {
            "text": "i trnje njegovo u jednom danu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Krasotu šuma njegovih i polja njegovih",
            "poem": 1
          },
          {
            "text": "on će uništiti od srži do kore.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "I biće kao bolesnik koji kopni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Što ostane drva u njegovoj šumi,",
            "poem": 1
          },
          {
            "text": "to malo će i dečak moći da prebroji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Povratak ostatka"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "I biće u dan onaj ostatak Izrailjev",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "i izbeglice, potomci Jakovljevi,",
            "poem": 1
          },
          {
            "text": "neće se više oslanjati na onoga koji ih obara,",
            "poem": 2
          },
          {
            "text": "nego će bivati istinski oslonjeni",
            "poem": 1
          },
          {
            "text": "na Gospoda, Svetitelja Izrailjeva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Ostatak će se vratiti,",
            "poem": 1
          },
          {
            "text": "ostatak Jakovljev Bogu silnome.",
            "poem": 2
          },
          {
            "noteId": 4
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Ta, ako bude naroda tvojega, Izrailja,",
            "poem": 1
          },
          {
            "text": "kao peska morskoga,",
            "poem": 2
          },
          {
            "text": "vratiće se ostatak njegov.",
            "poem": 1
          },
          {
            "text": "Odluka je konačna: pravda nadire.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Jer u potpunosti je odlučio Gospod Bog nad vojskama:",
            "poem": 1
          },
          {
            "text": "on to čini u sredini cele zemlje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Ohrabrenje"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Zato govori Gospodar Gospod nad vojskama:",
          {
            "text": "„Narode moj, stanovnici na Sionu,",
            "poem": 1
          },
          {
            "text": "ne boj se Asirca kad te šibom tuče,",
            "poem": 2
          },
          {
            "text": "kad palicu na te podiže",
            "poem": 1
          },
          {
            "text": "na putu egipatskom,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "jer još samo malo, i jarost je ispunjena,",
            "poem": 1
          },
          {
            "text": "i gnev moj će ih uništiti.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "I Gospod nad vojskama zamahnuće bičem na njega",
            "poem": 1
          },
          {
            "text": "kao što udaraše Madijane na Steni Orivovoj;",
            "poem": 2
          },
          {
            "text": "i palica je njegova nad morem,",
            "poem": 1
          },
          {
            "text": "i podiže je na putu egipatskom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "I biće u dan onaj:",
            "poem": 1
          },
          {
            "text": "biće skinuto breme njegovo s tvojih ramena",
            "poem": 2
          },
          {
            "text": "i jaram njegov s tvojeg vrata,",
            "poem": 1
          },
          {
            "text": "i slomiće se jaram pred pomazanjem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Osvajač"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "On dolazi na Ajat,",
            "poem": 1
          },
          {
            "text": "on je prošao Migron,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "on rasprti prtljag svoj u Mihmasu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Oni prѐlaze prélaze:",
            "poem": 1
          },
          {
            "text": "„U Gavi će biti prenoćište za nas.“",
            "poem": 2
          },
          {
            "text": "Rama drhće,",
            "poem": 1
          },
          {
            "text": "a Gavaja Saulova beži.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Vrišti, ćerko Galimska, što glasnije!",
            "poem": 1
          },
          {
            "text": "Slušaj, Laise!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Siromahu, Anatote!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Madmena odluta;",
            "poem": 1
          },
          {
            "text": "stanovnici gevimski utekoše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Još danas će se u Novu zaustaviti,",
            "poem": 1
          },
          {
            "text": "rukom maše gori ćerke sionske,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "humu jerusalimskom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Gle, Gospodar Gospod nad vojskama",
            "poem": 1
          },
          {
            "text": "grane kreše užasom,",
            "poem": 2
          },
          {
            "text": "posečeni su vrhovi uspravljeni,",
            "poem": 1
          },
          {
            "text": "oni uzdignuti su oboreni;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "a sekirom se šumski gustiš raseca,",
            "poem": 1
          },
          {
            "text": "a od Silnog Livan biva oboren.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
