  "chapter": {
    "number": 24,
    "content": [
      {
        "type": "heading",
        "content": [
          "Bog će suditi i osuditi"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Gle, Gospod će zemlju opustošiti",
            "poem": 1
          },
          {
            "text": "i ogoliti",
            "poem": 2
          },
          {
            "text": "i njeno lice unakaziti,",
            "poem": 1
          },
          {
            "text": "i stanovnike njene raspršiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Kao narod sveštenik će biti,",
            "poem": 1
          },
          {
            "text": "i kao sluga gospodar njegov,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i kao sluškinja gospodarica njena,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i kupac kao prodavac njegov,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i zajmoprimac kao zajmodavac njegov,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i dužnik kao poverilac njegov.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Zemlja će biti opustošena pustoš,",
            "poem": 1
          },
          {
            "text": "ispražnjena praznina,",
            "poem": 2
          },
          {
            "text": "zato što je Gospod rekao ovu reč.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Zemlja tuži, vene;",
            "poem": 1
          },
          {
            "text": "svet gine, vene;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ginu gordi narodi na zemlji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Jer je zemlja oskrnavljena pod stanovnicima njenim,",
            "poem": 1
          },
          {
            "text": "zato što su zakone prestupili,",
            "poem": 2
          },
          {
            "text": "odredbu pogazili,",
            "poem": 1
          },
          {
            "text": "savez večni prekršili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Zato zemlju prokletstvo proždire,",
            "poem": 1
          },
          {
            "text": "stanovnici njeni su pod krivicom.",
            "poem": 2
          },
          {
            "text": "Zato su popaljeni stanovnici zemaljski,",
            "poem": 1
          },
          {
            "text": "i ljudi je malo preostalo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Vino novo tuguje, loza vene,",
            "poem": 1
          },
          {
            "text": "uzdišu svi što vesela srca behu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Nema više veselja uz bubnjeve,",
            "poem": 1
          },
          {
            "text": "okonča se graja slavljenika,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "umukla je svirka na citarama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Vino piju, ali ne pevaju,",
            "poem": 1
          },
          {
            "text": "pijancima gorči piće žestoko.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Grad bezvredni postade razoren,",
            "poem": 1
          },
          {
            "text": "svim kućama ulaz je zatvoren,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "zbog vina je jauk po ulicama,",
            "poem": 1
          },
          {
            "text": "svaka radost u mrak se pretvori,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "iz zemlje je izgnano veselje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Samo pustoš ostade u gradu,",
            "poem": 1
          },
          {
            "text": "vratnice se razvališe treskom,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "jer se tako u zemlji događa,",
            "poem": 1
          },
          {
            "text": "tako biva među narodima,",
            "poem": 2
          },
          {
            "text": "kao kad se otresu masline,",
            "poem": 1
          },
          {
            "text": "ili grožđe pabirči po berbi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Oni glas podižu kličući;",
            "poem": 1
          },
          {
            "text": "veličanstvenost Gospodnju uznose s mora.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Zato slavite Gospoda vi na istoku,",
            "poem": 1
          },
          {
            "text": "ime Gospoda, Boga Izrailjeva na ostrvima morskim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "S kraja zemlje čujemo muziku:",
            "poem": 1
          },
          {
            "text": "„Neka je čast Pravedniku!“",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ali ja govorim:",
            "poem": 1
          },
          {
            "text": "„Propadoh! Propadoh! Teško meni!",
            "poem": 2
          },
          {
            "text": "Izdajnici su izdali,",
            "poem": 1
          },
          {
            "text": "baš izdajom izdajnici su izdali!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Strahota i jama i zamka,",
            "poem": 1
          },
          {
            "text": "tebi, stanovniče zemaljski.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ko utekne ispred glasa o strahoti,",
            "poem": 1
          },
          {
            "text": "u jamu će upasti;",
            "poem": 2
          },
          {
            "text": "a ko se iz jame izvuče,",
            "poem": 1
          },
          {
            "text": "u zamku će se uhvatiti.",
            "poem": 2
          },
          "Nastavak pesme o Božijem sudu",
          {
            "text": "Pa će se otvoriti okna na visini,",
            "poem": 1
          },
          {
            "text": "i zatrešće se temelji zemaljski.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Zemlja će se razbijanjem razbiti.",
            "poem": 1
          },
          {
            "text": "Zemlja će se raspuklinom raspući.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Zemlja će se zemljotresom tresti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Zemlja će se teturanjem teturati kao pijan čovek;",
            "poem": 1
          },
          {
            "text": "zaljuljaće se kao senica: tamo-amo;",
            "poem": 2
          },
          {
            "text": "toliko će joj bezakonje njeno otežati,",
            "poem": 1
          },
          {
            "text": "te će pasti i više ustati neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "I dogodiće se u onaj dan:",
            "poem": 1
          },
          {
            "text": "Gospod će pohoditi vojsku višnju na visini,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i sve careve ovozemaljske na zemlji;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "biće sabirom sabrani",
            "poem": 1
          },
          {
            "text": "i zarobljeni u tamnici,",
            "poem": 2
          },
          {
            "text": "u zatvoru zatvoreni,",
            "poem": 1
          },
          {
            "text": "i kažnjeni posle mnogo dana.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Mesec će se zacrveneti",
            "poem": 1
          },
          {
            "text": "i sunce će pocrveneti,",
            "poem": 2
          },
          {
            "text": "jer će se zacariti Gospod nad vojskama",
            "poem": 1
          },
          {
            "text": "na gori Sion i u Jerusalimu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i slava mu je pred starešinama njegovim.",
            "poem": 2
          }
        ]
      }
    ],
