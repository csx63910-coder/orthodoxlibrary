  "chapter": {
    "number": 49,
    "content": [
      {
        "type": "heading",
        "content": [
          "O sluzi Gospodnjem, Pesma druga"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Čujte mene, ostrva!",
            "poem": 1
          },
          {
            "text": "Poslušajte me, narodi daleki!",
            "poem": 2
          },
          {
            "text": "Gospod me je pozvao čim sam se rodio,",
            "poem": 1
          },
          {
            "text": "moje ime je spomenuo od utrobe materine,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "i načinio je usta moja kao oštar mač,",
            "poem": 1
          },
          {
            "text": "senom svoje ruke on me je zaklonio,",
            "poem": 2
          },
          {
            "text": "u glatku me strelu pretvorio,",
            "poem": 1
          },
          {
            "text": "u tobolcu svome on me je sakrio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Rekao mi je: ’Izrailju, ti si moj sluga,",
            "poem": 1
          },
          {
            "text": "u kom ću postati ponosan.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "A ja sam rekao: ’Uzalud sam se mučio za opustošenost,",
            "poem": 1
          },
          {
            "text": "i isprazno upinjao snagu svoju.",
            "poem": 2
          },
          {
            "text": "Ipak, pravda je moja kod Gospoda,",
            "poem": 1
          },
          {
            "text": "i učinak moj kod Boga mojega.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "I sad govori Gospod",
            "poem": 1
          },
          {
            "text": "koji me je pre rođenja slugom svojim načinio,",
            "poem": 2
          },
          {
            "text": "da mu Jakova povratim",
            "poem": 1
          },
          {
            "text": "i da mu se Izrailj sabere.",
            "poem": 2
          },
          {
            "text": "I proslaviću se u očima Gospodnjim,",
            "poem": 1
          },
          {
            "text": "i Bog moj će biti snaga moja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "I reče:",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "’Nevažno je da mi budeš sluga,",
            "poem": 1
          },
          {
            "text": "da podignem pleme Jakovljevo,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i da vratiš ostatke Izrailjeve,",
            "poem": 2
          },
          {
            "text": "nego ću te odrediti da budeš svetlost pucima,",
            "poem": 1
          },
          {
            "text": "da budeš spasenje moje do kraja zemlje.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Pesma o slavnom povratku"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Govori Gospod,",
            "poem": 1
          },
          {
            "text": "Otkupitelj Izrailjev, Svetitelj njegov,",
            "poem": 2
          },
          {
            "text": "onom kome preziru dušu,",
            "poem": 1
          },
          {
            "text": "na koga se gadi puk, sluzi nasilnicima:",
            "poem": 2
          },
          {
            "text": "„Videće carevi i ustaće glavari,",
            "poem": 1
          },
          {
            "text": "i klanjaće ti se",
            "poem": 2
          },
          {
            "text": "zbog Gospoda koji je veran,",
            "poem": 1
          },
          {
            "text": "Svetitelja Izrailjeva koji te je izabrao.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Obnova Izrailja"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Govori Gospod:",
          {
            "text": "„U vreme povoljno sam te uslišio,",
            "poem": 1
          },
          {
            "text": "i u dan spasenja sam ti pomogao,",
            "poem": 2
          },
          {
            "text": "i sazdao sam te i postavio te",
            "poem": 1
          },
          {
            "text": "za savez s narodom,",
            "poem": 2
          },
          {
            "text": "za podizanje zemlje,",
            "poem": 1
          },
          {
            "text": "za ubaštinjenje razorenih baština,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "za reč utamničenima: ’Izađite!’,",
            "poem": 1
          },
          {
            "text": "i onima koji su u tami: ’Pokažite se!’",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Na putevima će se napasati,",
            "poem": 1
          },
          {
            "text": "i po svim visoravnima biće paša njihova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Neće biti ni gladni ni žedni,",
            "poem": 1
          },
          {
            "text": "i neće ih mučiti ni suša ni sunce,",
            "poem": 2
          },
          {
            "text": "jer će ih voditi onaj koji im se smilovao,",
            "poem": 1
          },
          {
            "text": "i dovešće ih na izvore vodene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "I pretvoriće sve gore moje u put,",
            "poem": 1
          },
          {
            "text": "i uzdići će moje drumove.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Evo, neki dolaze iz daleka,",
            "poem": 1
          },
          {
            "text": "i, gle, neki sa severa i sa zapada,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a neki iz zemlje Sinim.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Kličite, nebesa,",
            "poem": 1
          },
          {
            "text": "i veseli se, zemljo!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Podvikujte, planine, razdragano!",
            "poem": 2
          },
          {
            "text": "Zato što Gospod teši narod svoj,",
            "poem": 1
          },
          {
            "text": "i smilovaće se na nevoljnike svoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "A Sion reče: „Napustio me Gospod“",
            "poem": 1
          },
          {
            "text": "i „Gospodar me je zaboravio.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "„Može li žena zaboraviti svoje odojče,",
            "poem": 1
          },
          {
            "text": "da se ne smiluje na sina utrobe svoje?",
            "poem": 2
          },
          {
            "text": "Ako bi neka i zaboravila,",
            "poem": 1
          },
          {
            "text": "ja pak tebe zaboraviti neću.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Evo, na oba dlana sam te urezao,",
            "poem": 1
          },
          {
            "text": "zidovi tvoji preda mnom su svagda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Graditelji tvoji žure,",
            "poem": 1
          },
          {
            "text": "rušitelji tvoji i pustošnici tvoji od tebe odlaze.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Osvrni se i pogledaj oko sebe,",
            "poem": 1
          },
          {
            "text": "svi se oni sabiraju, k tebi dolaze.",
            "poem": 2
          },
          {
            "text": "Života mi moga – govori Gospod –",
            "poem": 1
          },
          {
            "text": "svima ćeš se njima kao haljinom odenuti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i kao nevesta njima ukrasiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ruševine svoje i razvaline svoje,",
            "poem": 1
          },
          {
            "text": "i zemlju poharanu svoju",
            "poem": 2
          },
          {
            "text": "sad podešavaš za stanovanje,",
            "poem": 1
          },
          {
            "text": "i zato će se udaljiti koji te zatiru.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Ponovo će ti govoriti na uši",
            "poem": 1
          },
          {
            "text": "sinovi kojih si bila lišena:",
            "poem": 2
          },
          {
            "text": "’Tesno mi je mesto;",
            "poem": 1
          },
          {
            "text": "pomeri se i nastaniću se.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "I govorićeš u srcu svome:",
            "poem": 1
          },
          {
            "text": "’Ko mi je ovo rodio?",
            "poem": 2
          },
          {
            "text": "A ja sam bila bez dece i ploda,",
            "poem": 1
          },
          {
            "text": "prognana i odbačena,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a ove, ko je odgajio?",
            "poem": 2
          },
          {
            "text": "Eto, ja sam ostala sama;",
            "poem": 1
          },
          {
            "text": "ovi, otkuda su oni?’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Govori Gospodar Gospod:",
          {
            "text": "„Evo, rukom svojom mašem pucima",
            "poem": 1
          },
          {
            "text": "i zastavu svoju podižem narodima.",
            "poem": 2
          },
          {
            "text": "Pa ću vratiti sinove tvoje na grudi,",
            "poem": 1
          },
          {
            "text": "i doneću ćerke na plećima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "I carevi će o tebi brinuti,",
            "poem": 1
          },
          {
            "text": "i kneginje njihove biće tvoje dojkinje.",
            "poem": 2
          },
          {
            "text": "Klanjaće ti se do zemlje",
            "poem": 1
          },
          {
            "text": "i prašinu s nogu tvojih lizaće.",
            "poem": 2
          },
          {
            "text": "I znaćeš da sam ja Gospod.",
            "poem": 1
          },
          {
            "text": "Neće se postideti koji se uzdaju u mene.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Može li se junaku plen zapleniti,",
            "poem": 1
          },
          {
            "text": "ili da zarobljenik pobegne od užasnika?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Ipak, govori Gospod:",
          {
            "text": "„Junaku će biti zaplenjen zarobljenik",
            "poem": 1
          },
          {
            "text": "i plen će pobeći od užasnika,",
            "poem": 2
          },
          {
            "text": "a sa onima koji se s tobom spore",
            "poem": 1
          },
          {
            "text": "sporiću se ja, i tvoje sinove izbaviću ja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "A tlačitelje tvoje nateraću da jedu meso svoje,",
            "poem": 1
          },
          {
            "text": "i kao mladim vinom opijaće se krvlju svojom.",
            "poem": 2
          },
          {
            "text": "I znaće telo svako",
            "poem": 1
          },
          {
            "text": "da sam ja, Gospod, Spasitelj tvoj,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i da je Silni Jakovljev Otkupitelj tvoj.“",
            "poem": 2
          }
        ]
      }
    ],
