  "chapter": {
    "number": 55,
    "content": [
      {
        "type": "heading",
        "content": [
          "Obilje milosti Gospodnjih"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "O, svi žedni, pristupite vodi,",
            "poem": 1
          },
          {
            "text": "i koji novac nemate, pristupite,",
            "poem": 2
          },
          {
            "text": "kupujte i jedite,",
            "poem": 1
          },
          {
            "text": "i pristupite, kupujte",
            "poem": 2
          },
          {
            "text": "bez novaca i bez plaćanja,",
            "poem": 1
          },
          {
            "text": "vino i mleko.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Zašto da trošite novac na nešto što hleb nije,",
            "poem": 1
          },
          {
            "text": "i zaradu svoju na nešto što zasititi neće?",
            "poem": 2
          },
          {
            "text": "Mene poslušajte i ješćete što je dobro,",
            "poem": 1
          },
          {
            "text": "i duša će se vaša naslađivati krtinom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Uho priklonite i meni pristupite;",
            "poem": 1
          },
          {
            "text": "slušajte i duša vaša će živeti.",
            "poem": 2
          },
          {
            "text": "Pa ću s vama sklopiti savez večni,",
            "poem": 1
          },
          {
            "text": "Davidu obećanih milosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Evo, njega sam dao da bude svedok narodima;",
            "poem": 1
          },
          {
            "text": "vladar i zapovednik narodima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Evo, puk koji ga ne poznaješ pozvaćeš;",
            "poem": 1
          },
          {
            "text": "puk koji tebe ne poznaje pohrliće tebi",
            "poem": 2
          },
          {
            "text": "radi Gospoda Boga tvojega",
            "poem": 1
          },
          {
            "text": "i za Svetitelja Izrailjeva",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "koji ti je dao dostojanstvo.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Gospod je blizu"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Tražite Gospoda dok se može naći!",
            "poem": 1
          },
          {
            "text": "Prizivajte ga dok je blizu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Neka opaki put svoj ostavi",
            "poem": 1
          },
          {
            "text": "i nikogović svoje zamisli,",
            "poem": 2
          },
          {
            "text": "i neka se Gospodu vrati, a on će mu se smilovati;",
            "poem": 1
          },
          {
            "text": "i Bogu našem zato što umnožava praštanje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "„Jer, zamisli vaše nisu zamisli moje,",
            "poem": 1
          },
          {
            "text": "i putevi moji nisu putevi vaši",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Nego, koliko je nebo nad zemljom visoko,",
            "poem": 1
          },
          {
            "text": "toliko su putevi moji visoko nad putevima vašim,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a zamisli moje iznad zamisli vaših.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Moć Gospodnje reči"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Jer kao što kiša pada",
            "poem": 1
          },
          {
            "text": "i sneg sa nebesa",
            "poem": 2
          },
          {
            "text": "i ne vraća se pusta,",
            "poem": 1
          },
          {
            "text": "nego natapa zemlju,",
            "poem": 2
          },
          {
            "text": "te biva plodna i rodna;",
            "poem": 1
          },
          {
            "text": "pa daje seme onome koji seje i hranu onome koji jede,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "takva je reč moja što iz mojih usta izlazi,",
            "poem": 1
          },
          {
            "text": "neće mi se vratiti prazna,",
            "poem": 2
          },
          {
            "text": "nego će učiniti ono što mi se sviđa",
            "poem": 1
          },
          {
            "text": "i napredovaće radi čega sam je poslao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Zapis o budućem blagoslovu"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Da, s radošću ćete otići,",
            "poem": 1
          },
          {
            "text": "i u miru ćete biti vođeni.",
            "poem": 2
          },
          {
            "text": "Planine i bregovi",
            "poem": 1
          },
          {
            "text": "klicaće pred vama veselo,",
            "poem": 2
          },
          {
            "text": "i svako drvo zeleno",
            "poem": 1
          },
          {
            "text": "zapljeskaće dlanovima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Umesto trnja će rasti čempresi,",
            "poem": 1
          },
          {
            "text": "umesto koprive će rasti mirta.",
            "poem": 2
          },
          {
            "text": "I biće radi Gospodnjeg imena,",
            "poem": 1
          },
          {
            "text": "radi znaka večnoga, nerazorivoga.“",
            "poem": 2
          }
        ]
      }
    ],
