  "chapter": {
    "number": 65,
    "content": [
      {
        "type": "heading",
        "content": [
          "Protiv idola, a za Jerusalim"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "„Potražili su me koji nisu pitali,",
            "poem": 1
          },
          {
            "text": "našli su me koji nisu iskali.",
            "poem": 2
          },
          {
            "text": "Rekao sam: ’Evo me! Evo me!’",
            "poem": 1
          },
          {
            "text": "puku koji moje ime prizivao nije.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ruke svoje pružao sam vazdan",
            "poem": 1
          },
          {
            "text": "prema narodu odmetničkom,",
            "poem": 2
          },
          {
            "text": "koji putem nevaljanim hoda",
            "poem": 1
          },
          {
            "text": "po svojim zamislima;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "narodu koji me u lice",
            "poem": 1
          },
          {
            "text": "izaziva stalno,",
            "poem": 2
          },
          {
            "text": "žrtve prinose po vrtovima",
            "poem": 1
          },
          {
            "text": "i kade na opekama,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "borave po grobovima,",
            "poem": 1
          },
          {
            "text": "noć provode po skrivenim mestima,",
            "poem": 2
          },
          {
            "text": "jedu meso svinjsko",
            "poem": 1
          },
          {
            "text": "i drobe gadosti u zdele svoje;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "koji govore: ’Sebe se drži!",
            "poem": 1
          },
          {
            "text": "Ne pristupaj meni, jer sam od tebe svetiji.’",
            "poem": 2
          },
          {
            "text": "Ovi su dim u nosu mom,",
            "poem": 1
          },
          {
            "text": "vatra što povazdan gori.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Evo, zapisano je preda mnom,",
            "poem": 1
          },
          {
            "text": "neću ućutati dok ne namirim,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a namiriću u nedra njihova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Krivice vaše i krivice otaca vaših,",
            "poem": 1
          },
          {
            "text": "zajedno su – govori Gospod –",
            "poem": 2
          },
          {
            "text": "jer oni kade po gorama",
            "poem": 1
          },
          {
            "text": "i ruže me po uzvišicama.",
            "poem": 2
          },
          {
            "text": "I nekadašnje delo njihovo",
            "poem": 1
          },
          {
            "text": "odmeriću u nedra njihova.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Govori Gospod:",
          {
            "text": "„Kao kad se stiče sok u grozdu,",
            "poem": 1
          },
          {
            "text": "pa se kaže: ’Ne zatiri ga.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "U njemu je blagoslov’,",
            "poem": 2
          },
          {
            "text": "tako ću učiniti radi svojih slugu:",
            "poem": 1
          },
          {
            "text": "neću sve to zatrti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "I izvešću iz Jakova potomstvo,",
            "poem": 1
          },
          {
            "text": "i iz Jude mojih gora posednika,",
            "poem": 2
          },
          {
            "text": "i to će izabranici moji baštiniti,",
            "poem": 1
          },
          {
            "text": "i sluge moje tamo će se nastaniti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "I Saron će postati za ovce plandište,",
            "poem": 1
          },
          {
            "text": "i dolina Ahor",
            "poem": 2
          },
          {
            "noteId": 15
          },
          {
            "text": "za goveda počivalište –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "narodu mojem koji mene traži.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "A vi, koji ste Gospoda ostavili,",
            "poem": 1
          },
          {
            "text": "koji ste svetu goru moju zaboravili,",
            "poem": 2
          },
          {
            "text": "koji Gadu",
            "poem": 1
          },
          {
            "noteId": 16
          },
          {
            "text": "trpezu postavljate,",
            "poem": 1
          },
          {
            "text": "i koji nalive izlivate na oltar Meniju",
            "poem": 2
          },
          {
            "noteId": 17
          },
          {
            "text": "–",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "za vas odredio sam mač",
            "poem": 1
          },
          {
            "text": "i da se svi savijete radi klanja.",
            "poem": 2
          },
          {
            "text": "Zato što sam zvao i odgovorili niste,",
            "poem": 1
          },
          {
            "text": "što sam govorio i slušali niste.",
            "poem": 2
          },
          {
            "text": "Nego ste činili ono što ja smatram da je zlo,",
            "poem": 1
          },
          {
            "text": "izabrali ste ono što mi nije ugodno.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Zato govori Gospodar Gospod:",
          {
            "text": "„Evo, sluge moje će jesti,",
            "poem": 1
          },
          {
            "text": "a vi ćete gladovati.",
            "poem": 2
          },
          {
            "text": "Evo, sluge moje će piti,",
            "poem": 1
          },
          {
            "text": "a vi ćete žedni biti.",
            "poem": 2
          },
          {
            "text": "Evo, sluge moje će se radovati,",
            "poem": 1
          },
          {
            "text": "a vi ćete se stideti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Evo, sluge moje će se veseliti",
            "poem": 1
          },
          {
            "text": "zbog dobra u srcu,",
            "poem": 2
          },
          {
            "text": "a vi ćete vikati",
            "poem": 1
          },
          {
            "text": "zbog bola u srcu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i tugovaćete zbog slomljenog duha.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "I ostavićete ime svoje",
            "poem": 1
          },
          {
            "text": "da njim kunu moji izabranici:",
            "poem": 2
          },
          {
            "text": "i neka te usmrti Gospodar Gospod!",
            "poem": 1
          },
          {
            "text": "A sluge ću svoje drugim imenom nazvati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Širom zemlje ko se bude blagosiljao,",
            "poem": 1
          },
          {
            "text": "neka se blagosilja Bogom vernim.",
            "poem": 2
          },
          {
            "text": "I ko se bude zaklinjao širom zemlje,",
            "poem": 1
          },
          {
            "text": "neka se zaklinje Bogom vernim.",
            "poem": 2
          },
          {
            "text": "Naime, pređašnje nevolje će biti zaboravljene,",
            "poem": 1
          },
          {
            "text": "i zato će biti od očiju mojih sakrivene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Nova nebesa i nova zemlja"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Jer, gle, ja stvaram",
            "poem": 1
          },
          {
            "text": "nebesa nova i zemlju novu,",
            "poem": 2
          },
          {
            "text": "i pređašnje se pominjati neće,",
            "poem": 1
          },
          {
            "text": "i na um vam to padati neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Stoga veselite se i kličite",
            "poem": 1
          },
          {
            "text": "od kolena do kolena za ono što stvaram.",
            "poem": 2
          },
          {
            "text": "A evo, ja stvaram od Jerusalima klicanje",
            "poem": 1
          },
          {
            "text": "i od naroda njegova veselje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "I klicaće u Jerusalimu,",
            "poem": 1
          },
          {
            "text": "i veseliće se u mom narodu;",
            "poem": 2
          },
          {
            "text": "i više u njemu čuti se neće",
            "poem": 1
          },
          {
            "text": "glas koji oplakuje i glas koji vapi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Tamo više neće biti",
            "poem": 1
          },
          {
            "text": "odojčeta kratkoga života,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ni starca koji ne bi navršio dane svoje,",
            "poem": 2
          },
          {
            "text": "jer će mladić kao stogodišnjak umirati,",
            "poem": 1
          },
          {
            "text": "i stogodišnji grešnik",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "prokletim će se smatrati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "I kuće će graditi i nastanjivati,",
            "poem": 1
          },
          {
            "text": "i vinograde saditi i rod njihov jesti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Neće jedni graditi, a drugi nastanjivati;",
            "poem": 1
          },
          {
            "text": "neće jedni saditi, a drugi jesti.",
            "poem": 2
          },
          {
            "text": "Nego će kao trajanje drveta",
            "poem": 1
          },
          {
            "text": "biti trajanje naroda mojega,",
            "poem": 2
          },
          {
            "text": "a dela svojih ruku",
            "poem": 1
          },
          {
            "text": "koristiće izabranici moji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Neće se mučiti naprazno,",
            "poem": 1
          },
          {
            "text": "niti će rađati za užas,",
            "poem": 2
          },
          {
            "text": "jer oni će biti potomstvo blagoslovenih od Gospoda",
            "poem": 1
          },
          {
            "text": "i izdanci njihovi s njima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "I biće pre nego što će prizvati,",
            "poem": 1
          },
          {
            "text": "a ja ću im odgovoriti;",
            "poem": 2
          },
          {
            "text": "još dok budu govorili,",
            "poem": 1
          },
          {
            "text": "ja ću ih uslišiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Vuk i jagnje zajedno će se napasati,",
            "poem": 1
          },
          {
            "text": "i lav će slično volu slamu jesti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a zmiji će prašina biti za hranu.",
            "poem": 2
          },
          {
            "text": "Oni zlo činiti neće, i potirati neće",
            "poem": 1
          },
          {
            "text": "nigde na svetoj gori mojoj",
            "poem": 2
          },
          {
            "text": "– govori Gospod.“",
            "poem": 3
          }
        ]
      }
    ],
