  "chapter": {
    "number": 52,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Probudi se! Probudi se!",
            "poem": 1
          },
          {
            "text": "Odeni se u svoju snagu, Sione!",
            "poem": 2
          },
          {
            "text": "Odeni se ogrtačem sjajnosti svoje,",
            "poem": 1
          },
          {
            "text": "Jerusalime, grade sveti,",
            "poem": 2
          },
          {
            "text": "jer u tebe više ulaziti neće",
            "poem": 1
          },
          {
            "text": "neobrezani i nečisti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Stresi sa sebe prašinu i ustani,",
            "poem": 1
          },
          {
            "text": "ustoliči se, Jerusalime!",
            "poem": 2
          },
          {
            "text": "Skini okove sa svoga vrata,",
            "poem": 1
          },
          {
            "text": "zaboravljena ćerko sionska.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Jer govori Gospod:",
          {
            "text": "„Eto, bili ste prodani",
            "poem": 1
          },
          {
            "text": "i bez novca ćete biti otkupljeni.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Jer govori Gospodar Gospod:",
          {
            "text": "„U Egipat je nekada narod moj sišao da tamo stranac bude,",
            "poem": 1
          },
          {
            "text": "a Asir mu je ni zbog čega nasilje činio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "A sada, zašto sam ja ovde? – govori Gospod.",
          {
            "text": "Zato što je bez razloga porobljen moj narod,",
            "poem": 1
          },
          {
            "text": "a porobljivači njegovi likuju – govori Gospod –",
            "poem": 2
          },
          {
            "text": "i bez prestanka, povazdan",
            "poem": 1
          },
          {
            "text": "vređa se moje ime.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Zato će narod moj poznati ime moje.",
            "poem": 1
          },
          {
            "text": "Zato će u onaj dan znati",
            "poem": 2
          },
          {
            "text": "da sam ja onaj koji govori:",
            "poem": 1
          },
          {
            "text": "’Evo me!’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Otrežnjenje i radost"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Kako li su divne po gorama",
            "poem": 1
          },
          {
            "text": "noge blagovesnika koji najavljuje mir,",
            "poem": 2
          },
          {
            "text": "blagovesnika dobrote koji najavljuje spasenje,",
            "poem": 1
          },
          {
            "text": "govoreći Sionu: „Bog tvoj caruje!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Glas stražara tvojih se podiže,",
            "poem": 1
          },
          {
            "text": "glas zajedničkog klicanja,",
            "poem": 2
          },
          {
            "text": "jer očima svojim gledaju",
            "poem": 1
          },
          {
            "text": "kako se Gospod vraća na Sion.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Podvriskujte i kličite zajedno,",
            "poem": 1
          },
          {
            "text": "razvaline jerusalimske,",
            "poem": 2
          },
          {
            "text": "jer Gospod je narod svoj utešio,",
            "poem": 1
          },
          {
            "text": "Jerusalim otkupio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Svoju svetu mišicu Gospod je otkrio",
            "poem": 1
          },
          {
            "text": "da svi puci gledaju,",
            "poem": 2
          },
          {
            "text": "da svi krajevi zemljini vide",
            "poem": 1
          },
          {
            "text": "kako naš Bog spasava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Odlazite! Odlazite! Odatle izađite!",
            "poem": 1
          },
          {
            "text": "Nečistote ne dotičite!",
            "poem": 2
          },
          {
            "text": "Iz sredine njegove izađite! Sebe očistite,",
            "poem": 1
          },
          {
            "text": "koji posude Gospodnje podižete.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Jer u žurbi izlaziti nećete,",
            "poem": 1
          },
          {
            "text": "i bežati nećete,",
            "poem": 2
          },
          {
            "text": "zato što ispred vas ide Gospod,",
            "poem": 1
          },
          {
            "text": "a iza vašeg stroja je Bog Izrailjev.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "O Božijem sluzi, Pesma četvrta"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "„Gle, moj Sluga će uspevati,",
            "poem": 1
          },
          {
            "text": "uzvisiće se i uzdignuti, i veoma uzveličati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Kako su se mnogi užasnuli nad njim",
            "poem": 1
          },
          {
            "noteId": 13
          },
          {
            "text": ":",
            "poem": 1
          },
          {
            "text": "tako iznakažen njegov ljudski lik",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i pojava njegova među potomcima ljudi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ipak, poškropiće on narode mnoge",
            "poem": 1
          },
          {
            "noteId": 14
          },
          {
            "text": ",",
            "poem": 1
          },
          {
            "text": "ni pisnuti neće carevi,",
            "poem": 2
          },
          {
            "text": "jer videće što im niko objavio nije,",
            "poem": 1
          },
          {
            "text": "i shvatiće o kome čuli nisu.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 13,
        "caller": "+",
        "text": "52,14 U izvornom tekstu stoji nad tobom, tj. nad Slugom.",
        "reference": {
          "chapter": 52,
          "verse": 14
        }
      },
      {
        "noteId": 14,
        "caller": "+",
        "text": "52,15 I ovaj prevod je moguć: Ipak, puci mnogi diviće se njemu.",
        "reference": {
          "chapter": 52,
          "verse": 15
        }
      }
    ]
