  "chapter": {
    "number": 60,
    "content": [
      {
        "type": "heading",
        "content": [
          "Ustani, Jerusalime!"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ustani, zasvetli, jer dolazi svetlost tvoja,",
            "poem": 1
          },
          {
            "text": "i slava Gospodnja nad tobom blista.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Jer, gle, mrak će pokriti zemlju,",
            "poem": 1
          },
          {
            "text": "i gusta tama narode,",
            "poem": 2
          },
          {
            "text": "a nad tobom blista Gospod,",
            "poem": 1
          },
          {
            "text": "i slava njegova nad tobom se javlja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "I puci idu prema tvojoj svetlosti,",
            "poem": 1
          },
          {
            "text": "i carevi prema sjaju blistanja tvoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Obazri se oko sebe i gledaj:",
            "poem": 1
          },
          {
            "text": "svi se oni sakupljaju,",
            "poem": 2
          },
          {
            "text": "sinovi tvoji dolaze ti iz daleka,",
            "poem": 1
          },
          {
            "text": "i ćerke tvoje bivaju donesene u naručju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Tada ćeš gledati i bujati,",
            "poem": 1
          },
          {
            "text": "i ustreptaće i širiće se srce tvoje,",
            "poem": 2
          },
          {
            "text": "jer će se bogatstvo s mora k tebi okrenuti,",
            "poem": 1
          },
          {
            "text": "blago tuđih naroda tebi će pristizati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Mnoštvo kamila tebe će prekriti,",
            "poem": 1
          },
          {
            "text": "jednogrbe kamile iz Madijana i Gefe,",
            "poem": 2
          },
          {
            "text": "svi će oni doći iz Save,",
            "poem": 1
          },
          {
            "text": "doneće zlato i tamjan,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i blagovestiće pevajući pohvale Gospodu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Sva stada iz Kedra k tebi će se sabrati,",
            "poem": 1
          },
          {
            "text": "ovnovi iz Navajota tebi će služiti;",
            "poem": 2
          },
          {
            "text": "podizaće se kao ugodna žrtva na žrtveniku mom.",
            "poem": 1
          },
          {
            "text": "I proslaviću Dom slavnosti svoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ko su oni što nadleću kao oblak tamni,",
            "poem": 1
          },
          {
            "text": "kao golubovi prema golubnjacima svojim?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Na mene ostrva čekaju,",
            "poem": 1
          },
          {
            "text": "na čelu su im iz Tarsisa brodovi,",
            "poem": 2
          },
          {
            "text": "da izdaleka dovedu sinove tvoje,",
            "poem": 1
          },
          {
            "text": "srebro njihovo i zlato njihovo s njima,",
            "poem": 2
          },
          {
            "text": "za ime Gospoda Boga tvojega,",
            "poem": 1
          },
          {
            "text": "za Svetitelja Izrailjeva",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "koji te je slavnim učinio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Sinovi stranaca gradiće tvrđave tvoje",
            "poem": 1
          },
          {
            "text": "i carevi njihovi tebe će opsluživati,",
            "poem": 2
          },
          {
            "text": "jer sam te udario u srdnji svojoj,",
            "poem": 1
          },
          {
            "text": "a smilovao sam ti se po raspoloženju svojem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Vratnice će tvoje svagda otvorene biti,",
            "poem": 1
          },
          {
            "text": "danju i noću zatvarati se neće,",
            "poem": 2
          },
          {
            "text": "da bi propustile blago tuđinskih naroda",
            "poem": 1
          },
          {
            "text": "i careve njihove koji ih predvode.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ta propašće puk i carstvo",
            "poem": 1
          },
          {
            "text": "koji tebi ne budu služili,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i ti će puci biti potpuno zatrti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Slava livanska doći će tebi:",
            "poem": 1
          },
          {
            "text": "čempres, brest i šimšir skupa,",
            "poem": 2
          },
          {
            "text": "da ukrase mesto Svetilišta mojega,",
            "poem": 1
          },
          {
            "text": "da učine časnim mesto ispod nogu mojih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "I ići će prema tebi pognuti sinovi tlačitelja tvojih,",
            "poem": 1
          },
          {
            "text": "i padaće ka tvojim stopama svi koji su te prezirali.",
            "poem": 2
          },
          {
            "text": "A tebe će nazvati: ’Grad Gospodnji’,",
            "poem": 1
          },
          {
            "text": "’Sion Svetitelja Izrailjeva.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Umesto da budeš napušten",
            "poem": 1
          },
          {
            "text": "i omrznut i izbegavan,",
            "poem": 2
          },
          {
            "text": "postaviću te da budeš ponos večni,",
            "poem": 1
          },
          {
            "text": "veselje od roda do roda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "I sisaćeš mleko stranih naroda,",
            "poem": 1
          },
          {
            "text": "i carske grudi će te dojiti,",
            "poem": 2
          },
          {
            "text": "i znaćeš da sam ja Gospod, Spasitelj tvoj,",
            "poem": 1
          },
          {
            "text": "Otkupitelj tvoj, Silni Jakovljev.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Umesto bronze dovešću ti zlato,",
            "poem": 1
          },
          {
            "text": "i umesto gvožđa dovešću ti srebro,",
            "poem": 2
          },
          {
            "text": "i umesto drveta bronzu,",
            "poem": 1
          },
          {
            "text": "i umesto kamena gvožđe,",
            "poem": 2
          },
          {
            "text": "a za nadzornika ću ti postaviti Mir,",
            "poem": 1
          },
          {
            "text": "i upravitelj tvoj biće Pravda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Više se neće čuti o nasilju u tvojoj zemlji,",
            "poem": 1
          },
          {
            "text": "o tlačenju i rušenju u granicama tvojim.",
            "poem": 2
          },
          {
            "text": "I zidine tvoje zvaćeš ’Spas’,",
            "poem": 1
          },
          {
            "text": "i vratnice tvoje ’Proslavljanje’.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Više ti neće biti sunce kao svetlost danju,",
            "poem": 1
          },
          {
            "text": "niti će sjaj meseca da ti svetli.",
            "poem": 2
          },
          {
            "text": "Nego će ti Gospod biti svetlost večna",
            "poem": 1
          },
          {
            "text": "i Bog tvoj slavnost tvoja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Sunce tvoje zalaziti više neće,",
            "poem": 1
          },
          {
            "text": "ni mesec ti se pomračiti neće,",
            "poem": 2
          },
          {
            "text": "nego će ti Gospod večna svetlost biti,",
            "poem": 1
          },
          {
            "text": "i navršiće se dani žalosti tvoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "I u narodu tvome svi će biti pravednici,",
            "poem": 1
          },
          {
            "text": "doveka će zemlju zauzimati,",
            "poem": 2
          },
          {
            "text": "izdanak nasada moga,",
            "poem": 1
          },
          {
            "text": "izrada ruku mojih,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "slavnosti radi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Od najmanjeg postaće hiljada,",
            "poem": 1
          },
          {
            "text": "od sitnoga jedan moćni puk.",
            "poem": 2
          },
          {
            "text": "Ja, Gospod,",
            "poem": 1
          },
          {
            "text": "činiću brzo u vreme pogodno.",
            "poem": 2
          }
        ]
      }
    ],
