  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "heading",
        "content": [
          "Pesma o vinogradu"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Zapevaću miljeniku svome,",
            "poem": 1
          },
          {
            "text": "pesmu ljubavnika svojega o vinogradu njegovom.",
            "poem": 2
          },
          {
            "text": "Moj miljenik je vinograd imao",
            "poem": 1
          },
          {
            "text": "na brdašcu rodnome.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "On ga okopa i od kamenja očisti,",
            "poem": 1
          },
          {
            "text": "te lozu plemenitu u njemu posadi.",
            "poem": 2
          },
          {
            "text": "Posred njega on kulu podiže",
            "poem": 1
          },
          {
            "text": "i u njemu muljaru sagradi.",
            "poem": 2
          },
          {
            "text": "Čekao je da mu rodi grožđe,",
            "poem": 1
          },
          {
            "text": "a on njemu izrodi vinjage.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "„Sad, stanovnici jerusalimski, i vi, ljudi Judejci,",
            "poem": 1
          },
          {
            "text": "vi budite sudije na sudu između mene i mog vinograda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Šta još mogoh učiniti za vinograd moj,",
            "poem": 1
          },
          {
            "text": "a da mu nisam učinio?",
            "poem": 2
          },
          {
            "text": "Zašto? Ja se nadah da će roditi grožđe,",
            "poem": 1
          },
          {
            "text": "a on je izrodio vinjage?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "I sad da vam kažem",
            "poem": 1
          },
          {
            "text": "šta ću da učinim vinogradu svome:",
            "poem": 2
          },
          {
            "text": "plot ću njegov ukloniti,",
            "poem": 1
          },
          {
            "text": "neka ga pustoše;",
            "poem": 2
          },
          {
            "text": "zid ću njegov razvaliti,",
            "poem": 1
          },
          {
            "text": "neka ga izgaze;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "u pustoš ću ga pretvoriti,",
            "poem": 1
          },
          {
            "text": "niti će biti orezan, niti će biti okopan;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "neka sav zaraste u bodlje i u trnje;",
            "poem": 2
          },
          {
            "text": "i oblacima ću zabraniti",
            "poem": 1
          },
          {
            "text": "da nad njim kišu puste.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Naime, vinograd Gospoda nad vojskama",
            "poem": 1
          },
          {
            "text": "dom je Izrailjev;",
            "poem": 2
          },
          {
            "text": "i ljudi Judejci",
            "poem": 1
          },
          {
            "text": "zasad su njegov premili.",
            "poem": 2
          },
          {
            "text": "Nadao se on pravu, a eto krvoprolića;",
            "poem": 1
          },
          {
            "text": "nadao se pravednosti, a eto vapaja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Teško onima…"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Teško onima",
            "poem": 1
          },
          {
            "text": "koji primiču kuću uz kuću, polje uz polje,",
            "poem": 2
          },
          {
            "text": "sastavljaju dok sve mesto ne zauzmu,",
            "poem": 1
          },
          {
            "text": "te da jedini sred zemlje ostanu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Ušima svojim slušam Gospoda nad vojskama:",
          {
            "text": "„Baš će kuće mnoge opusteti,",
            "poem": 1
          },
          {
            "text": "velike i lepe bez žitelja ostati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Jer vinograd od deset vata",
            "poem": 1
          },
          {
            "noteId": 1
          },
          {
            "text": "samo će bačvicu dati,",
            "poem": 1
          },
          {
            "text": "i zasejana mera daće deseti deo.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Teško onima koji rano rane",
            "poem": 1
          },
          {
            "text": "da se opijaju pićem žestokim,",
            "poem": 2
          },
          {
            "text": "nastavljaju do rasvitka",
            "poem": 1
          },
          {
            "text": "zato što ih vino raspaljuje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Harfe i lire,",
            "poem": 1
          },
          {
            "text": "bubnjevi i frule i vino na gozbama su njihovim;",
            "poem": 2
          },
          {
            "text": "a za delo Gospodnje ne mare,",
            "poem": 1
          },
          {
            "text": "i rad ruku njegovih ne gledaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Zato što znanja nema,",
            "poem": 1
          },
          {
            "text": "narod moj će u ropstvo odveden biti;",
            "poem": 2
          },
          {
            "text": "i slavni njegovi će od gladi umirati,",
            "poem": 1
          },
          {
            "text": "i mnoštvo će njegovo od žeđi goreti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Zato je Svet mrtvih",
            "poem": 1
          },
          {
            "noteId": 2
          },
          {
            "text": "ždrelo svoje razvalio,",
            "poem": 1
          },
          {
            "text": "i neizmerne ralje razjapio",
            "poem": 2
          },
          {
            "text": "da se u njih strmoglave slava njegova i mnoštvo njegovo",
            "poem": 1
          },
          {
            "text": "uz buku njegovu i viku njegovu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "I čovek će se savijati,",
            "poem": 1
          },
          {
            "text": "i muževan će ponižen biti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i silnici će pogled oboriti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Gospod nad vojskama sudom će se uzvisiti,",
            "poem": 1
          },
          {
            "text": "i Bog sveti svetost će pravdom dokazati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Jaganjci će kao na pašnjacima pasti,",
            "poem": 1
          },
          {
            "text": "i jarci će po bogataškim ruševinama brstiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Teško onima koji na sebe",
            "poem": 1
          },
          {
            "text": "krivicu navlače užima varalačkim",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i opakost konopcima kolskim –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "onima koji govore: „Neka požuri,",
            "poem": 1
          },
          {
            "text": "neka pohita sa onim što čini,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pa da vidimo.",
            "poem": 2
          },
          {
            "text": "Neka se približi i neka dođe Svetitelj Izrailjev",
            "poem": 1
          },
          {
            "text": "sa onim što je naumio,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pa da znamo!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Teško onima koji zlo dobrim nazivaju,",
            "poem": 1
          },
          {
            "text": "a dobro zlim;",
            "poem": 2
          },
          {
            "text": "tamu kao svetlost predstavljaju,",
            "poem": 1
          },
          {
            "text": "a svetlost kao tamu;",
            "poem": 2
          },
          {
            "text": "gorko kao slatko predstavljaju,",
            "poem": 1
          },
          {
            "text": "a slatko kao gorko!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Teško onima koji u svojim očima su mudri",
            "poem": 1
          },
          {
            "text": "i sami pred sobom pametni!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Teško onima koji su u vinu silni,",
            "poem": 1
          },
          {
            "text": "i u mešanju žestokih pića hrabri;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "koji za mito krivca opravdavaju,",
            "poem": 1
          },
          {
            "text": "i pravedničku pravednost potiskuju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Zato, kao što plameni jezici strnjiku proždiru,",
            "poem": 1
          },
          {
            "text": "i kao što vatra seno proguta,",
            "poem": 2
          },
          {
            "text": "tako će koren njihov istrunuti,",
            "poem": 1
          },
          {
            "text": "kao prah će se pupoljak njihov razleteti;",
            "poem": 2
          },
          {
            "text": "zato što odbaciše Zakon Gospoda nad vojskama",
            "poem": 1
          },
          {
            "text": "i prezreše reč Svetitelja Izrailjeva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Gnev Gospodnji"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Zato se raspalio gnev Gospodnji protiv njegovog naroda,",
            "poem": 1
          },
          {
            "text": "te on na njega podiže ruku svoju i tako ga udari",
            "poem": 2
          },
          {
            "text": "da se potresoše planine;",
            "poem": 1
          },
          {
            "text": "pa telesa njihova leže kao smeće posred ulica.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ipak, gnev se njegov još ne smiruje,",
            "poem": 1
          },
          {
            "text": "još je ispružena ruka njegova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Nadiru Asirci"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "On podiže ratnu zastavu narodima izdaleka;",
            "poem": 1
          },
          {
            "text": "i on im zazviždi do kraja zemlje;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i gle, brzom hitrinom oni dolaze.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Među njima nema ni umorna, ni sustala,",
            "poem": 1
          },
          {
            "text": "ni dremljiva, ni pospana;",
            "poem": 2
          },
          {
            "text": "ni da im se pojas oko struka raspasuje,",
            "poem": 1
          },
          {
            "text": "ni da im se remen na sandali dreši.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Njihove su strele dobro zašiljene;",
            "poem": 1
          },
          {
            "text": "njihovi su lukovi svi zapeti;",
            "poem": 2
          },
          {
            "text": "njihovih konja kopita su kao kremen;",
            "poem": 1
          },
          {
            "text": "njihovi su točkovi kao vihor.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Njihova je rika kao u lava,",
            "poem": 1
          },
          {
            "text": "oni riču kao mlada zver,",
            "poem": 2
          },
          {
            "text": "i reže, i plene, i odnose,",
            "poem": 1
          },
          {
            "text": "i niko ih ne sprečava.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "I režaće na njega u dan onaj",
            "poem": 1
          },
          {
            "text": "kao more kada reži.",
            "poem": 2
          },
          {
            "text": "Pogleda li neko na zemlju,",
            "poem": 1
          },
          {
            "text": "gle, tama je i teskoba,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i svetlost zamračena oblacima njenim.",
            "poem": 2
          }
        ]
      }
    ],
