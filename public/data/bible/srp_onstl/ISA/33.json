  "chapter": {
    "number": 33,
    "content": [
      {
        "type": "heading",
        "content": [
          "Nada u Gospoda"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Teško tebi,",
            "poem": 1
          },
          {
            "text": "razaraš, a nisi razoren,",
            "poem": 2
          },
          {
            "text": "i izdajnik si,",
            "poem": 1
          },
          {
            "text": "a tebe nisu izdali.",
            "poem": 2
          },
          {
            "text": "Kad prestaneš da razaraš,",
            "poem": 1
          },
          {
            "text": "ti ćeš biti razoren;",
            "poem": 2
          },
          {
            "text": "kad završiš sa izdajništvom,",
            "poem": 1
          },
          {
            "text": "tebe će izdati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Gospode, smiluj se nama,",
            "poem": 1
          },
          {
            "text": "ti si naša nada.",
            "poem": 2
          },
          {
            "text": "Budi njihova mišica jutrima,",
            "poem": 1
          },
          {
            "text": "i naše spasenje u vreme nevolje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Narodi su pobegli pred gomilom koja tutnji,",
            "poem": 1
          },
          {
            "text": "puci su se raspršili pred uzvišenošću tvojom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "I vaš plen se sakuplja, sakupljaju se gusenice,",
            "poem": 1
          },
          {
            "text": "kao što skakavci tumaraju, tako on optrčava oko njega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Gospod je uzvišen zato što na visini stanuje,",
            "poem": 1
          },
          {
            "text": "i napunio je Sion pravom i pravednošću.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "I tvoja bezbedna vremena",
            "poem": 1
          },
          {
            "text": "biće spaseno bogatstvo, mudrost i znanje.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Njegova je riznica bogobojaznost.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Gospod će doći"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Gle, delije kukaju napolju,",
            "poem": 1
          },
          {
            "text": "glasnici za mir zaplakaće gorko.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Opusteli su drumovi,",
            "poem": 1
          },
          {
            "text": "prestali su da putuju putnici.",
            "poem": 2
          },
          {
            "text": "Savez je raskinuo,",
            "poem": 1
          },
          {
            "text": "gradove odbacio,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "čoveka ne poštuje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Tuguje, klone zemlja;",
            "poem": 1
          },
          {
            "text": "Livan je postiđen i vene,",
            "poem": 2
          },
          {
            "text": "Saron je postao kao pustara,",
            "poem": 1
          },
          {
            "text": "Vasan i Karmil su bez lišća.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "„Sad ću ustati – govori Gospod.",
            "poem": 1
          },
          {
            "text": "Sad ću biti uzvišen.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Sad ću biti podignut.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Zasejali ste seno,",
            "poem": 1
          },
          {
            "text": "rodićete strnjiku.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Proždreće vas vaš ognjeni dah.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "I biće narodi kao peći za kreč,",
            "poem": 1
          },
          {
            "text": "trnje posečeno u vatri će izgoreti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Vi, koji ste daleko, čujte šta sam učinio;",
            "poem": 1
          },
          {
            "text": "a vi, koji ste blizu, upoznajte silu moju:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "strepe na Sionu grešnici,",
            "poem": 1
          },
          {
            "text": "užas spopada prokletnike.",
            "poem": 2
          },
          {
            "text": "’Ko od nas će opstati pred vatrom što proždire?",
            "poem": 1
          },
          {
            "text": "Ko od nas će opstati pred požarom večnim?’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Onaj koji živi pravedno",
            "poem": 1
          },
          {
            "text": "i koji govori čestito,",
            "poem": 2
          },
          {
            "text": "prezire zarađeno na nasilju,",
            "poem": 1
          },
          {
            "text": "stresa mito sa svojih dlanova,",
            "poem": 2
          },
          {
            "text": "odbija da posluša za krvoproliće,",
            "poem": 1
          },
          {
            "text": "i neće da gleda da se čini zlo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Taj će stanovati na visinama,",
            "poem": 1
          },
          {
            "text": "zaklon će mu biti tvrđave na stenama,",
            "poem": 2
          },
          {
            "text": "hranu će dobijati redovno",
            "poem": 1
          },
          {
            "text": "i voda će mu biti obezbeđena.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Budućnost u slavi"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Oči tvoje gledaće cara u lepoti njegovoj,",
            "poem": 1
          },
          {
            "text": "posmatraće zemlju oblasti dalekih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Srce će tvoje razmatrati užas:",
            "poem": 1
          },
          {
            "text": "’Gde je onaj što broji?",
            "poem": 2
          },
          {
            "text": "Gde je onaj što meri?",
            "poem": 1
          },
          {
            "text": "Gde je onaj što kule broji?’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Nećeš videti naroda žestokog,",
            "poem": 1
          },
          {
            "text": "naroda čiji se govor teško sluša,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jezika stranog što ga niko ne razume.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Pogledaj Sion, grad praznika naših.",
            "poem": 1
          },
          {
            "text": "Oči će tvoje Jerusalim videti,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "boravište zaštićeno, šator neuzdrmani,",
            "poem": 2
          },
          {
            "text": "čiji se stubići ne vade nikada,",
            "poem": 1
          },
          {
            "text": "a nijedno uže njegovo neće se otkinuti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Ta onda ćemo imati dostojanstvenog Gospoda,",
            "poem": 1
          },
          {
            "text": "umesto reka, rukavaca širokih sa obe strane.",
            "poem": 2
          },
          {
            "text": "Neće njime prolaziti lađa na vesla,",
            "poem": 1
          },
          {
            "text": "niti će prodreti zapovednički brod.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Jer: naš sudija je Gospod,",
            "poem": 1
          },
          {
            "text": "naš zakonodavac je Gospod,",
            "poem": 2
          },
          {
            "text": "naš car je Gospod,",
            "poem": 1
          },
          {
            "text": "on će nas spasti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Tvoja užad su popustila,",
            "poem": 1
          },
          {
            "text": "svoje katarke ne mogu držati,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "niti jedra podizati –",
            "poem": 2
          },
          {
            "text": "pa se deli mnogi plen od pljačke;",
            "poem": 1
          },
          {
            "text": "kljasti će otimati otimačinu,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "i nijedan stanovnik neće reći: „Bolestan sam.“",
            "poem": 1
          },
          {
            "text": "Narodu koji boravi u njemu krivica će oproštena biti.",
            "poem": 2
          }
        ]
      }
    ],
