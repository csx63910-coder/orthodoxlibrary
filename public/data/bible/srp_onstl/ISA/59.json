  "chapter": {
    "number": 59,
    "content": [
      {
        "type": "heading",
        "content": [
          "Psalam proroka Isaije"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Gle, nije ruka Gospodnja okraćala da ne spasava,",
            "poem": 1
          },
          {
            "text": "niti je uho njegovo ogluhnulo da ne čuje;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "nego vaše krivice jesu pregrada",
            "poem": 1
          },
          {
            "text": "između vas i Boga vašega,",
            "poem": 2
          },
          {
            "text": "i gresi vaši zaklanjaju lice njegovo od vas",
            "poem": 1
          },
          {
            "text": "da vas ne čuje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jer šake su vaše krvlju zagađene,",
            "poem": 1
          },
          {
            "text": "i prsti su vaši u zločinu,",
            "poem": 2
          },
          {
            "text": "usne vaše govore prevaru,",
            "poem": 1
          },
          {
            "text": "jezik vaš mrmlja podlost.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Na pravednost niko ne poziva,",
            "poem": 1
          },
          {
            "text": "niti iko po istini sudi;",
            "poem": 2
          },
          {
            "text": "uzdaju se u ništavilo, i govore reči isprazne;",
            "poem": 1
          },
          {
            "text": "muku začinju, nevaljalstvo rađaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Jaja gujina legu",
            "poem": 1
          },
          {
            "text": "i mrežu paukovu pletu;",
            "poem": 2
          },
          {
            "text": "od njihovih ko pojede jaja, taj umire;",
            "poem": 1
          },
          {
            "text": "a ako ga razbije, guja se izlegne.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Njihovo pletenje nije za odevanje,",
            "poem": 1
          },
          {
            "text": "njihove izrađevine nisu za pokrivanje.",
            "poem": 2
          },
          {
            "text": "Njihove izrađevine delo su prestupničko",
            "poem": 1
          },
          {
            "text": "i šakama svojim čine nasilje",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Njihove noge u zlo trče",
            "poem": 1
          },
          {
            "text": "i hitre su da prolivaju nevinu krv.",
            "poem": 2
          },
          {
            "text": "Misli njihove misli su prestupničke,",
            "poem": 1
          },
          {
            "text": "pustoš je i propast na drumovima njihovim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Put ka miru oni ne poznaju,",
            "poem": 1
          },
          {
            "text": "na stazama njihovim pravednosti nema.",
            "poem": 2
          },
          {
            "text": "Izopačili su svoje ugažene puteve,",
            "poem": 1
          },
          {
            "text": "ko po takvom putuje, mir ne upoznaje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Zato se pravo od nas udaljilo,",
            "poem": 1
          },
          {
            "text": "i pravednost do nas ne dopire.",
            "poem": 2
          },
          {
            "text": "Nadali smo se svetlosti, a gle, tama;",
            "poem": 1
          },
          {
            "text": "sjajnom sjaju, a hodamo po mraku dubokom;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "po zidu pipamo kao slepi,",
            "poem": 1
          },
          {
            "text": "i tapkamo kao da smo bez očiju;",
            "poem": 2
          },
          {
            "text": "u podne se spotičemo kao da smo u sumraku;",
            "poem": 1
          },
          {
            "text": "u obilju smo kao da smo mrtvi;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "svi mi mumlamo kao da smo medvedi",
            "poem": 1
          },
          {
            "text": "i gukanjem gučemo kao da smo golubovi.",
            "poem": 2
          },
          {
            "text": "Očekujemo sud, a njega nema,",
            "poem": 1
          },
          {
            "text": "spasenje – udaljilo se od nas.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Jer mnogo je naših pobuna pred tobom,",
            "poem": 1
          },
          {
            "text": "i gresi naši svedoče protiv nas.",
            "poem": 2
          },
          {
            "text": "Zaista, mi uviđamo pobune svoje",
            "poem": 1
          },
          {
            "text": "i upoznali smo krivicu svoju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Pobunili smo se i Gospoda se odrekli,",
            "poem": 1
          },
          {
            "text": "odmetnuli se od Boga našega;",
            "poem": 2
          },
          {
            "text": "govorili smo reči podle i otpadničke,",
            "poem": 1
          },
          {
            "text": "izmišljotine i odvajanje, iz srca reči lažljive.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "I tako je pravo potisnuto,",
            "poem": 1
          },
          {
            "text": "i pravda je daleko odgurnuta,",
            "poem": 2
          },
          {
            "text": "jer istina je javno posrnula,",
            "poem": 1
          },
          {
            "text": "i čestitost proći ne može.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Istina biva čerupana,",
            "poem": 1
          },
          {
            "text": "i ko se zla kloni, biva orobljen.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "A Gospod vidi i to je zlo pred njim",
            "poem": 1
          },
          {
            "text": "jer pravice nema.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "I vidi: nema čoveka.",
            "poem": 1
          },
          {
            "text": "I zapanji se što zastupnika nema.",
            "poem": 2
          },
          {
            "text": "Onda se oslobodi mišica njegova,",
            "poem": 1
          },
          {
            "text": "i bi mu potpora pravednost njegova.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Pravednost je navukao kao oklop,",
            "poem": 1
          },
          {
            "text": "i na glavi mu je spasenje kao kaciga,",
            "poem": 2
          },
          {
            "text": "a odeću osvetničku je navukao kao odoru,",
            "poem": 1
          },
          {
            "text": "i revnošću se ogrnuo kao plaštom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Prema onom što su zaslužili",
            "poem": 1
          },
          {
            "text": "njih će namiriti;",
            "poem": 2
          },
          {
            "text": "prema onom što su zaslužili,",
            "poem": 1
          },
          {
            "text": "zato što su nasrtali, zato što su mrzeli,",
            "poem": 2
          },
          {
            "text": "njih će namiriti,",
            "poem": 1
          },
          {
            "text": "prema onom što su žudeli,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "što su zaslužili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "I videće sa zapada ime Gospodnje,",
            "poem": 1
          },
          {
            "text": "i sa istoka sunčevoga slavu njegovu,",
            "poem": 2
          },
          {
            "text": "jer će doći kao bujica,",
            "poem": 1
          },
          {
            "text": "Duh Gospodnji nju će podsticati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "„A Otkupitelj će doći Sionu",
            "poem": 1
          },
          {
            "text": "i onima koji se u Jakovu odvrate od prestupa",
            "poem": 2
          },
          {
            "text": "– govori Gospod.",
            "poem": 3
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Zapis o Duhu i reči"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Evo, ovo je moj savez s njima, govori Gospod: Duh moj, koji je na tebi, i reči moje, što sam ti ih u usta stavio, neće otići od usta tvojih, ni od usta potomstva tvojega, ni od usta potomaka potomstva tvojega – govori Gospod – kako sada tako i doveka."
        ]
      }
    ],
