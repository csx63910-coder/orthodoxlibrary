  "chapter": {
    "number": 29,
    "content": [
      {
        "type": "heading",
        "content": [
          "Reč o Jerusalimu"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "„Teško Arilu",
            "poem": 1
          },
          {
            "noteId": 8
          },
          {
            "text": ", Arilu,",
            "poem": 1
          },
          {
            "text": "gradu što ga opkoli David.",
            "poem": 2
          },
          {
            "text": "Neka se godina za godinom niže,",
            "poem": 1
          },
          {
            "text": "neka se praznici izređaju,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "onda ću pritisnuti Aril:",
            "poem": 1
          },
          {
            "text": "i biće tuga i žalost,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i meni će biti kao Arilu",
            "poem": 2
          },
          {
            "noteId": 9
          },
          {
            "text": ";",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "opkoliću te unaokolo,",
            "poem": 1
          },
          {
            "text": "oko tebe opkopaću rovove,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "protiv tebe podići nasipe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Oboren ćeš biti i sa zemlje govoriti,",
            "poem": 1
          },
          {
            "text": "rečju prigušenom iz prašine kazivati,",
            "poem": 2
          },
          {
            "text": "i glas će ti biti iz zemlje,",
            "poem": 1
          },
          {
            "text": "kao prizivač duhova besedu ćeš iz prašine šaptati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "I mnoštvo će tuđinaca tvojih biti kao sitan prah,",
            "poem": 1
          },
          {
            "text": "i rulja nasilnika kao pleva razvejana;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i biće iznenada, odjednom,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "pohodiće te Gospod nad vojskama",
            "poem": 1
          },
          {
            "text": "grmljavinom i trusom i bukom velikom,",
            "poem": 2
          },
          {
            "text": "i olujom i plamenom razbuktalim što proždire.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Viđenje noćno biće kao san:",
            "poem": 1
          },
          {
            "text": "mnoštvo svih naroda",
            "poem": 2
          },
          {
            "text": "što protiv Arila vojuju,",
            "poem": 1
          },
          {
            "text": "i svih onih koji na nj zavojštiše",
            "poem": 2
          },
          {
            "text": "i na tvrđave njegove",
            "poem": 1
          },
          {
            "text": "i koji ga pritesniše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Biće kao kad gladan sanja,",
            "poem": 1
          },
          {
            "text": "i gle, on jede",
            "poem": 2
          },
          {
            "text": "i probudi se prazna želuca;",
            "poem": 1
          },
          {
            "text": "i kao kad žedan sanja,",
            "poem": 2
          },
          {
            "text": "i gle, on pije,",
            "poem": 1
          },
          {
            "text": "i probudi se, i gle, iznemogao i suva grla.",
            "poem": 2
          },
          {
            "text": "Tako će se dogoditi mnoštvu svih naroda",
            "poem": 1
          },
          {
            "text": "koji vojuju protiv gore Sion.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Stanite i zapanjite se!",
            "poem": 1
          },
          {
            "text": "Oslepite i obnevidite!",
            "poem": 2
          },
          {
            "text": "Pijani su, ali ne od vina;",
            "poem": 1
          },
          {
            "text": "i posrću, ali ne od prepečenice.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Gospod je na vas izlio duboki san,",
            "poem": 1
          },
          {
            "text": "i zatvorio je oči vaše – proroke,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i zastro je glave vaše – videoce.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Pokriveno otkrivanje"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Zato će svako vaše viđenje biti kao reči u zapečaćenom svitku. Daju nekom ko zna da čita i kažu: „Hajde, čitaj ovo!“ On će odgovoriti: „Ne mogu zato što je zapečaćeno.“"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Onda daju nekom ko ne zna da čita i kažu mu: „Hajde, čitaj to!“ On će odgovoriti: „Ne znam da čitam.“"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Božija pretnja"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Gospodar je rekao:",
          {
            "text": "„Zato što ovaj narod pristupa ustima,",
            "poem": 1
          },
          {
            "text": "i čast mi odaje usnama,",
            "poem": 2
          },
          {
            "text": "a srce mu je od mene daleko,",
            "poem": 1
          },
          {
            "text": "i njihova je pobožnost naučena zapovest ljudska;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "zato ću, evo, i nadalje s narodom ovim čuda činiti,",
            "poem": 1
          },
          {
            "text": "čuda i samo čuda;",
            "poem": 2
          },
          {
            "text": "te će propasti mudrost mudraca njegovih,",
            "poem": 1
          },
          {
            "text": "i sakriće se umnost umnika njegovih.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Protiv nepouzdanih savetnika (III)"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Teško onima koji se po dubinama kriju od Gospoda",
            "poem": 1
          },
          {
            "text": "da bi sakrili namere,",
            "poem": 2
          },
          {
            "text": "i koji u tmini deluju i zbore:",
            "poem": 1
          },
          {
            "text": "„Ko nas vidi i ko nas poznaje?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Koliko ste vi naopaki!",
            "poem": 1
          },
          {
            "text": "Ceni li se glina kao grnčar,",
            "poem": 2
          },
          {
            "text": "pa da proizvod rekne svom proizvođaču:",
            "poem": 1
          },
          {
            "text": "„Nije me on načinio!“?",
            "poem": 2
          },
          {
            "text": "Ili lonac da rekne grnčaru:",
            "poem": 1
          },
          {
            "text": "„On ne razaznaje?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Neće li se Livan uskoro u Karmil pretvoriti,",
            "poem": 1
          },
          {
            "text": "a Karmil kao šuma računati?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "I gluvi će u onaj dan slušati reči iz knjige.",
            "poem": 1
          },
          {
            "text": "I iz mraka i tame oči slepih će progledati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "I opet će se ponizni radovati u Gospodu,",
            "poem": 1
          },
          {
            "text": "najbedniji će klicati Svetitelju Izrailjevu,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "jer nasilnik će iščeznuti,",
            "poem": 1
          },
          {
            "text": "i podsmevač će nestati,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i svi koji vrebaju na zlo biće istrebljeni:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "koji druge na greh rečju navode,",
            "poem": 1
          },
          {
            "text": "koji porotniku kod vratnica zamku postavljaju,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pod lažnom optužbom i bez razloga pravednika ruše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Zato govori Gospod, koji je otkupio Avrahama, domu Jakovljevom:",
          {
            "text": "„Od sad Jakov stideti se neće,",
            "poem": 1
          },
          {
            "text": "i od sad lice njegovo bledeti neće,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "jer kad vidi decu svoju,",
            "poem": 1
          },
          {
            "text": "usred sebe delo mojih ruku,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "on će moje ime svetkovati.",
            "poem": 2
          },
          {
            "text": "Svetkovaće Svetitelja Jakovljeva",
            "poem": 1
          },
          {
            "text": "i bojaće se Boga Izrailjeva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Urazumiće se oni koji duhovno lutaju,",
            "poem": 1
          },
          {
            "text": "pouku će primiti oni koji mrmljaju.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 8,
        "caller": "+",
        "text": "29,1 Još jedan naziv za Jerusalim.",
        "reference": {
