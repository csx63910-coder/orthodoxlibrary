  "chapter": {
    "number": 64,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "O, razvedri nebesa i siđi,",
            "poem": 1
          },
          {
            "text": "neka se pred tobom planine zatresu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Kao kad se vatra po granju zapali,",
            "poem": 1
          },
          {
            "text": "vatra zakuva vodu:",
            "poem": 2
          },
          {
            "text": "neka dušmani tvoji shvate ime tvoje,",
            "poem": 1
          },
          {
            "text": "neka puci zadrhću pred tobom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Što ti činiš to zastrašuje;",
            "poem": 1
          },
          {
            "text": "neočekivano si sišao,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pred tobom se zatresle planine.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Od kako je veka nisu čuli,",
            "poem": 1
          },
          {
            "text": "nisu slušali, oko nije videlo,",
            "poem": 2
          },
          {
            "text": "da bog neki osim tebe učini",
            "poem": 1
          },
          {
            "text": "onima koji od njega očekuju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Susretljiv ti si prema razdraganima koji čine pravdu,",
            "poem": 1
          },
          {
            "text": "na putevima tvojim sećaju se tebe.",
            "poem": 2
          },
          {
            "text": "Gle, ti si se razljutio,",
            "poem": 1
          },
          {
            "text": "grešili smo na njima,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a bili bismo spaseni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "I postali smo svi mi kao nešto nečisto,",
            "poem": 1
          },
          {
            "text": "i kao ogrtač sa ženskim odlivom sve su pravednosti naše,",
            "poem": 2
          },
          {
            "text": "i svi smo mi kao lišće kad opadne,",
            "poem": 1
          },
          {
            "text": "i krivice naše kao vetar nas odnesu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "I nikog nema da priziva ime tvoje,",
            "poem": 1
          },
          {
            "text": "da se podigne i na tebe osloni,",
            "poem": 2
          },
          {
            "text": "zato što si lice svoje od nas sakrio",
            "poem": 1
          },
          {
            "text": "i rastapaš nas krivicama našim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Pa ipak, Gospode, ti si Otac naš;",
            "poem": 1
          },
          {
            "text": "mi smo glina, a ti nas oblikuješ,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i svi smo mi ruke tvoje delo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ne srdi se, Gospode, isuviše,",
            "poem": 1
          },
          {
            "text": "i nemoj stalno pominjati nedelo.",
            "poem": 2
          },
          {
            "text": "Evo, pogledaj nas:",
            "poem": 1
          },
          {
            "text": "svi smo mi narod tvoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Opusteli su sveti gradovi tvoji,",
            "poem": 1
          },
          {
            "text": "Sion je opusteo, Jerusalim je opustošen.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Hram, svetinja naša i ponos naš;",
            "poem": 1
          },
          {
            "text": "u čemu su te hvalili preci naši,",
            "poem": 2
          },
          {
            "text": "postao je zgarište",
            "poem": 1
          },
          {
            "text": "i sve dragocenosti naše su satrte.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Zar ćeš ovo mirno gledati, Gospode?",
            "poem": 1
          },
          {
            "text": "Ćutaćeš i još više ponižavati?",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
