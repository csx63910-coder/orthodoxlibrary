  "book": {
    "id": "ISA",
    "translationId": "srp_onstl",
    "name": "Knjiga proroka Isaije",
    "commonName": "Knjiga proroka Isaije",
    "title": "Knjiga proroka Isaije",
    "order": 23,
    "numberOfChapters": 66,
    "sha256": "52a276d08639ef24ff1f18ac3ddbdf0d0026f3b82a6b643d2c93493f58e95dd5",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onstl/ISA/1.json",
    "lastChapterNumber": 66,
    "lastChapterApiLink": "/api/srp_onstl/ISA/66.json",
    "totalNumberOfVerses": 1292
  },
  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Viđenje Isaije sina Amocova, što je za Judu i Jerusalim video u vreme Judinih careva: Ozije, Jotama, Ahaza i Jezekije."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Nerazumni i grešni narod"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Čujte, nebesa! Slušaj, zemljo,",
            "poem": 1
          },
          {
            "text": "jer govori Gospod:",
            "poem": 2
          },
          {
            "text": "„Sinove sam vaspitao i podigao,",
            "poem": 1
          },
          {
            "text": "a oni se odmetnuše od mene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Vo poznaje vlasnika svojega",
            "poem": 1
          },
          {
            "text": "i magarac jasle gospodara svojega.",
            "poem": 2
          },
          {
            "text": "Izrailj ne zna;",
            "poem": 1
          },
          {
            "text": "narod moj ne razume!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Jao, grešnoga li puka,",
            "poem": 1
          },
          {
            "text": "naroda ogrezlog u krivici,",
            "poem": 2
          },
          {
            "text": "potomaka zločinačkih,",
            "poem": 1
          },
          {
            "text": "sinova pokvarenjačkih!",
            "poem": 2
          },
          {
            "text": "Gospoda su ostavili;",
            "poem": 1
          },
          {
            "text": "Svetitelja Izrailjevog prezreli,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "leđa mu okrenuli.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Gde još da udarim,",
            "poem": 1
          },
          {
            "text": "odmetnici tvrdokorni?",
            "poem": 2
          },
          {
            "text": "Sva je glava bolna",
            "poem": 1
          },
          {
            "text": "i sve srce iznemoglo;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "od pete do glave zdravog mesta nema,",
            "poem": 1
          },
          {
            "text": "nego su uboji i modrice i rane otvorene;",
            "poem": 2
          },
          {
            "text": "očišćene nisu,",
            "poem": 1
          },
          {
            "text": "u zavojima nisu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "uljem zablažene nisu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Opustošena vam je zemlja,",
            "poem": 1
          },
          {
            "text": "oganj vam je gradove popalio,",
            "poem": 2
          },
          {
            "text": "vaše njive pred vama haraju tuđinci.",
            "poem": 1
          },
          {
            "text": "Pustoš je kao kad opustoše tuđinci.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ostavljena je ćerka sionska",
            "poem": 1
          },
          {
            "text": "kao senica u vinogradu,",
            "poem": 2
          },
          {
            "text": "kao koliba u gradini za krastavce,",
            "poem": 1
          },
          {
            "text": "kao grad pod opsadom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Da nam Gospod nad vojskama",
            "poem": 1
          },
          {
            "text": "nije ostavio ostatka,",
            "poem": 2
          },
          {
            "text": "kao Sodoma bili bismo,",
            "poem": 1
          },
          {
            "text": "slični Gomori bili bismo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Reč Gospodnju čujte,",
            "poem": 1
          },
          {
            "text": "glavari sodomski!",
            "poem": 2
          },
          {
            "text": "Zakon Boga našeg poslušajte,",
            "poem": 1
          },
          {
            "text": "narode gomorski!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "„Šta li će meni mnoštvo žrtava vaših?",
            "poem": 1
          },
          {
            "text": "– govori Gospod.",
            "poem": 2
          },
          {
            "text": "Sit sam ovnujskih svespalnica",
            "poem": 1
          },
          {
            "text": "i naslaga lojnih sa teladi gojnih.",
            "poem": 2
          },
          {
            "text": "I krv od bikova i jaganjaca i jaraca",
            "poem": 1
          },
          {
            "text": "ne mili se meni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Kad dolazite da mi se pokažete,",
            "poem": 1
          },
          {
            "text": "ko to traži od vas",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da po mojim predvorjima trupkate?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ne umnožavajte bezvredne prinose,",
            "poem": 1
          },
          {
            "text": "kađenje na koje se gadim;",
            "poem": 2
          },
          {
            "text": "mladine i subote, sazivanje saziva,",
            "poem": 1
          },
          {
            "text": "ne podnosim zle",
            "poem": 2
          },
          {
            "noteId": 0
          },
          {
            "text": "svečanosti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Mladine vaše i praznike,",
            "poem": 1
          },
          {
            "text": "to mrzi duša moja,",
            "poem": 2
          },
          {
            "text": "to je teret za me,",
            "poem": 1
          },
          {
            "text": "dodija mi podnositi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Kad za molitvu širite ruke svoje,",
            "poem": 1
          },
          {
            "text": "ja od vas odvraćam oči svoje;",
            "poem": 2
          },
          {
            "text": "i kad produžujete molitvu,",
            "poem": 1
          },
          {
            "text": "ja vas ne slušam.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Vaše su ruke ogrezle u krvi.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Operite sebe, očistite sebe.",
            "poem": 1
          },
          {
            "text": "Uklonite zloću dela vaših ispred očiju mojih.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Prestanite zlo činiti,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "učite se dobro činiti: težite pravu,",
            "poem": 1
          },
          {
            "text": "ublažite ugnjetavanje,",
            "poem": 2
          },
          {
            "text": "dajte prava sirotinji,",
            "poem": 1
          },
          {
            "text": "parničite se u korist udovice.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Zatim dođite da raspravljamo",
            "poem": 1
          },
          {
            "text": "– govori Gospod –",
            "poem": 2
          },
          {
            "text": "budu li gresi vaši kao skerlet,",
            "poem": 1
          },
          {
            "text": "postaće beli kao sneg;",
            "poem": 2
          },
          {
            "text": "budu li crveni kao purpur,",
            "poem": 1
          },
          {
            "text": "postaće kao vuna.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ako budete voljni i poslušate,",
            "poem": 1
          },
          {
            "text": "dobra zemaljska ješćete.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "A ako odbacite i bunite se,",
            "poem": 1
          },
          {
            "text": "mač će vas progutati",
            "poem": 2
          },
          {
            "text": "– jer usta Gospodnja rekoše.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Tužbalica nad Jerusalimom"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Kako se pretvori u bludnicu",
            "poem": 1
          },
          {
            "text": "verna naseobina!",
            "poem": 2
          },
          {
            "text": "Bila je puna pravičnosti,",
            "poem": 1
          },
          {
            "text": "u njoj je boravila pravda,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a sada su ubice.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Tvoje je srebro kao zgura postalo.",
            "poem": 1
          },
          {
            "text": "Tvoje piće se razvodnilo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Tvoji glavari su se odmetnuli,",
            "poem": 1
          },
          {
            "text": "s kradljivcima drugovi su postali.",
            "poem": 2
          },
          {
            "text": "Svaki se grabi za mito",
            "poem": 1
          },
          {
            "text": "i hrli za poklonima.",
            "poem": 2
          },
          {
            "text": "Pravo sirotinji oni uskraćuju;",
            "poem": 1
          },
          {
            "text": "udovičina parnica do njih ne doseže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Zato govori Gospodar,",
            "poem": 1
          },
          {
            "text": "Gospod nad vojskama, Silni Izrailjev:",
            "poem": 2
          },
          {
            "text": "„Ah, kad se iskalim na protivnicima",
            "poem": 1
          },
          {
            "text": "i kad se osvetim neprijateljima!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Kad ruku na tebe ispružim,",
            "poem": 1
          },
          {
            "text": "da lužinom zguru tvoju očistim,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da iz tebe onečišćenja uklonim.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Pa ti sudije opet postavim kao nekad,",
            "poem": 1
          },
          {
            "text": "savetnike kao od davnina,",
            "poem": 2
          },
          {
            "text": "te da te prozovu",
            "poem": 1
          },
          {
            "text": "’Grad pravednosti’,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "’Verna naseobina.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Pravda će otkupiti Sion,",
            "poem": 1
          },
          {
            "text": "i pravednost pokajnike njegove;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "a prestupnici i grešnici zajedno će se skršiti",
            "poem": 1
          },
          {
            "text": "i oni koji napuštaju Gospoda poginuće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Protiv obožavanja svetog drveta"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "„Zbog plemenitog drveća će se stideti,",
            "poem": 1
          },
          {
            "text": "zato što ih slavite;",
            "poem": 2
          },
          {
            "text": "i zbog lugova ćete se crveneti,",
            "poem": 1
          },
          {
            "text": "zato što ste ih izabrali.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Vi ćete biti slični hrastu,",
            "poem": 1
          },
          {
            "text": "s lišćem što se na njemu suši.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Nalik lugu u kom vode nema.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "I skriveno blago će biti kao kučina,",
            "poem": 1
          },
          {
            "text": "i onaj ko ga načini kao varnica –",
            "poem": 2
          },
          {
            "text": "oboje će zajedno izgoreti,",
            "poem": 1
          },
          {
            "text": "a niko neće gasiti.“",
            "poem": 2
          }
        ]
      }
    ],
