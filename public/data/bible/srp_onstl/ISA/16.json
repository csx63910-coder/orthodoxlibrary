  "chapter": {
    "number": 16,
    "content": [
      {
        "type": "heading",
        "content": [
          "Moavci beže u Judu"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Šaljite jagnje vladaru zemlje,",
            "poem": 1
          },
          {
            "text": "od Sele prema pustinji,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "do gore ćerke sionske.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Slično ptici oteranoj,",
            "poem": 1
          },
          {
            "text": "slično gnezdu rasturenom,",
            "poem": 2
          },
          {
            "text": "biće ćerke moavske",
            "poem": 1
          },
          {
            "text": "na gazovima potoka Arnona.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "„Daj nam savet!",
            "poem": 1
          },
          {
            "text": "Donesi presudu!",
            "poem": 2
          },
          {
            "text": "Usred podneva senku svoju",
            "poem": 1
          },
          {
            "text": "kao noć rasprostri.",
            "poem": 2
          },
          {
            "text": "Sakrivaj prognanike!",
            "poem": 1
          },
          {
            "text": "Nemoj izdati begunce!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Pusti da k tebi uteknu prognanici moavski.",
            "poem": 1
          },
          {
            "text": "Budi njihov zaklon ispred pustošnika;",
            "poem": 2
          },
          {
            "text": "jer tlačitelj je skončao,",
            "poem": 1
          },
          {
            "text": "ugnjetač je nestao,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "pustošenje je prestalo,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "gazilac je sa zemlje iščezao.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "„I tad će se učvrstiti presto u milosti,",
            "poem": 1
          },
          {
            "text": "i na njemu će stolovati u istini,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "u šatoru Davidovu,",
            "poem": 2
          },
          {
            "text": "sudija koji zahteva pravednost",
            "poem": 1
          },
          {
            "text": "i vešt je sa pravdom.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Tužbalica nad Moavom"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Čuli smo za moavsku nadmenost,",
            "poem": 1
          },
          {
            "text": "gordost preveliku;",
            "poem": 2
          },
          {
            "text": "za nadmenost njihovu i oholost njihovu.",
            "poem": 1
          },
          {
            "text": "Isprazno je njihovo hvalisanje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Tako nariče Moav,",
            "poem": 1
          },
          {
            "text": "svi nariču nad Moavom,",
            "poem": 2
          },
          {
            "text": "za koljivom od grožđa iz Kir-Eresa",
            "poem": 1
          },
          {
            "noteId": 5
          },
          {
            "text": "tuguju sasvim slomljeni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Uvenuli su zasadi esevonski,",
            "poem": 1
          },
          {
            "text": "vinogradi sivamski,",
            "poem": 2
          },
          {
            "text": "gospodari nad pucima",
            "poem": 1
          },
          {
            "text": "potrše njegove odabrane lozice.",
            "poem": 2
          },
          {
            "text": "Doprli su do Jazira,",
            "poem": 1
          },
          {
            "text": "zamicali u pustinju;",
            "poem": 2
          },
          {
            "text": "ogranci su im dosezali",
            "poem": 1
          },
          {
            "text": "da pređu more.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Zato plačem kao što Jazir oplakuje vinograde sivamske,",
            "poem": 1
          },
          {
            "text": "natapam suzama Esevon i Elealiju;",
            "poem": 2
          },
          {
            "text": "jer nad tvojom berbom i nad tvojom žetvom",
            "poem": 1
          },
          {
            "text": "nestalo je klicanje,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "veselje i radost.",
            "poem": 1
          },
          {
            "text": "U vinogradima nema cike,",
            "poem": 2
          },
          {
            "text": "ne kliče se od radosti;",
            "poem": 1
          },
          {
            "text": "gazilac ne gazi grožđe u kaci,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "zatvorio sam podvikivanje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Zato utroba moja za Moavom kao harfa cvili,",
            "poem": 1
          },
          {
            "text": "i potresen sam za Kir-Eresom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "I biće da će se videti:",
            "poem": 1
          },
          {
            "text": "na uzvišicama umaraju se Moavci,",
            "poem": 2
          },
          {
            "text": "i dolaze na svetilište svoje",
            "poem": 1
          },
          {
            "text": "da se mole, ali to neće ići.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Reč za Moav"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ovo je reč što je Gospod nekad rekao za Moav."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Sad, pak, Gospod kaže govoreći: „Za tri godine, kao tri godine najamničke, moavska će slava potamneti sa svim velikim mnoštvom, a ono malo ostatka biće sitno i slabašno.“"
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 5,
        "caller": "+",
        "text": "16,7 Kir-Areset prema izvornom tekstu, što je najverovatnije isto mesto spomenuto u st. 11.",
        "reference": {
          "chapter": 16,
          "verse": 7
        }
      }
    ]
