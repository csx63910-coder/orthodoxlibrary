  "chapter": {
    "number": 17,
    "content": [
      {
        "type": "heading",
        "content": [
          "Reč za Damask"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Proroštvo protiv Damaska:",
          {
            "text": "„Gle, Damask će prestati da bude grad,",
            "poem": 1
          },
          {
            "text": "i postaće gomila krhotina.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Njegovi gradovi oko Aroira",
            "poem": 1
          },
          {
            "text": "biće za stada i ležaće,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i neće biti zastrašitelja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Jefremovo pleme izgubiće utvrđenje,",
            "poem": 1
          },
          {
            "text": "i Damask carstvo;",
            "poem": 2
          },
          {
            "text": "a ostatku Arama će se dogoditi",
            "poem": 1
          },
          {
            "text": "što i slavi potomaka Izrailjevih –",
            "poem": 2
          },
          {
            "text": "govori Gospod nad vojskama.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "I biće u dan onaj: smanjiće se slava Jakovljeva",
            "poem": 1
          },
          {
            "text": "i splasnuće im salo na telu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "I biće kao kad žetelac žanje žito,",
            "poem": 1
          },
          {
            "text": "i ruka mu klasje hvata;",
            "poem": 2
          },
          {
            "text": "kao kad se skuplja klasje",
            "poem": 1
          },
          {
            "text": "u refaimskoj dolini –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "samo će pabirci ostati;",
            "poem": 1
          },
          {
            "text": "ili kao kad se maslina otrese:",
            "poem": 2
          },
          {
            "text": "dve-tri zrele na vrhu gornje grane,",
            "poem": 1
          },
          {
            "text": "četiri-pet na granama drveta –",
            "poem": 2
          },
          {
            "text": "govori Gospod, Bog Izrailjev.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Okončanje idolopoklonstva"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "U dan onaj čovek će pogledati svoga Sazdatelja,",
            "poem": 1
          },
          {
            "text": "i upraviće oči svoje prema Svetitelju Izrailjevu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Neće više poglédati na žrtvenike,",
            "poem": 1
          },
          {
            "text": "na delo svojih ruku; neće više gledati",
            "poem": 2
          },
          {
            "text": "šta njegovi prsti načiniše:",
            "poem": 1
          },
          {
            "text": "Aštartine stupove i stubove u čast Sunca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Protiv idolskih vrtova"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "U dan onaj utvrđeni gradovi njegovi će biti kao ostavljeni u šumi, kao gornja grana što je ostaviše pred potomcima Izrailjevim; i biće pustošenje."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Zato što si zaboravio Boga koji te spasava,",
            "poem": 1
          },
          {
            "text": "i nisi se setio Stene koja ti daje snagu;",
            "poem": 2
          },
          {
            "text": "zato sadiš ljupke sadove,",
            "poem": 1
          },
          {
            "text": "i kalemiš tuđinske mladice;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "u dan kad ih posadiš, one izrastu,",
            "poem": 1
          },
          {
            "text": "a ujutru tvoje sadnice su bokor;",
            "poem": 2
          },
          {
            "text": "ali žetva odlete u dan nevolje,",
            "poem": 1
          },
          {
            "text": "u dan bola kome leka nema.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Najezda mnogih naroda"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Jao, buka mnogih naroda,",
            "poem": 1
          },
          {
            "text": "buče kao što buči more;",
            "poem": 2
          },
          {
            "text": "šum svetine koja šumi",
            "poem": 1
          },
          {
            "text": "kao silne vode što šumore.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Narodi šumore kao silne vode što šumore,",
            "poem": 1
          },
          {
            "text": "ali kad im on zapreti, oni beže daleko,",
            "poem": 2
          },
          {
            "text": "i razvejani kao pleva po gorama na vetru,",
            "poem": 1
          },
          {
            "text": "kao vrtložići pred vihorom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Dođe veče, eto straha;",
            "poem": 1
          },
          {
            "text": "pre svanuća njega više nema.",
            "poem": 2
          },
          {
            "text": "Tako prolaze oni koji nas plene,",
            "poem": 1
          },
          {
            "text": "i kob je onih koji nas pljačkaju.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
