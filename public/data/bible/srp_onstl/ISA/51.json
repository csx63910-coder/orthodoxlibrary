  "chapter": {
    "number": 51,
    "content": [
      {
        "type": "heading",
        "content": [
          "Spasenje za Avrahamove potomke"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Poslušajte me, sledbenici pravednosti,",
            "poem": 1
          },
          {
            "text": "tražioci Gospoda,",
            "poem": 2
          },
          {
            "text": "osmotrite stenu iz koje ste isklesani,",
            "poem": 1
          },
          {
            "text": "kop istesan iz kog ste iskopani.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Osmotrite Avrahama, oca svojega,",
            "poem": 1
          },
          {
            "text": "i Saru koja vas je rodila.",
            "poem": 2
          },
          {
            "text": "Ta, on je sam bio kad sam ga pozvao,",
            "poem": 1
          },
          {
            "text": "a ipak sam ga blagoslovio i umnožio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ta, Gospod se sažalio nad Sionom,",
            "poem": 1
          },
          {
            "text": "sažalio se nad svim njegovim razvalinama,",
            "poem": 2
          },
          {
            "text": "te će pretvoriti pustinju njegovu u Eden,",
            "poem": 1
          },
          {
            "text": "a pustaru njegovu u vrt Gospodnji.",
            "poem": 2
          },
          {
            "text": "Klicanje i radost odjekivaće po njemu,",
            "poem": 1
          },
          {
            "text": "zahvaljivanja i glas pohvalni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Gospod će suditi narodima i pucima"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Posluhni mene, narode moj, i čuj mene, svete,",
            "poem": 1
          },
          {
            "text": "jer Zakon od mene proističe,",
            "poem": 2
          },
          {
            "text": "i moje ću pravosudstvo hitro postaviti",
            "poem": 1
          },
          {
            "text": "da bude svetlost narodima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Blizu je pravda moja,",
            "poem": 1
          },
          {
            "text": "spasonosno proističe,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a i mišica moja sudiće narodima.",
            "poem": 2
          },
          {
            "text": "Na mene ostrva čekaju",
            "poem": 1
          },
          {
            "text": "i u moju mišicu se uzdaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Oči svoje k nebu podignite,",
            "poem": 1
          },
          {
            "text": "i po zemlji osmotrite dole;",
            "poem": 2
          },
          {
            "text": "jer će nebesa kao dim iščeznuti,",
            "poem": 1
          },
          {
            "text": "i zemlja će se kao ogrtač raskrpati,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i stanovnici njeni kao takvi",
            "poem": 2
          },
          {
            "noteId": 12
          },
          {
            "text": "pomreće;",
            "poem": 2
          },
          {
            "text": "a spasenje moje trajaće doveka,",
            "poem": 1
          },
          {
            "text": "i pravednost moja uzdrmana neće biti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Poslušajte mene, koji poznajete pravdu,",
            "poem": 1
          },
          {
            "text": "narode kome je Zakon moj u srcima:",
            "poem": 2
          },
          {
            "text": "ne bojte se ruganja od ljudi,",
            "poem": 1
          },
          {
            "text": "i neka vas ne uzbuđuje njihovo vređanje,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "jer će ih kao ogrtač pojesti moljac,",
            "poem": 1
          },
          {
            "text": "i kao vunu poješće ih crv;",
            "poem": 2
          },
          {
            "text": "a pravednost moja trajaće doveka,",
            "poem": 1
          },
          {
            "text": "i spasenje moje od kolena do kolena.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Gospod se budi"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Probudi se! Probudi se!",
            "poem": 1
          },
          {
            "text": "Odeni se u snagu, mišice Gospodnja.",
            "poem": 2
          },
          {
            "text": "Probudi se kao u dane drevne,",
            "poem": 1
          },
          {
            "text": "tokom starinskih naraštaja.",
            "poem": 2
          },
          {
            "text": "Nisi li ti ispresecala Ravu,",
            "poem": 1
          },
          {
            "text": "izranjavila morsku neman?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Nisi li ti isušila more,",
            "poem": 1
          },
          {
            "text": "vode bezdana golemih,",
            "poem": 2
          },
          {
            "text": "postavila po dubinama morskim",
            "poem": 1
          },
          {
            "text": "put da prolaze otkupljeni?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Vratiće se izbavljeni Gospodnji,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "doći će u Sion s veseljem",
            "poem": 1
          },
          {
            "text": "i s radošću večnom na čelima;",
            "poem": 2
          },
          {
            "text": "pratiće ih razdraganost i radost,",
            "poem": 1
          },
          {
            "text": "a pobeći će žalost i uzdasi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Svemoćni Gospod teši ljude svoje"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "„Ja, ja sam utešitelj vaš.",
            "poem": 1
          },
          {
            "text": "Ko si ti da se bojiš čoveka smrtnoga",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i sina čovečijeg koji je kao trava?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Zaboravio si Gospoda,",
            "poem": 1
          },
          {
            "text": "koji te je načinio,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "koji je razastro nebesa",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i utemeljio zemlju.",
            "poem": 2
          },
          {
            "text": "Pa si strepeo stalno, povazdan",
            "poem": 1
          },
          {
            "text": "pred licem nadmenog tlačitelja,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kao pred nekim ko postoji da bi razjedao.",
            "poem": 2
          },
          {
            "text": "I… gde je nadmenost tlačitelja?",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Biće izgnanik slobodan ubrzo,",
            "poem": 2
          },
          {
            "text": "i neće umirati da bi bio razjedan,",
            "poem": 1
          },
          {
            "text": "i hleba mu nedostati neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Gospod Bog tvoj sam ja,",
            "poem": 1
          },
          {
            "text": "more uzburkam i talasi mu ključaju.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Gospod nad vojskama ime je njegovo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "I stavio sam reči svoje u usta tvoja,",
            "poem": 1
          },
          {
            "text": "i sakrio te u senku ruke svoje,",
            "poem": 2
          },
          {
            "text": "da razastrem nebesa",
            "poem": 1
          },
          {
            "text": "i utemeljim zemlju,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i kažem Sionu: ’Ti moj narod jesi.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Probudi se, Sveti grade!"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Hajde, probudi se! Hajde, probudi se!",
            "poem": 1
          },
          {
            "text": "Ustani, Jerusalime!",
            "poem": 2
          },
          {
            "text": "Koji si ispio iz ruke Gospodnje",
            "poem": 1
          },
          {
            "text": "čašu jarosti njegove;",
            "poem": 2
          },
          {
            "text": "pehar, čašu opijenosti,",
            "poem": 1
          },
          {
            "text": "ispio do dna.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Od svih sinova koje je rodio",
            "poem": 1
          },
          {
            "text": "nema nijednog da ga vodi.",
            "poem": 2
          },
          {
            "text": "Od svih sinova koje je odgojio",
            "poem": 1
          },
          {
            "text": "nema nijednog da ga za ruku prihvati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ovo te je dvoje zadesilo.",
            "poem": 1
          },
          {
            "text": "Hoće li te iko požaliti?",
            "poem": 2
          },
          {
            "text": "Pustošenje i raspad i glad i mač.",
            "poem": 1
          },
          {
            "text": "Hoće li te iko utešiti?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Sinovi ti leže obamrli",
            "poem": 1
          },
          {
            "text": "po uglovima svih ulica;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kao antilopa u mreži",
            "poem": 2
          },
          {
            "text": "puni jarosti Gospodnje,",
            "poem": 1
          },
          {
            "text": "karanja od Boga tvojega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Zato ovo počuj, poniženi",
            "poem": 1
          },
          {
            "text": "i opijeni, ali ne od vina.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Govori tvoj Gospodar Gospod,",
            "poem": 1
          },
          {
            "text": "Bog tvoj, branilac svog naroda:",
            "poem": 2
          },
          {
            "text": "„Evo, uzimam iz ruke tvoje",
            "poem": 1
          },
          {
            "text": "čašu opijenosti,",
            "poem": 2
          },
          {
            "text": "pehar, čašu jarosti moje.",
            "poem": 1
          },
          {
            "text": "I nikad se više iz nje ispijati neće.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "I to stavljam u ruku onih koji su te žalostili,",
            "poem": 1
          },
          {
            "text": "koji su duši tvojoj govorili:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "’Savij se i prelazićemo!’",
            "poem": 2
          },
          {
            "text": "I namesto tla podmetao si leđa svoja,",
            "poem": 1
          },
          {
            "text": "te su bila put onima koji prelaze.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
    "footnotes": [
      {
        "noteId": 12,
        "caller": "+",
        "text": "51,6 Kao takvi može da se prevede i kao komarci.",
        "reference": {
          "chapter": 51,
          "verse": 6
        }
      }
    ]
