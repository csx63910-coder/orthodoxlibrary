  "chapter": {
    "number": 62,
    "content": [
      {
        "type": "heading",
        "content": [
          "Božija obećanja Jerusalimu"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Siona radi ućutati neću",
            "poem": 1
          },
          {
            "text": "i zbog Jerusalima odmora mi nema,",
            "poem": 2
          },
          {
            "text": "dok njegova pravednost kao bljesak ne sine,",
            "poem": 1
          },
          {
            "text": "i spasenje njegovo kao buktinja se ne razbukti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "I puci će videti pravednost tvoju,",
            "poem": 1
          },
          {
            "text": "svi carevi slavu tvoju.",
            "poem": 2
          },
          {
            "text": "A tebe će novim imenom nazvati,",
            "poem": 1
          },
          {
            "text": "kako to budu usta Gospodnja odredila.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "I bićeš venac blistavi u Gospodnjoj ruci,",
            "poem": 1
          },
          {
            "text": "i turban carski na dlanu Boga svojega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Više ti se neće govoriti: „Ostavljena“,",
            "poem": 1
          },
          {
            "text": "niti će se zemlji tvojoj govoriti: „Opustošena“,",
            "poem": 2
          },
          {
            "text": "nego će te zvati: „Milina moja“,",
            "poem": 1
          },
          {
            "text": "a zemlju tvoju: „Udata“.",
            "poem": 2
          },
          {
            "text": "Jer ćeš Gospodu milina biti,",
            "poem": 1
          },
          {
            "text": "i zemlja će tvoja muža imati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Jer kao što se mladić ženi devicom,",
            "poem": 1
          },
          {
            "text": "tvoj Sazdatelj će se oženiti tobom,",
            "poem": 2
          },
          {
            "text": "i kao što se ženik veseli nevesti,",
            "poem": 1
          },
          {
            "text": "veseliće se tebi Bog tvoj.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Po zidovima tvojim, Jerusalime,",
            "poem": 1
          },
          {
            "text": "stražare sam rasporedio.",
            "poem": 2
          },
          {
            "text": "Po ceo dan i po celu noć",
            "poem": 1
          },
          {
            "text": "oni neće zaćutati nikako.",
            "poem": 2
          },
          {
            "text": "Oni podsećaju Gospoda,",
            "poem": 1
          },
          {
            "text": "njima počinka nema.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ne dajte mu da počine dok ne učvrsti i ustroji Jerusalim,",
            "poem": 1
          },
          {
            "text": "da on bude zemlji na pohvalu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Zakleo se Gospod desnicom svojom",
            "poem": 1
          },
          {
            "text": "i snažnom mišicom svojom:",
            "poem": 2
          },
          {
            "text": "„Više neće dati žito tvoje",
            "poem": 1
          },
          {
            "text": "da ga jedu neprijatelji tvoji,",
            "poem": 2
          },
          {
            "text": "ni da sinovi tuđinski piju tvoje vino",
            "poem": 1
          },
          {
            "text": "na čemu si se ti trudio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Nego koji su ga želi, ti će ga i jesti,",
            "poem": 1
          },
          {
            "text": "Gospoda hvaliće;",
            "poem": 2
          },
          {
            "text": "i koji su ga brali, ti će ga i piti",
            "poem": 1
          },
          {
            "text": "u predvorju mojega Svetilišta.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Pesma za završetak"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Prođite! Prođite kroz vratnice!",
            "poem": 1
          },
          {
            "text": "Poravnajte narodu put!",
            "poem": 2
          },
          {
            "text": "Nasipajte! Nasipajte drum!",
            "poem": 1
          },
          {
            "text": "Uklonite kamenje!",
            "poem": 2
          },
          {
            "text": "Podignite narodima znamenje!",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Evo, Gospod se glasi",
            "poem": 1
          },
          {
            "text": "do zemljinih krajeva:",
            "poem": 2
          },
          {
            "text": "„Recite ćerki sionskoj:",
            "poem": 1
          },
          {
            "text": "’Evo, Spas tvoj dolazi.",
            "poem": 2
          },
          {
            "text": "Evo s njim je plata njegova,",
            "poem": 1
          },
          {
            "text": "ispred njega najamnina njegova.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Oni će se zvati:",
            "poem": 1
          },
          {
            "text": "„Sveti narod“, „Otkupljeni Gospodom“,",
            "poem": 2
          },
          {
            "text": "a tebe će zvati: „Traženi“,",
            "poem": 1
          },
          {
            "text": "„Grad neostavljeni“.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
