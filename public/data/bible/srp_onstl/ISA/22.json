  "chapter": {
    "number": 22,
    "content": [
      {
        "type": "heading",
        "content": [
          "Reč o dolini viđenja"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Proroštvo o Dolini viđenja.",
          {
            "text": "Šta ti je sad,",
            "poem": 1
          },
          {
            "text": "te se penješ sav na krovove?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Prepun vreve, grade bučni,",
            "poem": 1
          },
          {
            "text": "šeheru razigrani!",
            "poem": 2
          },
          {
            "text": "Izginuli tvoji od mača ne padoše,",
            "poem": 1
          },
          {
            "text": "niti mrtvi tvoji u boju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Svi tvoji vladari zajedno pobegoše,",
            "poem": 1
          },
          {
            "text": "ne zategoše luk, a padoše u ropstvo,",
            "poem": 2
          },
          {
            "text": "zarobljeni su svi koji se nađoše u tebi,",
            "poem": 1
          },
          {
            "text": "daleko su bežali.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Zato sam rekao: „Ostavite me,",
            "poem": 1
          },
          {
            "text": "gorko ću plakati;",
            "poem": 2
          },
          {
            "text": "nemojte me tešiti",
            "poem": 1
          },
          {
            "text": "nad ruševinom milog naroda mojega.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Jer je dan pometnje i rasula i zbunjenosti",
            "poem": 1
          },
          {
            "text": "od Gospodara Gospoda nad vojskama.",
            "poem": 2
          },
          {
            "text": "U Dolini viđenja zid se ruši,",
            "poem": 1
          },
          {
            "text": "prema planini je vapaj,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "jer Elam tobolac donosi,",
            "poem": 1
          },
          {
            "text": "sa bojnim kolima i konjanicima,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a Kir štit otkriva.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Izabrane doline tvoje bojnih kola su pune.",
            "poem": 1
          },
          {
            "text": "Konjanici se kod vratnica postrojavaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Protiv borbene gotovosti"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Tako je Judi uklonio zaštitu.",
            "poem": 1
          },
          {
            "text": "U dan onaj pogled si svrnuo",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "na oružje u šumskoj kući.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "I pukotine u gradu Davidovu,",
            "poem": 1
          },
          {
            "text": "videli ste kako ih je mnogo.",
            "poem": 2
          },
          {
            "text": "I sabrali ste vodu",
            "poem": 1
          },
          {
            "text": "iz Donjeg jezera.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Pa ste prebrojali kuće jerusalimske",
            "poem": 1
          },
          {
            "text": "i porušili kuće da zid učvrstite;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "te ste između dva zida načinili",
            "poem": 1
          },
          {
            "text": "spremište za vodu iz Starog jezera;",
            "poem": 2
          },
          {
            "text": "ali se na Stvoritelja niste obazirali,",
            "poem": 1
          },
          {
            "text": "niti ste videli onog što je sve načinio odavno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "I pozvao je u dan onaj",
            "poem": 1
          },
          {
            "text": "Gospodar Gospod nad vojskama:",
            "poem": 2
          },
          {
            "text": "da plačete i tugujete,",
            "poem": 1
          },
          {
            "text": "da obrijete glave i pripašete kostret.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ali, gle, veselje i radost,",
            "poem": 1
          },
          {
            "text": "ubijaju goveda i kolju ovce,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "jedu meso i piju vino:",
            "poem": 2
          },
          {
            "text": "„Da jedemo i pijemo,",
            "poem": 1
          },
          {
            "text": "jer sutra ćemo da pomremo.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "A mojim ušima je objavio Gospod nad vojskama: „Neće biti otkupljena vaša krivica dok ne umrete – reče Gospodar Gospod nad vojskama.“"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Protiv nadstojnika Somne"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Govori Gospodar Gospod nad vojskama:",
          {
            "text": "„Hajde, otidi onom dvoraninu,",
            "poem": 1
          },
          {
            "text": "Somni, nadstojniku dvora:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "’Šta je s tobom i ko si to ti,",
            "poem": 1
          },
          {
            "text": "da ovde grobnicu klešeš sebi?",
            "poem": 2
          },
          {
            "text": "Kleše sebi grobnicu na visini,",
            "poem": 1
          },
          {
            "text": "useca u steni stan za sebe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Gle, Gospod će tebe baciti silno,",
            "poem": 1
          },
          {
            "text": "junak će te uhvatiti snažno,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "u klupko će te umotati žestoko,",
            "poem": 1
          },
          {
            "text": "kao loptu će te bacati po zemlji širokoj.",
            "poem": 2
          },
          {
            "text": "Tamo ćeš ti umreti,",
            "poem": 1
          },
          {
            "text": "i tamo su kola tvoja slavna,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "sramoto dvoru gospodara tvoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Lišiću te položaja tvoga,",
            "poem": 1
          },
          {
            "text": "i oteraću te iz službe tvoje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "A u taj dan ću pozvati slugu svoga Elijakima sina Helkijina."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Njega ću obući u odoru tvoju, njega ću opasati pojasom tvojim, njemu ću u ruke predati vlast tvoju, te će biti predak stanovnicima jerusalimskim i domu Judinom."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Na njegova pleća postaviću ključ od doma Davidova: kad otvori, neće zatvoriti niko, kad zatvori, neće otvoriti niko."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Njega ću kao klin uglaviti na mestu čvrstome, te će postati slavni presto u domu oca svojega."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "O njega će se obesiti sva slava doma oca njegova: izdanci i potomci, sve posude malene, od zdelica do svih krčaga.’"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "U dan onaj – govori Gospod nad vojskama – izvući će se klin uglavljeni na mestu čvrstome, slomiće se i pašće; a teret što je na njemu biće odsečen, jer je Gospod rekao.“"
        ]
      }
    ],
