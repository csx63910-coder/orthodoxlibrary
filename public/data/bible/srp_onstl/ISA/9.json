  "chapter": {
    "number": 9,
    "content": [
      {
        "type": "heading",
        "content": [
          "Bog se javlja i objavljuje"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ali neće biti mrak što nju guši kao u vremenu prethodnom, kad je obezvredio zemlju zavulonovsku i zemlju neftalimsku, a potonji će proslaviti put što vodi ka moru s druge strane Jordana, Galileju mnogobožačku."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Narod koji po tami hoda,",
            "poem": 1
          },
          {
            "text": "veliku je svetlost ugledao,",
            "poem": 2
          },
          {
            "text": "nastanjene u zemlji sena smrtnoga,",
            "poem": 1
          },
          {
            "text": "svetlost ih jarka obasja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Radost si uvećao;",
            "poem": 1
          },
          {
            "text": "pred tobom se raduju",
            "poem": 2
          },
          {
            "text": "kao u žetvenoj radosti,",
            "poem": 1
          },
          {
            "text": "kao što se vesele kada plen dele;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "jer jaram na nj natovaren",
            "poem": 1
          },
          {
            "text": "i obramicu na njegovom ramenu,",
            "poem": 2
          },
          {
            "text": "šibu progonitelja njegova,",
            "poem": 1
          },
          {
            "text": "ti si polomio kao u dan madijanski.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ta, svaka cokula maršira u metež,",
            "poem": 1
          },
          {
            "text": "i plašt se natapa u krvi,",
            "poem": 2
          },
          {
            "text": "te će biti za vatru",
            "poem": 1
          },
          {
            "text": "hrana razgorela.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ta, nama se muško dete rodilo,",
            "poem": 1
          },
          {
            "text": "nama je sin dat;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "vlast je njemu na ramenu.",
            "poem": 2
          },
          {
            "text": "I on će se zvati:",
            "poem": 1
          },
          {
            "text": "Divni Savetnik, Bog Silni,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Otac Večni, Vladar Mirotvorni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Rasprostiranju vlasti i miru",
            "poem": 1
          },
          {
            "text": "neće biti kraja",
            "poem": 2
          },
          {
            "text": "na prestolu Davidovu",
            "poem": 1
          },
          {
            "text": "i na carstvu njegovu,",
            "poem": 2
          },
          {
            "text": "da ga sredi i da ga utvrdi",
            "poem": 1
          },
          {
            "text": "u pravu i u pravednosti",
            "poem": 2
          },
          {
            "text": "od sada i do veka.",
            "poem": 1
          },
          {
            "text": "Revnost Gospoda nad vojskama",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "to će učiniti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Gospod plaća"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Gospodar je reč poslao Jakovu",
            "poem": 1
          },
          {
            "text": "i ona je među Izrailjce pala.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "I sav narod nju će upoznati,",
            "poem": 1
          },
          {
            "text": "Jefremovci i stanovništvo Samarije,",
            "poem": 2
          },
          {
            "text": "koji govore srcem",
            "poem": 1
          },
          {
            "text": "nadmenim i oholim:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "„Ako su opeke pale,",
            "poem": 1
          },
          {
            "text": "gradićemo od tesana kamena;",
            "poem": 2
          },
          {
            "text": "divlje smokve su sasečene,",
            "poem": 1
          },
          {
            "text": "kedre ćemo tamo podići.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "A Gospod razmešta protiv Resina protivnike njegove",
            "poem": 1
          },
          {
            "text": "i podbada neprijatelje njegove,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Arameju spreda, Filistejce straga,",
            "poem": 1
          },
          {
            "text": "te Izrailj proždiru svojim ustima.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Uza sve to gnev se njegov umiriti neće",
            "poem": 1
          },
          {
            "text": "i ruka mu ispružena ostaje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ipak se narod obratio nije onom koji ga je udario,",
            "poem": 1
          },
          {
            "text": "i Gospoda nad vojskama potražili nisu;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "te je Gospod odsekao od Izrailja glavu i rep,",
            "poem": 1
          },
          {
            "text": "granu i rogoz, u jedan dan.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Starešina i lice ugledno – to je glava,",
            "poem": 1
          },
          {
            "text": "a prorok koji naučava laž – to je rep.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Koji ovaj narod vode, oni zavode;",
            "poem": 1
          },
          {
            "text": "koji bivaju vođeni, oni propadaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Zato se Gospodar njegovim mladićima radovati neće,",
            "poem": 1
          },
          {
            "text": "njegovoj sirotinji i udovicama smilovati se neće.",
            "poem": 2
          },
          {
            "text": "Zato što je sav narod opak i zao,",
            "poem": 1
          },
          {
            "text": "na sva usta bezumno govore.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Uza sve to gnev se njegov umiriti neće",
            "poem": 1
          },
          {
            "text": "i ruka mu ispružena ostaje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Zato što se opakost kao požar rasplamsala,",
            "poem": 1
          },
          {
            "text": "bodlje i trnje proždire,",
            "poem": 2
          },
          {
            "text": "šumski čestar je upalila,",
            "poem": 1
          },
          {
            "text": "oblaci dima se podižu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Zemlja plamti od jarosti Gospoda nad vojskama,",
            "poem": 1
          },
          {
            "text": "i narod kao hrana za požar postaje:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ni svog brata niko ne poštedi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Ždere s desna",
            "poem": 1
          },
          {
            "text": "i opet je gladan;",
            "poem": 2
          },
          {
            "text": "guta s leva",
            "poem": 1
          },
          {
            "text": "i opet sit nije.",
            "poem": 2
          },
          {
            "text": "Čovek jede svoga bližnjeg meso:",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Manasijevci Jefremovce,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Jefremovci Manasijevce,",
            "poem": 1
          },
          {
            "text": "a zajedno oba na Judejce.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Uza sve to gnev se njegov umiriti neće",
            "poem": 1
          },
          {
            "text": "i ruka mu ispružena ostaje.",
            "poem": 2
          }
        ]
      }
    ],
