  "chapter": {
    "number": 28,
    "content": [
      {
        "type": "heading",
        "content": [
          "Opomena nedostojnima i neposlušnima"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Teško gordome vencu pijanica Jefremovih,",
            "poem": 1
          },
          {
            "text": "i cvetu uvelome, bleštavoj slavnosti njegovoj,",
            "poem": 2
          },
          {
            "text": "koji su se udebljali,",
            "poem": 1
          },
          {
            "text": "vinom opili.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Evo, Gospodar ima jačinu i moć,",
            "poem": 1
          },
          {
            "text": "kao oluja gradonosna, vihor rušilački,",
            "poem": 2
          },
          {
            "text": "kao poplava bujičinih voda,",
            "poem": 1
          },
          {
            "text": "obara ih na zemlju rukom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Nogama će biti izgažen",
            "poem": 1
          },
          {
            "text": "gordi venac pijanica Jefremovih,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "i cvet uveli, bleštava slavnost njegova,",
            "poem": 1
          },
          {
            "text": "koji su se udebljali;",
            "poem": 2
          },
          {
            "text": "biće kao smokva rana pre leta,",
            "poem": 1
          },
          {
            "text": "čim je neko ugleda,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "odmah je šakom ubere.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "U dan onaj Gospod nad vojskama",
            "poem": 1
          },
          {
            "text": "postaće venac blistavi",
            "poem": 2
          },
          {
            "text": "i kruna slavonosna",
            "poem": 1
          },
          {
            "text": "ostatku naroda svojega,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "duh pravedni",
            "poem": 1
          },
          {
            "text": "sudija na sudu,",
            "poem": 2
          },
          {
            "text": "i sila onom koji odbija napade na vratnice.",
            "poem": 1
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Protiv sveštenika i lažnih proroka"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "A i oni posrću od vina,",
            "poem": 1
          },
          {
            "text": "i teturaju se od žestokog pića.",
            "poem": 2
          },
          {
            "text": "Sveštenik i prorok od žestokog pića,",
            "poem": 1
          },
          {
            "text": "omamilo ih je vino;",
            "poem": 2
          },
          {
            "text": "teturaju se zbog žestokog pića.",
            "poem": 1
          },
          {
            "text": "Posrću pri viđenju,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ljuljaju se na ročištu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ta svi su stolovi puni gnusnih izbljuvaka,",
            "poem": 1
          },
          {
            "text": "nigde mesta čistoga.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "„Koga on to uči znanju?",
            "poem": 1
          },
          {
            "text": "I kome on objašnjava poruku?",
            "poem": 2
          },
          {
            "text": "Deci koju odvikavaju od mleka?",
            "poem": 1
          },
          {
            "text": "Odbijenima od dojenja?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Jer:",
            "poem": 1
          },
          {
            "text": "Tuc pa muc, tuc pa muc!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Muc pa tuc, muc pa tuc!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Tamo kvrc! Tamo kvrc!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Jer usnama što mucaju, i jezikom tuđinskim",
            "poem": 1
          },
          {
            "text": "govoriće ovom narodu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Jer on im je rekao:",
            "poem": 1
          },
          {
            "text": "„Ovo je počinak.",
            "poem": 2
          },
          {
            "text": "Neka se umorni odmore, i ovo im je zastanak!“",
            "poem": 1
          },
          {
            "text": "Ali oni poslušati ne htedoše.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "I biće im reč Gospodnja:",
            "poem": 1
          },
          {
            "text": "Tuc pa muc, tuc pa muc!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Muc pa tuc, muc pa tuc!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Tamo kvrc! Tamo kvrc,",
            "poem": 2
          },
          {
            "text": "da nauznak padnu kada hodaju",
            "poem": 1
          },
          {
            "text": "i da se polome i upletu i uhvate.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Protiv nepouzdanih savetnika (I)"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Zato čujte reč Gospodnju, vi, podsmevači,",
            "poem": 1
          },
          {
            "text": "vi, vladari ovog naroda koji je u Jerusalimu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Zato što govorite: „Sa smrću smo savez sklopili,",
            "poem": 1
          },
          {
            "text": "sa Svetom mrtvih sporazum sklopili.",
            "poem": 2
          },
          {
            "text": "Kad prođe bič razorni,",
            "poem": 1
          },
          {
            "text": "on nas dohvatiti neće,",
            "poem": 2
          },
          {
            "text": "jer od laži načinismo sebi sklonište,",
            "poem": 1
          },
          {
            "text": "i od obmane napravismo skrovište.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Proroštvo o pouzdanom kamenu"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Zato govori Gospod Gospodar:",
          {
            "text": "„Evo, postavljam na Sionu kamen,",
            "poem": 1
          },
          {
            "text": "kamen za proveru, dragoceni kamen ugaoni,",
            "poem": 2
          },
          {
            "text": "temeljac utemeljeni.",
            "poem": 1
          },
          {
            "text": "Ko u njega poveruje neće paničiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Uzeću pravo da mi bude kao ravnalo,",
            "poem": 1
          },
          {
            "text": "i pravdu kao visak.",
            "poem": 2
          },
          "Protiv nepouzdanih savetnika (II)",
          {
            "text": "I grad će vam zatrti sklonište načinjeno od laži,",
            "poem": 1
          },
          {
            "text": "a voda će vam poplaviti skrovište,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "vaš savez sa smrću propašće,",
            "poem": 1
          },
          {
            "text": "vaš sporazum sa Svetom mrtvih održati se neće,",
            "poem": 2
          },
          {
            "text": "kad prođe bič razorni,",
            "poem": 1
          },
          {
            "text": "on će vas izgaziti;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "dohvatiće vas kad prolazi,",
            "poem": 1
          },
          {
            "text": "a prolaziće od jutra do jutra,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "po danu i po noći.“",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Vas će goli strah",
            "poem": 1
          },
          {
            "text": "uputiti u poruku.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Prekratka će biti postelja da se čovek pruži;",
            "poem": 1
          },
          {
            "text": "uzak će biti pokrivač da se obmota.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Kao na gori Faresim, Gospod će ustati;",
            "poem": 1
          },
          {
            "text": "kao u Gavaonskoj dolini, on će se razjariti,",
            "poem": 2
          },
          {
            "text": "da delo svoje izvrši, delo čudnovato;",
            "poem": 1
          },
          {
            "text": "da zadatak svoj ostvari, zadatak zapanjujući.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "A sada, ne podsmevajte se,",
            "poem": 1
          },
          {
            "text": "inače će vas okovi jače stezati,",
            "poem": 2
          },
          {
            "text": "jer čuh da je uništenje zemlji celoj dosudio",
            "poem": 1
          },
          {
            "text": "Gospodar Gospod nad vojskama.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Poređenje sa oračem"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Poslušajte i čujte glas moj,",
            "poem": 1
          },
          {
            "text": "oslušnite pažljivo besedu moju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Ore li orač svakog dana da seje?",
            "poem": 1
          },
          {
            "text": "brazdi li i drlja njivu svoju?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "A kad joj poravna površ,",
            "poem": 1
          },
          {
            "text": "ne seje li grahor i ne sipa li kim?",
            "poem": 2
          },
          {
            "text": "Pšenicu gde treba,",
            "poem": 1
          },
          {
            "text": "i ječam na mesto,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i krupnik po rubovima?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Bog njegov ga upućuje,",
            "poem": 1
          },
          {
            "text": "on ga uči šta je ispravno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Jer se ne mlati grahor mlatilicom,",
            "poem": 1
          },
          {
            "text": "niti se točkom vrše po kimu,",
            "poem": 2
          },
          {
            "text": "već se grahor palicom bije,",
            "poem": 1
          },
          {
            "text": "a kim se prutom lupa.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "A da li se žito tare?",
            "poem": 1
          },
          {
            "text": "Njega stalno vršiti nećeš;",
            "poem": 2
          },
          {
            "text": "i točak kolski i konje njegove po njemu ćeš valjati,",
            "poem": 1
          },
          {
            "text": "ali ga nećeš zdrobiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "I to stiže od Gospoda nad vojskama,",
            "poem": 1
          },
          {
            "text": "divnog u savetništvu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "veličanstvenog u veleumlju.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
