  "chapter": {
    "number": 50,
    "content": [
      {
        "type": "heading",
        "content": [
          "Spasonosna svemoć Gospodnja"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Govori Gospod:",
          {
            "text": "„Gde je potvrda o razvodu za vašu mater",
            "poem": 1
          },
          {
            "text": "kojom sam je otpustio?",
            "poem": 2
          },
          {
            "text": "Ili: ko je poverilac",
            "poem": 1
          },
          {
            "text": "kome sam vas prodao?",
            "poem": 2
          },
          {
            "text": "Gle, zbog krivica vaših vi ste prodani.",
            "poem": 1
          },
          {
            "text": "Zbog neverstva svoga vaša mati je otpuštena.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Zašto, kad sam bio došao,",
            "poem": 1
          },
          {
            "text": "nikog nije bilo?",
            "poem": 2
          },
          {
            "text": "Kad sam bio zvao,",
            "poem": 1
          },
          {
            "text": "odazvao se niko nije?",
            "poem": 2
          },
          {
            "text": "Zar je tako kratko skraćena ruka moja,",
            "poem": 1
          },
          {
            "text": "te ne može izbaviti?",
            "poem": 2
          },
          {
            "text": "Ili: zar snage u meni nema,",
            "poem": 1
          },
          {
            "text": "te ne mogu osloboditi?",
            "poem": 2
          },
          {
            "text": "Gle, pretnjom svojom isušujem more,",
            "poem": 1
          },
          {
            "text": "pretvaram reke u pustinju.",
            "poem": 2
          },
          {
            "text": "Raspadaju se ribe njihove",
            "poem": 1
          },
          {
            "text": "kad vode nema, i umru od žeđi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Nebesa oblačim u crninu,",
            "poem": 1
          },
          {
            "text": "i kostret im kao prekrivači.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "O sluzi Gospodnjem, Pesma treća"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Gospodar Gospod dade mi jezik učen",
            "poem": 1
          },
          {
            "text": "da znam okrepiti umornoga.",
            "poem": 2
          },
          {
            "text": "Rečju me budi; iz jutra u jutro budi me na uho",
            "poem": 1
          },
          {
            "text": "da ga slušam kao učeni.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Gospodar Gospod otvorio mi je uho,",
            "poem": 1
          },
          {
            "text": "a ja nisam okretao pleća,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "niti sam ustuknuo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Leđa sam svoja podmetao onima koji me tuku,",
            "poem": 1
          },
          {
            "text": "a obraze svoje onima koji mi bradu čupaju,",
            "poem": 2
          },
          {
            "text": "lice svoje zaklanjao nisam",
            "poem": 1
          },
          {
            "text": "od uvreda i od pljuvanja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "A Gospodar Gospod meni pomoć daje",
            "poem": 1
          },
          {
            "text": "da se ne postidim,",
            "poem": 2
          },
          {
            "text": "zato sam svoj obraz u kremen pretvorio",
            "poem": 1
          },
          {
            "text": "i znam da se posramiti neću.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Blizu je onaj koji me pravda.",
            "poem": 1
          },
          {
            "text": "Ko će sa mnom da se parniči?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Stanimo zajedno.",
            "poem": 2
          },
          {
            "text": "Ko će protiv mene?",
            "poem": 1
          },
          {
            "text": "Nek mi priđe bliže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Gle, Gospodar Gospod meni pomaže.",
            "poem": 1
          },
          {
            "text": "Ko je taj koji će me okriviti?",
            "poem": 2
          },
          {
            "text": "Eto, svi oni će se istrošiti kao haljina,",
            "poem": 1
          },
          {
            "text": "moljac će ih pojesti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ko se među vama boji Gospoda",
            "poem": 1
          },
          {
            "text": "i sluša glas njegovog sluge,",
            "poem": 2
          },
          {
            "text": "koji je išao po tamninama,",
            "poem": 1
          },
          {
            "text": "a nije imao videla;",
            "poem": 2
          },
          {
            "text": "uzdao se u ime Gospodnje,",
            "poem": 1
          },
          {
            "text": "oslanjao na Boga svojega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Eno, svi vi koji palite vatru",
            "poem": 1
          },
          {
            "text": "opasujući se iskrama,",
            "poem": 2
          },
          {
            "text": "odoste u plamen svoje vatre",
            "poem": 1
          },
          {
            "text": "i u iskre vašeg sagorevanja;",
            "poem": 2
          },
          {
            "text": "od ruke moje to će vam biti:",
            "poem": 1
          },
          {
            "text": "ležaćete u mukama.",
            "poem": 2
          }
        ]
      }
    ],
