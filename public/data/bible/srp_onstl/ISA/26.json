  "chapter": {
    "number": 26,
    "content": [
      {
        "type": "heading",
        "content": [
          "Pesma pobednička"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "U onaj dan pevaće se ova pesma u zemlji Judinoj:",
          {
            "text": "„Imamo tvrd grad,",
            "poem": 1
          },
          {
            "text": "on nam podiže spasenje,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "zidove i bedeme.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Otvorite vratnice",
            "poem": 1
          },
          {
            "text": "da uđe puk pravedni",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "koji je dosledno veran,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "čiju ćeš sabranost zasnovanu na tebi",
            "poem": 1
          },
          {
            "text": "ti sabrati u miru,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "u miru zato što se u tebe uzda.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Uzdajte se u Gospoda doveka,",
            "poem": 1
          },
          {
            "text": "jer u Gospodu, u Gospodu samom je večna Stena;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "jer on obara one koji stanuju visoko,",
            "poem": 1
          },
          {
            "text": "naselje uzdignuto on ruši,",
            "poem": 2
          },
          {
            "text": "on ga ruši na zemlju,",
            "poem": 1
          },
          {
            "text": "on ga srozava u prašinu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Gaziće ga noga,",
            "poem": 1
          },
          {
            "text": "noge ubogih,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "koraci nevoljnih.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Psalam o pravdi Božijoj"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Staza pravednikova je čestita",
            "poem": 1
          },
          {
            "text": "i pravednikov kolosek ti ravnaš.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Da, na stazi tvojih presuda,",
            "poem": 1
          },
          {
            "text": "Gospode, mi te očekujemo,",
            "poem": 2
          },
          {
            "text": "i za imenom tvojim i za spomenom tvojim",
            "poem": 1
          },
          {
            "text": "žudi duša.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Duša moja žudi noću,",
            "poem": 1
          },
          {
            "text": "da, duh moj u meni, tebe traži,",
            "poem": 2
          },
          {
            "text": "jer kad ti presudiš na zemlji,",
            "poem": 1
          },
          {
            "text": "tad se pravdi uče stanovnici sveta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ako opaki dobije naklonost,",
            "poem": 1
          },
          {
            "text": "ipak neće naučiti šta je pravednost;",
            "poem": 2
          },
          {
            "text": "u zemlji čestitih on čini nepravdu",
            "poem": 1
          },
          {
            "text": "i ne obazire se na veličanstvo Gospodnje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Gospode, ruka tvoja je podignuta,",
            "poem": 1
          },
          {
            "text": "ipak oni ne vide.",
            "poem": 2
          },
          {
            "text": "Daj da vide revnost tvoju za tvoj narod,",
            "poem": 1
          },
          {
            "text": "pa nek se postide.",
            "poem": 2
          },
          {
            "text": "Plamen za neprijatelje tvoje",
            "poem": 1
          },
          {
            "text": "neka ih proždere.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Gospode, ti nam mir određuješ,",
            "poem": 1
          },
          {
            "text": "jer si ti uredio sva dela naša.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Gospode, Bože naš, upravljali su nama",
            "poem": 1
          },
          {
            "text": "osim tebe drugi gospodari.",
            "poem": 2
          },
          {
            "text": "Tebi jedinome,",
            "poem": 1
          },
          {
            "text": "tvoje ime pominjemo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Mrtvi neće oživeti,",
            "poem": 1
          },
          {
            "text": "pokojnici neće ustati,",
            "poem": 2
          },
          {
            "text": "jer ti si ih pohodio i razorio,",
            "poem": 1
          },
          {
            "text": "i zatro si svaku uspomenu na njih.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Umnožio si puk, Gospode,",
            "poem": 1
          },
          {
            "text": "umnožio si puk,",
            "poem": 2
          },
          {
            "text": "proslavio si se,",
            "poem": 1
          },
          {
            "text": "proširio si zemlji sve granice njene.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Gospode, u nevolji oni su k tebi došli,",
            "poem": 1
          },
          {
            "text": "tihu molitvu izlivali",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kada si ih karao.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Kao trudnica pred porođajem,",
            "poem": 1
          },
          {
            "text": "grči se, vrišti u bolovima,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "takvi smo mi pred licem tvojim, Gospode,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Zatrudneli smo,",
            "poem": 1
          },
          {
            "text": "grčimo se kao da vetar porađamo,",
            "poem": 2
          },
          {
            "text": "niti smo zemlji spasenja doneli,",
            "poem": 1
          },
          {
            "text": "niti se rodiše stanovnici sveta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Oživeće mrtvi tvoji,",
            "poem": 1
          },
          {
            "text": "dići će se s mojim mrtvim telom.",
            "poem": 2
          },
          {
            "text": "Probudite se i pevajte",
            "poem": 1
          },
          {
            "text": "koji boravite u prahu,",
            "poem": 2
          },
          {
            "text": "jer rosa svetlosna rosa je tvoja,",
            "poem": 1
          },
          {
            "text": "i zemlja pokojnika porod će dati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Bog razotkriva pokolj"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Hajde, narode moj, u odaje svoje uđi,",
            "poem": 1
          },
          {
            "text": "i vrata svoja za sobom zatvori.",
            "poem": 2
          },
          {
            "text": "Sakrij se časkom na tren,",
            "poem": 1
          },
          {
            "text": "dok jarost ne prođe.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Jer, gle, Gospod će izaći iz mesta svojega",
            "poem": 1
          },
          {
            "text": "da pohodi krivicu stanovnika zemaljskih;",
            "poem": 2
          },
          {
            "text": "i otkriće zemlja krv što je u njoj,",
            "poem": 1
          },
          {
            "text": "i neće više pokrivati poklane koji su u njoj.",
            "poem": 2
          }
        ]
      }
    ],
