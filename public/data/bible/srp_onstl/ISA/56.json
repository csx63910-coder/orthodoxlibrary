  "chapter": {
    "number": 56,
    "content": [
      {
        "type": "heading",
        "content": [
          "Bog prihvata neprihvaćene"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Govori Gospod:",
          {
            "text": "„Držite pravo",
            "poem": 1
          },
          {
            "text": "i činite pravdu,",
            "poem": 2
          },
          {
            "text": "jer od mene se približava spasenje",
            "poem": 1
          },
          {
            "text": "i biće objavljena pravda moja.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Blažen je čovek koji čini ovo,",
            "poem": 1
          },
          {
            "text": "i sin čovečiji koji to drži,",
            "poem": 2
          },
          {
            "text": "koji pazi na subotu da je ne oskrnavi,",
            "poem": 1
          },
          {
            "text": "i pazi na ruku svoju da nikakva zla ne učini.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Neka tuđinčev sin koji je prionuo uz Gospoda ne kazuje govoreći:",
            "poem": 1
          },
          {
            "text": "„Gospod me je jamačno odvojio od svog naroda.“",
            "poem": 2
          },
          {
            "text": "I evnuh neka ne govori:",
            "poem": 1
          },
          {
            "text": "„Ja sam suvo drvo.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Jer govori Gospod:",
          {
            "text": "„Evnusima koji paze na subote moje",
            "poem": 1
          },
          {
            "text": "i biraju što je meni ugodno,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i koji se drže saveza sa mnom;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "njima ću dati u Domu mome",
            "poem": 1
          },
          {
            "text": "i među zidovima mojim",
            "poem": 2
          },
          {
            "text": "spomen i ime bolje nego sinovima i ćerkama,",
            "poem": 1
          },
          {
            "text": "daću im večno ime, nerazorivo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "A tuđinske sinove koji su prionuli uz Gospoda",
            "poem": 1
          },
          {
            "text": "da mu se klanjaju i da ljube ime Gospodnje",
            "poem": 2
          },
          {
            "text": "i da mu budu sluge, svi koji paze na subotu",
            "poem": 1
          },
          {
            "text": "da je ne oskrnave i koji se drže saveza sa mnom;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "njih ću dovesti na svetu goru moju,",
            "poem": 1
          },
          {
            "text": "i obradovaću ih u mom Domu za molitvu.",
            "poem": 2
          },
          {
            "text": "Svespalnice njihove i žrtve zaklane",
            "poem": 1
          },
          {
            "text": "biće mi po volji na žrtveniku mome.",
            "poem": 2
          },
          {
            "text": "Jer će se Dom moj zvati",
            "poem": 1
          },
          {
            "text": "’Dom za molitvu svim narodima’.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Gospodar Gospod",
            "poem": 1
          },
          {
            "text": "koji sakuplja izgnane Izrailjce",
            "poem": 2
          },
          {
            "text": "veli: „Još ću ih sakupiti",
            "poem": 1
          },
          {
            "text": "svrh već sakupljenih.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Protiv nedostojnih glavara"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Sve životinje poljske, dođite da jedete,",
            "poem": 1
          },
          {
            "text": "sve životinje šumske.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Svi njegovi stražari su zatajili,",
            "poem": 1
          },
          {
            "text": "svi oni ne shvataju,",
            "poem": 2
          },
          {
            "text": "psi bezglasni, da laju ne mogu.",
            "poem": 1
          },
          {
            "text": "Sanjivo se izležavaju, vole da dremaju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "I to: proždrljivi su psi,",
            "poem": 1
          },
          {
            "text": "ne umeju da se nasite.",
            "poem": 2
          },
          {
            "text": "I oni su pastiri nerazboriti,",
            "poem": 1
          },
          {
            "text": "svaki od njih na svoj put okreće,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "svaki za grabežom svojim sebično.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "„Dođite, doneću vina,",
            "poem": 1
          },
          {
            "text": "i napićemo se žestoka pića.",
            "poem": 2
          },
          {
            "text": "Kao danas i sutra će biti:",
            "poem": 1
          },
          {
            "text": "obilje vrlo veliko!“",
            "poem": 2
          }
        ]
      }
    ],
