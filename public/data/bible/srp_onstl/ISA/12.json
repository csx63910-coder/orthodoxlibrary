  "chapter": {
    "number": 12,
    "content": [
      {
        "type": "heading",
        "content": [
          "Pesma zahvalnosti"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "U onaj dan ti ćeš govoriti:",
          {
            "text": "„Hvalim te, Gospode,",
            "poem": 1
          },
          {
            "text": "ti si se na mene razgnevio,",
            "poem": 2
          },
          {
            "text": "ali i gnev svoj odvratio;",
            "poem": 1
          },
          {
            "text": "još si me utešio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Evo, Bog je spasenje moje,",
            "poem": 1
          },
          {
            "text": "uzdam se i neću se bojati,",
            "poem": 2
          },
          {
            "text": "jer je Gospod snaga moja i pesma Gospodnja,",
            "poem": 1
          },
          {
            "text": "on mi je bio na spasenje.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "I radosno ćete crpsti vodu",
            "poem": 1
          },
          {
            "text": "iz spasonosnih izvora.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Vi ćete govoriti u dan onaj:",
          {
            "text": "„Zahvaljujte Gospodu!",
            "poem": 1
          },
          {
            "text": "Prizivajte ime njegovo!",
            "poem": 2
          },
          {
            "text": "Obznanjujte narodima dela njegova!",
            "poem": 1
          },
          {
            "text": "Pominjite kako je uzvišeno delo njegovo!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Pevajte Gospodu zato što je sazvao divotu.",
            "poem": 1
          },
          {
            "text": "Neka to bude po svoj zemlji znano.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Kličite i uzvisujte, stanovnici Siona,",
            "poem": 1
          },
          {
            "text": "jer je velik među vama Izrailjev Svetitelj.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
