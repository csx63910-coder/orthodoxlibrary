  "chapter": {
    "number": 6,
    "content": [
      {
        "type": "heading",
        "content": [
          "Bog poziva Isaiju"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Godine kad je umro car Ozija videh Gospoda kako sedi na visokom i uzdignutom prestolu, a skuti njegovog plašta su ispunjavali hram."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Iznad njega su se postavili šestokrili serafimi. Svaki je imao šestora krila: dvama je zaklanjao lice, dvama je pokrivao noge, a dvama krilima je leteo."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Oni su klicali jedan drugom i govorili:",
          {
            "text": "„Svet, svet, svet je Gospod nad vojskama!",
            "poem": 1
          },
          {
            "text": "Puna je sva zemlja slave njegove!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Od glasa onog koji kliče zatresli su se dovraci na pragovima i Dom se napunio dimom."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Na to sam rekao: „Teško meni, propao sam, jer sam čovek nečistih usana, i stanujem sred naroda nečistih usana; a Cara, Gospoda nad vojskama, videle su oči moje!“"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Tada je jedan od serafima doleteo k meni. U ruci mu je bila žeravica što je hvataljkama uzeo sa žrtvenika."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Njom je dotakao moje usne i rekao: „Evo, ovo je dotaklo usne tvoje, i skinuta je krivica tvoja, i oprošten je greh tvoj.“"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Zatim sam čuo glas Gospodarev kako govori: „Koga da pošaljem? I ko će poći za nas?“ A ja sam rekao: „Evo mene! Pošalji mene!“"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "On je na to rekao: „Idi i reci tom narodu:",
          {
            "text": "’Slušaćete i nećete razumeti,",
            "poem": 1
          },
          {
            "text": "gledaćete i nećete videti.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Otežaj salom tom narodu srce,",
            "poem": 1
          },
          {
            "text": "ogluvi uši njegove,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "oslepi oči njegove,",
            "poem": 2
          },
          {
            "text": "dok progledaju oči njegove,",
            "poem": 1
          },
          {
            "text": "i pročuju uši njegove,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i razbere srce njegovo,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i pokaje se i isceli ga.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Tada sam rekao: „Dokle, Gospodaru?“ Odgovorio je:",
          {
            "text": "„Dok su turobni gradovi bez stanovnika,",
            "poem": 1
          },
          {
            "text": "i kuće bez čoveka,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i turobne njive za pustošenje,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "i Gospod otera ljudstvo,",
            "poem": 1
          },
          {
            "text": "i veliko razaranje bude u samoj zemlji.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Pa ostane li u njoj desetina,",
            "poem": 1
          },
          {
            "text": "i ona će se vratiti.",
            "poem": 2
          },
          {
            "text": "I biće spaljen kao brest,",
            "poem": 1
          },
          {
            "text": "i kao hrast koji je oboren do panja svoga.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Potomstvo sveto iz panja njegovog.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
