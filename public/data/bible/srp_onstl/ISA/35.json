  "chapter": {
    "number": 35,
    "content": [
      {
        "type": "heading",
        "content": [
          "Sveti put"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Neka im se uzraduje pustinja,",
            "poem": 1
          },
          {
            "text": "zemlja sasušena.",
            "poem": 2
          },
          {
            "text": "Neka kliče pustara,",
            "poem": 1
          },
          {
            "text": "neka kao šafran procveta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Neka bujno cvati cvat,",
            "poem": 1
          },
          {
            "text": "i neka još kliče od radosti i pevanja.",
            "poem": 2
          },
          {
            "text": "Njoj je dana slava livanska,",
            "poem": 1
          },
          {
            "text": "krasota karmilska i saronska.",
            "poem": 2
          },
          {
            "text": "Oni će gledati slavu Gospodnju,",
            "poem": 1
          },
          {
            "text": "krasotu Boga našega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ruke klonule ukrepite,",
            "poem": 1
          },
          {
            "text": "i kolena klecava učvrstite.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Recite preplašenim srcima:",
            "poem": 1
          },
          {
            "text": "„Budite jaki, ne bojte se!",
            "poem": 2
          },
          {
            "text": "Evo Boga vašega,",
            "poem": 1
          },
          {
            "text": "odmazda dolazi,",
            "poem": 2
          },
          {
            "text": "naplata Božija.",
            "poem": 1
          },
          {
            "text": "On sam hita da vas spase!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Tada će se slepima otvoriti oči",
            "poem": 1
          },
          {
            "text": "i gluvima će se uši otvoriti;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "tada će hromi kao jelen skakati,",
            "poem": 1
          },
          {
            "text": "i pevaće jezik u nemoga;",
            "poem": 2
          },
          {
            "text": "jer će voda izbijati u pustinji",
            "poem": 1
          },
          {
            "text": "i potoci u pustari,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "tle spaljeno postaće rit,",
            "poem": 1
          },
          {
            "text": "a žedna zemlja vodoskoci;",
            "poem": 2
          },
          {
            "text": "u jazbinama za šakale",
            "poem": 1
          },
          {
            "text": "smestiće se zelenilo za trsku i rogoz.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Tamo će prolaziti drum i put,",
            "poem": 1
          },
          {
            "text": "i on će se zvati „Sveti put“;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "niko nečist njime proći neće",
            "poem": 2
          },
          {
            "text": "nego će biti za njih,",
            "poem": 1
          },
          {
            "text": "za one koji putem idu, a tu ludi neće zalutati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Tamo lava više biti neće,",
            "poem": 1
          },
          {
            "text": "niti će tamo prolaziti zver,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "niti će se naći,",
            "poem": 2
          },
          {
            "text": "nego će hodati otkupljeni.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Vratiće se izbavljeni Gospodnji,",
            "poem": 2
          },
          {
            "text": "doći će u Sion s veseljem",
            "poem": 1
          },
          {
            "text": "i s radošću večnom na čelima;",
            "poem": 2
          },
          {
            "text": "pratiće ih razdraganost i radost,",
            "poem": 1
          },
          {
            "text": "a pobeći će žalost i uzdasi.",
            "poem": 2
          }
        ]
      }
    ],
