  "chapter": {
    "number": 42,
    "content": [
      {
        "type": "heading",
        "content": [
          "O sluzi Gospodnjem. Pesma prva. Deo prvi."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Evo Sluge moga, kome sam potpora,",
            "poem": 1
          },
          {
            "text": "izabranika moga, miljenika duše moje.",
            "poem": 2
          },
          {
            "text": "Na njega sam Duha svoga izlio",
            "poem": 1
          },
          {
            "text": "da donosi pravdu narodima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "On ne viče, niti buku pravi,",
            "poem": 1
          },
          {
            "text": "na ulici glasa svog ne diže.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "On ne lomi trsku napuknutu,",
            "poem": 1
          },
          {
            "text": "niti gasi fitilj koji tinja,",
            "poem": 2
          },
          {
            "text": "nego on donosi pravo istinito.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "On ne tinja, niti slomljen biva",
            "poem": 2
          },
          {
            "text": "dok na zemlji pravo ne uspostavi,",
            "poem": 1
          },
          {
            "text": "a ostrva su žedna njegovog Zakona.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "O sluzi Gospodnjem. Pesma prva. Deo drugi."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Govori Bog Gospod,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "koji je stvorio i razastro nebesa,",
            "poem": 1
          },
          {
            "text": "koji je raširio zemlju i rastinje njeno,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "koji daje disanje narodima po njoj,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i duh bićima koja hodaju po njoj:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "„Ja, Gospod, u pravdi sam te pozvao,",
            "poem": 1
          },
          {
            "text": "i za ruku te uhvatio;",
            "poem": 2
          },
          {
            "text": "i tebe čuvao i tebe postavio",
            "poem": 1
          },
          {
            "text": "za savez narodu,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "za svetlost plemenima,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "da otvoriš oči slepima,",
            "poem": 1
          },
          {
            "text": "da izvedeš iz zatvora sužnje,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "iz tamnice one što u tami žive.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ja sam Gospod, to je ime moje,",
            "poem": 1
          },
          {
            "text": "i slave svoje drugom dati neću,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "niti časti svoje kipovima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Što je od iskona, gle, to dolazi;",
            "poem": 1
          },
          {
            "text": "i novosti ja već najavih,",
            "poem": 2
          },
          {
            "text": "pre nego se zbudu",
            "poem": 1
          },
          {
            "text": "činim da čujete.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Pobednička pesma"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Pevajte Gospodu pesmu novu,",
            "poem": 1
          },
          {
            "text": "slavu njegovu od kraja zemljinog,",
            "poem": 2
          },
          {
            "text": "koji morem silazite i što je po njemu,",
            "poem": 1
          },
          {
            "text": "ostrva i svi stanovnici njini.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Neka se uskomeša pustinja i gradovi njeni,",
            "poem": 1
          },
          {
            "text": "neka odjekuju naselja kedarska,",
            "poem": 2
          },
          {
            "text": "neka podvikuju stanovnici Sele,",
            "poem": 1
          },
          {
            "text": "neka kliču s gorskih vrhova,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Neka slavu svoju daju Gospodu,",
            "poem": 1
          },
          {
            "text": "i hvalu mu najavljuju po ostrvima.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Kao junak Gospod stupa,",
            "poem": 1
          },
          {
            "text": "kao ratnik on se razjario,",
            "poem": 2
          },
          {
            "text": "On klikće i uz to viče,",
            "poem": 1
          },
          {
            "text": "na neprijatelje se svoje ustremio.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "„Od davnina sam ćutao,",
            "poem": 1
          },
          {
            "text": "gluv se pravio, uzdržavao,",
            "poem": 2
          },
          {
            "text": "sad vičem kao porodilja,",
            "poem": 1
          },
          {
            "text": "dahćem i izdišem ujedno.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Sasušiću gore i bregove,",
            "poem": 1
          },
          {
            "text": "i sparušiti sve biljke po njima,",
            "poem": 2
          },
          {
            "text": "i pretvoriti reke u vrtače,",
            "poem": 1
          },
          {
            "text": "i močvare ja ću isušiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Slepe ljude vodiću putem što ga ne poznaju,",
            "poem": 1
          },
          {
            "text": "uputiću ih na staze što ih ne poznaju.",
            "poem": 2
          },
          {
            "text": "Pred njima ću tamu u svetlost pretvoriti,",
            "poem": 1
          },
          {
            "text": "a džombe u zaravan.",
            "poem": 2
          },
          {
            "text": "Te ću stvari učiniti",
            "poem": 1
          },
          {
            "text": "i neću oklevati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "U velikom stidu će uzmaći",
            "poem": 1
          },
          {
            "text": "koji se u rezane kipove uzdaju,",
            "poem": 2
          },
          {
            "text": "koji livenim likovima govore:",
            "poem": 1
          },
          {
            "text": "’Vi ste bogovi naši.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Pesma o zaslepljenosti"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Čujte, gluvi!",
            "poem": 1
          },
          {
            "text": "I progledajte, slepi, da vidite!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ko je slep, ako ne moj sluga?",
            "poem": 1
          },
          {
            "text": "Ko je gluv, ako ne moj glasnik koga šaljem?",
            "poem": 2
          },
          {
            "text": "Ko je slep kao namireni",
            "poem": 1
          },
          {
            "text": "i slep kao sluga Gospodnji?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Mnogo si video, ali nisi mario;",
            "poem": 1
          },
          {
            "text": "uši otvorene ali niko ne sluša.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Gospodu se svidelo",
            "poem": 1
          },
          {
            "text": "zbog pravednosti njegove",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "da uzveliča Zakon i počast mu da.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "A narod je ovaj opljačkan i oplenjen,",
            "poem": 1
          },
          {
            "text": "u pećine svi su oni zatvoreni,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "u zatvore sklonjeni.",
            "poem": 2
          },
          {
            "text": "Plene ih,",
            "poem": 1
          },
          {
            "text": "a niko da ih izbavi;",
            "poem": 2
          },
          {
            "text": "otimaju im,",
            "poem": 1
          },
          {
            "text": "a niko da kaže: „Vrati!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Ko od vas mari za to?",
            "poem": 1
          },
          {
            "text": "Ko se nagao i sluša unapred?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Ko je pljačkašu izručio Jakova",
            "poem": 1
          },
          {
            "text": "i otimačima Izrailja?",
            "poem": 2
          },
          {
            "text": "Nije li to Gospod,",
            "poem": 1
          },
          {
            "text": "protiv kog smo grešili,",
            "poem": 2
          },
          {
            "text": "čije puteve nisu hteli da slede,",
            "poem": 1
          },
          {
            "text": "i čiji Zakon nisu slušali?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Zato je on na njega izlio",
            "poem": 1
          },
          {
            "text": "jarost gneva svojega i nasilja ratna;",
            "poem": 2
          },
          {
            "text": "plamen ga je odasvud okružio,",
            "poem": 1
          },
          {
            "text": "ali on ni to nije shvatio;",
            "poem": 2
          },
          {
            "text": "i spalio ga je,",
            "poem": 1
          },
          {
            "text": "ali on ni to nije ozbiljno uzeo.",
            "poem": 2
          }
        ]
      }
    ],
