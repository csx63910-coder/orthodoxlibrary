  "chapter": {
    "number": 10,
    "content": [
      {
        "type": "heading",
        "content": [
          "Gospod će da se postara za Judu"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Tražite od Gospoda kišu u vreme prolećne kiše.",
            "poem": 1
          },
          {
            "text": "Gospod stvara grmljavinu i pljuskove,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "on daje svakome rastinje po polju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Jer idoli objavljuju pakosti,",
            "poem": 1
          },
          {
            "text": "sanjari vide prevaru,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "lažne snove raspredaju.",
            "poem": 2
          },
          {
            "text": "Oni taštinom teše",
            "poem": 1
          },
          {
            "text": "i zato ljudi idu kao ovce,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ojađeni, jer nema pastira.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "„Na pastire je planula srdžba moja",
            "poem": 1
          },
          {
            "text": "i jarcima ja ću da sudim.",
            "poem": 2
          },
          {
            "text": "Jer Gospod nad vojskama se o svom stadu brine",
            "poem": 1
          },
          {
            "text": "i o domu Judinom.",
            "poem": 2
          },
          {
            "text": "On će ih učiniti",
            "poem": 1
          },
          {
            "text": "svojim silnim ratnim konjem.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Od njega je ugaoni kamen,",
            "poem": 1
          },
          {
            "text": "od njega je klin u zidu;",
            "poem": 2
          },
          {
            "text": "od njega je ratni luk",
            "poem": 1
          },
          {
            "text": "i svaki vladar dolazi od njega.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "I oni će biti kao junaci",
            "poem": 1
          },
          {
            "text": "što u boju gaze dušmane po blatu ulica.",
            "poem": 2
          },
          {
            "text": "Boriće se, jer će Gospod biti s njima",
            "poem": 1
          },
          {
            "text": "i posramiće one koji jašu konje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ojačaću dom Judin",
            "poem": 1
          },
          {
            "text": "i dom Josifov izbaviću.",
            "poem": 2
          },
          {
            "text": "Obnoviću ih",
            "poem": 1
          },
          {
            "text": "jer sam im se smilovao.",
            "poem": 2
          },
          {
            "text": "I biće kao da ih odbacio nisam,",
            "poem": 1
          },
          {
            "text": "jer ja sam Gospod,",
            "poem": 2
          },
          {
            "text": "ja sam Bog njihov",
            "poem": 1
          },
          {
            "text": "i ja ću im se odazvati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Jefremovci će biti kao junak moćni,",
            "poem": 1
          },
          {
            "text": "srca radosnoga kao od vina.",
            "poem": 2
          },
          {
            "text": "Deca njihova će to videti i milo će im biti.",
            "poem": 1
          },
          {
            "text": "Klicaće im srca u Gospodu.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Zazviždaću im",
            "poem": 1
          },
          {
            "text": "i okupiću ih.",
            "poem": 2
          },
          {
            "text": "Jer ja sam ih otkupio",
            "poem": 1
          },
          {
            "text": "i biće ih mnoštvo kao što ih je mnoštvo i bilo.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Rasejaću ih među narode",
            "poem": 1
          },
          {
            "text": "i u dalekim krajevima će me se setiti.",
            "poem": 2
          },
          {
            "text": "Živeće sa svojom decom",
            "poem": 1
          },
          {
            "text": "i onda će se vratiti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Vratiću ih iz egipatske zemlje",
            "poem": 1
          },
          {
            "text": "i iz Asirije.",
            "poem": 2
          },
          {
            "text": "Okupiću ih u galadskoj zemlji",
            "poem": 1
          },
          {
            "text": "i na Livan dovešću ih.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Neće za njih biti dovoljno mesta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Kroz more oluje će proći",
            "poem": 1
          },
          {
            "text": "i primiriće morske talase.",
            "poem": 2
          },
          {
            "text": "Osušiće dubine Nila,",
            "poem": 1
          },
          {
            "text": "poniziće ponos Asirije,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a žezlo će egipatsko nestati.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Osnažiću ih, ja Gospod,",
            "poem": 1
          },
          {
            "text": "i u mom imenu će oni koračati",
            "poem": 2
          },
          {
            "text": "– govori Gospod.“",
            "poem": 3
          }
        ]
      }
    ],
