  "chapter": {
    "number": 9,
    "content": [
      {
        "type": "heading",
        "content": [
          "Sud nad neprijateljima Izrailja"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Proroštvo:",
          {
            "lineBreak": true
          },
          {
            "text": "Reč Gospodnja o zemlji Adrahu i o Damasku,",
            "poem": 1
          },
          {
            "text": "odmorištu njegovom –",
            "poem": 2
          },
          {
            "text": "jer su na Gospodu oči sveta",
            "poem": 1
          },
          {
            "text": "i svih plemena Izrailja –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "zatim o Amatu, koji se graniči sa njim,",
            "poem": 1
          },
          {
            "text": "kao i o Tiru i o Sidonu, jer su veoma mudri.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Naime, Tir je sebi sazidao utvrđenje,",
            "poem": 1
          },
          {
            "text": "zgrnuo je srebra kao prašine",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i zlata kao blata sa ulica.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Gle! Gospod će ga razvlastiti,",
            "poem": 1
          },
          {
            "text": "u more će bacati bedem njegov,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a njega će samog plamen da proguta.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Videće to Askalon pa će se prepasti,",
            "poem": 1
          },
          {
            "text": "a Gaza će se zgrčiti od jakog bola,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "baš kao i Akaron čija će se nada obrukati.",
            "poem": 2
          },
          {
            "text": "Postradaće car Gaze,",
            "poem": 1
          },
          {
            "text": "a u Askalonu nikog neće biti.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Mešanci će naseljavati Azot",
            "poem": 1
          },
          {
            "text": "jer ću Filistejcima da slomim ponos.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Uzeću im krv njihovih gadosti iz usta,",
            "poem": 1
          },
          {
            "text": "između njihovih zuba.",
            "poem": 2
          },
          {
            "text": "A ostatak će biti našem Bogu",
            "poem": 1
          },
          {
            "text": "kao dostojanstvenik u Judi,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a Akaron će biti poput Jevusejca.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Hramu svom ću na stražu da se postavim zbog vojske,",
            "poem": 1
          },
          {
            "text": "zbog onih što prolaze i dolaze.",
            "poem": 2
          },
          {
            "text": "Dušman više neće da ga gazi",
            "poem": 1
          },
          {
            "text": "jer sada sam očima svojim video to.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Dolazak cara Siona"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Kliči radosno, o, ćerko sionska!",
            "poem": 1
          },
          {
            "text": "Podvikuj od sreće, o, ćerko jerusalimska!",
            "poem": 2
          },
          {
            "text": "Evo, Car tvoj k tebi dolazi!",
            "poem": 1
          },
          {
            "text": "Pravedan je i spasava.",
            "poem": 2
          },
          {
            "text": "On je krotak i jaše na magarcu i na magaretu,",
            "poem": 1
          },
          {
            "text": "mladuncu magarice.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ukloniću iz Jefrema bojna kola",
            "poem": 1
          },
          {
            "text": "i konje iz Jerusalima.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Izlomiću ratne lukove",
            "poem": 2
          },
          {
            "text": "i on će objaviti mir narodima,",
            "poem": 1
          },
          {
            "text": "vladaće od mora do mora",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "i od Eufrata",
            "poem": 2
          },
          {
            "noteId": 5
          },
          {
            "text": "do krajeva gde zemlja prestaje.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Još ću ti zbog krvi tvog saveza",
            "poem": 1
          },
          {
            "text": "osloboditi tvoje zarobljenike iz bezvodne jame.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "O, zatvorenici,",
            "poem": 1
          },
          {
            "text": "u nadi se vratite u utvrđenje!",
            "poem": 2
          },
          {
            "text": "Još toga ću dana da objavim:",
            "poem": 1
          },
          {
            "text": "„Vraćam ti dvostruko.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Napeću sebi Judu kao luk",
            "poem": 1
          },
          {
            "text": "i napuniću ga Jefremom.",
            "poem": 2
          },
          {
            "text": "Podići ću tvoje sinove, Sione",
            "poem": 1
          },
          {
            "text": "na sinove tvoje, Grčko.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Učiniću te, Sione, da si kao mač ratnika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Gospod dolazi"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Gospod će se javiti nad njima",
            "poem": 1
          },
          {
            "text": "i suknuće kao munja strela njegova.",
            "poem": 2
          },
          {
            "text": "Gospod Bog će zaječati trubom",
            "poem": 1
          },
          {
            "text": "i hujaće u vihorima s juga.",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Gospod nad vojskama će biti zaštita nad njima,",
            "poem": 2
          },
          {
            "text": "pa će razarati",
            "poem": 1
          },
          {
            "text": "i obaraće kamenjem iz praćke.",
            "poem": 2
          },
          {
            "text": "Piće i vikaće kao vinopije",
            "poem": 1
          },
          {
            "text": "i biće puni kao pehar,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "kao uglovi žrtvenika.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Toga dana će ih izbaviti njihov Gospod Bog",
            "poem": 1
          },
          {
            "text": "kao stado svog naroda,",
            "poem": 2
          },
          {
            "text": "i oni će blistati kao dragulji iz krune",
            "poem": 1
          },
          {
            "text": "nad njegovom zemljom.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Kakvo je dobro njegovo!",
            "poem": 1
          },
          {
            "text": "Kakva je lepota njegova!",
            "poem": 2
          },
          {
            "text": "Od žita će bujati mladići",
            "poem": 1
          },
          {
            "text": "i devojke od šire.",
            "poem": 2
          }
        ]
      }
    ],
