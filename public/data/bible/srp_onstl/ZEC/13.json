  "chapter": {
    "number": 13,
    "content": [
      {
        "type": "heading",
        "content": [
          "Očišćenje od greha"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Toga će se dana zbog greha i nečistoće otvoriti izvor za dom Davidov i za stanovnike Jerusalima."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Toga ću dana – govori Gospod nad vojskama – iz zemlje izbrisati imena idola i više se neće spominjati. Iz zemlje ću da istrebim i proroke i nečisti duh."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "A ako bi još neko da prorokuje, kazaće mu roditelji, otac njegov i majka njegova: ’Živ nećeš ostati jer si laž objavljivao u ime Gospodnje!’ Tako će ga roditelji, otac njegov i majka njegova, probosti kada bude prorokovao."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Toga će se dana zastideti proroci, baš svi, zbog svojih objava koje su prorokovali. Neće se više zagrtati kosmatim ogrtačem da bi obmanjivali."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "I kazaće: ’Ja i nisam prorok. Ja sam ratar koji ore zemlju, nego me je neko kupio još kada sam mlad bio.’"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Neko će ga upitati: ’Odakle ti te rane po prsima?’ Odgovoriće: ’Izranjavali su me u kući moga prijatelja.’"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Udareni pastir i raštrkane ovce"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "O, maču, ustani na mog pastira",
            "poem": 1
          },
          {
            "text": "i na čoveka koji mi je blizak",
            "poem": 2
          },
          {
            "text": "– govori Gospod nad vojskama.",
            "poem": 3
          },
          {
            "text": "Udari pastira,",
            "poem": 1
          },
          {
            "text": "i ovce će se razbežati,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "a ja ću nad neznatne da okrenem ruku svoju.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "I u celoj zemlji – govori Gospod –",
            "poem": 1
          },
          {
            "text": "dve trećine će biti posečeno i postradaće.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Tako će ostati samo trećina ljudi.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Tu ću trećinu da pustim kroz vatru,",
            "poem": 1
          },
          {
            "text": "da je pretopim kao što se srebro topi.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Proveriću ih kao što se zlato proverava.",
            "poem": 2
          },
          {
            "text": "Oni će zazvati moje ime",
            "poem": 1
          },
          {
            "text": "i ja ću se odazvati i reći:",
            "poem": 2
          },
          {
            "text": "’Ovo je moj narod!’",
            "poem": 3
          },
          {
            "text": "A oni će da uzvrate:",
            "poem": 2
          },
          {
            "text": "’Gospod je naš Bog!’",
            "poem": 3
          }
        ]
      }
    ],
    "footnotes": []
  },
