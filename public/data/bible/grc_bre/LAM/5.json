    "order": 25,
    "numberOfChapters": 5,
    "sha256": "5217c54de38f859308657bb0b682ff47360bb7342d5bba7f6212ea3ac14ab60b",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_bre/LAM/1.json",
