  "chapter": {
    "number": 29,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "ἘΠΙ ΤΟΥΣ ἈΛΛΟΦΥΛΟΥΣ ΤΑΔΕ ΛΕΓΕΙ ΚΥΡΙΟΣ."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Ἰδοὺ ὕδατα ἀναβαίνει ἀπὸ Βοῤῥᾶ, καὶ ἔσται εἰς χειμάῤῥουν κατακλύζοντα, καὶ κατακλύσει γῆν καὶ τὸ πλήρωμα αὐτῆς, πόλιν καὶ τοὺς κατοικοῦντας ἐν αὐτῇ· καὶ κεκράξονται οἱ ἄνθρωποι, καὶ ἀλαλάξουσιν ἅπαντες οἱ κατοικοῦντες τὴν γῆν,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἀπὸ φωνῆς ὁρμῆς αὐτοῦ, ἀπὸ τῶν ὅπλων τῶν ποδῶν αὐτοῦ, καὶ ἀπὸ σεισμοῦ τῶν ἁρμάτων αὐτοῦ, ἤχου τροχῶν αὐτοῦ· οὐκ ἐπέστρεψαν πατέρες ἐφʼ υἱοὺς αὐτῶν ἀπὸ ἐκλύσεως χειρῶν αὐτῶν"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἐν τῇ ἡμέρᾳ τῇ ἐπερχομένῃ τοῦ ἀπολέσαι πάντας τοὺς ἀλλοφύλους· καὶ ἀφανιῶ τὴν Τύρον, καὶ τὴν Σιδῶνα, καὶ πάντας τοὺς καταλοίπους τῆς βοηθείας αὐτῶν, ὅτι ἐξολοθρεύσει Κύριος τοὺς καταλοίπους τῶν νήσων."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Ἥκει φαλάκρωμα ἐπὶ Γάζαν, ἀπεῤῥίφη Ἀσκάλων, καὶ οἱ κατάλοιποι Ἐνακίμ."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ἕως τίνος κόψεις ἡ μάχαιρα τοῦ Κυρίου; ἕως τίνος οὐχ ἡσυχάσεις; ἀποκατάστηθι εἰς τὸν κολεόν σου, ἀνάπαυσαι, καὶ ἐπάρθητι."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Πῶς ἡσυχάσει, καὶ Κύριος ἐνετείλατο αὐτῇ ἐπὶ τὴν Ἀσκάλωνα, καὶ ἐπὶ τὰς παραθαλασσίους, ἐπὶ τὰς καταλοίπους ἐπεγερθῆναι;"
        ]
      }
    ],
