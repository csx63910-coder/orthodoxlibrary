    "order": 13,
    "numberOfChapters": 29,
    "sha256": "81e248f8a40844d77057946d86beb4369af386967bbb17d723087caa35808eaf",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_bre/1CH/1.json",
