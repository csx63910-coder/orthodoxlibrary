  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ οὗτοι ἦσαν υἱοὶ Δαυὶδ οἱ τεχθέντες αὐτῷ ἐν Χεβρών· ὁ πρωτότοκος Ἀμνὼν τῇ Ἀχιναὰμ τῇ Ἰεζραηλίτιδι· ὁ δεύτερος Δαμνιὴλ τῇ Ἀβιγαίᾳ τῇ Καρμηλίᾳ·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Ὁ τρίτος Ἀβεσσαλὼμ, υἱὸς Μωχὰ θυγατρὸς Θολμαῒ βασιλέως Γεδσούρ· ὁ τέταρτος Ἀδωνία υἱὸς Ἀγγίθ·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Ὁ πέμπτος Σαφατία τῆς Ἀβιτὰλ· ὁ ἕκτος Ἰεθραὰμ τῇ Ἀγλᾷ γυναικὶ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Ἓξ ἐγεννήθησαν αὐτῷ ἐν Χεβρών· καὶ ἐβασίλευσεν ἐκεῖ ἑπτὰ ἔτη, καὶ ἑξάμηνον· καὶ τριάκοντα καὶ τρία ἔτη ἐβασίλευσεν ἐν Ἱερουσαλήμ."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Καὶ οὗτοι ἐτέχθησαν αὐτῷ ἐν Ἱερουσαλήμ· Σαμαὰ, Σωβὰβ, Νάθαν, καὶ Σαλωμών· τέσσαρες τῇ Βηρσαβεὲ θυγατρὶ Ἀμιήλ·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Καὶ Ἐβαὰρ, καὶ Ἐλισὰ, καὶ Ἐλιφαλὴθ,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "καὶ Ναγαὶ, καὶ Ναφὲκ, καὶ Ἰαφιὲ,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ Ἑλισαμὰ, καὶ Ἐλιαδὰ, καὶ Ἐλιφαλὰ, ἐννέα."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Πάντες υἱοὶ Δαυὶδ, πλὴν τῶν υἱῶν τῶν παλλακῶν, καὶ Θήμαρ ἀδελφὴ αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Υἱοὶ Σαλωμὼν, Ῥοβοάμ, Ἀβιὰ υἱὸς αὐτοῦ, Ἀσὰ υἱὸς αὐτοῦ, Ἰωσαφὰτ υἱὸς αὐτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ἰωρὰμ υἱὸς αὐτοῦ, Ὀχοζίας υἱὸς αὐτοῦ, Ἰωὰς υἱὸς αὐτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ἀμασίας υἱὸς αὐτοῦ, Ἀζαρίας υἱὸς αὐτοῦ, Ἰωάθαν υἱὸς αὐτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ἄχαζ υἱὸς αὐτοῦ, Ἐζεκίας υἱὸς αὐτοῦ, Μανασσῆς υἱὸς αὐτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Ἀμὼν υἱὸς αὐτοῦ, Ἰωσία υἱὸς αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Καὶ υἱοὶ Ἰωσία, πρωτότοκος Ἰωανὰν, ὁ δεύτερος Ἰωακεὶμ, ὁ τρίτος Σεδεκίας, ὁ τέταρτος Σαλούμ."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Καὶ υἱοὶ Ἰωακείμ, Ἰεχονίας υἱὸς αὐτοῦ, Σεδεκίας υἱὸς αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Καὶ υἱοὶ Ἰεχονία, Ἀσὶρ, Σαλαθιὴλ υἱὸς αὐτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Μελχειρὰμ, καὶ Φαδαΐας, καὶ Σανεσὰρ, καὶ Ἰεκιμία, καὶ Ὡσαμὰθ, καὶ Ναβαδίας."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Καὶ υἱοὶ Φαδαΐας, Ζοροβάβελ, καὶ Σεμεΐ· καὶ υἱοὶ Ζοροβάβελ, Μοσολλὰμ, καὶ Ἀνανία, καὶ Σαλωμεθὶ ἀδελφὴ αὐτῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "καὶ Ἀσουβὲ, καὶ Ὀὸλ, καὶ Βαραχὶα, καὶ Ἀσαδία, καὶ Ἀσοβὲδ, πέντε."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Καὶ υἱοὶ Ἀνανία, Φαλεττία, καὶ Ἰεσίας υἱὸς αὐτοῦ, Ῥαφὰλ υἱὸς αὐτοῦ, Ὀρνὰ υἱὸς αὐτοῦ, Ἀβδία υἱὸς αὐτοῦ, Σεχενίας υἱὸς αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Καὶ υἱὸς Σεχενία, Σαμαΐα· καὶ υἱοὶ Σαμαΐα, Χαττοὺς, καὶ Ἰωὴλ, καὶ Βεῤῥὶ, καὶ Νωαδία, καὶ Σαφὰθ, ἕξ."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Καὶ υἱοὶ Νωαδία, Ἐλιθενὰν, καὶ Ἐζεκία, καὶ Ἐζρικὰμ, τρεῖς."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Καὶ υἱοὶ Ἐλιθενὰν, Ὀδολία, καὶ Ἑλιασεβὼν, καὶ Φαδαΐα, καὶ Ἀκοὺβ, καὶ Ἰωανὰν, καὶ Δαλααΐα, καὶ Ἀνὰν, ἑπτά."
        ]
      }
    ],
