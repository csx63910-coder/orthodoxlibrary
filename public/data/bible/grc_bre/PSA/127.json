  "chapter": {
    "number": 127,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ὠδὴ τῶν ἀναβαθμῶν.",
            "descriptive": true
          },
          "Μακάριοι πάντες οἱ φοβούμενοι τὸν Κύριον, οἱ πορευόμενοι ἐν ταῖς ὁδοῖς αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Τοὺς πόνους τῶν καρπῶν σου φάγεσαι· μακάριος εἶ καὶ καλῶς σοι ἔσται."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Ἡ γυνή σου ὡς ἄμπελος εὐθηνοῦσα ἐν ταῖς κλίτεσι τῆς οἰκίας σου· οἱ υἱοί σου ὡς νεόφυτα ἐλαιῶν κύκλῳ τῆς τραπέζης σου."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Ἰδοὺ οὕτως εὐλογηθήσεται ἄνθρωπος ὁ φοβούμενος τὸν Κύριον."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Εὐλογήσαι σε Κύριος ἐκ Σιὼν, καὶ ἴδοις τὰ ἀγαθὰ Ἱερουσαλὴμ πάσας τὰς ἡμέρας τῆς ζωῆς σου·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Καὶ ἴδοις υἱοὺς τῶν υἱῶν σου· εἰρήνη ἐπὶ τὸν Ἰσραήλ."
        ]
      }
    ],
    "footnotes": []
