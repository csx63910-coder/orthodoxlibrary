  "chapter": {
    "number": 49,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ψαλμὸς τῷ Ἀσάφ.",
            "descriptive": true
          },
          "Θεὸς θεῶν Κύριος ἐλάλησε, καὶ ἐκάλεσε τὴν γῆν ἀπὸ ἀνατολῶν ἡλίου μέχρι δυσμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Ἐκ Σιὼν ἡ εὐπρέπεια τῆς ὡραιότητος αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Ὁ Θεὸς ἐμφανῶς ἥξει, ὁ Θεὸς ἡμῶν, καὶ οὐ παρασιωπήσεται· πῦρ ἐναντίον αὐτοῦ καυθήσεται, καὶ κύκλῳ αὐτοῦ καταιγὶς σφοδρά."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Προσκαλέσεται τὸν οὐρανὸν ἄνω, καὶ τὴν γῆν διακρῖναι τὸν λαὸν αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Συναγάγετε αὐτῷ τοὺς ὁσίους αὐτοῦ, τοὺς διατιθεμένους τὴν διαθήκην αὐτοῦ ἐπὶ θυσίαις."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Καὶ ἀναγγελοῦσιν οἱ οὐρανοὶ τὴν δικαιοσύνην αὐτοῦ, ὅτι Θεὸς κριτής ἐστι· διάψαλμα."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ἄκουσον λαός μου καὶ λαλήσω σοι, Ἰσραὴλ, καὶ διαμαρτύρομαί σοι· ὁ Θεὸς ὁ Θεός σου εἰμὶ ἐγώ."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Οὐκ ἐπὶ ταῖς θυσίαις σου ἐλέγξω σε, τὰ δὲ ὁλοκαυτώματά σου ἐνώπιόν μου ἐστὶ διαπαντός."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Οὐ δέξομαι ἐκ τοῦ οἴκου σου μόσχους, οὐδὲ ἐκ τῶν ποιμνίων σου χιυάρους·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Ὅτι ἐμά ἐστι πάντα τὰ θηρία τοῦ δρυμοῦ, κτήνη ἐν τοῖς ὄρεσι, καὶ βόες."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ἔγνωκα πάντα τὰ πετεινὰ τοῦ οὐρανοῦ, καὶ ὡραιότης ἀγροῦ μετʼ ἐμοῦ ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ἐὰν πεινάσω, οὐ μή σοι εἴπω, ἐμὴ γάρ ἐστιν ἡ οἰκουμένη καὶ τὸ πλήρωμα αὐτῆς."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Μὴ φάγομαι κρέα ταύρων, ἢ αἷμα τράγων πίομαι;"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Θῦσον τῷ Θεῷ θυσίαν αἰνέσεως, καὶ ἀπόδος τῷ ὑψίστῳ τὰς εὐχάς σου."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Καὶ ἐπικάλεσαί με ἐν ἡμέρᾳ θλίψεως, καὶ ἐξελοῦμαί σε, καὶ δοξάσεις με. διάψαλμα."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Τῷ δὲ ἁμαρτωλῷ εἶπεν ὁ Θεὸς, ἱνατί σὺ διηγῇ τὰ δικαιώματά μου, καὶ ἀναλαμβάνεις τὴν διαθήκην μου διὰ στόματός σου;"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Σὺ δὲ ἐμίσησας παιδείαν, καὶ ἐξέβαλες τοὺς λόγους μου εἰς τὰ ὀπίσω."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Εἰ ἐθεώρεις κλέπτην, συνέτρεχες αὐτῷ, καὶ μετὰ μοιχῶν τὴν μερίδα σου ἐτίθεις."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Τὸ στόμα σου ἐπλεόνασε κακίαν, καὶ ἡ γλῶσσά σου περιέπλεκε δολιότητα."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Καθήμενος κατὰ τοῦ ἀδελφοῦ σου κατελάλεις, καὶ κατὰ τοῦ υἱοῦ τῆς μητρός σου ἐτίθεις σκάνδαλον."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Ταῦτα ἐποίησας, καὶ ἐσίγησα, ὑπέλαβες ἀνομίαν ὅτι ἔσομαί σοι ὅμοιος· ἐλέγξω σε, καὶ παραστήσω κατὰ πρόσωπόν σου."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Σύνετε δὴ ταῦτα οἱ ἐπιλανθανόμενοι τοῦ Θεοῦ, μήποτε ἁρπάσῃ, καὶ μὴ ᾖ ὁ ῥυόμενος."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Θυσία αἰνέσεως δοξάσει με, καὶ ἐκεῖ ὁδὸς ᾗ δείξω αὐτῷ τὸ σωτήριον Θεοῦ."
        ]
      }
    ],
