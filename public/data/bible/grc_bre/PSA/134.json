  "chapter": {
    "number": 134,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ἀλληλούϊα.",
            "descriptive": true
          },
          "Αἰνεῖτε τὸ ὄνομα Κυρίου, αἰνεῖτε δοῦλοι Κύριον,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Οἱ ἑστῶτες ἐν οἴκω Κυρίου, ἐν αὐλαῖς οἴκου Θεοῦ ἡμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Αἰνεῖτε τὸν Κύριον, ὅτι ἀγαθὸς Κύριος· ψάλατε τῷ ὀνόματι αὐτοῦ, ὅτι καλόν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Ὅτι τὸν Ἰακὼβ ἐξελέξατο ἑαυτῷ ὁ Κύριος, Ἰσραὴλ εἰς περιουσιασμὸν ἑαυτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Ὅτι ἐγὼ ἔγνωκα, ὅτι μέγας ὁ Κύριος, καὶ ὁ Κύριος ἡμῶν παρὰ πάντας τοὺς θεούς."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Πάντα ὅσα ἠθέλησεν ὁ Κύριος, ἐποίησεν ἐν τῷ οὐρανῷ καὶ ἐν τῇ γῇ, ἐν ταῖς θαλάσσαις καὶ ἐν πάσαις ταῖς ἀβύσσοις."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ἀνάγων νεφέλας ἐξ ἐσχάτου τῆς γῆς, ἀστραπὰς εἰς ὑετὸν ἐποίησεν· ὁ ἐξάγων ἀνέμους ἐκ θησαυρῶν αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Ὃς ἐπάταξε τὰ πρωτότοκα Αἰγύπτου ἀπὸ ἀνθρώπου ἕως κτήνους."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Ἐξαπέστειλεν σημεῖα καὶ τέρατα ἐν μέσῳ σου Αἴγυπτε, ἐν Φαραῷ καὶ ἐν πᾶσι τοῖς δούλοις αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Ὃς ἐπάταξεν ἔθνη πολλά, καὶ ἀπέκτεινε βασιλεῖς κραταιούς·"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "τὸν Σηὼν βασιλέα τῶν Ἀμοῤῥαίων, καὶ τὸν Ὢγ βασιλέα τῆς Βασὰν, καὶ πάσας τὰς βασιλείας Χαναάν·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Καὶ ἔδωκε τὴν γῆν αὐτῶν κληρονομίαν, κληρονομίαν Ἰσραὴλ λαῷ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Κύριε τὸ ὄνομά σου εἰς τὸν αἰῶνα, καὶ τὸ μνημόσυνόν σου εἰς γενεὰν καὶ γενεάν."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Ὅτι κρινεῖ Κύριος τὸν λαὸν αὐτοῦ, καὶ ἐπὶ τοῖς δούλοις αὐτοῦ παρακληθήσεται."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Τὰ εἴδωλα τῶν ἐθνῶν ἀργύριον καὶ χρυσίον, ἔργα χειρῶν ἀνθρώπων."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Στόμα ἔχουσι καὶ οὐ λαλήσουσιν, ὀφθαλμοὺς ἔχουσι καὶ οὐκ ὄψονται·"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Ὦτα ἔχουσι καὶ οὐκ ἐνωτισθήσονται, οὐδὲ γάρ ἐστι πνεῦμα ἐν τῷ στόματι αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Ὅμοιοι αὐτοῖς γένοιντο οἱ ποιοῦντες αὐτὰ, καὶ πάντες οἱ πεποιθότες ἐπʼ αὐτοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Οἶκος Ἰσραὴλ εὐλογήσατε τὸν Κύριον, οἶκος Ἀαρὼν εὐλογήσατε τὸν Κύριον·"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Οἶκος Λευὶ, εὐλογήσατε τὸν Κύριον, οἱ φοβούμενοι τὸν Κύριον εὐλογήσατε τὸν Κύριον."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Εὐλογητὸς Κύριος ἐκ Σιὼν, ὁ κατοικῶν Ἱερουσαλήμ."
        ]
      }
    ],
