  "chapter": {
    "number": 131,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ὠδὴ τῶν ἀναβαθμῶν.",
            "descriptive": true
          },
          "Μνήσθητι Κύριε τοῦ Δαυὶδ, καὶ πάσης τῆς πρᾳότητος αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Ὡς ὤμοσε τῷ Κυρίῳ, ηὔξατο τῷ Θεῷ Ἰακώβ·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Εἰ εἰσελεύσομαι εἰς σκήνωμα οἴκου μου, εἰ ἀναβήσομαι ἐπὶ κλίνης στρωμνῆς μου·"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Εἰ δώσω ὕπνον τοῖς ὀφθαλμοῖς μοῦ, καὶ τοῖς βλεφάροις μου νυσταγμὸν, καὶ ἀνάπαυσιν τοῖς κροτάφοις μου·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Ἕως οὗ εὕρω τόπον τῷ Κυρίῳ, σκήνωμα τῷ Θεῷ Ἰακώβ."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ἰδοὺ ἠκούσαμεν αὐτὴν ἐν Ἐφραθὰ, εὕρομεν αὐτὴν ἐν τοῖς πεδίοις τοῦ δρυμοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Εἰσελευσώμεθα εἰς τὰ σκηνώματα αὐτοῦ· προσκυνήσωμεν εἰς τὸν τόπον οὗ ἔστησαν οἱ πόδες αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Ἀνάστηθι Κύριε εἰς τὴν ἀνάπαυσίν σου, σὺ καὶ ἡ κιβωτὸς τοῦ ἁγιάσματός σου."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Οἱ ἱερεῖς σου ἐνδύσονται δικαιοσύνην, καὶ οἱ ὅσιοί σου ἀγαλλιάσονται."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Ἕνεκεν Δαυὶδ τοῦ δούλου σου, μὴ ἀποστρέψῃς τὸ πρόσωπον τοῦ χριστοῦ σου."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ὤμοσε Κύριος τῷ Δαυὶδ ἀλήθειαν, καὶ οὐ μὴ ἀθετήσει αὐτὴν, ἐκ καρποῦ τῆς κοιλίας σου, θήσομαι ἐπὶ τοῦ θρόνον σου."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ἐὰν φυλάξωνται οἱ υἱοί σου τὴν διαθήκην μου, καὶ τὰ μαρτύριά μου ταῦτα ἃ διδάξω αὐτοὺς, καὶ οἱ υἱοὶ αὐτῶν ἕως τοῦ αἰῶνος καθιοῦνται ἐπὶ τοῦ θρόνου σου."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ὅτι ἐξελέξατο Κύριος τὴν Σιὼν, ᾑρετίσατο αὐτὴν εἰς κατοικίαν ἑαυτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Αὕτη ἡ κατάπαυσίς μου εἰς αἰῶνα αἰῶνος, ὧδε κατοικήσω ὅτι ᾑρετισάμην αὐτήν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Τὴν θήραν αὐτῆς εὐλογῶν εὐλογήσω, τοὺς πτωχοὺς αὐτῆς χορτάσω ἄρτων."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Τοὺς ἱερεῖς αὐτῆς ἐνδύσω σωτηρίαν, καὶ οἱ ὅσιοι αὐτῆς ἀγαλλιάσει ἀγαλλιάσονται."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Ἐκεῖ ἐξανατελῶ κέρας τῷ Δαυὶδ, ἡτοίμασα λύχνον τῷ χριστῷ σου."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Τοὺς ἐχθροὺς αὐτοῦ ἐνδύσω αἰσχύνην, ἐπὶ δὲ αὐτὸν ἐξανθήσει τὸ ἁγίασμά μου."
        ]
      }
    ],
