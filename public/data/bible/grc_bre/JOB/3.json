  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Μετὰ τοῦτο ἤνοιξεν Ἰὼβ τὸ στόμα αὐτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ κατηράσατο τὴν ἡμέραν αὐτοῦ, λέγων,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Ἀπόλοιτο ἡ ἡμέρα ἐν ᾗ ἐγεννήθην, καὶ ἡ νὺξ ἐκείνη ᾗ εἶπαν, Ἰδοὺ ἄρσεν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Ἡ νὺξ ἐκείνη εἴη σκότος, καὶ μὴ ἀναζητήσαι αὐτὴν ὁ Κύριος ἄνωθεν, μηδὲ ἔλθοι εἰς αὐτὴν φέγγος·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Ἐκλάβοι δὲ αὐτὴν σκότος καὶ σκιὰ θανάτου, ἐπέλθοι ἐπʼ αὐτὴν γνόφος·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καταραθείη ἡ ἡμέρα καὶ ἡ νὺξ ἐκείνη, ἀπενέγκοιτο αὐτὴν σκότος· μὴ εἴη εἰς ἡμέρας ἐνιαυτοῦ, μηδὲ ἀριθμηθείη εἰς ἡμέρας μηνῶν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ἀλλὰ ἡ νὺξ ἐκείνη εἴη ὀδύνη, καὶ μὴ ἔλθοι ἐπʼ αὐτὴν εὐφροσύνη, μηδὲ χαρμονή·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Ἀλλὰ καταράσαιτο αὐτὴν ὁ καταρώμενος τὴν ἡμέραν ἐκείνην, ὁ μέλλων τὸ μέγα κῆτος χειρώσασθαι."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Σκοτωθείη τὰ ἄστρα τῆς νυκτὸς ἐκείνης· ὑπομείναι, καὶ εἰς φωτισμὸν μὴ ἔλθοι, καὶ μὴ ἴδοι Ἑωσφόρον ἀνατέλλοντα."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Ὅτι οὐ συνέκλεισε πύλας γαστρὸς μητρός μου, ἀπήλλαξε γὰρ ἂν πόνον ἀπὸ ὀφθαλμῶν μου."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Διατί γὰρ ἐν κοιλίᾳ οὐκ ἐτελεύτησα; ἐκ γαστρὸς δὲ ἐξῆλθον, καὶ οὐκ εὐθὺς ἀπωλόμην;"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ἱνατί δὲ συνήντησάν μοι τὰ γόνατα; ἱνατί δὲ μαστοὺς ἐθήλασα;"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "νῦν ἂν κοιμηθεὶς ἡσύχασα, ὑπνώσας δὲ ἀνεπαυσάμην"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Νῦν ἂν κοιμηθεὶς ἡσύχασα, ὑπνώσας δὲ ἀνεπαυσάμην μετὰ βασιλέων βουλευτῶν γῆς οἳ ἐγαυριῶντο ἐπὶ ξίφεσιν,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ἢ μετὰ ἀρχόντων, ὧν πολὺς ὁ χρυσός, οἳ ἔπλησαν τοὺς οἴκους αὐτῶν ἀργυρίου·"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Ἢ ὥσπερ ἔκτρωμα ἐκπορευόμενον ἐκ μήτρας μητρὸς, ἢ ὥσπερ νήπιοι, οἳ οὐκ εἶδον φῶς·"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Ἐκεῖ ἀσεβεῖς ἐξέκαυσαν θυμὸν ὀργῆς, ἐκεῖ ἀνεπαύσαντο κατάκοποι τῷ σώματι."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Ὁμοθυμαδὸν δὲ οἱ αἰώνιοι οὐκ ἤκουσαν φωνὴν φορολόγου."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Μικρὸς καὶ μέγας ἐκεῖ ἐστι, καὶ θεράπων δεδοικὼς τὸν κύριον αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Ἱνατί γὰρ δέδοται τοῖς ἐν πικρίᾳ φῶς; ζωὴ δὲ ταῖς ἐν ὀδύναις ψυχαῖς,"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "οἳ ἱμείρονται τοῦ θανάτου, καὶ οὐ τυγχάνουσιν ἀνορύσσοντες ὥσπερ θησαυροὺς,"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "περιχαρεῖς δὲ ἐγένοντο ἐὰν κατατύχωσι;"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Θάνατος ἀνδρὶ ἀνάπαυμα, συνέκλεισεν γὰρ ὁ Θεὸς κατʼ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Πρὸ γὰρ τῶν σίτων μου στεναγμὸς ἥκει, δακρύω δὲ ἐγὼ συνεχόμενος φόβῳ."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Φόβος γὰρ ὃν ἐφρόντισα ἦλθέ μοι, καὶ ὃν ἐδεδοίκειν, συνήντησέν μοι."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Οὔτε εἰρήνευσα, οὔτε ἡσύχασα, οὔτε ἀνεπαυσάμην, ἦλθε δέ μοι ὀργή·"
        ]
      }
    ],
