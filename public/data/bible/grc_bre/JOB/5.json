  },
  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἐπικαλέσαι δὲ εἴ τις σοι ὑπακούσεται, ἢ εἴ τινα ἀγγέλων ἁγίων ὄψῃ·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Καὶ γὰρ ἄφρονα ἀναιρεῖ ὀργὴ, πεπλανημένον δὲ θανατοῖ ζῆλος."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Ἐγὼ δὲ ἑώρακα ἄφρονας ῥίζαν βάλλοντας, ἀλλʼ εὐθέως ἐβρώθη αὐτῶν ἡ δίαιτα."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Πόῤῥω γένοιντο οἱ υἱοὶ αὐτῶν ἀπὸ σωτηρίας, κολαβρισθείησαν δὲ ἐπὶ θύραις ἡσσόνων, καὶ οὐκ ἔσται ὁ ἐξαιρούμενος."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Ἃ γὰρ ἐκεῖνοι συνήγαγον, δίκαιοι ἔδονται, αὐτοὶ δὲ ἐκ κακῶν οὐκ ἐξαίρετοι ἔσονται· ἐκσιφωνισθείη αὐτῶν ἡ ἰσχύς."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Οὐ γὰρ μὴ ἐξέλθῃ ἐκ τῆς γῆς κόπος, οὐδὲ ἐξ ὀρέων ἀναβλαστήσει πόνος."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ἀλλὰ ἄνθρωπος γεννᾶται κόπῳ, νεοσσοὶ δὲ γυπὸς τὰ ὑψηλὰ πέτονται."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Οὐ μὴν δὲ ἀλλὰ ἐγὼ δεηθήσομαι Κυρίου, Κύριον δὲ τὸν πάντων δεσπότην ἐπικαλέσομαι,"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "τὸν ποιοῦντα μεγάλα καὶ ἀνεξιχνίαστα, ἔνδοξά τε καὶ ἐξαίσια, ὧν οὐκ ἔστιν ἀριθμὸς,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "τὸν διδόντα ὑετὸν ἐπὶ τὴν γῆν, ἀποστέλλοντα ὕδωρ ἐπὶ τὴν ὑπʼ οὐρανὸν,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "τὸν ποιοῦντα ταπεινοὺς εἰς ὕψος, καὶ ἀπολωλότας ἐξεγείροντα,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "διαλλάσσοντα βουλὰς πανούργων, καὶ οὐ μὴ ποιήσουσιν αἱ χεῖρες αὐτῶν ἀληθές·"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ὁ καταλαμβάνων σοφοὺς ἐν τῇ φρονήσει, βουλὴν δὲ πολυπλόκων ἐξέστησεν."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Ἡμέρας συναντήσεται αὐτοῖς σκότος, τὸ δὲ μεσημβρινὸν ψηλαφήσαισαν ἶσα νυκτὶ,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ἀπόλοιντο δὲ ἐν πολέμῳ· ἀδύνατος δὲ ἐξέλθοι ἐκ χειρὸς δυνάστου."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Εἴη δὲ ἀδυνάτῳ ἐλπὶς, ἀδίκου δὲ στόμα ἐμφραχθείη."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Μακάριος δὲ ἄνθρωπος ὃν ἤλεγξεν ὁ Κύριος, νουθέτημα δὲ παντοκράτορος μὴ ἀπαναίνου."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Αὐτὸς γὰρ ἀλγεῖν ποιεῖ, καὶ πάλιν ἀποκαθίστησιν· ἔπαισε, καὶ αἱ χεῖρες αὐτοῦ ἰάσαντο."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Ἑξάκις ἐξ ἀναγκῶν σε ἐξελεῖται, ἐν δὲ τῷ ἑβδόμῳ οὐ μὴ ἅψηταί σου κακόν."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Ἐν λιμῷ ῥύσεταί σε ἐκ θανάτου, ἐν πολέμῳ δὲ ἐκ χειρὸς σιδήρου λύσει σε."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Ἀπὸ μάστιγος γλώσσης σε κρύψει, καὶ οὐ μὴ φοβηθῇς ἀπὸ κακῶν ἐρχομένων."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Ἀδίκων καὶ ἀνόμων καταγελάσῃ· ἀπὸ δὲ θηρίων ἀγρίων οὐ μὴ φοβηθῇς·"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Θῆρες γὰρ ἄγριοι εἰρηνεύσουσί σοι."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Εἶτα γνώσῃ ὅτι εἰρηνεύσει σου ὁ οἶκος· ἡ δὲ δίαιτα τῆς σκηνῆς σου οὐ μὴ ἁμάρτῃ."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Γνώσῃ δὲ ὅτι πολὺ τὸ σπέρμα σου, τὰ δὲ τέκνα σου ἔσται ὥσπερ τὸ παμβότανον τοῦ ἀγροῦ."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Ἐλεύσῃ δὲ ἐν τάφῳ ὥσπερ σῖτος ὥριμος κατὰ καιρὸν θεριζόμενος, ἢ ὥσπερ θιμωνία ἅλωνος καθʼ ὥραν συγκομισθεῖσα."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Ἰδοὺ ταῦτα οὕτως ἐξιχνιάσαμεν· ταῦτά ἐστιν ἃ ἀκηκόαμεν· σὺ δὲ γνῶθι σεαυτῷ, εἴ τι ἔπραξας."
        ]
      }
    ],
