  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ὑπολαβὼν δὲ Ἐλιφὰς ὁ Θαιμανίτης, λέγει,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Μὴ πολλάκις σοι λελάληται ἐν κόπῳ; ἰσχὺν δὲ ῥημάτων σου τίς ὑποίσει;"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Εἰ γὰρ σὺ ἐνουθέτησας πολλοὺς, καὶ χεῖρας ἀσθενοῦς παρεκάλεσας,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἀσθενοῦντάς τε ἐξανέστησας ῥήμασι, γόνασί τε ἀδυνατοῦσι θάρσος περιέθηκας."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Νῦν δὲ ἥκει ἐπὶ σὲ πόνος καὶ ἥψατό σου, σὺ ἐσπούδασας."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Πότερον οὐχ ὁ φόβος σου ἐστὶν ἐν ἀφροσύνῃ, καὶ ἡ ἐλπίς σου καὶ ἡ κακία τῆς ὁδοῦ σου;"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Μνήσθητι οὖν, τίς καθαρὸς ὢν ἀπώλετο, ἢ πότε ἀληθινοὶ ὁλόῤῥιζοι ἀπώλοντο;"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Καθʼ ὃν τρόπον εἶδον τοὺς ἀροτριῶντας τὰ ἄτοπα, οἱ δὲ σπείροντες αὐτὰ ὀδύνας θεριοῦσιν ἑαυτοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Ἀπὸ προστάγματος Κυρίου ἀπολοῦνται, ἀπὸ δὲ πνεύματος ὀργῆς αὐτοῦ ἀφανισθήσονται."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Σθένος λέοντος, φωνὴ δὲ λεαίνης, γαυρίαμα δὲ δρακόντων ἐσβέσθη."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Μυρμηκολέων ὤλετο παρὰ τὸ μὴ ἔχειν βορὰν, σκύμνοι δὲ λεόντων ἔλιπον ἀλλήλους."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Εἰ δέ τι ῥῆμα ἀληθινὸν ἐγεγόνει ἐν λόγοις σου, οὐθὲν ἄν σοι τούτων κακὸν ἀπήντησε· πότερον οὐ δέξεταί μου τὸ οὖς ἐξαίσια παρʼ αὐτοῦ;"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Φόβῳ δὲ καὶ ἤχῳ νυκτερινῇ ἐπιπίπτων φόβος ἐπʼ ἀνθρώπους,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "φρίκη μοι συνήντησεν καὶ τρόμος, καὶ μεγάλως μου τὰ ὀστᾶ διέσεισε,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ πνεῦμα ἐπὶ πρόσωπόν μου ἐπῆλθεν, ἔφριξαν δέ μου τρίχες καὶ σάρκες."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Ἀνέστην καὶ οὐκ ἐπέγνων, εἶδον καὶ οὐκ ἦν μορφὴ πρὸ ὀφθαλμῶν μου, ἀλλʼ ἢ αὖραν καὶ φωνὴν ἤκουον."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Τί γάρ; μὴ καθαρὸς ἔσται βροτὸς ἐναντίον τοῦ Κυρίου; ἢ ἀπὸ τῶν ἔργων αὐτοῦ ἄμεμπτος ἀνήρ;"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Εἰ κατὰ παίδων αὐτοῦ οὐ πιστεύει, κατὰ δὲ ἀγγέλων αὐτοῦ σκολιόν τι ἐπενόησε."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Τοὺς δὲ κατοικοῦντας οἰκίας πηλίνας, ἐξ ὧν καὶ αὐτοὶ ἐκ τοῦ αὐτοῦ πηλοῦ ἐσμεν, ἔπαισεν αὐτοὺς σητὸς τρόπον,"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "καὶ ἀπὸ πρωΐθεν μέχρι ἑσπέρας οὐκ ἔτι εἰσὶ, παρὰ τὸ μὴ δύνασθαι αὐτοὺς ἑαυτοῖς βοηθῆσαι, ἀπώλοντο."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Ἐνεφύσησε γὰρ αὐτοῖς καὶ ἐξηράνθησαν, ἀπώλοντο παρὰ τὸ μὴ ἔχειν αὐτοὺς σοφίαν."
        ]
      }
    ],
