  "book": {
    "id": "JOB",
    "translationId": "grc_bre",
    "name": "ΙΩΒ",
    "commonName": "ΙΩΒ",
    "title": "ΙΩΒ",
    "order": 18,
    "numberOfChapters": 42,
    "sha256": "5a180a082ffd0f4e0c5317e85128573ae906cc032394cc91ce71d0fd82d7abac",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_bre/JOB/1.json",
    "lastChapterNumber": 42,
    "lastChapterApiLink": "/api/grc_bre/JOB/42.json",
    "totalNumberOfVerses": 1082
  },
  "chapter": {
    "number": 41,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Οὐχ ἐώρακας αὐτόν; οὐδὲ ἐπὶ τοῖς λεγομένοις τεθαύμακας;"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Οὐ δέδοικας, ὅτι ἡτοίμασταί μοι; τίς γάρ ἐστιν ὁ ἐμοὶ ἀντιστάς;"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Ἢ τίς ἀντιστήσεταί μοι, καὶ ὑπομενεῖ; εἰ πᾶσα ἡ ὑπʼ οὐρανὸν ἐμή ἐστιν,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Οὐ σιωπήσομαι διʼ αὐτόν· καὶ λόγον δυνάμεως ἐλεήσει τὸν ἶσον αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Τίς ἀποκαλύψει πρόσωπον ἐνδύσεως αὐτοῦ, εἰς δὲ πτύξιν θώρακος αὐτοῦ τίς ἂν εἰσέλθοι;"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Πύλας προσώπου αὐτοῦ τίς ἀνοίξει; κύκλῳ ὀδόντων αὐτοῦ φόβος."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Τὰ ἔγκατα αὐτοῦ ἀσπίδες χάλκεαι. σύνδεσμος δὲ αὐτοῦ, ὥσπερ σμυρίτης λίθος."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Εἷς τοῦ ἑνὸς κολλῶνται, πνεῦμα δὲ οὐ μὴ διέλθῃ αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Ἀνὴρ τῷ ἀδελφῷ αὐτοῦ προσκολληθήσεται· συνέχονται καὶ οὐ μὴ ἀποσπασθῶσιν."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Ἐν πταρμῷ αὐτοῦ ἐπιφαύσκεται φέγγος, οἱ δὲ ὀφθαλμοὶ αὐτοῦ εἶδος Ἑωσφόρου."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ἐκ στόματος αὐτοῦ ἐκπορεύονται ὡς λαμπάδες καιόμεναι, καὶ διαῤῥιπτοῦνται ἑς ἐσχάραι πυρός."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ἐκ μυκτήρων αὐτοῦ ἐκπορεύεται καπνὸς καμίνου καιομένης πυρὶ ἀνθράκων."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ἡ ψυχὴ αὐτοῦ ἄνθρακες, φλὸξ δὲ ἐκ στόματος αὐτοῦ ἐκπορεύεται·"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Ἐν δὲ τραχήλῳ αὐτοῦ αὐλίζεται δύναμις, ἔμπροσθεν αὐτοῦ τρέχει ἀπώλεια."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Σάρκες δὲ σώματος αὐτοῦ κεκόλληνται· καταχέει ἐπʼ αὐτὸν, οὐ σαλευθήσεται."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Ἡ καρδία αὐτοῦ πέπηγεν ὡς λίθος, ἕστηκε δὲ ὥσπερ ἄκμων ἀνήλατος."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Στραφέντος δὲ αὐτοῦ, φόβος θηρίοις τετράποσιν ἐπὶ γῆς ἁλλομένοις."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Ἐὰν συναντήσωσιν αὐτῷ λόγχαι, οὐδὲν μὴ ποιήσωσι, δόρυ, καὶ θώρακα."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Ἥγηται μὲν γὰρ σίδηρον ἄχυρα, χαλκὸν δὲ ὥσπερ ξύλον σαθρόν."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Οὐ μὴ τρώσῃ αὐτὸν τόξον χάλκεον· ἥγηται μὲν πετροβόλον χόρτον."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Ὡς καλάμη ἐλογίσθησαν σφυρά, καταγελᾷ δὲ σεισμοῦ πυρφόρου."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Ἡ στρωμνὴ αὐτοῦ ὀβελίσκοι ὀξεῖς, πᾶς δὲ χρυσὸς θαλάσσης ὑπʼ αὐτὸν ὥσπερ πηλὸς ἀμύθητος."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Ἀναζεῖ τὴν ἄβυσσον ὥσπερ χαλκεῖον· ἥγηται δὲ τὴν θάλασσαν ὥσπερ ἐξάλειπτρον,"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "τὸν δὲ τάρταρον τῆς ἀβύσσου ὥσπερ αἰχμάλωτον· ἐλογίσατο ἄβυσσον εἰς περίπατον."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Οὐκ ἔστιν οὐδὲν ἐπὶ τῆς γῆς ὅμοιον αὐτῷ, πεποιημένον ἐκαταπαίζεσθαι ὑπὸ τῶν ἀγγέλων μου."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Πᾶν ὑψηλὸν ὁρᾷ· αὐτὸς δὲ βασιλεὺς πάντων τῶν ἐν τοῖς ὕδασιν."
        ]
      }
    ],
