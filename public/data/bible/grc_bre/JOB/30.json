    "title": "ΙΩΒ",
    "order": 18,
    "numberOfChapters": 42,
    "sha256": "5a180a082ffd0f4e0c5317e85128573ae906cc032394cc91ce71d0fd82d7abac",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_bre/JOB/1.json",
    "lastChapterNumber": 42,
    "lastChapterApiLink": "/api/grc_bre/JOB/42.json",
    "totalNumberOfVerses": 1082
  },
  "chapter": {
    "number": 30,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Νυνὶ δὲ κατεγέλασάν μου ἐλάχιστοι, νῦν νουθετοῦσί με ἐν μέρει, ὧν ἐξουδένουν τοὺς πατέρας αὐτῶν, οὓς οὐχ ἡγησάμην ἀξίους κυνῶν τῶν ἐμῶν νομάδων."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Καί γε ἰσχὺς χειρῶν αὐτῶν ἱνατί μοι; ἐπʼ αὐτοὺς ἀπώλετο συντέλεια."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Ἐν ἐνδείᾳ καὶ λιμῷ ἄγονος, οἱ φεύγοντες ἄνυδρον ἐχθὲς συνοχὴν καὶ ταλαιπωρίαν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Οἱ περικυκλοῦντες ἄλιμα ἐπὶ ἠχοῦντι, οἵτινες ἄλιμα ἦν αὐτῶν τὰ σῖτα, ἄτιμοι δὲ καὶ πεφαυλισμένοι, ἐνδεεῖς παντὸς ἀγαθοῦ, οἳ καὶ ῥὶζας ξύλων ἐμασσῶντο ὑπὸ λιμοῦ μεγάλου."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Ἐπανέστησάν μοι κλέπται,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ὧν οἱ οἶκοι αὐτῶν ἦσαν τρῶγλαι πετρῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ἀναμέσον εὐήχων βοήσονται οἳ ὑπὸ φρύγανα ἄγρια διῃτῶντο."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Ἀφρόνων υἱοὶ καὶ ἀτίμων, ὄνομα καὶ κλέος ἐσβεσμένον ἀπὸ γῆς."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Νυνὶ δὲ κιθάρα ἐγώ εἰμι αὐτῶν, καὶ ἐμὲ θρύλλημα ἔχουσιν."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Ἐβδελύξαντο δέ με ἀποστάντες μακρὰν, ἀπὸ δὲ τοῦ προσώπου μου οὐκ ἐφείσαντο πτύελον."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ἀνοίξας γὰρ φαρέτραν αὐτοῦ ἐκάκωσέ με, καὶ χαλινὸν τοῦ προσώπου μου ἐξαπέστειλεν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ἐπὶ δεξιῶν βλαστοῦ ἐπανέστησαν, πόδα αὐτῶν ἐξέτειναν, καὶ ὡδοποίησαν ἐπʼ ἐμὲ· τρίβους ἀπωλείας αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ἐξετρίβησαν τρίβοι μου, ἐξέδυσαν γάρ μου τὴν στολήν·"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "βέλεσιν αὐτοῦ κατηκόντισέ με. Κέκριται δέ μοι ὡς βούλεται, ἐν ὀδύναις πέφυρμαι."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Ἐπιστρέφονταί μου αἱ ὀδύναι, ᾤχετό μου ἡ ἐλπὶς ὥσπερ πνεῦμα, καὶ ὥσπερ νέφος ἡ σωτηρία μου."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Καὶ νῦν ἐπʼ ἐμὲ ἐκχυθήσεται ἡ ψυχή μου, ἔχουσιν δέ με ἡμέραι ὀδυνῶν."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Νυκτὶ δέ μου τὰ ὀστᾶ συγκέχυται, τὰ δὲ νεῦρά μου διαλέλυται."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Ἐν πολλῇ ἰσχύϊ ἐπελάβετό μου τῆς στολῆς, ὥσπερ τὸ περιστόμιον τοῦ χιτῶνός μου περιέσχε με."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Ἥγησαι δέ με ἴσα πηλῷ, ἐν γῇ καὶ σποδῷ μου ἡ μερίς."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Κέκραγα δὲ πρὸς σὲ καὶ οὐκ ἀκούεις μου, ἔστησαν δὲ καὶ κατενόησάν με."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Ἐπέβησαν δέ μοι ἀνελεημόνως, χειρὶ κραταιᾷ με ἐμαστίγωσας."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Ἔταξας δέ με ἐν ὀδύναις, καὶ ἀπέῤῥιψάς με ἀπὸ σωτηρίας."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Οἶδα γὰρ ὅτι θάνατός με ἐκτρίψει, οἰκία γὰρ παντὶ θνητῷ γῆ."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Εἰ γὰρ ὄφελον δυναίμην ἐμαυτὸν χειρώσασθαι, ἢ δεηθείς γε ἑτέρου, καὶ ποιήσει μοι τοῦτο."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Ἐγὼ δὲ ἐπὶ παντὶ ἀδυνάτῳ ἔκλαυσα, ἐστέναξα ἰδὼν ἄνδρα ἐν ἀνάγκαις·"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ἐγὼ δὲ ἐπέχων ἀγαθοῖς, ἰδοὺ συνήντησάν μοι μᾶλλον ἡμέραι κακῶν."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Ἡ κοιλία μου ἐξέζεσε καὶ οὐ σιωπήσεται, προέφθασάν με ἡμέραι πτωχείας."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Στένων πεπόρευμαι ἄνευ φιμοῦ, ἕστηκα δὲ ἐν ἐκκλησίᾳ κεκραγώς."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Ἀδελφὸς γέγονα σειρήνων, ἑταῖρος δὲ στρουθῶν."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Τὸ δὲ δέρμα μου ἐσκότωται μεγάλως, τὰ δὲ ὀστᾶ μου ἀπὸ καύματος."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "Ἀπέβη δὲ εἰς πένθος μου ἡ κιθάρα, ὁ δὲ ψαλμός μου εἰς κλαυθμὸν ἐμοί."
        ]
      }
    ],
