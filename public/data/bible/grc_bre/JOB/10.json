  "chapter": {
    "number": 10,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καμνὼν τῇ ψυχῇ μου, στένων ἐπαφήσω ἐπʼ αὐτὸν τὰ ῥήματα μου· λαλήσω πικρίᾳ ψυχῆς μου συνεχόμενος,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ ἐρῶ πρὸς Κύριον, μή με ἀσεβεῖν δίδασκε· καὶ διατί με οὕτως ἔκρινας;"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Ἢ καλόν σοι ἐὰν ἀδικήσω; ὅτι ἀπείπω ἔργα χειρῶν σου, βουλῇ δὲ ἀσεβῶν προσέσχες."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Ἢ ὥσπερ βροτὸς ὁρᾷ, καθορᾷς; ἢ καθὼς ὁρᾷ ἄνθρωπος, βλέψῃ;"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Ἢ ὁ βίος σου ἀνθρώπινός ἐστιν, ἢ τὰ ἔτη σου ἀνδρὸς,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ὅτι ἀνεζήτησας τὴν ἀνομίαν μου, καὶ τὰς ἁμαρτίας μου ἐξιχνίασας;"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Οἶδας γὰρ ὅτι οὐκ ἠσέβησα· ἀλλὰ τίς ἐστιν ὁ ἐκ τῶν χειρῶν σου ἐξαιρούμενος;"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Αἱ χεῖρές σου ἔπλασάν με καὶ ἐποίησάν με, μετὰ ταῦτα μεταβαλών με ἔπαισας."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Μνήσθητι, ὅτι πηλόν με ἔπλασας, εἰς δὲ γῆν με πάλιν ἀποστρέφεις."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Ἢ οὐχ ὥσπερ γάλα με ἤμελξας, ἐτύρωσας δέ με ἶσα τυρῷ;"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Δέρμα δὲ καὶ κρέας με ἐνέδυσας, ὀστέοις δὲ καὶ νεύροις με ἔνειρας."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ζωὴν δὲ καὶ ἔλεος ἔθου παρʼ ἐμοὶ, ἡ δὲ ἐπισκοπή σου ἐφυλαξέ μου τὸ πνεῦμα."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ταῦτα ἔχων ἐν σεαυτῷ, οἶδα ὅτι πάντα δύνασαι· ἀδυνατεῖ δέ σοι οὐθέν."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Ἐάν τε γὰρ ἁμάρτω, φυλάσσεις με, ἀπὸ δὲ ἀνομίας οὐκ ἀθῶόν με πεποίηκας."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Ἐάν τε γὰρ ἀσεβήσω, οἴμοι· ἐὰν δὲ ὦ δίκαιος, οὐ δύναμαι ἀνακύψαι, πλήρης γὰρ ἀτιμίας εἰμί."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Ἀγρεύομαι γὰρ ὥσπερ λέων εἰς σφαγήν· πάλιν γὰρ μεταβαλὼν δεινῶς με ὀλέκεις,"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ἐπανακαινίζων ἐπʼ ἐμὲ τὴν ἔτασίν μου· ὀργῇ δὲ μεγάλῃ μοι ἐχρήσω, ἐπήγαγες δὲ ἐπʼ ἐμὲ πειρατήρια."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Ἱνατί οὖν ἐκ κοιλίας με ἐξήγαγες, καὶ οὐκ ἀπέθανον, ὀφθαλμὸς δέ με οὐκ εἶδε,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "καὶ ὥσπερ οὐκ ὢν ἐγενόμην; διατί γὰρ ἐκ γαστρὸς εἰς μνῆμα οὐκ ἀπηλλάγην;"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Ἢ οὐκ ὀλίγος ἐστὶν ὁ βίος τοῦ χρόνου μου; ἔασόν με ἀναπαύσασθαι μικρὸν,"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "πρὸ τοῦ με πορευθῆναι ὅθεν οὐκ ἀναστρέψω, εἰς γῆν σκοτεινὴν καὶ γνοφερὰν,"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "εἰς γῆν σκότους αἰωνίου, οὗ οὐκ ἔστι φέγγος, οὐδὲ ὁρᾷν ζωὴν βροτῶν."
        ]
      }
    ],
