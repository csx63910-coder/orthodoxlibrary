  "chapter": {
    "number": 40,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ ἀπεκρίθη Κύριος ὁ Θεὸς τῷ Ἰὼβ, καὶ εἶπε,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "μὴ κρίσιν μετὰ ἱκανοῦ ἐκκλίνει; ἐλέγχων δὲ Θεὸν, ἀποκριθήσεται αὐτήν."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Ὑπολαβὼν δὲ Ἰὼβ λέγει τῷ Κυρίῳ,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "τί ἔτι ἐγὼ κρίνομαι, νουθετούμενος καὶ ἐλέγχων Κύριον, ἀκούων τοιαῦτα οὐθὲν ὤν; ἐγὼ δὲ τίνα ἀπόκρισιν δῶ πρὸς ταῦτα; χεῖρα θήσω ἐπὶ στόματί μου."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Ἅπαξ λελάληκα, ἐπὶ δὲ τῷ δευτέρῳ οὐ προσθήσω."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ἔτι δὲ ὑπολαβὼν ὁ Κύριος, εἶπε τῷ Ἰὼβ ἐκ τοῦ νέφους,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Μὴ, ἀλλὰ ζῶσαι ὥσπερ ἀνὴρ τὴν ὀσφύν σου, ἐρωτήσω δέ σε, σὺ δέ μοι ἀπόκριναι."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Μὴ ἀποποιοῦ μου τὸ κρίμα· οἴει δέ με ἄλλως σοι κεχρηματικέναι, ἢ ἳνα ἀναφανῇς δίκαιος;"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Ἢ βραχίων σοί ἐστι κατὰ τοῦ Κυρίου, ἢ φωνῇ κατʼ αὐτοῦ βροντᾷς;"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Ἀνάλαβε δὴ ὕψος καὶ δύναμιν, δόξαν δὲ καὶ τιμὴν ἀμφίασαι."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ἀπόστειλον δὲ ἀγγέλους ὀργῇ, πὰντα δὲ ὑβριστὴν ταπείνωσον."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ὑπερήφανον δὲ σβέσον, σῆψον δὲ ἀσεβεῖς παραχρῆμα."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Κρύψον δὲ εἰς γῆν ὁμοθυμαδόν, τὰ δὲ πρόσωπα αὐτῶν ἀτιμίας ἔμπλησον."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Ὁμολογήσω ὅτι δύναται ἡ δεξιά σου σῶσαι."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Ἀλλὰ δὴ ἰδοὺ θηρία παρὰ σοὶ, χόρτον ἶσα βουσὶν ἐσθίουσιν."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Ἰδοὺ δὴ ἡ ἰσχὺς αὐτοῦ ἐπʼ ὀσφύϊ, ἡ δὲ δύναμις αὐτοῦ ἐπʼ ὀμφαλοῦ γαστρός·"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Ἔστησεν οὐρὰν ὡς κυπάρισσον, τὰ δὲ νεῦρα αὐτοῦ συμπέπλεκται."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Αἱ πλευραὶ αὐτοῦ, πλευραὶ χάλκειαι, ἡ δὲ ῥάχις αὐτοῦ σίδηρος χυτός."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Τουτέστιν ἀρχὴ πλάσματος Κυρίου· πεποιημένον ἐγκαταπαίζεσθαι ὑπὸ τῶν ἀγγέλων αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Ἐπελθὼν δὲ ἐπʼ ὄρος ἀκρότομον, ἐποίησε χαρμονὴν τετράποσιν ἐν τῷ ταρτάρῳ."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Ὑπὸ παντοδαπὰ δένδρα κοιμᾶται, παρὰ πάπυρον καὶ κάλαμον καὶ βούτομον."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Σκιάζονται δὲ ἐν αὐτῷ δένδρα μεγάλα σὺν ῥαδάμνοις, καὶ κλῶνες ἀγροῦ."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Ἐὰν γένηται πλημμύρα, οὐ μὴ αἰσθηθῇ· πέποιθεν, ὅτι προσκρούσει ὁ Ἰορδάνης εἰς τὸ στόμα αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Ἐν τῷ ὀφθαλμῷ αὐτοῦ δέξεται αὐτόν, ἐνσκολιευόμενος τρήσει ῥῖνα."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Ἄξεις δὲ δράκοντα ἐν ἀγκίστρῳ, περιθήσεις δὲ φορβαίεαν περὶ ῥῖνα αὐτοῦ;"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Ἤ δήσεις κρίκον ἐν τῷ μυκτῆρι αὐτοῦ, ψελλίῳ δὲ τρυπήσεις τὸ χεῖλος αὐτοῦ;"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Λαλήσει δέ σοι δεήσει, ἱκετηρίᾳ μαλακῶς;"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Θήσεται δὲ μετὰ σοῦ διαθήκην; λήψῃ δὲ αὐτὸν δοῦλον αἰώνιον;"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Παίξῃ δὲ ἐν αὐτῷ ὥσπερ ὀρνέῳ; ἢ δήσεις αὐτὸν ὥσπερ στρουθίον παιδίῳ;"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Ἐνσιτοῦνται δὲ ἐν αὐτῷ ἔθνη, μεριτεύονται δὲ αὐτὸν Φοινίκων ἔθνη;"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "Πᾶν δὲ πλωτὸν συνελθὸν οὐ μὴ ἐνέγκωσι βύρσαν μίαν οὐρᾶς αὐτοῦ, καὶ ἐν πλοίοις ἁλιέων κεφαλὴν αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Ἐπιθήσεις δὲ αὐτῷ χεῖρα, μνησθεὶς πόλεμον τὸν γινόμενον ἐν στόματι αὐτοῦ, καὶ μηκέτι γινέσθω."
        ]
      }
    ],
