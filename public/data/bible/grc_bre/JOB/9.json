  "chapter": {
    "number": 9,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ὑπολαβὼν δὲ Ἰὼβ, λέγει,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Ἐπʼ ἀληθείας οἶδα, ὅτι οὕτως ἐστί· πῶς γὰρ ἔσται δίκαιος βροτὸς παρὰ Κυρίῳ;"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Ἐὰν γὰρ βούληται κριθῆναι αὐτῷ, οὐ μὴ ὑπακούσῃ αὐτῷ, ἵνα μὴ ἀντείπῃ πρὸς ἕνα λόγον αὐτοῦ ἐκ χιλίων."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Σοφὸς γάρ ἐστι διανοίᾳ, κραταιός τε καὶ μέγας· τίς σκληρὸς γενόμενος ἐναντίον αὐτοῦ ὑπέμεινεν;"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Ὁ παλαιῶν ὄρη καὶ οὐκ οἴδασιν, ὁ καταστρέφων αὐτὰ ὀργῇ·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ὁ σείων τὴν ὑπʼ οὐρανὸν ἐκ θεμελίων, οἱ δὲ στύλοι αὐτῆς σαλεύονται·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ὁ λέγων τῷ ἡλίῳ καὶ οὐκ ἀνατέλλει, κατὰ δὲ ἄστρων κατασφραγίζει·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Ὁ τανύσας τὸν οὐρανὸν μόνος, καὶ περιπατῶν ὡς ἐπʼ ἐδάφους ἐπὶ θαλάσσης·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Ὁ ποιῶν Πλειάδα καὶ Ἕσπερον καὶ Ἀρκτοῦρον, καὶ ταμεῖα Νότου·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Ὁ ποιῶν μεγάλα καὶ ἀνεξιχνίαστα, ἔνδοξά τε καὶ ἐξαίσια, ὧν οὐκ ἔστιν ἀριθμός."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ἐὰν ὑπερβῇ με, οὐ μὴ ἴδω· ἐὰν παρέλθῃ με, οὐδʼ ὡς ἔγνων."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ἐὰν ἀπαλλάξῃ, τίς ἀποστρέψει; ἢ τίς ἐρεῖ αὐτῷ, τί ἐποίησας;"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Αὐτὸς γὰρ ἀπέστραπται ὀργὴν, ὑπʼ αὐτοῦ ἐκάμφθησαν κήτη τὰ ὑπʼ οὐρανόν"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Ἐὰν δέ μου ὑπακούσεται, ἤ διακρίνει τὰ ῥήματά μου."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Ἐὰν γὰρ ὦ δίκαιος, οὐκ εἰσακούσεταί μου, τοῦ κρίματος αὐτοῦ δεηθήσομαι·"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Ἐάν τε καλέσω καὶ μὴ ὑπακούσῃ, οὐ πιστεύω ὅτι εἰσακήκοέ μου τῆς φωνῆς."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Μὴ γνόφῳ με ἐκτρίψῃ· πολλὰ δέ μου τὰ συντρίμματα πεποίηκε διακενῆς."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Οὐκ ἐᾷ γάρ με ἀναπνεῦσαι· ἐνέπλησε δέ με πικρίας,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ὅτι μὲν γὰρ ἰσχύει κράτει· τίς οὖν κρίματι αὐτοῦ ἀντιστήσεται;"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Ἐὰν γὰρ ὦ δίκαιος, τὸ στόμα μου ἀσεβήσει· ἐάν τε ᾧ ἄμεμπτος, σκολιὸς ἀποβήσομαι."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Εἴτε γὰρ ἠσέβησα, οὐκ οἶδα τῇ ψυχῇ, πλὴν ἀφαιρεῖταί μου ἡ ζωή."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Διὸ εἶπον, μέγαν καὶ δυνάστην ἀπολλύει ὀργή,"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ὅτι φαῦλοι ἐν θανάτῳ ἐξαισίῳ, ἀλλὰ δίκαιοι καταγελῶνται,"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "παραδέδονται γὰρ εἰς χεῖρας ἀσεβοῦς, πρόσωπα κριτῶν αὐτῆς συγκαλύπτει· εἰ δὲ μὴ αὐτός ἐστι, τίς ἐστιν;"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Ὁ δὲ βίος μου ἐστὶν ἐλαφρότερος δρομέως· ἀπέδρασαν, καὶ οὐκ εἴδοσαν."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Ἢ καὶ ἐστι ναυσὶν ἴχνος ὁδοῦ, ἢ ἀετοῦ πετομένου ζητοῦντος βοράν;"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Ἐάν τε γὰρ εἶπω, ἐπιλήσομαι λαλῶν, συγκύψας τῷ προσώπῳ στενάξω·"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Σείομαι πᾶσι τοῖς μέλεσιν, οἴδα γὰρ ὅτι οὐκ ἀθῶόν με ἐάσεις."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Ἐπειδὴ δέ εἰμι ἀσεβὴς, διὰ τί οὐκ ἀπέθανον;"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Ἐὰν γὰρ ἀπολούσωμαι χιόνι, καὶ ἀποκαθάρωμαι χερσὶ καθαραῖς,"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "ἱκανῶς ἐν ῥύπῳ με ἔβαψας, ἐβδελύξατο δέ με ἡ στολή."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Οὐ γὰρ εἰ ἄνθρωπος κατʼ ἐμὲ, ᾧ ἀντικρινοῦμαι, ἵνα ἔλθωμεν ὁμοθυμαδὸν εἰς κρίσιν."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "Εἴθε ἦν ὁ μεσίτης ἡμῶν, καὶ ἐλέγχων, καὶ διακούων ἀναμέσον ἀμφοτέρων."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "Ἀπαλλαξάτω ἀπʼ ἐμοῦ τὴν ῥάβδον, ὁ δὲ φόβος αὐτοῦ μή με στροβείτω,"
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "καὶ οὐ μὴ φοβηθῶ, ἀλλὰ λαλήσω· οὐ γὰρ οὕτω συνεπίσταμαι."
        ]
      }
    ],
