  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Δίκαιων δὲ ψυχαὶ ἐν χειρὶ Θεοῦ, καὶ οὐ μὴ ἅψηται αὐτῶν βάσανος."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Ἔδοξαν ἐν ὀφθαλμοῖς ἀφρόνων τεθνάναι,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ ἐλογίσθη κάκωσις ἡ ἔξοδος αὐτῶν, καὶ ἡ ἀφʼ ἡμῶν πορεία σύντριμμα· οἱ δὲ εἰσιν ἐν εἰρήνῃ·"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Καὶ γὰρ ἐν ὄψει ἀνθρώπων ἐὰν κολασθῶσιν, ἡ ἐλπὶς αὐτῶν ἀθανασίας πλήρης."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Καὶ ὀλίγα παιδευθέντες μεγάλα εὐεργετηθήσονται, ὅτι ὁ Θεὸς ἐπείρασεν αὐτοὺς, καὶ εὗρεν αὐτοὺς ἀξίους ἑαυτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ὡς χρυσὸν ἐν χωνευτηρίῳ ἐδοκίμασεν αὐτούς, καὶ ὡς ὁλοκάρπωμα θυσίας προσεδέξατο αὐτούς."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Καὶ ἐν καιρῷ ἐπισκοπῆς αὐτῶν ἀναλάμψουσι, καὶ ὡς σπινθῆρες ἐν καλάμῃ διαδραμοῦνται."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Κρινοῦσιν ἔθνη καὶ κρατήσουσι λαῶν, καὶ βασιλεύσει αὐτῶν Κύριος εἰς τοὺς αἰῶνας."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Οἱ πεποιθότες ἐπʼ αὐτῷ συνήσουσιν ἀλήθειαν, καὶ οἱ πιστοὶ ἐν ἀγάπῃ προσμενοῦσιν αὐτῷ, ὅτι χάρις καὶ ἔλεος τοῖς ἐκλεκτοῖς αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Οἱ δὲ ἀσεβεῖς καθὰ ἐλογίσαντο ἕξουσιν ἐπιτιμίαν, οἱ ἀμελήσαντες τοῦ δικαίου καὶ τοῦ Κυρίου ἀποστάντες."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Σοφίαν γὰρ καὶ παιδείαν ὁ ἐξουθενῶν ταλαίπωρος, καὶ κενὴ ἡ ἐλπὶς αὐτῶν, καὶ οἱ κόποι ἀνόνητοι, καὶ ἄχρηστα τὰ ἔργα αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Αἱ γυναῖκες αὐτῶν ἄφρονες, καὶ πονηρὰ τὰ τέκνα αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ἐπικατάρατος ἡ γένεσις αὐτῶν, ὅτι μακαρία στεῖρα ἡ ἀμίαντος, ἥτις οὐκ ἔγνω κοίτης ἐν παραπτώματι, ἕξει καρπὸν ἐν ἐπισκοπῇ ψυχῶν."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Καὶ εὐνοῦχος ὁ μὴ ἐργασάμενος ἐν χειρὶ ἀνόμημα, μηδὲ ἐνθυμηθεὶς κατὰ τοῦ Κυρίου πονηρά· δοθήσεται γὰρ αὐτῷ τῆς πίστεως χάρις ἐκλεκτὴ, καὶ κλῆρος ἐν ναῷ Κυρίου θυμηρέστερος·"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Ἀγαθῶν γὰρ πόνων καρπὸς εὐκλεὴς, καὶ ἀδιάπτωτος ἡ ῥίζα τῆς φρονήσεως."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Τέκνα δὲ μοιχῶν ἀτέλεστα ἔσται, καὶ ἐκ παρανόμου κοίτης σπέρμα ἀφανισθήσεται."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Ἐάν τε γὰρ μακρόβιοι γένωνται, εἰς οὐθὲν λογισθήσονται, καὶ ἄτιμον ἐπʼ ἐσχάτον τὸ γῆρας αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Ἐάν τε ὀξέως τελευτήσωσιν, οὐχ ἕχουσιν ἐλπίδα, οὐδὲ ἐν ἡμέρᾳ διαγνώσεως παραμύθιον·"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "γενεᾶς γὰρ ἀδίκου χαλεπὰ τὰ τέλη."
        ]
      }
    ],
