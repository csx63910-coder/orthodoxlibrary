  "chapter": {
    "number": 9,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἡ σοφία ᾠκοδόμησεν ἑαυτῇ οἶκον, καὶ ὑπήρεισε στύλους ἑπτά."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Ἔσφαξε τὰ ἑαυτῆς θύματα, ἐκέρασεν εἰς κρατῆρα τὸν ἑαυτῆς οἶνον, καὶ ἡτοιμάσατο τὴν ἑαυτῆς τράπεζαν."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Ἀπέστειλε τοὺς ἑαυτῆς δούλους, συγκαλοῦσα μετὰ ὑψηλοῦ κηρύγματος ἐπὶ κρατῆρα, λέγουσα,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Ὅς ἐστιν ἄφρων, ἐκκλινάτω πρὸς μέ· καὶ τοῖς ἐνδεέσι φρενῶν εἶπεν,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἔλθατε, φάγετε τῶν ἐμῶν ἄρτων, καὶ πίετε οἶνον ὃν ἐκέρασα ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ἀπολείπετε ἀφροσύνην, ἵνα εἰς τὸν αἰῶνα βασιλεύσητε· καὶ ζητήσατε φρόνησιν, καὶ κατορθώσατε ἐν γνώσει σύνεσιν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ὁ παιδεύων κακοὺς λήψεται ἑαυτῷ ἀτιμίαν· ἐλέγχων δὲ τὸν ἀσεβῆ μωμήσεται ἑαυτόν."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Μὴ ἔλεγχε κακοὺς, ἵνα μὴ μισήσωσί σε· ἔλεγχε σοφὸν, καὶ ἀγαπήσει σε."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Δίδου σοφῷ ἀφορμὴν, καὶ σοφώτερος ἔσται· γνώριζε δικαίῳ, καὶ προσθήσει τοῦ δέχεσθαι."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Ἀρχὴ σοφίας φόβος Κυρίου, καὶ βουλὴ ἁγίων σύνεσις·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "τὸ γὰρ γνῶναι νόμον, διανοίας ἐστὶν ἀγαθῆς."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Τούτῳ γὰρ τῷ τρόπῳ πολὺν ζήσεις χρόνον, καὶ προστεθήσεταί σοι ἔτη ζωῆς σου."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Υἱὲ ἐὰν σοφὸς γένῃ σεαυτῷ, σοφὸς ἔσῃ καὶ τοῖς πλησίον· ἐὰν δὲ κακὸς ἀποβῇς, μόνος ἂν ἀντλήσεις κακά·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ὃς ἐρείδεται ἐπὶ ψεύδεσιν, οὗτος ποιμαίνει ἀνέμους, ὁ δʼ αὐτὸς διώξεται ὄρνεα πετόμενα·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ἀπέλιπε γὰρ ὁδοὺς τοῦ ἑαυτοῦ ἀμπελῶνος, τοὺς δὲ ἄξονας τοῦ ἰδίου γεωργίου πεπλάνηται·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "διαπορεύεται δὲ διʼ ἀνύδρου ἐρήμου, καὶ γῆν διατεταγμένην ἐν διψώδεσι, συνάγει δὲ χερσὶν ἀκαρπίαν."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Γυνὴ ἄφρων καὶ θρασεῖα ἐνδεὴς ψωμοῦ γίνεται, ἣ οὐκ ἐπίσταται αἰσχύνην."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Ἐκάθισεν ἐπὶ θύραις τοῦ ἑαυτῆς οἴκου, ἐπὶ δίφρου ἐμφανῶς ἐν πλατείαις,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "προσκαλουμένη τοὺς παριόντας καὶ κατευθύνοντας ἐν ταῖς ὁδοῖς αὐτῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Ὅς ἐστιν ὑμῶν ἀφρονέστατος, ἐκκλινάτω πρὸς μέ· καὶ τοῖς ἐνδεέσι φρονήσεως παρακελεύομαι, λέγουσα,"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ἄρτων κρυφίων ἡδέως ἅψασθε, καὶ ὕδατος κλοπῆς γλυκεροῦ."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Ὁ δὲ οὐκ οἶδεν ὅτι γηγενεῖς παρʼ αὐτῇ ὄλλυνται, καὶ ἐπὶ πέταυρον ᾅδου συναντᾷ·"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ἀλλὰ ἀποπήδησον, μὴ χρονίσῃς ἐν τῷ τόπῳ, μηδὲ ἐπιστήσῃς τὸ σὸν ὄμμα πρὸς αὐτὴν,"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "οὕτως γὰρ διαβήσῃ ὕδωρ ἀλλότριον·"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ἀπὸ δὲ ὕδατος ἀλλοτρίου ἀπόσχου, καὶ ἀπὸ πηγῆς ἀλλοτρίας μὴ πίῃς"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ἵνα πολὺν ζησῃς χρόνον, προστεθῇ δέ σοι ἔτη ζωῆς."
        ]
      }
    ],
