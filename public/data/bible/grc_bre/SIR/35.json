  "chapter": {
    "number": 35,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἡγούμενων σε κατέστησαν; μὴ ἐπαίρου, γίνου ἐν αὐτοῖς ὡς εἷς ἐξ αὐτῶν· φρόντισον αὐτῶν, καὶ οὕτω κάθισον,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ πᾶσαν τὴν χρείαν σου ποιήσας ἀνάπεσε, ἵνα εὐφρανθῇς διʼ αὐτοὺς, καὶ εὐκοσμίας χάριν λάβῃς στέφανον."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Λάλησον πρεσβύτερε, πρέπει γάρ σοι, ἐν ἀκριβεῖ ἐπιστήμῃ, καὶ μὴ ἐμποδίσῃς μουσικά."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Ὅπου ἀκρόαμα, μὴ ἐκχέῃς λαλιὰν, καὶ ἀκαίρως μὴ σοφίζου."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Σφραγὶς ἄνθρακος ἐπὶ κόσμῳ χρυσῷ, σύγκριμα μουσικῶν ἐν συμποσίῳ οἴνου."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ἐν κατασκευάσματι χρυσῷ σφραγὶς σμαράγδου μέλος μουσικῶν ἐφʼ ἡδεῖ οἴνῳ."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Λάλησον νεανίσκε εἰ χρεία σου, μόλις δὶς ἐὰν ἐπερωτηθῇς."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Κεφαλαίωσον λόγον, ἐν ὀλίγοις πολλὰ, γίνου ὡς γινώσκων καὶ ἅμα σιωπῶν."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Ἐν μέσῳ μεγιστάνων μὴ ἐξισάζου, καὶ ἑτέρου λέγοντος μὴ πολλὰ ἀδολέσχει."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Πρὸ βροντῆς κατασπεύδει ἀστραπὴ, καὶ πρὸ αἰσχυντηροῦ προελεύσεται χάρις."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ἐν ὥρᾳ ἐξεγείρου καὶ μὴ οὐράγει, ἀπότρεχε εἰς οἶκον καὶ μὴ ῥαθύμει."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ἐκεῖ παῖζε καὶ ποίει τὰ ἐνθυμήματά σου, καὶ μὴ ἁμάρτῃς λόγῳ ὑπερηφάνῳ."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Καὶ ἐπὶ τούτοις εὐλόγησον τὸν ποιήσαντά σε, καὶ μεθύσκοντά σε ἀπὸ τῶν ἀγαθῶν αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Ὁ φοβούμενος Κύριον ἐκδέξεται παιδείαν, καὶ οἱ ὀρθρίζοντες εὑρήσουσιν εὐδοκίαν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Ὁ ζητῶν νόμον ἐμπλησθήσεται αὐτοῦ, καὶ ὁ ὑποκρινόμενος σκανδαλισθήσεται ἐν αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Οἱ φοβούμενοι Κύριον εὑρήσουσι κρίμα, καὶ δικαιώματα ὡς φῶς ἐξάψουσιν."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Ἄνθρωπος ἁμαρτωλὸς ἐκκλίνει ἐλεγμὸν, καὶ κατὰ τὸ θέλημα αὐτοῦ εὑρήσει σύγκριμα."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Ἀνὴρ βουλῆς οὐ μὴ παρίδῃ διανόημα, ἀλλότριος καὶ ὑπερήφανος οὐ καταπτήξει φόβον, καὶ μετὰ τὸ ποιῆσαι μετʼ αὐτοῦ ἄνευ βουλῆς."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Ἄνευ βουλῆς μηθὲν ποιήσῃς, καὶ ἐν τῷ ποιῆσαί σε μὴ μεταμελοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Ἐν ὁδῷ ἀντιπτώματος μὴ πορεύου, καὶ μὴ προσκόψῃς ἐν λιθώδεσι."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Μὴ πιστεύσῃς ἐν ὁδῷ ἀπροσκόπῳ,"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "καὶ ἀπὸ τῶν τέκνων σου φύλαξαι."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Ἐν παντὶ ἔργῳ πίστευε τῇ ψυχῇ σου, καὶ γὰρ τοῦτό ἐστι τήρησις ἐντολῶν."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Ὁ πιστεύων νόμῳ προσέχει ἐντολαῖς, καὶ ὁ πεποιθὼς Κυρίῳ οὐκ ἐλαττωθήσεται."
        ]
      }
    ],
