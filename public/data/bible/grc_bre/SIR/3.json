    "numberOfChapters": 51,
    "isApocryphal": true,
    "sha256": "c63407aebf5a6da631d418aac055f12871744e12933fa1d17bfa0c86fc6236aa",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_bre/SIR/1.json",
