  "chapter": {
    "number": 7,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἐπίστρεφε ἐπίστρεφε ἡ Σουναμίτις· ἐπίστρεφε ἐπίστρεφε, καὶ ὀφόμεθα ἐν σοί. Τί ὄψεσθε ἐν τῇ Σουναμίτιδι; ἡ ἐρχομένη ὡς χοροὶ τῶν παρεμβολῶν."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Ὡραιώθησαν διαβήματά σου ἐν ὑποδήμασί σου, θύγατερ ναδάβ· ῥυθμοὶ μηρῶν ὅμοιοι ὁρμίσκοις, ἔργον τεχνίτου."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Ὀμφαλός σου κρατὴρ τορευτὸς, μὴ ὑστερούμενος κράμα· κοιλία σου θημωνία σίτου πεφραγμένη ἐν κρίνοις."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Δύο μαστοί σου, ὡς δύο νεβροὶ δίδυμοι δορκάδος."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Ὁ τράχηλός σου ὡς πύργος ἐλεφάντινος· οἱ ὀφθαλμοί σου ὡς λίμναι ἐν Ἐσεβὼν, ἐν πύλαις θυγατρὸς πολλῶν· μυκτήρ σου, ὡς πύργος τοῦ Λιβάνου σκοπεύων πρόσωπον Δαμασκοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Κεφαλή σου ἐπὶ σὲ ὡς Κάρμηλος, καὶ πλόκιον κεφαλῆς σου ὡς πορφύρα· βασιλεὺς δεδεμένος ἐν παραδρομαῖς."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Τί ὡραιώθης, καὶ τί ἡδύνθης ἀγάπη;"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἐν τρυφαῖς σου τοῦτο μέγεθός σου· ὡμοιώθης τῷ φοίνικι, καὶ οἱ μαστοί σου τοῖς βότρυσιν."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Εἶπα, ἀναβήσομαι ἐπὶ τῷ φοίνικι, κρατήσω τῶν ὕψεων αὐτοῦ· καὶ ἔσονται δὴ μαστοί σου ὡς βότρυες τῆς ἀμπέλου, καὶ ὀσμὴ ῥινός σου ὡς μῆλα,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ ὁ λάρυγξ σου ὡς οἶνος ὁ ἀγαθὸς, πορευόμενος τῷ ἀδελφιδῷ μου εἰς εὐθύτητα, ἱκανούμενος χείλεσί μου καὶ ὀδοῦσιν."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ἐγὼ τῷ ἀδελφιδῷ μου, καὶ ἐπʼ ἐμὲ ἡ ἐπιστροφὴ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ἐλθὲ ἀδελφιδέ μου, ἐξέλθωμεν εἰς ἀγρὸν, αὐλισθῶμεν ἐν κώμαις."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ὀρθρίσωμεν εἰς ἀμπελῶνας· ἴδωμεν εἰ ἤνθησεν ἡ ἄμπελος, ἤνθησεν ὁ κυπρισμὸς, ἤνθησν αἱ ῥοαί· ἐκεῖ δώσω τοὺς μαστούς μου σοί."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Οἱ μανδραγόραι ἔδωκαν ὀσμήν· καὶ ἐπὶ θύραις ἡμῶν πάντα ἀκρόδρυα νέα πρὸς παλαιὰ, ἀδελφιδέ μου, ἐτήρησά σοι."
        ]
      }
    ],
