  "chapter": {
    "number": 6,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ποῦ ἀπῆλθεν ὁ ἀδελφιδός σου ἡ καλὴ ἐν γυναιξὶ; ποῦ ἀπέβλεψεν ὁ ἀδελφιδός σου; καὶ ζητήσομεν αὐτὸν μετὰ σοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Ἀδελφιδός μου κατέβη εἰς κῆπον αὐτοῦ εἰς φιάλας τοῦ ἀρώματος, ποιμαίνειν ἐν κήποις, καὶ συλλέγειν κρίνα."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Ἐγὼ τῷ ἀδελφιδῷ μου, καὶ ἀδελφιδός μου ἐμοί, ὁ ποιμαίνων ἐν τοῖς κρίνοις."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Καλὴ εἶ ἡ πλησίον μου, ὡς εὐδοκία, ὡραῖα ὡς Ἱερουσαλὴμ, θάμβος ὡς τεταγμέναι."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Ἀπόστρεψον ὀφθαλμούς σου ἀπεναντίον μου, ὅτι αὐτοὶ ἀνεπτέρωσάν με· τρίχωμά σου ὡς ἀγέλαι τῶν αἰγῶν, αἳ ἀνεφάνησαν ἀπὸ τοῦ Γαλαάδ."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ὀδόντες σου ὡς ἀγέλαι τῶν κεκαρμένων, αἳ ἀνέβησαν ἀπὸ τοῦ λουτροῦ, αἱ πᾶσαι διδυμεύουσαι, καὶ ἀτεκνοῦσα οὐκ ἔστιν ἐν αὐταῖς· ὡς σπαρτίον τὸ κόκκινον χείλη σου, καὶ ἡ λαλιά σου ὡραιᾶ."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ὡς λέπυρον ῥοᾶς μῆλόν σου ἐκτὸς τῆς σιωπήσεώς σου."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Ἑξήκοντά εἰσι βασίλισσαι καὶ ὀγδοήκοντα παλλακαὶ, καὶ νεάνιδες ὧν οὐκ ἔστιν ἀριθμός."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Μία ἐστὶ περιστερά μου, τελεία μου, μία ἐστὶ τῇ μητρὶ αὐτῆς, ἐκλεκτή ἐστι τῇ τεκούσῃ αὐτήν· Εἴδοσαν αὐτὴν θυγατέρες καὶ μακαριοῦσιν αὐτὴν, βασίλισσαι καί γε παλλακαὶ, καὶ αἰνέσουσιν αὐτήν."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Τίς αὕτη ἡ ἐκκύπτουσα ὡσεὶ ὄρθρος, καλὴ ὡς σελήνη, ἐκλεκτὴ ὡς ὁ ἥλιος, θάμβος ὡς τεταγμέναι;"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Εἰς κῆπον καρύας κατέβην ἰδεῖν ἐν γεννήμασι τοῦ χειμάῤῥου, ἰδεῖν εἰ ἤνθησεν ἡ ἄμπελος, ἐξήνθησαν αἱ ῥοαί·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ἐκεῖ δώσω τοὺς μαστούς μου σοί· οὐκ ἔγνω ἡ ψυχή μου· ἔθετο με ἅρματα Ἀμιναδάβ."
        ]
      }
    ],
