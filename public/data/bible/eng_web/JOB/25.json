  "chapter": {
    "number": 25,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Then Bildad the Shuhite answered,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "“Dominion and fear are with him.",
            "poem": 1
          },
          {
            "text": "He makes peace in his high places.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Can his armies be counted?",
            "poem": 1
          },
          {
            "text": "On whom does his light not arise?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "How then can man be just with God?",
            "poem": 1
          },
          {
            "text": "Or how can he who is born of a woman be clean?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Behold, even the moon has no brightness,",
            "poem": 1
          },
          {
            "text": "and the stars are not pure in his sight;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "How much less man, who is a worm,",
            "poem": 1
          },
          {
            "text": "and the son of man, who is a worm!”",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
