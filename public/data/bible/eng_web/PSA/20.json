  "chapter": {
    "number": 20,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "For the Chief Musician. A Psalm by David."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "May Yahweh answer you in the day of trouble.",
            "poem": 1
          },
          {
            "text": "May the name of the God of Jacob set you up on high,",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "send you help from the sanctuary,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "grant you support from Zion,",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "remember all your offerings,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "and accept your burned sacrifice. Selah.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "May he grant you your heart’s desire,",
            "poem": 1
          },
          {
            "text": "and fulfill all your counsel.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "We will triumph in your salvation.",
            "poem": 1
          },
          {
            "text": "In the name of our God, we will set up our banners.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "May Yahweh grant all your requests.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Now I know that Yahweh saves his anointed.",
            "poem": 1
          },
          {
            "text": "He will answer him from his holy heaven,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "with the saving strength of his right hand.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Some trust in chariots, and some in horses,",
            "poem": 1
          },
          {
            "text": "but we trust in the name of Yahweh our God.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "They are bowed down and fallen,",
            "poem": 1
          },
          {
            "text": "but we rise up, and stand upright.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Save, Yahweh!",
            "poem": 1
          },
          {
            "text": "Let the King answer us when we call!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
