  "chapter": {
    "number": 24,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "A Psalm by David."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "The earth is Yahweh’s, with its fullness;",
            "poem": 1
          },
          {
            "text": "the world, and those who dwell in it.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "For he has founded it on the seas,",
            "poem": 1
          },
          {
            "text": "and established it on the floods.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Who may ascend to Yahweh’s hill?",
            "poem": 1
          },
          {
            "text": "Who may stand in his holy place?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "He who has clean hands and a pure heart;",
            "poem": 1
          },
          {
            "text": "who has not lifted up his soul to falsehood,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "and has not sworn deceitfully.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "He shall receive a blessing from Yahweh,",
            "poem": 1
          },
          {
            "text": "righteousness from the God of his salvation.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "This is the generation of those who seek Him,",
            "poem": 1
          },
          {
            "text": "who seek your face—even Jacob. Selah.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Lift up your heads, you gates!",
            "poem": 1
          },
          {
            "text": "Be lifted up, you everlasting doors,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "and the King of glory will come in.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Who is the King of glory?",
            "poem": 1
          },
          {
            "text": "Yahweh strong and mighty,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Yahweh mighty in battle.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Lift up your heads, you gates;",
            "poem": 1
          },
          {
            "text": "yes, lift them up, you everlasting doors,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "and the King of glory will come in.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Who is this King of glory?",
            "poem": 1
          },
          {
            "text": "Yahweh of Armies is the King of glory! Selah.",
            "poem": 2
          }
        ]
      }
    ],
