  "chapter": {
    "number": 15,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "A Psalm by David."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Yahweh, who shall dwell in your sanctuary?",
            "poem": 1
          },
          {
            "text": "Who shall live on your holy hill?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "He who walks blamelessly and does what is right,",
            "poem": 1
          },
          {
            "text": "and speaks truth in his heart;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "he who doesn’t slander with his tongue,",
            "poem": 1
          },
          {
            "text": "nor does evil to his friend,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "nor casts slurs against his fellow man;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "in whose eyes a vile man is despised,",
            "poem": 1
          },
          {
            "text": "but who honors those who fear Yahweh;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "he who keeps an oath even when it hurts, and doesn’t change;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "he who doesn’t lend out his money for usury,",
            "poem": 1
          },
          {
            "text": "nor take a bribe against the innocent.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "He who does these things shall never be shaken.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
