  "chapter": {
    "number": 22,
    "content": [
      {
        "type": "heading",
        "content": [
          "Елифас"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Тада је Елифас из Темана узвратио овако:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Зар је човек од користи Богу?",
            "poem": 1
          },
          {
            "text": "Да ли му је мудрац од користи?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Зар се Свемоћни радује што си праведан?",
            "poem": 1
          },
          {
            "text": "Је ли му на корист кад путеве своје учиниш без мане?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Прекорева ли те за богобојазност твоју",
            "poem": 1
          },
          {
            "text": "и да ли се суди с тобом?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Није ли голема злоба твоја?",
            "poem": 1
          },
          {
            "text": "Зар нема краја кривицама твојим?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "А ти си браћи својој безразложно залог узимао,",
            "poem": 1
          },
          {
            "text": "и са њих си скидао хаљине.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Изнемоглог водом напојио ниси,",
            "poem": 1
          },
          {
            "text": "а ни гладном хлеба ниси дао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Јесте, ти си човек силан, земљопоседник си,",
            "poem": 1
          },
          {
            "text": "угледник што у њој живи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Тек, удовице си терао празних руку,",
            "poem": 1
          },
          {
            "text": "кршио си руке сирочади.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "И зато су око тебе замке,",
            "poem": 1
          },
          {
            "text": "ненадана страхота спопада те;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "или мрак, па не видиш ништа,",
            "poem": 1
          },
          {
            "text": "силна те је вода потопила.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Није ли Бог високо на небесима?",
            "poem": 1
          },
          {
            "text": "Погледај поврх звезда, како су високо!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "А ти питаш: ’Зна ли шта Бог?",
            "poem": 1
          },
          {
            "text": "Да ли суди кроз таму најгушћу?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Облаци су скровиште његово, па не види,",
            "poem": 1
          },
          {
            "text": "он корача по небеском своду.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Пута древног зар ћеш се држати,",
            "poem": 1
          },
          {
            "text": "оног што га утабаше људи покварени;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "они што су однешени кад им време није било,",
            "poem": 1
          },
          {
            "text": "када им је темеље потопила река?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Богу су они говорили: ’Прођи нас се!’",
            "poem": 1
          },
          {
            "text": "И: ’Шта ће Свемоћни да нам ради?’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "А он им је добрима куће препунио.",
            "poem": 1
          },
          {
            "text": "Зато је од мене подалеко савет зликоваца!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Видеће то праведници и радоваће се,",
            "poem": 1
          },
          {
            "text": "ругаће им се недужни:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "’Душмани ће наши баш збрисани бити,",
            "poem": 1
          },
          {
            "text": "обиље њихово прогутаће пламен!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Измири се с Богом, молим те,",
            "poem": 1
          },
          {
            "text": "и у миру буди, да на тебе добро дође.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Прихвати, молим те, поуку његових уста",
            "poem": 1
          },
          {
            "text": "и његове речи у срце своје стави.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Вратиш ли се Свемоћноме, обновљен ћеш бити;",
            "poem": 1
          },
          {
            "text": "уклониш ли безакоње из шатора свога,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "одбациш ли злато у прашину",
            "poem": 1
          },
          {
            "text": "и офирско злато по поточном камењу;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Свемоћни биће злато твоје,",
            "poem": 1
          },
          {
            "text": "најчистије сребро твоје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Тада ћеш се радовати Свемоћноме,",
            "poem": 1
          },
          {
            "text": "лице своје подигнућеш Богу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Молићеш се њему и он ће те чути,",
            "poem": 1
          },
          {
            "text": "извршићеш своје завете.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Остварићеш шта год да одлучиш,",
            "poem": 1
          },
          {
            "text": "светло ће ти стазе обасјати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Кад понизе људе, ти ћеш рећи:",
            "poem": 1
          },
          {
            "text": "’Узвисите их!’, и Бог ће тада да спасе скрушене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Он ће да избави и онога што недужан није,",
            "poem": 1
          },
          {
            "text": "због чистоће руку твојих избавиће њега.“",
            "poem": 2
          }
        ]
      }
    ],
