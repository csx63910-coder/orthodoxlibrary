  "chapter": {
    "number": 27,
    "content": [
      {
        "type": "heading",
        "content": [
          "Последње речи Јова пријатељима"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "А Јов је наставио своје казивање овим речима:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Живога ми Бога који ми је ускратио право",
            "poem": 1
          },
          {
            "text": "и Свемоћног што ми душу огорчи;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "док у мени даха има",
            "poem": 1
          },
          {
            "text": "и Божијег духа у мом носу;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "усне моје неће говорити неправду,",
            "poem": 1
          },
          {
            "text": "мој језик неће изустити обману.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Далеко од мене било да изјавим како сте у праву!",
            "poem": 1
          },
          {
            "text": "Док ме има не одустајем од своје честитости.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Држаћу се праведности своје, нећу је пустити;",
            "poem": 1
          },
          {
            "text": "све док живим савест моја ме запећи неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Душманин мој нека прође као покварењак,",
            "poem": 1
          },
          {
            "text": "као злотвор нека прође онај што се диже на ме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Јер каква је нада безбожника када је сасечен,",
            "poem": 1
          },
          {
            "text": "када Бог му душу узме?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Чује ли Бог вапај његов",
            "poem": 1
          },
          {
            "text": "кад на њега невоља дође?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Радује ли се Свемоћноме",
            "poem": 1
          },
          {
            "text": "и зове ли Бога у доба свако?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ја ћу вас поучити о Божијој руци,",
            "poem": 1
          },
          {
            "text": "нећу да вам кријем наум Свемоћнога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ето, сви ви сте видели ово,",
            "poem": 1
          },
          {
            "text": "па зашто онда улудо говорите бесмислице?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Таква је од Бога судбина за зликовца,",
            "poem": 1
          },
          {
            "text": "наследство Свемоћног што примају окрутни!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Макар и да му се деца рађају, за мач се рађају;",
            "poem": 1
          },
          {
            "text": "потомство му никад хлеба неће бити сито.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Преживеле ће му покопати зараза,",
            "poem": 1
          },
          {
            "text": "а удовице им закукати неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Макар да згрне сребра ко да је прашина,",
            "poem": 1
          },
          {
            "text": "и спреми одеће као да је земља;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "све што спреми обући ће праведник,",
            "poem": 1
          },
          {
            "text": "а сребро ће да раздели недужни.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Попут мољца кућу себи зида,",
            "poem": 1
          },
          {
            "text": "као да је колибица што је чувар прави.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Лећи ће богат тад и никад више,",
            "poem": 1
          },
          {
            "text": "кад очи своје отвори – ничег више нема.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Ненадане страхоте ко бујице односе га,",
            "poem": 1
          },
          {
            "text": "олуја га ноћу краде.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Подиже га ветар са истока, одлетеће,",
            "poem": 1
          },
          {
            "text": "свитлаће га са места његовог.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Сјуриће се на њега, штедети га неће",
            "poem": 1
          },
          {
            "text": "док он буде стрмоглавце бежао од руке његове.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "И пљескаће својим рукама над њим,",
            "poem": 1
          },
          {
            "text": "и звиждаће га са његовог места.",
            "poem": 2
          }
        ]
      }
    ],
