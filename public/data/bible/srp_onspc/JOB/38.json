    "name": "Књига о Јову",
    "commonName": "Књига о Јову",
    "title": "Књига о Јову",
    "order": 18,
    "numberOfChapters": 42,
    "sha256": "06b5a0909a72d6176f6b8d8ebef5ecc2bfb265f5829f37c46298f8075bdf4bb8",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/JOB/1.json",
    "lastChapterNumber": 42,
    "lastChapterApiLink": "/api/srp_onspc/JOB/42.json",
    "totalNumberOfVerses": 1070
  },
  "chapter": {
    "number": 38,
    "content": [
      {
        "type": "heading",
        "content": [
          "Господње беседе"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Тада је Господ узвратио Јову из вихора овим речима:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Ко је тај што мој савет",
            "poem": 1
          },
          {
            "text": "помрачује речима незнања?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Као мушко опаши слабине своје,",
            "poem": 1
          },
          {
            "text": "да те ја питам, а ти да ми одговараш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Где си ти био када сам полагао темеље земљи?",
            "poem": 1
          },
          {
            "text": "Кажи ако си паметан!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ко јој је одредио мере – ако то знаш –",
            "poem": 1
          },
          {
            "text": "ко је мерно уже над њом развукао?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "На чему су њене основе углављене?",
            "poem": 1
          },
          {
            "text": "Ко ли јој је поставио угаони камен",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "када су јутарње звезде певале сложно",
            "poem": 1
          },
          {
            "text": "и кад су клицали сви Божији синови",
            "poem": 2
          },
          {
            "noteId": 9
          },
          {
            "text": "?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ко је море затворио вратима",
            "poem": 1
          },
          {
            "text": "када је прокуљало и из утробе изашло;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "када сам му од облака хаљину скројио",
            "poem": 1
          },
          {
            "text": "и повоје од густога мрака;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "и побо му граничнике своје,",
            "poem": 1
          },
          {
            "text": "углавио решетку и врата;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "када сам му рекао:",
            "poem": 1
          },
          {
            "text": "’Долазићеш довде али не и даље,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "овде је међа обести таласа твојих!’?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Јеси ли за живота свога заповедао јутру",
            "poem": 1
          },
          {
            "text": "и казао зори где јој је место,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "да прихвати земљу за углове,",
            "poem": 1
          },
          {
            "text": "да с ње буду отресени злобни људи?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "А земља се обликује као глина под печатом,",
            "poem": 1
          },
          {
            "text": "па све на њој ко хаљина стоји.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Тада се од злобника узима светло њихово,",
            "poem": 1
          },
          {
            "text": "ломи им се рука уздигнута.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Да ли си ишао до извора мора?",
            "poem": 1
          },
          {
            "text": "Јеси ли ходао дубином бездана?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Да ли су ти показана врата смрти?",
            "poem": 1
          },
          {
            "text": "Јеси ли видео врата од најцрње таме?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Јеси ли сагледао земљина пространства?",
            "poem": 1
          },
          {
            "text": "Реци, ако знаш све то!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Који је пут до куће светла?",
            "poem": 1
          },
          {
            "text": "На ком се месту налази тама?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Зар можеш да их понесеш до њиховог места?",
            "poem": 1
          },
          {
            "text": "Знаш ли за стазе до њиховог стана?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Ма, ти то знаш, ти си се тада родио",
            "poem": 1
          },
          {
            "text": "и голем је број твојих дана!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Јеси ли био у ризницама снега?",
            "poem": 1
          },
          {
            "text": "Јеси ли видео оружарницу града",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "коју сам сачувао за време невоље,",
            "poem": 1
          },
          {
            "text": "за дан боја и војевања?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "У којем се смеру рачва муња",
            "poem": 1
          },
          {
            "text": "и где се источни ветар по земљи разноси?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Ко поплаву рачва на канале",
            "poem": 1
          },
          {
            "text": "и пут тутњави грома,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "да донесе кишу земљи без икога",
            "poem": 1
          },
          {
            "text": "и пустари без живе душе;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "да напоји пустош и пустињу",
            "poem": 1
          },
          {
            "text": "и учини да изникне трава?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Да ли киша оца има?",
            "poem": 1
          },
          {
            "text": "Капи росе ко је изродио?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Из чије се утробе лед родио",
            "poem": 1
          },
          {
            "text": "и иње с небеса ко је породио,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "кад ко камен воде се скамене,",
            "poem": 1
          },
          {
            "text": "површином следи се дубина?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Јеси ли ти свезао Влашиће ланцима?",
            "poem": 1
          },
          {
            "text": "Хоћеш ли да одрешиш Орион?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Можеш ли да на време изведеш сазвежђа",
            "poem": 1
          },
          {
            "text": "и поведеш Медведа са његовим медведићима?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Познајеш ли законе небеса",
            "poem": 1
          },
          {
            "text": "и постављаш ли њихова правила на земљи?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Зар ти можеш облацима да довикнеш,",
            "poem": 1
          },
          {
            "text": "па да те силним водама облију?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Можеш ли да пошаљеш муње,",
            "poem": 1
          },
          {
            "text": "да оне крену и кажу ти: ’Ту смо!’?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Ко је петлу дао мудрост",
            "poem": 1
          },
          {
            "text": "и ко је разуму знање дао?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Ко мудрошћу облаке броји",
            "poem": 1
          },
          {
            "text": "и ко их излива ко небеске мешине,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "да стврдне грумење земље",
            "poem": 1
          },
          {
            "text": "и згрудва бусење?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
