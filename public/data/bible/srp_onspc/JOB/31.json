  "book": {
    "id": "JOB",
    "translationId": "srp_onspc",
    "name": "Књига о Јову",
    "commonName": "Књига о Јову",
    "title": "Књига о Јову",
    "order": 18,
    "numberOfChapters": 42,
    "sha256": "06b5a0909a72d6176f6b8d8ebef5ecc2bfb265f5829f37c46298f8075bdf4bb8",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/JOB/1.json",
    "lastChapterNumber": 42,
    "lastChapterApiLink": "/api/srp_onspc/JOB/42.json",
    "totalNumberOfVerses": 1070
  },
  "chapter": {
    "number": 31,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Са очима својим савез сам склопио,",
            "poem": 1
          },
          {
            "text": "па како бих онда загледао девојку?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Па шта то онда Бог одозго дели?",
            "poem": 1
          },
          {
            "text": "Какво је са висина наследство Свемоћног?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Није ли то пропаст за злотвора",
            "poem": 1
          },
          {
            "text": "и несрећа за покварењака?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Не види ли он путеве моје,",
            "poem": 1
          },
          {
            "text": "зар не броји све моје кораке?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ако сам се дружио с лажовима,",
            "poem": 1
          },
          {
            "text": "ако ми је нога журила ка обмани;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "нека ме измери на тасовима тачним,",
            "poem": 1
          },
          {
            "text": "нек честитост моју Бог открије.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ако је мој корак зашао са пута,",
            "poem": 1
          },
          {
            "text": "срце моје повело се за мојим очима,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "за руке ми прионула љага;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "тад нек жањем, а други нек једе,",
            "poem": 1
          },
          {
            "text": "нек се моја летина почупа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ако ли је жена срце ми завела,",
            "poem": 1
          },
          {
            "text": "ако сам ближњег свога на улазу вребао;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "нек тад другом моја жена меље,",
            "poem": 1
          },
          {
            "text": "у постељи других нека буде.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Али то би била гадост,",
            "poem": 1
          },
          {
            "text": "баш кривица за осуду!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Да, била би то ватра која гута све до трулежи мртвих",
            "poem": 1
          },
          {
            "text": "и спаљује сву летину моју.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Елем, ако сам се оглушио на тужбу",
            "poem": 1
          },
          {
            "text": "слушкиње своје или слуге свога,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "када су се парничили са мном;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "шта бих урадио када би Бог устао,",
            "poem": 1
          },
          {
            "text": "кад би ми рачун затражио?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Шта ли бих му тада узвратио?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Није ли онај што ме саздао у утроби и њих саздао?",
            "poem": 1
          },
          {
            "text": "Зар нас није један исти начинио у стомаку?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ако сам се оглушио на жељу сиромаха",
            "poem": 1
          },
          {
            "text": "и расплакао очи удовици;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "ако сам свој залогај хлеба јео у самоћи,",
            "poem": 1
          },
          {
            "text": "а сироче није узело од њега –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "јер је уз мене расло као уз оца још од младости моје,",
            "poem": 1
          },
          {
            "text": "а удовици сам помагао још од како ме мајка родила –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "ако сам видео страдалника неодевеног,",
            "poem": 1
          },
          {
            "text": "ако нисам заоденуо убогог;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "ако ме бедра његова благосиљала нису,",
            "poem": 1
          },
          {
            "text": "ако се руном оваца мојих утоплио није;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "ако сам одмахнуо руком против сирочета,",
            "poem": 1
          },
          {
            "text": "а знао сам да на суду могу да помогнем;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "нека ми рука из рамена отпадне",
            "poem": 1
          },
          {
            "text": "и нек ми се шака преломи у зглобу!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Јер, дрхтао сам од Божије страхоте,",
            "poem": 1
          },
          {
            "text": "пред његовим величанством не бих то чинио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Ако сам се у злато уздао,",
            "poem": 1
          },
          {
            "text": "сувом злату говорио: ’Поуздање моје!’;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "ако сам се радовао свом великом благу,",
            "poem": 1
          },
          {
            "text": "што ми је рука толико згрнула;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "ако сам у сунце гледао док сија",
            "poem": 1
          },
          {
            "text": "и у месец сјајни док путује;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "ако ми се срце потајно заносило,",
            "poem": 1
          },
          {
            "text": "па сам им руком слао пољупце са својих уста;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "и то би била кривица што вапи за судом,",
            "poem": 1
          },
          {
            "text": "јер бих тако порекао Бога са висине!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Елем, ако сам се радовао над несрећом душманина мога,",
            "poem": 1
          },
          {
            "text": "ликовао кад га пропаст снађе;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "нисам дао устима да згреше,",
            "poem": 1
          },
          {
            "text": "да му клетву призивам на душу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Нису ли људи из шатора рекли:",
            "poem": 1
          },
          {
            "text": "’Ко се још меса његовога најео није?’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Придошлица на улици ноћ провео није,",
            "poem": 1
          },
          {
            "text": "путнику сам отварао врата.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Да ли сам грехе своје прикривао као Адам,",
            "poem": 1
          },
          {
            "text": "и кривицу крио у грудима својим;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "јер сам се препао великог мноштва,",
            "poem": 1
          },
          {
            "text": "страховао од презира у роду,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "па се ућутао и кроз врата не бих излазио?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "О, кад би ме неко чуо!",
            "poem": 1
          },
          {
            "text": "Ево, ово потписујем,",
            "poem": 2
          },
          {
            "text": "па нека ме услиши Свемоћни,",
            "poem": 1
          },
          {
            "text": "а ево и оптужнице што је тужилац против мене подигао!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Зар је не бих ја понео на рамену своме,",
            "poem": 1
          },
          {
            "text": "на себе је као круну причврстио?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Рачун бих му положио за кораке своје,",
            "poem": 1
          },
          {
            "text": "као владар бих му приступио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "Ако је због мене вапила земља моја",
            "poem": 1
          },
          {
            "text": "и у глас плакале бразде њене;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          {
            "text": "ако сам забадава јео плодове њене",
            "poem": 1
          },
          {
            "text": "и души њихових власника задао јаде;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          {
            "text": "уместо пшеницом нек уроди трњем",
            "poem": 1
          },
          {
            "text": "и коровом уместо јечма!“",
            "poem": 2
          },
          "Јов је завршио своја казивања."
        ]
      }
    ],
