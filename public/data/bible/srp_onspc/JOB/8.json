  "chapter": {
    "number": 8,
    "content": [
      {
        "type": "heading",
        "content": [
          "Вилдад"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "А Вилдад из Суша је одговорио овим речима:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Докле ћеш о томе да причаш",
            "poem": 1
          },
          {
            "text": "и докле ће речи твојих уста бити вихор?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Зар Бог изврће правду?",
            "poem": 1
          },
          {
            "text": "Изврће ли Свемоћни праведност?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ако су му твоја деца сагрешила,",
            "poem": 1
          },
          {
            "text": "он их је препустио њиховим гресима!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Али ако потражиш Бога",
            "poem": 1
          },
          {
            "text": "и Свемоћнога преклињеш за милост;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "ако будеш чист и праведан,",
            "poem": 1
          },
          {
            "text": "он ће бдети над тобом",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и обновиће твоје праведно боравиште.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Незнатни су били почеци твоји,",
            "poem": 1
          },
          {
            "text": "а будућност твоја процветаће силно.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Хајде, питај нараштај пређашњи",
            "poem": 1
          },
          {
            "text": "и истражи сазнања њихових предака.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Јер, ми смо од јуче, не знамо ништа,",
            "poem": 1
          },
          {
            "text": "сена су наши земаљски дани.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Зар те неће поучити,",
            "poem": 1
          },
          {
            "text": "рећи ти из срца свога и изнети поуке?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Расте ли папирус мимо мочваре?",
            "poem": 1
          },
          {
            "text": "Расте ли трска мимо вода?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Док је још у цвату и непосечена,",
            "poem": 1
          },
          {
            "text": "већ се суши пре осталих трава.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Е, такве су стазе оних што Бога заборављају,",
            "poem": 1
          },
          {
            "text": "тако се руши нада безбожничка;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "онога чије се поуздање кида",
            "poem": 1
          },
          {
            "text": "и који се ослања на кућу од паучине;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Елем, ослони ли се на кућу своју –",
            "poem": 1
          },
          {
            "text": "неће стајати;",
            "poem": 2
          },
          {
            "text": "прихвати ли је се –",
            "poem": 1
          },
          {
            "text": "неће се држати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Он је као једра биљка на сунцу,",
            "poem": 1
          },
          {
            "text": "чије се младице пружају изван врта;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "корење му се над камењарем преплиће",
            "poem": 1
          },
          {
            "text": "и у кршу тражи места.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Али, ако се искорени са свог места,",
            "poem": 1
          },
          {
            "text": "оно ће га се одрећи: ’Видело те никад нисам!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ето, то ти је радост његовог пута,",
            "poem": 1
          },
          {
            "text": "а већ неко други ниче из тла.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Гле, Бог не одбацује човека без мане,",
            "poem": 1
          },
          {
            "text": "али и не прихвата злотвора за руку.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Штавише, смехом ће испунити уста твоја",
            "poem": 1
          },
          {
            "text": "и усне твоје клицањем!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Стидом ће се загрнути они који те мрзе,",
            "poem": 1
          },
          {
            "text": "а шатор зликоваца ће нестати.“",
            "poem": 2
          }
        ]
      }
    ],
