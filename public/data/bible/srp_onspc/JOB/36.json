  "chapter": {
    "number": 36,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Елијуј је наставио овим речима:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Стрпи се мало да ти објасним,",
            "poem": 1
          },
          {
            "text": "још бих да ти нешто кажем о Богу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Знање ћу своје нашироко да изнесем,",
            "poem": 1
          },
          {
            "text": "зарад Саздатеља свога",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "праведност ћу да објасним.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Стварно нема неистине у речима мојим,",
            "poem": 1
          },
          {
            "text": "пред тобом је човек беспрекорног знања.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Гле! Бог је силан, не презире никог.",
            "poem": 1
          },
          {
            "text": "Он је силан, у науму велик!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Он злотвора не оставља живог,",
            "poem": 1
          },
          {
            "text": "ојађеним удељује правду.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Са праведног свој поглед не скида,",
            "poem": 1
          },
          {
            "text": "с царевима навек на престо их поставља",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и они се уздижу високо.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ако су и ланцима оковани",
            "poem": 1
          },
          {
            "text": "и свезани конопцима јада,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "он им јавља шта су урадили,",
            "poem": 1
          },
          {
            "text": "о преступима којим се бахате.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Он им ухо за прекор отвара,",
            "poem": 1
          },
          {
            "text": "позива их да се греха клоне.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Буду ли га чули и њему служили,",
            "poem": 1
          },
          {
            "text": "у напретку дане своје проживеће",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и године своје у милини.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "А ако не послушају,",
            "poem": 1
          },
          {
            "text": "мач ће их сасећи;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ишчезнуће без икаквог знања.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Гнев навлаче људи срца безбожнога,",
            "poem": 1
          },
          {
            "text": "чак и за помоћ не преклињу кад их он везује.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Док су млади душа им умире,",
            "poem": 1
          },
          {
            "text": "скончавају међу храмским блудницима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Невољника он невољом спасава",
            "poem": 1
          },
          {
            "text": "и ухо му тлачењем отвара.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "И тебе ће ишчупати из раља невоље на пространо место;",
            "poem": 1
          },
          {
            "text": "на место где зебње нема,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "где је прострт сто крцат изобиљем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Али ти кипиш судом за злобнике,",
            "poem": 1
          },
          {
            "text": "обузет си и судом и правдом!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Пази да те нико богатством не мами,",
            "poem": 1
          },
          {
            "text": "не дај да те заведе големи откуп.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Хоће ли те из невоље избавити благо твоје",
            "poem": 1
          },
          {
            "text": "и сав труд снаге твоје?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Не жуди за ноћи",
            "poem": 1
          },
          {
            "text": "када људе узимају из њихових кућа.",
            "poem": 2
          },
          {
            "noteId": 8
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Чувај се, злу се не приклањај,",
            "poem": 1
          },
          {
            "text": "јер то си и одабрао рађе него муку.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Гле! Узвишен је Господ у сили својој!",
            "poem": 1
          },
          {
            "text": "Попут њега учитељ ко ли је?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Ко ли му је пут његов наменио?",
            "poem": 1
          },
          {
            "text": "Каже ли му ико: ’Лоше си чинио’?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Имај на уму да његово величаш дело",
            "poem": 1
          },
          {
            "text": "о коме певају људи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Сав га је људски род видео,",
            "poem": 1
          },
          {
            "text": "мотре га људи издалека.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Јесте, узвишен је Бог, нама несазнатљив",
            "poem": 1
          },
          {
            "text": "и број година његових нам је недокучив!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Јер он подиже капи воде",
            "poem": 1
          },
          {
            "text": "што из кише маглом росе,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "па људима обилно",
            "poem": 1
          },
          {
            "text": "из облака пљуште.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Ко још разуме како се ваља облак",
            "poem": 1
          },
          {
            "text": "и како грми из куће његове?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Ено, око себе он простире муњу своју",
            "poem": 1
          },
          {
            "text": "и покрива дубине мора!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Он тиме влада народима",
            "poem": 1
          },
          {
            "text": "и даје обиље хране.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Муњама пуни руке",
            "poem": 1
          },
          {
            "text": "па им нареди где ће да ударе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Грмљавина њихова га најављује,",
            "poem": 1
          },
          {
            "text": "али и стока када олуја стиже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
    "footnotes": [
      {
        "noteId": 8,
        "caller": "+",
        "text": "36,20 Или: када народе одводе са свог места.",
        "reference": {
          "chapter": 36,
          "verse": 20
        }
      }
    ]
