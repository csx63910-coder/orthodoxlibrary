  "chapter": {
    "number": 20,
    "content": [
      {
        "type": "heading",
        "content": [
          "Софар"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "А Софар из Намата је одговорио овим речима:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Ако је тако, немирне ме мисли моје терају да одговорим,",
            "poem": 1
          },
          {
            "text": "јер у мени ври.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Увређен сам прекором који сам чуо,",
            "poem": 1
          },
          {
            "text": "па сад узвраћам у духу мог разумевања.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Елем, знаш ли да је тако од давнина,",
            "poem": 1
          },
          {
            "text": "од како је људски род на земљу стављен:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "прекратка је радост зликоваца",
            "poem": 1
          },
          {
            "text": "и за часак срећа безбожника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Све и да се стасом дигне до небеса,",
            "poem": 1
          },
          {
            "text": "да му глава облаке досегне,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "исхлапиће довека ко сопствени измет,",
            "poem": 1
          },
          {
            "text": "и питаће: ’Где је?’, они што су га виђали.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Попут сна ће испарити и неће га наћи,",
            "poem": 1
          },
          {
            "text": "прогнаће га као ноћно привиђење.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Око које га је гледало видети га више неће;",
            "poem": 1
          },
          {
            "text": "завичај га његов више неће видети.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Његови ће се синови додворавати сиромасима,",
            "poem": 1
          },
          {
            "text": "а он ће рукама својим враћати од богатства свога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Кости су му пуне младалачке снаге",
            "poem": 1
          },
          {
            "text": "која ће са њиме у прах лећи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Нека му је и слатко зло у устима његовим,",
            "poem": 1
          },
          {
            "text": "што га скрива под језиком својим;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "нека га штеди, нека га не пушта,",
            "poem": 1
          },
          {
            "text": "нека га под непцем растапа;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "та његова храна у цревима,",
            "poem": 1
          },
          {
            "text": "у утроби његовој ће се претворити у отров кобре.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Повратиће из стомака свога благо прогутано,",
            "poem": 1
          },
          {
            "text": "Бог ће му га избацити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Отров кобри сиса,",
            "poem": 1
          },
          {
            "text": "убиће га језик отровнице.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "У потоке гледати неће,",
            "poem": 1
          },
          {
            "text": "у брзаке река од меда и масла.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Вратиће шта је отео, неће моћи то да прогута;",
            "poem": 1
          },
          {
            "text": "уживати неће добра своје трговине.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Јер је тлачио и запостављао сиромахе,",
            "poem": 1
          },
          {
            "text": "харао је кућу коју зидао није.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Његов стомак не зна шта је доста,",
            "poem": 1
          },
          {
            "text": "спокоја му нема у ономе за чим жуди.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Неће имати шта више да прождере",
            "poem": 1
          },
          {
            "text": "и зато му имање неће потрајати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "И када буде пун обиља биће у невољи,",
            "poem": 1
          },
          {
            "text": "стићи ће га рука сваког страдалника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Али док буде пунио стомак свој,",
            "poem": 1
          },
          {
            "text": "Бог ће му послати пламен гнева свога,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "као кишу на црева његова.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "И док бежи од гвозденог оружја,",
            "poem": 1
          },
          {
            "text": "пробошће га стрела лука бронзанога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Када је извуче,",
            "poem": 1
          },
          {
            "text": "када му изађе из леђа",
            "poem": 2
          },
          {
            "text": "и ко муња из жучи његове,",
            "poem": 1
          },
          {
            "text": "доћи ће на њега ужас.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Сва је тама сачувана за његово благо,",
            "poem": 1
          },
          {
            "text": "прождраће га пламен нераспирен,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "зло нанеће преживелом шатора његовог.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Небеса ће разоткрити његову кривицу,",
            "poem": 1
          },
          {
            "text": "земља ће се подићи на њега.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Поплављена биће летина куће његове,",
            "poem": 1
          },
          {
            "text": "отплављена у дан Божијега гнева.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Таква је од Бога судбина за зликовца,",
            "poem": 1
          },
          {
            "text": "богомдано му наследство.“",
            "poem": 2
          }
        ]
      }
    ],
