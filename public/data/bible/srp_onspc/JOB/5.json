  "book": {
    "id": "JOB",
    "translationId": "srp_onspc",
    "name": "Књига о Јову",
    "commonName": "Књига о Јову",
    "title": "Књига о Јову",
    "order": 18,
    "numberOfChapters": 42,
    "sha256": "06b5a0909a72d6176f6b8d8ebef5ecc2bfb265f5829f37c46298f8075bdf4bb8",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/JOB/1.json",
    "lastChapterNumber": 42,
    "lastChapterApiLink": "/api/srp_onspc/JOB/42.json",
    "totalNumberOfVerses": 1070
  },
  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Хајде, позивај! Ко ће ти се одазвати?",
            "poem": 1
          },
          {
            "text": "Коме од светих ћеш да се окренеш?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Безумника убија безумље,",
            "poem": 1
          },
          {
            "text": "а лаковерног сатире завист.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Лично сам видео безумника како се одомаћује",
            "poem": 1
          },
          {
            "text": "и одмах сам проклео његово газдинство.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Јер, деца су му далеко од сигурности,",
            "poem": 1
          },
          {
            "text": "гину на вратима, а нема ко да их избави.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Летину његову једе ко је гладан,",
            "poem": 1
          },
          {
            "text": "купи је чак и испод трња,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "док жедан вреба на њихово благо.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Јер штета не излази из прашине",
            "poem": 1
          },
          {
            "text": "и из земље не ниче невоља;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "већ се човек рађа за невољу",
            "poem": 1
          },
          {
            "text": "ко што у вис врцају варнице.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Али ја бих да Бога тражим",
            "poem": 1
          },
          {
            "text": "и Богу свој случај да изнесем;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "њему, што велике ствари чини,",
            "poem": 1
          },
          {
            "text": "неистраживо мноштво чудеса његових;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "њему, који даје кишу земљи",
            "poem": 1
          },
          {
            "text": "и који шаље воду пољима;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "њему, који понижене на висину ставља",
            "poem": 1
          },
          {
            "text": "и жалосне на сигурно диже;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "њему, који мрси науме лукавих",
            "poem": 1
          },
          {
            "text": "и не даје да им руке с успехом послују.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Бог надмудрује мудре њиховим лукавством,",
            "poem": 1
          },
          {
            "text": "суновраћује савет препредених",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "који усред дана помрчину срећу",
            "poem": 1
          },
          {
            "text": "и у подне пипају ко ноћу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Да, Бог спасава од мача из њихових уста",
            "poem": 1
          },
          {
            "text": "и сиромаха из руку јакога!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Тад убоги задобија наду,",
            "poem": 1
          },
          {
            "text": "а неправда затвара уста своја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "О, како је благословен човек кога Бог прекорева!",
            "poem": 1
          },
          {
            "text": "Зато не презири опомену Свемоћнога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Јер он и рани и завије;",
            "poem": 1
          },
          {
            "text": "он удара, али руке његове лече.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Од шест ће те невоља спасти,",
            "poem": 1
          },
          {
            "text": "а и у седмој зло те се неће дотаћи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "У глади ће те спасти, од смрти",
            "poem": 1
          },
          {
            "text": "и од снаге мача у рату.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Сакривен ћеш бити од шибе језика",
            "poem": 1
          },
          {
            "text": "и нећеш стрепети од пропасти кад стигне.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Смејаћеш се разарању и глади",
            "poem": 1
          },
          {
            "text": "и нећеш стрепети од земаљских звери,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "јер ћеш бити у савезу с камењем по пољу",
            "poem": 1
          },
          {
            "text": "и земаљске ће звери бити у миру са тобом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Видећеш да си сигуран у шатору своме,",
            "poem": 1
          },
          {
            "text": "обилазићеш имање своје и ништа му зафалити неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Видећеш да ће ти деца бити бројна,",
            "poem": 1
          },
          {
            "text": "да је твојих наследника као траве по земљи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Једар ћеш отићи у гроб,",
            "poem": 1
          },
          {
            "text": "као што се у право време сакупља сноп жита.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Ето, то смо проучили. То је тако.",
            "poem": 1
          },
          {
            "text": "А ти си чуо, па примени то на себе!“",
            "poem": 2
          }
        ]
      }
    ],
