  "chapter": {
    "number": 35,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "И још је казао Елијуј:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Мислиш ли да је исправно то што си рекао:",
            "poem": 1
          },
          {
            "text": "’Праведан сам ја пред Богом’?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Да, рекао си: ’Какву ти",
            "poem": 1
          },
          {
            "noteId": 6
          },
          {
            "text": "корист имаш?",
            "poem": 1
          },
          {
            "text": "Шта ми вреди то што не грешим?’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ево ја, ја ћу да одговорим и теби",
            "poem": 1
          },
          {
            "text": "и твојим пријатељима што су са тобом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "У небеса гледај и видећеш;",
            "poem": 1
          },
          {
            "text": "посматрај облаке, како су само виши од тебе!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ако си грешио, шта си њему учинио?",
            "poem": 1
          },
          {
            "text": "Ако је твојих преступа много,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јеси ли њему урадио нешто?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ако си праведан, јеси ли му нешто дао?",
            "poem": 1
          },
          {
            "text": "Да није примио нешто из твоје руке?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Поквареност твоја шкоди оном попут тебе,",
            "poem": 1
          },
          {
            "text": "а праведност твоја користи потомку човека.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Због силнога тлачења вапе људи,",
            "poem": 1
          },
          {
            "text": "преклињу за помоћ због руке силника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "И нико не пита: ’А где је Бог, Саздатељ мој,",
            "poem": 1
          },
          {
            "text": "који у ноћи песме даје;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "који нас поучава више него земаљске звери",
            "poem": 1
          },
          {
            "text": "и мудрим нас чини више него небеске птице?’",
            "poem": 2
          },
          {
            "noteId": 7
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Онда они запомажу, а он се не одазива",
            "poem": 1
          },
          {
            "text": "због поноса злобника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Бог зацело таштину не слуша,",
            "poem": 1
          },
          {
            "text": "Свемоћни и не гледа на њу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "А колико тек кад кажеш",
            "poem": 1
          },
          {
            "text": "како га не видиш,",
            "poem": 2
          },
          {
            "text": "како је твој случај пред њим,",
            "poem": 1
          },
          {
            "text": "како њега ишчекујеш;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "како гнев његов не кажњава",
            "poem": 1
          },
          {
            "text": "и како за грех и не мари!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Елем, узалудно Јов уста отвара",
            "poem": 1
          },
          {
            "text": "и гомила безначајне речи.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 6,
        "caller": "+",
        "text": "35,3 Јов пита Бога.",
        "reference": {
          "chapter": 35,
          "verse": 3
        }
      },
      {
        "noteId": 7,
        "caller": "+",
        "text": "35,11 У духу Јов 12,7-8овај стих може да се преведе и као: који нас поучава кроз земаљске звери и чини мудрим кроз небеске птице.",
