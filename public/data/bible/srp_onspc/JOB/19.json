  "chapter": {
    "number": 19,
    "content": [
      {
        "type": "heading",
        "content": [
          "Јов"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "А Јов је одговорио овим речима:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Докле ћете да кињите душу моју",
            "poem": 1
          },
          {
            "text": "и речима ме ломите?!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Па већ сте ме десет пута понизили!",
            "poem": 1
          },
          {
            "text": "Не стидите ли се што ми тако пакостите?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Све и да сам стварно погрешио,",
            "poem": 1
          },
          {
            "text": "моја грешка је само моја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ако бисте стварно да се нада мном уздижете",
            "poem": 1
          },
          {
            "text": "и да ме убеђујете у ругло моје,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "знајте онда да ме је Бог ојадио,",
            "poem": 1
          },
          {
            "text": "својом ме је мрежом обмотао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ето, ја вичем: ’Насиље!’, а услишен нисам;",
            "poem": 1
          },
          {
            "text": "ја за помоћ запомажем, али правде нема.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Мој пут он је заградио, не могу да прођем;",
            "poem": 1
          },
          {
            "text": "стазе моје он је замрачио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Част је моју свукао са мене,",
            "poem": 1
          },
          {
            "text": "скинуо ми круну с главе моје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Са свих страна сваљује ме да нестанем,",
            "poem": 1
          },
          {
            "text": "изваљује као дрво наду моју.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ужарио се гнев његов на мене,",
            "poem": 1
          },
          {
            "text": "па ме сматра душманином својим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Сложно марширају његове чете,",
            "poem": 1
          },
          {
            "text": "ено, наспрам мене насип подижу;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "око мог шатора логор дижу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Далеко од мене он је одвео браћу моју,",
            "poem": 1
          },
          {
            "text": "а моји знанци су ми сада ко потпуни странци.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Мојих рођака више нема,",
            "poem": 1
          },
          {
            "text": "заборавили су ме познаници моји.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Гости мога дома и слушкиње моје гледају ме ко туђинца,",
            "poem": 1
          },
          {
            "text": "за њихове очи ја сам придошлица.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Слугу свога ја дозивам, ал’ ми се не јавља,",
            "poem": 1
          },
          {
            "text": "устима га својим преклињем за помоћ.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Жена ми се гади од задаха мога,",
            "poem": 1
          },
          {
            "text": "одуран сам и родбини својој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Чак ме и дечаци презиру,",
            "poem": 1
          },
          {
            "text": "ругају ми се кад бих да устанем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Гаде ме се сви пријатељи блиски,",
            "poem": 1
          },
          {
            "text": "они које сам волео, сад су против мене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Кожа ми се слепила за кости,",
            "poem": 1
          },
          {
            "text": "зуби су ми поиспадали.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Смилујте ми се! Смилујте ми се,",
            "poem": 1
          },
          {
            "text": "о, пријатељи моји,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер је рука Божија ударила на ме!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Па зашто ме попут Бога прогоните,",
            "poem": 1
          },
          {
            "text": "меса мога зар нисте сити?",
            "poem": 2
          },
          {
            "noteId": 5
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "О, када би се речи моје записале!",
            "poem": 1
          },
          {
            "text": "О, када би се у књигу утиснуле;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "гвозденим пером и оловом",
            "poem": 1
          },
          {
            "text": "заувек у камен урезале!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Али ја знам да Откупитељ мој живи,",
            "poem": 1
          },
          {
            "text": "да ће на крају он стати над прахом!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Нека и пукне ова моја кожа,",
            "poem": 1
          },
          {
            "text": "гледаћу Бога из тела свога;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "њега ћу ја лично гледати,",
            "poem": 1
          },
          {
            "text": "очима својим, а не ко туђинац.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "А нутрина моја у мени малакше.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "А ви би требало да кажете: ’Зашто га прогонимо?’,",
            "poem": 1
          },
          {
            "text": "јер налазите да је у мени корен ове ствари.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Од мача страхујте,",
            "poem": 1
          },
          {
            "text": "јер гнев доноси одмазду мача,",
            "poem": 2
          },
          {
            "text": "да бисте знали –",
            "poem": 1
          },
          {
            "text": "суд постоји.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 5,
        "caller": "+",
        "text": "19,22 Идиом јести нечије месо према арамејском, арапском и акадском значи оптуживати (Дан 3,8), па овај део стиха може да се преведе и као: нисте ли ме довољно оптужили?",
        "reference": {
          "chapter": 19,
          "verse": 22
        }
      }
    ]
