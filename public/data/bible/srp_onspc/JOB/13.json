  "chapter": {
    "number": 13,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ето, око је моје све видело,",
            "poem": 1
          },
          {
            "text": "ухо је моје чуло и то разабрало.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "И ја имам знање попут вашег",
            "poem": 1
          },
          {
            "text": "и нисам од вас гори.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Па ипак бих Свемоћном да говорим,",
            "poem": 1
          },
          {
            "text": "са Богом бих да се правдам.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Али ви смишљате неистине",
            "poem": 1
          },
          {
            "text": "и сви сте бескорисни лекари!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Када бисте сасвим заћутали",
            "poem": 1
          },
          {
            "text": "можда бисте и мудри постали!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ја вас молим, саслушајте моје оправдање",
            "poem": 1
          },
          {
            "text": "и тврдњама мојих уста пажњу поклоните.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Па зар ћете Бога бранити неправдом,",
            "poem": 1
          },
          {
            "text": "сведочити ради њега обману?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Зар ћете га пристрасно заступати?",
            "poem": 1
          },
          {
            "text": "За Бога ћете случај да водите?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Добро ли ће бити кад вас он испита?",
            "poem": 1
          },
          {
            "text": "Зар ћете га преварити ко што неко вара човека?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "А он ће вас свакако прекорити,",
            "poem": 1
          },
          {
            "text": "све и да потајно будете пристрасни.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Зар вас неће преплашити величанство његово?",
            "poem": 1
          },
          {
            "text": "Неће ли вас спопасти језа од њега?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ставови су ваши пусте доскочице,",
            "poem": 1
          },
          {
            "text": "одбране су ваше одбране земљане.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Не говорите ми више да бих и ја до речи дошао,",
            "poem": 1
          },
          {
            "text": "па нека ме снађе шта год да ме снађе!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Зашто бих себе кидао зубима својим",
            "poem": 1
          },
          {
            "text": "и главу своју у торбу стављао?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Гле! Макар да ме и убије, надаћу се њему;",
            "poem": 1
          },
          {
            "text": "још увек бих пред њим путеве своје бранио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "И избављење то ће ми бити,",
            "poem": 1
          },
          {
            "text": "јер пред њега безбожник не може да дође.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Послушајте пажљиво беседу моју,",
            "poem": 1
          },
          {
            "text": "нек вам моје објашњење уђе у уши.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ево, молим вас, изложићу случај свој,",
            "poem": 1
          },
          {
            "text": "јер знам да сам у праву.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ко ће да се парничи са мном?",
            "poem": 1
          },
          {
            "text": "Јер, ако сад ућутим мене неће бити!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Једино ми две ствари немој учинити",
            "poem": 1
          },
          {
            "text": "да се не бих сакривао ја од лица твога:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Своју руку уклони од мене",
            "poem": 1
          },
          {
            "text": "и твој ужас нека ме не плаши!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Позови ме и одговараћу ти,",
            "poem": 1
          },
          {
            "text": "или да се ја жалим, а ти ми одговарај.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Које су то моје кривице и греси?",
            "poem": 1
          },
          {
            "text": "Покажи ми преступ мој и грех мој!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Зашто лице своје скриваш",
            "poem": 1
          },
          {
            "text": "и сматраш ме душманином својим?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Лист одуван зар ћеш да раздиреш,",
            "poem": 1
          },
          {
            "text": "травку суву зар ћеш да одуваш?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Горке ствари против мене записујеш,",
            "poem": 1
          },
          {
            "text": "кривице младости моје ми на терет стављаш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Ноге моје у окове стављаш,",
            "poem": 1
          },
          {
            "text": "надгледаш све стазе моје",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и бележиш сваки траг ногу мојих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "А ја пропадам као трулеж,",
            "poem": 1
          },
          {
            "text": "као одећа коју мољац једе!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
