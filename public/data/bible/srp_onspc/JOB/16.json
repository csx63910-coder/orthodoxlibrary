  "chapter": {
    "number": 16,
    "content": [
      {
        "type": "heading",
        "content": [
          "Јов"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "А Јов је одговорио овим речима:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Много сам ја таквих ствари чуо,",
            "poem": 1
          },
          {
            "text": "сви ви сте ми мучни тешиоци!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Има ли краја причању у ветар?",
            "poem": 1
          },
          {
            "text": "Шта те то тера да ми одговараш?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "И ја бих попут вас говорио",
            "poem": 1
          },
          {
            "text": "да сте ви на моме месту,",
            "poem": 2
          },
          {
            "text": "подбадао бих вас речима",
            "poem": 1
          },
          {
            "text": "и климао главом на вас.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Али би вас уста моја ојачала,",
            "poem": 1
          },
          {
            "text": "усне моје донеле утеху.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ако бих говорио,",
            "poem": 1
          },
          {
            "text": "свој бол не бих ублажио;",
            "poem": 2
          },
          {
            "text": "ако бих ућутао,",
            "poem": 1
          },
          {
            "text": "колико бола би ме напустило?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ипак, он ме је изнурио;",
            "poem": 1
          },
          {
            "text": "ти си ми затро све укућане моје!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Зграбио си ме,",
            "poem": 1
          },
          {
            "text": "бол је сведок против мене;",
            "poem": 2
          },
          {
            "text": "мршавост се моја подигнула",
            "poem": 1
          },
          {
            "text": "да у лице ме оптужи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Његов ме гнев раздире и спопада,",
            "poem": 1
          },
          {
            "text": "на мене зубима шкргуће својим,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "душманин мој је на мене упро очи своје!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Разјапили су своја уста према мени,",
            "poem": 1
          },
          {
            "text": "с презиром ми шамарају образе,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "окупљају се против мене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Злотвору ме Бог је изручио,",
            "poem": 1
          },
          {
            "text": "бацио ме у руке злобника!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Мирно сам живео, а он ме је уздрмао,",
            "poem": 1
          },
          {
            "text": "за врат ме је дочепао, смрскао ме;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "себи ме је за мету ставио;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "стрелци су ме његови окружили,",
            "poem": 1
          },
          {
            "text": "нутрину ми је распарао без милости",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и жуч ми је по земљи просуо.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Пролама кроз мене",
            "poem": 1
          },
          {
            "text": "све пролом за проломом,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "као ратник према мени тутњи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "За кожу сам своју, ја зашио кострет,",
            "poem": 1
          },
          {
            "text": "у прашину достојанство своје уваљао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Од ридања подбуло је лице моје,",
            "poem": 1
          },
          {
            "text": "капци су ми попут смрти црни,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "премда насиља нема у рукама мојим",
            "poem": 1
          },
          {
            "text": "и моја је молитва чиста.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "О, земљо, крв моју не прекривај!",
            "poem": 1
          },
          {
            "text": "Не било места за мој вапај!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "А сада, на небесима ено сведока мога!",
            "poem": 1
          },
          {
            "text": "Да, мој бранилац је на висинама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "А моји пријатељи – моји посредници вајни!",
            "poem": 1
          },
          {
            "text": "Око моје Богу плаче.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Ех, кад би се човек правдао са Богом",
            "poem": 1
          },
          {
            "text": "као човек са човеком.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Још година која прохујаће",
            "poem": 1
          },
          {
            "text": "и поћи ћу путем с којег повратка ми нема.",
            "poem": 2
          }
        ]
      }
    ],
