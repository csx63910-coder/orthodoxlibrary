  "chapter": {
    "number": 11,
    "content": [
      {
        "type": "heading",
        "content": [
          "Софар"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "А Софар из Намата је одговорио овим речима:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Зар на многе речи одговора нема",
            "poem": 1
          },
          {
            "text": "и хоће ли причалица постати праведан?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Хоће ли твоје празне приче ућуткати људе",
            "poem": 1
          },
          {
            "text": "и твоје ругање проћи без понижења?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ето, рекао си: ’Моја је поука без мане!",
            "poem": 1
          },
          {
            "text": "Ја сам невин у твојим очима!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Али када би Бог хтео да говори,",
            "poem": 1
          },
          {
            "text": "против тебе да отвори уста своја;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "да ти каже тајне мудрости –",
            "poem": 1
          },
          {
            "text": "мудрости што има двоструко значење –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "сазнао би да Бог заборавља неке кривице твоје!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Да ли можеш да докучиш Божије дубине",
            "poem": 1
          },
          {
            "text": "и границе Свемоћног можеш ли да нађеш?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Од небеса су више!",
            "poem": 1
          },
          {
            "text": "И шта ту да урадиш?",
            "poem": 2
          },
          {
            "text": "Дубље су од Света мртвих!",
            "poem": 1
          },
          {
            "text": "И шта ту да докучиш?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Оне су од земље дуже",
            "poem": 1
          },
          {
            "text": "и мером су шире него море.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ако он дође, па затвори или окупи судиште,",
            "poem": 1
          },
          {
            "text": "ко у томе да га спречи?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Јер, он познаје људску пролазност,",
            "poem": 1
          },
          {
            "text": "види поквареност и с пажњом је прати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ипак, шупљоглавац ће мудар постати",
            "poem": 1
          },
          {
            "text": "кад магаре дивље окоти човека!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ако будеш срце своје припремио",
            "poem": 1
          },
          {
            "text": "и руке своје к њему раширио;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "а зло ти се у рукама нађе – одбаци га –",
            "poem": 1
          },
          {
            "text": "нек неправда не пребива у шатору твоме!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Тада ћеш без стида да подигнеш лице своје,",
            "poem": 1
          },
          {
            "text": "чврст ћеш бити, страховати нећеш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Заборавићеш муку своју,",
            "poem": 1
          },
          {
            "text": "помишљаћеш на њу као на лањске снегове.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Светлији од поднева живот ће ти бити,",
            "poem": 1
          },
          {
            "text": "а и када ноћ наступи, биће као јутро.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Спокојан ћеш бити јер постоји нада!",
            "poem": 1
          },
          {
            "text": "Бићеш добро заштићен,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "у спокојству спаваћеш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Лежаћеш и нико те неће плашити,",
            "poem": 1
          },
          {
            "text": "многи ће ти се додворавати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Згаснуће очи зликовачке,",
            "poem": 1
          },
          {
            "text": "уточиште њихово нестаће,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а нада једина им је да издахну душу.“",
            "poem": 2
          }
        ]
      }
    ],
