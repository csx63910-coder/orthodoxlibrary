  "chapter": {
    "number": 41,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Не дивља ли када га пробудиш?",
            "poem": 1
          },
          {
            "text": "А ко је тај што би пред мене да стане?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Зар ми је ко икада дао шта, да би му ја то вратио?",
            "poem": 1
          },
          {
            "text": "Па све је моје под небесима!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "О удовима његовим ја да ћутим нећу,",
            "poem": 1
          },
          {
            "text": "ни о његовој снази, ни о складу његовог тела.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ко ће да му разоткрије површину његове одеће?",
            "poem": 1
          },
          {
            "text": "Дупли оклоп ко да му пробије?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ко би да му чељусти разјапи",
            "poem": 1
          },
          {
            "text": "када је страва око његових зуба?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Леђа су му од низова крљушти поређаних",
            "poem": 1
          },
          {
            "text": "и чврсто спојених.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Пријањају једна уз другу,",
            "poem": 1
          },
          {
            "text": "ни ваздух међу њима не пролази.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Спојене су међу собом, једна другу држе,",
            "poem": 1
          },
          {
            "text": "размака немају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Кад он кине, ко да муња сине;",
            "poem": 1
          },
          {
            "text": "очи му се црвене ко зора.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Пламен му из уста сукља,",
            "poem": 1
          },
          {
            "text": "жеравице ватрене врцају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Пара му се диже из ноздрва,",
            "poem": 1
          },
          {
            "text": "ко котао кључа и прелива.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Својим дахом угаљ распирује,",
            "poem": 1
          },
          {
            "text": "из ждрела му ватра пламти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Њему снага почива у шији,",
            "poem": 1
          },
          {
            "text": "испред њега наступа страхота.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Набори му на телу пријањају,",
            "poem": 1
          },
          {
            "text": "чврсти су и непомични.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Срце му је као камен тврдо,",
            "poem": 1
          },
          {
            "text": "тврдо му је као доњи жрвањ.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Кад се дигне, застрепе делије,",
            "poem": 1
          },
          {
            "text": "пред ломњавом одступају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ко га мачем и дохвати –",
            "poem": 1
          },
          {
            "text": "ништа му не вреди –",
            "poem": 2
          },
          {
            "text": "тако и копљем,",
            "poem": 1
          },
          {
            "text": "стрелом ил’ оствама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Гвожђе му је попут плеве,",
            "poem": 1
          },
          {
            "text": "а бронза му као дрво труло.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Њега стрела потерати неће,",
            "poem": 1
          },
          {
            "text": "а камење из праћке за њега је плева.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Као прутић њему је тољага,",
            "poem": 1
          },
          {
            "text": "фијуку се копља он подсмева.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Стомак му је ко од ломљених црепова,",
            "poem": 1
          },
          {
            "text": "па кроз блато прође ко дрљача.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Због њега дубина проври као лонац,",
            "poem": 1
          },
          {
            "text": "море се пени као казан масти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "За собом оставља траг од пене,",
            "poem": 1
          },
          {
            "text": "па се чини да је дубина оседела.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Нико му сличан на земљи није!",
            "poem": 1
          },
          {
            "text": "То је створење које страха нема!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Он гледа сваког ко је поносан",
            "poem": 1
          },
          {
            "text": "јер он је цар свих поносних!“",
            "poem": 2
          }
        ]
      }
    ],
