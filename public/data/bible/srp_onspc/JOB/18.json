  "chapter": {
    "number": 18,
    "content": [
      {
        "type": "heading",
        "content": [
          "Вилдад"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "А Вилдад из Суша је одговорио овим речима:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Када ћете да станете са причом?",
            "poem": 1
          },
          {
            "text": "Уразумите се, па да разговарамо.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Зашто би нас за стоку сматрали?",
            "poem": 1
          },
          {
            "text": "Зар смо глупи у вашим очима?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ти што раздиреш у свом бесу душу своју!",
            "poem": 1
          },
          {
            "text": "Хоће ли због тебе земља да опусти,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "хоће ли се са свог места померити стена?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Баш се гаси светло зликовца,",
            "poem": 1
          },
          {
            "text": "неће сијати жар његовог плама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Згаснуће светло у његовом шатору,",
            "poem": 1
          },
          {
            "text": "а над њим ће догорети светиљка.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Јењава жилавост његових корака",
            "poem": 1
          },
          {
            "text": "и руше га намере његове.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Јер су му ноге упале у мрежу,",
            "poem": 1
          },
          {
            "text": "у њене се петље запетљао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Замка га је за пету зграбила,",
            "poem": 1
          },
          {
            "text": "заплела га омча.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "За њега је клопка на тлу сакривена,",
            "poem": 1
          },
          {
            "text": "на путу је замка за њега.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ужаснут је од страхота свуд унаоколо,",
            "poem": 1
          },
          {
            "text": "сатиру га на кораку сваком.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Гладна га је невоља његова,",
            "poem": 1
          },
          {
            "text": "пропаст је спремљена да га саплете.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Она му растаче делове коже,",
            "poem": 1
          },
          {
            "text": "најцрња смрт му једе удове.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Одвлаче га из сигурности свог шатора,",
            "poem": 1
          },
          {
            "text": "и терају до цара страхоте",
            "poem": 2
          },
          {
            "noteId": 4
          },
          {
            "text": ".",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Њему туђи пребиваће у његовом шатору,",
            "poem": 1
          },
          {
            "text": "сумпор ће му по имању разасути.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Корење његово иструлиће одоздо,",
            "poem": 1
          },
          {
            "text": "а његове гране свенуће одозго.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ишчезнуће са земље сећање на њега,",
            "poem": 1
          },
          {
            "text": "неће му се на улици име чути.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Отераће га са светла у таму,",
            "poem": 1
          },
          {
            "text": "протераће га са земље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Остаће без рода,",
            "poem": 1
          },
          {
            "text": "без порода у народу своме,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "без преживелога у свом завичају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "На његов дан згрануће се и они на западу,",
            "poem": 1
          },
          {
            "text": "а и оне на истоку подилазиће језа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Заиста, такав је завичај злотвора,",
            "poem": 1
          },
          {
            "text": "такво је место онога што за Бога не зна!“",
            "poem": 2
          }
        ]
      }
    ],
