  "chapter": {
    "number": 21,
    "content": [
      {
        "type": "heading",
        "content": [
          "Јов"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "А Јов је одговорио овим речима:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Послушајте пажљиво беседу моју,",
            "poem": 1
          },
          {
            "text": "нека ми то буде утеха од вас.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Отрпите ме, ја бих говорио!",
            "poem": 1
          },
          {
            "text": "А ви се ругајте када то кажем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Жалим ли се ја то човеку?",
            "poem": 1
          },
          {
            "text": "Зар да дух мој не плане?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "К мени се окрените и запањите се,",
            "poem": 1
          },
          {
            "text": "затворите руком уста!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "И ја сам потресен кад мислим о овом,",
            "poem": 1
          },
          {
            "text": "грозница ми тело грчи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Елем, зашто живе зликовци,",
            "poem": 1
          },
          {
            "text": "зашто остаре и осиле?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Деца су њихова једра пред њима,",
            "poem": 1
          },
          {
            "text": "њихови су потомци са њима,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "пред очима њиховим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Куће су њихове лишене страха,",
            "poem": 1
          },
          {
            "text": "над њима нема Божијег прута.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Бикови су им приплодни, осемењују,",
            "poem": 1
          },
          {
            "text": "краве им се теле и нису јалове.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Попут стада пуштају дечаке,",
            "poem": 1
          },
          {
            "text": "њихова деца скакућу около.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Подцикују уз даире и лиру,",
            "poem": 1
          },
          {
            "text": "радују се уз звуке свирале.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Дане своје проживе у добру",
            "poem": 1
          },
          {
            "text": "и спокојно силазе у Свет мртвих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "А Богу говоре: ’Прођи нас се!",
            "poem": 1
          },
          {
            "text": "За путеве твоје нећемо да знамо!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ко је Свемоћни, па да му служимо?",
            "poem": 1
          },
          {
            "text": "Шта то добијамо ако га молимо?’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Гле! Напредак њихов није у руци њиховој,",
            "poem": 1
          },
          {
            "text": "од мене је подалеко савет зликоваца.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Колико се често гаси светиљка зликовца?",
            "poem": 1
          },
          {
            "text": "Стиже ли их пропаст њихова?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Додељује ли им Бог у свом гневу боли?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Јесу ли они попут сламе на ветру,",
            "poem": 1
          },
          {
            "text": "попут плеве коју вихор носи?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "’Бог грехе човека чува за децу његову’?",
            "poem": 1
          },
          {
            "text": "Ма нека то њему врати, нека тога свестан буде!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Нек очима својим своју пропаст гледа,",
            "poem": 1
          },
          {
            "text": "нек од гнева Свемоћнога пије!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Јер, мари ли он шта ће након њега са кућом му бити,",
            "poem": 1
          },
          {
            "text": "када му се број месеци скрати?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Учи ли ико Бога мудрости?",
            "poem": 1
          },
          {
            "text": "Њега, који суди узноситима?!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Један умре у обиљу свега",
            "poem": 1
          },
          {
            "text": "и све му је потаман, напредно;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "тело му је ухрањено млеком",
            "poem": 1
          },
          {
            "text": "и једра му срж је у костима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Други умире огорчене душе,",
            "poem": 1
          },
          {
            "text": "а добра се науживао није.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Тек, обојица ће у прашину лећи,",
            "poem": 1
          },
          {
            "text": "прекриће их црви.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Ето, мени су познате мисли ваше,",
            "poem": 1
          },
          {
            "text": "сплетке које сплеткарите против мене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Ви кажете: ’Где је сада кућа племићева?",
            "poem": 1
          },
          {
            "text": "Где је шатор у коме зликовци почивају?’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Што нисте питали оне који пролазе тим путем?!",
            "poem": 1
          },
          {
            "text": "Нисте ли њихове знакове уочили?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Јер, зликовац се поштеђује у дану пропасти,",
            "poem": 1
          },
          {
            "text": "избавља се злобник у дану јарости.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Ко ће да га прекори у лице због његовог пута?",
            "poem": 1
          },
          {
            "text": "Ко ће да му узврати за оно што је учинио?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Али када га на гробље буду изнели,",
            "poem": 1
          },
          {
            "text": "неко ће стражарити над хумком.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Слатко ће му бити грумење земље;",
            "poem": 1
          },
          {
            "text": "сваки човек њега ће следити,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а пре њега било их је безброј.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "И како ме сада улудо тешите?",
            "poem": 1
          },
          {
            "text": "Одговори ваши остали су лажни.“",
            "poem": 2
          }
        ]
      }
    ],
