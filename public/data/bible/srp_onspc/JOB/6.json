  "chapter": {
    "number": 6,
    "content": [
      {
        "type": "heading",
        "content": [
          "Јов"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "А Јов је одговорио овим речима:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„О, кад би се туга моја измерити могла",
            "poem": 1
          },
          {
            "text": "на теразијама, са свом несрећом мојом!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Од песка морског била би тежа",
            "poem": 1
          },
          {
            "text": "и зато су речи моје непромишљене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ево, стреле су Свемоћнога у мени",
            "poem": 1
          },
          {
            "text": "и њихов отров дух мој испија.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Божији су се ужаси постројили против мене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Њаче ли дивљи магарац крај испаше?",
            "poem": 1
          },
          {
            "text": "Муче ли во покрај хране своје?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Једе ли се неосољено јело?",
            "poem": 1
          },
          {
            "text": "Укусно ли је беланце јајета?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ни да такнем тако нешто нисам хтео,",
            "poem": 1
          },
          {
            "text": "а сад ми се храна моја огадила.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ех, кад би се испунила моја молба",
            "poem": 1
          },
          {
            "text": "и дао ми Бог чему се надам!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Кад би хтео Бог да ме скрши,",
            "poem": 1
          },
          {
            "text": "да замахне руком својом и среже ме!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "И даље би за мене то утеха била,",
            "poem": 1
          },
          {
            "text": "скакао бих весело и у муци којој нема олакшања,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер нисам прећутао речи Светога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "А у чему је то моја снага да бих истрајао?",
            "poem": 1
          },
          {
            "text": "И какав је то мој крај, па да ми се душа стрпи?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Јесам ли снажан као што је камен снажан?",
            "poem": 1
          },
          {
            "text": "Да није моје тело од бронзе?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Није ли свака снага у мени нестала?",
            "poem": 1
          },
          {
            "text": "Из мене је истргнут сваки напредак.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ко ускраћује милост очајнику, пријатељу своме,",
            "poem": 1
          },
          {
            "text": "одбацио је страх од Свемоћнога.",
            "poem": 2
          },
          {
            "noteId": 0
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "А моја су ме браћа изневерила као поток непостојан,",
            "poem": 1
          },
          {
            "text": "ко потоци сувих корита",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "мутних од леда,",
            "poem": 1
          },
          {
            "text": "на којима се снег крије.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Када се истопе, они нестану.",
            "poem": 1
          },
          {
            "text": "Када је топло, они испаре са свог места.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Вијугају стазе њихових токова,",
            "poem": 1
          },
          {
            "text": "одлазе у пустару и нестају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Погледом их траже каравани Теме",
            "poem": 1
          },
          {
            "text": "и путници из Саве жељно их погледају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "И посрамили су се, јер су се поуздали,",
            "poem": 1
          },
          {
            "text": "дошли су до њих и разочарали се.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "А сада сте ви за мене такви – никакви –",
            "poem": 1
          },
          {
            "text": "видели сте ужас и препали се!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Да ли сам вама рекао: ’Дајте!",
            "poem": 1
          },
          {
            "text": "Од свога имања дајте откуп за мене;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "избавите ме из руку злотвора,",
            "poem": 1
          },
          {
            "text": "откупите ме из руку окрутних?!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Научите ме, па ћу да заћутим.",
            "poem": 1
          },
          {
            "text": "Објасните ми шта сам сагрешио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Како су болне речи прикладне!",
            "poem": 1
          },
          {
            "text": "Али кога то ваш прекор прекорева?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Јел’ мислите речи да прекорите",
            "poem": 1
          },
          {
            "text": "и ветар очајникових жалопојки?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Па ви бисте и сироче оборили",
            "poem": 1
          },
          {
            "text": "и погађали се за пријатеља свога!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Зато будите вољни да ме погледате,",
            "poem": 1
          },
          {
            "text": "да ли ћу вас лагати у лице.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Молим вас, оканите се,",
            "poem": 1
          },
          {
            "text": "нек не буде неправде! Прођите се,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "праведност је моја још увек овде!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Има ли неправде на језику моме?",
            "poem": 1
          },
          {
            "text": "Зар уста моја не препознају зло?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
    "footnotes": [
      {
        "noteId": 0,
        "caller": "+",
        "text": "6,14 Изворни језик је овде недокучив, па овај стих може да се преведе и овако: Очајнику је потребна оданост његовог пријатеља макар да је заборавио богобојазност.",
        "reference": {
          "chapter": 6,
          "verse": 14
        }
      }
    ]
