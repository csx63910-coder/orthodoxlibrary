  },
  "chapter": {
    "number": 40,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Господ још рече Јову:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Као мушко опаши слабине своје,",
            "poem": 1
          },
          {
            "text": "да те ја питам, а ти да ми одговараш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Зар би ти да праведност моју обезвредиш?",
            "poem": 1
          },
          {
            "text": "Прогласио би мене кривим",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да би себе прогласио правим?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Имаш ли ти руку ко што је Божија?",
            "poem": 1
          },
          {
            "text": "Глас твој да ли као његов грми?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Хајде, величанством и угледом украси се,",
            "poem": 1
          },
          {
            "text": "у част и славу обуци се!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Излиј поплаву срџбе своје!",
            "poem": 1
          },
          {
            "text": "Сваког гордог погледај и сруши га.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Погледај све горде, па их понизи;",
            "poem": 1
          },
          {
            "text": "на лицу места изгази зле.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Заједно их у прашину затрпај,",
            "poem": 1
          },
          {
            "text": "преко лица покров у гробници свежи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Тада ћу ти ја признати",
            "poem": 1
          },
          {
            "text": "да десница твоја може да те спасе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "А гле, чудовиште бехемота",
            "poem": 1
          },
          {
            "noteId": 10
          },
          {
            "text": "које сам са тобом заједно створио!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Он попут вола пасе,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "а види му снаге у бедрима његовим!",
            "poem": 1
          },
          {
            "text": "Сила му је у трбушним мишићима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Реп укрути као кедар,",
            "poem": 1
          },
          {
            "text": "бедрене му жиле преплетене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Кости су му ко цеви бронзане,",
            "poem": 1
          },
          {
            "text": "а удови ко металне цеви.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Он је прво дело Божијег стварања,",
            "poem": 1
          },
          {
            "text": "Саздатељ му његов са мачем прилази.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Њему брда храну дају,",
            "poem": 1
          },
          {
            "text": "тамо где се играју звери пољске.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Испод лотоса он лежи,",
            "poem": 1
          },
          {
            "text": "крије се у трски и мочвари.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Лотоси га заклањају сенком,",
            "poem": 1
          },
          {
            "text": "окружен је поточним врбама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Гле, подивља ли река, њега то не страши;",
            "poem": 1
          },
          {
            "text": "нема страха ни кад Јордан јурне му у уста.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Може ли га ико зграбити док гледа?",
            "poem": 1
          },
          {
            "text": "Може ли му ико њушку пробости кукама?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Зар ћеш левијатана удицом да извучеш",
            "poem": 1
          },
          {
            "text": "и конопцем језик да му свежеш?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Хоћеш ли му уже кроз нос да провучеш",
            "poem": 1
          },
          {
            "text": "и чељуст му куком да прободеш?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Хоће ли те преклињати много",
            "poem": 1
          },
          {
            "text": "и умилне причати ти речи?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Зар ће савез с тобом да начини?",
            "poem": 1
          },
          {
            "text": "Држаћеш га довека ко роба?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Играћеш се са њим ко са птицом,",
            "poem": 1
          },
          {
            "text": "повоцем свезати за своје девојке?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Зар ће се ортаци цењкати за њега,",
            "poem": 1
          },
          {
            "text": "на комаде поделити трговцима?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Хоћеш ли му кожу избости оствама",
            "poem": 1
          },
          {
            "text": "и главу харпуном?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Ако руке на њега положиш –",
            "poem": 1
          },
          {
            "text": "сећаћеш се тога боја,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ал’ га више поновити нећеш!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Али, улудо је надати се томе!",
            "poem": 1
          },
          {
            "text": "Зар човек не пада само када га угледа?",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 10,
        "caller": "+",
        "text": "40,10 Ово је множина јеврејске именице животиња, чиме се највероватније указује на несвакидашњу величину овог бића.",
        "reference": {
          "chapter": 40,
          "verse": 10
        }
      }
    ]
