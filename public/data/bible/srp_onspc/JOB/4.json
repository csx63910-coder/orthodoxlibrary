  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "heading",
        "content": [
          "Елифас"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Тада је Елифас из Темана узвратио овако:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Хоћеш ли имати стрпљења да ти неко одговори?",
            "poem": 1
          },
          {
            "text": "Али ко би се могао уздржати од речи?!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ето, поучавао си многе",
            "poem": 1
          },
          {
            "text": "и руке клонуле си снажио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Посрнулог су твоје речи подизале",
            "poem": 1
          },
          {
            "text": "и колена си клецава јачао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "А сад, када је тебе снашло,",
            "poem": 1
          },
          {
            "text": "постао си нестрпљив;",
            "poem": 2
          },
          {
            "text": "кад се тебе такло,",
            "poem": 1
          },
          {
            "text": "ти си пренеражен.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Није ли богобојазност твоја поуздање твоје,",
            "poem": 1
          },
          {
            "text": "а честитост путева твојих нада твоја?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Молим те, сети се: ко је невин пострадао?",
            "poem": 1
          },
          {
            "text": "Где су то праведници сатрвени били?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Колико сам ја видео, они који ору неправду",
            "poem": 1
          },
          {
            "text": "и невољу сеју, баш то и жању.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Они гину од Божијег даха,",
            "poem": 1
          },
          {
            "text": "ишчезавају од духа гнева његовога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Рика лава, лавље урликање",
            "poem": 1
          },
          {
            "text": "и зуби лавића се ломе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Лав скапава без плена",
            "poem": 1
          },
          {
            "text": "и лавићи се губе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Знаш, к мени је потајно допрла реч,",
            "poem": 1
          },
          {
            "text": "о том ми је ухо шапат ухватило;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "у немирним мислима, у виђењима ноћним,",
            "poem": 1
          },
          {
            "text": "кад људе опхрва дубоки сан;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "страх и трепет су ме спопали",
            "poem": 1
          },
          {
            "text": "и од њих ми кости зазвечаше.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Тек, дух ми је прешао преко лица",
            "poem": 1
          },
          {
            "text": "и длаке на телу су ми се најежиле!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "И он стаде,",
            "poem": 1
          },
          {
            "text": "али му нисам разазнао лик.",
            "poem": 2
          },
          {
            "text": "Био ми је неки облик пред очима",
            "poem": 1
          },
          {
            "text": "и чуо сам глас који шапуће:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "’Зар смртник може да буде праведнији од Бога?",
            "poem": 1
          },
          {
            "text": "Зар је човек чистији од Саздатеља свога?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Па он се ни у слуге своје не поуздаје",
            "poem": 1
          },
          {
            "text": "и анђелима својим он налази ману,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "а камоли онима што живе у набијачама,",
            "poem": 1
          },
          {
            "text": "што им је темељ у прашини",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и које смрскају ко мољца.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Сатиру их у комаде од јутра до сутра,",
            "poem": 1
          },
          {
            "text": "заувек ишчезавају и нико не мари.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Није ли уже њиховог шатора ишчупано?",
            "poem": 1
          },
          {
            "text": "Помреће без мудрости.’",
            "poem": 2
          }
        ]
      }
    ],
