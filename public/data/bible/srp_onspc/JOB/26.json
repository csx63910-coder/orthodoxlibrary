  "chapter": {
    "number": 26,
    "content": [
      {
        "type": "heading",
        "content": [
          "Јов"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "А Јов је одговорио овим речима:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Е, баш си помогао беспомоћном,",
            "poem": 1
          },
          {
            "text": "баш спасао руку малаксалу!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Баш си немудроме савет дао",
            "poem": 1
          },
          {
            "text": "и мудрости прегршт обзнанио!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "А коме си те речи објавио?",
            "poem": 1
          },
          {
            "text": "Чији је то дух из тебе изашао?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Покојници испод вода дрхте,",
            "poem": 1
          },
          {
            "text": "ал’ и они што у њима живе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "И Свет мртвих пред њим је огољен,",
            "poem": 1
          },
          {
            "text": "и трулеж је мртвих нескривена.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Над безданом север је он простро,",
            "poem": 1
          },
          {
            "text": "окачио земљу у празнини.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Воде је свезао над облаке своје,",
            "poem": 1
          },
          {
            "text": "али се облаци не цепају под њима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Престо је свој сакрио,",
            "poem": 1
          },
          {
            "text": "свој је облак над њим разастро.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Поврх вода обзорје поставља,",
            "poem": 1
          },
          {
            "text": "као међу светлости и мраку.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Дрмају се стубови небески,",
            "poem": 1
          },
          {
            "text": "ужаснути његовим прекором.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Силом својом он море узбурка,",
            "poem": 1
          },
          {
            "text": "чудовиште Раву мудрошћу он смрска.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Његов ветар разведрује небеса,",
            "poem": 1
          },
          {
            "text": "рука му пробада змију вијугаву.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Гле, ово су обриси пута његовога,",
            "poem": 1
          },
          {
            "text": "само шапат речи што чујемо о њему!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Гром моћи његове ко ће да разуме?“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
