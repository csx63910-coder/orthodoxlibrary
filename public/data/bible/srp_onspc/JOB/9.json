  "chapter": {
    "number": 9,
    "content": [
      {
        "type": "heading",
        "content": [
          "Јов"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "А Јов је одговорио овим речима:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Заиста, ја знам да је тако,",
            "poem": 1
          },
          {
            "text": "јер како да се човек оправда пред Богом?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ако би неко хтео да се спори са њим,",
            "poem": 1
          },
          {
            "text": "не би могао да му одговори једну од хиљаду.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Он је мудрог срца и свемогућ,",
            "poem": 1
          },
          {
            "text": "па ко да му пркоси и остане читав?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Он помера горе да оне то и не знају,",
            "poem": 1
          },
          {
            "text": "преврће их у јарости својој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Он потреса земљу из основа њених,",
            "poem": 1
          },
          {
            "text": "па стубови њени дрхте.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Он заповеди сунцу и оно не сија,",
            "poem": 1
          },
          {
            "text": "над звездама печат ставља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Само он је тај што небеса разастире",
            "poem": 1
          },
          {
            "text": "и маршира по морским таласима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Он је начинио Медведа, Орион,",
            "poem": 1
          },
          {
            "text": "Влашиће и јужна сазвежђа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Он чини велике ствари,",
            "poem": 1
          },
          {
            "text": "неистраживо је мноштво чудеса његових.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Гле! Поред мене он пролази, а ја га не видим.",
            "poem": 1
          },
          {
            "text": "Он пролази, а ја га не опажам.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Види – он отима и ко да га спречи?",
            "poem": 1
          },
          {
            "text": "Ко ће да му каже: ’А шта то радиш?’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Бог не одвраћа свој гнев,",
            "poem": 1
          },
          {
            "text": "под њим су прострти помоћници чудовишта Раве.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "А шта бих ја још могао да му узвратим?",
            "poem": 1
          },
          {
            "text": "Које речи да одаберем против њега?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Чак и да сам невин, правдати се нећу,",
            "poem": 1
          },
          {
            "text": "судију ћу свога за милост да молим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ако га зазовем и он ми се јави,",
            "poem": 1
          },
          {
            "text": "нећу веровати да је мом вапају поклонио пажњу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Јер он ме ломи у олуји,",
            "poem": 1
          },
          {
            "text": "без повода задаје ми многе ране.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Не пушта ми да дођем до даха",
            "poem": 1
          },
          {
            "text": "јер ме је горким јадима налио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ако је до силе, несумњиво он је силан;",
            "poem": 1
          },
          {
            "text": "али ако је до правде, ко ће да ме брани?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Све и да се правдам,",
            "poem": 1
          },
          {
            "text": "моја ће ме уста прогласити кривим;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "осудиће ме и да сам без мане.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "И да сам без мане, самог себе не познајем",
            "poem": 1
          },
          {
            "text": "и свој живот ја презирем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Све је то једно те исто. Зато кажем:",
            "poem": 1
          },
          {
            "text": "’И оног без мане и оног злога,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Бог ће да докрајчи.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Ако би бич ненадано убијао,",
            "poem": 1
          },
          {
            "text": "он би се ругао очају недужних.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Земља је предана у руке зликовца,",
            "poem": 1
          },
          {
            "text": "а он затвара очи њеним судијама.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Јер, ако није он, ко је онда?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Моји дани протрчаше брже него гласник брзи;",
            "poem": 1
          },
          {
            "text": "утекоше, добра не видеше;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Склизнули су ко бродови трске,",
            "poem": 1
          },
          {
            "text": "сручили се попут лешинара на лешину.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Ако бих казао: ’Заборављам жалопојку своју,",
            "poem": 1
          },
          {
            "text": "мењам израз свога лица и бићу весео’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "опет бих стрепео у свим својим јадима,",
            "poem": 1
          },
          {
            "text": "и знам да ти ме оправдао не би.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Јер ако ћу бити крив,",
            "poem": 1
          },
          {
            "text": "зашто бих се узалуд трудио?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Све да се и умијем снежном водом,",
            "poem": 1
          },
          {
            "text": "руке своје лужином да сперем;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "и тад би ме у глибаву јаму уронио",
            "poem": 1
          },
          {
            "text": "да сам гадан и одећи својој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Није он човек попут мене, па да му узвратим,",
            "poem": 1
          },
          {
            "text": "да заједно дођемо на суд.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Међу нама нема посредника",
            "poem": 1
          },
          {
            "text": "што би руку своју положио на нас обојицу;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "ко би жезло Божије са мене склонио,",
            "poem": 1
          },
          {
            "text": "да ме ужас његов не ужасне!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Тада бих говорио и не бих га се плашио.",
            "poem": 1
          },
          {
            "text": "Али, сада нисам такав.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
