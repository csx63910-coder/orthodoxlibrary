  "chapter": {
    "number": 29,
    "content": [
      {
        "type": "heading",
        "content": [
          "Јовова последња одбрана"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "А Јов је наставио своје казивање овим речима:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„О, када би ми било као који месец раније,",
            "poem": 1
          },
          {
            "text": "као у данима када ме је Бог чувао;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "када ми је светлила његова светиљка над главом мојом,",
            "poem": 1
          },
          {
            "text": "по његовом светлу кад сам мраком ишао;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "баш какав сам био у својим једрим данима,",
            "poem": 1
          },
          {
            "text": "када сам у шатору своме с Богом близак био;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "онда кад је Свемоћни са мном био",
            "poem": 1
          },
          {
            "text": "и деца моја око мене!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Тад сам ноге у маслу прао",
            "poem": 1
          },
          {
            "text": "и потоке уља цедио ми камен!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "А када бих изашао на градска врата и на трг,",
            "poem": 1
          },
          {
            "text": "ставио бих столицу своју;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "младићи би ме видели, па би се повукли,",
            "poem": 1
          },
          {
            "text": "а старци би устајали и стајали;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "главари би причу прекидали,",
            "poem": 1
          },
          {
            "text": "своја уста руком затварали;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "утихнуо би глас владара,",
            "poem": 1
          },
          {
            "text": "језик им се за непце лепио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Блаженим ме звало ухо што ме је слушало,",
            "poem": 1
          },
          {
            "text": "хвалило ме око што ме је гледало;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "јер сам избављао убогога што ко бедник вапи,",
            "poem": 1
          },
          {
            "text": "сиротога без помоћи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Страдалников благослов био је на мени,",
            "poem": 1
          },
          {
            "text": "а срцу сам удовице доносио песму.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Праведност бих узимао, она ме је одевала;",
            "poem": 1
          },
          {
            "text": "правда ми је моја била ко одећа и ко турбан.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Слепоме сам очи био,",
            "poem": 1
          },
          {
            "text": "хромоме сам ноге био.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Отац сам био убогима,",
            "poem": 1
          },
          {
            "text": "незнанца сам на суду бранио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ломио сам вилице злотвору,",
            "poem": 1
          },
          {
            "text": "из уста му жртву отимао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "А причао сам: ’У своме ћу гнезду да преминем,",
            "poem": 1
          },
          {
            "text": "умножићу дане попут песка.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Мој је корен досезао воду,",
            "poem": 1
          },
          {
            "text": "гране су моје преко ноћи росне;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Моја је слава у мени свежа,",
            "poem": 1
          },
          {
            "text": "у руци је мојој увек млад лук.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Чекали су људи да ме чују,",
            "poem": 1
          },
          {
            "text": "ћутали би да чују мој савет.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "После моје речи нису узвраћали,",
            "poem": 1
          },
          {
            "text": "по њима би мој говор капао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Ко на кишу чекали би на ме,",
            "poem": 1
          },
          {
            "text": "уста своја отварали као да сам дажд пролећни.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Веровали не би кад бих им се насмејао",
            "poem": 1
          },
          {
            "text": "и ведрину мог лица нису потамнили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Пут сам им бирао, попут кнеза сам седео;",
            "poem": 1
          },
          {
            "text": "био сам као цар међу четама,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "као онај што жалосне теши.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
