  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "heading",
        "content": [
          "Јовова жалопојка"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Онда је Јов проговорио проклињући дан свог рођења."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Рекао је:"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "„Нек нестане дана у коме сам рођен",
            "poem": 1
          },
          {
            "text": "и ноћи када је речено: ’Зачело се мушко!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "У таму нека се окрене тај дан.",
            "poem": 1
          },
          {
            "text": "Не марио Бог одозго за њега",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и светлост га никада не обасјала.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Зграбили га ноћ и тама најгушћа,",
            "poem": 1
          },
          {
            "text": "облак га прекрио",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и све га помрчине дневне престравиле!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Нек ноћ ону тама прогута,",
            "poem": 1
          },
          {
            "text": "нек не буде придодана данима годишњим,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "нек не буде убројана месецима!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ево, ноћ та јалова нек буде,",
            "poem": 1
          },
          {
            "text": "повик среће не ушао у њу!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Проклели је они који дан проклињу,",
            "poem": 1
          },
          {
            "text": "што су вољни левијатана да буде.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Нека згасну звезде свитања њенога,",
            "poem": 1
          },
          {
            "text": "чекајући зору нека је не дочека,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "не видела поглед праскозорја;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "јер ми није затворила врата од мајчиног крила",
            "poem": 1
          },
          {
            "text": "и сакрила није муку од очију мојих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Зашто нисам умро у утроби",
            "poem": 1
          },
          {
            "text": "и скончао из стомака кад сам изашао?!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Зашто су ме прихватила колена",
            "poem": 1
          },
          {
            "text": "и зашто груди које сам сисао?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Јер ја бих сада спокојно лежао,",
            "poem": 1
          },
          {
            "text": "спавао бих и у миру био",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "с царевима и земаљским саветницима,",
            "poem": 1
          },
          {
            "text": "са онима што су себи обновили развалине;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "с кнезовима што имају злата,",
            "poem": 1
          },
          {
            "text": "што су сребром куће своје испунили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Или зашто нисам био мртворођенче замотано,",
            "poem": 1
          },
          {
            "text": "или попут дојенчади, што светла видела нису?!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Тамо злобници престају са злобом,",
            "poem": 1
          },
          {
            "text": "тамо почивају изнурени.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Затвореници су заједно спокојни",
            "poem": 1
          },
          {
            "text": "и не чују повик тлачитељев.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Тамо су и велики и мали,",
            "poem": 1
          },
          {
            "text": "а роб се ослободио господара свога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Зашто се страдалнику даје светло",
            "poem": 1
          },
          {
            "text": "и живот људима огорчене душе;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "онима што за смрти жуде, а ње нема,",
            "poem": 1
          },
          {
            "text": "и траже је више него благо закопано;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "онима који се безмерно радују и ликују",
            "poem": 1
          },
          {
            "text": "јер су гроб пронашли;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "човеку чији је пут сакривен",
            "poem": 1
          },
          {
            "text": "и кога је Бог одасвуд заградио?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Моме јелу претходи јечање моје",
            "poem": 1
          },
          {
            "text": "и мој се вапај ко вода излива.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Јер ме снађе чег’ сам се бојао,",
            "poem": 1
          },
          {
            "text": "сустигло ме од чег’ сам стрепео!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Немам мира, немам олакшања,",
            "poem": 1
          },
          {
            "text": "немам почивања, мука ме сустиже.“",
            "poem": 2
          }
        ]
      }
    ],
