  "chapter": {
    "number": 23,
    "content": [
      {
        "type": "heading",
        "content": [
          "Јов"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "А Јов је одговорио овим речима:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Још и данас је јетка моја жалопојка",
            "poem": 1
          },
          {
            "text": "и с муком се борим да не бих јечао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "О, када бих знао где ћу да га нађем,",
            "poem": 1
          },
          {
            "text": "дошао бих до његовог места!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Пред њим бих изложио свој случај,",
            "poem": 1
          },
          {
            "text": "доказима уста своја напунио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Да ми је да знам којим би ми речима одговорио;",
            "poem": 1
          },
          {
            "text": "да ми је да разумем шта би ми рекао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Да ли би се силом великом парничио са мном?",
            "poem": 1
          },
          {
            "text": "Не би, него би се заузео за ме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Онде би се праведник са њим расправио,",
            "poem": 1
          },
          {
            "text": "мој би ме судија заувек избавио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Гле, одем ли напред, њега нема;",
            "poem": 1
          },
          {
            "text": "ни позади њега не опажам.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Не видим га ни на лево, тамо где делује;",
            "poem": 1
          },
          {
            "text": "не видим га ни на десно, када се окрене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Али он зна пут којим идем;",
            "poem": 1
          },
          {
            "text": "претапа ме да чист будем попут злата.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "По његовој стопи мој је корак ишао,",
            "poem": 1
          },
          {
            "text": "његовог сам се пута држао и нисам скретао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Заповест његових усана нисам напустио,",
            "poem": 1
          },
          {
            "text": "чувао сам речи његове више него хлеб насушни.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Али он је једини и ко ће да га мења!",
            "poem": 1
          },
          {
            "text": "Шта год да пожели, он тако и чини.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Науме ће своје, мени намењене, извршити,",
            "poem": 1
          },
          {
            "text": "а у њему још је таквог много чега.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Зато сам преплашен од њега;",
            "poem": 1
          },
          {
            "text": "кад размишљам, јежим се од њега!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Елем, Бог је моје срце смалаксао,",
            "poem": 1
          },
          {
            "text": "Свемоћни ме је престравио;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "ипак нисам био сатрт мраком,",
            "poem": 1
          },
          {
            "text": "нити ми је густа тама заклонила лице.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
