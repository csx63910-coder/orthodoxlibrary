  "chapter": {
    "number": 15,
    "content": [
      {
        "type": "heading",
        "content": [
          "Елифас"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Тада је Елифас из Темана узвратио овако:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Зар мудар човек одговара у ветар,",
            "poem": 1
          },
          {
            "text": "зар свој стомак пуни источним ветром?!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Расправља ли речима безначајним",
            "poem": 1
          },
          {
            "text": "и говорима који никоме нису на корист?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "А ти сатиреш побожност,",
            "poem": 1
          },
          {
            "text": "размишљање пред Богом ометаш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Кривице твоје поуку дају устима твојим,",
            "poem": 1
          },
          {
            "text": "језиком се лукавим ти служиш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Сопствена те уста осуђују ко кривца,",
            "poem": 1
          },
          {
            "text": "а не ја; сопствене усне против тебе сведоче.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Да ти ниси прворођено људско биће,",
            "poem": 1
          },
          {
            "text": "изнедрен пре планина?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Да ниси слушао Божије тајне савете",
            "poem": 1
          },
          {
            "text": "и за себе задржао мудрост?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Шта то ти знаш, а ми да не знамо?",
            "poem": 1
          },
          {
            "text": "Шта ти схваташ, а да нама то није дано?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Међу нама има и седих и старих,",
            "poem": 1
          },
          {
            "text": "старијих и од оца твога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Шта, нису ти довољне Божије утехе",
            "poem": 1
          },
          {
            "text": "и обзирно упућена ти реч?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Зашто ти се срце твоје понело?",
            "poem": 1
          },
          {
            "text": "Зашто ти севају очи твоје,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "па се твој дух против Бога окренуо",
            "poem": 1
          },
          {
            "text": "и устима својим просипаш речи?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Па шта је човек да би чист био,",
            "poem": 1
          },
          {
            "text": "да би праведан био онај што га жена роди?!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Он се ни у свете",
            "poem": 1
          },
          {
            "noteId": 3
          },
          {
            "text": "своје не поуздаје,",
            "poem": 1
          },
          {
            "text": "очима његовим ни небеса нису чиста,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "а камоли гнусан и искварен човек,",
            "poem": 1
          },
          {
            "text": "човек што неправду као воду пије!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Елем, ја ћу ти рећи! Мене послушај,",
            "poem": 1
          },
          {
            "text": "објавићу ти оно што сам видео;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "оно што су мудри људи предали од предака својих",
            "poem": 1
          },
          {
            "text": "и то нису прикрили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "А само је њима земља била дана",
            "poem": 1
          },
          {
            "text": "и туђинац није пролазио међу њима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Тек, злобник се у болу превија кроз све дане,",
            "poem": 1
          },
          {
            "text": "и мало година је одређено окрутноме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Звук страхоте му је у ушима",
            "poem": 1
          },
          {
            "text": "и док је још мир затирач му долази.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Не нада се повратку из таме,",
            "poem": 1
          },
          {
            "text": "јер је за мач обележен.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Потуца се због хлеба: ’Где је?’",
            "poem": 1
          },
          {
            "text": "Он зна да му се ближи црни дан.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Плаше га и зебња и невоља,",
            "poem": 1
          },
          {
            "text": "надвладавају га као цар за напад спреман;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "јер на Бога руку своју диже,",
            "poem": 1
          },
          {
            "text": "пред Свемоћним охоло се држи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Он јуриша дрско против Бога,",
            "poem": 1
          },
          {
            "text": "носи штит велики и јаки.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Лице му је задригло,",
            "poem": 1
          },
          {
            "text": "бокови му усаљени;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "живи у руинама од градова,",
            "poem": 1
          },
          {
            "text": "у кућама напуштеним",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "што постаће гомиле камења.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Богат неће бити и благо му потрајати неће,",
            "poem": 1
          },
          {
            "text": "имање му се неће ширити по земљи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Он неће побећи из таме,",
            "poem": 1
          },
          {
            "text": "пламен ће му изданак спарушити",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и нестаће у даху Божијих уста.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Нек се не узда у безвредно јер је заведен,",
            "poem": 1
          },
          {
            "text": "јер ће му безвредно постати награда;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "а награђен ће бити и пре свога дана",
            "poem": 1
          },
          {
            "text": "и грана му неће озеленети.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Као лоза отрешће свој незрели грозд",
            "poem": 1
          },
          {
            "text": "и као маслина стрешће цват свој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Јер јалово је друштво безбожничко,",
            "poem": 1
          },
          {
            "text": "а шаторе подмићених ватра прогутаће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Зачеће невољу, а родиће злобу,",
            "poem": 1
          },
          {
            "text": "стомаци им спремни за обману.“",
            "poem": 2
          }
        ]
      }
    ],
