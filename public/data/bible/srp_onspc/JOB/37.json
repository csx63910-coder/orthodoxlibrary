  },
  "chapter": {
    "number": 37,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Стварно, и моје срце због тога туче,",
            "poem": 1
          },
          {
            "text": "отима се у грудима!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Слушајте! Почујте тутњаву гласа његовога,",
            "poem": 1
          },
          {
            "text": "проламање што излази из уста његових.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Испод свих небеса он га пушта,",
            "poem": 1
          },
          {
            "text": "и муњу своју до крајева земље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "За њом громови туку",
            "poem": 1
          },
          {
            "text": "гласом славе његове,",
            "poem": 2
          },
          {
            "text": "а када се огласе тутњавом својом",
            "poem": 1
          },
          {
            "text": "не враћа се више муња.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "То Бог чудесно грми гласом својим",
            "poem": 1
          },
          {
            "text": "и велике, нама несхватљиве ствари чини!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Елем, он снегу каже: ’На земљу падни!’",
            "poem": 1
          },
          {
            "text": "и обилној киши: ’Пљушти!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Тиме свачију руку спутава у раду,",
            "poem": 1
          },
          {
            "text": "да би сваки човек знао за дело његово.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Тада звери иду у брлоге своје,",
            "poem": 1
          },
          {
            "text": "почивају у својим јазбинама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Олуја се сручи из одаје своје",
            "poem": 1
          },
          {
            "text": "и северци доносе зиму.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Дах Божији лед доноси",
            "poem": 1
          },
          {
            "text": "и широке воде леди.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Облаке тмурне је влагом напунио",
            "poem": 1
          },
          {
            "text": "и севне муњом по облаку;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "и они онда круже,",
            "poem": 1
          },
          {
            "text": "ваљају се како их он води;",
            "poem": 2
          },
          {
            "text": "да ураде што им је заповедио",
            "poem": 1
          },
          {
            "text": "по лицу света и земље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "А он то чини било као прекор",
            "poem": 1
          },
          {
            "text": "или као милосрђе на добро земље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "О, Јове, послушај ово!",
            "poem": 1
          },
          {
            "text": "Стани па размотри чудеса Божија.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Знаш ли како их је Бог послагао,",
            "poem": 1
          },
          {
            "text": "како заблешти муњом облака свога?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Знаш ли како облаци висе",
            "poem": 1
          },
          {
            "text": "и чудеса оног што је савршен у знању?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ти, чије су хаљине вруће",
            "poem": 1
          },
          {
            "text": "док је земља мирна због јужног ветра;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "хоћеш ли са њим да развлачиш облаке,",
            "poem": 1
          },
          {
            "text": "тврде као изливено огледало?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Хајде нам кажи шта да му кажемо!",
            "poem": 1
          },
          {
            "text": "Због таме свој случај не можемо да изнесемо.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Да му јавимо да бих ја да проговорим?",
            "poem": 1
          },
          {
            "text": "Зар би било ко говорио да би прождран био!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Сјајно светло на небу људи сада не могу да виде,",
            "poem": 1
          },
          {
            "text": "али ветар хуји и развејава облаке.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Са севера стиже златни сјај",
            "poem": 1
          },
          {
            "text": "и око Бога је слава величанства!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Свемоћнога не можемо наћи.",
            "poem": 1
          },
          {
            "text": "Узвишен је у сили,",
            "poem": 2
          },
          {
            "text": "али у правди и великој праведности својој",
            "poem": 1
          },
          {
            "text": "он не тлачи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Зато га се боје људи:",
            "poem": 1
          },
          {
            "text": "он не мари за мудре у срцу.“",
            "poem": 2
          }
        ]
      }
    ],
