  "chapter": {
    "number": 25,
    "content": [
      {
        "type": "heading",
        "content": [
          "Вилдад"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Тада је Вилдад из Суша узвратио овако:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Божији су и власт и страх!",
            "poem": 1
          },
          {
            "text": "Он мир ствара у висинама својим!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Да ли има броја његовим четама?",
            "poem": 1
          },
          {
            "text": "Кога то светло његово не обасјава?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Како да се човек оправда пред Богом?",
            "poem": 1
          },
          {
            "text": "Како да се очисти онај што га жена роди?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Гле! Ни месец му бистар није,",
            "poem": 1
          },
          {
            "text": "очима његовим нити звезде нису чисте;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "а камоли човек – црв",
            "poem": 1
          },
          {
            "text": "и потомак човека – црвић!“",
            "poem": 2
          }
        ]
      }
    ],
