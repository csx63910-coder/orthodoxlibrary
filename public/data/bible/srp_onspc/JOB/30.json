  },
  "chapter": {
    "number": 30,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "А сад ми се смеју млађи од мене,",
            "poem": 1
          },
          {
            "text": "они чије очеве нисам хтео",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ни са псима стада свога!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "А и шта бих са њихових руку снагом?",
            "poem": 1
          },
          {
            "text": "Усахла је та снага у њима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Спарушени су од беде и глади,",
            "poem": 1
          },
          {
            "text": "ти што глођу штагод по пустари,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "у сумраку, по рушевинама и развалинама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Они чупају слез по честарима",
            "poem": 1
          },
          {
            "text": "и корен смреке себи за храну.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Отерани су из друштва,",
            "poem": 1
          },
          {
            "text": "људи на њих вичу као на лопова.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ено их у јаругама потока,",
            "poem": 1
          },
          {
            "text": "коначе по јамама у земљи и по камењарима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Запомажу међу грмљем,",
            "poem": 1
          },
          {
            "text": "скупљају се у копривама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Синови су безумника,",
            "poem": 1
          },
          {
            "text": "сој безимених из земље протераних.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "А сад сам им песма ругалица,",
            "poem": 1
          },
          {
            "text": "постао сам прича за њих!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Гаде ме се, стоје издалека,",
            "poem": 1
          },
          {
            "text": "не либе се да ме у лице пљуну.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Јер Бог је развезао мог шатора уже,",
            "poem": 1
          },
          {
            "text": "ударио ме је, а људи се на мене разуларише.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Мени с десна диже се младалачка руља,",
            "poem": 1
          },
          {
            "text": "терају ме да бежим,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "против мене насипају бедеме пропасти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Руше ми путеве,",
            "poem": 1
          },
          {
            "text": "успешно ме разарају",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и за то им помоћ није потребна.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Навиру ко кроз широк процеп,",
            "poem": 1
          },
          {
            "text": "наваљују преко развалина.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ненадане страхоте пале су на мене,",
            "poem": 1
          },
          {
            "text": "попут ветра разгоне ми достојанство,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а моје спасење нестаде ко облак.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Сад се душа моја разлила у мени,",
            "poem": 1
          },
          {
            "text": "јер су ме сустигли дани јада.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Кости моје ноћ пробада у мени,",
            "poem": 1
          },
          {
            "text": "болови ме глођу без престанка.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Одора се моја изобличила од силе велике,",
            "poem": 1
          },
          {
            "text": "сапела ме као крагна од тунике моје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Он ме је у блато бацио,",
            "poem": 1
          },
          {
            "text": "сад сам налик праху и пепелу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "За помоћ ја теби вапим,",
            "poem": 1
          },
          {
            "text": "ал’ се не одазиваш;",
            "poem": 2
          },
          {
            "text": "а када сам стао,",
            "poem": 1
          },
          {
            "text": "на мене си пажњу обратио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "У крвника мога си се претворио,",
            "poem": 1
          },
          {
            "text": "силом руке своје си ме спопао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Винуо си ме да ветар зајашем,",
            "poem": 1
          },
          {
            "text": "растапаш ме у олуји.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Јер ја знам да ме у смрт одводиш,",
            "poem": 1
          },
          {
            "text": "у кућу састанка свих који су живи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Али нико не пружа руку своју руини,",
            "poem": 1
          },
          {
            "text": "макар да за помоћ вапи у пропасти својој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Зар ја нисам заплакао ради невољника?",
            "poem": 1
          },
          {
            "text": "Зар ми душа зајецала није ради убогога?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Али кад сам чекао на добро,",
            "poem": 1
          },
          {
            "text": "зло је дошло;",
            "poem": 2
          },
          {
            "text": "када сам се понадао светлу,",
            "poem": 1
          },
          {
            "text": "пристигла је тама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Утроба је моја устрептала и није се примирила,",
            "poem": 1
          },
          {
            "text": "дани патње су ме задесили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Поцрнео ходам, али не од сунца;",
            "poem": 1
          },
          {
            "text": "устајем у збору и вичем за помоћ.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Збратимљен сам са шакалима,",
            "poem": 1
          },
          {
            "text": "пријатељ сам нојевима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Поцрнела кожа је на мени,",
            "poem": 1
          },
          {
            "text": "од грознице цвокоћу ми кости.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Моја лира сад је за кукњаву,",
            "poem": 1
          },
          {
            "text": "а свирала моја за плач нарикача.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
