  "chapter": {
    "number": 12,
    "content": [
      {
        "type": "heading",
        "content": [
          "Јов"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "А Јов је одговорио овим речима:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Несумњиво, баш ви сте ми људи",
            "poem": 1
          },
          {
            "text": "с којима ће и мудрост да сконча!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Али и ја имам памет попут ваше,",
            "poem": 1
          },
          {
            "text": "ништа гори од вас нисам.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "И ко још не зна ове ствари?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ја сам на подсмех пријатељу своме,",
            "poem": 1
          },
          {
            "text": "ја, који сам зазвао Бога и он ми се одазвао.",
            "poem": 2
          },
          {
            "text": "На подсмех је човек праведан,",
            "poem": 1
          },
          {
            "text": "човек беспрекоран.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "’Он је за пропаст и презир’ –",
            "poem": 1
          },
          {
            "text": "став је безбрижнога –",
            "poem": 2
          },
          {
            "text": "’Гурнути треба онога",
            "poem": 1
          },
          {
            "text": "што му ноге посрћу!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "А у шаторима окрутних је мир,",
            "poem": 1
          },
          {
            "text": "спокојни су они што Бога изазивају",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и они што у руци својој бога свога носе",
            "poem": 2
          },
          {
            "noteId": 2
          },
          {
            "text": ".",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Али, молим те, питај животиње",
            "poem": 1
          },
          {
            "text": "и поучиће те;",
            "poem": 2
          },
          {
            "text": "и птице на небу",
            "poem": 1
          },
          {
            "text": "нека ти кажу!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Са земљом попричај и поучиће те,",
            "poem": 1
          },
          {
            "text": "рибе у мору ће ти казивати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ко од њих још не зна",
            "poem": 1
          },
          {
            "text": "да је ово начинила Господња рука?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "У његовој је руци душа свега живог",
            "poem": 1
          },
          {
            "text": "и дах тела човечанства целог.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Не разазнаје ли ухо речи",
            "poem": 1
          },
          {
            "text": "ко што непце храну проба?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Не долази ли мудрост с годинама",
            "poem": 1
          },
          {
            "text": "и разборитост са данима многим?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Са Богом су и мудрост и снага,",
            "poem": 1
          },
          {
            "text": "његови су и савет и разборитост.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Гле, што он разгради, нико не сагради;",
            "poem": 1
          },
          {
            "text": "кад он човека затвори и нико га не ослободи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Гле, он воде задржава и оне пресуше;",
            "poem": 1
          },
          {
            "text": "он их ослобађа и земља је изрована.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Са њим су снага и поуздана мудрост,",
            "poem": 1
          },
          {
            "text": "заведени и заводник су његови.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Он босоноге одводи саветнике",
            "poem": 1
          },
          {
            "text": "и слуђује судије.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Цареве он распојасава,",
            "poem": 1
          },
          {
            "text": "каишом им опасује бедра.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Он босоноге одводи свештенике",
            "poem": 1
          },
          {
            "text": "и свргава властодршце.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Поузданим усне он затвара,",
            "poem": 1
          },
          {
            "text": "проницљивост старцима односи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "На племиће он презир излива,",
            "poem": 1
          },
          {
            "text": "делијама каиш откопчава.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Он из мрака објављује недокучиве ствари,",
            "poem": 1
          },
          {
            "text": "мрклу таму износи на светло.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Народе он великим чини и сатире их;",
            "poem": 1
          },
          {
            "text": "умножи народе, па их распрши.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Он узима разум старешинама народа земаљских,",
            "poem": 1
          },
          {
            "text": "чини да лутају пустаром беспутном.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Они у мраку пипају, без светла,",
            "poem": 1
          },
          {
            "text": "а он чини да посрћу ко пијанци.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 2,
        "caller": "+",
        "text": "12,6 Последњи део стиха може да се преведе и као: премда их Бог у шаци држи.",
