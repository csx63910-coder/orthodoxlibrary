    "lastChapterApiLink": "/api/srp_onspc/JOB/42.json",
    "totalNumberOfVerses": 1070
  },
  "chapter": {
    "number": 24,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Зашто Свемоћни није одредио времена суда?",
            "poem": 1
          },
          {
            "text": "Зашто они који га познају не виде дане његове?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Померају људи међе,",
            "poem": 1
          },
          {
            "text": "стада отимају, па их напасају;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "сирочади одводе магарца,",
            "poem": 1
          },
          {
            "text": "вола за залог узимају од удовице.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Они разгоне убоге са пута,",
            "poem": 1
          },
          {
            "text": "скривају се заједно сиромаси земље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ено, као дивљи магарци у пустињи иду својим послом;",
            "poem": 1
          },
          {
            "text": "храну себи траже,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "у пустари хлеб за себе и за децу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "По пољу купе крму,",
            "poem": 1
          },
          {
            "text": "пабирче по винограду злобника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Неодевени су, ноћивају без огртача,",
            "poem": 1
          },
          {
            "text": "на зими су без покривача.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Искисли су од планинске кише,",
            "poem": 1
          },
          {
            "text": "без заклона крије се под стену.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Сироче од дојења краду",
            "poem": 1
          },
          {
            "text": "и од сиромаха узимају залог.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Тумарају обнажени,",
            "poem": 1
          },
          {
            "text": "неодевени снопље носе, а гладни.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Међу својим дрворедима цеде уље,",
            "poem": 1
          },
          {
            "text": "грожђе муљају у каци, а жедни су.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Стење народ у граду,",
            "poem": 1
          },
          {
            "text": "за помоћ вапе смртно рањени,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а Богу то није мрско.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "А неки су у друштву оних што ратују против светла,",
            "poem": 1
          },
          {
            "text": "што не маре за путеве светла",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и не живе на стазама његовим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "У зору се крвник диже,",
            "poem": 1
          },
          {
            "text": "сиротана и убогог да убије,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а по ноћи је ко лопов.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Прељубниково око чека сумрак јер говори:",
            "poem": 1
          },
          {
            "text": "’Да ме око не угледа!’,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "па покрива лице своје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Кад је тама, лопов куће прокопава,",
            "poem": 1
          },
          {
            "text": "а по дану се закључава",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да за светлост не зна.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Јер је свима њима јутро попут густог мрака,",
            "poem": 1
          },
          {
            "text": "предани су ужасима мрака густог.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Пролете они поврх вода,",
            "poem": 1
          },
          {
            "text": "проклето им наследство у земљи",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и нека ниједан не крене ка виноградима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Попут суше и врућине снежне воде кад однесу,",
            "poem": 1
          },
          {
            "text": "тако и Свет мртвих носи оне што се огрешише.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Заборавља га мајчина утроба,",
            "poem": 1
          },
          {
            "text": "црвима је храна;",
            "poem": 2
          },
          {
            "text": "њега више не спомињу,",
            "poem": 1
          },
          {
            "text": "неправда ће бити као стабло преломљено.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Он наваљује на јалову, на нероткињу;",
            "poem": 1
          },
          {
            "text": "злоставља удовицу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Силом својом Бог моћнике одвлачи,",
            "poem": 1
          },
          {
            "text": "подиже се и нико за живот сигуран није.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Бог им спокојство даје, па се осилише;",
            "poem": 1
          },
          {
            "text": "али његове су очи на њиховим путевима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Тек за мало уздигну се и већ их нема;",
            "poem": 1
          },
          {
            "text": "ко сви други пропадају, вену;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "одсецају се као вршци класја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Ако није тако, ко ће да ми лаж докаже?",
            "poem": 1
          },
          {
            "text": "Ко ће да обезвреди казивање моје?“",
            "poem": 2
          }
        ]
      }
    ],
