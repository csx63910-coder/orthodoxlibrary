  "book": {
    "id": "JOB",
    "translationId": "srp_onspc",
    "name": "Књига о Јову",
    "commonName": "Књига о Јову",
    "title": "Књига о Јову",
    "order": 18,
    "numberOfChapters": 42,
    "sha256": "06b5a0909a72d6176f6b8d8ebef5ecc2bfb265f5829f37c46298f8075bdf4bb8",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/JOB/1.json",
    "lastChapterNumber": 42,
    "lastChapterApiLink": "/api/srp_onspc/JOB/42.json",
    "totalNumberOfVerses": 1070
  },
  "chapter": {
    "number": 39,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Хоћеш ли ти лаву плен да ловиш",
            "poem": 1
          },
          {
            "text": "и нахраниш лавиће,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "кад се примире у јазбинама,",
            "poem": 1
          },
          {
            "text": "кад из потаје вребају у жбуњу?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ко гаврану јело спрема,",
            "poem": 1
          },
          {
            "text": "када му птићи пиште Богу,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "када за храном гегају се?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "А знаш ли време кад се дивокозе козе?",
            "poem": 1
          },
          {
            "text": "Јеси ли гледао кад кошуте коте младе?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Да ли бројиш колико су месеци скотне?",
            "poem": 1
          },
          {
            "text": "Знаш ли када ће се омладити?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Шћућуре се и окоте своје младе,",
            "poem": 1
          },
          {
            "text": "болова се ослободе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "И млади им ојачају, расту у дивљини,",
            "poem": 1
          },
          {
            "text": "и кад оду више им се не враћају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ко је дивљег магарца ослободио",
            "poem": 1
          },
          {
            "text": "и ко му је развезао ужад?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ја сам њему пустару за кућу дао",
            "poem": 1
          },
          {
            "text": "и слатину за пребивалиште.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Он на градску вреву њаче",
            "poem": 1
          },
          {
            "text": "и не хаје за повик гонича.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "По брдима пашу своју тражи,",
            "poem": 1
          },
          {
            "text": "њуши за сваким зеленилом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Пристаје ли биво да ти служи,",
            "poem": 1
          },
          {
            "text": "да заноћи за твојим јаслама?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Зар ћеш бивола ужетом у плуг да упрегнеш?",
            "poem": 1
          },
          {
            "text": "Хоће ли за тобом долове да дрља?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Хоћеш ли се уздати у њега због његове поголеме снаге?",
            "poem": 1
          },
          {
            "text": "Хоћеш да му свој рад препустиш?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Зар верујеш како ће ти довући летину,",
            "poem": 1
          },
          {
            "text": "на гумно ти скупити пшеницу?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ној поносно лепеће крилима,",
            "poem": 1
          },
          {
            "text": "али то нису ни крила ни перје роде!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Своја јаја на земљи полаже,",
            "poem": 1
          },
          {
            "text": "у прашини, да им буде топло.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Он не мари дал’ ће нога да их смрска,",
            "poem": 1
          },
          {
            "text": "дивља зверка да их згази.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Нема сажаљења за птиће своје",
            "poem": 1
          },
          {
            "text": "као да нису његови,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "не мари што труд му је узалудан.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Бог га је мудрости лишио,",
            "poem": 1
          },
          {
            "text": "разума му није уделио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Кад се високо размаше,",
            "poem": 1
          },
          {
            "text": "и коњу и његовом јахачу се смеје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Даде ли ти коњу снагу?",
            "poem": 1
          },
          {
            "text": "Да ли си му гривом украсио врат?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Ти ли му дајеш да ко скакавац скаче?",
            "poem": 1
          },
          {
            "text": "Ужасно је рзање његово поносно.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Земљу копа, од снаге дрхти,",
            "poem": 1
          },
          {
            "text": "на оружје хрли!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Страху се смеје, не да се смести",
            "poem": 1
          },
          {
            "text": "и пред мачем не узмиче.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Тоболац над њим звечи,",
            "poem": 1
          },
          {
            "text": "севају сабља и копље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Од дрхтања и фрктања земљу гризе,",
            "poem": 1
          },
          {
            "text": "не мирује на позив рога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Он зањишти на звук рога",
            "poem": 1
          },
          {
            "text": "и нањуши издалека битку,",
            "poem": 2
          },
          {
            "text": "вику заповедника",
            "poem": 1
          },
          {
            "text": "и бојни поклич.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Вине ли се крагуј по замисли твојој",
            "poem": 1
          },
          {
            "text": "и рашири крила према југу?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "По твојој ли се речи орао уздиже",
            "poem": 1
          },
          {
            "text": "и на висинама гнезди?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "На литици живи,",
            "poem": 1
          },
          {
            "text": "ноћ проводи на гребену",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и на утврђењу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Одатле он храну вреба",
            "poem": 1
          },
          {
            "text": "и очи му надалеко виде.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Његови птићи крв пију,",
            "poem": 1
          },
          {
            "text": "лешеви где су –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и он је тамо.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "Тада је Господ узвратио Јову овим речима:"
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "„Зар ће свађалица Свемоћнога да исправља?",
            "poem": 1
          },
          {
            "text": "Нека Богу сад узврати тај што му замера!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "И Јов је овим речима узвратио Господу:"
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "„Гле, ја никакав како бих теби узвратио?!",
            "poem": 1
          },
          {
            "text": "Руком својом затварам уста своја!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "Нећу да узвратим, већ једном сам говорио;",
            "poem": 1
          },
          {
            "text": "и још једном, али више нећу.“",
            "poem": 2
          }
        ]
      }
    ],
