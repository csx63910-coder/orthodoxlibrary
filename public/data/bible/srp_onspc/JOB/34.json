  "book": {
    "id": "JOB",
    "translationId": "srp_onspc",
    "name": "Књига о Јову",
    "commonName": "Књига о Јову",
    "title": "Књига о Јову",
    "order": 18,
    "numberOfChapters": 42,
    "sha256": "06b5a0909a72d6176f6b8d8ebef5ecc2bfb265f5829f37c46298f8075bdf4bb8",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/JOB/1.json",
    "lastChapterNumber": 42,
    "lastChapterApiLink": "/api/srp_onspc/JOB/42.json",
    "totalNumberOfVerses": 1070
  },
  "chapter": {
    "number": 34,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Елијуј је наставио своје казивање:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Ви мудри, послушајте речи моје;",
            "poem": 1
          },
          {
            "text": "ви учени, обратите пажњу!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Јер, беседе се ухом пропитују,",
            "poem": 1
          },
          {
            "text": "ко што непцем пробају се јела.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Шта је право, сами разлучимо,",
            "poem": 1
          },
          {
            "text": "међу собом препознајмо добро.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ето, Јов је рекао: ’Праведан сам,",
            "poem": 1
          },
          {
            "text": "а Бог ми је ускратио моју правду!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Зар бих о својој правди лагао?",
            "poem": 1
          },
          {
            "text": "На смрт сам прободен,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а згрешио нисам.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Попут Јова има ли човека,",
            "poem": 1
          },
          {
            "text": "што поругу пије као да је вода;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "који иде за друштвом злотвора,",
            "poem": 1
          },
          {
            "text": "пријатељује с покварењацима?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Јер је казао: ’Никаква је корист за човека",
            "poem": 1
          },
          {
            "text": "да Богу угађа!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Зато ме чујте, људи разумног срца:",
            "poem": 1
          },
          {
            "text": "далеко била од Бога поквареност",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и неправедност од Свемоћног!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Јер по делу он човеку враћа,",
            "poem": 1
          },
          {
            "text": "човеку узвраћа по путу његовом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Бог заиста не ради злобно",
            "poem": 1
          },
          {
            "text": "и Свемоћни не изврће правду.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ко је њему поверио земљу?",
            "poem": 1
          },
          {
            "text": "Ко ли га је поставио над читавим светом?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Када би се срцем томе посветио,",
            "poem": 1
          },
          {
            "text": "па свој дух и дах свој себи задржао,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "свако би тело нестало,",
            "poem": 1
          },
          {
            "text": "човечанство цело у прах би се вратило.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Саслушај ме ако разум имаш,",
            "poem": 1
          },
          {
            "text": "почуј добро речи моје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Хоће ли да влада онај који правду мрзи?",
            "poem": 1
          },
          {
            "text": "Зар ћеш кривим да прогласиш свемогућег Праведника?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Па он цару каже: ’Ништаријо’,",
            "poem": 1
          },
          {
            "text": "и племићу: ’Зликовче!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Он пристрасан није према главарима",
            "poem": 1
          },
          {
            "text": "и не повлађује богатом пред сиротим,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер његових руку сви су они дело.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Усред ноћи у трену умиру,",
            "poem": 1
          },
          {
            "text": "скончавају људи потрешени,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "моћник нестаје без ичије руке.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Јер очи његове пут човеков прате,",
            "poem": 1
          },
          {
            "text": "сваки корак његов он посматра.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Нема мрака, нема помрчине",
            "poem": 1
          },
          {
            "text": "злотвора да скрије.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Јер Бог не одлаже време",
            "poem": 1
          },
          {
            "text": "кад му човек на суд дође.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Без истраге моћнике обара,",
            "poem": 1
          },
          {
            "text": "на њихово место он друге поставља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Јер дела њихова њему су знана,",
            "poem": 1
          },
          {
            "text": "преко ноћи он их одбацује,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "сатрвени буду.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Потире их због њихове злобе,",
            "poem": 1
          },
          {
            "text": "тамо где и други виде,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "јер су се од њега окренули,",
            "poem": 1
          },
          {
            "text": "јер нису марили за све његове путеве;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "јер је због њих до њега дошао вапај сиромаха",
            "poem": 1
          },
          {
            "text": "и плач убогих он је чуо.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "А када он умири, ко да узнемири?",
            "poem": 1
          },
          {
            "text": "Кад лице сакрије, ко ће да га нађе?",
            "poem": 2
          },
          {
            "text": "А тако бива и за народ и за човека,",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "да безбожник не завлада",
            "poem": 1
          },
          {
            "text": "и народу не постави замке.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Зар сме неко Богу да каже:",
            "poem": 1
          },
          {
            "text": "’Трпео сам, ал’ грешити више нећу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Поучи ме оном што не видим;",
            "poem": 1
          },
          {
            "text": "ако ли сам чинио неправду, више нећу.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Хоће ли ти по твоме узвратити",
            "poem": 1
          },
          {
            "text": "јер ти ово одбијаш?",
            "poem": 2
          },
          {
            "text": "Али ти бираш, а не ја,",
            "poem": 1
          },
          {
            "text": "па сада говори оно што знаш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Разумни људи ће ми рећи,",
            "poem": 1
          },
          {
            "text": "а и човек мудар што ме слуша:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "’Немудро збори Јов!",
            "poem": 1
          },
          {
            "text": "Без поуке су његове речи!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "О, да би довека Јов кушан био",
            "poem": 1
          },
          {
            "text": "кад већ одговара као један од покварењака!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Јер је греху своме и преступ додао,",
            "poem": 1
          },
          {
            "text": "међу нама он пљеска рукама",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и речима многим обасипа Бога.“",
            "poem": 2
          }
        ]
      }
    ],
