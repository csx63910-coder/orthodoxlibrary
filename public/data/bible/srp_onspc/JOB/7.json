  },
  "chapter": {
    "number": 7,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Не кулучи ли људски род на земљи",
            "poem": 1
          },
          {
            "text": "и нису ли му дани као дани најамникови?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Као слуга што уздише за хладом",
            "poem": 1
          },
          {
            "text": "и као најамник што чезне за надницом својом,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "тако су и мени додељени месеци бесмисла,",
            "poem": 1
          },
          {
            "text": "тегобне су ми ноћи одређене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ако легнем, кажем: ’Кад ћу да устанем?’",
            "poem": 1
          },
          {
            "text": "Одужи се ноћ, додија ми",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и преврћем се до зоре.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Тело ми се у црве и скорено блато обукло,",
            "poem": 1
          },
          {
            "text": "кожа ми је крастава и гнојна.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Дани моји прохујаше брже него ткање на разбоју,",
            "poem": 1
          },
          {
            "text": "до краја се одмотала нада.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Присети се да ми је живот дашак,",
            "poem": 1
          },
          {
            "text": "да ми очи више неће гледати добра!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Више ме неће гледати око које ме је гледало.",
            "poem": 1
          },
          {
            "text": "Твоје ће ме очи потражити",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "али мене више бити неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Као што се облак расплине, нестане,",
            "poem": 1
          },
          {
            "text": "тако се не диже онај што у Свет мртвих",
            "poem": 2
          },
          {
            "noteId": 1
          },
          {
            "text": "сиђе;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "не враћа се више кући својој,",
            "poem": 1
          },
          {
            "text": "завичај га његов више не познаје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Тако ни ја нећу више да затварам уста своја.",
            "poem": 1
          },
          {
            "text": "Завапићу у тескоби духа свога,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јадаћу се у чемеру душе своје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Шта сам ја то – море или морска неман –",
            "poem": 1
          },
          {
            "text": "да си стражу око мене поставио?!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Јер кад кажем: ’Постеља ће моја да утеши мене,",
            "poem": 1
          },
          {
            "text": "мој ће лежај да олакша жалопојке моје’,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "ти сновима тад ме плашиш,",
            "poem": 1
          },
          {
            "text": "престрављујеш виђењима;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "па су ми и вешала дража",
            "poem": 1
          },
          {
            "text": "и смрт више него живот.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Смучило ми се!",
            "poem": 1
          },
          {
            "text": "Па нећу ја довека да живим!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Прођи ме се, јер су дашак дани моји!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Па шта је човек да га тако уздижеш,",
            "poem": 1
          },
          {
            "text": "да ти је за срце прирастао;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "да се бавиш њиме из јутра у јутро,",
            "poem": 1
          },
          {
            "text": "да га сваког трена искушаваш?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Докле?! Нећеш ли да скренеш свој поглед са мене?",
            "poem": 1
          },
          {
            "text": "Нећеш ли ме пустити насамо, док пљувачку ја своју прогутам?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Све и да сам сагрешио,",
            "poem": 1
          },
          {
            "text": "шта сам теби учинио, о, чувару људи?!",
            "poem": 2
          },
          {
            "text": "Зашто си ме себи ко мету ставио,",
            "poem": 1
          },
          {
            "text": "па сам ти постао терет?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Што ми не би преступ опростио",
            "poem": 1
          },
          {
            "text": "и кривицу моју мимоишао?",
            "poem": 2
          },
          {
            "text": "Јер, ја ћу лећи у прашину,",
            "poem": 1
          },
          {
            "text": "па кад ме потражиш –",
            "poem": 2
          },
          {
            "text": "мене више бити неће.“",
            "poem": 3
          }
        ]
      }
    ],
