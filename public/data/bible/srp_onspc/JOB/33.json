  "book": {
    "id": "JOB",
    "translationId": "srp_onspc",
    "name": "Књига о Јову",
    "commonName": "Књига о Јову",
    "title": "Књига о Јову",
    "order": 18,
    "numberOfChapters": 42,
    "sha256": "06b5a0909a72d6176f6b8d8ebef5ecc2bfb265f5829f37c46298f8075bdf4bb8",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/JOB/1.json",
    "lastChapterNumber": 42,
    "lastChapterApiLink": "/api/srp_onspc/JOB/42.json",
    "totalNumberOfVerses": 1070
  },
  "chapter": {
    "number": 33,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Зато, о, Јове, молим те чуј моја казивања",
            "poem": 1
          },
          {
            "text": "и све речи моје послушај!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Молим те, види, јер отварам уста своја",
            "poem": 1
          },
          {
            "text": "да мој језик проговори.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Из честитости мога срца су речи моје",
            "poem": 1
          },
          {
            "text": "и по знању моја ће уста искрено да говоре.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Елем, Божији Дух ме је саздао,",
            "poem": 1
          },
          {
            "text": "дах Свемоћнога живот ми је дао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Па ако си кадар, ти ми одговори;",
            "poem": 1
          },
          {
            "text": "спреми се, па пред мене стани.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Знај, и ја сам пред Богом попут тебе;",
            "poem": 1
          },
          {
            "text": "и ја сам од иловаче обликован.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Нека те ништа у мени ужасно не плаши,",
            "poem": 1
          },
          {
            "text": "од мене нећеш бити притиснут тешко.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Дакле, говорио си на моје уши,",
            "poem": 1
          },
          {
            "text": "речи сам твоје јасно чуо:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "’Ја сам чист, без греха сам и без мане!",
            "poem": 1
          },
          {
            "text": "У мени кривице нема!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Али, ето, Бог задевицу са мном тражи,",
            "poem": 1
          },
          {
            "text": "гледа ме ко душманина свога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ноге моје у окове ставља",
            "poem": 1
          },
          {
            "text": "па надгледа све путеве моје.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Али ја ћу да ти кажем – ниси у праву –",
            "poem": 1
          },
          {
            "text": "јер Бог је од човека већи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Зашто се убеђујеш с Богом",
            "poem": 1
          },
          {
            "text": "када он не одговара на сваку човекову реч?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Јер Бог говори једном овако, други пут онако –",
            "poem": 1
          },
          {
            "text": "али нико за то не пази –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "у сну, у виђењу ноћном,",
            "poem": 1
          },
          {
            "text": "када дубок сан на људе пада",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "док спавају на постељи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Тада он даје објаву људима,",
            "poem": 1
          },
          {
            "text": "упозорава их опоменама;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "да би човека одвратио од недела",
            "poem": 1
          },
          {
            "text": "и сакрио охолост од њега.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Он му душу чува од раке,",
            "poem": 1
          },
          {
            "text": "живот његов од мача што сече.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Човека болом кори на постељи његовој,",
            "poem": 1
          },
          {
            "text": "без престанка жигају га кости.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Живот му се гади хлеба,",
            "poem": 1
          },
          {
            "text": "а душа омиљеног јела.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Наочиглед тело му пропада,",
            "poem": 1
          },
          {
            "text": "још му штрче кости огољене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Душа му је све ближа раки,",
            "poem": 1
          },
          {
            "text": "а живот веснику смрти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Кад би било посланика,",
            "poem": 1
          },
          {
            "text": "посредника једног од хиљаду,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да човеку јави пут његове честитости,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "кад би му се Бог смиловао, па рекао:",
            "poem": 1
          },
          {
            "text": "’Спасите га од пада у раку!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Нашао сам откуп!’;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "тад би му се ко детету подмладило тело,",
            "poem": 1
          },
          {
            "text": "вратио би се у дане младалачке снаге.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Тад ће се молити Богу и он ће га прихватити,",
            "poem": 1
          },
          {
            "text": "гледаће лице његово и клицаће.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Бог ће обновити човеку праведност његову.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "А он погледаће људе и казаће:",
            "poem": 1
          },
          {
            "text": "’Грешио сам, правду извртао,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "али ми није враћено по мери!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Он је душу моју откупио од пада у раку,",
            "poem": 1
          },
          {
            "text": "да ми живот светла види!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Ето, све ово Бог чини двапут,",
            "poem": 1
          },
          {
            "text": "трипут са човеком;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "да му душу из раке поврати",
            "poem": 1
          },
          {
            "text": "и обасја светлошћу живота.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Јове! Пази, саслушај ме!",
            "poem": 1
          },
          {
            "text": "Ти ћути, а ја ћу да причам.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Реци ако имаш речи да ми узвратиш,",
            "poem": 1
          },
          {
            "text": "јер бих хтео да те оправдам.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Ако немаш, ти саслушај мене.",
            "poem": 1
          },
          {
            "text": "Ћути, да те мудрошћу поучим.“",
            "poem": 2
          }
        ]
      }
    ],
