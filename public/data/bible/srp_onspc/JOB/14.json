  },
  "chapter": {
    "number": 14,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Човек рођен од жене кратко живи",
            "poem": 1
          },
          {
            "text": "и пун је невоља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Изникне као цвет, па свене;",
            "poem": 1
          },
          {
            "text": "бежи попут сене и не траје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Зар на таквог поглед свој обраћаш",
            "poem": 1
          },
          {
            "text": "и мене пред себе на суд доводиш!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ко ће чистим нечисто да учини?",
            "poem": 1
          },
          {
            "text": "Нико!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Његови су дани одређени,",
            "poem": 1
          },
          {
            "text": "ти познајеш број његових месеци;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "међе си му поставио да их не прелази.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Скрени поглед с њега, па нека одахне,",
            "poem": 1
          },
          {
            "text": "док као најамник свој дан не одради.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Јер постоји нада и за дрво посечено;",
            "poem": 1
          },
          {
            "text": "поново ће да изникне",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и неће остати без младица својих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Нек му се и корен у земљи спаруши",
            "poem": 1
          },
          {
            "text": "и пањ му се у земљи сасуши;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "пропупеће чим осети воду,",
            "poem": 1
          },
          {
            "text": "пустиће изданке као да је засад!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "А човек скончава онемоћао;",
            "poem": 1
          },
          {
            "text": "издахне смртник, и где је он?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Из мора исхлапи вода,",
            "poem": 1
          },
          {
            "text": "а поток пресахне, пресуши;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "тако и човек легне да више не устане;",
            "poem": 1
          },
          {
            "text": "док небеса не буде било не буде се,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "не дижу се људи из сна њиховога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "О, када би ме у Свет мртвих сакрио,",
            "poem": 1
          },
          {
            "text": "склонио ме док гнев твој не мине;",
            "poem": 2
          },
          {
            "text": "када би ми поставио рок",
            "poem": 1
          },
          {
            "text": "и тад ме се сетио!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ал’ кад човек умре, да ли више живи?",
            "poem": 1
          },
          {
            "text": "Кроз све дане свог кулучења,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ја чекаћу да ми стигне смена.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ти ћеш ме позвати и ја ћу се одазвати,",
            "poem": 1
          },
          {
            "text": "зажелећеш дело руку својих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Тада ћеш ми кораке бројати,",
            "poem": 1
          },
          {
            "text": "на мој грех се нећеш освртати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Преступ си мој свезао у врећу,",
            "poem": 1
          },
          {
            "text": "кривицу си моју избелио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Али као што се гора руши, одрања се,",
            "poem": 1
          },
          {
            "text": "као што се камен са свог места сваља;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "ко што воде раздробе камење",
            "poem": 1
          },
          {
            "text": "и бујице тло исперу,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и ти тако уништаваш човекову наду.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Једном засвагда ти га надвладаваш и он одлази,",
            "poem": 1
          },
          {
            "text": "лице му мењаш и отпушташ га.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "И он не зна да ли су му синови у части,",
            "poem": 1
          },
          {
            "text": "и не види ако су незнатни.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Само му је тело у болу своме,",
            "poem": 1
          },
          {
            "text": "само му душа за собом пати.“",
            "poem": 2
          }
        ]
      }
    ],
