  },
  "chapter": {
    "number": 17,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Мој дух је сатрвен,",
            "poem": 1
          },
          {
            "text": "дани су моји згасли",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и рака ме чека.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ето, подсмевачи су са мном,",
            "poem": 1
          },
          {
            "text": "не склапа се око моје због њихове свадљивости.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Молим те, Боже, ти сам јамац мој буди!",
            "poem": 1
          },
          {
            "text": "Јер ко је тај ко би ми се прихватио руке?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ти си склонио мудрост од њихових срца",
            "poem": 1
          },
          {
            "text": "због чега их издигнути нећеш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ко због добити изда пријатеље,",
            "poem": 1
          },
          {
            "text": "деци ће му очи усахнути!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Он је мене учинио причом за народе,",
            "poem": 1
          },
          {
            "text": "ја сам лице за пљување.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Туга ми је очи замутила,",
            "poem": 1
          },
          {
            "text": "сваки је мој уд попут сенке.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Због тога се праведници зграну,",
            "poem": 1
          },
          {
            "text": "недужни се грозе над безбожним.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Али праведник ће истрајати на свом путу,",
            "poem": 1
          },
          {
            "text": "још више ће ојачати човек чистих руку.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Хајде, вратите се сви ви!",
            "poem": 1
          },
          {
            "text": "Дођите, молим вас,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "али мудрог међу вама нећу наћи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Прохујали су моји дани,",
            "poem": 1
          },
          {
            "text": "намере и жеље срца мога су разбијене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Они праве дан од ноћи,",
            "poem": 1
          },
          {
            "text": "а мраку у лице кажу:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "’Светло је близу!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ако бих за Светом мртвих чезнуо као за домом својим",
            "poem": 1
          },
          {
            "text": "и у тами постељу своју простро,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "ако гробу викнем: ’Оче мој’,",
            "poem": 1
          },
          {
            "text": "а црву: ’Мајко моја’ или ’сестро моја’,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "где је онда нада моја?!",
            "poem": 1
          },
          {
            "text": "Види ли ко наду моју?!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Силази ли она до врата Света мртвих?",
            "poem": 1
          },
          {
            "text": "Заједно ли ћемо у прах лећи?“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
