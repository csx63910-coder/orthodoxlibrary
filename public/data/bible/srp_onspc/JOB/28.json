  "chapter": {
    "number": 28,
    "content": [
      {
        "type": "heading",
        "content": [
          "Где је мудрост?"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ето, и сребро има свој рудник,",
            "poem": 1
          },
          {
            "text": "и злато место на ком се испира.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "И гвожђе се из земље узима",
            "poem": 1
          },
          {
            "text": "и камен се претапа у бронзу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "А човек таму докрајчује,",
            "poem": 1
          },
          {
            "text": "истражује до крајњих граница,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "тражи руду у тами најгушћој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Окно копа далеко од ближњег",
            "poem": 1
          },
          {
            "text": "где нога не залази,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "пење се и клати далеко од људи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Земља са које хлеб долази",
            "poem": 1
          },
          {
            "text": "изнутра се ковитла ко ватра.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "У њеним је стенама налазиште сафира,",
            "poem": 1
          },
          {
            "text": "а има и златне прашине.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Пут до тамо не зна птица грабљивица,",
            "poem": 1
          },
          {
            "text": "око соколово траг му не назире.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Поносне се звери њиме не шуњају,",
            "poem": 1
          },
          {
            "text": "а ни лав по њему не пролази.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Човек пружа руку за кременом,",
            "poem": 1
          },
          {
            "text": "прекопава корење планина;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "у стенама тунеле пробија",
            "poem": 1
          },
          {
            "text": "и очима види сваку вредност;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "обуздава цурење вода",
            "poem": 1
          },
          {
            "text": "и оно скривено на светло износи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Али где се мудрост проналази?",
            "poem": 1
          },
          {
            "text": "Где је место разборитости?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Род јој људски вредност не познаје,",
            "poem": 1
          },
          {
            "text": "не проналази се у земљи живих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Тек, бездан јавља: ’У мени није!’",
            "poem": 1
          },
          {
            "text": "и море каже: ’Није ни са мном!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Суво злато за њу се не даје,",
            "poem": 1
          },
          {
            "text": "за цену њену сребро се не мери.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Не плаћа се ни златом офирским,",
            "poem": 1
          },
          {
            "text": "ни скупоценим ониксом и сафиром.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Нису јој равни ни злато ни кристал,",
            "poem": 1
          },
          {
            "text": "за ћуп сувог злата не трампи се она.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Корале и јаспис и не спомињите,",
            "poem": 1
          },
          {
            "text": "од бисера мудрост је вреднија.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Не мери се са њом ни топаз из Куша,",
            "poem": 1
          },
          {
            "text": "ни сувим се златом платити не може.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Па одакле онда долази мудрост?",
            "poem": 1
          },
          {
            "text": "Где је место разборитости?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Од очију свега живог је склоњена,",
            "poem": 1
          },
          {
            "text": "од небеских птица је скривена.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Трулеж мртвих и смрт нам казују:",
            "poem": 1
          },
          {
            "text": "’Ушима смо својим чули казивање о њој.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Бог разуме пут до ње",
            "poem": 1
          },
          {
            "text": "и познаје њено место,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "јер он види до крајева земље",
            "poem": 1
          },
          {
            "text": "и он гледа испод свих небеса.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Кад је ветру подарио снагу",
            "poem": 1
          },
          {
            "text": "и мерама премерио воде;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "кад је киши одредбу давао",
            "poem": 1
          },
          {
            "text": "и муње олујама;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "тада ју је погледао, објавио, поставио,",
            "poem": 1
          },
          {
            "text": "тада ју је проверио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "А људима је рекао:",
            "poem": 1
          },
          {
            "text": "’Ево, мудрост је у богобојазности",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а разборитост у уклањању од зла!’“",
            "poem": 2
          }
        ]
      }
    ],
