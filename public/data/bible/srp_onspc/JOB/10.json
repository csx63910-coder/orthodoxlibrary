  },
  "chapter": {
    "number": 10,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Души ми се живот огадио!",
            "poem": 1
          },
          {
            "text": "Над собом ћу жалопојком зажалити,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јадаћу се у чемеру душе своје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Богу ћу рећи: ’Не осуђуј ме!",
            "poem": 1
          },
          {
            "text": "Објави ми за шта ме оптужујеш",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Зар ти је мило да тлачиш,",
            "poem": 1
          },
          {
            "text": "да одбациш дело својих руку,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а да се смешиш над наумом зликовачким?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Зар ти имаш очи човекове,",
            "poem": 1
          },
          {
            "text": "па да видиш то што људи гледају?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Јесу ли ти дани смртникови дани",
            "poem": 1
          },
          {
            "text": "и године твоје као век човека;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "па кривице моје испитујеш",
            "poem": 1
          },
          {
            "text": "и за грехом мојим трагаш?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "А ти знаш да кривац нисам,",
            "poem": 1
          },
          {
            "text": "да из твоје руке избављења нема!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Уобличише ме твоје руке, саздаше ме,",
            "poem": 1
          },
          {
            "text": "а ти ме прождиреш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Сети се, молим те,",
            "poem": 1
          },
          {
            "text": "да си ме ко глину створио,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "па зар ћеш у прашину да ме вратиш?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ниси ли ме ко млеко излио",
            "poem": 1
          },
          {
            "text": "и згрушао попут сира?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ниси ли ме обукао у кожу и месо;",
            "poem": 1
          },
          {
            "text": "ниси ли ме изаткао костима и венама?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Дао си ми и живот и милост,",
            "poem": 1
          },
          {
            "text": "својим си старањем дух ми очувао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Али, све ове ствари си сакрио у срцу своме,",
            "poem": 1
          },
          {
            "text": "и знам да је то било у теби!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ако бих и згрешио, ти би бдео нада мном;",
            "poem": 1
          },
          {
            "text": "не би ме помиловао због кривице моје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ако сам био злотвор, јао мени!",
            "poem": 1
          },
          {
            "text": "Ако сам био праведан, главу своју уздизао нисам.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Али ја се давим у срамоти",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и свестан сам беде своје!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Уздигнем ли се, као лав ме ловиш",
            "poem": 1
          },
          {
            "text": "и поново на мени величанство своје показујеш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Против мене нове сведоке доводиш,",
            "poem": 1
          },
          {
            "text": "љутиш се на мене све више",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и војску за војском против мене шаљеш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Зашто си ме извадио из мајчиног крила?",
            "poem": 1
          },
          {
            "text": "Да сам барем издахнуо, да ме око угледало није!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Био бих као да ме никад није било,",
            "poem": 1
          },
          {
            "text": "од мајчиног крила до гроба би ме однели.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Зар моји дани нису малобројни?",
            "poem": 1
          },
          {
            "text": "Доста више! Прођи ме се,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "дај ми да се мало развеселим;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "пре него одем у земљу неповрата,",
            "poem": 1
          },
          {
            "text": "ноћи и мрака најгушћег;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "у земљу крајње таме,",
            "poem": 1
          },
          {
            "text": "дубоког црнила и нереда,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "где је и светло као потпуни мрак.’“",
            "poem": 2
          }
        ]
      }
    ],
