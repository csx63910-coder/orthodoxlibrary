    "order": 58,
    "numberOfChapters": 13,
    "sha256": "fa2277a6a2a91af834e6d99e28225c7141840b200cd5a20e008ba447b09e36a7",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/HEB/1.json",
