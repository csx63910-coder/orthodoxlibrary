    "name": "2. Коринћанима",
    "commonName": "2. Коринћанима",
    "title": "Друга посланица Коринћанима",
    "order": 47,
    "numberOfChapters": 13,
    "sha256": "ee156e2e424f91be2d6addc8c1205d8202d56fb198335e6b3e7caec2eef9a0c6",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/2CO/1.json",
