    "lastChapterApiLink": "/api/srp_onspc/1TH/5.json",
    "totalNumberOfVerses": 89
  },
  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "heading",
        "content": [
          "Будите спремни за Господњи долазак"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "А што се тиче времена и часа, о томе нема потребе да вам се пише."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Ви, наиме, врло добро знате да ће дан Господњи доћи као што лопов долази ноћу."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Кад људи буду говорили: „Мир и сигурност“, тада ће их изненада задесити пропаст, као трудови трудницу, и неће моћи да побегну."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Али ви, браћо, нисте у тами да би вас овај дан затекао као лопов,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "јер ви сте сви синови светла и синови дана. Ми не припадамо тами и ноћи."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Зато не спавајмо као други, већ бдијмо и будимо трезни."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Јер, они који спавају, ноћу спавају, и који се опијају, ноћу се опијају."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Али, пошто припадамо дану, будимо трезни, обучени у оклоп вере и љубави и с кацигом наде на спасење."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Бог нас, наиме, није одредио да искусимо гнев, већ да добијемо спасење посредством нашег Господа Исуса Христа."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Он је умро за нас да бисмо ми са њим живели, било да смо још живи или смо већ умрли."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Зато, бодрите једни друге и изграђујте се међусобно, као што то већ и чините."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Последња упутства и поздрави"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Молимо вас, браћо, да поштујете оне који се труде међу вама, оне који вас, по Господњој вољи, воде и опомињу."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Цените их изнад свега и волите због службе коју обављају. Живите међу собом у миру."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Заклињемо вас, браћо, опомињите неуредне, бодрите малодушне, помажите слабима, будите стрпљиви са сваким."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Гледајте да нико никоме не враћа зло за зло, него се увек трудите да чините добро једни другима и свима."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Увек се радујте!"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Молите се без престанка!"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Захваљујте на свему, јер је то Божија воља за вас у Христу Исусу."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Не спутавајте Духа."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Не презирите пророштва,"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "него све проверавајте, па што је добро, задржите."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Клоните се сваког зла."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "А Бог мира нека доврши ваше посвећење, те да се цело ваше биће – дух, душа и тело – сачувају беспрекорним за долазак Господа нашег Исуса Христа."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Веран је Бог који вас позива, он ће то и учинити."
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Браћо, молите се за нас."
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Поздравите сву браћу светим пољупцем."
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Заклињем вас пред Господом да прочитате ову посланицу свој браћи."
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Милост Господа нашега Исуса Христа с вама!"
        ]
      }
    ],
