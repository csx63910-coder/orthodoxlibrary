    "name": "1. Солуњанима",
    "commonName": "1. Солуњанима",
    "title": "Прва посланица Солуњанима",
    "order": 52,
    "numberOfChapters": 5,
    "sha256": "e3cab1b0500b60c15058e7d758a50c5b572508901a6971316dcfa42eb8ef6114",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/1TH/1.json",
