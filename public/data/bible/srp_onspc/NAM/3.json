  },
  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "heading",
        "content": [
          "Јао Ниниви"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Јао граду крволочном!",
            "poem": 1
          },
          {
            "text": "Пун је обмане,",
            "poem": 2
          },
          {
            "text": "пун је отимачине,",
            "poem": 1
          },
          {
            "text": "у њему плена нема да нема.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Фијуче бич",
            "poem": 1
          },
          {
            "text": "и тутње точкови,",
            "poem": 2
          },
          {
            "text": "коњи су у галопу,",
            "poem": 1
          },
          {
            "text": "а бојна кола поскакују.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Коњаници јуре",
            "poem": 1
          },
          {
            "text": "док мач сева",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и копље блешти.",
            "poem": 2
          },
          {
            "text": "Ено мноштва покланих,",
            "poem": 1
          },
          {
            "text": "нема мере тежини лешева,",
            "poem": 2
          },
          {
            "text": "побијенима нема броја",
            "poem": 1
          },
          {
            "text": "и људи се о мртве саплићу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "А то је због многих блудништава блуднице,",
            "poem": 1
          },
          {
            "text": "заносне и веште у врачању,",
            "poem": 2
          },
          {
            "text": "која продаје народе својим блудничењем",
            "poem": 1
          },
          {
            "text": "и племена својим врачањима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "„Ево ме против тебе – говори Господ над војскама –",
            "poem": 1
          },
          {
            "text": "да ти преко лица задигнем скутове,",
            "poem": 2
          },
          {
            "text": "да народима покажем твоју голотињу",
            "poem": 1
          },
          {
            "text": "и царствима твоју срамоту.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Гадости ћу бацити на вас,",
            "poem": 1
          },
          {
            "text": "презрећу вас",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и учинити призором у који се зури.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Побећи ће од тебе сви који те буду гледали.",
            "poem": 1
          },
          {
            "text": "Рећи ће: ’Опустошена је Нинива!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ко ће да је пожали?’",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Где да ти нађем утешитеље?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Зар си ти боља од Но-Амона",
            "poem": 1
          },
          {
            "text": "што пребива на водама Нила,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "окружен водама,",
            "poem": 2
          },
          {
            "text": "коме је море било бедем",
            "poem": 1
          },
          {
            "text": "и коме су море зидине биле.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Куш му је био снага, Египат коме краја није било,",
            "poem": 1
          },
          {
            "text": "а Фути и Лувимани су му помагали.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ипак је отишла у изгнанство, у ропство.",
            "poem": 1
          },
          {
            "text": "А и децу су јој смрскали",
            "poem": 2
          },
          {
            "text": "по угловима свих улица.",
            "poem": 3
          },
          {
            "text": "За њихове су племиће бацали жреб,",
            "poem": 1
          },
          {
            "text": "великаше су им оковали ланцима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "И још ћеш бити пијана и сакривена,",
            "poem": 1
          },
          {
            "text": "тражићеш заклон пред непријатељем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Сва утврђења твоја су смокве",
            "poem": 1
          },
          {
            "text": "са првим зрелим плодовима који,",
            "poem": 2
          },
          {
            "text": "протресу ли се,",
            "poem": 1
          },
          {
            "text": "падају у уста оног ко би да их једе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ево, твој је народ",
            "poem": 1
          },
          {
            "text": "попут жена усред тебе.",
            "poem": 2
          },
          {
            "text": "Врата твоје земље ће се широм отворити непријатељима твојим.",
            "poem": 1
          },
          {
            "text": "Твоје ће решетке ватра да прогута.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Нахватај себи воде за опсаду!",
            "poem": 1
          },
          {
            "text": "Ојачај своја утврђења!",
            "poem": 2
          },
          {
            "text": "Иди, гацај у глини,",
            "poem": 1
          },
          {
            "text": "прави цигле у калупима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Тамо ће те ватра прогутати,",
            "poem": 1
          },
          {
            "text": "мач ће те сасећи,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "прождраће те као скакавац.",
            "poem": 2
          },
          {
            "text": "Намножи се попут скакаваца!",
            "poem": 1
          },
          {
            "text": "Намножи се попут гусеница!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Умножила си своје трговце",
            "poem": 1
          },
          {
            "text": "да их је више од звезда на небу,",
            "poem": 2
          },
          {
            "text": "а они су скакавци што су се излегли",
            "poem": 1
          },
          {
            "text": "и одлетели.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Твоји стражари су као гусенице,",
            "poem": 1
          },
          {
            "text": "твоје војсковође као рој скакаваца",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "што се роје на зидинама по хладном дану.",
            "poem": 2
          },
          {
            "text": "А када сунце гране, они одлете",
            "poem": 1
          },
          {
            "text": "и не зна се место на коме су?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Поспани су твоји пастири, о, царе асирски!",
            "poem": 1
          },
          {
            "text": "Дворани твоји дремају,",
            "poem": 2
          },
          {
            "text": "твој је народ раштркан по горама",
            "poem": 1
          },
          {
            "text": "и нема ко да их окупи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Страдању твоме нема лека.",
            "poem": 1
          },
          {
            "text": "Опака је твоја рана.",
            "poem": 2
          },
          {
            "text": "Сви који чују вест о теби",
            "poem": 1
          },
          {
            "text": "пљескају длановима над тобом,",
            "poem": 2
          },
          {
            "text": "јер кога није захватила",
            "poem": 1
          },
          {
            "text": "твоја истрајна злоба?",
            "poem": 2
          }
        ]
      }
    ],
