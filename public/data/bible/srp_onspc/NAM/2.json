  "book": {
    "id": "NAM",
    "translationId": "srp_onspc",
    "name": "Књига пророка Наума",
    "commonName": "Књига пророка Наума",
    "title": "Књига пророка Наума",
    "order": 34,
    "numberOfChapters": 3,
    "sha256": "10cfa82498b471ecb0f075ed736ec2f23ecc716b476b245834e57de021f107bf",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/NAM/1.json",
    "lastChapterNumber": 3,
    "lastChapterApiLink": "/api/srp_onspc/NAM/3.json",
    "totalNumberOfVerses": 47
  },
  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "heading",
        "content": [
          "Нинива ће пасти"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Пред тебе је стао онај што те расејава!",
            "poem": 1
          },
          {
            "text": "Чувај утврђење,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "пази на пут,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "учврсти бедра,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "окрепи сасвим своју снагу!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Јер, Господ ће да обнови Јаковљев понос",
            "poem": 1
          },
          {
            "text": "као славу Израиља,",
            "poem": 2
          },
          {
            "text": "премда су их опустошили душмани",
            "poem": 1
          },
          {
            "text": "и посекли им лозе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Црвен је штит ратника његових,",
            "poem": 1
          },
          {
            "text": "јунаци су обучени у скерлет,",
            "poem": 2
          },
          {
            "text": "сијају метални окови бојних кола,",
            "poem": 1
          },
          {
            "text": "а у дану кад се спреми",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и чемпреси се тресу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "По улицама махнитају бојна кола,",
            "poem": 1
          },
          {
            "text": "вршљају по трговима,",
            "poem": 2
          },
          {
            "text": "изгледају као бакље,",
            "poem": 1
          },
          {
            "text": "галопирају као муње.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Сетиће се својих војсковођа",
            "poem": 1
          },
          {
            "text": "који ће се спотицати на својим маршевима,",
            "poem": 2
          },
          {
            "text": "журити њеним зидинама",
            "poem": 1
          },
          {
            "text": "и већ спремној барикади.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Уставе ће се отворити",
            "poem": 1
          },
          {
            "text": "и двор ће се подлокати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Тако је урађено:",
            "poem": 1
          },
          {
            "text": "разоткривена је и одведена.",
            "poem": 2
          },
          {
            "text": "Њене слушкиње запевају,",
            "poem": 1
          },
          {
            "text": "пијучу као голубице, у прса се туку.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Као језеро је Нинива још од првих дана,",
            "poem": 1
          },
          {
            "text": "али они сада беже.",
            "poem": 2
          },
          {
            "text": "„Станите! Станите!“",
            "poem": 1
          },
          {
            "text": "Али нико се окренуо није.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Отимајте сребро!",
            "poem": 1
          },
          {
            "text": "Отимајте злато!",
            "poem": 2
          },
          {
            "text": "Нема мере залихама",
            "poem": 1
          },
          {
            "text": "и обиљу сваке драгоцене ствари.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Опустело, похарано и ојађено!",
            "poem": 1
          },
          {
            "text": "Топе се срца, клецају колена и бедра сва,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "свима су смркнута лица.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Где је лавља јазбина,",
            "poem": 1
          },
          {
            "text": "где брлог за лавиће?",
            "poem": 2
          },
          {
            "text": "Где су ишли лав, лавица и младунче,",
            "poem": 1
          },
          {
            "text": "а да их нико плашио није?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Лав је ловио довољно за младунце,",
            "poem": 1
          },
          {
            "text": "давио плен за своје лавице,",
            "poem": 2
          },
          {
            "text": "своју пећину пунио пленом",
            "poem": 1
          },
          {
            "text": "и свој брлог месом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "„Ево ме против тебе",
            "poem": 1
          },
          {
            "text": "– говори Господ над војскама –",
            "poem": 2
          },
          {
            "text": "да твоја бојна кола претворим у дим.",
            "poem": 1
          },
          {
            "text": "Мач ће да поједе лавиће твоје",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и твој ћу плен да истребим из земље.",
            "poem": 2
          },
          {
            "text": "Повик гласника твојих",
            "poem": 1
          },
          {
            "text": "више се неће чути.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
