  "book": {
    "id": "NAM",
    "translationId": "srp_onspc",
    "name": "Књига пророка Наума",
    "commonName": "Књига пророка Наума",
    "title": "Књига пророка Наума",
    "order": 34,
    "numberOfChapters": 3,
    "sha256": "10cfa82498b471ecb0f075ed736ec2f23ecc716b476b245834e57de021f107bf",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/NAM/1.json",
