  },
  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Пророштво о Ниниви. Књига виђења Наума из Елкоша."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Господњи гнев против Ниниве"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Бог је љубоморан и освећује се Господ.",
            "poem": 1
          },
          {
            "text": "Он је Господ освете и господар гнева.",
            "poem": 2
          },
          {
            "text": "Господ се свети својим душманима",
            "poem": 1
          },
          {
            "text": "и гаји гнев према својим непријатељима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Господ се споро гневи, велике је силе,",
            "poem": 1
          },
          {
            "text": "али кривца нипошто не оставља некажњена.",
            "poem": 2
          },
          {
            "text": "У олујном ветру, у вихору пут је његов",
            "poem": 1
          },
          {
            "text": "и облак му је прашина под ногама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Кад море прекори, он га исушује",
            "poem": 1
          },
          {
            "text": "и све реке чини сувим.",
            "poem": 2
          },
          {
            "text": "Вену Васан и Кармил,",
            "poem": 1
          },
          {
            "text": "вене цват Ливана.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Због њега се горе тресу,",
            "poem": 1
          },
          {
            "text": "а брегови растачу.",
            "poem": 2
          },
          {
            "text": "Земља се пред њим подиже",
            "poem": 1
          },
          {
            "text": "и сав свет и сви који на њему живе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ко да стоји пред гневом његовим?",
            "poem": 1
          },
          {
            "text": "Ко да издржи пламен срдње његове?",
            "poem": 2
          },
          {
            "text": "Јер гнев се његов излио као лава",
            "poem": 1
          },
          {
            "text": "и стене се пред њим дробе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Господ је добар,",
            "poem": 1
          },
          {
            "text": "заштита је у дану невоље",
            "poem": 2
          },
          {
            "text": "и познаје оне што у њему уточиште траже.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Он ће силном поплавом",
            "poem": 2
          },
          {
            "text": "да докрајчи Ниниву,",
            "poem": 1
          },
          {
            "text": "а своје ће душмане у мрак да одагна.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Шта год да сплеткарите против Господа,",
            "poem": 1
          },
          {
            "text": "он ће то да докрајчи.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Невоља се неће подигнути двапут.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Нека су и као трње сплетени",
            "poem": 1
          },
          {
            "text": "и као пијани од свог пића,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "прогутани биће сасвим ко стрњика сува.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Од тебе ће доћи онај",
            "poem": 1
          },
          {
            "text": "који сплеткари зло против Господа,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "опаки саветник.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Овако каже Господ:",
          {
            "text": "„Иако су Асирци и сложни и иако бројни,",
            "poem": 1
          },
          {
            "text": "и такви биће сасечени и изгажени.",
            "poem": 2
          },
          {
            "text": "А ја сам те тлачио, народе мој,",
            "poem": 1
          },
          {
            "text": "али те више тлачити нећу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ево, сада ћу да скршим његов јарам на теби,",
            "poem": 1
          },
          {
            "text": "изломићу твоје окове.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Господ је заповедио против тебе:",
            "poem": 1
          },
          {
            "text": "„Твоје име неће имати потомке.",
            "poem": 2
          },
          {
            "text": "Из куће твојих богова",
            "poem": 1
          },
          {
            "text": "срушићу кипове и ливене идоле.",
            "poem": 2
          },
          {
            "text": "Гроб ти спремам",
            "poem": 1
          },
          {
            "text": "јер си безвредан.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ево, на горама су ноге благовесника",
            "poem": 1
          },
          {
            "text": "који мир објављује!",
            "poem": 2
          },
          {
            "text": "Прослављај, Јудо, празнике своје!",
            "poem": 1
          },
          {
            "text": "Испуни своје завете",
            "poem": 2
          },
          {
            "text": "јер те више неће газити опаки.",
            "poem": 1
          },
          {
            "text": "Сатрће се сасвим.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
