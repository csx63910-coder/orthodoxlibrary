  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "heading",
        "content": [
          "Деворина песма"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Тог дана су Девора и Варак, син Авиноамов, испевали песму:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Зато што су вође израиљске на чело ступиле,",
            "poem": 1
          },
          {
            "text": "зато што се народ вољно одазвао – благосиљајте Господа!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Чујте, цареви, слушајте, владари!",
            "poem": 1
          },
          {
            "text": "Запеваћу Господу, испеваћу песму Господу, Богу Израиљеву.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Кад си силазио са Сира, Господе,",
            "poem": 1
          },
          {
            "text": "кад си ступао са поља едомских,",
            "poem": 2
          },
          {
            "text": "земља се тресла, небеса су пљуштала,",
            "poem": 1
          },
          {
            "text": "облаци су водом запљуштали.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Горе су се тресле",
            "poem": 1
          },
          {
            "noteId": 2
          },
          {
            "text": "пред Господом,",
            "poem": 1
          },
          {
            "text": "пред Господом синајским, Богом Израиљевим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "У дане Самегара, сина Анатова, у дане Јаиле,",
            "poem": 1
          },
          {
            "text": "путеви су опустели, те су путници",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ходали по стазама кривудавим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Села израиљска опустеше,",
            "poem": 1
          },
          {
            "text": "док не устах ја, Девора, док не устах",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да Израиљу будем мајка.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Кад су богове нове бирали,",
            "poem": 1
          },
          {
            "text": "рат им стиже на градске капије.",
            "poem": 2
          },
          {
            "text": "Зар се штит видео у Израиљу,",
            "poem": 1
          },
          {
            "text": "или копље међу четрдесет хиљада?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Срце је моје уз вође Израиљеве,",
            "poem": 1
          },
          {
            "text": "и уз оне што се вољно одазваше.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Благосиљајте Господа!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ви што јашете беле магарице,",
            "poem": 1
          },
          {
            "text": "и седите на простиркама,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ви што путевима ходите,",
            "poem": 2
          },
          {
            "text": "разаберите",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "глас певача код бунара.",
            "poem": 1
          },
          {
            "text": "Тамо они поју о праведним делима Господњим,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "о праведним делима његових мештана у Израиљу.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Тада народ Господњи сиђе к вратима.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Пробуди се, пробуди, Деворо,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "пробуди се и песму запевај!",
            "poem": 2
          },
          {
            "text": "Устани, Вараче, и робље поведи,",
            "poem": 1
          },
          {
            "text": "ти сине Авиноамов!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Шачица је моћни народ надвладала,",
            "poem": 1
          },
          {
            "text": "народ се Господњи сабрао к мени на моћне.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Од Јефрема изађоше они што поникоше међу Амаличанима,",
            "poem": 1
          },
          {
            "text": "за тобом је Венијамин с твојим мноштвима,",
            "poem": 2
          },
          {
            "text": "од Махира су изашли заповедници,",
            "poem": 1
          },
          {
            "text": "а од Завулона они што штап писарски носе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Кнезови су Исахарови са Девором,",
            "poem": 1
          },
          {
            "text": "Исахар се за Вараком у долину сјурио,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "у стопу га је верно пратио.",
            "poem": 2
          },
          {
            "text": "Међу четама Рувимовим,",
            "poem": 1
          },
          {
            "text": "дуго се на одлуку накањују.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Зашто седиш међу торовима?",
            "poem": 1
          },
          {
            "text": "Да чујеш како дозивају стада?",
            "poem": 2
          },
          {
            "text": "Међу четама Рувимовим,",
            "poem": 1
          },
          {
            "text": "дуго се на одлуку накањују.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Галад почива с оне стране Јордана;",
            "poem": 1
          },
          {
            "text": "а што Дан још седи у лађама?",
            "poem": 2
          },
          {
            "text": "Асир седи уз обалу морску,",
            "poem": 1
          },
          {
            "text": "мирно живи у својим лукама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Завулон је народ што се наругао смрти,",
            "poem": 1
          },
          {
            "text": "као и Нефталим са поља високих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Цареви су дошли и ратовали,",
            "poem": 1
          },
          {
            "text": "у бој ступише цареви ханански",
            "poem": 2
          },
          {
            "text": "код Танаха, крај вода мегидских,",
            "poem": 1
          },
          {
            "text": "ал’ се плена – сребра не домогоше.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "С неба су звезде ратовале,",
            "poem": 1
          },
          {
            "text": "са својих су стаза са Сисером ратовале.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Однесе их поток Кисон, поток древни, поток Кисон.",
            "poem": 1
          },
          {
            "text": "Ступај смело, душо моја!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Копита су тад коњска затутњала,",
            "poem": 1
          },
          {
            "text": "у галоп, у галоп ударише пастуви.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "’Проклињите Мероз!’ – рече Анђео Господњи.",
            "poem": 1
          },
          {
            "text": "’Љуто проклињите његове мештане,",
            "poem": 2
          },
          {
            "text": "јер не притекоше у помоћ Господу,",
            "poem": 1
          },
          {
            "text": "не помогоше Господу против моћних.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Благословена нек је Јаила међу женама,",
            "poem": 1
          },
          {
            "text": "жена Хевера Кенејца,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "благословенија нек је од свих жена шатора.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Кад је тражио воде, млека му нали,",
            "poem": 1
          },
          {
            "text": "у зделу кнежевску масла му даде.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Левицом се машила за колац,",
            "poem": 1
          },
          {
            "text": "а десницом за маљ ковачки,",
            "poem": 2
          },
          {
            "text": "па удари Сисеру и главу му смрска,",
            "poem": 1
          },
          {
            "text": "здроби му, проби му слепоочнице.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Код њених ногу сави се и паде,",
            "poem": 1
          },
          {
            "text": "пружио се подно њених ногу,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "где се сави, тамо мртав паде.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Сисерина мајка кроз прозор погледава,",
            "poem": 1
          },
          {
            "text": "кроз решетку она са сузама збори:",
            "poem": 2
          },
          {
            "text": "’Зашто му кола још не пристижу?",
            "poem": 1
          },
          {
            "text": "Зашто топот кола његових касни?’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Најмудрија јој одговара дворкиња,",
            "poem": 1
          },
          {
            "text": "самој себи она одговара:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "’Плен су нашли, па га сада деле,",
            "poem": 1
          },
          {
            "text": "по девојку, па и две на ратника,",
            "poem": 2
          },
          {
            "text": "бојено и исткано за плен Сисери,",
            "poem": 1
          },
          {
            "text": "бојено и исткано, то му је плен,",
            "poem": 2
          },
          {
            "text": "за вратове оних који плене.’",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Тако нек пропадну сви твоји душмани, Господе,",
            "poem": 1
          },
          {
            "text": "као сунце у пуном сјају нека сину који тебе воле!“",
            "poem": 2
          },
          "Земља је била мирна четрдесет година."
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 2,
        "caller": "+",
        "text": "5,5 Овако је према Септуагинти, Таргуму и сиријском рукопису.",
