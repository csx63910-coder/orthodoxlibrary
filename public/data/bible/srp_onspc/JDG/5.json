  "book": {
    "id": "JDG",
    "translationId": "srp_onspc",
    "name": "Књига о судијама",
    "commonName": "Књига о судијама",
    "title": "Књига о судијама",
    "order": 7,
    "numberOfChapters": 21,
    "sha256": "f9d8245b15e12164f0c4e328f2d2570eb20059f34256402624681ab271ac4b35",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/JDG/1.json",
    "lastChapterNumber": 21,
    "lastChapterApiLink": "/api/srp_onspc/JDG/21.json",
