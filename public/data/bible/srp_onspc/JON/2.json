  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "heading",
        "content": [
          "Бог шаље рибу да прогута Јону"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Али Господ посла велику рибу да прогута Јону. Јона је био у утроби рибе три дана и три ноћи."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Тада се Јона помолио Господу, своме Богу, из утробе рибе."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Јонина молитва"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Рекао је:",
          {
            "text": "„Из невоље своје призвах Господа",
            "poem": 1
          },
          {
            "text": "и он ми је одговорио,",
            "poem": 2
          },
          {
            "text": "из утробе Света мртвих",
            "poem": 1
          },
          {
            "noteId": 0
          },
          {
            "text": "завапих,",
            "poem": 1
          },
          {
            "text": "и ти си чуо глас мој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ти си ме бацио у дубине,",
            "poem": 1
          },
          {
            "text": "у средиште мора,",
            "poem": 2
          },
          {
            "text": "бујица ме опколила,",
            "poem": 1
          },
          {
            "text": "сви таласи твоји и вртлози преплавише ме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Помислих: ’Отеран сам од твојих очију,",
            "poem": 1
          },
          {
            "text": "но, опет ћу свети Дом твој гледати.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Воде ми дођоше до грла,",
            "poem": 1
          },
          {
            "text": "бездан ме је окружио,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "траве ми се око главе сплетоше,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "спустих се до темеља горских,",
            "poem": 1
          },
          {
            "text": "заувек се браве земаљске склопише нада мном,",
            "poem": 2
          },
          {
            "text": "али ти си подигао из јаме живот мој,",
            "poem": 1
          },
          {
            "text": "Господе, Боже мој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Кад ми живот на измаку беше,",
            "poem": 1
          },
          {
            "text": "сетих се Господа,",
            "poem": 2
          },
          {
            "text": "и молитва ми допре до Господа,",
            "poem": 1
          },
          {
            "text": "до светога Дома твојега.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Они што се држе ништавних идола,",
            "poem": 1
          },
          {
            "text": "милост Божију себи ускраћују.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Гласом хвалоспевним",
            "poem": 1
          },
          {
            "text": "жртву ћу ти принети,",
            "poem": 2
          },
          {
            "text": "што заветовах, то ћу извршити.",
            "poem": 1
          },
          {
            "text": "Спасење је од Господа!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Тада је Господ заповедио риби, те је она избацила Јону на копно."
        ]
      }
    ],
    "footnotes": [
      {
