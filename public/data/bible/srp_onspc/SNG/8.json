  },
  "chapter": {
    "number": 8,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "О, да си ми као брат био",
            "poem": 1
          },
          {
            "text": "што је груди мајке моје сисао!",
            "poem": 2
          },
          {
            "text": "Нашла бих те на пољу",
            "poem": 1
          },
          {
            "text": "и пољубила те",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и нико ме презирао не би.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Водила бих те",
            "poem": 1
          },
          {
            "text": "и довела у дом мајке своје,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "која ме је подигла.",
            "poem": 2
          },
          {
            "text": "Дала бих ти да попијеш вино зачињено",
            "poem": 1
          },
          {
            "text": "и сок од мога нара.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Левица му је под главом мојом,",
            "poem": 1
          },
          {
            "text": "а десницом ме грли.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ћерке јерусалимске, заклињем вас,",
            "poem": 1
          },
          {
            "text": "не будите и не дижите моју љубав",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "док јој се не прохте.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ко је она што долази из пустиње,",
            "poem": 1
          },
          {
            "text": "наслоњена на вољеног свога?",
            "poem": 2
          },
          "Она",
          {
            "text": "Под јабуком сам те пробудила,",
            "poem": 1
          },
          {
            "text": "тамо где те је мајка твоја родила,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "тамо где те родила у мукама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Стави ме као жиг на срце своје,",
            "poem": 1
          },
          {
            "text": "као прстен на руку своју.",
            "poem": 2
          },
          {
            "text": "Јер љубав је ко смрт јака,",
            "poem": 1
          },
          {
            "text": "а љубомора страшна попут Света мртвих",
            "poem": 2
          },
          {
            "noteId": 3
          },
          {
            "text": ".",
            "poem": 2
          },
          {
            "text": "Њен горући пламен",
            "poem": 1
          },
          {
            "text": "је моћна ватра.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Силне воде нису кадре да угасе љубав",
            "poem": 1
          },
          {
            "text": "и реке је згаснути не могу.",
            "poem": 2
          },
          {
            "text": "Ако неко за љубав даје",
            "poem": 1
          },
          {
            "text": "све богатство своје куће,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "људи би то презрели.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Наша је сестра мала",
            "poem": 1
          },
          {
            "text": "и још нема груди.",
            "poem": 2
          },
          {
            "text": "Шта за њу да урадимо",
            "poem": 1
          },
          {
            "text": "на дан када о њој буде речи?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ако као зид буде,",
            "poem": 1
          },
          {
            "text": "на њој ћемо дићи грудобран од сребра;",
            "poem": 2
          },
          {
            "text": "ако буде као врата,",
            "poem": 1
          },
          {
            "text": "заградићемо их кедровим даскама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ја сам зид!",
            "poem": 1
          },
          {
            "text": "Моје су груди као куле.",
            "poem": 2
          },
          {
            "text": "Тако сам постала она",
            "poem": 1
          },
          {
            "text": "што је нашла наклоност у његовим очима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "У Вал-Амону Соломон је виноград имао.",
            "poem": 1
          },
          {
            "text": "Виноград је дао чуварима,",
            "poem": 2
          },
          {
            "text": "да му сваки од тог плода",
            "poem": 1
          },
          {
            "text": "доноси по хиљаду сребрника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Преда мном је мој виноград,",
            "poem": 1
          },
          {
            "text": "моје је власништво.",
            "poem": 2
          },
          {
            "text": "Хиљаду сребрника припада теби, о, Соломоне,",
            "poem": 1
          },
          {
            "text": "а две стотине онима који му плод чувају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "О, ти која пребиваш у виноградима!",
            "poem": 1
          },
          {
            "text": "Глас твој ти другови помно ослушкују,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "па дај да га и ја чујем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Пожури, о, вољени мој!",
            "poem": 1
          },
          {
            "text": "Буди као јелен",
            "poem": 2
          },
          {
            "text": "или ко јеленче",
            "poem": 1
          },
          {
            "text": "на брдима што миришу.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
