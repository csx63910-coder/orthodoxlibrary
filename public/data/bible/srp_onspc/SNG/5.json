  },
  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Дошао сам у врт свој, о, сестро моја, невесто!",
            "poem": 1
          },
          {
            "text": "Побрао сам смирну моју са зачинима мојим,",
            "poem": 2
          },
          {
            "text": "појео сам саће моје с медом мојим,",
            "poem": 1
          },
          {
            "text": "попио сам вино моје са млеком мојим.",
            "poem": 2
          },
          "Пријатељи",
          {
            "text": "Једите и пијте, о, пријатељи моји!",
            "poem": 1
          },
          {
            "text": "Опијте се, о, најмилији!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Спавам, ал’ срце ми будно.",
            "poem": 1
          },
          {
            "text": "Чуј! Вољени мој куца:",
            "poem": 2
          },
          {
            "text": "„Отвори ми, сестро моја, вољена моја,",
            "poem": 1
          },
          {
            "text": "голубице без мане!",
            "poem": 2
          },
          {
            "text": "Глава ми је натопљена росом,",
            "poem": 1
          },
          {
            "text": "увојке ми ноћ је овлажила.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Одору сам своју свукла",
            "poem": 1
          },
          {
            "text": "и како да је навучем?",
            "poem": 2
          },
          {
            "text": "Ноге сам опрала своје",
            "poem": 1
          },
          {
            "text": "и како да их испрљам?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Кроз отвор је мој вољени провукао руку своју",
            "poem": 1
          },
          {
            "text": "и за њим је устрептала утроба моја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Устала сам да отворим вољеноме своме",
            "poem": 1
          },
          {
            "text": "и с руку ми је прокапала смирна,",
            "poem": 2
          },
          {
            "text": "на резу је с прстију ми",
            "poem": 1
          },
          {
            "text": "процурила смирна.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "И отворила сам вољеном свом,",
            "poem": 1
          },
          {
            "text": "али мој се вољени окренуо и отишао.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Душа ми је клонула што се удаљио.",
            "poem": 2
          },
          {
            "text": "Тражила сам га и нисам га нашла,",
            "poem": 1
          },
          {
            "text": "дозивала сам га и није ми се одазвао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Нашли су ме стражари што обилазе град.",
            "poem": 1
          },
          {
            "text": "Истукли су ме, израњавали,",
            "poem": 2
          },
          {
            "text": "узели су вео с мене",
            "poem": 1
          },
          {
            "text": "стражари са зида.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ћерке јерусалимске, заклињем вас,",
            "poem": 1
          },
          {
            "text": "ако нађете вољенога мога",
            "poem": 2
          },
          {
            "text": "шта да му кажете?",
            "poem": 1
          },
          {
            "text": "Да болујем од љубави.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "А што је твој вољени бољи од других вољених,",
            "poem": 1
          },
          {
            "text": "о, ти најлепша међу женама?",
            "poem": 2
          },
          {
            "text": "Што је твој вољени бољи од других",
            "poem": 1
          },
          {
            "text": "па нас заклињеш тако?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Мој вољени блиста, румен је,",
            "poem": 1
          },
          {
            "text": "наочитији од десет хиљада!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Глава му је од злата злаћаног,",
            "poem": 1
          },
          {
            "text": "коса увојита",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и ко гавран црна.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Очи су његове голубице",
            "poem": 1
          },
          {
            "text": "на воденим брзацима,",
            "poem": 2
          },
          {
            "text": "млеком умивене,",
            "poem": 1
          },
          {
            "text": "складно угнеждене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Образи му ко леје зачина",
            "poem": 1
          },
          {
            "text": "и куле миришљавих трава;",
            "poem": 2
          },
          {
            "text": "усне су му љиљани",
            "poem": 1
          },
          {
            "text": "са којих се цеди смирна.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Руке су му ко палице златне",
            "poem": 1
          },
          {
            "text": "пуне хрисолита,",
            "poem": 2
          },
          {
            "text": "стомак му је плоча слоноваче",
            "poem": 1
          },
          {
            "text": "покривена сафирима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Његове су ноге мермерни стубови",
            "poem": 1
          },
          {
            "text": "положени на темеље од сувога злата;",
            "poem": 2
          },
          {
            "text": "стасит је ко Ливан,",
            "poem": 1
          },
          {
            "text": "као пробрани кедрови.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Уста су му заслађена",
            "poem": 1
          },
          {
            "text": "и сав је пожељан;",
            "poem": 2
          },
          {
            "text": "такав је вољени мој, такав је драган мој,",
            "poem": 1
          },
          {
            "text": "о, ћерке јерусалимске!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
