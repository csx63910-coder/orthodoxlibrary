  },
  "chapter": {
    "number": 7,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Како су љупка стопала твоја у сандалама,",
            "poem": 1
          },
          {
            "text": "о, ћерко великашка!",
            "poem": 2
          },
          {
            "text": "Облине бокова твојих су као драгуљи,",
            "poem": 1
          },
          {
            "text": "као рукотворина уметника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Пупак ти је ко округли пехар",
            "poem": 1
          },
          {
            "text": "коме никад не зафали вина;",
            "poem": 2
          },
          {
            "text": "стомак ти је ко снопић пшенице",
            "poem": 1
          },
          {
            "text": "окружен љиљанима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Груди су твоје као ланад,",
            "poem": 1
          },
          {
            "text": "близанци срнини.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Врат ти је као кула од слоноваче,",
            "poem": 1
          },
          {
            "text": "очи језерца Есевона на вратима ватравимским;",
            "poem": 2
          },
          {
            "text": "нос ти је као кула ливанска",
            "poem": 1
          },
          {
            "text": "што гледа на Дамаск.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Глава је твоја попут Кармила,",
            "poem": 1
          },
          {
            "text": "коса ти је као царски скерлет.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "У локне се твоје цар уплео.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Како си лепа!",
            "poem": 1
          },
          {
            "text": "Како си љупка вољена у својим чарима!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Стас ти је као дрво палме,",
            "poem": 1
          },
          {
            "text": "а груди ти ко гроздови.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Зато кажем: „Ја бих се на палму пео,",
            "poem": 1
          },
          {
            "text": "држао се за стабљике њеног воћа.“",
            "poem": 2
          },
          {
            "text": "Нек ми твоје груди буду ко гроздови на виновој лози,",
            "poem": 1
          },
          {
            "text": "дах носа твога ко мирис јабука.",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Уста су твоја као добро вино.",
            "poem": 2
          },
          "Она",
          {
            "text": "Оно глатко клизи моме вољеноме,",
            "poem": 1
          },
          {
            "text": "оно нежно цури са усана оних што спавају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ја припадам моме вољеноме,",
            "poem": 1
          },
          {
            "text": "а он за мном жуди.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Дођи, вољени мој! Хајдемо у поља,",
            "poem": 1
          },
          {
            "text": "хајде да ноћимо по селима!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Дигнимо се рано, хајдемо у винограде",
            "poem": 1
          },
          {
            "text": "да видимо је ли пропупила лоза,",
            "poem": 2
          },
          {
            "text": "да ли се расцветала,",
            "poem": 1
          },
          {
            "text": "јесу ли се расцветали нарови.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "И тамо ћу ти дати љубав своју.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Мандрагоре одишу мирисом,",
            "poem": 1
          },
          {
            "text": "а на вратима је нашим све пробрано воће.",
            "poem": 2
          },
          {
            "text": "А ја сам за тебе сачувала и ново и старо,",
            "poem": 1
          },
          {
            "text": "о, вољени мој!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
