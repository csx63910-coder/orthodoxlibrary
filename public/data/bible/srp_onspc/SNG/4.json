  },
  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Лепа си, вољена моја, лепа си!",
            "poem": 1
          },
          {
            "text": "Очи су твоје голубице иза вела твога,",
            "poem": 2
          },
          {
            "text": "коса ти је попут стада коза",
            "poem": 1
          },
          {
            "text": "што се спушта низ гору Галад.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Зуби су ти као стадо остриганих оваца што долази са купања.",
            "poem": 1
          },
          {
            "text": "Свака од њих близанце носи и јалове међу њима нема.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Усне су ти попут нити скерлета,",
            "poem": 1
          },
          {
            "text": "а уста су ти љупка.",
            "poem": 2
          },
          {
            "text": "Као кришка нара",
            "poem": 1
          },
          {
            "text": "чело је твоје иза вела твога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Твој је врат као кула Давидова,",
            "poem": 1
          },
          {
            "text": "начињена од поређаног камења.",
            "poem": 2
          },
          {
            "text": "Хиљаду штитова висе на њој,",
            "poem": 1
          },
          {
            "text": "све штитови од ратника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Груди су твоје као ланад,",
            "poem": 1
          },
          {
            "text": "близанци срнини",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "који пасу међу љиљанима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Док дан не мине",
            "poem": 1
          },
          {
            "text": "и сенке не ишчиле",
            "poem": 2
          },
          {
            "text": "отићи ћу на брдо смирнино",
            "poem": 1
          },
          {
            "text": "и на гору од тамјана.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Сва си лепа, вољена моја,",
            "poem": 1
          },
          {
            "text": "и на теби мане нема.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Хајде са мном са Ливана, невесто,",
            "poem": 1
          },
          {
            "text": "хајде са мном са Ливана!",
            "poem": 2
          },
          {
            "text": "Сиђи са врха Амана,",
            "poem": 1
          },
          {
            "text": "са врха Сенира и Ермона;",
            "poem": 2
          },
          {
            "text": "из брлога лавова",
            "poem": 1
          },
          {
            "text": "и с гора рисових.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Срце си ми украла, сестро моја, невесто!",
            "poem": 1
          },
          {
            "text": "Срце си ми украла",
            "poem": 2
          },
          {
            "text": "једним погледом очију својих,",
            "poem": 1
          },
          {
            "text": "једним украсом огрлице своје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Како је лепа љубав твоја,",
            "poem": 1
          },
          {
            "text": "сестро моја, невесто!",
            "poem": 2
          },
          {
            "text": "Љубав је твоја од вина боља",
            "poem": 1
          },
          {
            "text": "и мирис уља твојих од свих зачина.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Са усана твојих мед капље, о, невесто!",
            "poem": 1
          },
          {
            "text": "Мед и млеко под твојим су језиком,",
            "poem": 2
          },
          {
            "text": "а мирис хаљина твојих",
            "poem": 1
          },
          {
            "text": "је мирис Ливана.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Врт закључан ти си, сестро моја, невесто;",
            "poem": 1
          },
          {
            "text": "врело затворено, запечаћен извор.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Твоји су изданци царски врт нарова",
            "poem": 1
          },
          {
            "text": "с најбољим плодовима,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "са каном и нардом;",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "са нардом и шафраном,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "са мирисном трском и циметом,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "са свим стаблима тамјана,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "смирне и алоје,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "са свим пробраним зачинима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ти си врело вртовима,",
            "poem": 1
          },
          {
            "text": "извор воде што жубори",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и с Ливана тече.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Пробуди се, северни ветре!",
            "poem": 1
          },
          {
            "text": "Дођи, јужни ветре!",
            "poem": 2
          },
          {
            "text": "Дуни, вртом мојим,",
            "poem": 1
          },
          {
            "text": "нек полете његови зачини.",
            "poem": 2
          },
          {
            "text": "Нека дође мој вољени у свој врт,",
            "poem": 1
          },
          {
            "text": "нека једе од пробраног воћа.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
