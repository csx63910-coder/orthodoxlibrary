  "book": {
    "id": "SNG",
    "translationId": "srp_onspc",
    "name": "Песма над песмама",
    "commonName": "Песма над песмама",
    "title": "Песма над песмама",
    "order": 22,
    "numberOfChapters": 8,
    "sha256": "6cc997f946c2c3868d59fc2bd84490291809602e686cbff1def317640ea2627b",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/SNG/1.json",
    "lastChapterNumber": 8,
    "lastChapterApiLink": "/api/srp_onspc/SNG/8.json",
    "totalNumberOfVerses": 117
  },
  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Соломонова песма над песмама."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Пољупцем усана својих ме пољуби,",
            "poem": 1
          },
          {
            "text": "јер је твоја љубав боља од вина.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Мирис је твоје помасти диван,",
            "poem": 1
          },
          {
            "text": "име је твоје као уље изливено",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и зато те воле девојке.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Поведи ме са собом, побегнимо!",
            "poem": 1
          },
          {
            "text": "Нек ме цар уведе у одаје своје.",
            "poem": 2
          },
          "Пријатељице",
          {
            "text": "Радоваћемо се и уживаћемо у теби.",
            "poem": 1
          },
          {
            "text": "Славићемо твоју љубав више него вино.",
            "poem": 2
          },
          "Она",
          {
            "text": "Добро је што те оне воле.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Тамнопута сам али љупка,",
            "poem": 1
          },
          {
            "text": "ћерке јерусалимске,",
            "poem": 2
          },
          {
            "text": "као шатори кедарски,",
            "poem": 1
          },
          {
            "text": "као крила Соломонових шатора.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Не гледајте ме што сам тамнопута,",
            "poem": 1
          },
          {
            "text": "јер ме је сунце опалило.",
            "poem": 2
          },
          {
            "text": "Моја су браћа љута на мене.",
            "poem": 1
          },
          {
            "text": "Поставили су ме да винограде чувам,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а ја свој сопствени виноград сачувала нисам.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Кажи ми, ти кога душа моја воли,",
            "poem": 1
          },
          {
            "text": "где ти стадо пасе",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и где ти у подне пландује?",
            "poem": 2
          },
          {
            "text": "Зашто да се велом покривам",
            "poem": 1
          },
          {
            "noteId": 0
          },
          {
            "text": "међу стадима пријатеља твојих?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ако не знаш, о, најлепша међу женама,",
            "poem": 1
          },
          {
            "text": "иди по трагу стада",
            "poem": 2
          },
          {
            "text": "па напасај козлиће своје",
            "poem": 1
          },
          {
            "text": "крај пастирских коначишта.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "О, вољена моја, ти си као моја ждребица",
            "poem": 1
          },
          {
            "text": "међу фараоновим упрегнутим ждрепцима!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Лепи су ти образи окићени ланчићима,",
            "poem": 1
          },
          {
            "text": "а на врату ти огрлице.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Сковаћемо ти наруквице златне",
            "poem": 1
          },
          {
            "text": "и украсити сребром.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Док је цар за столом својим,",
            "poem": 1
          },
          {
            "text": "мирисом својим мој нард одаје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Смотуљак смирне што ноћи међ’ грудима мојим,",
            "poem": 1
          },
          {
            "text": "то је мени мој вољени.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Струк кане у цвату из винограда Ен-Гедија,",
            "poem": 1
          },
          {
            "text": "то је мени мој вољени.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Како ли си лепа, о, вољена моја!",
            "poem": 1
          },
          {
            "text": "Лепа си, а очи су ти голубице.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Како си згодан, о, вољени мој, и мио!",
            "poem": 1
          },
          {
            "text": "Ево, постеља је наша бујна трава.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Кедрови су греде куће наше,",
            "poem": 1
          },
          {
            "text": "а чемпреси рогови крова.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 0,
        "caller": "+",
        "text": "1,7 Са неким мањим изменама изворног текста, овај део стиха може да се преведе: Зашто да тумарам…",
        "reference": {
          "chapter": 1,
          "verse": 7
        }
      }
    ]
  },
