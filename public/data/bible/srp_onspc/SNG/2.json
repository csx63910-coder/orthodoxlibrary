  },
  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ја сам шафран са Сарона",
            "poem": 1
          },
          {
            "text": "и љиљан из долина.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Какав је љиљан међу трњем,",
            "poem": 1
          },
          {
            "text": "таква је вољена моја међу девојкама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Као стабло јабуке међу шумским дрвећем,",
            "poem": 1
          },
          {
            "text": "такав је вољени мој међу момцима.",
            "poem": 2
          },
          {
            "text": "За хладом његовим чезнем, да седнем,",
            "poem": 1
          },
          {
            "text": "да плодом његовим осладим непце своје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Унео ме је у кућу вина,",
            "poem": 1
          },
          {
            "text": "љубав је његова застава нада мном.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Крепите ме сувим грожђем,",
            "poem": 1
          },
          {
            "text": "јабукама ме освежите,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер сам од љубави клонула.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Левица му је под главом мојом,",
            "poem": 1
          },
          {
            "text": "а десницом ме грли.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ћерке јерусалимске, заклињем вас",
            "poem": 1
          },
          {
            "text": "ланадима и кошутама пољским,",
            "poem": 2
          },
          {
            "text": "не будите и не дижите моју љубав",
            "poem": 1
          },
          {
            "text": "док јој се не прохте.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Чуј гласа вољеног мога!",
            "poem": 1
          },
          {
            "text": "Ево, долази,",
            "poem": 2
          },
          {
            "text": "поскакује по брдима",
            "poem": 1
          },
          {
            "text": "и горе прескаче.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Као газела и као срндаћ мој је вољени.",
            "poem": 1
          },
          {
            "text": "Гле, ено га стоји иза нашег зида,",
            "poem": 2
          },
          {
            "text": "провирује са прозора,",
            "poem": 1
          },
          {
            "text": "кроз решетке гледа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "А мој вољени ми одговори, рече ми:",
            "poem": 1
          },
          {
            "text": "„Устани, вољена моја,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "дођи, најлепша моја!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ево, зима је прошла",
            "poem": 1
          },
          {
            "text": "и киша умину, прође.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Земља је процветала,",
            "poem": 1
          },
          {
            "text": "стиже време орезивања",
            "poem": 2
          },
          {
            "noteId": 1
          },
          {
            "text": ",",
            "poem": 2
          },
          {
            "text": "по нашој се земљи",
            "poem": 1
          },
          {
            "text": "чује цвркут грлице.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Плодови рани пупе на смоквином стаблу,",
            "poem": 1
          },
          {
            "text": "виногради цвату и мирисом одишу.",
            "poem": 2
          },
          {
            "text": "Устани и дођи,",
            "poem": 1
          },
          {
            "text": "о, вољена моја, дођи!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Голубице моја у раселини стене,",
            "poem": 1
          },
          {
            "text": "заклоњена у врлети.",
            "poem": 2
          },
          {
            "text": "Дај ми да ти видим лице!",
            "poem": 1
          },
          {
            "text": "Дај ми гласа да ти чујем,",
            "poem": 2
          },
          {
            "text": "јер је глас твој меден",
            "poem": 1
          },
          {
            "text": "и лице је твоје љупко.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Лисице нам похватајте,",
            "poem": 1
          },
          {
            "text": "лисичиће што сатиру винограде,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер наш је виноград у цвату.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Мој је драги мој и ја сам његова,",
            "poem": 1
          },
          {
            "text": "међу љиљанима он пасе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Врати се док дан не мине",
            "poem": 1
          },
          {
            "text": "и сенке не ишчиле.",
            "poem": 2
          },
          {
            "text": "Као срна буди, о, вољени мој,",
            "poem": 1
          },
          {
            "text": "као срндаћ на брдима што нас деле.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 1,
        "caller": "+",
        "text": "2,12 Или: певања, што је одлика игре једнакозвучних речи.",
        "reference": {
          "chapter": 2,
          "verse": 12
        }
      }
    ]
  },
