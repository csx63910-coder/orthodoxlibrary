  },
  "chapter": {
    "number": 6,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Где је отишао вољени твој,",
            "poem": 1
          },
          {
            "text": "о, најлепша међу женама?",
            "poem": 2
          },
          {
            "text": "Куда се окренуо вољени твој",
            "poem": 1
          },
          {
            "text": "да га тражимо са тобом?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Вољени је мој сишао у врт свој,",
            "poem": 1
          },
          {
            "text": "на леје зачина,",
            "poem": 2
          },
          {
            "text": "да пасе по вртовима",
            "poem": 1
          },
          {
            "text": "и љиљане бере.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ја припадам моме вољеноме",
            "poem": 1
          },
          {
            "text": "и мени припада мој вољени",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "који пасе међу љиљанима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Лепа си, вољена моја,",
            "poem": 1
          },
          {
            "text": "као Терса љупка и као Јерусалим,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "страховита као војска с барјацима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Очи своје с мене скрени",
            "poem": 1
          },
          {
            "text": "јер ме залуђују,",
            "poem": 2
          },
          {
            "text": "а коса ти је попут стада коза",
            "poem": 1
          },
          {
            "text": "што се спушта низ Галад.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Зуби су ти као стадо оваца",
            "poem": 1
          },
          {
            "text": "што долази са купања.",
            "poem": 2
          },
          {
            "text": "Свака од њих близанце носи",
            "poem": 1
          },
          {
            "text": "и јалове међу њима нема.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Као кришка нара",
            "poem": 1
          },
          {
            "text": "чело је твоје иза вела твога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Нека је шездесет царица,",
            "poem": 1
          },
          {
            "text": "осамдесет иноча",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и небројено младих жена;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "ал’ је једна голубица моја без мане.",
            "poem": 1
          },
          {
            "text": "Она је љубимица мајке своје,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "миљеница оне што је роди.",
            "poem": 2
          },
          {
            "text": "Виделе су је девојке и блаженом је прозвале,",
            "poem": 1
          },
          {
            "text": "а царице и иноче су је хвалиле.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ко је она што се јавља као зора,",
            "poem": 1
          },
          {
            "text": "лепа као пуни месец, ко сунце без мане,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "страховита као војска с барјацима?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Сишао сам у орашњак,",
            "poem": 1
          },
          {
            "text": "прегледао изданке у долу,",
            "poem": 2
          },
          {
            "text": "да видим хоће ли да пропупи лоза",
            "poem": 1
          },
          {
            "text": "и нар да процвета.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ал’ ме душа, а да нисам знао,",
            "poem": 1
          },
          {
            "text": "посади на кола мојих великаша.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Врати се! Врати се, о, Суламко!",
            "poem": 1
          },
          {
            "text": "Врати се, врати да те погледамо!",
            "poem": 2
          },
          "Он",
          {
            "text": "Зашто да гледате у Суламку",
            "poem": 1
          },
          {
            "text": "као у игру два табора.",
            "poem": 2
          }
        ]
      }
    ],
