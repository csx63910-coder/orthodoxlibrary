  "book": {
    "id": "SNG",
    "translationId": "srp_onspc",
    "name": "Песма над песмама",
    "commonName": "Песма над песмама",
    "title": "Песма над песмама",
    "order": 22,
    "numberOfChapters": 8,
    "sha256": "6cc997f946c2c3868d59fc2bd84490291809602e686cbff1def317640ea2627b",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/SNG/1.json",
    "lastChapterNumber": 8,
    "lastChapterApiLink": "/api/srp_onspc/SNG/8.json",
    "totalNumberOfVerses": 117
  },
  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Тражила сам у ноћима на постељи својој",
            "poem": 1
          },
          {
            "text": "оног кога воли душа моја,",
            "poem": 2
          },
          {
            "text": "тражила сам",
            "poem": 1
          },
          {
            "text": "и нисам га нашла.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Устаћу, град ћу обиграти,",
            "poem": 1
          },
          {
            "text": "по улицама и по трговима ћу тражити",
            "poem": 2
          },
          {
            "text": "оног кога душа моја воли.",
            "poem": 1
          },
          {
            "text": "И тражила сам га, али га нисам нашла.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Нашли су ме стражари што обилазе град:",
            "poem": 1
          },
          {
            "text": "„Јесте ли видели онога",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "кога воли душа моја?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "И тек што сам их мало прошла,",
            "poem": 1
          },
          {
            "text": "нашла сам оног ког ми душа воли.",
            "poem": 2
          },
          {
            "text": "Зграбила сам га и пуштала га нисам",
            "poem": 1
          },
          {
            "text": "све док га нисам довела до куће мајке моје,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "до одаје оне што ме је родила.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ћерке јерусалимске, заклињем вас",
            "poem": 1
          },
          {
            "text": "ланадима и кошутама пољским,",
            "poem": 2
          },
          {
            "text": "не будите и не дижите моју љубав",
            "poem": 1
          },
          {
            "text": "док јој се не прохте.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Шта се то из пустиње диже",
            "poem": 1
          },
          {
            "text": "ко облаци дима,",
            "poem": 2
          },
          {
            "text": "намирисано смирном, тамјаном",
            "poem": 1
          },
          {
            "text": "и свим мирисним помастима трговачким?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Гле, то је лежаљка Соломонова,",
            "poem": 1
          },
          {
            "text": "а око ње су шездесет делија,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "неки од јунака Израиља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Сваки од њих мач је дограбио,",
            "poem": 1
          },
          {
            "text": "ратовању су вични;",
            "poem": 2
          },
          {
            "text": "сваком од њих мач о бедру,",
            "poem": 1
          },
          {
            "text": "због ноћних страхота.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Од стабала ливанских је себи",
            "poem": 1
          },
          {
            "text": "носиљку начинио цар Соломон.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Од сребра јој је начинио мотке,",
            "poem": 1
          },
          {
            "text": "наслон од злата,",
            "poem": 2
          },
          {
            "text": "седиште од скерлета,",
            "poem": 1
          },
          {
            "text": "а унутрашњост су јој кожом",
            "poem": 2
          },
          {
            "noteId": 2
          },
          {
            "text": "обложиле ћерке јерусалимске.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Изађите и гледајте,",
            "poem": 1
          },
          {
            "text": "о, ћерке сионске, цара Соломона",
            "poem": 2
          },
          {
            "text": "с круном којом га окрунила мајка његова",
            "poem": 1
          },
          {
            "text": "на дан његовог венчања,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "на дан када му се срце радовало!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 2,
        "caller": "+",
        "text": "3,10 Игра речи на изворном језику: кожа – са љубављу.",
        "reference": {
          "chapter": 3,
          "verse": 10
        }
      }
    ]
