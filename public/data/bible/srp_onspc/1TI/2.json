    "name": "1. Тимотеју",
    "commonName": "1. Тимотеју",
    "title": "Прва посланица Тимотеју",
    "order": 54,
    "numberOfChapters": 6,
    "sha256": "79d0982c892f9dd246dcecdecdbfd9706693bdc841fbb5f0ddfe90df2712a604",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/1TI/1.json",
    "lastChapterNumber": 6,
    "lastChapterApiLink": "/api/srp_onspc/1TI/6.json",
