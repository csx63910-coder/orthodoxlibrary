  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "heading",
        "content": [
          "Гнев Божији је велик"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Када се Господ разгневио,",
            "poem": 1
          },
          {
            "text": "ћерку је сионску у таму завио.",
            "poem": 2
          },
          {
            "text": "Сјајни град светлости небеске,",
            "poem": 1
          },
          {
            "text": "у рушевине претвори земаљске.",
            "poem": 2
          },
          {
            "text": "Славни Дом, дику Израиљеву,",
            "poem": 1
          },
          {
            "text": "он напусти у дан гнева свога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Господ је сатро без милости,",
            "poem": 1
          },
          {
            "text": "сва села у Јаковљевој земљи.",
            "poem": 2
          },
          {
            "text": "Кад се разгневио, он је разорио",
            "poem": 1
          },
          {
            "text": "све тврђаве што држе Јудејци;",
            "poem": 2
          },
          {
            "text": "са земљом је сравнио и проклео",
            "poem": 1
          },
          {
            "text": "царство и његове главаре.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "У распаљеној својој јарости,",
            "poem": 1
          },
          {
            "text": "сву моћ израиљску он је скрхао.",
            "poem": 2
          },
          {
            "text": "Кад је непријатељ насрнуо,",
            "poem": 1
          },
          {
            "text": "десницу своју Бог нам је ускратио.",
            "poem": 2
          },
          {
            "text": "Као огањ плануо је у Јакову,",
            "poem": 1
          },
          {
            "text": "око себе све је попалио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Као непријатељ лук је свој затегао,",
            "poem": 1
          },
          {
            "text": "као душман је навалио,",
            "poem": 2
          },
          {
            "text": "убијао све што нам је оку драго,",
            "poem": 1
          },
          {
            "text": "све чему се радовасмо.",
            "poem": 2
          },
          {
            "text": "На шаторе ћерке сионске",
            "poem": 1
          },
          {
            "text": "сасу своју срџбу распаљену.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Господ је као непријатељ постао:",
            "poem": 1
          },
          {
            "text": "Израиљев народ разорио,",
            "poem": 2
          },
          {
            "text": "све његове дворе порушио,",
            "poem": 1
          },
          {
            "text": "све тврђаве њему разорио;",
            "poem": 2
          },
          {
            "text": "Јудином народу умножио је јаде,",
            "poem": 1
          },
          {
            "text": "нагомилао јецање и уздисаје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Одбачени, укинути, разорени…"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Сеницу је растурио у комаде,",
            "poem": 1
          },
          {
            "text": "разорио место за службе Божије.",
            "poem": 2
          },
          {
            "text": "На Сиону Господ у заборав баци",
            "poem": 1
          },
          {
            "text": "и празник и суботу;",
            "poem": 2
          },
          {
            "text": "разгневио се и презрео",
            "poem": 1
          },
          {
            "text": "и цара и свештеника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Господ је свој жртвеник одбацио,",
            "poem": 1
          },
          {
            "text": "Светилиште своје је оскрнавио;",
            "poem": 2
          },
          {
            "text": "предао у руке душманске",
            "poem": 1
          },
          {
            "text": "да руше бедеме и дворе,",
            "poem": 2
          },
          {
            "text": "да урлају по Господњем Дому,",
            "poem": 1
          },
          {
            "text": "где ми некад празновасмо.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Господ је одлучио да руши,",
            "poem": 1
          },
          {
            "text": "да попадају зидови ћерке сионске;",
            "poem": 2
          },
          {
            "text": "одредио је меру рушења",
            "poem": 1
          },
          {
            "text": "и није се устезала рука његова.",
            "poem": 2
          },
          {
            "text": "Спољни зидови, други ред зидова,",
            "poem": 1
          },
          {
            "text": "оронули тужно леже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Вратнице су спаљене и поломљене,",
            "poem": 1
          },
          {
            "text": "он им је здробио резе и греде.",
            "poem": 2
          },
          {
            "text": "Цар и кнезови су у прогонству,",
            "poem": 1
          },
          {
            "text": "нема никог да нас учи Закону,",
            "poem": 2
          },
          {
            "text": "нити се јављају виђења,",
            "poem": 1
          },
          {
            "text": "дар Господњи пророцима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Старешине ћерке сионске",
            "poem": 1
          },
          {
            "text": "по земљи су поседали и ћуте,",
            "poem": 2
          },
          {
            "text": "главе своје прашином посипају,",
            "poem": 1
          },
          {
            "text": "обавили кострет око тела.",
            "poem": 2
          },
          {
            "text": "Све до земље спустиле су главе",
            "poem": 1
          },
          {
            "text": "јерусалимске девојке младе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Од плакања ишчилеше ми очи,",
            "poem": 1
          },
          {
            "text": "у ропцу ми душа грца,",
            "poem": 2
          },
          {
            "text": "жалост ме је исцрпла потпуно,",
            "poem": 1
          },
          {
            "text": "јер посматрам слом народа мога:",
            "poem": 2
          },
          {
            "text": "деца и одојчад умиру",
            "poem": 1
          },
          {
            "text": "по трговима града срушенога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Говораху својим матерама:",
            "poem": 1
          },
          {
            "text": "„Где је жито? Где је пиће?“",
            "poem": 2
          },
          {
            "text": "и слично рањеницима обамиру",
            "poem": 1
          },
          {
            "text": "по трговима града срушенога",
            "poem": 2
          },
          {
            "text": "и душе своје испуштају",
            "poem": 1
          },
          {
            "text": "на грудима својих мајки.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Стварност је сурова"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "О, Јерусалиме, о, мили граде,",
            "poem": 1
          },
          {
            "text": "коме си сличан, налик си на кога?",
            "poem": 2
          },
          {
            "text": "Како да те утешим, о, девице, ћерко сионска?",
            "poem": 1
          },
          {
            "text": "Да ли је овако пострадао ико?",
            "poem": 2
          },
          {
            "text": "Несрећа је твоја безгранична, као море.",
            "poem": 1
          },
          {
            "text": "Да те исцели неко?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Твоји пророци немају пророштва",
            "poem": 1
          },
          {
            "text": "осим обмана и лажи.",
            "poem": 2
          },
          {
            "text": "На кривицу твоју не указују,",
            "poem": 1
          },
          {
            "text": "заваравају те,",
            "poem": 2
          },
          {
            "text": "од изгнанства одвраћају.",
            "poem": 1
          },
          {
            "text": "Лажним те пророштвима убеђују,",
            "poem": 2
          },
          {
            "text": "те избегаваш покајање.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Руга ти се, пљеска рукама",
            "poem": 1
          },
          {
            "text": "народ који пролази крај града.",
            "poem": 2
          },
          {
            "text": "Звижде и главом одмахују",
            "poem": 1
          },
          {
            "text": "над рушевинама јерусалимским:",
            "poem": 2
          },
          {
            "text": "„Је ли то та варош савршено лепа?",
            "poem": 1
          },
          {
            "text": "Је ли то радост целе земље?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Смеју ти се, над тобом се церекају",
            "poem": 1
          },
          {
            "text": "сви непријатељи твоји.",
            "poem": 2
          },
          {
            "text": "Криве усне, кезе зубе,",
            "poem": 1
          },
          {
            "text": "па говоре: „Ми смо га слистили!",
            "poem": 2
          },
          {
            "text": "Ово је оно што смо чекали!",
            "poem": 1
          },
          {
            "text": "Дочекасмо. Очи наше видеше!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Господ је извршио своју намеру,",
            "poem": 1
          },
          {
            "text": "одржао је реч своју.",
            "poem": 2
          },
          {
            "text": "Од давнина нас је он опомињао,",
            "poem": 1
          },
          {
            "text": "сад нас без милости разорио.",
            "poem": 2
          },
          {
            "text": "Непријатељ победнички ликује,",
            "poem": 1
          },
          {
            "text": "противник се нашем поразу весели.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Вапај и молитва – то остаје пред Богом"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "И зидови твоји нека вапе,",
            "poem": 1
          },
          {
            "text": "јецај, ћерко сионска, призивај Господа!",
            "poem": 2
          },
          {
            "text": "Нека теку сузе твоје",
            "poem": 1
          },
          {
            "text": "као потоци и дању и ноћу.",
            "poem": 2
          },
          {
            "text": "Не дај себи одмора, наричи!",
            "poem": 1
          },
          {
            "text": "Не дај мира зеницама, плачи!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Током ноћи дижи се и вичи,",
            "poem": 1
          },
          {
            "text": "призивај га сваког часа,",
            "poem": 2
          },
          {
            "text": "изливај срце као воду пред лицем Господа,",
            "poem": 1
          },
          {
            "text": "да се смилује нејачи твојој,",
            "poem": 2
          },
          {
            "text": "деци што од глади скапавају",
            "poem": 1
          },
          {
            "text": "по угловима свих улица.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Погледај, погледај, о, Господе!",
            "poem": 1
          },
          {
            "text": "Кога си то на муке бацио?",
            "poem": 2
          },
          {
            "text": "Зар жене да пород свој једу?",
            "poem": 1
          },
          {
            "text": "Зар оне што у наручју њишу?",
            "poem": 2
          },
          {
            "text": "Зар у самом Светилишту кољу",
            "poem": 1
          },
          {
            "text": "свештенике твоје и пророке твоје?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "По улици леже у прашини,",
            "poem": 1
          },
          {
            "text": "мртва леже деца са старцима;",
            "poem": 2
          },
          {
            "text": "девојке моје и младићи",
            "poem": 1
          },
          {
            "text": "леже мачем побијени.",
            "poem": 2
          },
          {
            "text": "Ти их поби у дан гнева свога,",
            "poem": 1
          },
          {
            "text": "ти их покла без милости.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Као да је дан празника, са свих страна",
            "poem": 1
          },
          {
            "text": "сабрао си све ужасе на ме.",
            "poem": 2
          },
          {
            "text": "У дан гнева твога",
            "poem": 1
          },
          {
            "text": "нико није преживео, нико утекао.",
            "poem": 2
          },
          {
            "text": "Децу моју одњихану и одраслу",
            "poem": 1
          },
          {
            "text": "побио је душманин клети.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
