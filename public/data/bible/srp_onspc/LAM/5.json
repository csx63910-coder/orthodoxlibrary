  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "heading",
        "content": [
          "Народ плаче пред Богом"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Опомени се, Господе, шта нам се догодило;",
            "poem": 1
          },
          {
            "text": "погледај, види нашу срамоту.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "У туђинске руке пала је баштина наша,",
            "poem": 1
          },
          {
            "text": "странци се шире по нашим домовима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Очева наших нема, сирочад смо постали,",
            "poem": 1
          },
          {
            "text": "мајке су наше сада удовице.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Воду за пиће новцем плаћамо,",
            "poem": 1
          },
          {
            "text": "дрва за гориво такође купујемо.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Гоне нас као теглеће живинче;",
            "poem": 1
          },
          {
            "text": "исцепани смо, а не дају нам одмора.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Идемо, просјачимо по Египту и Асирији",
            "poem": 1
          },
          {
            "text": "да бисмо имали хлеба да преживимо.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Наши преци згрешише, али њих нема,",
            "poem": 1
          },
          {
            "text": "па ми испаштамо за кривице њихове.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Над нама владају простаци робови",
            "poem": 1
          },
          {
            "text": "и од њихове силе нико да нас избави.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Убице харају по земљи,",
            "poem": 1
          },
          {
            "text": "стављамо живот на коцку идући по храну.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Од глади горимо као у грозници,",
            "poem": 1
          },
          {
            "text": "и кожа је наша као пећ ужарена.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "На светињи, на Сиону, силују жене,",
            "poem": 1
          },
          {
            "text": "по Јудиним насељима девојке.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Наше главаре рукама својим хватају и вешају,",
            "poem": 1
          },
          {
            "text": "ни старце наше неће да поштују.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Младићи као робови окрећу жрвњеве,",
            "poem": 1
          },
          {
            "text": "дечаци падају под бременима дрва.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Старци више не седе пред вратима,",
            "poem": 1
          },
          {
            "text": "младих људи свирка више се не чује.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ишчезла је радост из наших живота:",
            "poem": 1
          },
          {
            "text": "уместо да играмо, ми смо ојађени.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Са главе је наше круна пала.",
            "poem": 1
          },
          "Народ признаје грехе",
          {
            "text": "Згрешили смо, сада тешко нама.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ето зато срце наше болује!",
            "poem": 1
          },
          {
            "text": "Ето, зато се очи наше замутише!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Зато је сионска гора опустошена.",
            "poem": 1
          },
          {
            "text": "Зато се шакали шуњају по тој пустоши.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Молитва за избављење"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ти, Господе, остајеш довека,",
            "poem": 1
          },
          {
            "text": "твој је престо од колена до колена.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Немој нас занавек заборавити,",
            "poem": 1
          },
          {
            "text": "немој нас за дуго време оставити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Врати нас к себи! Обрати нас, Господе!",
            "poem": 1
          },
          {
            "text": "Обнови славу нашу из негдашњих дана.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Зар да нас одбациш потпуно?",
            "poem": 1
          },
          {
            "text": "Да се на нас срдиш бескрајно?",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
