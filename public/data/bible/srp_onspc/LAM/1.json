  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "heading",
        "content": [
          "Несрећни град"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Како седи престоница усамљена!",
            "poem": 1
          },
          {
            "text": "А некад је пуна људи била.",
            "poem": 2
          },
          {
            "text": "Град постаде као удовица,",
            "poem": 1
          },
          {
            "text": "а некад је свет га поштовао.",
            "poem": 2
          },
          {
            "text": "Та царица међу градовима",
            "poem": 1
          },
          {
            "text": "робиња је сада потлачена.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Грозним плачем сву ноћ плаче,",
            "poem": 1
          },
          {
            "text": "низ образе сузе рони.",
            "poem": 2
          },
          {
            "text": "Никог нема да је теши сада,",
            "poem": 1
          },
          {
            "text": "а некада сви јој пријатељи беху.",
            "poem": 2
          },
          {
            "text": "Савезници сви је издадоше,",
            "poem": 1
          },
          {
            "text": "постали су њени непријатељи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Народ Јудин, робље беспомоћно,",
            "poem": 1
          },
          {
            "text": "у невољи, у тешком прогонству,",
            "poem": 2
          },
          {
            "text": "по туђинским сад живе земљама.",
            "poem": 1
          },
          {
            "text": "Нема места где би да почину.",
            "poem": 2
          },
          {
            "text": "Одасвуд их окружују гонитељи,",
            "poem": 1
          },
          {
            "text": "из теснаца никуд да побегну.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Тужни су путеви ка сионском Дому,",
            "poem": 1
          },
          {
            "text": "на празнике не долази нико.",
            "poem": 2
          },
          {
            "text": "Сва су врата разваљена,",
            "poem": 1
          },
          {
            "text": "свештеници уздишу једнако,",
            "poem": 2
          },
          {
            "text": "уплакане су девојке које су некад певале.",
            "poem": 1
          },
          {
            "text": "Сион је у горком ропцу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Над њим сада господаре тлачитељи,",
            "poem": 1
          },
          {
            "text": "због победе ликују непријатељи.",
            "poem": 2
          },
          {
            "text": "Многобројни су греси сионски,",
            "poem": 1
          },
          {
            "text": "зато га је Господ изложио патњама.",
            "poem": 2
          },
          {
            "text": "Насилници заробише децу са Сиона",
            "poem": 1
          },
          {
            "text": "и одведоше их у изгнанство.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Повукла се од ћерке сионске,",
            "poem": 1
          },
          {
            "text": "повукла се сва слава његова.",
            "poem": 2
          },
          {
            "text": "Кнезови му постадоше као срне",
            "poem": 1
          },
          {
            "text": "исцрпене од глади,",
            "poem": 2
          },
          {
            "text": "у бежању изгубише снагу",
            "poem": 1
          },
          {
            "text": "испред ловаца који их гоне.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Јерусалим, рушевина усамљена,",
            "poem": 1
          },
          {
            "text": "свог се сјаја опомиње,",
            "poem": 2
          },
          {
            "text": "а кад паде непријатељима у руке,",
            "poem": 1
          },
          {
            "text": "никог нема да му помоћ пружи.",
            "poem": 2
          },
          {
            "text": "Гледају га тлачитељи,",
            "poem": 1
          },
          {
            "text": "смеју му се зато што је пао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Тешки греси и страдања тешка"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Тешки ли су овог града греси!",
            "poem": 1
          },
          {
            "text": "Гадан ли је, нечист ли је!",
            "poem": 2
          },
          {
            "text": "Ценише га, а сад га презиру:",
            "poem": 1
          },
          {
            "text": "Град без части, го је у срамоти.",
            "poem": 2
          },
          {
            "text": "Само јечи, лице крије,",
            "poem": 1
          },
          {
            "text": "осврће се, иза себе гледа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Види му се да је нечист јако,",
            "poem": 1
          },
          {
            "text": "али он не мари што га ово снађе.",
            "poem": 2
          },
          {
            "text": "Ужасно је како он пропада,",
            "poem": 1
          },
          {
            "text": "а никога нема да га теши.",
            "poem": 2
          },
          {
            "text": "Погледај, Господе, његову невољу,",
            "poem": 1
          },
          {
            "text": "јер непријатељи ликују ли, ликују.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Непријатељ граби, пљачка,",
            "poem": 1
          },
          {
            "text": "све ризнице овог града.",
            "poem": 2
          },
          {
            "text": "Јерусалим гледа како странци",
            "poem": 1
          },
          {
            "text": "проваљују Дому у Светилиште,",
            "poem": 2
          },
          {
            "text": "а њима си, Господе, забранио",
            "poem": 1
          },
          {
            "text": "да ступају где ти збор ступа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Цвили народ, како да не тугује!",
            "poem": 1
          },
          {
            "text": "Траже хлеба, трампе драгоцености своје за храну,",
            "poem": 2
          },
          {
            "text": "не би ли живнули некако.",
            "poem": 1
          },
          {
            "text": "„Смилуј ми се – плачу – о, Господе!",
            "poem": 2
          },
          {
            "text": "Смилуј ми се,",
            "poem": 1
          },
          {
            "text": "јер падох у беду.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Јерусалим у тузи"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Погледајте ме, сви што пролазите",
            "poem": 1
          },
          {
            "text": "– град довикује тужно –",
            "poem": 2
          },
          {
            "text": "Има ли бола сличног овом болу",
            "poem": 1
          },
          {
            "text": "што погоди мене?",
            "poem": 2
          },
          {
            "text": "Како ме је Господ ударио",
            "poem": 1
          },
          {
            "text": "у дан кад се на ме разгневио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Послао је огањ са висине,",
            "poem": 1
          },
          {
            "text": "разгоре га по мојим костима.",
            "poem": 2
          },
          {
            "text": "Разапео мрежу испред мојих ногу",
            "poem": 1
          },
          {
            "text": "и на земљу оборио.",
            "poem": 2
          },
          {
            "text": "Уцвилио ме је и ожалостио",
            "poem": 1
          },
          {
            "text": "у мукама за сва времена.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Све моје грехе на мене навалио,",
            "poem": 1
          },
          {
            "text": "руком их својом у бреме свезао,",
            "poem": 2
          },
          {
            "text": "на мој га је врат натоварио.",
            "poem": 1
          },
          {
            "text": "Ослабих од овог терета.",
            "poem": 2
          },
          {
            "text": "Господ ме је предао мојим душманима,",
            "poem": 1
          },
          {
            "text": "ја им се пак не могу супротставити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Свим мојим јунацима",
            "poem": 1
          },
          {
            "text": "Господ се наругао.",
            "poem": 2
          },
          {
            "text": "Дигао је ратнике против мене,",
            "poem": 1
          },
          {
            "text": "да побије моје узданице младе.",
            "poem": 2
          },
          {
            "text": "Као грожђе у муљари",
            "poem": 1
          },
          {
            "text": "изгазио је Господ лепу земљу Јудину.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Зато из мојих очију као поток лију сузе.",
            "poem": 1
          },
          {
            "text": "Утешити не може ме нико;",
            "poem": 2
          },
          {
            "text": "охрабрити не може ме нико.",
            "poem": 1
          },
          {
            "text": "Синови су моји побеђени,",
            "poem": 2
          },
          {
            "text": "непријатељ ништа народу не остави.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Сион руке своје пружа,",
            "poem": 1
          },
          {
            "text": "али помоћ нико му не пружа.",
            "poem": 2
          },
          {
            "text": "Господ поста противник народу Јаковљеву,",
            "poem": 1
          },
          {
            "text": "са свих страна наваљују тлачитељи;",
            "poem": 2
          },
          {
            "text": "с Јерусалимом поступају",
            "poem": 1
          },
          {
            "text": "као да је гадост међу њима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Реч о праведном Богу"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Господ ме је праведно казнио,",
            "poem": 1
          },
          {
            "text": "јер његову реч нисам послушао.",
            "poem": 2
          },
          {
            "text": "О, чујте ме, одасвуд народи,",
            "poem": 1
          },
          {
            "text": "јаде моје гледајте, видите;",
            "poem": 2
          },
          {
            "text": "девојке моје, младиће моје,",
            "poem": 1
          },
          {
            "text": "у прогонство отераше.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Позвах своје савезнике,",
            "poem": 1
          },
          {
            "text": "а они ми помоћ ускратише.",
            "poem": 2
          },
          {
            "text": "Свештеници моји и старешине",
            "poem": 1
          },
          {
            "text": "по градским улицама помреше,",
            "poem": 2
          },
          {
            "text": "а само су храну тражили",
            "poem": 1
          },
          {
            "text": "не би ли у животу остали.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "На мој ропац погледај, Господе,",
            "poem": 1
          },
          {
            "text": "на измученост душе моје.",
            "poem": 2
          },
          {
            "text": "У грудима срце ми се грчи,",
            "poem": 1
          },
          {
            "text": "жалостан сам због свога пркоса.",
            "poem": 2
          },
          {
            "text": "По улицама синове моје убијају,",
            "poem": 1
          },
          {
            "text": "а унутра, по кућама, смрт коси.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Како цвилим, чуј ме.",
            "poem": 1
          },
          {
            "text": "Нема никог да ме утеши.",
            "poem": 2
          },
          {
            "text": "За моју несрећу душмани су чули,",
            "poem": 1
          },
          {
            "text": "те ликују зато што си ми је ти послао.",
            "poem": 2
          },
          {
            "text": "Дај да и мени сване!",
            "poem": 1
          },
          {
            "text": "Нека слично мени и душмани пате.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Прокуни њихове опачине све,",
            "poem": 1
          },
          {
            "text": "рачунај им зло за зло;",
            "poem": 2
          },
          {
            "text": "мене си већ за грехе казнио,",
            "poem": 1
          },
          {
            "text": "и њих казни тако.",
            "poem": 2
          },
          {
            "text": "Само јечим ја у јаду сада,",
            "poem": 1
          },
          {
            "text": "у мом је срцу туга.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
