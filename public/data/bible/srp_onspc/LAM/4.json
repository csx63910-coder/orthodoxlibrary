  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "heading",
        "content": [
          "Јад и беда после пада"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Како потамне злато,",
            "poem": 1
          },
          {
            "text": "наше жежено злато!",
            "poem": 2
          },
          {
            "text": "Лежи камење храмовно",
            "poem": 1
          },
          {
            "text": "по улицама разбацано.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Сионски младићи, некад скупоцени",
            "poem": 1
          },
          {
            "text": "као злато најчистије,",
            "poem": 2
          },
          {
            "text": "сада су – ах! – као обична грнчарија,",
            "poem": 1
          },
          {
            "text": "као производ лончарски.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "И вучица хоће да доји,",
            "poem": 1
          },
          {
            "text": "да вучиће своје негује,",
            "poem": 2
          },
          {
            "text": "а жене у народу моме",
            "poem": 1
          },
          {
            "text": "окрутне су као ној у пустињи:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "одојчад оставише жедну,",
            "poem": 1
          },
          {
            "text": "језик им се за непце лепи;",
            "poem": 2
          },
          {
            "text": "децу пустише да пиште,",
            "poem": 1
          },
          {
            "text": "никога нема да им храну пружи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Некад сами сладише јела одабрана,",
            "poem": 1
          },
          {
            "text": "сада скапавају по улицама.",
            "poem": 2
          },
          {
            "text": "Некад су у раскоши одрастали,",
            "poem": 1
          },
          {
            "text": "сада по сметлишту пребиру.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Примио је казну народ мој",
            "poem": 1
          },
          {
            "text": "тежу него становници содомски,",
            "poem": 2
          },
          {
            "text": "јер њих разори за трен ока",
            "poem": 1
          },
          {
            "text": "и притом на њих не подиже људе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Некад су били наши јунаци",
            "poem": 1
          },
          {
            "text": "чистији од снега, бељи од млека;",
            "poem": 2
          },
          {
            "text": "били су румени и глатки,",
            "poem": 1
          },
          {
            "text": "као од брега одваљени.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Сад су им лица црња од чађи,",
            "poem": 1
          },
          {
            "text": "по улицама их не познаје нико;",
            "poem": 2
          },
          {
            "text": "кожа им се смежурала око очију,",
            "poem": 1
          },
          {
            "text": "сасушила се као дрво суво.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Сретнији су који у рату погибоше,",
            "poem": 1
          },
          {
            "text": "теже је онима које глад помори:",
            "poem": 2
          },
          {
            "text": "исцрпени, скапавали су лагано,",
            "poem": 1
          },
          {
            "text": "није било плодова са поља да остану у животу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Жене тако нежне беху,",
            "poem": 1
          },
          {
            "text": "па кувају децу своју",
            "poem": 2
          },
          {
            "text": "да нахране себе њима –",
            "poem": 1
          },
          {
            "text": "о, ужасно је народа мога страдање!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Силином је провалио гнев Господњи,",
            "poem": 1
          },
          {
            "text": "он изли своју срџбу јаросну,",
            "poem": 2
          },
          {
            "text": "запали пожар на сионском граду,",
            "poem": 1
          },
          {
            "text": "те му спали и темеље саме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Кривица свештеника и пророка"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Нису веровали ни страни владари,",
            "poem": 1
          },
          {
            "text": "ни сви становници земље,",
            "poem": 2
          },
          {
            "text": "да ће моћи освајач и душман",
            "poem": 1
          },
          {
            "text": "кроз капије јерусалимске да уђу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ипак то се догодило",
            "poem": 1
          },
          {
            "text": "због греха пророчких,",
            "poem": 2
          },
          {
            "text": "због кривица свештеничких,",
            "poem": 1
          },
          {
            "text": "због невине крви",
            "poem": 2
          },
          {
            "noteId": 0
          },
          {
            "text": "усред града проливене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Тумарају по улицама као слепи,",
            "poem": 1
          },
          {
            "text": "крвљу су умрљани,",
            "poem": 2
          },
          {
            "text": "нико се не усуђује да их дотакне,",
            "poem": 1
          },
          {
            "text": "оскрнављена је одећа њихова.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Народ виче: „Одлазите!",
            "poem": 1
          },
          {
            "text": "Оскрнављени, натраг! Не дотичите!“",
            "poem": 2
          },
          {
            "text": "Тако лутаху од народа до народа,",
            "poem": 1
          },
          {
            "text": "а међу народима су говорили:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Овде више не могу да бораве.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Распрши их Господ да их не гледа,",
            "poem": 1
          },
          {
            "text": "да о њима више не брине.",
            "poem": 2
          },
          {
            "text": "На свештенике више не пази,",
            "poem": 1
          },
          {
            "text": "старешине више не жали.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Малаксалост потлачених"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "А нама су се очи умориле,",
            "poem": 1
          },
          {
            "text": "ишчекујемо помоћ, а ње нема.",
            "poem": 2
          },
          {
            "text": "С кула наших зуримо до на крај обзорја,",
            "poem": 1
          },
          {
            "text": "чекамо народ који нас не може избавити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Непријатељ нам је сваки корак вребао,",
            "poem": 1
          },
          {
            "text": "по трговима својим не могосмо пролазити,",
            "poem": 2
          },
          {
            "text": "али дани наши пролажаху,",
            "poem": 1
          },
          {
            "text": "крај нам се приближи, стиже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Брже од грабљивица које с неба слећу,",
            "poem": 1
          },
          {
            "text": "гонитељи наши стигоше,",
            "poem": 2
          },
          {
            "text": "хватали су нас по брдима,",
            "poem": 1
          },
          {
            "text": "у пустињи у заседи чекали.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Заробише наше животно уздање,",
            "poem": 1
          },
          {
            "text": "Господњег помазаника, цара,",
            "poem": 2
          },
          {
            "text": "а ми смо се уздали:",
            "poem": 1
          },
          {
            "text": "цар ће нас од сваког освајача сачувати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Ипак – има Бога"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Радујеш се и веселиш, о, ћерко едомска,",
            "poem": 1
          },
          {
            "text": "и ти, народе из земље Уз.",
            "poem": 2
          },
          {
            "text": "Час пропасти и вама долази,",
            "poem": 1
          },
          {
            "text": "и ви ћете се тетурати голи,",
            "poem": 2
          },
          {
            "text": "откриће се и ваша срамота.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "За своју кривицу си, ћерко сионска, испаштала,",
            "poem": 1
          },
          {
            "text": "више те неће у изгнанство терати.",
            "poem": 2
          },
          {
            "text": "Ћерко едомска, тебе ће Господ казнити,",
            "poem": 1
          },
          {
            "text": "твоје ће кривице разоткрити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
