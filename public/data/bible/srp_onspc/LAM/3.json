  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "heading",
        "content": [
          "Песников бол"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ја сам човек који је упознао беду;",
            "poem": 1
          },
          {
            "text": "искусио сам како Бог кажњава.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Мене одведе, мене примора;",
            "poem": 1
          },
          {
            "text": "ходам без светлости, а тмина све гушћа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Лично мене он бије и туче,",
            "poem": 1
          },
          {
            "text": "његови ударци не престају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Месо ми се цепа, кожа ми пуца;",
            "poem": 1
          },
          {
            "text": "он ломи кости моје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "У ропски ме јарам упрегао,",
            "poem": 1
          },
          {
            "text": "тешкоће је на мене навалио,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "натерао да живим у тмини,",
            "poem": 1
          },
          {
            "text": "мртвац затворен довека.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Зазида ме, излаза ми нема;",
            "poem": 1
          },
          {
            "text": "ја сам сужањ с тешким оковима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Вичем, вапим да ми он помогне,",
            "poem": 1
          },
          {
            "text": "али он ми молитву одбија.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Тесаним каменом ме је зазидао,",
            "poem": 1
          },
          {
            "text": "на све стране закрчио друмове, путеве.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Као медвед на ме вреба,",
            "poem": 1
          },
          {
            "text": "као лав се на ме баца.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "По беспућу гони ме и комада,",
            "poem": 1
          },
          {
            "text": "оставља ме да бих тамо умро.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Запиње лук свој и гађа,",
            "poem": 1
          },
          {
            "text": "као да сам ја мета његових стрела.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "У нутрину стреле ми је сасуо,",
            "poem": 1
          },
          {
            "text": "у моје тело дубоко их зарио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Народ ми се вазда подсмева,",
            "poem": 1
          },
          {
            "text": "за поругу служим свима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Он горчином мене храни,",
            "poem": 1
          },
          {
            "text": "пеленом ме он напаја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Тера ме да гризем камен и зубе моје ломи;",
            "poem": 1
          },
          {
            "text": "у пепео мене закопава.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Заборавих шта је мир и здравље,",
            "poem": 1
          },
          {
            "text": "више не знам шта је живот добри.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Нема мени још много живљења,",
            "poem": 1
          },
          {
            "text": "ишчезла је моја нада у Господа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Хоће ли Бог помоћи?"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Мислим на своје муке и потуцања,",
            "poem": 1
          },
          {
            "text": "то ми је слично пелену, слично отрову.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Мислим на то без престанка,",
            "poem": 1
          },
          {
            "text": "душа моја сахне у мени.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Невољу носим у срцу своме,",
            "poem": 1
          },
          {
            "text": "али гајим наду у мислима:",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Није нас нестало јер није престала љубав Господња,",
            "poem": 1
          },
          {
            "text": "јер није пресушило милосрђе његово,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "они се обнављају сваког јутра,",
            "poem": 1
          },
          {
            "text": "верност му је зајамчена као излазак сунца.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Кад Господа имам, ништа ми не треба,",
            "poem": 1
          },
          {
            "text": "и зато се уздам у њега.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Бог – једино уздање"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Господ је добар према човеку",
            "poem": 1
          },
          {
            "text": "који се у Бога узда, који га тражи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Добро је чекати га смирено,",
            "poem": 1
          },
          {
            "text": "очекивати спасење од Господа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Најбоље је у младости",
            "poem": 1
          },
          {
            "text": "своме се јарму научити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Патниче, седи усамљен и ћути,",
            "poem": 1
          },
          {
            "text": "Бог је то наметнуо.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Поклонимо се до тла прашњавога,",
            "poem": 1
          },
          {
            "text": "можда још има наде.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Ако нас туче, нека туче;",
            "poem": 1
          },
          {
            "text": "ако нам се руга, нека се руга.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Господ ипак има милосрђа,",
            "poem": 1
          },
          {
            "text": "за вечност нас неће одбацити;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "смиловаће се иако нас је растужио,",
            "poem": 1
          },
          {
            "text": "његова је милост постојана;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "њему није мило да нас понижава",
            "poem": 1
          },
          {
            "text": "и да на људе наваљује тугу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Када сужње газе мучитељи,",
            "poem": 1
          },
          {
            "text": "када дух им ломе у тамници,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "када људе лишавају права,",
            "poem": 1
          },
          {
            "text": "када се укида што је Свевишњи установио,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "када се правда изврће на суду,",
            "poem": 1
          },
          {
            "text": "зар Господ све то не види?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Човек каже па се и не збуде,",
            "poem": 1
          },
          {
            "text": "али Господ заповеда и то бити мора.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "Када Свевишњи одреди",
            "poem": 1
          },
          {
            "text": "онда и несрећа и добро долази.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          {
            "text": "Зашто се буни човек?",
            "poem": 1
          },
          {
            "text": "Свако добија према греху своме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Признање пред Богом"
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          {
            "text": "Испитајмо, размотримо путеве своје,",
            "poem": 1
          },
          {
            "text": "вратимо се Господу своме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          {
            "text": "Отворимо своја срца,",
            "poem": 1
          },
          {
            "text": "молимо се Богу небескоме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          {
            "text": "Ми смо отпадници, ми смо непокорни,",
            "poem": 1
          },
          {
            "text": "а ти нам праштао ниси.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          {
            "text": "Гневом си се заогрнуо,",
            "poem": 1
          },
          {
            "text": "гонио нас, убијао, ниси штедео.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          {
            "text": "Облаком си се заогрнуо,",
            "poem": 1
          },
          {
            "text": "наша молитва није продрла до тебе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          {
            "text": "Сметлиште си од нас начинио,",
            "poem": 1
          },
          {
            "text": "сви народи су нас презрели.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          {
            "text": "На нас су се искезили",
            "poem": 1
          },
          {
            "text": "сви наши душмани.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          {
            "text": "Прошли смо кроз пропаст и рушевине,",
            "poem": 1
          },
          {
            "text": "живимо у страху и затирању.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          {
            "text": "Потоци суза из мојих очију теку",
            "poem": 1
          },
          {
            "text": "због разарања мога народа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Паћеничка жалост"
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          {
            "text": "Сузе моје теку без престанка,",
            "poem": 1
          },
          {
            "text": "из очију лију и стати неће,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          {
            "text": "док нас не погледа",
            "poem": 1
          },
          {
            "text": "и не види Господ са небеса.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 51,
        "content": [
          {
            "text": "Жалост ме раздире кад гледам очима",
            "poem": 1
          },
          {
            "text": "шта се догађа у граду женама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 52,
        "content": [
          {
            "text": "Као птицу прогоне ме стално,",
            "poem": 1
          },
          {
            "text": "а немају зашто да ме мрзе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 53,
        "content": [
          {
            "text": "Живога ме у јаму бацише",
            "poem": 1
          },
          {
            "text": "и камењем затрпаше.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 54,
        "content": [
          {
            "text": "Вода ми се склопи изнад главе,",
            "poem": 1
          },
          {
            "text": "те помислих: „Са мном је свршено.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Бог избавља и плаћа"
        ]
      },
      {
        "type": "verse",
        "number": 55,
        "content": [
          {
            "text": "Из дубине, из јаме, о, Господе,",
            "poem": 1
          },
          {
            "text": "призвах име твоје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 56,
        "content": [
          {
            "text": "Глас мој ти си чуо,",
            "poem": 1
          },
          {
            "text": "послушај вапаје моје!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 57,
        "content": [
          {
            "text": "Кад завапих, ти се нађе близу.",
            "poem": 1
          },
          {
            "text": "Ти ми рече: „Немој се бојати!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 58,
        "content": [
          {
            "text": "Ти си ми, Господе, извојевао правду,",
            "poem": 1
          },
          {
            "text": "ти си ми живот откупио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 59,
        "content": [
          {
            "text": "Ти, Господе, видиш, насиље ми чине.",
            "poem": 1
          },
          {
            "text": "Ти ми правду на суду досуди.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 60,
        "content": [
          {
            "text": "Ти знаш како ми се свете непријатељи,",
            "poem": 1
          },
          {
            "text": "какве сплетке против мене плету.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 61,
        "content": [
          {
            "text": "Ти, Господе, чујеш како ме исмевају,",
            "poem": 1
          },
          {
            "text": "какве сплетке против мене плету.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 62,
        "content": [
          {
            "text": "Кад говоре и кад мисле противници,",
            "poem": 1
          },
          {
            "text": "поваздан су против мене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 63,
        "content": [
          {
            "text": "Кад седају и кад устају,",
            "poem": 1
          },
          {
            "text": "ти их видиш, мени се ругају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 64,
        "content": [
          {
            "text": "Ти, Господе, казни како доликује,",
            "poem": 1
          },
          {
            "text": "према ономе што су учинили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 65,
        "content": [
          {
            "text": "Ти прокуни срца њихова,",
            "poem": 1
          },
          {
            "text": "ти их испуни очајним мукама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 66,
        "content": [
          {
            "text": "Ти их у гневу гони, са земље истреби.",
            "poem": 1
          },
          {
            "text": "Господе, нека их не буде испод неба.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      }
