  "chapter": {
    "number": 9,
    "content": [
      {
        "type": "heading",
        "content": [
          "Бог се јавља и објављује"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Али неће бити мрак што њу гуши као у времену претходном, кад је обезвредио земљу завулоновску и земљу нефталимску, а потоњи ће прославити пут што води ка мору с друге стране Јордана, Галилеју многобожачку."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Народ који по тами хода,",
            "poem": 1
          },
          {
            "text": "велику је светлост угледао,",
            "poem": 2
          },
          {
            "text": "настањене у земљи сена смртнога,",
            "poem": 1
          },
          {
            "text": "светлост их јарка обасја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Радост си увећао;",
            "poem": 1
          },
          {
            "text": "пред тобом се радују",
            "poem": 2
          },
          {
            "text": "као у жетвеној радости,",
            "poem": 1
          },
          {
            "text": "као што се веселе када плен деле;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "јер јарам на њ натоварен",
            "poem": 1
          },
          {
            "text": "и обрамицу на његовом рамену,",
            "poem": 2
          },
          {
            "text": "шибу прогонитеља његова,",
            "poem": 1
          },
          {
            "text": "ти си поломио као у дан мадијански.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Та, свака цокула маршира у метеж,",
            "poem": 1
          },
          {
            "text": "и плашт се натапа у крви,",
            "poem": 2
          },
          {
            "text": "те ће бити за ватру",
            "poem": 1
          },
          {
            "text": "храна разгорела.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Та, нама се мушко дете родило,",
            "poem": 1
          },
          {
            "text": "нама је син дат;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "власт је њему на рамену.",
            "poem": 2
          },
          {
            "text": "И он ће се звати:",
            "poem": 1
          },
          {
            "text": "Дивни Саветник, Бог Силни,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Отац Вечни, Владар Миротворни.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Распростирању власти и миру",
            "poem": 1
          },
          {
            "text": "неће бити краја",
            "poem": 2
          },
          {
            "text": "на престолу Давидову",
            "poem": 1
          },
          {
            "text": "и на царству његову,",
            "poem": 2
          },
          {
            "text": "да га среди и да га утврди",
            "poem": 1
          },
          {
            "text": "у праву и у праведности",
            "poem": 2
          },
          {
            "text": "од сада и до века.",
            "poem": 1
          },
          {
            "text": "Ревност Господа над војскама",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "то ће учинити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Господ плаћа"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Господар је реч послао Јакову",
            "poem": 1
          },
          {
            "text": "и она је међу Израиљце пала.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "И сав народ њу ће упознати,",
            "poem": 1
          },
          {
            "text": "Јефремовци и становништво Самарије,",
            "poem": 2
          },
          {
            "text": "који говоре срцем",
            "poem": 1
          },
          {
            "text": "надменим и охолим:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "„Ако су опеке пале,",
            "poem": 1
          },
          {
            "text": "градићемо од тесана камена;",
            "poem": 2
          },
          {
            "text": "дивље смокве су сасечене,",
            "poem": 1
          },
          {
            "text": "кедре ћемо тамо подићи.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "А Господ размешта против Ресина противнике његове",
            "poem": 1
          },
          {
            "text": "и подбада непријатеље његове,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Арамеју спреда, Филистејце страга,",
            "poem": 1
          },
          {
            "text": "те Израиљ прождиру својим устима.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Уза све то гнев се његов умирити неће",
            "poem": 1
          },
          {
            "text": "и рука му испружена остаје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ипак се народ обратио није оном који га је ударио,",
            "poem": 1
          },
          {
            "text": "и Господа над војскама потражили нису;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "те је Господ одсекао од Израиља главу и реп,",
            "poem": 1
          },
          {
            "text": "грану и рогоз, у један дан.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Старешина и лице угледно – то је глава,",
            "poem": 1
          },
          {
            "text": "а пророк који научава лаж – то је реп.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Који овај народ воде, они заводе;",
            "poem": 1
          },
          {
            "text": "који бивају вођени, они пропадају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Зато се Господар његовим младићима радовати неће,",
            "poem": 1
          },
          {
            "text": "његовој сиротињи и удовицама смиловати се неће.",
            "poem": 2
          },
          {
            "text": "Зато што је сав народ опак и зао,",
            "poem": 1
          },
          {
            "text": "на сва уста безумно говоре.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Уза све то гнев се његов умирити неће",
            "poem": 1
          },
          {
            "text": "и рука му испружена остаје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Зато што се опакост као пожар распламсала,",
            "poem": 1
          },
          {
            "text": "бодље и трње прождире,",
            "poem": 2
          },
          {
            "text": "шумски честар је упалила,",
            "poem": 1
          },
          {
            "text": "облаци дима се подижу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Земља пламти од јарости Господа над војскама,",
            "poem": 1
          },
          {
            "text": "и народ као храна за пожар постаје:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ни свог брата нико не поштеди.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Ждере с десна",
            "poem": 1
          },
          {
            "text": "и опет је гладан;",
            "poem": 2
          },
          {
            "text": "гута с лева",
            "poem": 1
          },
          {
            "text": "и опет сит није.",
            "poem": 2
          },
          {
            "text": "Човек једе свога ближњег месо:",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Манасијевци Јефремовце,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Јефремовци Манасијевце,",
            "poem": 1
          },
          {
            "text": "а заједно оба на Јудејце.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Уза све то гнев се његов умирити неће",
            "poem": 1
          },
          {
            "text": "и рука му испружена остаје.",
            "poem": 2
          }
        ]
      }
    ],
