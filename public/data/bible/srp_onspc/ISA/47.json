  "chapter": {
    "number": 47,
    "content": [
      {
        "type": "heading",
        "content": [
          "Тужбалица над Вавилоном"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "„Спусти се и седи у прашину,",
            "poem": 1
          },
          {
            "text": "девице, ћерко вавилонска.",
            "poem": 2
          },
          {
            "text": "Седи на земљу.",
            "poem": 1
          },
          {
            "text": "Нема престола, ћерко халдејска!",
            "poem": 2
          },
          {
            "text": "Јер неће те више звати",
            "poem": 1
          },
          {
            "text": "нежном и осећајном.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ухвати млинско камење и мељи брашно,",
            "poem": 1
          },
          {
            "text": "свуци свој огртач,",
            "poem": 2
          },
          {
            "text": "скут подигни, свуци с бедара,",
            "poem": 1
          },
          {
            "text": "прелази реке.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Нека се појави голотиња твоја,",
            "poem": 1
          },
          {
            "text": "још нека се покаже срамота твоја.",
            "poem": 2
          },
          {
            "text": "Осветићу се",
            "poem": 1
          },
          {
            "text": "и неће ме спречити нико.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Откупитељ наш, његово је име:",
            "poem": 1
          },
          {
            "text": "Господ над војскама, Светитељ Израиљев.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "„Седи ћутке и повуци се у таму,",
            "poem": 1
          },
          {
            "text": "ћерко халдејска,",
            "poem": 2
          },
          {
            "text": "јер те више неће звати",
            "poem": 1
          },
          {
            "text": "господарицом над царствима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "На свој сам се народ разгневио,",
            "poem": 1
          },
          {
            "text": "своју сам баштину оскрнавио,",
            "poem": 2
          },
          {
            "text": "и теби их у руке предао;",
            "poem": 1
          },
          {
            "text": "а ти према њима милост не показа:",
            "poem": 2
          },
          {
            "text": "јармом твојим",
            "poem": 1
          },
          {
            "text": "старце си претоварила.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "И говорила си:",
            "poem": 1
          },
          {
            "text": "’Довека ћу бити господарица!’,",
            "poem": 2
          },
          {
            "text": "а у твоје срце то није доспело,",
            "poem": 1
          },
          {
            "text": "ниси се сетила шта на крају бива.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "А сада слушај ово, развратнице,",
            "poem": 1
          },
          {
            "text": "која боравиш у спокојству,",
            "poem": 2
          },
          {
            "text": "те у срцу проговараш своме:",
            "poem": 1
          },
          {
            "text": "’Ја сам и друге нема,",
            "poem": 2
          },
          {
            "text": "нећу постати удовица,",
            "poem": 1
          },
          {
            "text": "нити децу изгубити своју.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Па обоје ће доћи на тебе,",
            "poem": 1
          },
          {
            "text": "тренутно, у истом дану:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "изгубићеш и децу и мужа;",
            "poem": 2
          },
          {
            "text": "у целини ће доћи на тебе,",
            "poem": 1
          },
          {
            "text": "иако врачаш многоструко",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и чараш веома.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "У злоћу своју и ти си се поуздала",
            "poem": 1
          },
          {
            "text": "говорећи: ’Не види ме нико.’",
            "poem": 2
          },
          {
            "text": "Мудрост твоја и знање твоје, оне те заведоше,",
            "poem": 1
          },
          {
            "text": "те говориш у срцу својему:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "’Ја сам и друге нема.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Доћи ће злоћа и на тебе,",
            "poem": 1
          },
          {
            "text": "и нећеш знати да их спречиш;",
            "poem": 2
          },
          {
            "text": "и стуштиће се невоља на те,",
            "poem": 1
          },
          {
            "text": "и нећеш моћи одвратити;",
            "poem": 2
          },
          {
            "text": "и доћи ће на те изненада",
            "poem": 1
          },
          {
            "text": "пропаст за коју не знаш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Де, остани на твојим чарањима,",
            "poem": 1
          },
          {
            "text": "и на мноштву твојих врачања,",
            "poem": 2
          },
          {
            "text": "на којима се трудиш од младости;",
            "poem": 1
          },
          {
            "text": "можда се и окористиш, можда страх донесеш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ринтала си због многих саветника твојих.",
            "poem": 1
          },
          {
            "text": "Хајде, нека устану и спасу те:",
            "poem": 2
          },
          {
            "text": "они ’премеравају’ по небесима,",
            "poem": 1
          },
          {
            "text": "они ’виде’ по звездама,",
            "poem": 2
          },
          {
            "text": "они ’сазнавају’ по младом месецу;",
            "poem": 1
          },
          {
            "text": "шта ће тебе снаћи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Та, они ће бити као стрњика,",
            "poem": 1
          },
          {
            "text": "огањ ће их спалити;",
            "poem": 2
          },
          {
            "text": "сами себе избавити неће",
            "poem": 1
          },
          {
            "text": "из пламене руке;",
            "poem": 2
          },
          {
            "text": "неће остати ни жеравице да се неко огреје,",
            "poem": 1
          },
          {
            "text": "ни ватре да крај ње поседи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Такви ће постати они",
            "poem": 1
          },
          {
            "text": "око којих си се замарала,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "твоји трговчићи од младости:",
            "poem": 2
          },
          {
            "text": "сваки ће на своју страну отперјати,",
            "poem": 1
          },
          {
            "text": "никог неће бити да те спасе.“",
            "poem": 2
          }
        ]
      }
    ],
