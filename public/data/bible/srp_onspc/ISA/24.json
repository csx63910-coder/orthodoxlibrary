  "chapter": {
    "number": 24,
    "content": [
      {
        "type": "heading",
        "content": [
          "Бог ће судити и осудити"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Гле, Господ ће земљу опустошити",
            "poem": 1
          },
          {
            "text": "и оголити",
            "poem": 2
          },
          {
            "text": "и њено лице унаказити,",
            "poem": 1
          },
          {
            "text": "и становнике њене распршити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Као народ свештеник ће бити,",
            "poem": 1
          },
          {
            "text": "и као слуга господар његов,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и као слушкиња господарица њена,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и купац као продавац његов,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и зајмопримац као зајмодавац његов,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и дужник као поверилац његов.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Земља ће бити опустошена пустош,",
            "poem": 1
          },
          {
            "text": "испражњена празнина,",
            "poem": 2
          },
          {
            "text": "зато што је Господ рекао ову реч.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Земља тужи, вене;",
            "poem": 1
          },
          {
            "text": "свет гине, вене;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "гину горди народи на земљи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Јер је земља оскрнављена под становницима њеним,",
            "poem": 1
          },
          {
            "text": "зато што су законе преступили,",
            "poem": 2
          },
          {
            "text": "одредбу погазили,",
            "poem": 1
          },
          {
            "text": "савез вечни прекршили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Зато земљу проклетство прождире,",
            "poem": 1
          },
          {
            "text": "становници њени су под кривицом.",
            "poem": 2
          },
          {
            "text": "Зато су попаљени становници земаљски,",
            "poem": 1
          },
          {
            "text": "и људи је мало преостало.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Вино ново тугује, лоза вене,",
            "poem": 1
          },
          {
            "text": "уздишу сви што весела срца беху.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Нема више весеља уз бубњеве,",
            "poem": 1
          },
          {
            "text": "оконча се граја слављеника,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "умукла је свирка на цитарама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Вино пију, али не певају,",
            "poem": 1
          },
          {
            "text": "пијанцима горчи пиће жестоко.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Град безвредни постаде разорен,",
            "poem": 1
          },
          {
            "text": "свим кућама улаз је затворен,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "због вина је јаук по улицама,",
            "poem": 1
          },
          {
            "text": "свака радост у мрак се претвори,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "из земље је изгнано весеље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Само пустош остаде у граду,",
            "poem": 1
          },
          {
            "text": "вратнице се развалише треском,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "јер се тако у земљи догађа,",
            "poem": 1
          },
          {
            "text": "тако бива међу народима,",
            "poem": 2
          },
          {
            "text": "као кад се отресу маслине,",
            "poem": 1
          },
          {
            "text": "или грожђе пабирчи по берби.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Они глас подижу кличући;",
            "poem": 1
          },
          {
            "text": "величанственост Господњу узносе с мора.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Зато славите Господа ви на истоку,",
            "poem": 1
          },
          {
            "text": "име Господа, Бога Израиљева на острвима морским.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "С краја земље чујемо музику:",
            "poem": 1
          },
          {
            "text": "„Нека је част Праведнику!“",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Али ја говорим:",
            "poem": 1
          },
          {
            "text": "„Пропадох! Пропадох! Тешко мени!",
            "poem": 2
          },
          {
            "text": "Издајници су издали,",
            "poem": 1
          },
          {
            "text": "баш издајом издајници су издали!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Страхота и јама и замка,",
            "poem": 1
          },
          {
            "text": "теби, становниче земаљски.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ко утекне испред гласа о страхоти,",
            "poem": 1
          },
          {
            "text": "у јаму ће упасти;",
            "poem": 2
          },
          {
            "text": "а ко се из јаме извуче,",
            "poem": 1
          },
          {
            "text": "у замку ће се ухватити.",
            "poem": 2
          },
          "Наставак песме о Божијем суду",
          {
            "text": "Па ће се отворити окна на висини,",
            "poem": 1
          },
          {
            "text": "и затрешће се темељи земаљски.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Земља ће се разбијањем разбити.",
            "poem": 1
          },
          {
            "text": "Земља ће се распуклином распући.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Земља ће се земљотресом трести.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Земља ће се тетурањем тетурати као пијан човек;",
            "poem": 1
          },
          {
            "text": "заљуљаће се као сеница: тамо-амо;",
            "poem": 2
          },
          {
            "text": "толико ће јој безакоње њено отежати,",
            "poem": 1
          },
          {
            "text": "те ће пасти и више устати неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "И догодиће се у онај дан:",
            "poem": 1
          },
          {
            "text": "Господ ће походити војску вишњу на висини,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и све цареве овоземаљске на земљи;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "биће сабиром сабрани",
            "poem": 1
          },
          {
            "text": "и заробљени у тамници,",
            "poem": 2
          },
          {
            "text": "у затвору затворени,",
            "poem": 1
          },
          {
            "text": "и кажњени после много дана.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Месец ће се зацрвенети",
            "poem": 1
          },
          {
            "text": "и сунце ће поцрвенети,",
            "poem": 2
          },
          {
            "text": "јер ће се зацарити Господ над војскама",
            "poem": 1
          },
          {
            "text": "на гори Сион и у Јерусалиму,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и слава му је пред старешинама његовим.",
            "poem": 2
          }
        ]
      }
    ],
