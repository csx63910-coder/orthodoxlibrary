  "chapter": {
    "number": 58,
    "content": [
      {
        "type": "heading",
        "content": [
          "Беседа о посту"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Вичи колико те грло носи!",
            "poem": 1
          },
          {
            "text": "Немој се устезати.",
            "poem": 2
          },
          {
            "text": "Слично рогу глас свој подигни,",
            "poem": 1
          },
          {
            "text": "и народу мом злочине његове објави,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и дому Јаковљевом грехе његове.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "А мене дан за даном траже",
            "poem": 1
          },
          {
            "text": "и познавању путева мојих жуде,",
            "poem": 2
          },
          {
            "text": "као пук што делује по правди",
            "poem": 1
          },
          {
            "text": "и пресуде Бога свога не занемарује.",
            "poem": 2
          },
          {
            "text": "Ишту од мене праведност на суду,",
            "poem": 1
          },
          {
            "text": "за близином Божијом жуде.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "’Зашто смо постили,",
            "poem": 1
          },
          {
            "text": "кад ти не видиш?",
            "poem": 2
          },
          {
            "text": "Зашто смо мучили душу своју,",
            "poem": 1
          },
          {
            "text": "а ти не знаш?’",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Гле, у дан поста вашега ви згрћете како вам се хоће,",
            "poem": 1
          },
          {
            "text": "а све ваше раднике тлачите.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Гле, ви постите да бисте се препирали и наметали,",
            "poem": 1
          },
          {
            "text": "да бисте злехудога песницом ударали.",
            "poem": 2
          },
          {
            "text": "Немојте као данас постити,",
            "poem": 1
          },
          {
            "text": "онда ће се на висинама чути глас ваш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Зар је такав пост што сам га изабрао,",
            "poem": 1
          },
          {
            "text": "дан кад мучи човек душу своју,",
            "poem": 2
          },
          {
            "text": "да се главом својом савија ничице као рогоз,",
            "poem": 1
          },
          {
            "text": "и кострет и пепео проспе под себе?",
            "poem": 2
          },
          {
            "text": "Зар ћеш то постом звати",
            "poem": 1
          },
          {
            "text": "и даном што је Господу по вољи?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Није ли ово пост што сам га изабрао:",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "одрешити везе над злехудим,",
            "poem": 1
          },
          {
            "text": "развезати у јарам свезане,",
            "poem": 2
          },
          {
            "text": "дати слободу потрвенима,",
            "poem": 1
          },
          {
            "text": "и сваки јарам да буде изломљен?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Није ли да уделиш хлеб свој гладноме,",
            "poem": 1
          },
          {
            "text": "да у дом доведеш бескућника,",
            "poem": 2
          },
          {
            "text": "кад видиш гола да га оденеш,",
            "poem": 1
          },
          {
            "text": "и од родбине своје да се не кријеш?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Тада ће као зора сијати светлост твоја",
            "poem": 1
          },
          {
            "text": "и здравље ће твоје брзо бујати,",
            "poem": 2
          },
          {
            "text": "и правда ће твоја испред тебе ићи,",
            "poem": 1
          },
          {
            "text": "а слава Господња ће те пратити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Кад повичеш, Господ ће одговорити;",
            "poem": 1
          },
          {
            "text": "завапићеш, а он ће рећи: ’Ево ме!’",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ако из своје средине уклониш јарам,",
            "poem": 1
          },
          {
            "text": "прст претећи и беседу преступничку,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "и због гладног се узбуди твоја душа,",
            "poem": 1
          },
          {
            "text": "и наситиш душу намучену;",
            "poem": 2
          },
          {
            "text": "тада ће се светлост твоја подићи у тами,",
            "poem": 1
          },
          {
            "text": "и тамнина твоја биће као подне.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "И Господ ће те водити без престанка,",
            "poem": 1
          },
          {
            "text": "и по сухим тлима наситиће ти душу,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и кости ће твоје гипкијима учинити;",
            "poem": 2
          },
          {
            "text": "и бићеш као врт заливан",
            "poem": 1
          },
          {
            "text": "и као студенац чије воде усахнути неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "И вековне развалине саградиће за себе,",
            "poem": 1
          },
          {
            "text": "утемељене од колена до колена,",
            "poem": 2
          },
          {
            "text": "а тебе ће звати ’Онај који пукотине зазиђује’,",
            "poem": 1
          },
          {
            "text": "’Обновитељ друмова према насељима.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Запис о суботи"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ако одвратиш своју ногу од суботе,",
            "poem": 1
          },
          {
            "text": "да у свети дан мој не радиш што се теби свиђа,",
            "poem": 2
          },
          {
            "text": "и да суботу назовеш милином,",
            "poem": 1
          },
          {
            "text": "светињу Господњу прослављеном,",
            "poem": 2
          },
          {
            "text": "а славу његову одвојеном од послова,",
            "poem": 1
          },
          {
            "text": "да на својим путевима",
            "poem": 2
          },
          {
            "text": "не обављаш што ти се прохте,",
            "poem": 1
          },
          {
            "text": "и да не говориш непромишљене речи;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "тада ће ти омилити оно што је Господње,",
            "poem": 1
          },
          {
            "text": "пројахаћеш са мном по узвишицама на земљи,",
            "poem": 2
          },
          {
            "text": "па ћу те хранити оним што си наследио",
            "poem": 1
          },
          {
            "text": "од Јакова, претка твојега –",
            "poem": 2
          },
          {
            "text": "јер су то казала уста Господња.“",
            "poem": 3
          }
        ]
      }
    ],
