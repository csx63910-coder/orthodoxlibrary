  "chapter": {
    "number": 52,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Пробуди се! Пробуди се!",
            "poem": 1
          },
          {
            "text": "Одени се у своју снагу, Сионе!",
            "poem": 2
          },
          {
            "text": "Одени се огртачем сјајности своје,",
            "poem": 1
          },
          {
            "text": "Јерусалиме, граде свети,",
            "poem": 2
          },
          {
            "text": "јер у тебе више улазити неће",
            "poem": 1
          },
          {
            "text": "необрезани и нечисти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Стреси са себе прашину и устани,",
            "poem": 1
          },
          {
            "text": "устоличи се, Јерусалиме!",
            "poem": 2
          },
          {
            "text": "Скини окове са свога врата,",
            "poem": 1
          },
          {
            "text": "заборављена ћерко сионска.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Јер говори Господ:",
          {
            "text": "„Ето, били сте продани",
            "poem": 1
          },
          {
            "text": "и без новца ћете бити откупљени.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Јер говори Господар Господ:",
          {
            "text": "„У Египат је некада народ мој сишао да тамо странац буде,",
            "poem": 1
          },
          {
            "text": "а Асир му је ни због чега насиље чинио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "А сада, зашто сам ја овде? – говори Господ.",
          {
            "text": "Зато што је без разлога поробљен мој народ,",
            "poem": 1
          },
          {
            "text": "а поробљивачи његови ликују – говори Господ –",
            "poem": 2
          },
          {
            "text": "и без престанка, поваздан",
            "poem": 1
          },
          {
            "text": "вређа се моје име.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Зато ће народ мој познати име моје.",
            "poem": 1
          },
          {
            "text": "Зато ће у онај дан знати",
            "poem": 2
          },
          {
            "text": "да сам ја онај који говори:",
            "poem": 1
          },
          {
            "text": "’Ево ме!’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Отрежњење и радост"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Како ли су дивне по горама",
            "poem": 1
          },
          {
            "text": "ноге благовесника који најављује мир,",
            "poem": 2
          },
          {
            "text": "благовесника доброте који најављује спасење,",
            "poem": 1
          },
          {
            "text": "говорећи Сиону: „Бог твој царује!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Глас стражара твојих се подиже,",
            "poem": 1
          },
          {
            "text": "глас заједничког клицања,",
            "poem": 2
          },
          {
            "text": "јер очима својим гледају",
            "poem": 1
          },
          {
            "text": "како се Господ враћа на Сион.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Подврискујте и кличите заједно,",
            "poem": 1
          },
          {
            "text": "развалине јерусалимске,",
            "poem": 2
          },
          {
            "text": "јер Господ је народ свој утешио,",
            "poem": 1
          },
          {
            "text": "Јерусалим откупио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Своју свету мишицу Господ је открио",
            "poem": 1
          },
          {
            "text": "да сви пуци гледају,",
            "poem": 2
          },
          {
            "text": "да сви крајеви земљини виде",
            "poem": 1
          },
          {
            "text": "како наш Бог спасава.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Одлазите! Одлазите! Одатле изађите!",
            "poem": 1
          },
          {
            "text": "Нечистоте не дотичите!",
            "poem": 2
          },
          {
            "text": "Из средине његове изађите! Себе очистите,",
            "poem": 1
          },
          {
            "text": "који посуде Господње подижете.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Јер у журби излазити нећете,",
            "poem": 1
          },
          {
            "text": "и бежати нећете,",
            "poem": 2
          },
          {
            "text": "зато што испред вас иде Господ,",
            "poem": 1
          },
          {
            "text": "а иза вашег строја је Бог Израиљев.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "О Божијем слузи, Песма четврта"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "„Гле, мој Слуга ће успевати,",
            "poem": 1
          },
          {
            "text": "узвисиће се и уздигнути, и веома узвеличати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Како су се многи ужаснули над њим",
            "poem": 1
          },
          {
            "noteId": 13
          },
          {
            "text": ":",
            "poem": 1
          },
          {
            "text": "тако изнакажен његов људски лик",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и појава његова међу потомцима људи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ипак, пошкропиће он народе многе",
            "poem": 1
          },
          {
            "noteId": 14
          },
          {
            "text": ",",
            "poem": 1
          },
          {
            "text": "ни писнути неће цареви,",
            "poem": 2
          },
          {
            "text": "јер видеће што им нико објавио није,",
            "poem": 1
          },
          {
            "text": "и схватиће о коме чули нису.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 13,
        "caller": "+",
        "text": "52,14 У изворном тексту стоји над тобом, тј. над Слугом.",
        "reference": {
          "chapter": 52,
          "verse": 14
        }
      },
      {
        "noteId": 14,
        "caller": "+",
        "text": "52,15 И овај превод је могућ: Ипак, пуци многи дивиће се њему.",
        "reference": {
          "chapter": 52,
          "verse": 15
        }
      }
    ]
