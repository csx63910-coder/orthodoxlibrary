  "chapter": {
    "number": 34,
    "content": [
      {
        "type": "heading",
        "content": [
          "Пропаст земље едомске"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Приступите, пуци, да чујете;",
            "poem": 1
          },
          {
            "text": "и народи, слушајте!",
            "poem": 2
          },
          {
            "text": "Нека чује земља и што је испуњава,",
            "poem": 1
          },
          {
            "text": "свет и све што по њему расте.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Јер се разјарио Господ на све пуке,",
            "poem": 1
          },
          {
            "text": "расрдио се против све војске њихове;",
            "poem": 2
          },
          {
            "text": "изручио их је,",
            "poem": 1
          },
          {
            "text": "предао их је покољу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Њихови побијени леже,",
            "poem": 1
          },
          {
            "text": "и од лешева њихових смрад се подиже,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и крв њихова горја натапа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "И расула се сва војска небеска,",
            "poem": 1
          },
          {
            "text": "и небеса се савијају као свитак,",
            "poem": 2
          },
          {
            "text": "и сва војска њихова клоне,",
            "poem": 1
          },
          {
            "text": "као што клоне лист на лози,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "као што клоне на стаблу смоквину.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "„Јер мач мој се натопио на небесима.",
            "poem": 1
          },
          {
            "text": "Гле, на Едом он се спушта,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и на народ коме сам одредио да судим.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Мач за Господа напуњен је крвљу,",
            "poem": 1
          },
          {
            "text": "подмазан је лојем;",
            "poem": 2
          },
          {
            "text": "крвљу од јагањаца и јараца,",
            "poem": 1
          },
          {
            "text": "лојем с бубрега овнујских,",
            "poem": 2
          },
          {
            "text": "јер Господ има жртву у Восори,",
            "poem": 1
          },
          {
            "text": "и велико клање у земљи едомској.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "И с њима ће се то спустити",
            "poem": 1
          },
          {
            "text": "на биволе и на волове с јунцима.",
            "poem": 2
          },
          {
            "text": "И земља њихова ће се крвљу натопити,",
            "poem": 1
          },
          {
            "text": "и прашина њихова лојем омастити,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "јер Господ има дан за одмазду,",
            "poem": 1
          },
          {
            "text": "годину да се намире рачуни за Сион.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "И превратиће се потоци њезини у смолу,",
            "poem": 1
          },
          {
            "text": "и прашина њена у сумпор,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и земља ће њена бити смола у пламену,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "неће се гасити ни ноћу ни дању,",
            "poem": 1
          },
          {
            "text": "дим њен ће се дизати довека.",
            "poem": 2
          },
          {
            "text": "Од колена до колена лежаће пустош засвагда.",
            "poem": 1
          },
          {
            "text": "Никад више нико њоме пролазити неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Њу ће запосести буљина и јеж,",
            "poem": 1
          },
          {
            "text": "у њој ће боравити ушара и гавран.",
            "poem": 2
          },
          {
            "text": "И он ће на њој растегнути",
            "poem": 1
          },
          {
            "text": "мерну траку за пустош",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и висак за празнину.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Њено племство тамо неће бити, царством да га зову,",
            "poem": 1
          },
          {
            "text": "и сви њени заповедници биће уништени.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "По здањима њеним прорастаће трње,",
            "poem": 1
          },
          {
            "text": "по тврђавама њеним коприва и чкаљ,",
            "poem": 2
          },
          {
            "text": "те ће постати јазбина за шакале,",
            "poem": 1
          },
          {
            "text": "лежај за нојеве женке.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Тамо ће се срести дивље мачке с хијенама,",
            "poem": 1
          },
          {
            "text": "и длакавци ће дозивати један другог;",
            "poem": 2
          },
          {
            "text": "тамо ће се сместити ноћница-вештица",
            "poem": 1
          },
          {
            "text": "и наћи ће себи почивалиште;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "тамо ће се гнездити гуја,",
            "poem": 1
          },
          {
            "text": "полагаће своја јаја,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "лежаће на њима,",
            "poem": 2
          },
          {
            "text": "излећи ће их у сену свом;",
            "poem": 1
          },
          {
            "text": "тамо ће такође слетати јастребови",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "један за другим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Истражујте у Књизи Господњој, и читајте:",
          {
            "text": "Ниједно од њих недостајати неће,",
            "poem": 1
          },
          {
            "text": "мужјак женки неће зафалити,",
            "poem": 2
          },
          {
            "text": "зато што су уста моја",
            "poem": 1
          },
          {
            "text": "тако заповедила,",
            "poem": 2
          },
          {
            "text": "и Дух његов",
            "poem": 1
          },
          {
            "text": "тако их је сакупио;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "зато што је он за њих бацио жреб,",
            "poem": 1
          },
          {
            "text": "и његова рука им је одмерила земљу:",
            "poem": 2
          },
          {
            "text": "они ће је поседовати довека,",
            "poem": 1
          },
          {
            "text": "њу ће настањивати од колена до колена.",
            "poem": 2
          }
        ]
      }
    ],
