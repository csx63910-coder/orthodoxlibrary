  "book": {
    "id": "ISA",
    "translationId": "srp_onspc",
    "name": "Књига пророка Исаије",
    "commonName": "Књига пророка Исаије",
    "title": "Књига пророка Исаије",
    "order": 23,
    "numberOfChapters": 66,
    "sha256": "65da7472046c4c4242da6b0395082ca741c36130fd8710e93ef455190b89026a",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/ISA/1.json",
    "lastChapterNumber": 66,
    "lastChapterApiLink": "/api/srp_onspc/ISA/66.json",
    "totalNumberOfVerses": 1292
  },
  "chapter": {
    "number": 66,
    "content": [
      {
        "type": "heading",
        "content": [
          "Упозорење"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Говори Господ:",
          {
            "text": "„Небеса су престо мој,",
            "poem": 1
          },
          {
            "text": "а земља постоље за ноге моје.",
            "poem": 2
          },
          {
            "text": "Какву кућу ћете ми саградити?",
            "poem": 1
          },
          {
            "text": "И где је место мога почивања?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Па све је то рука моја начинила",
            "poem": 1
          },
          {
            "text": "и све је то постало",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "А на кога ћу погледати?",
            "poem": 1
          },
          {
            "text": "На исцрпљенога и на духовно сломљенога,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и онога који дрхти пред мојом речи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Против наопаких жртава"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Тај што коље вола,",
            "poem": 1
          },
          {
            "text": "ко човека да убија,",
            "poem": 2
          },
          {
            "text": "и ко жртвује овцу,",
            "poem": 1
          },
          {
            "text": "као да се псом скрнави;",
            "poem": 2
          },
          {
            "text": "тај што доноси принос,",
            "poem": 1
          },
          {
            "text": "ко да крв свињску приноси,",
            "poem": 2
          },
          {
            "text": "ко кади тамјаном,",
            "poem": 1
          },
          {
            "text": "тај идола благосиља.",
            "poem": 2
          },
          {
            "text": "То су они изабрали за своје путеве",
            "poem": 1
          },
          {
            "text": "и гадости њихове по вољи су души њиховој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ја ћу такође изабрати да им додијавам:",
            "poem": 1
          },
          {
            "text": "довешћу на њих то од чега зазиру.",
            "poem": 2
          },
          {
            "text": "Зато што сам звао, а одговора није било;",
            "poem": 1
          },
          {
            "text": "говорио сам, а слушали нису;",
            "poem": 2
          },
          {
            "text": "него су чинили што ја злом сматрам,",
            "poem": 1
          },
          {
            "text": "и бирали оно што ми није угодно.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Господ долази да ускоро суди"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Послушајте реч Господњу,",
            "poem": 1
          },
          {
            "text": "ви, који дрхтите од његове речи:",
            "poem": 2
          },
          {
            "text": "„Говоре ваша браћа, мрзитељи ваши,",
            "poem": 1
          },
          {
            "text": "који вас гоне због имена мојега:",
            "poem": 2
          },
          {
            "text": "’Нека се прослави Господ,",
            "poem": 1
          },
          {
            "text": "те да видимо вашу радост.’",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "И они ће постиђени бити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Глас граје из града,",
            "poem": 1
          },
          {
            "text": "глас из храма –",
            "poem": 2
          },
          {
            "text": "глас је Господа који намирује",
            "poem": 1
          },
          {
            "text": "накнаду непријатељима својим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Пре него што ју је заболело,",
            "poem": 1
          },
          {
            "text": "она је родила;",
            "poem": 2
          },
          {
            "text": "пре него што је бол на њу дошао,",
            "poem": 1
          },
          {
            "text": "она је на свет мушкарца донела.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ко је тако нешто чуо?",
            "poem": 1
          },
          {
            "text": "Ко је овако нешто видео?",
            "poem": 2
          },
          {
            "text": "Може ли земља у једном дану",
            "poem": 1
          },
          {
            "text": "да роди читави пук?",
            "poem": 2
          },
          {
            "text": "Да бол одједанпут жацне,",
            "poem": 1
          },
          {
            "text": "па да Сион синове своје роди?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "’Зар ја, који отварам материцу,",
            "poem": 1
          },
          {
            "text": "па да не рађам? – говори Господ.",
            "poem": 2
          },
          {
            "text": "Зар ја, који дајем да се рађа,",
            "poem": 1
          },
          {
            "text": "па да будем јалов? – говори Бог твој.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Радујте се због Јерусалима,",
            "poem": 1
          },
          {
            "text": "и кличите у њему, сви који га волите.",
            "poem": 2
          },
          {
            "text": "Веселите се с њим, веселите се",
            "poem": 1
          },
          {
            "text": "сви који сте туговали над њим;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "да будете надојени и насићени",
            "poem": 1
          },
          {
            "text": "на дојкама утехе његове,",
            "poem": 2
          },
          {
            "text": "да се насишете и насладите",
            "poem": 1
          },
          {
            "text": "из обиља славе његове.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Јер говори Господ:",
          {
            "text": "„Ево, ја ћу га досегнути миром који је као река,",
            "poem": 1
          },
          {
            "text": "и славом народа која је као поток набујали.",
            "poem": 2
          },
          {
            "text": "И његову одојчад ће у наручју носити",
            "poem": 1
          },
          {
            "text": "и на коленима миловати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Као човека кога мајка његова теши,",
            "poem": 1
          },
          {
            "text": "тако ћу и ја вас тешити,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и бићете утешени у Јерусалиму.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "И видећете и веселиће се срце ваше,",
            "poem": 1
          },
          {
            "text": "и као трава процветаће кости ваше,",
            "poem": 2
          },
          {
            "text": "и познаће се рука Господња",
            "poem": 1
          },
          {
            "text": "на слугама његовим, и последице њихове",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "на непријатељима његовим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Јер, гле, Господ у огњу долази,",
            "poem": 1
          },
          {
            "text": "као олуја су бојна кола његова,",
            "poem": 2
          },
          {
            "text": "вратиће у гневној разјарености својој",
            "poem": 1
          },
          {
            "text": "и карању његовом, у огњу распаљеном.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Јер ће Господ судити огњем",
            "poem": 1
          },
          {
            "text": "и мачем својим сваком људском бићу,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "те ће многи од Господа погинути.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Против отпадника"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "„Посвећују и прочишћавају сами себе у вртовима иза ’оне једне у средини’; једу свињетину и гадости и мишеве: заједно ће скончати – говори Господ."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "А ја знам дела њихова и намере њихове. Господња слава међу пуцима Долази време да се саберу сви пуци и сви језици, па ће доћи и славу моју гледати."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "И њима ћу поставити знак, те од оних који су се измакли, од њих ћу послати пуцима: у Тарсис, Фул и Луд – познатим стрелцима – у Тувал и Грчку, на острва далека где се није чуло што се о мени чује, и где се слава моја није видела. И они ће пуцима славу моју објављивати."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "И они ће довести сву браћу вашу из свих туђинских народа, принос за Господа: на коњима и на колима и у носиљкама и на мазгама и на једногрбим камилама на свету гору моју, Јерусалим – говори Господ – као што синови Израиљеви приносе принос у чистој посуди у Дому Господњем."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Па ћу и од њих узети за свештенике, за Левите – говори Господ."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Јер као што ће преда мном стајати небеса нова и земља нова, што ћу ја начинити – говори Господ – тако ће стајати потомство ваше и име ваше."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "И од младог месеца до младог месеца, и од суботе до суботе, долазиће свако биће на поклоњење пред лицем мојим – говори Господ;"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "и излазиће и гледаће лешеве људи који су се од мене одметнули, јер црв њихов не умире и огањ се њихов не гаси; и биће за презир сваком створењу.“"
        ]
      }
    ],
    "footnotes": []
  },
