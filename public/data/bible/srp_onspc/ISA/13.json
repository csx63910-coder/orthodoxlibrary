  "chapter": {
    "number": 13,
    "content": [
      {
        "type": "heading",
        "content": [
          "Против Вавилона"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Пророштво о Вавилону што га виде Исаија син Амоцов:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„На голетном брду подигните заставу,",
            "poem": 1
          },
          {
            "text": "њима из гласа вичите,",
            "poem": 2
          },
          {
            "text": "руком машите:",
            "poem": 1
          },
          {
            "text": "и нека уђу на кнежевска врата.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ја сам заповедио својим посвећенима,",
            "poem": 1
          },
          {
            "text": "па сам позвао јунаке своје за гнев мој,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "који се веселе величанству моме.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Глас је мноштва на горама,",
            "poem": 1
          },
          {
            "text": "као да је пуно народа.",
            "poem": 2
          },
          {
            "text": "Глас је буке од царстава,",
            "poem": 1
          },
          {
            "text": "од сакупљених гомила.",
            "poem": 2
          },
          {
            "text": "То Господ над војскама",
            "poem": 1
          },
          {
            "text": "врши смотру војске за бој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Долазе из далеке земље,",
            "poem": 1
          },
          {
            "text": "с небеске границе,",
            "poem": 2
          },
          {
            "text": "Господ и оруђа љутине његове,",
            "poem": 1
          },
          {
            "text": "да сву земљу разоре.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Кукајте, јер је близу дан Господњи,",
            "poem": 1
          },
          {
            "text": "пустошење од Свемоћног долази.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Све су руке зато малаксале,",
            "poem": 1
          },
          {
            "text": "свако људско срце обамрло,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "па су се устрашили,",
            "poem": 1
          },
          {
            "text": "жигање и болови их спопадају,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "грче се као породиља;",
            "poem": 2
          },
          {
            "text": "један зазире од другога,",
            "poem": 1
          },
          {
            "text": "лица су им лица од пламена.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ево долази дан Господњи,",
            "poem": 1
          },
          {
            "text": "свирепост моја и љутина и јарост гнева мојега,",
            "poem": 2
          },
          {
            "text": "да у пустош земљу претвори,",
            "poem": 1
          },
          {
            "text": "да из ње грешнике истреби;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "јер небеске звезде и сазвежђа њина",
            "poem": 1
          },
          {
            "text": "неће више светлошћу сијати,",
            "poem": 2
          },
          {
            "text": "сунце ће да згасне чим гране",
            "poem": 1
          },
          {
            "text": "и месец светлост своју неће више одсјајивати;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "јер ћу казнити васељену за злоћу,",
            "poem": 1
          },
          {
            "text": "и опаке за кривицу;",
            "poem": 2
          },
          {
            "text": "и зауставићу понос охолих,",
            "poem": 1
          },
          {
            "text": "и понизићу надменост насилничку.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Човек ће бити ређи од злата жеженога,",
            "poem": 1
          },
          {
            "text": "људски створ ређи од злата офирскога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Зато ћу небеса потрести",
            "poem": 1
          },
          {
            "text": "и земља ће се с места свога померити",
            "poem": 2
          },
          {
            "text": "због срџбе Господа над војскама,",
            "poem": 1
          },
          {
            "text": "у дан кад се гнев његов разјари.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "И тада, као срна пред хајкачима,",
            "poem": 1
          },
          {
            "text": "као овце које нико не сабира,",
            "poem": 2
          },
          {
            "text": "свако ће гледати према свом народу,",
            "poem": 1
          },
          {
            "text": "и свако ће побећи у своју земљу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Они ће пробости сваког кога стигну,",
            "poem": 1
          },
          {
            "text": "и од мача ће пасти свако кога ухвате;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "пред очима њиховим",
            "poem": 1
          },
          {
            "text": "одојчад ће им смрскати,",
            "poem": 2
          },
          {
            "text": "куће њине опљачкати,",
            "poem": 1
          },
          {
            "text": "жене њихове силовати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ево, на њих Мидијце подижем.",
            "poem": 1
          },
          {
            "text": "Они сребро не цене",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и они у злату не уживају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Они ће луком пострељати младиће,",
            "poem": 1
          },
          {
            "text": "на плод утробе се смиловати неће,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "над дечацима око им се сажалити неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Вавилон, украс царствима,",
            "poem": 1
          },
          {
            "text": "понос гордости халдејске,",
            "poem": 2
          },
          {
            "text": "биће као Содома и Гомора",
            "poem": 1
          },
          {
            "text": "када их је Бог опустошио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Он довека неће бити насељен,",
            "poem": 1
          },
          {
            "text": "од колена до колена биће ненастањен.",
            "poem": 2
          },
          {
            "text": "И Арапин онде неће подизати шатора,",
            "poem": 1
          },
          {
            "text": "нити ће пастири онде почивати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Онде ће звери пустињске боравити,",
            "poem": 1
          },
          {
            "text": "и совуљаге ће им куће напунити,",
            "poem": 2
          },
          {
            "text": "и нојеви ће онде становати,",
            "poem": 1
          },
          {
            "text": "а јарци ће тамо скакутати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "По њиховим напуштеним зградама завијаће хијене,",
            "poem": 1
          },
          {
            "text": "а по њиховим раскошним дворовима шакали.",
            "poem": 2
          },
          {
            "text": "Ближи се време његово,",
            "poem": 1
          },
          {
            "text": "а дани му се продужити неће.",
            "poem": 2
          }
        ]
      }
    ],
