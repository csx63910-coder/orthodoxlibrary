  },
  "chapter": {
    "number": 49,
    "content": [
      {
        "type": "heading",
        "content": [
          "О слузи Господњем, Песма друга"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Чујте мене, острва!",
            "poem": 1
          },
          {
            "text": "Послушајте ме, народи далеки!",
            "poem": 2
          },
          {
            "text": "Господ ме је позвао чим сам се родио,",
            "poem": 1
          },
          {
            "text": "моје име је споменуо од утробе материне,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "и начинио је уста моја као оштар мач,",
            "poem": 1
          },
          {
            "text": "сеном своје руке он ме је заклонио,",
            "poem": 2
          },
          {
            "text": "у глатку ме стрелу претворио,",
            "poem": 1
          },
          {
            "text": "у тоболцу своме он ме је сакрио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Рекао ми је: ’Израиљу, ти си мој слуга,",
            "poem": 1
          },
          {
            "text": "у ком ћу постати поносан.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "А ја сам рекао: ’Узалуд сам се мучио за опустошеност,",
            "poem": 1
          },
          {
            "text": "и испразно упињао снагу своју.",
            "poem": 2
          },
          {
            "text": "Ипак, правда је моја код Господа,",
            "poem": 1
          },
          {
            "text": "и учинак мој код Бога мојега.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "И сад говори Господ",
            "poem": 1
          },
          {
            "text": "који ме је пре рођења слугом својим начинио,",
            "poem": 2
          },
          {
            "text": "да му Јакова повратим",
            "poem": 1
          },
          {
            "text": "и да му се Израиљ сабере.",
            "poem": 2
          },
          {
            "text": "И прославићу се у очима Господњим,",
            "poem": 1
          },
          {
            "text": "и Бог мој ће бити снага моја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "И рече:",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "’Неважно је да ми будеш слуга,",
            "poem": 1
          },
          {
            "text": "да подигнем племе Јаковљево,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и да вратиш остатке Израиљеве,",
            "poem": 2
          },
          {
            "text": "него ћу те одредити да будеш светлост пуцима,",
            "poem": 1
          },
          {
            "text": "да будеш спасење моје до краја земље.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Песма о славном повратку"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Говори Господ,",
            "poem": 1
          },
          {
            "text": "Откупитељ Израиљев, Светитељ његов,",
            "poem": 2
          },
          {
            "text": "оном коме презиру душу,",
            "poem": 1
          },
          {
            "text": "на кога се гади пук, слузи насилницима:",
            "poem": 2
          },
          {
            "text": "„Видеће цареви и устаће главари,",
            "poem": 1
          },
          {
            "text": "и клањаће ти се",
            "poem": 2
          },
          {
            "text": "због Господа који је веран,",
            "poem": 1
          },
          {
            "text": "Светитеља Израиљева који те је изабрао.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Обнова Израиља"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Говори Господ:",
          {
            "text": "„У време повољно сам те услишио,",
            "poem": 1
          },
          {
            "text": "и у дан спасења сам ти помогао,",
            "poem": 2
          },
          {
            "text": "и саздао сам те и поставио те",
            "poem": 1
          },
          {
            "text": "за савез с народом,",
            "poem": 2
          },
          {
            "text": "за подизање земље,",
            "poem": 1
          },
          {
            "text": "за убаштињење разорених баштина,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "за реч утамниченима: ’Изађите!’,",
            "poem": 1
          },
          {
            "text": "и онима који су у тами: ’Покажите се!’",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "На путевима ће се напасати,",
            "poem": 1
          },
          {
            "text": "и по свим висоравнима биће паша њихова.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Неће бити ни гладни ни жедни,",
            "poem": 1
          },
          {
            "text": "и неће их мучити ни суша ни сунце,",
            "poem": 2
          },
          {
            "text": "јер ће их водити онај који им се смиловао,",
            "poem": 1
          },
          {
            "text": "и довешће их на изворе водене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "И претвориће све горе моје у пут,",
            "poem": 1
          },
          {
            "text": "и уздићи ће моје друмове.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ево, неки долазе из далека,",
            "poem": 1
          },
          {
            "text": "и, гле, неки са севера и са запада,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а неки из земље Синим.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Кличите, небеса,",
            "poem": 1
          },
          {
            "text": "и весели се, земљо!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Подвикујте, планине, раздрагано!",
            "poem": 2
          },
          {
            "text": "Зато што Господ теши народ свој,",
            "poem": 1
          },
          {
            "text": "и смиловаће се на невољнике своје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "А Сион рече: „Напустио ме Господ“",
            "poem": 1
          },
          {
            "text": "и „Господар ме је заборавио.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "„Може ли жена заборавити своје одојче,",
            "poem": 1
          },
          {
            "text": "да се не смилује на сина утробе своје?",
            "poem": 2
          },
          {
            "text": "Ако би нека и заборавила,",
            "poem": 1
          },
          {
            "text": "ја пак тебе заборавити нећу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ево, на оба длана сам те урезао,",
            "poem": 1
          },
          {
            "text": "зидови твоји преда мном су свагда.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Градитељи твоји журе,",
            "poem": 1
          },
          {
            "text": "рушитељи твоји и пустошници твоји од тебе одлазе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Осврни се и погледај око себе,",
            "poem": 1
          },
          {
            "text": "сви се они сабирају, к теби долазе.",
            "poem": 2
          },
          {
            "text": "Живота ми мога – говори Господ –",
            "poem": 1
          },
          {
            "text": "свима ћеш се њима као хаљином оденути,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и као невеста њима украсити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Рушевине своје и развалине своје,",
            "poem": 1
          },
          {
            "text": "и земљу похарану своју",
            "poem": 2
          },
          {
            "text": "сад подешаваш за становање,",
            "poem": 1
          },
          {
            "text": "и зато ће се удаљити који те затиру.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Поново ће ти говорити на уши",
            "poem": 1
          },
          {
            "text": "синови којих си била лишена:",
            "poem": 2
          },
          {
            "text": "’Тесно ми је место;",
            "poem": 1
          },
          {
            "text": "помери се и настанићу се.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "И говорићеш у срцу своме:",
            "poem": 1
          },
          {
            "text": "’Ко ми је ово родио?",
            "poem": 2
          },
          {
            "text": "А ја сам била без деце и плода,",
            "poem": 1
          },
          {
            "text": "прогнана и одбачена,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а ове, ко је одгајио?",
            "poem": 2
          },
          {
            "text": "Ето, ја сам остала сама;",
            "poem": 1
          },
          {
            "text": "ови, откуда су они?’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Говори Господар Господ:",
          {
            "text": "„Ево, руком својом машем пуцима",
            "poem": 1
          },
          {
            "text": "и заставу своју подижем народима.",
            "poem": 2
          },
          {
            "text": "Па ћу вратити синове твоје на груди,",
            "poem": 1
          },
          {
            "text": "и донећу ћерке на плећима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "И цареви ће о теби бринути,",
            "poem": 1
          },
          {
            "text": "и кнегиње њихове биће твоје дојкиње.",
            "poem": 2
          },
          {
            "text": "Клањаће ти се до земље",
            "poem": 1
          },
          {
            "text": "и прашину с ногу твојих лизаће.",
            "poem": 2
          },
          {
            "text": "И знаћеш да сам ја Господ.",
            "poem": 1
          },
          {
            "text": "Неће се постидети који се уздају у мене.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Може ли се јунаку плен запленити,",
            "poem": 1
          },
          {
            "text": "или да заробљеник побегне од ужасника?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Ипак, говори Господ:",
          {
            "text": "„Јунаку ће бити заплењен заробљеник",
            "poem": 1
          },
          {
            "text": "и плен ће побећи од ужасника,",
            "poem": 2
          },
          {
            "text": "а са онима који се с тобом споре",
            "poem": 1
          },
          {
            "text": "спорићу се ја, и твоје синове избавићу ја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "А тлачитеље твоје натераћу да једу месо своје,",
            "poem": 1
          },
          {
            "text": "и као младим вином опијаће се крвљу својом.",
            "poem": 2
          },
          {
            "text": "И знаће тело свако",
            "poem": 1
          },
          {
            "text": "да сам ја, Господ, Спаситељ твој,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и да је Силни Јаковљев Откупитељ твој.“",
            "poem": 2
          }
        ]
      }
    ],
