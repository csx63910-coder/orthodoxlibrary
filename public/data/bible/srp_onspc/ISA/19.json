  "chapter": {
    "number": 19,
    "content": [
      {
        "type": "heading",
        "content": [
          "Реч против Египта"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Пророштво против Египта.",
          {
            "text": "Ево, Господ јаше на лаку облаку,",
            "poem": 1
          },
          {
            "text": "и у Египат стиже.",
            "poem": 2
          },
          {
            "text": "Дрхћу пред њим египатски идоли,",
            "poem": 1
          },
          {
            "text": "Египћанима срце у грудима обамире.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Подбошћу Египћане против Египћана,",
            "poem": 1
          },
          {
            "text": "и човек ће се борити против брата својега,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и човек против друга својега,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "град против града,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "царство против царства.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Египат ће клонути духом.",
            "poem": 1
          },
          {
            "text": "Ја ћу спречити његове намере,",
            "poem": 2
          },
          {
            "text": "те ће тражити код идола и код врачара,",
            "poem": 1
          },
          {
            "text": "код призивача духова и код видовњака.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Египћане ћу ја предати",
            "poem": 1
          },
          {
            "text": "у руке окрутном господару;",
            "poem": 2
          },
          {
            "text": "цар жестоки над њима ће владати",
            "poem": 1
          },
          {
            "text": "– говори Господар Господ над војскама.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Из реке ће испарити воде,",
            "poem": 1
          },
          {
            "text": "корита ће речна пресахнути и пресушити,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "усмрдеће се прокопи,",
            "poem": 1
          },
          {
            "text": "сахнуће рукавци египатски и пресушиће.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Увенуће трска и рогоз.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ливаде крај Нила, крај ушћа Нила,",
            "poem": 1
          },
          {
            "text": "и сви усеви крај Нила усахнуће;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "биће одбачени и неће их више бити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "И туговаће рибари,",
            "poem": 1
          },
          {
            "text": "и јадиковаће који бацају у Нил удицу,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и биће уплакани који мреже по води бацају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "И постидеће се који обрађују лан,",
            "poem": 1
          },
          {
            "text": "влачари и ткачи платна белога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Срушене су уставе његове,",
            "poem": 1
          },
          {
            "text": "растужиће се који граде за плату.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ах, главари соански су лудаци,",
            "poem": 1
          },
          {
            "text": "мудри саветници фараонови саветују глупаво.",
            "poem": 2
          },
          {
            "text": "Како то говорите фараону:",
            "poem": 1
          },
          {
            "text": "„Ученик сам мудрих људи,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ученик сам древних царева.“?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Где ли су ти твоји мудраци?",
            "poem": 1
          },
          {
            "text": "Нека ти дојаве и нека обзнане:",
            "poem": 2
          },
          {
            "text": "Шта је Господ над војскама",
            "poem": 1
          },
          {
            "text": "за Египат наумио?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Главари соански су луди,",
            "poem": 1
          },
          {
            "text": "преварише се кнезови нофски,",
            "poem": 2
          },
          {
            "text": "они заводе Египат,",
            "poem": 1
          },
          {
            "text": "његове племенске угледнике.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Господ је у њих улио духа забуне,",
            "poem": 1
          },
          {
            "text": "те Египат смућују",
            "poem": 2
          },
          {
            "text": "у свему што он чини,",
            "poem": 1
          },
          {
            "text": "јер се тетура као пијаница кад повраћа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Више неће бити у Египту рада,",
            "poem": 1
          },
          {
            "text": "било да га чини глава или реп,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "било палма или сита.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Египат и Асирија долазе Богу"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "У дан онај Египћани ће бити као жене, дрхтаће и стрепеће кад Господ над војскама на њих руком замахне, којом он маше над њима."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Тле јудејско на ужас Египту ће бити; бојаће се ко год му га помене, због намере што је Господ над војскама за Египат наумио."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "У дан онај биће у земљи египатској пет градова где ће се језиком хананским говорити и где ће се Господу над војскама заклињати; „град Ахерес",
          {
            "noteId": 6
          },
          "“ рећи ће за једнога."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "У дан онај биће жртвеник Господњи усред земље египатске, и стуб посвећен Господу близу границе његове."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "И биће знак и сведочанство за Господа над војскама у земљи египатској: кад против тлачитеља призову Господа, он ће им послати спаситеља и војсковођу – избавитеља."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "И Господ ће себе обзнанити Египћанима, и Египћани ће познати Господа у дан онај, и служиће му жртвама и приносима, заветоваће Господу завете и извршаваће."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Господ ће Египћане ударити тешко, али ће их исцелити; и они ће се Господу обратити, и он ће их услишити и излечити."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "У дан онај друм ће бити од Египта до Асирије: Асирци ће долазити у Египат и Египћани у Асирију. Египћани и Асирци служиће Господу."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "У дан онај Израиљ ће бити трећи са Египтом и Асиријом, да буду благослов усред земље."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Благословиће их Господ над војскама:",
          {
            "text": "„Нека је благословен – говориће се –",
            "poem": 1
          },
          {
            "text": "мој народ египатски,",
            "poem": 2
          },
          {
            "text": "и дело руку мојих, Асирија,",
            "poem": 1
          },
          {
            "text": "и достојање моје, Израиљ.“",
            "poem": 2
          }
        ]
      }
    ],
