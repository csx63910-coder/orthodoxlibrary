  "chapter": {
    "number": 54,
    "content": [
      {
        "type": "heading",
        "content": [
          "Велик је Јерусалим"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Кличи, нероткињо, која не рађаш,",
            "poem": 1
          },
          {
            "text": "подврискуј кличући;",
            "poem": 2
          },
          {
            "text": "весели се која за порођај не знаш,",
            "poem": 1
          },
          {
            "text": "јер више синова има самотна",
            "poem": 2
          },
          {
            "text": "него ли удата –",
            "poem": 1
          },
          {
            "text": "говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Рашири место за свој шатор,",
            "poem": 1
          },
          {
            "text": "разастри платна за своје коначиште.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Не штеди!",
            "poem": 2
          },
          {
            "text": "Ужад своју продужи,",
            "poem": 1
          },
          {
            "text": "кочиће своје учврсти!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Јер десно и лево ћеш се пробити",
            "poem": 1
          },
          {
            "text": "и потомство ће твоје пуке запосести",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и настаниће опустеле градове.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Господња љубав"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Не бој се, нећеш се постидети.",
            "poem": 1
          },
          {
            "text": "Не стиди се, јер нећеш црвенети.",
            "poem": 2
          },
          {
            "text": "Јер ћеш заборавити срамоту младости своје,",
            "poem": 1
          },
          {
            "text": "и нећеш више спомињати",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "што су те понижавали док си била удовица.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Јер твој супруг је Саздатељ твој,",
            "poem": 1
          },
          {
            "text": "његово је име Господ над војскама,",
            "poem": 2
          },
          {
            "text": "и твој Откупитељ је Светитељ Израиљев,",
            "poem": 1
          },
          {
            "text": "он се зове Бог земље свеколике.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Наиме, као жену остављену",
            "poem": 1
          },
          {
            "text": "и духовно уцвељену позвао те је Господ,",
            "poem": 2
          },
          {
            "text": "и отпуштену жену",
            "poem": 1
          },
          {
            "text": "с којом си од младости своје“ –",
            "poem": 2
          },
          {
            "text": "говори Бог твој.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "„За трен кратки сам те оставио,",
            "poem": 1
          },
          {
            "text": "а у великим милосрђима тебе ћу пригрлити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Из мене је срџба провалила,",
            "poem": 1
          },
          {
            "text": "и за часак сам заклонио лице своје од тебе,",
            "poem": 2
          },
          {
            "text": "а смиловао сам ти се по вечној милости –",
            "poem": 1
          },
          {
            "text": "говори Откупитељ твој, Господ.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Јер ово им је као воде Нојеве,",
            "poem": 1
          },
          {
            "text": "кад се заклех да воде Нојеве",
            "poem": 2
          },
          {
            "text": "више земљу преплављати неће:",
            "poem": 1
          },
          {
            "text": "тако се заклињем",
            "poem": 2
          },
          {
            "text": "да на тебе срдити се нећу",
            "poem": 1
          },
          {
            "text": "и да тебе прекорити нећу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Нека се планине помакну",
            "poem": 1
          },
          {
            "text": "и нека се брда уздрмају,",
            "poem": 2
          },
          {
            "text": "ипак се моја милост од тебе одмаћи неће,",
            "poem": 1
          },
          {
            "text": "нити ће се уздрмати мој савез мировни",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "– говори Господ који ти се смиловао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Јерусалим обновљен и благословен"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Невољнице, вихором витлана, неутешена,",
            "poem": 1
          },
          {
            "text": "гле, ја ћу сложити на мермер камење твоје,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и на сафире темељ твој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "И од рубина дићи ћу ти на тврђави зупце;",
            "poem": 1
          },
          {
            "text": "и од карбункула твоје вратнице,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и све ограде твоје од камења драгога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "И сви синови твоји биће учени од Господа,",
            "poem": 1
          },
          {
            "text": "и обилан мир имаће синови твоји.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Бићеш саздана на правди.",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Одбаци страх,",
            "poem": 1
          },
          {
            "text": "јер немаш се чега бојати.",
            "poem": 2
          },
          {
            "text": "Одбаци страх,",
            "poem": 1
          },
          {
            "text": "јер он ти се ни примаћи неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Гле, постројиће се против тебе",
            "poem": 1
          },
          {
            "text": "као да је то од мене.",
            "poem": 2
          },
          {
            "text": "Ко се построји против тебе",
            "poem": 1
          },
          {
            "text": "пропашће због тебе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Гле, ја сам ковача створио,",
            "poem": 1
          },
          {
            "text": "који жеравицу распаљује,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "вади из ње оружје да га искује,",
            "poem": 2
          },
          {
            "text": "а ја сам и затирача створио да затире.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ниједно оружје исковано против тебе неће успети,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и сваки језик који се против тебе подигне",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "на суду ћеш оборити.",
            "poem": 2
          },
          {
            "text": "То је баштина слугу Господњих",
            "poem": 1
          },
          {
            "text": "и правда њихова од мене – говори Господ.",
            "poem": 2
          }
        ]
      }
    ],
