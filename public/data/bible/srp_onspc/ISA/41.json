  "chapter": {
    "number": 41,
    "content": [
      {
        "type": "heading",
        "content": [
          "Владар са истока – опомена од Господа"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "„Умукните преда мном, острва,",
            "poem": 1
          },
          {
            "text": "и нека снагу обнове народи.",
            "poem": 2
          },
          {
            "text": "Нека се примакну, па нека проговоре;",
            "poem": 1
          },
          {
            "text": "приступимо на суд заједно.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ко је са истока подигао праведност,",
            "poem": 1
          },
          {
            "text": "позвао га до својих стопа,",
            "poem": 2
          },
          {
            "text": "даје му пред собом народе",
            "poem": 1
          },
          {
            "text": "и цареве покорава?",
            "poem": 2
          },
          {
            "text": "Мачу његовом их као прашину даје,",
            "poem": 1
          },
          {
            "text": "луком његовим су распршени као слама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Он њих гони, безбедно напредује,",
            "poem": 1
          },
          {
            "text": "ноге му на друмове не долазе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ко то чини и ко то постиже,",
            "poem": 1
          },
          {
            "text": "који од почетка призива нараштаје?",
            "poem": 2
          },
          {
            "text": "Ја, Господ, који сам Први и Последњи, то сам ја.“",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Острва гледају и страх их обузима,",
            "poem": 1
          },
          {
            "text": "дрхћу крајеви земаљски,",
            "poem": 2
          },
          {
            "text": "они се приближавају и већ су ту.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Човек свом другу помаже",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и свом брату говори: „Буди јак!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ливац бодри златаре,",
            "poem": 1
          },
          {
            "text": "онај који чекићем тањи",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "бодри оног који кује на наковњу.",
            "poem": 2
          },
          {
            "text": "Он говори о споју: „То је добро“,",
            "poem": 1
          },
          {
            "text": "и кип утврђује клиновима да се не помиче.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Бог је са својим народом"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "„А ти, Израиљу, слуго мој,",
            "poem": 1
          },
          {
            "text": "Јакове, изабраниче мој,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "потомче Аврахама, мог љубимца!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ти, кога оснажих са земљиних крајева",
            "poem": 1
          },
          {
            "text": "и кога позвах с њених рубова;",
            "poem": 2
          },
          {
            "text": "ти, коме сам рекао: ’Ти си слуга мој’,",
            "poem": 1
          },
          {
            "text": "тебе сам изабрао и нећу те одбацити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Не бој се, јер ја сам с тобом,",
            "poem": 1
          },
          {
            "text": "не обзири се застрашено, јер ја сам Бог твој.",
            "poem": 2
          },
          {
            "text": "Ја те крепим и заиста ти помажем,",
            "poem": 1
          },
          {
            "text": "заиста те подупирем десницом правде своје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Гле, постидеће се и посрамиће се",
            "poem": 1
          },
          {
            "text": "сви који су против тебе беснели",
            "poem": 2
          },
          {
            "text": "и биће као ништа,",
            "poem": 1
          },
          {
            "text": "и пропашће који се с тобом парничише.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Тражићеш своје противнике,",
            "poem": 1
          },
          {
            "text": "али их нећеш наћи.",
            "poem": 2
          },
          {
            "text": "Биће као ништа и ишчезнуће",
            "poem": 1
          },
          {
            "text": "они који против тебе војују.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Јер ја, Господ, Бог твој,",
            "poem": 1
          },
          {
            "text": "крепим десницу твоју, говорим ти:",
            "poem": 2
          },
          {
            "text": "Не бој се,",
            "poem": 1
          },
          {
            "text": "ја ти помажем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Не бој се, црвићу Јакове, људство Израиљево,",
            "poem": 1
          },
          {
            "text": "ја ћу ти помоћи – говори Господ.",
            "poem": 2
          },
          {
            "text": "Израиљев Светитељ,",
            "poem": 1
          },
          {
            "text": "Он је твој Откупитељ.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Гле, начинио сам те да будеш оштри млат,",
            "poem": 1
          },
          {
            "text": "нови, са зупцима јаким;",
            "poem": 2
          },
          {
            "text": "млатићеш брда и сатираћеш,",
            "poem": 1
          },
          {
            "text": "а од брегова ћеш плеву начинити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ти ћеш њих вејати, и ветар ће их однети,",
            "poem": 1
          },
          {
            "text": "вихор ће их распршити.",
            "poem": 2
          },
          {
            "text": "А ти ћеш кликтати Господу,",
            "poem": 1
          },
          {
            "text": "славићеш Светитеља Израиљевог.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Чудесне промене од Бога долазе"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Убоги и бедни воду траже, а ње нема.",
            "poem": 1
          },
          {
            "text": "Језик им се од жеђи осушио.",
            "poem": 2
          },
          {
            "text": "Ја, Господ, њих ћу услишити.",
            "poem": 1
          },
          {
            "text": "Ја, Бог Израиљев, њих нећу заборавити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Отворићу реке у голетима,",
            "poem": 1
          },
          {
            "text": "и изворе посред долина.",
            "poem": 2
          },
          {
            "text": "Пустињу ћу у рит претворити,",
            "poem": 1
          },
          {
            "text": "а сушну земљу у врело.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "У пустињи посадићу кедар,",
            "poem": 1
          },
          {
            "text": "багрем и мирту и маслину.",
            "poem": 2
          },
          {
            "text": "Пустињу ћу пошумити чемпресом,",
            "poem": 1
          },
          {
            "text": "брестом и шимширом заједно.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Нека људи виде и нека знају,",
            "poem": 1
          },
          {
            "text": "и нека промисле и нека схвате заједно,",
            "poem": 2
          },
          {
            "text": "да је то учинила рука Господња,",
            "poem": 1
          },
          {
            "text": "и створио Светитељ Израиљев.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Господ је проверени Бог"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Свој спор изложите! – говори Господ.",
            "poem": 1
          },
          {
            "text": "Доказе предочите! – говори цар Израиљев.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Нека приступе и нек нам објаве",
            "poem": 1
          },
          {
            "text": "оно што ће се догодити.",
            "poem": 2
          },
          {
            "text": "Прошлост – шта су открили?",
            "poem": 1
          },
          {
            "text": "да о томе размишљамо",
            "poem": 2
          },
          {
            "text": "и знамо што се испунило?",
            "poem": 1
          },
          {
            "text": "Него објавите шта ће доћи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Откријте нам шта ће после бити,",
            "poem": 1
          },
          {
            "text": "па ћемо познати да сте богови.",
            "poem": 2
          },
          {
            "text": "Хајде, учините нешто, добро или зло,",
            "poem": 1
          },
          {
            "text": "па да се задивимо и заједно увидимо.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Гле, ви сте ништа,",
            "poem": 1
          },
          {
            "text": "и дела су ваша као издисај;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ко вас изабере, тај је одвратан.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Пророштво о непристрасном освајачу"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Подигао сам га са севера,",
            "poem": 1
          },
          {
            "text": "и он је дошао са истока сунчанога;",
            "poem": 2
          },
          {
            "text": "те ће доћи на достојанственике као по каљузи,",
            "poem": 1
          },
          {
            "text": "и газиће их као грнчар глину.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Ко је од искона објавио па да знамо,",
            "poem": 1
          },
          {
            "text": "унапред, па да кажемо: ’У праву је!’?",
            "poem": 2
          },
          {
            "text": "Заиста, нема ко да објављује.",
            "poem": 1
          },
          {
            "text": "Заиста, нема ко да обавештава.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Заиста, нема ко да чује речи ваше.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Прво Сиону рекох: ’Гле, ево их!’",
            "poem": 1
          },
          {
            "text": "и Јерусалиму ћу дати весника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "И ја гледам, а човека нема,",
            "poem": 1
          },
          {
            "text": "и међу њима, а саветника нема,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "па ја их питам, а не одговарају ни реч.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Гле, сви су они зли;",
            "poem": 1
          },
          {
            "text": "ништавило су дела њихова,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ветар и празнина кипови су њихови.",
            "poem": 2
          }
        ]
      }
    ],
