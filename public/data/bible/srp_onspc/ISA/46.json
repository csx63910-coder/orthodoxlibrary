    "title": "Књига пророка Исаије",
    "order": 23,
    "numberOfChapters": 66,
    "sha256": "65da7472046c4c4242da6b0395082ca741c36130fd8710e93ef455190b89026a",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/ISA/1.json",
    "lastChapterNumber": 66,
    "lastChapterApiLink": "/api/srp_onspc/ISA/66.json",
    "totalNumberOfVerses": 1292
  },
  "chapter": {
    "number": 46,
    "content": [
      {
        "type": "heading",
        "content": [
          "Немоћна божанства и свемоћни Господ"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Паде Вил! Сруши се Навав!",
            "poem": 1
          },
          {
            "text": "Стављају своје рукотворине на животиње и на стоку.",
            "poem": 2
          },
          {
            "text": "Носе их као бремена,",
            "poem": 1
          },
          {
            "text": "терет што замара.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Руше се и падају заједно.",
            "poem": 1
          },
          {
            "text": "Не могу избавити носиоце.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "И душе своје у ропство одводе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "„Слушајте ме, доме Јаковљев,",
            "poem": 1
          },
          {
            "text": "и сви остаци дома Израиљева!",
            "poem": 2
          },
          {
            "text": "Ја сам вас носио од рођења;",
            "poem": 1
          },
          {
            "text": "Ја сам вас подизао од утробе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "И кад остарите, ја остајем исти;",
            "poem": 1
          },
          {
            "text": "и кад оседите, ја ћу бити потпора.",
            "poem": 2
          },
          {
            "text": "Ја сам чинио и ја ћу подизати,",
            "poem": 1
          },
          {
            "text": "и ја ћу подупирати и допремати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "С ким бисте ме упоредили,",
            "poem": 1
          },
          {
            "text": "и сличним и изгледним учинили и поредили?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ваде злато из торбе,",
            "poem": 1
          },
          {
            "text": "и сребро мере на ваги,",
            "poem": 2
          },
          {
            "text": "у најам узимају ливца",
            "poem": 1
          },
          {
            "text": "да им од тога начини бога,",
            "poem": 2
          },
          {
            "text": "да падају ничице,",
            "poem": 1
          },
          {
            "text": "челом и телом да се простиру.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Подижу га на раме, подупиру га,",
            "poem": 1
          },
          {
            "text": "спуштају га доле и стоји,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "из места својега и не помера се,",
            "poem": 2
          },
          {
            "text": "нити виче на њих и не одговара;",
            "poem": 1
          },
          {
            "text": "не спасава никога из невоље његове.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Помоћ је близу"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Сетите се тога и будите људи;",
            "poem": 1
          },
          {
            "text": "одметници, узмите то к срцу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Сетите се почетака из древности.",
            "poem": 1
          },
          {
            "text": "Та, ја сам Бог и нема другога,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Бог јесам и нико није као ја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "На почетку последице најављујем,",
            "poem": 1
          },
          {
            "text": "и унапред што се није збило.",
            "poem": 2
          },
          {
            "text": "Кажем: ’Одлука ће се моја извршити,",
            "poem": 1
          },
          {
            "text": "и учинићу све што хоћу.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Позваћу са истока грабљивицу,",
            "poem": 1
          },
          {
            "text": "из далеке земље човека по одлуци својој.",
            "poem": 2
          },
          {
            "text": "Што рекох, то ћу и довести.",
            "poem": 1
          },
          {
            "text": "Што исказах, то ћу учинити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Слушајте ме, срцем упорни,",
            "poem": 1
          },
          {
            "text": "од праведности удаљени.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Праведност своју примичем,",
            "poem": 1
          },
          {
            "text": "није се удаљила;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и спасење моје окаснити неће.",
            "poem": 2
          },
          {
            "text": "И на Сион ћу спасење ставити,",
            "poem": 1
          },
          {
            "text": "Израиљу прослављење своје.“",
            "poem": 2
          }
        ]
      }
    ],
