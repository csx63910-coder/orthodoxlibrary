  "chapter": {
    "number": 12,
    "content": [
      {
        "type": "heading",
        "content": [
          "Песма захвалности"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "У онај дан ти ћеш говорити:",
          {
            "text": "„Хвалим те, Господе,",
            "poem": 1
          },
          {
            "text": "ти си се на мене разгневио,",
            "poem": 2
          },
          {
            "text": "али и гнев свој одвратио;",
            "poem": 1
          },
          {
            "text": "још си ме утешио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ево, Бог је спасење моје,",
            "poem": 1
          },
          {
            "text": "уздам се и нећу се бојати,",
            "poem": 2
          },
          {
            "text": "јер је Господ снага моја и песма Господња,",
            "poem": 1
          },
          {
            "text": "он ми је био на спасење.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "И радосно ћете црпсти воду",
            "poem": 1
          },
          {
            "text": "из спасоносних извора.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Ви ћете говорити у дан онај:",
          {
            "text": "„Захваљујте Господу!",
            "poem": 1
          },
          {
            "text": "Призивајте име његово!",
            "poem": 2
          },
          {
            "text": "Обзнањујте народима дела његова!",
            "poem": 1
          },
          {
            "text": "Помињите како је узвишено дело његово!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Певајте Господу зато што је сазвао дивоту.",
            "poem": 1
          },
          {
            "text": "Нека то буде по свој земљи знано.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Кличите и узвисујте, становници Сиона,",
            "poem": 1
          },
          {
            "text": "јер је велик међу вама Израиљев Светитељ.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
