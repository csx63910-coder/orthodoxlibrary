  "chapter": {
    "number": 62,
    "content": [
      {
        "type": "heading",
        "content": [
          "Божија обећања Јерусалиму"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Сиона ради ућутати нећу",
            "poem": 1
          },
          {
            "text": "и због Јерусалима одмора ми нема,",
            "poem": 2
          },
          {
            "text": "док његова праведност као бљесак не сине,",
            "poem": 1
          },
          {
            "text": "и спасење његово као буктиња се не разбукти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "И пуци ће видети праведност твоју,",
            "poem": 1
          },
          {
            "text": "сви цареви славу твоју.",
            "poem": 2
          },
          {
            "text": "А тебе ће новим именом назвати,",
            "poem": 1
          },
          {
            "text": "како то буду уста Господња одредила.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "И бићеш венац блистави у Господњој руци,",
            "poem": 1
          },
          {
            "text": "и турбан царски на длану Бога својега.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Више ти се неће говорити: „Остављена“,",
            "poem": 1
          },
          {
            "text": "нити ће се земљи твојој говорити: „Опустошена“,",
            "poem": 2
          },
          {
            "text": "него ће те звати: „Милина моја“,",
            "poem": 1
          },
          {
            "text": "а земљу твоју: „Удата“.",
            "poem": 2
          },
          {
            "text": "Јер ћеш Господу милина бити,",
            "poem": 1
          },
          {
            "text": "и земља ће твоја мужа имати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Јер као што се младић жени девицом,",
            "poem": 1
          },
          {
            "text": "твој Саздатељ ће се оженити тобом,",
            "poem": 2
          },
          {
            "text": "и као што се женик весели невести,",
            "poem": 1
          },
          {
            "text": "веселиће се теби Бог твој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "По зидовима твојим, Јерусалиме,",
            "poem": 1
          },
          {
            "text": "стражаре сам распоредио.",
            "poem": 2
          },
          {
            "text": "По цео дан и по целу ноћ",
            "poem": 1
          },
          {
            "text": "они неће заћутати никако.",
            "poem": 2
          },
          {
            "text": "Они подсећају Господа,",
            "poem": 1
          },
          {
            "text": "њима починка нема.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Не дајте му да почине док не учврсти и устроји Јерусалим,",
            "poem": 1
          },
          {
            "text": "да он буде земљи на похвалу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Заклео се Господ десницом својом",
            "poem": 1
          },
          {
            "text": "и снажном мишицом својом:",
            "poem": 2
          },
          {
            "text": "„Више неће дати жито твоје",
            "poem": 1
          },
          {
            "text": "да га једу непријатељи твоји,",
            "poem": 2
          },
          {
            "text": "ни да синови туђински пију твоје вино",
            "poem": 1
          },
          {
            "text": "на чему си се ти трудио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Него који су га жели, ти ће га и јести,",
            "poem": 1
          },
          {
            "text": "Господа хвалиће;",
            "poem": 2
          },
          {
            "text": "и који су га брали, ти ће га и пити",
            "poem": 1
          },
          {
            "text": "у предворју мојега Светилишта.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Песма за завршетак"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Прођите! Прођите кроз вратнице!",
            "poem": 1
          },
          {
            "text": "Поравнајте народу пут!",
            "poem": 2
          },
          {
            "text": "Насипајте! Насипајте друм!",
            "poem": 1
          },
          {
            "text": "Уклоните камење!",
            "poem": 2
          },
          {
            "text": "Подигните народима знамење!",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ево, Господ се гласи",
            "poem": 1
          },
          {
            "text": "до земљиних крајева:",
            "poem": 2
          },
          {
            "text": "„Реците ћерки сионској:",
            "poem": 1
          },
          {
            "text": "’Ево, Спас твој долази.",
            "poem": 2
          },
          {
            "text": "Ево с њим је плата његова,",
            "poem": 1
          },
          {
            "text": "испред њега најамнина његова.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Они ће се звати:",
            "poem": 1
          },
          {
            "text": "„Свети народ“, „Откупљени Господом“,",
            "poem": 2
          },
          {
            "text": "а тебе ће звати: „Тражени“,",
            "poem": 1
          },
          {
            "text": "„Град неостављени“.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
