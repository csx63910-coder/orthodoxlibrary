  "chapter": {
    "number": 18,
    "content": [
      {
        "type": "heading",
        "content": [
          "Реч против Куша"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Тешко земљи размахнутих крила,",
            "poem": 1
          },
          {
            "text": "с оне стране кушанских река,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "која морем шаље гласнике,",
            "poem": 1
          },
          {
            "text": "и водом у чамцима рогозним.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Идите, хитри весници,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "пуку лепа стаса и тамне пути,",
            "poem": 1
          },
          {
            "text": "народу ког се боје и надаље,",
            "poem": 2
          },
          {
            "text": "пуку жилавом и завојевачком,",
            "poem": 1
          },
          {
            "text": "чијом земљом се преплићу реке.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Сви становници васељене,",
            "poem": 1
          },
          {
            "text": "житељи земље,",
            "poem": 2
          },
          {
            "text": "кад се застава на горама подигне,",
            "poem": 1
          },
          {
            "text": "гледајте;",
            "poem": 2
          },
          {
            "text": "и кад рог затруби,",
            "poem": 1
          },
          {
            "text": "слушајте.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Јер мени говори Господ:",
            "poem": 1
          },
          {
            "text": "„Одмараћу се и посматрати са својег места,",
            "poem": 2
          },
          {
            "text": "као жега зажарена над светлошћу,",
            "poem": 1
          },
          {
            "text": "као росни облак кад је жега током жетве.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Пре бербе, кад процвета лоза,",
            "poem": 1
          },
          {
            "text": "дозревање гроздова је у јеку,",
            "poem": 2
          },
          {
            "text": "и секачима ће посећи младице,",
            "poem": 1
          },
          {
            "text": "и одстранити посечене лозице.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Заједно ће бити остављени",
            "poem": 1
          },
          {
            "text": "грабљивицама горским и зверима по земљи:",
            "poem": 2
          },
          {
            "text": "грабљивице ће на њима летовати,",
            "poem": 1
          },
          {
            "text": "и све звери земаљске зимовати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "У то време дар доносиће Господу над војскама",
          {
            "text": "пук лепа стаса и тамне пути,",
            "poem": 1
          },
          {
            "text": "народ ког се боје и надаље,",
            "poem": 2
          },
          {
            "text": "пук жилав и завојевачки,",
            "poem": 1
          },
          {
            "text": "чијом земљом преплићу се реке,",
            "poem": 2
          },
          "к месту где је име Господа над војскама, гори Сион."
        ]
      }
    ],
