    "lastChapterApiLink": "/api/srp_onspc/ISA/66.json",
    "totalNumberOfVerses": 1292
  },
  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "heading",
        "content": [
          "Мир неуздрмани"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Виђење Исаије сина Амоцова за Јуду и Јерусалим."
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Догодиће се у последње дане",
          {
            "text": "и гора Дома Господњег",
            "poem": 1
          },
          {
            "text": "биће постављена врх гора,",
            "poem": 2
          },
          {
            "text": "и узвишена изнад брегова.",
            "poem": 1
          },
          {
            "text": "Сви пуци према њој ће се стицати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Многи народи ће ходати и говорити:",
          {
            "text": "„Хајде, попнимо се на гору Господњу,",
            "poem": 1
          },
          {
            "text": "у Дом Бога Јаковљева,",
            "poem": 2
          },
          {
            "text": "те да нас он научи путевима својим,",
            "poem": 1
          },
          {
            "text": "и да ми ходамо стазама његовим.“",
            "poem": 2
          },
          {
            "text": "Јер ће поучење изаћи са Сиона,",
            "poem": 1
          },
          {
            "text": "и реч Господња из Јерусалима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Па ће он бити судија међу пуцима,",
            "poem": 1
          },
          {
            "text": "и он ће бити меродаван за народе многе;",
            "poem": 2
          },
          {
            "text": "те ће они мачеве прековати у раонике,",
            "poem": 1
          },
          {
            "text": "а копља у српове.",
            "poem": 2
          },
          {
            "text": "Неће више народ против народа подизати мачеве,",
            "poem": 1
          },
          {
            "text": "нити ће се више учити ратовању.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Доме Јаковљев, хајдемо,",
            "poem": 1
          },
          {
            "text": "у светлости Господњој да ходамо!",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Долазак Господњи"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Та, ти си напустио свој народ,",
            "poem": 1
          },
          {
            "text": "дом Јаковљев.",
            "poem": 2
          },
          {
            "text": "Зато што су пуни врачања са истока",
            "poem": 1
          },
          {
            "text": "и гатара као Филистејци,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и деци туђинаца они се умиљавају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Његова земља је сребра и злата пуна,",
            "poem": 1
          },
          {
            "text": "и ризницама његовим нема броја;",
            "poem": 2
          },
          {
            "text": "његова земља је коња пуна,",
            "poem": 1
          },
          {
            "text": "и колима његовим нема броја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Његова је земља идола пуна,",
            "poem": 1
          },
          {
            "text": "и пред делом руку својих они ничице падају,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "пред оним што прсти њихови начинише.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ипак, човек ће се савити,",
            "poem": 1
          },
          {
            "text": "и муж ће се понизити,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а ти им нећеш опростити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Уђи у стену, сакриј се у прашину",
            "poem": 1
          },
          {
            "text": "пред страхом Господњим,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "пред сјајем величанства његова.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Охоли човеков поглед биће скрхан",
            "poem": 1
          },
          {
            "text": "и бахатост људска понижена.",
            "poem": 2
          },
          {
            "text": "Господ ће бити узвишен, он једини – у дан онај.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Јер биће то дан Господа над војскама",
            "poem": 1
          },
          {
            "text": "против свих поноситих и надмених,",
            "poem": 2
          },
          {
            "text": "против свих што се узвисише",
            "poem": 1
          },
          {
            "text": "да их он обори;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "против свих кедрова ливанских, високих и уздигнутих,",
            "poem": 1
          },
          {
            "text": "и против свих храстова васанских,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "и против свих гора високих,",
            "poem": 1
          },
          {
            "text": "и свих брегова уздигнутих;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "и против сваке куле високе,",
            "poem": 1
          },
          {
            "text": "и против свих зидина утврђених;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "против свега бродовља тарсиског,",
            "poem": 1
          },
          {
            "text": "и против свих бродова раскошних.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Охолост људска биће скршена,",
            "poem": 1
          },
          {
            "text": "и надменост људска понижена.",
            "poem": 2
          },
          {
            "text": "Господ ће бити узвишен,",
            "poem": 1
          },
          {
            "text": "он једини – у дан онај,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "а идоли ће нестати потпуно.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Нека уђу у пећине стеновите,",
            "poem": 1
          },
          {
            "text": "и у земунице у прашини,",
            "poem": 2
          },
          {
            "text": "пред страхом Господњим,",
            "poem": 1
          },
          {
            "text": "пред сјајем величанства његова,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "кад устане да потресе земљу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "У дан онај човек ће побацати",
            "poem": 1
          },
          {
            "text": "своје идоле сребрне и своје идоле златне,",
            "poem": 2
          },
          {
            "text": "што су их њему начинили,",
            "poem": 1
          },
          {
            "text": "да се клања ничице",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "кртицама и слепим мишевима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Улазиће у пећинске шупљине",
            "poem": 1
          },
          {
            "text": "и у распуклине у стенама",
            "poem": 2
          },
          {
            "text": "пред страхом Господњим,",
            "poem": 1
          },
          {
            "text": "пред сјајем величанства његова,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "кад устане да потресе земљу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Чувајте се, дакле, од човека!",
            "poem": 1
          },
          {
            "text": "Он дах има у ноздрвама.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Та, шта он вреди?",
            "poem": 2
          }
        ]
      }
    ],
