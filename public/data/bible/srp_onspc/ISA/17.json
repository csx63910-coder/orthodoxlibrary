  "chapter": {
    "number": 17,
    "content": [
      {
        "type": "heading",
        "content": [
          "Реч за Дамаск"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Пророштво против Дамаска:",
          {
            "text": "„Гле, Дамаск ће престати да буде град,",
            "poem": 1
          },
          {
            "text": "и постаће гомила крхотина.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Његови градови око Ароира",
            "poem": 1
          },
          {
            "text": "биће за стада и лежаће,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и неће бити застрашитеља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Јефремово племе изгубиће утврђење,",
            "poem": 1
          },
          {
            "text": "и Дамаск царство;",
            "poem": 2
          },
          {
            "text": "а остатку Арама ће се догодити",
            "poem": 1
          },
          {
            "text": "што и слави потомака Израиљевих –",
            "poem": 2
          },
          {
            "text": "говори Господ над војскама.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "И биће у дан онај: смањиће се слава Јаковљева",
            "poem": 1
          },
          {
            "text": "и спласнуће им сало на телу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "И биће као кад жетелац жање жито,",
            "poem": 1
          },
          {
            "text": "и рука му класје хвата;",
            "poem": 2
          },
          {
            "text": "као кад се скупља класје",
            "poem": 1
          },
          {
            "text": "у рефаимској долини –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "само ће пабирци остати;",
            "poem": 1
          },
          {
            "text": "или као кад се маслина отресе:",
            "poem": 2
          },
          {
            "text": "две-три зреле на врху горње гране,",
            "poem": 1
          },
          {
            "text": "четири-пет на гранама дрвета –",
            "poem": 2
          },
          {
            "text": "говори Господ, Бог Израиљев.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Окончање идолопоклонства"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "У дан онај човек ће погледати свога Саздатеља,",
            "poem": 1
          },
          {
            "text": "и управиће очи своје према Светитељу Израиљеву.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Неће више погле́дати на жртвенике,",
            "poem": 1
          },
          {
            "text": "на дело својих руку; неће више гледати",
            "poem": 2
          },
          {
            "text": "шта његови прсти начинише:",
            "poem": 1
          },
          {
            "text": "Аштартине ступове и стубове у част Сунца.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Против идолских вртова"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "У дан онај утврђени градови његови ће бити као остављени у шуми, као горња грана што је оставише пред потомцима Израиљевим; и биће пустошење."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Зато што си заборавио Бога који те спасава,",
            "poem": 1
          },
          {
            "text": "и ниси се сетио Стене која ти даје снагу;",
            "poem": 2
          },
          {
            "text": "зато садиш љупке садове,",
            "poem": 1
          },
          {
            "text": "и калемиш туђинске младице;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "у дан кад их посадиш, оне израсту,",
            "poem": 1
          },
          {
            "text": "а ујутру твоје саднице су бокор;",
            "poem": 2
          },
          {
            "text": "али жетва одлете у дан невоље,",
            "poem": 1
          },
          {
            "text": "у дан бола коме лека нема.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Најезда многих народа"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Јао, бука многих народа,",
            "poem": 1
          },
          {
            "text": "буче као што бучи море;",
            "poem": 2
          },
          {
            "text": "шум светине која шуми",
            "poem": 1
          },
          {
            "text": "као силне воде што шуморе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Народи шуморе као силне воде што шуморе,",
            "poem": 1
          },
          {
            "text": "али кад им он запрети, они беже далеко,",
            "poem": 2
          },
          {
            "text": "и развејани као плева по горама на ветру,",
            "poem": 1
          },
          {
            "text": "као вртложићи пред вихором.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Дође вече, ето страха;",
            "poem": 1
          },
          {
            "text": "пре сванућа њега више нема.",
            "poem": 2
          },
          {
            "text": "Тако пролазе они који нас плене,",
            "poem": 1
          },
          {
            "text": "и коб је оних који нас пљачкају.",
            "poem": 2
          }
        ]
      }
    ],
