  "chapter": {
    "number": 32,
    "content": [
      {
        "type": "heading",
        "content": [
          "Царска праведност"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ево, по правди царује цар,",
            "poem": 1
          },
          {
            "text": "праведно владају владари.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "И сваки је као заветрина,",
            "poem": 1
          },
          {
            "text": "те заклања од олује,",
            "poem": 2
          },
          {
            "text": "и он је као потоци водени у сушној земљи,",
            "poem": 1
          },
          {
            "text": "као хладовина иза велике стене у жедној пустињи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "И очи оних који виде неће више бити замућене,",
            "poem": 1
          },
          {
            "text": "и уши оних који чују слушаће пажљиво,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "и срце брзоплетих схватиће знање,",
            "poem": 1
          },
          {
            "text": "и муцавци ће пожурити да говоре разговетно.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Покварењака више неће звати племићем,",
            "poem": 1
          },
          {
            "text": "варалицу више неће сматрати угледним.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Ко је покварен, а ко је племенит?"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Наиме, безумник говори безумно,",
            "poem": 1
          },
          {
            "text": "и срце његово смишља безакоње,",
            "poem": 2
          },
          {
            "text": "да почини злодела,",
            "poem": 1
          },
          {
            "text": "да о Господу охоло говори,",
            "poem": 2
          },
          {
            "text": "да гладнога остави празна желуца,",
            "poem": 1
          },
          {
            "text": "да жедноме ускрати пиће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "И варалица је наоружан злобом;",
            "poem": 1
          },
          {
            "text": "он сплетке смишља",
            "poem": 2
          },
          {
            "text": "да упропасти понизне речима лажљивим,",
            "poem": 1
          },
          {
            "text": "и сиромаха кад тражи право.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "А племић смишља племенитости,",
            "poem": 1
          },
          {
            "text": "и он племенитости остварује.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Опомена и промена"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Устајте, жене лакомислене,",
            "poem": 1
          },
          {
            "text": "почујте глас мој;",
            "poem": 2
          },
          {
            "text": "ћерке лаковерне,",
            "poem": 1
          },
          {
            "text": "послушајте беседу моју.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Кроз годину и нешто дана",
            "poem": 1
          },
          {
            "text": "дрхтаћете, лаковерне,",
            "poem": 2
          },
          {
            "text": "јер пропада берба,",
            "poem": 1
          },
          {
            "text": "не долази жетва.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Стрепите, лакомислене!",
            "poem": 1
          },
          {
            "text": "Дрхћите, лаковерне!",
            "poem": 2
          },
          {
            "text": "Свуците се и разголитите се,",
            "poem": 1
          },
          {
            "text": "и опашите се по бедрима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ударајте се у груди и наричите за пољима љупким,",
            "poem": 1
          },
          {
            "text": "за виноградима родним.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Над тлом народа мога",
            "poem": 1
          },
          {
            "text": "трње бодљикаво ће расти,",
            "poem": 2
          },
          {
            "text": "као и над свим домовима веселим,",
            "poem": 1
          },
          {
            "text": "насељем раздраганим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Јер двор је напуштен, град бучни запуштен.",
            "poem": 1
          },
          {
            "text": "Уместо насипа и куле биће пећина довека,",
            "poem": 2
          },
          {
            "text": "уживање за дивље магарце,",
            "poem": 1
          },
          {
            "text": "пашњак за стада.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Док се на нас не излије Дух с висина,",
            "poem": 1
          },
          {
            "text": "те претвори пустињу у воћњак,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а воћњак ће се рачунати као шума.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Тад ће у пустињи становати право,",
            "poem": 1
          },
          {
            "text": "а у воћњаку боравити праведност.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Из праведности ће се мир родити,",
            "poem": 1
          },
          {
            "text": "а праведности ће на служби бити",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "поуздање и спокојство довека.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Мој ће народ тада боравити у зградама мирним,",
            "poem": 1
          },
          {
            "text": "и у становима безбедним,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и у почивалиштима поузданим,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "иако ће шума бити оборена",
            "poem": 1
          },
          {
            "text": "и град ниско спуштен.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Благо вама,",
            "poem": 1
          },
          {
            "text": "сејете поред свих вода,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "пуштате волове и магарце.",
            "poem": 2
          }
        ]
      }
    ],
