  "chapter": {
    "number": 48,
    "content": [
      {
        "type": "heading",
        "content": [
          "Господ – господар будућности"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "„Слушај ово, доме Јаковљев,",
            "poem": 1
          },
          {
            "text": "који се називате именом Израиљевим",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и који сте изашли из вода Јудиних,",
            "poem": 2
          },
          {
            "text": "који се заклињете именом Господњим,",
            "poem": 1
          },
          {
            "text": "спомињете Бога Израиљева",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "не у истини и не у праведности.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Јер по Светом Граду ви се називате",
            "poem": 1
          },
          {
            "text": "и на Бога Израиљева ви се ослањате,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "његово је име: Господ над војскама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Од почетка, од давнина обавештавам,",
            "poem": 1
          },
          {
            "text": "из мојих уста је изашло",
            "poem": 2
          },
          {
            "text": "и објавићу што се чини изненада,",
            "poem": 1
          },
          {
            "text": "и то се збило.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Иако сам знао да си тврдокоран,",
            "poem": 1
          },
          {
            "text": "и да је врат твој жила гвоздена,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и да је чело твоје бронза;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "ипак сам ти већ онда најавио,",
            "poem": 1
          },
          {
            "text": "обавестио те пре него се збуде;",
            "poem": 2
          },
          {
            "text": "да не рекнеш:",
            "poem": 1
          },
          {
            "text": "’Мој кип то учини,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и мој лик резани и мој лик ливени то заповедише.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Чуо си, погледај све то.",
            "poem": 1
          },
          {
            "text": "Зар нећете објављивати?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "И ново ћеш од сада слушати од мене,",
            "poem": 1
          },
          {
            "text": "тајанствено, што знао ниси.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Сада је створено,",
            "poem": 1
          },
          {
            "text": "а није од раније и пре овог дана,",
            "poem": 2
          },
          {
            "text": "што ни чуо ниси; да не рекнеш:",
            "poem": 1
          },
          {
            "text": "’Гле, то сам већ знао.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Нити си чуо, нити си знао,",
            "poem": 1
          },
          {
            "text": "нити се уши твоје од пре отворише.",
            "poem": 2
          },
          {
            "text": "Та, знао сам да ћеш изневерити",
            "poem": 1
          },
          {
            "text": "и да су те назвали отпадником чим си се родио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Због имена својега спутавам гнев свој,",
            "poem": 1
          },
          {
            "text": "и због части своје уздржавам се према теби,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "иначе бих те истребио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ево, претопићу те, али не као сребро;",
            "poem": 1
          },
          {
            "text": "прочишћавам те у топионици невољничкој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Због себе, због себе ћу учинити.",
            "poem": 1
          },
          {
            "text": "Зар да се богохули?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "И славу своју другом дати нећу.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Господ благовести свог миљеника"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "„Чуј мене, Јакове,",
            "poem": 1
          },
          {
            "text": "и Израиљу, кога сам позвао:",
            "poem": 2
          },
          {
            "text": "Ја јесам,",
            "poem": 1
          },
          {
            "text": "ја сам Први, ја сам и Последњи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Рука је моја и земљу утемељила,",
            "poem": 1
          },
          {
            "text": "а десница моја небеса је распрострла,",
            "poem": 2
          },
          {
            "text": "кад ја њих позовем,",
            "poem": 1
          },
          {
            "text": "скупа ће се постројити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Скупите се сви и послушајте:",
            "poem": 1
          },
          {
            "text": "Ко је од њих то најавио?",
            "poem": 2
          },
          {
            "text": "Онај кога Господ воли",
            "poem": 1
          },
          {
            "text": "вољу његову ће учинити над Вавилоном",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и над потомством његовим, Халдејцима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ја, ја сам рекао,",
            "poem": 1
          },
          {
            "text": "њега сам позвао,",
            "poem": 2
          },
          {
            "text": "њега водио,",
            "poem": 1
          },
          {
            "text": "и његов пут унапредио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Приступите ми и послушајте ово:",
          {
            "text": "Нисам вам од почетка у тајности говорио,",
            "poem": 1
          },
          {
            "text": "и био сам тамо кад се то догађало.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "А сад ме шаље Господар Господ",
            "poem": 1
          },
          {
            "text": "и Дух његов.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Шта ће бити са Израиљем?"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Говори Господ, Откупитељ твој,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Светитељ Израиљев:",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Ја, Господ Бог твој,",
            "poem": 1
          },
          {
            "text": "учим те на добробит,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "упућујем те којим ћеш путем ићи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "О, да си се покорио мојим заповестима,",
            "poem": 1
          },
          {
            "text": "мир би твој био као река,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и праведност твоја као таласи морски.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Потомства би твојег било као песка,",
            "poem": 1
          },
          {
            "text": "а порода твога као његових зрнаца.",
            "poem": 2
          },
          {
            "text": "Не би се затрло и не би се избрисало",
            "poem": 1
          },
          {
            "text": "име његово пред лицем мојим.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Песма о изласку из Вавилона"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Изађите из Вавилона!",
            "poem": 1
          },
          {
            "text": "Бежите из Халдеје!",
            "poem": 2
          },
          {
            "text": "Гласом ускликталим благословите;",
            "poem": 1
          },
          {
            "text": "ово објављујте;",
            "poem": 2
          },
          {
            "text": "то разгласите до краја земље.",
            "poem": 1
          },
          {
            "text": "Говорите: „Откупио је Господ свог слугу Јакова!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "И нису били жедни док су ишли пустошима,",
            "poem": 1
          },
          {
            "text": "воду им је из стене наточио,",
            "poem": 2
          },
          {
            "text": "и стену је расцепио",
            "poem": 1
          },
          {
            "text": "и вода је потекла.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "„Нема мира!",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "– говори Господ опакима.",
            "poem": 1
          }
        ]
      }
    ],
