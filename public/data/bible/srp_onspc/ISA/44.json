  "chapter": {
    "number": 44,
    "content": [
      {
        "type": "heading",
        "content": [
          "Бог ће благословити Јевреје"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "А сад послушај, Јакове, слуго мој,",
            "poem": 1
          },
          {
            "text": "и Израиљу, ког сам изабрао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Говори Господ",
            "poem": 1
          },
          {
            "text": "који те је начинио, и који те је од утробе саздао,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "теби помаже:",
            "poem": 2
          },
          {
            "text": "Не бој се, Јакове, мој слуго,",
            "poem": 1
          },
          {
            "text": "Јешуруне, ког сам изабрао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Јер ћу воду излити на жедно тле,",
            "poem": 1
          },
          {
            "text": "и врела на сушну земљу.",
            "poem": 2
          },
          {
            "text": "Излићу Дух свој на потомство твоје,",
            "poem": 1
          },
          {
            "text": "и благослов на поколења твоја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "И рашће као да су међу травом,",
            "poem": 1
          },
          {
            "text": "као врбе из текуће воде.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Један ће рећи: ’Ја сам Господњи!’",
            "poem": 1
          },
          {
            "text": "други ће се звати именом Јаковљевим,",
            "poem": 2
          },
          {
            "text": "трећи ће себи на руци исписати: ’Господњи’,",
            "poem": 1
          },
          {
            "text": "и усвојиће име Израиљево.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Нема Бога осим Господа"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Говори Господ,",
            "poem": 1
          },
          {
            "text": "Цар Израиљев и његов Откупитељ,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Господ над војскама:",
            "poem": 2
          },
          {
            "text": "„Ја сам Први и ја сам Последњи,",
            "poem": 1
          },
          {
            "text": "осим мене другог Бога нема.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ко је као ја? Нека устане и каже,",
            "poem": 1
          },
          {
            "text": "нека се јави и нек то објави,",
            "poem": 2
          },
          {
            "text": "и нек то разложи преда мном.",
            "poem": 1
          },
          {
            "text": "Откад поставих народ од вечности,",
            "poem": 2
          },
          {
            "text": "и ствари што ће доћи,",
            "poem": 1
          },
          {
            "text": "нека најави шта ће се збити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Не плашите се и не бојте се:",
            "poem": 1
          },
          {
            "text": "нисам ли вам одавно објавио и најавио?",
            "poem": 2
          },
          {
            "text": "И ви сте моји сведоци:",
            "poem": 1
          },
          {
            "text": "има ли Бога осим мене?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Не, нема Стене за коју ја знам.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Против кипова и ликова"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Који праве кипове,",
            "poem": 1
          },
          {
            "text": "сви су они ништавила,",
            "poem": 2
          },
          {
            "text": "и драгоцености њихове не користе ничему.",
            "poem": 1
          },
          {
            "text": "Сведоци њихови не виде и не знају, те ће бити на срамоту.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ко прави бога и лије кип,",
            "poem": 1
          },
          {
            "text": "да од тога користи нема?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Гле, осрамотиће се сви другови његови и уметници.",
            "poem": 1
          },
          {
            "text": "Нека се саберу сви: и они су дело људско.",
            "poem": 2
          },
          {
            "text": "Нека се поставе:",
            "poem": 1
          },
          {
            "text": "заједно ће се престравити и постидети.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Обликује гвожђе алатком",
            "poem": 1
          },
          {
            "text": "и ради на жару угља,",
            "poem": 2
          },
          {
            "text": "чекићима га дотерује",
            "poem": 1
          },
          {
            "text": "и снажном га руком обрађује.",
            "poem": 2
          },
          {
            "text": "Не храни се и нема снаге,",
            "poem": 1
          },
          {
            "text": "воде не пије и исцрпљује се.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Обликује дрво, узима меру,",
            "poem": 1
          },
          {
            "text": "писаљком га обележава,",
            "poem": 2
          },
          {
            "text": "обрађује га длетом, оцртава га шестаром,",
            "poem": 1
          },
          {
            "text": "и деље га по узору на људски лик,",
            "poem": 2
          },
          {
            "text": "као лепоту људску,",
            "poem": 1
          },
          {
            "text": "да буде постављен у дому.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "За себе је насекао кедре",
            "poem": 1
          },
          {
            "text": "и узео кипарисе и храст,",
            "poem": 2
          },
          {
            "text": "што је за себе неговао међу дрветима шумским,",
            "poem": 1
          },
          {
            "text": "засадио бор што је порастао на киши.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "И човеку је то као гориво;",
            "poem": 1
          },
          {
            "text": "узима од тога да се огреје;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "па ложи и пече хлеб.",
            "poem": 2
          },
          {
            "text": "Међутим, од тога деље и бога",
            "poem": 1
          },
          {
            "text": "пред којим пада ничице",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и прави кип и клања му се.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Половином ложи ватру,",
            "poem": 1
          },
          {
            "text": "том половином пече месо на жару,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "једе печење и бива сит,",
            "poem": 2
          },
          {
            "text": "те се греје и говори:",
            "poem": 1
          },
          {
            "text": "„Ах, грејем се и крај ватре уживам.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "А од остатка прави бога, идола свога;",
            "poem": 1
          },
          {
            "text": "пада пред њим ничице",
            "poem": 2
          },
          {
            "text": "и клања му се и моли му се:",
            "poem": 1
          },
          {
            "text": "„Избави ме, јер ти си мој бог.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Не знају и не расуђују,",
            "poem": 1
          },
          {
            "text": "јер су им очи замазане па не виде;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и срца њихова па не разумеју.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Такав не размишља и нема у њега знања",
            "poem": 1
          },
          {
            "text": "ни расуђивања да каже:",
            "poem": 2
          },
          {
            "text": "„Половином од овога ложио сам ватру,",
            "poem": 1
          },
          {
            "text": "па сам на жару испекао хлеб,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "испржио сам месо и појео га.",
            "poem": 2
          },
          {
            "text": "А од остатка сам начинио гнусобу.",
            "poem": 1
          },
          {
            "text": "Зар да се клањам комаду дрвета?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Тај се стара за пепео.",
            "poem": 1
          },
          {
            "text": "Њега заводи преварно срце,",
            "poem": 2
          },
          {
            "text": "те не може да избави свој живот,",
            "poem": 1
          },
          {
            "text": "а неће да каже:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Није ли обмана у мојој десници?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Бог ће се смиловати"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "„Сети се овога, Јакове,",
            "poem": 1
          },
          {
            "text": "и Израиљу, јер си слуга мој!",
            "poem": 2
          },
          {
            "text": "Ја сам те саздао и ти си слуга мој;",
            "poem": 1
          },
          {
            "text": "Израиљу, ја тебе да заборавим нећу!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Као маглу растерао сам твоје преступе,",
            "poem": 1
          },
          {
            "text": "и грехе твоје као да су облак.",
            "poem": 2
          },
          {
            "text": "Мени се врати,",
            "poem": 1
          },
          {
            "text": "јер ја сам те откупио.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Радосница"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Кличите, небеса, ово је дело Господње!",
            "poem": 1
          },
          {
            "text": "Орите се, дубине земљине!",
            "poem": 2
          },
          {
            "text": "Одјекујте радосно, планине,",
            "poem": 1
          },
          {
            "text": "и ви, шуме, са свим својим дрвећем!",
            "poem": 2
          },
          {
            "text": "Јер Господ је откупио Јакова,",
            "poem": 1
          },
          {
            "text": "и прославио се у Израиљу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Песма о сили Господњој"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Говори Господ, Откупитељ твој,",
            "poem": 1
          },
          {
            "text": "и Саздатељ твој од утробе:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Ја сам Господ који сам све учинио,",
            "poem": 1
          },
          {
            "text": "ја сам лично разапео небеса,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и без икога засводио земљу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Ја спречавам врачарска знамења,",
            "poem": 1
          },
          {
            "text": "и гатаре претварам у лудаке;",
            "poem": 2
          },
          {
            "text": "терам мудраце да устукну",
            "poem": 1
          },
          {
            "text": "и знање преобраћам у безумље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Потврђујем што слуга му каже,",
            "poem": 1
          },
          {
            "text": "испуњавам својих гласника намере.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "’Насели се!’ – говорим Јерусалиму,",
            "poem": 1
          },
          {
            "text": "и градовима Јудиним: ’Саградите се!’",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "А ја ћу подићи што је разрушено.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Говорим океану: ’Пресахни!",
            "poem": 1
          },
          {
            "text": "Твоје реке пресушујем.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "’Пастиру мој’ – говорим Киру,",
            "poem": 1
          },
          {
            "text": "и он ће све моје жеље испунити.",
            "poem": 2
          },
          {
            "text": "’Сагради се!’ – говориће Јерусалиму,",
            "poem": 1
          },
          {
            "text": "а Дому: ’Утемељи се!’“",
            "poem": 2
          }
        ]
      }
    ],
