  },
  "chapter": {
    "number": 51,
    "content": [
      {
        "type": "heading",
        "content": [
          "Спасење за Аврахамове потомке"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Послушајте ме, следбеници праведности,",
            "poem": 1
          },
          {
            "text": "тражиоци Господа,",
            "poem": 2
          },
          {
            "text": "осмотрите стену из које сте исклесани,",
            "poem": 1
          },
          {
            "text": "коп истесан из ког сте ископани.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Осмотрите Аврахама, оца својега,",
            "poem": 1
          },
          {
            "text": "и Сару која вас је родила.",
            "poem": 2
          },
          {
            "text": "Та, он је сам био кад сам га позвао,",
            "poem": 1
          },
          {
            "text": "а ипак сам га благословио и умножио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Та, Господ се сажалио над Сионом,",
            "poem": 1
          },
          {
            "text": "сажалио се над свим његовим развалинама,",
            "poem": 2
          },
          {
            "text": "те ће претворити пустињу његову у Еден,",
            "poem": 1
          },
          {
            "text": "а пустару његову у врт Господњи.",
            "poem": 2
          },
          {
            "text": "Клицање и радост одјекиваће по њему,",
            "poem": 1
          },
          {
            "text": "захваљивања и глас похвални.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Господ ће судити народима и пуцима"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Послухни мене, народе мој, и чуј мене, свете,",
            "poem": 1
          },
          {
            "text": "јер Закон од мене проистиче,",
            "poem": 2
          },
          {
            "text": "и моје ћу правосудство хитро поставити",
            "poem": 1
          },
          {
            "text": "да буде светлост народима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Близу је правда моја,",
            "poem": 1
          },
          {
            "text": "спасоносно проистиче,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а и мишица моја судиће народима.",
            "poem": 2
          },
          {
            "text": "На мене острва чекају",
            "poem": 1
          },
          {
            "text": "и у моју мишицу се уздају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Очи своје к небу подигните,",
            "poem": 1
          },
          {
            "text": "и по земљи осмотрите доле;",
            "poem": 2
          },
          {
            "text": "јер ће небеса као дим ишчезнути,",
            "poem": 1
          },
          {
            "text": "и земља ће се као огртач раскрпати,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и становници њени као такви",
            "poem": 2
          },
          {
            "noteId": 12
          },
          {
            "text": "помреће;",
            "poem": 2
          },
          {
            "text": "а спасење моје трајаће довека,",
            "poem": 1
          },
          {
            "text": "и праведност моја уздрмана неће бити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Послушајте мене, који познајете правду,",
            "poem": 1
          },
          {
            "text": "народе коме је Закон мој у срцима:",
            "poem": 2
          },
          {
            "text": "не бојте се ругања од људи,",
            "poem": 1
          },
          {
            "text": "и нека вас не узбуђује њихово вређање,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "јер ће их као огртач појести мољац,",
            "poem": 1
          },
          {
            "text": "и као вуну појешће их црв;",
            "poem": 2
          },
          {
            "text": "а праведност моја трајаће довека,",
            "poem": 1
          },
          {
            "text": "и спасење моје од колена до колена.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Господ се буди"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Пробуди се! Пробуди се!",
            "poem": 1
          },
          {
            "text": "Одени се у снагу, мишице Господња.",
            "poem": 2
          },
          {
            "text": "Пробуди се као у дане древне,",
            "poem": 1
          },
          {
            "text": "током старинских нараштаја.",
            "poem": 2
          },
          {
            "text": "Ниси ли ти испресецала Раву,",
            "poem": 1
          },
          {
            "text": "израњавила морску неман?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ниси ли ти исушила море,",
            "poem": 1
          },
          {
            "text": "воде бездана големих,",
            "poem": 2
          },
          {
            "text": "поставила по дубинама морским",
            "poem": 1
          },
          {
            "text": "пут да пролазе откупљени?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Вратиће се избављени Господњи,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "доћи ће у Сион с весељем",
            "poem": 1
          },
          {
            "text": "и с радошћу вечном на челима;",
            "poem": 2
          },
          {
            "text": "пратиће их раздраганост и радост,",
            "poem": 1
          },
          {
            "text": "а побећи ће жалост и уздаси.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Свемоћни Господ теши људе своје"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "„Ја, ја сам утешитељ ваш.",
            "poem": 1
          },
          {
            "text": "Ко си ти да се бојиш човека смртнога",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и сина човечијег који је као трава?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Заборавио си Господа,",
            "poem": 1
          },
          {
            "text": "који те је начинио,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "који је разастро небеса",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и утемељио земљу.",
            "poem": 2
          },
          {
            "text": "Па си стрепео стално, поваздан",
            "poem": 1
          },
          {
            "text": "пред лицем надменог тлачитеља,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "као пред неким ко постоји да би разједао.",
            "poem": 2
          },
          {
            "text": "И… где је надменост тлачитеља?",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Биће изгнаник слободан убрзо,",
            "poem": 2
          },
          {
            "text": "и неће умирати да би био разједан,",
            "poem": 1
          },
          {
            "text": "и хлеба му недостати неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Господ Бог твој сам ја,",
            "poem": 1
          },
          {
            "text": "море узбуркам и таласи му кључају.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Господ над војскама име је његово.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "И ставио сам речи своје у уста твоја,",
            "poem": 1
          },
          {
            "text": "и сакрио те у сенку руке своје,",
            "poem": 2
          },
          {
            "text": "да разастрем небеса",
            "poem": 1
          },
          {
            "text": "и утемељим земљу,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и кажем Сиону: ’Ти мој народ јеси.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Пробуди се, Свети граде!"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Хајде, пробуди се! Хајде, пробуди се!",
            "poem": 1
          },
          {
            "text": "Устани, Јерусалиме!",
            "poem": 2
          },
          {
            "text": "Који си испио из руке Господње",
            "poem": 1
          },
          {
            "text": "чашу јарости његове;",
            "poem": 2
          },
          {
            "text": "пехар, чашу опијености,",
            "poem": 1
          },
          {
            "text": "испио до дна.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Од свих синова које је родио",
            "poem": 1
          },
          {
            "text": "нема ниједног да га води.",
            "poem": 2
          },
          {
            "text": "Од свих синова које је одгојио",
            "poem": 1
          },
          {
            "text": "нема ниједног да га за руку прихвати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ово те је двоје задесило.",
            "poem": 1
          },
          {
            "text": "Хоће ли те ико пожалити?",
            "poem": 2
          },
          {
            "text": "Пустошење и распад и глад и мач.",
            "poem": 1
          },
          {
            "text": "Хоће ли те ико утешити?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Синови ти леже обамрли",
            "poem": 1
          },
          {
            "text": "по угловима свих улица;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "као антилопа у мрежи",
            "poem": 2
          },
          {
            "text": "пуни јарости Господње,",
            "poem": 1
          },
          {
            "text": "карања од Бога твојега.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Зато ово почуј, понижени",
            "poem": 1
          },
          {
            "text": "и опијени, али не од вина.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Говори твој Господар Господ,",
            "poem": 1
          },
          {
            "text": "Бог твој, бранилац свог народа:",
            "poem": 2
          },
          {
            "text": "„Ево, узимам из руке твоје",
            "poem": 1
          },
          {
            "text": "чашу опијености,",
            "poem": 2
          },
          {
            "text": "пехар, чашу јарости моје.",
            "poem": 1
          },
          {
            "text": "И никад се више из ње испијати неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "И то стављам у руку оних који су те жалостили,",
            "poem": 1
          },
          {
            "text": "који су души твојој говорили:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "’Савиј се и прелазићемо!’",
            "poem": 2
          },
          {
            "text": "И наместо тла подметао си леђа своја,",
            "poem": 1
          },
          {
            "text": "те су била пут онима који прелазе.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      }
    ],
    "footnotes": [
      {
        "noteId": 12,
        "caller": "+",
        "text": "51,6 Као такви може да се преведе и као комарци.",
