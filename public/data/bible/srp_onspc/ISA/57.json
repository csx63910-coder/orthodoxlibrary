  },
  "chapter": {
    "number": 57,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Праведник гине",
            "poem": 1
          },
          {
            "text": "и никога то не узбуђује.",
            "poem": 2
          },
          {
            "text": "И смерни људи бивају одвођени",
            "poem": 1
          },
          {
            "text": "и нико не разабире",
            "poem": 2
          },
          {
            "text": "да праведник бива одведен пред зло,",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "да уђе у мир.",
            "poem": 1
          },
          {
            "text": "Почивају на лежајима својим",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ко је ишао исправно.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "„А сад се примакните амо,",
            "poem": 1
          },
          {
            "text": "синови гатарини,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "потомство прељубничко, смрдљиво.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Над ким се шегачите?",
            "poem": 1
          },
          {
            "text": "Над ким се бекељите?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Плазите језик?",
            "poem": 2
          },
          {
            "text": "Нисте ли ви деца бунтовна,",
            "poem": 1
          },
          {
            "text": "потомство лажљиваца,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "који се успаљују међу храстовима,",
            "poem": 1
          },
          {
            "text": "под сваким дрветом зеленим,",
            "poem": 2
          },
          {
            "text": "жртвујући децу по долинама,",
            "poem": 1
          },
          {
            "text": "под каменим раселинама?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Пророк тугује због идолопоклонства"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "„На вододерини твоја је рака.",
            "poem": 1
          },
          {
            "text": "Оне, оне су твоји међаши.",
            "poem": 2
          },
          {
            "text": "Управо њима изливаш жртве наливне,",
            "poem": 1
          },
          {
            "text": "спаљујеш житну жртву.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Зар оне да ми се свиде?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "На гору високу и уздигнуту",
            "poem": 1
          },
          {
            "text": "свој си лежај поставила,",
            "poem": 2
          },
          {
            "text": "па си се тамо попела",
            "poem": 1
          },
          {
            "text": "да кољеш жртву закланицу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Уз врата и довратке",
            "poem": 1
          },
          {
            "text": "свој си запис поставила.",
            "poem": 2
          },
          {
            "text": "Далеко од мене си разоткрила",
            "poem": 1
          },
          {
            "text": "и на висине лежај свој наместила,",
            "poem": 2
          },
          {
            "text": "те се погађала са онима које волиш",
            "poem": 1
          },
          {
            "text": "да легнеш с њима, да осетиш снагу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "И ходочастиш цару у помазању,",
            "poem": 1
          },
          {
            "text": "и умножаваш своја мира;",
            "poem": 2
          },
          {
            "text": "и послала си своје известиоце издалека",
            "poem": 1
          },
          {
            "text": "и спустила до Света мртвих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Изнурила си себе многим путовањима својим.",
            "poem": 1
          },
          {
            "text": "Ниси рекла: ’То је таштина!’",
            "poem": 2
          },
          {
            "text": "Стекла си јакост нову,",
            "poem": 1
          },
          {
            "text": "зато ослабила ниси.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Па кога си се уплашила и побојала,",
            "poem": 1
          },
          {
            "text": "те си слагала?",
            "poem": 2
          },
          {
            "text": "И ниси се мене сетила,",
            "poem": 1
          },
          {
            "text": "ниси себи на срце ставила.",
            "poem": 2
          },
          {
            "text": "Нисам ли ја ћутао и од века,",
            "poem": 1
          },
          {
            "text": "па се мене побојала ниси?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ја ћу објавити твоју правду,",
            "poem": 1
          },
          {
            "text": "и дела ти твоја користити неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Кад завичеш, нека те изведу чете твоје.",
            "poem": 1
          },
          {
            "text": "А све њих ће ветар однети, таштина узети.",
            "poem": 2
          },
          {
            "text": "Међутим, који се у мене уздају",
            "poem": 1
          },
          {
            "text": "земљу ће баштинити",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и моју свету гору поседовати.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Песма утешна"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Тада ће се говорити:",
          {
            "text": "„Насипајте! Насипајте! Пут поравнајте!",
            "poem": 1
          },
          {
            "text": "Мом народу сметње с пута уклоните!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Јер говори Вишњи и Уздигнути,",
            "poem": 1
          },
          {
            "text": "настањени трајно, а име му је Светитељ:",
            "poem": 2
          },
          {
            "text": "„Мој стан је узвишеност и светиња,",
            "poem": 1
          },
          {
            "text": "а са скрушеним сам и с духом пониженим,",
            "poem": 2
          },
          {
            "text": "да оживим пониженима дух,",
            "poem": 1
          },
          {
            "text": "да оживим скрушенима срце.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Јер се нећу препирати довека,",
            "poem": 1
          },
          {
            "text": "нити ћу се љутити непрестано,",
            "poem": 2
          },
          {
            "text": "јер би испред лица мојега ослабио дух",
            "poem": 1
          },
          {
            "text": "и душе које сам саздао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Кривица његова је грабеж.",
            "poem": 1
          },
          {
            "text": "Зато сам се наљутио,",
            "poem": 2
          },
          {
            "text": "и зато га ударио, и у љутини се сакрио;",
            "poem": 1
          },
          {
            "text": "а он је отишао одметнички,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "како га срце његово одвуче.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Путеве његове сам видео.",
            "poem": 1
          },
          {
            "text": "И излечићу га и довести,",
            "poem": 2
          },
          {
            "text": "и умирићу срце оних који га теше",
            "poem": 1
          },
          {
            "text": "и који с њим тугују.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Стварам речи уснама да проговоре:",
            "poem": 1
          },
          {
            "text": "Мир! Мир удаљеноме и блискоме",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "– говори Господ, и њега ћу излечити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "А опаки су као море усталасало,",
            "poem": 1
          },
          {
            "text": "што се успокојити не може,",
            "poem": 2
          },
          {
            "text": "и из вода својих исталасава",
            "poem": 1
          },
          {
            "text": "муљ и блато.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Нема мира опакима",
            "poem": 1
          },
          {
            "text": "– говори Бог мој.",
            "poem": 2
          }
        ]
      }
    ],
