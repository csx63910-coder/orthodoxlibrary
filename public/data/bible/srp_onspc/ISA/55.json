  "chapter": {
    "number": 55,
    "content": [
      {
        "type": "heading",
        "content": [
          "Обиље милости Господњих"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "О, сви жедни, приступите води,",
            "poem": 1
          },
          {
            "text": "и који новац немате, приступите,",
            "poem": 2
          },
          {
            "text": "купујте и једите,",
            "poem": 1
          },
          {
            "text": "и приступите, купујте",
            "poem": 2
          },
          {
            "text": "без новаца и без плаћања,",
            "poem": 1
          },
          {
            "text": "вино и млеко.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Зашто да трошите новац на нешто што хлеб није,",
            "poem": 1
          },
          {
            "text": "и зараду своју на нешто што заситити неће?",
            "poem": 2
          },
          {
            "text": "Мене послушајте и јешћете што је добро,",
            "poem": 1
          },
          {
            "text": "и душа ће се ваша наслађивати кртином.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ухо приклоните и мени приступите;",
            "poem": 1
          },
          {
            "text": "слушајте и душа ваша ће живети.",
            "poem": 2
          },
          {
            "text": "Па ћу с вама склопити савез вечни,",
            "poem": 1
          },
          {
            "text": "Давиду обећаних милости.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ево, њега сам дао да буде сведок народима;",
            "poem": 1
          },
          {
            "text": "владар и заповедник народима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ево, пук који га не познајеш позваћеш;",
            "poem": 1
          },
          {
            "text": "пук који тебе не познаје похрлиће теби",
            "poem": 2
          },
          {
            "text": "ради Господа Бога твојега",
            "poem": 1
          },
          {
            "text": "и за Светитеља Израиљева",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "који ти је дао достојанство.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Господ је близу"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Тражите Господа док се може наћи!",
            "poem": 1
          },
          {
            "text": "Призивајте га док је близу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Нека опаки пут свој остави",
            "poem": 1
          },
          {
            "text": "и никоговић своје замисли,",
            "poem": 2
          },
          {
            "text": "и нека се Господу врати, а он ће му се смиловати;",
            "poem": 1
          },
          {
            "text": "и Богу нашем зато што умножава праштање.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "„Јер, замисли ваше нису замисли моје,",
            "poem": 1
          },
          {
            "text": "и путеви моји нису путеви ваши",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Него, колико је небо над земљом високо,",
            "poem": 1
          },
          {
            "text": "толико су путеви моји високо над путевима вашим,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а замисли моје изнад замисли ваших.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Моћ Господње речи"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Јер као што киша пада",
            "poem": 1
          },
          {
            "text": "и снег са небеса",
            "poem": 2
          },
          {
            "text": "и не враћа се пуста,",
            "poem": 1
          },
          {
            "text": "него натапа земљу,",
            "poem": 2
          },
          {
            "text": "те бива плодна и родна;",
            "poem": 1
          },
          {
            "text": "па даје семе ономе који сеје и храну ономе који једе,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "таква је реч моја што из мојих уста излази,",
            "poem": 1
          },
          {
            "text": "неће ми се вратити празна,",
            "poem": 2
          },
          {
            "text": "него ће учинити оно што ми се свиђа",
            "poem": 1
          },
          {
            "text": "и напредоваће ради чега сам је послао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Запис о будућем благослову"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Да, с радошћу ћете отићи,",
            "poem": 1
          },
          {
            "text": "и у миру ћете бити вођени.",
            "poem": 2
          },
          {
            "text": "Планине и брегови",
            "poem": 1
          },
          {
            "text": "клицаће пред вама весело,",
            "poem": 2
          },
          {
            "text": "и свако дрво зелено",
            "poem": 1
          },
          {
            "text": "запљескаће длановима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Уместо трња ће расти чемпреси,",
            "poem": 1
          },
          {
            "text": "уместо коприве ће расти мирта.",
            "poem": 2
          },
          {
            "text": "И биће ради Господњег имена,",
            "poem": 1
          },
          {
            "text": "ради знака вечнога, неразоривога.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
