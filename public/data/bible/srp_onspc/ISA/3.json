  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "heading",
        "content": [
          "Безвлашће у Јерусалиму"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Гле, Господар,",
            "poem": 1
          },
          {
            "text": "Господ над војскама,",
            "poem": 2
          },
          {
            "text": "одузима Јерусалиму и Јуди",
            "poem": 1
          },
          {
            "text": "снабдевање и издржавање,",
            "poem": 2
          },
          {
            "text": "снабдевање хлебом и снабдевање водом,",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "јунака и ратника,",
            "poem": 2
          },
          {
            "text": "судија и пророка,",
            "poem": 1
          },
          {
            "text": "руководиоца и старешину,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "педесетника и претпостављеног,",
            "poem": 1
          },
          {
            "text": "саветника и вештог стручњака,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и онога који се предвиђањем бави.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "„И дајем им дечаке за главаре;",
            "poem": 1
          },
          {
            "text": "и ћудљиве да над њима управљају.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Народ гоњен бива: човек на човека,",
            "poem": 1
          },
          {
            "text": "и човек на ближњег својег;",
            "poem": 2
          },
          {
            "text": "дрски су: дечак на старешину,",
            "poem": 1
          },
          {
            "text": "и простак на одличника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "А свако ће хватати брата својега",
            "poem": 1
          },
          {
            "text": "у дому оца својега:",
            "poem": 2
          },
          {
            "text": "„Ти плашт имаш! Дођи! Поглавар буди наш!",
            "poem": 1
          },
          {
            "text": "Ово расуло узми у руке своје!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "А он ће се бранити у онај дан:",
            "poem": 1
          },
          {
            "text": "„Нећу то да исправљам.",
            "poem": 2
          },
          {
            "text": "У Дому моме хлеба нема, ни плашта нема.",
            "poem": 1
          },
          {
            "text": "Немој мене постављати за народног главара.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Јер Јерусалим се руши,",
            "poem": 1
          },
          {
            "text": "и Јуда пада,",
            "poem": 2
          },
          {
            "text": "зато што су речи њихове",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "и дела њихова против Господа",
            "poem": 1
          },
          {
            "text": "пркошење у лице Слави његовој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Израз лица њиховог против њих сведочи;",
            "poem": 1
          },
          {
            "text": "и као Содома грехом својим",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "размећу се и не крију.",
            "poem": 2
          },
          {
            "text": "Тешко души њиховој!",
            "poem": 1
          },
          {
            "text": "Сами себи пропаст припремају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Кажите праведнику: биће му добро,",
            "poem": 1
          },
          {
            "text": "јер ће се хранити плодом дела својих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Тешко опакоме на зло,",
            "poem": 1
          },
          {
            "text": "јер дела руку његових на њега ће пасти!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Народе мој!",
            "poem": 1
          },
          {
            "text": "Малолетници су њихови тлачитељи",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и жене над њим владају.",
            "poem": 2
          },
          {
            "text": "Народе мој!",
            "poem": 1
          },
          {
            "text": "Који те воде, они те заводе,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и путеве твојих стаза они су запетљали.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "На парницу Господ се подиже",
            "poem": 1
          },
          {
            "text": "и стао је на суд с народима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Господ ће на суд доћи",
            "poem": 1
          },
          {
            "text": "против старешина народа својега",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и против главара њихових:",
            "poem": 2
          },
          {
            "text": "„То сте ви виноград мој опустошили;",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "у вашим кућама сте задржали",
            "poem": 1
          },
          {
            "text": "што сте од сиромаха отели.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Шта вам је, те народ мој тлачите",
            "poem": 1
          },
          {
            "text": "и лице сиромаха дробите?",
            "poem": 2
          },
          {
            "text": "– говори Господар, Господ над војскама.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Приговор Сионкама"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "И рече Господ:",
            "poem": 1
          },
          {
            "text": "„Шта се то шепуре ћерке сионске,",
            "poem": 2
          },
          {
            "text": "те ходају испружених вратова,",
            "poem": 1
          },
          {
            "text": "и очима намигују,",
            "poem": 2
          },
          {
            "text": "корацима ситним корачају,",
            "poem": 1
          },
          {
            "text": "ланчићима на ногама звецкају?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Господар ће учинити да теме ћерки сионских оћелави.",
            "poem": 1
          },
          {
            "text": "Господ ће разголитити стидна места њина.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "У дан онај ће Господар стргнути блештавост ланчића и гривни и месечића"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "и наушница и наруквица и копрена"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "и турбана и огрлица и појасића и стакалаца с мирисима и амајлија"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "и прстења и носних колутића"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "и скупоцених хаљина и плаштева и огртача и торбица"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "и шљокица и кошуљица и повезача и капица."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Место миомириса биће смрад;",
            "poem": 1
          },
          {
            "text": "место појаса биће врпца,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "место коврџа биће обријано теме,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "место гиздаве хаљине биће кострет,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "место лепоте биће жиг.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Јерусалимске удовице"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Мужеви ће твоји од мача погинути,",
            "poem": 1
          },
          {
            "text": "у окршајима јунаци твоји,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "На вратницама твојим ће се кукати и туговати,",
            "poem": 1
          },
          {
            "text": "на земљи ћеш седети напуштена.",
            "poem": 2
          }
        ]
      }
    ],
