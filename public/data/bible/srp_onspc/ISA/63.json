  "chapter": {
    "number": 63,
    "content": [
      {
        "type": "heading",
        "content": [
          "Гнев и погибија"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ко је тај што из Едома долази,",
            "poem": 1
          },
          {
            "text": "из Восоре у огртачу јарком,",
            "poem": 2
          },
          {
            "text": "онај украшени у одећи својој,",
            "poem": 1
          },
          {
            "text": "који корача у пуној снази?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "– „Ја сам који говори о правди,",
            "poem": 1
          },
          {
            "text": "велик кад спасава.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Зашто ти је одело црвено",
            "poem": 1
          },
          {
            "text": "и хаљине твоје као да си у муљари газио?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "– „Цедио сам, по каци газио,",
            "poem": 1
          },
          {
            "text": "од народа са мном ни човека,",
            "poem": 2
          },
          {
            "text": "и у гневу њих сам изгазио,",
            "poem": 1
          },
          {
            "text": "и у јари својој њих сам изгњечио.",
            "poem": 2
          },
          {
            "text": "А што је из њих шикљало мој огртач је попрскало,",
            "poem": 1
          },
          {
            "text": "те сам испрљао сву одећу своју.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Јер је у мом срцу дан када се светим,",
            "poem": 1
          },
          {
            "text": "и дошла је година када откупљујем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "И гледам, а нема ко да помогне;",
            "poem": 1
          },
          {
            "text": "збуњен бивам, а ослонца нема.",
            "poem": 2
          },
          {
            "text": "И спасла ме је десница моја,",
            "poem": 1
          },
          {
            "text": "и срџба моја ослонац ми била,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "те сатирем народе у гневу свом,",
            "poem": 1
          },
          {
            "text": "и срџбом својом сам их опио,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а оним што из њих шикља земљу сам натопио.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Бог и његов народ"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Господње ћу милости помињати,",
            "poem": 1
          },
          {
            "text": "похвалу Господњу према свему",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "што нам је урадио Господ,",
            "poem": 2
          },
          {
            "text": "и добро умножено дому Израиљеву,",
            "poem": 1
          },
          {
            "text": "што нам га је урадио по самилости својој",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "по обиљу милости своје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "И рекао је: „Доиста су мој народ,",
            "poem": 1
          },
          {
            "text": "синови који неће изневерити“,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "па је њима Спаситељ постао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "У свим невољама њиховим и он беше у невољи;",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "анђео што пред њим стоји их је спасао.",
            "poem": 1
          },
          {
            "text": "Својом љубављу их је спасао",
            "poem": 2
          },
          {
            "text": "и сам их својим милосрђем откупио",
            "poem": 1
          },
          {
            "text": "и дигао и носио у све дане од века.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "А они се сами одметнуше,",
            "poem": 1
          },
          {
            "text": "Светог Духа његовог жалостише.",
            "poem": 2
          },
          {
            "text": "И он им се преокрену у непријатеља;",
            "poem": 1
          },
          {
            "text": "он лично против њих зарати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Тад се давних присетише дана,",
            "poem": 1
          },
          {
            "text": "Мојсија, његовог народа.",
            "poem": 2
          },
          {
            "text": "Где је онај који им из мора извлачи",
            "poem": 1
          },
          {
            "text": "пастира за своје стадо?",
            "poem": 2
          },
          {
            "text": "Где је онај који ће у њега сместити",
            "poem": 1
          },
          {
            "text": "свога Духа Светога?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Који је Мојсијевом десницом управљао",
            "poem": 1
          },
          {
            "text": "преко своје мишице славносне?",
            "poem": 2
          },
          {
            "text": "Који воду пред њима располути",
            "poem": 1
          },
          {
            "text": "да своје име вечним учини?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Који њима управља по дну морскоме",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "као коњем по пустињи,",
            "poem": 1
          },
          {
            "text": "није било спотицања?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Слично стоци што у долину силази,",
            "poem": 1
          },
          {
            "text": "Дух Господњи их је успокојио.",
            "poem": 2
          },
          {
            "text": "Ти си тако водио народ свој,",
            "poem": 1
          },
          {
            "text": "и преславно име стекао си себи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Погледај с небеса и види",
            "poem": 1
          },
          {
            "text": "из твога светог и преславног Пребивалишта.",
            "poem": 2
          },
          {
            "text": "Где је твоја ревност и твоја сила,",
            "poem": 1
          },
          {
            "text": "навала ожалошћености твоје",
            "poem": 2
          },
          {
            "text": "и милосрђа твојега?",
            "poem": 1
          },
          {
            "text": "Мени ли се ускраћују?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Та, ти си Отац наш,",
            "poem": 1
          },
          {
            "text": "јер Аврахам нас спознао није,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и Израиљ нас препознао није,",
            "poem": 2
          },
          {
            "text": "ипак, Господе, ти си Отац наш,",
            "poem": 1
          },
          {
            "text": "Откупитељ наш, од вечности је име твоје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Зашто нас, Господе, одводиш од твојих путева,",
            "poem": 1
          },
          {
            "text": "тврдим чиниш срце наше спрам страха од тебе?",
            "poem": 2
          },
          {
            "text": "Врати се због својих слугу,",
            "poem": 1
          },
          {
            "text": "због племена што су ти баштина.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Њу је народ твој тек за кратко запосео,",
            "poem": 1
          },
          {
            "text": "али изгазише Светилиште твоје противници твоји.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Већ одавна слични смо постали",
            "poem": 1
          },
          {
            "text": "онима над којима ти ниси,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "над којима се твоје име не призива.",
            "poem": 2
          }
        ]
      }
    ],
