  "book": {
    "id": "ISA",
    "translationId": "srp_onspc",
    "name": "Књига пророка Исаије",
    "commonName": "Књига пророка Исаије",
    "title": "Књига пророка Исаије",
    "order": 23,
    "numberOfChapters": 66,
    "sha256": "65da7472046c4c4242da6b0395082ca741c36130fd8710e93ef455190b89026a",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/ISA/1.json",
    "lastChapterNumber": 66,
    "lastChapterApiLink": "/api/srp_onspc/ISA/66.json",
    "totalNumberOfVerses": 1292
  },
  "chapter": {
    "number": 10,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Тешко онима који неправедне одредбе одређују",
            "poem": 1
          },
          {
            "text": "и прописе тлачитељске прописују",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "да би убогоме правду ускратили",
            "poem": 1
          },
          {
            "text": "и сиромасима народа мог право отели,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "како би сиротињу опљачкали.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "И шта ћете у дан казне чинити,",
            "poem": 1
          },
          {
            "text": "када пропаст из далека дође?",
            "poem": 2
          },
          {
            "text": "Коме ћете за помоћ утећи?",
            "poem": 1
          },
          {
            "text": "Камо ћете благо своје оставити?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Као робље јамачно пузати",
            "poem": 1
          },
          {
            "text": "и међу поклане пасти…",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Уза све то гнев се његов умирити неће",
            "poem": 1
          },
          {
            "text": "и рука му испружена остаје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Против неименованог асирског владара"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "„Тешко Асирцу!",
            "poem": 1
          },
          {
            "text": "Он је гнева мога шиба.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Он је у њиховој руци прут срџбе моје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "На пук отпаднички њега сам послао,",
            "poem": 1
          },
          {
            "text": "на народ који ме је расрдио.",
            "poem": 2
          },
          {
            "text": "Он нека га оплени и опљачка,",
            "poem": 1
          },
          {
            "text": "као блато друмско нека га изгази.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Али он није тако намеравао,",
            "poem": 1
          },
          {
            "text": "и у срцу свом није тако смишљао,",
            "poem": 2
          },
          {
            "text": "него је у срцу свом за затирање,",
            "poem": 1
          },
          {
            "text": "за истребљивање не малог броја народа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Јер он је говорио:",
            "poem": 1
          },
          {
            "text": "’Сваки од мојих главара није ли као цар?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Није ли Халани као Харкемис?",
            "poem": 1
          },
          {
            "text": "И није ли Амат као Арфад?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Није ли Самарија као Дамаск?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Као што моја рука дохвати царства идолска и њихове ликове",
            "poem": 1
          },
          {
            "text": "од Јерусалима и од Самарије;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "као што учиних са Самаријом",
            "poem": 1
          },
          {
            "text": "и њеним идолима,",
            "poem": 2
          },
          {
            "text": "зар да не учиним с Јерусалимом",
            "poem": 1
          },
          {
            "text": "и његовим иконама?’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "И кад Господар избубња све што намерава чинити на гори Сион и у Јерусалиму, онда ћу казнити плод охолог срца цара асирског, и дрскост његових поноситих очију,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "зато што је рекао:",
          {
            "text": "„Снагом своје руке учиних,",
            "poem": 1
          },
          {
            "text": "и мудрошћу својом, јер уман јесам;",
            "poem": 2
          },
          {
            "text": "границе народима уклоних,",
            "poem": 1
          },
          {
            "text": "и блага њихова опљачках;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "као јунак покорих столујуће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Рука моја као гнездо зграби",
            "poem": 1
          },
          {
            "text": "богатства тих народа.",
            "poem": 2
          },
          {
            "text": "И као што се купе остављена јаја",
            "poem": 1
          },
          {
            "text": "сву сам земљу покупио;",
            "poem": 2
          },
          {
            "text": "и никог не би да крило покрене,",
            "poem": 1
          },
          {
            "text": "да кљун отвори, да запијуче.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Зар секира да се хвалише над човеком који њоме сече?",
            "poem": 1
          },
          {
            "text": "Хоће ли се величати тестера над човеком који њом тестери?",
            "poem": 2
          },
          {
            "text": "Зар палица маше човеком који је потеже,",
            "poem": 1
          },
          {
            "text": "и штап ли подиже оног који дрво није?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Зато ће Господар Господ над војскама",
            "poem": 1
          },
          {
            "text": "послати скапавање међу његове задригле,",
            "poem": 2
          },
          {
            "text": "и његову ће славу попалити",
            "poem": 1
          },
          {
            "text": "као што се ватра распаљује.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Светлост Израиљева биће та ватра,",
            "poem": 1
          },
          {
            "text": "и Светитељ његов биће тај пламен:",
            "poem": 2
          },
          {
            "text": "он ће горети и прождирати бодље његове",
            "poem": 1
          },
          {
            "text": "и трње његово у једном дану.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Красоту шума његових и поља његових",
            "poem": 1
          },
          {
            "text": "он ће уништити од сржи до коре.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "И биће као болесник који копни.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Што остане дрва у његовој шуми,",
            "poem": 1
          },
          {
            "text": "то мало ће и дечак моћи да преброји.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Повратак остатка"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "И биће у дан онај остатак Израиљев",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "и избеглице, потомци Јаковљеви,",
            "poem": 1
          },
          {
            "text": "неће се више ослањати на онога који их обара,",
            "poem": 2
          },
          {
            "text": "него ће бивати истински ослоњени",
            "poem": 1
          },
          {
            "text": "на Господа, Светитеља Израиљева.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Остатак ће се вратити,",
            "poem": 1
          },
          {
            "text": "остатак Јаковљев Богу силноме.",
            "poem": 2
          },
          {
            "noteId": 4
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Та, ако буде народа твојега, Израиља,",
            "poem": 1
          },
          {
            "text": "као песка морскога,",
            "poem": 2
          },
          {
            "text": "вратиће се остатак његов.",
            "poem": 1
          },
          {
            "text": "Одлука је коначна: правда надире.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Јер у потпуности је одлучио Господ Бог над војскама:",
            "poem": 1
          },
          {
            "text": "он то чини у средини целе земље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Охрабрење"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Зато говори Господар Господ над војскама:",
          {
            "text": "„Народе мој, становници на Сиону,",
            "poem": 1
          },
          {
            "text": "не бој се Асирца кад те шибом туче,",
            "poem": 2
          },
          {
            "text": "кад палицу на те подиже",
            "poem": 1
          },
          {
            "text": "на путу египатском,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "јер још само мало, и јарост је испуњена,",
            "poem": 1
          },
          {
            "text": "и гнев мој ће их уништити.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "И Господ над војскама замахнуће бичем на њега",
            "poem": 1
          },
          {
            "text": "као што удараше Мадијане на Стени Оривовој;",
            "poem": 2
          },
          {
            "text": "и палица је његова над морем,",
            "poem": 1
          },
          {
            "text": "и подиже је на путу египатском.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "И биће у дан онај:",
            "poem": 1
          },
          {
            "text": "биће скинуто бреме његово с твојих рамена",
            "poem": 2
          },
          {
            "text": "и јарам његов с твојег врата,",
            "poem": 1
          },
          {
            "text": "и сломиће се јарам пред помазањем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Освајач"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Он долази на Ајат,",
            "poem": 1
          },
          {
            "text": "он је прошао Мигрон,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "он распрти пртљаг свој у Михмасу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Они прѐлазе пре́лазе:",
            "poem": 1
          },
          {
            "text": "„У Гави ће бити преноћиште за нас.“",
            "poem": 2
          },
          {
            "text": "Рама дрхће,",
            "poem": 1
          },
          {
            "text": "а Гаваја Саулова бежи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Вришти, ћерко Галимска, што гласније!",
            "poem": 1
          },
          {
            "text": "Слушај, Лаисе!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Сиромаху, Анатоте!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Мадмена одлута;",
            "poem": 1
          },
          {
            "text": "становници гевимски утекоше.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Још данас ће се у Нову зауставити,",
            "poem": 1
          },
          {
            "text": "руком маше гори ћерке сионске,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "хуму јерусалимском.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Гле, Господар Господ над војскама",
            "poem": 1
          },
          {
            "text": "гране креше ужасом,",
            "poem": 2
          },
          {
            "text": "посечени су врхови усправљени,",
            "poem": 1
          },
          {
            "text": "они уздигнути су оборени;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "а секиром се шумски густиш расеца,",
            "poem": 1
          },
          {
            "text": "а од Силног Ливан бива оборен.",
            "poem": 2
          }
        ]
      }
    ],
