  "chapter": {
    "number": 30,
    "content": [
      {
        "type": "heading",
        "content": [
          "Против изасланства у Египат (I)"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Тешко синовима одметничким!",
            "poem": 1
          },
          {
            "text": "– говори Господ.",
            "poem": 2
          },
          {
            "text": "Они проводе намере што нису од мене,",
            "poem": 1
          },
          {
            "text": "склапају савезе што нису по Духу мом;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и грех на грех гомилају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Кренули су у Египат доле,",
            "poem": 1
          },
          {
            "text": "а нису питали шта ћу ја рећи;",
            "poem": 2
          },
          {
            "text": "да утекну у уточиште фараонско,",
            "poem": 1
          },
          {
            "text": "и да се уздају у сенку египатску.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Уточиште фараонско биће им на срамоту,",
            "poem": 1
          },
          {
            "text": "и уздање у сенку египатску на поругу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Та главари његови већ су у Соану,",
            "poem": 1
          },
          {
            "text": "посланици његови стигли су у Ханес:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "сви ће се посрамити",
            "poem": 1
          },
          {
            "text": "над народом бескорисним,",
            "poem": 2
          },
          {
            "text": "неће им бити на помоћ ни на корист,",
            "poem": 1
          },
          {
            "text": "већ на срамоту, па и за укор.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Против изасланства у Египат (II)"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Пророштво против животиња негевских:",
          {
            "text": "Кроз земљу невоље и беде,",
            "poem": 1
          },
          {
            "text": "лавице и лава који ричу,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "љуте гује и крилате змије огњене,",
            "poem": 2
          },
          {
            "text": "носе они блага своја на леђима младих магараца,",
            "poem": 1
          },
          {
            "text": "и богатства своја на грбама камила –",
            "poem": 2
          },
          {
            "text": "носе га народу бескорисном.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Зато што је египатска помоћ празна и ништавна,",
            "poem": 2
          },
          {
            "text": "због тога сам их назвао:",
            "poem": 1
          },
          {
            "text": "„Изнемогла Рава",
            "poem": 2
          },
          {
            "noteId": 10
          },
          {
            "text": ".“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Завештање"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Сад дођи, упиши на плочи пред њима",
            "poem": 1
          },
          {
            "text": "и забележи у књизи,",
            "poem": 2
          },
          {
            "text": "те да остане за будућност,",
            "poem": 1
          },
          {
            "text": "за век векова;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "јер ово је народ одметнички, синови лажљиви,",
            "poem": 1
          },
          {
            "text": "синови који неће да слушају Закон Господњи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Они говоре видовитима:",
            "poem": 1
          },
          {
            "text": "„Оканите се виђења!“,",
            "poem": 2
          },
          {
            "text": "а видеоцима:",
            "poem": 1
          },
          {
            "text": "„Не пророкујте нам поштење!",
            "poem": 2
          },
          {
            "text": "Говорите што је нама угодно!",
            "poem": 1
          },
          {
            "text": "Пророкујте нам привиде!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Застраните с пута,",
            "poem": 1
          },
          {
            "text": "скрените са стазе,",
            "poem": 2
          },
          {
            "text": "уклоните нам са очију",
            "poem": 1
          },
          {
            "text": "Светитеља Израиљева!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Зато Светитељ Израиљев говори:",
          {
            "text": "„Зато што реч ову презирете,",
            "poem": 1
          },
          {
            "text": "а ослањате се на опакост и превару,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и на њих се подупирете,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "зато ће вам та кривица бити као пукотина,",
            "poem": 1
          },
          {
            "text": "што се избочила на зиду високом,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "који ће се срушити изненада, у тренутку,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "и срушиће се као што се руши суд грнчарски,",
            "poem": 1
          },
          {
            "text": "разбије се и нико га не жали,",
            "poem": 2
          },
          {
            "text": "те међу крхотинама његовим ни уломак се не нађе,",
            "poem": 1
          },
          {
            "text": "да се узме жеравица са огњишта",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "или заграби вода са студенца.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Јер говори Господар Господ, Светитељ Израиљев:",
          {
            "text": "„У покајању и спокојству бићете спасени;",
            "poem": 1
          },
          {
            "text": "у смирености и ослонцу ваша је сила;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "али ви нисте хтели.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Рекли сте: ’Не, јер ћемо на коњима побећи.’",
            "poem": 1
          },
          {
            "text": "Зато ћете бежати.",
            "poem": 2
          },
          {
            "text": "’Јахаћемо онда у галопу.’",
            "poem": 1
          },
          {
            "text": "Зато ће ваши гониоци бржи бити:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "вас хиљаду бежаће",
            "poem": 1
          },
          {
            "text": "кад један подвикне;",
            "poem": 2
          },
          {
            "text": "кад подвикну петорица,",
            "poem": 1
          },
          {
            "text": "трком ћете бежати,",
            "poem": 2
          },
          {
            "text": "док од вас не остане",
            "poem": 1
          },
          {
            "text": "као колац на врху горе",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "или као ознака на брду.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ипак, Господ чезне да вам се смилује,",
            "poem": 1
          },
          {
            "text": "и зато чезне да вас облагодати,",
            "poem": 2
          },
          {
            "text": "јер Господ је Бог праведни.",
            "poem": 1
          },
          {
            "text": "Благо свима који чезну за њим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Будуће благостање"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "О, народе сионски, који станујеш у Јерусалиму. Немој никако плакати. Он ће јамачно бити наклоњен гласу вапаја твојега. Чим те чује, одговориће ти."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "И Господар ће вам дати хлеб патнички и воду невоље, па се више неће крити твоји учитељи, и твоје ће очи гледати учитеље твоје."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "И уши твоје слушаће реч иза леђа твојих где се говори: „То је пут, њиме идите!“, било да скрећете надесно или налево."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Тада ћеш сматрати нечистима своје кумире посребрене и своје идоле златом опточене. Одбацићеш их као излив женски и рећи ћеш: „Напоље!“"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Тада ће дати кишу твом семену што посејеш на њиви, а хлеб што ће га њива родити биће обилат и хранљив. Стока твоја ће пасти у онај дан, по пространим пашњацима."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Волови и магарци који служе за њиву јешће осољену храну, овејану лопатом и решетом."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "И на свакој гори и на свакој узвишици биће потока и токова, у дан силнога покоља кад се куле буду рушиле."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Тада ће месечина бити као сунчева светлост, а сунчева светлост ће бити седам пута јача, као светлост седам дана – у дан кад Господ завије преломе народу своме, и излечи ране удараца његових."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Пропаст Асирије"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Гле, Господ лично из далека долази,",
            "poem": 1
          },
          {
            "text": "гнев његов гори, бреме бива отежано.",
            "poem": 2
          },
          {
            "text": "Усне његове јарости су пуне,",
            "poem": 1
          },
          {
            "text": "језик му је ватра што прождире,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "а Дух је његов као поток набујали,",
            "poem": 1
          },
          {
            "text": "што се до грла попео.",
            "poem": 2
          },
          {
            "text": "Он долази да светину прорешета решетом погубним,",
            "poem": 1
          },
          {
            "text": "и да постави узде заводљиве",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "у чељуст народима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Песма ће вам бити",
            "poem": 1
          },
          {
            "text": "као у претпразничким ноћима,",
            "poem": 2
          },
          {
            "text": "кад су срца весела",
            "poem": 1
          },
          {
            "text": "као код оног који иде уз звуке фруле",
            "poem": 2
          },
          {
            "text": "да дође на Гору Господњу,",
            "poem": 1
          },
          {
            "text": "на Стену Израиљеву,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "и зачуће се величанствени глас Господњи,",
            "poem": 1
          },
          {
            "text": "и показаће се удар руке његове",
            "poem": 2
          },
          {
            "text": "у јаросном гневу, у ватри што прождире,",
            "poem": 1
          },
          {
            "text": "из провале облака и олује,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и из града који је као туцаник,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "јер од гласа Господњег препашће се Асирац,",
            "poem": 1
          },
          {
            "text": "шибом којом он шиба.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "И кад год удари палица одређена",
            "poem": 1
          },
          {
            "text": "којом ће се Господ одморити на њему,",
            "poem": 2
          },
          {
            "text": "с бубњевима и харфама, у борбеним покличима,",
            "poem": 1
          },
          {
            "text": "против њега он се бори.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Већ је приправљен Тофет,",
            "poem": 1
          },
          {
            "text": "управо је спреман за цара,",
            "poem": 2
          },
          {
            "text": "много ватре и много дрва.",
            "poem": 1
          },
          {
            "text": "Он је продубио, проширио ломачу за њега,",
            "poem": 2
          },
          {
            "text": "повећао ватру и дрва.",
            "poem": 1
          },
          {
            "text": "Дах Господњи је као поток од сумпора,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "разгара се на њему.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 10,
        "caller": "+",
        "text": "30,7 Име морске немани које одсликава хаос, а понекад Египат.",
        "reference": {
          "chapter": 30,
          "verse": 7
        }
      }
    ]
