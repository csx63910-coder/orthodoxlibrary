    "name": "Књига пророка Исаије",
    "commonName": "Књига пророка Исаије",
    "title": "Књига пророка Исаије",
    "order": 23,
    "numberOfChapters": 66,
    "sha256": "65da7472046c4c4242da6b0395082ca741c36130fd8710e93ef455190b89026a",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/ISA/1.json",
    "lastChapterNumber": 66,
    "lastChapterApiLink": "/api/srp_onspc/ISA/66.json",
    "totalNumberOfVerses": 1292
  },
  "chapter": {
    "number": 53,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ко је поверовао нашој поруци,",
            "poem": 1
          },
          {
            "text": "и мишица Господња коме се открила?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "И као изданак пред њим је израстао,",
            "poem": 1
          },
          {
            "text": "и као корен из земље сухе.",
            "poem": 2
          },
          {
            "text": "Није имао красоте ни изгледа;",
            "poem": 1
          },
          {
            "text": "ни да буде виђен ни пожељан.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Био је презрен и од људи одбачен,",
            "poem": 1
          },
          {
            "text": "човек у боловима и страдању вичан,",
            "poem": 2
          },
          {
            "text": "и као онај од ког заклањају лице,",
            "poem": 1
          },
          {
            "text": "био је презрен и за нас безначајан.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "А он је наше болове понео,",
            "poem": 1
          },
          {
            "text": "и наше болести на себе узео.",
            "poem": 2
          },
          {
            "text": "Ми смо, пак, сматрали",
            "poem": 1
          },
          {
            "text": "да га Бог туче, удара и понижава.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "А он је прободен због наших преступа,",
            "poem": 1
          },
          {
            "text": "сатрвен због наших кривица,",
            "poem": 2
          },
          {
            "text": "карање је на њему због нашег мира",
            "poem": 1
          },
          {
            "text": "и ранама својим нас је исцелио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Сви смо ми као овце заврљали,",
            "poem": 1
          },
          {
            "text": "сваки је кренуо својим путем;",
            "poem": 2
          },
          {
            "text": "а Господ је на њега свалио",
            "poem": 1
          },
          {
            "text": "кривицу свих нас.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Тлачен је био и понизио се он,",
            "poem": 1
          },
          {
            "text": "и није отворио уста своја;",
            "poem": 2
          },
          {
            "text": "као јагње на клање је вођен,",
            "poem": 1
          },
          {
            "text": "и као овца нема пред онима који је стрижу,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и није отворио уста своја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Од власти и од суда он је изузет.",
            "poem": 1
          },
          {
            "text": "И ко ће да исприча шта је после било?",
            "poem": 2
          },
          {
            "text": "Јер из земље живих је издвојен,",
            "poem": 1
          },
          {
            "text": "због греха мог народа он је тучен.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Одредили су му гроб међу опакима,",
            "poem": 1
          },
          {
            "text": "а у смрти би с богаташима.",
            "poem": 2
          },
          {
            "text": "Ипак, нити је учинио насиље,",
            "poem": 1
          },
          {
            "text": "нити превару устима својим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Међутим, Господу се свидело",
            "poem": 1
          },
          {
            "text": "да га сатире болом.",
            "poem": 2
          },
          {
            "text": "Ако принесеш живот његов",
            "poem": 1
          },
          {
            "text": "као жртву за преступ,",
            "poem": 2
          },
          {
            "text": "потомство ће се постарати",
            "poem": 1
          },
          {
            "text": "да се продуже дани,",
            "poem": 2
          },
          {
            "text": "и што је Господу угодно",
            "poem": 1
          },
          {
            "text": "напредоваће руком његовом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "„Из оног што је искусио",
            "poem": 1
          },
          {
            "text": "видеће светло и знањем својим ће се наситити.",
            "poem": 2
          },
          {
            "text": "Својим познањем праведни слуга мој оправдаће многе.",
            "poem": 1
          },
          {
            "text": "И њихове кривице сам ће изнети.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Зато ћу му многе у баштину дати",
            "poem": 1
          },
          {
            "text": "и с моћницима ће плен делити.",
            "poem": 2
          },
          {
            "text": "И сам је себе понудио да умре,",
            "poem": 1
          },
          {
            "text": "па је у грешнике убројен,",
            "poem": 2
          },
          {
            "text": "и сам је понео грехе многих",
            "poem": 1
          },
          {
            "text": "и заузима се за грешнике.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
