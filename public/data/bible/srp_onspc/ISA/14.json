  },
  "chapter": {
    "number": 14,
    "content": [
      {
        "type": "heading",
        "content": [
          "Господ припрема повратак"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Та, смиловаће се Господ Јакову,",
            "poem": 1
          },
          {
            "text": "и опет ће изабрати Израиља;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и даће им да се одморе на свом тлу.",
            "poem": 2
          },
          {
            "text": "Па ће им се придружити дошљак",
            "poem": 1
          },
          {
            "text": "и прикључиће се племенима Јаковљевим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "И узеће их народи",
            "poem": 1
          },
          {
            "text": "и одвешће их у њихов крај,",
            "poem": 2
          },
          {
            "text": "а потомство Израиљево њих ће населити на Господњем тлу,",
            "poem": 1
          },
          {
            "text": "као робове и слушкиње.",
            "poem": 2
          },
          {
            "text": "И заробиће оне који су њих заробљавали,",
            "poem": 1
          },
          {
            "text": "и биће господари над својим тлачитељима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Како нестаде Вавилон"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "И биће оног дана: Господ ће ти дати починак од напора твојих и од невоља твојих и робовања тешког, чиме су те били тлачили."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Тад ћеш саставити изреку против вавилонског цара, ти ћеш говорити:",
          {
            "text": "Како нестаде тлачитељ!",
            "poem": 1
          },
          {
            "text": "Како нестаде мучилиште!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Господ је сломио палицу опаких",
            "poem": 1
          },
          {
            "text": "и жезло владарско",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "што је бесно тукло народе",
            "poem": 1
          },
          {
            "text": "ударцима што не престајаху,",
            "poem": 2
          },
          {
            "text": "што је гневно потчињавало пуке,",
            "poem": 1
          },
          {
            "text": "немилице их прогонило.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Сва земља се одмара, почива,",
            "poem": 1
          },
          {
            "text": "пролама се клицање.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Над тобом се радују чемпреси",
            "poem": 1
          },
          {
            "text": "и кедри ливански:",
            "poem": 2
          },
          {
            "text": "„Од како си пао,",
            "poem": 1
          },
          {
            "text": "не долазе на нас дрвосече.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Доле се због тебе Свет мртвих усколебао,",
            "poem": 1
          },
          {
            "text": "када дођеш, да те он поздрави;",
            "poem": 2
          },
          {
            "text": "зато он буди преминуле,",
            "poem": 1
          },
          {
            "text": "све моћнике земаљске;",
            "poem": 2
          },
          {
            "text": "са својих престола устају",
            "poem": 1
          },
          {
            "text": "сви цареви разних народности.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Сви ти они казују и говоре:",
            "poem": 1
          },
          {
            "text": "„Ти си онемоћао као и ми што смо.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ти си нама сличан постао.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Охолост се твоја у Свет мртвих сруши,",
            "poem": 1
          },
          {
            "text": "бука твојих лаута;",
            "poem": 2
          },
          {
            "text": "под тобом је лежај трулежи,",
            "poem": 1
          },
          {
            "text": "а над тобом покривач од црва.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Како паде са небеса,",
            "poem": 1
          },
          {
            "text": "Светлоношо, сине Зорин?",
            "poem": 2
          },
          {
            "text": "Оборен си ти на земљу,",
            "poem": 1
          },
          {
            "text": "разоритељ над пуцима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "А у свом си срцу говорио:",
            "poem": 1
          },
          {
            "text": "„Попећу се на небеса,",
            "poem": 2
          },
          {
            "text": "изнад звезда Божијих.",
            "poem": 1
          },
          {
            "text": "Престо свој ћу подићи",
            "poem": 2
          },
          {
            "text": "и сешћу на гори саборној,",
            "poem": 1
          },
          {
            "text": "на ивицама севера.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Узнећу се на висине над облацима,",
            "poem": 1
          },
          {
            "text": "изједначићу се са Свевишњим.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "А ти си у Свет мртвих бачен,",
            "poem": 1
          },
          {
            "text": "у дубине бездана.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Који те виде, они те посматрају,",
            "poem": 1
          },
          {
            "text": "и о теби размишљају:",
            "poem": 2
          },
          {
            "text": "„Је ли то тај човек",
            "poem": 1
          },
          {
            "text": "који је земљу тресао, царства дрмао;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "који је васељену у пустињу претварао",
            "poem": 1
          },
          {
            "text": "и њене градове рушио;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "који затворенике своје кући није пуштао?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Цареви разних народа сви почивају у части,",
            "poem": 1
          },
          {
            "text": "сваки је у својој гробници;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "а ти си избачен из гроба свог",
            "poem": 1
          },
          {
            "text": "као неки изданак одурни,",
            "poem": 2
          },
          {
            "text": "покривен си покланима,",
            "poem": 1
          },
          {
            "text": "мачем прободенима,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "на плоче од раке побацанима,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "као изгажена лешина.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Ни твој погреб неће бити",
            "poem": 1
          },
          {
            "text": "као што је погреб њихов,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "зато што си своју земљу разорио,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "зато што си свој народ поклао.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Нека се никад више",
            "poem": 1
          },
          {
            "text": "потомство зликовачко не помиње.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Спремите покољ потомцима",
            "poem": 1
          },
          {
            "text": "због кривице њихових отаца,",
            "poem": 2
          },
          {
            "text": "да се више не подижу, да свет освајају,",
            "poem": 1
          },
          {
            "text": "те ће сва васељена бити покривена градовима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Слом Вавилона"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "„Устаћу на њих",
            "poem": 1
          },
          {
            "text": "– говори Господ над војскама –",
            "poem": 2
          },
          {
            "text": "и затрћу Вавилону име",
            "poem": 1
          },
          {
            "text": "и остатак и род и пород",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Па ћу њега у посед предати",
            "poem": 1
          },
          {
            "text": "јежевима и мочварама.",
            "poem": 2
          },
          {
            "text": "Почистићу га метлом-затиралицом",
            "poem": 1
          },
          {
            "text": "– говори Господ над војскама.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Слом земље Асирије"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Заклео се Господ над војскама говорећи:",
          {
            "text": "„Што замислих, то се има збити,",
            "poem": 1
          },
          {
            "text": "што наумих, то ће се догодити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Скршићу Асирца на мојој земљи,",
            "poem": 1
          },
          {
            "text": "изгазићу на мојим горама.",
            "poem": 2
          },
          {
            "text": "Њен ће јарам са њих пасти;",
            "poem": 1
          },
          {
            "text": "њено бреме са њихових плећа.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Таква је одлука донесена против читаве земље;",
            "poem": 1
          },
          {
            "text": "таква је рука испружена против свих народности.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "А кад Господ над војскама одлучи,",
            "poem": 1
          },
          {
            "text": "ко ће се успротивити?",
            "poem": 2
          },
          {
            "text": "Кад он руку испружи,",
            "poem": 1
          },
          {
            "text": "ко ће је одвратити?",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Опомена Филистејцима"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Године кад је умро цар Ахаз било је ово пророштво:"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Не радуј се, Филистејо цела,",
            "poem": 1
          },
          {
            "text": "што се сломи штап што те удара,",
            "poem": 2
          },
          {
            "text": "јер ће отровница изаћи из змијског клупка",
            "poem": 1
          },
          {
            "text": "и она ће излећи змаја крилатога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "И напасаће се првенци убогих,",
            "poem": 1
          },
          {
            "text": "и у спокојству почиваће сиромаси;",
            "poem": 2
          },
          {
            "text": "а твој род ћу поморити глађу,",
            "poem": 1
          },
          {
            "text": "и побићу што од тебе остане.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Кукајте, вратнице! Запомажи, граде!",
            "poem": 1
          },
          {
            "text": "Стрепи, сва филистејска земљо!",
            "poem": 2
          },
          {
            "text": "Јер најезда са севера долази,",
            "poem": 1
          },
          {
            "text": "и чете њезине нико не напушта!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Шта ће се тада одговорити",
            "poem": 1
          },
          {
            "text": "гласницима било кога пука?",
            "poem": 2
          },
          {
            "text": "„Господ је основао Сион,",
            "poem": 1
          },
          {
            "text": "и у њему ће бити заштићени сиромаси из његова народа.“",
            "poem": 2
          }
        ]
      }
    ],
