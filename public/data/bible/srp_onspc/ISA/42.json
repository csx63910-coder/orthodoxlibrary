  "chapter": {
    "number": 42,
    "content": [
      {
        "type": "heading",
        "content": [
          "О слузи Господњем. Песма прва. Део први."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ево Слуге мога, коме сам потпора,",
            "poem": 1
          },
          {
            "text": "изабраника мога, миљеника душе моје.",
            "poem": 2
          },
          {
            "text": "На њега сам Духа свога излио",
            "poem": 1
          },
          {
            "text": "да доноси правду народима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Он не виче, нити буку прави,",
            "poem": 1
          },
          {
            "text": "на улици гласа свог не диже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Он не ломи трску напукнуту,",
            "poem": 1
          },
          {
            "text": "нити гаси фитиљ који тиња,",
            "poem": 2
          },
          {
            "text": "него он доноси право истинито.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Он не тиња, нити сломљен бива",
            "poem": 2
          },
          {
            "text": "док на земљи право не успостави,",
            "poem": 1
          },
          {
            "text": "а острва су жедна његовог Закона.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "О слузи Господњем. Песма прва. Део други."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Говори Бог Господ,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "који је створио и разастро небеса,",
            "poem": 1
          },
          {
            "text": "који је раширио земљу и растиње њено,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "који даје дисање народима по њој,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и дух бићима која ходају по њој:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "„Ја, Господ, у правди сам те позвао,",
            "poem": 1
          },
          {
            "text": "и за руку те ухватио;",
            "poem": 2
          },
          {
            "text": "и тебе чувао и тебе поставио",
            "poem": 1
          },
          {
            "text": "за савез народу,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "за светлост племенима,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "да отвориш очи слепима,",
            "poem": 1
          },
          {
            "text": "да изведеш из затвора сужње,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "из тамнице оне што у тами живе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ја сам Господ, то је име моје,",
            "poem": 1
          },
          {
            "text": "и славе своје другом дати нећу,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "нити части своје киповима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Што је од искона, гле, то долази;",
            "poem": 1
          },
          {
            "text": "и новости ја већ најавих,",
            "poem": 2
          },
          {
            "text": "пре него се збуду",
            "poem": 1
          },
          {
            "text": "чиним да чујете.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Победничка песма"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Певајте Господу песму нову,",
            "poem": 1
          },
          {
            "text": "славу његову од краја земљиног,",
            "poem": 2
          },
          {
            "text": "који морем силазите и што је по њему,",
            "poem": 1
          },
          {
            "text": "острва и сви становници њини.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Нека се ускомеша пустиња и градови њени,",
            "poem": 1
          },
          {
            "text": "нека одјекују насеља кедарска,",
            "poem": 2
          },
          {
            "text": "нека подвикују становници Селе,",
            "poem": 1
          },
          {
            "text": "нека кличу с горских врхова,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Нека славу своју дају Господу,",
            "poem": 1
          },
          {
            "text": "и хвалу му најављују по острвима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Као јунак Господ ступа,",
            "poem": 1
          },
          {
            "text": "као ратник он се разјарио,",
            "poem": 2
          },
          {
            "text": "Он кликће и уз то виче,",
            "poem": 1
          },
          {
            "text": "на непријатеље се своје устремио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "„Од давнина сам ћутао,",
            "poem": 1
          },
          {
            "text": "глув се правио, уздржавао,",
            "poem": 2
          },
          {
            "text": "сад вичем као породиља,",
            "poem": 1
          },
          {
            "text": "дахћем и издишем уједно.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Сасушићу горе и брегове,",
            "poem": 1
          },
          {
            "text": "и спарушити све биљке по њима,",
            "poem": 2
          },
          {
            "text": "и претворити реке у вртаче,",
            "poem": 1
          },
          {
            "text": "и мочваре ја ћу исушити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Слепе људе водићу путем што га не познају,",
            "poem": 1
          },
          {
            "text": "упутићу их на стазе што их не познају.",
            "poem": 2
          },
          {
            "text": "Пред њима ћу таму у светлост претворити,",
            "poem": 1
          },
          {
            "text": "а џомбе у зараван.",
            "poem": 2
          },
          {
            "text": "Те ћу ствари учинити",
            "poem": 1
          },
          {
            "text": "и нећу оклевати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "У великом стиду ће узмаћи",
            "poem": 1
          },
          {
            "text": "који се у резане кипове уздају,",
            "poem": 2
          },
          {
            "text": "који ливеним ликовима говоре:",
            "poem": 1
          },
          {
            "text": "’Ви сте богови наши.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Песма о заслепљености"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Чујте, глуви!",
            "poem": 1
          },
          {
            "text": "И прогледајте, слепи, да видите!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ко је слеп, ако не мој слуга?",
            "poem": 1
          },
          {
            "text": "Ко је глув, ако не мој гласник кога шаљем?",
            "poem": 2
          },
          {
            "text": "Ко је слеп као намирени",
            "poem": 1
          },
          {
            "text": "и слеп као слуга Господњи?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Много си видео, али ниси марио;",
            "poem": 1
          },
          {
            "text": "уши отворене али нико не слуша.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Господу се свидело",
            "poem": 1
          },
          {
            "text": "због праведности његове",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да узвелича Закон и почаст му да.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "А народ је овај опљачкан и оплењен,",
            "poem": 1
          },
          {
            "text": "у пећине сви су они затворени,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "у затворе склоњени.",
            "poem": 2
          },
          {
            "text": "Плене их,",
            "poem": 1
          },
          {
            "text": "а нико да их избави;",
            "poem": 2
          },
          {
            "text": "отимају им,",
            "poem": 1
          },
          {
            "text": "а нико да каже: „Врати!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Ко од вас мари за то?",
            "poem": 1
          },
          {
            "text": "Ко се нагао и слуша унапред?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Ко је пљачкашу изручио Јакова",
            "poem": 1
          },
          {
            "text": "и отимачима Израиља?",
            "poem": 2
          },
          {
            "text": "Није ли то Господ,",
            "poem": 1
          },
          {
            "text": "против ког смо грешили,",
            "poem": 2
          },
          {
            "text": "чије путеве нису хтели да следе,",
            "poem": 1
          },
          {
            "text": "и чији Закон нису слушали?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Зато је он на њега излио",
            "poem": 1
          },
          {
            "text": "јарост гнева својега и насиља ратна;",
            "poem": 2
          },
          {
            "text": "пламен га је одасвуд окружио,",
            "poem": 1
          },
          {
            "text": "али он ни то није схватио;",
            "poem": 2
          },
          {
            "text": "и спалио га је,",
            "poem": 1
          },
          {
            "text": "али он ни то није озбиљно узео.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
