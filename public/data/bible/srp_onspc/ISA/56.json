  "chapter": {
    "number": 56,
    "content": [
      {
        "type": "heading",
        "content": [
          "Бог прихвата неприхваћене"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Говори Господ:",
          {
            "text": "„Држите право",
            "poem": 1
          },
          {
            "text": "и чините правду,",
            "poem": 2
          },
          {
            "text": "јер од мене се приближава спасење",
            "poem": 1
          },
          {
            "text": "и биће објављена правда моја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Блажен је човек који чини ово,",
            "poem": 1
          },
          {
            "text": "и син човечији који то држи,",
            "poem": 2
          },
          {
            "text": "који пази на суботу да је не оскрнави,",
            "poem": 1
          },
          {
            "text": "и пази на руку своју да никаква зла не учини.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Нека туђинчев син који је прионуо уз Господа не казује говорећи:",
            "poem": 1
          },
          {
            "text": "„Господ ме је јамачно одвојио од свог народа.“",
            "poem": 2
          },
          {
            "text": "И евнух нека не говори:",
            "poem": 1
          },
          {
            "text": "„Ја сам суво дрво.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Јер говори Господ:",
          {
            "text": "„Евнусима који пазе на суботе моје",
            "poem": 1
          },
          {
            "text": "и бирају што је мени угодно,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и који се држе савеза са мном;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "њима ћу дати у Дому моме",
            "poem": 1
          },
          {
            "text": "и међу зидовима мојим",
            "poem": 2
          },
          {
            "text": "спомен и име боље него синовима и ћеркама,",
            "poem": 1
          },
          {
            "text": "даћу им вечно име, неразориво.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "А туђинске синове који су прионули уз Господа",
            "poem": 1
          },
          {
            "text": "да му се клањају и да љубе име Господње",
            "poem": 2
          },
          {
            "text": "и да му буду слуге, сви који пазе на суботу",
            "poem": 1
          },
          {
            "text": "да је не оскрнаве и који се држе савеза са мном;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "њих ћу довести на свету гору моју,",
            "poem": 1
          },
          {
            "text": "и обрадоваћу их у мом Дому за молитву.",
            "poem": 2
          },
          {
            "text": "Свеспалнице њихове и жртве заклане",
            "poem": 1
          },
          {
            "text": "биће ми по вољи на жртвенику моме.",
            "poem": 2
          },
          {
            "text": "Јер ће се Дом мој звати",
            "poem": 1
          },
          {
            "text": "’Дом за молитву свим народима’.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Господар Господ",
            "poem": 1
          },
          {
            "text": "који сакупља изгнане Израиљце",
            "poem": 2
          },
          {
            "text": "вели: „Још ћу их сакупити",
            "poem": 1
          },
          {
            "text": "сврх већ сакупљених.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Против недостојних главара"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Све животиње пољске, дођите да једете,",
            "poem": 1
          },
          {
            "text": "све животиње шумске.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Сви његови стражари су затајили,",
            "poem": 1
          },
          {
            "text": "сви они не схватају,",
            "poem": 2
          },
          {
            "text": "пси безгласни, да лају не могу.",
            "poem": 1
          },
          {
            "text": "Сањиво се излежавају, воле да дремају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "И то: прождрљиви су пси,",
            "poem": 1
          },
          {
            "text": "не умеју да се насите.",
            "poem": 2
          },
          {
            "text": "И они су пастири неразборити,",
            "poem": 1
          },
          {
            "text": "сваки од њих на свој пут окреће,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "сваки за грабежом својим себично.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "„Дођите, донећу вина,",
            "poem": 1
          },
          {
            "text": "и напићемо се жестока пића.",
            "poem": 2
          },
          {
            "text": "Као данас и сутра ће бити:",
            "poem": 1
          },
          {
            "text": "обиље врло велико!“",
            "poem": 2
          }
        ]
      }
    ],
