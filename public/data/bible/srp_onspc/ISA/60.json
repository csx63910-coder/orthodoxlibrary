  "book": {
    "id": "ISA",
    "translationId": "srp_onspc",
    "name": "Књига пророка Исаије",
    "commonName": "Књига пророка Исаије",
    "title": "Књига пророка Исаије",
    "order": 23,
    "numberOfChapters": 66,
    "sha256": "65da7472046c4c4242da6b0395082ca741c36130fd8710e93ef455190b89026a",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/ISA/1.json",
    "lastChapterNumber": 66,
    "lastChapterApiLink": "/api/srp_onspc/ISA/66.json",
    "totalNumberOfVerses": 1292
  },
  "chapter": {
    "number": 60,
    "content": [
      {
        "type": "heading",
        "content": [
          "Устани, Јерусалиме!"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Устани, засветли, јер долази светлост твоја,",
            "poem": 1
          },
          {
            "text": "и слава Господња над тобом блиста.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Јер, гле, мрак ће покрити земљу,",
            "poem": 1
          },
          {
            "text": "и густа тама народе,",
            "poem": 2
          },
          {
            "text": "а над тобом блиста Господ,",
            "poem": 1
          },
          {
            "text": "и слава његова над тобом се јавља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "И пуци иду према твојој светлости,",
            "poem": 1
          },
          {
            "text": "и цареви према сјају блистања твога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Обазри се око себе и гледај:",
            "poem": 1
          },
          {
            "text": "сви се они сакупљају,",
            "poem": 2
          },
          {
            "text": "синови твоји долазе ти из далека,",
            "poem": 1
          },
          {
            "text": "и ћерке твоје бивају донесене у наручју.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Тада ћеш гледати и бујати,",
            "poem": 1
          },
          {
            "text": "и устрептаће и шириће се срце твоје,",
            "poem": 2
          },
          {
            "text": "јер ће се богатство с мора к теби окренути,",
            "poem": 1
          },
          {
            "text": "благо туђих народа теби ће пристизати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Мноштво камила тебе ће прекрити,",
            "poem": 1
          },
          {
            "text": "једногрбе камиле из Мадијана и Гефе,",
            "poem": 2
          },
          {
            "text": "сви ће они доћи из Саве,",
            "poem": 1
          },
          {
            "text": "донеће злато и тамјан,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и благовестиће певајући похвале Господу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Сва стада из Кедра к теби ће се сабрати,",
            "poem": 1
          },
          {
            "text": "овнови из Навајота теби ће служити;",
            "poem": 2
          },
          {
            "text": "подизаће се као угодна жртва на жртвенику мом.",
            "poem": 1
          },
          {
            "text": "И прославићу Дом славности своје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ко су они што надлећу као облак тамни,",
            "poem": 1
          },
          {
            "text": "као голубови према голубњацима својим?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "На мене острва чекају,",
            "poem": 1
          },
          {
            "text": "на челу су им из Тарсиса бродови,",
            "poem": 2
          },
          {
            "text": "да издалека доведу синове твоје,",
            "poem": 1
          },
          {
            "text": "сребро њихово и злато њихово с њима,",
            "poem": 2
          },
          {
            "text": "за име Господа Бога твојега,",
            "poem": 1
          },
          {
            "text": "за Светитеља Израиљева",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "који те је славним учинио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Синови странаца градиће тврђаве твоје",
            "poem": 1
          },
          {
            "text": "и цареви њихови тебе ће опслуживати,",
            "poem": 2
          },
          {
            "text": "јер сам те ударио у срдњи својој,",
            "poem": 1
          },
          {
            "text": "а смиловао сам ти се по расположењу својем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Вратнице ће твоје свагда отворене бити,",
            "poem": 1
          },
          {
            "text": "дању и ноћу затварати се неће,",
            "poem": 2
          },
          {
            "text": "да би пропустиле благо туђинских народа",
            "poem": 1
          },
          {
            "text": "и цареве њихове који их предводе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Та пропашће пук и царство",
            "poem": 1
          },
          {
            "text": "који теби не буду служили,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и ти ће пуци бити потпуно затрти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Слава ливанска доћи ће теби:",
            "poem": 1
          },
          {
            "text": "чемпрес, брест и шимшир скупа,",
            "poem": 2
          },
          {
            "text": "да украсе место Светилишта мојега,",
            "poem": 1
          },
          {
            "text": "да учине часним место испод ногу мојих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "И ићи ће према теби погнути синови тлачитеља твојих,",
            "poem": 1
          },
          {
            "text": "и падаће ка твојим стопама сви који су те презирали.",
            "poem": 2
          },
          {
            "text": "А тебе ће назвати: ’Град Господњи’,",
            "poem": 1
          },
          {
            "text": "’Сион Светитеља Израиљева.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Уместо да будеш напуштен",
            "poem": 1
          },
          {
            "text": "и омрзнут и избегаван,",
            "poem": 2
          },
          {
            "text": "поставићу те да будеш понос вечни,",
            "poem": 1
          },
          {
            "text": "весеље од рода до рода.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "И сисаћеш млеко страних народа,",
            "poem": 1
          },
          {
            "text": "и царске груди ће те дојити,",
            "poem": 2
          },
          {
            "text": "и знаћеш да сам ја Господ, Спаситељ твој,",
            "poem": 1
          },
          {
            "text": "Откупитељ твој, Силни Јаковљев.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Уместо бронзе довешћу ти злато,",
            "poem": 1
          },
          {
            "text": "и уместо гвожђа довешћу ти сребро,",
            "poem": 2
          },
          {
            "text": "и уместо дрвета бронзу,",
            "poem": 1
          },
          {
            "text": "и уместо камена гвожђе,",
            "poem": 2
          },
          {
            "text": "а за надзорника ћу ти поставити Мир,",
            "poem": 1
          },
          {
            "text": "и управитељ твој биће Правда.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Више се неће чути о насиљу у твојој земљи,",
            "poem": 1
          },
          {
            "text": "о тлачењу и рушењу у границама твојим.",
            "poem": 2
          },
          {
            "text": "И зидине твоје зваћеш ’Спас’,",
            "poem": 1
          },
          {
            "text": "и вратнице твоје ’Прослављање’.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Више ти неће бити сунце као светлост дању,",
            "poem": 1
          },
          {
            "text": "нити ће сјај месеца да ти светли.",
            "poem": 2
          },
          {
            "text": "Него ће ти Господ бити светлост вечна",
            "poem": 1
          },
          {
            "text": "и Бог твој славност твоја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Сунце твоје залазити више неће,",
            "poem": 1
          },
          {
            "text": "ни месец ти се помрачити неће,",
            "poem": 2
          },
          {
            "text": "него ће ти Господ вечна светлост бити,",
            "poem": 1
          },
          {
            "text": "и навршиће се дани жалости твоје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "И у народу твоме сви ће бити праведници,",
            "poem": 1
          },
          {
            "text": "довека ће земљу заузимати,",
            "poem": 2
          },
          {
            "text": "изданак насада мога,",
            "poem": 1
          },
          {
            "text": "израда руку мојих,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "славности ради.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Од најмањег постаће хиљада,",
            "poem": 1
          },
          {
            "text": "од ситнога један моћни пук.",
            "poem": 2
          },
          {
            "text": "Ја, Господ,",
            "poem": 1
          },
          {
            "text": "чинићу брзо у време погодно.",
            "poem": 2
          }
        ]
      }
    ],
