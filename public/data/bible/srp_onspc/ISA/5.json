  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "heading",
        "content": [
          "Песма о винограду"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Запеваћу миљенику своме,",
            "poem": 1
          },
          {
            "text": "песму љубавника својега о винограду његовом.",
            "poem": 2
          },
          {
            "text": "Мој миљеник је виноград имао",
            "poem": 1
          },
          {
            "text": "на брдашцу родноме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Он га окопа и од камења очисти,",
            "poem": 1
          },
          {
            "text": "те лозу племениту у њему посади.",
            "poem": 2
          },
          {
            "text": "Посред њега он кулу подиже",
            "poem": 1
          },
          {
            "text": "и у њему муљару сагради.",
            "poem": 2
          },
          {
            "text": "Чекао је да му роди грожђе,",
            "poem": 1
          },
          {
            "text": "а он њему изроди вињаге.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "„Сад, становници јерусалимски, и ви, људи Јудејци,",
            "poem": 1
          },
          {
            "text": "ви будите судије на суду између мене и мог винограда.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Шта још могох учинити за виноград мој,",
            "poem": 1
          },
          {
            "text": "а да му нисам учинио?",
            "poem": 2
          },
          {
            "text": "Зашто? Ја се надах да ће родити грожђе,",
            "poem": 1
          },
          {
            "text": "а он је изродио вињаге?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "И сад да вам кажем",
            "poem": 1
          },
          {
            "text": "шта ћу да учиним винограду своме:",
            "poem": 2
          },
          {
            "text": "плот ћу његов уклонити,",
            "poem": 1
          },
          {
            "text": "нека га пустоше;",
            "poem": 2
          },
          {
            "text": "зид ћу његов развалити,",
            "poem": 1
          },
          {
            "text": "нека га изгазе;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "у пустош ћу га претворити,",
            "poem": 1
          },
          {
            "text": "нити ће бити орезан, нити ће бити окопан;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "нека сав зарасте у бодље и у трње;",
            "poem": 2
          },
          {
            "text": "и облацима ћу забранити",
            "poem": 1
          },
          {
            "text": "да над њим кишу пусте.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Наиме, виноград Господа над војскама",
            "poem": 1
          },
          {
            "text": "дом је Израиљев;",
            "poem": 2
          },
          {
            "text": "и људи Јудејци",
            "poem": 1
          },
          {
            "text": "засад су његов премили.",
            "poem": 2
          },
          {
            "text": "Надао се он праву, а ето крвопролића;",
            "poem": 1
          },
          {
            "text": "надао се праведности, а ето вапаја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Тешко онима…"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Тешко онима",
            "poem": 1
          },
          {
            "text": "који примичу кућу уз кућу, поље уз поље,",
            "poem": 2
          },
          {
            "text": "састављају док све место не заузму,",
            "poem": 1
          },
          {
            "text": "те да једини сред земље остану.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Ушима својим слушам Господа над војскама:",
          {
            "text": "„Баш ће куће многе опустети,",
            "poem": 1
          },
          {
            "text": "велике и лепе без житеља остати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Јер виноград од десет вата",
            "poem": 1
          },
          {
            "noteId": 1
          },
          {
            "text": "само ће бачвицу дати,",
            "poem": 1
          },
          {
            "text": "и засејана мера даће десети део.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Тешко онима који рано ране",
            "poem": 1
          },
          {
            "text": "да се опијају пићем жестоким,",
            "poem": 2
          },
          {
            "text": "настављају до расвитка",
            "poem": 1
          },
          {
            "text": "зато што их вино распаљује.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Харфе и лире,",
            "poem": 1
          },
          {
            "text": "бубњеви и фруле и вино на гозбама су њиховим;",
            "poem": 2
          },
          {
            "text": "а за дело Господње не маре,",
            "poem": 1
          },
          {
            "text": "и рад руку његових не гледају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Зато што знања нема,",
            "poem": 1
          },
          {
            "text": "народ мој ће у ропство одведен бити;",
            "poem": 2
          },
          {
            "text": "и славни његови ће од глади умирати,",
            "poem": 1
          },
          {
            "text": "и мноштво ће његово од жеђи горети.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Зато је Свет мртвих",
            "poem": 1
          },
          {
            "noteId": 2
          },
          {
            "text": "ждрело своје развалио,",
            "poem": 1
          },
          {
            "text": "и неизмерне раље разјапио",
            "poem": 2
          },
          {
            "text": "да се у њих стрмоглаве слава његова и мноштво његово",
            "poem": 1
          },
          {
            "text": "уз буку његову и вику његову.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "И човек ће се савијати,",
            "poem": 1
          },
          {
            "text": "и мужеван ће понижен бити,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и силници ће поглед оборити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Господ над војскама судом ће се узвисити,",
            "poem": 1
          },
          {
            "text": "и Бог свети светост ће правдом доказати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Јагањци ће као на пашњацима пасти,",
            "poem": 1
          },
          {
            "text": "и јарци ће по богаташким рушевинама брстити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Тешко онима који на себе",
            "poem": 1
          },
          {
            "text": "кривицу навлаче ужима варалачким",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и опакост конопцима колским –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "онима који говоре: „Нека пожури,",
            "poem": 1
          },
          {
            "text": "нека похита са оним што чини,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "па да видимо.",
            "poem": 2
          },
          {
            "text": "Нека се приближи и нека дође Светитељ Израиљев",
            "poem": 1
          },
          {
            "text": "са оним што је наумио,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "па да знамо!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Тешко онима који зло добрим називају,",
            "poem": 1
          },
          {
            "text": "а добро злим;",
            "poem": 2
          },
          {
            "text": "таму као светлост представљају,",
            "poem": 1
          },
          {
            "text": "а светлост као таму;",
            "poem": 2
          },
          {
            "text": "горко као слатко представљају,",
            "poem": 1
          },
          {
            "text": "а слатко као горко!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Тешко онима који у својим очима су мудри",
            "poem": 1
          },
          {
            "text": "и сами пред собом паметни!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Тешко онима који су у вину силни,",
            "poem": 1
          },
          {
            "text": "и у мешању жестоких пића храбри;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "који за мито кривца оправдавају,",
            "poem": 1
          },
          {
            "text": "и праведничку праведност потискују.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Зато, као што пламени језици стрњику прождиру,",
            "poem": 1
          },
          {
            "text": "и као што ватра сено прогута,",
            "poem": 2
          },
          {
            "text": "тако ће корен њихов иструнути,",
            "poem": 1
          },
          {
            "text": "као прах ће се пупољак њихов разлетети;",
            "poem": 2
          },
          {
            "text": "зато што одбацише Закон Господа над војскама",
            "poem": 1
          },
          {
            "text": "и презреше реч Светитеља Израиљева.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Гнев Господњи"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Зато се распалио гнев Господњи против његовог народа,",
            "poem": 1
          },
          {
            "text": "те он на њега подиже руку своју и тако га удари",
            "poem": 2
          },
          {
            "text": "да се потресоше планине;",
            "poem": 1
          },
          {
            "text": "па телеса њихова леже као смеће посред улица.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ипак, гнев се његов још не смирује,",
            "poem": 1
          },
          {
            "text": "још је испружена рука његова.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Надиру Асирци"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Он подиже ратну заставу народима издалека;",
            "poem": 1
          },
          {
            "text": "и он им зазвижди до краја земље;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и гле, брзом хитрином они долазе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Међу њима нема ни уморна, ни сустала,",
            "poem": 1
          },
          {
            "text": "ни дремљива, ни поспана;",
            "poem": 2
          },
          {
            "text": "ни да им се појас око струка распасује,",
            "poem": 1
          },
          {
            "text": "ни да им се ремен на сандали дреши.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Њихове су стреле добро зашиљене;",
            "poem": 1
          },
          {
            "text": "њихови су лукови сви запети;",
            "poem": 2
          },
          {
            "text": "њихових коња копита су као кремен;",
            "poem": 1
          },
          {
            "text": "њихови су точкови као вихор.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Њихова је рика као у лава,",
            "poem": 1
          },
          {
            "text": "они ричу као млада звер,",
            "poem": 2
          },
          {
            "text": "и реже, и плене, и односе,",
            "poem": 1
          },
          {
            "text": "и нико их не спречава.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "И режаће на њега у дан онај",
            "poem": 1
          },
          {
            "text": "као море када режи.",
            "poem": 2
          },
          {
            "text": "Погледа ли неко на земљу,",
            "poem": 1
          },
          {
            "text": "гле, тама је и тескоба,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и светлост замрачена облацима њеним.",
            "poem": 2
          }
        ]
      }
    ],
