  },
  "chapter": {
    "number": 64,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "О, разведри небеса и сиђи,",
            "poem": 1
          },
          {
            "text": "нека се пред тобом планине затресу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Као кад се ватра по грању запали,",
            "poem": 1
          },
          {
            "text": "ватра закува воду:",
            "poem": 2
          },
          {
            "text": "нека душмани твоји схвате име твоје,",
            "poem": 1
          },
          {
            "text": "нека пуци задрхћу пред тобом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Што ти чиниш то застрашује;",
            "poem": 1
          },
          {
            "text": "неочекивано си сишао,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "пред тобом се затресле планине.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Од како је века нису чули,",
            "poem": 1
          },
          {
            "text": "нису слушали, око није видело,",
            "poem": 2
          },
          {
            "text": "да бог неки осим тебе учини",
            "poem": 1
          },
          {
            "text": "онима који од њега очекују.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Сусретљив ти си према раздраганима који чине правду,",
            "poem": 1
          },
          {
            "text": "на путевима твојим сећају се тебе.",
            "poem": 2
          },
          {
            "text": "Гле, ти си се разљутио,",
            "poem": 1
          },
          {
            "text": "грешили смо на њима,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а били бисмо спасени.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "И постали смо сви ми као нешто нечисто,",
            "poem": 1
          },
          {
            "text": "и као огртач са женским одливом све су праведности наше,",
            "poem": 2
          },
          {
            "text": "и сви смо ми као лишће кад опадне,",
            "poem": 1
          },
          {
            "text": "и кривице наше као ветар нас однесу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "И никог нема да призива име твоје,",
            "poem": 1
          },
          {
            "text": "да се подигне и на тебе ослони,",
            "poem": 2
          },
          {
            "text": "зато што си лице своје од нас сакрио",
            "poem": 1
          },
          {
            "text": "и растапаш нас кривицама нашим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Па ипак, Господе, ти си Отац наш;",
            "poem": 1
          },
          {
            "text": "ми смо глина, а ти нас обликујеш,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и сви смо ми руке твоје дело.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Не срди се, Господе, исувише,",
            "poem": 1
          },
          {
            "text": "и немој стално помињати недело.",
            "poem": 2
          },
          {
            "text": "Ево, погледај нас:",
            "poem": 1
          },
          {
            "text": "сви смо ми народ твој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Опустели су свети градови твоји,",
            "poem": 1
          },
          {
            "text": "Сион је опустео, Јерусалим је опустошен.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Храм, светиња наша и понос наш;",
            "poem": 1
          },
          {
            "text": "у чему су те хвалили преци наши,",
            "poem": 2
          },
          {
            "text": "постао је згариште",
            "poem": 1
          },
          {
            "text": "и све драгоцености наше су сатрте.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Зар ћеш ово мирно гледати, Господе?",
            "poem": 1
          },
          {
            "text": "Ћутаћеш и још више понижавати?",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
