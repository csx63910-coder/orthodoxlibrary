  "chapter": {
    "number": 33,
    "content": [
      {
        "type": "heading",
        "content": [
          "Нада у Господа"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Тешко теби,",
            "poem": 1
          },
          {
            "text": "разараш, а ниси разорен,",
            "poem": 2
          },
          {
            "text": "и издајник си,",
            "poem": 1
          },
          {
            "text": "а тебе нису издали.",
            "poem": 2
          },
          {
            "text": "Кад престанеш да разараш,",
            "poem": 1
          },
          {
            "text": "ти ћеш бити разорен;",
            "poem": 2
          },
          {
            "text": "кад завршиш са издајништвом,",
            "poem": 1
          },
          {
            "text": "тебе ће издати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Господе, смилуј се нама,",
            "poem": 1
          },
          {
            "text": "ти си наша нада.",
            "poem": 2
          },
          {
            "text": "Буди њихова мишица јутрима,",
            "poem": 1
          },
          {
            "text": "и наше спасење у време невоље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Народи су побегли пред гомилом која тутњи,",
            "poem": 1
          },
          {
            "text": "пуци су се распршили пред узвишеношћу твојом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "И ваш плен се сакупља, сакупљају се гусенице,",
            "poem": 1
          },
          {
            "text": "као што скакавци тумарају, тако он оптрчава око њега.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Господ је узвишен зато што на висини станује,",
            "poem": 1
          },
          {
            "text": "и напунио је Сион правом и праведношћу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "И твоја безбедна времена",
            "poem": 1
          },
          {
            "text": "биће спасено богатство, мудрост и знање.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Његова је ризница богобојазност.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Господ ће доћи"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Гле, делије кукају напољу,",
            "poem": 1
          },
          {
            "text": "гласници за мир заплакаће горко.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Опустели су друмови,",
            "poem": 1
          },
          {
            "text": "престали су да путују путници.",
            "poem": 2
          },
          {
            "text": "Савез је раскинуо,",
            "poem": 1
          },
          {
            "text": "градове одбацио,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "човека не поштује.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Тугује, клоне земља;",
            "poem": 1
          },
          {
            "text": "Ливан је постиђен и вене,",
            "poem": 2
          },
          {
            "text": "Сарон је постао као пустара,",
            "poem": 1
          },
          {
            "text": "Васан и Кармил су без лишћа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "„Сад ћу устати – говори Господ.",
            "poem": 1
          },
          {
            "text": "Сад ћу бити узвишен.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Сад ћу бити подигнут.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Засејали сте сено,",
            "poem": 1
          },
          {
            "text": "родићете стрњику.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Прождреће вас ваш огњени дах.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "И биће народи као пећи за креч,",
            "poem": 1
          },
          {
            "text": "трње посечено у ватри ће изгорети.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ви, који сте далеко, чујте шта сам учинио;",
            "poem": 1
          },
          {
            "text": "а ви, који сте близу, упознајте силу моју:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "стрепе на Сиону грешници,",
            "poem": 1
          },
          {
            "text": "ужас спопада проклетнике.",
            "poem": 2
          },
          {
            "text": "’Ко од нас ће опстати пред ватром што прождире?",
            "poem": 1
          },
          {
            "text": "Ко од нас ће опстати пред пожаром вечним?’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Онај који живи праведно",
            "poem": 1
          },
          {
            "text": "и који говори честито,",
            "poem": 2
          },
          {
            "text": "презире зарађено на насиљу,",
            "poem": 1
          },
          {
            "text": "стреса мито са својих дланова,",
            "poem": 2
          },
          {
            "text": "одбија да послуша за крвопролиће,",
            "poem": 1
          },
          {
            "text": "и неће да гледа да се чини зло.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Тај ће становати на висинама,",
            "poem": 1
          },
          {
            "text": "заклон ће му бити тврђаве на стенама,",
            "poem": 2
          },
          {
            "text": "храну ће добијати редовно",
            "poem": 1
          },
          {
            "text": "и вода ће му бити обезбеђена.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Будућност у слави"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Очи твоје гледаће цара у лепоти његовој,",
            "poem": 1
          },
          {
            "text": "посматраће земљу области далеких.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Срце ће твоје разматрати ужас:",
            "poem": 1
          },
          {
            "text": "’Где је онај што броји?",
            "poem": 2
          },
          {
            "text": "Где је онај што мери?",
            "poem": 1
          },
          {
            "text": "Где је онај што куле броји?’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Нећеш видети народа жестоког,",
            "poem": 1
          },
          {
            "text": "народа чији се говор тешко слуша,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "језика страног што га нико не разуме.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Погледај Сион, град празника наших.",
            "poem": 1
          },
          {
            "text": "Очи ће твоје Јерусалим видети,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "боравиште заштићено, шатор неуздрмани,",
            "poem": 2
          },
          {
            "text": "чији се стубићи не ваде никада,",
            "poem": 1
          },
          {
            "text": "а ниједно уже његово неће се откинути.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Та онда ћемо имати достојанственог Господа,",
            "poem": 1
          },
          {
            "text": "уместо река, рукаваца широких са обе стране.",
            "poem": 2
          },
          {
            "text": "Неће њиме пролазити лађа на весла,",
            "poem": 1
          },
          {
            "text": "нити ће продрети заповеднички брод.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Јер: наш судија је Господ,",
            "poem": 1
          },
          {
            "text": "наш законодавац је Господ,",
            "poem": 2
          },
          {
            "text": "наш цар је Господ,",
            "poem": 1
          },
          {
            "text": "он ће нас спасти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Твоја ужад су попустила,",
            "poem": 1
          },
          {
            "text": "своје катарке не могу држати,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "нити једра подизати –",
            "poem": 2
          },
          {
            "text": "па се дели многи плен од пљачке;",
            "poem": 1
          },
          {
            "text": "кљасти ће отимати отимачину,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "и ниједан становник неће рећи: „Болестан сам.“",
            "poem": 1
          },
          {
            "text": "Народу који борави у њему кривица ће опроштена бити.",
            "poem": 2
          }
        ]
      }
    ],
