  },
  "chapter": {
    "number": 65,
    "content": [
      {
        "type": "heading",
        "content": [
          "Против идола, а за Јерусалим"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "„Потражили су ме који нису питали,",
            "poem": 1
          },
          {
            "text": "нашли су ме који нису искали.",
            "poem": 2
          },
          {
            "text": "Рекао сам: ’Ево ме! Ево ме!’",
            "poem": 1
          },
          {
            "text": "пуку који моје име призивао није.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Руке своје пружао сам ваздан",
            "poem": 1
          },
          {
            "text": "према народу одметничком,",
            "poem": 2
          },
          {
            "text": "који путем неваљаним хода",
            "poem": 1
          },
          {
            "text": "по својим замислима;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "народу који ме у лице",
            "poem": 1
          },
          {
            "text": "изазива стално,",
            "poem": 2
          },
          {
            "text": "жртве приносе по вртовима",
            "poem": 1
          },
          {
            "text": "и каде на опекама,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "бораве по гробовима,",
            "poem": 1
          },
          {
            "text": "ноћ проводе по скривеним местима,",
            "poem": 2
          },
          {
            "text": "једу месо свињско",
            "poem": 1
          },
          {
            "text": "и дробе гадости у зделе своје;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "који говоре: ’Себе се држи!",
            "poem": 1
          },
          {
            "text": "Не приступај мени, јер сам од тебе светији.’",
            "poem": 2
          },
          {
            "text": "Ови су дим у носу мом,",
            "poem": 1
          },
          {
            "text": "ватра што поваздан гори.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ево, записано је преда мном,",
            "poem": 1
          },
          {
            "text": "нећу ућутати док не намирим,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а намирићу у недра њихова.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Кривице ваше и кривице отаца ваших,",
            "poem": 1
          },
          {
            "text": "заједно су – говори Господ –",
            "poem": 2
          },
          {
            "text": "јер они каде по горама",
            "poem": 1
          },
          {
            "text": "и руже ме по узвишицама.",
            "poem": 2
          },
          {
            "text": "И некадашње дело њихово",
            "poem": 1
          },
          {
            "text": "одмерићу у недра њихова.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Говори Господ:",
          {
            "text": "„Као кад се стиче сок у грозду,",
            "poem": 1
          },
          {
            "text": "па се каже: ’Не затири га.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "У њему је благослов’,",
            "poem": 2
          },
          {
            "text": "тако ћу учинити ради својих слугу:",
            "poem": 1
          },
          {
            "text": "нећу све то затрти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "И извешћу из Јакова потомство,",
            "poem": 1
          },
          {
            "text": "и из Јуде мојих гора поседника,",
            "poem": 2
          },
          {
            "text": "и то ће изабраници моји баштинити,",
            "poem": 1
          },
          {
            "text": "и слуге моје тамо ће се настанити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "И Сарон ће постати за овце пландиште,",
            "poem": 1
          },
          {
            "text": "и долина Ахор",
            "poem": 2
          },
          {
            "noteId": 15
          },
          {
            "text": "за говеда почивалиште –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "народу мојем који мене тражи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "А ви, који сте Господа оставили,",
            "poem": 1
          },
          {
            "text": "који сте свету гору моју заборавили,",
            "poem": 2
          },
          {
            "text": "који Гаду",
            "poem": 1
          },
          {
            "noteId": 16
          },
          {
            "text": "трпезу постављате,",
            "poem": 1
          },
          {
            "text": "и који наливе изливате на олтар Менију",
            "poem": 2
          },
          {
            "noteId": 17
          },
          {
            "text": "–",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "за вас одредио сам мач",
            "poem": 1
          },
          {
            "text": "и да се сви савијете ради клања.",
            "poem": 2
          },
          {
            "text": "Зато што сам звао и одговорили нисте,",
            "poem": 1
          },
          {
            "text": "што сам говорио и слушали нисте.",
            "poem": 2
          },
          {
            "text": "Него сте чинили оно што ја сматрам да је зло,",
            "poem": 1
          },
          {
            "text": "изабрали сте оно што ми није угодно.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Зато говори Господар Господ:",
          {
            "text": "„Ево, слуге моје ће јести,",
            "poem": 1
          },
          {
            "text": "а ви ћете гладовати.",
            "poem": 2
          },
          {
            "text": "Ево, слуге моје ће пити,",
            "poem": 1
          },
          {
            "text": "а ви ћете жедни бити.",
            "poem": 2
          },
          {
            "text": "Ево, слуге моје ће се радовати,",
            "poem": 1
          },
          {
            "text": "а ви ћете се стидети.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ево, слуге моје ће се веселити",
            "poem": 1
          },
          {
            "text": "због добра у срцу,",
            "poem": 2
          },
          {
            "text": "а ви ћете викати",
            "poem": 1
          },
          {
            "text": "због бола у срцу,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и туговаћете због сломљеног духа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "И оставићете име своје",
            "poem": 1
          },
          {
            "text": "да њим куну моји изабраници:",
            "poem": 2
          },
          {
            "text": "и нека те усмрти Господар Господ!",
            "poem": 1
          },
          {
            "text": "А слуге ћу своје другим именом назвати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Широм земље ко се буде благосиљао,",
            "poem": 1
          },
          {
            "text": "нека се благосиља Богом верним.",
            "poem": 2
          },
          {
            "text": "И ко се буде заклињао широм земље,",
            "poem": 1
          },
          {
            "text": "нека се заклиње Богом верним.",
            "poem": 2
          },
          {
            "text": "Наиме, пређашње невоље ће бити заборављене,",
            "poem": 1
          },
          {
            "text": "и зато ће бити од очију мојих сакривене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Нова небеса и нова земља"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Јер, гле, ја стварам",
            "poem": 1
          },
          {
            "text": "небеса нова и земљу нову,",
            "poem": 2
          },
          {
            "text": "и пређашње се помињати неће,",
            "poem": 1
          },
          {
            "text": "и на ум вам то падати неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Стога веселите се и кличите",
            "poem": 1
          },
          {
            "text": "од колена до колена за оно што стварам.",
            "poem": 2
          },
          {
            "text": "А ево, ја стварам од Јерусалима клицање",
            "poem": 1
          },
          {
            "text": "и од народа његова весеље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "И клицаће у Јерусалиму,",
            "poem": 1
          },
          {
            "text": "и веселиће се у мом народу;",
            "poem": 2
          },
          {
            "text": "и више у њему чути се неће",
            "poem": 1
          },
          {
            "text": "глас који оплакује и глас који вапи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Тамо више неће бити",
            "poem": 1
          },
          {
            "text": "одојчета краткога живота,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ни старца који не би навршио дане своје,",
            "poem": 2
          },
          {
            "text": "јер ће младић као стогодишњак умирати,",
            "poem": 1
          },
          {
            "text": "и стогодишњи грешник",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "проклетим ће се сматрати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "И куће ће градити и настањивати,",
            "poem": 1
          },
          {
            "text": "и винограде садити и род њихов јести.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Неће једни градити, а други настањивати;",
            "poem": 1
          },
          {
            "text": "неће једни садити, а други јести.",
            "poem": 2
          },
          {
            "text": "Него ће као трајање дрвета",
            "poem": 1
          },
          {
            "text": "бити трајање народа мојега,",
            "poem": 2
          },
          {
            "text": "а дела својих руку",
            "poem": 1
          },
          {
            "text": "користиће изабраници моји.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Неће се мучити напразно,",
            "poem": 1
          },
          {
            "text": "нити ће рађати за ужас,",
            "poem": 2
          },
          {
            "text": "јер они ће бити потомство благословених од Господа",
            "poem": 1
          },
          {
            "text": "и изданци њихови с њима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "И биће пре него што ће призвати,",
            "poem": 1
          },
          {
            "text": "а ја ћу им одговорити;",
            "poem": 2
          },
          {
            "text": "још док буду говорили,",
            "poem": 1
          },
          {
            "text": "ја ћу их услишити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Вук и јагње заједно ће се напасати,",
            "poem": 1
          },
          {
            "text": "и лав ће слично волу сламу јести,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а змији ће прашина бити за храну.",
            "poem": 2
          },
          {
            "text": "Они зло чинити неће, и потирати неће",
            "poem": 1
          },
          {
            "text": "нигде на светој гори мојој",
            "poem": 2
          },
          {
            "text": "– говори Господ.“",
            "poem": 3
          }
        ]
      }
    ],
