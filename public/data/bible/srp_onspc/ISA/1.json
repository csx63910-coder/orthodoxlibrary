    "lastChapterApiLink": "/api/srp_onspc/ISA/66.json",
    "totalNumberOfVerses": 1292
  },
  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Виђење Исаије сина Амоцова, што је за Јуду и Јерусалим видео у време Јудиних царева: Озије, Јотама, Ахаза и Језекије."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Неразумни и грешни народ"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Чујте, небеса! Слушај, земљо,",
            "poem": 1
          },
          {
            "text": "јер говори Господ:",
            "poem": 2
          },
          {
            "text": "„Синове сам васпитао и подигао,",
            "poem": 1
          },
          {
            "text": "а они се одметнуше од мене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Во познаје власника својега",
            "poem": 1
          },
          {
            "text": "и магарац јасле господара својега.",
            "poem": 2
          },
          {
            "text": "Израиљ не зна;",
            "poem": 1
          },
          {
            "text": "народ мој не разуме!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Јао, грешнога ли пука,",
            "poem": 1
          },
          {
            "text": "народа огрезлог у кривици,",
            "poem": 2
          },
          {
            "text": "потомака злочиначких,",
            "poem": 1
          },
          {
            "text": "синова покварењачких!",
            "poem": 2
          },
          {
            "text": "Господа су оставили;",
            "poem": 1
          },
          {
            "text": "Светитеља Израиљевог презрели,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "леђа му окренули.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Где још да ударим,",
            "poem": 1
          },
          {
            "text": "одметници тврдокорни?",
            "poem": 2
          },
          {
            "text": "Сва је глава болна",
            "poem": 1
          },
          {
            "text": "и све срце изнемогло;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "од пете до главе здравог места нема,",
            "poem": 1
          },
          {
            "text": "него су убоји и модрице и ране отворене;",
            "poem": 2
          },
          {
            "text": "очишћене нису,",
            "poem": 1
          },
          {
            "text": "у завојима нису,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "уљем заблажене нису.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Опустошена вам је земља,",
            "poem": 1
          },
          {
            "text": "огањ вам је градове попалио,",
            "poem": 2
          },
          {
            "text": "ваше њиве пред вама харају туђинци.",
            "poem": 1
          },
          {
            "text": "Пустош је као кад опустоше туђинци.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Остављена је ћерка сионска",
            "poem": 1
          },
          {
            "text": "као сеница у винограду,",
            "poem": 2
          },
          {
            "text": "као колиба у градини за краставце,",
            "poem": 1
          },
          {
            "text": "као град под опсадом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Да нам Господ над војскама",
            "poem": 1
          },
          {
            "text": "није оставио остатка,",
            "poem": 2
          },
          {
            "text": "као Содома били бисмо,",
            "poem": 1
          },
          {
            "text": "слични Гомори били бисмо.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Реч Господњу чујте,",
            "poem": 1
          },
          {
            "text": "главари содомски!",
            "poem": 2
          },
          {
            "text": "Закон Бога нашег послушајте,",
            "poem": 1
          },
          {
            "text": "народе гоморски!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "„Шта ли ће мени мноштво жртава ваших?",
            "poem": 1
          },
          {
            "text": "– говори Господ.",
            "poem": 2
          },
          {
            "text": "Сит сам овнујских свеспалница",
            "poem": 1
          },
          {
            "text": "и наслага лојних са телади гојних.",
            "poem": 2
          },
          {
            "text": "И крв од бикова и јагањаца и јараца",
            "poem": 1
          },
          {
            "text": "не мили се мени.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Кад долазите да ми се покажете,",
            "poem": 1
          },
          {
            "text": "ко то тражи од вас",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да по мојим предворјима трупкате?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Не умножавајте безвредне приносе,",
            "poem": 1
          },
          {
            "text": "кађење на које се гадим;",
            "poem": 2
          },
          {
            "text": "младине и суботе, сазивање сазива,",
            "poem": 1
          },
          {
            "text": "не подносим зле",
            "poem": 2
          },
          {
            "noteId": 0
          },
          {
            "text": "свечаности.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Младине ваше и празнике,",
            "poem": 1
          },
          {
            "text": "то мрзи душа моја,",
            "poem": 2
          },
          {
            "text": "то је терет за ме,",
            "poem": 1
          },
          {
            "text": "додија ми подносити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Кад за молитву ширите руке своје,",
            "poem": 1
          },
          {
            "text": "ја од вас одвраћам очи своје;",
            "poem": 2
          },
          {
            "text": "и кад продужујете молитву,",
            "poem": 1
          },
          {
            "text": "ја вас не слушам.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ваше су руке огрезле у крви.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Оперите себе, очистите себе.",
            "poem": 1
          },
          {
            "text": "Уклоните злоћу дела ваших испред очију мојих.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Престаните зло чинити,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "учите се добро чинити: тежите праву,",
            "poem": 1
          },
          {
            "text": "ублажите угњетавање,",
            "poem": 2
          },
          {
            "text": "дајте права сиротињи,",
            "poem": 1
          },
          {
            "text": "парничите се у корист удовице.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Затим дођите да расправљамо",
            "poem": 1
          },
          {
            "text": "– говори Господ –",
            "poem": 2
          },
          {
            "text": "буду ли греси ваши као скерлет,",
            "poem": 1
          },
          {
            "text": "постаће бели као снег;",
            "poem": 2
          },
          {
            "text": "буду ли црвени као пурпур,",
            "poem": 1
          },
          {
            "text": "постаће као вуна.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ако будете вољни и послушате,",
            "poem": 1
          },
          {
            "text": "добра земаљска јешћете.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "А ако одбаците и буните се,",
            "poem": 1
          },
          {
            "text": "мач ће вас прогутати",
            "poem": 2
          },
          {
            "text": "– јер уста Господња рекоше.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Тужбалица над Јерусалимом"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Како се претвори у блудницу",
            "poem": 1
          },
          {
            "text": "верна насеобина!",
            "poem": 2
          },
          {
            "text": "Била је пуна правичности,",
            "poem": 1
          },
          {
            "text": "у њој је боравила правда,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а сада су убице.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Твоје је сребро као згура постало.",
            "poem": 1
          },
          {
            "text": "Твоје пиће се разводнило.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Твоји главари су се одметнули,",
            "poem": 1
          },
          {
            "text": "с крадљивцима другови су постали.",
            "poem": 2
          },
          {
            "text": "Сваки се граби за мито",
            "poem": 1
          },
          {
            "text": "и хрли за поклонима.",
            "poem": 2
          },
          {
            "text": "Право сиротињи они ускраћују;",
            "poem": 1
          },
          {
            "text": "удовичина парница до њих не досеже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Зато говори Господар,",
            "poem": 1
          },
          {
            "text": "Господ над војскама, Силни Израиљев:",
            "poem": 2
          },
          {
            "text": "„Ах, кад се искалим на противницима",
            "poem": 1
          },
          {
            "text": "и кад се осветим непријатељима!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Кад руку на тебе испружим,",
            "poem": 1
          },
          {
            "text": "да лужином згуру твоју очистим,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да из тебе онечишћења уклоним.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Па ти судије опет поставим као некад,",
            "poem": 1
          },
          {
            "text": "саветнике као од давнина,",
            "poem": 2
          },
          {
            "text": "те да те прозову",
            "poem": 1
          },
          {
            "text": "’Град праведности’,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "’Верна насеобина.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Правда ће откупити Сион,",
            "poem": 1
          },
          {
            "text": "и праведност покајнике његове;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "а преступници и грешници заједно ће се скршити",
            "poem": 1
          },
          {
            "text": "и они који напуштају Господа погинуће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Против обожавања светог дрвета"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "„Због племенитог дрвећа ће се стидети,",
            "poem": 1
          },
          {
            "text": "зато што их славите;",
            "poem": 2
          },
          {
            "text": "и због лугова ћете се црвенети,",
            "poem": 1
          },
          {
            "text": "зато што сте их изабрали.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Ви ћете бити слични храсту,",
            "poem": 1
          },
          {
            "text": "с лишћем што се на њему суши.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Налик лугу у ком воде нема.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "И скривено благо ће бити као кучина,",
            "poem": 1
          },
          {
            "text": "и онај ко га начини као варница –",
            "poem": 2
          },
          {
            "text": "обоје ће заједно изгорети,",
            "poem": 1
          },
          {
            "text": "а нико неће гасити.“",
            "poem": 2
          }
        ]
      }
    ],
