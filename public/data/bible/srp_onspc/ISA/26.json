  "chapter": {
    "number": 26,
    "content": [
      {
        "type": "heading",
        "content": [
          "Песма победничка"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "У онај дан певаће се ова песма у земљи Јудиној:",
          {
            "text": "„Имамо тврд град,",
            "poem": 1
          },
          {
            "text": "он нам подиже спасење,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "зидове и бедеме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Отворите вратнице",
            "poem": 1
          },
          {
            "text": "да уђе пук праведни",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "који је доследно веран,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "чију ћеш сабраност засновану на теби",
            "poem": 1
          },
          {
            "text": "ти сабрати у миру,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "у миру зато што се у тебе узда.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Уздајте се у Господа довека,",
            "poem": 1
          },
          {
            "text": "јер у Господу, у Господу самом је вечна Стена;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "јер он обара оне који станују високо,",
            "poem": 1
          },
          {
            "text": "насеље уздигнуто он руши,",
            "poem": 2
          },
          {
            "text": "он га руши на земљу,",
            "poem": 1
          },
          {
            "text": "он га срозава у прашину.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Газиће га нога,",
            "poem": 1
          },
          {
            "text": "ноге убогих,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "кораци невољних.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Псалам о правди Божијој"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Стаза праведникова је честита",
            "poem": 1
          },
          {
            "text": "и праведников колосек ти равнаш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Да, на стази твојих пресуда,",
            "poem": 1
          },
          {
            "text": "Господе, ми те очекујемо,",
            "poem": 2
          },
          {
            "text": "и за именом твојим и за споменом твојим",
            "poem": 1
          },
          {
            "text": "жуди душа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Душа моја жуди ноћу,",
            "poem": 1
          },
          {
            "text": "да, дух мој у мени, тебе тражи,",
            "poem": 2
          },
          {
            "text": "јер кад ти пресудиш на земљи,",
            "poem": 1
          },
          {
            "text": "тад се правди уче становници света.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ако опаки добије наклоност,",
            "poem": 1
          },
          {
            "text": "ипак неће научити шта је праведност;",
            "poem": 2
          },
          {
            "text": "у земљи честитих он чини неправду",
            "poem": 1
          },
          {
            "text": "и не обазире се на величанство Господње.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Господе, рука твоја је подигнута,",
            "poem": 1
          },
          {
            "text": "ипак они не виде.",
            "poem": 2
          },
          {
            "text": "Дај да виде ревност твоју за твој народ,",
            "poem": 1
          },
          {
            "text": "па нек се постиде.",
            "poem": 2
          },
          {
            "text": "Пламен за непријатеље твоје",
            "poem": 1
          },
          {
            "text": "нека их прождере.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Господе, ти нам мир одређујеш,",
            "poem": 1
          },
          {
            "text": "јер си ти уредио сва дела наша.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Господе, Боже наш, управљали су нама",
            "poem": 1
          },
          {
            "text": "осим тебе други господари.",
            "poem": 2
          },
          {
            "text": "Теби јединоме,",
            "poem": 1
          },
          {
            "text": "твоје име помињемо.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Мртви неће оживети,",
            "poem": 1
          },
          {
            "text": "покојници неће устати,",
            "poem": 2
          },
          {
            "text": "јер ти си их походио и разорио,",
            "poem": 1
          },
          {
            "text": "и затро си сваку успомену на њих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Умножио си пук, Господе,",
            "poem": 1
          },
          {
            "text": "умножио си пук,",
            "poem": 2
          },
          {
            "text": "прославио си се,",
            "poem": 1
          },
          {
            "text": "проширио си земљи све границе њене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Господе, у невољи они су к теби дошли,",
            "poem": 1
          },
          {
            "text": "тиху молитву изливали",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "када си их карао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Као трудница пред порођајем,",
            "poem": 1
          },
          {
            "text": "грчи се, вришти у боловима,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "такви смо ми пред лицем твојим, Господе,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Затруднели смо,",
            "poem": 1
          },
          {
            "text": "грчимо се као да ветар порађамо,",
            "poem": 2
          },
          {
            "text": "нити смо земљи спасења донели,",
            "poem": 1
          },
          {
            "text": "нити се родише становници света.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Оживеће мртви твоји,",
            "poem": 1
          },
          {
            "text": "дићи ће се с мојим мртвим телом.",
            "poem": 2
          },
          {
            "text": "Пробудите се и певајте",
            "poem": 1
          },
          {
            "text": "који боравите у праху,",
            "poem": 2
          },
          {
            "text": "јер роса светлосна роса је твоја,",
            "poem": 1
          },
          {
            "text": "и земља покојника пород ће дати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Бог разоткрива покољ"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Хајде, народе мој, у одаје своје уђи,",
            "poem": 1
          },
          {
            "text": "и врата своја за собом затвори.",
            "poem": 2
          },
          {
            "text": "Сакриј се часком на трен,",
            "poem": 1
          },
          {
            "text": "док јарост не прође.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Јер, гле, Господ ће изаћи из места својега",
            "poem": 1
          },
          {
            "text": "да походи кривицу становника земаљских;",
            "poem": 2
          },
          {
            "text": "и откриће земља крв што је у њој,",
            "poem": 1
          },
          {
            "text": "и неће више покривати поклане који су у њој.",
            "poem": 2
          }
        ]
      }
    ],
