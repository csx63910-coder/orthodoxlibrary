  },
  "chapter": {
    "number": 43,
    "content": [
      {
        "type": "heading",
        "content": [
          "Ослобођење јеврејског народа"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Сада говори Господ,",
            "poem": 1
          },
          {
            "text": "који те је створио, Јакове,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "који те је начинио, Израиљу:",
            "poem": 2
          },
          {
            "text": "„Не бој се, јер ја сам те откупио,",
            "poem": 1
          },
          {
            "text": "по имену те позвао: ти си мој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Кад преко воде прелазиш,",
            "poem": 1
          },
          {
            "text": "ја сам с тобом;",
            "poem": 2
          },
          {
            "text": "преко река,",
            "poem": 1
          },
          {
            "text": "неће те преплавити.",
            "poem": 2
          },
          {
            "text": "Прођеш ли кроз ватру,",
            "poem": 1
          },
          {
            "text": "нећеш изгорети,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и пламен те опалити неће,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "јер ја сам Господ, Бог твој,",
            "poem": 1
          },
          {
            "text": "Израиљев Светитељ, твој Спаситељ.",
            "poem": 2
          },
          {
            "text": "Да тебе откупим, дајем Египат;",
            "poem": 1
          },
          {
            "text": "уместо тебе дајем Куш и Севу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Јер ти си драгоцен у мојим очима,",
            "poem": 1
          },
          {
            "text": "цењен си и ја те волим.",
            "poem": 2
          },
          {
            "text": "Зато и дајем човека уместо тебе,",
            "poem": 1
          },
          {
            "text": "и народе трампим за живот твој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Не бој се, јер ја сам с тобом.",
            "poem": 1
          },
          {
            "text": "Са истока ћу потомство твоје довести,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и са запада ћу те сакупити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Рећи ћу северу: ’Дај ми!’",
            "poem": 1
          },
          {
            "text": "и југу: ’Не задржавај га!’",
            "poem": 2
          },
          {
            "text": "Синове моје доведи издалека,",
            "poem": 1
          },
          {
            "text": "и ћерке моје с краја земље,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "сваког ко се именом мојим зове,",
            "poem": 1
          },
          {
            "text": "и кога сам на славу своју створио,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "замислио га, па га начинио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Господ је једини Бог"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Изведи народ слеп, премда има очи,",
            "poem": 1
          },
          {
            "text": "и глув, премда има уши.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Нека се заједно саберу сва племена,",
            "poem": 1
          },
          {
            "text": "и нека се сакупе народи.",
            "poem": 2
          },
          {
            "text": "Је ли ко од њих ово најавио,",
            "poem": 1
          },
          {
            "text": "и од давнина нам предсказао?",
            "poem": 2
          },
          {
            "text": "Нек доведу своје сведоке и оправдају се.",
            "poem": 1
          },
          {
            "text": "Нека се чује, па нек кажу: ’Истина је!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ви сте сведоци моји – говори Господ –",
            "poem": 1
          },
          {
            "text": "и слуге моје које сам изабрао,",
            "poem": 2
          },
          {
            "text": "да бисте знали и мени веровали,",
            "poem": 1
          },
          {
            "text": "и схватили да сам то ја.",
            "poem": 2
          },
          {
            "text": "Пре мене ниједан бог саздан не би,",
            "poem": 1
          },
          {
            "text": "а неће ни после мене бити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ја, ја сам Господ,",
            "poem": 1
          },
          {
            "text": "осим мене спаситеља нема.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ја сам најавио и спасао и предсказао,",
            "poem": 1
          },
          {
            "text": "и међу вама туђинаца нема!",
            "poem": 2
          },
          {
            "text": "А ви сте сведоци моји – говори Господ –",
            "poem": 1
          },
          {
            "text": "и ја сам Бог.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Од вечности ја то јесам,",
            "poem": 1
          },
          {
            "text": "и нико из моје руке избавити неће.",
            "poem": 2
          },
          {
            "text": "Учинићу, а ко ће изменити?“",
            "poem": 1
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Бог ће уништити Вавилон"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Говори Господ,",
            "poem": 1
          },
          {
            "text": "ваш Откупитељ, Израиљев Светитељ:",
            "poem": 2
          },
          {
            "text": "„Вас ради послао сам према Вавилону,",
            "poem": 1
          },
          {
            "text": "и оборићу бегунце, све њих;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а Халдејци ће клицати у лађама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ја сам Господ, ваш Светитељ,",
            "poem": 1
          },
          {
            "text": "Израиљев створитељ, ваш цар!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Нови излазак"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Говори Господ,",
            "poem": 1
          },
          {
            "text": "који начини пут по мору,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и по водама силним пролаз,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "који је извео бојна кола и коње,",
            "poem": 1
          },
          {
            "text": "војску и јунаке заједно,",
            "poem": 2
          },
          {
            "text": "и они падоше да више не устану,",
            "poem": 1
          },
          {
            "text": "згаснуше, као фитиљ утрнуше:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "„Не спомињите оно што је давнашње,",
            "poem": 1
          },
          {
            "text": "не мислите на оно што је застарело.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ево, чиним нешто ново;",
            "poem": 1
          },
          {
            "text": "већ настаје, зар не опажате?",
            "poem": 2
          },
          {
            "text": "Да, направићу пут у пустињи,",
            "poem": 1
          },
          {
            "text": "и реке у пустоши.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Славиће ме звери пољске,",
            "poem": 1
          },
          {
            "text": "шакали и нојеви млади,",
            "poem": 2
          },
          {
            "text": "јер сам дао воду у пустињи,",
            "poem": 1
          },
          {
            "text": "реке у пустари,",
            "poem": 2
          },
          {
            "text": "да напојим свој народ,",
            "poem": 1
          },
          {
            "text": "изабраника својега.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Овај народ што сам га себи саздао,",
            "poem": 1
          },
          {
            "text": "казиваће мени похвалу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Незахвалност Божијег народа"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Али ти мене ниси призивао, Јакове;",
            "poem": 1
          },
          {
            "text": "досадио сам ти, Израиљу!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Ниси ми приносио овцу на свеспалницу,",
            "poem": 1
          },
          {
            "text": "ниси ме прослављао приносећи жртве;",
            "poem": 2
          },
          {
            "text": "а ја те нисам терао да приносиш приносе,",
            "poem": 1
          },
          {
            "text": "нити сам ти досађивао да ми кадиш;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "ниси ми за новац куповао мирисни штапић;",
            "poem": 1
          },
          {
            "text": "ниси ме ситио салом својих жртава;",
            "poem": 2
          },
          {
            "text": "него си ме оптерећивао својим гресима,",
            "poem": 1
          },
          {
            "text": "досађивао си ми својом кривицом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "А ја, ја сам тај,",
            "poem": 1
          },
          {
            "text": "себе ради бришем твоје преступе,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и не спомињем твоје грехе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Подсети ме,",
            "poem": 1
          },
          {
            "text": "спорићемо се заједно,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "сабери се да се оправдаш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Прво је сагрешио отац твој,",
            "poem": 1
          },
          {
            "text": "а од мене су се одметнули посредници твоји.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "И ја ћу оскрнавити главаре Светилишта,",
            "poem": 1
          },
          {
            "text": "те Јакова изручити проклетству,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а Израиља порузи.",
            "poem": 2
          }
        ]
      }
    ],
