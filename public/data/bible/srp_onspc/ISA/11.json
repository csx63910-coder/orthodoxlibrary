  "chapter": {
    "number": 11,
    "content": [
      {
        "type": "heading",
        "content": [
          "Долазак праведног цара"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Из пања Јесејева младица ће израсти,",
            "poem": 1
          },
          {
            "text": "из његова бокора Изданак ће плод донети.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "На њему ће почивати Дух Господњи,",
            "poem": 1
          },
          {
            "text": "Дух мудрости и разума,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Дух савета и јакости,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Дух знања и богобојазности.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Њега ће продахнути богобојазност:",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "те он неће судити према ономе што види,",
            "poem": 1
          },
          {
            "text": "нити ценити према ономе што чује,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "него ће он по правди судити, и понизнима на земљи",
            "poem": 1
          },
          {
            "text": "праведну процену изрицати;",
            "poem": 2
          },
          {
            "text": "шибом речи своје ошинуће земљу,",
            "poem": 1
          },
          {
            "text": "а дахом из уста убиће опакога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Он ће опасати бедра правдом,",
            "poem": 1
          },
          {
            "text": "и бокове ће повезати верношћу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Вук ће боравити с јагњетом",
            "poem": 1
          },
          {
            "text": "и рис ће лежати с јаретом,",
            "poem": 2
          },
          {
            "text": "теле и лав заједно ће пасти,",
            "poem": 1
          },
          {
            "text": "а дечак ће их водити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Крава и медведица ће се напасати,",
            "poem": 1
          },
          {
            "text": "и младунчад њихова заједно ће лежати;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "слично волу, и лав ће се сламом хранити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Изнад јаме гујине играће се одојче,",
            "poem": 1
          },
          {
            "text": "а детенце ће ручицу завлачити у легло змијино.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Зло се више неће чинити, нити ће бити насиља",
            "poem": 1
          },
          {
            "text": "на светој гори мојој,",
            "poem": 2
          },
          {
            "text": "јер ће се земља испунити познавањем Господа,",
            "poem": 1
          },
          {
            "text": "као што је водом испуњено море.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Повратак прогнаних сународника"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "У дан онај Јесејев корен ће се подићи као застава на народе, пуци ће тражити њега и одмориште његово биће славно."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "У онај дан Господар ће по други пут испружити руку да откупи остатак свог народа, оне што су преостали из Асирије и из Египта и из Патроса и из Куша и из Елама и из Сенара и из Амата и са обала морских."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Подићи ће заставу за пуке",
            "poem": 1
          },
          {
            "text": "и сабраће распршене Израиљце,",
            "poem": 2
          },
          {
            "text": "и сакупиће расељене Јудејце,",
            "poem": 1
          },
          {
            "text": "са земљина сва четири крила.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Завист племена Јефремова нестаће,",
            "poem": 1
          },
          {
            "text": "непријатељи Јуде истребљени биће:",
            "poem": 2
          },
          {
            "text": "Јефрем више Јуди завидети неће,",
            "poem": 1
          },
          {
            "text": "нити ће Јуда Јефрему непријатељ бити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Они ће за врат сести Филистејцима на западу;",
            "poem": 1
          },
          {
            "text": "они ће заједно пленити племена на истоку;",
            "poem": 2
          },
          {
            "text": "руком ће својом држати Едомце и Моавце;",
            "poem": 1
          },
          {
            "text": "њима ће бити послушни потомци Амонови.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Господ ће исушити",
            "poem": 1
          },
          {
            "text": "залив мора египатског,",
            "poem": 2
          },
          {
            "text": "руком ће замахнути против Еуфрата,",
            "poem": 1
          },
          {
            "text": "јаром ветра он ће њу разбити",
            "poem": 2
          },
          {
            "text": "на седам сувих токова,",
            "poem": 1
          },
          {
            "text": "те ће је људи прелазити у обући.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "И биће пут остатку народа његова,",
            "poem": 1
          },
          {
            "text": "преживелима из Асирије,",
            "poem": 2
          },
          {
            "text": "као што је био Израиљцима",
            "poem": 1
          },
          {
            "text": "кад су се подигли из земље египатске.",
            "poem": 2
          }
        ]
      }
    ],
