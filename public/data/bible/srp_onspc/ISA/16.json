  "chapter": {
    "number": 16,
    "content": [
      {
        "type": "heading",
        "content": [
          "Моавци беже у Јуду"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Шаљите јагње владару земље,",
            "poem": 1
          },
          {
            "text": "од Селе према пустињи,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "до горе ћерке сионске.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Слично птици отераној,",
            "poem": 1
          },
          {
            "text": "слично гнезду растуреном,",
            "poem": 2
          },
          {
            "text": "биће ћерке моавске",
            "poem": 1
          },
          {
            "text": "на газовима потока Арнона.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "„Дај нам савет!",
            "poem": 1
          },
          {
            "text": "Донеси пресуду!",
            "poem": 2
          },
          {
            "text": "Усред поднева сенку своју",
            "poem": 1
          },
          {
            "text": "као ноћ распростри.",
            "poem": 2
          },
          {
            "text": "Сакривај прогнанике!",
            "poem": 1
          },
          {
            "text": "Немој издати бегунце!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Пусти да к теби утекну прогнаници моавски.",
            "poem": 1
          },
          {
            "text": "Буди њихов заклон испред пустошника;",
            "poem": 2
          },
          {
            "text": "јер тлачитељ је скончао,",
            "poem": 1
          },
          {
            "text": "угњетач је нестао,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "пустошење је престало,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "газилац је са земље ишчезао.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "„И тад ће се учврстити престо у милости,",
            "poem": 1
          },
          {
            "text": "и на њему ће столовати у истини,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "у шатору Давидову,",
            "poem": 2
          },
          {
            "text": "судија који захтева праведност",
            "poem": 1
          },
          {
            "text": "и вешт је са правдом.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Тужбалица над Моавом"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Чули смо за моавску надменост,",
            "poem": 1
          },
          {
            "text": "гордост превелику;",
            "poem": 2
          },
          {
            "text": "за надменост њихову и охолост њихову.",
            "poem": 1
          },
          {
            "text": "Испразно је њихово хвалисање.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Тако нариче Моав,",
            "poem": 1
          },
          {
            "text": "сви наричу над Моавом,",
            "poem": 2
          },
          {
            "text": "за кољивом од грожђа из Кир-Ереса",
            "poem": 1
          },
          {
            "noteId": 5
          },
          {
            "text": "тугују сасвим сломљени.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Увенули су засади есевонски,",
            "poem": 1
          },
          {
            "text": "виногради сивамски,",
            "poem": 2
          },
          {
            "text": "господари над пуцима",
            "poem": 1
          },
          {
            "text": "потрше његове одабране лозице.",
            "poem": 2
          },
          {
            "text": "Допрли су до Јазира,",
            "poem": 1
          },
          {
            "text": "замицали у пустињу;",
            "poem": 2
          },
          {
            "text": "огранци су им досезали",
            "poem": 1
          },
          {
            "text": "да пређу море.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Зато плачем као што Јазир оплакује винограде сивамске,",
            "poem": 1
          },
          {
            "text": "натапам сузама Есевон и Елеалију;",
            "poem": 2
          },
          {
            "text": "јер над твојом бербом и над твојом жетвом",
            "poem": 1
          },
          {
            "text": "нестало је клицање,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "весеље и радост.",
            "poem": 1
          },
          {
            "text": "У виноградима нема цике,",
            "poem": 2
          },
          {
            "text": "не кличе се од радости;",
            "poem": 1
          },
          {
            "text": "газилац не гази грожђе у каци,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "затворио сам подвикивање.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Зато утроба моја за Моавом као харфа цвили,",
            "poem": 1
          },
          {
            "text": "и потресен сам за Кир-Ересом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "И биће да ће се видети:",
            "poem": 1
          },
          {
            "text": "на узвишицама умарају се Моавци,",
            "poem": 2
          },
          {
            "text": "и долазе на светилиште своје",
            "poem": 1
          },
          {
            "text": "да се моле, али то неће ићи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Реч за Моав"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ово је реч што је Господ некад рекао за Моав."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Сад, пак, Господ каже говорећи: „За три године, као три године најамничке, моавска ће слава потамнети са свим великим мноштвом, а оно мало остатка биће ситно и слабашно.“"
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 5,
        "caller": "+",
        "text": "16,7 Кир-Аресет према изворном тексту, што је највероватније исто место споменуто у ст. 11.",
        "reference": {
          "chapter": 16,
          "verse": 7
        }
      }
    ]
