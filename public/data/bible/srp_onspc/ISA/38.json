  "chapter": {
    "number": 38,
    "content": [
      {
        "type": "heading",
        "content": [
          "Језекијина болест и оздрављење"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "У оне дане се Језекија разболео на смрт. Пророк Исаија, син Амоцов, је дошао и рекао му: „Говори Господ: ’Уреди своју кућу, јер ћеш умрети; нећеш се опоравити.’“"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Језекија је окренуо своје лице према зиду, па се помолио Господу овако:"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "„О, Господе, сети се да сам пред тобом ходио верно и свим срцем, и да сам чинио што је добро у твојим очима.“ И Језекија горко заплака."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "И дође реч Господња Исаији говорећи:"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "„Иди и реци Језекији. Говори Господ, Бог твога претка Давида: ’Чуо сам твоју молитву и видео сам твоје сузе. Гле, додаћу твоме животу петнаест година,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "и избавићу те из руке асирског цара. Одбранићу овај град."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "И ово ће ти бити знак од Господа: Господ ће учинити ову ствар као што је рекао."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Гле, ја ћу вратити за десет црта сенку што је сишла по цртама Ахазова сунчаника.’“ Тада се сунце вратило за десет црта по цртама по којима је сишло."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Језекијина захвална песма"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Запис Језекије, цара Јудиног, када се разболео па оздравио од своје болести:"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ја сам говорио: „У средини мојих дана",
            "poem": 1
          },
          {
            "text": "ја одлазим пред вратнице Света мртвих,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "лишен остатка година мојих.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Говорио сам: „Више нећу гледати Господа,",
            "poem": 1
          },
          {
            "text": "Господа у земљи живих;",
            "poem": 2
          },
          {
            "text": "више нећу видети човека",
            "poem": 1
          },
          {
            "text": "са онима који станују у пролазности.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Мој век је одвојен и од мене отргнут",
            "poem": 1
          },
          {
            "text": "слично шатору пастирском,",
            "poem": 2
          },
          {
            "text": "слично ткачу пресекао је живот мој.",
            "poem": 1
          },
          {
            "text": "Докрајчићеш мене од дана до ноћи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Слично лаву примирио сам се до јутра,",
            "poem": 1
          },
          {
            "text": "тако он дроби све кости моје.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Докрајчићеш мене од дана до ноћи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Слично ласти узлетелој, тако цијучем;",
            "poem": 1
          },
          {
            "text": "слично ждралу изнемоглом, тако уздишем –",
            "poem": 2
          },
          {
            "text": "мој је поглед према висинама:",
            "poem": 1
          },
          {
            "text": "Господе, под теретом сам, буди мој јамац.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Шта да му кажем?",
            "poem": 1
          },
          {
            "text": "Он ми је рекао",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и он је тај који је у дело спровео.",
            "poem": 2
          },
          {
            "text": "Благо ћу провести све године своје,",
            "poem": 1
          },
          {
            "text": "мада ће ми остати горчина у души.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Господару, на њима они живе",
            "poem": 1
          },
          {
            "text": "и живот духа мог је за све у њима.",
            "poem": 2
          },
          {
            "text": "А ти ћеш ме излечити",
            "poem": 1
          },
          {
            "text": "и живот ми вратити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Гле, у здравље се претворило",
            "poem": 1
          },
          {
            "text": "што ми беше горко;",
            "poem": 2
          },
          {
            "text": "и ти си душу моју избавио",
            "poem": 1
          },
          {
            "text": "из погубне јаме,",
            "poem": 2
          },
          {
            "text": "тако што си у неповрат бацио",
            "poem": 1
          },
          {
            "text": "све што сам ја згрешио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Та, Свет мртвих тебе не хвали,",
            "poem": 1
          },
          {
            "text": "смрт тебе не слави;",
            "poem": 2
          },
          {
            "text": "они који су спуштени у раку",
            "poem": 1
          },
          {
            "text": "у тебе се не уздају због твоје истине.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Живи, живи,",
            "poem": 1
          },
          {
            "text": "он тебе хвали као ја данас.",
            "poem": 2
          },
          {
            "text": "Отац ће учити",
            "poem": 1
          },
          {
            "text": "синове истини твојој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Да ме спасеш, притеци, Господе,",
            "poem": 1
          },
          {
            "text": "и ми ћемо певати уз харфе,",
            "poem": 2
          },
          {
            "text": "у све дане живота својега",
            "poem": 1
          },
          {
            "text": "пред Домом Господњим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "А Исаија беше рекао: „Нека донесу облог од смокава и привију на чир и оздравиће.“"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "А Језекија рече: „Шта ће бити знак да ћу ићи горе у Дом Господњи?“"
        ]
      }
    ],
