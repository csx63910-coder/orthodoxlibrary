  "book": {
    "id": "ISA",
    "translationId": "srp_onspc",
    "name": "Књига пророка Исаије",
    "commonName": "Књига пророка Исаије",
    "title": "Књига пророка Исаије",
    "order": 23,
    "numberOfChapters": 66,
    "sha256": "65da7472046c4c4242da6b0395082ca741c36130fd8710e93ef455190b89026a",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/ISA/1.json",
    "lastChapterNumber": 66,
    "lastChapterApiLink": "/api/srp_onspc/ISA/66.json",
    "totalNumberOfVerses": 1292
  },
  "chapter": {
    "number": 40,
    "content": [
      {
        "type": "heading",
        "content": [
          "Утеха од Господа"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "„Тешите, тешите народ мој",
            "poem": 1
          },
          {
            "text": "– говори Бог ваш –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Говорите Јерусалиму срдачно,",
            "poem": 1
          },
          {
            "text": "и вичите му:",
            "poem": 2
          },
          {
            "text": "ратовање му је окончано,",
            "poem": 1
          },
          {
            "text": "кривица му окајана,",
            "poem": 2
          },
          {
            "text": "јер он из руке Господње прими",
            "poem": 1
          },
          {
            "text": "двапут више него што сагреши.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Глас виче:",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Пут Господњи",
            "poem": 1
          },
          {
            "text": "кроз пустињу приправите;",
            "poem": 2
          },
          {
            "text": "друм за Бога нашега",
            "poem": 1
          },
          {
            "text": "у пустоши поравнајте.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Свака долина нека се подигне,",
            "poem": 1
          },
          {
            "text": "а свака гора и брежуљак нека се спусти;",
            "poem": 2
          },
          {
            "text": "и што је стрмо нек буде равница,",
            "poem": 1
          },
          {
            "text": "и храпаво нека буде глатко.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Тада ће се открити слава Господња,",
            "poem": 1
          },
          {
            "text": "и сваки човек ће је видети –",
            "poem": 2
          },
          {
            "text": "јер су то казала уста Господња.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Глас рече: „Вичи!“",
            "poem": 1
          },
          {
            "text": "А он одговори: „Шта да вичем?“",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Свако је тело као трава,",
            "poem": 1
          },
          {
            "text": "и сва му је милина као цвет пољски.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Сахне трава, вене цвет,",
            "poem": 1
          },
          {
            "text": "кад преко њих Господњи пређе дах.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Заиста, народ је трава.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Сахне трава, вене цвет,",
            "poem": 1
          },
          {
            "text": "али реч Бога нашега остаје довека.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Бог најављује своју наклоност"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "На високу гору се успни,",
            "poem": 1
          },
          {
            "text": "Сионе, гласниче радосне вести.",
            "poem": 2
          },
          {
            "text": "Глас свој снажно подигни,",
            "poem": 1
          },
          {
            "text": "Јерусалиме, гласниче радосне вести.",
            "poem": 2
          },
          {
            "text": "Подигни га, не бој се,",
            "poem": 1
          },
          {
            "text": "кажи градовима Јудиним:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Ево Бога вашега!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ево, Господар Господ долази у сили,",
            "poem": 1
          },
          {
            "text": "влада он мишицом својом!",
            "poem": 2
          },
          {
            "text": "Ево, с њим је и плата од њега,",
            "poem": 1
          },
          {
            "text": "а испред њега награда од њега.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Као Пастир он своје стадо напаса,",
            "poem": 1
          },
          {
            "text": "у своје руке јагањце сабира,",
            "poem": 2
          },
          {
            "text": "у наручју своме их носи,",
            "poem": 1
          },
          {
            "text": "а дојилице негује.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Бог објављује своју славу"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ко је воде прегрштима измерио,",
            "poem": 1
          },
          {
            "text": "и небеса педљем премерио?",
            "poem": 2
          },
          {
            "text": "А ко је сав прах земаљски размерио мерицом,",
            "poem": 1
          },
          {
            "text": "и планине теговима,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и брегове теразијама?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Духа Господњег ко је премерио,",
            "poem": 1
          },
          {
            "text": "и који саветник је њега упутио?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "С ким се саветовао и изграђивао,",
            "poem": 1
          },
          {
            "text": "и ко га је стазама правде научио?",
            "poem": 2
          },
          {
            "text": "И научио га знању",
            "poem": 1
          },
          {
            "text": "и упознао га с путем разборитости?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Гле, народи су као кап из ведра,",
            "poem": 1
          },
          {
            "text": "и вреде као прах на теразијама.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Гле, острва као зрнце подиже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ни Ливан није довољан за ломачу,",
            "poem": 1
          },
          {
            "text": "а његових звери нема довољно за свеспалницу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Сви народи пред њим су као ништа,",
            "poem": 1
          },
          {
            "text": "ништавилом и празнином он их сматра.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Коме ћете Бога сличним учинити",
            "poem": 1
          },
          {
            "text": "и с каквим ћете га ликом упоредити?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ливац излива идола,",
            "poem": 1
          },
          {
            "text": "златар га позлатом облаже",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и од сребра ланчиће излива.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Сиромах за принос",
            "poem": 1
          },
          {
            "text": "дрво нетрулежно бира,",
            "poem": 2
          },
          {
            "text": "и за то вештог уметника тражи",
            "poem": 1
          },
          {
            "text": "да за њега кип непомични начини.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Зар не знате?",
            "poem": 1
          },
          {
            "text": "Зар нисте чули?",
            "poem": 2
          },
          {
            "text": "Зар вам није од искона објављено?",
            "poem": 1
          },
          {
            "text": "Зар нисте схватили од оснивања земље?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Над кругом земаљским он столује",
            "poem": 1
          },
          {
            "text": "и становници су њени на скакавце налик;",
            "poem": 2
          },
          {
            "text": "небеса је разастро као копрену,",
            "poem": 1
          },
          {
            "text": "разапео их као шатор за становање.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Он моћнике претвара у ништавило,",
            "poem": 1
          },
          {
            "text": "судије по земљи чини да су као ништа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Тек што су засађени,",
            "poem": 1
          },
          {
            "text": "тек што су посејани,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "тек што им стабљика у земљу корен пустила",
            "poem": 2
          },
          {
            "text": "– он на њих дуне, и они усахну,",
            "poem": 1
          },
          {
            "text": "као сламу вихор их развеје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "„Коме ћете мене сличним учинити?",
            "poem": 1
          },
          {
            "text": "Ко је као ја?“ – пита Светитељ.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Подигните поглед свој и гледајте:",
            "poem": 1
          },
          {
            "text": "Ко је ово створио?",
            "poem": 2
          },
          {
            "text": "Онај који на број војску небеску изводи,",
            "poem": 1
          },
          {
            "text": "и који по имену све њих прозива.",
            "poem": 2
          },
          {
            "text": "Због његове велике моћи и силне јачине",
            "poem": 1
          },
          {
            "text": "нико не изостаје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Божије свемоћно свезнање"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Зашто кажеш, Јакове,",
            "poem": 1
          },
          {
            "text": "и ти говориш, Израиљу:",
            "poem": 2
          },
          {
            "text": "„Мој пут је скривен Господу,",
            "poem": 1
          },
          {
            "text": "и моја правица измиче Богу мојем“?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Зар не знаш",
            "poem": 1
          },
          {
            "text": "и зар ниси чуо?",
            "poem": 2
          },
          {
            "text": "Господ је Бог вечни,",
            "poem": 1
          },
          {
            "text": "створитељ крајева земљиних.",
            "poem": 2
          },
          {
            "text": "Он се не умара и не сустаје,",
            "poem": 1
          },
          {
            "text": "и ум се његов не да ограничити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Он снагу уморноме даје,",
            "poem": 1
          },
          {
            "text": "и немоћноме моћ он јача.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Младићи се умарају и сустају,",
            "poem": 1
          },
          {
            "text": "и момци морају да посрћу,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "али онима који се у Господа уздају",
            "poem": 1
          },
          {
            "text": "снага се обнавља,",
            "poem": 2
          },
          {
            "text": "крила им расту као орловима,",
            "poem": 1
          },
          {
            "text": "трче и не сустају,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ходају и не умарају се.",
            "poem": 2
          }
        ]
      }
    ],
