  "chapter": {
    "number": 22,
    "content": [
      {
        "type": "heading",
        "content": [
          "Реч о долини виђења"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Пророштво о Долини виђења.",
          {
            "text": "Шта ти је сад,",
            "poem": 1
          },
          {
            "text": "те се пењеш сав на кровове?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Препун вреве, граде бучни,",
            "poem": 1
          },
          {
            "text": "шехеру разиграни!",
            "poem": 2
          },
          {
            "text": "Изгинули твоји од мача не падоше,",
            "poem": 1
          },
          {
            "text": "нити мртви твоји у боју.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Сви твоји владари заједно побегоше,",
            "poem": 1
          },
          {
            "text": "не затегоше лук, а падоше у ропство,",
            "poem": 2
          },
          {
            "text": "заробљени су сви који се нађоше у теби,",
            "poem": 1
          },
          {
            "text": "далеко су бежали.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Зато сам рекао: „Оставите ме,",
            "poem": 1
          },
          {
            "text": "горко ћу плакати;",
            "poem": 2
          },
          {
            "text": "немојте ме тешити",
            "poem": 1
          },
          {
            "text": "над рушевином милог народа мојега.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Јер је дан пометње и расула и збуњености",
            "poem": 1
          },
          {
            "text": "од Господара Господа над војскама.",
            "poem": 2
          },
          {
            "text": "У Долини виђења зид се руши,",
            "poem": 1
          },
          {
            "text": "према планини је вапај,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "јер Елам тоболац доноси,",
            "poem": 1
          },
          {
            "text": "са бојним колима и коњаницима,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а Кир штит открива.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Изабране долине твоје бојних кола су пуне.",
            "poem": 1
          },
          {
            "text": "Коњаници се код вратница постројавају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Против борбене готовости"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Тако је Јуди уклонио заштиту.",
            "poem": 1
          },
          {
            "text": "У дан онај поглед си сврнуо",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "на оружје у шумској кући.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "И пукотине у граду Давидову,",
            "poem": 1
          },
          {
            "text": "видели сте како их је много.",
            "poem": 2
          },
          {
            "text": "И сабрали сте воду",
            "poem": 1
          },
          {
            "text": "из Доњег језера.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Па сте пребројали куће јерусалимске",
            "poem": 1
          },
          {
            "text": "и порушили куће да зид учврстите;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "те сте између два зида начинили",
            "poem": 1
          },
          {
            "text": "спремиште за воду из Старог језера;",
            "poem": 2
          },
          {
            "text": "али се на Створитеља нисте обазирали,",
            "poem": 1
          },
          {
            "text": "нити сте видели оног што је све начинио одавно.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "И позвао је у дан онај",
            "poem": 1
          },
          {
            "text": "Господар Господ над војскама:",
            "poem": 2
          },
          {
            "text": "да плачете и тугујете,",
            "poem": 1
          },
          {
            "text": "да обријете главе и припашете кострет.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Али, гле, весеље и радост,",
            "poem": 1
          },
          {
            "text": "убијају говеда и кољу овце,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "једу месо и пију вино:",
            "poem": 2
          },
          {
            "text": "„Да једемо и пијемо,",
            "poem": 1
          },
          {
            "text": "јер сутра ћемо да помремо.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "А мојим ушима је објавио Господ над војскама: „Неће бити откупљена ваша кривица док не умрете – рече Господар Господ над војскама.“"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Против надстојника Сомне"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Говори Господар Господ над војскама:",
          {
            "text": "„Хајде, отиди оном дворанину,",
            "poem": 1
          },
          {
            "text": "Сомни, надстојнику двора:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "’Шта је с тобом и ко си то ти,",
            "poem": 1
          },
          {
            "text": "да овде гробницу клешеш себи?",
            "poem": 2
          },
          {
            "text": "Клеше себи гробницу на висини,",
            "poem": 1
          },
          {
            "text": "усеца у стени стан за себе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Гле, Господ ће тебе бацити силно,",
            "poem": 1
          },
          {
            "text": "јунак ће те ухватити снажно,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "у клупко ће те умотати жестоко,",
            "poem": 1
          },
          {
            "text": "као лопту ће те бацати по земљи широкој.",
            "poem": 2
          },
          {
            "text": "Тамо ћеш ти умрети,",
            "poem": 1
          },
          {
            "text": "и тамо су кола твоја славна,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "срамото двору господара твога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Лишићу те положаја твога,",
            "poem": 1
          },
          {
            "text": "и отераћу те из службе твоје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "А у тај дан ћу позвати слугу свога Елијакима сина Хелкијина."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Њега ћу обући у одору твоју, њега ћу опасати појасом твојим, њему ћу у руке предати власт твоју, те ће бити предак становницима јерусалимским и дому Јудином."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "На његова плећа поставићу кључ од дома Давидова: кад отвори, неће затворити нико, кад затвори, неће отворити нико."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Њега ћу као клин углавити на месту чврстоме, те ће постати славни престо у дому оца својега."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "О њега ће се обесити сва слава дома оца његова: изданци и потомци, све посуде малене, од зделица до свих крчага.’"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "У дан онај – говори Господ над војскама – извући ће се клин углављени на месту чврстоме, сломиће се и пашће; а терет што је на њему биће одсечен, јер је Господ рекао.“"
        ]
      }
    ],
