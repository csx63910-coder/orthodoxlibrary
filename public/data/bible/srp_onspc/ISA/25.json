  },
  "chapter": {
    "number": 25,
    "content": [
      {
        "type": "heading",
        "content": [
          "Молитва захвална"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Господе, ти си Бог мој,",
            "poem": 1
          },
          {
            "text": "узвисујем те, славим твоје име,",
            "poem": 2
          },
          {
            "text": "зато што си остварио дивоту,",
            "poem": 1
          },
          {
            "text": "од давнина смишљену верност верну,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "јер си град претворио у хрпу,",
            "poem": 1
          },
          {
            "text": "насеље утврђено у рушевину;",
            "poem": 2
          },
          {
            "text": "тврђава туђинаца више није град –",
            "poem": 1
          },
          {
            "text": "довека се обновити неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Тебе зато народ снажни слави,",
            "poem": 1
          },
          {
            "text": "од тебе се боји град свирепих племена,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "а ти си уточиште сиротом,",
            "poem": 1
          },
          {
            "text": "уточиште убогом у невољи његовој;",
            "poem": 2
          },
          {
            "text": "ти си склониште од непогоде,",
            "poem": 1
          },
          {
            "text": "заклон од жеге,",
            "poem": 2
          },
          {
            "text": "јер ћуд је свирепих",
            "poem": 1
          },
          {
            "text": "као непогода са стране;",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "као жега над сушним тлом,",
            "poem": 2
          },
          {
            "text": "ти гушиш грају одвратних,",
            "poem": 1
          },
          {
            "text": "као жегу сенком облака",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "свирепима се прекинуло певање.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Месијанска свечаност"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "А Господ над војскама спремиће на овој гори",
            "poem": 1
          },
          {
            "text": "гозбу од сала за све народе,",
            "poem": 2
          },
          {
            "text": "гозбу од сала, гозбу од вина,",
            "poem": 1
          },
          {
            "text": "од вина одлежалог, од мождине масне,",
            "poem": 2
          },
          {
            "text": "од пречишћеног вина одлежалог.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "И на овој гори он ће здерати",
            "poem": 1
          },
          {
            "text": "застор што све народе застире",
            "poem": 2
          },
          {
            "text": "и копрену што све пуке обавија.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Он ће смрт победоносно здерати,",
            "poem": 2
          },
          {
            "text": "и Господар Господ ће сузу отрти",
            "poem": 1
          },
          {
            "text": "са лица свакога,",
            "poem": 2
          },
          {
            "text": "и срамоту ће скинути",
            "poem": 1
          },
          {
            "text": "са свог народа по свој земљи –",
            "poem": 2
          },
          {
            "text": "зато што је Господ рекао.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "И говориће се у дан онај:",
          {
            "text": "„Гле, ово је Бог наш.",
            "poem": 1
          },
          {
            "text": "Њега смо очекивали и он нас је спасао.",
            "poem": 2
          },
          {
            "text": "Ово је Господ ког смо очекивали;",
            "poem": 1
          },
          {
            "text": "кличимо и радујмо се, јер он спасава.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Јер рука Господња почива на гори овој,",
            "poem": 1
          },
          {
            "text": "и Моав ће бити изгажен под њим",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "као што се слама у ђубришту гази.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "И шириће руке своје посред њега",
            "poem": 1
          },
          {
            "text": "као што шири пливач када плива.",
            "poem": 2
          },
          {
            "text": "И понизиће његов понос",
            "poem": 1
          },
          {
            "text": "вештином руку његових.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "И обориће на високој тврђави твоје зидове,",
            "poem": 1
          },
          {
            "text": "и обориће их на земљу,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "понизиће их, бациће их у прашину.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
