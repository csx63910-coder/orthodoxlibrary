  "book": {
    "id": "ISA",
    "translationId": "srp_onspc",
    "name": "Књига пророка Исаије",
    "commonName": "Књига пророка Исаије",
    "title": "Књига пророка Исаије",
    "order": 23,
    "numberOfChapters": 66,
    "sha256": "65da7472046c4c4242da6b0395082ca741c36130fd8710e93ef455190b89026a",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/ISA/1.json",
    "lastChapterNumber": 66,
    "lastChapterApiLink": "/api/srp_onspc/ISA/66.json",
    "totalNumberOfVerses": 1292
  },
  "chapter": {
    "number": 28,
    "content": [
      {
        "type": "heading",
        "content": [
          "Опомена недостојнима и непослушнима"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Тешко гордоме венцу пијаница Јефремових,",
            "poem": 1
          },
          {
            "text": "и цвету увеломе, блештавој славности његовој,",
            "poem": 2
          },
          {
            "text": "који су се удебљали,",
            "poem": 1
          },
          {
            "text": "вином опили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ево, Господар има јачину и моћ,",
            "poem": 1
          },
          {
            "text": "као олуја градоносна, вихор рушилачки,",
            "poem": 2
          },
          {
            "text": "као поплава бујичиних вода,",
            "poem": 1
          },
          {
            "text": "обара их на земљу руком.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ногама ће бити изгажен",
            "poem": 1
          },
          {
            "text": "горди венац пијаница Јефремових,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "и цвет увели, блештава славност његова,",
            "poem": 1
          },
          {
            "text": "који су се удебљали;",
            "poem": 2
          },
          {
            "text": "биће као смоква рана пре лета,",
            "poem": 1
          },
          {
            "text": "чим је неко угледа,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "одмах је шаком убере.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "У дан онај Господ над војскама",
            "poem": 1
          },
          {
            "text": "постаће венац блистави",
            "poem": 2
          },
          {
            "text": "и круна славоносна",
            "poem": 1
          },
          {
            "text": "остатку народа својега,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "дух праведни",
            "poem": 1
          },
          {
            "text": "судија на суду,",
            "poem": 2
          },
          {
            "text": "и сила оном који одбија нападе на вратнице.",
            "poem": 1
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Против свештеника и лажних пророка"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "А и они посрћу од вина,",
            "poem": 1
          },
          {
            "text": "и тетурају се од жестоког пића.",
            "poem": 2
          },
          {
            "text": "Свештеник и пророк од жестоког пића,",
            "poem": 1
          },
          {
            "text": "омамило их је вино;",
            "poem": 2
          },
          {
            "text": "тетурају се због жестоког пића.",
            "poem": 1
          },
          {
            "text": "Посрћу при виђењу,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "љуљају се на рочишту.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Та сви су столови пуни гнусних избљувака,",
            "poem": 1
          },
          {
            "text": "нигде места чистога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "„Кога он то учи знању?",
            "poem": 1
          },
          {
            "text": "И коме он објашњава поруку?",
            "poem": 2
          },
          {
            "text": "Деци коју одвикавају од млека?",
            "poem": 1
          },
          {
            "text": "Одбијенима од дојења?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Јер:",
            "poem": 1
          },
          {
            "text": "Туц па муц, туц па муц!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Муц па туц, муц па туц!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Тамо кврц! Тамо кврц!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Јер уснама што муцају, и језиком туђинским",
            "poem": 1
          },
          {
            "text": "говориће овом народу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Јер он им је рекао:",
            "poem": 1
          },
          {
            "text": "„Ово је починак.",
            "poem": 2
          },
          {
            "text": "Нека се уморни одморе, и ово им је застанак!“",
            "poem": 1
          },
          {
            "text": "Али они послушати не хтедоше.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "И биће им реч Господња:",
            "poem": 1
          },
          {
            "text": "Туц па муц, туц па муц!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Муц па туц, муц па туц!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Тамо кврц! Тамо кврц,",
            "poem": 2
          },
          {
            "text": "да наузнак падну када ходају",
            "poem": 1
          },
          {
            "text": "и да се поломе и уплету и ухвате.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Против непоузданих саветника (I)"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Зато чујте реч Господњу, ви, подсмевачи,",
            "poem": 1
          },
          {
            "text": "ви, владари овог народа који је у Јерусалиму.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Зато што говорите: „Са смрћу смо савез склопили,",
            "poem": 1
          },
          {
            "text": "са Светом мртвих споразум склопили.",
            "poem": 2
          },
          {
            "text": "Кад прође бич разорни,",
            "poem": 1
          },
          {
            "text": "он нас дохватити неће,",
            "poem": 2
          },
          {
            "text": "јер од лажи начинисмо себи склониште,",
            "poem": 1
          },
          {
            "text": "и од обмане направисмо скровиште.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Пророштво о поузданом камену"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Зато говори Господ Господар:",
          {
            "text": "„Ево, постављам на Сиону камен,",
            "poem": 1
          },
          {
            "text": "камен за проверу, драгоцени камен угаони,",
            "poem": 2
          },
          {
            "text": "темељац утемељени.",
            "poem": 1
          },
          {
            "text": "Ко у њега поверује неће паничити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Узећу право да ми буде као равнало,",
            "poem": 1
          },
          {
            "text": "и правду као висак.",
            "poem": 2
          },
          "Против непоузданих саветника (II)",
          {
            "text": "И град ће вам затрти склониште начињено од лажи,",
            "poem": 1
          },
          {
            "text": "а вода ће вам поплавити скровиште,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "ваш савез са смрћу пропашће,",
            "poem": 1
          },
          {
            "text": "ваш споразум са Светом мртвих одржати се неће,",
            "poem": 2
          },
          {
            "text": "кад прође бич разорни,",
            "poem": 1
          },
          {
            "text": "он ће вас изгазити;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "дохватиће вас кад пролази,",
            "poem": 1
          },
          {
            "text": "а пролазиће од јутра до јутра,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "по дану и по ноћи.“",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Вас ће голи страх",
            "poem": 1
          },
          {
            "text": "упутити у поруку.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Прекратка ће бити постеља да се човек пружи;",
            "poem": 1
          },
          {
            "text": "узак ће бити покривач да се обмота.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Као на гори Фаресим, Господ ће устати;",
            "poem": 1
          },
          {
            "text": "као у Гаваонској долини, он ће се разјарити,",
            "poem": 2
          },
          {
            "text": "да дело своје изврши, дело чудновато;",
            "poem": 1
          },
          {
            "text": "да задатак свој оствари, задатак запањујући.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "А сада, не подсмевајте се,",
            "poem": 1
          },
          {
            "text": "иначе ће вас окови јаче стезати,",
            "poem": 2
          },
          {
            "text": "јер чух да је уништење земљи целој досудио",
            "poem": 1
          },
          {
            "text": "Господар Господ над војскама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Поређење са орачем"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Послушајте и чујте глас мој,",
            "poem": 1
          },
          {
            "text": "ослушните пажљиво беседу моју.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Оре ли орач сваког дана да сеје?",
            "poem": 1
          },
          {
            "text": "бразди ли и дрља њиву своју?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "А кад јој поравна површ,",
            "poem": 1
          },
          {
            "text": "не сеје ли грахор и не сипа ли ким?",
            "poem": 2
          },
          {
            "text": "Пшеницу где треба,",
            "poem": 1
          },
          {
            "text": "и јечам на место,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и крупник по рубовима?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Бог његов га упућује,",
            "poem": 1
          },
          {
            "text": "он га учи шта је исправно.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Јер се не млати грахор млатилицом,",
            "poem": 1
          },
          {
            "text": "нити се точком врше по киму,",
            "poem": 2
          },
          {
            "text": "већ се грахор палицом бије,",
            "poem": 1
          },
          {
            "text": "а ким се прутом лупа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "А да ли се жито таре?",
            "poem": 1
          },
          {
            "text": "Њега стално вршити нећеш;",
            "poem": 2
          },
          {
            "text": "и точак колски и коње његове по њему ћеш ваљати,",
            "poem": 1
          },
          {
            "text": "али га нећеш здробити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "И то стиже од Господа над војскама,",
            "poem": 1
          },
          {
            "text": "дивног у саветништву,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "величанственог у велеумљу.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
