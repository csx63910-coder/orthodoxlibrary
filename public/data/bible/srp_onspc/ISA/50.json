  "chapter": {
    "number": 50,
    "content": [
      {
        "type": "heading",
        "content": [
          "Спасоносна свемоћ Господња"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Говори Господ:",
          {
            "text": "„Где је потврда о разводу за вашу матер",
            "poem": 1
          },
          {
            "text": "којом сам је отпустио?",
            "poem": 2
          },
          {
            "text": "Или: ко је поверилац",
            "poem": 1
          },
          {
            "text": "коме сам вас продао?",
            "poem": 2
          },
          {
            "text": "Гле, због кривица ваших ви сте продани.",
            "poem": 1
          },
          {
            "text": "Због неверства свога ваша мати је отпуштена.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Зашто, кад сам био дошао,",
            "poem": 1
          },
          {
            "text": "никог није било?",
            "poem": 2
          },
          {
            "text": "Кад сам био звао,",
            "poem": 1
          },
          {
            "text": "одазвао се нико није?",
            "poem": 2
          },
          {
            "text": "Зар је тако кратко скраћена рука моја,",
            "poem": 1
          },
          {
            "text": "те не може избавити?",
            "poem": 2
          },
          {
            "text": "Или: зар снаге у мени нема,",
            "poem": 1
          },
          {
            "text": "те не могу ослободити?",
            "poem": 2
          },
          {
            "text": "Гле, претњом својом исушујем море,",
            "poem": 1
          },
          {
            "text": "претварам реке у пустињу.",
            "poem": 2
          },
          {
            "text": "Распадају се рибе њихове",
            "poem": 1
          },
          {
            "text": "кад воде нема, и умру од жеђи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Небеса облачим у црнину,",
            "poem": 1
          },
          {
            "text": "и кострет им као прекривачи.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "О слузи Господњем, Песма трећа"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Господар Господ даде ми језик учен",
            "poem": 1
          },
          {
            "text": "да знам окрепити уморнога.",
            "poem": 2
          },
          {
            "text": "Речју ме буди; из јутра у јутро буди ме на ухо",
            "poem": 1
          },
          {
            "text": "да га слушам као учени.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Господар Господ отворио ми је ухо,",
            "poem": 1
          },
          {
            "text": "а ја нисам окретао плећа,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "нити сам устукнуо.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Леђа сам своја подметао онима који ме туку,",
            "poem": 1
          },
          {
            "text": "а образе своје онима који ми браду чупају,",
            "poem": 2
          },
          {
            "text": "лице своје заклањао нисам",
            "poem": 1
          },
          {
            "text": "од увреда и од пљувања.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "А Господар Господ мени помоћ даје",
            "poem": 1
          },
          {
            "text": "да се не постидим,",
            "poem": 2
          },
          {
            "text": "зато сам свој образ у кремен претворио",
            "poem": 1
          },
          {
            "text": "и знам да се посрамити нећу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Близу је онај који ме правда.",
            "poem": 1
          },
          {
            "text": "Ко ће са мном да се парничи?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Станимо заједно.",
            "poem": 2
          },
          {
            "text": "Ко ће против мене?",
            "poem": 1
          },
          {
            "text": "Нек ми приђе ближе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Гле, Господар Господ мени помаже.",
            "poem": 1
          },
          {
            "text": "Ко је тај који ће ме окривити?",
            "poem": 2
          },
          {
            "text": "Ето, сви они ће се истрошити као хаљина,",
            "poem": 1
          },
          {
            "text": "мољац ће их појести.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ко се међу вама боји Господа",
            "poem": 1
          },
          {
            "text": "и слуша глас његовог слуге,",
            "poem": 2
          },
          {
            "text": "који је ишао по тамнинама,",
            "poem": 1
          },
          {
            "text": "а није имао видела;",
            "poem": 2
          },
          {
            "text": "уздао се у име Господње,",
            "poem": 1
          },
          {
            "text": "ослањао на Бога својега.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ено, сви ви који палите ватру",
            "poem": 1
          },
          {
            "text": "опасујући се искрама,",
            "poem": 2
          },
          {
            "text": "одосте у пламен своје ватре",
            "poem": 1
          },
          {
            "text": "и у искре вашег сагоревања;",
            "poem": 2
          },
          {
            "text": "од руке моје то ће вам бити:",
            "poem": 1
          },
          {
            "text": "лежаћете у мукама.",
            "poem": 2
          }
        ]
      }
    ],
