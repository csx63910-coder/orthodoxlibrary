    "lastChapterApiLink": "/api/srp_onspc/ISA/66.json",
    "totalNumberOfVerses": 1292
  },
  "chapter": {
    "number": 27,
    "content": [
      {
        "type": "heading",
        "content": [
          "Избављење Израиља"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "У дан онај",
          {
            "text": "походиће Господ мачем својим,",
            "poem": 1
          },
          {
            "text": "љутим и великим и јаким",
            "poem": 2
          },
          {
            "text": "левијатана, змију вијугаву,",
            "poem": 1
          },
          {
            "text": "и заклаће неман морску.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Виноград Господњи"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "У дан онај",
          {
            "text": "„Винограде винородни – одговориће му.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ја, Господ, бдим над њим,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "заливам га непрестано;",
            "poem": 2
          },
          {
            "text": "да га неко не оштети,",
            "poem": 1
          },
          {
            "text": "дању и ноћу стражарим над њим.",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Нема јарости у мени.",
            "poem": 2
          },
          {
            "text": "Трновитим бодљама, ко ће ме напасти?",
            "poem": 1
          },
          {
            "text": "Наступићу против њега;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "спалићу га свега.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Или: нека се поузда у моје уточиште:",
            "poem": 1
          },
          {
            "text": "мир са мном нека склопи,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "са мном мир нека склопи!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Милост народу и казна тлачитељу"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Иде време, Јаков ће се укоренити,",
            "poem": 1
          },
          {
            "text": "Израиљ ће се разгранати и процветати,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и они ће плодовима лице света прекрити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Да ли је он ударио",
            "poem": 1
          },
          {
            "text": "оног што је њега ударио?",
            "poem": 2
          },
          {
            "text": "Да ли је он клао",
            "poem": 1
          },
          {
            "text": "оног што је њега клао?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Истерао си га, изгнао си га –",
            "poem": 1
          },
          {
            "text": "ти си њега карао.",
            "poem": 2
          },
          {
            "text": "Он ће га одувати дахом својим олујним",
            "poem": 1
          },
          {
            "text": "у дан ветра источнога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Тако ће се откупити кривица Јаковљева,",
            "poem": 1
          },
          {
            "text": "а све ово је зато што је њему опроштен грех:",
            "poem": 2
          },
          {
            "text": "он ће учинити да сви камени жртвеници",
            "poem": 1
          },
          {
            "text": "буду као здробљени кречњак,",
            "poem": 2
          },
          {
            "text": "да се више не подижу",
            "poem": 1
          },
          {
            "text": "Аштартини ступови и стубови у част сунца.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Јер ће град утврђени остати сам,",
            "poem": 1
          },
          {
            "text": "напуштен и заборављен као пустиња.",
            "poem": 2
          },
          {
            "text": "Онде телад пасе,",
            "poem": 1
          },
          {
            "text": "онде лежи",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и брсти му гране.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Кад му се круна осуши, онда се ломе;",
            "poem": 1
          },
          {
            "text": "жене долазе и оне их спаљују,",
            "poem": 2
          },
          {
            "text": "јер је то народ неразуман.",
            "poem": 1
          },
          {
            "text": "Зато им се неће смиловати његов Саздатељ,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и неће му бити наклоњен његов Градитељ.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Зов велике трубе"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "У дан онај овршиће Господ класје од тока Еуфрата до Египатског потока, и ви ћете се скупити, један по један, потомци Израиљеви."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "У дан онај велика ће затрубити труба и доћи ће расељени по земљи асирској, и изгнани у земљу египатску, и клањаће се Господу на светој гори, у Јерусалиму."
        ]
      }
    ],
