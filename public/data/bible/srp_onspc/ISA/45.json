  "chapter": {
    "number": 45,
    "content": [
      {
        "type": "heading",
        "content": [
          "Пророштво о Киру"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Говори Господ о помазанику свом,",
            "poem": 1
          },
          {
            "text": "Киру, ког прихватих за десницу",
            "poem": 2
          },
          {
            "text": "да пред њим оборим народе",
            "poem": 1
          },
          {
            "text": "и цареве лишим њиховог угледа:",
            "poem": 2
          },
          {
            "text": "„Пред њим двострука врата отварам,",
            "poem": 1
          },
          {
            "text": "и неће вратнице пред њим затворене бити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ја ћу марширати пред тобом",
            "poem": 1
          },
          {
            "text": "да поравнам неравнине,",
            "poem": 2
          },
          {
            "text": "да разломим врата бронзана,",
            "poem": 1
          },
          {
            "text": "и покршим преворнице гвоздене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Дајем ти блага из мрачних одаја",
            "poem": 1
          },
          {
            "text": "и богатства из скровишта,",
            "poem": 2
          },
          {
            "text": "да схватиш да сам ја Господ,",
            "poem": 1
          },
          {
            "text": "који те зове по имену, Бог Израиљев.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ради слуге свога Јакова,",
            "poem": 1
          },
          {
            "text": "и изабраника Израиља,",
            "poem": 2
          },
          {
            "text": "и тебе позвах по имену,",
            "poem": 1
          },
          {
            "text": "наименовах те, иако ме ниси знао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ја сам Господ и другога нема,",
            "poem": 1
          },
          {
            "text": "осим мене другог Бога нема.",
            "poem": 2
          },
          {
            "text": "Иако мене не познајеш,",
            "poem": 1
          },
          {
            "text": "ја сам те наоружао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Нека се зна од истока и од запада",
            "poem": 1
          },
          {
            "text": "да је ништавило све што је мимо мене.",
            "poem": 2
          },
          "Бог обећава спасење",
          {
            "text": "Ја сам Господ и другога нема:",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "ја творим светлост и стварам таму,",
            "poem": 1
          },
          {
            "text": "чиним мир и несрећу стварам;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ја, Господ, све то чиним.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Росите, небеса, одозго,",
            "poem": 1
          },
          {
            "text": "и праведност, облаци, нека из вас пада.",
            "poem": 2
          },
          {
            "text": "Нека се отвори земља",
            "poem": 1
          },
          {
            "text": "и спасење нека буде плод,",
            "poem": 2
          },
          {
            "text": "те заједно проклија праведност;",
            "poem": 1
          },
          {
            "text": "ја, Господ, то сам створио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Господ је свесилан"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Тешко оном ко расправља са Саздатељем својим,",
            "poem": 1
          },
          {
            "text": "а грне је међу грнчаријом!",
            "poem": 2
          },
          {
            "text": "Каже ли глина грнчару:",
            "poem": 1
          },
          {
            "text": "’Шта радиш?’",
            "poem": 2
          },
          {
            "text": "или дело његово:",
            "poem": 1
          },
          {
            "text": "’Он нема обе руке’?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Тешко оном који оцу каже:",
            "poem": 1
          },
          {
            "text": "’Зашто си родио?’",
            "poem": 2
          },
          {
            "text": "или жени:",
            "poem": 1
          },
          {
            "text": "’Зашто си на свет донела?’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Говори Господ,",
            "poem": 1
          },
          {
            "text": "Израиљев Светитељ и његов Саздатељ:",
            "poem": 2
          },
          {
            "text": "„Зар је ваше да ме питате",
            "poem": 1
          },
          {
            "text": "о знацима над децом мојом,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и да ми заповедате над делом мојих руку?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ја сам земљу начинио",
            "poem": 1
          },
          {
            "text": "и човека на њој створио;",
            "poem": 2
          },
          {
            "text": "својим сам рукама небеса распростро",
            "poem": 1
          },
          {
            "text": "и свим војскама њиховим заповедам.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ја сам га подигао у праведности",
            "poem": 1
          },
          {
            "text": "и поравнао све путеве његове.",
            "poem": 2
          },
          {
            "text": "Он ће обновити мој град",
            "poem": 1
          },
          {
            "text": "и ослободити заробљене моје",
            "poem": 2
          },
          {
            "text": "без откупнине и без накнаде –",
            "poem": 1
          },
          {
            "text": "говори Господ над војскама.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Обраћење туђинаца"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Говори Господ:",
          {
            "text": "„Труд египатски и добитак кушки,",
            "poem": 1
          },
          {
            "text": "и Савајци, људи повисоки,",
            "poem": 2
          },
          {
            "text": "теби ће прећи и твоји ће бити,",
            "poem": 1
          },
          {
            "text": "за тобом ће ићи, у оковима претходити,",
            "poem": 2
          },
          {
            "text": "и теби ће се клањати,",
            "poem": 1
          },
          {
            "text": "и тебе молити:",
            "poem": 2
          },
          {
            "text": "’О, само код тебе је Божанство,",
            "poem": 1
          },
          {
            "text": "и осим Бога други не постоји.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Заиста, ти си Божанство скривено,",
            "poem": 1
          },
          {
            "text": "Бог Израиљев, Спаситељ.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Постидеће се и осрамотиће се сви,",
            "poem": 1
          },
          {
            "text": "заједно ће се повући покуњени они који праве кипове.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Господ ће спасти Израиља",
            "poem": 1
          },
          {
            "text": "спасењем вечним,",
            "poem": 2
          },
          {
            "text": "нећете се постидети,",
            "poem": 1
          },
          {
            "text": "и до векова вечних нећете се осрамотити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Господ указује на своја дела"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Та, говори Господ,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "створитељ небеса",
            "poem": 1
          },
          {
            "text": "– он је Бог –",
            "poem": 2
          },
          {
            "text": "који је обликовао земљу",
            "poem": 1
          },
          {
            "text": "и изглед јој дао,",
            "poem": 2
          },
          {
            "text": "који је учврстио,",
            "poem": 1
          },
          {
            "text": "и није је створио да буде пустош,",
            "poem": 2
          },
          {
            "text": "него је уобличио да се на њој станује:",
            "poem": 1
          },
          {
            "text": "„Ја сам Господ и другог нема.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Нисам говорио у тајности,",
            "poem": 1
          },
          {
            "text": "у закутку земље тамне.",
            "poem": 2
          },
          {
            "text": "Нисам рекао потомству Јаковљеву:",
            "poem": 1
          },
          {
            "text": "’Тражите ме у пустоши.’",
            "poem": 2
          },
          {
            "text": "Ја, Господ, говорим правду",
            "poem": 1
          },
          {
            "text": "и благовестим честитости.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Господ је Бог за све људе"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Саберите се и дођите,",
            "poem": 1
          },
          {
            "text": "заједно приступите, избеглице из других народа.",
            "poem": 2
          },
          {
            "text": "Незналице су који носе дрво идолско",
            "poem": 1
          },
          {
            "text": "и моле се божанству које не спасава.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Објавите и предочите,",
            "poem": 1
          },
          {
            "text": "хајде, посаветујте се заједнички.",
            "poem": 2
          },
          {
            "text": "Ко је ово од давнина изјавио",
            "poem": 1
          },
          {
            "text": "и још тада предсказао?",
            "poem": 2
          },
          {
            "text": "Нисам ли ја, Господ?",
            "poem": 1
          },
          {
            "text": "Осим мене другог бога нема;",
            "poem": 2
          },
          {
            "text": "праведног Божанства и Спаситеља",
            "poem": 1
          },
          {
            "text": "осим мене нема.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Обратите се мени и бићете спасени,",
            "poem": 1
          },
          {
            "text": "сви крајеви земљини,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер ја сам Божанство и другог нема.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Заклињем се самим собом:",
            "poem": 1
          },
          {
            "text": "из мојих уста излази реч праведна",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и нећу је опозвати:",
            "poem": 2
          },
          {
            "text": "да ће се преда мном свако колено савити,",
            "poem": 1
          },
          {
            "text": "сваки језик мноме заклињати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "’Само у Господу имам – вели –",
            "poem": 1
          },
          {
            "text": "праведност и снагу.’“",
            "poem": 2
          },
          {
            "text": "К њему ће доћи и стидеће се",
            "poem": 1
          },
          {
            "text": "сви који су беснели против њега.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "У Господу ће имати",
            "poem": 1
          },
          {
            "text": "праведност и прослављање",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "све потомство Израиљево.",
            "poem": 2
          }
        ]
      }
    ],
