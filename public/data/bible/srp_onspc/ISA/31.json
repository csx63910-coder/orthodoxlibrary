  "chapter": {
    "number": 31,
    "content": [
      {
        "type": "heading",
        "content": [
          "Против Египта"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Тешко онима који силазе у Египат по помоћ,",
            "poem": 1
          },
          {
            "text": "и наду у коње полажу,",
            "poem": 2
          },
          {
            "text": "и у кола се уздају многа,",
            "poem": 1
          },
          {
            "text": "и у коњанике врло јаке,",
            "poem": 2
          },
          {
            "text": "а не гледају с поуздањем у Светитеља Израиљева,",
            "poem": 1
          },
          {
            "text": "а не траже Господа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ипак, он је мудар и навалиће зло,",
            "poem": 1
          },
          {
            "text": "и неће преиначити што је рекао,",
            "poem": 2
          },
          {
            "text": "те ће устати против дома зликовачког",
            "poem": 1
          },
          {
            "text": "и против помоћи од преступника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Египћанин је човек, он није Бог;",
            "poem": 1
          },
          {
            "text": "коњи његови су месо, они нису дух.",
            "poem": 2
          },
          {
            "text": "Када Господ испружи руку своју,",
            "poem": 1
          },
          {
            "text": "посрнуће онај који помаже",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и пашће онај коме он помаже",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "– сви заједно ће пропасти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Господ се бори против Асирије"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Ево, Господ ми је овако рекао:",
          {
            "text": "„Као што лав или лавић",
            "poem": 1
          },
          {
            "text": "над пленом својим режи,",
            "poem": 2
          },
          {
            "text": "и онда кад на њега повиче пастира мноштво,",
            "poem": 1
          },
          {
            "text": "он се не плаши од гласова њихових,",
            "poem": 2
          },
          {
            "text": "нити он стрепи од граје њихове –",
            "poem": 1
          },
          {
            "text": "тако ће Господ над војскама",
            "poem": 2
          },
          {
            "text": "сићи да се бори",
            "poem": 1
          },
          {
            "text": "за гору Сион, за узвишење њено.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Како птица крилима,",
            "poem": 1
          },
          {
            "text": "тако ће Господ над војскама Јерусалим заклањати,",
            "poem": 2
          },
          {
            "text": "заклон бити, избавити,",
            "poem": 1
          },
          {
            "text": "поштедети и спасти.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Вратите се ономе против кога сте се дубоко побунили, синови Израиљеви."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Та, у онај дан ће свако презрети идоле своје сребрне и златне, ликове своје резане, што их себи руке ваше на грех начинише."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "„Асирац ће пасти од мача што није од људи,",
            "poem": 1
          },
          {
            "text": "прождераће га мач што није од човека.",
            "poem": 2
          },
          {
            "text": "Он ће од мача бежати,",
            "poem": 1
          },
          {
            "text": "а младићи његови ће бити под насиљем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ужаснут, оставиће своју тврђаву;",
            "poem": 1
          },
          {
            "text": "његови главари ће се престравити под заставом –",
            "poem": 2
          },
          {
            "text": "тако је рекао Господ,",
            "poem": 1
          },
          {
            "text": "његова је ватра на Сиону,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и његова је пећ у Јерусалиму.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
