  "chapter": {
    "number": 29,
    "content": [
      {
        "type": "heading",
        "content": [
          "Реч о Јерусалиму"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "„Тешко Арилу",
            "poem": 1
          },
          {
            "noteId": 8
          },
          {
            "text": ", Арилу,",
            "poem": 1
          },
          {
            "text": "граду што га опколи Давид.",
            "poem": 2
          },
          {
            "text": "Нека се година за годином ниже,",
            "poem": 1
          },
          {
            "text": "нека се празници изређају,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "онда ћу притиснути Арил:",
            "poem": 1
          },
          {
            "text": "и биће туга и жалост,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и мени ће бити као Арилу",
            "poem": 2
          },
          {
            "noteId": 9
          },
          {
            "text": ";",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "опколићу те унаоколо,",
            "poem": 1
          },
          {
            "text": "око тебе опкопаћу ровове,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "против тебе подићи насипе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Оборен ћеш бити и са земље говорити,",
            "poem": 1
          },
          {
            "text": "речју пригушеном из прашине казивати,",
            "poem": 2
          },
          {
            "text": "и глас ће ти бити из земље,",
            "poem": 1
          },
          {
            "text": "као призивач духова беседу ћеш из прашине шаптати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "И мноштво ће туђинаца твојих бити као ситан прах,",
            "poem": 1
          },
          {
            "text": "и руља насилника као плева развејана;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и биће изненада, одједном,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "походиће те Господ над војскама",
            "poem": 1
          },
          {
            "text": "грмљавином и трусом и буком великом,",
            "poem": 2
          },
          {
            "text": "и олујом и пламеном разбукталим што прождире.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Виђење ноћно биће као сан:",
            "poem": 1
          },
          {
            "text": "мноштво свих народа",
            "poem": 2
          },
          {
            "text": "што против Арила војују,",
            "poem": 1
          },
          {
            "text": "и свих оних који на њ завојштише",
            "poem": 2
          },
          {
            "text": "и на тврђаве његове",
            "poem": 1
          },
          {
            "text": "и који га притеснише.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Биће као кад гладан сања,",
            "poem": 1
          },
          {
            "text": "и гле, он једе",
            "poem": 2
          },
          {
            "text": "и пробуди се празна желуца;",
            "poem": 1
          },
          {
            "text": "и као кад жедан сања,",
            "poem": 2
          },
          {
            "text": "и гле, он пије,",
            "poem": 1
          },
          {
            "text": "и пробуди се, и гле, изнемогао и сува грла.",
            "poem": 2
          },
          {
            "text": "Тако ће се догодити мноштву свих народа",
            "poem": 1
          },
          {
            "text": "који војују против горе Сион.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Станите и запањите се!",
            "poem": 1
          },
          {
            "text": "Ослепите и обневидите!",
            "poem": 2
          },
          {
            "text": "Пијани су, али не од вина;",
            "poem": 1
          },
          {
            "text": "и посрћу, али не од препеченице.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Господ је на вас излио дубоки сан,",
            "poem": 1
          },
          {
            "text": "и затворио је очи ваше – пророке,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и застро је главе ваше – видеоце.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Покривено откривање"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Зато ће свако ваше виђење бити као речи у запечаћеном свитку. Дају неком ко зна да чита и кажу: „Хајде, читај ово!“ Он ће одговорити: „Не могу зато што је запечаћено.“"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Онда дају неком ко не зна да чита и кажу му: „Хајде, читај то!“ Он ће одговорити: „Не знам да читам.“"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Божија претња"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Господар је рекао:",
          {
            "text": "„Зато што овај народ приступа устима,",
            "poem": 1
          },
          {
            "text": "и част ми одаје уснама,",
            "poem": 2
          },
          {
            "text": "а срце му је од мене далеко,",
            "poem": 1
          },
          {
            "text": "и њихова је побожност научена заповест људска;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "зато ћу, ево, и надаље с народом овим чуда чинити,",
            "poem": 1
          },
          {
            "text": "чуда и само чуда;",
            "poem": 2
          },
          {
            "text": "те ће пропасти мудрост мудраца његових,",
            "poem": 1
          },
          {
            "text": "и сакриће се умност умника његових.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Против непоузданих саветника (III)"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Тешко онима који се по дубинама крију од Господа",
            "poem": 1
          },
          {
            "text": "да би сакрили намере,",
            "poem": 2
          },
          {
            "text": "и који у тмини делују и зборе:",
            "poem": 1
          },
          {
            "text": "„Ко нас види и ко нас познаје?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Колико сте ви наопаки!",
            "poem": 1
          },
          {
            "text": "Цени ли се глина као грнчар,",
            "poem": 2
          },
          {
            "text": "па да производ рекне свом произвођачу:",
            "poem": 1
          },
          {
            "text": "„Није ме он начинио!“?",
            "poem": 2
          },
          {
            "text": "Или лонац да рекне грнчару:",
            "poem": 1
          },
          {
            "text": "„Он не разазнаје?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Неће ли се Ливан ускоро у Кармил претворити,",
            "poem": 1
          },
          {
            "text": "а Кармил као шума рачунати?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "И глуви ће у онај дан слушати речи из књиге.",
            "poem": 1
          },
          {
            "text": "И из мрака и таме очи слепих ће прогледати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "И опет ће се понизни радовати у Господу,",
            "poem": 1
          },
          {
            "text": "најбеднији ће клицати Светитељу Израиљеву,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "јер насилник ће ишчезнути,",
            "poem": 1
          },
          {
            "text": "и подсмевач ће нестати,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и сви који вребају на зло биће истребљени:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "који друге на грех речју наводе,",
            "poem": 1
          },
          {
            "text": "који поротнику код вратница замку постављају,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "под лажном оптужбом и без разлога праведника руше.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Зато говори Господ, који је откупио Аврахама, дому Јаковљевом:",
          {
            "text": "„Од сад Јаков стидети се неће,",
            "poem": 1
          },
          {
            "text": "и од сад лице његово бледети неће,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "јер кад види децу своју,",
            "poem": 1
          },
          {
            "text": "усред себе дело мојих руку,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "он ће моје име светковати.",
            "poem": 2
          },
          {
            "text": "Светковаће Светитеља Јаковљева",
            "poem": 1
          },
          {
            "text": "и бојаће се Бога Израиљева.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Уразумиће се они који духовно лутају,",
            "poem": 1
          },
          {
            "text": "поуку ће примити они који мрмљају.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 8,
        "caller": "+",
        "text": "29,1 Још један назив за Јерусалим.",
        "reference": {
          "chapter": 29,
          "verse": 1
        }
      },
      {
        "noteId": 9,
        "caller": "+",
        "text": "29,2 Игра речи на јеврејском, јер име Арил звучи као огњиште жртвеника.",
        "reference": {
          "chapter": 29,
          "verse": 2
        }
      }
    ]
