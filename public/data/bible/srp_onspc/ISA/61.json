  "chapter": {
    "number": 61,
    "content": [
      {
        "type": "heading",
        "content": [
          "Пророково послање"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Дух је Господњи нада мном;",
            "poem": 1
          },
          {
            "text": "он ме је помазао,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да јавим Радосну вест понизнима.",
            "poem": 2
          },
          {
            "text": "Послао ме је да превијем у срцу сломљене,",
            "poem": 1
          },
          {
            "text": "да најавим слободу заробљеницима,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "утамниченима да ће им престати сужањство;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "да од Господа најавим годину помиловања,",
            "poem": 1
          },
          {
            "text": "и од Бога нашега дан освете;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да утешим све ожалошћене,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "да усправим ожалошћене на Сиону,",
            "poem": 1
          },
          {
            "text": "да им дам накит уместо пепела,",
            "poem": 2
          },
          {
            "text": "уље за весеље уместо жалости,",
            "poem": 1
          },
          {
            "text": "одећу за похвалу уместо духа тужнога;",
            "poem": 2
          },
          {
            "text": "и њих ће звати:",
            "poem": 1
          },
          {
            "text": "’Храстови правдини,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Засад Господње славности’.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "И саградиће древне развалине,",
            "poem": 1
          },
          {
            "text": "и подићи места похарана,",
            "poem": 2
          },
          {
            "text": "и обновиће градове,",
            "poem": 1
          },
          {
            "text": "пустошене од колена до колена.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "И туђинци ће стајати",
            "poem": 1
          },
          {
            "text": "и стада ваша напасати,",
            "poem": 2
          },
          {
            "text": "и синови странаца биће ратари ваши",
            "poem": 1
          },
          {
            "text": "и виноградари ваши.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "А ви ћете се звати: ’Свештеници Господњи’.",
            "poem": 1
          },
          {
            "text": "Говориће вам се: ’Служитељи Бога нашега’.",
            "poem": 2
          },
          {
            "text": "Јешћете благо туђинских народа",
            "poem": 1
          },
          {
            "text": "и загосподарићете славом њиховом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Уместо вашег двоструког ниподаштавања и срамоте,",
            "poem": 1
          },
          {
            "text": "одредиће им се да се веселе за вас,",
            "poem": 2
          },
          {
            "text": "који ћете у њиховој земљи",
            "poem": 1
          },
          {
            "text": "наследити двоструко,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "којима ће бити радост вечна.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Јер ја, Господ, волим право,",
            "poem": 1
          },
          {
            "text": "мрзим грабеж уз жртву свеспалницу,",
            "poem": 2
          },
          {
            "text": "а даћу им плату одистинску,",
            "poem": 1
          },
          {
            "text": "и склопићу с њима савез вечни.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "И знаће се међу пуцима потомство њихово,",
            "poem": 1
          },
          {
            "text": "усред народа нараштаји њихови.",
            "poem": 2
          },
          {
            "text": "Сви који их виде схватиће да су они потомство",
            "poem": 1
          },
          {
            "text": "што га је благословио Господ.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Усхићен сам врло у Господу,",
            "poem": 1
          },
          {
            "text": "кличе душа моја у Богу моме,",
            "poem": 2
          },
          {
            "text": "јер ме је оденуо хаљином спасења,",
            "poem": 1
          },
          {
            "text": "огрнуо ме је плаштом праведности,",
            "poem": 2
          },
          {
            "text": "као женик кад на себе венац стави",
            "poem": 1
          },
          {
            "text": "и невеста кад се накитом украси.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Јер као што земља истерује клице своје,",
            "poem": 1
          },
          {
            "text": "и као што семе у врту клија,",
            "poem": 2
          },
          {
            "text": "тако ће Господар Господ учинити",
            "poem": 1
          },
          {
            "text": "да проклија правда и похвала пред свим пуцима.",
            "poem": 2
          }
        ]
      }
    ],
