  "chapter": {
    "number": 59,
    "content": [
      {
        "type": "heading",
        "content": [
          "Псалам пророка Исаије"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Гле, није рука Господња окраћала да не спасава,",
            "poem": 1
          },
          {
            "text": "нити је ухо његово оглухнуло да не чује;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "него ваше кривице јесу преграда",
            "poem": 1
          },
          {
            "text": "између вас и Бога вашега,",
            "poem": 2
          },
          {
            "text": "и греси ваши заклањају лице његово од вас",
            "poem": 1
          },
          {
            "text": "да вас не чује.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Јер шаке су ваше крвљу загађене,",
            "poem": 1
          },
          {
            "text": "и прсти су ваши у злочину,",
            "poem": 2
          },
          {
            "text": "усне ваше говоре превару,",
            "poem": 1
          },
          {
            "text": "језик ваш мрмља подлост.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "На праведност нико не позива,",
            "poem": 1
          },
          {
            "text": "нити ико по истини суди;",
            "poem": 2
          },
          {
            "text": "уздају се у ништавило, и говоре речи испразне;",
            "poem": 1
          },
          {
            "text": "муку зачињу, неваљалство рађају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Јаја гујина легу",
            "poem": 1
          },
          {
            "text": "и мрежу паукову плету;",
            "poem": 2
          },
          {
            "text": "од њихових ко поједе јаја, тај умире;",
            "poem": 1
          },
          {
            "text": "а ако га разбије, гуја се излегне.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Њихово плетење није за одевање,",
            "poem": 1
          },
          {
            "text": "њихове израђевине нису за покривање.",
            "poem": 2
          },
          {
            "text": "Њихове израђевине дело су преступничко",
            "poem": 1
          },
          {
            "text": "и шакама својим чине насиље",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Њихове ноге у зло трче",
            "poem": 1
          },
          {
            "text": "и хитре су да проливају невину крв.",
            "poem": 2
          },
          {
            "text": "Мисли њихове мисли су преступничке,",
            "poem": 1
          },
          {
            "text": "пустош је и пропаст на друмовима њиховим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Пут ка миру они не познају,",
            "poem": 1
          },
          {
            "text": "на стазама њиховим праведности нема.",
            "poem": 2
          },
          {
            "text": "Изопачили су своје угажене путеве,",
            "poem": 1
          },
          {
            "text": "ко по таквом путује, мир не упознаје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Зато се право од нас удаљило,",
            "poem": 1
          },
          {
            "text": "и праведност до нас не допире.",
            "poem": 2
          },
          {
            "text": "Надали смо се светлости, а гле, тама;",
            "poem": 1
          },
          {
            "text": "сјајном сјају, а ходамо по мраку дубоком;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "по зиду пипамо као слепи,",
            "poem": 1
          },
          {
            "text": "и тапкамо као да смо без очију;",
            "poem": 2
          },
          {
            "text": "у подне се спотичемо као да смо у сумраку;",
            "poem": 1
          },
          {
            "text": "у обиљу смо као да смо мртви;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "сви ми мумламо као да смо медведи",
            "poem": 1
          },
          {
            "text": "и гукањем гучемо као да смо голубови.",
            "poem": 2
          },
          {
            "text": "Очекујемо суд, а њега нема,",
            "poem": 1
          },
          {
            "text": "спасење – удаљило се од нас.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Јер много је наших побуна пред тобом,",
            "poem": 1
          },
          {
            "text": "и греси наши сведоче против нас.",
            "poem": 2
          },
          {
            "text": "Заиста, ми увиђамо побуне своје",
            "poem": 1
          },
          {
            "text": "и упознали смо кривицу своју.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Побунили смо се и Господа се одрекли,",
            "poem": 1
          },
          {
            "text": "одметнули се од Бога нашега;",
            "poem": 2
          },
          {
            "text": "говорили смо речи подле и отпадничке,",
            "poem": 1
          },
          {
            "text": "измишљотине и одвајање, из срца речи лажљиве.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "И тако је право потиснуто,",
            "poem": 1
          },
          {
            "text": "и правда је далеко одгурнута,",
            "poem": 2
          },
          {
            "text": "јер истина је јавно посрнула,",
            "poem": 1
          },
          {
            "text": "и честитост проћи не може.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Истина бива черупана,",
            "poem": 1
          },
          {
            "text": "и ко се зла клони, бива оробљен.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "А Господ види и то је зло пред њим",
            "poem": 1
          },
          {
            "text": "јер правице нема.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "И види: нема човека.",
            "poem": 1
          },
          {
            "text": "И запањи се што заступника нема.",
            "poem": 2
          },
          {
            "text": "Онда се ослободи мишица његова,",
            "poem": 1
          },
          {
            "text": "и би му потпора праведност његова.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Праведност је навукао као оклоп,",
            "poem": 1
          },
          {
            "text": "и на глави му је спасење као кацига,",
            "poem": 2
          },
          {
            "text": "а одећу осветничку је навукао као одору,",
            "poem": 1
          },
          {
            "text": "и ревношћу се огрнуо као плаштом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Према оном што су заслужили",
            "poem": 1
          },
          {
            "text": "њих ће намирити;",
            "poem": 2
          },
          {
            "text": "према оном што су заслужили,",
            "poem": 1
          },
          {
            "text": "зато што су насртали, зато што су мрзели,",
            "poem": 2
          },
          {
            "text": "њих ће намирити,",
            "poem": 1
          },
          {
            "text": "према оном што су жудели,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "што су заслужили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "И видеће са запада име Господње,",
            "poem": 1
          },
          {
            "text": "и са истока сунчевога славу његову,",
            "poem": 2
          },
          {
            "text": "јер ће доћи као бујица,",
            "poem": 1
          },
          {
            "text": "Дух Господњи њу ће подстицати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "„А Откупитељ ће доћи Сиону",
            "poem": 1
          },
          {
            "text": "и онима који се у Јакову одврате од преступа",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Запис о Духу и речи"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Ево, ово је мој савез с њима, говори Господ: Дух мој, који је на теби, и речи моје, што сам ти их у уста ставио, неће отићи од уста твојих, ни од уста потомства твојега, ни од уста потомака потомства твојега – говори Господ – како сада тако и довека."
        ]
      }
    ],
