  "chapter": {
    "number": 6,
    "content": [
      {
        "type": "heading",
        "content": [
          "Господња парница против Израиља"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Чујте сада шта говори Господ:",
          {
            "text": "„Устани, са горама се парничи.",
            "poem": 1
          },
          {
            "text": "Глас твој нека чују брда.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "О, брда и чврсти темељи земљини,",
            "poem": 1
          },
          {
            "text": "чујте Господњи случај!",
            "poem": 2
          },
          {
            "text": "Јер, Господ се суди са својим народом",
            "poem": 1
          },
          {
            "text": "и са Израиљем се спори.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Шта сам ти урадио, народе мој?",
            "poem": 1
          },
          {
            "text": "Чиме сам ти дојадио, одговори ми?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Па ја сам те извео из египатске земље,",
            "poem": 1
          },
          {
            "text": "из куће ропства сам те откупио",
            "poem": 2
          },
          {
            "text": "и пред тобом послао Мојсија,",
            "poem": 1
          },
          {
            "text": "Арона и Марију.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Сети се, молим те, народе мој,",
            "poem": 1
          },
          {
            "text": "шта је наумио моавски цар Валак",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и шта му је говорио Валам, син Веоров,",
            "poem": 2
          },
          {
            "text": "шта се збило од Ситима до Галгала,",
            "poem": 1
          },
          {
            "text": "да бисте схватили Господњу праведност.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Како ћу Господу да приступим,",
            "poem": 1
          },
          {
            "text": "савијен ничице пред узвишеним Богом?",
            "poem": 2
          },
          {
            "text": "Да му приступим са свеспалницама",
            "poem": 1
          },
          {
            "text": "и теладима од годину дана?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Хоће ли Господ бити задовољан са хиљадама овнова,",
            "poem": 1
          },
          {
            "text": "са десетином хиљада потока уља?",
            "poem": 2
          },
          {
            "text": "Да ли да првенца дам за своје преступе,",
            "poem": 1
          },
          {
            "text": "плод утробе своје за грех душе моје?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Објавио ти је Господ, о, човече, шта је добро",
            "poem": 1
          },
          {
            "text": "и шта тражи од тебе:",
            "poem": 2
          },
          {
            "text": "само да чиниш правду, волиш милосрђе",
            "poem": 1
          },
          {
            "text": "и покорно ходаш са својим Богом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Кривица и казна Израиља"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Глас Господњи виче граду",
            "poem": 1
          },
          {
            "text": "и ко је мудар бојаће се имена твога.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Слушајте жезло моћи и онога ко га је овластио!",
            "poem": 2
          },
          {
            "noteId": 0
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Има ли у кући непоштеног још увек непоштеног блага",
            "poem": 1
          },
          {
            "text": "и проклете непоштене мере?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Зар ћу да будем чист са непоштеним теразијама",
            "poem": 1
          },
          {
            "text": "и са торбом нетачних тегова?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Јер су њихови богаташи пуни насиља,",
            "poem": 1
          },
          {
            "text": "његови становници говоре превару,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "лажљив им је језик у устима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "И још ћу те разболети ударајући те,",
            "poem": 1
          },
          {
            "text": "због греха ћу те пустошити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Јешћеш, а сит нећеш бити.",
            "poem": 1
          },
          {
            "text": "Бићеш празан у нутрини својој.",
            "poem": 2
          },
          {
            "text": "Склањаћеш, а нећеш осигурати.",
            "poem": 1
          },
          {
            "text": "А ја ћу мач послати на оно што си осигурао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Сејаћеш, али нећеш жети,",
            "poem": 1
          },
          {
            "text": "газићеш маслине и грожђе,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "али се уљем нећеш мазати и вино нећеш пити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Држиш Амријеве уредбе",
            "poem": 1
          },
          {
            "text": "и сва дела Ахавовог дома.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Идеш по њиховим саветима",
            "poem": 2
          },
          {
            "text": "и зато сам те предао разарању,",
            "poem": 1
          },
          {
            "text": "а твој живаљ ће поднети ругло",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и погрду мог народа.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 0,
        "caller": "+",
        "text": "6,9 Овај део стиха може и овако да се преведе: Слушај, племе (Јудино)! Ко је онај што га је установио (град)?",
        "reference": {
          "chapter": 6,
          "verse": 9
        }
      }
    ]
