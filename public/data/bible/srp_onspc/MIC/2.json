  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "heading",
        "content": [
          "Људски планови и Божији планови"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Јао онима који зло спремају,",
            "poem": 1
          },
          {
            "text": "који кују неправду на постељама својим!",
            "poem": 2
          },
          {
            "text": "Кад осване, онда то и чине,",
            "poem": 1
          },
          {
            "text": "јер је сила у руци њиховој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Зажеле њиве – отимају их;",
            "poem": 1
          },
          {
            "text": "и куће – одузимају их.",
            "poem": 2
          },
          {
            "text": "Они тлаче човека и дом његов,",
            "poem": 1
          },
          {
            "text": "човека и његово наследство.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Зато овако каже Господ:",
          {
            "text": "„Ево, роду овом спремам зло.",
            "poem": 1
          },
          {
            "text": "Из њега нећете своје вратове извући",
            "poem": 2
          },
          {
            "text": "и нећете надмено ићи,",
            "poem": 1
          },
          {
            "text": "јер ће доћи време зла.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Тога ће дана о вама с подсмехом причати,",
            "poem": 1
          },
          {
            "text": "нарицаће нарицаљку:",
            "poem": 2
          },
          {
            "text": "’Збило се – рећи ће. Сатрвени смо сасвим.",
            "poem": 1
          },
          {
            "text": "Мењао је део народа мога.",
            "poem": 2
          },
          {
            "text": "Како га је отргнуо од мене!",
            "poem": 1
          },
          {
            "text": "Наша је поља дао отпадницима.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Зато нећеш имати никога ко би ти жребом",
            "poem": 1
          },
          {
            "text": "мерио ужетом земљу у збору Господњем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Лажни пророци"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "„Не пените пророштвима“ – пророкују они –",
            "poem": 1
          },
          {
            "text": "„Не пророкујте о тим стварима!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Неће се на нас обрушити.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Кажеш ли ти, о, доме Јаковљев:",
            "poem": 1
          },
          {
            "text": "„Је ли Дух Господњи нестрпљив?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "То ли су његова дела?“",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Не чине ли моје речи добро",
            "poem": 1
          },
          {
            "text": "ономе који исправно живи?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Колико јуче мој се народ подигао",
            "poem": 1
          },
          {
            "text": "као непријатељ.",
            "poem": 2
          },
          {
            "text": "Скидате са хаљине плашт",
            "poem": 1
          },
          {
            "text": "онима који спокојно пролазе,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "као они који се из битке враћају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Жене мог народа терате",
            "poem": 1
          },
          {
            "text": "из њихових вољених кућа,",
            "poem": 2
          },
          {
            "text": "од њихове деце славу моју",
            "poem": 1
          },
          {
            "text": "довека узимате.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Устаните и идите",
            "poem": 1
          },
          {
            "text": "јер ово није место починка.",
            "poem": 2
          },
          {
            "text": "Зато што је нечисто,",
            "poem": 1
          },
          {
            "text": "биће разорено и биће то страховито разарање.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ако човек лажов, што иде низ ветар, слаже –",
            "poem": 1
          },
          {
            "text": "пророковаћу ти о вину и жестоком пићу –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "тај ће бити пророк овом народу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Обећање избављења"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Заиста, окупићу, Јакове, све вас.",
            "poem": 1
          },
          {
            "text": "Заиста, заједно ћу окупити остатак Израиљев.",
            "poem": 2
          },
          {
            "text": "Учинићу их попут оваца у тору,",
            "poem": 1
          },
          {
            "text": "попут стада посред паше његове,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да од људи буде ларма.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Пред њима ће ићи онај што продире,",
            "poem": 1
          },
          {
            "text": "па ће и они продрти, проћи кроз врата и изаћи кроз њих.",
            "poem": 2
          },
          {
            "text": "Њихов ће цар ићи пред њима",
            "poem": 1
          },
          {
            "text": "и Господ на њиховом челу.“",
            "poem": 2
          }
        ]
      }
    ],
