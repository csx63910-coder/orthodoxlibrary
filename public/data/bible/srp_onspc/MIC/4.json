  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "heading",
        "content": [
          "Гора Господња"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Догодиће се у последње дане",
          {
            "text": "и гора Дома Господњег",
            "poem": 1
          },
          {
            "text": "биће постављена врх гора,",
            "poem": 2
          },
          {
            "text": "и узвишена изнад брегова.",
            "poem": 1
          },
          {
            "text": "Пуци према њој ће се стицати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Многи народи ће ходати и говорити:",
          {
            "text": "„Хајде, попнимо се на гору Господњу",
            "poem": 1
          },
          {
            "text": "и у Дом Бога Јаковљева,",
            "poem": 2
          },
          {
            "text": "те да нас он научи путевима својим,",
            "poem": 1
          },
          {
            "text": "и да ми ходамо стазама његовим.“",
            "poem": 2
          },
          {
            "text": "Јер ће поучење изаћи са Сиона,",
            "poem": 1
          },
          {
            "text": "и реч Господња из Јерусалима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Па ће он бити судија међу многим народима,",
            "poem": 1
          },
          {
            "text": "и он ће бити меродаван за народе моћне и далеке;",
            "poem": 2
          },
          {
            "text": "те ће они мачеве прековати у раонике,",
            "poem": 1
          },
          {
            "text": "а копља у српове.",
            "poem": 2
          },
          {
            "text": "Неће више народ против народа подизати мачеве,",
            "poem": 1
          },
          {
            "text": "нити ће се више учити ратовању.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Свако ће да пребива под својом лозом",
            "poem": 1
          },
          {
            "text": "и под својом смоквом,",
            "poem": 2
          },
          {
            "text": "а неће бити никог да их плаши,",
            "poem": 1
          },
          {
            "text": "јер су тако казала уста Господа над војскама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Јер сви ће народи ходити,",
            "poem": 1
          },
          {
            "text": "свако у име свога бога,",
            "poem": 2
          },
          {
            "text": "а ми ћемо ходити у име Господа,",
            "poem": 1
          },
          {
            "text": "нашег Бога у веке векова.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Наум Господњи"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "„Тога дана – говори Господ –",
            "poem": 1
          },
          {
            "text": "окупићу хроме,",
            "poem": 2
          },
          {
            "text": "сабраћу протеране",
            "poem": 1
          },
          {
            "text": "којима сам наудио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Од хромих ћу начинити остатак",
            "poem": 1
          },
          {
            "text": "и од протераних народ моћан.",
            "poem": 2
          },
          {
            "text": "И Господ ће над њима да влада",
            "poem": 1
          },
          {
            "text": "на гори Сион од сад па довека.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "А ти, о, куло стада,",
            "poem": 1
          },
          {
            "text": "упориште ћерке сионске,",
            "poem": 2
          },
          {
            "text": "теби ће доћи и стићи ти власт,",
            "poem": 1
          },
          {
            "text": "пређашње царство ћерке Јерусалима.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Зашто сада тако јако вичеш?",
            "poem": 1
          },
          {
            "text": "Зар у теби нема цара?",
            "poem": 2
          },
          {
            "text": "Јесу ли ти пропали саветници",
            "poem": 1
          },
          {
            "text": "па те је обузео бол као породиљу?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Савиј се и напни, о, ћерко сионска,",
            "poem": 1
          },
          {
            "text": "као породиља,",
            "poem": 2
          },
          {
            "text": "јер ћеш сада изаћи из града",
            "poem": 1
          },
          {
            "text": "и живећеш на пољу.",
            "poem": 2
          },
          {
            "text": "Отићи ћеш у Вавилон",
            "poem": 1
          },
          {
            "text": "и тамо ће те избавити,",
            "poem": 2
          },
          {
            "text": "тамо ће те откупити Господ",
            "poem": 1
          },
          {
            "text": "из руку твојих непријатеља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "А сада су се против тебе",
            "poem": 1
          },
          {
            "text": "окупили народи многи,",
            "poem": 2
          },
          {
            "text": "који говоре: „Оскрнавимо је!",
            "poem": 1
          },
          {
            "text": "И нек нам се очи наслађују Сионом.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Али они не знају науме Господње",
            "poem": 1
          },
          {
            "text": "и његове одлуке не схватају,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер он их сакупља ко снопље по гумну.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "„Устани и врши, о, ћерко сионска!",
            "poem": 1
          },
          {
            "text": "Начинићу ти гвоздени рог",
            "poem": 2
          },
          {
            "text": "и бронзана копита",
            "poem": 1
          },
          {
            "text": "да смрвиш народе многе.“",
            "poem": 2
          },
          {
            "text": "Господу ћеш да посветиш њихову отимачину,",
            "poem": 1
          },
          {
            "text": "и њихово благо Господу све земље.",
            "poem": 2
          }
        ]
      }
    ],
