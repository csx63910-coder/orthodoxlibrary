  },
  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "heading",
        "content": [
          "Прекор вођама и пророцима"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Зато сам рекао:",
          {
            "text": "„Чујте, о, Јакова главари",
            "poem": 1
          },
          {
            "text": "и војводе дома Израиљевог!",
            "poem": 2
          },
          {
            "text": "Није ли на вама да знате шта је правда?",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "А ви мрзите добро и волите зло!",
            "poem": 2
          },
          {
            "text": "Кожу са њих гулите",
            "poem": 1
          },
          {
            "text": "и месо са њихових костију.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Једете месо мог народа",
            "poem": 1
          },
          {
            "text": "и кожу са њих дерете;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ломите им кости на комаде;",
            "poem": 2
          },
          {
            "text": "касапите их као за лонац,",
            "poem": 1
          },
          {
            "text": "као месо усред тигања.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Тада ће они Господу да завапе,",
            "poem": 1
          },
          {
            "text": "а он им се одазвати неће.",
            "poem": 2
          },
          {
            "text": "Сакриће од њих лице своје у оно време,",
            "poem": 1
          },
          {
            "text": "јер су починили злодела.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "„Овако каже Господ",
          {
            "text": "против пророка који заводе мој народ,",
            "poem": 1
          },
          {
            "text": "који гризу зубима и објављују мир,",
            "poem": 2
          },
          {
            "text": "а рат најављују ономе",
            "poem": 1
          },
          {
            "text": "ко им у уста ништа не ставља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Зато ће вам ноћ пасти без виђења",
            "poem": 1
          },
          {
            "text": "и тама ће вас обавити без гатања;",
            "poem": 2
          },
          {
            "text": "сунце ће над пророцима заћи",
            "poem": 1
          },
          {
            "text": "и биће оног дана мрак над њима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "И посрамиће се видеоци,",
            "poem": 1
          },
          {
            "text": "и застидеће се гатари.",
            "poem": 2
          },
          {
            "text": "Затвориће уста своја сви до једног",
            "poem": 1
          },
          {
            "text": "јер нема Божијег одговора.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "А ја сам пун снаге Господњег Духа,",
            "poem": 1
          },
          {
            "text": "правде и силе,",
            "poem": 2
          },
          {
            "text": "да објавим Јакову преступ његов",
            "poem": 1
          },
          {
            "text": "и Израиљу његов грех.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Чујте, о, главари Јаковљевог дома",
            "poem": 1
          },
          {
            "text": "и војводе дома Израиљевог,",
            "poem": 2
          },
          {
            "text": "ви што се гадите на правду",
            "poem": 1
          },
          {
            "text": "и изврћете све што је право;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "који крвљу Сион градите",
            "poem": 1
          },
          {
            "text": "и Јерусалим неправдом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Његови главари за мито суде,",
            "poem": 1
          },
          {
            "text": "за плату свештеници његови уче.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Пророци гатају за сребро,",
            "poem": 2
          },
          {
            "text": "а на Господа се позивају говорећи:",
            "poem": 1
          },
          {
            "text": "„Није ли Господ међу нама?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Неће нас зло задесити!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Зато ће због вас",
            "poem": 1
          },
          {
            "text": "преоран бити Сион,",
            "poem": 2
          },
          {
            "text": "Јерусалим у рушевине претворен,",
            "poem": 1
          },
          {
            "text": "а брдо овог Дома у зараслу шуму.",
            "poem": 2
          }
        ]
      }
    ],
