    "name": "Књига пророка Михеја",
    "commonName": "Књига пророка Михеја",
    "title": "Књига пророка Михеја",
    "order": 33,
    "numberOfChapters": 7,
    "sha256": "c20d9aa3e9b393f55eaca72a6c82b53d59bb8cc922032cb335a655bea021a87d",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/MIC/1.json",
    "lastChapterNumber": 7,
    "lastChapterApiLink": "/api/srp_onspc/MIC/7.json",
