    "lastChapterApiLink": "/api/srp_onspc/MIC/7.json",
    "totalNumberOfVerses": 105
  },
  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ово је Господња реч која је дошла Михеју Морашћанину, виђење за Самарију и Јерусалим у време Јотама, Ахаза и Језекије, царева Јуде."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Чујте, о, народи сви!",
            "poem": 1
          },
          {
            "text": "Послушај, земљо, сви ви што је испуњавате!",
            "poem": 2
          },
          {
            "text": "Нека Господ Бог против вас сведок буде,",
            "poem": 1
          },
          {
            "text": "Господ из храма светости своје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Суд над Самаријом и Јерусалимом"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Јер, гле, излази Господ из свог места,",
            "poem": 1
          },
          {
            "text": "сићи ће да гази висине земаљске.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Под њим ће се топити планине,",
            "poem": 1
          },
          {
            "text": "распукнуће се долине",
            "poem": 2
          },
          {
            "text": "као восак пред огњем,",
            "poem": 1
          },
          {
            "text": "биће као када вода низ стрмину тече.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Све је то због Јаковљевог преступа",
            "poem": 1
          },
          {
            "text": "и због греха куће израиљске.",
            "poem": 2
          },
          {
            "text": "А који је Јаковљев преступ?",
            "poem": 1
          },
          {
            "text": "Зар то није Самарија?",
            "poem": 2
          },
          {
            "text": "И које су узвишице Јудине?",
            "poem": 1
          },
          {
            "text": "Зар то није Јерусалим?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "„Самарију ћу да претворим у хрпу камења насред ледине,",
            "poem": 1
          },
          {
            "text": "у поље за засад винограда.",
            "poem": 2
          },
          {
            "text": "Камење ћу њено да изручим у долину,",
            "poem": 1
          },
          {
            "text": "оголићу њене темеље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Биће сатрвени сви њени кипови",
            "poem": 1
          },
          {
            "text": "и у ватри изгореће сви њени добици.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Уништићу све њене идоле",
            "poem": 2
          },
          {
            "text": "јер их је накупила од добити блудничке,",
            "poem": 1
          },
          {
            "text": "па ће опет бити блудничка добит.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Плач и жаљење"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Жалићу ја због овог, вапићу,",
            "poem": 1
          },
          {
            "text": "ићи ћу бос и го.",
            "poem": 2
          },
          {
            "text": "Завијаћу нарицаљку као шакал",
            "poem": 1
          },
          {
            "text": "и кликтаћу као женка ноја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Јер нема лека за њену рану",
            "poem": 1
          },
          {
            "text": "која дође све до Јуде,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "рашири се све до врата мог народа у Јерусалиму.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Не јављајте Гату,",
            "poem": 1
          },
          {
            "text": "не јецајте, не плачите.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "У Вет-Афри у прашини ваљајте се.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Бежи, становнице сафирска,",
            "poem": 1
          },
          {
            "text": "гола и осрамоћена.",
            "poem": 2
          },
          {
            "text": "Неће изаћи становница сананска",
            "poem": 1
          },
          {
            "text": "јер због нарицаљке Вет-Езела",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "тамо нећете заклон наћи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Добро чека забринута становница маротска,",
            "poem": 1
          },
          {
            "text": "јер је сишло од Господа зло на врата Јерусалима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "У бојна кола упрегни коње,",
            "poem": 1
          },
          {
            "text": "становнице Лахиса,",
            "poem": 2
          },
          {
            "text": "јер си почетак греха ћерко сионска.",
            "poem": 1
          },
          {
            "text": "У теби су се нашли преступи Израиља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Зато ћеш дати дарове Моресет-Гату,",
            "poem": 1
          },
          {
            "text": "а куће ахзивске изневериће цареве Израиља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ипак ћу ти довести освајача,",
            "poem": 1
          },
          {
            "text": "становнице мариска,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а до Одолама ће доћи слава Израиља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Оћелави и косу ошишај",
            "poem": 1
          },
          {
            "text": "за децом својом милом.",
            "poem": 2
          },
          {
            "text": "Рашири ћелу своју као лешинар,",
            "poem": 1
          },
          {
            "text": "јер ће од тебе отићи у изгнанство.",
            "poem": 2
          }
        ]
      }
    ],
