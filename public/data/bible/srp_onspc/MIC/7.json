  "chapter": {
    "number": 7,
    "content": [
      {
        "type": "heading",
        "content": [
          "Несрећа Израиља"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Јадан ли сам!",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ја сам као они који беру летње воће",
            "poem": 1
          },
          {
            "text": "и пабирче грожђе,",
            "poem": 2
          },
          {
            "text": "а нема гроздова за јело,",
            "poem": 1
          },
          {
            "text": "и нема раних смокава за којима ми душа жуди.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Нестало је верника из земље",
            "poem": 1
          },
          {
            "text": "и праведника међу људима нема.",
            "poem": 2
          },
          {
            "text": "Свако вреба крв да лије,",
            "poem": 1
          },
          {
            "text": "свако мрежом лови брата свога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Рукама су вешти у злу.",
            "poem": 1
          },
          {
            "text": "Главар захтева, судија мито тражи,",
            "poem": 2
          },
          {
            "text": "великаш казује своје прохтеве",
            "poem": 1
          },
          {
            "text": "и заједно сплеткаре.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Њихов је најбољи човек попут трна,",
            "poem": 1
          },
          {
            "text": "а праведник гори од трновог жбуна.",
            "poem": 2
          },
          {
            "text": "Стиже ти твоја казна,",
            "poem": 1
          },
          {
            "text": "дан што ти је најављен,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и сада ће настати њихова пометња.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Другу не веруј",
            "poem": 1
          },
          {
            "text": "и у пријатеља се не поуздај.",
            "poem": 2
          },
          {
            "text": "Уста своја не отварај",
            "poem": 1
          },
          {
            "text": "ни пред оном у наручју своме.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Син презире оца,",
            "poem": 1
          },
          {
            "text": "ћерка се диже на мајку своју",
            "poem": 2
          },
          {
            "text": "и снаха на свекрву своју.",
            "poem": 1
          },
          {
            "text": "Човеку ће његови укућани постати непријатељи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "А ја Господа ишчекујем,",
            "poem": 1
          },
          {
            "text": "чекам Бога мог спасења!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Услишиће мене Бог мој!",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Израиљ ће се уздигнути"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Не радуј се нада мном, о, непријатељице моја!",
            "poem": 1
          },
          {
            "text": "Јер, ако сам и пао, устаћу;",
            "poem": 2
          },
          {
            "text": "ако и у тами седим,",
            "poem": 1
          },
          {
            "text": "Господ ми је светлост!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Господњу ћу јарост да подносим –",
            "poem": 1
          },
          {
            "text": "јер сам му згрешио –",
            "poem": 2
          },
          {
            "text": "док мој случај не одбрани",
            "poem": 1
          },
          {
            "text": "и парницу моју праведно не реши.",
            "poem": 2
          },
          {
            "text": "Извешће ме он на светлост",
            "poem": 1
          },
          {
            "text": "и ја ћу гледати праведност његову.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Видеће то моја непријатељица",
            "poem": 1
          },
          {
            "text": "и срамота ће покрити ону што ме пита:",
            "poem": 2
          },
          {
            "text": "„Где је Господ, твој Бог?“",
            "poem": 1
          },
          {
            "text": "А ја ћу је посматрати,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер ће тада постати блато по друму гажено.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "То је дан градње твојих зидова,",
            "poem": 1
          },
          {
            "text": "тога дана ће се твоја међа проширити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Тога ће ти дана долазити",
            "poem": 1
          },
          {
            "text": "од Асирије до градова Египта;",
            "poem": 2
          },
          {
            "text": "и од Египта до реке Еуфрат;",
            "poem": 1
          },
          {
            "text": "од мора до мора",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и од горе до горе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "И земља ће се претворити у пустош",
            "poem": 1
          },
          {
            "text": "због њених становника,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "због плода дела њихових.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Молитва и славопој"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Палицом својом напасај свој народ,",
            "poem": 1
          },
          {
            "text": "стадо свог наследства",
            "poem": 2
          },
          {
            "text": "што пребива са̂мо у честару,",
            "poem": 1
          },
          {
            "text": "усред воћњака.",
            "poem": 2
          },
          {
            "text": "Напасај их по Васану и Галаду",
            "poem": 1
          },
          {
            "text": "као у старим временима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "„Као у данима твог изласка из египатске земље",
            "poem": 1
          },
          {
            "text": "показаћу вам чудеса.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Народи ће гледати",
            "poem": 1
          },
          {
            "text": "и застидеће се све своје снаге.",
            "poem": 2
          },
          {
            "text": "Затвориће уста своја",
            "poem": 1
          },
          {
            "text": "и уши ће им заглувети.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Лизаће прашину попут змије,",
            "poem": 1
          },
          {
            "text": "попут гмизаваца земаљских трешће се пузећи из својих утврда.",
            "poem": 2
          },
          {
            "text": "Због Господа, нашег Бога,",
            "poem": 1
          },
          {
            "text": "престрављени биће",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и плашиће те се.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ко је Бог теби налик,",
            "poem": 1
          },
          {
            "text": "што кривице прашта",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и прелази преко греха остатка свог наследства?",
            "poem": 2
          },
          {
            "text": "Не срди се довека",
            "poem": 1
          },
          {
            "text": "већ ужива у милости.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Опет ће се смиловати на нас",
            "poem": 1
          },
          {
            "text": "и згазити наше кривице.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Да, ти ћеш бацити у дубине мора све грехе њихове.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Показаћеш истину Јакову",
            "poem": 1
          },
          {
            "text": "и милост Аврахаму",
            "poem": 2
          },
          {
            "text": "како си се од давнина",
            "poem": 1
          },
          {
            "text": "заклео нашим оцима.",
            "poem": 2
          }
        ]
      }
    ],
