  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "heading",
        "content": [
          "Обећани Владар из Витлејема"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "А сада се у чете сабери, о, ти, ћерко чете!",
            "poem": 1
          },
          {
            "text": "Опсаду је против нас дигао,",
            "poem": 2
          },
          {
            "text": "палицом ударају по образу",
            "poem": 1
          },
          {
            "text": "судију Израиља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„А ти, Витлејеме Ефрато,",
            "poem": 1
          },
          {
            "text": "премда си мален међу хиљадама Јуде,",
            "poem": 2
          },
          {
            "text": "из тебе ће ми изаћи Владар Израиља,",
            "poem": 1
          },
          {
            "text": "а порекло му је од давнина,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "од вечности.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Зато ће их предати",
            "poem": 1
          },
          {
            "text": "док не буде време да роди она што ће да роди,",
            "poem": 2
          },
          {
            "text": "а остатак браће његове ће се вратити",
            "poem": 1
          },
          {
            "text": "деци Израиља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "И он ће стајати и напасаће их",
          {
            "text": "у сили Господњој",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и у слави имена Господа, Бога свога.",
            "poem": 2
          },
          {
            "text": "А они ће да почивају, јер ће се он тада величати",
            "poem": 1
          },
          {
            "text": "до крајева где земља престаје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Он ће бити тај мир,",
            "poem": 1
          },
          {
            "text": "кад Асирац дође у нашу земљу",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и ступи у дворове наше.",
            "poem": 2
          },
          {
            "text": "А ми ћемо устати против њега",
            "poem": 1
          },
          {
            "text": "са седам пастира и осам народних кнезова.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Они ће мачем потући земљу асирску",
            "poem": 1
          },
          {
            "text": "и земљу Невродову на вратима његовим;",
            "poem": 2
          },
          {
            "text": "а он ће да нас избави од Асирца",
            "poem": 1
          },
          {
            "text": "који ће доћи у нашу земљу",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и згазиће међу нашу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Јаковљев остатак ће бити међу многим народима",
            "poem": 1
          },
          {
            "text": "као роса Господња,",
            "poem": 2
          },
          {
            "text": "као ситна киша по трави",
            "poem": 1
          },
          {
            "text": "што за човека не мари",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и не чека никога од људи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Јаковљев остатак ће бити међу многим народима,",
            "poem": 1
          },
          {
            "text": "усред мноштва људи",
            "poem": 2
          },
          {
            "text": "као лав међу шумским зверима;",
            "poem": 1
          },
          {
            "text": "као лавић међу стадима оваца.",
            "poem": 2
          },
          {
            "text": "А прође ли, сатрће и растргнути,",
            "poem": 1
          },
          {
            "text": "а никога да избави.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Нек се дигне рука твоја на непријатеље твоје!",
            "poem": 1
          },
          {
            "text": "Нека се истребе сви душмани твоји!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "„И тога ћу дана – говори Господ –",
          {
            "text": "да потаманим твоје коње из твоје средине",
            "poem": 1
          },
          {
            "text": "и изломим твоја бојна кола!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Градове твоје земље ћу да срушим",
            "poem": 1
          },
          {
            "text": "и сва утврђења твоја ћу да разорим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Истребићу врачање руку твојих",
            "poem": 1
          },
          {
            "text": "и остаћеш без гатара!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Изломићу твоје кипове",
            "poem": 1
          },
          {
            "text": "и свете стубове у твојој средини,",
            "poem": 2
          },
          {
            "text": "па се више нећеш клањати",
            "poem": 1
          },
          {
            "text": "својој рукотворини.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Извалићу Аштартине ступове из твоје средине",
            "poem": 1
          },
          {
            "text": "и твоје ћу градове да порушим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "У гневу и јарости ћу се осветити",
            "poem": 1
          },
          {
            "text": "овим непослушним народима.“",
            "poem": 2
          }
        ]
      }
    ],
