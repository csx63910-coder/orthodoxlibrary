    "lastChapterApiLink": "/api/srp_onspc/DEU/34.json",
    "totalNumberOfVerses": 959
  },
  "chapter": {
    "number": 33,
    "content": [
      {
        "type": "heading",
        "content": [
          "Мојсије благосиља израиљска племена"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ово је благослов, којим је Мојсије, човек Божији, благословио народ израиљски пред своју смрт."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Рече:",
          {
            "text": "„Сиђе Господ са Синаја,",
            "poem": 1
          },
          {
            "text": "са Сира се њему објави,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "заблиста с горе Фарана,",
            "poem": 2
          },
          {
            "text": "с хиљадама својих светих дође,",
            "poem": 1
          },
          {
            "text": "у десници му пламен Закона.",
            "poem": 2
          },
          {
            "noteId": 13
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Да, ти волиш народе,",
            "poem": 1
          },
          {
            "text": "сви свети његови у руци су твојој!",
            "poem": 2
          },
          {
            "text": "Пред твоје су ноге пали,",
            "poem": 1
          },
          {
            "text": "учећи се твојим речима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Мојсије нам Закон предаде,",
            "poem": 1
          },
          {
            "text": "у наследство збора Јаковљева.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Нека буде цара у Јешуруну,",
            "poem": 1
          },
          {
            "text": "кад главари се народни сакупе,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "заједно с племенима Израиљевим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Нека живи Рувим, нека не изумре,",
            "poem": 1
          },
          {
            "text": "нек му увек шачица преостане!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "А за Јуду рече ово:",
          {
            "text": "„Услиши, Господе, глас Јудин,",
            "poem": 1
          },
          {
            "text": "и доведи га његовом народу.",
            "poem": 2
          },
          {
            "text": "Нек рукама својим право своје брани,",
            "poem": 1
          },
          {
            "text": "помоћ му буди против душмана његових.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "А за Левија рече:",
          {
            "text": "„Тумими и Урими твоји, Господе,",
            "poem": 1
          },
          {
            "text": "припадају твом верном човеку.",
            "poem": 2
          },
          {
            "text": "Њега си кушао код Масе,",
            "poem": 1
          },
          {
            "text": "с њим се свађао код вода меривских.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Он каже о оцу своме и мајци својој:",
            "poem": 1
          },
          {
            "text": "’Не видим их!’",
            "poem": 2
          },
          {
            "text": "Браћу своју не препознаје,",
            "poem": 1
          },
          {
            "text": "децу своју не примећује;",
            "poem": 2
          },
          {
            "text": "јер твоје је наредбе вршио",
            "poem": 1
          },
          {
            "text": "и твој савез чувао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Он Јакова учи твојим одредбама,",
            "poem": 1
          },
          {
            "text": "и Израиља твоме Закону.",
            "poem": 2
          },
          {
            "text": "Он кад приноси твојим ноздрвама,",
            "poem": 1
          },
          {
            "text": "и свеспалницу на твој жртвеник.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Благослови, Господе, снагу његову,",
            "poem": 1
          },
          {
            "text": "и прихвати дела руку његових.",
            "poem": 2
          },
          {
            "text": "Сломи бедра оних што устају на њега,",
            "poem": 1
          },
          {
            "text": "да не устану више његови мрзитељи.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "За Венијамина рече:",
          {
            "text": "„Господњи је он миљеник,",
            "poem": 1
          },
          {
            "text": "спокојно код њега почива;",
            "poem": 2
          },
          {
            "text": "Он га штити свакодневно,",
            "poem": 1
          },
          {
            "text": "у наручју његовом пребива.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "За Јосифа рече:",
          {
            "text": "„Нек Господ благослови земљу његову,",
            "poem": 1
          },
          {
            "text": "обиљем росе са небеса,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "те водом из дубине што лежи под земљом;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "обиљем плодова које даје сунце,",
            "poem": 1
          },
          {
            "text": "обиљем урода што дају месеци;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "првином древних гора,",
            "poem": 1
          },
          {
            "text": "и обиљем вечних брда;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "обиљем земље и њене пунине,",
            "poem": 1
          },
          {
            "text": "добром вољом оног што у грму пребива.",
            "poem": 2
          },
          {
            "text": "Све то нек се спусти на главу Јосифову,",
            "poem": 1
          },
          {
            "text": "на теме посвећеног међу својом браћом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Величанством је као во првенац,",
            "poem": 1
          },
          {
            "text": "рогови му као биволови.",
            "poem": 2
          },
          {
            "text": "Њима он пробада народе,",
            "poem": 1
          },
          {
            "text": "све до крајева земаљских.",
            "poem": 2
          },
          {
            "text": "Такво је мноштво хиљада Јефремових,",
            "poem": 1
          },
          {
            "text": "такве су хиљаде Манасијине.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "За Завулона рече:",
          {
            "text": "„Радуј се, Завулоне, у својим походима,",
            "poem": 1
          },
          {
            "text": "и ти, Исахаре, у својим шаторима!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "На планину ће позвати народе,",
            "poem": 1
          },
          {
            "text": "да принесу жртве праведне;",
            "poem": 2
          },
          {
            "text": "црпиће од обиља мора,",
            "poem": 1
          },
          {
            "text": "од блага које песак крије.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "А за Гада рече:",
          {
            "text": "„Нек је благословен онај",
            "poem": 1
          },
          {
            "text": "што шири границе Гадове!",
            "poem": 2
          },
          {
            "text": "Као лав у заседи лежи,",
            "poem": 1
          },
          {
            "text": "те раздире раме и главу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Изабрао је за себе првину,",
            "poem": 1
          },
          {
            "text": "одређену за главара.",
            "poem": 2
          },
          {
            "text": "Дошао је с главарима народа",
            "poem": 1
          },
          {
            "text": "и правду Господњу извршио,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и одредбе његове с Израиљем.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "За Дана рече:",
          {
            "text": "„Дан је лавић,",
            "poem": 1
          },
          {
            "text": "што скаче из Васана.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "За Нефталима рече:",
          {
            "text": "„Нефталим је милошћу насићен,",
            "poem": 1
          },
          {
            "text": "и испуњен благословом Господњим,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "запад и југ он ће заузети.",
            "poem": 2
          },
          {
            "noteId": 14
          },
          {
            "text": "“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "За Асира рече:",
          {
            "text": "„Благословен био Асир међу синовима,",
            "poem": 1
          },
          {
            "text": "нек миљеник буде међу својом браћом,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и нек своје ноге у уље умаче.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Нек ти браве буду од железа и бронзе,",
            "poem": 1
          },
          {
            "text": "нек ти снага траје у све твоје дане.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Нико није као Бог Јешурунов,",
            "poem": 1
          },
          {
            "text": "који по небесима језди",
            "poem": 2
          },
          {
            "text": "да ти у помоћ стигне,",
            "poem": 1
          },
          {
            "text": "и по облацима у своме величанству.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Бог исконски твоје је уточиште,",
            "poem": 1
          },
          {
            "text": "вечне мишице његове подижу те;",
            "poem": 2
          },
          {
            "text": "он пред тобом тера твога душмана,",
            "poem": 1
          },
          {
            "text": "и говори: ’Истреби!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "У спокојству живи Израиљ,",
            "poem": 1
          },
          {
            "text": "издвојен је извор Јаковљев",
            "poem": 2
          },
          {
            "text": "у земљи жита и младог вина,",
            "poem": 1
          },
          {
            "text": "где небеса росом дажде.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Срећан ли си, Израиљу!",
            "poem": 1
          },
          {
            "text": "Ко је као ти, народе,",
            "poem": 2
          },
          {
            "text": "кога Господ избавља?",
            "poem": 1
          },
          {
            "text": "Он ти је штит – твоја одбрана,",
            "poem": 2
          },
          {
            "text": "Он је мач твој – твоја победа.",
            "poem": 1
          },
          {
            "text": "Душмани твоји пузиће пред тобом,",
            "poem": 2
          },
          {
            "text": "а ти ћеш им по леђима газити.",
            "poem": 1
          },
          {
            "noteId": 15
          },
          {
            "text": "“",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": [
