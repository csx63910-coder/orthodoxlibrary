    "name": "Поновљени Закон (5. Мој)",
    "commonName": "Поновљени Закон (5. Мој)",
    "title": "Поновљени Закон или Пета књига Мојсијева",
    "order": 5,
    "numberOfChapters": 34,
    "sha256": "49188d7899ff4c5033961dd8da1f0d3ee64c20b5ada09e52a70f7c93cb428989",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/DEU/1.json",
