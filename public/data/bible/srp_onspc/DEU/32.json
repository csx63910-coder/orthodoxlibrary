    "lastChapterApiLink": "/api/srp_onspc/DEU/34.json",
    "totalNumberOfVerses": 959
  },
  "chapter": {
    "number": 32,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Чујте, небеса, говорићу,",
            "poem": 1
          },
          {
            "text": "слушај, земљо, беседу уста мојих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Као киша нека дажди поука моја,",
            "poem": 1
          },
          {
            "text": "као роса нек се спусти беседа моја,",
            "poem": 2
          },
          {
            "text": "као пљусак на младу траву,",
            "poem": 1
          },
          {
            "text": "као ситна киша на младо биље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Јер, објавићу име Господње,",
            "poem": 1
          },
          {
            "text": "величајте Бога нашега!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Он је Стена, без мане је дело његово,",
            "poem": 1
          },
          {
            "text": "јер праведни су сви путеви његови.",
            "poem": 2
          },
          {
            "text": "Бог је веран, он је беспрекоран,",
            "poem": 1
          },
          {
            "text": "праведан је он и правичан.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "А они се искварише,",
            "poem": 1
          },
          {
            "text": "нису више деца његова,",
            "poem": 2
          },
          {
            "text": "јер срама немају,",
            "poem": 1
          },
          {
            "text": "нараштај су опак и изопачен.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Зар овако враћаш Господу,",
            "poem": 1
          },
          {
            "text": "народе безумни и немудри?",
            "poem": 2
          },
          {
            "text": "Није ли он твој отац који те је створио,",
            "poem": 1
          },
          {
            "text": "који те је начинио и ојачао?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Спомените се давних дана,",
            "poem": 1
          },
          {
            "text": "расудите о годинама минулих векова.",
            "poem": 2
          },
          {
            "text": "Упитај свог оца,",
            "poem": 1
          },
          {
            "text": "он ће ти објаснити,",
            "poem": 2
          },
          {
            "text": "и своје старешине,",
            "poem": 1
          },
          {
            "text": "они ће ти рећи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Кад је Свевишњи делио наследство народима,",
            "poem": 1
          },
          {
            "text": "кад је делио потомке људске,",
            "poem": 2
          },
          {
            "text": "поставио је границе народима,",
            "poem": 1
          },
          {
            "text": "према броју синова Израиљевих",
            "poem": 2
          },
          {
            "noteId": 9
          },
          {
            "text": ".",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Јер, наследство Господње,",
            "poem": 1
          },
          {
            "text": "народ је његов,",
            "poem": 2
          },
          {
            "text": "Јаков је део његов,",
            "poem": 1
          },
          {
            "text": "његово је он наследство.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Нашао га је у земљи пустињској,",
            "poem": 1
          },
          {
            "text": "у пустари страшној где ничега нема.",
            "poem": 2
          },
          {
            "text": "Бранио га је, збринуо га",
            "poem": 1
          },
          {
            "text": "и заштитио ко зеницу ока свога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Као што орао бди над својим гнездом,",
            "poem": 1
          },
          {
            "text": "и лебди над својим птићима,",
            "poem": 2
          },
          {
            "text": "као што шири своја крила и узима их,",
            "poem": 1
          },
          {
            "text": "те их носи на својим перима,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "тако их је сам Господ водио;",
            "poem": 1
          },
          {
            "text": "другог бога не би поред њега.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "На висине га је земаљске посадио,",
            "poem": 1
          },
          {
            "text": "те је јео урод са поља,",
            "poem": 2
          },
          {
            "text": "хранио га медом из литице,",
            "poem": 1
          },
          {
            "text": "и уљем из најтврђе стене;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "маслом од стоке,",
            "poem": 1
          },
          {
            "text": "млеком од стада,",
            "poem": 2
          },
          {
            "text": "овновима и јарцима васанским",
            "poem": 1
          },
          {
            "text": "и пшеницом понајбољом.",
            "poem": 2
          },
          {
            "text": "Пио си вино, крв грожђа.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Угојио се Јешурун",
            "poem": 1
          },
          {
            "noteId": 10
          },
          {
            "text": ",",
            "poem": 1
          },
          {
            "text": "узјогунио се,",
            "poem": 2
          },
          {
            "text": "усалио си се, окрупњао и наситио,",
            "poem": 1
          },
          {
            "text": "оставио је Бога који га је начинио,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "отпао је од Стене свога спасења.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Боговима туђим љубомору му изазваше,",
            "poem": 1
          },
          {
            "text": "и идолима одвратним гнев му распалише.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Злодусима, а не Богу, жртве су приносили,",
            "poem": 1
          },
          {
            "text": "боговима које нису познавали,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "боговима новим, скоро приспелим,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "које преци ваши познавали нису.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Занемарио си Стену која те је зачела,",
            "poem": 1
          },
          {
            "text": "заборавио Бога, који те је родио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Видео је то Господ, па их је одбацио,",
            "poem": 1
          },
          {
            "text": "јер синови га и ћерке разгневише.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Тада рече: „Своје лице ћу од њих сакрити,",
            "poem": 1
          },
          {
            "text": "да видим како ће свршити;",
            "poem": 2
          },
          {
            "text": "јер нараштај су они изопачени,",
            "poem": 1
          },
          {
            "text": "деца која немају верности.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "На љубомору су ме изазвали,",
            "poem": 1
          },
          {
            "text": "богом који Бог није,",
            "poem": 2
          },
          {
            "text": "разгневили ме својим ништавилима.",
            "poem": 1
          },
          {
            "text": "Зато ћу их учинити љубоморним",
            "poem": 2
          },
          {
            "text": "народом који није народ,",
            "poem": 1
          },
          {
            "text": "раздражићу их народом безумним.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Јер, мој гнев је ватру запалио,",
            "poem": 1
          },
          {
            "text": "и гореће све до дубина Света мртвих",
            "poem": 2
          },
          {
            "noteId": 11
          },
          {
            "text": ";",
            "poem": 2
          },
          {
            "text": "прогутаће и земљу и плод њен,",
            "poem": 1
          },
          {
            "text": "спалиће темеље горске.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Стога, невоље ћу на њих згрнути,",
            "poem": 1
          },
          {
            "text": "на њих ћу своје одапети стреле.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Глад ће их похарати,",
            "poem": 1
          },
          {
            "text": "сатрће их пошасти и љуте заразе!",
            "poem": 2
          },
          {
            "text": "Чељусти зверске на њих ћу послати,",
            "poem": 1
          },
          {
            "text": "с отровом гмизаваца што пузе у прашини.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Напољу ће мач узимати децу,",
            "poem": 1
          },
          {
            "text": "а унутра ће ужас обузимати",
            "poem": 2
          },
          {
            "text": "како момка, тако и девојку,",
            "poem": 1
          },
          {
            "text": "како дојенче, тако седу главу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Рекао бих: ’У прах ћу их смрвити,",
            "poem": 1
          },
          {
            "text": "њих ћу избрисати из сећања људи’,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "да ми није до гневнога непријатеља:",
            "poem": 1
          },
          {
            "text": "душмани би се њихови могли преварити,",
            "poem": 2
          },
          {
            "text": "говорећи: ’Наша их је рука надјачала,",
            "poem": 1
          },
          {
            "text": "све то Господ није учинио.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Јер, они су народ што нема разума,",
            "poem": 1
          },
          {
            "text": "расуђивања међу њима нема.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Кад би само били мудри,",
            "poem": 1
          },
          {
            "text": "то би они размотрили,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "схватили би свој свршетак.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Зар би један могао да гони хиљаду,",
            "poem": 1
          },
          {
            "text": "и да двојица десет хиљада потерају,",
            "poem": 2
          },
          {
            "text": "да их Стена њихова није продала,",
            "poem": 1
          },
          {
            "text": "да их Господ њима није изручио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Јер, стена њихова није као наша Стена;",
            "poem": 1
          },
          {
            "text": "то и душмани наши могу да просуде.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Јер, вино њихово,",
            "poem": 1
          },
          {
            "text": "од лозе је содомске, а са поља гоморских.",
            "poem": 2
          },
          {
            "text": "Грожђе је његово, грожђе отровано,",
            "poem": 1
          },
          {
            "text": "гроздови му сама горчина.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Вино је њихово отров змијин",
            "poem": 1
          },
          {
            "text": "и љути је отров аспидин.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "„Није ли он безбедан код мене,",
            "poem": 1
          },
          {
            "text": "запечаћен у мојим ризницама?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Моја је освета! Ја ћу узвратити,",
            "poem": 1
          },
          {
            "text": "кад им нога буде посрнула.",
            "poem": 2
          },
          {
            "text": "Јер близу је дан њихове несреће,",
            "poem": 1
          },
          {
            "text": "пропаст њихова брзо се примиче.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Господ ће судити своме народу,",
            "poem": 1
          },
          {
            "text": "на своје ће се слуге сажалити,",
            "poem": 2
          },
          {
            "text": "кад види да их снага напушта,",
            "poem": 1
          },
          {
            "text": "да крај дође робу и слободном.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Питаће: „Где су сада богови њихови,",
            "poem": 1
          },
          {
            "text": "где ли стена којом се заклањаше?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "Јели су сало њихових жртава,",
            "poem": 1
          },
          {
            "text": "и пили вино њихових изливница.",
            "poem": 2
          },
          {
            "text": "Нека устану да вам помогну,",
            "poem": 1
          },
          {
            "text": "нек вам они буду заштита.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          {
            "text": "Видите сада да сам ја онај,",
            "poem": 1
          },
          {
            "text": "и да другог бога поред мене нема.",
            "poem": 2
          },
          {
            "text": "Ја усмрћујем и ја оживљујем,",
            "poem": 1
          },
          {
            "text": "ја рањавам и ја зацељујем;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "из моје се руке нико не избавља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          {
            "text": "Дижем своју руку према небу и кажем:",
            "poem": 1
          },
          {
            "text": "Не био ја жив до века,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          {
            "text": "ако не наоштрим мач свој сјајни,",
            "poem": 1
          },
          {
            "text": "да суд узмем у своје руке,",
            "poem": 2
          },
          {
            "text": "да одмаздом вратим душманима,",
            "poem": 1
          },
          {
            "text": "и отплатим онима који мене мрзе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          {
            "text": "Своје стреле напојићу крвљу,",
            "poem": 1
          },
          {
            "text": "мач мој најешће се меса:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "крвљу покланих и заробљених,",
            "poem": 2
          },
          {
            "text": "и дугокосим главама",
            "poem": 1
          },
          {
            "text": "челника душманских.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          {
            "text": "Радујте се, пуци, народе његов,",
            "poem": 1
          },
          {
            "text": "јер крв ће слугу својих осветити,",
            "poem": 2
          },
          {
            "text": "одмаздом ће узвратити својим душманима,",
            "poem": 1
          },
          {
            "text": "и откупиће своју земљу и свој народ.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "Мојсије дође са Осијом",
          {
            "noteId": 12
          },
          ", сином Навиновим, и изговори све речи ове песме на уши свег народа."
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "Кад је Мојсије завршио да саопштава све ове речи целом Израиљу,"
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "рекао им је: „Узмите к срцу све речи којима вас упозоравам данас. Наредићеш својој деци да држе и врше све речи овога Закона."
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          "Ово нису празне речи; оне су ваш живот. Вршећи их, дуго ћете живети у земљи коју ћете заузети кад пређете преко Јордана.“"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Напомена Мојсијеве смрти"
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          "Тог истог дана, Господ рече Мојсију:"
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          "„Попни се на ову гору Аварим, гору Навав, која је у земљи моавској, код Јерихона, и погледај земљу хананску, коју дајем синовима Израиљевим у наследство."
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          "Тамо на гори на коју се пењеш ћеш умрети и придружити се своме народу, као што је твој брат Арон умро на гори Ор, придруживши се своме народу."
        ]
      },
      {
        "type": "verse",
        "number": 51,
        "content": [
          "Јер ви сте ми се изневерили пред Израиљцима, у време Мериве кадиске у пустињи Цин, кад нисте показали моју светост пред Израиљцима."
        ]
      },
      {
        "type": "verse",
        "number": 52,
        "content": [
          "Зато ћеш само издалека видети земљу, али у ту земљу, коју дајем народу израиљском, нећеш ући.“"
        ]
      }
    ],
