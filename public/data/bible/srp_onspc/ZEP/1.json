  },
  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Реч Господња која је дошла Софонији, Кушијевом сину и потомку Годолије, Амарије и Језекије у време Амоновог сина Јосије, цара Јуде."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Суд целе земље на дан Господњи"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Збрисаћу, докрајчићу",
            "poem": 1
          },
          {
            "text": "све са лица земље",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Докрајчићу и човека и звер,",
            "poem": 1
          },
          {
            "text": "докрајчићу птице с неба,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "рибе из мора",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и пакости са све пакоснима.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Истребићу људе са лица земље",
            "poem": 1
          },
          {
            "text": "– говори Господ.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Подигнућу своју руку на Јуду",
            "poem": 1
          },
          {
            "text": "и на сав живаљ Јерусалима.",
            "poem": 2
          },
          {
            "text": "Истребићу са овог места Валов остатак",
            "poem": 1
          },
          {
            "text": "и спомен на идолопоклоничке свештенике",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "с другим свештеницима;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "оне што се по крововима",
            "poem": 1
          },
          {
            "text": "клањају војсци небеској,",
            "poem": 2
          },
          {
            "text": "оне који се клањају и заклињу Господу",
            "poem": 1
          },
          {
            "text": "али се заклињу и Молоху",
            "poem": 2
          },
          {
            "noteId": 0
          },
          {
            "text": ";",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "оне што се окрећу од Господа,",
            "poem": 1
          },
          {
            "text": "оне што не траже Господа и за њега не питају.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Тишина пред Господом Богом",
            "poem": 1
          },
          {
            "text": "јер је близу дан Господњи!",
            "poem": 2
          },
          {
            "text": "Спремио је Господ жртву,",
            "poem": 1
          },
          {
            "text": "сазвао је госте своје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "„А на дан Господње жртве",
            "poem": 1
          },
          {
            "text": "судићу главаре,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "цареве синове",
            "poem": 2
          },
          {
            "text": "и све који носе",
            "poem": 1
          },
          {
            "text": "одело туђинца.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Казнићу све који тога дана",
            "poem": 1
          },
          {
            "text": "прескачу преко прага,",
            "poem": 2
          },
          {
            "text": "који куће својих господара",
            "poem": 1
          },
          {
            "text": "пуне насиљем и преваром.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Тога ће се дана чути",
            "poem": 1
          },
          {
            "text": "– говори Господ –",
            "poem": 2
          },
          {
            "text": "плач невоље са Рибљих врата,",
            "poem": 1
          },
          {
            "text": "запомагање са другог краја",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и велика ломљава са брда.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Кукајте, о, становници Мактеса,",
            "poem": 1
          },
          {
            "text": "јер гине сав народ који тргује,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "биће побијени сви који мере сребро.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "У то време ћу светиљкама да претражим Јерусалим.",
            "poem": 1
          },
          {
            "text": "Судићу народу полеглом ко вино по талогу своме,",
            "poem": 2
          },
          {
            "text": "који у срцу свом говори:",
            "poem": 1
          },
          {
            "text": "’Господ не чини добро, а ни зло не чини!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Благо ће им плен постати",
            "poem": 1
          },
          {
            "text": "и опустеће им куће.",
            "poem": 2
          },
          {
            "text": "Куће ће зидати,",
            "poem": 1
          },
          {
            "text": "али живети у њима неће,",
            "poem": 2
          },
          {
            "text": "садиће винограде,",
            "poem": 1
          },
          {
            "text": "али вино њихово неће пити.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Близу је велики дан Господњи!",
            "poem": 1
          },
          {
            "text": "Близу је и све је ближи и ближи!",
            "poem": 2
          },
          {
            "text": "Горак је повик дана Господњег",
            "poem": 1
          },
          {
            "text": "и ено виче ратник.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Тај дан ће бити дан гнева,",
            "poem": 1
          },
          {
            "text": "дан невоље и страдања,",
            "poem": 2
          },
          {
            "text": "дан разарања и пустошења,",
            "poem": 3
          },
          {
            "text": "дан мрклог мрака,",
            "poem": 2
          },
          {
            "text": "дан облака и густе таме;",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "дан труба и бојног поклича",
            "poem": 2
          },
          {
            "text": "над градовима утврђеним,",
            "poem": 1
          },
          {
            "text": "над кулама високим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "„Нанећу бол људима",
            "poem": 1
          },
          {
            "text": "па ће ићи као да су слепи,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер су Господу сагрешили.",
            "poem": 2
          },
          {
            "text": "Просуће се крв њихова као прах",
            "poem": 1
          },
          {
            "text": "и као ђубриво њихове утробе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ни њихово сребро ни злато њихово",
            "poem": 1
          },
          {
            "text": "неће моћи да их спасе",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "на дан гнева Господњег.“",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Пламен његове ревности",
            "poem": 1
          },
          {
            "text": "прождраће сву земљу,",
            "poem": 2
          },
          {
            "text": "јер ће сигурно и страшно докрајчити",
            "poem": 1
          },
          {
            "text": "сав живаљ земаљски.",
            "poem": 2
          }
        ]
      }
    ],
