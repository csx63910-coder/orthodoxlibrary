  },
  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "heading",
        "content": [
          "Јуда и Јерусалим осуђени са народима"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Јуда сабрана на покајање"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Саберите се! Саберите се,",
            "poem": 1
          },
          {
            "text": "о, народе који стида немаш,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "пре него се осуда оствари",
            "poem": 1
          },
          {
            "text": "и дан прође као плева;",
            "poem": 2
          },
          {
            "text": "пре него на вас дође",
            "poem": 1
          },
          {
            "text": "пламен гнева Господњег,",
            "poem": 2
          },
          {
            "text": "пре него на вас дође",
            "poem": 1
          },
          {
            "text": "дан гнева Господњег.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Тражите Господа, о, сви понизни у земљи,",
            "poem": 1
          },
          {
            "text": "који извршавате његове судове.",
            "poem": 2
          },
          {
            "text": "Тражите праведност! Тражите понизност,",
            "poem": 1
          },
          {
            "text": "па можда на дан гнева Господњег",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "скривени будете.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Филистеја"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Јер Газа ће бити напуштена,",
            "poem": 1
          },
          {
            "text": "Аскалон ће пустош постати,",
            "poem": 2
          },
          {
            "text": "Азоту ће народ истерати у по бела дана,",
            "poem": 1
          },
          {
            "text": "а Акарон ће бити искорењен.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Јао Херећанима,",
            "poem": 1
          },
          {
            "text": "становницима приморског краја!",
            "poem": 2
          },
          {
            "text": "О, Ханане,",
            "poem": 1
          },
          {
            "text": "реч је Господња против тебе,",
            "poem": 2
          },
          {
            "text": "земљо филистејска:",
            "poem": 1
          },
          {
            "text": "„Уништићу ти сваког живог!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Приморски ће крај постати пашњаци,",
            "poem": 1
          },
          {
            "text": "пастирске ливаде",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и торови за овце.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Зато ће овај крај припасти",
            "poem": 1
          },
          {
            "text": "остатку дома Јудиног",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и по њему ће се напасати.",
            "poem": 2
          },
          {
            "text": "Увече ће легати",
            "poem": 1
          },
          {
            "text": "по кућама Аскалона",
            "poem": 2
          },
          {
            "text": "јер ће их се сетити Господ, Бог њихов,",
            "poem": 1
          },
          {
            "text": "и вратиће њихове изгнанике.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Моав и Амон"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "„Чуо сам ругање Моаваца",
            "poem": 1
          },
          {
            "text": "и понижавање Амонаца.",
            "poem": 2
          },
          {
            "text": "Они хуле на мој народ,",
            "poem": 1
          },
          {
            "text": "осилили су се на њиховој граници.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Зато, живота ми мога",
            "poem": 1
          },
          {
            "text": "– говори Господ над војскама,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Бог Израиљев –",
            "poem": 2
          },
          {
            "text": "Моавци ће бити као Содома,",
            "poem": 1
          },
          {
            "text": "а Амонци као Гомора:",
            "poem": 2
          },
          {
            "text": "царство коприва, слана јама",
            "poem": 1
          },
          {
            "text": "и вечна пустош.",
            "poem": 2
          },
          {
            "text": "Похараће их остатак мог народа,",
            "poem": 1
          },
          {
            "text": "преостали од мога народа ће их запосести.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "И ово им је уместо њиховог поноса,",
            "poem": 1
          },
          {
            "text": "јер су осионо понижавали",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "народ Господа над војскама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Биће Господ страшан према њима",
            "poem": 1
          },
          {
            "text": "јер ће помести све богове земаљске.",
            "poem": 2
          },
          {
            "text": "Сва острва народа ће му се поклонити,",
            "poem": 1
          },
          {
            "text": "баш свако са свог места.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Куш"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "„А и ви, о, Кушани,",
            "poem": 1
          },
          {
            "text": "бићете сасечени мачем мојим!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Асирија"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Пружиће он руку своју на север",
            "poem": 1
          },
          {
            "text": "и уништиће Асирију.",
            "poem": 2
          },
          {
            "text": "Ниниву ће учинити пустаром",
            "poem": 1
          },
          {
            "text": "спрженом као пустиња.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Крда ће лежати по њој",
            "poem": 1
          },
          {
            "text": "и све врсте животиња.",
            "poem": 2
          },
          {
            "text": "Буљина и сова",
            "poem": 1
          },
          {
            "text": "по њеним стубовима ноћ проводе,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "хучу на прозору.",
            "poem": 2
          },
          {
            "text": "Разваљен ће бити праг",
            "poem": 1
          },
          {
            "text": "јер је он изломио даску од кедра.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Такав ће бити охоли град",
            "poem": 1
          },
          {
            "text": "што спокојно почива,",
            "poem": 2
          },
          {
            "text": "који у свом срцу каже:",
            "poem": 1
          },
          {
            "text": "„Ја једини и нико као ја!“",
            "poem": 2
          },
          {
            "text": "Како си постао пустош,",
            "poem": 1
          },
          {
            "text": "брлог сваке звери!",
            "poem": 2
          },
          {
            "text": "Ко год мимо њега прође звиждаће,",
            "poem": 1
          },
          {
            "text": "одмахнуће руком.",
            "poem": 2
          }
        ]
      }
    ],
