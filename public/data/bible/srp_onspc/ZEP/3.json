  "book": {
    "id": "ZEP",
    "translationId": "srp_onspc",
    "name": "Књига пророка Софоније",
    "commonName": "Књига пророка Софоније",
    "title": "Књига пророка Софоније",
    "order": 36,
    "numberOfChapters": 3,
    "sha256": "20ef8bc09fdf7ae8b44cad06751dd2f6d55d91b628e393affa1929d595c03619",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/ZEP/1.json",
    "lastChapterNumber": 3,
    "lastChapterApiLink": "/api/srp_onspc/ZEP/3.json",
    "totalNumberOfVerses": 53
  },
  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "heading",
        "content": [
          "Јерусалим"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Јао поганом и оскрнављеном граду силеџији!",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Он не слуша глас",
            "poem": 1
          },
          {
            "text": "и не прихвата прекор Господњи.",
            "poem": 2
          },
          {
            "text": "Не поуздаје се у Бога свога",
            "poem": 1
          },
          {
            "text": "и не прилази му.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Усред њега главари његови",
            "poem": 1
          },
          {
            "text": "су лавови што ричу,",
            "poem": 2
          },
          {
            "text": "судије су му ноћни вуци",
            "poem": 1
          },
          {
            "text": "што до јутра све кости оглођу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Његови пророци су бахати,",
            "poem": 1
          },
          {
            "text": "људи издајници.",
            "poem": 2
          },
          {
            "text": "Свештеници његови светињу скрнаве",
            "poem": 1
          },
          {
            "text": "и Закон крше.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Праведан је Господ усред њега!",
            "poem": 1
          },
          {
            "text": "Он не чини неправду.",
            "poem": 2
          },
          {
            "text": "Свако јутро своју правду даје",
            "poem": 1
          },
          {
            "text": "и кад сване он се не повлачи.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Али злотвор ни тад за срамоту не зна.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Јерусалим се не каје"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "„Затро сам народе",
            "poem": 1
          },
          {
            "text": "и срушио им куле.",
            "poem": 2
          },
          {
            "text": "Улице сам им опустошио",
            "poem": 1
          },
          {
            "text": "да ни пролазника нема.",
            "poem": 2
          },
          {
            "text": "Градове им зарушио",
            "poem": 1
          },
          {
            "text": "и никога нема,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "нема становника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "А рекох:",
            "poem": 1
          },
          {
            "text": "’Свакако ћеш ме се уплашити,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "прихватићеш прекор.’",
            "poem": 2
          },
          {
            "text": "Тада му се неће порушити пребивалиште",
            "poem": 1
          },
          {
            "text": "свим оним што сам наумио за њега.",
            "poem": 2
          },
          {
            "text": "Ипак, упорно су грешили",
            "poem": 1
          },
          {
            "text": "свим делима својим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Зато ме чекајте",
            "poem": 1
          },
          {
            "text": "– говори Господ –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "до дана када ћу се дићи због плена.",
            "poem": 2
          },
          {
            "text": "Јер је моја одлука да окупим народе,",
            "poem": 1
          },
          {
            "text": "да саберем царства",
            "poem": 2
          },
          {
            "text": "и на њих излијем своју јарост",
            "poem": 1
          },
          {
            "text": "и сав пламен гнева свога.",
            "poem": 2
          },
          {
            "text": "Тако ће у ватри ревности моје",
            "poem": 1
          },
          {
            "text": "сва земља бити прогутана.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Обнова остатка Израиља"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Тада ћу да дам народима чиста уста",
            "poem": 1
          },
          {
            "text": "да сваки од њих призива име Господње",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и раме уз раме му служе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "С друге стране, од река кушанских,",
            "poem": 1
          },
          {
            "text": "донеће ми житне жртве моји молиоци,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ћерка мојих расејаних.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Нећеш се стидети тога дана свих својих поступака",
            "poem": 1
          },
          {
            "text": "којима си се бунио против мене.",
            "poem": 2
          },
          {
            "text": "Тада ћу уклонити од тебе оне охоле,",
            "poem": 1
          },
          {
            "text": "твоје поносите,",
            "poem": 2
          },
          {
            "text": "па се више нећеш бахатити",
            "poem": 1
          },
          {
            "text": "на мојој светој гори.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "У теби ћу оставити",
            "poem": 1
          },
          {
            "text": "народ кротак и сиромашан,",
            "poem": 2
          },
          {
            "text": "и они ће уточиште наћи",
            "poem": 1
          },
          {
            "text": "у имену Господњем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Остатак Израиља неће чинити неправду",
            "poem": 1
          },
          {
            "text": "и лажи неће говорити.",
            "poem": 2
          },
          {
            "text": "Неће им у устима бити језик обмане",
            "poem": 1
          },
          {
            "text": "него ће се напасати и почиваће.",
            "poem": 2
          },
          {
            "text": "Неће бити никог да их плаши.“",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Кличи, ћерко сионска!",
            "poem": 1
          },
          {
            "text": "Подвикуј, Израиљу!",
            "poem": 2
          },
          {
            "text": "Радуј се и величај од свег срца,",
            "poem": 1
          },
          {
            "text": "о, ћерко јерусалимска!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Уклонио је Господ пресуду против тебе,",
            "poem": 1
          },
          {
            "text": "помео је душмане твоје.",
            "poem": 2
          },
          {
            "text": "Цар Израиља – Господ је у средини твојој!",
            "poem": 1
          },
          {
            "text": "Од зла се ти више не плаши.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Тог дана ће се рећи Јерусалиму:",
            "poem": 1
          },
          {
            "text": "„О, Сионе, не плаши се!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Нека ти руке не клону!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Господ, Бог твој је усред тебе,",
            "poem": 1
          },
          {
            "text": "ратник што ти победу даје.",
            "poem": 2
          },
          {
            "text": "Радоваће се силно због тебе,",
            "poem": 1
          },
          {
            "text": "утишаће те љубављу својом.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Клицаће због тебе радосним повиком.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "„Ојађене, одстрањене од празника",
            "poem": 1
          },
          {
            "text": "ја ћу да окупим.",
            "poem": 2
          },
          {
            "text": "Били су далеко од тебе,",
            "poem": 1
          },
          {
            "text": "обремењени срамотом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ево, окрећем се свим твојим тлачитељима у време ово.",
            "poem": 1
          },
          {
            "text": "Спашћу хроме и сабраћу протеране.",
            "poem": 2
          },
          {
            "text": "Даћу част и име осрамоћенима",
            "poem": 1
          },
          {
            "text": "што су били по целој земљи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Довешћу вас у оно време,",
            "poem": 1
          },
          {
            "text": "у то време ја ћу вас сабрати.",
            "poem": 2
          },
          {
            "text": "Јер ја ћу вам дати и име и част",
            "poem": 1
          },
          {
            "text": "међу свим земаљским народима,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "када на ваше очи вратим изгнане ваше“ –",
            "poem": 2
          },
          {
            "text": "каже Господ.",
            "poem": 3
          }
        ]
      }
    ],
