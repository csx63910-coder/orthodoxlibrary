  "book": {
    "id": "1SA",
    "translationId": "srp_onspc",
    "name": "1. Књига Самуилова",
    "commonName": "1. Књига Самуилова",
    "title": "Прва књига Самуилова",
    "order": 9,
    "numberOfChapters": 31,
    "sha256": "93a34689882cf46820131e5891bfec8cbea5147a810bdbee95a34ec451a0015d",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/1SA/1.json",
