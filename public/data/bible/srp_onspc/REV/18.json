  "chapter": {
    "number": 18,
    "content": [
      {
        "type": "heading",
        "content": [
          "Пад Вавилона"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "После овога сам видео другог анђела како силази са неба са великом влашћу. Његова слава обасјала је целу земљу."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Тада анђео повика јаким гласом:",
          {
            "text": "„Паде, паде, велики Вавилон,",
            "poem": 1
          },
          {
            "text": "и постаде пребивалиште злих духова",
            "poem": 2
          },
          {
            "text": "и склониште свих нечистих духова,",
            "poem": 1
          },
          {
            "text": "склониште свим нечистим птицама",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и свим нечистим и мрским зверима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Јер сви су се народи напојили",
            "poem": 1
          },
          {
            "text": "жестоким вином њенога блудничења.",
            "poem": 2
          },
          {
            "text": "Цареви света с њом су блудничили,",
            "poem": 1
          },
          {
            "text": "а светски се трговци обогатили од њене силне раскоши!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Затим сам чуо други глас са неба како говори:",
          {
            "text": "„Народе мој, изађи из тог града,",
            "poem": 1
          },
          {
            "text": "да не будете учесници у његовим гресима,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и да вас не снађу његова зла.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Јер греси се њени нагомилаше до неба,",
            "poem": 1
          },
          {
            "text": "и Бог се сетио њених неправди.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Вратите јој истом мером,",
            "poem": 1
          },
          {
            "text": "вратите јој двоструко више за њена дела;",
            "poem": 2
          },
          {
            "text": "улијте јој у чашу двоструку меру оног",
            "poem": 1
          },
          {
            "text": "што је замешала другима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Задајте јој муке и жалости",
            "poem": 1
          },
          {
            "text": "онолико колико је себи дала славе и раскоши!",
            "poem": 2
          },
          {
            "text": "Јер она говори у своме срцу:",
            "poem": 1
          },
          {
            "text": "’Седим на престолу као царица,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "нисам удовица и жалости нећу искусити.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Зато ће се у један дан сручити на њу сва ова зла:",
            "poem": 1
          },
          {
            "text": "смрт, жалост и глад.",
            "poem": 2
          },
          {
            "text": "И прождреће је ватра,",
            "poem": 1
          },
          {
            "text": "јер је силан Господ Бог који јој суди.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "За њом ће плакати и нарицати сви цареви света који су с њом блудничили и уживали у њеној раскоши, када виде дим и њу сву у пламену."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Преплашени њеним мукама, стајаће издалека и говорити:",
          {
            "text": "„Јао, јао, велики граде Вавилоне, силни граде,",
            "poem": 1
          },
          {
            "text": "јер у један час наста твој суд!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "А светски ће трговци плакати и нарицати за њом, јер нико више не купује њихову робу:"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "злато, сребро, драго камење, бисере, танани лан, порфиру, свилу, скерлет, разна мирисна дрвета, сваковрсне посуде од слоноваче, предмете начињене од скупоценог дрвета, бронзе, гвожђа и мрамора;"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "цимет, балзам, миомирис, мирисава уља, тамјан, вино, уље, бело брашно, пшеницу, стоку, овце и коње, кола, робове и људске душе."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Остала си без воћа за којим си чезнула, сва твоја раскош и сјај пропали су и више их нећеш повратити."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Трговци који су овим трговали и обогатили се од ње, стајаће издалека обузети страхом због њених мука, плачући и наричући."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Говориће:",
          {
            "text": "„Јао, јао, велики граде,",
            "poem": 1
          },
          {
            "text": "који си се облачио у лан, порфиру и скерлет,",
            "poem": 2
          },
          {
            "text": "и китио се златом, драгим камењем и бисерима!",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "У један час опусте толико богатство!“",
            "poem": 2
          },
          "И сви кормилари, сви морнари и морепловци, стајали су издалека."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Видевши дим који се подиже из града у пожару, јадиковали су и говорили: „Који је град био као овај велики град?“"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Они посуше прашину на своје главе јадикујући и плачући:",
          {
            "text": "„Јао, јао, велики граде!",
            "poem": 1
          },
          {
            "text": "Од његовог изобиља се обогатише",
            "poem": 2
          },
          {
            "text": "сви који су имали бродове на мору,",
            "poem": 1
          },
          {
            "text": "а у један је час опустео.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Весели се над њим, небо!",
            "poem": 1
          },
          {
            "text": "Веселите се над њим, ви свети, апостоли и пророци,",
            "poem": 2
          },
          {
            "text": "јер га је Бог казнио због оног што је учинио вама!“",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Тада је један моћни анђео подигао камен, велик као млински, и бацио га у море, говорећи:",
          {
            "text": "„Овако ће бити бачен велики град Вавилон",
            "poem": 1
          },
          {
            "text": "и неће га више бити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Музика китаристе, музичара, флаутиста и трубача",
            "poem": 1
          },
          {
            "text": "неће се више чути у теби,",
            "poem": 2
          },
          {
            "text": "нити ће се који уметник више наћи у теби,",
            "poem": 1
          },
          {
            "text": "а ни звук млина се неће више чути.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Светлост светиљке",
            "poem": 1
          },
          {
            "text": "неће више засјати у теби,",
            "poem": 2
          },
          {
            "text": "нити ће се глас младожење и невесте",
            "poem": 1
          },
          {
            "text": "икад чути у теби,",
            "poem": 2
          },
          {
            "text": "зато што су твоји трговци били светски моћници,",
            "poem": 1
          },
          {
            "text": "и зато што је твоје врачање довело у заблуду све народе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Уз то се у теби пролила крв пророка и светих,",
            "poem": 1
          },
          {
            "text": "и свих оних који су убијени на земљи.“",
            "poem": 2
          }
        ]
      }
    ],
