  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "heading",
        "content": [
          "Сврха Лукиног писања"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Пошто су већ многи предузели да опишу догађаје који су се испунили међу нама,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "онако како су нам пренели они који су од почетка били очевици и слуге Божије речи,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "стога сам и ја сматрао за сходно, пошто сам све подробно од почетка испитао, да ти то напишем по реду, уважени Теофиле,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "да се увериш у веродостојност онога чему си поучен."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Рођење Јована Крститеља"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "У време када је цар Ирод владао над Јудејом, био је један свештеник по имену Захарија. Он је припадао Авијином реду. Жена му је водила порекло од Арона. Звала се Јелисавета."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Обоје су били праведни пред Богом, беспрекорно живећи по заповестима и захтевима Господњим."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Деце нису имали, јер је Јелисавета била нероткиња, а обоје су већ били у поодмаклим годинама."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Једном је Захарија, по редоследу свог реда, вршио службу у храму пред Богом."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Он је, по свештеничком обичају, коцком био изабран да уђе у храм Господњи и принесе кад."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Док се кад приносио, много народа се молило у предворју."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Тада се појави анђео Господњи и стаде с десне стране кадионог жртвеника."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Захарија се узнемири и силно се препадне угледавши анђела."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Анђео му рече: „Не бој се, Захарија! Твоја молитва је услишена. Твоја жена Јелисавета ће ти родити сина, и ти ћеш му дати име ’Јован’."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Он ће ти бити на радост и весеље и многи ће се радовати његовом рођењу."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Јер, он ће бити велики пред Господом. Он неће пити ни вина, ни жестока пића, а Духом Светим биће испуњен још у мајчиној утроби."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Многе ће Израиљце окренути Господу, њиховом Богу."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Ступаће као весник пред Господом, у Илијином духу и сили; да измири очеве са синовима и да врати непослушне на пут разборитости праведничке, те да припреми народ за Господа.“"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Захарија рече анђелу: „По чему ћу то знати? Ја сам, ево, стар човек, а и моја жена је већ зашла у године.“"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Анђео му одговори: „Ја сам Гаврило који стојим у Божијем присуству. Бог ме је послао да говорим с тобом и да ти саопштим ову радосну вест."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Будући да ниси поверовао мојим речима, занемећеш и нећеш моћи да говориш све до дана када ће се ово догодити. Ово ће се испунити у право време.“"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "А народ који је чекао Захарију, чудио се што се он тако дуго задржао у храму."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Када је Захарија изашао из храма, није могао да им говори. Они су онда схватили да је имао виђење у храму. Давао им је знакове; није могао да говори."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Кад је истекло време његове службе, Захарија се вратио кући."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Нешто након тога, његова жена Јелисавета затрудни. Крила се пет месеци, говорећи:"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "„Ово је Господ учинио за мене у време када му се свидело да уклони моју срамоту пред људима.“"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Наговештај Исусовог рођења"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "А шестог месеца, Бог пошаље анђела Гаврила у галилејски град Назарет"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "девојци по имену Марија. Она је била испрошена за човека који се звао Јосиф, пореклом из лозе цара Давида."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Дошавши к њој, рекао је: „Радуј се, ти којој је исказана милост! Господ је с тобом!“"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Марија се смете на те речи и поче да размишља: какав је ово поздрав?"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Анђео настави: „Не бој се, Марија, јер си нашла милост пред Богом."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "И ево, затруднећеш и родићеш сина, па ћеш му дати име ’Исус’."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Он ће бити силан и зваће га ’Син Свевишњега’. Њему ће Господ Бог предати престо његовога оца Давида."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "Он ће довека владати над потомством Јаковљевим и његовом Царству неће бити краја.“"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "Марија упита анђела: „По чему ћу то знати, кад још нисам удата?“"
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "Анђео јој одговори: „Дух Свети ће сићи на тебе и сила Свевишњег ће те осенити. Зато ће то дете бити свето и зваће се ’Син Божији’."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "А ево и твоја рођака Јелисавета носи сина у својој старости. Она је већ у шестом месецу, а њу су називали нероткињом."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "Богу ништа није немогуће.“"
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "Марија рече: „Ево служитељке Господње, нека ми буде како си рекао.“ Анђео тада оде од ње."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Сусрет Марије и Јелисавете"
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "Тих дана, Марија се спреми и журно оде у град Јудин."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "Ушла је у Захаријину кућу и поздравила Јелисавету."
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "Кад је Јелисавета чула Маријин поздрав, заигра дете у њеној утроби и Свети Дух је испуни,"
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "те она ускликну: „О, најблагословенија међу женама, благословен је плод утробе твоје!"
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "Чиме сам то заслужила да мајка мога Господа дође к мени?"
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "Јер, чим сам чула твој поздрав, од радости заигра дете у мојој утроби."
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "Блажена је она која је поверовала да ће се испунити што јој Господ рече.“"
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "Онда Марија рече:",
          {
            "text": "„Велича душа моја Господа,",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          {
            "text": "весели се дух мој Богу, моме Спаситељу,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          {
            "text": "јер погледа на понизност своје слушкиње.",
            "poem": 1
          },
          {
            "text": "Ево, од сада ће ме сви нараштаји звати блаженом;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          {
            "text": "јер велика је дела Свесилни учинио по мени,",
            "poem": 1
          },
          {
            "text": "свето је име његово!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          {
            "text": "Милост је његова над онима што га поштују,",
            "poem": 1
          },
          {
            "text": "од колена до колена.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 51,
        "content": [
          {
            "text": "Моћна дела учини мишицом својом,",
            "poem": 1
          },
          {
            "text": "растера узносите што су пуни себе,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 52,
        "content": [
          {
            "text": "збаци владаре са престола",
            "poem": 1
          },
          {
            "text": "и узвиси понижене,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 53,
        "content": [
          {
            "text": "гладне насити добрима,",
            "poem": 1
          },
          {
            "text": "а богате без ичега отпусти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 54,
        "content": [
          {
            "text": "Придиже Израиља, слугу свога,",
            "poem": 1
          },
          {
            "text": "сетивши се свога милосрђа,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 55,
        "content": [
          {
            "text": "како рече прецима нашим,",
            "poem": 1
          },
          {
            "text": "Аврахаму и његовом потомству довека.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 56,
        "content": [
          "Марија остаде са Јелисаветом око три месеца, па се врати својој кући."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Рођење Јована Крститеља"
        ]
      },
      {
        "type": "verse",
        "number": 57,
        "content": [
          "Дође време да Јелисавета роди, и она роди сина."
        ]
      },
      {
        "type": "verse",
        "number": 58,
        "content": [
          "Њени суседи и рођаци су чули да јој је Господ био веома милостив, па су се радовали са њом."
        ]
      },
      {
        "type": "verse",
        "number": 59,
        "content": [
          "Осмога дана дођу да обрежу дете. Хтели су да му дају очево име – Захарија,"
        ]
      },
      {
        "type": "verse",
        "number": 60,
        "content": [
          "али мајка рече: „Никако, име ће му бити Јован!“"
        ]
      },
      {
        "type": "verse",
        "number": 61,
        "content": [
          "Они јој рекоше: „Али, у твојој родбини нико не носи то име.“"
        ]
      },
      {
        "type": "verse",
        "number": 62,
        "content": [
          "Онда знаковима упитају оца да каже како би он хтео да се дете зове."
        ]
      },
      {
        "type": "verse",
        "number": 63,
        "content": [
          "Захарија затражи таблицу и напише: „Његово име је Јован.“ Сви су се томе чудили."
        ]
      },
      {
        "type": "verse",
        "number": 64,
        "content": [
          "Одједном, Захарија поче да говори и да прославља Бога."
        ]
      },
      {
        "type": "verse",
        "number": 65,
        "content": [
          "Страх је обузео све њихове суседе, тако да се ово прочуло по целом горском крају Јудеје."
        ]
      },
      {
        "type": "verse",
        "number": 66,
        "content": [
          "Сви који су ово чули, размишљали су о томе питајући се: „Шта ће бити са овим дететом?“ Јер је рука Господња била са њим."
        ]
      },
      {
        "type": "verse",
        "number": 67,
        "content": [
          "А Захарија, отац Јованов, испуњен Светим Духом, поче да пророкује:"
        ]
      },
      {
        "type": "verse",
        "number": 68,
        "content": [
          {
            "text": "„Благословен да је Господ, Бог Израиљев,",
            "poem": 1
          },
          {
            "text": "што дође међу свој народ и откупи га.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 69,
        "content": [
          {
            "text": "Подиже нам силнога Спаситеља,",
            "poem": 1
          },
          {
            "text": "од рода Давидова, слуге свога,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 70,
        "content": [
          {
            "text": "како обећа давно",
            "poem": 1
          },
          {
            "text": "преко својих светих пророка:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 71,
        "content": [
          {
            "text": "да нас спасе од наших душмана",
            "poem": 1
          },
          {
            "text": "и од руку оних који нас мрзе;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 72,
        "content": [
          {
            "text": "да ће исказати милост прецима нашим",
            "poem": 1
          },
          {
            "text": "и сетити се свога светог савеза,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 73,
        "content": [
          {
            "text": "по заклетви датој праоцу нашем Аврахаму,",
            "poem": 1
          },
          {
            "text": "да ће нам дати:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 74,
        "content": [
          {
            "text": "да му без страха служимо,",
            "poem": 1
          },
          {
            "text": "од душманске руке избављени,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 75,
        "content": [
          {
            "text": "живећи свето и праведно",
            "poem": 1
          },
          {
            "text": "пред њим у све дане наше.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 76,
        "content": [
          {
            "text": "А ти, дете моје, зваћеш се ’пророк Свевишњега’,",
            "poem": 1
          },
          {
            "text": "јер ћеш ићи пред Господом",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да припремиш путеве за њега.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 77,
        "content": [
          {
            "text": "Ти ћеш довести до спознаје његов народ",
            "poem": 1
          },
          {
            "text": "да је спасење у опроштењу њихових греха,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 78,
        "content": [
          {
            "text": "по милостивом срцу Бога нашега,",
            "poem": 1
          },
          {
            "text": "од којег ће нам доћи",
            "poem": 2
          },
          {
            "noteId": 0
          },
          {
            "text": "светлост зоре са висине,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 79,
        "content": [
          {
            "text": "да обасја оне што живе у тами",
            "poem": 1
          },
          {
            "text": "и под сенком смрти бораве,",
            "poem": 2
          },
          {
            "text": "и да наше стопе на пут мира усмери.“",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 80,
        "content": [
          "Када је дечак одрастао и духовно ојачао, отишао је да живи у пустињи, све до дана када се појавио у јавности израиљског народа."
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 0,
        "caller": "+",
        "text": "1,78 Дословно: излазак звезде и изданак биљке. Септуагинта преводи ову реч са излазак, што може да се односи и на једно и на друго. Могуће је да Лука има на уму обе слике, и излазак звезде и изданак биљке. Слика пророчки говори о доласку Давидовог изданка, то јест, Христа. (Зах 3,8; 6,12; Јер 23,5; 4. Мој 24,17; Мал 3,2.)",
        "reference": {
          "chapter": 1,
