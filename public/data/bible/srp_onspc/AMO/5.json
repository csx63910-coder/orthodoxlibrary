  "book": {
    "id": "AMO",
    "translationId": "srp_onspc",
    "name": "Књига пророка Амоса",
    "commonName": "Књига пророка Амоса",
    "title": "Књига пророка Амоса",
    "order": 30,
    "numberOfChapters": 9,
    "sha256": "4a4cc7535cd08f6525d2f0387ff5d65968b156b5a9b515d2b0dd5525954ca71c",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/AMO/1.json",
    "lastChapterNumber": 9,
    "lastChapterApiLink": "/api/srp_onspc/AMO/9.json",
    "totalNumberOfVerses": 146
  },
  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "heading",
        "content": [
          "Јадиковка и позив на покајање"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Чујте ову реч, нарицаљку коју о вама износим, о, доме Израиљев!"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Пала је девица израиљска",
            "poem": 1
          },
          {
            "text": "и више устати неће.",
            "poem": 2
          },
          {
            "text": "Напуштена је на својој земљи",
            "poem": 1
          },
          {
            "text": "и никога нема да је подигне.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Јер овако каже Господ Бог:",
          {
            "text": "„У граду из ког је отишла хиљада",
            "poem": 1
          },
          {
            "text": "остаће њих стотину,",
            "poem": 2
          },
          {
            "text": "из ког је отишло њих стотину",
            "poem": 1
          },
          {
            "text": "остаће десеторо дому израиљском.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Јер овако каже Господ дому израиљском:",
          {
            "text": "„Тражите ме и живећете!",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Не тражите Ветиљ!",
            "poem": 2
          },
          {
            "text": "Не идите у Галгал!",
            "poem": 1
          },
          {
            "text": "Не прелазите у Вир-Савеју!",
            "poem": 2
          },
          {
            "text": "Јер, Галгал ће сигурно у изгнанство,",
            "poem": 1
          },
          {
            "text": "а и Ветиљ ће аветиња постати.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Тражите Господа и живећете,",
            "poem": 1
          },
          {
            "text": "да се не би обрушио као огањ на дом Јосифов",
            "poem": 2
          },
          {
            "text": "и спалио га,",
            "poem": 1
          },
          {
            "text": "а нико га не гаси у Ветиљу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ви у пелен правду изокрећете",
            "poem": 1
          },
          {
            "text": "и праведност на тле обарате.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "А он је створио Влашиће и Орион,",
            "poem": 1
          },
          {
            "text": "претвара мрак у јутро",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и окреће дан у ноћ.",
            "poem": 2
          },
          {
            "text": "Он дозива морске воде",
            "poem": 1
          },
          {
            "text": "и излива их по земљином лицу.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Господ је име његово.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Он сукне пустош на моћника",
            "poem": 1
          },
          {
            "text": "и пустош ће на утврђење доћи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "А они мрзе онога који на вратима прекорева,",
            "poem": 1
          },
          {
            "text": "гаде се онога који честито говори.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Зато што газите убогога",
            "poem": 1
          },
          {
            "text": "и узимате му данак у житу,",
            "poem": 2
          },
          {
            "text": "саградили сте куће од клесаног камена",
            "poem": 1
          },
          {
            "text": "али нећете пребивати у њима.",
            "poem": 2
          },
          {
            "text": "Нећете пити вино",
            "poem": 1
          },
          {
            "text": "ваших родних винограда које сте засадили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Јер ја знам мноштво ваших преступа",
            "poem": 1
          },
          {
            "text": "и ваше многобројне грехе.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Тлачите праведника, мито узимате,",
            "poem": 1
          },
          {
            "text": "на вратима убогоме правду изврћете.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Зато мудар ћути у овом времену",
            "poem": 1
          },
          {
            "text": "јер је зло време.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Добро тражите, а не зло,",
            "poem": 1
          },
          {
            "text": "да живи будете,",
            "poem": 2
          },
          {
            "text": "да са вама буде Господ, Бог над војскама,",
            "poem": 1
          },
          {
            "text": "како и кажете.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Зло мрзите, а волите добро,",
            "poem": 1
          },
          {
            "text": "на вратима правду заступајте,",
            "poem": 2
          },
          {
            "text": "па се можда Господ, Бог над војскама,",
            "poem": 1
          },
          {
            "text": "смилује остатку Јосифовом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Зато овако каже Господ, Бог над војскама, Господ:",
          {
            "text": "„Јадиковка је по свим трговима",
            "poem": 1
          },
          {
            "text": "и улицама свим: ’Јао! Јао!’",
            "poem": 2
          },
          {
            "text": "И зваће ратара да жали,",
            "poem": 1
          },
          {
            "text": "да жале они који знају нарицаљку.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Јадиковаће по свим виноградима,",
            "poem": 1
          },
          {
            "text": "јер посред тебе ја ћу проћи",
            "poem": 2
          },
          {
            "text": "– говори Господ.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Дан Господњи"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Јао онима што прижељкују",
            "poem": 1
          },
          {
            "text": "дан Господњи!",
            "poem": 2
          },
          {
            "text": "Шта ће вама дан Господњи?",
            "poem": 1
          },
          {
            "text": "Тад је тама, а не светло.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Као човек кад од лава бежи,",
            "poem": 1
          },
          {
            "text": "а дочека га медвед,",
            "poem": 2
          },
          {
            "text": "или у кућу уђе",
            "poem": 1
          },
          {
            "text": "и руку своју на зид стави",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да га уједе змија.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Неће ли дан Господњи бити тама, а не светло",
            "poem": 1
          },
          {
            "text": "и помрчина без сјаја?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "„Ја мрзим, ја презирем ваше светковине!",
            "poem": 1
          },
          {
            "text": "Светим саборима вашим ни да примиришем!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "И ако ми приносите свеспалнице",
            "poem": 1
          },
          {
            "text": "и ваше житне жртве,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "нећу да их прихватим.",
            "poem": 2
          },
          {
            "text": "Не обазирем се на жртве мира",
            "poem": 1
          },
          {
            "text": "ваших утовљених јунаца.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Склоните од мене буку својих песама",
            "poem": 1
          },
          {
            "text": "и мелодију харфи својих.",
            "poem": 2
          },
          {
            "text": "Не желим да их чујем.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Нека правда као вода потече",
            "poem": 1
          },
          {
            "text": "и праведност као поток непресушни.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Мени ли сте приносили житне жртве",
            "poem": 1
          },
          {
            "text": "и приносе у пустињи четрдесет година,",
            "poem": 2
          },
          {
            "text": "о, доме Израиљев?!",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Носили сте своје идоле –",
            "poem": 1
          },
          {
            "text": "Сикута, цара свога",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и Кијуна, звезду својих богова –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "које сте себи начинили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Изагнаћу вас још даље од Дамаска,",
            "poem": 1
          },
          {
            "text": "каже Господ, а његово је име Бог над војскама.“",
            "poem": 2
          }
        ]
      }
    ],
