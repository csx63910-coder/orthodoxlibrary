  },
  "chapter": {
    "number": 8,
    "content": [
      {
        "type": "heading",
        "content": [
          "Корпа летњег воћа"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ово ми је показао Господ Бог. Гле, корпа летњег воћа."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Казао ми је: „Амосе, шта видиш?“ Одговорио сам: „Корпу летњег воћа.“ Господ узврати: „Мом народу, Израиљу, дошао је крај",
          {
            "noteId": 3
          },
          "и ја више нећу да му попуштам."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "На тај дан ће лелек бити храмска песма – говори Господ Бог – посвуда ће бити разбацани многи лешеви. Тише само!"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Чујте ово, о, ви што газите убогога",
            "poem": 1
          },
          {
            "text": "и сатирете понизне у земљи!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Говорите:",
          {
            "text": "’Када ће се завршити младина",
            "poem": 1
          },
          {
            "text": "да продајемо жито,",
            "poem": 2
          },
          {
            "text": "и субота, да отворимо житнице;",
            "poem": 1
          },
          {
            "text": "да закидамо на мери,",
            "poem": 2
          },
          {
            "text": "варамо на теговима",
            "poem": 1
          },
          {
            "text": "и подваљујемо непоштеним теразијама;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "да за сребро купујемо сиромаха",
            "poem": 1
          },
          {
            "text": "и убогог за сандале,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да продајемо житне трице.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Господ се заклео поносом Јаковљевим: „Довека заборавити нећу сва њихова дела."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Зар се земља због тога неће задрмати",
            "poem": 1
          },
          {
            "text": "и закукати свако живи на њој?",
            "poem": 2
          },
          {
            "text": "Подиће се на њој све попут Нила,",
            "poem": 1
          },
          {
            "text": "набујаће и опашће",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "као Нил египатски.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "И тога дана ћу дати да сунце зађе у подне,",
          {
            "text": "и донећу земљи помрчину у по бела дана",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Окренућу ваше светковине у жалопојку",
            "poem": 1
          },
          {
            "text": "и све песме ваше у нарицаљку.",
            "poem": 2
          },
          {
            "text": "Сва ћу бедра ваша обући у кострет",
            "poem": 1
          },
          {
            "text": "и оћелавићу сваку главу.",
            "poem": 2
          },
          {
            "text": "Учинићу жалопојку као за јединцем",
            "poem": 1
          },
          {
            "text": "и крај тога као дан горчине.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Гле, долазе дани – говори Господ Бог –",
            "poem": 1
          },
          {
            "text": "када ћу послати глад на земљу.",
            "poem": 2
          },
          {
            "text": "Али не глад за хлебом, не жеђ за водом,",
            "poem": 1
          },
          {
            "text": "већ за слушањем речи Господњих!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Тумараће од мора до мора",
            "poem": 1
          },
          {
            "text": "и од севера до истока.",
            "poem": 2
          },
          {
            "text": "Лутаће с једног краја на други,",
            "poem": 1
          },
          {
            "text": "тражиће реч Господњу и неће је наћи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Тога ће дана",
          {
            "text": "од жеђи смалаксати",
            "poem": 1
          },
          {
            "text": "лепе девојке и младићи,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "они који се заклињу идолом Самарије",
            "poem": 1
          },
          {
            "text": "и говоре: ’Жив био твој бог, о, Дане!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Жив био пут у Вир-Савеју!’",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "И онда ће пасти и више се неће дићи.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 3,
        "caller": "+",
        "text": "8,2 Игра речи, јер именице крај и летње воће на јеврејском звуче готово исто.",
        "reference": {
          "chapter": 8,
          "verse": 2
        }
      }
    ]
