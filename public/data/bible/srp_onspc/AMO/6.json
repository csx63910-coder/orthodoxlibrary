    "translationId": "srp_onspc",
    "name": "Књига пророка Амоса",
    "commonName": "Књига пророка Амоса",
    "title": "Књига пророка Амоса",
    "order": 30,
    "numberOfChapters": 9,
    "sha256": "4a4cc7535cd08f6525d2f0387ff5d65968b156b5a9b515d2b0dd5525954ca71c",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/AMO/1.json",
    "lastChapterNumber": 9,
    "lastChapterApiLink": "/api/srp_onspc/AMO/9.json",
    "totalNumberOfVerses": 146
  },
  "chapter": {
    "number": 6,
    "content": [
      {
        "type": "heading",
        "content": [
          "Јао лакомисленима!"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Јао лакомисленима на Сиону,",
            "poem": 1
          },
          {
            "text": "онима што су безбрижни на гори Самарији,",
            "poem": 2
          },
          {
            "text": "онима што се зову угледнима најбољих народа,",
            "poem": 1
          },
          {
            "text": "а којима долази дом Израиљев!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Пређите у Халани, разгледајте,",
            "poem": 1
          },
          {
            "text": "па оданде идите у Амат-Рабу",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и спустите се у Гат филистејски.",
            "poem": 2
          },
          {
            "text": "Јесу ли та царства боља од ових",
            "poem": 1
          },
          {
            "text": "и да ли су им пространије међе од ваших међа?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ви одгурујете долазак дана зла,",
            "poem": 1
          },
          {
            "text": "а примичете владавину насиља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Башкарите се на лежајима од слоноваче,",
            "poem": 1
          },
          {
            "text": "протежете на диванима својим",
            "poem": 2
          },
          {
            "text": "и једете јагњад из стада",
            "poem": 1
          },
          {
            "text": "и телад из штале.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Дрндате по харфи,",
            "poem": 1
          },
          {
            "text": "као Давид себи измишљате инструменте.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ви пехарима пијете вино,",
            "poem": 1
          },
          {
            "text": "мажете се најбољим уљима",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и не боле вас Јосифове развалине.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Зато ћете сада отићи у изгнанство на челу изгнаника,",
            "poem": 1
          },
          {
            "text": "умукнуће славље оних што се протежу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Бог се гнуша Јаковљевог поноса"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Собом се заклео Господ Бог, овако говори Господ, Бог над војскама:",
          {
            "text": "„Гнушам се Јаковљевог поноса",
            "poem": 1
          },
          {
            "text": "и мрзим његова утврђења.",
            "poem": 2
          },
          {
            "text": "Зато ћу да предам град",
            "poem": 1
          },
          {
            "text": "и све у њему.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Ако и десеторо људи преостане у једној кући и они ће помрети."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Њихов рођак, најближи њихов ће их узети да их спали, да изнесе кости њихове из куће. И рећи ће ономе у ћошку куће: „Је ли још неко са тобом?“ А он ће му одговорити: „Није.“ И додаће: „Тише само! Не спомињи Господње име!“"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Јер, ево, Господ заповеда",
            "poem": 1
          },
          {
            "text": "и удариће велику кућу и развалиће је,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а мања ће кућа пући.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Трче ли коњи по литицама?",
            "poem": 1
          },
          {
            "text": "Оре ли се море воловима?",
            "poem": 2
          },
          {
            "text": "Јер, правду сте у отров преокренули",
            "poem": 1
          },
          {
            "text": "и у пелен плод праведности.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Радујете се Ло-Девару и говорите:",
            "poem": 1
          },
          {
            "text": "„Нисмо ли својом снагом освојили Карнајим!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "„Јер, ево, подижем против вас, о, доме Израиљев",
            "poem": 1
          },
          {
            "text": "– говори Господ Бог над војскама –",
            "poem": 2
          },
          {
            "text": "народ који ће вас тлачити",
            "poem": 1
          },
          {
            "text": "од Лево-Амата до пустињског потока.“",
            "poem": 2
          }
        ]
      }
    ],
