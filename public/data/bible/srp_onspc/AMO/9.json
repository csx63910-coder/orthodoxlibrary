  "chapter": {
    "number": 9,
    "content": [
      {
        "type": "heading",
        "content": [
          "Разарање Израиља"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Видео сам Господа, стајао је код жртвеника и рекао:",
          {
            "text": "„Удари у стубове!",
            "poem": 1
          },
          {
            "text": "Нека се затресу довраци!",
            "poem": 2
          },
          {
            "text": "Сруши их на главу свих њих,",
            "poem": 1
          },
          {
            "text": "а ја ћу да побијем преживеле",
            "poem": 2
          },
          {
            "text": "и неће умаћи ко год да бежи,",
            "poem": 1
          },
          {
            "text": "и нико се неће спасти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "У Свет мртвих",
            "poem": 1
          },
          {
            "noteId": 4
          },
          {
            "text": "ако се укопају,",
            "poem": 1
          },
          {
            "text": "и онде ће их моја рука зграбити.",
            "poem": 2
          },
          {
            "text": "На небеса да се попну,",
            "poem": 1
          },
          {
            "text": "и оданде ћу их скинути.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "На врх Кармила да се сакрију,",
            "poem": 1
          },
          {
            "text": "ја ћу их наћи и узећу их оданде.",
            "poem": 2
          },
          {
            "text": "На дно мора да се сакрију од погледа мога,",
            "poem": 1
          },
          {
            "text": "и онде ћу заповедити змији да их уједе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ако их њихов непријатељ отера у изгнанство,",
            "poem": 1
          },
          {
            "text": "и онде ћу да заповедим мачу, па ће их сасећи.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ока са њих ја скинути нећу",
            "poem": 1
          },
          {
            "text": "да им зло донесем, а не добро.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Господ Бог над војскама",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "дотиче земљу и она се топи.",
            "poem": 1
          },
          {
            "text": "И кукају њени становници,",
            "poem": 2
          },
          {
            "text": "набуја она попут Нила",
            "poem": 1
          },
          {
            "text": "и опада попут Нила египатског.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Он себи на небесима гради одаје,",
            "poem": 1
          },
          {
            "text": "за себе је свод над земљом утемељио.",
            "poem": 2
          },
          {
            "text": "Он позива воде мора",
            "poem": 1
          },
          {
            "text": "и излива их по земљином лицу –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Господ је име његово!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "„Нисте ли за мене као деца кушитска,",
            "poem": 1
          },
          {
            "text": "ви, децо израиљска?",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          },
          {
            "text": "Зар ја нисам из египатске земље извео Израиља,",
            "poem": 1
          },
          {
            "text": "Филистејце са Кафтора",
            "poem": 2
          },
          {
            "noteId": 5
          },
          {
            "lineBreak": true
          },
          {
            "text": "и Арама из Кира?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ево, очи су Господа Бога",
            "poem": 1
          },
          {
            "text": "на грешном царству",
            "poem": 2
          },
          {
            "text": "и ја ћу да га збришем",
            "poem": 1
          },
          {
            "text": "са лица земље.",
            "poem": 2
          },
          {
            "text": "Ипак нећу сасвим да збришем",
            "poem": 1
          },
          {
            "text": "дом Јаковљев",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Јер, ево, заповедам",
            "poem": 1
          },
          {
            "text": "да ћу просејати дом Израиљев",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "међу свим народима",
            "poem": 2
          },
          {
            "text": "као да га просејавам ситом,",
            "poem": 1
          },
          {
            "text": "и ни зрнце на тло пасти неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Од мача ће изгинути",
            "poem": 1
          },
          {
            "text": "сви грешници мог народа што говоре:",
            "poem": 2
          },
          {
            "text": "’Неће нам се приближити,",
            "poem": 1
          },
          {
            "text": "зло нас неће дохватити!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Обнова Израиља"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Тога ћу дана",
          {
            "text": "подићи пали шатор Давидов,",
            "poem": 1
          },
          {
            "text": "зазидаћу му пукотине,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "саградићу што је у њему срушено,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и обновити га као у давнашње време.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Тако ће узети наследство остатка Едома",
            "poem": 1
          },
          {
            "text": "и све народе који носе моје име",
            "poem": 2
          },
          {
            "text": "– говори Господ који чини ово.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ево, долазе дани – говори Господ –",
          {
            "text": "када ће ратар стизати жетеоца",
            "poem": 1
          },
          {
            "text": "и газилац грожђа престићи сејача.",
            "poem": 2
          },
          {
            "text": "И тада ће горе капати слатким вином",
            "poem": 1
          },
          {
            "text": "и сви ће се брегови преливати.",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Вратићу Израиљ, свој народ из изгнанства.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "И они ће обновити градове напуштене и живеће у њима.",
            "poem": 1
          },
          {
            "text": "Садиће винограде и њихово пити вино,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "садиће баште и њихов род јести.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Засадићу их у земљу њихову",
            "poem": 1
          },
          {
            "text": "и неће бити ишчупани опет",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "из своје земље, коју сам им дао“ –",
            "poem": 2
          },
          {
            "text": "каже Господ, твој Бог.",
            "poem": 3
          }
        ]
      }
    ],
