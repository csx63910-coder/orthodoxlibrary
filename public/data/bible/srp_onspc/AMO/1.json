  "book": {
    "id": "AMO",
    "translationId": "srp_onspc",
    "name": "Књига пророка Амоса",
    "commonName": "Књига пророка Амоса",
    "title": "Књига пророка Амоса",
    "order": 30,
    "numberOfChapters": 9,
    "sha256": "4a4cc7535cd08f6525d2f0387ff5d65968b156b5a9b515d2b0dd5525954ca71c",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/AMO/1.json",
    "lastChapterNumber": 9,
    "lastChapterApiLink": "/api/srp_onspc/AMO/9.json",
    "totalNumberOfVerses": 146
  },
  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Речи Амоса које је видео за Израиљ, док је био међу сточарима из Текује. Било је то две године пре земљотреса, у време Озије, цара Јуде, и за време Јеровоама, цара Израиља, Јоасовог сина."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Он је рекао:",
          {
            "text": "„Господ риче са Сиона,",
            "poem": 1
          },
          {
            "text": "из Јерусалима глас свој пушта.",
            "poem": 2
          },
          {
            "text": "Тугују пастирски пашњаци",
            "poem": 1
          },
          {
            "text": "и врх Кармила се суши.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Суд над околним народима"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Овако каже Господ:",
          {
            "text": "„Због три преступа Дамаска,",
            "poem": 1
          },
          {
            "text": "а и због четири, своју казну нећу да повучем,",
            "poem": 2
          },
          {
            "text": "јер су Галад овршили",
            "poem": 1
          },
          {
            "text": "гвозденом вршилицом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Бацићу огањ на кућу Азаилову",
            "poem": 1
          },
          {
            "text": "и спалиће Вен-Ададова утврђења.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Изломићу преворнице на Дамаску,",
            "poem": 1
          },
          {
            "text": "истребићу живаљ из те долине Авен",
            "poem": 2
          },
          {
            "noteId": 0
          },
          {
            "text": "и онога што у Вет-Едену жезло држи.",
            "poem": 1
          },
          {
            "text": "У изгнанство, у Кир ће отићи Арамов народ –",
            "poem": 2
          },
          {
            "text": "каже Господ.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Овако каже Господ:",
          {
            "text": "„Због три преступа Газе,",
            "poem": 1
          },
          {
            "text": "а и због четири, своју казну нећу да повучем,",
            "poem": 2
          },
          {
            "text": "јер су све изгнанике одвели у ропство",
            "poem": 1
          },
          {
            "text": "и предали их Едому.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Бацићу огањ на зидине Газе",
            "poem": 1
          },
          {
            "text": "и спалиће њена утврђења.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Истребићу живаљ из Азота",
            "poem": 1
          },
          {
            "text": "и онога што у Аскалону жезло држи.",
            "poem": 2
          },
          {
            "text": "Руку ћу своју да окренем на Акарон,",
            "poem": 1
          },
          {
            "text": "и пострадаће остатак филистејски",
            "poem": 2
          },
          {
            "text": "– говори Господ Бог.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Овако каже Господ:",
          {
            "text": "„Због три преступа Тира,",
            "poem": 1
          },
          {
            "text": "а и због четири, своју казну нећу да повучем,",
            "poem": 2
          },
          {
            "text": "јер су све изгнанике предали Едому.",
            "poem": 1
          },
          {
            "text": "Нису се сетили братског савеза.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Бацићу огањ на зидине Тира",
            "poem": 1
          },
          {
            "text": "и спалиће његова утврђења.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Овако каже Господ:",
          {
            "text": "„Због три преступа Едома,",
            "poem": 1
          },
          {
            "text": "а и због четири, своју казну нећу да повучем,",
            "poem": 2
          },
          {
            "text": "јер је мачем свога брата прогонио",
            "poem": 1
          },
          {
            "text": "и потиснуо своје смиловање.",
            "poem": 2
          },
          {
            "text": "У свом га је бесу сатирао стално",
            "poem": 1
          },
          {
            "text": "и довека разјарен био.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Бацићу огањ на Теман",
            "poem": 1
          },
          {
            "text": "и спалиће утврђења Восоре.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Овако каже Господ:",
          {
            "text": "„Због три преступа синова Амонових,",
            "poem": 1
          },
          {
            "text": "а и због четири, своју казну нећу да повучем,",
            "poem": 2
          },
          {
            "text": "јер су распорили труднице Галада",
            "poem": 1
          },
          {
            "text": "да би међу своју проширили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Запалићу огањ на зидинама Раве",
            "poem": 1
          },
          {
            "text": "и спалиће њена утврђења,",
            "poem": 2
          },
          {
            "text": "све уз поклич на дан боја",
            "poem": 1
          },
          {
            "text": "и уз вихор олујнога дана.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "А њихов ће цар отићи у изгнанство,",
            "poem": 1
          },
          {
            "text": "заједно – он и главари његови“ –",
            "poem": 2
          },
          {
            "text": "каже Господ.",
            "poem": 3
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 0,
        "caller": "+",
        "text": "1,5 Или: долине идолатрије, што је погрдан назив за Дамаск и цара Арама.",
        "reference": {
          "chapter": 1,
          "verse": 5
        }
      }
    ]
