  },
  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "heading",
        "content": [
          "Израиљ се није вратио Богу"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Чујте ову реч, о, краве васанске које сте на брду Самарије,",
            "poem": 1
          },
          {
            "text": "што тлачите сиромаха, обарате убогога",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и говорите мужевима: „Донесите нам да пијемо!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Господ Бог се заклео светошћу својом:",
            "poem": 1
          },
          {
            "text": "„Гле, ево долазе вам дани",
            "poem": 2
          },
          {
            "text": "када ће вас извлачити кукама,",
            "poem": 1
          },
          {
            "text": "а последње од вас удицама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Излазиће свака од вас,",
            "poem": 1
          },
          {
            "text": "равно напред, кроз пукотине",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и разбацаће вас по Армону",
            "poem": 2
          },
          {
            "noteId": 1
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Дођите у Ветиљ и грешите,",
            "poem": 1
          },
          {
            "text": "а у Галгалу грешите још више.",
            "poem": 2
          },
          {
            "text": "Своје жртве јутром приносите",
            "poem": 1
          },
          {
            "text": "и трећег дана своје десетке.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Захвалнице са квасцем приносите,",
            "poem": 1
          },
          {
            "text": "објавите добровољне жртве,",
            "poem": 2
          },
          {
            "text": "разгласите их, јер вам је то по вољи,",
            "poem": 1
          },
          {
            "text": "децо Израиљева",
            "poem": 2
          },
          {
            "text": "– говори Господ Бог.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "А ја сам вам дао чисте зубе",
            "poem": 1
          },
          {
            "noteId": 2
          },
          {
            "text": "у свим вашим градовима,",
            "poem": 1
          },
          {
            "text": "оскудицу хлеба у свим местима вашим,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "али ви ми се нисте вратили",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Још сам вам и кишу ускратио,",
            "poem": 1
          },
          {
            "text": "а било је три месеца пред жетву.",
            "poem": 2
          },
          {
            "text": "На један град сам послао кишу,",
            "poem": 1
          },
          {
            "text": "а на други нисам.",
            "poem": 2
          },
          {
            "text": "Послао сам кишу на једну њиву да је натопи,",
            "poem": 1
          },
          {
            "text": "а она која није натапана се осушила.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Два су се, па и три града дотетурала до једног града да пију воде.",
            "poem": 1
          },
          {
            "text": "И нису се напили",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и ви ми се нисте вратили",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ударио сам медљиком и кукољем",
            "poem": 1
          },
          {
            "text": "баште ваше и ваше винограде,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ваше смокве и винограде ваше.",
            "poem": 2
          },
          {
            "text": "Појео их је скакавац,",
            "poem": 1
          },
          {
            "text": "али ви ми се нисте вратили",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "И помор сам слао међу вас",
            "poem": 1
          },
          {
            "text": "као на Египат.",
            "poem": 2
          },
          {
            "text": "Мачем сам сасекао ваше младиће",
            "poem": 1
          },
          {
            "text": "са све вашим преотетим коњима.",
            "poem": 2
          },
          {
            "text": "Дао сам да вам се до носа подиже смрад вашег табора,",
            "poem": 1
          },
          {
            "text": "али ви ми се нисте вратили",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Затирао сам неке од вас",
            "poem": 1
          },
          {
            "text": "као што је Бог опустошио Содому и Гомору,",
            "poem": 2
          },
          {
            "text": "били сте као угарак извучен из ложишта,",
            "poem": 1
          },
          {
            "text": "али ви ми се нисте вратили",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Зато ћу тако да ти урадим, о, Израиљу!",
            "poem": 1
          },
          {
            "text": "И због тога што ћу да ти урадим,",
            "poem": 2
          },
          {
            "text": "припреми се да сретнеш свога Бога, о, Израиљу!“",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Јер, ево онога што је горе начинио,",
            "poem": 1
          },
          {
            "text": "што је ветар саздао",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и јавио човеку мисао своју;",
            "poem": 2
          },
          {
            "text": "који зору у таму претвара",
            "poem": 1
          },
          {
            "text": "и хода по узвишењима земље –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "име му је Господ, Бог над војскама!",
            "poem": 2
          }
        ]
      }
    ],
