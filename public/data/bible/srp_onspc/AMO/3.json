  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "heading",
        "content": [
          "Сведоци против Израиља"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Чујте ову реч, јер Господ против вас говори, децо Израиљева. Говори против вас и свег рода који сам извео из египатске земље:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Само сам вас познавао",
            "poem": 1
          },
          {
            "text": "више од свих родова на земљи.",
            "poem": 2
          },
          {
            "text": "Зато ћу вас и казнити",
            "poem": 1
          },
          {
            "text": "за све ваше кривице.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Иду ли двоје заједно,",
            "poem": 1
          },
          {
            "text": "а да се нису срели?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Риче ли лав у шуми",
            "poem": 1
          },
          {
            "text": "ако нема плена?",
            "poem": 2
          },
          {
            "text": "Јавља ли се риком лавић из брлога свога,",
            "poem": 1
          },
          {
            "text": "ако није нешто ухватио?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Слеће ли птица у замку на тле,",
            "poem": 1
          },
          {
            "text": "ако нема мамца?",
            "poem": 2
          },
          {
            "text": "Склања ли се птичија замка са тла,",
            "poem": 1
          },
          {
            "text": "ако ништа ухваћено није?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Огласи ли се труба у граду,",
            "poem": 1
          },
          {
            "text": "а да народ не задрхти?",
            "poem": 2
          },
          {
            "text": "Зар постоји несрећа у граду,",
            "poem": 1
          },
          {
            "text": "а да није од Господа?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Јер Господ не чини ништа,",
            "poem": 1
          },
          {
            "text": "а да тајну своју не објави пророцима,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "слугама својим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Зарикао је лав!",
            "poem": 1
          },
          {
            "text": "И ко да се не препадне?!",
            "poem": 2
          },
          {
            "text": "Проговорио је Господ Бог!",
            "poem": 1
          },
          {
            "text": "И ко да не пророкује?!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Објавите по утврђењима у Азоту",
            "poem": 1
          },
          {
            "text": "и по утврђењима египатске земље.",
            "poem": 2
          },
          {
            "text": "Реците: „Саберите се по брдима Самарије,",
            "poem": 1
          },
          {
            "text": "гледајте велике немире сред ње",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и насиље у њој.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "„Нису знали добро да чине – говори Господ –",
            "poem": 1
          },
          {
            "text": "ти што згрћу насиљем",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и пустошењем по својим утврђењима.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Зато овако каже Господ Бог:",
          {
            "text": "„Непријатељ је око земље,",
            "poem": 1
          },
          {
            "text": "снагу ће твоју да обори,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "оплениће твоја утврђења.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Овако каже Господ:",
          {
            "text": "„Као када пастир истргне из лављих чељусти",
            "poem": 1
          },
          {
            "text": "пар ногу или комад ува,",
            "poem": 2
          },
          {
            "text": "тако ће истргнути децу Израиљеву",
            "poem": 1
          },
          {
            "text": "која у Самарији пребивају на углу постеље,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "на свиленом кревету.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Чуј и сведочи дому Јаковљевом, говори Господ, Господ Бог над војскама:"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "На дан када казним Израиљ за преступе његове",
            "poem": 1
          },
          {
            "text": "казнићу и жртвенике Ветиља.",
            "poem": 2
          },
          {
            "text": "Одсеће се рогови жртвеника",
            "poem": 1
          },
          {
            "text": "и попадаће на тле.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "И зимску и летњу ћу кућу ударити.",
            "poem": 1
          },
          {
            "text": "Срушиће се куће пуне слоноваче",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и многи ће домови бити збрисани",
            "poem": 2
          },
          {
            "text": "– говори Господ.“",
            "poem": 3
          }
        ]
      }
    ],
