  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "heading",
        "content": [
          "Давидови потомци"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "А ово су Давидови синови који су му се родили у Хеврону: првенац Амнон, од Ахиноаме Језраелке, други Данило од Авигеје Кармилке,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "трећи Авесалом, син Махе, ћерке Талмаја, гесурског цара, четврти Адонија, син Агитин,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "пети Сефатија од Авитале, шести Итрам од његове жене Егле."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Ових шест му се родило у Хеврону, где је царевао седам година и шест месеци. Тридесет три године је царевао у Јерусалиму."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Ови су му се родили у Јерусалиму: Шима, Совав, Натан и Соломон, четири од Витсавеје, Амилове ћерке;"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Јевар, Елисама и Елифелет,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Нога, Нефег и Јафија,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Елисама, Елијада и Елифелет; њих девет."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Све су ово били Давидови синови, поред синова иноча. Тамара им је била сестра."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Цареви Јуде"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Соломонов син је био Ровоам, његов син Авија, његов син Аса, његов син Јосафат,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "његов син Јорам, а његов син Охозија, његов син Јоас,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "његов син Амасија, његов син Азарија, његов син Јотам,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "његов син Ахаз, његов син Језекија, његов син Манасија,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "његов син Амон, његов син Јосија."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Јосијини синови: првенац Јоанан, други Јоаким, трећи Седекија, четврти Салум."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Синови Јоакимови: његов син Јехонија, и његов син Седекија."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Наследници престола након изгнанства"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Синови сужња Јехоније: његов син Салатило."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Његови синови: Малхирам, Федаја, Сенасар, Јекамија, Осама и Недавија."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Федајини синови: Зоровавељ и Семај. Зоровавељеви синови: Месулам, Хананија, и њихова сестра Селомита."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Месуламови синови: Асува, Оило, Варахија, Асадија и Јусавесед; њих пет."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Хананијини синови: Фелатија и Исаија, и синови Рефаје, Арнана, Овадије и Сеханије."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Сеханијини синови: Семаја, и његови синови: Хатуш, Игал, Варија, Неарија и Сафат; њих шест."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Неаријини синови: Елиоинај, Језекија и Азрикам; њих три."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Елиоинајеви синови: Одавија, Елијасив, Фелаја, Акув, Јоанан, Далаја и Анан; њих седам."
        ]
      }
    ],
