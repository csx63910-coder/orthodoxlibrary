  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "heading",
        "content": [
          "Од Адама до Аврахама"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Нојеви потомци"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Адам, Сит, Енос,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Кајинан, Малелеило, Јаред,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Енох, Матусал, Ламех,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Нојеви синови",
          {
            "noteId": 0
          },
          ": Сим, Хам и Јафет."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Јафетови потомци"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Јафетови синови су: Гомер, Магог, Мидиј, Јаван, Тувал, Месех и Тирас."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Гомерови синови су: Асхенас, Рифат и Тогарма."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Јаванови синови су: Елиса и Тарсис, Китим и Доданим."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Хамови потомци"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Хамови синови су: Куш и Мисраим, Фут и Ханан."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Кушови синови су: Сева, Евила, Савата, Регма и Саватака. Регмини синови су: Сава и Дедан."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Кушу се родио Неврод. Овај је постао први моћник на земљи."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Од Мисраима су, пак, потекли Лудејци, Енемејци, Лавејци и Нафтухијци,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "па Патрошани, Хаслоњани (од којих су потекли Филистејци) и Кафтореји."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ханану се родио Сидон, његов првенац и Хет."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Од Ханана воде порекло Јевусејци, Аморејци, Гергешани,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Евејци, Арукејци, Синијци,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Арвађани, Самарјани и Амаћани."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Симови потомци"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Симови синови: Елам, Асур, Арфаксад, Луд и Арам. А Арамови потомци су: Уз, Ул, Гетер и Месех."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Арфаксаду се, пак, родио Сала, а Сали Евер."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Еверу су се родила два сина: један се звао Фалек, јер су се за време његовог живота људи на земљи поделили",
          {
            "noteId": 1
          },
          "; а његов брат се звао Јектан."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Јектану су се родили Елмодад, Салеф, Ацармавет и Јарах,"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Адорам, Узал, Дикла,"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Евал, Авимаил, Сава,"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Офир, Евила и Јовав; сви ови су били Јектанови синови."
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Сим, Арфаксад, Сала,"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Евер, Фалек, Рагав,"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Серух, Нахор, Тара,"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Аврам, то јест, Аврахам."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Од Аврахама до Јакова"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Синови Аврахамови: Исак и Исмаило."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Агарини потомци"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Ово је њихов родослов: Исмаилов првенац Навајот, па Кедар, Авдеило, Мивсам,"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Мишма, Дума, Маса, Хадад, Тема,"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "Јетур, Нафис и Кедма; то су синови Исмаилови."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Хетурини потомци"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "А синови Хетуре, Аврахамове иноче: она је родила Зомрана, Јоксана, Мадана, Мадијана, Јесвока и Соијена. А Јоксанови синови су: Сава и Дедан."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "Мадијанови синови су: Гефа, Афир, Енох, Авида и Елдага. Све су ово Хетурини потомци."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Сарини потомци"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "Аврахаму се родио Исак; а синови Исакови су били Исав и Израиљ."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Исавови потомци"
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "Исавови синови: Елифас, Рагуило, Јеус, Јеглом и Кореј."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "Синови Елифасови: Теман, Омар, Софар, Готом, Кенез, Тамна и Амалик."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "Синови Рагуилови: Нахат, Зара, Шама и Мозе."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Сирови потомци"
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "Сирови синови: Лотан, Совал, Севегон, Ана, Дисон, Асар и Дисан."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "Лотанови синови: Хорије и Еман. Лотанова сестра је била Тамна."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "Синови Совалови: Голам, Манахат, Евал, Шефија и Онам. Синови Севегонови: Аја и Ана."
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "Синови Анини: Дисон. Дисонови синови: Амада, Асван, Итран и Харан."
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "Синови Асарови: Валан, Заван и Јакан. Синови Дисонови: Уз и Аран."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Владари Едома"
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "А ово су цареви који су владали у земљи Едом, пре него што је и један цар завладао над израиљским народом: Валак, Веоров син, чији град се звао Денава."
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "Кад је Валак умро, на његово место се зацарио Јовав, син Зарин из Восоре."
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "Кад је Јовав умро, на његово место се зацарио Асом из земље Теманаца."
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "Кад је Асом умро, на његово место се зацарио Адад, Варадов син, који је потукао Мадијанце на моавском пољу. Његов град се звао Авит."
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          "Кад је Адад умро, на његово место се зацарио Самала из Масреке."
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          "Кад је Самала умро, на његово место се зацарио Саул из Ровота на Реци."
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          "Кад је Саул умро, на његово место се зацарио Валенон, син Ахворов."
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          "Кад је Валенон умро, на његово место се зацарио Адад. Његов град се звао Пау. Његовој жени је било име Метавеила, која је била ћерка Матраиде, ћерке Мезахавове."
        ]
      },
      {
        "type": "verse",
        "number": 51,
        "content": [
          "А кад је умро Адад, настали су кнезови у Едому: Тамна, Гола, Јетет,"
        ]
      },
      {
        "type": "verse",
        "number": 52,
        "content": [
          "Оливема, Ила, Финон,"
        ]
      },
      {
        "type": "verse",
        "number": 53,
        "content": [
          "Кенез, Теман, Мивсар,"
        ]
      },
      {
        "type": "verse",
        "number": 54,
        "content": [
          "Магедило и Ирам. То су били едомски кнезови."
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 0,
        "caller": "+",
        "text": "1,4 Према Септуагинти.",
        "reference": {
          "chapter": 1,
          "verse": 4
        }
      },
      {
        "noteId": 1,
        "caller": "+",
        "text": "1,19 Поделили се највероватније односи на поделу која је настала у току градње Вавилонске куле. Том приликом је Бог побркао језике, након чега су се људи расејали по целој земљи.",
        "reference": {
          "chapter": 1,
          "verse": 19
        }
      }
    ]
  },
