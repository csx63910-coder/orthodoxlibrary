  "chapter": {
    "number": 16,
    "content": [
      {
        "type": "heading",
        "content": [
          "Ковчег савеза у шатору"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ковчег Господњи су донели и поставили га усред шатора који је Давид разапео за њега. Онда су принели жртве свеспалнице и жртве мира."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Кад је Давид завршио с приношењем жртве свеспалнице и жртве мира, благословио је народ у име Господње."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Затим је разделио свим Израиљцима, и мушкарцима и женама, свакоме по један хлеб, колач од урми и колач од сувог грожђа."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Потом је поставио неке од Левита да служе испред Ковчега Господњег, да зазивају, хвале и славе Господа, Бога Израиљевог:"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Асафа главара, а другог за њим Захарију, па Јеиела, Семирамота, Јехила, Мататију, Елијава, Венају и Овид-Едома. Јеиел је свирао лиру и харфу а Асаф цимбале."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Свештеници Венаја и Јазило су редовно трубили у трубу пред Ковчегом савеза Господњег."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Тог дана је Давид први пут наредио да Асаф и његова браћа приносе хвале Господу:"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Хвалите Господа, призивајте му име,",
            "poem": 1
          },
          {
            "text": "објавите његова дела међу народима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Певајте му, славите га песмом,",
            "poem": 1
          },
          {
            "text": "говорите о свим његовим чудесима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Хвалите се светим именом његовим,",
            "poem": 1
          },
          {
            "text": "нек се радују срца оних који траже Господа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Тражите Господа и његову снагу,",
            "poem": 1
          },
          {
            "text": "тражите свагда лице његово.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Памтите чудеса која је учинио,",
            "poem": 1
          },
          {
            "text": "чуда и судове уста његових.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "О, семе Израиљево, слуго његов,",
            "poem": 1
          },
          {
            "text": "децо Јаковљева, изабраници његови!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Он је Господ, Бог наш, судови су његови",
            "poem": 1
          },
          {
            "text": "по свој земљи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Сећајте се увек његовог савеза,",
            "poem": 1
          },
          {
            "text": "речи што је заповедио за хиљаду нараштаја,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "који је склопио са Аврахамом,",
            "poem": 1
          },
          {
            "text": "и којим се заклео Исаку,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "за уредбу га је поставио Јакову,",
            "poem": 1
          },
          {
            "text": "Израиљу за вечни савез,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "говорећи: „Теби ћу дати земљу хананску,",
            "poem": 1
          },
          {
            "text": "као део вашега наследства.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Док вас је још било мало,",
            "poem": 1
          },
          {
            "text": "тек шачица дошљака у земљи,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "лутајући од народа до народа,",
            "poem": 1
          },
          {
            "text": "од једног царства до другог,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "није дао ником да их тлачи,",
            "poem": 1
          },
          {
            "text": "ради њих је кажњавао цареве.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "„Не дирајте моје помазанике,",
            "poem": 1
          },
          {
            "text": "мојим пророцима злобу не чините!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Певај Господу, сва земљо,",
            "poem": 1
          },
          {
            "text": "дан за даном навешћујте његово спасење.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Објавите му славу међу пуцима,",
            "poem": 1
          },
          {
            "text": "његова чудеса међу свим народима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Јер велик је Господ, многе хвале вредан;",
            "poem": 1
          },
          {
            "text": "страшнији од свих богова.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Јер ништавни су сви богови народа,",
            "poem": 1
          },
          {
            "text": "али Господ је саздао небеса.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Пред њим су слава и величанство,",
            "poem": 1
          },
          {
            "text": "на његовом су месту сила и радост.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Дајте Господу, племена народна,",
            "poem": 1
          },
          {
            "text": "дајте Господу славу и силу,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "дајте Господу славу ради његовог имена,",
            "poem": 1
          },
          {
            "text": "донесите му принос, дођите пред њега,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "клањајте се Господу сјајном у светости,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "дрхти пред њим, сва земљо!",
            "poem": 1
          },
          {
            "text": "Чврсто стоји свет, неће се пољуљати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Нека се радују небеса,",
            "poem": 1
          },
          {
            "text": "нека се весели земља,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "нека се говори међу народима: „Господ влада!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Нека хучи море и све што је у њему,",
            "poem": 1
          },
          {
            "text": "нек се радује поље и све што је на њему.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Тада ће певати шумско дрвеће пред Господом,",
            "poem": 1
          },
          {
            "text": "јер он долази да суди земљи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Хвалите Господа јер је добар,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Реците: „Спаси нас, Боже нашега спасења,",
            "poem": 1
          },
          {
            "text": "скупи нас, избави нас од народа,",
            "poem": 2
          },
          {
            "text": "да хвалимо твоје свето име,",
            "poem": 1
          },
          {
            "text": "да се дичимо твојом славом.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Благословен да је Господ,",
            "poem": 1
          },
          {
            "text": "Бог Израиљев, од века до века.",
            "poem": 2
          },
          "И сав народ нека каже: „Амин“ и „Нек је слава Господу!“"
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "Асафа и његову браћу је оставио тамо пред Ковчегом савеза Господњег да редовно служе пред Ковчегом, како је прописано за сваки дан,"
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "а тако и Овид-Едома и његову браћу, њих шездесет осам; Овид-Едома, сина Једутуновог и Осу као вратаре."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "Свештеника Садока и његову браћу свештенике је оставио пред Пребивалиштем Господњим, на узвишици код Гаваона,"
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "да стално приносе жртве свеспалнице Господу на жртвенику за жртве свеспалнице, ујутро и увече, у складу са свим што је написано у Закону Господњем, који је он дао Израиљу."
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "С њима су били Еман, Једутун и остали изабрани, који су били одређени поименце да приносе хвалу Господу: „Јер је милост његова довека.“"
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "Еман и Једутун су имали да трубе у трубе, и да свирају цимбале и друге музичке справе на славу Богу."
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "Затим се народ вратио својим кућама, а Давид се вратио да благослови свој дом."
        ]
      }
    ],
