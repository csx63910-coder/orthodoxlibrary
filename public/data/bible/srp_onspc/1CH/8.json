  "chapter": {
    "number": 8,
    "content": [
      {
        "type": "heading",
        "content": [
          "Венијаминови потомци"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Венијамину се родио Вела, његов првенац; Асвил је био други, Ара трећи,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Ноја четврти, и Рафај пети."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Велини синови су били: Адар, Гира, Авијуд,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Ависуј, Наман, Ахоја,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Гира, Шефуфан и Урам."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ово су били Ехудови синови. Они су били главари отачких домова становника Гаваје, који су били изгнани у Манахат:"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Наман, Ахија и Гира, који их је одвео у изгнанство; њему су се родили Уза и Ахихуд."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Сарајим је имао синове у моавској земљи након што се развео од својих жена Усиме и Варе."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Он је са својом женом Одесом имао Јовава, Сивију, Мису, Малхама,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Јеуса, Сахију и Мирму. То су били његови синови, и главари отачких домова."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Са Усимом је имао Авитова и Елфала."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Елфалови синови су били: Евер, Мисам и Самед, који је сазидао Онан и Лод и његова села,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "и Верија и Сема, који су били главари отачких домова становника Ајалона; они су натерали у бег становнике Гата."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Ахијо, Сасак, Јеремот,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Зевадија, Арад, Едер,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Михаило, Јеспа и Јоха били су Веријини синови."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Зевадија, Месулам, Језекија, Хевер,"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Исмерај, Језлија и Јовав били су Елфалови синови."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Јаким, Зихрије, Завдије,"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Елинај, Цилтај, Елило,"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Адаја, Вераја и Симрат били су Семајеви синови."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Јишпан, Евер, Елило,"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Авдон, Зихрије, Анан,"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Хананија и Елам и Антотија,"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Јефедија, и Фануило, били су Сасакови синови."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Самсерај, Сеарија, Готолија,"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Јересија, Илија и Зихрије, били су Јероамови синови."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Ови су били главари отачких домова по својим родословима. Живели су у Јерусалиму."
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Гаваонов отац је живео у Гаваону. Жена му се звала Маха."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Његов првенац је био Авдон, па Сур, Кис, Вал, Надав,"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "Гедор, Ахијо, Захер,"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "и Миклот, коме се родио Сима. Они су са својом браћом живели у Јерусалиму насупрот својих сродника."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "Неру се родио Кис, Кису се родио Саул, а Саулу су се родили Јонатан, Малхи-Сув, Авинадав и Есвал."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "Јонатанов син је био Меривал",
          {
            "noteId": 11
          },
          ", а Меривалу се родио Миха."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "Михини синови су били: Фитон, Мелех, Тареја и Ахаз."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "Ахазу се родио Јоада, а Јоади су се родили Алемет, Азмавет и Зимрије. Зимрији се родио Моса."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "Моси се родио Винеја; његов син је био Рафај, његов син Елеаса и његов син Ацел."
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "Ацел је имао шест синова, а ово су им имена: Азрикам, Вохеруј, Исмаило, Сеарија, Овадија и Анан. Сви ови су били Ацелови синови."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "А синови његовог брата Исека: његов првенац Улам, Јеус други, и Елифелет трећи."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "Уламови синови су били храбри ратници, који су натезали лук. Имали су много синова и унука, стотину педесет. Сви ови су били Венијаминови потомци."
        ]
      }
    ],
