  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "heading",
        "content": [
          "Соломон зида Дом Господњи"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Соломон је почео да зида Дом Господњи у Јерусалиму, на брду Морији, где се Господ објавио његовом оцу Давиду. То је место Давид већ припремио на гумну Јевусејца Орне."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Он је почео да зида другог дана, другог месеца, четврте године своје владавине."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "И постави темеље Соломон за Дом Господњи, по старим мерама у дужину шездесет лаката а у ширину двадесет лаката.",
          {
            "noteId": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Трем се налазио с прочеља Дома и одговарао је његовој ширини – двадесет лаката",
          {
            "noteId": 3
          },
          "– а био је висок стотину двадесет лаката.",
          {
            "noteId": 4
          },
          "Изнутра је био обложен чистим златом."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Највеће површине Дома је обложио чемпресовим дрветом и чистим златом, а сводове украсио палмама и ланцима."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ради лепоте, Дом је украсио драгим камењем и златом из Парваима."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Златом обложи и греде, прагове, зидове, врата, а на зидовима је изрезбарио златне херувиме."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "У Дому је, по његовој дужини сазидао Светињу над светињама. Њена дужина и ширина су били двадесет лаката",
          {
            "noteId": 5
          },
          ". Обложио ју је са шест стотина таланата",
          {
            "noteId": 6
          },
          "чистог злата."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Позлаћени ексери су тежили педесет шекела,",
          {
            "noteId": 7
          },
          "а и горње просторије је обложио златом."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "У Светињи над светињама уметници су излили два херувима и обложили их златом."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Крила херувима су била дуга двадесет лаката, а свако од њих пет лаката",
          {
            "noteId": 8
          },
          ". Први је једним крилом дотицао крило другог, а другим крилом зид одаје."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "И други је крилом, пет лаката",
          {
            "noteId": 9
          },
          "дугим, дотицао зид, а другим се спајао са исто толико дугим крилом првог."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Двадесет лаката",
          {
            "noteId": 10
          },
          "у дужину имају крила кад су раширена, а херувими су стајали на ногама лицем окренути према Дому."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Сашио је завесу од раскошног гримизног и скерлетног платна, од финог лана и извезао по њему херувиме."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Испред Дома је подигао два стуба висока тридесет пет лаката, који су на врху имали пет лаката дуга оглавља",
          {
            "noteId": 11
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Поставио је ланце у Светињи над светињама и њима оплео врх стубова, а ланце је украсио са стотину нарова."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Стубове је поставио испред Дома, један с леве, а други с десне стране. Десног је назвао Јакин а левог Воаз."
        ]
      }
    ],
