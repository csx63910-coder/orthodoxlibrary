  "chapter": {
    "number": 23,
    "content": [
      {
        "type": "heading",
        "content": [
          "Валамова прва прича"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Валам рече Валаку: „Подигни ми овде седам жртвеника и припреми ми седам јунаца и седам овнова.“"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Валак учини онако како му је Валам рекао. Затим су Валак и Валам принели на жртвенику једног јунца и једног овна."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Валам рече Валаку: „Остани код своје свеспалнице, а ја ћу поћи; можда ће се Господ срести са мном, па шта ми каже, то ћу говорити.“ Тако оде он на узвишицу."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Господ је срео Валама, и Валам му је рекао: „Припремио сам седам жртвеника и на сваком жртвенику принео једног јунца и једног овна.“"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Тада Господ стави реч у Валамова уста и рече: „Врати се Валаку и говори тако.“"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Кад се вратио Валаку, овај је стајао код своје свеспалнице са свим моавским кнезовима."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Тада Валам изрече своју причу:",
          {
            "text": "„Из Арама ме Валак доведе,",
            "poem": 1
          },
          {
            "text": "цар моавски из горја источног:",
            "poem": 2
          },
          {
            "text": "’Дођи – рече – Јакова ми прокуни,",
            "poem": 1
          },
          {
            "text": "дођи и Израиљ презри!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Како да прокунем",
            "poem": 1
          },
          {
            "text": "кога Бог не проклиње,",
            "poem": 2
          },
          {
            "text": "и презрем",
            "poem": 1
          },
          {
            "text": "кога Господ не презире?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Јер гледам га с планинских врхова,",
            "poem": 1
          },
          {
            "text": "посматрам га с горских узвишења;",
            "poem": 2
          },
          {
            "text": "гле народа који живи издвојено,",
            "poem": 1
          },
          {
            "text": "међу народе он се не рачуна.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ко ће избројити прах Јаковљев,",
            "poem": 1
          },
          {
            "text": "ко да изброји четвртину Израиља?",
            "poem": 2
          },
          {
            "text": "О, кад бих умро смрћу праведничком,",
            "poem": 1
          },
          {
            "text": "кад би и мој крај био као њихов!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Тада Валак рече Валаму: „Шта си ми то учинио? Довео сам те да прокунеш моје непријатеље, а ти си их обилно благословио.“"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Валам одговори: „Зар да не кажем верно оно што ми је Господ ставио у уста?“"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Валамова друга прича"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Валак му рече: „Пођи са мном на друго место; одатле ћеш видети само један његов део, а не сав народ. Оданде ми га прокуни.“"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Затим га је одвео у Зофимско поље, на врх Фасге. Тамо је подигао седам жртвеника и на сваком жртвенику принео по једног јунца и овна."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Валам рече Валаку: „Стани ту код своје свеспалнице, а ја идем онамо да се сретнем с Господом.“"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Господ сретне Валама, стави своју реч у његова уста и рече: „Врати се Валаку и говори овако.“"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Када се вратио к њему, Валак је стајао код своје свеспалнице са моавским кнезовима. Валак га упита: „Шта је Господ рекао?“"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Тада Валам изрече своју причу:",
          {
            "text": "„Устани, Валаче,",
            "poem": 1
          },
          {
            "text": "послушај ме, сине Сефоров!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Бог није човек да би слагао,",
            "poem": 1
          },
          {
            "text": "или потомак људски да би се кајао.",
            "poem": 2
          },
          {
            "text": "Зар је шта рекао да није учинио,",
            "poem": 1
          },
          {
            "text": "изрекао да није испунио?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Заповест ми даде да благосиљам,",
            "poem": 1
          },
          {
            "text": "благослов је дао и нећу га повући.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Не назире се несрећа у Јакову,",
            "poem": 1
          },
          {
            "text": "невоља се не види у Израиљу.",
            "poem": 2
          },
          {
            "text": "С њим је Господ, Бог његов,",
            "poem": 1
          },
          {
            "text": "царски му поклик сред њега одзвања!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Бог их је из Египта извео,",
            "poem": 1
          },
          {
            "text": "он је њему као рози биволови.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Против Јакова нема врачања,",
            "poem": 1
          },
          {
            "text": "против Израиља нема гатања.",
            "poem": 2
          },
          {
            "text": "Нек се сада прича о Јакову,",
            "poem": 1
          },
          {
            "text": "о Израиљу нек се приповеда:",
            "poem": 2
          },
          {
            "text": "’Ево, шта је Бог учинио!’",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Какав ли је то само народ!",
            "poem": 1
          },
          {
            "text": "Као лавица устаје,",
            "poem": 2
          },
          {
            "text": "као лав се диже,",
            "poem": 1
          },
          {
            "text": "не леже док улов не прождере",
            "poem": 2
          },
          {
            "text": "и крви се жртава не напије.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Тада Валак рече Валаму: „Кад га већ не можеш проклети, немој га ни благосиљати!“"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Валам одговори Валаку: „Зар ти нисам рекао: ’Учинићу све што ми Господ буде рекао?’“"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Валамова трећа прича"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Валам рече Валаку: „Хајде да те одведем на друго место; можда ће Богу бити по вољи да ми их прокунеш оданде!“"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Валак поведе Валама на врх Фегора који се надвија над пустаром."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Валам рече Валаку: „Подигни ми овде седам жртвеника и припреми ми седам јунаца и седам овнова.“"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Валак је урадио како му је Валам рекао, и принео седам јунаца и седам овнова."
        ]
      }
    ],
