  "chapter": {
    "number": 21,
    "content": [
      {
        "type": "heading",
        "content": [
          "Разорење Арада"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Кад је цар Арада, Хананац који је живео у Негеву, чуо да Израиљ долази из правца Атарина, напао је Израиљце и заробио неке од њих."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Тада се Израиљ заветовао Господу, рекавши: „Ако предаш овај народ у наше руке, изручићемо његове градове клетом уништењу.“"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Господ је услишио Израиљев глас и предао им Хананце. Изручили су клетом уништењу и њих и њихове градове. Зато се то место прозвало Орма",
          {
            "noteId": 23
          },
          "."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Бронзана змија"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Са горе Ор су се запутили путем према Црвеном мору, да би заобишли едомску земљу. Али народ је на путу постао нестрпљив."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Тада је народ рекао против Бога и против Мојсија: „Зашто сте нас извели из Египта? Да помремо у пустињи? Јер нема ни хлеба ни воде, а ова јадна храна нам се огадила.“"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Тада је Господ послао на народ отровне змије",
          {
            "noteId": 24
          },
          "; оне су их уједале, па је помрло много народа у Израиљу."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Народ је дошао к Мојсију и рекао: „Згрешили смо кад смо говорили против Господа и против тебе. Помоли се Господу да уклони змије од нас!“ Мојсије се помолио за народ."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Господ рече Мојсију: „Направи змију отровницу и постави је на стуб. Буде ли ко уједен, нека погледа на њу и преживеће.“"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Мојсије направи бронзану змију и постави је на стуб. И кад би змија ујела неког, тај би погледао у змију и оздравио."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Пут за Моав"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Израиљци су наставили и утаборили се у Овоту."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Напустивши Овот, утаборили су се код Ије-Аварима, у пустињи насупрот Моава, према истоку."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Оданде су отишли и утаборили се код потока Зареда."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Кад су отишли оданде, утаборили су се на другој страни Арнона, који је у пустињи и извире на аморејској међи. Наиме, Арнон је моавска граница, између Моаваца и Аморејаца."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Зато се каже у Књизи Господњих ратова:",
          {
            "text": "„Вајев код Суфе и арнонски потоци,",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "с притокама што допиру до места Ара,",
            "poem": 2
          },
          {
            "text": "и наслањају се на моавску границу.“",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Оданде оду до Вира, бунара где је Господ рекао Мојсију: „Окупи народ да им дам воду.“"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Тада је Израиљ запевао ову песму:",
          {
            "text": "„Покуљај, бунаре! Запојте му:",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Бунар су кнезови ископали,",
            "poem": 1
          },
          {
            "text": "издубили га великаши народни,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "жезлом и штаповима својим.“",
            "poem": 2
          },
          "Из пустиње одоше у Мантанаин,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "из Мантанаина у Нахалиел, а из Нахалиела у Вамот;"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "из Вамота у долину што је у моавској земљи, код врхунца Фасге што се надвија над пустаром."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Ратови против Сихона и Ога"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Израиљ је послао гласнике Сихону, аморејском цару, с поруком:"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "„Дозволи ми да прођем кроз твоју земљу. Нећемо скретати ни у поља ни у винограде, и нећемо пити воду из бунара, него ћемо ићи царским путем, док не прођемо твоје подручје.“"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Међутим, Сихон није дозволио Израиљу да прође кроз његово подручје. Сихон је скупио сав свој народ и изашао да пресретне Израиља у пустињи. Кад је дошао до Јасе, ступио је у бој против Израиља."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Израиљ га је потукао оштрим мачем и освојио његову земљу од Арнона до Јавока, све до Амонаца, јер је амонска граница била утврђена."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Израиљ је заузео све те градове и настанио се у свим аморејским градовима, Есевону и свим његовим селима."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "А Есевон је био град аморејског цара Сихона, који је ратовао против пређашњег моавског цара, од кога је одузео сву његову земљу све до Арнона."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Зато песници кажу:",
          {
            "text": "„Дођите у Есевон да се подигне",
            "poem": 1
          },
          {
            "text": "и утврди Сихонов град!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Јер сукну огањ из Есевона,",
            "poem": 1
          },
          {
            "text": "пламен из града Сихоновог,",
            "poem": 2
          },
          {
            "text": "те прогута Ар моавски",
            "poem": 1
          },
          {
            "text": "и становнике висина арнонских.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Тешко теби, Моаве,",
            "poem": 1
          },
          {
            "text": "пропао си, народе Хамосов.",
            "poem": 2
          },
          {
            "text": "Своје је синове учинио избеглицама,",
            "poem": 1
          },
          {
            "text": "а ћерке своје заточеницама",
            "poem": 2
          },
          {
            "text": "Сихона, цара аморејског.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "И потукосмо их;",
            "poem": 1
          },
          {
            "text": "пропаде Есевон све до Девона,",
            "poem": 2
          },
          {
            "text": "опустошисмо их до Нофа",
            "poem": 1
          },
          {
            "text": "што се пружа до Медеве.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "Тако се Израиљ настанио у аморејској земљи."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Након што је Мојсије послао људе да извиде Јазир, Израиљци су освојили његова села и изгнали Аморејце који су тамо живели."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "Потом су се окренули и кренули горе путем за Васан. Тада је Ог, васански цар, и сав његов народ изашао против њих у бој код Едрајина."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "Господ рече Мојсију: „Не бој га се, јер сам у твоје руке предао и њега, и сав његов народ, и његову земљу. Учини с њим као што си учинио с аморејским царем Сихоном, који је живео у Есевону.“"
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "Тада су потукли њега, његове синове и сав његов народ, тако да му није остао ниједан преживели; а његову земљу су запосели."
        ]
      }
    ],
    "footnotes": [
