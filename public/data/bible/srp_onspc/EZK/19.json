  "chapter": {
    "number": 19,
    "content": [
      {
        "type": "heading",
        "content": [
          "Нарицаљка о Израиљевом паду"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "А ти изреци нарицаљку за израиљским кнезовима."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Реци:",
          {
            "text": "’Шта је била мати твоја? Лавица!",
            "poem": 1
          },
          {
            "text": "Међу лавовима је лежала,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "међу младим лавовима младе је хранила.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Кад једног младунца отхрани,",
            "poem": 1
          },
          {
            "text": "млад лав од њега постаде.",
            "poem": 2
          },
          {
            "text": "Научио се да плен раздире,",
            "poem": 1
          },
          {
            "text": "па је људе стао да прождире.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Народи су за њега дочули;",
            "poem": 1
          },
          {
            "text": "у њихову се јаму ухватио,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "у ланцима га у Египат одведоше.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "А кад виде да узалуд чека,",
            "poem": 1
          },
          {
            "text": "и да јој се нада развејала,",
            "poem": 2
          },
          {
            "text": "она узе другога младунца,",
            "poem": 1
          },
          {
            "text": "и од њега учини лавића.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Међу лавовима он је ишао,",
            "poem": 1
          },
          {
            "text": "у младога је лава израстао.",
            "poem": 2
          },
          {
            "text": "Научио се да плен раздире,",
            "poem": 1
          },
          {
            "text": "па је људе стао да прождире.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Рушио је њихове дворове,",
            "poem": 1
          },
          {
            "text": "пустошио њихове градове,",
            "poem": 2
          },
          {
            "text": "Земља и сви што у њој живе,",
            "poem": 1
          },
          {
            "text": "испразни се од рике његове.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Скупише се народи на њега,",
            "poem": 1
          },
          {
            "text": "из околних крајева дођоше,",
            "poem": 2
          },
          {
            "text": "своје мреже разапеше над њим,",
            "poem": 1
          },
          {
            "text": "и ухвати се у јаму њихову.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "У ланцима га у кавез метнуше,",
            "poem": 1
          },
          {
            "text": "доведоше га цару у Вавилон.",
            "poem": 2
          },
          {
            "text": "У тамницу су њега бацили,",
            "poem": 1
          },
          {
            "text": "да се рика његова више не чује",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "по горама израиљским.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Мати ти је била као лоза,",
            "poem": 1
          },
          {
            "text": "засађена крај обилних вода.",
            "poem": 2
          },
          {
            "text": "Плодна беше и са пуно лишћа,",
            "poem": 1
          },
          {
            "text": "натапана обилним водама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Гране су јој биле моћне,",
            "poem": 1
          },
          {
            "text": "свака беше као жезло царско.",
            "poem": 2
          },
          {
            "text": "Висином се више крошњи дигла,",
            "poem": 1
          },
          {
            "text": "висина јој беше на видику",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "са гранама својим многобројним.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ишчупаше је гневно,",
            "poem": 1
          },
          {
            "text": "и бацише на земљу.",
            "poem": 2
          },
          {
            "text": "Осуши је ветар источни,",
            "poem": 1
          },
          {
            "text": "род јој би покидан, осушен,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а моћне гране огањ је прождро.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "А сада је у пустињи засађена,",
            "poem": 1
          },
          {
            "text": "у земљи сувој и жедној.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Плану огањ из једнога прута,",
            "poem": 1
          },
          {
            "text": "род јој прождра;",
            "poem": 2
          },
          {
            "text": "Не оста јој моћна грана,",
            "poem": 1
          },
          {
            "text": "достојна жезла владарског.’“",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          "То је нарицаљка, и тако треба да се нариче."
        ]
      }
    ],
