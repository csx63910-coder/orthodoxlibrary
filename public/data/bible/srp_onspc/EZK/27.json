  "chapter": {
    "number": 27,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "И дође ми реч Господња:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "„Сине човечији, запевај тужбалицу о Тиру!"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Реци Тиру:",
          {
            "text": "’О, ти што столујеш на вратима морским,",
            "poem": 1
          },
          {
            "text": "што тргујеш с народима на многим острвима,",
            "poem": 2
          },
          {
            "text": "Говори Господ Бог: о, Тире, ти рече:",
            "poem": 1
          },
          {
            "text": "„Ја сам савршенство лепоте!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Границе твоје у срцу су мора,",
            "poem": 1
          },
          {
            "text": "савршена твоја лепота твојих је зидара дело.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Од чемпреса сенирских",
            "poem": 1
          },
          {
            "text": "све су ти даске начинили,",
            "poem": 2
          },
          {
            "text": "с Ливана кедар узеше,",
            "poem": 1
          },
          {
            "text": "да ти јарбол начине,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "од храстова васанских,",
            "poem": 1
          },
          {
            "text": "весла су ти направили,",
            "poem": 2
          },
          {
            "text": "а палубу од борова с китимских острва;",
            "poem": 1
          },
          {
            "text": "слонову кост у њу су уметнули.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Једро ти је било од лана везеног, египатског,",
            "poem": 1
          },
          {
            "text": "а застори од гримиза и скерлета с острва елиских.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Мештани Сидона и Арвада били су ти веслачи,",
            "poem": 1
          },
          {
            "text": "мудраци твоји, Тире, били су ти кормилари.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Старешине гевалске и мудраци његови",
            "poem": 1
          },
          {
            "text": "пукотине су твоје поправљали;",
            "poem": 2
          },
          {
            "text": "све лађе на мору и посада њихова",
            "poem": 1
          },
          {
            "text": "долазили су да од тебе робу купују.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Људи из Персије, Луда и Фута,",
            "poem": 1
          },
          {
            "text": "твоји су били ратници.",
            "poem": 2
          },
          {
            "text": "О твоје су зидове штитове и шлемове качили,",
            "poem": 1
          },
          {
            "text": "и китили те сјајем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Арвађани и војска твоја на твојим зидовима,",
            "poem": 1
          },
          {
            "text": "куле су твоје Гамадити чували унаоколо.",
            "poem": 2
          },
          {
            "text": "Штитове су своје качили на твоје зидове",
            "poem": 1
          },
          {
            "text": "да дотерају твоју лепоту.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Тарсис је трговао с тобом; због твог силног богатства свакојаког плаћао је твоју робу сребром и гвожђем, калајем и оловом."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Јаван, Тувал и Месех су трговали с тобом размењујући робље и бронзано посуђе за твоју робу."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Они из дома Тогарминог размењивали су коње, јахаће коње и мазге за твоју робу."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Синови Деданови су трговали с тобом. И многа су острва трговала за тебе; доносили су ти као накнаду слонову кост и ебоново дрво."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Арам је трговао с тобом због обиља твојих производа; плаћали су за твоју робу малахитима, скерлетом, везеним платном и финим ланом, коралима и рубинима."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Јуда и земља Израиљева су трговали с тобом; плаћали су за твоју робу пшеницом из Минита, брашном, медом, уљем и мелемом."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Дамаск је, због обиља твојих производа сваке врсте, трговао с тобом хелвонским вином и вуном из Сахара."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Дан и Јаван из Узала за твоју су робу давали обрађено гвожђе, касију и трску."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Дедан је трговао с тобом с јахачким простиркама."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Арабљани и сви кнезови кедарски трговали су с тобом и плаћали ти јагањцима, овновима и јарцима."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Трговци из Саве и Регме су трговали с тобом. За твоју робу плаћали су најбољим зачинима сваке врсте, свакојаким драгуљима и златом."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Харан, Кана, Еден, савски трговци, Асирија и Хилмад, су трговали с тобом."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Трговали су с тобом на твојој пијаци у замену за најбоље рухо од везене пурпурне тканине, и разнобојне тепихе од чврсто уплетених нити."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Тарсиске лађе превозиле су твоју робу. Био си пун и веома натоварен на морској пучини."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Твоји веслачи су те извели на пучину, али источни ветар те је разбио усред мора."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Твоје богатство, твоја роба, твоји морепловци, твоји морнари, кормилари и мајстори за твоје пукотине, твоји трговци, сви ратници у теби, и сви који су на палуби, пашће у морске дубине у дан твога пада."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Кад се зачује вапај твојих кормилара затрешће се обала."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Тада ће сви веслачи, морнари и сви морски кормилари напустити своје лађе и искрцати се на земљу."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Они ће подићи свој глас и горко завапити над тобом. Прашином ће посути своју главу и ваљати се у пепелу,"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "обријаће главу за тобом, припасаће кострет, па ће, огорчене душе, плакати за тобом и горко нарицати."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Закукаће и запевати нарицаљку над тобом:",
          {
            "text": "„Ко је као Тир",
            "poem": 1
          },
          {
            "text": "ућуткан усред мора?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Кад су ти робу довозили с мора,",
            "poem": 1
          },
          {
            "text": "њом си ситио многе народе;",
            "poem": 2
          },
          {
            "text": "обиљем блага и робом својом,",
            "poem": 1
          },
          {
            "text": "ти си богатио цареве земаљске.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "А сада те море разби у води дубокој,",
            "poem": 1
          },
          {
            "text": "роба твоја пропаде, и сав народ у теби.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Сви су житељи острвски запањени над тобом;",
            "poem": 1
          },
          {
            "text": "цареве им подилази језа, од страха им се лице грчи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Трговци народа звижде над тобом;",
            "poem": 1
          },
          {
            "text": "постао си ругло",
            "poem": 2
          },
          {
            "text": "и више те неће бити.’“",
            "poem": 1
          }
        ]
      }
    ],
