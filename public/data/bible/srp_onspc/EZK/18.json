    "order": 26,
    "numberOfChapters": 48,
    "sha256": "75d6fa469481d8eabc0e3ed6b6e2fab2e1f4ff8eb59f8f662f55e6957a50fd02",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/EZK/1.json",
