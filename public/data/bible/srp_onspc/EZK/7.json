  "book": {
    "id": "EZK",
    "translationId": "srp_onspc",
    "name": "Књига пророка Језекиља",
    "commonName": "Књига пророка Језекиља",
    "title": "Књига пророка Језекиља",
    "order": 26,
    "numberOfChapters": 48,
    "sha256": "75d6fa469481d8eabc0e3ed6b6e2fab2e1f4ff8eb59f8f662f55e6957a50fd02",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/EZK/1.json",
    "lastChapterNumber": 48,
    "lastChapterApiLink": "/api/srp_onspc/EZK/48.json",
    "totalNumberOfVerses": 1273
  },
  "chapter": {
    "number": 7,
    "content": [
      {
        "type": "heading",
        "content": [
          "Предстојећа пропаст"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Дође ми реч Господња:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Сине човечији, говори Господ Бог земљи израиљској:",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "’Крај, дошао је крај",
            "poem": 1
          },
          {
            "text": "на четири краја земље!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Сада ти је дошао крај,",
            "poem": 1
          },
          {
            "text": "јер ћу послати свој гнев на тебе.",
            "poem": 2
          },
          {
            "text": "Судићу ти по твојим путевима",
            "poem": 1
          },
          {
            "text": "и платићу ти за све твоје гадости.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Моје ти се око неће сажалити,",
            "poem": 1
          },
          {
            "text": "нећу те поштедети,",
            "poem": 2
          },
          {
            "text": "него ћу ти платити за твоје путеве",
            "poem": 1
          },
          {
            "text": "и за гадости у теби.",
            "poem": 2
          },
          "Тада ћете знати да сам ја Господ.’"
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Говори Господ Бог:",
          {
            "text": "’Долази зло за злом.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Дошао је крај!",
            "poem": 1
          },
          {
            "text": "Крај је стигао!",
            "poem": 2
          },
          {
            "text": "Гле, дошао је,",
            "poem": 1
          },
          {
            "text": "на тебе се намерио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Куцнуо ти је час,",
            "poem": 1
          },
          {
            "text": "житељу земље,",
            "poem": 2
          },
          {
            "text": "време је дошло,",
            "poem": 1
          },
          {
            "text": "близу је дан;",
            "poem": 2
          },
          {
            "text": "страхота је у горама,",
            "poem": 1
          },
          {
            "text": "а не радост.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Свој бес ћу убрзо излити на тебе,",
            "poem": 1
          },
          {
            "text": "гнев ћу свој искалити на теби.",
            "poem": 2
          },
          {
            "text": "Судићу ти по твојим путевима,",
            "poem": 1
          },
          {
            "text": "платићу ти за све гадости твоје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Моје ти се око неће сажалити,",
            "poem": 1
          },
          {
            "text": "нећу те поштедети,",
            "poem": 2
          },
          {
            "text": "него ћу ти платити за твоје путеве,",
            "poem": 1
          },
          {
            "text": "и за гадости које су у теби.",
            "poem": 2
          },
          {
            "text": "Тада ћеш знати да то ја, Господ, ударам.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Дан је, ево, дошао!",
            "poem": 1
          },
          {
            "text": "Пропаст је изникла,",
            "poem": 2
          },
          {
            "text": "штап је процветао,",
            "poem": 1
          },
          {
            "text": "охолост напупела!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Насиље је израсло",
            "poem": 1
          },
          {
            "text": "у штап безакоња.",
            "poem": 2
          },
          {
            "text": "Нико од њих неће остати,",
            "poem": 1
          },
          {
            "text": "ништа од њиховог мноштва,",
            "poem": 2
          },
          {
            "text": "ништа од њиховог блага,",
            "poem": 1
          },
          {
            "text": "ничега вредног међу њима!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Дошло је време, приспео је дан.",
            "poem": 1
          },
          {
            "text": "Ко купује, нека се не весели,",
            "poem": 2
          },
          {
            "text": "ко продаје, нека не жали,",
            "poem": 1
          },
          {
            "text": "јер гнев долази на све мноштво.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ко продаје неће моћи да поврати што је продао,",
            "poem": 1
          },
          {
            "text": "докле год су обојица живи,",
            "poem": 2
          },
          {
            "text": "јер је виђење за све мноштво",
            "poem": 1
          },
          {
            "text": "и неће бити опозвано.",
            "poem": 2
          },
          {
            "text": "Због своје кривице",
            "poem": 1
          },
          {
            "text": "нико неће сачувати свој живот.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "У трубе су затрубили,",
            "poem": 1
          },
          {
            "text": "све је спремно,",
            "poem": 2
          },
          {
            "text": "али нема никог да у бој пође,",
            "poem": 1
          },
          {
            "text": "јер мој је гнев над свим мноштвом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Напољу је мач,",
            "poem": 1
          },
          {
            "text": "а унутра зараза и глад;",
            "poem": 2
          },
          {
            "text": "ко је напољу погинуће од мача,",
            "poem": 1
          },
          {
            "text": "а ко је унутра,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "њега ће прождрети глад и зараза.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "А њихови преживели који умакну,",
            "poem": 1
          },
          {
            "text": "биће по горама,",
            "poem": 2
          },
          {
            "text": "као голубови по долинама,",
            "poem": 1
          },
          {
            "text": "и сви ће уздисати,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "сваки за своју кривицу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Све ће руке малаксати,",
            "poem": 1
          },
          {
            "text": "а сва ће колена постати као да су од воде.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Опасиваће се кострећу,",
            "poem": 1
          },
          {
            "text": "дрхтање ће их обузети,",
            "poem": 2
          },
          {
            "text": "на сваком ће лицу бити срам,",
            "poem": 1
          },
          {
            "text": "и свака ће глава оћелавити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Избациће на улице своје сребро",
            "poem": 1
          },
          {
            "text": "и злато као смеће.",
            "poem": 2
          },
          {
            "text": "Њихово сребро и злато",
            "poem": 1
          },
          {
            "text": "неће моћи да их избави у дан гнева Господњег.",
            "poem": 2
          },
          {
            "text": "Но, своју глад неће утолити,",
            "poem": 1
          },
          {
            "text": "своје трбухе неће напунити,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер су због тога посрнули у кривицу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Дичили су се својим дивним накитом;",
            "poem": 1
          },
          {
            "text": "од њега су правили ликове својих одвратних и гадних ствари.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Зато ћу им га претворити у смеће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Онда ћу га предати у руке туђинаца да га оплене,",
            "poem": 1
          },
          {
            "text": "и зликовцима на земљи да га опљачкају,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "који ће га оскрнавити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Окренућу своје лице од њих,",
            "poem": 1
          },
          {
            "text": "па нека се скрнави моје благо;",
            "poem": 2
          },
          {
            "text": "нека разбојници упадају у њега",
            "poem": 1
          },
          {
            "text": "и нека га оскрнаве!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Искуј окове,",
            "poem": 1
          },
          {
            "text": "јер је земља пуна крви неправедно осуђених,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а град пун насиља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Зато ћу довести најгоре међу народима",
            "poem": 1
          },
          {
            "text": "да запоседну њихове куће.",
            "poem": 2
          },
          {
            "text": "Тако ћу докрајчити понос моћних,",
            "poem": 1
          },
          {
            "text": "а њихова светилишта ће бити оскрнављена.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Кад страхота дође,",
            "poem": 1
          },
          {
            "text": "тражиће мир, а њега неће бити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Једна ће пропаст ићи за другом,",
            "poem": 1
          },
          {
            "text": "једна лоша вест стизаће за другом.",
            "poem": 2
          },
          {
            "text": "Тада ће тражити виђење од пророка,",
            "poem": 1
          },
          {
            "text": "али ће свештеник остати без Закона,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а старешине без савета.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Цар ће туговати,",
            "poem": 1
          },
          {
            "text": "кнез бити обучен у очај,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а руке народа земље ће дрхтати.",
            "poem": 2
          },
          {
            "text": "Поступаћу с њима по њиховим путевима",
            "poem": 1
          },
          {
            "text": "и судити им по њиховим судовима.",
            "poem": 2
          },
          {
            "text": "Тада ће знати да сам ја Господ.’“",
            "poem": 3
          }
        ]
      }
    ],
