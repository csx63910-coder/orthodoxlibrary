  "chapter": {
    "number": 28,
    "content": [
      {
        "type": "heading",
        "content": [
          "Пророштво против тирског кнеза"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Дође ми реч Господња:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "„Сине човечији, реци тирском владару: ’Говори Господ Бог:",
          {
            "text": "Узохолио си се у срцу говорећи:",
            "poem": 1
          },
          {
            "text": "„Ја сам бог;",
            "poem": 2
          },
          {
            "text": "седим на Божијем престолу",
            "poem": 1
          },
          {
            "noteId": 8
          },
          {
            "text": "у срцу мора.“",
            "poem": 2
          },
          {
            "text": "Ипак, ти си само човек, а не Бог,",
            "poem": 1
          },
          {
            "text": "иако свој ум изједначаваш с Божијим умом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ето, мудрији си од Данила;",
            "poem": 1
          },
          {
            "text": "ниједна тајна ти није скривена.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Стекао си себи богатство",
            "poem": 1
          },
          {
            "text": "мудрошћу и разумом,",
            "poem": 2
          },
          {
            "text": "накупио си сребро и злато",
            "poem": 1
          },
          {
            "text": "у својим ризницама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Умножио си своје богатство",
            "poem": 1
          },
          {
            "text": "великом својом мудрошћу у трговини,",
            "poem": 2
          },
          {
            "text": "али си се узохолио у срцу",
            "poem": 1
          },
          {
            "text": "због свог богатства.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Зато говори Господ Бог:",
          {
            "text": "Зато што изједначаваш свој ум",
            "poem": 1
          },
          {
            "text": "с Божијим умом,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "ево, довешћу на тебе туђинце,",
            "poem": 1
          },
          {
            "text": "најнемилосрдније међу народима,",
            "poem": 2
          },
          {
            "text": "а они ће исукати мачеве",
            "poem": 1
          },
          {
            "text": "на лепоту твоје мудрости",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и окаљати твој сјај.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Бациће те у јаму",
            "poem": 1
          },
          {
            "text": "и умрећеш смрћу посечених усред мора.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Хоћеш ли пред својим погубитељем да кажеш: „Ја сам Бог“?",
            "poem": 1
          },
          {
            "text": "Ти си човек, а не Бог,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "кад паднеш у руке својих погубитеља!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Умрећеш смрћу необрезаних руком туђинаца,",
            "poem": 1
          },
          "јер сам ја то рекао – говори Господ Бог.’“"
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Опет ми дође реч Господња:"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "„Сине човечији, испевај тужбалицу против тирског цара. Реци му: ’Говори Господ Бог:",
          {
            "text": "Ти си печат савршенства,",
            "poem": 1
          },
          {
            "text": "пун мудрости и савршен у лепоти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Био си у Едену, врту Божијем,",
            "poem": 1
          },
          {
            "text": "сав окићен драгим камењем:",
            "poem": 2
          },
          {
            "text": "рубином, топазом, дијамантом,",
            "poem": 1
          },
          {
            "text": "хрисолитом, ониксом, јасписом,",
            "poem": 2
          },
          {
            "text": "сафиром, малахитом и смарагдом;",
            "poem": 1
          },
          {
            "text": "златом те уоквирили и извезли,",
            "poem": 2
          },
          {
            "text": "учврстили их у дан кад си био створен.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Учиних те херувимом заштитником,",
            "poem": 2
          },
          {
            "text": "поставих те на свету гору Божију,",
            "poem": 1
          },
          {
            "text": "ходио си посред огњеног камења.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Беспрекоран беше на путевима својим,",
            "poem": 1
          },
          {
            "text": "од дана кад си створен,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "до дана кад се неправда нашла на теби.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Због обиља твоје трговине",
            "poem": 1
          },
          {
            "text": "напунило се насиље у теби; згрешио си.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Зато те збацих нечистог с горе Божије",
            "poem": 2
          },
          {
            "text": "и уклоних те, херувиме заштитниче,",
            "poem": 1
          },
          {
            "text": "испред огњеног камења.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Понело се срце твоје због твоје лепоте,",
            "poem": 1
          },
          {
            "text": "упропасти мудрост своју због свог сјаја.",
            "poem": 2
          },
          {
            "text": "И бацио сам те на земљу,",
            "poem": 1
          },
          {
            "text": "пред цареве те земаљске поставио",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да те они гледају с презрењем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Због многих твојих кривица,",
            "poem": 1
          },
          {
            "text": "због трговине твоје непоштене,",
            "poem": 2
          },
          {
            "text": "светилиште си своје оскрнавио.",
            "poem": 1
          },
          {
            "text": "Зато сам запалио огањ посред тебе,",
            "poem": 2
          },
          {
            "text": "и огањ те је прогутао;",
            "poem": 1
          },
          {
            "text": "у пепео сам те претворио",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "на очи свима што те гледају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Сви који су те знали међу народима,",
            "poem": 1
          },
          {
            "text": "згражају се сад над тобом,",
            "poem": 2
          },
          {
            "text": "постао си призором ужаса,",
            "poem": 1
          },
          {
            "text": "и више те никада неће бити.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Пророштво против Сидона"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Дође ми реч Господња:"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "„Сине човечији, окрени се лицем према Сидону и пророкуј против њега."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Реци: ’Говори Господ Бог:",
          {
            "text": "Ево ме против тебе, Сидоне,",
            "poem": 1
          },
          {
            "text": "да се прославим усред тебе.",
            "poem": 2
          },
          {
            "text": "И знаћете да сам ја Господ,",
            "poem": 1
          },
          {
            "text": "када над њим извршим суд,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и када покажем своју светост у њему.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Послаћу на њега пошаст,",
            "poem": 1
          },
          {
            "text": "и крви ће бити на његовим улицама.",
            "poem": 2
          },
          {
            "text": "Посечени ће гинути усред њега од мача,",
            "poem": 1
          },
          {
            "text": "који ће их стизати са свих страна.",
            "poem": 2
          },
          {
            "text": "Тада ће знати да сам ја Господ.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Дом Израиљев неће више имати трн који убада, ни бодљу која наноси бол; ниоткуда више неће бити оних који их презиру. Тада ће знати да сам ја Господ Бог."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Зато говори Господ: када скупим дом Израиљев из народа где су били расејани, и покажем на њима своју светост пред пуцима, тада ће живети на земљи, коју сам ја дао своме слузи Јакову."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "И живеће спокојно на њој: градиће куће, садиће винограде и живеће безбедно, када извршим суд над свима који их презиру са свих страна. Тада ће знати да сам ја, Господ, њихов Бог.’“"
        ]
      },
      {
        "type": "line_break"
      }
    ],
