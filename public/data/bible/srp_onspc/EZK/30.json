  "chapter": {
    "number": 30,
    "content": [
      {
        "type": "heading",
        "content": [
          "Тешко Египту у дан Господњи!"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Дође ми реч Господња:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "„Сине човечији, пророкуј и реци: ’Говори Господ:",
          {
            "text": "Закукајте –",
            "poem": 1
          },
          {
            "text": "Јао, дане!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Јер близу је дан,",
            "poem": 1
          },
          {
            "text": "дан Господњи,",
            "poem": 2
          },
          {
            "text": "дан облачни,",
            "poem": 1
          },
          {
            "text": "време за народе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Доћи ће мач на Египат,",
            "poem": 1
          },
          {
            "text": "стрепња ће обузети Куш",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "кад погинули стану да падају по Египту,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "кад му отму његово богатство,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и кад му сруше темеље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Куш и Фут, Луд, Арабија и Хув, и народ земље савеза, пашће с њима од мача."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Говори Господ Бог:",
          {
            "text": "Пропашће они који помажу Египту,",
            "poem": 1
          },
          {
            "text": "сурваће се понос његове снаге;",
            "poem": 2
          },
          {
            "text": "падаће од мача од Мигдола до Сиене",
            "poem": 1
          },
          {
            "text": "– говори Господ Бог.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Биће опустошени усред опустошених земаља,",
            "poem": 1
          },
          {
            "text": "а његови градови ће лежати међу разореним градовима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Тада ће знати да сам ја Господ",
            "poem": 1
          },
          {
            "text": "када запалим ватру у Египту",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и када претрпе слом сви његови помагачи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "У тај дан изаћи ће преда мном посланици у бродовима да уплаше спокојни Куш. И обузеће их ужас у дан египатски, јер он, ево, долази."
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Говори Господ Бог:",
          {
            "text": "Ја ћу истребити многобројни народ",
            "poem": 1
          },
          {
            "text": "египатски руком Навуходоносора, вавилонског цара.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Он и његов народ,",
            "poem": 1
          },
          {
            "text": "најнемилосрднији међу народима,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "доћи ће да униште земљу.",
            "poem": 2
          },
          {
            "text": "Они ће исукати своје мачеве на Египћане,",
            "poem": 1
          },
          {
            "text": "па ће испунити земљу мртвима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ја ћу исушити рукавце Нила,",
            "poem": 1
          },
          {
            "text": "а земљу ћу продати зликовцима.",
            "poem": 2
          },
          {
            "text": "Руком туђинаца опустошићу земљу",
            "poem": 1
          },
          {
            "text": "и све што је у њој.",
            "poem": 2
          },
          {
            "text": "Ја сам, Господ, говорио.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Говори Господ Бог:",
          {
            "text": "Уништићу идоле и истребити",
            "poem": 1
          },
          {
            "text": "ништавна божанства из Нофа.",
            "poem": 2
          },
          {
            "text": "Неће више бити кнеза у Египту;",
            "poem": 1
          },
          {
            "text": "и предаћу страху земљу египатску.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Опустошићу Патрос,",
            "poem": 1
          },
          {
            "text": "запалићу Соан,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и извршити суд на Нои.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Излићу свој гнев на Син,",
            "poem": 1
          },
          {
            "text": "тврђаву египатску,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и истребити мноштво у Нои.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Запалићу ватру у Египту:",
            "poem": 1
          },
          {
            "text": "Син ће се превијати од мука,",
            "poem": 2
          },
          {
            "text": "Ноа ће бити освојен,",
            "poem": 1
          },
          {
            "text": "а Ноф ће бити сваког дана у тескоби.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Младићи Авина и Пи-Весета пашће од мача,",
            "poem": 1
          },
          {
            "text": "а градови",
            "poem": 2
          },
          {
            "noteId": 9
          },
          {
            "text": "ће отићи у ропство.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "У Тафнесу ће се помрачити дан",
            "poem": 1
          },
          {
            "text": "када сломим јарам египатски.",
            "poem": 2
          },
          {
            "text": "Тада ће се угасити понос његове снаге.",
            "poem": 1
          },
          {
            "text": "Прекриће га облак,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а његове ће ћерке отићи у ропство.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Тако ћу извршити судове на Египту,",
            "poem": 1
          },
          {
            "text": "па ће знати да сам ја Господ.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Осуда фараона"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "У једанаестој години, првог месеца седмог дана у месецу, дође ми реч Господња:"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "„Сине човечији, ја сам сломио мишицу фараону, египатском цару, а ево, нико му на њу није ставио повој с мелемима, нити је повио завојима да се учврсти, како би се латила мача."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Зато говори Господ Бог: ево ме против фараона, цара египатског; сломићу му руке, и здраву и ону сломљену, и учинити да му мач испадне из руке."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Расућу Египћане међу народе, и расејати их по земљама."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Ја ћу ојачати руке вавилонском цару и дати му мач у руку; сломићу руке фараону, а он ће стењати пред њим као што стење смртно рањен човек."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Ојачаћу руке вавилонском цару, а фараонове ће руке клонути. Када ставим мач у руке вавилонском цару, и он замахне њиме над Египтом, тада ће знати да сам ја Господ."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Ја ћу расути Египћане међу народе и расејати их по земљама. Тада ће знати да сам ја Господ.“"
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 9,
        "caller": "+",
        "text": "30,17 Септуагинта (као и Даничић) преводи а жене (девојке) ће бити одведене у ропство.",
