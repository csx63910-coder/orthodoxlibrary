    "name": "Књига пророка Осије",
    "commonName": "Књига пророка Осије",
    "title": "Књига пророка Осије",
    "order": 28,
    "numberOfChapters": 14,
    "sha256": "56caf5ccb190f60754adc49576fe8f1a2d3dfbdfcb85e2e73be368f56612fe6f",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/HOS/1.json",
    "lastChapterNumber": 14,
    "lastChapterApiLink": "/api/srp_onspc/HOS/14.json",
    "totalNumberOfVerses": 197
  },
  "chapter": {
    "number": 12,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Јефрем се ветром храни,",
            "poem": 1
          },
          {
            "text": "за источним ветром стално хрли.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Умножио је лаж и насиље.",
            "poem": 2
          },
          {
            "text": "Са Асиријом савез су склопили,",
            "poem": 1
          },
          {
            "text": "а уље се у Египат носи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Господ се парничи са Јудом.",
            "poem": 1
          },
          {
            "text": "Јакова кажњава, узвратиће му по његовим путевима",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и по делима његовим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "За пету је свога брата у утроби ухватио,",
            "poem": 1
          },
          {
            "text": "и са Богом се борио у мужевној снази својој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Са Анђелом се борио и победио.",
            "poem": 1
          },
          {
            "text": "Плакао је, наклоност му је тражио",
            "poem": 2
          },
          {
            "text": "и у Ветиљу га је нашао.",
            "poem": 1
          },
          {
            "text": "И тамо му",
            "poem": 2
          },
          {
            "noteId": 16
          },
          {
            "text": "је он говорио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Он – Господ Бог над војскама –",
            "poem": 1
          },
          {
            "text": "Господ му је име за спомињање.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "А ти, ти се врати своме Богу.",
            "poem": 1
          },
          {
            "text": "Верност и праведност чувај.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "У свог Бога стално се поуздај.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "У руци трговца теразије непоштене,",
            "poem": 1
          },
          {
            "text": "воли да закине.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Јефрем рече: „Обогатио сам се,",
            "poem": 1
          },
          {
            "text": "згрнуо сам себи благо.",
            "poem": 2
          },
          {
            "text": "И у свему моме труду",
            "poem": 1
          },
          {
            "text": "кривицу ми неће наћи а да је грех.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "„А ја, Господ, Бог твој ја сам био",
            "poem": 1
          },
          {
            "text": "још од земље египатске.",
            "poem": 2
          },
          {
            "text": "И опет ћу ти дати да у шаторима својим пребиваш",
            "poem": 1
          },
          {
            "text": "као у данима празника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Пророцима сам се објавио",
            "poem": 1
          },
          {
            "text": "и виђења им умножио.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "По пророцима сам поређења давао.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Има ли зла у Галаду?",
            "poem": 1
          },
          {
            "text": "Баш су ништа сви који су у њему.",
            "poem": 2
          },
          {
            "text": "У Галгалу волове жртвују,",
            "poem": 1
          },
          {
            "text": "њихови су жртвеници гомиле камења по браздама њиве.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "У земљу арамејску Јаков је побегао.",
            "poem": 1
          },
          {
            "text": "За жену је служио Израиљ",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и за жену чувао је стада.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Господ је преко пророка извео Израиља из Египта",
            "poem": 1
          },
          {
            "text": "и чувао га је преко пророка.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "А Јефрем га је горко раздраживао.",
            "poem": 1
          },
          {
            "text": "Крв што је проли на њему остаје.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Господ његов узвратиће му погрде његове.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 16,
        "caller": "+",
        "text": "12,4 Овако је у арамејском и у грчким рукописима, док је у јеврејском множина, нама.",
        "reference": {
          "chapter": 12,
          "verse": 4
        }
      }
    ]
  },
