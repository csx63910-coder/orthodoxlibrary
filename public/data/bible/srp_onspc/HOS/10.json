    "name": "Књига пророка Осије",
    "commonName": "Књига пророка Осије",
    "title": "Књига пророка Осије",
    "order": 28,
    "numberOfChapters": 14,
    "sha256": "56caf5ccb190f60754adc49576fe8f1a2d3dfbdfcb85e2e73be368f56612fe6f",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/HOS/1.json",
    "lastChapterNumber": 14,
    "lastChapterApiLink": "/api/srp_onspc/HOS/14.json",
    "totalNumberOfVerses": 197
  },
  "chapter": {
    "number": 10,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Израиљ је био лоза разграната.",
            "poem": 1
          },
          {
            "text": "Рађао је плод за себе",
            "poem": 2
          },
          {
            "text": "и по обиљу својих плодова",
            "poem": 1
          },
          {
            "text": "умножавао жртвенике,",
            "poem": 2
          },
          {
            "text": "подизао је украшене свете стубове",
            "poem": 1
          },
          {
            "text": "према напретку своје земље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Срце им је љигаво",
            "poem": 1
          },
          {
            "text": "и сада им следи казна од њега",
            "poem": 2
          },
          {
            "noteId": 14
          },
          {
            "text": ":",
            "poem": 2
          },
          {
            "text": "разбиће им жртвенике",
            "poem": 1
          },
          {
            "text": "и поломиће им свете стубове.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Јер они сад говоре: „Немамо цара",
            "poem": 1
          },
          {
            "text": "јер се ни Господа не бојимо!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Јер, каква корист и од цара?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Говоре бесмислице",
            "poem": 1
          },
          {
            "text": "док се куну лажно",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и заветују се,",
            "poem": 2
          },
          {
            "text": "парнице се ко отровни коров шире",
            "poem": 1
          },
          {
            "text": "по браздама њихове њиве.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "За телетом Вет-Авеновим",
            "poem": 1
          },
          {
            "text": "стрепе становници Самарије.",
            "poem": 2
          },
          {
            "text": "Жалиће за њим његов народ,",
            "poem": 1
          },
          {
            "text": "његови свештеници ће стрепети над њим,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер је од њега отишла слава његова.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "У Асирију ће га однети",
            "poem": 1
          },
          {
            "text": "на дар великом цару;",
            "poem": 2
          },
          {
            "text": "стид ће да спопадне Јефрема,",
            "poem": 1
          },
          {
            "text": "а Израиљ ће се застидети због намере своје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Самарија ће се разорити",
            "poem": 1
          },
          {
            "text": "са све царем ко са трунком поврх воде.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Биће оборене узвишице Вет-Авена,",
            "poem": 1
          },
          {
            "text": "тај грех Израиља;",
            "poem": 2
          },
          {
            "text": "трње и коров ће покрити",
            "poem": 1
          },
          {
            "text": "њихове жртвенике,",
            "poem": 2
          },
          {
            "text": "а они ће рећи горама: „Прекријте нас“,",
            "poem": 1
          },
          {
            "text": "и бреговима: „Падните на нас.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "О, Израиљу, грешио си још од гавајских дана!",
            "poem": 1
          },
          {
            "text": "Онде су и остали.",
            "poem": 2
          },
          {
            "text": "Али, тамо у Гаваји,",
            "poem": 1
          },
          {
            "text": "неће ли рат захватити синове неправде?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Казнићу их кад ми је по вољи.",
            "poem": 1
          },
          {
            "text": "Окупиће се на њих народ да их окују",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "због њиховог двостукога греха.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Јефрем је укроћена јуница",
            "poem": 1
          },
          {
            "text": "која воли да врше.",
            "poem": 2
          },
          {
            "text": "Лепу ћу јој шију јармом украсити.",
            "poem": 1
          },
          {
            "text": "Ујармићу Јефрема,",
            "poem": 2
          },
          {
            "text": "ораће Јуда,",
            "poem": 1
          },
          {
            "text": "дрљаће Јаков.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Праведност сејте,",
            "poem": 1
          },
          {
            "text": "жањите милост",
            "poem": 2
          },
          {
            "text": "и тло неузорано орите!",
            "poem": 1
          },
          {
            "text": "Време је да Господа тражите,",
            "poem": 2
          },
          {
            "text": "док се не врати",
            "poem": 1
          },
          {
            "text": "и не да вам кишу праведности.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "А ви сте опакост орали,",
            "poem": 1
          },
          {
            "text": "неправду пожњели",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и плод лагања јели,",
            "poem": 2
          },
          {
            "text": "јер сте се у свој пут поуздали,",
            "poem": 1
          },
          {
            "text": "у ратнике своје многобројне.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Заориће се ратна вика у народу твоме,",
            "poem": 1
          },
          {
            "text": "сатрвена биће утврђења твоја сва;",
            "poem": 2
          },
          {
            "text": "као што је Салман сатро Вет-Арвел,",
            "poem": 1
          },
          {
            "text": "када је на дан боја мајка с децом на комаде била размрскана.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ово ће ти учинити, о, Ветиљу,",
            "poem": 1
          },
          {
            "text": "због велике злобе твоје.",
            "poem": 2
          },
          {
            "text": "Када дан буде окончан,",
            "poem": 1
          },
          {
            "text": "окончаће и цар Израиља.",
            "poem": 2
          }
        ]
      }
    ],
