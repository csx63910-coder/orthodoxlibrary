  "chapter": {
    "number": 13,
    "content": [
      {
        "type": "heading",
        "content": [
          "Господњи гнев против Израиља"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Страх је владао док је Јефрем говорио.",
            "poem": 1
          },
          {
            "text": "Уздигао се он у Израиљу,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "али је згрешио због Вала и умро.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "А и сада грехе множе",
            "poem": 1
          },
          {
            "text": "јер су себи излили идоле",
            "poem": 2
          },
          {
            "text": "од свог сребра и својом вештином.",
            "poem": 1
          },
          {
            "text": "Идоли су дело ливца, сви до једног!",
            "poem": 2
          },
          {
            "text": "И још за њих кажу:",
            "poem": 1
          },
          {
            "text": "„Људи који жртвују нека љубе телад!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Биће зато ко јутарњи облак",
            "poem": 1
          },
          {
            "text": "и као роса рана што нестаје,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "као плева с гумна олујом ношена",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и дим из оџака.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "„А ја сам био Господ,",
            "poem": 1
          },
          {
            "text": "Бог твој, још од земље египатске,",
            "poem": 2
          },
          {
            "text": "осим мене не знаш за друге богове.",
            "poem": 1
          },
          {
            "text": "Осим мене Спаситеља нема.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ја сам тебе посматрао у пустињи,",
            "poem": 1
          },
          {
            "text": "у земљи сасушеној.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Наситили су се на пашњаку своме.",
            "poem": 1
          },
          {
            "text": "Наситили су се, срцем огордили",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и зато ме заборавили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Попут лава ја ћу за њих бити,",
            "poem": 1
          },
          {
            "text": "попут риса што крај пута вреба.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Пресрешћу их као медведица којој су отели медведиће,",
            "poem": 1
          },
          {
            "text": "до срца им груди растргнути.",
            "poem": 2
          },
          {
            "text": "Прождраћу их онде као лав,",
            "poem": 1
          },
          {
            "text": "раскомадаће их дивље звери.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Сатрвен си, Израиљу,",
            "poem": 1
          },
          {
            "text": "јер си против мене, против свога помоћника!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Где је сада цар твој да те спасе",
            "poem": 1
          },
          {
            "text": "у свим твојим градовима, твоје судије?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "А за њих си говорио: ’Дај ми цара и главаре!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "И у гневу своме цара сам ти дао,",
            "poem": 1
          },
          {
            "text": "али сам га и узео у јарости својој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Свезана је кривица Јефремова",
            "poem": 1
          },
          {
            "text": "и прикривен грех је његов.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Спопашће га болови ко да се порађа.",
            "poem": 1
          },
          {
            "text": "Али он је дете што мудрости нема,",
            "poem": 2
          },
          {
            "text": "јер он не би да се роди,",
            "poem": 1
          },
          {
            "text": "да изађе из утробе кад је томе време.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Од превласти Света мртвих",
            "poem": 1
          },
          {
            "noteId": 17
          },
          {
            "text": "откупићу их",
            "poem": 1
          },
          {
            "text": "и од смрти избавићу их.",
            "poem": 2
          },
          {
            "text": "Где је, смрти, твоје разарање?",
            "poem": 1
          },
          {
            "text": "Где је, Свете мртвих, жалац твој?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Самилост је сакривена од очију мојих.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Све и да процвета међу браћом својом,",
            "poem": 2
          },
          {
            "text": "источни ће ветар доћи,",
            "poem": 1
          },
          {
            "text": "из пустиње ветар Господњи се диже",
            "poem": 2
          },
          {
            "text": "да пресуши његове изворе,",
            "poem": 1
          },
          {
            "text": "да пресахне његова врела",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и да отме благо, све драгоцености.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Биће крива Самарија",
            "poem": 1
          },
          {
            "text": "за побуну против Бога свога.",
            "poem": 2
          },
          {
            "text": "Од мача ће они пасти,",
            "poem": 1
          },
          {
            "text": "децу ће им размрскати",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и труднице распорити.“",
            "poem": 2
          }
        ]
      }
    ],
