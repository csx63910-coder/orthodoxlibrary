  "book": {
    "id": "HOS",
    "translationId": "srp_onspc",
    "name": "Књига пророка Осије",
    "commonName": "Књига пророка Осије",
    "title": "Књига пророка Осије",
    "order": 28,
    "numberOfChapters": 14,
    "sha256": "56caf5ccb190f60754adc49576fe8f1a2d3dfbdfcb85e2e73be368f56612fe6f",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/HOS/1.json",
    "lastChapterNumber": 14,
    "lastChapterApiLink": "/api/srp_onspc/HOS/14.json",
    "totalNumberOfVerses": 197
  },
  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Реците својој браћи: ’Народе мој!’",
          {
            "noteId": 3
          },
          "; и својој сестри: ’Помилована!’",
          {
            "noteId": 4
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Израиљ кажњен и обновљен"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Парничите се са мајком својом!",
            "poem": 1
          },
          {
            "text": "Судите се, јер ми она више није жена,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а ја муж њен нисам.",
            "poem": 2
          },
          {
            "text": "Нек са лица свога скине своје блудништво",
            "poem": 1
          },
          {
            "text": "и своје прељубе са груди својих,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "да је не бих скинуо,",
            "poem": 1
          },
          {
            "text": "голотињу њену разоткрио као на дан када се родила.",
            "poem": 2
          },
          {
            "text": "Претворићу је у пустињу,",
            "poem": 1
          },
          {
            "text": "претворићу је у земљу суву",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и убити жеђу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "И нећу се смиловати на њену децу,",
            "poem": 1
          },
          {
            "text": "јер су копилад!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Њихова је мајка блудничила,",
            "poem": 1
          },
          {
            "text": "осрамотила се она што их је зачела.",
            "poem": 2
          },
          {
            "text": "Јер, рекла је: ’Идем ја за својим љубавницима,",
            "poem": 1
          },
          {
            "text": "за онима што ми храну и воду дају;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "што ми дају вуну и лан, уље и пиће.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Зато ћу, ево, да преградим њен пут трњем;",
            "poem": 1
          },
          {
            "text": "зидом ћу је обзидати да не нађе свој пут.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "И она ће јурити за својим љубавницима,",
            "poem": 1
          },
          {
            "text": "али их неће стићи;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "тражиће их, али их неће наћи.",
            "poem": 2
          },
          {
            "text": "Рећи ће:",
            "poem": 1
          },
          {
            "text": "’Отићи ћу, вратићу се своме првом мужу,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер ми је било боље тада него сада.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Она не зна да сам јој ја",
            "poem": 1
          },
          {
            "text": "дао жито и вино, уље и сребро;",
            "poem": 2
          },
          {
            "text": "ја сам јој умножио злато",
            "poem": 1
          },
          {
            "text": "што га је дала да слије Вала.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Зато ћу сада да узмем натраг своје жито у време жетве,",
            "poem": 1
          },
          {
            "text": "и своје вино у доба бербе;",
            "poem": 2
          },
          {
            "text": "склонићу своју вуну и свој лан,",
            "poem": 1
          },
          {
            "text": "чиме би покрила нагост њену.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Разоткрићу сада њену нагост",
            "poem": 1
          },
          {
            "text": "на очи њеним љубавницима",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и из руку мојих је нико избавити неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ућуткаћу све весеље",
            "poem": 1
          },
          {
            "text": "њених сабора, њених младина,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "њених субота и свих њених празника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Опустошићу њену лозу и њене смокве,",
            "poem": 1
          },
          {
            "text": "за које је рекла:",
            "poem": 2
          },
          {
            "text": "’То је плата моја коју су ми дали љубавници моји.’",
            "poem": 1
          },
          {
            "text": "Претворићу све то у шуму,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да их једу пољске звери.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Судићу јој ја због дана Вала,",
            "poem": 1
          },
          {
            "text": "када им је палила тамјан;",
            "poem": 2
          },
          {
            "text": "када се нагиздала својим прстењем и накитом својим,",
            "poem": 1
          },
          {
            "text": "када је отишла за својим љубавницима,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а мене је заборавила",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Зато ћу је, ево, намамити;",
            "poem": 1
          },
          {
            "text": "у пустињу одвешћу је",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и благо јој говорити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Вратићу јој ја оданде винограде њене",
            "poem": 1
          },
          {
            "text": "и долину Ахор",
            "poem": 2
          },
          {
            "noteId": 5
          },
          {
            "text": "као врата наде.",
            "poem": 2
          },
          {
            "text": "Одазваће се она с оног места,",
            "poem": 1
          },
          {
            "text": "као кад је била млада",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и као када је долазила из Египта.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Тога ћеш ме дана – говори Господ –",
            "poem": 1
          },
          {
            "text": "звати: ’Мужу мој’,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и нећеш ме више звати: ’Господару мој.",
            "poem": 2
          },
          {
            "noteId": 6
          },
          {
            "text": "’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Уклонићу имена Вала из њених уста",
            "poem": 1
          },
          {
            "text": "да им име више никад не спомене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Тога ћу дана за њих сачинити савез",
            "poem": 1
          },
          {
            "text": "са пољским зверима,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "са небеским птицама и са гмизавцима.",
            "poem": 2
          },
          {
            "text": "Уклонићу лук, мач и битку из земље",
            "poem": 1
          },
          {
            "text": "и даћу им да безбрижно леже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Верићу те довека са собом;",
            "poem": 1
          },
          {
            "text": "верићу те са собом у праведности и правди,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "у милости и милосрђу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Верићу те са собом у верности",
            "poem": 1
          },
          {
            "text": "и познаћеш Господа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "И ја ћу тога дана да послушам",
            "poem": 1
          },
          {
            "text": "– говори Господ –",
            "poem": 2
          },
          {
            "text": "да послушам небеса,",
            "poem": 1
          },
          {
            "text": "а она ће послушати земљу;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "земља ће послушати жито",
            "poem": 1
          },
          {
            "text": "и ново вино и свеже уље.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "А они ће послушати Језраел.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Посејаћу је за себе по земљи",
            "poem": 1
          },
          {
            "text": "и смиловаћу се Ло-Рухами",
            "poem": 2
          },
          {
            "noteId": 7
          },
          {
            "text": ",",
            "poem": 2
          },
          {
            "text": "а Ло-Амију",
            "poem": 1
          },
          {
            "noteId": 8
          },
          {
            "text": "ћу рећи: ’Ти си мој народ’,",
            "poem": 1
          },
          {
            "text": "а он ће рећи мени: ’Мој Бог.’“",
            "poem": 2
          }
        ]
      }
    ],
