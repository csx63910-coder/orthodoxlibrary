  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "heading",
        "content": [
          "Оптужба против Израиља"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Чујте реч Господњу, о, народе израиљски,",
            "poem": 1
          },
          {
            "text": "јер се Господ парничи",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "са становницима земље:",
            "poem": 2
          },
          {
            "text": "„Нема истине, нема милости",
            "poem": 1
          },
          {
            "text": "и нема богопознања у земљи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Проклињање и обмањивање, убијање,",
            "poem": 1
          },
          {
            "text": "крађе и прељубе су прокуљали,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а крв се на крв пролива.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Зато ће земља да тугује,",
            "poem": 1
          },
          {
            "text": "свенуће свако у њој.",
            "poem": 2
          },
          {
            "text": "Угинуће звери пољске, небеске птице,",
            "poem": 1
          },
          {
            "text": "па и рибе у мору.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ипак, нека се нико не парничи,",
            "poem": 1
          },
          {
            "text": "нико никога нека не прекорева,",
            "poem": 2
          },
          {
            "text": "јер народ је твој попут оних",
            "poem": 1
          },
          {
            "text": "који се буне против свештеника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Посрнућеш дању",
            "poem": 1
          },
          {
            "text": "али ће и пророк заједно са тобом да посрне ноћу.",
            "poem": 2
          },
          {
            "text": "А и мајку твоју погубићу!",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Погибе мој народ јер нема знања.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Зато што си ти одбацио знање",
            "poem": 1
          },
          {
            "text": "и ја ћу тебе да одбацим,",
            "poem": 2
          },
          {
            "text": "да ми више не будеш свештеник.",
            "poem": 3
          },
          {
            "text": "Заборавио си Закон Бога свога,",
            "poem": 1
          },
          {
            "text": "па ћу и ја да заборавим децу твоју.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "И што их је више било,",
            "poem": 1
          },
          {
            "text": "грешили су више против мене;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "срамотом ћу да заменим ја њихову славу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Грехом мог народа се хране,",
            "poem": 1
          },
          {
            "text": "кривица њихова глад им разгаљује.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Народу ће бити као и свештеницима;",
            "poem": 1
          },
          {
            "text": "и ја ћу да му судим, да узвратим по његовим путевима",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и по делима његовим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Јешће они, али сити неће бити;",
            "poem": 1
          },
          {
            "text": "блудничили су, али се неће умножити",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер су Господу престали да служе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Блудничење, вино и шира залуђују срце.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Са дрветом се својим саветује мој народ",
            "poem": 1
          },
          {
            "text": "и штап му његов савет даје!",
            "poem": 2
          },
          {
            "text": "Заведен је духом блудништва.",
            "poem": 1
          },
          {
            "text": "Блудничили су и отпали од Бога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Жртвују на врх гора;",
            "poem": 1
          },
          {
            "text": "каде по брдима",
            "poem": 2
          },
          {
            "text": "и испод храста, тополе и бреста",
            "poem": 1
          },
          {
            "text": "јер је тамо добар хлад.",
            "poem": 2
          },
          {
            "text": "А ћерке вам блудниче",
            "poem": 1
          },
          {
            "text": "и снахе вам прељубу чине.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Али нећу да судим вашим ћеркама",
            "poem": 1
          },
          {
            "text": "јер блудниче",
            "poem": 2
          },
          {
            "text": "и снахама вашим",
            "poem": 1
          },
          {
            "text": "јер чине прељубу.",
            "poem": 2
          },
          {
            "text": "Јер, сами се мушкарци одвајају са блудницама",
            "poem": 1
          },
          {
            "text": "и жртвују са храмским блудницама.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "А народ који то не схвата биће упропашћен.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ако ти блудничиш, о, Израиљу,",
            "poem": 1
          },
          {
            "text": "нека Јуда не сагреши!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Не идите у Галгал!",
            "poem": 1
          },
          {
            "text": "Не пењите се у Вет-Авен",
            "poem": 2
          },
          {
            "noteId": 10
          },
          {
            "lineBreak": true
          },
          {
            "text": "и не куните се: ’Тако ми живог Господа!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Као јогунаста јуница",
            "poem": 1
          },
          {
            "text": "Израиљ је јогунаст.",
            "poem": 2
          },
          {
            "text": "Хоће ли их сада Господ водити",
            "poem": 1
          },
          {
            "text": "као јагње на пространо место?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Јефрем се удружио са идолима.",
            "poem": 1
          },
          {
            "text": "Прођи га се!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "А када им понестане пића",
            "poem": 1
          },
          {
            "text": "они упорно блудниче,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а њихове старешине баш воле срамоту.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ветар их је својим крилима сапео;",
            "poem": 1
          },
          {
            "text": "биће посрамљени због жртава својих.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 10,
        "caller": "+",
        "text": "4,15 Вет-Авен значи кућа покварености, што је погрдни назив за Ветиљ, Дом Божији.",
        "reference": {
          "chapter": 4,
          "verse": 15
        }
      }
    ]
