  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "heading",
        "content": [
          "Суд над Израиљем"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Чујте ово, свештеници",
            "poem": 1
          },
          {
            "text": "и пази, доме Израиљев!",
            "poem": 2
          },
          {
            "text": "И ти, дворе царев, послушај,",
            "poem": 1
          },
          {
            "text": "јер ти је одређен суд,",
            "poem": 2
          },
          {
            "text": "јер сте били замка за Миспу",
            "poem": 1
          },
          {
            "text": "и мрежа разапета преко Тавора.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Огрезли су у клању, бунтовници,",
            "poem": 1
          },
          {
            "text": "и све сам их покарао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Познајем ја Јефрема",
            "poem": 1
          },
          {
            "text": "и Израиљ од мене скривен није.",
            "poem": 2
          },
          {
            "text": "Јер ти сада блудничиш, Јефреме,",
            "poem": 1
          },
          {
            "text": "ти себе опогани, Израиљу!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Дела им њихова не пуштају",
            "poem": 1
          },
          {
            "text": "да се своме Богу врате,",
            "poem": 2
          },
          {
            "text": "јер им је у срцу дух блудништва",
            "poem": 1
          },
          {
            "text": "и Господа не познају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Израиљу понос сведочи у лице,",
            "poem": 1
          },
          {
            "text": "па ће се и Израиљ и Јефрем спотакнути у својој кривици.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "А и Јуда ће се спотакнути с њима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Са стадима и крдима ће ићи",
            "poem": 1
          },
          {
            "text": "Господа да траже,",
            "poem": 2
          },
          {
            "text": "али га пронаћи неће",
            "poem": 1
          },
          {
            "text": "јер се он измакнуо од њих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Господа су изневерили",
            "poem": 1
          },
          {
            "text": "јер су децу туђу изродили,",
            "poem": 2
          },
          {
            "text": "и сад ће их празник младина",
            "poem": 1
          },
          {
            "text": "појести све са имањем њиховим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Дувајте у трубу у Гаваји,",
            "poem": 1
          },
          {
            "text": "затрубите у Рами,",
            "poem": 2
          },
          {
            "text": "вичите у Вет-Авену –",
            "poem": 1
          },
          {
            "text": "за тобом, о, Венијамине!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Јефрем ће постати пустош",
            "poem": 1
          },
          {
            "text": "на дан казне,",
            "poem": 2
          },
          {
            "text": "и ја племенима израиљским",
            "poem": 1
          },
          {
            "text": "откривам ствари поуздане.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Јудини су главари постали",
            "poem": 1
          },
          {
            "text": "као они што померају међу,",
            "poem": 2
          },
          {
            "text": "и ја ћу на њих као воду",
            "poem": 1
          },
          {
            "text": "да излијем јарост своју.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Јефрем је потлачен,",
            "poem": 1
          },
          {
            "text": "суд га је скршио",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер му је баш по вољи било да иде за идолима",
            "poem": 2
          },
          {
            "noteId": 11
          },
          {
            "text": ".",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "А ја сам Јефрему као мољац,",
            "poem": 1
          },
          {
            "text": "и као трулеж дому Јудином.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "А када је Јефрем видео своју болест",
            "poem": 1
          },
          {
            "text": "и Јуда рану своју,",
            "poem": 2
          },
          {
            "text": "отишао је Јефрем Асирији",
            "poem": 1
          },
          {
            "text": "и послао по великог цара.",
            "poem": 2
          },
          {
            "text": "Али он не може да вас излечи,",
            "poem": 1
          },
          {
            "text": "он не може да исцели рану вашу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Јер ја сам Јефрему попут лава",
            "poem": 1
          },
          {
            "text": "и Јуди сам попут лавића.",
            "poem": 2
          },
          {
            "text": "Ја, ја ћу да растргнем, да одјурим",
            "poem": 1
          },
          {
            "text": "и одвучем, и нико не може да избави!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Одјурићу, вратићу се на своје станиште",
            "poem": 1
          },
          {
            "text": "док не поднесу суд.",
            "poem": 2
          },
          {
            "noteId": 12
          },
          {
            "text": "И тражиће лице моје у невољи својој,",
            "poem": 1
          },
          {
            "text": "и тражиће ме жељно.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 11,
        "caller": "+",
        "text": "5,11 Ова изворна реч је несигурног значења и може да се преведе: за људским заповестима; за противником; за нечистоћом.",
        "reference": {
          "chapter": 5,
          "verse": 11
        }
      },
      {
        "noteId": 12,
        "caller": "+",
        "text": "5,15 Или: док не признају своју кривицу.",
        "reference": {
          "chapter": 5,
          "verse": 15
        }
      }
    ]
  },
