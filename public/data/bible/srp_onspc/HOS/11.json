  "chapter": {
    "number": 11,
    "content": [
      {
        "type": "heading",
        "content": [
          "Божија љубав за Израиљ"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "„Волео сам Израиљ још док је дете био",
            "poem": 1
          },
          {
            "text": "и из Египта позвах сина свога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Али што су их",
            "poem": 1
          },
          {
            "noteId": 15
          },
          {
            "text": "више позивали,",
            "poem": 1
          },
          {
            "text": "од њих су више одлазили,",
            "poem": 2
          },
          {
            "text": "Валима су жртвовали,",
            "poem": 1
          },
          {
            "text": "идолима су кадили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Јефрема сам учио да хода,",
            "poem": 1
          },
          {
            "text": "ја сам их за руке прихватао.",
            "poem": 2
          },
          {
            "text": "Али они препознали нису",
            "poem": 1
          },
          {
            "text": "да сам ја тај што сам их лечио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Спонама људским, везама љубави",
            "poem": 1
          },
          {
            "text": "ја сам их привлачио.",
            "poem": 2
          },
          {
            "text": "Био сам им као онај што им у устима жвале раслабљује.",
            "poem": 1
          },
          {
            "text": "Сагињао сам се да бих их хранио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Неће се вратити у Египат,",
            "poem": 1
          },
          {
            "text": "него ће Асирца за цара имати",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер су одбили да се покају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Витлаће им мач по градовима,",
            "poem": 1
          },
          {
            "text": "капије ће им разорити,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "прождраће их због њихових сплетки.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Мој је народ одлучан да ме се одриче.",
            "poem": 1
          },
          {
            "text": "Зову га ка Вишњем,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ал’ га нико не узвиси.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "О, Јефреме, како да те предам?",
            "poem": 1
          },
          {
            "text": "О, Израиљу, како да те изручим?",
            "poem": 2
          },
          {
            "text": "Како да те учиним као Адму,",
            "poem": 1
          },
          {
            "text": "да те учиним као Севојим?",
            "poem": 2
          },
          {
            "text": "Туче у мени срце моје,",
            "poem": 1
          },
          {
            "text": "разгорело се моје смиловање.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Пламен свога гнева нећу да излијем,",
            "poem": 1
          },
          {
            "text": "нећу опет Јефрема да затрем.",
            "poem": 2
          },
          {
            "text": "Јер, Бог ја јесам, нисам човек;",
            "poem": 1
          },
          {
            "text": "Светац међу вама",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и у гневу нећу да вам дођем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Они ће следити Господа",
            "poem": 1
          },
          {
            "text": "и као лав он ће да риче.",
            "poem": 2
          },
          {
            "text": "Зарикаће он,",
            "poem": 1
          },
          {
            "text": "задрхтаће и доћи ће они, деца са запада.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Задрхтаће и доћи као птица из Египта,",
            "poem": 1
          },
          {
            "text": "као голубица из земље асирске.",
            "poem": 2
          },
          {
            "text": "Даћу им да живе у кућама њиним",
            "poem": 1
          },
          {
            "text": "– говори Господ.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Израиљев грех"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Јефрем ме је лажју окружио,",
            "poem": 1
          },
          {
            "text": "а обманом дом Израиљев.",
            "poem": 2
          },
          {
            "text": "Али Јуда још с Богом корача,",
            "poem": 1
          },
          {
            "text": "са светима остао је веран.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 15,
        "caller": "+",
        "text": "11,2 Овако је у јеврејском тексту док је у Септуагинти и арамејском преводу једнина.",
        "reference": {
          "chapter": 11,
          "verse": 2
        }
      }
    ]
