    "lastChapterApiLink": "/api/srp_onspc/HOS/14.json",
    "totalNumberOfVerses": 197
  },
  "chapter": {
    "number": 7,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Када бих да лечим Израиља,",
            "poem": 1
          },
          {
            "text": "открива се Јефремова кривица",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и зло Самарије;",
            "poem": 2
          },
          {
            "text": "јер су превртљивци,",
            "poem": 1
          },
          {
            "text": "лопов проваљује",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и банда је убица на улици.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "А у срцу своме они и не мисле",
            "poem": 1
          },
          {
            "text": "да ја памтим сва злодела њина.",
            "poem": 2
          },
          {
            "text": "Сада су их окружила сва њихова дела,",
            "poem": 1
          },
          {
            "text": "ево их пред лицем мојим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Злоделима цара разгаљују",
            "poem": 1
          },
          {
            "text": "и лажима својим главаре.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Сви су они прељубници,",
            "poem": 1
          },
          {
            "text": "као пећ су успламтела",
            "poem": 2
          },
          {
            "text": "коју пекар престаје да жари",
            "poem": 1
          },
          {
            "text": "од када је замесио тесто,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "па докле му не ускисне од квасца.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "На дан нашега цара",
            "poem": 1
          },
          {
            "text": "клонули су главари разгаљени вином",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и он пружи своју руку подсмевачима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Пришли су му и пламтели срцем",
            "poem": 1
          },
          {
            "text": "у својој обмани.",
            "poem": 2
          },
          {
            "text": "Спавала је као пекар јарост њина целе ноћи,",
            "poem": 1
          },
          {
            "text": "а ујутро се разгневила као пламен ватре.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Сви су они зажарени као пећ",
            "poem": 1
          },
          {
            "text": "и прогутаће своје судије;",
            "poem": 2
          },
          {
            "text": "падају сви њихови цареви,",
            "poem": 1
          },
          {
            "text": "а међу њима нема никог да позове мене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Јефрем је са народима, себе је измешао.",
            "poem": 1
          },
          {
            "text": "Јефрем је постао погача неокренута.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Туђинци му снагу једу,",
            "poem": 1
          },
          {
            "text": "а он то и не зна;",
            "poem": 2
          },
          {
            "text": "седе косе посуше га,",
            "poem": 1
          },
          {
            "text": "а он то и не зна.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Израиљу понос сведочи у лице,",
            "poem": 1
          },
          {
            "text": "ал’ се не окрећу Господу, свом Богу;",
            "poem": 2
          },
          {
            "text": "и у свему томе",
            "poem": 1
          },
          {
            "text": "они га не траже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "А Јефрем је постао као голубица",
            "poem": 1
          },
          {
            "text": "лаковерна што разума нема!",
            "poem": 2
          },
          {
            "text": "Ено, зову Египат",
            "poem": 1
          },
          {
            "text": "и одлазе у Асирију.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Али када оду, над њима ћу да раширим своју мрежу.",
            "poem": 1
          },
          {
            "text": "Као птице небеске збацићу их,",
            "poem": 2
          },
          {
            "text": "казнићу их кад их чујем",
            "poem": 1
          },
          {
            "text": "у њиховом збору.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Јао њима, јер су од мене побегли!",
            "poem": 1
          },
          {
            "text": "Опустошиће јер су се против мене побунили.",
            "poem": 2
          },
          {
            "text": "Ја би да их откупим,",
            "poem": 1
          },
          {
            "text": "а они о мени лажи објављују.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Нису срцем вапили мени,",
            "poem": 1
          },
          {
            "text": "него су кукали на својим постељама.",
            "poem": 2
          },
          {
            "text": "Због жита и младог вина себе секу",
            "poem": 1
          },
          {
            "text": "и од мене се окрећу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "А ја сам их крепио, снажио им руке,",
            "poem": 1
          },
          {
            "text": "а они су ми зло мислили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "И они се нису окренули Вишњем;",
            "poem": 1
          },
          {
            "text": "постали су као лук лабави.",
            "poem": 2
          },
          {
            "text": "Пашће они од мача,",
            "poem": 1
          },
          {
            "text": "а њихове вође од горчине сопственог језика.",
            "poem": 2
          },
          {
            "text": "А то ће им у Египту бити на поругу.",
            "poem": 1
          }
        ]
      }
    ],
