  "chapter": {
    "number": 6,
    "content": [
      {
        "type": "heading",
        "content": [
          "Израиљ се не каје"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "„Дођите! Хајде да се вратимо Господу,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер он нас је растргнуо,",
            "poem": 1
          },
          {
            "text": "и он ће нас излечити;",
            "poem": 2
          },
          {
            "text": "он нас је ударио,",
            "poem": 1
          },
          {
            "text": "и он ће нас превити!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Оживеће нас за пар дана,",
            "poem": 1
          },
          {
            "text": "а већ трећег ће нас дићи",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да пред њиме ми живимо!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Хајде да га упознамо,",
            "poem": 1
          },
          {
            "text": "хајде да тежимо богопознању!",
            "poem": 2
          },
          {
            "text": "Он сигурно стиже као зора,",
            "poem": 1
          },
          {
            "text": "долази нам као киша, као позна киша",
            "poem": 2
          },
          {
            "noteId": 13
          },
          {
            "text": "земљу што натапа.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "„Шта да ти радим, Јефреме?",
            "poem": 1
          },
          {
            "text": "Јудо, шта да ти радим?",
            "poem": 2
          },
          {
            "text": "Ваша је оданост као облак јутарњи,",
            "poem": 1
          },
          {
            "text": "као роса рана нестаје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Сећи ћу их у комаде преко пророка,",
            "poem": 1
          },
          {
            "text": "убићу их речима својих уста,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а прописи ће моји бити светло што се јавља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Јер ја милосрђе хоћу, а не жртву;",
            "poem": 1
          },
          {
            "text": "богопознање, а не свеспалнице!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Попут Адама су савез прекршили.",
            "poem": 1
          },
          {
            "text": "О, како су ме издали!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Галад је град злочинаца крвавих трагова.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Дружина је свештеничка банда убица",
            "poem": 1
          },
          {
            "text": "што човека вреба.",
            "poem": 2
          },
          {
            "text": "Убијају на путу за Сихем,",
            "poem": 1
          },
          {
            "text": "грозоте су починили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Видео сам страшне ствари у дому Израиљевом:",
            "poem": 1
          },
          {
            "text": "Јефрем тамо блудничи,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а Израиљ се опоганио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Јудо, и за тебе је одређена жетва,",
            "poem": 1
          },
          {
            "text": "из изгнанства народ свој кад вратим.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 13,
        "caller": "+",
        "text": "6,3 Јесења, рана киша, од позног септембра до раног новембра и пролећна, позна киша, од априла до почетка маја.",
        "reference": {
          "chapter": 6,
          "verse": 3
        }
      }
    ]
