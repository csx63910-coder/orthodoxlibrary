  "chapter": {
    "number": 8,
    "content": [
      {
        "type": "heading",
        "content": [
          "Израиљ жање олују"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Трубу на уста!",
            "poem": 1
          },
          {
            "text": "Ено лешинара над Домом Господњим",
            "poem": 2
          },
          {
            "text": "јер су прекршили мој савез,",
            "poem": 1
          },
          {
            "text": "побунили се против мог Закона.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Мени вапе:",
            "poem": 1
          },
          {
            "text": "’О, мој Боже!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ми, Израиљ, знамо тебе!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Али Израиљ је одбацио добро",
            "poem": 1
          },
          {
            "text": "и душман ће га прогонити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Постављају цареве који нису моји,",
            "poem": 1
          },
          {
            "text": "постављају главаре које не познајем.",
            "poem": 2
          },
          {
            "text": "Од свог сребра и од злата свога",
            "poem": 1
          },
          {
            "text": "идоле су себи направили,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да би могли бити истребљени.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Самаријо, твоје је теле одбачено",
            "poem": 1
          },
          {
            "text": "јер се на њих мој гнев распалио.",
            "poem": 2
          },
          {
            "text": "Колико још нећете моћи да будете неокаљани?",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Јер је од Израиља и та рукотворина,",
            "poem": 2
          },
          {
            "text": "ливац ју је излио и није Бог.",
            "poem": 1
          },
          {
            "text": "Зато ће се у парчиће претворити",
            "poem": 2
          },
          {
            "text": "теле Самарије.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Зато што су сејали ветар,",
            "poem": 1
          },
          {
            "text": "пожњеће олују.",
            "poem": 2
          },
          {
            "text": "Нема класа на том снопу,",
            "poem": 1
          },
          {
            "text": "неће бити брашна.",
            "poem": 2
          },
          {
            "text": "Можда роди за туђинце",
            "poem": 1
          },
          {
            "text": "који ће га прогутати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Израиљ ће прогутати!",
            "poem": 1
          },
          {
            "text": "Они су сада међу народима",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "као крчаг безвредан који нико неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Јер су у Асирију отишли",
            "poem": 1
          },
          {
            "text": "попут дивљег магарца што се сам скита,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а Јефрем љубавнике плаћа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Иако их и међу народима плаћа,",
            "poem": 1
          },
          {
            "text": "сада ћу их окупити",
            "poem": 2
          },
          {
            "text": "и за мало ће бити",
            "poem": 1
          },
          {
            "text": "под теретом цара и главара.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Јефрем је умножио жртвенике за грехе,",
            "poem": 1
          },
          {
            "text": "а за њега су они постали жртвеници греха.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Написао сам му много тога у своме Закону,",
            "poem": 1
          },
          {
            "text": "али за њега је то као нешто туђе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "За жртве, за приносе моје",
            "poem": 1
          },
          {
            "text": "они жртвују месо и једу га,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а Господу то није угодно.",
            "poem": 2
          },
          {
            "text": "Сада ће се опоменути њихове кривице",
            "poem": 1
          },
          {
            "text": "и казниће грехе њихове,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а они ће се вратити у Египат.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Заборавио је Израиљ Саздатеља свога",
            "poem": 1
          },
          {
            "text": "и саградио дворове,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а Јуда је умножио утврђене градове.",
            "poem": 2
          },
          {
            "text": "Ја ћу да пошаљем огањ на његове градове",
            "poem": 1
          },
          {
            "text": "и он ће да прождере његова утврђења.“",
            "poem": 2
          }
        ]
      }
    ],
