  "chapter": {
    "number": 11,
    "content": [
      {
        "type": "heading",
        "content": [
          "Одважи се и делуј"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Поврх вода хлеб свој баци",
            "poem": 1
          },
          {
            "text": "и наћи ћеш га после дана многих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Дај иметак седморици, па и осморици,",
            "poem": 1
          },
          {
            "text": "јер не знаш хоће ли земљу да стигне зло?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ако су облаци пуни кише,",
            "poem": 1
          },
          {
            "text": "на земљу се изручују;",
            "poem": 2
          },
          {
            "text": "падне ли дрво на југ или на север,",
            "poem": 1
          },
          {
            "text": "тамо где падне, тамо и остаје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ко у ветар гледа, одустаје од сетве;",
            "poem": 1
          },
          {
            "text": "ко облаке прати, одустаје од жетве.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Као што не знаш путању ветра",
            "poem": 1
          },
          {
            "text": "ни како настају кости у утроби труднице,",
            "poem": 2
          },
          {
            "text": "тако и дело Бога",
            "poem": 1
          },
          {
            "text": "који све чини не познајеш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Од јутра сеј семе",
            "poem": 1
          },
          {
            "text": "и до вечери не склапај руке своје.",
            "poem": 2
          },
          {
            "text": "Јер не знаш хоће ли да успе",
            "poem": 1
          },
          {
            "text": "једно или друго,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "или ће обоје испасти добро.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Сећај се свог Створитеља док си млад"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Слатко ли је светло",
            "poem": 1
          },
          {
            "text": "и добро ли је када очи у сунце гледају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Јер, ако човек већ и живи многе године,",
            "poem": 1
          },
          {
            "text": "нека у свима њима радостан буде.",
            "poem": 2
          },
          {
            "text": "Али нека се сети да ће доћи многи тмурни дани.",
            "poem": 1
          },
          {
            "text": "А пролазно је све то што долази.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "О, младићу, радуј се у младости својој!",
            "poem": 1
          },
          {
            "text": "Нека ти срце ужива док си млад,",
            "poem": 2
          },
          {
            "text": "следи његове жеље",
            "poem": 1
          },
          {
            "text": "и хтења очију својих.",
            "poem": 2
          },
          {
            "text": "Али знај да ће те због свега тога",
            "poem": 1
          },
          {
            "text": "Бог довести на суд.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Одбаци стрепњу из свог срца",
            "poem": 1
          },
          {
            "text": "и зло од тела свога одбаци,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер су и младост и црна коса пролазни.",
            "poem": 2
          }
        ]
      }
    ],
