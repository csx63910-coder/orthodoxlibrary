    "name": "Књига проповедникова",
    "commonName": "Књига проповедникова",
    "title": "Књига проповедникова",
    "order": 21,
    "numberOfChapters": 12,
    "sha256": "2f99515b94284fda981b7e4b5bc373e8ec8b4fbe0f9407d8ddf587bf5858368f",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/ECC/1.json",
    "lastChapterNumber": 12,
    "lastChapterApiLink": "/api/srp_onspc/ECC/12.json",
    "totalNumberOfVerses": 222
  },
  "chapter": {
    "number": 10,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Од угинуле муве се усмрди и ужегне апотекарско уље.",
            "poem": 1
          },
          {
            "text": "Тако је и мало глупости теже од много мудрости и од много части.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Мудром је срце с десне стране,",
            "poem": 1
          },
          {
            "text": "а безумнику с леве стране.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Чак и када путем иде,",
            "poem": 1
          },
          {
            "text": "луда је без срца,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "па још каже свима да је луда.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ако се гнев владарев на тебе подиже,",
            "poem": 1
          },
          {
            "text": "не напуштај своје место,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер смиреност утишава големе грехе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Видео сам да под капом небеском",
            "poem": 1
          },
          {
            "text": "постоји зло налик греху који долази од владара:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Глупаци су устоличени на многим високим местима,",
            "poem": 1
          },
          {
            "text": "док поштовани заузимају ниже место.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Видео сам слуге на коњима",
            "poem": 1
          },
          {
            "text": "и главаре што пешаче као робље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ко другоме јаму копа сам у њу упада",
            "poem": 1
          },
          {
            "text": "и ко руши зид ујешће га змија.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Камење које се клеше може да повреди клесара,",
            "poem": 1
          },
          {
            "text": "а дрво које се теше може да угрози тесара.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ако је секира тупа",
            "poem": 1
          },
          {
            "text": "и сечиво јој наоштрено није,",
            "poem": 2
          },
          {
            "text": "човеку голема снага треба.",
            "poem": 1
          },
          {
            "text": "Значи, мудрост је корисна јер напредак даје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Слаба корист за бајача",
            "poem": 1
          },
          {
            "text": "пре бајања уједе ли змија.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Блажене су речи мудрог,",
            "poem": 1
          },
          {
            "text": "а безумног његова уста изједају;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "глупост је на почетку његовог говора,",
            "poem": 1
          },
          {
            "text": "а сулудо зло на његовом свршетку.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Лудак силно брбља,",
            "poem": 1
          },
          {
            "text": "а човек не зна шта ће да се збуде,",
            "poem": 2
          },
          {
            "text": "и ко ће да му каже",
            "poem": 1
          },
          {
            "text": "шта долази након њега?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Безумнике труд замара,",
            "poem": 1
          },
          {
            "text": "па не знају ни у град да уђу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Јао теби, земљо, с неодраслим царем",
            "poem": 1
          },
          {
            "text": "и са главарима што се од јутра госте!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Блажена си, земљо, с царем племенитог рода,",
            "poem": 1
          },
          {
            "text": "с главарима што се госте кад је томе време,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ко јунаци, а не ко пијанци.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Због лењости и кров се угиба,",
            "poem": 1
          },
          {
            "text": "због немарних руку прокишњава кућа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ради славља хлеб се меси,",
            "poem": 1
          },
          {
            "text": "вино живот увесељава,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а новац свему решење пружа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Цара немој клети у себи,",
            "poem": 1
          },
          {
            "text": "а у одајама где почиваш немој клети богаташа;",
            "poem": 2
          },
          {
            "text": "јер ће птица небеска однети глас,",
            "poem": 1
          },
          {
            "text": "одаће ствар власница крила.",
            "poem": 2
          }
        ]
      }
    ],
