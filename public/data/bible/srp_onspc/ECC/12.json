    "name": "Књига проповедникова",
    "commonName": "Књига проповедникова",
    "title": "Књига проповедникова",
    "order": 21,
    "numberOfChapters": 12,
    "sha256": "2f99515b94284fda981b7e4b5bc373e8ec8b4fbe0f9407d8ddf587bf5858368f",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/ECC/1.json",
    "lastChapterNumber": 12,
    "lastChapterApiLink": "/api/srp_onspc/ECC/12.json",
    "totalNumberOfVerses": 222
  },
  "chapter": {
    "number": 12,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Сећај се Створитеља свога",
            "poem": 1
          },
          {
            "text": "у данима младости своје –",
            "poem": 2
          },
          {
            "text": "пре него дођу дани зла",
            "poem": 1
          },
          {
            "text": "и пристигну године за које ћеш рећи:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Не миле ми се“;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "пре него се замрачи сунце,",
            "poem": 1
          },
          {
            "text": "светло месеца и звезда",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и оду облаци након кише;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "на дан када се заљуљају чувари куће",
            "poem": 1
          },
          {
            "text": "и пресамите се јунаци,",
            "poem": 2
          },
          {
            "text": "када стану малобројне дробилице",
            "poem": 1
          },
          {
            "text": "и замагле се оне што кроз прозоре гледају,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "када се затворе улична врата",
            "poem": 1
          },
          {
            "text": "и утиша звекет млинског камена,",
            "poem": 2
          },
          {
            "text": "када се човек диже с цвркутом птица",
            "poem": 1
          },
          {
            "text": "и прореде се песме;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "када се човек боји узвишења",
            "poem": 1
          },
          {
            "text": "и опасности на путу,",
            "poem": 2
          },
          {
            "text": "када процвета бадем",
            "poem": 1
          },
          {
            "text": "и скакавац се улењи,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "када жеља умине.",
            "poem": 2
          },
          {
            "text": "Јер човек одлази у своју вечну кућу,",
            "poem": 1
          },
          {
            "text": "а на улицу излазе ожалошћени.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Сећај га се пре него пукне сребрно уже",
            "poem": 1
          },
          {
            "text": "и поломи се златна чаша,",
            "poem": 2
          },
          {
            "text": "пре него пукне крчаг на врелу",
            "poem": 1
          },
          {
            "text": "и скрши се точак на бунару.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Тада се прах земљи враћа, где је и био,",
            "poem": 1
          },
          {
            "text": "а дух се враћа Богу који га је дао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Пролазност над пролазношћу – вајка се проповедник –",
            "poem": 1
          },
          {
            "text": "Све је пролазно!",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Закључак"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "И не само да је проповедник био мудар него је и народ поучавао знању. Пажљиво је проучавао многе приче да би их саставио."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Проповедник је трагао за прикладним речима, хтео је да тачно запише речи истине."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Речи мудрих су попут остана, попут чврсто прикуцаних ексера су сакупљачи прича, што их је дао један пастир."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Чувај се, сине мој, претеривања, јер нема краја писању многих књига. А од силног учења и тело клоне."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Закључак свега што се чуло је:",
            "poem": 1
          },
          {
            "text": "Бога се бој",
            "poem": 2
          },
          {
            "text": "и његове заповести држи.",
            "poem": 1
          },
          {
            "text": "То је сва човекова дужност.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Елем, Бог ће свако дело довести на суд,",
            "poem": 1
          },
          {
            "text": "сваку скривену ствар,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "било добро или зло.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
