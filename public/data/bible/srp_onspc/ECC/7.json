  "chapter": {
    "number": 7,
    "content": [
      {
        "type": "heading",
        "content": [
          "Мудрост"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Боље је добро име од доброг мирисног уља",
            "poem": 1
          },
          {
            "text": "и дан смрти од дана рођења.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Боље је ићи у кућу ожалошћених",
            "poem": 1
          },
          {
            "text": "него у кућу где је гозба,",
            "poem": 2
          },
          {
            "text": "јер је то крај сваком човеку.",
            "poem": 1
          },
          {
            "text": "Нека то срцем својим пригрли ко живи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Од смеха је стрепња боља",
            "poem": 1
          },
          {
            "text": "јер је у тужном лицу милина срцу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Срце мудрих људи је у кући ожалошћених,",
            "poem": 1
          },
          {
            "text": "а срце безумника у кући где је гозба.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Боље је слушати прекор мудрог",
            "poem": 1
          },
          {
            "text": "него кад неко слуша песму безумника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Наиме, смех безумника",
            "poem": 1
          },
          {
            "text": "је попут праскања трновог грања под лонцем,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "али и то је пролазно.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Насиље и мудрог чини лудим,",
            "poem": 1
          },
          {
            "text": "а у миту срце огрезне.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Крај неке ствари је бољи од њеног почетка",
            "poem": 1
          },
          {
            "text": "и дуготрпељивост од бахатости.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Не нагли духом до јарости,",
            "poem": 1
          },
          {
            "text": "јер јарост почива у недрима безумника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Не питај: „Зашто су дани који су прошли бољи од дана који су дошли?“,",
            "poem": 1
          },
          {
            "text": "јер такво питање није мудро.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Мудрост је добра као и наследство",
            "poem": 1
          },
          {
            "text": "и на корист је онима које сунце обасјава.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Јер је у мудрости заклон",
            "poem": 1
          },
          {
            "text": "као што је у новцу заклон,",
            "poem": 2
          },
          {
            "text": "али је предност познавања мудрости у томе",
            "poem": 1
          },
          {
            "text": "што чува живот мудрих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Размисли о делу Божијем:",
          {
            "text": "ко је то кадар да исправи",
            "poem": 1
          },
          {
            "text": "оно што он искриви?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "У дану добрих ствари и ти добар буди,",
            "poem": 1
          },
          {
            "text": "а у дану лоших ствари размисли о овом:",
            "poem": 2
          },
          {
            "text": "Бог је начинио обоје с разлогом,",
            "poem": 1
          },
          {
            "text": "да човек не зна шта ће бити након њега.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Баш сам свашта видео у данима своје пролазности:",
          {
            "text": "праведника који страда у својој праведности",
            "poem": 1
          },
          {
            "text": "и неправедника који истрајава у својој неправедности.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Не буди претерано праведан",
            "poem": 1
          },
          {
            "text": "и не чини себе премудрим.",
            "poem": 2
          },
          {
            "text": "Зашто би се упропастио?",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Не буди претерано зао",
            "poem": 1
          },
          {
            "text": "и не буди луд.",
            "poem": 2
          },
          {
            "text": "Зашто би умро кад ти време није?",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Добро је да се држиш овог савета,",
            "poem": 1
          },
          {
            "text": "а и претходни не испуштај из руке.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Јер ко се боји Бога спасава се од свега.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Мудрост мудроме пружа више снаге",
            "poem": 1
          },
          {
            "text": "него десеторици владара што су у граду.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Стварно, нема на земљи праведног човека",
            "poem": 1
          },
          {
            "text": "који чини добро и не греши.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Елем, не мари за приче што их људи причају,",
            "poem": 1
          },
          {
            "text": "да не би чуо како те твој слуга куне.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Јер, срце твоје зна",
            "poem": 1
          },
          {
            "text": "да си често и ти клео друге.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "И све сам то искушао мудрошћу, па рекох:",
          {
            "text": "„Бићу мудар!“",
            "poem": 1
          },
          {
            "text": "Али, то је било далеко од мене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Шта год да се збива је далеко и предубоко.",
            "poem": 1
          },
          {
            "text": "Ко ће то да докучи?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Тако сам срцем настојао да сазнам,",
            "poem": 1
          },
          {
            "text": "да истражим, да нађем мудрост и смисао,",
            "poem": 2
          },
          {
            "text": "да откријем глупост неправде",
            "poem": 1
          },
          {
            "text": "и лудост безумља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "И открио сам да је жена,",
            "poem": 1
          },
          {
            "text": "која је као замка и чије је срце мрежа,",
            "poem": 2
          },
          {
            "text": "од смрти горча",
            "poem": 1
          },
          {
            "text": "и да су јој руке као ланци.",
            "poem": 2
          },
          {
            "text": "Богоугодник од ње бежи",
            "poem": 1
          },
          {
            "text": "док грешника она хвата.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Гле, то сам открио – говори проповедник –",
          {
            "text": "док сам ствари по ствари тражио смисао,",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "за којим истрајно трагам душом",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и не налазим га:",
            "poem": 2
          },
          {
            "text": "од њих хиљаду човека једног сам нашао,",
            "poem": 1
          },
          {
            "text": "али жену међу свим овима нашао нисам.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Ето, једно сам открио:",
            "poem": 1
          },
          {
            "text": "Бог је људе створио честитима,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "али они којекакве сплетке траже.",
            "poem": 2
          }
        ]
      }
    ],
