  "chapter": {
    "number": 86,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Давидова молитва."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Своје ухо пригни, о, Господе!",
            "poem": 1
          },
          {
            "text": "Услиши ме, јер сиромах",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и невољник ја сам.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Душу моју ти сачувај, јер сам веран;",
            "poem": 1
          },
          {
            "text": "свога слугу спаси,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер ти си мој Бог у кога се уздам.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Смилуј ми се, о, Господе,",
            "poem": 1
          },
          {
            "text": "јер ти вапим од јутра до сутра!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Разгали душу слуге свога,",
            "poem": 1
          },
          {
            "text": "јер ја теби, о, Господе, душу своју дижем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ти си добар, Господе;",
            "poem": 1
          },
          {
            "text": "вољан си да прашташ,",
            "poem": 2
          },
          {
            "text": "милошћу си богат",
            "poem": 1
          },
          {
            "text": "за све што те призивају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "О, Господе, чуј молитву моју!",
            "poem": 1
          },
          {
            "text": "Поклони пажњу гласу мога преклињања.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ја ћу тебе звати у дану моје невоље",
            "poem": 1
          },
          {
            "text": "јер ти ћеш се одазвати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Нема, Господе, никог попут тебе међу боговима,",
            "poem": 1
          },
          {
            "text": "не постоје дела као што су твоја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Сви народи које си створио ће доћи,",
            "poem": 1
          },
          {
            "text": "пред тобом се поклонити, Господе,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "име твоје прославити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Јер ти си велик,",
            "poem": 1
          },
          {
            "text": "чудеса ти твориш,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ти си Бог једини.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Научи ме своме путу, Господе,",
            "poem": 1
          },
          {
            "text": "да поступам по истини твојој,",
            "poem": 2
          },
          {
            "text": "да се срцем целим",
            "poem": 1
          },
          {
            "text": "твог имена бојим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "И ја ћу да те хвалим, Господе, мој Боже,",
            "poem": 1
          },
          {
            "text": "срцем својим целим!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Довека ћу да величам име твоје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Јер велика је милост твоја према мени,",
            "poem": 1
          },
          {
            "text": "јер си душу моју избавио",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "из најдубљег Света мртвих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Боже, против мене устају охоли;",
            "poem": 1
          },
          {
            "text": "моју душу траже бездушници;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "они тебе немају пред собом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "А ти си, Господе, Бог милостив и милосрдан,",
            "poem": 1
          },
          {
            "text": "спор на срџбу, богат милошћу и истином.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "На мене се осврни,",
            "poem": 1
          },
          {
            "text": "милостив ми буди;",
            "poem": 2
          },
          {
            "text": "своју снагу подај слузи своме,",
            "poem": 1
          },
          {
            "text": "спаси сина слушкиње своје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "На мени покажи знак доброте,",
            "poem": 1
          },
          {
            "text": "па нек виде они што ме мрзе;",
            "poem": 2
          },
          {
            "text": "нека се застиде тебе, о, Господе,",
            "poem": 1
          },
          {
            "text": "јер си ми помогао и утешио ме.",
            "poem": 2
          }
        ]
      }
    ],
