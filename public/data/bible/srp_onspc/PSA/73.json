  "chapter": {
    "number": 73,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Псалам Асафов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Зацело је Бог добар Израиљу,",
            "poem": 1
          },
          {
            "text": "и онима чије срце је без мане.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Што се мене тиче, замало ми ноге нису зашле с пута;",
            "poem": 1
          },
          {
            "text": "кораци се моји скоро исклизаше.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Јер сам завидео бахатима",
            "poem": 1
          },
          {
            "text": "гледајући благостање зликоваца.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ето, стрепњу од смрти немају,",
            "poem": 1
          },
          {
            "text": "тело им је задригло.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Људске муке не познају,",
            "poem": 1
          },
          {
            "text": "не страдају са људима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Надменост је зато њима као огрлица,",
            "poem": 1
          },
          {
            "text": "огрће их одећа насиља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Од дебљине очи своје избечише,",
            "poem": 1
          },
          {
            "text": "зло им срце за границу не зна.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Исмевају се, говоре злобно",
            "poem": 1
          },
          {
            "text": "и насиљем прете поносито.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Њихова су уста окренута небесима,",
            "poem": 1
          },
          {
            "text": "а њихов језик земљом шета.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Зато им се њихов народ враћа",
            "poem": 1
          },
          {
            "text": "и обиље воде испијају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "И говоре: „Како би Бог знао?",
            "poem": 1
          },
          {
            "text": "Постоји ли знање Свевишњега?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Гле, такви су зликовци:",
            "poem": 1
          },
          {
            "text": "спокојни довека",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и богатство гомилају!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Зацело сам узалуд своје срце чистим очувао,",
            "poem": 1
          },
          {
            "text": "своје руке невиношћу очистио!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Од јутра до сутра ојађен сам био,",
            "poem": 1
          },
          {
            "text": "јутра су ми доносила казну.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "А да сам казао да ћу и ја тако да причам,",
            "poem": 1
          },
          {
            "text": "изневерио бих нараштај твоје деце.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Размишљао сам да разазнам ово,",
            "poem": 1
          },
          {
            "text": "и очима мојим то је мучно било;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "док нисам ушао у Божије Светилиште,",
            "poem": 1
          },
          {
            "text": "и схватио њихов свршетак.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Зацело их стављаш на клизаво место,",
            "poem": 1
          },
          {
            "text": "обараш их у руине.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Како су опустошени, у трену су окончали",
            "poem": 1
          },
          {
            "text": "и наглом страхотом докрајчени!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Они су попут сна када се неко пробуди.",
            "poem": 1
          },
          {
            "text": "О, Господе, када се пробудиш, лик њихов презрећеш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Када огорчено беше срце моје",
            "poem": 1
          },
          {
            "text": "и нутрина моја беше прободена,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "без памети и без знања сам био,",
            "poem": 1
          },
          {
            "text": "пред тобом сам био животиња.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Ипак сам ја са тобом стално,",
            "poem": 1
          },
          {
            "text": "ти ми држиш десну руку.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Саветом ме својим водиш,",
            "poem": 1
          },
          {
            "text": "напослетку ћеш ме у славу узети.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Кога ја имам на небесима?",
            "poem": 1
          },
          {
            "text": "Поред тебе на земљи ми ништа мило није.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Нека ми окопне и тело и срце,",
            "poem": 1
          },
          {
            "text": "Бог је довека стена мога срца",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и баштина моја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Гле, ено пропашће они од тебе далеки,",
            "poem": 1
          },
          {
            "text": "ти сатиреш сваког ко ти је неверан.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Што се мене тиче,",
            "poem": 1
          },
          {
            "text": "добра ми је Божија близина.",
            "poem": 2
          },
          {
            "text": "У Господу Богу себи начинићу уточиште",
            "poem": 1
          },
          {
            "text": "и сва дела твоја објавићу.",
            "poem": 2
          }
        ]
      }
    ],
