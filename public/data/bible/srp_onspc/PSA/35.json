  "chapter": {
    "number": 35,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Давидов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Осуди, Господе, моје тужиоце,",
            "poem": 1
          },
          {
            "text": "и војуј против мојих нападача.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Узми оружје и штит,",
            "poem": 1
          },
          {
            "text": "устани, помози ми!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Потегни копље дуго и кратко,",
            "poem": 1
          },
          {
            "text": "против оних који ме прогоне.",
            "poem": 2
          },
          {
            "text": "Реци мојој души:",
            "poem": 1
          },
          {
            "text": "„Ја сам ти спасење!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Нек се постиде и осрамоте",
            "poem": 1
          },
          {
            "text": "они који ми о глави раде,",
            "poem": 2
          },
          {
            "text": "нек се повуку у срамоти",
            "poem": 1
          },
          {
            "text": "они што ми зло смишљају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Нек буду као плева на ветру,",
            "poem": 1
          },
          {
            "text": "тако нек их Анђео Господњи гони,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "нек је таман и клизав пут њихов,",
            "poem": 1
          },
          {
            "text": "кад их гони Анђео Господњи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Без повода ми разапеше мрежу,",
            "poem": 1
          },
          {
            "text": "без разлога ми ископаше јаму.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Нек их снађе пропаст изненада,",
            "poem": 1
          },
          {
            "text": "нек се ухвате у мрежу коју су сакрили,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "нек у њу падну на своју пропаст.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "А моја ће се душа радовати у Господу,",
            "poem": 1
          },
          {
            "text": "веселиће се у његовом спасењу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Све ће моје кости говорити:",
            "poem": 1
          },
          {
            "text": "„Ко је као ти, о, Господе?",
            "poem": 2
          },
          {
            "text": "Ти избављаш сиромаха од моћнијег од њега,",
            "poem": 1
          },
          {
            "text": "сиромаха и убогога од онога што га пљачка.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Иступају окрутни сведоци,",
            "poem": 1
          },
          {
            "text": "питају ме за оно што не знам.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "За добро ми злом плаћају,",
            "poem": 1
          },
          {
            "text": "душу моју у беду гурају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "А кад су они били у болести,",
            "poem": 1
          },
          {
            "text": "у кострет сам се због њих облачио,",
            "poem": 2
          },
          {
            "text": "душу своју постом сам мучио,",
            "poem": 1
          },
          {
            "text": "а молитва ми се у крило враћала.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Као за другом или братом,",
            "poem": 1
          },
          {
            "text": "шетао сам горе-доле;",
            "poem": 2
          },
          {
            "text": "као кад се жали за мајком,",
            "poem": 1
          },
          {
            "text": "тако сам се у жалости свио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "А кад ја посрнем, они се радују,",
            "poem": 1
          },
          {
            "text": "скупљају се против мене бедници,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "они које не знам раздиру ме непрестано.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Као безбожни злобно се ругају,",
            "poem": 1
          },
          {
            "text": "и зубима својим шкргућу на мене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Докле ћеш то гледати, Господе?",
            "poem": 1
          },
          {
            "text": "Спаси ме од њихових напада,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и мој живот од младих лавова.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Хвалићу те у великом збору,",
            "poem": 1
          },
          {
            "text": "славићу те међу многим народом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Не дај да се веселе нада мном",
            "poem": 1
          },
          {
            "text": "подмукли моји душмани,",
            "poem": 2
          },
          {
            "text": "да не намигују очима",
            "poem": 1
          },
          {
            "text": "они што ме без разлога мрзе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Они не говоре о миру,",
            "poem": 1
          },
          {
            "text": "већ смишљају преваре",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "против мирних у земљи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Уста своја разјапљују на мене,",
            "poem": 1
          },
          {
            "text": "и говоре: „Ево! Ево! Својим смо то очима видели!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Ти видиш то, Господе, не ћути!",
            "poem": 1
          },
          {
            "text": "Не удаљуј се, Господе, од мене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Пробуди се, устани, ради мога права,",
            "poem": 1
          },
          {
            "text": "мој спор одбрани, Боже мој, Господе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Оправдај ме, Господе, мој Боже, по праведности својој,",
            "poem": 1
          },
          {
            "text": "не дај да се они радују нада мном.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Не дај да у срцу они кажу: „Ето, то смо хтели!“",
            "poem": 1
          },
          {
            "text": "Да не кажу: „Прогутали смо га!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Нек се постиде и осрамоте",
            "poem": 1
          },
          {
            "text": "они што се невољи мојој радују;",
            "poem": 2
          },
          {
            "text": "нек стид и срам покрије оне,",
            "poem": 1
          },
          {
            "text": "који себе уздижу нада мном.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Нека кличу и радују се они,",
            "poem": 1
          },
          {
            "text": "којима је мило моје оправдање;",
            "poem": 2
          },
          {
            "text": "нека они говоре стално:",
            "poem": 1
          },
          {
            "text": "„Велик је Господ!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Мио му је напредак слуге његовог.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Језик ће ми причати о праведности твојој,",
            "poem": 1
          },
          {
            "text": "поваздан ћу прослављати тебе.",
            "poem": 2
          }
        ]
      }
    ],
