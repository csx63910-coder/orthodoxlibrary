  "chapter": {
    "number": 84,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. Радосница потомака Корејевих. Псалам."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "О, Господе над војскама,",
            "poem": 1
          },
          {
            "text": "дивно ли је боравиште твоје!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Чезне ми и копни душа",
            "poem": 1
          },
          {
            "text": "за двориштем Господњим!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Срце ми и тело кличу живом Богу!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Крај твојих жртвеника –",
            "poem": 1
          },
          {
            "text": "о, Господе над војскама,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Царе мој и Боже мој –",
            "poem": 2
          },
          {
            "text": "птица дом свој нађе",
            "poem": 1
          },
          {
            "text": "и ластавица гнездо своје,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "у које птиће своје стави.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Како су блажени они што бораве у твом Дому,",
            "poem": 1
          },
          {
            "text": "они што те славе без престанка. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Како је блажен човек коме је у теби снага,",
            "poem": 1
          },
          {
            "text": "онај чије срце жели к теби да путује.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Они што пролазе сузном долином",
            "poem": 1
          },
          {
            "text": "чине је извором,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "благослове јој рана киша носи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Путују, и све су силнији,",
            "poem": 1
          },
          {
            "text": "док се свако не покаже Богу на Сиону.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "О, Господе, Боже над војскама, чуј молитву моју!",
            "poem": 1
          },
          {
            "text": "Пригни ухо, о, Јаковљев Боже!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Штит наш погледај, о, Боже,",
            "poem": 1
          },
          {
            "text": "и запази лице свог помазаника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Јер бољи је и један дан у твојим двориштима",
            "poem": 1
          },
          {
            "text": "него хиљаду других;",
            "poem": 2
          },
          {
            "text": "боље и да стојим на прагу Дома Бога мога,",
            "poem": 1
          },
          {
            "text": "него да боравим у шаторима злога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Јер Господ Бог је и сунце и штит,",
            "poem": 1
          },
          {
            "text": "Господ даје и наклоност и част.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Не узима добро беспрекорним људима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "О, Господе над војскама,",
            "poem": 1
          },
          {
            "text": "благо сваком ко се у тебе поузда!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
