  "chapter": {
    "number": 87,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Потомака Корејевих. Псалам. Песма."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "На светим је горама његов темељ.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Господ воли врата Сиона",
            "poem": 1
          },
          {
            "text": "више од свих Јаковљевих пребивалишта.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Славне се ствари говоре о теби,",
            "poem": 1
          },
          {
            "text": "о, граде Божији! Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "„Спомињаћу и Вавилон и Раву",
            "poem": 1
          },
          {
            "text": "са онима који ме познају;",
            "poem": 2
          },
          {
            "text": "ено, онде су Филистеја и Тир са Кушом,",
            "poem": 1
          },
          {
            "text": "’А овај је овде рођен.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "А Сиону ће рећи:",
            "poem": 1
          },
          {
            "text": "„Тај и тај се у њему родио;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Свевишњи је њега основао.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Уписаће Господ у књигу пописа народа:",
            "poem": 1
          },
          {
            "text": "„Овај се родио овде!“ Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "А певачи и играчи кажу:",
            "poem": 1
          },
          {
            "text": "„У теби су сви извори моји!“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
