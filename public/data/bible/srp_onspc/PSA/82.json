  "chapter": {
    "number": 82,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Псалам Асафов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Бог је стао у Божијем збору,",
            "poem": 1
          },
          {
            "text": "па сад суди међу боговима:",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Докле ћете судити нечасно",
            "poem": 1
          },
          {
            "text": "и држати страну злотворима? Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Заступајте право убогога и сиротога,",
            "poem": 1
          },
          {
            "text": "оправдајте сиромаха и невољника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Спасавајте слабог и тлаченог,",
            "poem": 1
          },
          {
            "text": "избавите их из руке зликоваца.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Али нису знали, нису разумели;",
            "poem": 1
          },
          {
            "text": "у тами су посртали",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и темеље земљи задрмали.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ја рекох: ’Богови сте,",
            "poem": 1
          },
          {
            "text": "сви сте деца Свевишњега!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ипак ћете помрети ко људи,",
            "poem": 1
          },
          {
            "text": "пропашћете ко и главар сваки.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Устани, Боже, и суди земљи,",
            "poem": 1
          },
          {
            "text": "јер сви су народи наследство твоје!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
