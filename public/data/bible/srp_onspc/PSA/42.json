  "chapter": {
    "number": 42,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "За хоровођу. Поучна песма синова Корејевих."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Као што кошута чезне за потоцима,",
            "poem": 1
          },
          {
            "text": "тако душа моја чезне за тобом, Боже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Жедна ми је душа Бога, Бога живога.",
            "poem": 1
          },
          {
            "text": "Када ћу доћи и пред Богом се појавити?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Сузе су ми храна и дању и ноћу,",
            "poem": 1
          },
          {
            "text": "док ми поваздан говоре: „Где ти је Бог твој?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Душа ми вене кад се сетим како сам ходио с многима,",
            "poem": 1
          },
          {
            "text": "предводећи их к Дому Божијем уз клицање и хвалоспеве,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "с мноштвом које слави празник.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Што си ми клонула, душо моја,",
            "poem": 1
          },
          {
            "text": "и што уздишеш у мени?",
            "poem": 2
          },
          {
            "text": "Богу се надај, јер опет ћу га славити,",
            "poem": 1
          },
          {
            "text": "Спаситеља мог, Бога мог.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Клонула је душа у мени,",
            "poem": 1
          },
          {
            "text": "зато те спомињем из краја јорданског,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и с Ермона, на гори Мисару.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Дубина дубину дозива хуком слапова твојих,",
            "poem": 1
          },
          {
            "text": "све бујице и таласи твоји пређоше преко мене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Дању Господ шаље своју милост,",
            "poem": 1
          },
          {
            "text": "а ноћу је песма његова са мном –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "молитва Богу живота мог.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Рећи ћу Богу: „Стено моја, зашто си ме заборавио?",
            "poem": 1
          },
          {
            "text": "Зашто жалим под тлаком непријатеља свог?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Кости ми се ломе од ругања душмана мојих,",
            "poem": 1
          },
          {
            "text": "док ми поваздан говоре: „Где ти је Бог твој?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Што си ми клонула, душо моја,",
            "poem": 1
          },
          {
            "text": "што уздишеш у мени?",
            "poem": 2
          },
          {
            "text": "Богу се надај, јер опет ћу га славити,",
            "poem": 1
          },
          {
            "text": "Спаситеља и Бога свог.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
