  "chapter": {
    "number": 54,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи, уз жичане инструменте. Давидова поучна песма, када су Зифејци дошли Саулу и рекли: „Не крије ли се Давид код нас?“"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Боже, именом ме својим спаси",
            "poem": 1
          },
          {
            "text": "и снагом ме својом ти одбрани.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Боже, чуј молитву моју;",
            "poem": 1
          },
          {
            "text": "речи уста мојих послушај.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Јер, против мене устају туђинци;",
            "poem": 1
          },
          {
            "text": "моју душу траже бездушници;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "они Бога немају пред собом. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Гле, Бог ми је помоћник;",
            "poem": 1
          },
          {
            "text": "Господ је међу онима што ми душу подупиру.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Вратило се зло мрзитељу моме;",
            "poem": 1
          },
          {
            "text": "ти их сатри у верности својој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Радо ћу ти жртвовати;",
            "poem": 1
          },
          {
            "text": "хвалићу име твоје, Господе,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер је добро.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Јер оно ме је избавило из сваке невоље",
            "poem": 1
          },
          {
            "text": "и око ми победнички гледа противнике моје.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
