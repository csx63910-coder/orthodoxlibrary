  "chapter": {
    "number": 114,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Када је из Египта изашао Израиљ,",
            "poem": 1
          },
          {
            "text": "дом Јаковљев из народа туђинског језика,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Јуда је постао његово Светилиште",
            "poem": 1
          },
          {
            "text": "и Израиљ царство његово.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Видело то море, па устукну,",
            "poem": 1
          },
          {
            "text": "а и Јордан потече уназад.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ко овнови поскакаше горе",
            "poem": 1
          },
          {
            "text": "и брежуљци попут јагањаца.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Море, што си утекло?",
            "poem": 1
          },
          {
            "text": "Јордане, што си уназад потекао?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Горе, што скачете ко овнови",
            "poem": 1
          },
          {
            "text": "и ви, брежуљци, попут јагањаца?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Пред Господом потреси се, земљо,",
            "poem": 1
          },
          {
            "text": "пред Јаковљевим Богом;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "што претвара стену у језеро,",
            "poem": 1
          },
          {
            "text": "кремен-камен у свој извор воде.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
