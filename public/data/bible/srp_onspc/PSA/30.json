  "chapter": {
    "number": 30,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Псалам Давидов. Песма за посвећење храма."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Узвисујем те, Господе, јер си ме подигао,",
            "poem": 1
          },
          {
            "text": "ниси дао да се душмани нада мном радују.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Теби завапих, Господе, Боже мој,",
            "poem": 1
          },
          {
            "text": "и ти си ме исцелио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Господе, из Света мртвих ти си ме извео,",
            "poem": 1
          },
          {
            "text": "моју си душу спасао од раке.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Запојте Господу, верни његови,",
            "poem": 1
          },
          {
            "text": "хвалите га, спомињите светост његову.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Јер гнев његов траје за трен,",
            "poem": 1
          },
          {
            "text": "а читав живот милост његова.",
            "poem": 2
          },
          {
            "text": "Вече доноси плач,",
            "poem": 1
          },
          {
            "text": "а јутро клицање.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "У свом спокојству рекао сам себи:",
            "poem": 1
          },
          {
            "text": "„Никада ме ништа неће уздрмати.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Милошћу си ме својом, Господе,",
            "poem": 1
          },
          {
            "text": "учврстио као моћну гору;",
            "poem": 2
          },
          {
            "text": "кад си лице своје сакрио,",
            "poem": 1
          },
          {
            "text": "свега ме је страх обузео.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "К теби вапим, Господе,",
            "poem": 1
          },
          {
            "text": "од свога Бога тражим милост.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "„Каква корист од моје смрти,",
            "poem": 1
          },
          {
            "text": "ако сиђем у раку?",
            "poem": 2
          },
          {
            "text": "Хоће ли те прах прослављати?",
            "poem": 1
          },
          {
            "text": "Зар ће прах о твојој верности да прича?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Почуј, Господе, смилуј ми се,",
            "poem": 1
          },
          {
            "text": "буди моја помоћ, о, Господе!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Мој си плач окренуо у коло,",
            "poem": 1
          },
          {
            "text": "скинуо си с мене рухо жалости,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и у рухо ме радости обукао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Зато те душа моја слави без престанка.",
            "poem": 1
          },
          {
            "text": "О, Господе, Боже мој, хвалићу те вечно!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
