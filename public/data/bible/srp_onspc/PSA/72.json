  "chapter": {
    "number": 72,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Соломону."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "О, Боже, прописе своје цару подај",
            "poem": 1
          },
          {
            "text": "и праведност своју сину царевоме!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Нек народу твоме он праведно суди",
            "poem": 1
          },
          {
            "text": "и сиромасима према прописима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Нека горе народу мир донесу",
            "poem": 1
          },
          {
            "text": "и брда праведност.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Он ће сиромасима да суди,",
            "poem": 1
          },
          {
            "text": "деци убогих победу даће",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и скршиће тлачитеља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Бојаће те се људи док је сунца и месеца,",
            "poem": 1
          },
          {
            "text": "од рода до рода.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Спустиће се као киша на кошену траву",
            "poem": 1
          },
          {
            "text": "и попут пљускова натапаће земљу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "У његовим данима процветаће праведник",
            "poem": 1
          },
          {
            "text": "и обиље мира док месеца буде било.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Владаће од мора до мора",
            "poem": 1
          },
          {
            "text": "и од реке до крајева где земља престаје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Клекнуће пред њим пустињска племена,",
            "poem": 1
          },
          {
            "text": "противници његови лизаће прашину.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Принеће му принос",
            "poem": 1
          },
          {
            "text": "цареви тарсиски и острвски;",
            "poem": 2
          },
          {
            "text": "цареви Саве и Севе",
            "poem": 1
          },
          {
            "text": "данак ће да дају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Поклониће му се сви цареви,",
            "poem": 1
          },
          {
            "text": "сви народи служиће му.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Јер он ће да избави убогог што за помоћ вапи,",
            "poem": 1
          },
          {
            "text": "и сиромаха без помоћи ниоткуда.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Поштедеће слабог и убогог,",
            "poem": 1
          },
          {
            "text": "животе убогих спасти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Од тлачења и насиља живот њихов откупиће,",
            "poem": 1
          },
          {
            "text": "очима његовим крв њихова драгоцена ће бити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Жив нек буде!",
            "poem": 1
          },
          {
            "text": "Нек му дају од злата савскога;",
            "poem": 2
          },
          {
            "text": "нека стално за њега се моле,",
            "poem": 1
          },
          {
            "text": "од јутра до сутра благосиљају га.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Нек пшеницом обилује земља,",
            "poem": 1
          },
          {
            "text": "нек се род његов повија на врху гора, као на Ливану;",
            "poem": 2
          },
          {
            "text": "нек процвета народ из градова",
            "poem": 1
          },
          {
            "text": "ко трава земаљска.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Његово име нек буде довека,",
            "poem": 1
          },
          {
            "text": "нека траје докле је и сунца.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Нек у њему сви народи благослове се",
            "poem": 1
          },
          {
            "text": "и блаженим нек га називају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Благословен био Господ Бог, Бог Израиља,",
            "poem": 1
          },
          {
            "text": "он једини чудеса чини.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "И благословено довека било његово славно име,",
            "poem": 1
          },
          {
            "text": "нек сву земљу слава му испуни.",
            "poem": 2
          },
          "Амин! Амин!"
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Довршише се молитве Давида, сина Јесејевог.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
