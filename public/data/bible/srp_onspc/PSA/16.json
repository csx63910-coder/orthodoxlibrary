  "chapter": {
    "number": 16,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Давидова песма поуздања у Бога."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Чувај ме, о, Боже,",
            "poem": 1
          },
          {
            "text": "јер у теби је уточиште моје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Кажем Господу:",
            "poem": 1
          },
          {
            "text": "„Ти си мој Господ,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "без тебе ми нема добра.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Узвишени су свети у земљи,",
            "poem": 1
          },
          {
            "text": "у њима ми је сва милина.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Многе муке стижу оне,",
            "poem": 1
          },
          {
            "text": "што за другим боговима хрле.",
            "poem": 2
          },
          {
            "text": "Зато нећу њима крвне жртве лити,",
            "poem": 1
          },
          {
            "text": "нити ће ми усне призивати им име.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Господ ми је баштина, моја чаша;",
            "poem": 1
          },
          {
            "text": "ти чврсто држиш мој део.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Земља ми је дана на пријатном месту;",
            "poem": 1
          },
          {
            "text": "како ли је дивна моја баштина!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Благосиљам Господа који ме саветује,",
            "poem": 1
          },
          {
            "text": "и у ноћно доба опомиње ме нутрина.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Господ ми је увек пред очима.",
            "poem": 1
          },
          {
            "text": "Пошто ми је он са десне стране,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ништа мене уздрмати неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Зато ми је срце усхићено,",
            "poem": 1
          },
          {
            "text": "а биће моје томе се радује;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "цело моје тело почива спокојно,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "што ми душу нећеш препустити Свету мртвих,",
            "poem": 1
          },
          {
            "text": "нити дати да твој верни трули.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Стазу живота ти си ми открио,",
            "poem": 1
          },
          {
            "text": "пун радости пред тобом ћу бити.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Вечне су дивоте у твојој десници!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
