  "chapter": {
    "number": 34,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Давидов. Када се Давид претварао да је луд пред Авимелехом. Овај га је, затим, отерао, па је Давид отишао."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Благосиљаћу Господа непрестано,",
            "poem": 1
          },
          {
            "text": "стално ће га усне моје хвалити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Хвалиће се Господом моја душа;",
            "poem": 1
          },
          {
            "text": "нека чују понизни, нека се радују.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Величајте са мном Господа,",
            "poem": 1
          },
          {
            "text": "заједно му узвисујмо име.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Тражио сам Господа, и он ми одговори,",
            "poem": 1
          },
          {
            "text": "од свих ме је страхова избавио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ведри су они који гледају у њега,",
            "poem": 1
          },
          {
            "text": "лице се њихово неће постидети.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Кад је овај сиромах вапио, Господ га је чуо,",
            "poem": 1
          },
          {
            "text": "и од свих га је невоља избавио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Анђео Господњи табором окружује",
            "poem": 1
          },
          {
            "text": "оне који га се боје; избавља их.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Искусите и видите да је Господ добар,",
            "poem": 1
          },
          {
            "text": "благо човеку што у њему уточиште нађе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Бојте се Господа, ви свети његови,",
            "poem": 1
          },
          {
            "text": "јер нема оскудице за оне који га се боје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "И млади лавови трпе и гладују,",
            "poem": 1
          },
          {
            "text": "али онима што траже Господа,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "њима добра никаквог не мањка.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Дођите, о, децо, и чујте ме,",
            "poem": 1
          },
          {
            "text": "богобојазности ћу вас поучити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Који човек воли живот?",
            "poem": 1
          },
          {
            "text": "Ко жели да добре дане види?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Нек се твој језик од зла уздржи,",
            "poem": 1
          },
          {
            "text": "нек ти усне не говоре лажи,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "зла се клони, а добро чини,",
            "poem": 1
          },
          {
            "text": "тражи мир и за њим ти иди.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Очи Господње мотре на праведне,",
            "poem": 1
          },
          {
            "text": "и уши његове вапај им чују.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Лице се Господње мршти на зликовце,",
            "poem": 1
          },
          {
            "text": "да са земље помен им истреби.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Господ чује кад праведни завапе,",
            "poem": 1
          },
          {
            "text": "од свих невоља он их избавља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Близу је Господ онима са сломљеним срцем,",
            "poem": 1
          },
          {
            "text": "он спасава оне са клонулим духом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Многа зла сналазе праведника,",
            "poem": 1
          },
          {
            "text": "али Господ га избавља од свих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Он чува све кости његове,",
            "poem": 1
          },
          {
            "text": "ниједна му се неће поломити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Зло ће убити опакога,",
            "poem": 1
          },
          {
            "text": "а који мрзе праведника биће окривљени.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Господ откупљује живот својих слугу;",
            "poem": 1
          },
          {
            "text": "неће бити крив нико ко у њему уточиште нађе.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
