  },
  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Блажен човек који не следи савет опаких,",
            "poem": 1
          },
          {
            "text": "не стоји на грешничком путу,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "нити седа у друштво ругача,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "већ ужива у Закону Господњем,",
            "poem": 1
          },
          {
            "text": "дан и ноћ му о Закону мисли.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Он је као дрво усађено крај поточних вода,",
            "poem": 1
          },
          {
            "text": "које род свој даје када му је време,",
            "poem": 2
          },
          {
            "text": "а лишће му никада не вене.",
            "poem": 1
          },
          {
            "text": "Све што ради, на добро му иде.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Нису такви опаки!",
            "poem": 1
          },
          {
            "text": "Они су као плева што је ветар носи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Зато опаки неће опстати на суду,",
            "poem": 1
          },
          {
            "text": "ни грешници на збору праведних.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Јер зна Господ пут праведника,",
            "poem": 1
          },
          {
            "text": "а пут опаких води у пропаст.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
