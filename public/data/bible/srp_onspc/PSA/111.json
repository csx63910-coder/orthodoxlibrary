  },
  "chapter": {
    "number": 111,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Славите Господа!",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Хвалићу Господа целим срцем својим,",
            "poem": 1
          },
          {
            "text": "на сабору праведника и у заједници!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Велика су дела Господња,",
            "poem": 1
          },
          {
            "text": "жељан их је свако ко ужива у њима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Величанствено и славно дело је његово,",
            "poem": 1
          },
          {
            "text": "праведност његова трајаће довека.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Чудеса је своја учинио да се памте,",
            "poem": 1
          },
          {
            "text": "милосрдан је и милостив Господ.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Храну даје богобојазнима,",
            "poem": 1
          },
          {
            "text": "свог савеза довека се сећа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Свом народу јавио је силу дела својих,",
            "poem": 1
          },
          {
            "text": "дајући им наследство народа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Веродостојна су и праведна дела његових руку,",
            "poem": 1
          },
          {
            "text": "сви његови прописи су поуздани;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "постављени од века до века,",
            "poem": 1
          },
          {
            "text": "учињени истинито и праведно.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "За свој народ откуп је послао",
            "poem": 1
          },
          {
            "text": "и свој савез вечно поставио;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "име му је и свето и страшно.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Мудрост отпочиње богобојазношћу.",
            "poem": 1
          },
          {
            "text": "Баш су разборити сви који тако чине",
            "poem": 2
          },
          {
            "noteId": 11
          },
          {
            "lineBreak": true
          },
          {
            "text": "и слава им траје за век века.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 11,
        "caller": "+",
        "text": "111,10 Они који држе савез и богобојазни су, према контексту овог и претходног стиха.",
        "reference": {
          "chapter": 111,
          "verse": 10
        }
      }
    ]
  },
