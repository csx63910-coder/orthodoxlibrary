  "chapter": {
    "number": 77,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. За Једутуна од Асафа. Псалам."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Глас свој Богу дижем,",
            "poem": 1
          },
          {
            "text": "гласом својим вапим Богу и он ме услиши!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "У дану невоље своје Господа сам тражио,",
            "poem": 1
          },
          {
            "text": "руке неуморно ноћу сам пружао.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Али душа моја неће утеху!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Спомињем Бога и јецам,",
            "poem": 1
          },
          {
            "text": "јадам се, а дух ми малакше. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Капке очне не даш ми да склопим!",
            "poem": 1
          },
          {
            "text": "Немиран сам, да причам не могу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Мислим на минуле дане",
            "poem": 1
          },
          {
            "text": "и године давне.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ноћу се сећам своје песме",
            "poem": 1
          },
          {
            "text": "па срцем својим размишљам",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и духом својим испитујем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Одбацује ли Господ довека?",
            "poem": 1
          },
          {
            "text": "Зар се неће опет приклонити?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Је ли му љубав довека ишчезла?",
            "poem": 1
          },
          {
            "text": "Је ли пропало обећање дано нараштају сваком?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Зар је Бог заборавио да се смилује",
            "poem": 1
          },
          {
            "text": "или је милосрђе своје у свом гневу угушио? Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Рекао сам: „Ово је моја рана –",
            "poem": 1
          },
          {
            "text": "десница Свевишњег више није иста!“",
            "poem": 2
          },
          {
            "noteId": 6
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Спомињем дела Господња,",
            "poem": 1
          },
          {
            "text": "чуда твоја од старина памтим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "На сва дела твоја мислим,",
            "poem": 1
          },
          {
            "text": "разматрам то што си учинио!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "О, Боже, у Светињи је пут твој!",
            "poem": 1
          },
          {
            "text": "Који је бог велик попут Бога нашег?!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ти си Бог што чудеса чиниш,",
            "poem": 1
          },
          {
            "text": "силу своју обзнањујеш међу народима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Свој си народ откупио снагом својом,",
            "poem": 1
          },
          {
            "text": "синове Јакова и Јосифа. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Кад те воде угледаше, Боже,",
            "poem": 1
          },
          {
            "text": "кад те воде угледаше,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "скупише се, а дубине узбуркаше.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Облаци се провалише кишом,",
            "poem": 1
          },
          {
            "text": "из облака грмљавина дође",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и севнуше твоје муње.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Пролом твога грома беше у вихору,",
            "poem": 1
          },
          {
            "text": "муње светом засветлише,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а земља се дрмала и тресла.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "По мору је стаза твоја прошла,",
            "poem": 1
          },
          {
            "text": "прошао си немирним водама,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а стопама твојим трага нема.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Водио си свој народ ко стадо,",
            "poem": 1
          },
          {
            "text": "Мојсијевом и Ароновом руком.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 6,
        "caller": "+",
        "text": "77,10 Овај стих може и овако да се преведе: И за овим жалим: за годинама када је десница Господња била испружена.",
        "reference": {
          "chapter": 77,
          "verse": 10
        }
      }
    ]
  },
