  "chapter": {
    "number": 8,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи, „Радосница“. Псалам Давидов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "О, Господе, наш Боже,",
            "poem": 1
          },
          {
            "text": "како је узвишено име твоје по свој земљи!",
            "poem": 2
          },
          {
            "text": "Ти си хвалу себи",
            "poem": 1
          },
          {
            "text": "дао на небесима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Са усана деце и дојенчади,",
            "poem": 1
          },
          {
            "text": "ти си себи моћ подигао",
            "poem": 2
          },
          {
            "text": "ради својих непријатеља;",
            "poem": 1
          },
          {
            "text": "да ућуткаш душманина и осветника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Кад погледам твоја небеса,",
            "poem": 1
          },
          {
            "text": "које твоји прсти начинише,",
            "poem": 2
          },
          {
            "text": "месец и звезде које ти постави…",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Шта је човек да га се сећаш,",
            "poem": 1
          },
          {
            "text": "шта ли син човечији да бринеш за њега?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ти си га мало мањим од Бога учинио,",
            "poem": 1
          },
          {
            "text": "славом и чашћу њега си овенчао,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "дела руку својих у власт си му дао,",
            "poem": 1
          },
          {
            "text": "њему под ноге све си покорио:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "све овце и говеда,",
            "poem": 1
          },
          {
            "text": "и звериње пољско,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "птице небеске, и рибе морске,",
            "poem": 1
          },
          {
            "text": "што пливају морским стазама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "О, Господе, наш Боже,",
            "poem": 1
          },
          {
            "text": "како је узвишено име твоје по свој земљи!",
            "poem": 2
          }
        ]
      }
    ],
