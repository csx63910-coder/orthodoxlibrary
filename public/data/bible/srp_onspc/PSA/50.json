  "chapter": {
    "number": 50,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Псалам Асафов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Господ, Бог Свевишњи, говори,",
            "poem": 1
          },
          {
            "text": "дозива земљу од изласка сунца",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "па до његовог заласка.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Од Сиона, савршено лепог,",
            "poem": 1
          },
          {
            "text": "Бог је заблистао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Долази наш Бог и ћутати неће;",
            "poem": 1
          },
          {
            "text": "пред њим пламен гута,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "око њега бучи непогода.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Он с висина позива небеса,",
            "poem": 1
          },
          {
            "text": "а и земљу, да суди свом народу:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "„Окупите ми мој верни народ",
            "poem": 1
          },
          {
            "text": "што уз жртву савез са мном склопи.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Небеса јављају његову праведност;",
            "poem": 1
          },
          {
            "text": "јер је сам Бог судија. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "„Чуј, мој народе, говорићу,",
            "poem": 1
          },
          {
            "text": "о, Израиљу, против тебе сведочићу;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ја сам Бог, твој Бог јесам.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Не корим те због твојих жртава",
            "poem": 1
          },
          {
            "text": "и твојих свеспалница што су стално преда мном.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Не примам бика из твоје штале",
            "poem": 1
          },
          {
            "text": "и јарце из твојих стада.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Јер моја је свака шумска животиња,",
            "poem": 1
          },
          {
            "text": "стока са хиљаду гора.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Свака горска птица мени је позната,",
            "poem": 1
          },
          {
            "text": "припада ми што по пољу миче.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Да огладним, не бих теби казао;",
            "poem": 1
          },
          {
            "text": "јер су моји и свет и шта га испуњава.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Једем ли ја месо бикова",
            "poem": 1
          },
          {
            "text": "и пијем ли крв јараца?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Жртвуј Богу захвалницу,",
            "poem": 1
          },
          {
            "text": "испуни Свевишњем завете своје;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "позови ме у дану невоље;",
            "poem": 1
          },
          {
            "text": "избавићу те, а ти ћеш ме прославити.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "А зликовцу говори Бог:",
          {
            "text": "„Зашто прописе моје рецитујеш",
            "poem": 1
          },
          {
            "text": "и мој савез узимаш у уста?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ти, који мрзиш укор,",
            "poem": 1
          },
          {
            "text": "и моје си речи одбацио од себе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Кад видиш лопова, с њим под руку идеш,",
            "poem": 1
          },
          {
            "text": "ортачиш с прељубницима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Злу препушташ уста своја,",
            "poem": 1
          },
          {
            "text": "језик ти се с клеветом уплео.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Седиш и оцрњујеш брата свога,",
            "poem": 1
          },
          {
            "text": "сина мајке своје оговараш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Такве ствари си чинио,",
            "poem": 1
          },
          {
            "text": "а ја сам ћутао;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "замишљао си ме себи равним;",
            "poem": 2
          },
          {
            "text": "а ја ћу те укорити,",
            "poem": 1
          },
          {
            "text": "случај свој ти редом предочити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Размислите о овоме,",
            "poem": 1
          },
          {
            "text": "ви што Бога заборављате;",
            "poem": 2
          },
          {
            "text": "или ћу вас растргнути,",
            "poem": 1
          },
          {
            "text": "и неће бити избавитеља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Мене слави ко жртвује захвалницу;",
            "poem": 1
          },
          {
            "text": "ко се пута држи",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "показаћу му Божије спасење.“",
            "poem": 2
          }
        ]
      }
    ],
