  "chapter": {
    "number": 24,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Псалам Давидов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Господу припада земља и све што је на њој,",
            "poem": 1
          },
          {
            "text": "свет и сви који живе на њему.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Јер он га је утемељио на морима,",
            "poem": 1
          },
          {
            "text": "на водама га основао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ко ће да се успне на гору Господњу?",
            "poem": 1
          },
          {
            "text": "Ко ће да стане на свето место његово?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Онај коме су руке недужне,",
            "poem": 1
          },
          {
            "text": "човек који има срце без мане,",
            "poem": 2
          },
          {
            "text": "чија душа не следи испразност,",
            "poem": 1
          },
          {
            "text": "и који се не заклиње лажно.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Он ће пожњети благослов од Господа,",
            "poem": 1
          },
          {
            "text": "и праведност од Бога, свог Спаситеља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Такав је нараштај оних који га траже,",
            "poem": 1
          },
          {
            "text": "који траже лице твоје, Боже Јаковљев. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Дигните, о, врата, своје надвратнике,",
            "poem": 1
          },
          {
            "text": "дигните се, двери вечне,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да уђе Цар славе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ко је тај Цар славе?",
            "poem": 1
          },
          {
            "text": "Господ јак и јуначан,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Господ силан у боју.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Дигните, о, врата, своје надвратнике,",
            "poem": 1
          },
          {
            "text": "дигните се, двери вечне,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да уђе Цар славе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ко је тај Цар славе?",
            "poem": 1
          },
          {
            "text": "Господ над војскама,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "он је тај Цар славе. Села",
            "poem": 2
          }
        ]
      }
    ],
