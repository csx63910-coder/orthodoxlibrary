  "chapter": {
    "number": 66,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. Псалам. Песма."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Кличи Богу, земљо сва!",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Певајте слави његовог имена;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "славу му и хвалу дајте.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Реците Богу: „Како су страшна дела твоја!",
            "poem": 1
          },
          {
            "text": "Због велике силе твоје",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "пред тобом пузе твоји противници.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Сва ти се земља клања;",
            "poem": 1
          },
          {
            "text": "славопој певају теби,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "славопој певају имену твоме.“ Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Дођите и видите дела Божија,",
            "poem": 1
          },
          {
            "text": "страшна дела према потомцима људи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Он од мора чини суву земљу,",
            "poem": 1
          },
          {
            "text": "па су воде прегазили ногом;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "хајде да се тамо радујемо њему.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Снагом својом он довека влада;",
            "poem": 1
          },
          {
            "text": "његове очи на народе мотре,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "па душмани нек се не уздижу. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Благосиљај нашег Бога, народе,",
            "poem": 1
          },
          {
            "text": "нек се чује глас хвале о њему;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "о њему који нам живот у душу стави",
            "poem": 1
          },
          {
            "text": "и не даде ногама нашим да посрну.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Опробао си нас, Боже,",
            "poem": 1
          },
          {
            "text": "претопио нас као сребро што се топи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "У мрежу си нас довео,",
            "poem": 1
          },
          {
            "text": "терет си нам на бедра ставио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Пустио си да нам човек врат зајаше,",
            "poem": 1
          },
          {
            "text": "прошли смо и кроз ватру и кроз воду,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "али си нас довео до изобиља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ући ћу са свеспалницама у Дом твој;",
            "poem": 1
          },
          {
            "text": "испунићу што сам ти се заветовао,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "што су усне моје изустиле,",
            "poem": 1
          },
          {
            "text": "и што су ми уста у невољи мојој рекла.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Принећу ти товну стоку",
            "poem": 1
          },
          {
            "text": "на свеспалницу са кадом овнова;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "принећу ти и јунце и јарце. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Дођите и слушајте,",
            "poem": 1
          },
          {
            "text": "ви који се Бога бојите,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "рећи ћу вам шта је души мојој учинио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Њему сам вапио устима својим,",
            "poem": 1
          },
          {
            "text": "мој га је језик уздизао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Да сам злобу у свом срцу пазио,",
            "poem": 1
          },
          {
            "text": "не би ме Господ услишио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Заиста је Господ чуо,",
            "poem": 1
          },
          {
            "text": "на зов молитве моје се осврнуо.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Благословен да је Бог",
            "poem": 1
          },
          {
            "text": "што молитву моју није уклонио,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а ни милост своју од мене.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
