  "chapter": {
    "number": 47,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. Псалам потомака Корејевих."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Сви народи, запљескајте длановима;",
            "poem": 1
          },
          {
            "text": "кличите Богу веселим узвиком!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Јер је страшан Свевишњи Господ,",
            "poem": 1
          },
          {
            "text": "цар велики над свом земљом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Он нам је покорио народе",
            "poem": 1
          },
          {
            "text": "и људе под ноге наше.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Наследство је за нас одабрао,",
            "poem": 1
          },
          {
            "text": "понос за Јакова кога воли. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Подиже се Бог уз поклик;",
            "poem": 1
          },
          {
            "text": "Господ, уз звук трубе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Певајте славопоје Богу,",
            "poem": 1
          },
          {
            "text": "певајте славопоје;",
            "poem": 2
          },
          {
            "text": "певајте славопоје цару нашем,",
            "poem": 1
          },
          {
            "text": "певајте славопоје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Јер, Бог је цар целе земље;",
            "poem": 1
          },
          {
            "text": "певајте песму поучну.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Бог влада над народима,",
            "poem": 1
          },
          {
            "text": "Бог столује на престолу свом светом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Племићи народа се окупљају,",
            "poem": 1
          },
          {
            "text": "са народом Бога Аврахамовог;",
            "poem": 2
          },
          {
            "text": "Божији су штитови земље",
            "poem": 1
          },
          {
            "text": "и он је преузвишен.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
