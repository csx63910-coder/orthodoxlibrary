    "name": "Псалм",
    "commonName": "Псалм",
    "title": "Псалми",
    "order": 19,
    "numberOfChapters": 150,
    "sha256": "26caf786163c3156cd828b9195dd87c0a9678ee51bdea32fbef70df99683a272",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/PSA/1.json",
    "lastChapterNumber": 150,
    "lastChapterApiLink": "/api/srp_onspc/PSA/150.json",
    "totalNumberOfVerses": 2461
  },
  "chapter": {
    "number": 105,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Хвалите Господа, призивајте му име,",
            "poem": 1
          },
          {
            "text": "објавите његова дела међу народима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Певајте му, славите га песмом,",
            "poem": 1
          },
          {
            "text": "говорите о свим његовим чудесима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Хвалите се светим именом његовим,",
            "poem": 1
          },
          {
            "text": "нек се радују срца оних који траже Господа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Тражите Господа и његову снагу,",
            "poem": 1
          },
          {
            "text": "тражите свагда лице његово.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Памтите чудеса која је учинио,",
            "poem": 1
          },
          {
            "text": "чуда и судове уста његових.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "О, семе Аврахамово, слуго његов,",
            "poem": 1
          },
          {
            "text": "децо Јаковљева, изабраници његови!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Он је Господ, Бог наш,",
            "poem": 1
          },
          {
            "text": "судови су његови по свој земљи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Он се сећа увек његовог савеза,",
            "poem": 1
          },
          {
            "text": "речи што је заповеди за хиљаду нараштаја,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "који је склопио са Аврахамом,",
            "poem": 1
          },
          {
            "text": "и којим се заклео Исаку,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "за уредбу га је поставио Јакову,",
            "poem": 1
          },
          {
            "text": "Израиљу за вечни савез,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "говорећи: „Теби ћу дати земљу хананску,",
            "poem": 1
          },
          {
            "text": "као део вашега наследства.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Док их је још било мало,",
            "poem": 1
          },
          {
            "text": "тек шачица дошљака у земљи,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "лутајући од народа до народа,",
            "poem": 1
          },
          {
            "text": "од једног царства до другог,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "није дао ником да их тлачи,",
            "poem": 1
          },
          {
            "text": "ради њих је кажњавао цареве:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "„Не дирајте моје помазанике,",
            "poem": 1
          },
          {
            "text": "мојим пророцима злобу не чините!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Он је глад призвао на земљу,",
            "poem": 1
          },
          {
            "text": "укинуо свако снабдевање хлебом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Човека је послао пред њима,",
            "poem": 1
          },
          {
            "text": "Јосифа, проданог у робље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ноге су му спутали ланцима,",
            "poem": 1
          },
          {
            "text": "а врат су му оковали гвожђем;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "све до часа кад се испунила реч о њему,",
            "poem": 1
          },
          {
            "text": "реч Господња га је прокушала.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Цар је заповедио да га пусте,",
            "poem": 1
          },
          {
            "text": "владар народа га је ослободио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Поставио га је за господара куће,",
            "poem": 1
          },
          {
            "text": "за управитеља свих својих добара;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "да по својој вољи води му главаре,",
            "poem": 1
          },
          {
            "text": "старешине му мудро саветује.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Тако је Израиљ дошао у Египат;",
            "poem": 1
          },
          {
            "text": "Јаков, дошљак у Хамовој земљи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "И он је веома умножио свој народ,",
            "poem": 1
          },
          {
            "text": "бројнији су били од својих душмана.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Окренуо им је срце да замрзе његов народ,",
            "poem": 1
          },
          {
            "text": "да му се на слуге пакосно окоме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Послао је Мојсија, свог слугу,",
            "poem": 1
          },
          {
            "text": "и Арона, свог изабраника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "И они су пред њима приказали његове знакове",
            "poem": 1
          },
          {
            "text": "и чудеса по Хамовој земљи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Спустио је таму на њу, помрачио је,",
            "poem": 1
          },
          {
            "text": "и они",
            "poem": 2
          },
          {
            "noteId": 10
          },
          {
            "text": "нису били непослушни његовој речи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Воде им је у крв претворио",
            "poem": 1
          },
          {
            "text": "и рибе им поморио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Земља им је врвела од жаба,",
            "poem": 1
          },
          {
            "text": "чак и одаје њихових царева.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Заповедио је, па су обади и комарци",
            "poem": 1
          },
          {
            "text": "навалили на све њихове крајеве.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Град им је као кишу дао",
            "poem": 1
          },
          {
            "text": "и пламене муње по њиховој земљи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Лозе им је и смокве сломио,",
            "poem": 1
          },
          {
            "text": "скршио им стабла по њиховом крају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Заповедио је, па су грунули",
            "poem": 1
          },
          {
            "text": "безбројни скакавци и гусенице.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Обрстили су све биље њихове земље,",
            "poem": 1
          },
          {
            "text": "појели им летину са поља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Побио је све првенце њихове земље,",
            "poem": 1
          },
          {
            "text": "први плод све њихове мужевности.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Извео их је са сребром и златом,",
            "poem": 1
          },
          {
            "text": "међу његовим племенима није било посрнулих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "Египат је одахнуо када су изашли,",
            "poem": 1
          },
          {
            "text": "јер их је од њих спопала страхота.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          {
            "text": "Облак је као заклон разастро",
            "poem": 1
          },
          {
            "text": "и пламен да ноћу светли.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          {
            "text": "Молили су га и он им доведе препелице,",
            "poem": 1
          },
          {
            "text": "хлебом с неба их насити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          {
            "text": "Отворио је стену и воде прокуљаше,",
            "poem": 1
          },
          {
            "text": "потекле су као поток у земљи сувој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          {
            "text": "Јер се сетио свог светог обећања Аврахаму,",
            "poem": 1
          },
          {
            "text": "слузи своме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          {
            "text": "Извео је свој народ у радости,",
            "poem": 1
          },
          {
            "text": "уз клицање своје изабране.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          {
            "text": "Дао им је земље туђинске,",
            "poem": 1
          },
          {
            "text": "запосели су труд народа;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          {
            "text": "да би се држали његових прописа",
            "poem": 1
          },
          {
            "text": "и законе његове слушали.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Славите Господа!",
            "poem": 1
          }
        ]
      }
    ],
