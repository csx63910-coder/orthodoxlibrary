  "chapter": {
    "number": 29,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Псалам Давидов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Дајте славу Господу, синови Божији,",
            "poem": 1
          },
          {
            "text": "дајте Господу славу и силу,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "дајте Господу славу имена његовог,",
            "poem": 1
          },
          {
            "text": "клањајте се Господу у величанству светиње његове.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Глас је Господњи над водама,",
            "poem": 1
          },
          {
            "text": "он то тутњи, он, Бог славе,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "он, Господ, над многим водама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Глас је Господњи силан,",
            "poem": 1
          },
          {
            "text": "глас је Господњи величанствен.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Глас Господњи ломи кедрове,",
            "poem": 1
          },
          {
            "text": "Господ ломи кедрове ливанске.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Од њега поскакују као теле,",
            "poem": 1
          },
          {
            "text": "а Ливан и Сирјон",
            "poem": 2
          },
          {
            "noteId": 4
          },
          {
            "text": "као биволче.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Глас Господњи сипа муње огњене,",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "глас Господњи потреса пустињу,",
            "poem": 1
          },
          {
            "text": "тресе Господ пустињу кадиску.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Од гласа Господњег кошуте се младе,",
            "poem": 1
          },
          {
            "text": "шумама он скида кору са стабала,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а у Дому његовом сви говоре „Слава!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Господ столује над потопом,",
            "poem": 1
          },
          {
            "text": "Господ столује као Цар довека.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Господ даје силу свом народу,",
            "poem": 1
          },
          {
            "text": "Господ миром благосиља свој народ.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 4,
        "caller": "+",
        "text": "29,6 Друго име горе Ермон, види 5. Мој 3,9.",
        "reference": {
          "chapter": 29,
          "verse": 6
        }
      }
    ]
