  "chapter": {
    "number": 126,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Песма поклоничка."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Кад је Господ прогнанике на Сион враћао,",
            "poem": 1
          },
          {
            "text": "било нам је као да сањамо!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Уста су нам праскала од смеха,",
            "poem": 1
          },
          {
            "text": "језик нам је клицао",
            "poem": 2
          },
          {
            "text": "када се међу народима причало:",
            "poem": 1
          },
          {
            "text": "„Њима је Господ велико дело учинио!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Господ нам је велико дело учинио",
            "poem": 1
          },
          {
            "text": "и како смо само раздрагани били!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "О, Господе, срећу нашу ти поврати",
            "poem": 1
          },
          {
            "text": "ко брзаке на испуцалу земљу!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Они који са сузама сеју,",
            "poem": 1
          },
          {
            "text": "жању са клицањем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Плачући иде човек",
            "poem": 1
          },
          {
            "text": "и зобницу са семеном носи,",
            "poem": 2
          },
          {
            "text": "али ће се вратити сигурно,",
            "poem": 1
          },
          {
            "text": "и клицаће, своје снопље",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "док буде носио!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
