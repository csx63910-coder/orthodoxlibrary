  },
  "chapter": {
    "number": 37,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Давидов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Не жести се због злотвора,",
            "poem": 1
          },
          {
            "text": "не завиди оним што неправду чине.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Јер ће попут траве брзо да увену,",
            "poem": 1
          },
          {
            "text": "ко зелено биље осушиће се.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "У Господа се уздај и чини добро,",
            "poem": 1
          },
          {
            "text": "пребивај на земљи и верношћу напасај се.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Радуј се у Господу",
            "poem": 1
          },
          {
            "text": "и даће ти по жељама срца твога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Господу препусти пут свој,",
            "poem": 1
          },
          {
            "text": "поуздај се у њега и он ће учинити:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "праведност ће твоју попут светла да изведе,",
            "poem": 1
          },
          {
            "text": "и правду твоју попут поднева.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Умири се пред Господом,",
            "poem": 1
          },
          {
            "text": "ишчекуј га са стрпљењем;",
            "poem": 2
          },
          {
            "text": "не жести се на онога што му добро иде на његовом путу,",
            "poem": 1
          },
          {
            "text": "на човека који сплиће сплетке.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Од јарости суздржи се",
            "poem": 1
          },
          {
            "text": "и гнева се окани;",
            "poem": 2
          },
          {
            "text": "не жести се,",
            "poem": 1
          },
          {
            "text": "то само зло доноси.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Јер, зликовце ће истребити,",
            "poem": 1
          },
          {
            "text": "а земљу ће наследити они што Господа очекују.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Још само мало,",
            "poem": 1
          },
          {
            "text": "и зликовца више неће бити;",
            "poem": 2
          },
          {
            "text": "помно ћеш да гледаш по његовом месту,",
            "poem": 1
          },
          {
            "text": "а њега неће бити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Понизни ће наследити земљу,",
            "poem": 1
          },
          {
            "text": "радоваће се због обиља мира.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Зликовац сплеткари против праведника,",
            "poem": 1
          },
          {
            "text": "и зубима својим шкргуће на њега.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "А Господ му се смеје,",
            "poem": 1
          },
          {
            "text": "јер види да дан његов стиже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Зликовци су мач исукали,",
            "poem": 1
          },
          {
            "text": "лук су свој натегнули;",
            "poem": 2
          },
          {
            "text": "да оборе сиромаха и убогог,",
            "poem": 1
          },
          {
            "text": "да закољу људе праведних путева.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Срце ће им мач пробости,",
            "poem": 1
          },
          {
            "text": "њихов лук ће бити сломљен.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Боље је и мало праведниково",
            "poem": 1
          },
          {
            "text": "него благо зликоваца многих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Јер, снага ће зликоваца бити поломљена,",
            "poem": 1
          },
          {
            "text": "а праведне Господ потпомаже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Господу су знани дани беспрекорних,",
            "poem": 1
          },
          {
            "text": "наследство њихово остаје довека.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "У времену лошем неће се стидети,",
            "poem": 1
          },
          {
            "text": "и сити ће бити у данима глади.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "А зликовци ће пропасти;",
            "poem": 1
          },
          {
            "text": "душмани Господњи биће као пашњаци најбољи –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "окончаће, у диму ће окончати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Зликовац позајмљује и не враћа,",
            "poem": 1
          },
          {
            "text": "а праведник је дарежљив и даје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Јер, они које он благослови,",
            "poem": 1
          },
          {
            "text": "наследиће земљу;",
            "poem": 2
          },
          {
            "text": "а које он прокуне,",
            "poem": 1
          },
          {
            "text": "биће истребљени.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Од Господа су човекови кораци,",
            "poem": 1
          },
          {
            "text": "и на путу његовом он ужива.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Па ако и падне, он одбачен неће бити,",
            "poem": 1
          },
          {
            "text": "јер му Господ руку држи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Био сам млад, сада сам стар,",
            "poem": 1
          },
          {
            "text": "и нисам видео праведника напуштеног,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ни његове потомке да просјаче хлеба.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Дарежљив је поваздан, позајмљује,",
            "poem": 1
          },
          {
            "text": "потомство му је блажено.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Од зла се одврати, чини добро",
            "poem": 1
          },
          {
            "text": "и живећеш довека.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Јер Господ воли правду и своје верне неће напустити,",
            "poem": 1
          },
          {
            "text": "довека ће бити сачувани;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а потомци зликоваца биће истребљени.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Праведни ће земљу да наследе,",
            "poem": 1
          },
          {
            "text": "пребиваће на њој трајно.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Мудрост зборе уста праведнога",
            "poem": 1
          },
          {
            "text": "и језик му објављује правду.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "У срцу му је Закон Бога његовога,",
            "poem": 1
          },
          {
            "text": "кораци му се не клизају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Зликовац праведника вреба",
            "poem": 1
          },
          {
            "text": "и настоји да га убије.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Али његовој га руци Господ препустити неће;",
            "poem": 1
          },
          {
            "text": "када му се суди, осудити га неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Чекај на Господа,",
            "poem": 1
          },
          {
            "text": "пута се његовога држи;",
            "poem": 2
          },
          {
            "text": "да те узвиси, да наследиш земљу",
            "poem": 1
          },
          {
            "text": "и гледаш када се зликовци буду истребили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Видео сам зликовца бездушног,",
            "poem": 1
          },
          {
            "text": "грана се као домаће стабло зелено.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Али прошао је; погледао сам,",
            "poem": 1
          },
          {
            "text": "а њега нема;",
            "poem": 2
          },
          {
            "text": "потражио сам га,",
            "poem": 1
          },
          {
            "text": "и нисам га пронашао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Посматрај онога без мане, гледај у честитога;",
            "poem": 1
          },
          {
            "text": "јер будућност припада миротворцу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "Сви ће преступници бити разорени,",
            "poem": 1
          },
          {
            "text": "истребљење је будућност зликоваца.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          {
            "text": "Од Господа је спасење праведних,",
            "poem": 1
          },
          {
            "text": "у време невоље он им је тврђава.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          {
            "text": "Господ им помаже,",
            "poem": 1
          },
          {
            "text": "он их избавља;",
            "poem": 2
          },
          {
            "text": "од зликоваца избавља их,",
            "poem": 1
          },
          {
            "text": "спасава их јер у њему уточиште траже.",
            "poem": 2
          }
        ]
      }
    ],
