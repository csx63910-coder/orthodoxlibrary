  "chapter": {
    "number": 22,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи, по напеву кошута у зори. Давидов псалам."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Боже мој, Боже мој, зашто си ме оставио?!",
            "poem": 1
          },
          {
            "text": "Далеко си од мога спасења,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и од речи вапаја мојега.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Боже мој, вапим дању, а ти не одговараш;",
            "poem": 1
          },
          {
            "text": "ноћу, али нема ми одмора.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "А ти си онај Свети,",
            "poem": 1
          },
          {
            "text": "престо ти је на хвалама Израиљевим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "У тебе су се наши преци уздали,",
            "poem": 1
          },
          {
            "text": "уздали се и ти их избави.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Теби су вапили и избављени били,",
            "poem": 1
          },
          {
            "text": "у тебе се уздали и нису се осрамотили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "А ја сам црв, а не човек,",
            "poem": 1
          },
          {
            "text": "ругло људима, презир народа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ко год ме види, тај ми се руга,",
            "poem": 1
          },
          {
            "text": "цере ми се и машу главама:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "„У Господа се уздао, нека га он избави,",
            "poem": 1
          },
          {
            "text": "кад у њему радост налази.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Јер ти си ме извукао из утробе мајчине,",
            "poem": 1
          },
          {
            "text": "на грудима мајке дао ми починак.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Теби сам предан од мајчина крила,",
            "poem": 1
          },
          {
            "text": "од утробе мајчине ти си Бог мој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Не удаљуј се од мене,",
            "poem": 1
          },
          {
            "text": "јер невоља је близу,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а помоћника нема.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Окружише ме многи бикови,",
            "poem": 1
          },
          {
            "text": "бикови ме васански опколише.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "На мене су чељуст раширили,",
            "poem": 1
          },
          {
            "text": "као лав што раздире и риче.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Попут воде живот ми истиче,",
            "poem": 1
          },
          {
            "text": "све су ми се кости разглавиле,",
            "poem": 2
          },
          {
            "text": "срце ми је ко восак постало,",
            "poem": 1
          },
          {
            "text": "и топи се у мојим грудима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Снага ми се као цреп сасуши,",
            "poem": 1
          },
          {
            "text": "језик ми је уз непце прионуо;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "у смртни си ме прах ставио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Јер пси су ме, ево, опколили,",
            "poem": 1
          },
          {
            "text": "окружила ме чета зликоваца,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "руке су ми и ноге пробили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Све кости своје избројати могу,",
            "poem": 1
          },
          {
            "text": "а они ме гледају и зуре у мене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Моје хаљине деле међу собом,",
            "poem": 1
          },
          {
            "text": "коцку бацају за моју одећу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Не удаљуј се од мене, Господе,",
            "poem": 1
          },
          {
            "text": "снаго моја, пожури ми у помоћ,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "душу моју избави од мача,",
            "poem": 1
          },
          {
            "text": "и мој живот од канџи паса.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Избави ме од лавље чељусти,",
            "poem": 1
          },
          {
            "text": "и од рогова биволових!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "А ја ћу причати о твом имену браћи својој,",
            "poem": 1
          },
          {
            "text": "хвалићу те усред збора.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Хвалите Господа, ви што га се бојите,",
            "poem": 1
          },
          {
            "text": "славите га, све семе Јаковљево,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "сав род Израиљев, нек од њега стрепи!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Јер патњу угњетеног није презрео,",
            "poem": 1
          },
          {
            "text": "нити му је постала одвратна,",
            "poem": 2
          },
          {
            "text": "није своје лице сакрио од њега,",
            "poem": 1
          },
          {
            "text": "него му је вапај услишио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "О теби ћу певати на великом збору,",
            "poem": 1
          },
          {
            "text": "испунићу завете своје пред онима који га се боје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Понизни ће јести и бити сити,",
            "poem": 1
          },
          {
            "text": "хвалиће Господа који га траже.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Нека срца ваша живе довека!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Сетиће се и вратити Господу,",
            "poem": 1
          },
          {
            "text": "сви крајеви земаљски,",
            "poem": 2
          },
          {
            "text": "пашће ничице пред тобом",
            "poem": 1
          },
          {
            "text": "сва племена народа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Јер Господње је Царство,",
            "poem": 1
          },
          {
            "text": "он влада над народима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Њему ће се клањати сви богати",
            "poem": 1
          },
          {
            "text": "и сити на земљи,",
            "poem": 2
          },
          {
            "text": "пред њим ће клекнути сви који у прах силазе,",
            "poem": 1
          },
          {
            "text": "којима се живот угасио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Потомство њему ће служити,",
            "poem": 1
          },
          {
            "text": "причаће о Господу будућем нараштају,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "доћи ће и објавити праведност његову",
            "poem": 1
          },
          {
            "text": "народу који се још није родио,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да је он то учинио.",
            "poem": 2
          }
        ]
      }
    ],
