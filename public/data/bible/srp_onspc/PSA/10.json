  "book": {
    "id": "PSA",
    "translationId": "srp_onspc",
    "name": "Псалм",
    "commonName": "Псалм",
    "title": "Псалми",
    "order": 19,
    "numberOfChapters": 150,
    "sha256": "26caf786163c3156cd828b9195dd87c0a9678ee51bdea32fbef70df99683a272",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/PSA/1.json",
    "lastChapterNumber": 150,
    "lastChapterApiLink": "/api/srp_onspc/PSA/150.json",
    "totalNumberOfVerses": 2461
  },
  "chapter": {
    "number": 10,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Зашто, Господе, стојиш далеко?",
            "poem": 1
          },
          {
            "text": "Што се скриваш у време невоље?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Опаки, надмени, љуто гони убогог,",
            "poem": 1
          },
          {
            "text": "у сплетке га хвата које је исплео.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Јер опаки се хвали жудњама свог срца,",
            "poem": 1
          },
          {
            "text": "похлепни проклиње, презире Господа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "У својој га охолости он не тражи,",
            "poem": 1
          },
          {
            "text": "нема Бога ни у једној мисли својој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Тај увек успева на својим стазама,",
            "poem": 1
          },
          {
            "text": "на судове твоје он с висока гледа,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и својим се душманима руга.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Он у срцу каже:",
            "poem": 1
          },
          {
            "text": "„Ништа мене неће уздрмати,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "зло ме никад задесити неће.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Уста су му пуна клетве, лажи и увреде,",
            "poem": 1
          },
          {
            "text": "а мука и невоља под језиком његовим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "У дворишту вреба из заседе,",
            "poem": 1
          },
          {
            "text": "из потаје убија невинога,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "из скровишта мотри немоћнога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Као лав он вреба у шипражју,",
            "poem": 1
          },
          {
            "text": "у заседи чека да улови убогога;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "у своју га мрежу хвата и одвлачи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Беспомоћне ломи и обара,",
            "poem": 1
          },
          {
            "text": "они му у канџе допадају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Он говори у срцу:",
            "poem": 1
          },
          {
            "text": "„Бог заборавља, скрива лице,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "никада он то неће видети.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Устани, Господе,",
            "poem": 1
          },
          {
            "text": "дигни своју руку, Боже,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "понизне немој заборавити!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Зашто опаки да презире Бога,",
            "poem": 1
          },
          {
            "text": "зашто да у свом срцу каже:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Ти ме нећеш за то питати“?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Али, ти то ипак видиш,",
            "poem": 1
          },
          {
            "text": "јер посматраш муку и невољу,",
            "poem": 2
          },
          {
            "text": "да ствар узмеш у своје руке.",
            "poem": 1
          },
          {
            "text": "Немоћни се ослања на тебе,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "сиротоме ти си помоћник.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Сломи руку опакоме, зломе,",
            "poem": 1
          },
          {
            "text": "па кад тражиш његову опакост,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ни трага од ње да не нађеш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Господ је цар у веке векова,",
            "poem": 1
          },
          {
            "text": "нестаће народи са његове земље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ти, Господе, чујеш чежњу понизних,",
            "poem": 1
          },
          {
            "text": "храбриш их, ухо своје приклањаш,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "да даш право сиротоме и угњетеном,",
            "poem": 1
          },
          {
            "text": "да човек на земљи не задаје више страх.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
