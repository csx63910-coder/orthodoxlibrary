  "book": {
    "id": "PSA",
    "translationId": "srp_onspc",
    "name": "Псалм",
    "commonName": "Псалм",
    "title": "Псалми",
    "order": 19,
    "numberOfChapters": 150,
    "sha256": "26caf786163c3156cd828b9195dd87c0a9678ee51bdea32fbef70df99683a272",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/PSA/1.json",
    "lastChapterNumber": 150,
    "lastChapterApiLink": "/api/srp_onspc/PSA/150.json",
    "totalNumberOfVerses": 2461
  },
  "chapter": {
    "number": 116,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ја волим Господа, јер је чуо мој глас",
            "poem": 1
          },
          {
            "text": "и преклињања моја;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "пригнуо је ухо своје к мени",
            "poem": 1
          },
          {
            "text": "и докле живим ја ћу да му вапим!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Смртна су се ужад сплела око мене",
            "poem": 1
          },
          {
            "text": "и замка Света мртвих спопала ме;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "снађоше ме и мука и чемер.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Али име сам Господње звао:",
            "poem": 1
          },
          {
            "text": "„О, Господе, преклињем те,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "избави ми душу!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Милостив је и праведан Господ,",
            "poem": 1
          },
          {
            "text": "наш је Бог милосрдан!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Господ брани простодушне,",
            "poem": 1
          },
          {
            "text": "јер када сам био лаковеран, он ме је спасао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ти се опет смири, душо моја,",
            "poem": 1
          },
          {
            "text": "јер ти Господ обилно узврати!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Да, ти си душу моју од смрти спасао,",
            "poem": 1
          },
          {
            "text": "око моје од плакања,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ногу моју од спотицања.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "У земљи живих",
            "poem": 1
          },
          {
            "text": "пред Господом ја ћу ићи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Поверовао сам, макар и говорим:",
            "poem": 1
          },
          {
            "text": "„Ојађен сам јако!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "А рекао сам брзоплето:",
            "poem": 1
          },
          {
            "text": "„Сваки човек је лажљивац!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Чиме Господу да узвратим",
            "poem": 1
          },
          {
            "text": "за све његово добро према мени?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Чашу ћу спасења да подигнем,",
            "poem": 1
          },
          {
            "text": "Господње ћу име да призовем!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Завете своје извршићу Господу",
            "poem": 1
          },
          {
            "text": "пред целим његовим народом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Скупоцена је у очима Господњим",
            "poem": 1
          },
          {
            "text": "смрт његових верних.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "О, Господе, ја сам слуга твој!",
            "poem": 1
          },
          {
            "text": "Твој сам слуга, син твоје слушкиње,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "са мене си расково окове!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Принећу ти жртву захвалницу",
            "poem": 1
          },
          {
            "text": "и призваћу ја име Господње!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Завете своје извршићу Господу",
            "poem": 1
          },
          {
            "text": "пред целим његовим народом;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "у двориштима Дома Господњег,",
            "poem": 1
          },
          {
            "text": "усред тебе, о, Јерусалиме.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Славите Господа!",
            "poem": 1
          }
        ]
      }
    ],
