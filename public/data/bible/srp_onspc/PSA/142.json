  "chapter": {
    "number": 142,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Давидова поучна песма, кад је био у пећини. Молитва."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Гласом својим ја Господу вапим,",
            "poem": 1
          },
          {
            "text": "гласом својим ја Господа за милост преклињем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Жалопојку своју пред њега изливам,",
            "poem": 1
          },
          {
            "text": "муку своју њему образлажем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Када дух ми на измаку беше,",
            "poem": 1
          },
          {
            "text": "ти си знао стазу моју;",
            "poem": 2
          },
          {
            "text": "пут којим сам ишао,",
            "poem": 1
          },
          {
            "text": "на коме су ми замку поставили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Удесно погледај па види",
            "poem": 1
          },
          {
            "text": "да нико на ме не обраћа пажњу;",
            "poem": 2
          },
          {
            "text": "мени више уточишта нема,",
            "poem": 1
          },
          {
            "text": "нема никог да за мене мари.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "О, Господе, теби вапим! Говорим ти:",
            "poem": 1
          },
          {
            "text": "„Уточиште моје ти си",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и наследство моје у земљи живих!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Јецај мој пажљиво почуј,",
            "poem": 1
          },
          {
            "text": "јер сам јадан преко сваке мере;",
            "poem": 2
          },
          {
            "text": "од тлачитеља ме ослободи,",
            "poem": 1
          },
          {
            "text": "јер за мене су прејаки.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Душу моју из тамнице вади",
            "poem": 1
          },
          {
            "text": "па да хвалим име твоје;",
            "poem": 2
          },
          {
            "text": "па нека ме окруже праведни,",
            "poem": 1
          },
          {
            "text": "јер си мени благонаклон био!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
