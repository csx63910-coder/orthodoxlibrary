  "chapter": {
    "number": 93,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Господ влада величанством заодевен!",
            "poem": 1
          },
          {
            "text": "Загрнут је и опасан Господ снагом;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а свет је утврђен, непомичан.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Утврђен је од давнина престо твој,",
            "poem": 1
          },
          {
            "text": "а и ти си од искона.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Реке дижу, о, Господе,",
            "poem": 1
          },
          {
            "text": "реке дижу своју хуку;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "реке дижу своју буку.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "И од хуке вода многих,",
            "poem": 1
          },
          {
            "text": "и од силних таласа морских,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "силнији је Господ узвишени.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Прописи су твоји чврсти, поуздани;",
            "poem": 1
          },
          {
            "text": "Доликује светост твоме Дому, Господе,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "кроз дане многе.",
            "poem": 2
          }
        ]
      }
    ],
