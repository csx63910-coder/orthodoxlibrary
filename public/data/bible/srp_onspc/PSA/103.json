  "chapter": {
    "number": 103,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Давидов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Благосиљај, душо моја, Господа",
            "poem": 1
          },
          {
            "text": "и име му свето све што је у мени!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Благосиљај, душо моја, Господа,",
            "poem": 1
          },
          {
            "text": "не заборави сва доброчинства његова!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Он ти кривице све твоје опрашта",
            "poem": 1
          },
          {
            "text": "и лечи ти све болести твоје;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "од пропасти спасава ти живот,",
            "poem": 1
          },
          {
            "text": "овенчава милошћу и милосрђем;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "живот ти добротом храни,",
            "poem": 1
          },
          {
            "text": "младост ти је свежа ко у орла.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Господ чини оно што је право,",
            "poem": 1
          },
          {
            "text": "пресуђује у корист тлачених.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Путеве је своје открио Мојсију,",
            "poem": 1
          },
          {
            "text": "дела своја деци Израиља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Милостив и милосрдан је Господ,",
            "poem": 1
          },
          {
            "text": "дуготрпљив, богат милосрђем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Не тужи нас без престанка,",
            "poem": 1
          },
          {
            "text": "довека се он не гневи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "По гресима нашим он нам не узвраћа,",
            "poem": 1
          },
          {
            "text": "не плаћа нам према кривицама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Јер колико је небо над земљом високо,",
            "poem": 1
          },
          {
            "text": "толика је над богобојазнима милост његова.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Колико је исток од запада далеко,",
            "poem": 1
          },
          {
            "text": "толико је преступе наше од нас удаљио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Као кад се отац на децу сажали,",
            "poem": 1
          },
          {
            "text": "сажали се Господ богобојазнима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Јер он зна како смо грађени",
            "poem": 1
          },
          {
            "text": "и сећа се да смо тек прашина.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Попут траве човекови су дани,",
            "poem": 1
          },
          {
            "text": "попут цвета на ливади што цвета;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "ветар задува и већ је нестао,",
            "poem": 1
          },
          {
            "text": "више га се и не сећа место где је био.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "А милост је Господња одувек",
            "poem": 1
          },
          {
            "text": "и заувек на богобојазнима",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и праведност његова на њиховим потомцима;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "на онима који држе његов савез,",
            "poem": 1
          },
          {
            "text": "који памте његове прописе и извршавају их.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Господ је на небесима поставио свој престо",
            "poem": 1
          },
          {
            "text": "и над свим царством својим влада.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Благосиљајте Господа, анђели његови,",
            "poem": 1
          },
          {
            "text": "јаки и снажни,",
            "poem": 2
          },
          {
            "text": "који чините по његовој речи",
            "poem": 1
          },
          {
            "text": "и слушате његове наредбе!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Благосиљајте Господа, све војске његове,",
            "poem": 1
          },
          {
            "text": "слуге његове, што чините како му је драго!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Благосиљате Господа, сва дела његова,",
            "poem": 1
          },
          {
            "text": "где год да је место у коме он влада!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Благосиљај, душо моја, Господа!",
            "poem": 1
          }
        ]
      }
    ],
