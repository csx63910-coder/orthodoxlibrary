  "chapter": {
    "number": 137,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Седели смо тамо, поред река Вавилона",
            "poem": 1
          },
          {
            "text": "и плакали кад би се сетили Сиона.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "О тамошње смо врбе",
            "poem": 1
          },
          {
            "text": "повешали харфе своје,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "јер су наши тлачитељи од нас захтевали песму;",
            "poem": 1
          },
          {
            "text": "мучитељи наши да се веселимо:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Певајте нам песму о Сиону!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Како да певамо Господњу песму",
            "poem": 1
          },
          {
            "text": "у туђинској земљи?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "О, Јерусалиме, ако бих тебе заборавио,",
            "poem": 1
          },
          {
            "text": "заборављена била и десница моја!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Језик ми се за непце слепио",
            "poem": 1
          },
          {
            "text": "ако те се не сетио,",
            "poem": 2
          },
          {
            "text": "ако се не радовао Јерусалиму",
            "poem": 1
          },
          {
            "text": "више него и најбољем своме!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "О, Господе, сети се Едомаца",
            "poem": 1
          },
          {
            "text": "што су на дан пада Јерусалима говорили:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Разваљујте! Разваљујте га до темеља!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "О, ћерко вавилонска,",
            "poem": 1
          },
          {
            "text": "што ћеш бити разорена!",
            "poem": 2
          },
          {
            "text": "Благо оном који ти узврати истом мером,",
            "poem": 1
          },
          {
            "text": "онако како си чинила нама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Благо оном ко ти нејач зграби",
            "poem": 1
          },
          {
            "text": "и о стену смрска!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
