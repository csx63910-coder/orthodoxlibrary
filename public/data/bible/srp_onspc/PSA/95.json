  "chapter": {
    "number": 95,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Дођите! Кличимо Господу!",
            "poem": 1
          },
          {
            "text": "Ускликнимо Стени нашега спасења!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Дођимо пред њега с похвалама,",
            "poem": 1
          },
          {
            "text": "у песмама кличимо му!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Јер Господ је велик Бог,",
            "poem": 1
          },
          {
            "text": "цар је велик над свим боговима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "У његовој су руци дубине земаљске,",
            "poem": 1
          },
          {
            "text": "његови су врхови планина.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Његово је море, он га је створио;",
            "poem": 1
          },
          {
            "text": "руке су му копно начиниле.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Дођите да ничице попадамо!",
            "poem": 1
          },
          {
            "text": "Хајде да се поклонимо и клекнемо",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "пред Господом, Саздатељем нашим!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Јер он је наш Бог,",
            "poem": 1
          },
          {
            "text": "а ми народ његове испаше,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "стадо које води.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Данас кад глас његов чујете:",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "„Тврда срца не будите као на Мериви,",
            "poem": 1
          },
          {
            "text": "у пустињи у дан Масе",
            "poem": 2
          },
          {
            "noteId": 8
          },
          {
            "text": ".",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Оци ваши мене су кушали,",
            "poem": 1
          },
          {
            "text": "изазивали ме, иако су дела моја гледали.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Четрдесет лета сам се гнушао оног нараштаја и рекох:",
            "poem": 1
          },
          {
            "text": "’Верности нема у њима никакве,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "путеве моје они не познају.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "У гневу сам се тада заклео:",
            "poem": 1
          },
          {
            "text": "’Неће они ући у мој починак.’“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 8,
        "caller": "+",
        "text": "95,8 Према 2. Мој 17,7Маса и Мерива су места чија имена, свађа и искушавање имају сликовито значење.",
        "reference": {
          "chapter": 95,
          "verse": 8
        }
      }
    ]
  },
