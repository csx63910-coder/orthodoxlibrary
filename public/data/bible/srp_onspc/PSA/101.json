  "chapter": {
    "number": 101,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Давидов Псалам."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "О милости и о правди певам!",
            "poem": 1
          },
          {
            "text": "Ја теби, Господе, певам похвале.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Предаћу се путу беспрекорном!",
            "poem": 1
          },
          {
            "text": "Када ћеш ми доћи?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "У честитости срца свога",
            "poem": 1
          },
          {
            "text": "живећу у свом дому.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ствари гнусне",
            "poem": 1
          },
          {
            "text": "не стављам пред очи своје;",
            "poem": 2
          },
          {
            "text": "отпадничке ствари мрзим,",
            "poem": 1
          },
          {
            "text": "на њих не пристајем!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ништа немам с подлацима",
            "poem": 1
          },
          {
            "text": "и за зло нећу да знам.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ко свог ближњег иза леђа оцрњује,",
            "poem": 1
          },
          {
            "text": "ја тога сатирем;",
            "poem": 2
          },
          {
            "text": "ко је пркосног погледа и надменог срца,",
            "poem": 1
          },
          {
            "text": "ја тога не трпим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Моје су очи на вернима у земљи",
            "poem": 1
          },
          {
            "text": "да би са мном боравили;",
            "poem": 2
          },
          {
            "text": "нек ми служи онај",
            "poem": 1
          },
          {
            "text": "који иде путем беспрекорним.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "У мом дому места",
            "poem": 1
          },
          {
            "text": "нема за препредењака,",
            "poem": 2
          },
          {
            "text": "пред очима мојим лажов",
            "poem": 1
          },
          {
            "text": "потрајати неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Из јутра у јутро сатирем",
            "poem": 1
          },
          {
            "text": "све неверне из земље,",
            "poem": 2
          },
          {
            "text": "све злотворе истребљујем",
            "poem": 1
          },
          {
            "text": "из Господњег града.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
