  "chapter": {
    "number": 51,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. Давидов Псалам, када му је, након посете Витсавеји, дошао пророк Натан."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "По милости својој, Боже,",
            "poem": 1
          },
          {
            "text": "смилуј ми се;",
            "poem": 2
          },
          {
            "text": "по големом милосрђу своме,",
            "poem": 1
          },
          {
            "text": "обриши ми преступе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Од кривице моје опери ме сасвим",
            "poem": 1
          },
          {
            "text": "и од греха мога очисти ме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Преступа сам својих свестан,",
            "poem": 1
          },
          {
            "text": "преда мном је грех мој непрестано.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Теби, теби самом згрешио сам;",
            "poem": 1
          },
          {
            "text": "у очима твојим зло сам учинио.",
            "poem": 2
          },
          {
            "text": "Зато си праведан када проговориш,",
            "poem": 1
          },
          {
            "text": "и чист када судиш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Гле, у кривици сам се и родио",
            "poem": 1
          },
          {
            "text": "и у греху зачела ме моја мајка.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Гле, мила ти је истина у срцу;",
            "poem": 1
          },
          {
            "text": "у нутрини учиш ме мудрости.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Очисти ме изопом да чист будем;",
            "poem": 1
          },
          {
            "text": "опери ме да од снега бељи будем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Весеље и радост ми дај да слушам;",
            "poem": 1
          },
          {
            "text": "нек се обрадују кости које си смрскао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Сакриј лице своје од греха мојих,",
            "poem": 1
          },
          {
            "text": "све кривице моје ти очисти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Чисто срце створи мени, Боже;",
            "poem": 1
          },
          {
            "text": "у нутрини мојој постојан дух обнови.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Од себе ме не одбацуј",
            "poem": 1
          },
          {
            "text": "и од мене не узимај свога Духа Светог.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Радост свог спасења обнови у мени,",
            "poem": 1
          },
          {
            "text": "и духом вољним ти мене ободри.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Твојим путевима научићу преступнике",
            "poem": 1
          },
          {
            "text": "и грешници теби ће се вратити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Од крвопролића ме ослободи,",
            "poem": 1
          },
          {
            "text": "Боже, Боже Спаситељу мој;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и клицаће мој језик о праведности твојој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Господе, усне ми отвори;",
            "poem": 1
          },
          {
            "text": "и уста ће моја славу твоју да јављају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Јер ти жртву не желиш, јер ја бих је принео;",
            "poem": 1
          },
          {
            "text": "не мили ти се свеспалница.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Богу је жртва дух потрешен;",
            "poem": 1
          },
          {
            "text": "потрешено и скрхано срце ти не презри, Боже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Наклоношћу својом чини добро Сиону;",
            "poem": 1
          },
          {
            "text": "сазидај зидине Јерусалиму.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Тада ћеш се зажелети праведних жртава,",
            "poem": 1
          },
          {
            "text": "свеспалнице и паљених жртава;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "тада ће ти на жртвенику принети бикове.",
            "poem": 2
          }
        ]
      }
    ],
