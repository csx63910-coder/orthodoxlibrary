  "chapter": {
    "number": 41,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "За хоровођу. Псалам Давидов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Благо оном који мисли на сиромаха,",
            "poem": 1
          },
          {
            "text": "Господ га избавља у дан невоље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Господ га чува и држи у животу,",
            "poem": 1
          },
          {
            "text": "он ће га благословити у земљи,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "неће га изручити жељи душмана његових.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Господ ће га крепити на постељи боли;",
            "poem": 1
          },
          {
            "text": "ти ћеш га од болести опоравити на лежају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Рекох: „Господе, смилуј ми се,",
            "poem": 1
          },
          {
            "text": "исцели ми душу, јер сам ти згрешио.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Непријатељи злурадо говоре о мени:",
            "poem": 1
          },
          {
            "text": "„Када ће умрети? Када ће му се име затрти?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Кад ми ко у посету дође, говори којешта,",
            "poem": 1
          },
          {
            "text": "а у срцу скупља пакост;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "кад изађе онда јавно каже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Заједно против мене шапућу сви што ме мрзе,",
            "poem": 1
          },
          {
            "text": "несрећу ми предвиђају:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "„Кобна га је болест ударила;",
            "poem": 1
          },
          {
            "text": "легао је и дићи се више неће.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Па и ближњи мој коме сам веровао,",
            "poem": 1
          },
          {
            "text": "онај који са мном једе, окрену се против мене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "А ти, Господе, смилуј ми се,",
            "poem": 1
          },
          {
            "text": "подигни ме, да им вратим мило за драго.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "По овоме знам да сам ти угодан,",
            "poem": 1
          },
          {
            "text": "јер мој непријатељ не ликује нада мном.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "У моме ме поштењу подржи,",
            "poem": 1
          },
          {
            "text": "пред своје ме лице постави довека.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Благословен да је Господ, Бог Израиљев,",
            "poem": 1
          },
          {
            "text": "од века и до века. Амин. Амин.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
