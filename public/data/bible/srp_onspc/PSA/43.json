  "chapter": {
    "number": 43,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Досуди ми правду, Боже,",
            "poem": 1
          },
          {
            "text": "одбрани мој спор од безбожног света,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "избави ме од човека подлог и неправедног.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Јер ти си Бог мој, тврђава моја.",
            "poem": 1
          },
          {
            "text": "Зашто си ме одбацио?",
            "poem": 2
          },
          {
            "text": "Зашто идем около у жалости",
            "poem": 1
          },
          {
            "text": "под тлаком непријатеља мога?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Пошаљи светлост и истину твоју да ме воде,",
            "poem": 1
          },
          {
            "text": "да ме доведу на свету гору твоју,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и до места где ти пребиваш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Приступићу тада к жртвенику Божијем,",
            "poem": 1
          },
          {
            "text": "к Богу радости и ужитка свог;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да те харфом хвалим, Боже, Боже мој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Зашто си ми клонула, душо моја,",
            "poem": 1
          },
          {
            "text": "зашто уздишеш у мени?",
            "poem": 2
          },
          {
            "text": "Богу се надај, јер опет ћу га славити,",
            "poem": 1
          },
          {
            "text": "Спаситеља и Бога свог.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
