  },
  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Зашто ли се буне народи,",
            "poem": 1
          },
          {
            "text": "шта то људи узалуд смишљају?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Цареви се света прикупљају,",
            "poem": 1
          },
          {
            "text": "кнезови се с њима саветују,",
            "poem": 2
          },
          {
            "text": "да навале сложно на Господа",
            "poem": 1
          },
          {
            "text": "и на његовог Помазаника",
            "poem": 2
          },
          {
            "noteId": 0
          },
          {
            "text": ":",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "„Збацимо са себе окове њихове,",
            "poem": 1
          },
          {
            "text": "стргнимо са себе свезе њихове!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Смеје се онај што на небесима столује,",
            "poem": 1
          },
          {
            "text": "Господ се то њима подругује.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Он им онда у гневу проговара,",
            "poem": 1
          },
          {
            "text": "јарошћу их својом ужасава:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "„Цара свога ја сам поставио,",
            "poem": 1
          },
          {
            "text": "на Сиону, светој гори својој.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Објавићу одлуку Господњу.",
            "poem": 1
          },
          {
            "text": "Он ми рече:",
            "poem": 2
          },
          {
            "text": "„Ти си Син мој,",
            "poem": 1
          },
          {
            "text": "данас си се мени родио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Тражи од мене, и даћу ти у наследство пуке,",
            "poem": 1
          },
          {
            "text": "и крајеве земаљске да ти буду имовина.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Сломићеш их гвозденом палицом,",
            "poem": 1
          },
          {
            "text": "разбићеш их као посуду од глине.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Зато, цареви, будите разумни,",
            "poem": 1
          },
          {
            "text": "примите наук, владари земаљски!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Служите Господу у страху,",
            "poem": 1
          },
          {
            "text": "с трепетом се радујте.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Волите Сина, да му гнев не плане,",
            "poem": 1
          },
          {
            "text": "па да пропаднете на свом путу,",
            "poem": 2
          },
          {
            "text": "јер гнев његов за трен ока плане.",
            "poem": 1
          },
          {
            "text": "Благо сваком ко у њему уточиште тражи!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 0,
        "caller": "+",
        "text": "2,2 Превод грчке именице Христос, према Дал 4,26, где је овај део Псалма наведен.",
        "reference": {
          "chapter": 2,
          "verse": 2
        }
      }
    ]
