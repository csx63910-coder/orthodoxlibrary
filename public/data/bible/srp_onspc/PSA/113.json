  "chapter": {
    "number": 113,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Славите Господа!",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "О, славите, слуге Господње,",
            "poem": 1
          },
          {
            "text": "славите име Господње!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Нек име Господње прослављано буде",
            "poem": 1
          },
          {
            "text": "од сад па довека!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Од изласка сунца па до његовог заласка,",
            "poem": 1
          },
          {
            "text": "прослављано било име Господње!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Над свим народима узвишен је Господ,",
            "poem": 1
          },
          {
            "text": "слава му је врх небеса.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ко је као Господ, Бог наш,",
            "poem": 1
          },
          {
            "text": "што столује у висини;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "што се сагне да погледа",
            "poem": 1
          },
          {
            "text": "и по небу и по земљи?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Сиромаха диже из прашине,",
            "poem": 1
          },
          {
            "text": "из буњишта диже убогога;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "да га посади с племићима,",
            "poem": 1
          },
          {
            "text": "с племићима његовог народа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Од нероткиње у кући",
            "poem": 1
          },
          {
            "text": "чини срећну мајку деце.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Славите Господа!",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
