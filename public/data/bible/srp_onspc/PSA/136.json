    "commonName": "Псалм",
    "title": "Псалми",
    "order": 19,
    "numberOfChapters": 150,
    "sha256": "26caf786163c3156cd828b9195dd87c0a9678ee51bdea32fbef70df99683a272",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/PSA/1.json",
    "lastChapterNumber": 150,
    "lastChapterApiLink": "/api/srp_onspc/PSA/150.json",
    "totalNumberOfVerses": 2461
  },
  "chapter": {
    "number": 136,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Хвалите Господа јер је добар,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Хвалите Бога над боговима,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Хвалите Господара над господарима,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека;",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "оног што ко нико чудеса велика чини,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "оног што умешно начини небеса,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "оног што је земљу разастро на водама,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "оног што начини велика светлећа тела,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "сунце да управља даном,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "месец и звезде да управљају ноћу;",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека;",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "оног што је побио првенце Египта,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "и из њега извео Израиља,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "моћном руком и испруженом мишицом,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека;",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "оног што је разделио Црвено море напола,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "и кроз њега провео Израиља,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "и сручио фараона и његову војску у Црвено море,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека;",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "оног што је свој народ по пустињи водио,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека;",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "оног што је погубио цареве велике,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "и побио цареве силне,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Сихона, аморејског цара,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "и Ога, васанскога цара,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "и њихову је земљу дао у наследство,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "у наследство за свог слугу, за Израиљ,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека;",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "онога што нас се понижених сетио,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "и од душмана нас избавио наших,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "оног који даје храну створењу сваком,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Хвалите Бога небеског,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека!",
            "poem": 2
          }
        ]
      }
    ],
