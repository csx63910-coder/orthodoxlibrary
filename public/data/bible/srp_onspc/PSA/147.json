  },
  "chapter": {
    "number": 147,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Славите Господа!",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Баш је добро Богу нашем запевати славопоје;",
            "poem": 1
          },
          {
            "text": "баш је мило прикладно славити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Господ гради Јерусалим",
            "poem": 1
          },
          {
            "text": "и окупља изгнане Израиљце.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Он лечи срца уцвељених",
            "poem": 1
          },
          {
            "text": "и ране им превија.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Звезде он пребројава",
            "poem": 1
          },
          {
            "text": "и сваку од њих поименце зове.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Велик је наш Господ и силе големе,",
            "poem": 1
          },
          {
            "text": "његова је мудрост безгранична.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Господ диже понизне,",
            "poem": 1
          },
          {
            "text": "а зликовце до земље срозава.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Запевајте хвалоспев Господу!",
            "poem": 1
          },
          {
            "text": "Запевајте славопој на харфи Богу нашем!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Он је небо застро облацима,",
            "poem": 1
          },
          {
            "text": "за земљу се кишом постарао,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "дао трави да расте по горју.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Он зверима храну даје кад затреба,",
            "poem": 1
          },
          {
            "text": "и гавранчићима када му загракћу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Не задивљује се снагом коња,",
            "poem": 1
          },
          {
            "text": "не одушевљава се бедрима јунака.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Господу су мили ти што га се боје,",
            "poem": 1
          },
          {
            "text": "они што се надају милости његовој!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "О, Јерусалиме, величај Господа!",
            "poem": 1
          },
          {
            "text": "О, Сионе, слави Бога свога!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Јер он је ојачао крила врата твојих,",
            "poem": 1
          },
          {
            "text": "благословио је децу твоју у теби.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Земљи твојој он мир доноси",
            "poem": 1
          },
          {
            "text": "и сити те пшеницом најбољом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Реч одлуке своје он пошаље земљи,",
            "poem": 1
          },
          {
            "text": "и реч му већ хита, не застаје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Он снег даје као да је вуна,",
            "poem": 1
          },
          {
            "text": "разбацује иње ко да је пепео.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Град свој баца као да су мрве",
            "poem": 1
          },
          {
            "text": "и мраз његов ко може да трпи?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Реч пошаље своју, па их онда топи;",
            "poem": 1
          },
          {
            "text": "ветром својим дуне и потеку воде.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Јакову је речи своје објавио",
            "poem": 1
          },
          {
            "text": "и Израиљу уредбе своје и своја правила.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "А то није урадио ниједном народу,",
            "poem": 1
          },
          {
            "text": "правила његова нису им позната.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Славите Господа!",
            "poem": 1
          }
        ]
      }
    ],
