  "chapter": {
    "number": 88,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Песма. Псалам. Потомака Корејевих. Хоровођи. Жалосно. Пева се наизменично. Поучна песма Емана Езраита."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "О, Господе, Боже мог спасења,",
            "poem": 1
          },
          {
            "text": "и дању и ноћу ја пред тобом вапим!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Нек пред тебе дође молитва моја,",
            "poem": 1
          },
          {
            "text": "моме преклињању ти ухо приклони!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Душа ми је препуна очаја,",
            "poem": 1
          },
          {
            "text": "Свету мртвих живот ми све ближи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "У друштву сам оних што иду у раку,",
            "poem": 1
          },
          {
            "text": "ја сам као човек који снаге нема;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "положен сам међу мртве,",
            "poem": 1
          },
          {
            "text": "попут мртвих што леже у гробу,",
            "poem": 2
          },
          {
            "text": "као они које више не спомињеш",
            "poem": 1
          },
          {
            "text": "и што су далеко од твоје помоћи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ти си ме положио у најдубљу раку,",
            "poem": 1
          },
          {
            "text": "у тамне дубине.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Срџба твоја на мене је легла",
            "poem": 1
          },
          {
            "text": "и плаве ме сви таласи твоји. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Од мене си одвојио пријатеље моје,",
            "poem": 1
          },
          {
            "text": "гадним си ме њима учинио;",
            "poem": 2
          },
          {
            "text": "сада сам спутан, напоље не могу!",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Очи су ми усахле од беде.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Призивам те сваког дана,",
            "poem": 1
          },
          {
            "text": "о, Господе, теби ширим руке своје!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Зар ћеш чуда за мртве да чиниш?",
            "poem": 1
          },
          {
            "text": "Хоће ли покојни устати да те славе? Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Да ли се у гробу твоја милост разглашава,",
            "poem": 1
          },
          {
            "text": "и верност твоја у трулежу мртвих?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Па зар се у тами зна за чуда твоја,",
            "poem": 1
          },
          {
            "text": "за праведност твоју у земљи заборава?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "А ја тебе, о, Господе, призивам у помоћ;",
            "poem": 1
          },
          {
            "text": "молитва се моја јутром подиже до тебе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Господе, зашто ме одбацујеш?",
            "poem": 1
          },
          {
            "text": "Зашто своје лице од мене сакриваш?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ојађен сам, од младости близу смрти;",
            "poem": 1
          },
          {
            "text": "очајан сам, натоварен ужасима твојим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Срџба твоја ме је прегазила,",
            "poem": 1
          },
          {
            "text": "страхоте ме твоје уништиле.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Окружише ме попут воде поваздан,",
            "poem": 1
          },
          {
            "text": "наваљују једнодушно на ме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Вољене и блиске од мене си уклонио",
            "poem": 1
          },
          {
            "text": "и ја сада другујем са тамом.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
