  "chapter": {
    "number": 76,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи, уз жичане инструменте. Асафов псалам. Песма."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Бог је познат у Јуди,",
            "poem": 1
          },
          {
            "text": "име му је узвишено у Израиљу!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Салим му је конак,",
            "poem": 1
          },
          {
            "text": "на Сиону му стан.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Тамо је сломио стрелу запаљену,",
            "poem": 1
          },
          {
            "text": "штит и мач и справе ратничке. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ти блисташ,",
            "poem": 1
          },
          {
            "text": "славнији си од тих брда са пленом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Људи храброг срца су оплењени,",
            "poem": 1
          },
          {
            "text": "позаспаше;",
            "poem": 2
          },
          {
            "text": "јаки људи,",
            "poem": 1
          },
          {
            "text": "ал’ ни руку да подигну.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Заспаше довека од поклича твога,",
            "poem": 1
          },
          {
            "text": "о, Боже Јаковљев, и коњ и коњаник!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ти! Ти си страшан!",
            "poem": 1
          },
          {
            "text": "Кад се гневиш, ко пред тобом може да опстане?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Са небеса ти суд јављаш.",
            "poem": 1
          },
          {
            "text": "Земља се преплаши, онеми,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "кад устаје Бог да суди",
            "poem": 1
          },
          {
            "text": "и да спасе све понизне на земљи. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Прослављаш се и људским гневом,",
            "poem": 1
          },
          {
            "text": "опасујеш се преживелима од гнева.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Заветујте се и завете извршите Господу, своме Богу;",
            "poem": 1
          },
          {
            "text": "сви који су око њега,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "нек Страшноме дар донесу!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Владарима он дух обара,",
            "poem": 1
          },
          {
            "text": "од њега стрепе цареви земаљски!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
