  "chapter": {
    "number": 70,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. Давидов. За спомен."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Боже, избави ме! У помоћ ми пожури, Господе!",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Нека се постиде,",
            "poem": 1
          },
          {
            "text": "нека се осрамоте ти што ми о глави раде.",
            "poem": 2
          },
          {
            "text": "Нека се повуку у срамоти,",
            "poem": 1
          },
          {
            "text": "нека буду понижени ти што им је мила невоља моја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Нек устукну због срамоте своје",
            "poem": 1
          },
          {
            "text": "ти што довикују: „Аха! Аха!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Нек ликују и нек се радују у теби",
            "poem": 1
          },
          {
            "text": "сви који те траже;",
            "poem": 2
          },
          {
            "text": "нека увек говоре они што спасење твоје воле:",
            "poem": 1
          },
          {
            "text": "„Велик је Бог!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "А ја сам сиромах и убог,",
            "poem": 1
          },
          {
            "text": "Боже, пожури к мени.",
            "poem": 2
          },
          {
            "text": "Ти си моја помоћ и мој избавитељ.",
            "poem": 1
          },
          {
            "text": "О, Господе, не оклевај!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
