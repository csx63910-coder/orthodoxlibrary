  "chapter": {
    "number": 123,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Песма поклоничка."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Очи своје ја подижем теби,",
            "poem": 1
          },
          {
            "text": "који седиш на небесима!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Гле, као што су очи слугу",
            "poem": 1
          },
          {
            "text": "на рукама њихових газда;",
            "poem": 2
          },
          {
            "text": "као што су слушкињине очи",
            "poem": 1
          },
          {
            "text": "на рукама њене газдарице;",
            "poem": 2
          },
          {
            "text": "тако су и наше очи",
            "poem": 1
          },
          {
            "text": "на Господу Богу нашем,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "док се на нас не сажали.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Сажали се, о, Господе,",
            "poem": 1
          },
          {
            "text": "сажали се на нас,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер презира смо сити!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Душа наша довољно је сита",
            "poem": 1
          },
          {
            "text": "ругања бахатих",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и презира осионих људи!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
