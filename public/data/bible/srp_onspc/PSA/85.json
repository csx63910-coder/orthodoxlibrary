  "chapter": {
    "number": 85,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. Потомака Корејевих. Псалам."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ти си, Господе, благонаклон земљи својој;",
            "poem": 1
          },
          {
            "text": "Јакову си срећу повратио;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "свом народу кривицу опростио,",
            "poem": 1
          },
          {
            "text": "све њихове грехе си покрио. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Сву си срџбу своју утихнуо",
            "poem": 1
          },
          {
            "text": "и згаснуо јару свога гнева.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Обнови нас, Боже нашега спасења",
            "poem": 1
          },
          {
            "text": "и не буди на нас више гневан.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Хоћеш ли довека да се гневиш на нас,",
            "poem": 1
          },
          {
            "text": "срџбу своју да пренесеш",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "с нараштаја на нараштај?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Нећеш ли нам опет доћи и оживети нас,",
            "poem": 1
          },
          {
            "text": "па да ти се радује твој народ?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Милост своју покажи нам, о, Господе!",
            "poem": 1
          },
          {
            "text": "Своје нам спасење ти подари!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Послушаћу шта год да ми Господ Бог објави.",
            "poem": 1
          },
          {
            "text": "Јер, он најављује мир народу своме,",
            "poem": 2
          },
          {
            "text": "својим вернима;",
            "poem": 1
          },
          {
            "text": "ал’ на лудост нек се не враћају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Заиста је његово спасење близу богобојазнима,",
            "poem": 1
          },
          {
            "text": "кад ће слава нашу земљу да настани.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Срећу се милост и истина,",
            "poem": 1
          },
          {
            "text": "правда и мир љубе се!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Из земље истина буја,",
            "poem": 1
          },
          {
            "text": "а правда с небеса доле гледа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Још ће Господ добра дати,",
            "poem": 1
          },
          {
            "text": "нашој земљи даће њеног рода.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Правда пред њим иде",
            "poem": 1
          },
          {
            "text": "и стазу спрема по корацима његовим.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
