  "chapter": {
    "number": 127,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Песма поклоничка. Соломонова."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ако Господ не подиже кућу,",
            "poem": 1
          },
          {
            "text": "узалуд се на њој градитељи муче;",
            "poem": 2
          },
          {
            "text": "ако Господ над градом не бдије,",
            "poem": 1
          },
          {
            "text": "узалуд је над њим стражар будан.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Узалудно је и вама да се рано подижете,",
            "poem": 1
          },
          {
            "text": "да касно лежете",
            "poem": 2
          },
          {
            "text": "и једете хлеб са муком стечен,",
            "poem": 1
          },
          {
            "text": "јер он сан свом миљенику даје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Гле, синови су поклон од Господа,",
            "poem": 1
          },
          {
            "text": "плод утробе је награда!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Слични су стрелама у руци ратника,",
            "poem": 1
          },
          {
            "text": "баш су такви у младости рођени синови.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Благо човеку",
            "poem": 1
          },
          {
            "text": "који њима тоболац свој напуни!",
            "poem": 2
          },
          {
            "text": "Такви се црвенети неће",
            "poem": 1
          },
          {
            "text": "кад се буду с душманима",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "на вратима града расправљали!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
