  "chapter": {
    "number": 150,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Славите Господа!",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Славите Бога у Светилишту његовом,",
            "poem": 1
          },
          {
            "text": "славите га под небеским сводом силе његове!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Славите га због његових силних дела,",
            "poem": 1
          },
          {
            "text": "славите га због његове силне величине!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Славите га уз јеку труба,",
            "poem": 1
          },
          {
            "text": "славите га и лиром и харфом!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Славите га и бубњем и колом,",
            "poem": 1
          },
          {
            "text": "славите га струнама и свиралама!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Славите га цимбалима громким,",
            "poem": 1
          },
          {
            "text": "славите га цимбалима звонким!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Нек Господа слави све што дише!",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Славите Господа!",
            "poem": 1
          }
        ]
      }
    ],
