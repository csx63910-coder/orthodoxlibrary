  "chapter": {
    "number": 28,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Давидов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "К теби, Господе, вапим, стено моја,",
            "poem": 1
          },
          {
            "text": "не буди глув према мени,",
            "poem": 2
          },
          {
            "text": "да неуслишен не будем",
            "poem": 1
          },
          {
            "text": "као они што у раку силазе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Почуј глас мога преклињања",
            "poem": 1
          },
          {
            "text": "кад завапим к теби,",
            "poem": 2
          },
          {
            "text": "кад подигнем руке своје",
            "poem": 1
          },
          {
            "text": "к твом најсветијем месту.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Не одведи ме с опакима,",
            "poem": 1
          },
          {
            "text": "с онима који чине безакоње.",
            "poem": 2
          },
          {
            "text": "Они причају благо с ближњима својим,",
            "poem": 1
          },
          {
            "text": "а у срцу злоба им почива.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Врати им по делима њиховим,",
            "poem": 1
          },
          {
            "text": "и по њиховим злим поступцима.",
            "poem": 2
          },
          {
            "text": "Плати им по делима руку њихових,",
            "poem": 1
          },
          {
            "text": "ти им врати што су заслужили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Пошто не маре за дела Господња,",
            "poem": 1
          },
          {
            "text": "нити за дела руку његових,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "срушиће их, подићи их неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Нека је благословен Господ,",
            "poem": 1
          },
          {
            "text": "јер је чуо глас мога преклињања.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Господ је моја снага и мој штит,",
            "poem": 1
          },
          {
            "text": "у њега се поуздаје моје срце.",
            "poem": 2
          },
          {
            "text": "Он ми је помогао, па ми кличе срце,",
            "poem": 1
          },
          {
            "text": "својом песмом даваћу му хвале.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Господ је снага свом народу,",
            "poem": 1
          },
          {
            "text": "тврђава спасења свом помазанику.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Спаси свој народ! Благослови своје наследство!",
            "poem": 1
          },
          {
            "text": "Напасај га и носи заувек!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
