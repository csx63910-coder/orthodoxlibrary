  "chapter": {
    "number": 89,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Поучна песма Етан Езраита."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "О милости Господњој ја довека певам;",
            "poem": 1
          },
          {
            "text": "устима својим верност твоју разглашавам",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "нараштају сваком!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Јер рекао сам: „Довека је милост чврста,",
            "poem": 1
          },
          {
            "text": "верност ти је постављена у небеса.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "А ти: „Савез сам склопио са изабраником својим,",
            "poem": 1
          },
          {
            "text": "заклео се свом слузи Давиду:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "’Потомство ћу твоје довека да учврстим,",
            "poem": 1
          },
          {
            "text": "твој ће престо да потраје кроз поколење свако!’“ Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "О, Господе, небеса славе чудеса твоја",
            "poem": 1
          },
          {
            "text": "и твоју верност у збору светих!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Јер ко је тај на небу да је Господу налик,",
            "poem": 1
          },
          {
            "text": "да је као Господ међу синовима Божијим?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Бог је величанствен на сабору светих,",
            "poem": 1
          },
          {
            "text": "страшнији је од свих што га окружују.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Господе, Боже над војскама,",
            "poem": 1
          },
          {
            "text": "ко је попут тебе моћан Господ?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Верношћу си својом обавијен.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ти управљаш морем поноситим,",
            "poem": 1
          },
          {
            "text": "ти му спушташ таласе немирне.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Скршио си Раву као да је заклан,",
            "poem": 1
          },
          {
            "text": "душмане си своје растерао силом руке своје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Твоја су небеса, баш као и земља;",
            "poem": 1
          },
          {
            "text": "свет и оно што га чини ти си поставио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Југ и север ти си начинио,",
            "poem": 1
          },
          {
            "text": "и Тавор и Ермон твом имену кличу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Мишица је твоја јака, рука ти је моћна,",
            "poem": 1
          },
          {
            "text": "десница је твоја подигнута.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Твог престола темељи су праведност и правда;",
            "poem": 1
          },
          {
            "text": "милост и истина иду испред твога лица.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Благо народу коме је клицање знано,",
            "poem": 1
          },
          {
            "text": "који живи у светлости лица твога, о, Господе!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Имену се твоме они поваздан радују,",
            "poem": 1
          },
          {
            "text": "праведношћу твојом они се уздижу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Јер ти си слава њихове јакости,",
            "poem": 1
          },
          {
            "text": "наклоношћу твојом наш се рог",
            "poem": 2
          },
          {
            "noteId": 7
          },
          {
            "text": "уздиже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Јер наш је штит од Господа,",
            "poem": 1
          },
          {
            "text": "наш је цар од Светитеља Израиљевог.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Тада си у виђењу говорио",
            "poem": 1
          },
          {
            "text": "свом верном народу и рекао:",
            "poem": 2
          },
          {
            "text": "„Своју помоћ дао сам јунаку,",
            "poem": 1
          },
          {
            "text": "изабраног из народа дигох.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Нашао сам Давида, слугу свога,",
            "poem": 1
          },
          {
            "text": "уљем својим светим помазао сам га.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "На њему ће моја рука да почива,",
            "poem": 1
          },
          {
            "text": "мишица ће моја да га јача.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Неће га варати непријатељ,",
            "poem": 1
          },
          {
            "text": "неће му наудити неправедник.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Изломићу пред њим душмане његове,",
            "poem": 1
          },
          {
            "text": "и потући оне што га мрзе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Моја верност и милост моја биће са њим,",
            "poem": 1
          },
          {
            "text": "у моје ће се име подићи рог његов.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Његову ћу руку дигнути на море",
            "poem": 1
          },
          {
            "text": "и на реке десницу његову.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "А он ће ме звати: ’Оче мој, Боже мој,",
            "poem": 1
          },
          {
            "text": "Стено мог спасења!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "А ја ћу га поставити за прворођеног,",
            "poem": 1
          },
          {
            "text": "за најузвишенијег међу царевима земље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Довека ћу му очувати милост своју",
            "poem": 1
          },
          {
            "text": "и свој ћу савез да учврстим са њим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Довека ћу да учврстим потомство његово,",
            "poem": 1
          },
          {
            "text": "престо његов биће док је дана небу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "А ако синови његови мој Закон напусте",
            "poem": 1
          },
          {
            "text": "и не живе по мојим уредбама;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "ако прекрше одредбе моје",
            "poem": 1
          },
          {
            "text": "и заповести моје не држе;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "казнићу им преступе шибом",
            "poem": 1
          },
          {
            "text": "и кривицу ударцима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Али милост своју никад нећу да им узмем,",
            "poem": 1
          },
          {
            "text": "верност своју нећу да порекнем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Нећу да погазим свој савез,",
            "poem": 1
          },
          {
            "text": "нећу да порекнем оно што устима обећао сам.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Једном сам се заклео Давиду светошћу својом",
            "poem": 1
          },
          {
            "text": "и порећи нећу!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Потомство ће његово довека да траје",
            "poem": 1
          },
          {
            "text": "и преда мном попут сунца престо његов;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "као месец заувек ће потрајати,",
            "poem": 1
          },
          {
            "text": "попут неба сведок верни.“ Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "А сада си га свргнуо, згрозио се",
            "poem": 1
          },
          {
            "text": "и разјарио на свог помазаника;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          {
            "text": "Порекао си савез са слугом својим,",
            "poem": 1
          },
          {
            "text": "у прашини му круну оскрнавио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          {
            "text": "Зарушио си му све зидине",
            "poem": 1
          },
          {
            "text": "и утврђења му у руине претворио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          {
            "text": "Харају га сви што путем прођу,",
            "poem": 1
          },
          {
            "text": "комшијама својим постао је ругло.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          {
            "text": "Дигао си десницу душмана његових,",
            "poem": 1
          },
          {
            "text": "крвника његовог ти чиниш веселим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          {
            "text": "Још си му оштрицу мача отупио,",
            "poem": 1
          },
          {
            "text": "у боју му помогао ниси.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          {
            "text": "Његов сјај си окончао,",
            "poem": 1
          },
          {
            "text": "срушио му престо у прашину.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          {
            "text": "Скратио си дане младости његове",
            "poem": 1
          },
          {
            "text": "и загрнуо га срамотом. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          {
            "text": "О, Господе, докле ћеш се крити?",
            "poem": 1
          },
          {
            "text": "Довека ти срџба као ватра букти?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          {
            "text": "Присети се дужине мог живота.",
            "poem": 1
          },
          {
            "text": "Зар узалуд створио си све потомке људи?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          {
            "text": "Ко је човек који је живео, а да смрти угледао није?",
            "poem": 1
          },
          {
            "text": "Из руку Света мртвих ко је живот избавио? Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          {
            "text": "О, Господе, где су твоја милосрђа давна",
            "poem": 1
          },
          {
            "text": "којима си се у верности својој заклео Давиду?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          {
            "text": "Сети се, о, Господе, срамоћења својих слугу,",
            "poem": 1
          },
          {
            "text": "која носим у недрима од народа многих!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 51,
        "content": [
          {
            "text": "Господе, њима су нас срамотили противници твоји;",
            "poem": 1
          },
          {
            "text": "њима су срамотили кораке твог помазаника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 52,
        "content": [
          {
            "text": "Благословен довека да је Господ!",
            "poem": 1
          },
          "Амин! Амин!"
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 7,
        "caller": "+",
        "text": "89,17 Рог је симбол, метафора војне снаге, достојанства.",
        "reference": {
          "chapter": 89,
          "verse": 17
        }
      }
    ]
