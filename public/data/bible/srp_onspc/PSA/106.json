  },
  "chapter": {
    "number": 106,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Славите Господа!",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Хвалите Господа јер је добар,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ко ће да искаже силна Господња дела,",
            "poem": 1
          },
          {
            "text": "да му сву славу разгласи?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Благо онима што се држе правде,",
            "poem": 1
          },
          {
            "text": "онима што увек поступају праведно.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Сети ме се, о, Господе,",
            "poem": 1
          },
          {
            "text": "када си милостив свом народу;",
            "poem": 2
          },
          {
            "text": "у спасењу своме",
            "poem": 1
          },
          {
            "text": "и мене се сети;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "да видим напредак твојих изабраних,",
            "poem": 1
          },
          {
            "text": "да се радујем у радости народа твога",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и хвалим се са твојим наследством.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Згрешили смо као преци наши;",
            "poem": 1
          },
          {
            "text": "учинили смо неправду, скривили смо!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Наши преци у Египту нису разумели чудеса твоја,",
            "poem": 1
          },
          {
            "text": "нису спомињали твоју велику милост,",
            "poem": 2
          },
          {
            "text": "па су се побунили крај мора,",
            "poem": 1
          },
          {
            "text": "крај Црвеног мора.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "А он их је избавио зарад свог имена,",
            "poem": 1
          },
          {
            "text": "да би силу своју показао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Запретио је Црвеном мору",
            "poem": 1
          },
          {
            "text": "и оно је пресушило,",
            "poem": 2
          },
          {
            "text": "па их је водио дубинама",
            "poem": 1
          },
          {
            "text": "као по пустињи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Спасао их је од руке мрзитеља,",
            "poem": 1
          },
          {
            "text": "откупио из руке душмана.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "И воде су преплавиле њихове крвнике,",
            "poem": 1
          },
          {
            "text": "нико од њих преостао није.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Тада су поверовали његовим речима",
            "poem": 1
          },
          {
            "text": "и певали му хвалоспеве.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Али брзо су му дела заборавили,",
            "poem": 1
          },
          {
            "text": "на савет његов чекали нису.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "У пустињи их спопаде жудња,",
            "poem": 1
          },
          {
            "text": "у пустари су искушавали Бога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "И он је дао како су тражили,",
            "poem": 1
          },
          {
            "text": "али им је душе разболео.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "У табору су завидели Мојсију и Арону,",
            "poem": 1
          },
          {
            "text": "свецу Господњем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "На то се земља распукла,",
            "poem": 1
          },
          {
            "text": "прогутала је Датана",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и затрпала Авиронову дружину.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Букнула је ватра у дружини,",
            "poem": 1
          },
          {
            "text": "сукнуо је пламен на злобнике.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "На Хориву излили су теле,",
            "poem": 1
          },
          {
            "text": "клањали се ливеном идолу;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "заменули су Славу своју",
            "poem": 1
          },
          {
            "text": "за лик вола који пасе траву!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Заборавили су Бога, свог избавитеља,",
            "poem": 1
          },
          {
            "text": "који је у Египту велика учинио дела;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "чудеса у Хамовој земљи",
            "poem": 1
          },
          {
            "text": "и страхоте на Црвеном мору.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Рекао је да би их истребио,",
            "poem": 1
          },
          {
            "text": "да његов изабраник Мојсије",
            "poem": 2
          },
          {
            "text": "није стао пред њега у процеп,",
            "poem": 1
          },
          {
            "text": "и одвратио његов разорни гнев.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Презрели су земљу милу",
            "poem": 1
          },
          {
            "text": "и нису веровали његовој речи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Гунђали су у својим шаторима",
            "poem": 1
          },
          {
            "text": "и глас Господњи слушали нису.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "А он им се заклео",
            "poem": 1
          },
          {
            "text": "да ће их побити у пустињи;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "да ће им побити децу међу народима",
            "poem": 1
          },
          {
            "text": "и раселити по земљама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Али они су се приклонили Вал-Фегору",
            "poem": 1
          },
          {
            "text": "и јели жртве за мртве.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Својим су га поступцима на гнев изазвали",
            "poem": 1
          },
          {
            "text": "па је пошаст букнула међу њима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Али устао је Финес да посредује",
            "poem": 1
          },
          {
            "text": "и пошаст је стала.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "То му се урачунало као праведност",
            "poem": 1
          },
          {
            "text": "кроз сва поколења, довека.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Гневили су га и на водама Мериве,",
            "poem": 1
          },
          {
            "text": "па је и Мојсије због њих настрадао;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "јер су му дух раздражили",
            "poem": 1
          },
          {
            "text": "па је непромишљено говорио уснама својим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Нису истребили народе",
            "poem": 1
          },
          {
            "text": "за које им је Господ заповедио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Помешали су се с народима,",
            "poem": 1
          },
          {
            "text": "навикнули на њихова дела.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Служили су њиховим идолима",
            "poem": 1
          },
          {
            "text": "и они су им постали замка.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Жртвовали су своје синове",
            "poem": 1
          },
          {
            "text": "и своје ћерке злодусима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "Проливали су невину крв,",
            "poem": 1
          },
          {
            "text": "крв својих синова и својих ћерки",
            "poem": 2
          },
          {
            "text": "које су жртвовали идолима Ханана;",
            "poem": 1
          },
          {
            "text": "крвљу су опоганили земљу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          {
            "text": "Оскрнавили су се делима својим,",
            "poem": 1
          },
          {
            "text": "одали се блуду поступцима својим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          {
            "text": "Тада је плануо гнев Господњи на његов народ,",
            "poem": 1
          },
          {
            "text": "згадило му се његово наследство.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          {
            "text": "Предавао их је у руке народа",
            "poem": 1
          },
          {
            "text": "па су над њима владали они што их мрзе;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          {
            "text": "тлачили их њихови душмани,",
            "poem": 1
          },
          {
            "text": "понизили под њиховом влашћу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          {
            "text": "Много пута их је избављао,",
            "poem": 1
          },
          {
            "text": "али су били бунтовних намера,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "па су пропадали у својим кривицама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          {
            "text": "Али он би их погледао у њиховој муци,",
            "poem": 1
          },
          {
            "text": "чуо би им преклињање;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          {
            "text": "па се због њих подсетио свог савеза",
            "poem": 1
          },
          {
            "text": "и сажалио по великој милости својој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          {
            "text": "Чак је учинио да им се смилују",
            "poem": 1
          },
          {
            "text": "сви тлачитељи њихови.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          {
            "text": "Спаси нас, Господе, Боже наш,",
            "poem": 1
          },
          {
            "text": "скупи нас од народа,",
            "poem": 2
          },
          {
            "text": "да хвалимо твоје свето име,",
            "poem": 1
          },
          {
            "text": "да се дичимо твојом славом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          {
            "text": "Благословен да је Господ, Бог Израиљев,",
            "poem": 1
          },
          {
            "text": "од века до века.",
            "poem": 2
          },
          {
            "text": "И сав народ нека каже:",
            "poem": 1
          },
          {
            "text": "„Амин.“",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Славите Господа!",
            "poem": 1
          }
        ]
      }
    ],
