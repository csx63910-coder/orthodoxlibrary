  "chapter": {
    "number": 44,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "За хоровођу. Поучна песма синова Корејевих."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "О, Боже, својим смо ушима чули,",
            "poem": 1
          },
          {
            "text": "наши нам преци рекоше,",
            "poem": 2
          },
          {
            "text": "за дело које ти учини у дане њихове,",
            "poem": 1
          },
          {
            "text": "у дане прадавне.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Својом си руком изгнао народе, а њих посадио,",
            "poem": 1
          },
          {
            "text": "пуке си разбио, а њих умножио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Нису они земљу мачем освојили,",
            "poem": 1
          },
          {
            "text": "нити их је рука њихова избавила,",
            "poem": 2
          },
          {
            "text": "него твоја рука десница,",
            "poem": 1
          },
          {
            "text": "и светло твога лица, јер си их заволео.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ти си мој цар, Боже!",
            "poem": 1
          },
          {
            "text": "Нареди, и Јаков ће бити спасен.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "С тобом пробадамо душмане своје,",
            "poem": 1
          },
          {
            "text": "у име твоје газимо непријатеље своје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Јер ја се не уздам у лук свој,",
            "poem": 1
          },
          {
            "text": "мач мој мене не спасава.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Јер ти нас избави од наших душмана,",
            "poem": 1
          },
          {
            "text": "ти осрамоти наше мрзитеље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Богом смо се хвалили поваздан,",
            "poem": 1
          },
          {
            "text": "име твоје славили поваздан.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Но, ти си нас одбацио и понизио,",
            "poem": 1
          },
          {
            "text": "и не идеш у бој с војском нашом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Чиниш да се повлачимо пред душманином,",
            "poem": 1
          },
          {
            "text": "да нас пљачкају наши мрзитељи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Изручио си нас као овце за клање,",
            "poem": 1
          },
          {
            "text": "расејао нас међу народе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Продао си свој народ у бесцење,",
            "poem": 1
          },
          {
            "text": "а од продаје се ниси обогатио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Учинио си нас руглом нашим суседима,",
            "poem": 1
          },
          {
            "text": "на подсмех смо и ругање онима око нас.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Учинио си нас ругалицом међу народима,",
            "poem": 1
          },
          {
            "text": "машу главом народи над нама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Срамота је моја стално преда мном,",
            "poem": 1
          },
          {
            "text": "стид ми је лице покрио",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "од гласа ругача и подсмевача,",
            "poem": 1
          },
          {
            "text": "пред душманином, осветником.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Све нас то снађе, ал’ нисмо те заборавили,",
            "poem": 1
          },
          {
            "text": "а ни савез твој нисмо изневерили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Срце нам се није одвратило,",
            "poem": 1
          },
          {
            "text": "нити су нам стопе с твог пута скренуле,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "кад си нас разбио у крају шакалском,",
            "poem": 1
          },
          {
            "text": "и у смртну нас таму завио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Ако заборавимо име Бога нашега,",
            "poem": 1
          },
          {
            "text": "и раширимо руке према туђем богу,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "неће ли Бог то открити,",
            "poem": 1
          },
          {
            "text": "кад познаје тајне срца?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Јер због тебе нас убијају свагда,",
            "poem": 1
          },
          {
            "text": "сматрају нас овцама за клање.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Пробуди се, зашто спаваш, Господе?",
            "poem": 1
          },
          {
            "text": "Устани, не одбацуј нас довека!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Зашто кријеш своје лице?",
            "poem": 1
          },
          {
            "text": "Зашто заборављаш муку и потлаченост нашу?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Јер душа наша лежи у прашини,",
            "poem": 1
          },
          {
            "text": "стомак нам се прилепио уз земљу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Устани, помози нам,",
            "poem": 1
          },
          {
            "text": "откупи нас због милости своје!",
            "poem": 2
          }
        ]
      }
    ],
