  "chapter": {
    "number": 124,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Песма поклоничка. Давидова."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "„Да Господ са нама није био“ –",
            "poem": 1
          },
          {
            "text": "нек Израиљ каже –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„да Господ са нама није био,",
            "poem": 1
          },
          {
            "text": "када су се људи на нас дигли;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "тада би нас живе прогутали,",
            "poem": 1
          },
          {
            "text": "кад су својим гневом успламтели на нас;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "тада би нас бујице однеле,",
            "poem": 1
          },
          {
            "text": "брзак би нам преплавио душе;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "тада би нам махнитале воде",
            "poem": 1
          },
          {
            "text": "преплавиле душе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Господ нек је благословен",
            "poem": 1
          },
          {
            "text": "што нас није ко плен дао њиховим зубима!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Душа се наша избавила",
            "poem": 1
          },
          {
            "text": "као птица из ловчеве замке;",
            "poem": 2
          },
          {
            "text": "замка је пукла",
            "poem": 1
          },
          {
            "text": "и ми смо се избавили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Наша помоћ име је Господа,",
            "poem": 1
          },
          {
            "text": "Саздатеља небеса и земље!“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
