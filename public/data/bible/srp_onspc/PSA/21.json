  "chapter": {
    "number": 21,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. Псалам Давидов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Господе, по твојој се снази цар весели,",
            "poem": 1
          },
          {
            "text": "како се много радује твоме спасењу!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Дао си му што му срце жели,",
            "poem": 1
          },
          {
            "text": "прошњу његову ниси одбио. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Јер сусрео си га добрим благословима,",
            "poem": 1
          },
          {
            "text": "на главу му ставио круну од сувога злата.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Живот је од тебе тражио и живот си му дао;",
            "poem": 1
          },
          {
            "text": "дуге дане заувек и довека.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Велика је твоја слава у твоме спасењу,",
            "poem": 1
          },
          {
            "text": "подарио си му сјај и величанство,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Јер ти му подари благослове довека,",
            "poem": 1
          },
          {
            "text": "дао му да се весели у радости твог лица.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Јер цар се узда у Господа,",
            "poem": 1
          },
          {
            "text": "и милошћу се Свевишњега неће уздрмати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Рука ће ти наћи све твоје душмане,",
            "poem": 1
          },
          {
            "text": "десница ти наћи оне што те мрзе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Учинићеш да буду као пећ огњена кад се појавиш,",
            "poem": 1
          },
          {
            "text": "Господ ће их прогутати у своме гневу,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "огањ прождраће их.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Истребићеш им потомке са земље,",
            "poem": 1
          },
          {
            "text": "и семе њихово међу потомцима људи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Јер зло су наумили против тебе,",
            "poem": 1
          },
          {
            "text": "заверу сковаше, ал’ неће им успети,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "јер ти ћеш их у бег натерати,",
            "poem": 1
          },
          {
            "text": "кад им стрелу упериш у лице.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Узвиси се, Господе, у својој сили!",
            "poem": 1
          },
          {
            "text": "А ми ћемо певати и славити твоју снагу.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
