  "chapter": {
    "number": 32,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Давидов. Поучна песма."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Благо ономе коме је опроштен преступ,",
            "poem": 1
          },
          {
            "text": "коме је покривен грех.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Благо човеку коме Господ не урачунава грех",
            "poem": 1
          },
          {
            "text": "и у чијем духу нема преваре.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Хтедох да прећутим, ал’ кости ми усахнуше,",
            "poem": 1
          },
          {
            "text": "јер дан читави у вапају сам проводио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Јер дању и ноћу",
            "poem": 1
          },
          {
            "text": "рука ме је твоја тешко притискала,",
            "poem": 2
          },
          {
            "text": "снага ми је сахнула",
            "poem": 1
          },
          {
            "text": "као на летњој жези. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Тада признах теби грех свој,",
            "poem": 1
          },
          {
            "text": "и преступ свој нисам крио.",
            "poem": 2
          },
          {
            "text": "Рекох: „Признаћу Господу своје преступе.“",
            "poem": 1
          },
          {
            "text": "И ти си ми преступ греха опростио. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Зато нека ти се сваки верни моли",
            "poem": 1
          },
          {
            "text": "у времену кад се можеш наћи;",
            "poem": 2
          },
          {
            "text": "чак и потоп да јурне на њега,",
            "poem": 1
          },
          {
            "text": "силне воде сустићи га неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ти си мени уточиште,",
            "poem": 1
          },
          {
            "text": "чувај ме од невоље;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ти ме заогрћеш радошћу избављења. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "„Ја ћу те умудрити и поучити",
            "poem": 1
          },
          {
            "text": "којим путем ти ваља кренути;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "савет ћу ти дати и над тобом бдети.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Не будите као коњ или мазга без разума,",
            "poem": 1
          },
          {
            "text": "који се кроте вођицама и уздом,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "иначе ти неће прићи близу.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Многи јади сналазе опакога,",
            "poem": 1
          },
          {
            "text": "а оног ко се узда у Господа окружује милост.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Радујте се у Господу,",
            "poem": 1
          },
          {
            "text": "веселите се, ви праведни,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "кличите, ви с честитим срцем!",
            "poem": 2
          }
        ]
      }
    ],
