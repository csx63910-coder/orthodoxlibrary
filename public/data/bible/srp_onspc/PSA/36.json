  "chapter": {
    "number": 36,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. Слуге Господњег Давида."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Преступ проговара из срца опаког,",
            "poem": 1
          },
          {
            "text": "за страх Божији очи му не знају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Јер он ласка себи",
            "poem": 1
          },
          {
            "text": "и очима својим не налази своју кривицу да би је мрзео.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Злобне су и заводљиве речи његових уста,",
            "poem": 1
          },
          {
            "text": "престао је да показује мудрост, да чини добро.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Он злобу смишља на постељи својој,",
            "poem": 1
          },
          {
            "text": "предао се путу неваљалом,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "зла се не одриче.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "О, Господе, милост ти је до небеса,",
            "poem": 1
          },
          {
            "text": "а верност ти је до облака.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Праведност је твоја попут горе Божије,",
            "poem": 1
          },
          {
            "text": "а твоја је правда дубина голема.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ти, Господе, чуваш и људе и звери.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Како је скупоцена милост твоја, Боже,",
            "poem": 1
          },
          {
            "text": "потомци људи у сенци крила твојих уточиште налазе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Сите се изобиљем твога Дома,",
            "poem": 1
          },
          {
            "text": "напајаш их реком твојих добара.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Јер у теби је врело живота,",
            "poem": 1
          },
          {
            "text": "у твом светлу ми видимо светло.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Милост своју пружи онима који те познају,",
            "poem": 1
          },
          {
            "text": "и праведност своју онима срца честитога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Нога поносита нек ми не прилази,",
            "poem": 1
          },
          {
            "text": "рука зликоваца нек ме не протера.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ено, падоше они који раде злобно,",
            "poem": 1
          },
          {
            "text": "срушени су и дићи се неће моћи.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
