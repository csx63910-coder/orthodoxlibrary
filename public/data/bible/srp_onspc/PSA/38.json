  "chapter": {
    "number": 38,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Псалам Давидов. За сећање."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Не карај ме у гневу свом, Господе,",
            "poem": 1
          },
          {
            "text": "не кажњавај у јарости својој,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "јер твоје су се стреле заболе у мене,",
            "poem": 1
          },
          {
            "text": "и твоја ме је рука притиснула.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "На мом телу здравог места нема од твоје срџбе,",
            "poem": 1
          },
          {
            "text": "ради мог греха кости ми немају починка.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Јер моје ме неправде преплавише,",
            "poem": 1
          },
          {
            "text": "навалише се на мене као терет претешки.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Моје ране смрде, гноје се",
            "poem": 1
          },
          {
            "text": "због моје лудости,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "погнуо сам се, сасвим се згурио,",
            "poem": 1
          },
          {
            "text": "па поваздан ходам у жалости.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Јер бедра су моја пуна бола љутог,",
            "poem": 1
          },
          {
            "text": "на телу ми здравог места нема.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Потпуно сам укочен и сломљен,",
            "poem": 1
          },
          {
            "text": "урлам јер ми срце стење.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "О, Господе, знана ти је свака жеља моја,",
            "poem": 1
          },
          {
            "text": "уздисање моје није ти скривено.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Срце моје силно удара,",
            "poem": 1
          },
          {
            "text": "снага ме моја напушта,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "нема више светла у мојим очима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Пријатељи и ближњи моји",
            "poem": 1
          },
          {
            "text": "одступају од мене због болести моје,",
            "poem": 2
          },
          {
            "text": "па и они који су ми род рођени,",
            "poem": 1
          },
          {
            "text": "и они од мене стоје далеко.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Они што ми о глави раде,",
            "poem": 1
          },
          {
            "text": "они мени замке постављају;",
            "poem": 2
          },
          {
            "text": "ти што хоће мени да науде,",
            "poem": 1
          },
          {
            "text": "такви мени прете уништењем,",
            "poem": 2
          },
          {
            "text": "па поваздан смишљају подлости.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "А ја сам као глув и не чујем ништа,",
            "poem": 1
          },
          {
            "text": "као нем сам који не отвара уста.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Постао сам као човек који не чује,",
            "poem": 1
          },
          {
            "text": "и као онај чија уста немају одговор.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Јер на тебе ја чекам, Господе,",
            "poem": 1
          },
          {
            "text": "ти одговори, Господе, мој Боже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ја рекох: „Не дај да се радују нада мном,",
            "poem": 1
          },
          {
            "text": "да ликују нада мном кад ми нога посрне.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Јер мој пад већ се примакао,",
            "poem": 1
          },
          {
            "text": "бол мој стално је преда мном.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ја признајем своје безакоње,",
            "poem": 1
          },
          {
            "text": "забринут сам због свог греха.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "А душмани моји пуни су живота,",
            "poem": 1
          },
          {
            "text": "моћни су и бројни они што ме неправедно мрзе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Они који узвраћају зло за добро",
            "poem": 1
          },
          {
            "text": "оптужују ме што следим добро.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Не остављај ме, Господе,",
            "poem": 1
          },
          {
            "text": "не удаљуј се од мене, Боже мој!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Пожури ми у помоћ, Господе, Спаситељу мој!",
            "poem": 1
          }
        ]
      }
    ],
