  },
  "chapter": {
    "number": 69,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. Напев: „Љиљани“. Давидов"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Спаси ме, о, Боже,",
            "poem": 1
          },
          {
            "text": "дођоше до грла воде!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Потонуо сам у блато дубоко,",
            "poem": 1
          },
          {
            "text": "а нигде ослонца;",
            "poem": 2
          },
          {
            "text": "доспео сам у воде дубоке,",
            "poem": 1
          },
          {
            "text": "бујица ме захватила.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Клонуо сам зовући те,",
            "poem": 1
          },
          {
            "text": "промуче ми грло;",
            "poem": 2
          },
          {
            "text": "очи су ми усахнуле",
            "poem": 1
          },
          {
            "text": "чекајући Бога мога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Бројнији су ти што ме без разлога мрзе",
            "poem": 1
          },
          {
            "text": "од косе на глави мојој,",
            "poem": 2
          },
          {
            "text": "ти моћници што би да ме збришу,",
            "poem": 1
          },
          {
            "text": "безразложни противници.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Враћам, а украо нисам.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Лудост моју ти познајеш, Боже;",
            "poem": 1
          },
          {
            "text": "греси моји скривени ти нису.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Нека се због мене не постиде они",
            "poem": 1
          },
          {
            "text": "који у тебе наду своју полажу,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Господе, Боже над војскама.",
            "poem": 2
          },
          {
            "text": "Нека се због мене не осрамоте они",
            "poem": 1
          },
          {
            "text": "који те траже,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Боже Израиљев.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Јер ја због тебе трпим презир,",
            "poem": 1
          },
          {
            "text": "лице моје прекрила је брука.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Браћи својој незнанац постадох,",
            "poem": 1
          },
          {
            "text": "туђинац сам деци моје мајке.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Изједа ме ревност за твој Дом.",
            "poem": 1
          },
          {
            "text": "Увреде оних који тебе вређају,",
            "poem": 2
          },
          {
            "text": "пале су на мене.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Плакао сам и постио,",
            "poem": 1
          },
          {
            "text": "и то ми је на презир било.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "За одећу себи кострет огрнух,",
            "poem": 1
          },
          {
            "text": "и постадох ругло за њих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "О мени причају они што седе на градским вратима",
            "poem": 1
          },
          {
            "text": "и певају песме пијанице.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "А ја се само теби молим, о, Господе,",
            "poem": 1
          },
          {
            "text": "у време повољно;",
            "poem": 2
          },
          {
            "text": "Боже, услиши ме по обилном твоме смиловању,",
            "poem": 1
          },
          {
            "text": "по верности свог спасења.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Из блата ме ослободи,",
            "poem": 1
          },
          {
            "text": "не дај да потонем;",
            "poem": 2
          },
          {
            "text": "ослободи ме од оних што ме мрзе,",
            "poem": 1
          },
          {
            "text": "од дубоких вода.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Бујица воде нек ме не захвати,",
            "poem": 1
          },
          {
            "text": "нек ме не прогута дубина",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и ждрело њено нада мном не затвори се.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Услиши ме, Господе,",
            "poem": 1
          },
          {
            "text": "јер је добра милост твоја;",
            "poem": 2
          },
          {
            "text": "по големом милосрђу своме",
            "poem": 1
          },
          {
            "text": "на мене се осврни.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Лице своје од свог слуге не сакривај,",
            "poem": 1
          },
          {
            "text": "јер сам на мукама;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "похитај, услиши ме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Приђи ближе души мојој, откупи је;",
            "poem": 1
          },
          {
            "text": "ради мојих противника, избави ме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ти знаш да сам презрен, осрамоћен и обрукан;",
            "poem": 1
          },
          {
            "text": "пред тобом су сви душмани моји.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Презир ми је срце сломио,",
            "poem": 1
          },
          {
            "text": "разболех се;",
            "poem": 2
          },
          {
            "text": "жудео сам за утехом –",
            "poem": 1
          },
          {
            "text": "никог ниоткуда;",
            "poem": 2
          },
          {
            "text": "за утешитељима –",
            "poem": 1
          },
          {
            "text": "нашао их нисам.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Пелен су ми у храну ставили,",
            "poem": 1
          },
          {
            "text": "сирће су ми жедном дали да пијем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Нек им сто постане замка,",
            "poem": 1
          },
          {
            "text": "одмазда и клопка;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "нек им очи потамне, да не виде,",
            "poem": 1
          },
          {
            "text": "и леђа им се заувек погрбе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Срџбу своју на њих излиј,",
            "poem": 1
          },
          {
            "text": "јарка љутња твоја нека их сустигне.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Табор нек им опустоши;",
            "poem": 1
          },
          {
            "text": "не живео нико у њиховим шаторима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Јер они гоне оне што си ударио",
            "poem": 1
          },
          {
            "text": "и јављају јаде оних које си ранио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Кривицу им на кривицу додај,",
            "poem": 1
          },
          {
            "text": "да не уђу у праведност твоју.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Избрисани били из Књиге живота,",
            "poem": 1
          },
          {
            "text": "да са праведнима не буду записани.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "А ја сам сиромах, у боловима сам;",
            "poem": 1
          },
          {
            "text": "спасење твоје, Боже, нека ме заштити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Име Божије песмом ћу да славим,",
            "poem": 1
          },
          {
            "text": "величаћу га хвалоспевом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "То ће бити Господу милије од вола",
            "poem": 1
          },
          {
            "text": "и од бика, рогатог папкара.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Видеће то понизни,",
            "poem": 1
          },
          {
            "text": "радоваће се;",
            "poem": 2
          },
          {
            "text": "ви, што Бога тражите,",
            "poem": 1
          },
          {
            "text": "нек вам срце буде живо.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Јер убоге Господ чује,",
            "poem": 1
          },
          {
            "text": "не презире заточене своје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Нек га славе небеса, земља, мора",
            "poem": 1
          },
          {
            "text": "и све што се у њима креће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Јер Сион ће Бог да спасе,",
            "poem": 1
          },
          {
            "text": "сазидаће јудејске градове;",
            "poem": 2
          },
          {
            "text": "и они ће их запосести",
            "poem": 1
          },
          {
            "text": "и живеће тамо.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "И потомци његових слуга",
            "poem": 1
          },
          {
            "text": "то ће да наследе,",
            "poem": 2
          },
          {
            "text": "и они што име његово воле",
            "poem": 1
          },
          {
            "text": "боравиће тамо.",
            "poem": 2
          }
        ]
      }
    ],
