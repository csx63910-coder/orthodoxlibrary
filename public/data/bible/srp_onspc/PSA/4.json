  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи, уз жичане инструменте. Давидов псалам."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Одговори кад те зовнем, Боже, моја правдо,",
            "poem": 1
          },
          {
            "text": "у мојој тескоби, дај ми да одахнем,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "смилуј ми се, почуј ми молитву.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Докле ће, о, људски синови,",
            "poem": 1
          },
          {
            "text": "слава моја бити у срамоти?",
            "poem": 2
          },
          {
            "text": "Докле ћете волети испразност,",
            "poem": 1
          },
          {
            "text": "докле ћете ићи за преваром? Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Знајте, верне је Господ одвојио за себе,",
            "poem": 1
          },
          {
            "text": "Господ слуша кад год га позовем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Гневите се, али не грешите,",
            "poem": 1
          },
          {
            "text": "на постељи срцем размишљајте, утихните. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Принесите жртве праведне,",
            "poem": 1
          },
          {
            "text": "у Господа се уздајте.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Многи кажу: „Ко ће нам показати срећу?“",
            "poem": 1
          },
          {
            "text": "Обасјај нас, Господе, светлом свога лица!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ти си ми весељем испунио срце,",
            "poem": 1
          },
          {
            "text": "више га има од њиховог жита,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и од младога вина њиховог.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ја спокојно лежем,",
            "poem": 1
          },
          {
            "text": "спокојно и спавам,",
            "poem": 2
          },
          {
            "text": "јер ти сам, Господе,",
            "poem": 1
          },
          {
            "text": "дајеш ми спокоја. Села",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
