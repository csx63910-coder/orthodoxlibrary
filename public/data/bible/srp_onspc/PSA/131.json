  "chapter": {
    "number": 131,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Песма поклоничка. Давидова."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "О, Господе, не горди се срце моје!",
            "poem": 1
          },
          {
            "text": "Очи моје нису узносите.",
            "poem": 2
          },
          {
            "text": "Не пружам се за великим,",
            "poem": 1
          },
          {
            "text": "ни за нечим мени недосежним.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ево, душу сам смирио и утишао",
            "poem": 1
          },
          {
            "text": "као одојче код мајке своје,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "као одојче у мени је душа моја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "О, Израиљу, Господу се надај",
            "poem": 1
          },
          {
            "text": "од сад па довека!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
