  "book": {
    "id": "PSA",
    "translationId": "srp_onspc",
    "name": "Псалм",
    "commonName": "Псалм",
    "title": "Псалми",
    "order": 19,
    "numberOfChapters": 150,
    "sha256": "26caf786163c3156cd828b9195dd87c0a9678ee51bdea32fbef70df99683a272",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/PSA/1.json",
    "lastChapterNumber": 150,
    "lastChapterApiLink": "/api/srp_onspc/PSA/150.json",
    "totalNumberOfVerses": 2461
  },
  "chapter": {
    "number": 104,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Благосиљај, душо моја, Господа!",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "О, Господе, о, мој Боже, ти си од свих већи;",
            "poem": 1
          },
          {
            "text": "оденут си и сјајем и славом!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Светлошћу је као плаштом заогрнут,",
            "poem": 1
          },
          {
            "text": "као шатор простиреш небеса.",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Греде горњих одаја својих у воде полаже,",
            "poem": 2
          },
          {
            "text": "облаке у кочије своје преже,",
            "poem": 1
          },
          {
            "text": "на крилима ветра језди.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Он своје анђеле чини ветровима,",
            "poem": 1
          },
          {
            "text": "и своје слуге огњеним пламеновима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Он је земљу поставио на њене темеље,",
            "poem": 1
          },
          {
            "text": "у веке векова неће се помаћи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Дубинама си је покрио као покривачем,",
            "poem": 1
          },
          {
            "text": "а воде су јој биле над горама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Повлаче се од прекора твога,",
            "poem": 1
          },
          {
            "text": "одтекле су од тутњаве грома твога –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "када су се горе дигле и долине слегле –",
            "poem": 1
          },
          {
            "text": "тамо где си им и одредио место;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "не прелазе међу што си им ставио,",
            "poem": 1
          },
          {
            "text": "вратити се неће да земљу прекрију.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ти изворе шаљеш долинама",
            "poem": 1
          },
          {
            "text": "да потеку међу планинама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Они поје сваку пољску зверку",
            "poem": 1
          },
          {
            "text": "и жеђ гасе дивљим магарцима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Небеске се птице крај њих гнезде",
            "poem": 1
          },
          {
            "text": "и певају у растињу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Из горњих одаја својих натапаш горе",
            "poem": 1
          },
          {
            "text": "и земља је пуна плода дела твојих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ти чиниш да за стоку трава расте,",
            "poem": 1
          },
          {
            "text": "биље што га човек обрађује,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да би земља уродила хлебом;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "и вино што човеку разгаљује срце,",
            "poem": 1
          },
          {
            "text": "уље што лице озари",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и хлеб што храни човеку срце.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Господња су стабла наливена,",
            "poem": 1
          },
          {
            "text": "кедрови што их је усадио на Ливану;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "на њима се птице гнезде,",
            "poem": 1
          },
          {
            "text": "у чемпресима рода им се скући.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "На високим горама живе дивокозе,",
            "poem": 1
          },
          {
            "text": "а камењари даманима уточиште дају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Он је месец начинио да се мери време,",
            "poem": 1
          },
          {
            "text": "а и сунце зна када да зађе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Ти спушташ таму и ноћ бива,",
            "poem": 1
          },
          {
            "text": "па измиле све шумске живуљке.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Лавови за пленом ричу",
            "poem": 1
          },
          {
            "text": "тражећи од Бога за себе храну.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Кад сунце заруди",
            "poem": 1
          },
          {
            "text": "они се окупе у јазбини својој и лежу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "А човек иде за послом својим",
            "poem": 1
          },
          {
            "text": "и ради до вечери.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "О, Господе, како је много дела твојих!",
            "poem": 1
          },
          {
            "text": "Свако си од њих учинио мудро",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и твојих је створења пуна земља!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Ено мора, великог и широких обала,",
            "poem": 1
          },
          {
            "text": "врве од безбројних створења,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "животиња малих и великих;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "По њему бродови броде",
            "poem": 1
          },
          {
            "text": "и Левијатан",
            "poem": 2
          },
          {
            "noteId": 9
          },
          {
            "text": "кога си начинио у њему игра.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Сви они чекају тебе",
            "poem": 1
          },
          {
            "text": "да им на време даш оно што једу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Ти им дајеш",
            "poem": 1
          },
          {
            "text": "и они то сакупе;",
            "poem": 2
          },
          {
            "text": "ти отвараш руку своју",
            "poem": 1
          },
          {
            "text": "и они су сити добра.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Кад сакријеш лице своје",
            "poem": 1
          },
          {
            "text": "они се препадну;",
            "poem": 2
          },
          {
            "text": "кад им узмеш дах, они скапавају",
            "poem": 1
          },
          {
            "text": "и поново иду у прашину.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Кад им пошаљеш свој дах они настају;",
            "poem": 1
          },
          {
            "text": "ти обнављаш лице земље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Нек довека буде слава Господња!",
            "poem": 1
          },
          {
            "text": "Нек делима својим радује се Господ!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Он у земљу гледа и она се тресе;",
            "poem": 1
          },
          {
            "text": "он дотиче горе и оне се диме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Кроз свој живот певаћу Господу,",
            "poem": 1
          },
          {
            "text": "док ме има Бога мога прослављаћу!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Угодне му биле мисли моје,",
            "poem": 1
          },
          {
            "text": "а ја ћу да се радујем у Господу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Нек грешници нестану са земље",
            "poem": 1
          },
          {
            "text": "и злобника нека више нема!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Благосиљај, душо моја, Господа!",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Славите Господа!",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 9,
        "caller": "+",
        "text": "104,26 Не зна се тачно значење ове речи. Преводи се као кит, крокодил, или морска неман.",
