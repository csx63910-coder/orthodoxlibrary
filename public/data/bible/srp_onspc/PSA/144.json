  },
  "chapter": {
    "number": 144,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Давидов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Благословен да је Господ, стена моја,",
            "poem": 1
          },
          {
            "text": "што ми руке за рат",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и прсте за борбу увежбава;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "милосрђе моје и тврђава моја;",
            "poem": 1
          },
          {
            "text": "моје уточиште и мој избавитељ;",
            "poem": 2
          },
          {
            "text": "мој штит, онај у коме уточиште налазим",
            "poem": 1
          },
          {
            "text": "и који ми мој народ покорава.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "О, Господе, шта је човек да за њега мариш",
            "poem": 1
          },
          {
            "text": "и људски потомак да се са њим бавиш?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Човек тек је даху налик",
            "poem": 1
          },
          {
            "text": "и дани му бледе као сенка.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "О, Господе, небеса своја спусти, па да сиђеш",
            "poem": 1
          },
          {
            "text": "и дотакнеш брда да се пуше!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Засевај муњом,",
            "poem": 1
          },
          {
            "text": "нека се распрше!",
            "poem": 2
          },
          {
            "text": "Стреле своје баци,",
            "poem": 1
          },
          {
            "text": "нека се разбеже!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Са висина руке пружи,",
            "poem": 1
          },
          {
            "text": "избави ме;",
            "poem": 2
          },
          {
            "text": "извади ме из бујица",
            "poem": 1
          },
          {
            "text": "и из руку деце туђинаца;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "оних што устима својим обмањују",
            "poem": 1
          },
          {
            "text": "и десницом својом заклињу се лажно.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "О, Боже, певаћу ти нову песму,",
            "poem": 1
          },
          {
            "text": "на лири са десет струна ја свираћу теби;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "теби који царевима избављење дајеш;",
            "poem": 1
          },
          {
            "text": "који Давида, слугу свога,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "спасаваш од мача опакога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ослободи ме, избави ме",
            "poem": 1
          },
          {
            "text": "из руке деце туђинаца,",
            "poem": 2
          },
          {
            "text": "оних што устима својим обмањују",
            "poem": 1
          },
          {
            "text": "и десницом својом заклињу се лажно.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Тад синови наши нека буду",
            "poem": 1
          },
          {
            "text": "као стабло горостасно у младости својој;",
            "poem": 2
          },
          {
            "text": "наше ћерке нека буду",
            "poem": 1
          },
          {
            "text": "попут шара стубова палате.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Амбари ће наши бити пуни",
            "poem": 1
          },
          {
            "text": "разноврсног рода;",
            "poem": 2
          },
          {
            "text": "хиљаде ће ојагњити овце наше,",
            "poem": 1
          },
          {
            "text": "и десет хиљада по пашњацима нашим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Волови ће теглити, неће бити разарања,",
            "poem": 1
          },
          {
            "text": "неће бити бежаније",
            "poem": 2
          },
          {
            "text": "и вриска се неће чути",
            "poem": 1
          },
          {
            "text": "по трговима нашим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Благо народу коме тако буде!",
            "poem": 1
          },
          {
            "text": "Благо народу коме Бог је Господ!",
            "poem": 2
          }
        ]
      }
    ],
