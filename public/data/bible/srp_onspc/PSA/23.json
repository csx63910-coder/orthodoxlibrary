  "chapter": {
    "number": 23,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Псалам Давидов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Господ је мени Пастир,",
            "poem": 1
          },
          {
            "text": "ни у чему ја не оскудевам.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "На зеленој паши одмара ме,",
            "poem": 1
          },
          {
            "text": "води ме на воде починка.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Душу моју опоравља,",
            "poem": 1
          },
          {
            "text": "води ме стазама праведности,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ради свог имена.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Па да и долином смртне сене ходам,",
            "poem": 1
          },
          {
            "text": "нећу се бојати зла, јер си ти са мном;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "штап твој и палица твоја дају ми утеху.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ти простиреш сто преда мном",
            "poem": 1
          },
          {
            "text": "у присуству мојих душмана,",
            "poem": 2
          },
          {
            "text": "намазао си уљем главу моју,",
            "poem": 1
          },
          {
            "text": "и чаша се моја прелива.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Да, доброта и милост твоја",
            "poem": 1
          },
          {
            "text": "пратиће ме у све дане живота мога",
            "poem": 2
          },
          {
            "text": "и ја ћу становати у Дому Господњем",
            "poem": 1
          },
          {
            "text": "у данима многим.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
