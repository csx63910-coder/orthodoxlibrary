  "chapter": {
    "number": 57,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. Давидов напев: „Не погуби.“ Песма поуздања у Бога, када је пред Саулом побегао у пећину."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Смилуј ми се, Боже, смилуј ми се,",
            "poem": 1
          },
          {
            "text": "јер у теби душа моја уточиште тражи;",
            "poem": 2
          },
          {
            "text": "и у сени твојих крила уточиште тражим",
            "poem": 1
          },
          {
            "text": "док невоље прођу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Вапим Богу Свевишњему,",
            "poem": 1
          },
          {
            "text": "Богу који ми све чини.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Посегнуће са небеса, спашће ме;",
            "poem": 1
          },
          {
            "text": "прекориће тог који ме гази; Села",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "послаће Бог милост своју и верност своју.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Душа ми је међу лавовима,",
            "poem": 1
          },
          {
            "text": "лежим међу прождрљивцима;",
            "poem": 2
          },
          {
            "text": "потомцима људи зуба ко копља и стреле,",
            "poem": 1
          },
          {
            "text": "језика као мача оштрог.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Нека си узвишен врх небеса, Боже;",
            "poem": 1
          },
          {
            "text": "слава твоја нек је над свом земљом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Нози мојој спремили су мрежу,",
            "poem": 1
          },
          {
            "text": "душа ми се повила;",
            "poem": 2
          },
          {
            "text": "испред мене јаму ископаше",
            "poem": 1
          },
          {
            "text": "и у њу сами упадоше. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Срце ми је вољно, Боже,",
            "poem": 1
          },
          {
            "text": "срце ми је вољно, да ти певам,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и да ти свирам!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Пробуди се, биће моје;",
            "poem": 1
          },
          {
            "text": "будите се, о, лиро и харфо,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ја бих зору да пробудим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "О, Господе, хвалићу те међу народима,",
            "poem": 1
          },
          {
            "text": "славићу те међу туђинцима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Јер велика је милост твоја; до небеса,",
            "poem": 1
          },
          {
            "text": "и до облака сеже верност твоја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Нека си узвишен врх небеса, Боже;",
            "poem": 1
          },
          {
            "text": "слава твоја нек је над свом земљом.",
            "poem": 2
          }
        ]
      }
    ],
