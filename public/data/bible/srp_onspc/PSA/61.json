  "chapter": {
    "number": 61,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи на жичаним инструментима. Давидов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Боже, чуј мој вапај;",
            "poem": 1
          },
          {
            "text": "молитву ми добро почуј.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ја те зовем са крајева земље",
            "poem": 1
          },
          {
            "text": "док ми срце клоне;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "поведи ме на стену од мене вишу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Јер ти си ми уточиште,",
            "poem": 1
          },
          {
            "text": "моћна кула испред противника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "У шатору твоме",
            "poem": 1
          },
          {
            "text": "довека бих да пребивам,",
            "poem": 2
          },
          {
            "text": "уточиште да ми буде",
            "poem": 1
          },
          {
            "text": "заклон твојих крила. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Јер ти си, Боже, чуо завете моје;",
            "poem": 1
          },
          {
            "text": "дао си ми наследство оних који стрепе од имена твога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Цару дане на дане надодај,",
            "poem": 1
          },
          {
            "text": "година његових нека буде од нараштаја до нараштаја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Нека га има довека пред Богом,",
            "poem": 1
          },
          {
            "text": "одреди му и милост и верност, нека га чувају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Имену ћу твоме зато славопој да певам довека;",
            "poem": 1
          },
          {
            "text": "да испуним завете своје дан за даном.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
