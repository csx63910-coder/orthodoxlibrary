  "chapter": {
    "number": 65,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. Псалам Давидов. Песма."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Боже, на Сиону те хвала очекује,",
            "poem": 1
          },
          {
            "text": "теби дани завет испуњен ће бити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Теби, што чујеш молитву,",
            "poem": 1
          },
          {
            "text": "сваки човек стиже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Кривице ме надвладаше,",
            "poem": 1
          },
          {
            "text": "ти опрости преступе нам наше.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Како је блажен изабраник, онај ког привучеш,",
            "poem": 1
          },
          {
            "text": "што пребива у твојим двориштима.",
            "poem": 2
          },
          {
            "text": "Сити били од добара Дома твога,",
            "poem": 1
          },
          {
            "text": "од твог светог храма.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Чудесним и праведним делима си нас услишио,",
            "poem": 1
          },
          {
            "text": "Боже спасења нашег,",
            "poem": 2
          },
          {
            "text": "поуздање свих крајева земље",
            "poem": 1
          },
          {
            "text": "и мора далеких.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ти си снагом својом основао горе,",
            "poem": 1
          },
          {
            "text": "силом си се опасао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ти стишаваш хук мора,",
            "poem": 1
          },
          {
            "text": "хук таласа њихових",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и вреву народа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Преплашише се од чудеса твојих становници свих крајева;",
            "poem": 1
          },
          {
            "text": "и јутро и вече од радости кличу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Земљом пролазиш и натапаш је;",
            "poem": 1
          },
          {
            "text": "изобилно ти је гиздаш потоцима Божијим пуним воде;",
            "poem": 2
          },
          {
            "text": "за жито се њено бринеш.",
            "poem": 1
          },
          {
            "text": "Ето, то си тако уредио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Бразде јој натапаш,",
            "poem": 1
          },
          {
            "text": "орање јој поравнаваш;",
            "poem": 2
          },
          {
            "text": "пљусковима омекшаваш",
            "poem": 1
          },
          {
            "text": "и њен урод благосиљаш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Годину си окрунио уродом својим,",
            "poem": 1
          },
          {
            "text": "стазе твоје кипе изобиљем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Бујају пашњаци пустињски,",
            "poem": 1
          },
          {
            "text": "весељем се брда опасују.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Стадима се облаче пашњаци,",
            "poem": 1
          },
          {
            "text": "долине се огрћу пшеницом,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "па певају, па још ускликују.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
