  "chapter": {
    "number": 78,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Асафова поучна песма."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "О, народе мој, послушај поуку моју",
            "poem": 1
          },
          {
            "text": "и речима мојих уста ухо приклоните!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Мој говор биће у причи,",
            "poem": 1
          },
          {
            "text": "објавићу загонетке од давнина.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Оно што смо чули, оно што смо научили",
            "poem": 1
          },
          {
            "text": "и што су нам стари наши испричали;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "то нећемо да кријемо од њихове деце.",
            "poem": 1
          },
          {
            "text": "Објавићемо новом нараштају хвале Господње,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "његову силу и чудеса која је учинио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Он је у Јакову учврстио сведочанство,",
            "poem": 1
          },
          {
            "text": "Израиљу је дао Закон",
            "poem": 2
          },
          {
            "text": "и заповедио нашим прецима",
            "poem": 1
          },
          {
            "text": "да их предају својим потомцима,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "да би нови нараштај знао,",
            "poem": 1
          },
          {
            "text": "деца што ће се родити,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "па кад одрасту да то пренесу деци својој;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "да се у Бога поуздају,",
            "poem": 1
          },
          {
            "text": "да дела Божија не заборављају",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и заповести његове да извршавају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Да не буду ко њихови стари,",
            "poem": 1
          },
          {
            "text": "нараштај бунтовни,",
            "poem": 2
          },
          {
            "text": "непослушно поколење несталнога срца",
            "poem": 1
          },
          {
            "text": "и духа коју није веран Богу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Јефремовци су били луковима наоружани",
            "poem": 1
          },
          {
            "text": "али су побегли на дан боја!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Нису одржали савез са Богом,",
            "poem": 1
          },
          {
            "text": "одбили су да поступе по његовом Закону.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Заборавили су његова дела,",
            "poem": 1
          },
          {
            "text": "чудеса његова која им је показао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "А он је пред њиховим прецима учинио чудо,",
            "poem": 1
          },
          {
            "text": "у египатској земљи, у области Соан.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Море је разделио и провео их,",
            "poem": 1
          },
          {
            "text": "воде је усправио да су попут зида.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Дању их је водио облаком",
            "poem": 1
          },
          {
            "text": "и светлошћу ватре целе ноћи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Стене је у пустињи расцепио,",
            "poem": 1
          },
          {
            "text": "обилно их напојио као из дубина.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Брзаке им је извео из раселине стене,",
            "poem": 1
          },
          {
            "text": "учинио да им воде као реке теку.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "А они су му упорно грешили,",
            "poem": 1
          },
          {
            "text": "пркосили Свевишњем у пустињи;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "у срцима кушали су Бога,",
            "poem": 1
          },
          {
            "text": "извољевали тражећи храну.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Приговарали су Богу и рекли:",
            "poem": 1
          },
          {
            "text": "„Кадар ли је Бог да у пустињи простре трпезу?!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Јесте, стену је ударио,",
            "poem": 1
          },
          {
            "text": "потекла је вода и потоци се разлили.",
            "poem": 2
          },
          {
            "text": "Али кадар ли је да нам да и храну,",
            "poem": 1
          },
          {
            "text": "да свој народ месом снабде?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Зато се Господ разјарио када је то чуо,",
            "poem": 1
          },
          {
            "text": "па је пожар плануо на Јакова",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и гнев је букнуо на Израиљ;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "јер у Бога веровали нису,",
            "poem": 1
          },
          {
            "text": "нису се поуздали да ће да их спасе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "И он је заповедио облацима",
            "poem": 1
          },
          {
            "text": "и отворио одгоре врата небеска,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "да их запљусне мана,",
            "poem": 1
          },
          {
            "text": "даде им жито са неба да једу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "И сви су јели хлеб моћника,",
            "poem": 1
          },
          {
            "text": "обиље хране им је послао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Довео је источни ветар са небеса,",
            "poem": 1
          },
          {
            "text": "донео је јужни ветар снагом својом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Месом их је ко прашином засуо",
            "poem": 1
          },
          {
            "text": "и крилатим птицама као морским песком.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Дао је да падају по њиховом табору,",
            "poem": 1
          },
          {
            "text": "око њихових шатора.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "И они су јели, најели се до ситости,",
            "poem": 1
          },
          {
            "text": "јер он им је дао како су жудели.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Али још их жудња није прошла",
            "poem": 1
          },
          {
            "text": "и још им је храна у устима била,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "када се гнев Божији дигао на њих.",
            "poem": 1
          },
          {
            "text": "И он поби њихове најјаче",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и обори младиће Израиља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "И поред тога опет су грешили,",
            "poem": 1
          },
          {
            "text": "нису веровали његовим чудима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Узалудне дане им је прекратио",
            "poem": 1
          },
          {
            "text": "и невољом наглом њихове године.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "А кад их је убијао, тражили су га",
            "poem": 1
          },
          {
            "text": "и враћали се, за Богом чезнули.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Тада би се присетили да им је Бог био стена,",
            "poem": 1
          },
          {
            "text": "Бог Свевишњи њихов Откупитељ!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Али би га устима варали",
            "poem": 1
          },
          {
            "text": "и лагали језицима својим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Срцем му нису били одани,",
            "poem": 1
          },
          {
            "text": "нису били верни његовом савезу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "Ипак, он се смиловао,",
            "poem": 1
          },
          {
            "text": "кривицу им опраштао",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и није их уништио.",
            "poem": 2
          },
          {
            "text": "Упорно је суспрезао гнев свој,",
            "poem": 1
          },
          {
            "text": "љутњу своју није подстицао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          {
            "text": "Сећао се да су тело,",
            "poem": 1
          },
          {
            "text": "да су дах што испарава",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и што се не враћа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          {
            "text": "А како су се често бунили у пустињи",
            "poem": 1
          },
          {
            "text": "и жалостили га у пустари!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          {
            "text": "Упорно су искушавали Бога,",
            "poem": 1
          },
          {
            "text": "вређали су Светитеља Израиљевог.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          {
            "text": "Нису се сећали његове руке",
            "poem": 1
          },
          {
            "text": "и дана када их је откупио од тлачитеља,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          {
            "text": "када је у Египту знакове своје извео",
            "poem": 1
          },
          {
            "text": "и чудеса своја у области Соан.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          {
            "text": "Реке је њихове у крв претворио,",
            "poem": 1
          },
          {
            "text": "а њихови се потоци нису могли пити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          {
            "text": "На њих је послао комарце, да их уједају,",
            "poem": 1
          },
          {
            "text": "жабе да их упропасте.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          {
            "text": "Усеве њихове даде гусеницама",
            "poem": 1
          },
          {
            "text": "и скакавцима сав труд њихов.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          {
            "text": "Градом им је стукао винограде,",
            "poem": 1
          },
          {
            "text": "а смокве сланом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          {
            "text": "Стоку им је граду изложио",
            "poem": 1
          },
          {
            "text": "и њихова говеда муњама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          {
            "text": "Послао је на њих врелину свог гнева,",
            "poem": 1
          },
          {
            "text": "срџбу и јарост,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "невољу и чету анђела пропасти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          {
            "text": "Свом је гневу стазу припремио",
            "poem": 1
          },
          {
            "text": "и живот им од смрти поштедео није,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "живот им је помору предао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 51,
        "content": [
          {
            "text": "Побио је све првенце у Египту,",
            "poem": 1
          },
          {
            "text": "прве од мушких у шаторима Хамовим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 52,
        "content": [
          {
            "text": "Свој је народ извео ко овце,",
            "poem": 1
          },
          {
            "text": "водио их попут стада кроз пустињу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 53,
        "content": [
          {
            "text": "Водио их је сигурно и плашили се нису,",
            "poem": 1
          },
          {
            "text": "а њихове душмане је преплавило море.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 54,
        "content": [
          {
            "text": "Тада их је довео на своје свето тло,",
            "poem": 1
          },
          {
            "text": "на ову гору, освојену његовом десницом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 55,
        "content": [
          {
            "text": "Пред њима је отерао народе,",
            "poem": 1
          },
          {
            "text": "доделио им је размерено наследство",
            "poem": 2
          },
          {
            "text": "и настанио племена Израиља",
            "poem": 1
          },
          {
            "text": "по њиховим шаторима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 56,
        "content": [
          {
            "text": "Али они су поново искушавали",
            "poem": 1
          },
          {
            "text": "и бунили се против Бога Свевишњега,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "прописе његови нису држали.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 57,
        "content": [
          {
            "text": "Окренули су се, изневерили попут очева својих,",
            "poem": 1
          },
          {
            "text": "издали су као лук сломљени.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 58,
        "content": [
          {
            "text": "Изазивали су га својим жртвеним бреговима,",
            "poem": 1
          },
          {
            "text": "чинили га љубоморним својим идолима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 59,
        "content": [
          {
            "text": "Бог је то чуо, разјарио се",
            "poem": 1
          },
          {
            "text": "и сасвим одбацио Израиљ,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 60,
        "content": [
          {
            "text": "па је напустио Пребивалиште у Силому,",
            "poem": 1
          },
          {
            "text": "стан који је подигао међу људима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 61,
        "content": [
          {
            "text": "Тако је ропству препустио снагу своју",
            "poem": 1
          },
          {
            "text": "и своју красоту рукама душмана.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 62,
        "content": [
          {
            "text": "И народ је свој он предао мачу",
            "poem": 1
          },
          {
            "text": "јер се разјарио на своје наследство.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 63,
        "content": [
          {
            "text": "Његове младиће прождрала је ватра,",
            "poem": 1
          },
          {
            "text": "па су му девице ко уседелице.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 64,
        "content": [
          {
            "text": "Од мача су му свештеници пали,",
            "poem": 1
          },
          {
            "text": "а удовице их ожалиле нису.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 65,
        "content": [
          {
            "text": "Пробуди се тада Господ ко да је спавао,",
            "poem": 1
          },
          {
            "text": "као јунак којега је савладало вино!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 66,
        "content": [
          {
            "text": "Душмане је своје назад одвукао",
            "poem": 1
          },
          {
            "text": "и довека их осрамотио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 67,
        "content": [
          {
            "text": "Јосифов је шатор одбацио,",
            "poem": 1
          },
          {
            "text": "племе Јефремово није изабрао,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 68,
        "content": [
          {
            "text": "већ је изабрао Јудино племе",
            "poem": 1
          },
          {
            "text": "и гору Сион коју заволи!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 69,
        "content": [
          {
            "text": "И ту је подигао Светилиште своје, високо ко небо,",
            "poem": 1
          },
          {
            "text": "попут земље довека га учврстио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 70,
        "content": [
          {
            "text": "Изабрао је свог слугу Давида,",
            "poem": 1
          },
          {
            "text": "узео га је од стада оваца.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 71,
        "content": [
          {
            "text": "Довео га је од оваца дојилица да напаса Јакова, његов народ",
            "poem": 1
          },
          {
            "text": "и Израиљ, његово наследство.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 72,
        "content": [
          {
            "text": "И он им је Пастир био по честитости свога срца,",
            "poem": 1
          },
          {
            "text": "водио их је својим умешним рукама.",
            "poem": 2
          }
        ]
      }
    ],
