  },
  "chapter": {
    "number": 74,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Асафова поучна песма."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Зашто си нас, о, Боже, одбацио довека?",
            "poem": 1
          },
          {
            "text": "Зашто да се јарост твоја пуши на стадо твоје паше?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Присети се своје заједнице што си је од давнина стекао,",
            "poem": 1
          },
          {
            "text": "племена свога наследства које си откупио –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "горе Сион на којој си пребивао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Кораке своје окрени ка руинама вечним,",
            "poem": 1
          },
          {
            "text": "свему чему је наудио противник у Светињи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Душмани твоји ричу усред твог места састанка,",
            "poem": 1
          },
          {
            "text": "поставише заставе своје за знакове.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Познати су као човек",
            "poem": 1
          },
          {
            "text": "што секиру на шипражје диже;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "и онда секиром и полугама",
            "poem": 1
          },
          {
            "text": "све резбарије ломи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Светилиште твоје до тла спалише,",
            "poem": 1
          },
          {
            "text": "опоганише Пребивалиште имена твог.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "У срцу су своме рекли: „Хајде да их сасвим потлачимо!“",
            "poem": 1
          },
          {
            "text": "Спалили су сва Божија места састанка у земљи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "А наше знакове видели нисмо,",
            "poem": 1
          },
          {
            "text": "ни пророка још нема,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и никога с нама ко би знао – докле?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Докле ће се, о, Боже, ругати душманин?",
            "poem": 1
          },
          {
            "text": "Хоће ли противник довека твоје име да презире?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Зашто руку своју, баш своју десницу, повлачиш?",
            "poem": 1
          },
          {
            "text": "Из недара својих извуци је и сатри их!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "А Бог цар мој је од давнина,",
            "poem": 1
          },
          {
            "text": "посред земље спасоносна дела чини.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Силом својом ти си море разделио,",
            "poem": 1
          },
          {
            "text": "у водама смрскао си главе морским неманима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Левијатану си главе раздробио,",
            "poem": 1
          },
          {
            "text": "народима уз обалу за храну си га дао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ти си дао да набуја и врело и поток,",
            "poem": 1
          },
          {
            "text": "ти си непресушне пресушио реке.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Твој је дан, баш као и ноћ;",
            "poem": 1
          },
          {
            "text": "ти си поставио и месец и сунце.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ти си земљи одредио сваку међу;",
            "poem": 1
          },
          {
            "text": "и лето и зиму начинио ти си.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Сети се тог противника који те презире, Господе,",
            "poem": 1
          },
          {
            "text": "и безумних што презиру ти име.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Не дај звери живот голубице своје,",
            "poem": 1
          },
          {
            "text": "довека не заборави на живот својих сиромаха.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Погледај на савез,",
            "poem": 1
          },
          {
            "text": "јер се мрачни крајеви земље напунише местима насиља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Не дај угњетеном да се понижен врати,",
            "poem": 1
          },
          {
            "text": "нека име твоје славе и сиромах и убоги.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Устани, о, Боже, свој случај одбрани!",
            "poem": 1
          },
          {
            "text": "Сети се презира безумног према теби од јутра до сутра.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Не заборави глас душмана својих,",
            "poem": 1
          },
          {
            "text": "поклич што се непрестано диже,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "оних што се против тебе буне.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
