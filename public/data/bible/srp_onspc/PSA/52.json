  "chapter": {
    "number": 52,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. Давидова поучна песма, када је Доик Едомац дошао и дојавио Саулу, рекавши му: „Давид је отишао у Ахимелекову кућу.“"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Што се хвалиш злобом, силниче?",
            "poem": 1
          },
          {
            "text": "Милост је Божија од јутра до сутра.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Разарања ти смишља језик",
            "poem": 1
          },
          {
            "text": "попут бритве оштар,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "о, превртљивче!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ти зло волиш више него добро,",
            "poem": 1
          },
          {
            "text": "и лаж више него право да говориш. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ти волиш све речи прождрљиве,",
            "poem": 1
          },
          {
            "text": "о, језиче обмањиви!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Али тебе ће Бог довека оборити;",
            "poem": 1
          },
          {
            "text": "зграбиће те, од шатора отргнути;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "из земље живих ишчупаће те. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "И видеће то праведници и бојаће се,",
            "poem": 1
          },
          {
            "text": "па ће му се смејати:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "„Гле човека што Бога није узео за тврђаву,",
            "poem": 1
          },
          {
            "text": "рушитеља силног,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "што се поуздао у обиље свога блага!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "А ја сам као зелена маслина",
            "poem": 1
          },
          {
            "text": "у Дому Божијем;",
            "poem": 2
          },
          {
            "text": "у милост се Божију уздам",
            "poem": 1
          },
          {
            "text": "од века до века.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Хвалићу те у веке векова",
            "poem": 1
          },
          {
            "text": "за дела твоја;",
            "poem": 2
          },
          {
            "text": "надаћу се имену твоме",
            "poem": 1
          },
          {
            "text": "јер је добро пред твојим вернима.",
            "poem": 2
          }
        ]
      }
    ],
