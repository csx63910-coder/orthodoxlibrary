    "lastChapterApiLink": "/api/srp_onspc/PSA/150.json",
    "totalNumberOfVerses": 2461
  },
  "chapter": {
    "number": 71,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "У теби је уточиште моје, Господе;",
            "poem": 1
          },
          {
            "text": "о, да се никад не постидим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ослободи ме по својој праведности и избави ме,",
            "poem": 1
          },
          {
            "text": "пригни ухо своје к мени и спаси ме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Буди ми стена пребивалишта",
            "poem": 1
          },
          {
            "text": "којој увек долазим;",
            "poem": 2
          },
          {
            "text": "спасење моје ти си заповедио,",
            "poem": 1
          },
          {
            "text": "јер си моја стена и тврђава.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Избави ме, Боже мој, из руке зликовачке,",
            "poem": 1
          },
          {
            "text": "од руке преступника и окрутнога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Јер, ти си моја нада, о, Боже Господе,",
            "poem": 1
          },
          {
            "text": "поуздање си ми од младости моје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "На тебе се ослањам од утробе,",
            "poem": 1
          },
          {
            "text": "из крила мајке моје си ме извукао;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "славићу те непрестано.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Попут знака постао сам многима,",
            "poem": 1
          },
          {
            "text": "а ти си ми уточиште јако.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Уста си ми славом својом испунио",
            "poem": 1
          },
          {
            "text": "и красотом својом од јутра до сутра.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Не одбаци ме у доба старости,",
            "poem": 1
          },
          {
            "text": "кад ми снага клоне не заборави ме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Јер о мени говоре противници моји,",
            "poem": 1
          },
          {
            "text": "они што ми живот вребају",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "заједно се саветују.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Кажу: „Бог је њега оставио!",
            "poem": 1
          },
          {
            "text": "Гоните га, ухватите,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер избавитеља нема!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Боже, од мене се не удаљуј!",
            "poem": 1
          },
          {
            "text": "О, мој Боже, пожури ми у помоћ!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Нека се постиде и нека пропадну",
            "poem": 1
          },
          {
            "text": "тужитељи моје душе;",
            "poem": 2
          },
          {
            "text": "и презир и брука нек покрију",
            "poem": 1
          },
          {
            "text": "оне који ми о глави раде.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "А ја ћу увек да се надам,",
            "poem": 1
          },
          {
            "text": "све више и више славићу те.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Уста ће моја о праведности твојој да говоре,",
            "poem": 1
          },
          {
            "text": "о делима твог спасења од јутра до сутра,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер им броја не знам.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "У моћним делима Бога Господа ја ћу доћи,",
            "poem": 1
          },
          {
            "text": "твоју праведност ћу спомињати, само твоју.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Од младости моје, Боже, ти си ме учио;",
            "poem": 1
          },
          {
            "text": "и чудеса твоја досад јављао сам.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Чак и када остарим и оседим,",
            "poem": 1
          },
          {
            "text": "Боже, не остављај ме,",
            "poem": 2
          },
          {
            "text": "док ти силу не објавим нараштају новом;",
            "poem": 1
          },
          {
            "text": "силу твоју сваком што долази.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Праведност је твоја, Боже, до висина,",
            "poem": 1
          },
          {
            "text": "велика си дела учинио;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ко је попут тебе, Боже?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Ти – дао си да гледам многе невоље и муке –",
            "poem": 1
          },
          {
            "text": "ти ћеш ми опет обновити живот;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "из дубина земље подићеш ме опет.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Ти ојачај достојанство моје",
            "poem": 1
          },
          {
            "text": "и поново утеши ме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "И ја ћу харфом да те хвалим",
            "poem": 1
          },
          {
            "text": "због верности твоје;",
            "poem": 2
          },
          {
            "text": "Боже мој, свираћу ти на лири,",
            "poem": 1
          },
          {
            "text": "Светитељу Израиљев.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Клицаће радосно усне моје,",
            "poem": 1
          },
          {
            "text": "јер ћу ти свирати,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и душа моја што си је откупио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "И мој ће језик од јутра до сутра",
            "poem": 1
          },
          {
            "text": "причати о твојој праведности;",
            "poem": 2
          },
          {
            "text": "јер ће се постидети, јер ће се осрамотити",
            "poem": 1
          },
          {
            "text": "ти што ми о глави раде.",
            "poem": 2
          }
        ]
      }
    ],
