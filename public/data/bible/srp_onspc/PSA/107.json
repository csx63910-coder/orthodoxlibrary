  "book": {
    "id": "PSA",
    "translationId": "srp_onspc",
    "name": "Псалм",
    "commonName": "Псалм",
    "title": "Псалми",
    "order": 19,
    "numberOfChapters": 150,
    "sha256": "26caf786163c3156cd828b9195dd87c0a9678ee51bdea32fbef70df99683a272",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/PSA/1.json",
    "lastChapterNumber": 150,
    "lastChapterApiLink": "/api/srp_onspc/PSA/150.json",
    "totalNumberOfVerses": 2461
  },
  "chapter": {
    "number": 107,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Хвалите Господа јер је добар,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Нек говоре тако они што их је Господ откупио,",
            "poem": 1
          },
          {
            "text": "они откупљени из руке душмана;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "које је окупио из земаља истока и запада,",
            "poem": 1
          },
          {
            "text": "са севера и с мора.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Тек, тумарали су по пустињи,",
            "poem": 1
          },
          {
            "text": "по беспућу и нису нашли место да се скрасе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "А били су и гладни и жедни,",
            "poem": 1
          },
          {
            "text": "душу своју да испусте.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Господу су завапили у чемеру своме",
            "poem": 1
          },
          {
            "text": "и он их је избавио од њихових мука!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Равним путем их је повео",
            "poem": 1
          },
          {
            "text": "да се скрасе, да се скуће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Нек Господа они хвале за његову милост,",
            "poem": 1
          },
          {
            "text": "за чудеса над потомцима људи!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Јер он поји грло жедном,",
            "poem": 1
          },
          {
            "text": "добрим сити душу гладном.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Чаме у мраку, у тами;",
            "poem": 1
          },
          {
            "text": "оковани и бедом и гвожђем;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "јер Божијим речима пркосе,",
            "poem": 1
          },
          {
            "text": "презрели су савет Свевишњега.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "А он им је патњом срца понизио;",
            "poem": 1
          },
          {
            "text": "срљали су, а помоћи ниоткуда.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Господу су завапили у чемеру своме",
            "poem": 1
          },
          {
            "text": "и он их је спасао од њихових мука!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Извео их је из мрака, из таме,",
            "poem": 1
          },
          {
            "text": "окове им поломио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Нек Господа они хвале за његову милост,",
            "poem": 1
          },
          {
            "text": "за чудеса над потомцима људи!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Јер је он разбио бронзана врата,",
            "poem": 1
          },
          {
            "text": "изломио гвоздене вратнице.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Побудалише због својих преступничких путева,",
            "poem": 1
          },
          {
            "text": "мучише се због својих кривица.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Души им се сва храна згадила",
            "poem": 1
          },
          {
            "text": "и до самих врата смрти су пристигли.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Господу су завапили у чемеру своме",
            "poem": 1
          },
          {
            "text": "и он их је спасао од њихових мука!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Реч своју им је послао, па су оздравили;",
            "poem": 1
          },
          {
            "text": "из рака њихових их је извукао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Нек Господа они хвале за његову милост,",
            "poem": 1
          },
          {
            "text": "за чудеса над потомцима људи!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Нек жртвују жртве захвалнице;",
            "poem": 1
          },
          {
            "text": "нек му дела објављују, нека кличу!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Они што су морем бродовима пловили,",
            "poem": 1
          },
          {
            "text": "што су трговали на великим водама;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "они су видели дела Господња,",
            "poem": 1
          },
          {
            "text": "његова чудеса у дубини;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "када је заповедио, ветру наредио",
            "poem": 1
          },
          {
            "text": "да таласе мора олуја подигне.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "И они се дижу до небеса,",
            "poem": 1
          },
          {
            "text": "ломе се до дубина,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "па им се душа топи од зебње.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Љуљају се, тетурају ко пијани,",
            "poem": 1
          },
          {
            "text": "нестаје им сва вештина.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Господу су завапили у чемеру своме",
            "poem": 1
          },
          {
            "text": "и он их је извео из њихових мука!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Олују је умирио",
            "poem": 1
          },
          {
            "text": "и таласи мора утихнуше.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "А када се стишају, поморци се радују;",
            "poem": 1
          },
          {
            "text": "он их води до жељене луке.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Нек Господа они хвале за његову милост,",
            "poem": 1
          },
          {
            "text": "за чудеса над потомцима људи!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Нека га уздижу на народном сабору",
            "poem": 1
          },
          {
            "text": "и нека га славе у старешинском збору!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Он претвара реке у пустињу,",
            "poem": 1
          },
          {
            "text": "врела воде у тло спарушено;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "плодну земљу у слатину",
            "poem": 1
          },
          {
            "text": "због зла оних који на њој живе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Од пустиње он језеро чини,",
            "poem": 1
          },
          {
            "text": "од земље пусте водене изворе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Ту је гладне населио",
            "poem": 1
          },
          {
            "text": "и они су град подигли;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "поља су засејали, винограде посадили",
            "poem": 1
          },
          {
            "text": "и они обиље плодова рађају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "И он их је благословио",
            "poem": 1
          },
          {
            "text": "па су се веома умножили;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ни стока им се проредила није.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          {
            "text": "Али због тлачења, невоље и јада",
            "poem": 1
          },
          {
            "text": "они се проредише, погурише.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          {
            "text": "Он излива презир на племиће,",
            "poem": 1
          },
          {
            "text": "пушта да тумарају пустаром беспутном;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          {
            "text": "док убогог уздиже, од невоље склања,",
            "poem": 1
          },
          {
            "text": "попут стада његов пород множи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          {
            "text": "Виде то праведни па се радују,",
            "poem": 1
          },
          {
            "text": "а сви неправедни затварају своја уста.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          {
            "text": "Ко је мудар? Тај нек ово памти,",
            "poem": 1
          },
          {
            "text": "у Господњу милост нек прониче!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
