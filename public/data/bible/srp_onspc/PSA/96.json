  },
  "chapter": {
    "number": 96,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Певајте Господу нову песму!",
            "poem": 1
          },
          {
            "text": "Певај Господу, сва земљо!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Певајте Господу и име му благосиљајте;",
            "poem": 1
          },
          {
            "text": "дан за даном навешћујте његово спасење.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Објавите му славу међу пуцима,",
            "poem": 1
          },
          {
            "text": "његова чудеса међу свим народима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Јер велик је Господ, многе хвале вредан;",
            "poem": 1
          },
          {
            "text": "страшнији од свих богова.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Јер ништавни су сви богови народа,",
            "poem": 1
          },
          {
            "text": "али Господ је саздао небеса.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Пред њим су слава и величанство,",
            "poem": 1
          },
          {
            "text": "сила и лепота у његовом Светилишту.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Дајте Господу, племена народна,",
            "poem": 1
          },
          {
            "text": "дајте Господу славу и силу,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "дајте Господу славу ради његовог имена,",
            "poem": 1
          },
          {
            "text": "донесите му принос, дођите у његова дворишта,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "клањајте се Господу сјајном у светости,",
            "poem": 1
          },
          {
            "text": "дрхти пред њим, сва земљо!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Говорите међу народима: „Господ влада!",
            "poem": 1
          },
          {
            "text": "Чврсто стоји свет, неће се пољуљати.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Он праведно суди народима.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Нека се радују небеса, нека се весели земља,",
            "poem": 1
          },
          {
            "text": "Нека хучи море и све што је у њему,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "нек се радује поље и све што је на њему.",
            "poem": 1
          },
          {
            "text": "Тада ће певати шумско дрвеће",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "пред Господом, јер он долази да суди земљи.",
            "poem": 1
          },
          {
            "text": "Он ће да суди свету по правди,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "народима по верности својој.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
