  "chapter": {
    "number": 138,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Давидов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Хвалићу те од свег срца,",
            "poem": 1
          },
          {
            "text": "пред боговима певаћу ти славопоје!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Клањаћу се у Дому светости твоје;",
            "poem": 1
          },
          {
            "text": "хвалићу име твоје за милост твоју и истину твоју;",
            "poem": 2
          },
          {
            "text": "за обећање твоје, за реч твоју",
            "poem": 1
          },
          {
            "text": "што је изнад свег имена свога диже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "На дан када сам вапио, ти си ме услишио;",
            "poem": 1
          },
          {
            "text": "смелост си ми дао, душу ојачао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Нек те хвале, о, Господе, сви цареви земље,",
            "poem": 1
          },
          {
            "text": "када чују речи твојих уста!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Опеваће путеве Господње,",
            "poem": 1
          },
          {
            "text": "јер је слава Господња велика.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Узвишен је Господ али гледа пониженог,",
            "poem": 1
          },
          {
            "text": "а бахатог надалеко препознаје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Макар се и нашао усред невоље,",
            "poem": 1
          },
          {
            "text": "живот ћеш ми сачувати;",
            "poem": 2
          },
          {
            "text": "на бес мога противника испружићеш руку своју,",
            "poem": 1
          },
          {
            "text": "спашће мене десна рука твоја!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Господ ће ме осветити!",
            "poem": 1
          },
          {
            "text": "О, Господе, милост твоја је довека;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "дела својих руку не напуштај!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
