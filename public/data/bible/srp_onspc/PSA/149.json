  "chapter": {
    "number": 149,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Славите Господа!",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Нову песму запевајте Господу",
            "poem": 1
          },
          {
            "text": "и његове хвалоспеве у збору верника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Нек Израиљ радује се своме Створитељу!",
            "poem": 1
          },
          {
            "text": "Нека кличе своме Цару народ са Сиона!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Нек му име славе играјући коло,",
            "poem": 1
          },
          {
            "text": "нек му засвирају на бубњу и лири.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Јер Господу је његов народ мио,",
            "poem": 1
          },
          {
            "text": "он понизне овенчава спасењем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Нека народ верни ликује у части!",
            "poem": 1
          },
          {
            "text": "Нека кличу са лежаја својих!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "У грлима нек им буду хвалоспеви Божији,",
            "poem": 1
          },
          {
            "text": "у рукама им мач с обе стране оштар;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "да се освете народима",
            "poem": 1
          },
          {
            "text": "и донесу казну туђинцима;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "да ланцима цареве им свежу",
            "poem": 1
          },
          {
            "text": "и окују гвожђем њихове племиће;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "да на њима изврше записану пресуду,",
            "poem": 1
          },
          {
            "text": "што је на част свих његових верних.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Славите Господа!",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
