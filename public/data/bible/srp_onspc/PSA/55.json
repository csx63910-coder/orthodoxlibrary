  "chapter": {
    "number": 55,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи, уз жичане инструменте. Давидова поучна песма."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Послушај, Боже, молитву моју;",
            "poem": 1
          },
          {
            "text": "од моје се молбе не сакривај.",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Добро ме почуј и услиши ме.",
            "poem": 2
          },
          {
            "text": "Неспокојан сам и сметен у жалопојци својој;",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "од гласа противника,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "због притиска зликовца,",
            "poem": 2
          },
          {
            "text": "јер навалише на мене невољу",
            "poem": 1
          },
          {
            "text": "и у гневу замрзеше ме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "У мени је срце моје устрептало",
            "poem": 1
          },
          {
            "text": "и смртни ужас на мене је пао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Страх и стрепња дошли су на мене,",
            "poem": 1
          },
          {
            "text": "језа ме је опхрвала.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Говорим: „Ко ће ми дати крила голубице?",
            "poem": 1
          },
          {
            "text": "Ја бих да одлетим и скрасим се.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Баш далеко ја бих одлетео,",
            "poem": 1
          },
          {
            "text": "скрасио се у пустињи. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Похитаћу у склониште своје,",
            "poem": 1
          },
          {
            "text": "због ветра што ковитла и због олује.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Смети их, Господе,",
            "poem": 1
          },
          {
            "text": "језик им расцепи;",
            "poem": 2
          },
          {
            "text": "јер видим насиље",
            "poem": 1
          },
          {
            "text": "и сукоб у граду.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Дан и ноћ зидине му обилазе,",
            "poem": 1
          },
          {
            "text": "у њему су злоба и страдање.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "У њему је разарање,",
            "poem": 1
          },
          {
            "text": "с тргова му не нестају тлачење и превара.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Јер није непријатељ тај који ме вређа –",
            "poem": 1
          },
          {
            "text": "ја бих то претрпео;",
            "poem": 2
          },
          {
            "text": "ни онај што ме мрзи није тај који ми чини шта велико –",
            "poem": 1
          },
          {
            "text": "од њега бих се ја сакрио;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "већ ти – човек мени раван –",
            "poem": 1
          },
          {
            "text": "пријатељ мој блиски који ме познаје;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "са ким сам се радо саветовао,",
            "poem": 1
          },
          {
            "text": "у Дом Божији ишао у мноштву.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Смрт нека их заскочи;",
            "poem": 1
          },
          {
            "text": "у Свет мртвих нека живи оду,",
            "poem": 2
          },
          {
            "text": "јер је зло тамо где бораве,",
            "poem": 1
          },
          {
            "text": "у њима самима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ја ћу Бога да зазовем",
            "poem": 1
          },
          {
            "text": "и Господ ће да ме спасе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Јадаћу се, уздисаћу увече, ујутро и у подне;",
            "poem": 1
          },
          {
            "text": "и он мој глас чуће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Откупиће у миру душу моју",
            "poem": 1
          },
          {
            "text": "из боја против мене,",
            "poem": 2
          },
          {
            "text": "јер је много оних",
            "poem": 1
          },
          {
            "text": "што ми се противе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Чуће Бог,",
            "poem": 1
          },
          {
            "text": "понизиће их онај што столује од давнина; Села",
            "poem": 2
          },
          {
            "text": "оне што се не мењају",
            "poem": 1
          },
          {
            "text": "и који се Бога не боје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Своју руку диже на оне с којима је у миру,",
            "poem": 1
          },
          {
            "text": "свој савез раскида.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Уста су му мека као масло,",
            "poem": 1
          },
          {
            "text": "а рат му је у срцу;",
            "poem": 2
          },
          {
            "text": "речи су му од уља мекше,",
            "poem": 1
          },
          {
            "text": "а ипак су мачеви исукани.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "На Господа товар свој пребаци",
            "poem": 1
          },
          {
            "text": "и он ће те подржати;",
            "poem": 2
          },
          {
            "text": "праведнику неће дати",
            "poem": 1
          },
          {
            "text": "никад да се затетура.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "А ти ћеш их, Боже, оборити у ждрело, у јаму;",
            "poem": 1
          },
          {
            "text": "крволоци и варалице ни половину својих дана доживети неће.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "А ја се у тебе уздам.",
            "poem": 1
          }
        ]
      }
    ],
