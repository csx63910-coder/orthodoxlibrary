  "chapter": {
    "number": 17,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Давидова молитва."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Чуј, Господе, праведности ради,",
            "poem": 1
          },
          {
            "text": "окрени се к моме вапају,",
            "poem": 2
          },
          {
            "text": "пригни ухо мојој молитви,",
            "poem": 1
          },
          {
            "text": "јер на мојим уснама нема преваре.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Нек ми суд с твога лица дође;",
            "poem": 1
          },
          {
            "text": "твоје очи честитост нек виде.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ти си мени испитао срце,",
            "poem": 1
          },
          {
            "text": "дошао ми ноћу у посету,",
            "poem": 2
          },
          {
            "text": "мисли си ми огњем искушао,",
            "poem": 1
          },
          {
            "text": "али ништа тамо ниси нашао;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а ја реших да устима не згрешим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "По чему ће човек да поступа?",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Према речи са твојих усана,",
            "poem": 1
          },
          {
            "text": "ја се чувам стаза насилника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Одржи ми стопе на својим стазама,",
            "poem": 1
          },
          {
            "text": "да се моје ноге не оклизну.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Призивам те, Боже, јер ми одговараш,",
            "poem": 1
          },
          {
            "text": "пригни ухо к мени, почуј моје речи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Покажи милост своју чудесну,",
            "poem": 1
          },
          {
            "text": "ти што десницом својом избављаш оне,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "који траже уточиште од својих злотвора.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Чувај ме као зеницу свог ока,",
            "poem": 1
          },
          {
            "text": "под сенку ме својих крила склони,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "од опаких који ме нападају,",
            "poem": 1
          },
          {
            "text": "од душмана што ме опкољују.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Срце им је постало бездушно",
            "poem": 1
          },
          {
            "noteId": 3
          },
          {
            "text": ",",
            "poem": 1
          },
          {
            "text": "а уста им говоре узносито.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Они мене гоне, опкољују,",
            "poem": 1
          },
          {
            "text": "а очи им пажљиво гледају,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "како да ме на тло оборе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Као лав су што жуди да растргне,",
            "poem": 1
          },
          {
            "text": "као млади лав што вреба из потаје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Устани на њих, Господе,",
            "poem": 1
          },
          {
            "text": "баци их на колена,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "мачем ме својим избави од опаког!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Избави ме својом руком, Господе,",
            "poem": 1
          },
          {
            "text": "од људи којима је део овај свет пролазни;",
            "poem": 2
          },
          {
            "text": "нека им трбух пуни оно",
            "poem": 1
          },
          {
            "text": "што си злима наменио;",
            "poem": 2
          },
          {
            "text": "сити ће им бити и синови,",
            "poem": 1
          },
          {
            "text": "и за потомство ће им још остати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "А ја ћу у праведности лице твоје видети,",
            "poem": 1
          },
          {
            "text": "кад се пробудим твога ћу се лика наситити.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 3,
        "caller": "+",
        "text": "17,10 Или: Својим салом су опточени – слика отврдлог срца у коме нема сажаљења.",
        "reference": {
          "chapter": 17,
          "verse": 10
        }
      }
    ]
