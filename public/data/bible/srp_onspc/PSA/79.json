  "chapter": {
    "number": 79,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Псалам Асафов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "О, Боже, туђинци су дошли у наследство твоје!",
            "poem": 1
          },
          {
            "text": "Опоганили су Дом твоје светости,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Јерусалим учинили рушевином!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Мртва тела твојих слугу",
            "poem": 1
          },
          {
            "text": "као храну птицама небеским су дали",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и зверима земаљским тела твојих верних.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Крв њихову излили су око Јерусалима",
            "poem": 1
          },
          {
            "text": "као да је вода, и нико их сахранио није.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Својим комшијама постали смо ругло,",
            "poem": 1
          },
          {
            "text": "на подсмех смо и на презир својој околини.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Докле ћеш се гневити, Господе? До када?",
            "poem": 1
          },
          {
            "text": "Зар ће довека да гори пламен љубоморе твоје?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Јарост своју излиј на туђинце што те не познају",
            "poem": 1
          },
          {
            "text": "и на царства која твоје име не призивају!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Јер они су прождрали Јакова",
            "poem": 1
          },
          {
            "text": "и насеље му уништили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Не памти нам пређашње кривице! Похитај!",
            "poem": 1
          },
          {
            "text": "Милосрђем својим пресретни нас",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер смо у великој беди!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Помози нам, о, Боже спасења нашега!",
            "poem": 1
          },
          {
            "text": "Избави нас ради свог имена славног!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Опрости нам грехе наше због имена свога!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Зашто да туђинци кажу:",
            "poem": 1
          },
          {
            "text": "„Где је њихов Бог?“",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Дај да нам очи виде освету међу народима",
            "poem": 1
          },
          {
            "text": "због проливене крви слугу твојих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Нек пред тебе допре јецај заточених,",
            "poem": 1
          },
          {
            "text": "па великом снагом својом спаси на смрт осуђене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Освети се седмоструко по недрима комшијама нашим",
            "poem": 1
          },
          {
            "text": "презиром њиховим којим су те, Господе, презрели!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "А ми, твој народ и стадо твоје паше,",
            "poem": 1
          },
          {
            "text": "у векове хвалићемо тебе!",
            "poem": 2
          },
          {
            "text": "Славу твоју јавићемо",
            "poem": 1
          },
          {
            "text": "сваком нараштају!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
