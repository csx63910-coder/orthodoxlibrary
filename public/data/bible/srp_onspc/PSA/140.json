  "chapter": {
    "number": 140,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. Давидов Псалам."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "О, Господе, избави ме од човека злобног,",
            "poem": 1
          },
          {
            "text": "од човека насилника ти мене заштити;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "оног што му срце злобу смишља,",
            "poem": 1
          },
          {
            "text": "оних што поваздан започињу свађе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Попут змије оштре језик,",
            "poem": 1
          },
          {
            "text": "отров им је змијски под уснама. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Заштити ме, о, Господе,",
            "poem": 1
          },
          {
            "text": "од шака поквареног,",
            "poem": 2
          },
          {
            "text": "од човека насилника ти мене заштити",
            "poem": 1
          },
          {
            "text": "и од оних што би да ме са ногу помету.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Охоли су ми замку и омче сакрили,",
            "poem": 1
          },
          {
            "text": "крај пута ми мрежу раширили",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и клопке ставили. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Господу говорим: „Бог мој ти си!“",
            "poem": 1
          },
          {
            "text": "О, Господе, пригни ухо гласу мојих преклињања!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "О, Господе Боже, сило мог спасења,",
            "poem": 1
          },
          {
            "text": "у дан ратни главу моју покриј.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "О, Господе, не дај злобном по жељама;",
            "poem": 1
          },
          {
            "text": "злу намеру му не оствари, да се не охоли. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ено глава оних што ме окружују!",
            "poem": 1
          },
          {
            "text": "Зло усана њихових нек се на њих сручи!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Нека на њих падне жар угљени;",
            "poem": 1
          },
          {
            "text": "у ватру нека их гурне,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "у раке, и нек се не дигну!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Нека се клеветник не укорени на земљи;",
            "poem": 1
          },
          {
            "text": "насилника нека злоба лови,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "нека га надвлада.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "А ја знам да ће Господ суд донети сиромаху",
            "poem": 1
          },
          {
            "text": "и правду за убогога!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Нек праведни хвале твоје име!",
            "poem": 1
          },
          {
            "text": "Честити ће пред тобом живети!",
            "poem": 2
          }
        ]
      }
    ],
