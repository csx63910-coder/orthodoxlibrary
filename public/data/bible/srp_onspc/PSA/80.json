  "chapter": {
    "number": 80,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. Према „Љиљанима“. Сведочења. Псалам Асафов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "О, Пастиру Израиља, чуј нас!",
            "poem": 1
          },
          {
            "text": "Ти што Јосифа си водио ко стадо!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Заблистај ти, што седиш над херувимима!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Устани у сили својој пред Јефремом, Венијамином и Манасијом.",
            "poem": 1
          },
          {
            "text": "Дођи и избави нас.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Обнови нас, о, Боже!",
            "poem": 1
          },
          {
            "text": "Озари лице своје",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да бисмо се избавили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "О, Господе, Боже над војскама,",
            "poem": 1
          },
          {
            "text": "до када ћеш срдит бити,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а твој ти се народ моли?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Сузним хлебом ти их храниш,",
            "poem": 1
          },
          {
            "text": "сузама из чанка појиш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Од нас си направио раздор међу комшијама нашим,",
            "poem": 1
          },
          {
            "text": "међу собом шегаче се душмани са нама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "О, Боже над војскама, поврати нас!",
            "poem": 1
          },
          {
            "text": "Озари лице своје",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да бисмо се избавили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Чокот си из Египта искоренио",
            "poem": 1
          },
          {
            "text": "и народе отерао да би га усадио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Пред њиме си раскрчио и он се укоренио,",
            "poem": 1
          },
          {
            "text": "свуд по земљи пружио је жиле.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Хлад је његов брда засенио,",
            "poem": 1
          },
          {
            "text": "а лозама Божије кедрове.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "До мора су се гранале његове лозе,",
            "poem": 1
          },
          {
            "text": "изданци његови све до Еуфрата.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Зашто си му срушио ограде",
            "poem": 1
          },
          {
            "text": "да га бере свако ко пролази путем?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ровари га дивљи вепар,",
            "poem": 1
          },
          {
            "text": "глође га све што се по пољу миче.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Боже над војскама, молимо те, врати се!",
            "poem": 1
          },
          {
            "text": "Са небеса погледај и види,",
            "poem": 2
          },
          {
            "text": "побрини се за чокот овај;",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "за корен што си га десницом својом усадио",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и младице што си себи ојачао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ето, сажежен је ватром и посечен,",
            "poem": 1
          },
          {
            "text": "они гину од прекорног лица твога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Нека рука твоја буде над човеком деснице твоје,",
            "poem": 1
          },
          {
            "text": "над потомком људи којега си себи ојачао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Тада се од тебе више одвратити нећемо.",
            "poem": 1
          },
          {
            "text": "Ти нас оживи, ми име твоје призивамо!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Обнови нас Господе, Боже над војскама!",
            "poem": 1
          },
          {
            "text": "Озари лице своје",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да бисмо се избавили.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
