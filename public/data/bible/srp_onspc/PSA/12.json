  "chapter": {
    "number": 12,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи: према Шеминиту. Псалам Давидов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Спасавај, Господе,",
            "poem": 1
          },
          {
            "text": "јер нестаде верни,",
            "poem": 2
          },
          {
            "text": "ишчезнуше побожни",
            "poem": 1
          },
          {
            "text": "међу потомцима људи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Свако вара свога ближњега,",
            "poem": 1
          },
          {
            "text": "усне њихове говоре ласкаво,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а у срцу другачије мисле.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Нек затре Господ усне превртљиве,",
            "poem": 1
          },
          {
            "text": "нек истреби језик хвалисави.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "„Наш је језик, наша снага“ – кажу,",
            "poem": 1
          },
          {
            "text": "„усне су нам наша узданица.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ко ће онда да влада над нама?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "„Ради сиромаха што су потлачени,",
            "poem": 1
          },
          {
            "text": "и убогога што стење под муком,",
            "poem": 2
          },
          {
            "text": "ја ћу сад устати – говори Господ –",
            "poem": 1
          },
          {
            "text": "спасење му дати за којим уздише.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Речи Господње чисте су речи,",
            "poem": 1
          },
          {
            "text": "сребро каљено у пећи од глине,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "седам пута оне су топљене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ти ћеш их, о, Господе, сачувати,",
            "poem": 1
          },
          {
            "text": "заувек нас штитити од тог нараштаја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Опаки се неспутано шире унаоколо,",
            "poem": 1
          },
          {
            "text": "кад се зло велича међу потомцима људи.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
