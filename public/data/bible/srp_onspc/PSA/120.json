  "chapter": {
    "number": 120,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Песма поклоничка."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "У невољи Господа сам звао",
            "poem": 1
          },
          {
            "text": "и он ми се одазвао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "О, Господе, избави ми душу",
            "poem": 1
          },
          {
            "text": "од лажљивих усана",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и језика превртљивог!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Шта ли ће се теби дати,",
            "poem": 1
          },
          {
            "text": "шта ће ти се надодати,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "о, језиче превртљиви?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Јунакове оштре стреле",
            "poem": 1
          },
          {
            "text": "са смрекином жеравицом!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Јао мени!",
            "poem": 1
          },
          {
            "text": "Ја сам дошљак код Месеха,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "у кедарским шаторима живим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Предуго сам боравио",
            "poem": 1
          },
          {
            "text": "са онима што мир мрзе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ја сам миру предан,",
            "poem": 1
          },
          {
            "text": "али чим бих да говорим,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "они би да зарате.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
