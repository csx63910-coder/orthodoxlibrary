  "chapter": {
    "number": 59,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. Давидов напев: „Не погуби.“ Песма поуздања у Бога, када је Саул послао људе да мотре на Давидову кућу и убију га."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Боже мој, ослободи ме од противника мојих;",
            "poem": 1
          },
          {
            "text": "склони ме од оних што се дижу против мене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Од злотвора ме ослободи,",
            "poem": 1
          },
          {
            "text": "од крволока ме спаси.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Јер, ено, из потаје вребају ми живот;",
            "poem": 1
          },
          {
            "text": "моћници против мене покрећу невољу,",
            "poem": 2
          },
          {
            "text": "али не због преступа,",
            "poem": 1
          },
          {
            "text": "не због греха мога, Господе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Без кривице моје они јуре, спремају се.",
            "poem": 1
          },
          {
            "text": "Подигни се, сусретни ме и примети!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "А ти, Господе, Боже над војскама,",
            "poem": 1
          },
          {
            "text": "Боже Израиљев,",
            "poem": 2
          },
          {
            "text": "пробуди се да све народе казниш;",
            "poem": 1
          },
          {
            "text": "не смилуј се ниједном злотвору злобном. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Увече се враћају,",
            "poem": 1
          },
          {
            "text": "попут псета реже",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и шуњају око града.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ено, устима брбљају,",
            "poem": 1
          },
          {
            "text": "а мачеви им на уснама,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер говоре: „Ко још слуша?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "А ти им се, о, Господе, смејеш;",
            "poem": 1
          },
          {
            "text": "ти се ругаш свим тим народима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ти си моја снага, тебе ишчекујем;",
            "poem": 1
          },
          {
            "text": "јер Бог је мој заклон.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Бог милости ће ме срести,",
            "poem": 1
          },
          {
            "text": "даће ми Бог да ликујем",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "над мрзитељима својим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Не убиј их,",
            "poem": 1
          },
          {
            "text": "да мој народ заборавио не би;",
            "poem": 2
          },
          {
            "text": "снагом својом распрши их и обори,",
            "poem": 1
          },
          {
            "text": "Господе, штите наш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "За грехе својих уста",
            "poem": 1
          },
          {
            "text": "и реч усана својих,",
            "poem": 2
          },
          {
            "text": "нека буду ухваћени у своме поносу,",
            "poem": 1
          },
          {
            "text": "због клетве и лажи што износе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Сатри их у гневу,",
            "poem": 1
          },
          {
            "text": "сатри да их нема,",
            "poem": 2
          },
          {
            "text": "па да народ схвати да Бог влада",
            "poem": 1
          },
          {
            "text": "у Јакову до крајева земље. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Увече се враћају,",
            "poem": 1
          },
          {
            "text": "попут псета реже",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и шуњају око града.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Распршени лутају за јелом,",
            "poem": 1
          },
          {
            "text": "ноћ пробдеју ако нису сити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "А ја ћу да певам о твојој сили,",
            "poem": 1
          },
          {
            "text": "веселићу се јутром због милости твоје;",
            "poem": 2
          },
          {
            "text": "јер си мој заклон,",
            "poem": 1
          },
          {
            "text": "уточиште у дану невоље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Сило моја, славопој ти певам;",
            "poem": 1
          },
          {
            "text": "јер Бог је мој заклон,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Бог милости моје.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
