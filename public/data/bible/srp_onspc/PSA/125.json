  "chapter": {
    "number": 125,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Песма поклоничка."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Они што се у Господа уздају,",
            "poem": 1
          },
          {
            "text": "јесу као гора Сион – постојана,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "довека се помакнути не да!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Попут гора што Јерусалим окружују,",
            "poem": 1
          },
          {
            "text": "тако је и Господ око свог народа,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "све од сада па за вечност целу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Уистину, неће жезло злочинаца владати",
            "poem": 1
          },
          {
            "text": "над земљом што припада праведнима;",
            "poem": 2
          },
          {
            "text": "да праведни руке своје не би",
            "poem": 1
          },
          {
            "text": "неправди пружали.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "О, Господе, добро чини добрима",
            "poem": 1
          },
          {
            "text": "и онима честитога срца!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "А оне што на своје криве стазе скрећу,",
            "poem": 1
          },
          {
            "text": "Господ ће одагнати са злотворима.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Мир Израиљу!",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
