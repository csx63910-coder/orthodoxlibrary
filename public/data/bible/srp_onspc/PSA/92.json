  "chapter": {
    "number": 92,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Псалам. Песма за дан суботњи."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Баш је добро хвалити Господа,",
            "poem": 1
          },
          {
            "text": "твом имену певати, Свевишњи;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "милост твоју ујутру јављати,",
            "poem": 1
          },
          {
            "text": "сваке ноћи верност твоју;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "лиром са десет струна",
            "poem": 1
          },
          {
            "text": "и харфином мелодијом!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Јер ти си ме, о, Господе,",
            "poem": 1
          },
          {
            "text": "обрадово делом својим;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "кличем труду руку твојих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Како су велика дела твоја, о, Господе!",
            "poem": 1
          },
          {
            "text": "Како су дубоки науми твоји.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Човек без памети не зна",
            "poem": 1
          },
          {
            "text": "и безумник ово не разуме;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Кад зликовци ничу као трава",
            "poem": 1
          },
          {
            "text": "и кад сваки злотвор цвета,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "то је да би заувек пропали!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "А ти си довека узвишен, о, Господе!",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "О, Господе, ено твојих душмана;",
            "poem": 1
          },
          {
            "text": "ено твојих душмана, гину,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и сви што злобно раде биће одувани.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ти си мој рог уздигао као у бивола,",
            "poem": 1
          },
          {
            "text": "помазан сам свежим уљем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Очима гледам по зидинама мојим",
            "poem": 1
          },
          {
            "text": "оне што се против мене дижу;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ушима својим слушам злотворе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Као палма грана се праведник,",
            "poem": 1
          },
          {
            "text": "као кедар расте на Ливану!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Посађени у Дому Господњем",
            "poem": 1
          },
          {
            "text": "цветаће у двориштима Бога нашег.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Биће плодоносни и када остаре,",
            "poem": 1
          },
          {
            "text": "једри и зелени биће;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "и јављаће: праведан је Господ, стена моја,",
            "poem": 1
          },
          {
            "text": "неправде у њему нема!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
