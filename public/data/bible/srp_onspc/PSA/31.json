  "chapter": {
    "number": 31,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "За хоровођу. Псалам Давидов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "У теби је уточиште моје, Господе;",
            "poem": 1
          },
          {
            "text": "о, да се никад не постидим;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "избави ме по својој праведности.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Пригни ухо своје к мени,",
            "poem": 1
          },
          {
            "text": "брзо ме избави,",
            "poem": 2
          },
          {
            "text": "буди ми стена, уточиште,",
            "poem": 1
          },
          {
            "text": "јака тврђава за моје спасење.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ти си моја стена и тврђава,",
            "poem": 1
          },
          {
            "text": "ради свог имена води ме, усмеравај.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Извуци ме из мреже коју ми поставише,",
            "poem": 1
          },
          {
            "text": "јер ти си моја тврђава.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "У твоје руке предајем свој дух,",
            "poem": 1
          },
          {
            "text": "откупи ме, Господе, верни Боже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Мрзим служитеље безвредних идола;",
            "poem": 1
          },
          {
            "text": "поуздајем се једино у Господа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Клицаћу и радоваћу се по твојој милости,",
            "poem": 1
          },
          {
            "text": "јер ти си видео моју муку;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ти си знао тескобу моје душе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ниси ме дао у руке душманину,",
            "poem": 1
          },
          {
            "text": "него си ми ноге поставио на пространо место.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Смилуј ми се, Господе, јер сам у невољи,",
            "poem": 1
          },
          {
            "text": "моје око од жалости копни,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "вене моја душа и нутрина.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Живот ми се троши у жалости,",
            "poem": 1
          },
          {
            "text": "у јецању одмичу године,",
            "poem": 2
          },
          {
            "text": "снага ме издаје због моје неправде,",
            "poem": 1
          },
          {
            "text": "и кости се моје распадају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Поруга постадох због свих својих душмана:",
            "poem": 1
          },
          {
            "text": "суседима терет, а знанцима страшило;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "беже од мене кад ме виде на улици.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Падох у заборав, као да сам умро,",
            "poem": 1
          },
          {
            "text": "постао сам као разбијени суд.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Јер ја чујем клевете многих,",
            "poem": 1
          },
          {
            "text": "ужас ме је опколио одасвуд.",
            "poem": 2
          },
          {
            "text": "А они се удружују против мене,",
            "poem": 1
          },
          {
            "text": "кују заверу да ми живот узму.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Али ја се у тебе уздам, Господе,",
            "poem": 1
          },
          {
            "text": "и кажем: „Ти си Бог мој.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Време је моје у руци твојој;",
            "poem": 1
          },
          {
            "text": "избави ме из руку душмана,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и од оних који ме прогоне.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Нека лице твоје обасја слугу твога,",
            "poem": 1
          },
          {
            "text": "милошћу ме својом избави.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Не дај да се постидим, Господе,",
            "poem": 1
          },
          {
            "text": "јер теби завапих;",
            "poem": 2
          },
          {
            "text": "нека се опаки постиде,",
            "poem": 1
          },
          {
            "text": "у Свету мртвих нек умукну.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Нека умукну уста лажљива,",
            "poem": 1
          },
          {
            "text": "која против праведника говоре",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "обесно, охоло и презриво.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Како је обилна доброта твоја,",
            "poem": 1
          },
          {
            "text": "коју чуваш за оне који те се боје;",
            "poem": 2
          },
          {
            "text": "исказујеш је пред потомцима људи,",
            "poem": 1
          },
          {
            "text": "онима што у теби уточиште нађу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Ти их скриваш у заклону свог лица,",
            "poem": 1
          },
          {
            "text": "од завера које људи кују,",
            "poem": 2
          },
          {
            "text": "заклањаш их под своју сеницу,",
            "poem": 1
          },
          {
            "text": "од језика који оптужују.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Благословен био Господ,",
            "poem": 1
          },
          {
            "text": "јер ми исказа дивну милост своју,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "кад сам био у граду под опсадом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Тада рекох узнемирен:",
            "poem": 1
          },
          {
            "text": "„Одбачен сам од твог погледа.“",
            "poem": 2
          },
          {
            "text": "Али ти си чуо глас мога преклињања,",
            "poem": 1
          },
          {
            "text": "када сам завапио к теби.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Волите Господа, сви верни његови,",
            "poem": 1
          },
          {
            "text": "Господ чува оне који верују,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а охолима плаћа пуном мером.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Будите јаки и храбра срца,",
            "poem": 1
          },
          {
            "text": "сви ви што се надате Господу!",
            "poem": 2
          }
        ]
      }
    ],
