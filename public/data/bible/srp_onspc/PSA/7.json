  "chapter": {
    "number": 7,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Тужбалица Давидова, коју је испевао Господу због речи Хуша, Венијаминовца."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Господе, Боже мој,",
            "poem": 1
          },
          {
            "text": "у теби је моје уточиште,",
            "poem": 2
          },
          {
            "text": "спаси ме, избави,",
            "poem": 1
          },
          {
            "text": "од свих који ме гоне,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "да ми душу као лав не раздеру,",
            "poem": 1
          },
          {
            "text": "растргну ме, а спаса ни од кога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Господе, Боже мој, ако сам ово учинио,",
            "poem": 1
          },
          {
            "text": "ако сам руке своје неправдом окаљао,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "ако сам пријатељу злом узвратио,",
            "poem": 1
          },
          {
            "text": "а противника без разлога пљачкао,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "нека ме непријатељ гони и сустигне,",
            "poem": 1
          },
          {
            "text": "нека живот мој на земљу згази,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а славу моју у прашину баци. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "У свом гневу устани, Господе,",
            "poem": 1
          },
          {
            "text": "дигни се на бес мојих душмана,",
            "poem": 2
          },
          {
            "text": "пробуди се, у помоћ ми дођи,",
            "poem": 1
          },
          {
            "text": "јер ти си свој суд заказао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Нека се збор народа скупи око тебе,",
            "poem": 1
          },
          {
            "text": "па над њима владај са висина.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Господ суди народима,",
            "poem": 1
          },
          {
            "text": "суди ми, Господе, по праведности",
            "poem": 2
          },
          {
            "text": "и непорочности мојој.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Бог је праведан,",
            "poem": 1
          },
          {
            "text": "он испитује и срца и нутрину;",
            "poem": 2
          },
          {
            "text": "нека дође крај злу опаких,",
            "poem": 1
          },
          {
            "text": "а праведнога ти учврсти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Бог је мој штит,",
            "poem": 1
          },
          {
            "text": "он спасава исправног у срцу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Бог је праведни судија,",
            "poem": 1
          },
          {
            "text": "сваког дана Бог гнев свој излива.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "А за оног ко се не покаје,",
            "poem": 1
          },
          {
            "text": "он ће свој мач наоштрити,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и лук свој запети, уперити;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "таквом спрема оружје смртно,",
            "poem": 1
          },
          {
            "text": "стреле своје прави запаљиве.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ето, опаки је злом бременит,",
            "poem": 1
          },
          {
            "text": "зачиње невољу, а рађа превару.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Копа јаму, издуби је,",
            "poem": 1
          },
          {
            "text": "и пада у јаму коју је начинио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Невоља његова нека му се на главу врати,",
            "poem": 1
          },
          {
            "text": "насиље његово нека му на теме падне.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Хвалићу Господа ради његове праведности,",
            "poem": 1
          },
          {
            "text": "славићу песмом име Господа Свевишњег!",
            "poem": 2
          }
        ]
      }
    ],
