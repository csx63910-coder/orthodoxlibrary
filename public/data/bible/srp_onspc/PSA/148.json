  "chapter": {
    "number": 148,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Славите Господа!",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Славите Господа са небеса,",
            "poem": 1
          },
          {
            "text": "славите га на висинама!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "О, анђели сви његови, славите га,",
            "poem": 1
          },
          {
            "text": "славите га, све војске његове!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Славите га, сунце и месече,",
            "poem": 1
          },
          {
            "text": "славите га, све блиставе звезде!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Славите га, небеса највиша,",
            "poem": 1
          },
          {
            "text": "и ви, воде врх небеса!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Нек Господње име славе,",
            "poem": 1
          },
          {
            "text": "јер он заповеди и они посташе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "За сву вечност њих је поставио,",
            "poem": 1
          },
          {
            "text": "уредбу је дао која проћи неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ви са земље славите Господа –",
            "poem": 1
          },
          {
            "text": "немани морске и дубино свака;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "громе и граде, снеже и магло,",
            "poem": 1
          },
          {
            "text": "олујо што реч његову остварујеш;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "горе и сва брда, свако стабло родно",
            "poem": 1
          },
          {
            "text": "и сви кедрови;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "звери и сва стоко,",
            "poem": 1
          },
          {
            "text": "гмизавци и птице крилате;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "земаљски цареви и сви људи,",
            "poem": 1
          },
          {
            "text": "главари и владари земље;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "младићи, а и девојке;",
            "poem": 1
          },
          {
            "text": "стари са младима!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Нек Господње име славе,",
            "poem": 1
          },
          {
            "text": "јер само је његово име узвишено;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "величанство му је и над земљом и над небесима!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Свом народу он ће рог уздићи –",
            "poem": 1
          },
          {
            "text": "славу сваког који му је веран –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "народу израиљском, народу њему блиском.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Славите Господа!",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
