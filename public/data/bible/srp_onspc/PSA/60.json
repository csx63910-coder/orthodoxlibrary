  "chapter": {
    "number": 60,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. Према „Љиљанима“. Сведочења. Давидова песма поуздања у Бога. За поуку: када се борио против Арам-Нахарајима и Арам-Сове и када се Јоав вратио, па у Сланој долини побио дванаест хиљада Едомаца."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Одбацио си нас, Боже,",
            "poem": 1
          },
          {
            "text": "срушио нас, разгневио се.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Опорави нас!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ти си земљу уздрмао,",
            "poem": 1
          },
          {
            "text": "расцепао си је;",
            "poem": 2
          },
          {
            "text": "раселине њене споји",
            "poem": 1
          },
          {
            "text": "јер је уздрмана.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Пустио си да твој народ види страхоту,",
            "poem": 1
          },
          {
            "text": "приморао да пијемо вино што опија.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Заставу си богобојазнима дао",
            "poem": 1
          },
          {
            "text": "да се због истине",
            "poem": 2
          },
          {
            "noteId": 5
          },
          {
            "text": "развије. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Десницом нас својом спаси, услиши нас,",
            "poem": 1
          },
          {
            "text": "па да твоји миљеници избављени буду.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "У свом Светилишту Бог је објавио:",
            "poem": 1
          },
          {
            "text": "„Заклицаћу, поделићу Сихем,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "премерићу долину Сокота.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Мој је Галад, мој је Манасија;",
            "poem": 1
          },
          {
            "text": "Јефрем ми је кацига на глави,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а Јуда ми царско жезло.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Моав ми је корито за прање,",
            "poem": 1
          },
          {
            "text": "на Едом сам бацио сандалу;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Филистејо, због мене ускликни!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ко ће мене да отпрати у град утврђени?",
            "poem": 1
          },
          {
            "text": "А на Едом ко ће ме повести?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Нећеш ли ти, о, Боже,",
            "poem": 1
          },
          {
            "text": "који си нас одбацио,",
            "poem": 2
          },
          {
            "text": "па с војскама нашим, Боже,",
            "poem": 1
          },
          {
            "text": "више не корачаш?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Помоћ дај нам испред противника,",
            "poem": 1
          },
          {
            "text": "узалуд је људско избављење.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Силно ћемо ступати са Богом,",
            "poem": 1
          },
          {
            "text": "изгазиће наше противнике!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 5,
        "caller": "+",
        "text": "60,4 Или: због лука.",
        "reference": {
          "chapter": 60,
          "verse": 4
        }
      }
    ]
