  "chapter": {
    "number": 15,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Псалам Давидов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ко то сме, о, Господе,",
            "poem": 1
          },
          {
            "text": "да пребива у твом шатору,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и да живи на светој гори твојој?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Онај који хода беспрекорно,",
            "poem": 1
          },
          {
            "text": "и чини што правда захтева;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ко из срца говори истину,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "и свој језик чува од пакости;",
            "poem": 1
          },
          {
            "text": "ко свом ближњем не чини зла,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "нити оцрњује свога ближњега;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "ко с презиром гледа на опаке,",
            "poem": 1
          },
          {
            "text": "а поштује оне што се боје Господа;",
            "poem": 2
          },
          {
            "text": "ко своју заклетву не пориче",
            "poem": 1
          },
          {
            "text": "макар му то и на зло изашло;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "ко не позајмљује новац с каматом,",
            "poem": 1
          },
          {
            "text": "нити прима мито против невиног.",
            "poem": 2
          },
          {
            "text": "Ко то чини, неће се пољуљати довека.",
            "poem": 1
          }
        ]
      }
    ],
