  "chapter": {
    "number": 139,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. Давидов Псалам."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "О, Господе, ти ме проничеш",
            "poem": 1
          },
          {
            "text": "и теби сам познат!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Знаш ме и кад седим и кад стојим,",
            "poem": 1
          },
          {
            "text": "познајеш ми мисли издалека.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Посматраш ме док ходам, док лежим,",
            "poem": 1
          },
          {
            "text": "и свестан си свих мојих путева.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Елем, још ми речи на језику нема,",
            "poem": 1
          },
          {
            "text": "а ти, ето, о, Господе, познајеш баш сваку!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Обухваташ ме и спреда и страга,",
            "poem": 1
          },
          {
            "text": "руку своју на мене полажеш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Чудесно ми је то сазнање, узвишено,",
            "poem": 1
          },
          {
            "text": "немоћан сам да га схватим!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Од твог Духа где да одем?",
            "poem": 1
          },
          {
            "text": "Од твог лица куда да побегнем?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Дигнем ли се до небеса – ти си тамо;",
            "poem": 1
          },
          {
            "text": "спустим ли се у Свет мртвих – и тамо си!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Винем ли се зориним крилима",
            "poem": 1
          },
          {
            "text": "и преселим на крај мора;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "и тамо ме рука твоја води,",
            "poem": 1
          },
          {
            "text": "придржава ме десница твоја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Све и да кажем –",
            "poem": 1
          },
          {
            "text": "„Тама ће ме свакако прекрити,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "светло око мене ко ноћ ће постати“ –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "од тебе ме ни тама не скрива",
            "poem": 1
          },
          {
            "text": "и ноћ попут дана сија,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер и тама ти је као светло!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Да, ти си ми нутрину створио,",
            "poem": 1
          },
          {
            "text": "саткао ме у утроби мајке моје!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Хвалићу те што сам такав саздан,",
            "poem": 1
          },
          {
            "text": "запањујуће диван,",
            "poem": 2
          },
          {
            "text": "што су ти дела чудесна;",
            "poem": 1
          },
          {
            "text": "а душа је моја тога добро свесна.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Моје кости теби нису сакривене биле,",
            "poem": 1
          },
          {
            "text": "док сам био стваран на тајноме месту;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "док сам био обликован у дубини земље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Очи су ме твоје ко заметак гледале;",
            "poem": 1
          },
          {
            "text": "у твојој су књизи записани дани моји одређени,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а да још ни један од њих постојао није!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "И како су ми драгоцене твоје мисли, Боже!",
            "poem": 1
          },
          {
            "text": "Како их је много кад се зброје!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Да их бројим,",
            "poem": 1
          },
          {
            "text": "више их је него песка;",
            "poem": 2
          },
          {
            "text": "а када се пробудим,",
            "poem": 1
          },
          {
            "text": "још увек сам са тобом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "О, Боже, кад би хтео зликовца да смакнеш!",
            "poem": 1
          },
          {
            "text": "Одлазите од мене, крвници!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Они против тебе сплеткаре,",
            "poem": 1
          },
          {
            "text": "лажи о теби шире твоји противници.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "О, Господе, зар да не мрзим те што тебе мрзе?",
            "poem": 1
          },
          {
            "text": "Богобораца се гнушам!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Мржњом крајњом ја их мрзим!",
            "poem": 1
          },
          {
            "text": "Душмани су они моји!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Проникни ме, о, Боже! Срце ми упознај,",
            "poem": 1
          },
          {
            "text": "окушај ме, забринуте мисли моје сазнај!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Види да ли идем путем застрањења",
            "poem": 1
          },
          {
            "text": "и води ме путем из давнина.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
