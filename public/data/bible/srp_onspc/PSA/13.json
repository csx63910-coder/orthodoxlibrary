  "chapter": {
    "number": 13,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. Псалам Давидов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Докле више, докле, о, Господе?",
            "poem": 1
          },
          {
            "text": "Зар ћеш ме ти ваздан заборављати?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Докле ћеш од мене своје лице крити?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Докле више да се питам у души,",
            "poem": 1
          },
          {
            "text": "и сваки дан у срцу тугујем?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Докле ће душманин да буде нада мном?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Погледај, услиши ме, Господе,",
            "poem": 1
          },
          {
            "text": "Боже мој, очи ми просветли,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да у сан смртни ја не утонем,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "да не каже непријатељ:",
            "poem": 1
          },
          {
            "text": "„Ја сам га надјачао“,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и противници не ликују нада мном.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "А ја ћу се у твоју милост уздати,",
            "poem": 1
          },
          {
            "text": "твоме се спасењу у срцу радовати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Певаћу Господу, јер ми је био добростив.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
