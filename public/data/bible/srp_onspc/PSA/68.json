  "book": {
    "id": "PSA",
    "translationId": "srp_onspc",
    "name": "Псалм",
    "commonName": "Псалм",
    "title": "Псалми",
    "order": 19,
    "numberOfChapters": 150,
    "sha256": "26caf786163c3156cd828b9195dd87c0a9678ee51bdea32fbef70df99683a272",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/PSA/1.json",
    "lastChapterNumber": 150,
    "lastChapterApiLink": "/api/srp_onspc/PSA/150.json",
    "totalNumberOfVerses": 2461
  },
  "chapter": {
    "number": 68,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. Давидов. Псалам. Песма."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Нека Бог устане,",
            "poem": 1
          },
          {
            "text": "нека се разиђу његови душмани!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Нека се разбеже пред њим они што га мрзе!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Развеј их попут дима развејаног;",
            "poem": 1
          },
          {
            "text": "нек пропадну зликовци пред Богом",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "као восак истопљен у ватри.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "А праведни нека се радују,",
            "poem": 1
          },
          {
            "text": "нек пред Богом кличу,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "нек ликују у весељу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Певајте Богу,",
            "poem": 1
          },
          {
            "text": "певајте славопој његовом имену;",
            "poem": 2
          },
          {
            "text": "уздигните оног што на облацима јаше.",
            "poem": 1
          },
          {
            "text": "Његово је име Господ,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ускликните пред њим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Отац сирочади и судија удовица –",
            "poem": 1
          },
          {
            "text": "то је Бог у свом светом Пребивалишту.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Бог усамљенима даје да у кући живе,",
            "poem": 1
          },
          {
            "text": "заточене води благостању,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а бунтовници боравиће у спарушеној земљи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Боже, кад си ишао испред свог народа,",
            "poem": 1
          },
          {
            "text": "када си ступао пустињом, Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "земља се тресла, небеса су пљуштала,",
            "poem": 1
          },
          {
            "text": "пред Богом, Богом синајским,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "пред Богом, Богом Израиљевим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Боже, обиље си кише послао наследству своме;",
            "poem": 1
          },
          {
            "text": "уморно је оно било, а ти си га ојачао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Живаљ твој се онде настанио,",
            "poem": 1
          },
          {
            "text": "снабдеваш убогог добрима својим, Боже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Господ објављује,",
            "poem": 1
          },
          {
            "text": "а жена што носе вести велико је мноштво.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Цареви и војске беже ли беже,",
            "poem": 1
          },
          {
            "text": "а лепотица куће плен раздељује.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ако и легнеш између торова,",
            "poem": 1
          },
          {
            "text": "ти си голубица крила обложених сребром,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и перја светлуцаво златног.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Кад Свемоћни распрши цареве у земљи,",
            "poem": 1
          },
          {
            "text": "паде снег на Салмону.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Гора Божија васанска је гора,",
            "poem": 1
          },
          {
            "text": "гора с врховима васанска је гора.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Зашто завидно гледате, о, горе,",
            "poem": 1
          },
          {
            "text": "врхове горе коју Бог жели за боравиште своје;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "где ће Господ зацело довека да пребива?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Божијих је кола на хиљаде,",
            "poem": 1
          },
          {
            "text": "на многе хиљаде;",
            "poem": 2
          },
          {
            "text": "а Господ је међу њима,",
            "poem": 1
          },
          {
            "text": "на Синају, у светости.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ти се попе на висину,",
            "poem": 1
          },
          {
            "text": "поведе робље силно,",
            "poem": 2
          },
          {
            "text": "прими дарове од људи,",
            "poem": 1
          },
          {
            "text": "па чак и од бунтовника;",
            "poem": 2
          },
          {
            "text": "да пребиваш тамо,",
            "poem": 1
          },
          {
            "text": "Господе Боже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Благословен да је Господ,",
            "poem": 1
          },
          {
            "text": "што терете наше дан за даном носи,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Бог нашег спасења. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Бог наш Бог је дела спасоносних,",
            "poem": 1
          },
          {
            "text": "од Господа Бога избављење је од смрти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Зацело ће Бог разбити главу својих противника,",
            "poem": 1
          },
          {
            "text": "и космато теме оног који живи у својим гресима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Господ каже: „Са Васана вратићу их,",
            "poem": 1
          },
          {
            "text": "из дубина мора вратићу их,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "па да ти нога гаца у крви",
            "poem": 1
          },
          {
            "text": "и језик твојих паса добије свој део од твојих противника.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Видеше поворке твоје, Боже;",
            "poem": 1
          },
          {
            "text": "поворке Бога мога, мога цара ка Светињи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Напред су ишли певачи, потом свирачи,",
            "poem": 1
          },
          {
            "text": "а у средини су девојке ударале даире.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Благосиљајте у зборовима Бога Господа,",
            "poem": 1
          },
          {
            "text": "ви са врела Израиљева!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Ено, млади Венијамин предводи их,",
            "poem": 1
          },
          {
            "text": "главари Јуде са мноштвом,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "главари Завулона и главари Нефталима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Твој Бог снагу ти је одредио;",
            "poem": 1
          },
          {
            "text": "покажи снагу своју, Боже, што си за нас деловао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Због твог Дома у Јерусалиму",
            "poem": 1
          },
          {
            "text": "цареви ће ти дарове доносити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Запрети зверима у трсци,",
            "poem": 1
          },
          {
            "text": "крду бикова међу теладима народа;",
            "poem": 2
          },
          {
            "text": "па нек се понизе и донесу комаде сребра,",
            "poem": 1
          },
          {
            "text": "а он ће расути народе што у рату уживају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Доћи ће изасланици из Египта,",
            "poem": 1
          },
          {
            "text": "Куш журно пружа руке своје Богу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "О, царства земаљска, певајте Богу;",
            "poem": 1
          },
          {
            "text": "певајте славопој Господу; Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "ономе што јаше небом, древним небесима!",
            "poem": 1
          },
          {
            "text": "Ено, он тутњи гласом својим, гласом силним.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Препознајте силу Божију над Израиљем,",
            "poem": 1
          },
          {
            "text": "величанство његово",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и његову силу у небесима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Ти си страшан, Боже, у Светилишту своме;",
            "poem": 1
          },
          {
            "text": "Бог Израиљев сам даје силу и снагу народу.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Благословен да је Бог!",
            "poem": 1
          }
        ]
      }
    ],
