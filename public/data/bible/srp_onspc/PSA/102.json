  "chapter": {
    "number": 102,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Молитва ојађеног човека пред Господом, кад излива своју муку."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "О, Господе, чуј молитву моју",
            "poem": 1
          },
          {
            "text": "и мој вапај нек до тебе дође!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Своје лице не скривај од мене у дану невоље,",
            "poem": 1
          },
          {
            "text": "ухо своје пригни мени;",
            "poem": 2
          },
          {
            "text": "ти пожури,",
            "poem": 1
          },
          {
            "text": "услиши ме у дан кад те зовем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Моји дани нестају у диму,",
            "poem": 1
          },
          {
            "text": "попут пећи кости ми спечене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Срце је моје као трава кошена, увела,",
            "poem": 1
          },
          {
            "text": "па ни хлеб се не сетим да једем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Од јецања мога силног",
            "poem": 1
          },
          {
            "text": "кожа ми се слепила за кости.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "На пустињску буљину личим",
            "poem": 1
          },
          {
            "text": "и на ћука с рушевина пустих!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Будан лежим,",
            "poem": 1
          },
          {
            "text": "постао сам птица што самује на крову.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Поваздан ми се ругају душмани,",
            "poem": 1
          },
          {
            "text": "именом мојим проклињу они што ме руже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Пепео једем као да је хлеб;",
            "poem": 1
          },
          {
            "text": "то што пијем са сузама мешам,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "због твог гнева и љутине твоје;",
            "poem": 1
          },
          {
            "text": "јер си ме подигао, па онда бацио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Као сенка бледе дани моји,",
            "poem": 1
          },
          {
            "text": "ја сам као трава спарушена.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "А ти си, Господе, довека! Ти трајеш,",
            "poem": 1
          },
          {
            "text": "спомињеш се кроз нараштај сваки.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ти устајеш да Сиону се смилујеш,",
            "poem": 1
          },
          {
            "text": "јер је време да га помилујеш,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер је дошло време одређено.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Јер слуге твоје воле му зидине,",
            "poem": 1
          },
          {
            "text": "жао им је његових руина.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Дрхтаће народи од имена Господњег",
            "poem": 1
          },
          {
            "text": "и од твоје славе сви цареви земаљски;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "јер ће Господ да изгради Сион",
            "poem": 1
          },
          {
            "text": "и објави се у његовој слави;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "када чује молитву јадника",
            "poem": 1
          },
          {
            "text": "њихове вапаје презрети неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Нек се то запише за нараштај нови,",
            "poem": 1
          },
          {
            "text": "за народ саздан да Господа слави!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Јер ће с висине светости своје гледати Господ,",
            "poem": 1
          },
          {
            "text": "с небеса ће земљу да погледа;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "чуће ропац заточених",
            "poem": 1
          },
          {
            "text": "и од смрти спасти осуђенике;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "да објави са Сиона име Господње",
            "poem": 1
          },
          {
            "text": "и хвалу своју у Јерусалиму;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "када се заједно окупе народи,",
            "poem": 1
          },
          {
            "text": "и царства да Господу служе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Сред живота снагу ми је одузео",
            "poem": 1
          },
          {
            "text": "и дане ми прекратио!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Рекао сам:",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Не узми ме усред мојих дана",
            "poem": 1
          },
          {
            "text": "кад већ живиш од рода до рода!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Ти си у почетку утемељио земљу,",
            "poem": 1
          },
          {
            "text": "и небеса су дело твојих руку.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Она ће пропасти, али ти ћеш остати,",
            "poem": 1
          },
          {
            "text": "и све ће се исхабати као изношена одећа,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "изменићеш их као одећу и проћи ће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "А ти си увек исти,",
            "poem": 1
          },
          {
            "text": "веку твоме нигде краја нема.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Синови твојих слугу живеће",
            "poem": 1
          },
          {
            "text": "и потомци њихови пред тобом спокојни ће бити.“",
            "poem": 2
          }
        ]
      }
    ],
