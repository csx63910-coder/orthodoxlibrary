  },
  "chapter": {
    "number": 118,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Хвалите Господа јер је добар,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Нек Израиљ каже:",
            "poem": 1
          },
          {
            "text": "„Јер је милост његова довека!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Нека дом Аронов каже:",
            "poem": 1
          },
          {
            "text": "„Јер је милост његова довека!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Нека кажу они који стрепе од Господа:",
            "poem": 1
          },
          {
            "text": "„Јер је милост његова довека!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "У тескоби Господа сам звао;",
            "poem": 1
          },
          {
            "text": "чуо ме је Господ,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "извео ме на пространо место.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Господ је на мојој страни, нећу се бојати;",
            "poem": 1
          },
          {
            "text": "шта ми може учинити човек?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Господ је на мојој страни,",
            "poem": 1
          },
          {
            "text": "међу мојим помагачима;",
            "poem": 2
          },
          {
            "text": "ја ћу само да ликујем",
            "poem": 1
          },
          {
            "text": "над онима што ме мрзе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Боље је у Господу уточиште наћи,",
            "poem": 1
          },
          {
            "text": "него у човеку ослонац пронаћи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Боље је у Господу уточиште наћи,",
            "poem": 1
          },
          {
            "text": "него у племићима ослонац пронаћи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Сви народи опколише мене,",
            "poem": 1
          },
          {
            "text": "али сам их потиснуо у име Господње.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Опколише ме, баш ме окружише,",
            "poem": 1
          },
          {
            "text": "али сам их потиснуо у име Господње.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Прекрише ме као пчеле,",
            "poem": 1
          },
          {
            "text": "ал’ згаснуше ко пламен у трњу,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер баш сам их потиснуо у име Господње.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Дивље су ме гурнули да паднем,",
            "poem": 1
          },
          {
            "text": "али ми је Господ помогао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Господ је моја сила и песма,",
            "poem": 1
          },
          {
            "text": "он ми је спасење!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Повик клицања и спасења",
            "poem": 1
          },
          {
            "text": "у шатору је праведника,",
            "poem": 2
          },
          {
            "text": "силна је на делу десница Господња.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Подигла се десница Господња!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Силна је на делу десница Господња!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ја умрети нећу, живећу",
            "poem": 1
          },
          {
            "text": "дела Господња да објавим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "А корио ме је Господ, баш ме је корио;",
            "poem": 1
          },
          {
            "text": "али смрти предао ме није.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Врата праведности отворите мени,",
            "poem": 1
          },
          {
            "text": "да кроз њих прођем и хвалим Господа!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "То су врата Господња,",
            "poem": 1
          },
          {
            "text": "праведни ће кроз њих проћи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Хвалићу те, јер си ми се одазвао,",
            "poem": 1
          },
          {
            "text": "јер си мени Спаситељ постао!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Камен што су зидари одбацили,",
            "poem": 1
          },
          {
            "text": "постаде камен угаони.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Од Господа ово беше",
            "poem": 1
          },
          {
            "text": "и то је дивно у нашим очима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Ово је дан саздан од Господа;",
            "poem": 1
          },
          {
            "text": "радујмо се и кличимо у њему!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "О, Господе, вапимо ти, спаси!",
            "poem": 1
          },
          {
            "text": "О, Господе, вапимо ти, успех дај нам!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Благословен онај који долази у име Господње!",
            "poem": 1
          },
          {
            "text": "Благосиљамо вас из Дома Господњег!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Господ је Бог,",
            "poem": 1
          },
          {
            "text": "нас је обасјао.",
            "poem": 2
          },
          {
            "text": "Жртву празничну конопцима завежите",
            "poem": 1
          },
          {
            "text": "за рогове жртвеника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Бог мој ти си, тебе ћу да хвалим;",
            "poem": 1
          },
          {
            "text": "о, мој Боже, тебе да величам!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Хвалите Господа јер је добар,",
            "poem": 1
          },
          {
            "text": "јер је милост његова довека!",
            "poem": 2
          }
        ]
      }
    ],
