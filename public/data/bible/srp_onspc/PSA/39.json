  "chapter": {
    "number": 39,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи, за Једутуна. Псалам Давидов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Зарекох се: „Пазићу на пут свој да не згрешим језиком,",
            "poem": 1
          },
          {
            "text": "држаћу узде на устима, све док је опаки преда мном.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Занемех, заћутах, чак ни што је добро не рекох,",
            "poem": 1
          },
          {
            "text": "али бол мој само жешћи поста.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Запалило се срце у мени,",
            "poem": 1
          },
          {
            "text": "у мислима мојим плануо је огањ,",
            "poem": 2
          },
          {
            "text": "те ја проговорих својим језиком:",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "„Објави ми, Господе, мој свршетак",
            "poem": 1
          },
          {
            "text": "и колика је дужина мојих дана,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да бих знао како сам пролазан.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ето, дао си ми дане не дуже од педља,",
            "poem": 1
          },
          {
            "text": "и век је мој као ништа пред тобом;",
            "poem": 2
          },
          {
            "text": "сваки човек, наизглед сигуран,",
            "poem": 1
          },
          {
            "text": "тек је дашак. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Баш као сенка човек пролази;",
            "poem": 1
          },
          {
            "text": "узалуд се кида и скупља богатство,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а не зна ко ће га побрати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Чему сада да се надам, Господе?",
            "poem": 1
          },
          {
            "text": "Моја нада је у теби.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Избави ме од свих мојих преступа,",
            "poem": 1
          },
          {
            "text": "не дај да будем на подсмех безумнику.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ја сам нем, не отварам уста,",
            "poem": 1
          },
          {
            "text": "јер ти си то сам учинио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Уклони свој бич од мене,",
            "poem": 1
          },
          {
            "text": "изгибох од силине руке твоје!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Кад опоменама караш човека због греха,",
            "poem": 1
          },
          {
            "text": "као мољац растачеш што му је најдраже;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да, сваки човек је тек дашак. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Послушај, Господе, моју молитву и чуј мој вапај,",
            "poem": 1
          },
          {
            "text": "не оглуши се о моје сузе,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер као дошљак код тебе пребивам, као сви преци моји.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Одврати свој поглед од мене, да одахнем,",
            "poem": 1
          },
          {
            "text": "пре него што одем и не буде ме више.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
