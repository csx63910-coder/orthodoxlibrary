  "chapter": {
    "number": 40,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "За хоровођу. Псалам Давидов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Стрпљиво сам чекао на Господа,",
            "poem": 1
          },
          {
            "text": "и он се пригнуо и чуо ми вапај.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Подигао ме је из јаме очаја,",
            "poem": 1
          },
          {
            "text": "из глиба блатњавог,",
            "poem": 2
          },
          {
            "text": "ноге ми је поставио на стену,",
            "poem": 1
          },
          {
            "text": "и учврстио кораке моје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "У уста ми је ставио нову песму,",
            "poem": 1
          },
          {
            "text": "хвалоспев Богу нашем.",
            "poem": 2
          },
          {
            "text": "Многи ће то видети, бојати се,",
            "poem": 1
          },
          {
            "text": "и поуздати се у Господа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Благо човеку који се узда у Господа,",
            "poem": 1
          },
          {
            "text": "а не окреће се охолима,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "или онима што иду за преваром.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Многа си своја чудеса учинио за нас, Господе, Боже мој,",
            "poem": 1
          },
          {
            "text": "и науми су твоји за нас неизбројиви.",
            "poem": 2
          },
          {
            "text": "А ја ћу јављати, говорити о њима,",
            "poem": 1
          },
          {
            "text": "којима нема броја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Жртве и приносе ниси пожелео,",
            "poem": 1
          },
          {
            "text": "али си ми зато уши отворио.",
            "poem": 2
          },
          {
            "text": "У жртвама свеспалницама",
            "poem": 1
          },
          {
            "text": "и жртвама за грех ниси уживао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Тада рекох: „Ево, долазим,",
            "poem": 1
          },
          {
            "text": "јер је тако написано за мене у свитку.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Желим да извршим вољу твоју, Боже мој;",
            "poem": 1
          },
          {
            "text": "Закон је твој у мом срцу.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Објављујем праведност у великом збору,",
            "poem": 1
          },
          {
            "text": "устима својим то не браним, Господе,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и ти то знаш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Праведност твоју не кријем у срцу,",
            "poem": 1
          },
          {
            "text": "већ говорим о верности и спасењу твоме,",
            "poem": 2
          },
          {
            "text": "не скривам милост и истину твоју од великог збора.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Господе, не ускраћуј ми милосрђе твоје;",
            "poem": 1
          },
          {
            "text": "нека ме милост и верност твоја штите довека.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Јер окружише ме невоље небројене,",
            "poem": 1
          },
          {
            "text": "безакоња ме моја сустигоше, видети не могу.",
            "poem": 2
          },
          {
            "text": "Бројни су као коса на мојој глави,",
            "poem": 1
          },
          {
            "text": "па ме срце моје издаје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Нека ти је мило, Господе, да ме избавиш!",
            "poem": 1
          },
          {
            "text": "У помоћ ми пожури, Господе!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Нека се постиде заједно, нека се осрамоте",
            "poem": 1
          },
          {
            "text": "они што ми о глави раде да је смакну;",
            "poem": 2
          },
          {
            "text": "нека се повуку у срамоти, нека буду понижени",
            "poem": 1
          },
          {
            "text": "ти што им је мила невоља моја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Нека се запање над срамотом својом,",
            "poem": 1
          },
          {
            "text": "ти што ми довикују: „Аха! Аха!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Нек ликују и нек се радују у теби",
            "poem": 1
          },
          {
            "text": "сви који те траже;",
            "poem": 2
          },
          {
            "text": "нека увек говоре они што спасење твоје воле:",
            "poem": 1
          },
          {
            "text": "„Велик је Господ!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "А ја сам сиромах и убог,",
            "poem": 1
          },
          {
            "text": "нека Господ мисли на мене.",
            "poem": 2
          },
          {
            "text": "Ти си ми помоћник и избавитељ.",
            "poem": 1
          },
          {
            "text": "О, мој Боже, не оклевај!",
            "poem": 2
          }
        ]
      }
    ],
