  "chapter": {
    "number": 130,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Песма поклоничка."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "О, Господе, из дубина ја тебе призивам!",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "О, Господе, чуј глас мој,",
            "poem": 2
          },
          {
            "text": "ухо своје пригни",
            "poem": 1
          },
          {
            "text": "позиву преклињања мојих!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "О, Господе, будеш ли кривице задржавао,",
            "poem": 1
          },
          {
            "text": "ко би онда опстао, Господе?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Али у теби је опраштање",
            "poem": 1
          },
          {
            "text": "да би те се бојали.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Господа ја ишчекујем,",
            "poem": 1
          },
          {
            "text": "ишчекује душа моја;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "његовој се речи надам.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Душа моја Господа ишчекује",
            "poem": 1
          },
          {
            "text": "више но стражари јутро,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "више но стражари јутро.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "О, Израиљу, Господу се надај!",
            "poem": 1
          },
          {
            "text": "Јер милостив је Господ,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "откупљује пребогато.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Баш он ће да откупи Израиљ",
            "poem": 1
          },
          {
            "text": "од свих његових кривица.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
