  "chapter": {
    "number": 19,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. Псалам Давидов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Небеса причају о слави Божијој,",
            "poem": 1
          },
          {
            "text": "небо објављује дело руку његових.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Један дан другом дану јавља,",
            "poem": 1
          },
          {
            "text": "а ноћ ноћи преноси сазнање.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Нема говора, нема ни језика,",
            "poem": 1
          },
          {
            "text": "где се глас њихов није зачуо.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Глас је целом одјекнуо земљом,",
            "poem": 1
          },
          {
            "text": "речи су им до накрај света стигле.",
            "poem": 2
          },
          {
            "text": "Сунцу је на небу шатор разапео,",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "па оно као женик из собе излази,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "весело као јунак што трчи по путу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Излазак му је на једном крају неба,",
            "poem": 1
          },
          {
            "text": "а ход му је до његовог краја;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "нема скривања од његове јаре.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Закон је Господњи беспрекоран – обнавља душу,",
            "poem": 1
          },
          {
            "text": "поуздано је сведочанство Господње – умудрује лаковерног.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Праведне су одлуке Господње – веселе срце;",
            "poem": 1
          },
          {
            "text": "без мане су судови Господњи – просветљују очи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Чист је страх Господњи – траје довека;",
            "poem": 1
          },
          {
            "text": "истинити су судови Господњи – праведни су сви заједно.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Пожељнији од злата, злата жеженог,",
            "poem": 1
          },
          {
            "text": "слађи су од меда што тече из саћа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Њима се твој слуга опомиње,",
            "poem": 1
          },
          {
            "text": "ко њих чува велику награду прима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ко ће разазнати своје погрешке?",
            "poem": 1
          },
          {
            "text": "Очисти ме и од оних скривених.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "И од вољних греха чувај слугу свога;",
            "poem": 1
          },
          {
            "text": "не дозволи да овладају мноме.",
            "poem": 2
          },
          {
            "text": "Тада ћу ја бити без кривице,",
            "poem": 1
          },
          {
            "text": "и недужан за велики преступ.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Нека речи мојих уста и мисли мога срца,",
            "poem": 1
          },
          {
            "text": "теби буду угодне, Господе, стено моја, откупитељу мој.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
