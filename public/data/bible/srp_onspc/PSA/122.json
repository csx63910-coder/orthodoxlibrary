  "chapter": {
    "number": 122,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Песма поклоничка. Давидова."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Обрадовао сам се када су ми рекли:",
            "poem": 1
          },
          {
            "text": "„Идемо у Дом Господњи!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ево нас, стојимо на вратима твојим,",
            "poem": 1
          },
          {
            "text": "о, Јерусалиме!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Јерусалим, град подигнут,",
            "poem": 1
          },
          {
            "text": "постојан и складан.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Племена се у њега успињу,",
            "poem": 1
          },
          {
            "text": "Господња племена",
            "poem": 2
          },
          {
            "text": "према пропису за Израиљ,",
            "poem": 1
          },
          {
            "text": "да хвалоспев дају Господњем имену.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Јер престоли суда су постављени тамо,",
            "poem": 1
          },
          {
            "text": "престоли дома Давидовог.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Молите се за мир Јерусалима!",
            "poem": 1
          },
          {
            "text": "Они што те воле нека напредују!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Нека буде мира међу твојим зидинама,",
            "poem": 1
          },
          {
            "text": "благостања међу твојим дворовима!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ради браће моје, пријатеља мојих,",
            "poem": 1
          },
          {
            "text": "кажем: „Мир у теби био!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ради Дома Господа, Бога нашег,",
            "poem": 1
          },
          {
            "text": "твоје добро тражим!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
