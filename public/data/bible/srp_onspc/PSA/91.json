  },
  "chapter": {
    "number": 91,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "У заклону Свевишњег ко пребива,",
            "poem": 1
          },
          {
            "text": "у сенци Свемоћног тај почива!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Господу ћу рећи:",
            "poem": 1
          },
          {
            "text": "„Мој заклоне и тврђаво моја!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Мој Боже у кога се уздам.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Јер он ће те избавити",
            "poem": 1
          },
          {
            "text": "из птичарске омче",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и помора кобног.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Својим перјем покриће те,",
            "poem": 1
          },
          {
            "text": "сакрићеш се под његова крила;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "штит и бедем истина је његова.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Страхоте ноћне нећеш се плашити,",
            "poem": 1
          },
          {
            "text": "а ни стреле која дању лети;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "ни помора што се мраком шуња,",
            "poem": 1
          },
          {
            "text": "ни заразе што коси у подне.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Поред тебе хиљада ће пасти,",
            "poem": 1
          },
          {
            "text": "теби здесна и десет хиљада,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а теби се приближити неће!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Само ћеш рођеним очима да гледаш,",
            "poem": 1
          },
          {
            "text": "над опаким видећеш освету.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Зато што си у Господу, у уточишту моме,",
            "poem": 1
          },
          {
            "text": "у Свевишњем пребивалиште себи нашао",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "зло те задесити неће,",
            "poem": 1
          },
          {
            "text": "и ни близу твог шатора пошаст прићи неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Јер он ће заповедити својим анђелима",
            "poem": 1
          },
          {
            "text": "да те чувају на свим твојим путевима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Они ће те понети на својим рукама,",
            "poem": 1
          },
          {
            "text": "да ногом не би о камен запео.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Изгазићеш и лава и змију,",
            "poem": 1
          },
          {
            "text": "прегазићеш лавића и гују.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "„Избавићу га јер ми је привржен;",
            "poem": 1
          },
          {
            "text": "на висину, у заклон га стављам,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер познаје моје име.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Он ће мене звати, а ја ћу му се одазвати;",
            "poem": 1
          },
          {
            "text": "бићу са њим у невољи да га спасем",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и учиним часним.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Животом дугим ћу га наситити,",
            "poem": 1
          },
          {
            "text": "даћу му да види избављење моје.“",
            "poem": 2
          }
        ]
      }
    ],
