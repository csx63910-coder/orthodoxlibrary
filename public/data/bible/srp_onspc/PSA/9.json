  "chapter": {
    "number": 9,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "За хоровођу, по напеву „Смрт сина“. Псалам Давидов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Славићу Господа свим срцем својим,",
            "poem": 1
          },
          {
            "text": "причаћу о свим твојим чудесима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Веселићу се, теби ћу клицати,",
            "poem": 1
          },
          {
            "text": "твоме ћу имену певати, Свевишњи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Кад се моји непријатељи повуку у бегу,",
            "poem": 1
          },
          {
            "text": "нека се саплету и пропадну пред тобом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Јер ти си одбранио моје право и суд,",
            "poem": 1
          },
          {
            "text": "сео си на престо да судиш по правди.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Укорио си народе, уништио опаке,",
            "poem": 1
          },
          {
            "text": "затро си им име у веке векова.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Докрајчен је душманин,",
            "poem": 1
          },
          {
            "text": "у рушевинама је довека,",
            "poem": 2
          },
          {
            "text": "градове си му истребио,",
            "poem": 1
          },
          {
            "text": "спомен на њих избрисао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Али Господ столује до века,",
            "poem": 1
          },
          {
            "text": "престо је свој поставио да суди,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "и свету ће судити по правди,",
            "poem": 1
          },
          {
            "text": "једнако ће судити народима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Господ је заклон угњетеном,",
            "poem": 1
          },
          {
            "text": "заклон у време невоље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Нека се уздају у тебе они који твоје име знају,",
            "poem": 1
          },
          {
            "text": "јер ти, Господе, не остављаш оне што те траже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Певајте Господу, који столује на Сиону!",
            "poem": 1
          },
          {
            "text": "Причајте народима о делима његовим!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Јер онај што се свети за проливену крв,",
            "poem": 1
          },
          {
            "text": "он памти, не заборавља вапај понизних.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Смилуј ми се, о, Господе,",
            "poem": 1
          },
          {
            "text": "види како ме киње мрзитељи моји",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "– ти што ме извлачиш из врата смрти –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "да бих навештао сва славна дела твоја",
            "poem": 1
          },
          {
            "text": "на дверима ћерке сионске,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и тамо се радовао твојему спасењу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Народи јаму ископаше, ал’ у њу сами упадоше,",
            "poem": 1
          },
          {
            "text": "нога им се ухвати у мрежу коју сакрише.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Господ је себе учинио знаним,",
            "poem": 1
          },
          {
            "text": "он поступа по праву,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а опаки се хвата у замку своје руке. Мисли. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Нека се опаки врате у Свет мртвих,",
            "poem": 1
          },
          {
            "text": "сви народи који Бога заборављају,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "јер убоги неће увек бити заборављен,",
            "poem": 1
          },
          {
            "text": "нити пропасти нада понизних.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Устани, Господе,",
            "poem": 1
          },
          {
            "text": "нека човек не надвлада,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "нека се суди народима пред тобом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Утерај им страх у кости, Господе,",
            "poem": 1
          },
          {
            "text": "нека знају пуци да су само људи. Села",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
