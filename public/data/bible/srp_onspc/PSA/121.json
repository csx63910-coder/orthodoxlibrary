  "chapter": {
    "number": 121,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Песма поклоничка."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Своје очи ка горама дижем.",
            "poem": 1
          },
          {
            "text": "Одакле ће мени помоћ доћи?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Доћи ће ми помоћ од Господа,",
            "poem": 1
          },
          {
            "text": "Саздатеља небеса и земље!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Нози твојој да посрне не да,",
            "poem": 1
          },
          {
            "text": "твој заштитник задремати неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Гле, не дрема и не спава",
            "poem": 1
          },
          {
            "text": "заштитник Израиља!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Господ је заштитник твој!",
            "poem": 1
          },
          {
            "text": "Господ ти је сенка с твоје десне стране.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Неће ти шкодити ни сунце по дану",
            "poem": 1
          },
          {
            "text": "ни месец по ноћи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Од свакога зла Господ ће те заштитити,",
            "poem": 1
          },
          {
            "text": "заштитиће душу твоју.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Господ ће те заштитити када будеш одлазио",
            "poem": 1
          },
          {
            "text": "и кад будеш долазио,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "од сада па довека!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
