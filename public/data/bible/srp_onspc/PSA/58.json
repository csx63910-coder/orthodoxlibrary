  "chapter": {
    "number": 58,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. Давидов напев: „Не погуби.“ Песма поуздања у Бога."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Зар ћутањем праведност јављате?",
            "poem": 1
          },
          {
            "text": "Судите ли подједнако потомцима људи?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Штавише, смишљате неправду да је чините;",
            "poem": 1
          },
          {
            "text": "рукама својим насиље земљом размеравате.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Застранише зликовци од мајчиног крила,",
            "poem": 1
          },
          {
            "text": "залуташе говорници лажи од стомака.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Њихов отров наликује змијском отрову;",
            "poem": 1
          },
          {
            "text": "попут кобриног је, што је глува, затвореног ува;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "што не чује глас шаптача,",
            "poem": 1
          },
          {
            "text": "врачара вештог у бацању врачки.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Зубе им, Боже, у устима поломи;",
            "poem": 1
          },
          {
            "text": "Господе, чељусти лавићима скрши.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Нек испаре попут вода што отичу својим путем;",
            "poem": 1
          },
          {
            "text": "стреле своје нек одапну као да су поломљене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Нек исцуре попут пужа који пузи,",
            "poem": 1
          },
          {
            "text": "нек су попут мртворођенчета што не види сунца.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Пре него ти лонци осете потпалу од трња –",
            "poem": 1
          },
          {
            "text": "сировог ил’ свелог –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "биће развејано.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "А праведник ће се радовати кад види освету;",
            "poem": 1
          },
          {
            "text": "ноге ће опрати у крви зликовца.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "И казаће свако:",
            "poem": 1
          },
          {
            "text": "„Праведнику стварно плод припада.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Стварно има Бога који суди земљи.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
