  "chapter": {
    "number": 6,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи, уз жичане инструменте. За дубоке гласове. Псалам Давидов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Не карај ме, Господе, у своме гневу,",
            "poem": 1
          },
          {
            "text": "у срџби ме својој не кажњавај.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Смилуј ми се, Господе, јер сам клонуо,",
            "poem": 1
          },
          {
            "text": "исцели ме, Господе, кости ми се тресу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Душа ми је врло устрептала,",
            "poem": 1
          },
          {
            "text": "докле, Господе, докле ћеш чекати?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Окрени се, Господе, избави ми душу,",
            "poem": 1
          },
          {
            "text": "спаси мене због милости своје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Јер, мртав човек тебе не спомиње,",
            "poem": 1
          },
          {
            "text": "ко ће те из Света мртвих",
            "poem": 2
          },
          {
            "noteId": 2
          },
          {
            "text": "прослављати?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Од јецања сасвим сам клонуо;",
            "poem": 1
          },
          {
            "text": "сву ноћ лежај ја плачем натапам,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и свој кревет сузама обливам.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Око моје од муке се гаси,",
            "poem": 1
          },
          {
            "text": "ишчезава због свих мојих душмана.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Одбијте од мене, сви преступници,",
            "poem": 1
          },
          {
            "text": "јер чуо је Господ глас мог вапаја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Чуо је Господ моју молбу,",
            "poem": 1
          },
          {
            "text": "Господ прима моју молитву.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Нек се осрамоте сви моји душмани,",
            "poem": 1
          },
          {
            "text": "нек великој смутњи подлегну,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "нек се одмах повуку у сраму.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 2,
