  "chapter": {
    "number": 145,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Давидова похвална песма."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "О, мој Боже, о, царе, величаћу тебе,",
            "poem": 1
          },
          {
            "text": "име твоје благосиљаћу у веке векова!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Сваког дана благосиљаћу те,",
            "poem": 1
          },
          {
            "text": "име ћу ти прослављати у веке векова.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Велики је Господ, предостојан славе,",
            "poem": 1
          },
          {
            "text": "величанства недокучивога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Поколење поколењу твоја дела разглашава,",
            "poem": 1
          },
          {
            "text": "обзнањује силу твоју.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "О красоти славе величанства твога,",
            "poem": 1
          },
          {
            "text": "о стварима чудним твојим ја ћу да размишљам",
            "poem": 2
          },
          {
            "noteId": 13
          },
          {
            "text": ".",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Говориће људи о снази твојих страшних дела,",
            "poem": 1
          },
          {
            "text": "а и ја ћу да сведочим о твом величанству.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Казиваће сећање о твојој великој доброти,",
            "poem": 1
          },
          {
            "text": "клицаће радосно о праведности твојој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Милосрдан и милостив је Господ,",
            "poem": 1
          },
          {
            "text": "спор на срџбу и богат милошћу!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Свакоме је Господ добар,",
            "poem": 1
          },
          {
            "text": "милосрдан свим својим делима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "О, Господе, славиће те свако дело твоје;",
            "poem": 1
          },
          {
            "text": "твоји верни благосиљаће те!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "О слави твога царства говориће,",
            "poem": 1
          },
          {
            "text": "о снази твојој сведочиће;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "дела ће му силна објавити људима,",
            "poem": 1
          },
          {
            "text": "и славну красоту његовога царства.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Царство свих времена јесте царство твоје,",
            "poem": 1
          },
          {
            "text": "твоја владавина за све нараштаје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Господ је ослонац за све који падну,",
            "poem": 1
          },
          {
            "text": "узданица за све понижене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Тебе очекују баш свачије очи",
            "poem": 1
          },
          {
            "text": "и ти им дајеш храну кад је томе време.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Руку своју ти отвараш",
            "poem": 1
          },
          {
            "text": "и ситиш жељу сваког живог бића.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "На свим путевима својим праведан је Господ",
            "poem": 1
          },
          {
            "text": "и веран је у сваком подухвату.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Господ је близак свима што га призивају,",
            "poem": 1
          },
          {
            "text": "свима што га у истини зову.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Испуњава чежњу богобојазнима,",
            "poem": 1
          },
          {
            "text": "спасава их када чује како вапе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Господ брани све који га воле,",
            "poem": 1
          },
          {
            "text": "а злотворе све ће да разори.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Господу ће уста моја ускликнути славопоје!",
            "poem": 1
          },
          {
            "text": "Нек све живо благосиља то свето му име,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "у веке векова!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 13,
        "caller": "+",
        "text": "145,5 Овај глагол, ова мисао се може превести и овако: ја ћу да говорим.",
        "reference": {
          "chapter": 145,
          "verse": 5
        }
      }
    ]
  },
