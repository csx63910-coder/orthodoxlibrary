  "chapter": {
    "number": 46,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. За потомке Корејеве. Песма за високе гласове."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Бог нам је уточиште и сила,",
            "poem": 1
          },
          {
            "text": "трајни помоћник у невољи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Не бојмо се, зато, кад се земља љуља,",
            "poem": 1
          },
          {
            "text": "кад се горе руше у дубине мора.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ма, нек буче и пене се његове воде,",
            "poem": 1
          },
          {
            "text": "нек се горе тресу од његове силе. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Тече река и њене притоке,",
            "poem": 1
          },
          {
            "text": "граду Божијем радост доносе,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "светом месту где Свевишњи живи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Бог је усред њега, помаћи се неће,",
            "poem": 1
          },
          {
            "text": "Бог ће му помоћи у сам освит јутра.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Буне се народи, пропадају царства,",
            "poem": 1
          },
          {
            "text": "кад глас повиси земља се раствара.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "С нама је Господ над војскама,",
            "poem": 1
          },
          {
            "text": "Бог Јаковљев наша је тврђава. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Дођите, размотрите дела Господња,",
            "poem": 1
          },
          {
            "text": "који пустош по земљи оставља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Он прекида ратове до на крај земље,",
            "poem": 1
          },
          {
            "text": "лук крши, копље прелама,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "бојна кола огњу изручује.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Утихните и знајте да сам ја Бог,",
            "poem": 1
          },
          {
            "text": "узвишен међу народима,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "узвишен на земљи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "С нама је Господ над војскама,",
            "poem": 1
          },
          {
            "text": "Бог Јаковљев наша је тврђава. Села",
            "poem": 2
          }
        ]
      }
    ],
