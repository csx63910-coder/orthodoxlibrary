  "chapter": {
    "number": 64,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. Псалам Давидов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Чуј, о, Боже, глас мој, жалопојку моју;",
            "poem": 1
          },
          {
            "text": "од страхоте противника живот ми сачувај.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Заклони ме од сплетки злотвора,",
            "poem": 1
          },
          {
            "text": "од халабуке починитеља злобе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Језике своје попут мача они оштре,",
            "poem": 1
          },
          {
            "text": "одапињу стреле своје – речи заједљиве –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "да из скривених места",
            "poem": 1
          },
          {
            "text": "гађају човека без мане;",
            "poem": 2
          },
          {
            "text": "и наједном гађају га",
            "poem": 1
          },
          {
            "text": "и страха немају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Соколе се међу собом на зле ствари,",
            "poem": 1
          },
          {
            "text": "договарају се да прикрију клопке,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "па говоре: „Ко ће да их види?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Сплићу неправду:",
            "poem": 1
          },
          {
            "text": "„Смислили смо! Сплетка је сплетена.“",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Дубоки су човекова нутрина и срце.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Али Бог ће их стрелом гађати",
            "poem": 1
          },
          {
            "text": "и наједном рањени ће бити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "О свој језик саплеће се,",
            "poem": 1
          },
          {
            "text": "задрхтаће свако ко их гледа;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "препашће се сав род људски,",
            "poem": 1
          },
          {
            "text": "објавиће дело Божије",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и његово дело разматраће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Радоваће се праведник у Господу,",
            "poem": 1
          },
          {
            "text": "у њему ће уточиште наћи,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "па ће се хвалити свако срца честитога.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
