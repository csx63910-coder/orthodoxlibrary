  },
  "chapter": {
    "number": 132,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Песма поклоничка."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "О, Господе, Давида се сети",
            "poem": 1
          },
          {
            "text": "и свих мука његових;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "како се Господу заклео",
            "poem": 1
          },
          {
            "text": "и заветовао Силном Јаковљевом:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "„У шатор дома свога нећу ући,",
            "poem": 1
          },
          {
            "text": "на постељу кревета свог нећу лећи;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "очима сна нећу дати,",
            "poem": 1
          },
          {
            "text": "ни капцима да се спусте;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "док не нађем место за Господа,",
            "poem": 1
          },
          {
            "text": "Пребивалиште Силном Јаковљевом!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Гле! Ми смо за то у Ефрати чули,",
            "poem": 1
          },
          {
            "text": "у пољима јаримским нашли смо га.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Пођимо у Пребивалиште његово!",
            "poem": 1
          },
          {
            "text": "Поклонимо се код подножја његових ногу!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Уздигни се, о, Господе, на место свог починка;",
            "poem": 1
          },
          {
            "text": "ти и Ковчег Силе твоје!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Свештеници нек огрну правду,",
            "poem": 1
          },
          {
            "text": "твоји верни нек радосно кличу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Због Давида, слуге свога,",
            "poem": 1
          },
          {
            "text": "не окрећи се од лица свог помазаника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Давиду се истински заклео Господ",
            "poem": 1
          },
          {
            "text": "и порећи неће:",
            "poem": 2
          },
          {
            "text": "„Једног од твојих потомака",
            "poem": 1
          },
          {
            "text": "поставићу на твој престо.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ако синови твоји буду држали мој савез",
            "poem": 1
          },
          {
            "text": "и прописе моје, што ћу их учити,",
            "poem": 2
          },
          {
            "text": "и синови ће њихови довека седети",
            "poem": 1
          },
          {
            "text": "на престолу твоме.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Да, Господ је Сион изабрао,",
            "poem": 1
          },
          {
            "text": "за Пребивалиште своје пожелео га је:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "„Довека је ово место мог починка,",
            "poem": 1
          },
          {
            "text": "ту ћу да боравим јер сам тако пожелео.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Шта му треба, даћу изобилно;",
            "poem": 1
          },
          {
            "text": "убоге му нахранићу хлебом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "У спасење ћу му обући свештенике,",
            "poem": 1
          },
          {
            "text": "верни ће му подцикивати, клицати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Даћу да Давиду рог моћи узрасте,",
            "poem": 1
          },
          {
            "text": "светиљку ћу да поставим за свог помазаника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "У срамоту ја завићу душмане његове,",
            "poem": 1
          },
          {
            "text": "а на њему његова ће круна да заблиста!“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
