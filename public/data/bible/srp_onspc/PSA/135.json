  },
  "chapter": {
    "number": 135,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Славите Господа!",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Славите име Господње!",
            "poem": 1
          },
          {
            "text": "Славите, о, слуге Господње;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "ви што стојите у Господњем Дому,",
            "poem": 1
          },
          {
            "text": "у двориштима Дома Бога нашег!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Славите Господа јер је добар Господ.",
            "poem": 1
          },
          {
            "text": "Песмом му прослављајте име,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер је мило.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Јер, Јакова је себи изабрао,",
            "poem": 1
          },
          {
            "text": "Израиља за своју драгоцену својину.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Заиста, ја знам да је велик Господ,",
            "poem": 1
          },
          {
            "text": "наш је Господ већи од свих божанстава.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Све што хоће, то Господ и чини –",
            "poem": 1
          },
          {
            "text": "на небесима и на земљи,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "у морима и у свим дубинама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Он подиже облаке с краја земље,",
            "poem": 1
          },
          {
            "text": "киши муње даје",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и изводи ветар из својих ризница.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Он је побио првенце у Египту,",
            "poem": 1
          },
          {
            "text": "како људе, тако животиње.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Послао је знакове и чудеса усред тебе, Египте,",
            "poem": 1
          },
          {
            "text": "на фараона и све његове слуге.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Побио је народе многе,",
            "poem": 1
          },
          {
            "text": "погубио је цареве силне –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Сихона, аморејског цара;",
            "poem": 1
          },
          {
            "text": "Ога, васанскога цара",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и сва царства у Ханану.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Њихову је земљу дао у наследство,",
            "poem": 1
          },
          {
            "text": "у наследство за свој народ, за Израиљ.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "О, Господе, вечито је име твоје!",
            "poem": 1
          },
          {
            "text": "О, Господе, спомињеш се кроз нараштај сваки!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Господ ће судити",
            "poem": 1
          },
          {
            "noteId": 12
          },
          {
            "text": "своме народу,",
            "poem": 1
          },
          {
            "text": "на своје ће се слуге сажалити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Сребро су и злато идоли народа,",
            "poem": 1
          },
          {
            "text": "људских руку дело.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Са устима – а неми,",
            "poem": 1
          },
          {
            "text": "са очима – а слепи;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "са ушима – а глуви,",
            "poem": 1
          },
          {
            "text": "у устима им нема даха.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Такви ће да буду ти што су их начинили,",
            "poem": 1
          },
          {
            "text": "сви који се у њих поуздају!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Благосиљај Господа, о, доме Израиљев!",
            "poem": 1
          },
          {
            "text": "Благосиљај Господа, о, доме Аронов!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Благосиљај Господа, о, доме Левијев!",
            "poem": 1
          },
          {
            "text": "Благосиљајте Господа, о, сви што стрепите од Господа!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Благословен нек је са Сиона Господ,",
            "poem": 1
          },
          {
            "text": "у Јерусалиму што пребива!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Славите Господа!",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 12,
        "caller": "+",
        "text": "135,14 Ово је суд на коме Бог брани, оправдава.",
        "reference": {
          "chapter": 135,
          "verse": 14
        }
      }
    ]
