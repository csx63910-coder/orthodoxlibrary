    "commonName": "Псалм",
    "title": "Псалми",
    "order": 19,
    "numberOfChapters": 150,
    "sha256": "26caf786163c3156cd828b9195dd87c0a9678ee51bdea32fbef70df99683a272",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/PSA/1.json",
    "lastChapterNumber": 150,
    "lastChapterApiLink": "/api/srp_onspc/PSA/150.json",
    "totalNumberOfVerses": 2461
  },
  "chapter": {
    "number": 27,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Давидов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Господ ми је светлост и спасење,",
            "poem": 1
          },
          {
            "text": "кога да се бојим?",
            "poem": 2
          },
          {
            "text": "Господ је моја тврђава,",
            "poem": 1
          },
          {
            "text": "од кога да страхујем?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Кад на мене навале опаки",
            "poem": 1
          },
          {
            "text": "да ми тело ждеру,",
            "poem": 2
          },
          {
            "text": "моји противници и душмани,",
            "poem": 1
          },
          {
            "text": "они се спотичу и падају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Па да и војска крене против мене,",
            "poem": 1
          },
          {
            "text": "моје се срце неће уплашити.",
            "poem": 2
          },
          {
            "text": "Да се и рат поведе против мене,",
            "poem": 1
          },
          {
            "text": "и тада ћу бити пун поуздања.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Једно тражим од Господа",
            "poem": 1
          },
          {
            "text": "и за тиме жудим:",
            "poem": 2
          },
          {
            "text": "да пребивам у Дому Господњем",
            "poem": 1
          },
          {
            "text": "кроз све дане свог живота;",
            "poem": 2
          },
          {
            "text": "да посматрам лепоту Господњу,",
            "poem": 1
          },
          {
            "text": "и савет потражим у његовом Дому.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Јер он ме склања под сеницу своју",
            "poem": 1
          },
          {
            "text": "у дан невоље,",
            "poem": 2
          },
          {
            "text": "скрива ме у скровишту свог шатора,",
            "poem": 1
          },
          {
            "text": "на стену ме подиже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Узвисила се сада моја глава",
            "poem": 1
          },
          {
            "text": "изнад мојих душмана око мене:",
            "poem": 2
          },
          {
            "text": "у његовом шатору жртве ћу хвале принети,",
            "poem": 1
          },
          {
            "text": "певаћу Господу, песмом га славити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Чуј, Господе, глас мој,",
            "poem": 1
          },
          {
            "text": "смилуј ми се, услиши ме!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Моје ме срце упућује к теби:",
            "poem": 1
          },
          {
            "text": "„Тражи лице моје.“",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Твоје лице тражим, Господе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Не криј своје лице од мене,",
            "poem": 1
          },
          {
            "text": "не изручи гневу слугу свога,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ти си увек био моја помоћ,",
            "poem": 2
          },
          {
            "text": "не напуштај ме, не остављај ме,",
            "poem": 1
          },
          {
            "text": "Боже спасења мога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ако ме напусте и отац и мајка,",
            "poem": 1
          },
          {
            "text": "Господ ће ме примити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Учи ме, Господе, своме путу,",
            "poem": 1
          },
          {
            "text": "равном ме стазом води,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ради мрзитеља мојих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Не предај ме вољи мога противника,",
            "poem": 1
          },
          {
            "text": "јер лажни сведоци устају на мене,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "који одишу насиљем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ја верујем да ћу видети доброту Господњу",
            "poem": 1
          },
          {
            "text": "у земљи живих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Чекај на Господа:",
            "poem": 1
          },
          {
            "text": "буди јак и одважна срца,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и чекај на Господа.",
            "poem": 2
          }
        ]
      }
    ],
