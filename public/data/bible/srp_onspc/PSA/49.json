  "chapter": {
    "number": 49,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. Потомака Корејевих. Псалам."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Чујте ово, о, сви народи;",
            "poem": 1
          },
          {
            "text": "послушајте, сви житељи света;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "потомци људи, потомци човекови; богати и сиромаси.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Моја ће уста објавити мудрост",
            "poem": 1
          },
          {
            "text": "и размишљање срца мога биће разборито.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ухо своје приклонићу пословици,",
            "poem": 1
          },
          {
            "text": "загонетку своју изложићу уз харфу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Од злих дана зашто да страхујем,",
            "poem": 1
          },
          {
            "text": "кад кривица зликовачка опколи ме;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "баш оних што се у имање своје уздају,",
            "poem": 1
          },
          {
            "text": "и обиљем се свог богатства хвале?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Не може човек брата свог да откупи,",
            "poem": 1
          },
          {
            "text": "не може за њега Богу накнаду да плати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Елем, висок је откуп за његов живот;",
            "poem": 1
          },
          {
            "text": "довека је неизмирив",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "да би довека живео",
            "poem": 1
          },
          {
            "text": "и гроба не би видео.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Јер човек види да мудар умире;",
            "poem": 1
          },
          {
            "text": "да и безумник и онај без памети пропадају,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да другима имања своја остављају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "У себи мисле да им домови довека остају,",
            "poem": 1
          },
          {
            "text": "и њихова места од поколења до поколења;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "именом својим земље називају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Тек, човек ни у раскоши не истрајава,",
            "poem": 1
          },
          {
            "text": "већ је попут стоке што угине.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "То је пут њихов – лудило –",
            "poem": 1
          },
          {
            "text": "али и оних што након њих",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "уживају у њиховим говорима. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Попут оваца одређени су за Свет мртвих,",
            "poem": 1
          },
          {
            "text": "смрт ће их напасати.",
            "poem": 2
          },
          {
            "text": "Праведни ће јутром владати над њима.",
            "poem": 1
          },
          {
            "text": "Лик ће им прогутати Свет мртвих,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "далеко од њиховог дома.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Зацело ће Бог душу моју да откупи из руку Света мртвих,",
            "poem": 1
          },
          {
            "text": "јер он ће ме прихватити. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Не плаши се кад се било ко богати,",
            "poem": 1
          },
          {
            "text": "када расте слава дома његовога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Јер кад умре, понети ништа неће;",
            "poem": 1
          },
          {
            "text": "слава његова за њим неће сићи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "А он себе у животу благосиља –",
            "poem": 1
          },
          {
            "text": "и људи те хвале кад си себи добро учинио –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "али ће поћи поколењу својих предака,",
            "poem": 1
          },
          {
            "text": "где довека светло видети неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Човек у раскоши, а без разума",
            "poem": 1
          },
          {
            "text": "је попут стоке што угине.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
