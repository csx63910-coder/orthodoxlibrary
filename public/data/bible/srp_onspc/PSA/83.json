  },
  "chapter": {
    "number": 83,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Песма. Псалам Асафов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "О, Боже, немој да заћутиш!",
            "poem": 1
          },
          {
            "text": "Не онеми,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "немој да мирујеш, о Боже!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Гле, ено их буче твоји душмани,",
            "poem": 1
          },
          {
            "text": "главу дижу они што те мрзе!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Сплетке кују против твог народа",
            "poem": 1
          },
          {
            "text": "и заверу праве твоме штићенику.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Рекли су: „Дођите, дајте да их сатремо као народ,",
            "poem": 1
          },
          {
            "text": "да се име Израиља више не спомене!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ено, сви су сложни у замисли",
            "poem": 1
          },
          {
            "text": "да против тебе савез склопе:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "шатори Едома и Исмаила,",
            "poem": 1
          },
          {
            "text": "Моава и Агарина;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Гевала, Амона и Амалика,",
            "poem": 1
          },
          {
            "text": "Филистејци с житељима Тира.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Још им је и Асирија пришла,",
            "poem": 1
          },
          {
            "text": "пристала ко војска уз децу Лотову. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Учини им као Мадијану и као Сисери,",
            "poem": 1
          },
          {
            "text": "као Јавину на потоку Кисону!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Били су потрвени код Ен-Дора,",
            "poem": 1
          },
          {
            "text": "претворени у ђубриво за њиву.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "С племићима им поступи као с Оривом и Зивом,",
            "poem": 1
          },
          {
            "text": "а са кнезовима њиховим као са Зевејем и Салманом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Јер они говоре:",
            "poem": 1
          },
          {
            "text": "„Заузмимо Божије пашњаке!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "О, мој Боже, претвори их у клупко корова,",
            "poem": 1
          },
          {
            "text": "у плеву на ветру!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ко кад ватра шуму пали",
            "poem": 1
          },
          {
            "text": "и ко кад пламен горе жари,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "тако их потерај вихором својим,",
            "poem": 1
          },
          {
            "text": "ужасни их својом олујом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Бешчашћем им лице покриј,",
            "poem": 1
          },
          {
            "text": "па нек вапе за именом твојим, о, Господе!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Нек се стиде и смету довека!",
            "poem": 1
          },
          {
            "text": "Нек пропадну срамећи се!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Па нека се зна – име ти је Господ –",
            "poem": 1
          },
          {
            "text": "над земљом си целом ти једини Свевишњи!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
