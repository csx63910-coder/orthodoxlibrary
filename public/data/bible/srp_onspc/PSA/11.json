  "chapter": {
    "number": 11,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. Давидов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Уточиште је мени у Господу.",
            "poem": 1
          },
          {
            "text": "Зашто онда мени говорите:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Као птица у гору утеци!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Јер, гле, опаки лук свој натежу,",
            "poem": 1
          },
          {
            "text": "на тетиву стрелу постављају,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да поштене из мрака гађају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Када се темељи распадају,",
            "poem": 1
          },
          {
            "text": "шта праведник може да учини?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Господ је у свом светом храму,",
            "poem": 1
          },
          {
            "text": "Господњи је престо на небесима,",
            "poem": 2
          },
          {
            "text": "очима он помно посматра,",
            "poem": 1
          },
          {
            "text": "он прониче потомке људи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Праведнога испитује Господ,",
            "poem": 1
          },
          {
            "text": "али душа његова мрзи онога,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ко је опак и воли насиље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "На опаког он ће сручити",
            "poem": 1
          },
          {
            "text": "ужарено угљевље и сумпор;",
            "poem": 2
          },
          {
            "text": "пламенови огњеног вихора,",
            "poem": 1
          },
          {
            "text": "то је део њихов, то им је у чаши.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Јер праведан је Господ,",
            "poem": 1
          },
          {
            "text": "праведност он воли,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "поштени ће гледати му лице.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
