  "chapter": {
    "number": 20,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. Псалам Давидов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Нека те Господ услиши у дан невоље,",
            "poem": 1
          },
          {
            "text": "нека те име Бога Јаковљевог штити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Нека ти пошаље помоћ из Светиње,",
            "poem": 1
          },
          {
            "text": "са Сиона нека те подупре.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Нека се сети свих твојих приноса,",
            "poem": 1
          },
          {
            "text": "и свеспалницу твоју нека прими. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Нека ти да што ти срце хоће,",
            "poem": 1
          },
          {
            "text": "и сваку замисао твоју нека испуни.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "А ми ћемо клицати ради твог спасења,",
            "poem": 1
          },
          {
            "text": "и у име Бога нашега дизати заставе.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Нека Господ испуни све твоје молбе.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Сада знам да Господ спасава свога помазаника,",
            "poem": 1
          },
          {
            "text": "и услишава га са свог светог неба,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "силним спасењем своје деснице.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Једни се хвале колима, други коњима,",
            "poem": 1
          },
          {
            "text": "а ми именом Господа, Бога нашега.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Они посрћу и падају,",
            "poem": 1
          },
          {
            "text": "ми се дижемо и стојимо.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Господе, спаси цара,",
            "poem": 1
          },
          {
            "text": "услиши нас кад те призовемо!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
