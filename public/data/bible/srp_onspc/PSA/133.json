  "chapter": {
    "number": 133,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Песма поклоничка. Давидова."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Гле! Како је добро, каква је милина",
            "poem": 1
          },
          {
            "text": "када су браћа заједно и сложно!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ко на глави добро уље,",
            "poem": 1
          },
          {
            "text": "које се на браду слива,",
            "poem": 2
          },
          {
            "text": "на Аронову браду;",
            "poem": 1
          },
          {
            "text": "што се слива на порубе одеће његове;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "као роса са Ермона,",
            "poem": 1
          },
          {
            "text": "која роси на сионске горе;",
            "poem": 2
          },
          {
            "text": "тамо где је Господ одредио",
            "poem": 1
          },
          {
            "text": "благослов живота вечног.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
