  "chapter": {
    "number": 90,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Молитва Мојсија, човека Божијега."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "О, Господе, ти си нама био пребивалиште",
            "poem": 1
          },
          {
            "text": "кроз сва поколења!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Пре рођења планина,",
            "poem": 1
          },
          {
            "text": "пре него си саздао земљу и свет,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "од века до века, ти си Бог.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ти смртника враћаш у прашину",
            "poem": 1
          },
          {
            "text": "и говориш: „Вратите се, о, потомци људи!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Јер је у твојим очима хиљаду година",
            "poem": 1
          },
          {
            "text": "попут минулог, јучерашњег дана",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и попут смене ноћне страже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Односиш их ко бујица, попут сна су,",
            "poem": 1
          },
          {
            "text": "јутром су ко трава изникнули;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "ујутро цветају и расту,",
            "poem": 1
          },
          {
            "text": "а увече суше се и вену.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Тако и ми нестајемо у твом гневу",
            "poem": 1
          },
          {
            "text": "и твоја нас срџба престрављује!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Наше си кривице пред себе ставио,",
            "poem": 1
          },
          {
            "text": "наше тајне лицем својим обасјао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Тако су минули дани наши сви у твоме гневу,",
            "poem": 1
          },
          {
            "text": "попут даха године су наше испариле.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "У нашем је веку седамдесет лета,",
            "poem": 1
          },
          {
            "text": "осамдесет лета ако смо у снази;",
            "poem": 2
          },
          {
            "text": "њихово најбоље – тегоба и мука –",
            "poem": 1
          },
          {
            "text": "брзо прођу и ми одлетимо.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ко је упознао силу твога гнева?",
            "poem": 1
          },
          {
            "text": "Колико си страшан, толико си срдит.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Научи нас да бројимо своје дане тако,",
            "poem": 1
          },
          {
            "text": "да бисмо срце мудро задобили!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "О, Господе, окрени се! Докле више?",
            "poem": 1
          },
          {
            "text": "Смилуј се на своје слуге.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Милошћу нас својом ујутро нахрани;",
            "poem": 1
          },
          {
            "text": "да кличемо, да се веселимо кроз све своје дане!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Обрадуј нас за све оне дане кад си нас тлачио,",
            "poem": 1
          },
          {
            "text": "за године гледане недаће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Нек слугама твојим прикаже се дело твоје",
            "poem": 1
          },
          {
            "text": "и њиховој деци величанство твоје!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Нек наклоност Господа, Бога нашег, почива на нама.",
            "poem": 1
          },
          {
            "text": "Шта радили у томе успели!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Шта радили у томе успели!",
            "poem": 2
          }
        ]
      }
    ],
