  "chapter": {
    "number": 56,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. Према напеву: „Нема голубица у даљини.“ Давидова песма поуздања у Бога, када су га Филистејци ухватили у Гату."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Смилуј ми се, Боже,",
            "poem": 1
          },
          {
            "text": "јер ме човек гази;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "од јутра до сутра нападач ме угњетава.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Газе ме мрзитељи моји од јутра до сутра;",
            "poem": 1
          },
          {
            "text": "јер много је нападача против мене, Узвишени.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "У дан бојазни ја ћу у тебе да се уздам.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "У Бога, чију реч ја славим,",
            "poem": 1
          },
          {
            "text": "у Бога се уздам;",
            "poem": 2
          },
          {
            "text": "нећу да се плашим.",
            "poem": 1
          },
          {
            "text": "Шта ми може пуки смртник?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Од јутра до сутра речи ми изврћу,",
            "poem": 1
          },
          {
            "text": "погубно је све што против мене смисле.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Започињу свађе, скривају се,",
            "poem": 1
          },
          {
            "text": "на кораке ми пазе док ми душу вребају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Зар им од кривице има избављења?",
            "poem": 1
          },
          {
            "text": "У гневу обори народе, Боже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Потуцања моја изброј,",
            "poem": 1
          },
          {
            "text": "у мешину своју сузе моје стави;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "нису ли оне у књизи твојој?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Онда ће моји противници да се врате,",
            "poem": 1
          },
          {
            "text": "устукнуће кад зазовем;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "знам то, јер је Бог уз мене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "У Бога, чију реч ја славим;",
            "poem": 1
          },
          {
            "text": "у Господа, чију реч ја славим;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "у Бога се уздам;",
            "poem": 1
          },
          {
            "text": "нећу да се плашим.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Шта ми може пуки смртник?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "На мени су, Боже, завети твоји;",
            "poem": 1
          },
          {
            "text": "принећу ти захвалнице,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "јер си душу моју од смрти избавио,",
            "poem": 1
          },
          {
            "text": "кораке моје од спотицања;",
            "poem": 2
          },
          {
            "text": "да ходам пред Богом",
            "poem": 1
          },
          {
            "text": "у светлу живота.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
