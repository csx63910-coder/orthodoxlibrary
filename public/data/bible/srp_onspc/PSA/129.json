  "chapter": {
    "number": 129,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Песма поклоничка."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "„Много су ме тлачили још од како млад сам био“ –",
            "poem": 1
          },
          {
            "text": "нек каже Израиљ –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Много су ме тлачили још од како млад сам био,",
            "poem": 1
          },
          {
            "text": "а ипак ме нису надвладали.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Преко мојих леђа су орали орачи",
            "poem": 1
          },
          {
            "text": "своје дуге бразде.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Праведан је Господ,",
            "poem": 1
          },
          {
            "text": "пресекао је конопце злотвора!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Нек се стиде, нек устукну",
            "poem": 1
          },
          {
            "text": "сви што Сион мрзе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Нек су као трава по крововима,",
            "poem": 1
          },
          {
            "text": "која свене пре него се почупа;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "која жетеоцу руку не испуни,",
            "poem": 1
          },
          {
            "text": "ни наручје оном који снопље веже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "А ни пролазници нек не кажу:",
            "poem": 1
          },
          {
            "text": "„Благословени од Господа да сте!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Благосиљамо вас у Господње име!“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
