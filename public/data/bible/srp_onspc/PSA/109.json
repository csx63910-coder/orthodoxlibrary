  "chapter": {
    "number": 109,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. Псалам Давидов."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "О, Боже слављења мојега,",
            "poem": 1
          },
          {
            "text": "немој да заћутиш!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ено, уста злобна и уста пакосна",
            "poem": 1
          },
          {
            "text": "на мене су разјапљена;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "клевећу ме језиком лажљивим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Окружили су ме речима мржње,",
            "poem": 1
          },
          {
            "text": "без разлога напали ме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Тужбама ми узвраћају љубав,",
            "poem": 1
          },
          {
            "text": "али ја се предајем молитви.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "На добро ми узвраћају злобом",
            "poem": 1
          },
          {
            "text": "и мржњу ми враћају за љубав.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Против таквог постави зликовца,",
            "poem": 1
          },
          {
            "text": "тужитеља, нек му стоји с десна!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Када му се суди, кривац нека буде;",
            "poem": 1
          },
          {
            "text": "нека му се и молитва у грех преокрене!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Нек му дани буду малобројни,",
            "poem": 1
          },
          {
            "text": "нека се његова служба да другоме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Нек му деца сирочад постану",
            "poem": 1
          },
          {
            "text": "и жена му удовица!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Нека му се деца потуцају, нека просе;",
            "poem": 1
          },
          {
            "text": "нека моле када оду из својих руина!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Нек му плени зајмодавац све што је његово,",
            "poem": 1
          },
          {
            "text": "нека му туђинац имање опљачка!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Немао никога да му се смилује,",
            "poem": 1
          },
          {
            "text": "сирочад му немала никога који би их пожалио!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Нека му се семе затре,",
            "poem": 1
          },
          {
            "text": "име им се избрисало у колену другом!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Нек се памте кривице његових предака пред Господом,",
            "poem": 1
          },
          {
            "text": "грех мајке његове нек се не избрише!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Нека буду трајно пред Господом,",
            "poem": 1
          },
          {
            "text": "а он са земље нек им збрише спомен!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Јер се није сетио милост да искаже,",
            "poem": 1
          },
          {
            "text": "већ је кињио сиромаха, невољника,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "убијао очајника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Волео је клетву,",
            "poem": 1
          },
          {
            "text": "па нека га стигне;",
            "poem": 2
          },
          {
            "text": "благослов му није био мио,",
            "poem": 1
          },
          {
            "text": "па нека је далеко од њега.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ко оделом у клетву се облачио,",
            "poem": 1
          },
          {
            "text": "па нек се она као вода у њега улије",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и као уље у његове кости.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Нек му она буде ко огртач у кога се замотава,",
            "poem": 1
          },
          {
            "text": "као појас који стално опасује!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Нека тако Господ плати мојим тужитељима",
            "poem": 1
          },
          {
            "text": "и онима што о мени говоре злобно!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "А ти, о, Господе Боже,",
            "poem": 1
          },
          {
            "text": "чини са мном како доликује твом имену;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "избави ме јер је милост твоја добра.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Ево, и сиромах и невољник ја сам,",
            "poem": 1
          },
          {
            "text": "прободено срце је у мени.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Бледим као сенка издужена,",
            "poem": 1
          },
          {
            "text": "одуван сам ко скакавац.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Од поста ми колена клецају;",
            "poem": 1
          },
          {
            "text": "тело ми је мршаво, без сала.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Постао сам ругло за њих,",
            "poem": 1
          },
          {
            "text": "одмахују главом кад ме виде.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "О, Господе, помози ми!",
            "poem": 1
          },
          {
            "text": "Спаси мене, о, мој Боже, по милости својој!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Нека знају људи да је ово рука твоја;",
            "poem": 1
          },
          {
            "text": "да си то ти, о, Господе, учинио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Они нека куну а ти благосиљај;",
            "poem": 1
          },
          {
            "text": "а када се дигну нека се застиде,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а твој ће се слуга радовати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Нека се тужитељи моји у бруку обуку,",
            "poem": 1
          },
          {
            "text": "срамотом својом нека се покрију ко плаштом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Хвалићу Господа на сав глас!",
            "poem": 1
          },
          {
            "text": "Славићу га усред мноштва;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "јер је убогоме стао с десне стране",
            "poem": 1
          },
          {
            "text": "да га спасе од оних што му души пресуђују!",
            "poem": 2
          }
        ]
      }
    ],
