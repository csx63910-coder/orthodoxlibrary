  "chapter": {
    "number": 112,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Славите Господа!",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Благо човеку што се Господа боји",
            "poem": 1
          },
          {
            "text": "и у заповестима његовим радо ужива.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Моћно ће му потомство бити по земљи,",
            "poem": 1
          },
          {
            "text": "нараштај ће праведника благословен бити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "У кући му благо и иметак,",
            "poem": 1
          },
          {
            "text": "праведност му постојана вавек.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Светло и у тами сија праведнима,",
            "poem": 1
          },
          {
            "text": "милосрднима, милостивима и правичнима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Сажаљив је добар човек, позајмљује,",
            "poem": 1
          },
          {
            "text": "праведно се у послу опходи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Тај се никад уздрмати неће,",
            "poem": 1
          },
          {
            "text": "сећање на праведника трајаће довека.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Он не стрепи пред лошим вестима,",
            "poem": 1
          },
          {
            "text": "поузданог срца у Господа се узда.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Прибраног је срца, не страхује",
            "poem": 1
          },
          {
            "text": "док не заликује над душманима својим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Он нештедимице дели,",
            "poem": 1
          },
          {
            "text": "даје сиротињи,",
            "poem": 2
          },
          {
            "text": "праведност његова остаје довека;",
            "poem": 1
          },
          {
            "text": "рог ће му се у части уздићи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Видеће то злотвор, озлоједиће се,",
            "poem": 1
          },
          {
            "text": "шкрипаће зубима и гришће се;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "пропашће жудња злотвора!",
            "poem": 2
          }
        ]
      }
    ],
