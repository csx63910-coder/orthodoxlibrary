  },
  "chapter": {
    "number": 45,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "За хоровођу, по напеву „Љиљани“, синова Корејевих. Поука. Песма љубави."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Из срца ми теку речи умилне,",
            "poem": 1
          },
          {
            "text": "цару управљам своје стихове;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "језик је мој писаљка хитрога писара.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ти си лепши од свих потомака људи,",
            "poem": 1
          },
          {
            "text": "с твојих уста милост се прелива,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер Бог те је благословио довека.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Уз бок припаши мач свој, јуначе,",
            "poem": 1
          },
          {
            "text": "у сјају и величанству своме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Изјаши победнички у величанству своме,",
            "poem": 1
          },
          {
            "text": "за истину, кроткост и праведност;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "нек десница твоја страшна дела покаже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Нек стреле твоје зашиљене",
            "poem": 1
          },
          {
            "text": "пробију срце царевих душмана,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и народи нек падају под ноге твоје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Твој је престо, Боже, у веке векова!",
            "poem": 1
          },
          {
            "text": "Жезло је правде жезло твога царства.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Волиш правду, а мрзиш неправду.",
            "poem": 1
          },
          {
            "text": "Зато те је Бог, твој Бог,",
            "poem": 2
          },
          {
            "text": "помазао уљем радости,",
            "poem": 1
          },
          {
            "text": "више него твоје другове;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Сва ти одећа мирише на смирну, алоју и касију,",
            "poem": 1
          },
          {
            "text": "из дворова од слоноваче харфом те веселе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ћерке царске твоје су дворкиње,",
            "poem": 1
          },
          {
            "text": "с десна ти царица стоји у офирском злату.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Послушај, ћерко, погледај, добро слушај,",
            "poem": 1
          },
          {
            "text": "заборави народ свој и дом оца свог.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Кад цар пожели лепоту твоју,",
            "poem": 1
          },
          {
            "text": "поклони му се, јер он је господар твој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ћерка тирска доћи ће ти с даром,",
            "poem": 1
          },
          {
            "text": "богати људи тражиће твоју наклоност.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Сва славна, ћерка царева чека у соби,",
            "poem": 1
          },
          {
            "text": "у хаљини златом извезеној,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "да је украшену доведу пред цара,",
            "poem": 1
          },
          {
            "text": "Девице је прате, другарице њене,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да и њих доведу пред тебе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Доводе их радосно, с весељем,",
            "poem": 1
          },
          {
            "text": "те ступају у цареве дворе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Твоји синови заузеће место очева твојих,",
            "poem": 1
          },
          {
            "text": "поставићеш их за кнезове по свој земљи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Име ћу ти овековечити кроз сва поколења;",
            "poem": 1
          },
          {
            "text": "зато ће те народи славити у веке векова.",
            "poem": 2
          }
        ]
      }
    ],
