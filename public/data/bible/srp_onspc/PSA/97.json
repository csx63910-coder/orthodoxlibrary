  "chapter": {
    "number": 97,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Господ влада! Нека се радује земља,",
            "poem": 1
          },
          {
            "text": "нека се радују острва многа!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Окружен је облацима, густом тамом;",
            "poem": 1
          },
          {
            "text": "на праведности и на праву престо му почива.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Пред њим огањ сукља,",
            "poem": 1
          },
          {
            "text": "на све стране пали његове душмане.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Његове муње блеште светом,",
            "poem": 1
          },
          {
            "text": "а земља задрхти када то угледа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Као восак топе се планине пред Господом,",
            "poem": 1
          },
          {
            "text": "пред Господарем земље целе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Праведност његову небеса јављају",
            "poem": 1
          },
          {
            "text": "и славу његову сви народи виде.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Нека се постиде све слуге кипова,",
            "poem": 1
          },
          {
            "text": "сви који се идолима хвале;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "о, божанства разна, њему се клањајте!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Сион чује па се радује;",
            "poem": 1
          },
          {
            "text": "веселе се Јудина насеља",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "због судова твојих, Господе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Јер, Господе, ти си Свевишњи све земље;",
            "poem": 1
          },
          {
            "text": "неизмерно узвишен си над свим божанствима!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "О, ви што Господа волите, зло замрзите!",
            "poem": 1
          },
          {
            "text": "Он је чувар душе својих верних;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "он отима душу њину из зликовачких руку.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "По праведнику расипа се светло",
            "poem": 1
          },
          {
            "text": "и весеље у срца честитих!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Праведници, радујте се у Господу!",
            "poem": 1
          },
          {
            "text": "Захваљујте му,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "светост његову спомињите!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
