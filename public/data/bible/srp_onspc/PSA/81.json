  },
  "chapter": {
    "number": 81,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Хоровођи. Радосница. Асафова."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Радујте се Богу, снази нашој!",
            "poem": 1
          },
          {
            "text": "Кличите Богу Јаковљевом!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Песму запевајте, даире дајте,",
            "poem": 1
          },
          {
            "text": "лиру и харфу умилну.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "О младини у рог задувајте,",
            "poem": 1
          },
          {
            "text": "у дан празника нашег када је пун месец.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Јер такав је пропис Израиљу",
            "poem": 1
          },
          {
            "text": "и заповест Јаковљевог Бога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Он је Јосифу дао то сведочанство",
            "poem": 1
          },
          {
            "text": "када је кренуо против египатске земље.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Слушао сам језик незнан што казује:",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "„С плећа сам му уклонио терет",
            "poem": 1
          },
          {
            "text": "и из руку узео кошару.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Вапио си у невољи и ја сам те избавио,",
            "poem": 1
          },
          {
            "text": "одазвао сам ти се из грома и мрака;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "искушао на водама Мериве. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Послушај ме, мој народе, ја те опомињем!",
            "poem": 1
          },
          {
            "text": "О, Израиљу, када би ме послушао;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "међу вама не би било другог бога",
            "poem": 1
          },
          {
            "text": "и не би се ти клањао богу туђинскоме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ја сам Господ, Бог твој,",
            "poem": 1
          },
          {
            "text": "који сам те извео из земље египатске.",
            "poem": 2
          },
          {
            "text": "Отвори широм уста своја",
            "poem": 1
          },
          {
            "text": "и ја ћу да их напуним!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Али мој народ није послушао глас мој,",
            "poem": 1
          },
          {
            "text": "Израиљ ми се покорио није.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "И ја сам их препустио самовољи њиховога срца,",
            "poem": 1
          },
          {
            "text": "живели су како су желели.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "О, кад би ме послушао народ мој",
            "poem": 1
          },
          {
            "text": "и путеве моје Израиљ следио!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ја бих брзо савладао њихове душмане,",
            "poem": 1
          },
          {
            "text": "на њихове злотворе бих руку своју подигао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Пузали би пред њим они што Господа мрзе",
            "poem": 1
          },
          {
            "text": "и такво би стање за њих трајало довека.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "А ја бих да их храним најбољом пшеницом,",
            "poem": 1
          },
          {
            "text": "из камена ситићу их медом.“",
            "poem": 2
          }
        ]
      }
    ],
