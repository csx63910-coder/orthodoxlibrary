    "commonName": "Псалм",
    "title": "Псалми",
    "order": 19,
    "numberOfChapters": 150,
    "sha256": "26caf786163c3156cd828b9195dd87c0a9678ee51bdea32fbef70df99683a272",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/PSA/1.json",
    "lastChapterNumber": 150,
    "lastChapterApiLink": "/api/srp_onspc/PSA/150.json",
    "totalNumberOfVerses": 2461
  },
  "chapter": {
    "number": 115,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Немој нама, о, Господе, немој нама,",
            "poem": 1
          },
          {
            "text": "већ имену своме славу подај,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "због милости своје и истине своје!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Зашто народи да говоре:",
            "poem": 1
          },
          {
            "text": "„Тај Бог њихов, где је?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "А Бог наш је на небесима",
            "poem": 1
          },
          {
            "text": "и он чини све што му се прохте!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Сребро су и злато њихови идоли,",
            "poem": 1
          },
          {
            "text": "људских руку дело.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Са устима – а неми,",
            "poem": 1
          },
          {
            "text": "са очима – а слепи;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "са ушима – а глуви",
            "poem": 1
          },
          {
            "text": "и са носем који не мирише;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "са рукама које не пипају,",
            "poem": 1
          },
          {
            "text": "са ногама које се не крећу",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и са грлом што ни глас да пусти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Такви ће да буду ти што су их начинили,",
            "poem": 1
          },
          {
            "text": "сви који се у њих поуздају!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Израиљу, у Господа се уздај!",
            "poem": 1
          },
          {
            "text": "Он им је помоћник, он им је штит!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Доме Аронов, у Господа се уздај!",
            "poem": 1
          },
          {
            "text": "Он им је помоћник, он им је заштитник!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ви што стрепите од Господа,",
            "poem": 1
          },
          {
            "text": "у Господа се уздајте!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Он им је помоћник, он им је заштитник!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Сетио се и нас Господ!",
            "poem": 1
          },
          {
            "text": "Нек нас благослови,",
            "poem": 2
          },
          {
            "text": "нека благослови дом Израиљев;",
            "poem": 1
          },
          {
            "text": "нека благослови дом Аронов!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Благословиће оне што стрепе од Господа,",
            "poem": 1
          },
          {
            "text": "како мале тако и велике.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Умножио вас Господ,",
            "poem": 1
          },
          {
            "text": "и вас и децу вашу!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Благословио вас Господ,",
            "poem": 1
          },
          {
            "text": "Саздатељ небеса и земље!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Небеса су Господња небеса,",
            "poem": 1
          },
          {
            "text": "а земљу је дао потомцима људи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Преминули не славе Господа,",
            "poem": 1
          },
          {
            "text": "ни сви што у покој иду;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "а ми Господа славимо",
            "poem": 1
          },
          {
            "text": "сада и довека!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Славите Господа!",
            "poem": 1
          }
        ]
      }
    ],
