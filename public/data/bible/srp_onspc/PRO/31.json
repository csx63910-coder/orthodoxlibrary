  "chapter": {
    "number": 31,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Поруке цара Лемуила, пророштва којим га је поучила његова мајка:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Чуј, сине мој! Чуј, сине утробе моје!",
            "poem": 1
          },
          {
            "text": "Чуј, сине завета мојих!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Не дај своју снагу женама,",
            "poem": 1
          },
          {
            "text": "ни путеве своје онима што руше цареве.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Није за цареве, Лемуило,",
            "poem": 1
          },
          {
            "text": "није за цареве да пију вино",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и за владаре склоност жестоком пићу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Да не би уз пиће заборавили шта су одредбе,",
            "poem": 1
          },
          {
            "text": "па онда ускратили право свим ојађенима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Жестоко пиће остави за умирућег",
            "poem": 1
          },
          {
            "text": "и вино за унесрећену душу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Нека такав пије, нека заборави своју беду",
            "poem": 1
          },
          {
            "text": "и свог јада нека се не сећа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Говори уместо безгласног",
            "poem": 1
          },
          {
            "text": "и заступај све људе који умиру.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Говори и суди праведно,",
            "poem": 1
          },
          {
            "text": "одбрани право сиромаха и убогог.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ко да нађе честиту жену?",
            "poem": 1
          },
          {
            "text": "Таква вреди много више од драгуља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "У њу се поуздаје срце њеног мужа",
            "poem": 1
          },
          {
            "text": "и неће остати без добитка.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Добро, а не зло она му чини",
            "poem": 1
          },
          {
            "text": "кроз све дане живота свога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Прихвата се вуне и лана",
            "poem": 1
          },
          {
            "text": "па ужива у раду руку својих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Она је попут трговачких галија,",
            "poem": 1
          },
          {
            "text": "јер издалека доноси себи хлеба.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Диже се док је још мркло,",
            "poem": 1
          },
          {
            "text": "храну дели укућанима",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и послове слушкињама својим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Разгледа њиву па је купи,",
            "poem": 1
          },
          {
            "text": "од зараде својих руку сади виноград.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Одважно се прихвата посла",
            "poem": 1
          },
          {
            "text": "и мишице своје јача.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Увиђа да добро зарађује",
            "poem": 1
          },
          {
            "text": "и светиљка јој се по ноћи не гаси.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Рукама се преслице дохвата,",
            "poem": 1
          },
          {
            "text": "длановима прихвата вретено.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Сиромаху отвара шаку,",
            "poem": 1
          },
          {
            "text": "руке пружа убогоме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Не страхује за укућане када је снег,",
            "poem": 1
          },
          {
            "text": "јер сви у дому носе двоструку одећу",
            "poem": 2
          },
          {
            "noteId": 7
          },
          {
            "text": ".",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Покриваче себи шије",
            "poem": 1
          },
          {
            "text": "и одећу од танкога платна и скерлета.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Познаје се њен муж на вратима",
            "poem": 1
          },
          {
            "text": "када седи са старешинама земље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Она шије ланене кошуље и продаје их,",
            "poem": 1
          },
          {
            "text": "појасевима снабдева трговце.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Облачи се у част и у дику",
            "poem": 1
          },
          {
            "text": "и смеје се дану што долази.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Мудро отвара уста своја,",
            "poem": 1
          },
          {
            "text": "а на језику су јој поуке истине.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Надгледа како јој укућани живе",
            "poem": 1
          },
          {
            "text": "и не једе хлеб у доколици.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Синови њени се дижу и благосиљају је,",
            "poem": 1
          },
          {
            "text": "а њен је муж хвали:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "„Честите су многе жене",
            "poem": 1
          },
          {
            "text": "али ти их све надмашујеш!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Допадљивост је заводљива и лепота је пролазна,",
            "poem": 1
          },
          {
            "text": "али ће хваљена бити жена која се Господа боји.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Подајте јој нешто од плода њених руку",
            "poem": 1
          },
          {
            "text": "и нека је на вратима града хвале дела њена!",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 7,
        "caller": "+",
        "text": "31,21 Ово је превод према Септуагинти, а према јеврејском тексту реч је о гримизној одећи.",
        "reference": {
          "chapter": 31,
          "verse": 21
        }
      }
    ]
