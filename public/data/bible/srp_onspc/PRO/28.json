  },
  "chapter": {
    "number": 28,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Неправедник бежи, а нико га не гони,",
            "poem": 1
          },
          {
            "text": "а праведник је као лавић храбар.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Земља због преступа има многе главаре,",
            "poem": 1
          },
          {
            "text": "али траје дуго са човеком поученим и разумним.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Сиромах који убогога тлачи",
            "poem": 1
          },
          {
            "text": "је као пљусак који носи, а рода не доноси.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Злог хвале они који Закон",
            "poem": 1
          },
          {
            "noteId": 6
          },
          {
            "text": "заборављају,",
            "poem": 1
          },
          {
            "text": "а на њих су кивни они који Закон чувају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Злотвори не схватају правду,",
            "poem": 1
          },
          {
            "text": "а све разуме онај што Господа тражи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Бољи је и сиромах који часно живи",
            "poem": 1
          },
          {
            "text": "од богаташа што нечасно живи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Разуман је син који Закон држи,",
            "poem": 1
          },
          {
            "text": "а свог оца срамоти онај што се дружи с изелицама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ко иметак себи згрће од камате и зеленаштва,",
            "poem": 1
          },
          {
            "text": "сакупља ономе који је милостив убогима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ухо своје ко одврати и не слуша Закон,",
            "poem": 1
          },
          {
            "text": "његова је молитва одвратна.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "У своју ће јаму пасти",
            "poem": 1
          },
          {
            "text": "ко заводи праведне на пут зла,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а добро ће беспрекорни да наследе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Богати је себи самом мудар,",
            "poem": 1
          },
          {
            "text": "али га разумни сиромах истражује помно.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Велика је слава у радости праведника,",
            "poem": 1
          },
          {
            "text": "а када се зли осиле, човек се сакрива.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ко сакрива сагрешења своја, нема му напретка;",
            "poem": 1
          },
          {
            "text": "помилован бива ко се због њих каје и одриче их се.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Блажен ли је човек што је стално на опрезу,",
            "poem": 1
          },
          {
            "text": "а у зло ће пасти онај што је срце своје скаменио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Лав што риче, медвед распомамљен,",
            "poem": 1
          },
          {
            "text": "такав је и злобни владар убогом народу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Големи је изнуђивач неразборит владар,",
            "poem": 1
          },
          {
            "text": "а ко се гнуша изнуђеног добитка продужава своје дане.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Крвопролићем оптерећен човек хрли јами",
            "poem": 1
          },
          {
            "text": "и нека му нико не помогне.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Избављен ће бити онај што беспрекорно живи,",
            "poem": 1
          },
          {
            "text": "а у трену пашће онај што нечасно живи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Изобиље хране има онај који своју земљу ради,",
            "poem": 1
          },
          {
            "text": "а изобиље сиромаштва онај који тежи безвредним стварима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Веран ће човек обилно бити благословен,",
            "poem": 1
          },
          {
            "text": "а некажњено неће проћи ко срља да се обогати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Страхота је кад се гледа ко је ко,",
            "poem": 1
          },
          {
            "text": "јер ће човек да сагреши и за парче хлеба.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Шкртица срља да се обогати,",
            "poem": 1
          },
          {
            "text": "а и не зна да му стиже оскудица.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Већу благонаклоност напослетку налази онај који кори човека",
            "poem": 1
          },
          {
            "text": "него онај који ласка језиком.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Ко поткрада мајку своју и оца својега,",
            "poem": 1
          },
          {
            "text": "па још каже да ту греха нема,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "тај се дружи са џелатом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Бахат човек отпочиње свађу,",
            "poem": 1
          },
          {
            "text": "а напредује ко се узда у Господа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Безуман је човек што верује срцу своме,",
            "poem": 1
          },
          {
            "text": "а ко мудро живи избављен ће бити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Нема оскудице ко сиромаху пружа,",
            "poem": 1
          },
          {
            "text": "а ко са њега скреће поглед препун је проклетства.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Када се осиле зликовци, свако се склања,",
            "poem": 1
          },
          {
            "text": "а када страдају, множе се праведници.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 6,
        "caller": "+",
        "text": "28,4 Осим значења Закон јеврејски израз тора се односи и на поуку, упутство у смислу ширем од Мојсијевог Закона.",
