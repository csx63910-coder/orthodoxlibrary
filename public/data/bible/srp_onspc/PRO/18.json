  "chapter": {
    "number": 18,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "За жељом својом жуди саможиви човек,",
            "poem": 1
          },
          {
            "text": "на мудрост се сваку изнервира.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Безумник не ужива у разборитости,",
            "poem": 1
          },
          {
            "text": "него у разоткривању свога срца.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Када дође зао човек долазе и презир",
            "poem": 1
          },
          {
            "text": "и брука са срамотом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Дубоке су воде речи у устима људским",
            "poem": 1
          },
          {
            "text": "и врело мудрости поток је набујали.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Страшно је држати страну неправеднику",
            "poem": 1
          },
          {
            "text": "да би праведнику одузели правду.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "У свађу срљају усне безумника",
            "poem": 1
          },
          {
            "text": "и батине му уста призивају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Безумника руше сопствена уста",
            "poem": 1
          },
          {
            "text": "и усне му живот вребају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Речи клеветника су као посластице",
            "poem": 1
          },
          {
            "text": "што у стомак клизе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ко је лењ у послу своме",
            "poem": 1
          },
          {
            "text": "побратим је великом расипнику.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Име је Господње моћна кула",
            "poem": 1
          },
          {
            "text": "у коју се на висину склања праведник.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Богатство је богатоме попут утврђења,",
            "poem": 1
          },
          {
            "text": "попут зида високога у машти његовој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Срце се човека узнесе пред пропаст,",
            "poem": 1
          },
          {
            "text": "а пре части долази понизност.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Будаласт је и срамотан онај",
            "poem": 1
          },
          {
            "text": "који узвраћа реч пре него је чуо.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "С болешћу се својом носи дух у човеку.",
            "poem": 1
          },
          {
            "text": "Али ко се носи с духом утученим?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Знању тежи срце промућурног,",
            "poem": 1
          },
          {
            "text": "а и ухо мудрог предано је њему.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Човек даром себи пут отвара",
            "poem": 1
          },
          {
            "text": "и он га одводи пред велике људе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "У праву је ко је први у својој парници,",
            "poem": 1
          },
          {
            "text": "али онда дође његов ближњи па га испитује.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Жреб прекида размирице",
            "poem": 1
          },
          {
            "text": "и неслогу међу моћницима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Увређени брат је тврђи од утврђеног града",
            "poem": 1
          },
          {
            "text": "и размирице су као решетка тврђаве.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Плодом уста својих сити човек стомак свој,",
            "poem": 1
          },
          {
            "text": "сити га плодом усана својих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Језик влада и животом и смрћу;",
            "poem": 1
          },
          {
            "text": "ко га воли, јешће његов плод.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Ко нађе жену, нашао је благо,",
            "poem": 1
          },
          {
            "text": "благодат је добио од Господа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Молећиво сиромах беседи,",
            "poem": 1
          },
          {
            "text": "а богаташ оштро одговара.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Човек с много пријатеља може и да страда,",
            "poem": 1
          },
          {
            "text": "али има пријатеља приснијих од брата.",
            "poem": 2
          }
        ]
      }
    ],
