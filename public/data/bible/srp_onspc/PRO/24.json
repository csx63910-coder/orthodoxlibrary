  "chapter": {
    "number": 24,
    "content": [
      {
        "type": "heading",
        "content": [
          "Двадесета прича"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Не завиди злима,",
            "poem": 1
          },
          {
            "text": "не пожели да си с њима;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "јер у срцу своме смишљају насиље,",
            "poem": 1
          },
          {
            "text": "најављују уснама невољу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Двадесет прва прича"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Мудрошћу се подиже кућа,",
            "poem": 1
          },
          {
            "text": "а разборитошћу је основана;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "знањем су јој собе напуњене",
            "poem": 1
          },
          {
            "text": "сваким благом пожељним и вредним.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Двадесет друга прича"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Човек ратник је јак,",
            "poem": 1
          },
          {
            "text": "али онај који зна јача снагу своју;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "јер ћеш рат добити мудрим саветима",
            "poem": 1
          },
          {
            "text": "и победа је у многим саветницима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Двадесет трећа прича"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Висока је мудрост немудроме,",
            "poem": 1
          },
          {
            "text": "он уста своја не отвара на судским вратима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Двадесет четврта прича"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ко је предан да зло смишља",
            "poem": 1
          },
          {
            "text": "назваће га сплеткарошем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Грех су безумни науми",
            "poem": 1
          },
          {
            "text": "и подругљивац је одуран људима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Двадесет пета прича"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Клонеш ли у дану невоље,",
            "poem": 1
          },
          {
            "text": "клонуће и твоја снага.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Спасавај оне које у смрт вуку,",
            "poem": 1
          },
          {
            "text": "извлачи оне што тетурају на погубљење.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Јер, кажеш ли – „Али, ми то нисмо знали!“ –",
            "poem": 1
          },
          {
            "text": "неће ли схватити онај што прониче срца?",
            "poem": 2
          },
          {
            "text": "Неће ли знати онај који ти живот чува",
            "poem": 1
          },
          {
            "text": "и узвратити човеку по делу његовом?",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Двадесет шеста прича"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Једи мед, сине мој, јер је здрав",
            "poem": 1
          },
          {
            "text": "и непцу је твоме сладак мед из саћа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Такво је познање мудрости души твојој",
            "poem": 1
          },
          {
            "text": "ако је пронађеш; тада будућност постоји",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и твоја нада неће пропасти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Двадесет седма прича"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Не вребај ко зликовац у потаји на дом праведника",
            "poem": 1
          },
          {
            "text": "и коначиште његово не руши.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Јер падне ли праведник и седам пута, устаће,",
            "poem": 1
          },
          {
            "text": "а зликовац ће посрнути у невољи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Двадесет осма прича"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Не радуј се док се руши душманин твој,",
            "poem": 1
          },
          {
            "text": "кад посрне нека ти се срце не весели;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "да Господ то не види и то буде зло пред њиме,",
            "poem": 1
          },
          {
            "text": "па са душманина повуче свој гнев.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Двадесет девета прича"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Не жести се због злотвора,",
            "poem": 1
          },
          {
            "text": "не завиди зликовцима;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "јер будућност не припада злотвору,",
            "poem": 1
          },
          {
            "text": "догорева светиљка зликовцу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Тридесета прича"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Бој се Господа, сине мој, баш као и цара;",
            "poem": 1
          },
          {
            "text": "не дружи се с бунтовнима;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "јер изненадна долази њихова пропаст",
            "poem": 1
          },
          {
            "text": "и ко ће да сазна свршетак ове двојице?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "И ово се тиче мудрих људи:",
          {
            "text": "Страхота је кад се гледа ко је ко на суду.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Наиме, ко каже зломе – „Ти си праведан!“ –",
            "poem": 1
          },
          {
            "text": "људи ће га проклињати,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "народи га презирати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "А онима који га прекоре уживање ће бити,",
            "poem": 1
          },
          {
            "text": "на њих ће доћи благослов добра.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Усне воли онај ко узвраћа праведним речима.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Посао свој на пољу заврши,",
            "poem": 1
          },
          {
            "text": "припреми њиву своју, а онда изгради кућу своју.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Не сведочи без разлога против ближњег свога,",
            "poem": 1
          },
          {
            "text": "зар ћеш да обмањујеш уснама својим?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Не реци – „Како је он урадио мени, тако ћу и ја да урадим њему.",
            "poem": 1
          },
          {
            "text": "Узвратићу му по делу његовом!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Прошао сам поред поља ленштине",
            "poem": 1
          },
          {
            "text": "и поред винограда безумника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "И гле, у трње је све зарасло,",
            "poem": 1
          },
          {
            "text": "копривама све обрасло,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "зид камени беше срушен.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Када сам то видео, срцем сам схватио,",
            "poem": 1
          },
          {
            "text": "видео сам и прихватио поуку:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Још мало снова, још мало дремежа,",
            "poem": 1
          },
          {
            "text": "још мало доконо да склопиш руке;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "и доћи ће твоје сиромаштво као скитница",
            "poem": 1
          },
          {
            "text": "и немаштина као насилник.",
            "poem": 2
          }
        ]
      }
    ],
