  "chapter": {
    "number": 9,
    "content": [
      {
        "type": "heading",
        "content": [
          "Позив мудрости и лудости"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Мудрост је кућу своју сазидала",
            "poem": 1
          },
          {
            "text": "и за њу седам стубова исклесала.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Поклала је своју стоку, вино своје зачинила,",
            "poem": 1
          },
          {
            "text": "своју трпезу поставила;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "послала је слушкиње своје",
            "poem": 1
          },
          {
            "text": "и позива са највиших градских места:",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "„Нека овде сврати ко год је лаковеран!“",
            "poem": 2
          },
          {
            "text": "А безумноме говори:",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "„Дођите, једите моју храну",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и пијте вино које сам зачинила!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Оканите се лаковерја и живећете,",
            "poem": 1
          },
          {
            "text": "напредујте разумним путем.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Срамоту на себе навлачи ко подсмевача саветује,",
            "poem": 1
          },
          {
            "text": "себи шкоди онај ко кори зликовца.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Не прекоревај подсмевача да те не би замрзео,",
            "poem": 1
          },
          {
            "text": "прекоревај мудрог и волеће те.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Реци мудром и биће мудрији,",
            "poem": 1
          },
          {
            "text": "поучи праведнога и ученији ће бити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Мудрост отпочиње богобојазношћу",
            "poem": 1
          },
          {
            "text": "и знање познавањем Светог.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Са мном ће се дани твоји умножити",
            "poem": 1
          },
          {
            "text": "и година твог живота биће много.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ако си мудар, мудар си за своје добро,",
            "poem": 1
          },
          {
            "text": "а ако си подсмевач, то ти је на терет.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Безумље је жена горопадна,",
            "poem": 1
          },
          {
            "text": "лаковерна и ничем поучена.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Она седи на вратима своје куће,",
            "poem": 1
          },
          {
            "text": "на градским узвишењима,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "довикује онима што путем пролазе",
            "poem": 1
          },
          {
            "text": "и стазама својим право иду:",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "„Нека овде сврати ко год је лаковеран!“",
            "poem": 2
          },
          {
            "text": "А безумноме говори:",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "„Слатке ли су украдене воде,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "укусан ли је хлеб из потаје!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Али он не зна да су тамо покојници,",
            "poem": 1
          },
          {
            "text": "да су њене званице у дубинама Света мртвих.",
            "poem": 2
          }
        ]
      }
    ],
