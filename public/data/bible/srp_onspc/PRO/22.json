  },
  "chapter": {
    "number": 22,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Боље је изабрати име него богатство големо",
            "poem": 1
          },
          {
            "text": "и благонаклоност је боља од сребра и злата.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "И богаташ и сиромах се срећу,",
            "poem": 1
          },
          {
            "text": "јер све их је Господ саздао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Обазрив човек примети невољу, па се скрије,",
            "poem": 1
          },
          {
            "text": "а лаковерни иду даље и буду кажњени.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Обиље, част и живот су награда",
            "poem": 1
          },
          {
            "text": "за понизност и богобојазност.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Замке су и трње на стази подлаца",
            "poem": 1
          },
          {
            "text": "а од њих је подалеко онај који чува душу своју.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Васпитај дете за пут којим му ваља ићи",
            "poem": 1
          },
          {
            "text": "па и када остари од њега се одмакнути неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Богати влада сиромасима,",
            "poem": 1
          },
          {
            "text": "а ко зајми служи зајмодавцу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ко неправду сеје невољу ће жети,",
            "poem": 1
          },
          {
            "text": "сломиће се шиба гнева његовога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Благословен биће дарежљиви,",
            "poem": 1
          },
          {
            "text": "јер даје сиромаху парче свога хлеба.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Отераш ли подругљивца, свађа престаће,",
            "poem": 1
          },
          {
            "text": "парничење и срамота нестаће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Ко воли чисто срце и милост му је на уснама",
            "poem": 1
          },
          {
            "text": "има цара за пријатеља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Очи Господње чувају знање,",
            "poem": 1
          },
          {
            "text": "он обара речи оних што неправду чине.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ленштина говори: „Лав је на улици!",
            "poem": 1
          },
          {
            "text": "Заклаће ме насред трга!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Јама дубока уста су блуднице,",
            "poem": 1
          },
          {
            "text": "у њу пашће онај на кога је Господ срдит.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Дечије је срце свезано безумљем",
            "poem": 1
          },
          {
            "text": "које шиба опомене надалеко од њега уклања.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "И ко тлачи сиромаха да за себе згрне",
            "poem": 1
          },
          {
            "text": "и ко даје богатоме, сигурно им следи немаштина.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Прва прича"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Приклони ухо, послушај речи мудрих људи",
            "poem": 1
          },
          {
            "text": "и срце приклони мом знању.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Јер ће ти бити задовољство да их држиш у себи,",
            "poem": 1
          },
          {
            "text": "да буду спремне на уснама твојим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "А да ти у Господу поуздање буде,",
            "poem": 1
          },
          {
            "text": "ја ти их данас објављујем, баш теби.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Нисам ли их за тебе записао",
            "poem": 1
          },
          {
            "text": "тридесет мудрих прича",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "кроз савете и знање;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "да те упознам с истинитошћу поузданих речи,",
            "poem": 1
          },
          {
            "text": "како би узвратио поузданим речима онима који те шаљу?",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Друга прича"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Не отимај сиромаху јер је сиромах,",
            "poem": 1
          },
          {
            "text": "не сатири убогога на судским вратима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Јер Господ ће бранити његов случај",
            "poem": 1
          },
          {
            "text": "и отеће душу онима што њима отимају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Трећа прича"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Не дружи се с разјареним,",
            "poem": 1
          },
          {
            "text": "не иди са бесним човеком;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "јер ћеш навикнути на путеве његове",
            "poem": 1
          },
          {
            "text": "и себе ћеш уплести у замку.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Четврта прича"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Не буди од оних који руку дају",
            "poem": 1
          },
          {
            "text": "и од оних који јамче за дугове.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Ако немаш довољно да платиш,",
            "poem": 1
          },
          {
            "text": "зашто да ти неко узме и постељу испод тебе?",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Пета прича"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Не помичи древни међаш",
            "poem": 1
          },
          {
            "text": "што су твоји преци поставили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Шеста прича"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Да ли си видео човека вештог у свом послу?",
            "poem": 1
          },
          {
            "text": "Пред царевима ће он стајати,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а неће стајати пред безначајним.",
            "poem": 2
          }
        ]
      }
    ],
