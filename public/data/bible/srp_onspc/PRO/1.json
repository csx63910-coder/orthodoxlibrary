  },
  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Мудре приче",
          {
            "noteId": 0
          },
          "Соломона, Давидовог сина, цара Израиља:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "да се стекну мудрост и укор,",
            "poem": 1
          },
          {
            "text": "поука разумним речима;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "да се прими укор,",
            "poem": 1
          },
          {
            "text": "размишља о правди, о праведности и честитости;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "да се разборитост лаковернима, знање",
            "poem": 1
          },
          {
            "text": "и домишљатост младима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Нека слуша ко је мудар и нека још више схвати,",
            "poem": 1
          },
          {
            "text": "нека учени добије мудар савет:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "да проникне поуку, загонетку,",
            "poem": 1
          },
          {
            "text": "речи мудрих и њихове приче.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Знање отпочиње богобојазношћу,",
            "poem": 1
          },
          {
            "text": "а мудрост и прекор будале презиру.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Упозорење на позив грешника"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Сине мој, послушај поуку оца свога",
            "poem": 1
          },
          {
            "text": "и мајке своје савет не одбацуј.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Јер, они ће бити прелепи венац на твојој глави",
            "poem": 1
          },
          {
            "text": "и привесци око твога врата.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Сине мој, ако ли те грешници заводе,",
            "poem": 1
          },
          {
            "text": "ти не пристај.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Кажу ли: „Хајде с нама,",
            "poem": 1
          },
          {
            "text": "у заседу да легнемо, крв невиног",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и недужног хајде да вребамо!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Хајде да их попут Света мртвих",
            "poem": 1
          },
          {
            "noteId": 1
          },
          {
            "text": "прогутамо,",
            "poem": 1
          },
          {
            "text": "и живе и једре, као оне што у раку иду.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Покупимо сва добра, све благо!",
            "poem": 1
          },
          {
            "text": "Накрцајмо своје куће пленом!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Са нама ћеш добитак да делиш,",
            "poem": 1
          },
          {
            "text": "нек нам свима буде једна кеса.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Сине мој, немој ићи путем с њима,",
            "poem": 1
          },
          {
            "text": "не дај нози на њихове стазе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Јер им ноге ка злу трче",
            "poem": 1
          },
          {
            "text": "и срљају да крв лију.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Узалуд се шири мрежа",
            "poem": 1
          },
          {
            "text": "наочиглед птице.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Али они чекају у заседи крв своју,",
            "poem": 1
          },
          {
            "text": "вребају свој живот.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Такве су стазе сваког ко граби непоштен добитак,",
            "poem": 1
          },
          {
            "text": "живота коштају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Мудрост прекорева"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Мудрост по улицама виче,",
            "poem": 1
          },
          {
            "text": "по трговима диже глас свој;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "по раскршћима, у највећој вреви објављује,",
            "poem": 1
          },
          {
            "text": "на улазима градских врата казивања своја даје:",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "„Докле ћете, лаковерни, волети лаковерност;",
            "poem": 1
          },
          {
            "text": "докле ћете, ругачи, у ругању уживати;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "докле ћете, тупоглави, мрзети знање?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Обратите се по прекору моме.",
            "poem": 1
          },
          {
            "text": "Ево, излићу вам духа свога,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "објавићу вам своје речи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Јер ја сам вас звала, а ви сте се оглушили,",
            "poem": 1
          },
          {
            "text": "пружала сам руку, а нико марио није;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "све моје савете сте занемарили",
            "poem": 1
          },
          {
            "text": "и прекоре моје нисте прихватили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Сада ћу се и ја смејати пропасти вашој,",
            "poem": 1
          },
          {
            "text": "ругаћу се кад буде дошла страхота ваша;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "кад ваша страхота прође као разарање",
            "poem": 1
          },
          {
            "text": "и пропаст ваша као олуја када хучи,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "када вас задесе мука и невоља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Тада ће ме звати, а ја се нећу одазивати,",
            "poem": 1
          },
          {
            "text": "тражиће ме жељно ал’ ме неће наћи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Зато што су мрзели знање",
            "poem": 1
          },
          {
            "text": "и нису изабрали богобојазност;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "мој савет нису послушали",
            "poem": 1
          },
          {
            "text": "и одбацили су сваки мој прекор.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Зато ће јести плод свог пута,",
            "poem": 1
          },
          {
            "text": "прејешће се савета својих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Јер лаковерне ће упропастити отпадништво,",
            "poem": 1
          },
          {
            "text": "а будале сатрће лакомисленост.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "А ко мене слуша живеће спокојно,",
            "poem": 1
          },
          {
            "text": "сигуран, без бојазни од недаћа.“",
            "poem": 2
          }
        ]
      }
    ],
