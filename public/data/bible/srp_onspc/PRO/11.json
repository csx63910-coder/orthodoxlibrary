  "chapter": {
    "number": 11,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Господу су гадне теразије лажне,",
            "poem": 1
          },
          {
            "text": "а тегови тачни њему су милина.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Када гордост дође, дође и срамота,",
            "poem": 1
          },
          {
            "text": "а мудрост је у кротким људима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Честитост води поштене,",
            "poem": 1
          },
          {
            "text": "а невернике упропашћује дволичност њихова.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Нема користи од богатства у дан гнева,",
            "poem": 1
          },
          {
            "text": "а праведност од смрти избавља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Праведност беспрекорном пут равна,",
            "poem": 1
          },
          {
            "text": "а злобник пада због злобе своје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Праведност избавља непорочне,",
            "poem": 1
          },
          {
            "text": "а покварени се хватају у жудњи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Када умре покварењак, умире и нада,",
            "poem": 1
          },
          {
            "text": "пропада му надање у снагу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Од невоље је избављен праведник,",
            "poem": 1
          },
          {
            "text": "а зликовац стиже на његово место.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Безбожник устима руши ближњег свога,",
            "poem": 1
          },
          {
            "text": "а знање спасава праведника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "У напретку праведника град се радује,",
            "poem": 1
          },
          {
            "text": "а од среће кличе када страдају зликовци.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Благословом честитих град се уздиже,",
            "poem": 1
          },
          {
            "text": "а руши се због уста покварених.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Безуман је ко презире ближњег свога,",
            "poem": 1
          },
          {
            "text": "а разборит човек ћути.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Клеветник се скита и открива тајне,",
            "poem": 1
          },
          {
            "text": "а ко је верног духа тај ћути о томе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Народ пропада где нема мудрог савета,",
            "poem": 1
          },
          {
            "text": "и успех је у многим саветницима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Злопати се онај ко јамчи за туђинца,",
            "poem": 1
          },
          {
            "text": "а безбедан је човек који мрзи да јамчи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Благонаклона жена завређује част,",
            "poem": 1
          },
          {
            "text": "а окрутни људи благо освајају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Милостив човек чини добро души својој,",
            "poem": 1
          },
          {
            "text": "а силник самом себи шкоди.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Покварењак задобија непоштену надницу,",
            "poem": 1
          },
          {
            "text": "а ко сеје правду добија поштену надницу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Живот даје стамена праведност,",
            "poem": 1
          },
          {
            "text": "а у смрт хрли онај што зло чини.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Господу је гадно срце покварених,",
            "poem": 1
          },
          {
            "text": "а уживање су му људи беспрекорног пута.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Несумњиво је да зликовац неће проћи некажњено,",
            "poem": 1
          },
          {
            "text": "а потомци праведника биће избављени.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Лепа жена која се одрекла памети,",
            "poem": 1
          },
          {
            "text": "златна је брњица на њушци крмаче.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Жеља праведника је само на добро,",
            "poem": 1
          },
          {
            "text": "а гневна је нада зликоваца.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Неко просипа, а опет има више,",
            "poem": 1
          },
          {
            "text": "а неко чува и не да шта би требало, па ипак осиромаши.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Дарежљива душа биће награђена",
            "poem": 1
          },
          {
            "text": "и напојен онај који друге поји.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Људи куну оног ко задржава жито,",
            "poem": 1
          },
          {
            "text": "а благослов дају оном што га продаје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Ко предано тражи добро, тражи наклоности,",
            "poem": 1
          },
          {
            "text": "а ко трага за злом, оно га и стиже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Пашће свако ко се узда у своје богатство,",
            "poem": 1
          },
          {
            "text": "а пупиће праведници ко зелена грана.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Ко запусти породицу наследиће ветар,",
            "poem": 1
          },
          {
            "text": "безумник ће бити слуга срцу мудром.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Плод праведника је дрво живота",
            "poem": 1
          },
          {
            "text": "и мудар је онај који задобија душе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Гле, већ је и праведник на земљи награђен,",
            "poem": 1
          },
          {
            "text": "а камоли злочинац и грешник неће бити!",
            "poem": 2
          }
        ]
      }
    ],
