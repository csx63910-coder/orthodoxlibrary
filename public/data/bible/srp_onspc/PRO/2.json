  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "heading",
        "content": [
          "Благодати мудрости"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Сине мој, прихватиш ли моје речи",
            "poem": 1
          },
          {
            "text": "и у себи сачуваш заповести моје;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "тад пажљиво слушај мудрост",
            "poem": 1
          },
          {
            "text": "и срцем тежи да разумеш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ако призовеш проницљивост",
            "poem": 1
          },
          {
            "text": "и завапиш разборитости;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "потражиш ли то као сребро,",
            "poem": 1
          },
          {
            "text": "трагаш ли за тим као за скривеним благом;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "онда ћеш знати за богобојазност",
            "poem": 1
          },
          {
            "text": "и наћи ћеш богопознање.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Јер Господ мудрост даје,",
            "poem": 1
          },
          {
            "text": "знање и разборитост из његових су уста.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Он праведнима сабира истинску мудрост,",
            "poem": 1
          },
          {
            "text": "штит је онима што честито живе,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "да заштити стазе праведности",
            "poem": 1
          },
          {
            "text": "и сачува пут верујућих својих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Онда ћеш разумети праведност, правду и честитост,",
            "poem": 1
          },
          {
            "text": "баш сваку стазу ваљану.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Онда ће ти мудрост доћи у срце",
            "poem": 1
          },
          {
            "text": "и знање биће мило души твојој;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "домишљатост ће бдети над тобом",
            "poem": 1
          },
          {
            "text": "и разборитост чуваће те.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Избавиће те од пута изопаченог,",
            "poem": 1
          },
          {
            "text": "од оних што изопачено говоре,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "од оних који напуштају праведну стазу",
            "poem": 1
          },
          {
            "text": "да би корачали стазама мрака,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "од оних који се радују када чине зло",
            "poem": 1
          },
          {
            "text": "и кличу изопачености зла,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "којима су стазе покварене,",
            "poem": 1
          },
          {
            "text": "а богазе искварене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Избавиће те од блуднице,",
            "poem": 1
          },
          {
            "text": "од успаљенице слаткоречиве,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "оне што напушта мужа младости своје",
            "poem": 1
          },
          {
            "text": "и заборавља завет Бога свога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Њена кућа тоне у смрт,",
            "poem": 1
          },
          {
            "text": "а стазе њене међу покојне.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Не враћа се нико ко јој оде,",
            "poem": 1
          },
          {
            "text": "не домогну се стаза живота.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Зато ти иди путем добрих људи,",
            "poem": 1
          },
          {
            "text": "држи се стаза праведника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Јер ће земљу праведници наследити",
            "poem": 1
          },
          {
            "text": "и беспрекорни ће у њој пребивати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "А зли ће се из земље истребити,",
            "poem": 1
          },
          {
            "text": "невернике ће почупати из ње.",
            "poem": 2
          }
        ]
      }
    ],
