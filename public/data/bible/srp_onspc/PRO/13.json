  "chapter": {
    "number": 13,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Мудар син прихвата очево васпитање,",
            "poem": 1
          },
          {
            "text": "а подругљивац не слуша укор.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Човек се насити добра од плода уста својих,",
            "poem": 1
          },
          {
            "text": "а покварењаци су гладни насиља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ко год чува уста своја чува живот свој,",
            "poem": 1
          },
          {
            "text": "а пропаст следује ономе ко шири своје усне.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Душа ленштине је гладна, али нема ништа,",
            "poem": 1
          },
          {
            "text": "а душа се марљивих људи нахрани.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Праведник мрзи лаж,",
            "poem": 1
          },
          {
            "text": "а злобник одурно и срамно поступа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Праведност чува пут честитог,",
            "poem": 1
          },
          {
            "text": "а неправда обара грешника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Неко себе представља богатим, али нема ништа,",
            "poem": 1
          },
          {
            "text": "а неко себе представља сиромашним, а пребогат је.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Човек богатством откупљује душу своју,",
            "poem": 1
          },
          {
            "text": "а сиромах и не чује претњу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Светло праведника блешти,",
            "poem": 1
          },
          {
            "text": "а светиљка зликоваца гасне.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Бахатост једино раздор изазива,",
            "poem": 1
          },
          {
            "text": "а мудрост је код оних који примају савет.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Нагло стечено богатство се умањује,",
            "poem": 1
          },
          {
            "text": "а увећава се оно сакупљано радом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Дуготрајно надање жалости срце,",
            "poem": 1
          },
          {
            "text": "а испуњена жеља је као дрво живота.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ко презире реч себи самом шкоди,",
            "poem": 1
          },
          {
            "text": "а ко страхује од заповести награђен ће бити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Мудрачева поука врело је живота",
            "poem": 1
          },
          {
            "text": "и одвраћа од смртних замки.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Проницљивост стиче наклоност,",
            "poem": 1
          },
          {
            "text": "а пут неверних је непромењив.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Сваки обазрив човек ради према знању,",
            "poem": 1
          },
          {
            "text": "а безумни шири безумље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Гласник зла у зло пада,",
            "poem": 1
          },
          {
            "text": "а сведок истине лечи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Сиромаштво и срамота стижу оног ко не мари за опомену,",
            "poem": 1
          },
          {
            "text": "а почашћен ће бити онај ко прихвата укор.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Слатка је души жеља испуњена,",
            "poem": 1
          },
          {
            "text": "а безумнику је мрско да се од зла одврати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Биће мудар ко иде с мудрима,",
            "poem": 1
          },
          {
            "text": "а настрадаће ко се дружи с безумнима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Грешнике пропаст прогони,",
            "poem": 1
          },
          {
            "text": "а праведници су добром награђени.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Добар човек оставља наследство унуцима,",
            "poem": 1
          },
          {
            "text": "а грешникова се добра чувају за праведника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Обиље је хране на неузораном пољу сиромаха,",
            "poem": 1
          },
          {
            "text": "али га неправда односи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Ко свој прут штеди мрзи свога сина,",
            "poem": 1
          },
          {
            "text": "а воли га ко га на време кори.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Када једе, праведнику се душа наједе,",
            "poem": 1
          },
          {
            "text": "а стомак злобника остаје гладан.",
            "poem": 2
          }
        ]
      }
    ],
