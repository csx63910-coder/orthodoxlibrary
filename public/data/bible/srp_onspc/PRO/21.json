  "chapter": {
    "number": 21,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ко потоци воде царево је срце у руци Господњој,",
            "poem": 1
          },
          {
            "text": "он га води како њему годи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "У сопственим очима човеку је чист сваки пут,",
            "poem": 1
          },
          {
            "text": "али Господ проверава намере срца.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Да се чини по праву и правди",
            "poem": 1
          },
          {
            "text": "Господу је милије од жртве.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Узносите очи и охоло срце",
            "poem": 1
          },
          {
            "text": "светиљка су покварених, а то је грех.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Намере марљивог једино обиљу воде,",
            "poem": 1
          },
          {
            "text": "а свих оних што срљају само сиромаштву.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Стицање богатства језиком лажљивим",
            "poem": 1
          },
          {
            "text": "је попут паре лелујаве; у смрт срљају такви.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Насилнике ће помести насиље њихово,",
            "poem": 1
          },
          {
            "text": "јер су одбили да чине по правди.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Крив је пут кривца,",
            "poem": 1
          },
          {
            "text": "а недужно је дело недужнога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Боље је седети на углу крова",
            "poem": 1
          },
          {
            "text": "него са женом свадљивом у заједничкој кући.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "За злом жуди душа злотвора,",
            "poem": 1
          },
          {
            "text": "самилост му ближњи његов не види у оку.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Казни подругљивца, па ће лаковерни постати мудар,",
            "poem": 1
          },
          {
            "text": "поучи разумног и схватиће поуку.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Свеправедни мотри на кућу злога,",
            "poem": 1
          },
          {
            "text": "он обара зле у пропаст.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ко затвара ухо своје од плача убогог",
            "poem": 1
          },
          {
            "text": "и сам ће плакати, а услишен неће бити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Тајни поклон љутњу утишава",
            "poem": 1
          },
          {
            "text": "и мито у недрима поголему срџбу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Праведнику је радост да ради по правди,",
            "poem": 1
          },
          {
            "text": "а језа је за оне што неправду раде.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Човек што залута с пута разумнога",
            "poem": 1
          },
          {
            "text": "завршиће у друштву покојних.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Сиромашан човек биће ко воли весеље,",
            "poem": 1
          },
          {
            "text": "ко вино и уље воли богат бити неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Злобник је откуп за праведника",
            "poem": 1
          },
          {
            "text": "и неверник за исправнога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Боље бити и у земљи пустој,",
            "poem": 1
          },
          {
            "text": "него са женом свадљивом и горопадном.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Примамљиво благо и уље су у дому мудрог,",
            "poem": 1
          },
          {
            "text": "а безумни човек све то проћерда.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Ко правди и љубави тежи",
            "poem": 1
          },
          {
            "text": "налази и живот и правду и част.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Мудар се успиње у град јунака",
            "poem": 1
          },
          {
            "text": "и обара бедем њиховог уздања.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Уста своја и језик свој ко чува,",
            "poem": 1
          },
          {
            "text": "од невоља себе брани.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Бахати и охоли – име му подругљивац –",
            "poem": 1
          },
          {
            "text": "онај је што ради у обести безмерној.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Ленштину убија његова жеља,",
            "poem": 1
          },
          {
            "text": "јер одбија да ради рукама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Он махнито тражи од јутра до сутра,",
            "poem": 1
          },
          {
            "text": "а праведник дели и не цицијаши.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Мрске су жртве злобника,",
            "poem": 1
          },
          {
            "text": "а још више кад их приноси у злоби!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Лажљиви сведок ће настрадати,",
            "poem": 1
          },
          {
            "text": "а човек који слуша с успехом ће да сведочи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Злобник на лицу показује дрскост,",
            "poem": 1
          },
          {
            "text": "а честити пут свој разазнаје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Ни мудрости ни знања,",
            "poem": 1
          },
          {
            "text": "ни савета нема насупрот Господу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "За дан боја коњ је спреман,",
            "poem": 1
          },
          {
            "text": "али победа је од Господа.",
            "poem": 2
          }
        ]
      }
    ],
