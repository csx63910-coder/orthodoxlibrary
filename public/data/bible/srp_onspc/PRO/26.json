  "chapter": {
    "number": 26,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Као снег лети и киша о жетви,",
            "poem": 1
          },
          {
            "text": "тако част не стоји безумном.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Као кад прхне врабац и ласта кад одлети,",
            "poem": 1
          },
          {
            "text": "тако и клетва не стиже без повода.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Бич је за коња, узде за магарца,",
            "poem": 1
          },
          {
            "text": "а батина за леђа безумног.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Не узвраћај безумноме по безумљу његовоме,",
            "poem": 1
          },
          {
            "text": "да и сам не би био њему налик.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Узврати безумноме по безумљу његовоме,",
            "poem": 1
          },
          {
            "text": "да сам себи не би био мудар.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ноге своје сам сасеца, насиљем се поднапија",
            "poem": 1
          },
          {
            "text": "ко поруку шаље рукама безумног.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Како ноге висе одузетом,",
            "poem": 1
          },
          {
            "text": "таква је мудра прича у устима безумнога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Камен у праћку веже",
            "poem": 1
          },
          {
            "text": "ко безумном почаст даје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Трнова грана у руци пијанца",
            "poem": 1
          },
          {
            "text": "је мудра прича у устима безумнога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Попут стрелца што рањава кога стигне,",
            "poem": 1
          },
          {
            "text": "такав је човек што унајмљује безумника",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и онај што унајмљује пролазника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Враћа се пас на своју бљувотину",
            "poem": 1
          },
          {
            "text": "као што се и безумник враћа безумљу своме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Видиш ли човека који мисли за себе да је мудар?",
            "poem": 1
          },
          {
            "text": "Више је наде за безумника него за њега!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ленштина говори: „Лав је на улици!",
            "poem": 1
          },
          {
            "text": "Лав је насред трга!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "На шаркама окрећу се врата,",
            "poem": 1
          },
          {
            "text": "а ленштина на кревету своме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ленштина умаче руку у чанак,",
            "poem": 1
          },
          {
            "text": "али је преуморан да устима својим је принесе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Самом себи ленштина је мудрији",
            "poem": 1
          },
          {
            "text": "од седморице што разборито одговарају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Пса за уши хвата",
            "poem": 1
          },
          {
            "text": "ко се у пролазу љути због туђе расправе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Као махнитави што бакље,",
            "poem": 1
          },
          {
            "text": "стреле и смрт сеје,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "такав је човек што вара ближњег свога,",
            "poem": 1
          },
          {
            "text": "па још каже: „Нисам ли се нашалио?!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Када нема дрва и ватра се гаси,",
            "poem": 1
          },
          {
            "text": "када нема клеветника и свађа се стиша.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Угаљ је за жеравицу и дрво за ватру,",
            "poem": 1
          },
          {
            "text": "а човек свађалица да потпали свађу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Речи клеветника су као посластице",
            "poem": 1
          },
          {
            "text": "што у стомак клизе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Посребрена грнчарија –",
            "poem": 1
          },
          {
            "text": "то су усне углађене и зло срце.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Онај који мрзи скрива се уснама својим,",
            "poem": 1
          },
          {
            "text": "а у себи сакупља превару.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Не веруј човеку умилног гласа",
            "poem": 1
          },
          {
            "text": "коме је у срцу седмострука гадост.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Он се скрива, мржњу прикрива,",
            "poem": 1
          },
          {
            "text": "али ће се разоткрити у збору поквареност његова.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Ко јаму копа, сам у њу пада",
            "poem": 1
          },
          {
            "text": "и ко камен ваља, на њега се сваља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Лажљив језик мрзи оне које дроби",
            "poem": 1
          },
          {
            "text": "и уста ласкава рушевине праве.",
            "poem": 2
          }
        ]
      }
    ],
