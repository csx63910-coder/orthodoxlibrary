  },
  "chapter": {
    "number": 23,
    "content": [
      {
        "type": "heading",
        "content": [
          "Седма прича"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Кад са владаром седаш да једеш",
            "poem": 1
          },
          {
            "text": "пажљиво размотри шта је пред тобом;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "нож ћеш ставити под грло своје",
            "poem": 1
          },
          {
            "text": "ако си алав.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Не жуди за његовим ђаконијама,",
            "poem": 1
          },
          {
            "text": "јер је то варљива храна.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Осма прича"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Не напињи се да стекнеш богатство",
            "poem": 1
          },
          {
            "text": "и своје се памети прођи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Пустиш ли на њега очи своје, гле њега нема,",
            "poem": 1
          },
          {
            "text": "јер је себи начинило крила попут орла,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "што се вине у небеса.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Девета прича"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Не једи храну саможивца,",
            "poem": 1
          },
          {
            "text": "не пожели ђаконије његове.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Јер како се он у себи прерачунава,",
            "poem": 1
          },
          {
            "text": "баш је такав када ти каже –",
            "poem": 2
          },
          {
            "text": "„Једи и пиј!“ –",
            "poem": 1
          },
          {
            "text": "а срце му није с тобом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Избљуваћеш залогај који си појео,",
            "poem": 1
          },
          {
            "text": "проћердаћеш све љубазне речи своје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Десета прича"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Не говори ушима безумног,",
            "poem": 1
          },
          {
            "text": "јер ће презрети поруку твојих речи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Једанаеста прича"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Не помичи древни међаш,",
            "poem": 1
          },
          {
            "text": "не залази у њиве сирочади.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Јер је јак њихов Откупитељ,",
            "poem": 1
          },
          {
            "text": "одбраниће њихов случај од тебе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Дванаеста прича"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Срце своје предај опомени,",
            "poem": 1
          },
          {
            "text": "своје уши поучним речима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Тринаеста прича"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Не ускраћуј казну детету,",
            "poem": 1
          },
          {
            "text": "јер неће да умре ако га и удариш шибом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Туци га шибом",
            "poem": 1
          },
          {
            "text": "и душу му од Света мртвих спаси.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Четрнаеста прича"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "О, мој сине, ако ти је срце мудро",
            "poem": 1
          },
          {
            "text": "и моје се срце радује;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "радује се нутрина моја,",
            "poem": 1
          },
          {
            "text": "кад ти усне честито говоре.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Петнаеста прича"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Нек ти срце грешницима не завиди,",
            "poem": 1
          },
          {
            "text": "у богобојазности ти поваздан буди.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Нема сумње, будућност постоји,",
            "poem": 1
          },
          {
            "text": "твоја нада неће пропасти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Шеснаеста прича"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Сине мој, послушај и мудар буди,",
            "poem": 1
          },
          {
            "text": "своје срце ти на пут усмери.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Не дружи се са онима што се вином опијају,",
            "poem": 1
          },
          {
            "text": "са онима који ждеру месо.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Јер, осиромашиће и пијаница и изелица,",
            "poem": 1
          },
          {
            "text": "мамурлук ће их обући у дроњке.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Седамнаеста прича"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Слушај оца свога што те је родио,",
            "poem": 1
          },
          {
            "text": "мајку своју не презири ни када остари.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Истину купуј и не продаји",
            "poem": 1
          },
          {
            "text": "мудрост, прекор и поуку.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Јако се радује отац праведног сина,",
            "poem": 1
          },
          {
            "text": "ко је родио мудрог сина ужива у њему.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Нека се радују и отац твој и мајка твоја,",
            "poem": 1
          },
          {
            "text": "нека се весели она која те је родила.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Осамнаеста прича"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Срце ми своје дај, сине мој,",
            "poem": 1
          },
          {
            "text": "и нека ти очи почивају на путевима мојим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Јер блудница је дубока јама,",
            "poem": 1
          },
          {
            "text": "туђинка је узано ждрело.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Она је ко лопов што вреба из потаје",
            "poem": 1
          },
          {
            "text": "и међу мушкарцима умножава неверне.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Деветнаеста прича"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Ко то кука? Ко то јечи?",
            "poem": 1
          },
          {
            "text": "Ко се свађа? Ко то приговара?",
            "poem": 2
          },
          {
            "text": "Ко има ране безразложне",
            "poem": 1
          },
          {
            "text": "и коме су закрвављене очи?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Онима што се излежавају крај вина,",
            "poem": 1
          },
          {
            "text": "онима што иду да пробају вино измешано.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Не гледај вино док се румени,",
            "poem": 1
          },
          {
            "text": "док се светлуца у чаши,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "док лагано клизи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Као змија на крају уједа,",
            "poem": 1
          },
          {
            "text": "као отровница убада.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Чудне ће призоре да виде очи твоје",
            "poem": 1
          },
          {
            "text": "и срце говориће лудорије.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Бићеш као онај што лежи усред мора,",
            "poem": 1
          },
          {
            "text": "као онај што лежи наврх јарбола.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "И рећи ћеш: „Ударили су ме, а болестан нисам,",
            "poem": 1
          },
          {
            "text": "тукли су ме, осетио нисам.",
            "poem": 2
          },
          {
            "text": "Када ћу се пробудити",
            "poem": 1
          },
          {
            "text": "да поново потражим пиће?“",
            "poem": 2
          }
        ]
      }
    ],
