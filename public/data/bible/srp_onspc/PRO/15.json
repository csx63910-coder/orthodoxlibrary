  "chapter": {
    "number": 15,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Благи одговор утишава гнев,",
            "poem": 1
          },
          {
            "text": "а груба реч покреће јарост.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Језик мудрих добро влада знањем,",
            "poem": 1
          },
          {
            "text": "а уста безумних бљују безумљем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Господње су очи на свакоме месту,",
            "poem": 1
          },
          {
            "text": "мотрећи на зле и на добре.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Здрав је језик ко дрво живота,",
            "poem": 1
          },
          {
            "text": "а дух слама језик поган.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Безумник презире опомену свога оца,",
            "poem": 1
          },
          {
            "text": "а разборит је ко мари за укор.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Велико је благо у дому праведника,",
            "poem": 1
          },
          {
            "text": "а злобнику је мука да заради.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Знање расипају уста мудрих људи,",
            "poem": 1
          },
          {
            "text": "што не чини срце безумника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Гадна је Господу жртва зликоваца,",
            "poem": 1
          },
          {
            "text": "молитва честитих њему је милина.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Господу је мрзак пут злобника,",
            "poem": 1
          },
          {
            "text": "а воли онога који правду следи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Немило је поучење за онога ко се одриче пута,",
            "poem": 1
          },
          {
            "text": "а умреће онај ко мрзи прекор.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Пред Господом су и Свет мртвих и трулеж мртвих,",
            "poem": 1
          },
          {
            "text": "а камоли срца људских потомака.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Подругљивац не воли онога који га кори",
            "poem": 1
          },
          {
            "text": "и не иде код мудрих људи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Весело срце ведри лице,",
            "poem": 1
          },
          {
            "text": "жалосно срце слама дух.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Разборито срце тежи знању,",
            "poem": 1
          },
          {
            "text": "а уста се безумника безумљем хране.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Немили су сви дани невољника,",
            "poem": 1
          },
          {
            "text": "а човек се доброг срца гости непрестано.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Боље је и мало у богобојазности,",
            "poem": 1
          },
          {
            "text": "него благо силно и са њим стрепња.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Бољи је тањир поврћа у љубави,",
            "poem": 1
          },
          {
            "text": "него утовљени во у мржњи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Гневан човек распаљује свађу,",
            "poem": 1
          },
          {
            "text": "а смирени човек утишава сукоб.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Пут ленштине је обрастао трњем,",
            "poem": 1
          },
          {
            "text": "а пут је честитих поравнан.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Мудар син радује оца,",
            "poem": 1
          },
          {
            "text": "а безуман човек презире мајку своју.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Безумника радује безумље,",
            "poem": 1
          },
          {
            "text": "а разборит човек равно иде путем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Науми се изјалове кад нема савета,",
            "poem": 1
          },
          {
            "text": "а остваре с мноштвом саветника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Човек се радује кад одговори тачно;",
            "poem": 1
          },
          {
            "text": "како је добра реч у право време!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Стаза живота за разумног према горе води,",
            "poem": 1
          },
          {
            "text": "и не да му према доле, у Свет мртвих да скрене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Господ руши кућу гордих људи",
            "poem": 1
          },
          {
            "text": "и јача међу удовице.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Намере зликовца гадне су Господу,",
            "poem": 1
          },
          {
            "text": "а чисте су му речи љубазности.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Кући својој беду наваљује ко нечасно и лакомо стиче,",
            "poem": 1
          },
          {
            "text": "а живеће онај човек ком се мито гади.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Срце праведника промишља одговор,",
            "poem": 1
          },
          {
            "text": "а уста покварених људи злом бљују.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Господ је далеко од покварењака,",
            "poem": 1
          },
          {
            "text": "а слуша молитву праведника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Бистар поглед и срце весели,",
            "poem": 1
          },
          {
            "text": "а добре вести подмлађују кости.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Ухо које слуша поуку живота,",
            "poem": 1
          },
          {
            "text": "трајаће у друштву мудрих људи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Ко не мари за опомену, презире сам себе,",
            "poem": 1
          },
          {
            "text": "а ко слуша укор стиче разборитост.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Богобојазност је поука мудрости,",
            "poem": 1
          },
          {
            "text": "а пре части долази понизност.",
            "poem": 2
          }
        ]
      }
    ],
