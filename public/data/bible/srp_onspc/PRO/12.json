  },
  "chapter": {
    "number": 12,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Ко воли опомену воли знање,",
            "poem": 1
          },
          {
            "text": "а простак је ко презире укор.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Добар човек добија Господњу наклоност,",
            "poem": 1
          },
          {
            "text": "а он проклиње човека који прави сплетке.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Поквареношћу се нико неће учврстити,",
            "poem": 1
          },
          {
            "text": "а корен је праведника непоколебљив.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Честита је жена круна мужу своме,",
            "poem": 1
          },
          {
            "text": "а жена раскалашна му је као трулеж у костима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Праведни су науми праведника,",
            "poem": 1
          },
          {
            "text": "а савети покварених су обмана.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Речи злих људи крв вребају у заседи,",
            "poem": 1
          },
          {
            "text": "а честити се устима својим ослобађају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Зликовци се руше и више их нема,",
            "poem": 1
          },
          {
            "text": "а дом праведника истрајава.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Човек се цени према разборитости својој,",
            "poem": 1
          },
          {
            "text": "а срце покварењака биће презрено.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Бољи је неугледан човек, а са слугом,",
            "poem": 1
          },
          {
            "text": "него онај што уздиже себе, а нема да једе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Праведник се брине и за добро својих животиња,",
            "poem": 1
          },
          {
            "text": "а злобници су окрутни и кад се смилују.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Изобиље хране има онај који своју земљу ради,",
            "poem": 1
          },
          {
            "text": "а шупљоглавац тежи безвредним стварима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Злобник жуди за злим пленом,",
            "poem": 1
          },
          {
            "text": "а корен праведника је плодоносан.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Злобнику је замка у греху усана,",
            "poem": 1
          },
          {
            "text": "а праведник се клони невоље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Човек се насити добра плодом уста својих",
            "poem": 1
          },
          {
            "text": "и врати му се све што рукама ради.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Безумник сматра да живи исправно,",
            "poem": 1
          },
          {
            "text": "али је мудар онај ко слуша савет.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Безумников се гнев одмах препозна,",
            "poem": 1
          },
          {
            "text": "а ко је обазрив покрива срамоту.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Кад верни сведок сведочи, он објављује правду,",
            "poem": 1
          },
          {
            "text": "а лажљиви сведок обмањује.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Има људи који говоре несмотрено као да боду мачем,",
            "poem": 1
          },
          {
            "text": "а језик мудрих лечи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Истинољубива уста ће довека утврђена бити,",
            "poem": 1
          },
          {
            "text": "а лажљиви језик ће нестати док трепнем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Обмана је у срцу оних што смишљају зло,",
            "poem": 1
          },
          {
            "text": "а радост следује оне што зову на мир.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Праведника не сналази никаква невоља,",
            "poem": 1
          },
          {
            "text": "а зликовци су пуни немира.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Лажљиве су усне одурне Господу,",
            "poem": 1
          },
          {
            "text": "а милина су му истинотворци.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Обазрив човек не открива знање,",
            "poem": 1
          },
          {
            "text": "а срце будаластих разглашава безумље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Рука марљивих људи ће владати,",
            "poem": 1
          },
          {
            "text": "а ленштина мора да робује.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Срце што стрепи повија човека,",
            "poem": 1
          },
          {
            "text": "а добра реч га ведри.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Праведник бира себи пријатеља,",
            "poem": 1
          },
          {
            "text": "а неправеднике заводи пут њихов.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Нема печења за ленштину,",
            "poem": 1
          },
          {
            "text": "човеку је благо марљивост његова.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Живот је на путу праведности",
            "poem": 1
          },
          {
            "text": "и нема смрти на њеној стази.",
            "poem": 2
          }
        ]
      }
    ],
