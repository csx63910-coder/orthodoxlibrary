  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "heading",
        "content": [
          "Благодати мудрости"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Сине мој, поуку моју не заборављај",
            "poem": 1
          },
          {
            "text": "и у срцу чувај заповести моје,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "јер ће ти продужити дане и године живота,",
            "poem": 1
          },
          {
            "text": "мир ће ти придодати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Милост и истина нека не одлазе од тебе.",
            "poem": 1
          },
          {
            "text": "Вежи их око врата,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "упиши их на плочу срца!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "И тад ћеш наћи милост и наклоност",
            "poem": 1
          },
          {
            "text": "и у Божијим и у људским очима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "У Господа поуздај се свим срцем својим",
            "poem": 1
          },
          {
            "text": "и немој се ослањати на мудрост своју.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Мисли на њега на својим путевима",
            "poem": 1
          },
          {
            "text": "да би твоје стазе учинио равним.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "У очима својим немој бити мудар,",
            "poem": 1
          },
          {
            "text": "бој се Господа и бежи од зла.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "То ће ти телу донети здравље,",
            "poem": 1
          },
          {
            "text": "кости ће ти подмладити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Дај част Господу својим добрима",
            "poem": 1
          },
          {
            "text": "и првинама свега што си стекао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Тада ће се обилно напунити амбари твоји,",
            "poem": 1
          },
          {
            "text": "преливаће се широм каце твоје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Сине мој, не узимај олако Господњи одгој,",
            "poem": 1
          },
          {
            "text": "и не клони када те он кори,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "јер Господ кори оног кога воли,",
            "poem": 1
          },
          {
            "text": "баш као и отац сина у коме му је милина.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Како је благословен човек који је нашао мудрост,",
            "poem": 1
          },
          {
            "text": "човек који је добио разборитост!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Јер је она драгоценија него добит од сребра,",
            "poem": 1
          },
          {
            "text": "корист је њена од злата већа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Вреднија је од драгуља",
            "poem": 1
          },
          {
            "text": "и равна јој нису сва уживања твоја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "У десници њеној је дуги живот,",
            "poem": 1
          },
          {
            "text": "а у њеној левици су богатство и углед.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Путеви су њени путеви благи",
            "poem": 1
          },
          {
            "text": "и све њене стазе су мирне.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Она је дрво живота онима који је се држе",
            "poem": 1
          },
          {
            "text": "и благословени су они који су чврсто прионули уз њу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Мудрошћу је Господ утемељио земљу",
            "poem": 1
          },
          {
            "text": "и разборитошћу је поставио небеса.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Знање је његово провалило бездане",
            "poem": 1
          },
          {
            "text": "и облаци су прокапали росом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Сине мој, не скрећи поглед са тога",
            "poem": 1
          },
          {
            "text": "и очувај истинску мудрост и домишљатост;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "биће то живот твојој души",
            "poem": 1
          },
          {
            "text": "и привезак око твога врата.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Тада ћеш спокојно корачати својим путем",
            "poem": 1
          },
          {
            "text": "и нога се твоја неће спотакнути.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Кад починеш, нећеш се бојати,",
            "poem": 1
          },
          {
            "text": "када легнеш слатко ћеш да спаваш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Нећеш се бојати кад страхота бане,",
            "poem": 1
          },
          {
            "text": "када зликовачко разарање дође.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Јер ће Господ поред тебе бити",
            "poem": 1
          },
          {
            "text": "и чуваће твој корак од замке.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Не ускраћуј помоћ невољницима",
            "poem": 1
          },
          {
            "text": "када су ти руке кадре да учине.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Немој рећи своме ближњем –",
            "poem": 1
          },
          {
            "text": "„Сутра дођи и даћу ти“ –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "када имаш то код себе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Не смишљај злобу ближњему своме,",
            "poem": 1
          },
          {
            "text": "јер он са тобом спокојно живи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Не свађај се с било киме без разлога",
            "poem": 1
          },
          {
            "text": "ако ти није нанео зло.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Не завиди насилнику",
            "poem": 1
          },
          {
            "text": "и не бирај било коју од стаза његових.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Јер је Господу одуран покварењак,",
            "poem": 1
          },
          {
            "text": "а близак је с честитима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "На кући је зликовачкој Господње проклетство,",
            "poem": 1
          },
          {
            "text": "а његови благослови на кући праведника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Ругачима Бог се руга,",
            "poem": 1
          },
          {
            "text": "а понизнима исказује милост.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Мудри људи наследиће углед,",
            "poem": 1
          },
          {
            "text": "а безумнима следује срамота.",
            "poem": 2
          }
        ]
      }
    ],
