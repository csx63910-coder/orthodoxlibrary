  "chapter": {
    "number": 8,
    "content": [
      {
        "type": "heading",
        "content": [
          "Мудрост позива"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Зар то мудрост не позива,",
            "poem": 1
          },
          {
            "text": "не диже ли разборитост глас свој?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ено је на узвишицама, покрај пута,",
            "poem": 1
          },
          {
            "text": "на раскршћима се поставила;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "на капијама, на улазима у град,",
            "poem": 1
          },
          {
            "text": "на улазним вратима она виче:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "„Људи, вас дозивам",
            "poem": 1
          },
          {
            "text": "и глас дижем целом човечанству!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Разборитости се научите, лаковерни људи,",
            "poem": 1
          },
          {
            "text": "уразумите срце, неразумни.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Слушајте, јер ја објављујем драгоцене ствари,",
            "poem": 1
          },
          {
            "text": "честите ће бити изреке усана мојих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Баш истину казиваћу",
            "poem": 1
          },
          {
            "text": "јер је злоба мрска уснама мојим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Праведне су све речи мојих уста",
            "poem": 1
          },
          {
            "text": "и нема у њима изопачености и непоштења.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Све су оне јасне разборитом",
            "poem": 1
          },
          {
            "text": "и исправне онима што знање стичу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Прихватите поуку моју, а не сребро,",
            "poem": 1
          },
          {
            "text": "изаберите знање пре него суво злато.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Јер је мудрост од драгуља боља",
            "poem": 1
          },
          {
            "text": "и сва јој уживања ни принети нису.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ја, мудрост, с разборитошћу живим,",
            "poem": 1
          },
          {
            "text": "проналазим знање и домишљатост.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Богобојазност значи мрзети зло,",
            "poem": 1
          },
          {
            "text": "јер ја мрзим бахати понос,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "пут злобе и уста покварена.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "У мени је савет, поуздана мудрост.",
            "poem": 1
          },
          {
            "text": "У мени је умност, ја имам снагу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Цареви владају уз моју помоћ",
            "poem": 1
          },
          {
            "text": "и владари деле правду.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Главари, кнезови и све праведне судије",
            "poem": 1
          },
          {
            "text": "владају уз моју помоћ.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ја волим све који воле мене,",
            "poem": 1
          },
          {
            "text": "налазе ме сви који ме помно траже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Част, иметак, трајно благостање",
            "poem": 1
          },
          {
            "text": "и праведност су са мном.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Од злата, од сувога злата је род мој бољи,",
            "poem": 1
          },
          {
            "text": "и добит моја боља од пробраног сребра.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Ја ходам путем праведности",
            "poem": 1
          },
          {
            "text": "и посред стаза правде,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "да онима који ме воле дам наследство",
            "poem": 1
          },
          {
            "text": "и њихове ризнице напуним.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Мене је имао Господ на почетку његовог пута,",
            "poem": 1
          },
          {
            "text": "још пре дела својих древних.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Постављена сам од давнина,",
            "poem": 1
          },
          {
            "text": "од искона, пре постања земље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Рођена сам кад бездана још није било,",
            "poem": 1
          },
          {
            "text": "када није било ни извора обилних вода.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Пре планина постављених",
            "poem": 1
          },
          {
            "text": "и пре брда рођена сам,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "док још земљу он створио није,",
            "poem": 1
          },
          {
            "text": "ни поља, ни прво тло света.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Када је створио небеса, ја сам била тамо,",
            "poem": 1
          },
          {
            "text": "када је оцртавао хоризонт над лицем бездана;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "када је горе учвршћивао облаке",
            "poem": 1
          },
          {
            "text": "и када су набујали извори бездана;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "када је мору поставио његове обале,",
            "poem": 1
          },
          {
            "text": "како вода не би прелазила његову заповест,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и када је означио темеље земљине.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Била сам уз њега као градитељка,",
            "poem": 1
          },
          {
            "text": "била сам му радост свакодневна,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "веселила се пред њим стално;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "веселила се по свету, по његовој земљи",
            "poem": 1
          },
          {
            "text": "и радовала се са потомцима људи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Зато ме, децо, послушајте.",
            "poem": 1
          },
          {
            "text": "О, како су благословени они који се држе мојих путева!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Послушајте поуку моју,",
            "poem": 1
          },
          {
            "text": "радите мудро и не одбацујте је.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Како је благословен човек који ме слуша,",
            "poem": 1
          },
          {
            "text": "који свакодневно бдије на мојим вратима",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и пази на доврацима врата мојих!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Јер ко мене нађе, нашао је живот",
            "poem": 1
          },
          {
            "text": "и добио наклоност Господњу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Али ко мене не нађе, себи самом шкоди,",
            "poem": 1
          },
          {
            "text": "а сви који ме мрзе воле смрт.“",
            "poem": 2
          }
        ]
      }
    ],
