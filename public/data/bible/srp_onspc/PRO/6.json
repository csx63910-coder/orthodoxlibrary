  "chapter": {
    "number": 6,
    "content": [
      {
        "type": "heading",
        "content": [
          "Упозорење против безумља"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Сине мој, ако јамчиш за ближњега свога",
            "poem": 1
          },
          {
            "text": "и руку си пружио туђинцу;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "везан си речима уста својих,",
            "poem": 1
          },
          {
            "text": "обавезан својим обећањем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ти онда учини ово, сине мој, да слободан будеш,",
            "poem": 1
          },
          {
            "text": "јер си допао рукама свог ближњег:",
            "poem": 2
          },
          {
            "text": "Иди, понизи се",
            "poem": 1
          },
          {
            "text": "и салећи ближњег свог!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Не дај сна очима својим",
            "poem": 1
          },
          {
            "text": "и својим капцима да дремају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Отми се као срна ловцу,",
            "poem": 1
          },
          {
            "text": "као птица из руку птичара.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "О, лењивче, иди мраву,",
            "poem": 1
          },
          {
            "text": "сагледај његове путеве и постани мудар!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Он нема ни војводу,",
            "poem": 1
          },
          {
            "text": "ни заповедника, ни владара,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "али спрема себи храну током лета,",
            "poem": 1
          },
          {
            "text": "током жетве скупља себи јело.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "О, лењивче, докле ћеш да пландујеш,",
            "poem": 1
          },
          {
            "text": "када ћеш од сна да се пренеш?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Још мало снова, још мало дремежа,",
            "poem": 1
          },
          {
            "text": "још мало доконо да склопиш руке;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "и доћи ће твоје сиромаштво као скитница",
            "poem": 1
          },
          {
            "text": "и немаштина као насилник.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ништарија и покварењак се скита",
            "poem": 1
          },
          {
            "text": "и непоштено говори;",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "намигује својим очима,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "подгуркује ногама,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "упире прстима;",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "изопачености су му у срцу,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "сваког часа смишља зло и уноси раздор.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Зато ће ненадано стићи његова пропаст,",
            "poem": 1
          },
          {
            "text": "у трену ће бити сломљен, а лека му неће бити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Шест је ствари које Господ мрзи",
            "poem": 1
          },
          {
            "text": "и седам му се души огадило:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "очи узносите,",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "језик лажљив,",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "руке које лију невину крв;",
            "poem": 3
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "срце што смишља опаке науме,",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "ноге што срљају и на зло су брзе;",
            "poem": 3
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Лажљив сведок што лаже чим зине",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "и ко сеје раздор међу браћом.",
            "poem": 3
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Упозорење против прељубе"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Сине мој, држи заповест оца свога",
            "poem": 1
          },
          {
            "text": "и не заборављај поуку мајке своје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Везуј их истрајно за срце своје",
            "poem": 1
          },
          {
            "text": "и обмотај око свога врата.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Водиће те док будеш ходао,",
            "poem": 1
          },
          {
            "text": "чуваће те док будеш спавао",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и говориће ти када се пробудиш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Јер је заповест светиљка и поука је светло,",
            "poem": 1
          },
          {
            "text": "а прекори одгоја стаза су живота.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Чуваће те од опаке жене,",
            "poem": 1
          },
          {
            "text": "од ласкавог језика жене прељубнице.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Не пожели у свом срцу њену лепоту,",
            "poem": 1
          },
          {
            "text": "не дај да те погледом опчини;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "јер због блуднице човек спадне на комад хлеба",
            "poem": 1
          },
          {
            "text": "и туђа жена лови драгоцену душу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Може ли човек да у недра жеравицу стави,",
            "poem": 1
          },
          {
            "text": "а да му се одећа не запали?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Може ли човек да хода по угљу врелом,",
            "poem": 1
          },
          {
            "text": "а да не опече стопала своја?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Тако је и са оним ко одлази жени свога ближњег,",
            "poem": 1
          },
          {
            "text": "неће проћи некажњено сваки који је се дотиче.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Људи не срамоте лопова када краде",
            "poem": 1
          },
          {
            "text": "да насити своју душу, јер је гладан;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "али кад ухваћен буде, надокнадиће седмоструко,",
            "poem": 1
          },
          {
            "text": "даће свако добро из куће своје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Безуман је ко са женом прељубу чини,",
            "poem": 1
          },
          {
            "text": "а то ради онај ко сатире самог себе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Такав допада и рана и срама,",
            "poem": 1
          },
          {
            "text": "његова се брука неће избрисати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Због љубоморе је муж гневан",
            "poem": 1
          },
          {
            "text": "и нема милости у дану освете.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Он не гледа ни на какав откуп,",
            "poem": 1
          },
          {
            "text": "не пристаје ни на велик мито.",
            "poem": 2
          }
        ]
      }
    ],
