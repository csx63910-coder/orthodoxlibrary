  "chapter": {
    "number": 7,
    "content": [
      {
        "type": "heading",
        "content": [
          "Упозорење против прељубнице"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Сине мој, држи се мојих речи",
            "poem": 1
          },
          {
            "text": "и заповести мојих, у себи их чувај.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Моје заповести чувај и живећеш,",
            "poem": 1
          },
          {
            "text": "поуку моју ко зеницу свога ока.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Вежи их око прстију својих,",
            "poem": 1
          },
          {
            "text": "упиши их на плочу срца!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Мудрости кажи „Сестро моја!“",
            "poem": 1
          },
          {
            "text": "и „рођеном“ проницљивост зови;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "да те чувају од жене туђинке,",
            "poem": 1
          },
          {
            "text": "од прељубнице слаткоречиве.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Елем, на прозору куће своје,",
            "poem": 1
          },
          {
            "text": "кроз решетке гледао сам,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "посматрао сам лаковерне",
            "poem": 1
          },
          {
            "text": "и међу младићима запазио безумнога момка.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Пролазио је улицом, поред њеног угла",
            "poem": 1
          },
          {
            "text": "и ишао према њеној кући,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "поткрај дана, кад је сумрак,",
            "poem": 1
          },
          {
            "text": "усред ноћи и помрчине.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "И гле, пресрете га жена у одећи блуднице",
            "poem": 1
          },
          {
            "text": "и превејаног срца;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "нападна, јогунаста,",
            "poem": 1
          },
          {
            "text": "ноге је у кући не држе;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "сад је на улици, сад је на тргу,",
            "poem": 1
          },
          {
            "text": "на сваком угла вреба у заседи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "И зграби га, пољуби га без стида на лицу",
            "poem": 1
          },
          {
            "text": "и рече му:",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "„Имам кући месо жртава мира,",
            "poem": 1
          },
          {
            "text": "јер сам данас испунила завете своје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Зато сам изашла да те сретнем,",
            "poem": 1
          },
          {
            "text": "баш тебе да тражим.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "И нашла сам те.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Свој сам кревет украсила засторима,",
            "poem": 1
          },
          {
            "text": "шареним ланом из Египта;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "смирном, алојом и циметом",
            "poem": 1
          },
          {
            "text": "лежај сам намирисала.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Дођи! До јутра се опијајмо љубављу својом.",
            "poem": 1
          },
          {
            "text": "Хајде да се науживамо у љубави!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Јер муж није у кући својој,",
            "poem": 1
          },
          {
            "text": "на далеки пут је отишао;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "са собом је понео кесу с новцем",
            "poem": 1
          },
          {
            "text": "и неће доћи кући до дана пуног месеца.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Тако га је намамила својом уверљивом причом,",
            "poem": 1
          },
          {
            "text": "наговорила га својим заводљивим уснама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "И он је одмах кренуо за њом,",
            "poem": 1
          },
          {
            "text": "као во на клање ишао је",
            "poem": 2
          },
          {
            "text": "и као безумник окован за казну;",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "док му стрела не прободе јетру,",
            "poem": 2
          },
          {
            "text": "као птица што у замку срља",
            "poem": 1
          },
          {
            "text": "он и не зна да ту главу губи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Зато ме послушајте, синови,",
            "poem": 1
          },
          {
            "text": "и пазите на оно што вам говорим!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Нека ти срце не застрани на путеве њене",
            "poem": 1
          },
          {
            "text": "и не лутај по њеним стазама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Јер многе смртно рањене је оборила",
            "poem": 1
          },
          {
            "text": "и нема броја људима које је побила.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Кућа је њена на путевима за Свет мртвих,",
            "poem": 1
          },
          {
            "text": "а они силазе у одаје смрти.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
