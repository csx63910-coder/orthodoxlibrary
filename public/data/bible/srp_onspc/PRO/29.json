  },
  "chapter": {
    "number": 29,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Када тврдоглави још више отврдоглави упркос карању,",
            "poem": 1
          },
          {
            "text": "сломиће се ненадано и неће му бити лека.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Кад се множе праведници, народ се радује,",
            "poem": 1
          },
          {
            "text": "а кад зликовац завлада, народ уздише.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Оца свог радује човек који воли мудрост,",
            "poem": 1
          },
          {
            "text": "а с блудницом ко се дружи, иметак свој ружи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Цар по правди земљу гради,",
            "poem": 1
          },
          {
            "text": "а грамзиви тлачитељ је разграђује.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Човек што ласка ближњем своме",
            "poem": 1
          },
          {
            "text": "мрежу шири ногама његовим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "У греху је замка зликовачка,",
            "poem": 1
          },
          {
            "text": "а праведник кличе и весели се.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Праведник разуме случај сиромаха,",
            "poem": 1
          },
          {
            "text": "а неправедник за ту ствар не мари.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Подсмевачи град разјаре,",
            "poem": 1
          },
          {
            "text": "а мудри стишавају гнев.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Кад се мудар човек суди с човеком немудрим,",
            "poem": 1
          },
          {
            "text": "љутио се ил’ смејао, починка му нема.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Крвници мрзе човека без мане,",
            "poem": 1
          },
          {
            "text": "а праведни му душу штите.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Сву ћуд своју истреса безумник,",
            "poem": 1
          },
          {
            "text": "а мудар се повлачи и стишава.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Владар који слуша лажи",
            "poem": 1
          },
          {
            "text": "имаће за слуге све саме зликовце.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "И сиромаху и тлачитељу једно је заједничко:",
            "poem": 1
          },
          {
            "text": "обојици Господ просветљује очи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Довека ће стајати престо цара",
            "poem": 1
          },
          {
            "text": "што убогом суди по истини.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Шиба прекора доноси мудрост,",
            "poem": 1
          },
          {
            "text": "а дете распуштено срамоти своју мајку.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Кад се злобници умножавају, умножавају се и греси,",
            "poem": 1
          },
          {
            "text": "али ће праведници гледати њихову пропаст.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Опомени свога сина и донеће ти спокој,",
            "poem": 1
          },
          {
            "text": "и донеће радост души твојој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Где виђења нема, народ се разузда;",
            "poem": 1
          },
          {
            "text": "а како је благословен човек што се поуке држи!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Речима се не поправља слуга,",
            "poem": 1
          },
          {
            "text": "јер ако их и разуме, он се не одазива.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Видиш ли човека брзоплетог у говору?",
            "poem": 1
          },
          {
            "text": "Више је наде за безумног него за њега.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Ко свом слузи од малена повлађује",
            "poem": 1
          },
          {
            "text": "за невољу крај му спрема.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Разјарени свађу започиње,",
            "poem": 1
          },
          {
            "text": "горопадни обилује гресима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Бахатост унижава човека,",
            "poem": 1
          },
          {
            "text": "а понизни завређује част.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Ко се дружи са лоповом мрзи душу своју,",
            "poem": 1
          },
          {
            "text": "јер он чује клетву, али је прећути.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Страх човеку замку поставља,",
            "poem": 1
          },
          {
            "text": "а збринут је онај што се у Господа узда.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Многи траже владареву наклоност,",
            "poem": 1
          },
          {
            "text": "али од Господа је правда за човека.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Неправедник је мрзак праведницима,",
            "poem": 1
          },
          {
            "text": "а злобницима је мрзак човек честитог живота.",
            "poem": 2
          }
        ]
      }
    ],
