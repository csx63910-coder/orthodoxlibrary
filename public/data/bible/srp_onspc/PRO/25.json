  "chapter": {
    "number": 25,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "И ово су Соломонове мудре приче које су преписали људи Језекије, Јудиног цара:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Божија је слава да сакрива ствари,",
            "poem": 1
          },
          {
            "text": "а цару је слава да ствар истражује.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Небо је високо, земља је дубока,",
            "poem": 1
          },
          {
            "text": "а и срца царска нико не истражи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Уклони са сребра згуру",
            "poem": 1
          },
          {
            "text": "и ето га чанак за ковача:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "уклони злога од цара",
            "poem": 1
          },
          {
            "text": "и у правди престо његов утврђен ће бити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Пред царем се не величај",
            "poem": 1
          },
          {
            "text": "и не стој на месту великаша;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "јер је боље да ти каже – „Горе дођи!“ –",
            "poem": 1
          },
          {
            "text": "него да те понизи пред племићем.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "А то",
            "poem": 1
          },
          {
            "noteId": 5
          },
          {
            "text": "што су ти очи виделе",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "не доводи журно на суђење,",
            "poem": 2
          },
          {
            "text": "јер шта ћеш када те на крају",
            "poem": 1
          },
          {
            "text": "посрами ближњи твој?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Реши спор са ближњем својим",
            "poem": 1
          },
          {
            "text": "и тајну другога не откривај;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "да те не би осрамотио онај који слуша",
            "poem": 1
          },
          {
            "text": "и зао глас остао на теби.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Благовремено казана реч",
            "poem": 1
          },
          {
            "text": "је попут златних јабука у сребрним чинијама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Минђуша златна и украс од чистог злата",
            "poem": 1
          },
          {
            "text": "је укор мудрог ономе који слуша.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Као студен снега на дан жетве",
            "poem": 1
          },
          {
            "text": "је верни гласник оном ко га шаље –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "освежава душу свога господара.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Попут облака и ветра без кише",
            "poem": 1
          },
          {
            "text": "човек је што се хвали даром недарованим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Стрпљивошћу се наговара владар,",
            "poem": 1
          },
          {
            "text": "а и језик благи може кост да сломи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Кад нађеш мед, једи док се не наједеш,",
            "poem": 1
          },
          {
            "text": "јер ћеш га повратити ако се преједеш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Нека ти је нога ретко у кући ближњег твога,",
            "poem": 1
          },
          {
            "text": "да те се не засити и не замрзи те.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Попут буздована, мача и стреле оштре",
            "poem": 1
          },
          {
            "text": "је човек који сведочи против ближњег свога, а лажов је.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Зуб покварен и клецава нога",
            "poem": 1
          },
          {
            "text": "је поверење у издајника у дану невоље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Као човек што хаљину скида по зимскоме дану",
            "poem": 1
          },
          {
            "text": "и као сирће на шалитри,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "такав је онај који песме пева срцу жалосноме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Ако је твој непријатељ гладан, нахрани га,",
            "poem": 1
          },
          {
            "text": "и ако је жедан, напој га водом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Јер ако тако чиниш, згрнућеш жар угљени на његову главу,",
            "poem": 1
          },
          {
            "text": "а Господ ће да ти плати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Северац кишу доноси,",
            "poem": 1
          },
          {
            "text": "а језик оговарачки срдита лица.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Боље је седети на углу крова",
            "poem": 1
          },
          {
            "text": "него са женом свадљивом у заједничкој кући.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Што је студена вода души изнуреној,",
            "poem": 1
          },
          {
            "text": "то је добра вест из далеке земље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Замућен извор и бунар зарушени",
            "poem": 1
          },
          {
            "text": "је праведник што тетура пред неправедником.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Није добро преждрати се меда",
            "poem": 1
          },
          {
            "text": "и људима на част није да част своју траже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Град проваљен и без зида",
            "poem": 1
          },
          {
            "text": "је човек који не зна себе самог да обузда.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 5,
        "caller": "+",
        "text": "25,7 Мисли се на племића из претходног стиха.",
