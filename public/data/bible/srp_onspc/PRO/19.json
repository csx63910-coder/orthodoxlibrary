  },
  "chapter": {
    "number": 19,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Бољи је и сиромах што честито живи,",
            "poem": 1
          },
          {
            "text": "него човек нечистих усана и безумник.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "И човек без знања је опак",
            "poem": 1
          },
          {
            "text": "и онај што срља, тај лута.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Лудост човеку подрива пут",
            "poem": 1
          },
          {
            "text": "и срце му се на Господа гневи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Богатство доноси много пријатеља,",
            "poem": 1
          },
          {
            "text": "а сиромах је напуштен од свог пријатеља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Лажљив сведок неће проћи без казне",
            "poem": 1
          },
          {
            "text": "и ко лажи шири избавити се неће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Многи се додворавају великодушном",
            "poem": 1
          },
          {
            "text": "и сви су пријатељи са дарежљивим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Сиромаха мрзе сва браћа његова,",
            "poem": 1
          },
          {
            "text": "његови га пријатељи још више напуштају!",
            "poem": 2
          },
          {
            "text": "Он их тражи,",
            "poem": 1
          },
          {
            "text": "дозива их, а њих нема.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ко срце испитује, самог себе воли;",
            "poem": 1
          },
          {
            "text": "ко се држи разборитости проналази добро.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Лажљив сведок неће проћи без казне,",
            "poem": 1
          },
          {
            "text": "настрадаће тај што лажи шири.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Будаластом раскош не пристаје,",
            "poem": 1
          },
          {
            "text": "а камоли слузи да влада главарима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Човекова обазривост чува га од срџбе,",
            "poem": 1
          },
          {
            "text": "на част му је да пређе преко увреде.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Царева је срџба лавић који риче,",
            "poem": 1
          },
          {
            "text": "а његова наклоност је ко роса по трави.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Безуман син упропаштава оца свога,",
            "poem": 1
          },
          {
            "text": "а женине су свађе као стално прокишњавање.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Кућа и имање наследство су од отаца,",
            "poem": 1
          },
          {
            "text": "а од Господа је жена обазрива.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Лењост води у дубоки сан,",
            "poem": 1
          },
          {
            "text": "а докони ће гладовати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Живот свој чува ко заповест држи,",
            "poem": 1
          },
          {
            "text": "а умреће онај ко презире путеве своје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Господу позајмљује ко даје сиромаху,",
            "poem": 1
          },
          {
            "text": "он ће да му узврати за то доброчинство.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Сина свога кажњавај докле има наде,",
            "poem": 1
          },
          {
            "text": "али срцем не пожели да га до смрти доведеш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Бесан човек плаћа глобу",
            "poem": 1
          },
          {
            "text": "и ако га од ње спасеш, мораћеш то поново да радиш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Слушај савет и прихвати укор",
            "poem": 1
          },
          {
            "text": "да постанеш мудар у зрелим данима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "У срцу човека многе су намере,",
            "poem": 1
          },
          {
            "text": "али Господњи се наум остварује.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Оданост је пожељна за човека",
            "poem": 1
          },
          {
            "noteId": 3
          },
          {
            "text": ";",
            "poem": 1
          },
          {
            "text": "боље и сиромашан него лажљив.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Богобојазност значи живот,",
            "poem": 1
          },
          {
            "text": "па испуњен човек почива непохаран злом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Ленштина умаче руку у чанак,",
            "poem": 1
          },
          {
            "text": "али је устима својим не приноси.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Шибај подругљивца па ће лаковерни постати мудар,",
            "poem": 1
          },
          {
            "text": "прекори разумног и схватиће поуку.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Ко оца злоставља и тера мајку,",
            "poem": 1
          },
          {
            "text": "син је који доноси бруку и срамоту.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Сине, престани, и слушај укор",
            "poem": 1
          },
          {
            "text": "да не застраниш од поука знања.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Безвредан се сведок руга правди",
            "poem": 1
          },
          {
            "text": "и уста злих људи прождиру злобу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "За подсмеваче спремљена је казна",
            "poem": 1
          },
          {
            "text": "и батина за леђа безумника.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 3,
