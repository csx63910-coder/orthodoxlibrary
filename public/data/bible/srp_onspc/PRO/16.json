  "chapter": {
    "number": 16,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Човек нешто срцем намерава,",
            "poem": 1
          },
          {
            "text": "али од Господа је језика одговор.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "У очима својим човеку су чисти путеви,",
            "poem": 1
          },
          {
            "text": "али Господ проверава намере срца.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Своја дела препусти Господу",
            "poem": 1
          },
          {
            "text": "и учврстиће твоје науме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Господ је начинио све за своју сврху,",
            "poem": 1
          },
          {
            "text": "па чак и злобника за дан страдања.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Господу је мрско свако узносито срце.",
            "poem": 1
          },
          {
            "text": "Нема сумње да тај неће проћи некажњено.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Милошћу и истином откупљује се кривица",
            "poem": 1
          },
          {
            "text": "и богобојазност одвраћа од зла.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Када су Господу мили човекови путеви,",
            "poem": 1
          },
          {
            "text": "он га и са непријатељима његовим мири.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Боље је и мало, а по правди,",
            "poem": 1
          },
          {
            "text": "него обиље стеченог, а по неправди.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Срце човеково смера својим путем,",
            "poem": 1
          },
          {
            "text": "али Господ усмерава његове кораке.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Цар пресуђује надахнутом објавом",
            "poem": 1
          },
          {
            "text": "и одлуке му нису неправедне.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Праведне су Господње мере и теразије,",
            "poem": 1
          },
          {
            "text": "сви тегови у торби његово су дело.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Гадост је кад цареви покварено раде,",
            "poem": 1
          },
          {
            "text": "јер се праведношћу учвршћује престо.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Цареви цене правдољубива уста,",
            "poem": 1
          },
          {
            "text": "они воле оног ко искрено збори.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Царева је срџба као весник смрти",
            "poem": 1
          },
          {
            "text": "и мудар је човек гаси.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Живот је у ведрини царевог лица,",
            "poem": 1
          },
          {
            "text": "наклоност је његова као облак пролећне кише.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Колико је боље тежити мудрости него злату,",
            "poem": 1
          },
          {
            "text": "тежити умности више него тежити сребру!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Пут честитих је одвраћање од зла,",
            "poem": 1
          },
          {
            "text": "живот свој чува онај ко свој пут сачува.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Пред пропашћу иде понос",
            "poem": 1
          },
          {
            "text": "и пред падом иде дух надмени.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "С понизнима боље бити понизан,",
            "poem": 1
          },
          {
            "text": "него плен делити с бахатима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Добро налази ко на реч припази",
            "poem": 1
          },
          {
            "text": "и како је благословен онај ко се у Господа поузда!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Промућурним зову оног срца мудрог",
            "poem": 1
          },
          {
            "text": "и љубазне усне су уверљивије.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Врело је живота проницљивост онима што је имају,",
            "poem": 1
          },
          {
            "text": "а безумље је шиба безумнима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Срце мудроме даје шта ће да каже",
            "poem": 1
          },
          {
            "text": "и уснама његовим јача убедљиву поуку.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Медено саће су речи љубазне,",
            "poem": 1
          },
          {
            "text": "сласт су души и здравље костима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Неки пут пред човеком као да је прав,",
            "poem": 1
          },
          {
            "text": "али завршава на путевима смрти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Себи ради ко год да ради,",
            "poem": 1
          },
          {
            "text": "јер га гладна уста нагоне на то.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Ништарија ископава зло",
            "poem": 1
          },
          {
            "text": "и усне су му попут ватре која прљи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Сплеткарош сплетке сплиће",
            "poem": 1
          },
          {
            "text": "и клеветник раздваја блиске пријатеље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Насилник мами ближњег свога",
            "poem": 1
          },
          {
            "text": "и грозним га путем води;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "намигује очима и гадости смишља,",
            "poem": 1
          },
          {
            "text": "стиска уста и зло постиже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Прелепа је круна коса седа",
            "poem": 1
          },
          {
            "text": "кад се нађе на праведном путу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Бољи је дуготрпљив човек од јунака,",
            "poem": 1
          },
          {
            "text": "и онај који собом влада од освајача града.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "У крило се коцка баца,",
            "poem": 1
          },
          {
            "text": "али од Господа долази свака одлука њена.",
            "poem": 2
          }
        ]
      }
    ],
