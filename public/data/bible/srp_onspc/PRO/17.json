  "chapter": {
    "number": 17,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Бољи је и залогај сувог хлеба у спокоју,",
            "poem": 1
          },
          {
            "text": "него кућа пуна жртвеног меса у свађи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Честити слуга ће владати над нечасним наследником",
            "poem": 1
          },
          {
            "text": "и делиће наследство са браћом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Топионица је за сребро и пећ је за злато,",
            "poem": 1
          },
          {
            "text": "а Господ испитује срца.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Злотвор пази на усне зликовачке,",
            "poem": 1
          },
          {
            "text": "а заводник слуша језик раздора.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ко се руга сиромаху срамоти му Саздатеља,",
            "poem": 1
          },
          {
            "text": "некажњено неће проћи ко ликује због пропасти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Унуци су старцима ко круна",
            "poem": 1
          },
          {
            "text": "и дика су родитељи деци.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Будали не стоје усне беседничке,",
            "poem": 1
          },
          {
            "text": "а камоли кнезу усне лажљивице.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Мито је за даваоца као драги камен,",
            "poem": 1
          },
          {
            "text": "јер му чини да успева где се год окрене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ко преступ покрива, тежи љубави,",
            "poem": 1
          },
          {
            "text": "а ко причу препричава раздваја блиске пријатеље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Укор разумнога прониче дубоко,",
            "poem": 1
          },
          {
            "text": "више него неразумног стотину удараца.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Зликовцу је само до метежа стало,",
            "poem": 1
          },
          {
            "text": "али ће му бити послан сурови посланик.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Боље је човеку да набаса на медведицу којој су отели медведиће,",
            "poem": 1
          },
          {
            "text": "него на безумника у лудости његовој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ко на добро злом узвраћа,",
            "poem": 1
          },
          {
            "text": "никада му од зла неће починути кућа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ко препирку отпочиње, тај бујицу ослобађа.",
            "poem": 1
          },
          {
            "text": "Зато се заваде клони пре него што шикне.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "И онај што оправдава кривог и онај што окривљује правог –",
            "poem": 1
          },
          {
            "text": "обојица су мрски Господу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Чему благо у руци немудрог,",
            "poem": 1
          },
          {
            "text": "кад намере нема да мудрост затражи?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Пријатељ воли у свако доба,",
            "poem": 1
          },
          {
            "text": "а и брат се за невољу рађа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Неразуман човек руку пружа",
            "poem": 1
          },
          {
            "text": "и сигурно јамчи за ближњега свога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ко воли раздор воли и преступ,",
            "poem": 1
          },
          {
            "text": "посрнуће тражи ко подиже врата своја у висине.",
            "poem": 2
          },
          {
            "noteId": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Човек срца поквареног не налази добро,",
            "poem": 1
          },
          {
            "text": "а коме је поган језик у невољу пада.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Жалостан је ко роди безумног",
            "poem": 1
          },
          {
            "text": "и нема радости оцу неукога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Весело срце добро здравље даје,",
            "poem": 1
          },
          {
            "text": "а дух потиштени суши кости.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Покварењак прима мито из недара",
            "poem": 1
          },
          {
            "text": "да поквари стазе праведности.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Мудрост је пред лицем разумног човека,",
            "poem": 1
          },
          {
            "text": "а очи безумног на крају су земље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Будаласти син туга је свом оцу,",
            "poem": 1
          },
          {
            "text": "огорчење оној што га је родила.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Није добро глобити праведника",
            "poem": 1
          },
          {
            "text": "ни шибати честите због правде.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Истински је мудар човек штедљив на речима,",
            "poem": 1
          },
          {
            "text": "а ко је племенитог духа разуман је човек.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "И безумник чак се чини мудрим када ћути,",
            "poem": 1
          },
          {
            "text": "кад затвара усне своје разумним га држе.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 2,
        "caller": "+",
        "text": "17,19 Древна слика људи који своја врата, своја уста охоло разјапљују.",
        "reference": {
          "chapter": 17,
          "verse": 19
        }
      }
    ]
