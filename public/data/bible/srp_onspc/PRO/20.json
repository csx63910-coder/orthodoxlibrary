  },
  "chapter": {
    "number": 20,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Вино је подсмевач и жестоко пиће свађалица,",
            "poem": 1
          },
          {
            "text": "немудар је ко се због њих тетура.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Царево је насиље као рика лавића,",
            "poem": 1
          },
          {
            "text": "ко га раздражује себи самом шкоди.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "На част је човеку да се клони свађе,",
            "poem": 1
          },
          {
            "text": "а сваки се безумник избезуми.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Кад је јесен – ленштина не оре,",
            "poem": 1
          },
          {
            "text": "кад је жетва – он проси и оскудева.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Дубока је вода замисао човековог срца,",
            "poem": 1
          },
          {
            "text": "ал’ је црпсти може само човек разборити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Многи људи објављују свима своју доброту,",
            "poem": 1
          },
          {
            "text": "али ко ће наћи оданог човека?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Праведник живи честитост своју",
            "poem": 1
          },
          {
            "text": "и како су само благословена деца након њега!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Цар који седи на судском престолу",
            "poem": 1
          },
          {
            "text": "погледом својим све зло расипа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Може ли ко рећи: „Срце сам своје очистио,",
            "poem": 1
          },
          {
            "text": "чист сам од греха свога“?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Неједнаки тегови и мера двојака –",
            "poem": 1
          },
          {
            "text": "обоје су огавни Господу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "И дете се по делима својим препознаје,",
            "poem": 1
          },
          {
            "text": "да ли су му дела исправна и чиста.",
            "poem": 2
          },
          {
            "noteId": 4
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "И ухо што чује и око што види,",
            "poem": 1
          },
          {
            "text": "и једно и друго створио је Господ.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Не воли спавање да не осиромашиш,",
            "poem": 1
          },
          {
            "text": "пробуди се и најешћеш се хлеба.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "„Безвредно! Безвредно!“ – говори купац –",
            "poem": 1
          },
          {
            "text": "а онда се хвали када оде својим путем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Постоји злато и мноштво драгуља,",
            "poem": 1
          },
          {
            "text": "али учене усне су као драгоцени накит.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Узми хаљину ономе што јамчи за туђинца,",
            "poem": 1
          },
          {
            "text": "и залог му узми кад јамчи за незнанца.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Човеку је сладак непоштени хлеб,",
            "poem": 1
          },
          {
            "text": "али су му после уста песка пуна.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Намере осмисли саветом",
            "poem": 1
          },
          {
            "text": "и мудрим вођењем ратуј.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Оговарач скита и одаје тајне,",
            "poem": 1
          },
          {
            "text": "зато се не петљај са брбљивцем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Ко проклиње и оца и мајку,",
            "poem": 1
          },
          {
            "text": "светиљка му догорева у најцрњој тами.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "У почетку нагло згрнуто наследство",
            "poem": 1
          },
          {
            "text": "остаје неблагословено на свом крају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Немој рећи: „Узвратићу злу!“",
            "poem": 1
          },
          {
            "text": "Чекај Господа да те избави.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Господу су мрски неједнаки тегови",
            "poem": 1
          },
          {
            "text": "и страшне су теразије неједнаке.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Од Господа су човекови кораци,",
            "poem": 1
          },
          {
            "text": "па како би неко докучио свој властити пут?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Човеку је замка кад непромишљено каже да је нешто посвећено,",
            "poem": 1
          },
          {
            "text": "а да после завете разматра.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Цар ће мудар развејати зликовце,",
            "poem": 1
          },
          {
            "text": "вршидбеним точком преко њих ће прећи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Светиљка Господња је човеков дах,",
            "poem": 1
          },
          {
            "text": "испитује дубине нутрине.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Оданост и истина чувају цара,",
            "poem": 1
          },
          {
            "text": "он оданошћу остаје на престолу своме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Младићу је част у његовој снази",
            "poem": 1
          },
          {
            "text": "а седа је коса достојанство старих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Ране и маснице чисте од зла,",
            "poem": 1
          },
          {
            "text": "а шиба чисти дубине нутрине.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 4,
        "caller": "+",
        "text": "20,11 Овај стих може и овако да се преведе: Чак и дете делима својим сакрива своје праве мотиве, да не знаш јесу ли му дела исправна и чиста.",
        "reference": {
          "chapter": 20,
          "verse": 11
        }
      }
    ]
