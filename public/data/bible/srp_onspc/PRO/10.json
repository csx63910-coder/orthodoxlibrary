  "chapter": {
    "number": 10,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Мудре приче Соломона:",
          {
            "text": "Мудар син радује свог оца,",
            "poem": 1
          },
          {
            "text": "а безуман син је жалост мајци својој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Бескорисно је непоштено богатство,",
            "poem": 1
          },
          {
            "text": "а праведност избавља од смрти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Не да Господ да је гладна душа праведника,",
            "poem": 1
          },
          {
            "text": "а жудњу зликовца одбацује.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Сиромах је ко год ради рукама лењивим,",
            "poem": 1
          },
          {
            "text": "а богатство стичу руке марљивих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Мудар је син који лети сакупља,",
            "poem": 1
          },
          {
            "text": "а срамотно ради син што о жетви спава.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Благослови су над главом праведника,",
            "poem": 1
          },
          {
            "text": "а уста зликоваца насиље скривају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Блажено је сећање на праведника,",
            "poem": 1
          },
          {
            "text": "а спомен на зликовца ће иструлити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Човек мудрог срца прихвата заповести,",
            "poem": 1
          },
          {
            "text": "а блебетави безумник ће сатрвен бити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Спокојно живи ко честито живи,",
            "poem": 1
          },
          {
            "text": "а ко накарадно живи биће разоткривен.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Јад задаје ко оком намигује,",
            "poem": 1
          },
          {
            "text": "а блебетало ће сатрвено бити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Уста су праведникова врело живота,",
            "poem": 1
          },
          {
            "text": "а уста зликоваца насиље скривају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Мржња замеће свађу,",
            "poem": 1
          },
          {
            "text": "а љубав све грехе покрива.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Мудрост ћеш наћи на уснама оштроумног,",
            "poem": 1
          },
          {
            "text": "а батина је за леђа безумнога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Мудри људи сабирају знање,",
            "poem": 1
          },
          {
            "text": "а брбљива уста близу су пропасти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Богатство је богатоме попут утврђења,",
            "poem": 1
          },
          {
            "text": "а сиромасима сиромаштво њихово попут рушевине.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Праведнику је живот награда,",
            "poem": 1
          },
          {
            "text": "а казна за грехе накнада зликовцу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "На стази живота је онај ко пази на опомену,",
            "poem": 1
          },
          {
            "text": "а тумара онај ко не мари за укор.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Безумник је ко прикрива мржњу лажљивим уснама,",
            "poem": 1
          },
          {
            "text": "а шири клевету.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Кад је речи много, грех је неизбежан;",
            "poem": 1
          },
          {
            "text": "разборито чини онај ко заузда уста.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Сребро је пробрано праведников језик,",
            "poem": 1
          },
          {
            "text": "а срце зликовца мале је вредности.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Многе хране уста праведника,",
            "poem": 1
          },
          {
            "text": "а безумни гину због безумља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Господњи благослов обогаћује",
            "poem": 1
          },
          {
            "text": "и тегобу са собом не носи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Злобнику је злоба ко забава,",
            "poem": 1
          },
          {
            "text": "а мудрост је за промишљеног.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Зликовца стиже оно чега се боји,",
            "poem": 1
          },
          {
            "text": "а праведном се жеља испуњава.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Као кад прохуји вихор ветар, тако ни зликовца нема,",
            "poem": 1
          },
          {
            "text": "а праведникови темељи су вечни.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Као сирће зубима и дим очима,",
            "poem": 1
          },
          {
            "text": "такав је ленштина ономе ко га упосли.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Богобојазност умножава дане,",
            "poem": 1
          },
          {
            "text": "а године зликоваца ће се скратити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Праведни се радују у нади,",
            "poem": 1
          },
          {
            "text": "а нада ће злобних да исхлапи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Пут Господњи је тврђава честитоме,",
            "poem": 1
          },
          {
            "text": "а пропаст за злотворе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Праведника неће довека пољуљати,",
            "poem": 1
          },
          {
            "text": "а злотвори неће населити земљу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Мудрошћу рађају уста праведника,",
            "poem": 1
          },
          {
            "text": "а језик ће развратника ишчупан да буде.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Уживање није страно праведним уснама,",
            "poem": 1
          },
          {
            "text": "а ни разврат устима зликовца.",
            "poem": 2
          }
        ]
      }
    ],
