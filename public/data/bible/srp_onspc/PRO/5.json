  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "heading",
        "content": [
          "Упозорење против прељубе"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Сине мој, пази на моју мудрост",
            "poem": 1
          },
          {
            "text": "и послушај добро разборитост моју,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "домишљатост да очуваш",
            "poem": 1
          },
          {
            "text": "и уста да ти очувају знање.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Јер са усана блуднице мед цури,",
            "poem": 1
          },
          {
            "text": "заводљиве речи мекше од уља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Али на крају је као пелен горка",
            "poem": 1
          },
          {
            "text": "и оштра као мач двосекли.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ноге јој силазе у смрт,",
            "poem": 1
          },
          {
            "text": "до Света мртвих ноге јој допиру.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Она не мари за пут живота,",
            "poem": 1
          },
          {
            "text": "стазе јој врлудају, а она то не зна.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Зато ме послушајте, децо,",
            "poem": 1
          },
          {
            "text": "и не одступајте од онога што вам казујем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Заобиђи је надалеко",
            "poem": 1
          },
          {
            "text": "и не примичи се улазу њене куће,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "да не би другима дао образ свој",
            "poem": 1
          },
          {
            "text": "и окрутном човеку године своје;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "да туђинци не би испили ти снагу",
            "poem": 1
          },
          {
            "text": "и труд ти остао у кући туђина;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "да не би кукао на своме свршетку",
            "poem": 1
          },
          {
            "text": "када ти пропадну и тело и здравље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "И ти ћеш рећи: „Како сам мрзео опомену,",
            "poem": 1
          },
          {
            "text": "док ми је срце презирало укор.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Нисам слушао глас свога учитеља,",
            "poem": 1
          },
          {
            "text": "нисам послушао васпитаче своје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Умало нисам пао у свакојако зло",
            "poem": 1
          },
          {
            "text": "усред збора и усред заједнице.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Пиј воду са свога бунара,",
            "poem": 1
          },
          {
            "text": "жубор воду са извора свога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Зар ће се разливати извори твоји по пољима",
            "poem": 1
          },
          {
            "text": "и потоци воде по трговима?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Нека они буду само твоји,",
            "poem": 1
          },
          {
            "text": "а не туђинаца што су са тобом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Да је благословен извор твој!",
            "poem": 1
          },
          {
            "text": "Радовао се ти са женом младости своје!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Она ти је кошута вољена и срна мила.",
            "poem": 1
          },
          {
            "text": "Наслађуј се увек грудима њеним,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "љубављу њеном се опијај стално.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Зашто би се опијао, сине мој,",
            "poem": 1
          },
          {
            "text": "са прељубницом и грлио недра туђе жене?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Јер су сви човекови путеви пред Господњим очима",
            "poem": 1
          },
          {
            "text": "и он их одмерава.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Покварењака ће поробити кривице његове,",
            "poem": 1
          },
          {
            "text": "биће спутан везама његовог греха.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "И умреће, јер није имао одгој,",
            "poem": 1
          },
          {
            "text": "застраниће због величине своје будалаштине.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
