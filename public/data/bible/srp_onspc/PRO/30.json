  "book": {
    "id": "PRO",
    "translationId": "srp_onspc",
    "name": "Приче Соломонове",
    "commonName": "Приче Соломонове",
    "title": "Приче Соломонове",
    "order": 20,
    "numberOfChapters": 31,
    "sha256": "0733f6537794caf53a3928d90b2758e3a4278140646c27306b6fc5e2a0d0240a",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/PRO/1.json",
    "lastChapterNumber": 31,
    "lastChapterApiLink": "/api/srp_onspc/PRO/31.json",
    "totalNumberOfVerses": 915
  },
  "chapter": {
    "number": 30,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Поруке Агура, Јекајевог сина,",
          {
            "text": "пророштво овог човека казано Итилу,",
            "poem": 1
          },
          {
            "text": "Итилу и Укалу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Елем, ја сам простији од било кога",
            "poem": 1
          },
          {
            "text": "и немам памети људске;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "нисам се поучио мудрости",
            "poem": 1
          },
          {
            "text": "и знање Светог немам.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ко се то успео на небеса па сишао?",
            "poem": 1
          },
          {
            "text": "Ко је сабрао ветар у шаке своје?",
            "poem": 2
          },
          {
            "text": "Ко је то увио воде у плашт?",
            "poem": 1
          },
          {
            "text": "Ко је поставио све земљине крајеве?",
            "poem": 2
          },
          {
            "text": "Како му је име",
            "poem": 1
          },
          {
            "text": "и како му се син зове,",
            "poem": 2
          },
          {
            "text": "знаш ли?",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Свака је Божија реч опробана.",
            "poem": 1
          },
          {
            "text": "Он је штит онима који у њему уточиште налазе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Не додаји речима његовим",
            "poem": 1
          },
          {
            "text": "да те не би прекорио,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да се не би показало да си лажов.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Две ствари од тебе тражим,",
            "poem": 1
          },
          {
            "text": "не ускрати ми их док сам жив:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "бескорисну, лажљиву реч од мене удаљи;",
            "poem": 1
          },
          {
            "text": "не дај ми сиромаштва и богатства,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "дај ми хлеба да једем тек да се наједем;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "да се не бих заситио, па се одрекао",
            "poem": 1
          },
          {
            "text": "и рекао ’Ко је Господ?’",
            "poem": 2
          },
          {
            "text": "Или да не бих осиромашио, па крао",
            "poem": 1
          },
          {
            "text": "и ружио име Бога свога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Не клевећи слугу господару његовом",
            "poem": 1
          },
          {
            "text": "да те не би проклињао, па би крив био.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Неки сој проклиње оца свога",
            "poem": 1
          },
          {
            "text": "и мајку своју не благосиља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Неки је сој себи самом чист",
            "poem": 1
          },
          {
            "text": "па од измета свог остаје неопран.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "О, како неки сој уздиже очи",
            "poem": 1
          },
          {
            "text": "и како му је поглед надмен!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Неком су соју зуби ко мачеви",
            "poem": 1
          },
          {
            "text": "а вилице ко ножеви,",
            "poem": 2
          },
          {
            "text": "да са земље прождеру убоге",
            "poem": 1
          },
          {
            "text": "и несрећнике људског рода.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Пијавица има две ћерке –",
            "poem": 1
          },
          {
            "text": "Дај и Дај.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Три су ствари незасите",
            "poem": 1
          },
          {
            "text": "и четири никада не кажу ’Доста!’:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Свет мртвих,",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "јалова утроба,",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "земља воде никад сита",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "и ватра што не каже ’Доста!’",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Око што се оцу руга",
            "poem": 1
          },
          {
            "text": "и презире послушност мајци,",
            "poem": 2
          },
          {
            "text": "искљуцаће поточни гаврани",
            "poem": 1
          },
          {
            "text": "и појешће орлићи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Три су ми ствари зачуђујуће",
            "poem": 1
          },
          {
            "text": "и четири су ми непознате:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "орлов лет по небесима,",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "пузање змије по стени,",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "пловидба лађе посред мора",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "и пут мушкарца са девојком.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "А пут жене прељубнице је овакав:",
            "poem": 1
          },
          {
            "text": "она једе, обрише уста па каже:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "’Никакво зло нисам урадила!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Под три ствари земља се потреса",
            "poem": 1
          },
          {
            "text": "и четири не може да носи:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "слугу када се зацари,",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "будалу кад је сита хлеба,",
            "poem": 3
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "невољену, а удату жену,",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "и слушкињу кад замени газдарицу своју.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Четири су створа малена на земљи,",
            "poem": 1
          },
          {
            "text": "а опет су преко мере учињена мудрим:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "мрави, нејак народ,",
            "poem": 1
          },
          {
            "text": "али лети себи припремају храну;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "дамани, нејак народ,",
            "poem": 1
          },
          {
            "text": "али дом свој на стенама праве;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "скакавци, иако без цара,",
            "poem": 1
          },
          {
            "text": "ал’ сви лете у поретку;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "гуштер, иако га с обе руке хваташ,",
            "poem": 1
          },
          {
            "text": "ено га у одајама царским.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Три су створа корака поносног",
            "poem": 1
          },
          {
            "text": "и четири што отмено газе:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "лав, од свих звери јачи, ни пред чим не узмиче;",
            "poem": 3
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "петао када се шепури,",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "јарац",
            "poem": 3
          },
          {
            "lineBreak": true
          },
          {
            "text": "и цар са војском поред себе.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Ако си будаласт био себе уздижући,",
            "poem": 1
          },
          {
            "text": "ако ли си сплеткарио,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "руку на уста стави.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Јер када се млеко бућка, настаје масло;",
            "poem": 1
          },
          {
            "text": "и када се нос истрља, крв процури;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а када бес ускипи, то доноси свађу.“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
