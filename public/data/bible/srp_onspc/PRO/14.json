    "name": "Приче Соломонове",
    "commonName": "Приче Соломонове",
    "title": "Приче Соломонове",
    "order": 20,
    "numberOfChapters": 31,
    "sha256": "0733f6537794caf53a3928d90b2758e3a4278140646c27306b6fc5e2a0d0240a",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/PRO/1.json",
    "lastChapterNumber": 31,
    "lastChapterApiLink": "/api/srp_onspc/PRO/31.json",
    "totalNumberOfVerses": 915
  },
  "chapter": {
    "number": 14,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Свака мудра жена кући своју кућу,",
            "poem": 1
          },
          {
            "text": "а безумна је жена раскућује рукама својим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Господа се боји ко честито живи,",
            "poem": 1
          },
          {
            "text": "а презире га онај ко покварено живи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Безумников говор је батина за леђа његова,",
            "poem": 1
          },
          {
            "text": "а мудре чувају уста њихова.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Где волова нема и јасле су чисте,",
            "poem": 1
          },
          {
            "text": "у снази је вола обиље плодова.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Веран сведок не говори лажи,",
            "poem": 1
          },
          {
            "text": "а лажљиви сведок одише лажима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Подругљивац мудрост тражи и не налази је,",
            "poem": 1
          },
          {
            "text": "а поучен човек знање проналази лако.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Иди од безумника,",
            "poem": 1
          },
          {
            "text": "од њега нећеш чути паметне речи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Мудрошћу обазрив човек схвата пут свој,",
            "poem": 1
          },
          {
            "text": "а безумље безумних је обмана.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Безумници се ругају греху,",
            "poem": 1
          },
          {
            "text": "а међу честитима је добра воља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Срцу је позната горчина његова",
            "poem": 1
          },
          {
            "text": "и туђинац не дели његово весеље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Кућа ће злобника бити разорена,",
            "poem": 1
          },
          {
            "text": "а шатор праведника ће процветати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Неки пут пред човеком као да је прав,",
            "poem": 1
          },
          {
            "text": "али завршава на путевима смрти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Срце боли и у смеху,",
            "poem": 1
          },
          {
            "text": "а и радост на свом крају понекад је жалост.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Својих ће се путева наситити отпадник,",
            "poem": 1
          },
          {
            "text": "а и добар човек биће сит од својих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Лаковерни свачему верује,",
            "poem": 1
          },
          {
            "text": "а обазрив пази на свој корак.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Мудар се човек боји греха, клони га се,",
            "poem": 1
          },
          {
            "text": "а немудар је распојасан, у себе сигуран.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Будаласто ради човек који брзо плане,",
            "poem": 1
          },
          {
            "text": "а и сплеткарош је омражен.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Лаковерним следује безумље,",
            "poem": 1
          },
          {
            "text": "а обазриви се знањем ките.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Пред добрим ће се људима злобници клањати",
            "poem": 1
          },
          {
            "text": "и покварењаци пред вратима праведних.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "И суседу своме мрзак је сиромах,",
            "poem": 1
          },
          {
            "text": "а много је оних што воле богатога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Грешан је човек што презире ближњег свога,",
            "poem": 1
          },
          {
            "text": "а благословен је онај који је наклоњен понизнима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Не застрањују ли сплеткароши?",
            "poem": 1
          },
          {
            "text": "Милост и истина онима што добро смишљају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Од сваког вреднога рада долази зарада,",
            "poem": 1
          },
          {
            "text": "а од празних прича само оскудица.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Мудрима је круна њихово богатство,",
            "poem": 1
          },
          {
            "text": "немудрост је немудрог глупава.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Истинољубив сведок спасава животе,",
            "poem": 1
          },
          {
            "text": "а лажљиви слаже чим зине.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "У богобојазности је поуздање јаком",
            "poem": 1
          },
          {
            "text": "и уточиште деци његовој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Врело је живота богобојазност",
            "poem": 1
          },
          {
            "text": "и одвраћа од смртних замки.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Царева је слава у мноштву народа,",
            "poem": 1
          },
          {
            "text": "а кад живља нема, тад владар пропада.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Ко се споро срди врло је разборит,",
            "poem": 1
          },
          {
            "text": "а ко брзо плане велича безумље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Здраво срце – здраво тело;",
            "poem": 1
          },
          {
            "text": "љубомора – трулеж у костима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Ко тлачи убогог срамоти му Саздатеља,",
            "poem": 1
          },
          {
            "text": "а слави га онај што се убогом смилује.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Опаки ће срушен бити опакошћу својом,",
            "poem": 1
          },
          {
            "text": "а праведник и у смрти уточиште има.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Мудрост почива у срцу разумног човека,",
            "poem": 1
          },
          {
            "text": "чак је и у нутрини безумника обелодањена.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Праведност уздиже народ,",
            "poem": 1
          },
          {
            "text": "а грех је срамота народу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Цар поштује слугу што честито ради,",
            "poem": 1
          },
          {
            "text": "а гневан је на онога што ради срамотно.",
            "poem": 2
          }
        ]
      }
    ],
