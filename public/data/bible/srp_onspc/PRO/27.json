  },
  "chapter": {
    "number": 27,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Не хвали се сутрашњим даном,",
            "poem": 1
          },
          {
            "text": "јер не знаш шта доноси тај дан.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Други нек те хвали, а не ти себе самог;",
            "poem": 1
          },
          {
            "text": "незнанац, а не усне твоје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Тежак је камен и песак је тежак,",
            "poem": 1
          },
          {
            "text": "али од обоје је тежи безобразлук безочнога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Окрутан је бес, срџба је горопадна",
            "poem": 1
          },
          {
            "text": "и са љубомором ко да се суочи?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Јавни укор је бољи",
            "poem": 1
          },
          {
            "text": "од тајне љубави.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Поузданије су модрице од онога који те воли",
            "poem": 1
          },
          {
            "text": "од многих пољубаца онога који те мрзи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Сита душа саће меда гази,",
            "poem": 1
          },
          {
            "text": "а гладној је души слатко и све горко.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Попут птице протеране из гнезда,",
            "poem": 1
          },
          {
            "text": "такав је и човек протеран из свог завичаја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Уље и мирис драги су срцу",
            "poem": 1
          },
          {
            "text": "и сладак је пријатељ који од срца саветује.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Не напуштај пријатеља и пријатеља свог оца;",
            "poem": 1
          },
          {
            "text": "не одлази у дом свога брата на дан своје невоље;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "бољи је сусед који је близу, него брат који је далеко.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Мудар буди, сине мој, и срце ми развесели,",
            "poem": 1
          },
          {
            "text": "па да могу подругљивцу речју да узвратим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Обазрив човек примети невољу, па се скрије,",
            "poem": 1
          },
          {
            "text": "а лаковерни иду даље и буду кажњени.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Узми хаљину ономе што јамчи за туђинца,",
            "poem": 1
          },
          {
            "text": "и залог му узми кад јамчи за туђинку.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ко од раног јутра свога ближњег благосиља на сав глас,",
            "poem": 1
          },
          {
            "text": "то ће му се рачунати као клетва.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Жена свадљива је попут сталног прокишњавања",
            "poem": 1
          },
          {
            "text": "по кишном дану.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ко њу обуздава, ветар обуздава",
            "poem": 1
          },
          {
            "text": "и као да држи уље у десници.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Гвожђе се о гвожђе оштри,",
            "poem": 1
          },
          {
            "text": "а човек се оштри о човека.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Од смоквиног плода јешће ко се за њу брине;",
            "poem": 1
          },
          {
            "text": "поштован ће бити онај који штити свога господара.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Као што се лице одсликава у води",
            "poem": 1
          },
          {
            "text": "тако се и срце човека у човеку види.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Као што су и Свет мртвих и трулеж мртвих незасити,",
            "poem": 1
          },
          {
            "text": "тако су незасите и очи човека.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Топионица је за сребро и пећ је за злато,",
            "poem": 1
          },
          {
            "text": "а човек се искушава похвалама које прима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Истуцаш ли тучком неразумног",
            "poem": 1
          },
          {
            "text": "са прекрупом у авану,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "његова се лудост неће скинути са њега.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Своје стадо добро пази,",
            "poem": 1
          },
          {
            "text": "побрини се добро за крда своја;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "јер иметак не траје довека,",
            "poem": 1
          },
          {
            "text": "а ни круна кроз сва поколења.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Коси се трава да нова никне,",
            "poem": 1
          },
          {
            "text": "сакупи се сено по брдима;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "јагњад те облаче,",
            "poem": 1
          },
          {
            "text": "а јарцима плаћаш за поља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Тад имаш обиље козјег млека себи за храну,",
            "poem": 1
          },
          {
            "text": "за храну укућана, за живот слушкиња својих.",
            "poem": 2
          }
        ]
      }
    ],
