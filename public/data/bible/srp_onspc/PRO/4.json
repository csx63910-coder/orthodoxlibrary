  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "heading",
        "content": [
          "Задобиј мудрост по сваку цену"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Децо, послушајте очев прекор",
            "poem": 1
          },
          {
            "text": "и будите пажљиви да се научите из поуке.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Јер ја вам добар савет дајем,",
            "poem": 1
          },
          {
            "text": "стога не запостављајте поуку моју.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Јер ја сам био очев син",
            "poem": 1
          },
          {
            "text": "и мили јединац мајке своје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Он ме је учио и говорио ми:",
            "poem": 1
          },
          {
            "text": "„Нека ти срце прионе чврсто уз речи моје,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "држи се мојих заповести и живећеш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Стичи мудрост! Стичи разумевање!",
            "poem": 1
          },
          {
            "text": "Не заборављај и не отуђуј се од онога што ти казујем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Не напуштај мудрост и она ће те чувати,",
            "poem": 1
          },
          {
            "text": "воли је и браниће те.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Мудрост је најважнија! Стичи мудрост!",
            "poem": 1
          },
          {
            "text": "Са свом својом стечевином ти стичи разумевање.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Уздижи је и уздигнуће те,",
            "poem": 1
          },
          {
            "text": "величаће те јер си је пригрлио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Прелепи венац ће ти ставити на главу,",
            "poem": 1
          },
          {
            "text": "даће ти славну круну.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Сине мој, послушај и прихвати речи моје",
            "poem": 1
          },
          {
            "text": "и много ће година живота твога бити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Упућујем те путем мудрости",
            "poem": 1
          },
          {
            "text": "и праведним те стазама водим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ноге ти неће клецати док ходаш",
            "poem": 1
          },
          {
            "text": "и нећеш посртати док будеш трчао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Држи се опомене и не напуштај је.",
            "poem": 1
          },
          {
            "text": "Брани је, јер ти је она живот.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Не иди стазом покварењака",
            "poem": 1
          },
          {
            "text": "и не следи пут зликоваца.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Клони га се и не иди њиме,",
            "poem": 1
          },
          {
            "text": "окрени се од њега и иди даље!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Јер они не спавају ако зло не нанесу,",
            "poem": 1
          },
          {
            "text": "сан им је украден ако кога не саплету.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Јер они једу хлеб безакоња",
            "poem": 1
          },
          {
            "text": "и насиља вино пију.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "А стаза је праведника попут светла зоре које осваја",
            "poem": 1
          },
          {
            "text": "и светли док дан не осване.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Док је стаза покварених мрачна,",
            "poem": 1
          },
          {
            "text": "па они и не знају о шта се све спотичу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Сине мој, пази на моје речи",
            "poem": 1
          },
          {
            "text": "и приклони ухо своје казивањима мојим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Нека се не одмичу од очију твојих",
            "poem": 1
          },
          {
            "text": "и чувај их усред срца свога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Јер су оне живот онима што их нађу",
            "poem": 1
          },
          {
            "text": "и здравље су целом телу њиховоме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Од свега што се чува ти највише чувај срце своје,",
            "poem": 1
          },
          {
            "text": "јер су у њему извори живота.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Од себе одбаци непоштен говор",
            "poem": 1
          },
          {
            "text": "и обману усана далеко баци од себе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Очи твоје нек гледају право,",
            "poem": 1
          },
          {
            "text": "испред себе ти прикуј свој поглед.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Поравнај стазу корака свога",
            "poem": 1
          },
          {
            "text": "и безбедни ће бити сви твоји путеви.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Не скрећи ни десно ни лево",
            "poem": 1
          },
          {
            "text": "и корак свој уклони од зла.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
