  "chapter": {
    "number": 16,
    "content": [
      {
        "type": "heading",
        "content": [
          "Исмаилово рођење"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Но, Аврамова жена Сараја није Авраму рађала деце. Она је имала слушкињу Египћанку која се звала Агара."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Сараја рече Авраму: „Ево, Господ ме је учинио нероткињом. Иди и лези с мојом слушкињом, можда ћу преко ње стећи потомство.“ Аврам је послушао што му је Сараја рекла."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Тада је Аврамова жена Сараја довела Авраму своју слушкињу Агару Египћанку и дала му је за жену (било је то десет година након што се Аврам населио у Хананској земљи)."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Аврам легне са Агаром и она затрудни. Кад је видела да је затруднела, с презиром је гледала на своју господарицу."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Сараја тада рече Авраму: „Твоја је кривица што ми се наноси ова неправда. Предала сам своју слушкињу у твој загрљај, али откако је опазила да је затруднела, почела је с презиром да гледа на мене. Нека Господ пресуди ко је од нас двоје крив!“"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Аврам одговори Сараји: „Ево, твоја слушкиња је у твојој власти. Како ти се чини да је добро, тако поступи према њој.“ Сараја поче тако злостављати Агару, да је ова побегла од ње."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Но, Анђео Господњи је нађе код извора што је на путу за Сур,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "па је запита: „Агаро, слушкињо Сарајина, одакле долазиш и куда идеш?“ Агара одговори: „Бежим од своје господарице Сараје.“"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Тада јој Анђео Господњи рече: „Врати се својој господарици и покори јој се!“"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Анђео Господњи јој уз то рече: „Веома ћу умножити твоје потомство, тако да се неће моћи пребројити!“"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Још јој рече Анђео Господњи:",
          {
            "text": "„Ево, зачела си",
            "poem": 1
          },
          {
            "text": "и родићеш сина.",
            "poem": 2
          },
          {
            "text": "Даћеш му име ’Исмаило’",
            "poem": 1
          },
          {
            "noteId": 27
          },
          {
            "text": ",",
            "poem": 1
          },
          {
            "text": "јер је Господ чуо за твоју невољу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Он ће бити као дивљи магарац:",
            "poem": 1
          },
          {
            "text": "рука ће се његова на свакога дизати,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и свачија рука на њега ће се дизати,",
            "poem": 2
          },
          {
            "text": "са свом својом браћом",
            "poem": 1
          },
          {
            "text": "у непријатељству ће живети.“",
            "poem": 2
          },
          {
            "noteId": 28
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Агара је назвала Господа који јој је говорио: „Ти си Бог који ме види!“ Агара је, наиме, рекла: „Уистину, видела сам онога који ме види!“"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Зато се тај извор зове „Вир Лахај Рој“",
          {
            "noteId": 29
          },
          "и налази се између Кадиса и Варада."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Агара је Авраму родила сина. Аврам је сину кога му је Агара родила, дао име Исмаило."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Авраму је било осамдесет шест година када му је Агара родила Исмаила."
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 27,
        "caller": "+",
        "text": "16,11 Исмаило значи Бог је чуо.",
        "reference": {
          "chapter": 16,
          "verse": 11
        }
      },
      {
        "noteId": 28,
        "caller": "+",
        "text": "16,12 Дословно: пред лицем све своје браће ће живети.",
        "reference": {
          "chapter": 16,
          "verse": 12
        }
      },
      {
        "noteId": 29,
        "caller": "+",
        "text": "16,14 Вир Лахај Рој значи Извор онога што живи и види ме.",
        "reference": {
