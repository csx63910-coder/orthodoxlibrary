  "chapter": {
    "number": 10,
    "content": [
      {
        "type": "heading",
        "content": [
          "Таблица народа"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ово је родослов Нојевих синова: Сима, Хама и Јафета. Њима су се родили синови после потопа."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Јафетовци"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Јафетови синови су: Гомер, Магог, Мидиј, Јаван, Тувал, Месех и Тирас."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Гомерови синови су: Асхенас, Рифат и Тогарма."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Јаванови синови су: Елиса и Тарсис, Китим и Доданим."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "(Од њих су се разгранали острвски народи по својим земљама; сваки са својим језиком, својим родовима и својим народима.)"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Хамовци"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Хамови синови су: Куш и Мисраим",
          {
            "noteId": 19
          },
          ", Фут и Ханан."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "А Кушови синови су: Сева, Евила, Савата, Регма и Саватака. Регмини синови су: Сава и Дедан."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Кушу се родио Неврод. Овај је постао први моћник на земљи."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Он је био и моћни ловац пред Господом. Зато се каже: „Као Неврод, моћни ловац пред Господом.“"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Његово царство су у почетку сачињавали: Вавилон, Орех, Архад и Халани у земљи Сенар."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Из те земље је отишао у Асирију и подигао Ниниву, Реховот Ир и Халах,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "те Ресен између Ниниве и великог града Халаха."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Од Мисраима су, пак, потекли Лудејци, Енемејци, Лавејци и Нафтухијци,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "па Патрошани, Хаслоњани (од којих су потекли Филистејци) и Кафтореји."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Ханану се родио Сидон, његов првенац, и Хет."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Од Ханана воде порекло Јевусејци, Аморејци, Гергешани,"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Евејци, Арукејци, Синијци,"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Арвађани, Самарјани, и Амаћани. После су се хананска племена расејала,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "тако да се граница Хананаца протезала од Сидона према Герару, све до Газе, па према Содоми и Гомори, Адми и Севојиму, све до Ласа."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "То су Хамови потомци, према својим племенима и језицима, по својим земљама и народима."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Симовци"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "А и Симу, праоцу свих синова Еверових, старијем брату Јафетовом, родили су се синови."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Симови синови: Елам, Асур, Арфаксад, Луд и Арам."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "А Арамови синови су: Уз, Ул, Гетер и Мас."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Арфаксаду се, пак, родио Сала, а Сали Евер."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Еверу су се родила два сина: један се звао Фалек, јер су се за време његовог живота људи на земљи поделили; а његов брат се звао Јектан."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Јектану су се родили Елмодад, Салеф, Ацармавет и Јарах,"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Адорам, Узал, Дикла,"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Овал, Авимаил, Сава,"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Офир, Евила и Јовав; сви ови су били Јектанови синови."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Њихова су се насеља протезала од Масе до Сафира, источног горја."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "То су Симови синови према својим племенима и језицима, земљама и народима."
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "То су племена Нојевих синова према својим родословима и народима. Од њих су се разгранали народи после потопа."
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 19,
        "caller": "+",
        "text": "10,6 Мисраим је праотац свих Мисираца, свих Египћана. (Мисир је старо име Египта.)",
        "reference": {
          "chapter": 10,
          "verse": 6
        }
      }
    ]
  },
