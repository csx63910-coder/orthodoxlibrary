  "chapter": {
    "number": 50,
    "content": [
      {
        "type": "heading",
        "content": [
          "Порука Вавилону"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Реч коју је руком пророка Јеремије Господ објавио о Вавилону и о земљи халдејској:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Објавите међу народима и прогласите;",
            "poem": 1
          },
          {
            "text": "подигните заставу,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "прогласите и не сакривајте.",
            "poem": 2
          },
          {
            "text": "Реците: ’Освојен је Вавилон,",
            "poem": 1
          },
          {
            "text": "осрамоћен је Вил",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и Меродах",
            "poem": 2
          },
          {
            "noteId": 29
          },
          {
            "text": "је скршен.",
            "poem": 2
          },
          {
            "text": "Осрамоћени су њихови идоли",
            "poem": 1
          },
          {
            "text": "и сломљени њихови одурни ликови.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Јер против њега долази народ са севера",
            "poem": 1
          },
          {
            "text": "који ће му опустошити земљу.",
            "poem": 2
          },
          {
            "text": "Тамо неће бити потомака људи, а ни стоке,",
            "poem": 1
          },
          {
            "text": "јер ће побећи и отићи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "У тим данима и у то време",
            "poem": 1
          },
          {
            "text": "– говори Господ –",
            "poem": 2
          },
          {
            "text": "доћи ће заједно Израиљци и Јудејци.",
            "poem": 1
          },
          {
            "text": "Ићи ће плачући и Господа, Бога свога тражиће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Питаће за пут за Сион, лице своје ће к њему окренути:",
            "poem": 1
          },
          {
            "text": "Прионимо уз Господа",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и вечни савез који се неће заборавити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Мој је народ сад постао стадо изгубљено,",
            "poem": 1
          },
          {
            "text": "на грех су их заводили њихови пастири.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Заводили су га по горама,",
            "poem": 2
          },
          {
            "text": "ишли од брда до брда.",
            "poem": 1
          },
          {
            "text": "Заборавили су своје почивалиште.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Прождире их свако ко их нађе,",
            "poem": 1
          },
          {
            "text": "а њихови душмани говоре: ’Ми за ово нисмо криви!",
            "poem": 2
          },
          {
            "text": "Они су згрешили Господу, пребивалишту правде;",
            "poem": 1
          },
          {
            "text": "Господу, нади њихових отаца.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Бежите из Вавилона",
            "poem": 1
          },
          {
            "text": "и из земље халдејске!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Изађите и будите као јарац предводник.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Ево, ја подижем и доводим на Вавилон",
            "poem": 1
          },
          {
            "text": "збор народа великих из северне земље.",
            "poem": 2
          },
          {
            "text": "Постројиће се према њему",
            "poem": 1
          },
          {
            "text": "и оданде га заробити.",
            "poem": 2
          },
          {
            "text": "Стреле су им као у ратника што децу одводи",
            "poem": 1
          },
          {
            "text": "и који се не враћа без плена.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Халдеја ће плен постати,",
            "poem": 1
          },
          {
            "text": "а они што је плене чиниће то колико им је по вољи",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Јер ви сте се радовали, ви сте и ликовали",
            "poem": 1
          },
          {
            "text": "док сте пленили моје наследство.",
            "poem": 2
          },
          {
            "text": "Ритали сте се ко јуница по пропланку,",
            "poem": 1
          },
          {
            "text": "њиштали сте ко обесни коњи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ваша је мајка јако посрамљена,",
            "poem": 1
          },
          {
            "text": "зацрвенела се она што вас роди.",
            "poem": 2
          },
          {
            "text": "Ево, последња међу народима",
            "poem": 1
          },
          {
            "text": "је као дивљина, пустош и пустара.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Због гнева Господњег тамо се не живи,",
            "poem": 1
          },
          {
            "text": "сва ће бити опустошена.",
            "poem": 2
          },
          {
            "text": "И свако ко поред Вавилона прође ужаснут ће бити",
            "poem": 1
          },
          {
            "text": "и звиждаће због свих рана његових.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Постројте се на Вавилон свуд унаоколо!",
            "poem": 1
          },
          {
            "text": "Гађајте га, чето с луковима,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "не штедите стреле јер је Господу згрешио!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Покличем сад против њега свуд унаоколо!",
            "poem": 1
          },
          {
            "text": "Руке диже, куле му падају,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "строваљене зидине његове",
            "poem": 2
          },
          {
            "text": "јер ово је Господња освета.",
            "poem": 1
          },
          {
            "text": "Осветите се:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "као што је он чинио, тако њему учините.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Истребите сејача из Вавилона",
            "poem": 1
          },
          {
            "text": "и онога што о жетви замахује српом.",
            "poem": 2
          },
          {
            "text": "Нека се од мача тлачитељског",
            "poem": 1
          },
          {
            "text": "свако у свој народ врати,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "нека свако својој земљи бежи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Израиљ је овца отерана",
            "poem": 1
          },
          {
            "text": "коју су лавови потерали.",
            "poem": 2
          },
          {
            "text": "Први лав, цар асирски,",
            "poem": 1
          },
          {
            "text": "га је прождерао;",
            "poem": 2
          },
          {
            "text": "а овај задњи, Навуходоносор,",
            "poem": 1
          },
          {
            "text": "цар Вавилона, му је кости оглодао.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Зато овако каже Господ над војскама, Бог Израиља:",
          {
            "text": "„Ево, казнићу цара Вавилона у његовој земљи",
            "poem": 1
          },
          {
            "text": "као што сам казнио цара Асирије.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Вратићу Израиљ на његову пашу,",
            "poem": 1
          },
          {
            "text": "да пасе по Кармилу, по Васану,",
            "poem": 2
          },
          {
            "text": "по Јефремовом горју и по Галаду",
            "poem": 1
          },
          {
            "text": "док му се душа не напасе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "У тим данима и у то време",
            "poem": 1
          },
          {
            "text": "– говори Господ –",
            "poem": 2
          },
          {
            "text": "неће бити кривице на Израиљу",
            "poem": 1
          },
          {
            "text": "која се тражи,",
            "poem": 2
          },
          {
            "text": "и неће бити греха на Јуди",
            "poem": 1
          },
          {
            "text": "који се тражи;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер ја опраштам онима који су остатак.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "На мератајимску земљу",
            "poem": 1
          },
          {
            "noteId": 30
          },
          {
            "text": "изађи",
            "poem": 1
          },
          {
            "text": "и на становнике Фекода.",
            "poem": 2
          },
          {
            "text": "Побиј их, изручи за њима све клетом уништењу",
            "poem": 1
          },
          {
            "text": "– говори Господ –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и учини све како сам ти заповедио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Бојни поклич и разарање велико",
            "poem": 1
          },
          {
            "text": "су по земљи!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Како је пресечен и сломљен",
            "poem": 1
          },
          {
            "text": "маљ читаве земље!",
            "poem": 2
          },
          {
            "text": "Како је Вавилон постао ругло",
            "poem": 1
          },
          {
            "text": "међу народима!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Замку сам ти поставио",
            "poem": 1
          },
          {
            "text": "и ти си се ухватио, Вавилоне.",
            "poem": 2
          },
          {
            "text": "Ти и не знаш да си разоткривен",
            "poem": 1
          },
          {
            "text": "и ухваћен јер си против Господа заратио.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Господ је отворио своју оружарницу",
            "poem": 1
          },
          {
            "text": "и изнео оружје своје јарости,",
            "poem": 2
          },
          {
            "text": "јер то у халдејској земљи",
            "poem": 1
          },
          {
            "text": "је подухват Господа, Бога над војскама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "На њу дођите са свих крајева,",
            "poem": 1
          },
          {
            "text": "отворите њене житнице",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и згрните је на гомиле!",
            "poem": 2
          },
          {
            "text": "Изручите је клетом уништењу",
            "poem": 1
          },
          {
            "text": "да јој нико не преживи!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Покољите све њене насилнике као бикове,",
            "poem": 1
          },
          {
            "text": "на клање их поведите!",
            "poem": 2
          },
          {
            "text": "Јао њима, јер стиже њихов дан,",
            "poem": 1
          },
          {
            "text": "време њихове казне!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Глас бегунаца и избеглих из вавилонске земље",
            "poem": 1
          },
          {
            "text": "јавља по Сиону",
            "poem": 2
          },
          {
            "text": "о освети Господа, нашег Бога,",
            "poem": 1
          },
          {
            "text": "о освети за његов Дом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "„Окупи стрелце на Вавилон,",
            "poem": 1
          },
          {
            "text": "утабори чету с луковима",
            "poem": 2
          },
          {
            "text": "против њих свуда унаоколо.",
            "poem": 1
          },
          {
            "text": "Нека нико не побегне.",
            "poem": 2
          },
          {
            "text": "Узврати му по делима његовим,",
            "poem": 1
          },
          {
            "text": "према свему што је учинио ти му учини,",
            "poem": 2
          },
          {
            "text": "јер се понео дрско против Господа,",
            "poem": 1
          },
          {
            "text": "против Свеца Израиљева.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Зато ће да попадају његови младићи по његовим трговима;",
            "poem": 1
          },
          {
            "text": "настрадаће тога дана сви људи ратници",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Ево, долазим на тебе, о, дрзниче",
            "poem": 1
          },
          {
            "text": "– говори Господ Бог над војскама –",
            "poem": 2
          },
          {
            "text": "јер је дошао твој дан",
            "poem": 1
          },
          {
            "text": "и време да те казним!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Посрнуће дрзник, пашће,",
            "poem": 1
          },
          {
            "text": "а нико га подигнути неће.",
            "poem": 2
          },
          {
            "text": "Запалићу ватру у његовим градовима",
            "poem": 1
          },
          {
            "text": "да прогута све унаоколо.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "Овако каже Господ над војскама:",
          {
            "text": "„Потлачени су заједно народ Израиља",
            "poem": 1
          },
          {
            "text": "и народ Јуде.",
            "poem": 2
          },
          {
            "text": "Сви њихови тлачитељи су их зграбили,",
            "poem": 1
          },
          {
            "text": "одбијају да их ослободе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Али је јак њихов Откупитељ!",
            "poem": 1
          },
          {
            "text": "’Господ над војскама’ му је име.",
            "poem": 2
          },
          {
            "text": "Он ће их бранити у њиховој парници",
            "poem": 1
          },
          {
            "text": "да земљи да спокој,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а неспокој свим становницима Вавилона.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Мач на Халдејце",
            "poem": 1
          },
          {
            "text": "– говори Господ –",
            "poem": 2
          },
          {
            "text": "и на све становнике Вавилона,",
            "poem": 1
          },
          {
            "text": "на његове главаре и мудраце његове!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Мач на лажне пророке –",
            "poem": 1
          },
          {
            "text": "нека буду будале.",
            "poem": 2
          },
          {
            "text": "Мачем на њихове ратнике –",
            "poem": 1
          },
          {
            "text": "нека се ужасну.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Мач на њихове коње, на њихова кола",
            "poem": 1
          },
          {
            "text": "и на све који су међу њима, а мешаног су порекла.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Постаће као жене!",
            "poem": 2
          },
          {
            "text": "Мач на њихове ризнице –",
            "poem": 1
          },
          {
            "text": "нека буду оплењене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "Суша водама његовим!",
            "poem": 1
          },
          {
            "text": "Нека пресуше,",
            "poem": 2
          },
          {
            "text": "јер је то земља идола",
            "poem": 1
          },
          {
            "text": "од чијег ужаса лудо раде.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          {
            "text": "Зато ће у њему боравити звери пустињске са хијенама,",
            "poem": 1
          },
          {
            "text": "и нојеви ће се настанити.",
            "poem": 2
          },
          {
            "text": "Он довека неће бити насељен,",
            "poem": 1
          },
          {
            "text": "од колена до колена биће ненастањен.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          {
            "text": "Као кад је Бог опустошио Содому и Гомору",
            "poem": 1
          },
          {
            "text": "и околне градове",
            "poem": 2
          },
          {
            "text": "– говори Господ –",
            "poem": 3
          },
          {
            "text": "тамо нико пребивати неће,",
            "poem": 1
          },
          {
            "text": "неће бити потомака људи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          {
            "text": "Гле, народ долази са севера!",
            "poem": 1
          },
          {
            "text": "Велики народ и цареви многи",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "биће подигнути из најдаљих земљиних крајева.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          {
            "text": "Они држе лук и копље.",
            "poem": 1
          },
          {
            "text": "Окрутни су и немилосрдни,",
            "poem": 2
          },
          {
            "text": "а глас им хучи као море.",
            "poem": 1
          },
          {
            "text": "Јашу коње спремни као ратник",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "против тебе, ћерко вавилонска.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          {
            "text": "Чуо је о њима глас цар Вавилона",
            "poem": 1
          },
          {
            "text": "и руке су му клонуле,",
            "poem": 2
          },
          {
            "text": "обузели су га зебња",
            "poem": 1
          },
          {
            "text": "и бол као породиљу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          {
            "text": "Гле, као лав што скаче из јорданског честара",
            "poem": 1
          },
          {
            "text": "на пашњак плодан,",
            "poem": 2
          },
          {
            "text": "ја ћу их потерати одатле у трену.",
            "poem": 1
          },
          {
            "text": "И ко год да је изабрани, ту ћу га ставити.",
            "poem": 2
          },
          {
            "text": "Јер, ко је као ја и ко ће против мене?",
            "poem": 1
          },
          {
            "text": "Ко је тај пастир који ће изаћи пред мене?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          {
            "text": "Зато чујте намере Господње што их је за Вавилон намерио,",
            "poem": 1
          },
          {
            "text": "и његове науме што је за земљу халдејску наумио:",
            "poem": 2
          },
          {
            "text": "стварно ће одвући најмлађе из стада,",
            "poem": 1
          },
          {
            "text": "опустошиће стварно због њих пашњак њихов.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          {
            "text": "Од повика „Освојен је Вавилон“ потрешће се земља",
            "poem": 1
          },
          {
            "text": "и вапај ће се чути међу народима.",
            "poem": 2
          }
        ]
      }
    ],
