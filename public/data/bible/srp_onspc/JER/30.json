  "chapter": {
    "number": 30,
    "content": [
      {
        "type": "heading",
        "content": [
          "Обнова Израиља"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Реч која је Јеремији дошла од Господа:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "„Овако каже Господ, Бог Израиља: ’Запиши себи у књигу све речи које ти објављујем."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Јер, ево, долазе дани – говори Господ – када ћу да вратим из изгнанства мој народ, Израиљ и Јуду. Господ каже: довешћу их у земљу коју сам дао њиховим прецима и они ће је запосести.’“"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "А ово је порука коју је Господ објавио Израиљу и Јуди:"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "„Овако каже Господ:",
          {
            "text": "’Чули сте страшне, грозне вапаје,",
            "poem": 1
          },
          {
            "text": "а мира нема!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Распитајте се и размотрите:",
            "poem": 1
          },
          {
            "text": "Да ли мушкарац рађа?",
            "poem": 2
          },
          {
            "text": "Па како онда видим да се свако мушко",
            "poem": 1
          },
          {
            "text": "држи за бедра, као породиља,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да су свима лица изобличена од бледила!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Јао! Велик ће бити тај дан",
            "poem": 1
          },
          {
            "text": "и нема таквог.",
            "poem": 2
          },
          {
            "text": "Биће то време невоље за Јакова,",
            "poem": 1
          },
          {
            "text": "али и од ње ће бити спасен.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "И тога дана – говори Господ над војскама –",
            "poem": 1
          },
          {
            "text": "сломићу му јарам с врата,",
            "poem": 2
          },
          {
            "text": "покидаћу му окове",
            "poem": 1
          },
          {
            "text": "и неће више служити туђинцима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Служиће Господу, своме Богу,",
            "poem": 1
          },
          {
            "text": "и своме цару Давиду",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "кога ћу им подигнути.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "А ти се не плаши, слуго мој Јакове",
            "poem": 1
          },
          {
            "text": "– говори Господ –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "не страхуј, Израиљу, јер те ја спасавам издалека;",
            "poem": 2
          },
          {
            "text": "из земље њиховог изгнанства враћам твоје потомке.",
            "poem": 1
          },
          {
            "text": "И Јаков ће се вратити, биће спокојан",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и сигуран јер га нико неће плашити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Јер сам ја с тобом",
            "poem": 1
          },
          {
            "text": "– говори Господ – да те спасем.",
            "poem": 2
          },
          {
            "text": "Ја ћу да истребим све народе",
            "poem": 1
          },
          {
            "text": "где сам те расејао,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "али тебе нећу да истребим.",
            "poem": 2
          },
          {
            "text": "Тебе ћу праведно да покарам",
            "poem": 1
          },
          {
            "text": "и нећу те оставити некажњеног.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Јер овако каже Господ:",
          {
            "text": "’Прелом је твој неизлечив",
            "poem": 1
          },
          {
            "text": "и тешка је твоја рана!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Нико те не брани",
            "poem": 1
          },
          {
            "text": "и за твоју рану нема лека",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "што ти здравље носи!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Сви љубавници твоји су те заборавили",
            "poem": 1
          },
          {
            "text": "и није их брига;",
            "poem": 2
          },
          {
            "text": "јер сам те оборио налетом непријатеља",
            "poem": 1
          },
          {
            "text": "и казном окрутнога",
            "poem": 2
          },
          {
            "text": "због твојих великих кривица",
            "poem": 1
          },
          {
            "text": "и многих греха твојих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Зашто плачеш због свог лома?",
            "poem": 1
          },
          {
            "text": "Бол је твој неизлечив",
            "poem": 2
          },
          {
            "text": "због твојих великих кривица и многих твојих греха.",
            "poem": 1
          },
          {
            "text": "А све то ја сам ти учинио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "И зато ће бити прогутани сви ти што тебе гутају.",
            "poem": 1
          },
          {
            "text": "Сви твоји непријатељи, баш сви ће отићи у ропство.",
            "poem": 2
          },
          {
            "text": "Они који те пљачкају биће опљачкани,",
            "poem": 1
          },
          {
            "text": "а оне који те плене у плен ћу да претворим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Јер ти ја здравље доносим",
            "poem": 1
          },
          {
            "text": "и лечим те од свих рана",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          },
          {
            "text": "Јер, звали су те ’Отерана’,",
            "poem": 1
          },
          {
            "text": "’Сион за који никог више није брига.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Овако каже Господ:",
          {
            "text": "’Ево, вратићу изгнане Јаковљевих шатора",
            "poem": 1
          },
          {
            "text": "и смиловаћу се на њихова пребивалишта!",
            "poem": 2
          },
          {
            "text": "Обновићу град на његовим рушевинама",
            "poem": 1
          },
          {
            "text": "и двор ће да почива где му је и место.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Из њих ће се чути захваљивање",
            "poem": 1
          },
          {
            "text": "и повик радосних.",
            "poem": 2
          },
          {
            "text": "Умножићу их",
            "poem": 1
          },
          {
            "text": "и неће бити незнатни;",
            "poem": 2
          },
          {
            "text": "учинићу их часним",
            "poem": 1
          },
          {
            "text": "и понижени неће бити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Њихове ће деце бити као некад давно,",
            "poem": 1
          },
          {
            "text": "а њихова ће заједница преда мном бити основана.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "И ја ћу да казним све њихове тлачитеље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Од њега ће потећи владар њихов,",
            "poem": 1
          },
          {
            "text": "њихов ће вођа од својих изаћи.",
            "poem": 2
          },
          {
            "text": "Ја ћу га привући и он ће ми приступити.",
            "poem": 1
          },
          {
            "text": "Јер, ко је тај што би срцем",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и помислио да ми другачије приступи",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "И ви ћете бити мени народ",
            "poem": 1
          },
          {
            "text": "а ја вама бићу Бог.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Ево вихора гнева Господњег!",
            "poem": 1
          },
          {
            "text": "Ковитла вихор над главом зликоваца,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "баш ковитла.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Господњи успламтели гнев неће уминути",
            "poem": 1
          },
          {
            "text": "док не испуни",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и док не уради по наумима свог срца.",
            "poem": 2
          },
          {
            "text": "А то ћете схватити",
            "poem": 1
          },
          {
            "text": "у последњим данима.",
            "poem": 2
          }
        ]
      }
    ],
