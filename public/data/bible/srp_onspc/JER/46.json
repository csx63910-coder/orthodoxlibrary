    "lastChapterApiLink": "/api/srp_onspc/JER/52.json",
    "totalNumberOfVerses": 1364
  },
  "chapter": {
    "number": 46,
    "content": [
      {
        "type": "heading",
        "content": [
          "Порука Египту"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Реч Господња која је дошла пророку Јеремији за народе:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "За Египат, за војску цара Египта, фараона Нехаона, што је на реци Еуфрат у Харкемису и коју је поразио Навуходоносор, цар Вавилона. А то је било четврте године Јосијиног сина Јоакима, цара Јуде."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "„Поређајте штитове и мале и велике!",
            "poem": 1
          },
          {
            "text": "Спремите се за битку!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Упрегните коње!",
            "poem": 1
          },
          {
            "text": "Узјашите коњаници!",
            "poem": 2
          },
          {
            "text": "Заузмите положај са кацигама!",
            "poem": 1
          },
          {
            "text": "Углачајте копља",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и оклопе на себе!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Је л’ ја то видим да су престрављени",
            "poem": 1
          },
          {
            "text": "и да су потиснути уназад?",
            "poem": 2
          },
          {
            "text": "Њихови су ратници разбијени,",
            "poem": 1
          },
          {
            "text": "повлаче се, беже и не враћају се.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ужас одасвуд",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Не дај брзом да побегне,",
            "poem": 1
          },
          {
            "text": "ни ратнику да се спасе.",
            "poem": 2
          },
          {
            "text": "На северу, поред реке Еуфрат,",
            "poem": 1
          },
          {
            "text": "ће се спотакнути и пасти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ко је тај што попут Нила плави",
            "poem": 1
          },
          {
            "text": "и водом својом надолази као река?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Египат плави попут Нила",
            "poem": 1
          },
          {
            "text": "и као река водом надолази.",
            "poem": 2
          },
          {
            "text": "И још каже: ’Надоћи ћу, преплавићу земљу,",
            "poem": 1
          },
          {
            "text": "разорићу град и све који у њему живе.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Пропните се, коњи!",
            "poem": 1
          },
          {
            "text": "Јуришајте, бојна кола!",
            "poem": 2
          },
          {
            "text": "Ратници нека искораче: и Куши и Фути са штитовима",
            "poem": 1
          },
          {
            "text": "и Лудеји с луковима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "То је дан који припада Господу, Богу над војскама,",
            "poem": 1
          },
          {
            "text": "дан освете, да се освети својим душманима.",
            "poem": 2
          },
          {
            "text": "Мач ће их прождирати док се не засити,",
            "poem": 1
          },
          {
            "text": "напиће се њихове крви,",
            "poem": 2
          },
          {
            "text": "јер ће жртва за Господа, Бога над војскама,",
            "poem": 1
          },
          {
            "text": "бити у северној земљи крај реке Еуфрат.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Попни се у Галад и купи мелем,",
            "poem": 1
          },
          {
            "text": "о, девице, ћерко египатска!",
            "poem": 2
          },
          {
            "text": "Узалуд су ти мелеми бројни,",
            "poem": 1
          },
          {
            "text": "јер за тебе нема излечења.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Народи су чули за твоју срамоту",
            "poem": 1
          },
          {
            "text": "и твога се плача испунила земља,",
            "poem": 2
          },
          {
            "text": "јер се ратник о ратника спотиче",
            "poem": 1
          },
          {
            "text": "и обојица падају.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Реч коју је Господ објавио пророку Јеремији о походу Навуходоносора, цара Вавилона, и о нападу на Египат:"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "„Најави у Египту, прогласи у Мигдолу,",
            "poem": 1
          },
          {
            "text": "у Нофу и Тафнесу прогласи.",
            "poem": 2
          },
          {
            "text": "Реци: ’Постави се и спреми се",
            "poem": 1
          },
          {
            "text": "јер мач прождире унаоколо!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Зашто су полегли твоји ратници?",
            "poem": 1
          },
          {
            "text": "Нису се одржали јер их је Господ гурнуо.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Многе је спотакнуо",
            "poem": 1
          },
          {
            "text": "и они падају један на другога,",
            "poem": 2
          },
          {
            "text": "па говоре: ’Устанимо и вратимо се",
            "poem": 1
          },
          {
            "text": "нашем народу и у свој родни крај",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "пред мачем тлачитељевим.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "И народ ће тамо назвати фараона,",
            "poem": 1
          },
          {
            "text": "цара Египта: ’Галамџија",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "коме је прошло време!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Живота ми мога – говори цар,",
            "poem": 1
          },
          {
            "text": "Господ над војскама му је име –",
            "poem": 2
          },
          {
            "text": "доћи ће као Тавор међу планинама",
            "poem": 1
          },
          {
            "text": "и као Кармил поред мора.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Спремај себи пртљаг за изгнанство,",
            "poem": 1
          },
          {
            "text": "становнице, ћерко египатска.",
            "poem": 2
          },
          {
            "text": "Јер ће Ноф постати руина,",
            "poem": 1
          },
          {
            "text": "опустеће од становника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Египат је прелепа јуница,",
            "poem": 1
          },
          {
            "text": "а обади са севера долазе и долазе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Плаћеници су његови усред њега",
            "poem": 1
          },
          {
            "text": "као товна телад.",
            "poem": 2
          },
          {
            "text": "Окренуће се и побећи ће заједно,",
            "poem": 1
          },
          {
            "text": "неће остати на положајима.",
            "poem": 2
          },
          {
            "text": "Јер стиже на њих дан њихове пропасти,",
            "poem": 1
          },
          {
            "text": "време њихове казне.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Он сикће као змија",
            "poem": 1
          },
          {
            "text": "што је одмигољила",
            "poem": 2
          },
          {
            "text": "јер они долазе у снази,",
            "poem": 1
          },
          {
            "text": "долазе на њега са секирама као дрвосече.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Посећи ће му шуму",
            "poem": 1
          },
          {
            "text": "– говори Господ –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ако је и непрегледна.",
            "poem": 2
          },
          {
            "text": "Више их је него скакаваца",
            "poem": 1
          },
          {
            "text": "што им нема броја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Биће осрамоћена ћерка Египта",
            "poem": 1
          },
          {
            "text": "и предана у руке народа са севера.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Овако каже Господ над војскама, Бог Израиља: „Ево, ја ћу да казним Амона у Нои, фараона, Египат и његове богове, његове цареве и фараона и оне што се у њега поуздају."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Даћу их у руке оних који им раде о глави, у руке Навуходоносора, цара Вавилона, и у руке његових слугу. А након тога ће га населити као у старим временима – говори Господ."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "А ти се не плаши, слуго мој Јакове!",
            "poem": 1
          },
          {
            "text": "Не страхуј, Израиљу,",
            "poem": 2
          },
          {
            "text": "јер те ја спасавам издалека;",
            "poem": 1
          },
          {
            "text": "из земље њиховог изгнанства враћам твоје потомке.",
            "poem": 2
          },
          {
            "text": "И Јаков ће се вратити, биће спокојан",
            "poem": 1
          },
          {
            "text": "и сигуран јер га нико неће плашити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Не плаши се, слуго мој Јакове",
            "poem": 1
          },
          {
            "text": "– говори Господ – јер сам ја с тобом.",
            "poem": 2
          },
          {
            "text": "Ја ћу да истребим све народе",
            "poem": 1
          },
          {
            "text": "где сам те расејао,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "али тебе нећу да истребим.",
            "poem": 2
          },
          {
            "text": "Тебе ћу праведно да покарам",
            "poem": 1
          },
          {
            "text": "и нећу те оставити некажњеног.“",
            "poem": 2
          }
        ]
      }
    ],
