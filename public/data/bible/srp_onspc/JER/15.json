    "lastChapterApiLink": "/api/srp_onspc/JER/52.json",
    "totalNumberOfVerses": 1364
  },
  "chapter": {
    "number": 15,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Господ ми је рекао: „Ако би Мојсије и Самуило стали пред мене не би се моја душа приклонила овом народу. Отерај их од мене! Нека иду."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "А ако ти кажу: ’А где да идемо?’, ти им одговори: ’Овако каже Господ:",
          {
            "text": "У смрт, ко је за смрт;",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "под мач, ко је за мач;",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "у глад, ко је за глад;",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "у изгнанство, ко је за изгнанство.’",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Навалићу на њих четири ствари – говори Господ – мач што убија, псе што тргају, птице небеске и звери земаљске што прождиру и тамане."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Учинићу их призором грозоте за сва царства света због Јудиног цара Манасије, сина Језекијиног, због оног што је урадио у Јерусалиму."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "О, Јерусалиме, ко ће да ти се смилује?!",
            "poem": 1
          },
          {
            "text": "Ко ће да те пожали",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и ко да ти сврати и упита те за здравље?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ти си мене напустио – говори Господ –",
            "poem": 1
          },
          {
            "text": "устукнуо си,",
            "poem": 2
          },
          {
            "text": "а ја ћу замахнути руком на тебе",
            "poem": 1
          },
          {
            "text": "и разорићу те.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Уморило ме је да ти попуштам.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Развејаћу их вилама на вратима земље.",
            "poem": 1
          },
          {
            "text": "Побићу децу мом народу,",
            "poem": 2
          },
          {
            "text": "сатрћу их јер се не кају",
            "poem": 1
          },
          {
            "text": "због својих путева.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Више него морског песка",
            "poem": 1
          },
          {
            "text": "биће преда мном удовица,",
            "poem": 2
          },
          {
            "text": "мајки младића против којих ћу довести",
            "poem": 1
          },
          {
            "text": "затирача усред дана.",
            "poem": 2
          },
          {
            "text": "Учинићу да се изненада на њих",
            "poem": 1
          },
          {
            "text": "стровале мука и ужас.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Клонула је она што је седморо родила,",
            "poem": 1
          },
          {
            "text": "дах је испустила,",
            "poem": 2
          },
          {
            "text": "сунце јој је зашло још за дана.",
            "poem": 1
          },
          {
            "text": "Посрамљена је, зацрвенела се,",
            "poem": 2
          },
          {
            "text": "а њихов остатак ћу дати мачу њихових непријатеља",
            "poem": 1
          },
          {
            "text": "– говори Господ.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Куку мајко, што си ме родила!",
            "poem": 1
          },
          {
            "text": "Човек сам неслоге,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "човек око ког се гложи цела земља!",
            "poem": 2
          },
          {
            "text": "Нит’ сам позајмљивао, нит’ су ми позајмљивали,",
            "poem": 1
          },
          {
            "text": "а сваки ме проклиње.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Господ одговори:",
          {
            "text": "„Ослободићу те заиста за твоје добро.",
            "poem": 1
          },
          {
            "text": "Заиста ћу дати да те непријатељ моли",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "у време погрома и у време невоље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Сломи ли ко гвожђе,",
            "poem": 1
          },
          {
            "text": "гвожђе са севера и бронзу",
            "poem": 2
          },
          {
            "noteId": 7
          },
          {
            "text": "?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Твоја добра и имања твоја",
            "poem": 1
          },
          {
            "text": "дајем као плен, у бесцење,",
            "poem": 2
          },
          {
            "text": "за све твоје грехе",
            "poem": 1
          },
          {
            "text": "по свим твојим границама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Предаћу те непријатељима твојим",
            "poem": 1
          },
          {
            "text": "у земљи коју не знаш,",
            "poem": 2
          },
          {
            "text": "да им служиш;",
            "poem": 1
          },
          {
            "text": "јер мој гнев је ватру запалио",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и против тебе она букти.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "О, Господе, ти знаш, ти ме се сети.",
            "poem": 1
          },
          {
            "text": "Сети ме се и освети се за мене онима што ме киње.",
            "poem": 2
          },
          {
            "text": "Не дај да ме збрише спорост твога гнева.",
            "poem": 1
          },
          {
            "text": "Ти знаш да за тебе трпим ругло.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Твоје речи су се нашле и ја сам их појео!",
            "poem": 1
          },
          {
            "text": "Твоје речи су постале радост и весеље моме срцу!",
            "poem": 2
          },
          {
            "text": "Јер, твоје је име призвано на мене,",
            "poem": 1
          },
          {
            "text": "о, Господе, Боже над војскама!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ја не седим у друштву весељака",
            "poem": 1
          },
          {
            "text": "и не веселим се.",
            "poem": 2
          },
          {
            "text": "Седим сам, баш због руке твоје,",
            "poem": 1
          },
          {
            "text": "јер си ме јарошћу преплавио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Зашто моме болу нема краја?",
            "poem": 1
          },
          {
            "text": "Зашто мојој рани нема лека, што одбија да буде излечена?",
            "poem": 2
          },
          {
            "text": "А ти си ми стварно као поток непостојан,",
            "poem": 1
          },
          {
            "text": "вода што пресуши.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "И зато овако каже Господ:",
          {
            "text": "„Ако се вратиш, излечићу те",
            "poem": 1
          },
          {
            "text": "и преда мном ћеш стајати.",
            "poem": 2
          },
          {
            "text": "И ако раздвојиш вредно од безвредног",
            "poem": 1
          },
          {
            "text": "бићеш као моја уста.",
            "poem": 2
          },
          {
            "text": "И они ће се окретати теби",
            "poem": 1
          },
          {
            "text": "али ти не смеш да се окрећеш к њима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Направићу од тебе",
            "poem": 1
          },
          {
            "text": "утврђени бронзани зид за народ овај.",
            "poem": 2
          },
          {
            "text": "Бориће се против тебе,",
            "poem": 1
          },
          {
            "text": "али те неће надвладати.",
            "poem": 2
          },
          {
            "text": "Јер ја сам с тобом",
            "poem": 1
          },
          {
            "text": "да те спасем и избављам",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Избавићу те из руку зликоваца!",
            "poem": 1
          },
          {
            "text": "Из шака свирепих откупићу те!“",
            "poem": 2
          }
        ]
      }
    ],
