  },
  "chapter": {
    "number": 31,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "„У оне дане – говори Господ – бићу Бог свим родовима Израиљевим, а они ће бити мој народ.“"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Овако каже Господ:",
          {
            "text": "„Народ који је преживео мач",
            "poem": 1
          },
          {
            "text": "нашао је наклоност у пустињи,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "када је Израиљ отишао да нађе свој починак.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Господ ми",
          {
            "noteId": 16
          },
          "се издалека објавио:",
          {
            "text": "„Ја те волим љубављу вечном",
            "poem": 1
          },
          {
            "text": "и зато те милошћу привлачим!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Опет ћу те сазидати,",
            "poem": 1
          },
          {
            "text": "обновљена бићеш, о, девице израиљска.",
            "poem": 2
          },
          {
            "text": "Даирама ћеш се опет окитити,",
            "poem": 1
          },
          {
            "text": "играћеш у колу с радоснима!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Опет ћеш да садиш винограде",
            "poem": 1
          },
          {
            "text": "на брдима Самарије.",
            "poem": 2
          },
          {
            "text": "А они који саде,",
            "poem": 1
          },
          {
            "text": "ти ће и да једу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Јер долази дан када ће звати стражари",
            "poem": 1
          },
          {
            "text": "по Јефремовом горју:",
            "poem": 2
          },
          {
            "text": "’Устаните! Идемо Господу,",
            "poem": 1
          },
          {
            "text": "нашем Богу на Сион!’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Овако каже Господ:",
          {
            "text": "„Радосно кличите због Јакова!",
            "poem": 1
          },
          {
            "text": "Подврискујте кличући због главе народа!",
            "poem": 2
          },
          {
            "text": "Објављујте, прослављајте и говорите:",
            "poem": 1
          },
          {
            "text": "’О, Господе, спаси свој народ,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "остатак Израиљев!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Ево, доводим их из северне земље,",
            "poem": 1
          },
          {
            "text": "окупљам их из најдаљих земљиних крајева.",
            "poem": 2
          },
          {
            "text": "И међу њима ће бити слепи и хроми,",
            "poem": 1
          },
          {
            "text": "трудница и породиља.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Баш велики збор ће се вратити овамо.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Доћи ће с преклињањима,",
            "poem": 1
          },
          {
            "text": "довешћу их док буду вапили.",
            "poem": 2
          },
          {
            "text": "Водићу их на набујале потоке,",
            "poem": 1
          },
          {
            "text": "на путеве равне на којима се неће спотакнути.",
            "poem": 2
          },
          {
            "text": "Јер ја сам Израиљу отац",
            "poem": 1
          },
          {
            "text": "и Јефрем је мој првенац.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "„Народи, чујте реч Господњу,",
            "poem": 1
          },
          {
            "text": "јавите по далеким острвима и реците:",
            "poem": 2
          },
          {
            "text": "’Онај који је раштркао Израиљ, тај ће га и сакупити",
            "poem": 1
          },
          {
            "text": "и чуваће их као пастир своје стадо.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Јер, Господ је откупио Јакова,",
            "poem": 1
          },
          {
            "text": "искупио га је из руку јачега од њега.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "А они ће доћи на брдо Сион кличући радосно.",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ликоваће због добра Господњег, због жита",
            "poem": 1
          },
          {
            "text": "и вина, због уља, јагањаца и телади.",
            "poem": 2
          },
          {
            "text": "Живот ће им бити као врт заливен",
            "poem": 1
          },
          {
            "text": "и више никад неће малаксати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Девојка ће се у колу радовати",
            "poem": 1
          },
          {
            "text": "заједно са младићима и старцима.",
            "poem": 2
          },
          {
            "text": "Преокренућу њихову жалост у радост.",
            "poem": 1
          },
          {
            "text": "Утешићу их и обрадовати их након туге њихове.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Наситићу изобиљем душе свештеника",
            "poem": 1
          },
          {
            "text": "а и мој ће народ сит бити од добара мојих",
            "poem": 2
          },
          {
            "text": "– говори Господ.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Овако каже Господ:",
          {
            "text": "„У Рами се глас чује,",
            "poem": 1
          },
          {
            "text": "јецај и лелек гласни:",
            "poem": 2
          },
          {
            "text": "то Рахиља за децом својом нариче,",
            "poem": 1
          },
          {
            "text": "и неће да се утеши,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер њих више нема.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Овако каже Господ:",
          {
            "text": "„Грло стегни да не плаче,",
            "poem": 1
          },
          {
            "text": "не дај оку да засузи!",
            "poem": 2
          },
          {
            "text": "Јер, ево награде за дело твоје",
            "poem": 1
          },
          {
            "text": "– говори Господ –",
            "poem": 3
          },
          {
            "text": "вратиће се они из земље непријатеља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "За твоје сутра постоји нада",
            "poem": 1
          },
          {
            "text": "– говори Господ –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "вратиће се деца у свој завичај.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Јесам, чуо сам Јефрема што над собом жали:",
            "poem": 1
          },
          {
            "text": "’Казнио си ме",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и био сам кажњен као теле неукроћено.",
            "poem": 2
          },
          {
            "text": "Поврати ме да могу да се вратим,",
            "poem": 1
          },
          {
            "text": "јер си ти, Господе, Бог мој!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "И кад сам ти се вратио,",
            "poem": 1
          },
          {
            "text": "покајао сам се;",
            "poem": 2
          },
          {
            "text": "и кад сам поучен био,",
            "poem": 1
          },
          {
            "text": "тукао сам се у бедра.",
            "poem": 2
          },
          {
            "text": "Срамота ме је и понижен сам",
            "poem": 1
          },
          {
            "text": "јер носим ругло своје младости.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Није ли Јефрем мој драги син",
            "poem": 1
          },
          {
            "text": "и дете најмилије?",
            "poem": 2
          },
          {
            "text": "Иако сам често говорио против њега,",
            "poem": 1
          },
          {
            "text": "стално мислим о њему.",
            "poem": 2
          },
          {
            "text": "Зато ми је за њим устрептала утроба",
            "poem": 1
          },
          {
            "text": "и стварно ћу да му се смилујем",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Постави себи путоказе.",
            "poem": 1
          },
          {
            "text": "Стави себи знакове",
            "poem": 2
          },
          {
            "text": "и срце усмери на пут,",
            "poem": 1
          },
          {
            "text": "на стазу којом си ишла.",
            "poem": 2
          },
          {
            "text": "Па се врати, о, девице израиљска,",
            "poem": 1
          },
          {
            "text": "врати се овим својим градовима!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Докле ћеш да тумараш,",
            "poem": 1
          },
          {
            "text": "о, ћерко одметничка?!",
            "poem": 2
          },
          {
            "text": "Јер Господ је створио на земљи нешто ново,",
            "poem": 1
          },
          {
            "text": "као кад би жена приступила мушкарцу.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Овако каже Господ над војскама, Бог Израиља: „Људи ће опет говорити ову изреку у јудејској земљи и по њеним градовима, кад им вратим њихове изгнанике: ’Нека те Господ благослови Пребивалиште правде, светости горо!’"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Пребиваће Јуда и сви њени градови заједно у њој, и ратари и они што иду за стадом."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Напојићу душе малаксале, окрепићу сваког изнемоглог.“"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "И тада сам се пробудио и погледао: мој је сан био тако сладак."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "„Ево, долазе дани – говори Господ – када ћу дом Израиљев и дом Јудин засејати људским семеном и сточним семеном."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "И као што сам бдео над њима да их чупам, да их обарам и рушим, да их разарам и кажњавам; тако ћу да бдим над њима да их градим и да их садим – говори Господ."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "У данима оним неће више говорити:",
          {
            "text": "’Очеви су јели недозрело грожђе,",
            "poem": 1
          },
          {
            "text": "али зато зуби трну синовима!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Ипак, за своју кривицу свако ће да умре; утрнуће зуби сваком који грожђе недозрело једе!"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Ево, долазе дани – говори Господ –",
            "poem": 1
          },
          {
            "text": "када ћу склопити нови савез",
            "poem": 2
          },
          {
            "text": "с народом израиљским",
            "poem": 1
          },
          {
            "text": "и с народом Јудиним.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "То неће бити као кад сам",
            "poem": 1
          },
          {
            "text": "склопио савез са њиховим оцима,",
            "poem": 2
          },
          {
            "text": "онога дана кад сам их узео за руку",
            "poem": 1
          },
          {
            "text": "и извео из Египта.",
            "poem": 2
          },
          {
            "text": "Али нису били верни моме савезу,",
            "poem": 1
          },
          {
            "text": "а ја сам им био муж",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "А ово је савез који ћу склопити",
            "poem": 1
          },
          {
            "text": "с народом израиљским након тих дана:",
            "poem": 2
          },
          {
            "text": "ставићу свој Закон у њих саме,",
            "poem": 1
          },
          {
            "text": "и уписаћу га у њихова срца.",
            "poem": 2
          },
          {
            "text": "Ја ћу бити њихов Бог,",
            "poem": 1
          },
          {
            "text": "а они ће бити мој народ",
            "poem": 2
          },
          {
            "text": "– говори Господ!",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Тада нико неће поучавати свога суграђанина",
            "poem": 1
          },
          {
            "text": "или брата говорећи: ’Упознај Господа’,",
            "poem": 2
          },
          {
            "text": "јер ће ме познавати сви од малог до великог",
            "poem": 1
          },
          {
            "text": "– говори Господ.",
            "poem": 2
          },
          {
            "text": "Јер опростићу њихове кривице,",
            "poem": 1
          },
          {
            "text": "и нећу се сећати њихових греха.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "Овако каже Господ",
          {
            "text": "који даје сунце да светли дању,",
            "poem": 1
          },
          {
            "text": "одредбе месецу и звездама да светле ноћу;",
            "poem": 2
          },
          {
            "text": "који море узбурка и таласи му кључају",
            "poem": 1
          },
          {
            "text": "и коме је име Господ над војскама:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "„Ако би ове одредбе и нестале преда мном",
            "poem": 1
          },
          {
            "text": "– говори Господ –",
            "poem": 2
          },
          {
            "text": "престаће и Израиљево потомство",
            "poem": 1
          },
          {
            "text": "да буде народ преда мном довека.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "Овако каже Господ:",
          {
            "text": "„Када би могла да се премере небеса горња,",
            "poem": 1
          },
          {
            "text": "и када би могли да се истраже темељи земљини доњи,",
            "poem": 2
          },
          {
            "text": "тако бих и ја могао да одбацим све потомке Израиља",
            "poem": 1
          },
          {
            "text": "због свега онога што су учинили",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "Ево, долазе дани – говори Господ – када ће се обновити град за Господа, од Ананилове куле па до Угаоних врата."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "А уже за мерење ће се протегнути све до брда Гарив и назад према Гоаху."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "И сва долина лешева и пепела, сва поља долине Кидрон, до угла Коњских врата ка истоку биће света Господу. Град никад више и довека неће бити разваљиван и рушен.“"
        ]
      }
    ],
