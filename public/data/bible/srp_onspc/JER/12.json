  "chapter": {
    "number": 12,
    "content": [
      {
        "type": "heading",
        "content": [
          "Јеремијина тужбалица"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Праведан си, Господе,",
            "poem": 1
          },
          {
            "text": "кад год ти се тужим,",
            "poem": 2
          },
          {
            "text": "али ћу ипак да ти говорим о правди:",
            "poem": 1
          },
          {
            "text": "Зашто су напредни путеви покварењака?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Зашто ликују сви подли злотвори?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Ти си их посадио и већ се укоренише,",
            "poem": 1
          },
          {
            "text": "напредују и већ доносе плод.",
            "poem": 2
          },
          {
            "text": "Близу си њихових уста,",
            "poem": 1
          },
          {
            "text": "али далеко од нутрине њихове.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "А ти ме, Господе, познајеш,",
            "poem": 1
          },
          {
            "text": "видиш ме и испитујеш срце моје спрам тебе.",
            "poem": 2
          },
          {
            "text": "Потерај их ко овце на клање,",
            "poem": 1
          },
          {
            "text": "одвоји их за дан клања!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Докле ће земља да тугује,",
            "poem": 1
          },
          {
            "text": "да сахне растиње по свим пољима",
            "poem": 2
          },
          {
            "text": "од зла оних што ту пребивају?",
            "poem": 1
          },
          {
            "text": "Пропале су и животиње и птице",
            "poem": 2
          },
          {
            "text": "јер је народ рекао:",
            "poem": 1
          },
          {
            "text": "„Неће он да види наше скончање!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Божији одговор"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "„Ако си се уморио трчећи с пешацима,",
            "poem": 1
          },
          {
            "text": "како ли ћеш се тек огледати с коњима?",
            "poem": 2
          },
          {
            "text": "Када у спокојној земљи падаш,",
            "poem": 1
          },
          {
            "text": "шта ли ћеш да радиш на јорданском честару?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Јер и браћа твоја",
            "poem": 1
          },
          {
            "text": "и дом твога оца су те изневерили",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и на сав глас су викали за тобом.",
            "poem": 2
          },
          {
            "text": "Не веруј им",
            "poem": 1
          },
          {
            "text": "чак и када ти љубазно говоре.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Дом сам свој напустио",
            "poem": 1
          },
          {
            "text": "и своје наследство оставио.",
            "poem": 2
          },
          {
            "text": "Вољену сам своју предао",
            "poem": 1
          },
          {
            "text": "у руке њених непријатеља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "А сада је моје наследство",
            "poem": 1
          },
          {
            "text": "као лав у шуми",
            "poem": 2
          },
          {
            "text": "што на мене риком риче.",
            "poem": 1
          },
          {
            "text": "И зато га мрзим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Је л’ наследство моје",
            "poem": 1
          },
          {
            "text": "пиргава птица грабљивица?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Лешинари, сјатите се на њу свуд унаоколо!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Идите, сакупите све животиње на поље,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "доведите их на храну.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Многи су пастири изломили мој виноград",
            "poem": 1
          },
          {
            "text": "и изгазили мој део.",
            "poem": 2
          },
          {
            "text": "Претворили су мој мили део",
            "poem": 1
          },
          {
            "text": "у голу пустињу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Да, претворили су је у пустињу",
            "poem": 1
          },
          {
            "text": "и сада преда мном опустошена тугује.",
            "poem": 2
          },
          {
            "text": "У пустару је претворена земља",
            "poem": 1
          },
          {
            "text": "и то никога не потреса.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Преко пустињских оголелих висова",
            "poem": 1
          },
          {
            "text": "дошли су затирачи,",
            "poem": 2
          },
          {
            "text": "јер Господњи мач сатире",
            "poem": 1
          },
          {
            "text": "с краја на крај земље",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и нема мира ни за кога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Сејаће пшеницу, а трње ће жети.",
            "poem": 1
          },
          {
            "text": "Изнурише се, а никакве користи.",
            "poem": 2
          },
          {
            "text": "Стидите се својих урода",
            "poem": 1
          },
          {
            "text": "због Господњег пламтећег гнева!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Овако каже Господ свим мојим злим суседима који нападају земљу коју сам дао мом народу Израиљу у наследство: ево, почупаћу их из њихове земље, а из њихове ћу средине да ишчупам Јудин дом."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "А када их ишчупам, вратићу се да им се смилујем и доведем сваког на његово наследство и сваког на његову земљу."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "И ако се истински науче путевима мога народа, да се заклињу мојим именом – ’Тако нам живог Господа’ – онако како су они мој народ научили да се куну Валом, населиће се усред мог народа."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Али ако не послушају, ја ћу да ишчупам тај народ, да ишчупам и да затрем – говори Господ.“"
        ]
      }
    ],
