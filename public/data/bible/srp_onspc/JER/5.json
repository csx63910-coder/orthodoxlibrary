  "book": {
    "id": "JER",
    "translationId": "srp_onspc",
    "name": "Књига пророка Јеремије",
    "commonName": "Књига пророка Јеремије",
    "title": "Књига пророка Јеремије",
    "order": 24,
    "numberOfChapters": 52,
    "sha256": "b33f8d3e722cccfab7e8d8c2e353b57c81d901db98dd37cafca596c2cc88e2e2",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/JER/1.json",
    "lastChapterNumber": 52,
    "lastChapterApiLink": "/api/srp_onspc/JER/52.json",
    "totalNumberOfVerses": 1364
  },
  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "heading",
        "content": [
          "Нико није праведан"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "„Протрчите по трговима Јерусалима.",
            "poem": 1
          },
          {
            "text": "Гледајте, посматрајте,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "тражите по улицама:",
            "poem": 2
          },
          {
            "text": "да ли ћете пронаћи човека,",
            "poem": 1
          },
          {
            "text": "иједног који поступа по правди и који тежи верности,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "па да опростим граду.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "’Тако ми живог Господа!’, ако тако и говори народ,",
            "poem": 1
          },
          {
            "text": "заправо се лажно заклињу.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "О, Господе, не траже ли твоје очи верност?",
            "poem": 1
          },
          {
            "text": "Ти си их ударао, али нису попустили;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "докрајчио си их, али су одбили да прихвате карање.",
            "poem": 2
          },
          {
            "text": "Окаменили су своје образе да су тврђи него стена",
            "poem": 1
          },
          {
            "text": "и одбијају да се врате.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Ја сам рекао: „Баш су сиромаси,",
            "poem": 1
          },
          {
            "text": "и баш су лудо поступили",
            "poem": 2
          },
          {
            "text": "јер не познају Господњи пут",
            "poem": 1
          },
          {
            "text": "и прописе Бога свога.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "И себи сам рекао да ћу ићи великашима,",
            "poem": 1
          },
          {
            "text": "па ћу њима да говорим,",
            "poem": 2
          },
          {
            "text": "јер они познају Господњи пут и прописе Бога свога.“",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Али су и они сложно скршили јарам",
            "poem": 1
          },
          {
            "text": "и изломили окове.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Зато ће их напасти шумски лав,",
            "poem": 1
          },
          {
            "text": "пустињски вук ће их опустошити",
            "poem": 2
          },
          {
            "text": "и рис ће вребати код њихових градова.",
            "poem": 1
          },
          {
            "text": "И свако ко изађе од њих биће растргнут у комаде,",
            "poem": 2
          },
          {
            "text": "јер су многи њихови преступи",
            "poem": 1
          },
          {
            "text": "и бројна су њихова отпадништва.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "„И како ћу све то да ти опростим?",
            "poem": 1
          },
          {
            "text": "Твоја су ме деца оставила",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и заклела се лажним боговима.",
            "poem": 2
          },
          {
            "text": "Ја сам их наситио,",
            "poem": 1
          },
          {
            "text": "а они су учинили прељубу",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и журили у кућу блуднице.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Они су као угојени, једри ждрепци,",
            "poem": 1
          },
          {
            "text": "па сваки рже за женом свог ближњег.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Зар због тога да их не казним?",
            "poem": 1
          },
          {
            "text": "– говори Господ.",
            "poem": 2
          },
          {
            "text": "Над народом попут овог",
            "poem": 1
          },
          {
            "text": "зар да се не освети моја душа?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Идите међу редове његове лозе и искидајте их,",
            "poem": 1
          },
          {
            "text": "али не чините потпуно уништење.",
            "poem": 2
          },
          {
            "text": "Одстраните посечене лозице",
            "poem": 1
          },
          {
            "text": "јер не припадају Господу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Јер су ме сасвим изневерили",
            "poem": 1
          },
          {
            "text": "дом Израиљев и дом Јудин",
            "poem": 2
          },
          {
            "text": "– говори Господ.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Лагали су о Господу",
            "poem": 1
          },
          {
            "text": "јер су рекли: „Није он такав!",
            "poem": 2
          },
          {
            "text": "Неће нас да задесе ни зло ни мач,",
            "poem": 1
          },
          {
            "text": "а ни глади нећемо видети!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Пророци су постали попут ветра",
            "poem": 1
          },
          {
            "text": "јер реч није у њима,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "па нека им тако и буде учињено.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Зато говори Господ Бог над војскама:",
          {
            "text": "„Зато што су тако изјавили,",
            "poem": 1
          },
          {
            "text": "ево, моје ћу речи у твојим устима да претворим у ватру,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а овај народ у дрва, па ће их прогутати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ево, доводим на тебе народ издалека,",
            "poem": 1
          },
          {
            "text": "доме Израиљев – говори Господ.",
            "poem": 2
          },
          {
            "text": "То је крепак народ, древни народ,",
            "poem": 1
          },
          {
            "text": "народ чији језик не разумеш шта год да говоре.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Тоболац им је попут гроба отворен",
            "poem": 1
          },
          {
            "text": "и сви су ратници.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Прогутаће ти и летину и храну.",
            "poem": 1
          },
          {
            "text": "Прогутаће ти синове и ћерке.",
            "poem": 2
          },
          {
            "text": "Прогутаће ти стада и крда.",
            "poem": 1
          },
          {
            "text": "Прогутаће ти вино и смокве.",
            "poem": 2
          },
          {
            "text": "Разориће ти мачем утврђене градове",
            "poem": 1
          },
          {
            "text": "у које си се уздао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Али тих дана – говори Господ – нећу те сасвим сатрти."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Јер тада ћете упитати: ’Зашто нам чини све то Господ, наш Бог?’ А ти ћеш им одговорити: ’Као што сте напустили мене и служили туђим боговима у својој земљи, тако ћете сада да служите туђинцима у земљи која није ваша.’"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Најавите ово у дому Јаковљевом",
            "poem": 1
          },
          {
            "text": "и објавите у Јуди. Реците:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "’Чујте сад ово, луди и неразумни народе,",
            "poem": 1
          },
          {
            "text": "који има очи, а не види",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и који има уши, а не чује!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Зар се мене не бојите? – говори Господ.",
            "poem": 1
          },
          {
            "text": "Не дрхтите ли од мене",
            "poem": 2
          },
          {
            "text": "који сам вечном уредбом поставио песак за границу мору,",
            "poem": 1
          },
          {
            "text": "и оно га не прелази?",
            "poem": 2
          },
          {
            "text": "Ако се и усталаса,",
            "poem": 1
          },
          {
            "text": "оно се не излива;",
            "poem": 2
          },
          {
            "text": "таласи му хуче,",
            "poem": 1
          },
          {
            "text": "али се не преливају.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Али овај народ има срце пркосно и одметничко,",
            "poem": 1
          },
          {
            "text": "скренули су и удаљили се.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Нису рекли од срца:",
            "poem": 1
          },
          {
            "text": "’Сад се бојмо Господа, нашег Бога",
            "poem": 2
          },
          {
            "text": "који нам даје рану и позну кишу на време,",
            "poem": 1
          },
          {
            "text": "који нам чува седмице одређене за жетву.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Ваше су кривице све ово ускратиле",
            "poem": 1
          },
          {
            "text": "и ваши су греси задржали ово добро.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Јер се у мом народу налазе зликовци",
            "poem": 1
          },
          {
            "text": "што вребају као птичари из заседе,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "што постављају замке да хватају људе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "И као што је кавез пун птица,",
            "poem": 1
          },
          {
            "text": "тако су њихове куће пуне преваре.",
            "poem": 2
          },
          {
            "text": "Зато су постали силни и награбили су блага.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Угојени су и углађени.",
            "poem": 2
          },
          {
            "text": "Они претерују у злу, не маре за право сиротиње,",
            "poem": 1
          },
          {
            "text": "напредују, не суде за право сиромаха.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Зар због тога да их не казним?",
            "poem": 1
          },
          {
            "text": "– говори Господ.",
            "poem": 2
          },
          {
            "text": "Над народом попут овог",
            "poem": 1
          },
          {
            "text": "зар да се не освети моја душа?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Грозота и страхота",
            "poem": 1
          },
          {
            "text": "се догађају по земљи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Пророци пророкују лаж",
            "poem": 1
          },
          {
            "text": "и свештеници владају по своме,",
            "poem": 2
          },
          {
            "text": "а мој народ све то воли!",
            "poem": 1
          },
          {
            "text": "Али шта ћете на крају да радите?!",
            "poem": 2
          }
        ]
      }
    ],
