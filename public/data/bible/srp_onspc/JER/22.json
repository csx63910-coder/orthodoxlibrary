  "chapter": {
    "number": 22,
    "content": [
      {
        "type": "heading",
        "content": [
          "Суд над злим царевима Јуде"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Господ је овако рекао: „Сиђи до царевог двора у Јуди и тамо им објави ову реч."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Реци: ’Чуј Господњу реч, царе Јудин, што седиш на Давидовом престолу – ти, твоје слуге и твој народ што улази на ова врата!"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Овако каже Господ: поступајте право и праведно. Од тлачитеља избављајте покраденог. Дошљака, сироче и удовицу не злостављајте и не тлачите. Не проливајте крв невиних на овом месту!"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Јер ако ово будете предано радили, тада ће на врата двора овог улазити цареви који седе на престолу Давидовом, на бојним колима и на коњима – они, њихове слуге и њихов народ."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "А не будете ли послушали ове речи, собом се заклињем – говори Господ – овај ће двор постати пустош!’“"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Јер овако каже Господ за двор Јудиног цара:",
          {
            "text": "„Мени си ти као Галад и врх Ливана,",
            "poem": 1
          },
          {
            "text": "али ћу те стварно претворити у пустињу,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "у градове расељене.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Затирача спремам на тебе,",
            "poem": 1
          },
          {
            "text": "све до једног наоружаног!",
            "poem": 2
          },
          {
            "text": "Најбоље ће твоје кедрове посећи",
            "poem": 1
          },
          {
            "text": "и у ватру бацити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Многи ће народи пролазити поред овог града, па ће се међусобно питати: ’Зашто је Господ поступио овако са великим градом овим?’"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "И одговориће: ’Зато што су напустили савез Господа, Бога свога, па су се клањали другим боговима и служили су им.’“"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Не оплакујте мртвог и не жалите за њим!",
            "poem": 1
          },
          {
            "text": "Него горко јецајте за оним што одлази,",
            "poem": 2
          },
          {
            "text": "да се више не врати",
            "poem": 1
          },
          {
            "text": "и не види свој родни крај.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Овако каже Господ о Салуму",
          {
            "noteId": 10
          },
          ", сину Јудиног цара Јосије, постављеном на место свог оца Јосије и који је отишао из овог места: „Он се никада више неће вратити."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Тамо где су га одвели, у изгнанство, тамо ће и да умре. Ову земљу он никада више неће видети."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Тешко ономе што кућу неправедно кући,",
            "poem": 1
          },
          {
            "text": "и одаје горње, али не по правди;",
            "poem": 2
          },
          {
            "text": "коме сународник ради без накнаде",
            "poem": 1
          },
          {
            "text": "и који не даје трудбенику плату.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Јер тај каже: ’Сазидаћу себи кућу повелику",
            "poem": 1
          },
          {
            "text": "и простране горње собе.’",
            "poem": 2
          },
          {
            "text": "Отвориће за себе прозоре,",
            "poem": 1
          },
          {
            "text": "па кедром облаже и црвеним боји.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Зар ти владаш",
            "poem": 1
          },
          {
            "text": "да би се кедровином разметао?",
            "poem": 2
          },
          {
            "text": "Зар твој отац није и јео и пио,",
            "poem": 1
          },
          {
            "text": "зар није праведно и правично радио,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "па му је било добро?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Бранио је сиромаха и убогог.",
            "poem": 1
          },
          {
            "text": "И онда је било добро.",
            "poem": 2
          },
          {
            "text": "Не значи ли то познавати мене?",
            "poem": 1
          },
          {
            "text": "– говори Господ.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Али твоје очи и твоје срце",
            "poem": 1
          },
          {
            "text": "не теже ничем сем непоштеном добитку",
            "poem": 2
          },
          {
            "text": "и проливању крви невинога,",
            "poem": 1
          },
          {
            "text": "да би тлачио и изнуђивао.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Овако каже Господ о Јоакиму, сину Јудиног цара Јосије:",
          {
            "text": "„Неће за њим зажалити:",
            "poem": 1
          },
          {
            "text": "’Јао, брате мој! Јао, сестро!’",
            "poem": 2
          },
          {
            "text": "Неће за њим зажалити:",
            "poem": 1
          },
          {
            "text": "’Јао, господару! Јао његово величанство!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Сахраниће га као што магарца сахрањују.",
            "poem": 1
          },
          {
            "text": "Одвући ће га и бацити",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "подаље од врата Јерусалима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Попни се на Ливан и вичи!",
            "poem": 1
          },
          {
            "text": "На Васану гласом зајечи",
            "poem": 2
          },
          {
            "text": "и завичи са Аварима,",
            "poem": 1
          },
          {
            "text": "јер су сатрвени сви твоји љубавници.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "А ја сам ти говорио у твом благостању,",
            "poem": 1
          },
          {
            "text": "а ти си рекао: ’Нећу да слушам!’",
            "poem": 2
          },
          {
            "text": "И то ти је био пут још од младости твоје –",
            "poem": 1
          },
          {
            "text": "да не слушаш мој глас.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Свим твојим пастирима ветар пастир ће да буде,",
            "poem": 1
          },
          {
            "text": "а и твоји љубавници ће отићи у изгнанство.",
            "poem": 2
          },
          {
            "text": "А онда ћеш се баш застидети и понижен ћеш бити",
            "poem": 1
          },
          {
            "text": "због свих својих зала.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Ти што седиш на ’Ливану’,",
            "poem": 1
          },
          {
            "text": "угнежден у кедровину:",
            "poem": 2
          },
          {
            "text": "како ћеш стењати кад те спопадну трудови",
            "poem": 1
          },
          {
            "text": "и бол као породиљу!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Живота ми мога – говори Господ – све да Јехонија",
          {
            "noteId": 11
          },
          ", син Јудиног цара Јоакима, буде и печатни прстен на десној руци мојој, и оданде ћу те стргнути."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Предаћу те у руке онима који ти о глави раде, у руке оних од којих стрепиш, у руке вавилонског цара Навуходоносора и у руке Халдејаца."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Избацићу и тебе и мајку твоју која те родила у другу земљу, тамо где се нисте родили. И тамо ћете умрети."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "А у земљу у коју им душа жуди да се врати, вратити се неће.“"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Је ли крчаг презрен и полупан овај човек Јехонија?",
            "poem": 1
          },
          {
            "text": "Или је посуда коју нико неће?",
            "poem": 2
          },
          {
            "text": "Зашто су одбачени и он и његово потомство,",
            "poem": 1
          },
          {
            "text": "истерани у земљу која им је туђа?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "О, земљо! О, земљо!",
            "poem": 1
          },
          {
            "text": "О, земљо, чуј реч Господњу!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Овако каже Господ:",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Запиши: овај човек је као без порода",
            "poem": 1
          },
          {
            "text": "и неће напредовати за живота свога.",
            "poem": 2
          },
          {
            "text": "Неће напредовати нико од његових потомака,",
            "poem": 1
          },
          {
            "text": "нико неће седети на престолу Давидовом",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да би поново владао Јудом.",
            "poem": 2
          }
        ]
      }
    ],
