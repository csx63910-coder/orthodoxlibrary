  "book": {
    "id": "JER",
    "translationId": "srp_onspc",
    "name": "Књига пророка Јеремије",
    "commonName": "Књига пророка Јеремије",
    "title": "Књига пророка Јеремије",
    "order": 24,
    "numberOfChapters": 52,
    "sha256": "b33f8d3e722cccfab7e8d8c2e353b57c81d901db98dd37cafca596c2cc88e2e2",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/JER/1.json",
    "lastChapterNumber": 52,
    "lastChapterApiLink": "/api/srp_onspc/JER/52.json",
    "totalNumberOfVerses": 1364
  },
  "chapter": {
    "number": 17,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Јудин је грех записан гвозденим пером,",
            "poem": 1
          },
          {
            "text": "урезан дијамантским шиљком",
            "poem": 2
          },
          {
            "text": "на плочу њиховог срца",
            "poem": 1
          },
          {
            "text": "и на рогове ваших жртвеника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Деца њихова размишљају",
            "poem": 1
          },
          {
            "text": "о њиховим жртвеницима и Аштартиним ступовима,",
            "poem": 2
          },
          {
            "text": "под зеленим дрвећем",
            "poem": 1
          },
          {
            "text": "на високим брдима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "А ти што се пењеш на планину у пољу:",
            "poem": 1
          },
          {
            "text": "твоје добро и сва имања твоја",
            "poem": 2
          },
          {
            "text": "дајем као плен,",
            "poem": 1
          },
          {
            "text": "и твоје узвишице за грех",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "по свим твојим границама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "И ти сам ћеш да изгубиш наследство",
            "poem": 1
          },
          {
            "text": "које сам ти дао.",
            "poem": 2
          },
          {
            "text": "Учинићу да робујеш својим непријатељима",
            "poem": 1
          },
          {
            "text": "у земљи коју не знаш,",
            "poem": 2
          },
          {
            "text": "јер си запалио ватру мога гнева",
            "poem": 1
          },
          {
            "text": "и довека она букти.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Овако каже Господ:",
          {
            "text": "„Проклет је човек у човека што се узда,",
            "poem": 1
          },
          {
            "text": "снагу своју што у телу тражи,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а од Господа окреће срце своје!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Биће као грм у пустињи",
            "poem": 1
          },
          {
            "text": "што и не зна кад му добро дође.",
            "poem": 2
          },
          {
            "text": "Тавориће у безводној пустари,",
            "poem": 1
          },
          {
            "text": "у слатини где нико не живи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Благословен је човек што се узда у Господа",
            "poem": 1
          },
          {
            "text": "и коме је Господ узданица!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Он ће бити као дрво посађено поред вода,",
            "poem": 1
          },
          {
            "text": "што корење пружа ка живоме току.",
            "poem": 2
          },
          {
            "text": "Припека кад дође, оно се не боји;",
            "poem": 1
          },
          {
            "text": "лишће му зелено кроз годину целу.",
            "poem": 2
          },
          {
            "text": "Од суше не стрепи,",
            "poem": 1
          },
          {
            "text": "плода увек има.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Срце је варљиво више од свег другог.",
            "poem": 1
          },
          {
            "text": "Непоправљиво је,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и ко ће га знати!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Ја, Господ, испитујем срце,",
            "poem": 1
          },
          {
            "text": "нутрину проверавам;",
            "poem": 2
          },
          {
            "text": "па свакоме дајем по његовом путу,",
            "poem": 1
          },
          {
            "text": "а и према плоду од његових дела.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Као јаребица што се леже, али не излеже,",
            "poem": 1
          },
          {
            "text": "онај је што благо непоштено згрће:",
            "poem": 2
          },
          {
            "text": "на пола му живота блага више нема,",
            "poem": 1
          },
          {
            "text": "а он на своме крају испада будала.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Престо славе од давнина узвишен,",
            "poem": 1
          },
          {
            "text": "место је нашег Светилишта.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Надо Израиљева, Господе,",
            "poem": 1
          },
          {
            "text": "постидеће се сви који те оставе.",
            "poem": 2
          },
          {
            "text": "Они који су се окренули од мене у прашину биће уписани,",
            "poem": 1
          },
          {
            "text": "јер су оставили Господа,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "извор свежих вода.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Излечи ме, Господе, да будем излечен!",
            "poem": 1
          },
          {
            "text": "Спаси ме да и спасен будем,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер си ти моја слава!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Гле њих, говоре ми:",
            "poem": 1
          },
          {
            "text": "„Где је реч Господња?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Хајде, нек се збуде!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Ја се нисам устезао да ти пастир будем, да за тобом идем.",
            "poem": 1
          },
          {
            "text": "Прижељкивао ти нисам тај дан несносни.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "И ти знаш шта су моје усне рекле у присуству твоме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Не буди ми ти на ужас,",
            "poem": 1
          },
          {
            "text": "јер си моје уточиште у дану пропасти!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Нек се стиде моји гонитељи,",
            "poem": 1
          },
          {
            "text": "а не ја да се стидим.",
            "poem": 2
          },
          {
            "text": "Нека они буду заплашени,",
            "poem": 1
          },
          {
            "text": "а не ја да заплашен будем.",
            "poem": 2
          },
          {
            "text": "Сручи на њих дан пропасти",
            "poem": 1
          },
          {
            "text": "и сломи их двапут јачим сломом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Субота – посвећени дан"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Господ ми је овако рекао: „Иди и стани на Врата синова народа, кроз која улазе Јудини цареви и кроз која излазе, и на сва врата Јерусалима."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Реци им: ’Чујте реч Господњу, о, цареви Јудини и сва Јудо и сви становници Јерусалима који улазите кроз ова врата!"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Овако каже Господ: чувајте животе своје па не носите робу у суботу и не уносите је на јерусалимска врата."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Ни из својих кућа не износите робу у суботу и не радите никаквог посла. Посветите суботу као што сам заповедио вашим прецима."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Али они нису послушали и нису пригнули своје ухо. Тврдоглави су постали, нису слушали и нису прихватили карање."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Али, будете ли ме пажљиво слушали – говори Господ – и суботом не будете носили робу кроз градска врата, већ посветите суботу и не радите никакав посао:"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "тада ће на градска врата улазити цареви и кнезови, који седе на престолу Давидовом, на бојним колима и на коњима – они, њихови главари, сви Јудејци и сви становници Јерусалима. А град ће овај остати довека."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "И доћи ће из Јудиних градова, сви што су око Јерусалима, из Венијаминове земље, из равнице, са брда и из Негева они што доносе свеспалнице, жртве, житне жртве и тамјан, и они што доносе захвалнице у Дом Господњи."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Али ако ме не послушате – да посветите суботу, да не носите робу и пролазите кроз јерусалимска врата у суботу – запалићу ватру на његовим вратима да прогута дворове Јерусалима, и неће се угасити.’“"
        ]
      }
    ],
