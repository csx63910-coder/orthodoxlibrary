  },
  "chapter": {
    "number": 6,
    "content": [
      {
        "type": "heading",
        "content": [
          "Јерусалим под опсадом"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Бежи и склањај се из Јерусалима,",
            "poem": 1
          },
          {
            "text": "народе Венијаминов!",
            "poem": 2
          },
          {
            "text": "У Текуји затруби у трубу,",
            "poem": 1
          },
          {
            "text": "а у Вет-Керему ватром дајте знак,",
            "poem": 2
          },
          {
            "text": "јер се са севера надвија пропаст",
            "poem": 1
          },
          {
            "text": "и велико разарање.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Разорићу лепушкасту и размажену ћерку сионску!",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Њој долазе пастири са својим стадима,",
            "poem": 1
          },
          {
            "text": "око ње подижу шаторе",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и сваки ће да пасе по свом делу.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "„Позивајте на бој против ње!",
            "poem": 1
          },
          {
            "text": "Устанимо и кренимо на њих усред бела дана.",
            "poem": 2
          },
          {
            "text": "Јао нама! Дан измаче",
            "poem": 1
          },
          {
            "text": "и вечерње сенке су се издужиле.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Устанимо и кренимо",
            "poem": 1
          },
          {
            "text": "да јој по ноћи разоримо дворове!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Јер говори Господ над војскама:",
          {
            "text": "„Сеците стабла",
            "poem": 1
          },
          {
            "text": "и наспите бедем против Јерусалима.",
            "poem": 2
          },
          {
            "text": "Град ће тај да одговара",
            "poem": 1
          },
          {
            "text": "због тлачења што је свуд по њему.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Као што бунар чува хладну воду",
            "poem": 1
          },
          {
            "text": "тако и он чува зло своје.",
            "poem": 2
          },
          {
            "text": "Насиље и пустош се чују у њему,",
            "poem": 1
          },
          {
            "text": "а преда мном стално болест су и ране.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Поучи се, Јерусалиме,",
            "poem": 1
          },
          {
            "text": "да се не би од тебе одвојила моја душа,",
            "poem": 2
          },
          {
            "text": "да те не бих претворио у опустошену земљу",
            "poem": 1
          },
          {
            "text": "у којој нико не борави.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Говори Господ над војскама:",
          {
            "text": "„Темељно ће као лозу попабирчити",
            "poem": 1
          },
          {
            "text": "остатак Израиљев.",
            "poem": 2
          },
          {
            "text": "Врати своју руку",
            "poem": 1
          },
          {
            "text": "као берач грожђа над младицу.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Коме да говорим, да упозоравам,",
            "poem": 1
          },
          {
            "text": "а да чују?",
            "poem": 2
          },
          {
            "text": "Ево, необрезано им је ухо",
            "poem": 1
          },
          {
            "text": "и не могу да са пажњом чују.",
            "poem": 2
          },
          {
            "text": "Ево, Господња се реч за њих претворила у ругло",
            "poem": 1
          },
          {
            "text": "и у њој не уживају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Пун сам гнева Господњег,",
            "poem": 1
          },
          {
            "text": "изнурило ме је да га задржавам.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Излиј га по деци на улици",
            "poem": 1
          },
          {
            "text": "и на скуп младића.",
            "poem": 2
          },
          {
            "text": "И мужа и жену ће захватити,",
            "poem": 1
          },
          {
            "text": "и старе и времените.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Њихове ће се куће предати другима,",
            "poem": 1
          },
          {
            "text": "баш као и поља и жене,",
            "poem": 2
          },
          {
            "text": "јер ја ћу подићи своју руку",
            "poem": 1
          },
          {
            "text": "на становнике земље",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Баш сви, од малог па до великог међу њима",
            "poem": 1
          },
          {
            "text": "грабе непоштени добитак.",
            "poem": 2
          },
          {
            "text": "Од пророка па до свештеника,",
            "poem": 1
          },
          {
            "text": "баш сви варају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Они мом народу",
            "poem": 1
          },
          {
            "text": "олако лече прелом причајући:",
            "poem": 2
          },
          {
            "text": "’Мир! Мир!’",
            "poem": 1
          },
          {
            "text": "А нема мира.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Јесу ли се застидели зато што су учинили гадост?",
            "poem": 1
          },
          {
            "text": "Баш се нимало нису застидели",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и не знају за стид.",
            "poem": 2
          },
          {
            "text": "Зато ће пасти међу оне што падају",
            "poem": 1
          },
          {
            "text": "и у часу када их казним биће саплетени",
            "poem": 2
          },
          {
            "text": "– говори Господ.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Овако каже Господ:",
          {
            "text": "„Станите на путеве, гледајте",
            "poem": 1
          },
          {
            "text": "и питајте за стазе од давнина.",
            "poem": 2
          },
          {
            "text": "Па који је пут добар, идите њиме,",
            "poem": 1
          },
          {
            "text": "и нађите спокој својим душама.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Али они рекоше: ’Нећемо да идемо!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Стражаре сам поставио над вама:",
            "poem": 1
          },
          {
            "text": "’Пазите на звук трубе!’",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Али су ми они рекли: ’Нећемо да пазимо!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Зато слушајте, народи,",
            "poem": 1
          },
          {
            "text": "и познај, заједницо, шта је с њима:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Послушај земљо!",
            "poem": 1
          },
          {
            "text": "Ево доносим пропаст на овај народ,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "плод самих њихових сплетки.",
            "poem": 2
          },
          {
            "text": "Јер за моје речи нису марили",
            "poem": 1
          },
          {
            "text": "и мој су Закон презрели.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Шта ће мени тамјан што долази из Саве",
            "poem": 1
          },
          {
            "text": "и цимет из далеке земље?",
            "poem": 2
          },
          {
            "text": "Не прихватам ваше свеспалнице.",
            "poem": 1
          },
          {
            "text": "И у осталим жртвама не уживам.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "И зато каже Господ:",
          {
            "text": "„Ево, даћу овом народу камење спотицања,",
            "poem": 1
          },
          {
            "text": "па ће се спотицати о њих.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Настрадаће и очеви и синови, сусед и његов пријатељ.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Ево како говори Господ:",
          {
            "text": "„Гле, народ долази",
            "poem": 1
          },
          {
            "text": "из северне земље!",
            "poem": 2
          },
          {
            "text": "Велики ће народ бити подигнут",
            "poem": 1
          },
          {
            "text": "из најдаљих земљиних крајева.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Они држе лук и копље.",
            "poem": 1
          },
          {
            "text": "Окрутни су и немилосрдни,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а глас им хучи као море.",
            "poem": 2
          },
          {
            "text": "Јашу коње спремни као ратник",
            "poem": 1
          },
          {
            "text": "против тебе, ћерко сионска.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Чули смо о њима глас",
            "poem": 1
          },
          {
            "text": "и руке су нам клонуле,",
            "poem": 2
          },
          {
            "text": "обузели су нас зебња",
            "poem": 1
          },
          {
            "text": "и бол као породиљу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Не излази у поље",
            "poem": 1
          },
          {
            "text": "и не иди путем,",
            "poem": 2
          },
          {
            "text": "јер је ужас одасвуд",
            "poem": 1
          },
          {
            "text": "и мач непријатељев.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Ћерко мог народа, опаши кострет",
            "poem": 1
          },
          {
            "text": "и ваљај се у пепелу.",
            "poem": 2
          },
          {
            "text": "Жали као за јединцем, горко плачи",
            "poem": 1
          },
          {
            "text": "јер ће ненадано доћи на нас затирач.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "„Поставио сам те као испитивача метала међу мој народ,",
            "poem": 1
          },
          {
            "text": "као утврђење, да испиташ",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и опробаш њихов пут.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Сви су они најгори одметници,",
            "poem": 1
          },
          {
            "text": "иду па клевећу.",
            "poem": 2
          },
          {
            "text": "Они су од бронзе и гвожђа,",
            "poem": 1
          },
          {
            "text": "сви су затирачи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Мехови се запалише од врелине",
            "poem": 1
          },
          {
            "text": "и ватра је спалила олово.",
            "poem": 2
          },
          {
            "text": "Залуд неко претапа и кали,",
            "poem": 1
          },
          {
            "text": "јер зликовце не може да одвоји.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "’Сребро одбачено’, зваће се,",
            "poem": 1
          },
          {
            "text": "јер их је Господ одбацио.“",
            "poem": 2
          }
        ]
      }
    ],
