  "chapter": {
    "number": 13,
    "content": [
      {
        "type": "heading",
        "content": [
          "Ланени појас"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Овако ми је Господ рекао: „Иди и купи себи ланени појас и припаши бедра, али га не потапај у воду.“"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Купио сам појас како ми је Господ казао и припасао бедра."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Опет ми је дошла реч од Господа и рекла ми:"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "„Узми појас што си га купио, што ти је на бедрима. Устани и иди на Еуфрат",
          {
            "noteId": 6
          },
          "па га тамо сакриј у раселину стене.“"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "И ја сам отишао на Еуфрат и сакрио појас како ми је заповедио Господ."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "А када је прошло много дана Господ ми је рекао: „Устани и иди на Еуфрат. Узми оданде појас за који сам ти заповедио да га тамо сакријеш.“"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "И ја сам отишао на Еуфрат, копао и узео појас где сам га био сакрио. И гле – он сав труо и ни за шта ваљан."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Тада ми је дошла Господња реч и рекла ми:"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "„Овако каже Господ: ’Учинићу да овако иструли Јудин понос и велики понос Јерусалима!"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Тај народ покварени, што одбија да чује моје речи, што живи по самовољи свог срца, што следи друге богове, служи им и клања им се, биће као овај појас што ни за шта није ваљан."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Јер као што појас пријања за човекова бедра, тако сам привио к себи сав дом Израиљев и сав дом Јудин – говори Господ – да ми буду народ и име, слава и част. Али нису послушали.’"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Винске мешине"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "А ти им реци ову поруку: ’Овако каже Господ, Бог Израиљев: свака се мешина пуни вином’, а они ће да ти приговарају: ’Па зар ми не знамо да се свака мешина пуни вином?’"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "А ти им узврати: ’Овако каже Господ: ево, ја ћу пијанством да испуним све становнике ове земље, и цареве који седе на Давидовом престолу, и свештенике и пророке, и све становнике Јерусалима!"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Полупаћу их једне о друге, и родитеље и децу такође – говори Господ. Нећу се сажалити, нећу се смиловати и нећу их поштедети него ћу их уништити!’“"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Заробљеништво прети"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Чујте и послушајте.",
            "poem": 1
          },
          {
            "text": "Не будите охоли",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер је Господ проговорио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Господу Богу своме дајте славу",
            "poem": 1
          },
          {
            "text": "пре него он таму донесе,",
            "poem": 2
          },
          {
            "text": "и пре него вам се у сумрак",
            "poem": 1
          },
          {
            "text": "ноге спотакну о горе.",
            "poem": 2
          },
          {
            "text": "А ви ћете чекати светлост",
            "poem": 1
          },
          {
            "text": "коју ће он да претвори у смртну таму,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "у густу таму претвориће је.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "А ако не послушате,",
            "poem": 1
          },
          {
            "text": "плакаћу на скривеном месту,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "због охолости ћу горко јецати",
            "poem": 2
          },
          {
            "text": "и ронити сузе,",
            "poem": 1
          },
          {
            "text": "јер је поробљено стадо Господње.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "„Реците цару и царици мајци:",
            "poem": 1
          },
          {
            "text": "’Понизно сиђите с престола!",
            "poem": 2
          },
          {
            "text": "Пашће с глава ваших",
            "poem": 1
          },
          {
            "text": "круна вашег величанства.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Градови Негева биће затворени,",
            "poem": 1
          },
          {
            "text": "а никог нема да их отвори.",
            "poem": 2
          },
          {
            "text": "Јуда је одведена у изгнанство,",
            "poem": 1
          },
          {
            "text": "баш сва је одведена у изгнанство.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Подигните очи и погледајте",
            "poem": 1
          },
          {
            "text": "оне што са севера долазе.",
            "poem": 2
          },
          {
            "text": "А где је стадо које ти је дано,",
            "poem": 1
          },
          {
            "text": "овце твоје части?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Шта ћеш рећи кад над тобом за главара постави",
            "poem": 1
          },
          {
            "text": "оне које си ти сам обучавао, савезнике твоје?",
            "poem": 2
          },
          {
            "text": "Неће ли те спопасти трудови",
            "poem": 1
          },
          {
            "text": "као породиљу?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "У срцу ћеш свом питати:",
            "poem": 1
          },
          {
            "text": "’Зашто ме је ово задесило?’",
            "poem": 2
          },
          {
            "text": "У твојим великим кривицама",
            "poem": 1
          },
          {
            "text": "разгрнути су ти скутови",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и напаствована си!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Да ли може Кушанин кожу своју да промени",
            "poem": 1
          },
          {
            "text": "и рис шаре своје?",
            "poem": 2
          },
          {
            "text": "И ви бисте онда могли добро да чините;",
            "poem": 1
          },
          {
            "text": "ви, што зло сте научили!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Зато ћу их расејати,",
            "poem": 1
          },
          {
            "text": "као слама одлетеће са пустињским ветром.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "То је твоја коб,",
            "poem": 1
          },
          {
            "text": "од мене ти мера измерена –",
            "poem": 2
          },
          {
            "text": "говори Господ –",
            "poem": 3
          },
          {
            "text": "јер си ме заборавио",
            "poem": 1
          },
          {
            "text": "и поуздао се у лаж.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Сада ћу ти ја задигнути скутове преко лица,",
            "poem": 1
          },
          {
            "text": "па ће бити изложена твоја срамота;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "твоје прељубе, твоје гадости,",
            "poem": 1
          },
          {
            "text": "изопаченост твог блудничења по горама.",
            "poem": 2
          },
          {
            "text": "Видео сам и твоје гадости по пољу.",
            "poem": 1
          },
          {
            "text": "Јао теби, о, Јерусалиме!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Колико још ћеш бити нечист?!“",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 6,
        "caller": "+",
        "text": "13,4 Могуће је да се ради о реци Перат – удаљеној свега 5 km од Јеремијиног дома – која симболизује Еуфрат удаљен око 1.100 km.",
