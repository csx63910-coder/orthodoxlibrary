  },
  "chapter": {
    "number": 51,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Овако каже Господ:",
          {
            "text": "„Ево, подижем на Вавилон и на становнике Лев-Камаја",
            "poem": 1
          },
          {
            "noteId": 31
          },
          {
            "text": "ветар што разара.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "На Вавилон шаљем туђинце да их развеју,",
            "poem": 1
          },
          {
            "text": "да опустоше њихову земљу.",
            "poem": 2
          },
          {
            "text": "Напашће их са свих страна",
            "poem": 1
          },
          {
            "text": "на дан пропасти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Нека стрелац лук свој не запиње,",
            "poem": 1
          },
          {
            "text": "нека се не шепури у оклопу своме.",
            "poem": 2
          },
          {
            "text": "Не штедите његове младиће,",
            "poem": 1
          },
          {
            "text": "изручите клетом уништењу сву војску његову.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Попадаће побијени у земљи халдејској",
            "poem": 1
          },
          {
            "text": "и прободени по његовим улицама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Израиљ и Јуда нису удовица заборављена",
            "poem": 1
          },
          {
            "text": "од њиховог Бога, Господа над војскама,",
            "poem": 2
          },
          {
            "text": "макар је њихова",
            "poem": 1
          },
          {
            "noteId": 32
          },
          {
            "text": "земља пуна греха",
            "poem": 1
          },
          {
            "text": "пред Свецем Израиљевим.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Бежите из Вавилона!",
            "poem": 1
          },
          {
            "text": "Свако живу главу нек спасава",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да не настрадате у његовој кривици.",
            "poem": 2
          },
          {
            "text": "Јер је време Господње освете.",
            "poem": 1
          },
          {
            "text": "Он узвраћа, он ће да му наплати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Чаша златна је Вавилон био у Господњој руци,",
            "poem": 1
          },
          {
            "text": "сву је земљу опијао.",
            "poem": 2
          },
          {
            "text": "Од њеног вина су се напили народи",
            "poem": 1
          },
          {
            "text": "и зато су се понели лудо народи ти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "И одједном је пао Вавилон и разбио се.",
            "poem": 1
          },
          {
            "text": "Кукајте над њим!",
            "poem": 2
          },
          {
            "text": "Донесите мелем за његову бол,",
            "poem": 1
          },
          {
            "text": "можда и оздрави.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Лечили смо ми Вавилон,",
            "poem": 1
          },
          {
            "text": "али није оздравио.",
            "poem": 2
          },
          {
            "text": "Оставите га! Свако својој земљи нека иде,",
            "poem": 1
          },
          {
            "text": "јер до неба је доспео његов суд,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "до облака се уздигао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "А Господ је за нас праведна дела учинио.",
            "poem": 1
          },
          {
            "text": "Дођите, објавимо на Сиону",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "дело Господа, нашег Бога!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Стреле наоштрите!",
            "poem": 1
          },
          {
            "text": "Штитове подигните!",
            "poem": 2
          },
          {
            "text": "На Вавилон је Господ подигао дух мидијских царева",
            "poem": 1
          },
          {
            "text": "јер хоће да га разори,",
            "poem": 2
          },
          {
            "text": "јер је Господња освета,",
            "poem": 1
          },
          {
            "text": "одмазда за његов Дом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Подигните заставу против зидина Вавилона!",
            "poem": 1
          },
          {
            "text": "Ојачајте стражу,",
            "poem": 2
          },
          {
            "text": "поставите стражаре,",
            "poem": 1
          },
          {
            "text": "спремите заседе.",
            "poem": 2
          },
          {
            "text": "Оно што је Господ наумио, то је и урадио,",
            "poem": 1
          },
          {
            "text": "баш како је најавио становницима Вавилона.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "О, ти што живиш крај многих вода",
            "poem": 1
          },
          {
            "text": "и обилујеш богатством,",
            "poem": 2
          },
          {
            "text": "крај ти је дошао",
            "poem": 1
          },
          {
            "text": "и твој је добитак престао!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Господ над војскама се собом заклео:",
            "poem": 1
          },
          {
            "text": "„Испунићу те људима као скакавцима",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да на тебе победнички кличу.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Он је силом својом начинио земљу.",
            "poem": 1
          },
          {
            "text": "Мудрошћу својом он је основао васељену",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и својом је разборитошћу разапео небеса.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Глас он када пусти, воде хуче на небесима.",
            "poem": 1
          },
          {
            "text": "Он подиже облаке с краја земље,",
            "poem": 2
          },
          {
            "text": "киши муње даје",
            "poem": 1
          },
          {
            "text": "и изводи ветар из својих ризница.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Баш је од свог знања глуп сваки човек.",
            "poem": 1
          },
          {
            "text": "Због идола се сваки златар стиди",
            "poem": 2
          },
          {
            "text": "јер су обмана његови ливени идоли.",
            "poem": 1
          },
          {
            "text": "Нема даха у њима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Они су испразни, творевине ругла.",
            "poem": 1
          },
          {
            "text": "Пропашће кад дође време за њихову казну.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Не следе Јакову такви као ови.",
            "poem": 1
          },
          {
            "text": "Јер он је тај који је све начинио.",
            "poem": 2
          },
          {
            "text": "Племе је његово наследство,",
            "poem": 1
          },
          {
            "text": "а он се зове Господ над војскама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "„Ти си ми маљ,",
            "poem": 1
          },
          {
            "text": "ратно оружје;",
            "poem": 2
          },
          {
            "text": "тобом разбијам народе",
            "poem": 1
          },
          {
            "text": "и царства тобом сатирем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Тобом разбијам и коња и његовог јахача;",
            "poem": 1
          },
          {
            "text": "тобом разбијам кола и њиховог возача.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Тобом разбијам мушкарца и жену;",
            "poem": 1
          },
          {
            "text": "тобом разбијам старца и дете;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "тобом разбијам младића и девојку.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Тобом разбијам пастира и стадо његово;",
            "poem": 1
          },
          {
            "text": "тобом разбијам ратара и његову запрегу;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "тобом разбијам господара и достојанственика.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Наплатићу Вавилону и свим становницима Халдеје све њихове опачине које су починили на Сиону вама наочиглед – говори Господ."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Ево ме на тебе, горо што сатиреш",
            "poem": 1
          },
          {
            "text": "– говори Господ –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "која сатиреш сву земљу.",
            "poem": 2
          },
          {
            "text": "На тебе ћу руку своју да испружим,",
            "poem": 1
          },
          {
            "text": "да те сваљам са литице",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и од тебе да направим гору сагорелу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Од тебе неће узимати ни угаони камен,",
            "poem": 1
          },
          {
            "text": "ни камен темељац,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер ћеш бити пустош довека",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Подигните заставу у земљи!",
            "poem": 1
          },
          {
            "text": "Дувајте у трубе међу народима!",
            "poem": 2
          },
          {
            "text": "Спремите против њега народе,",
            "poem": 1
          },
          {
            "text": "окупите на њега царства Арарата,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Миније и Асхенаса.",
            "poem": 2
          },
          {
            "text": "Постројте на њега војсковођу,",
            "poem": 1
          },
          {
            "text": "доведите коње чекињасте као скакавци.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Спремите на њега народе",
            "poem": 1
          },
          {
            "text": "и мидијске цареве,",
            "poem": 2
          },
          {
            "text": "њихове господаре, све њихове главаре",
            "poem": 1
          },
          {
            "text": "и сваку земљу њихове владавине.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "И земља ће се трести и увијати,",
            "poem": 1
          },
          {
            "text": "јер се на Вавилону испуњавају Господње намере,",
            "poem": 2
          },
          {
            "text": "да земљу вавилонску претвори",
            "poem": 1
          },
          {
            "text": "у пустош ненасељену.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Престали су да се боре ратници Вавилона,",
            "poem": 1
          },
          {
            "text": "остали су у утврђењима",
            "poem": 2
          },
          {
            "text": "и пресахнула им је снага.",
            "poem": 1
          },
          {
            "text": "Постали су као жене!",
            "poem": 2
          },
          {
            "text": "Домове су им спалили,",
            "poem": 1
          },
          {
            "text": "а врата поломили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Стиже гласник за гласником,",
            "poem": 1
          },
          {
            "text": "трчи весник за весником,",
            "poem": 2
          },
          {
            "text": "јавља цару Вавилона:",
            "poem": 1
          },
          {
            "text": "град су његов сасвим освојили;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "газове су опколили,",
            "poem": 1
          },
          {
            "text": "ритове су ватром попалили",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и све ратнике преплашили.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "Јер овако каже Господ над војскама, Бог Израиља:",
          {
            "text": "„Ћерка вавилонска ће бити као гумно",
            "poem": 1
          },
          {
            "text": "коме је време да се омлати.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Још мало и за њу ће доћи време жетве.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "„Мене је Навуходоносор, цар Вавилона,",
            "poem": 1
          },
          {
            "text": "и прождрао и помео.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Изложио ме је као посуду празну,",
            "poem": 2
          },
          {
            "text": "прождрао ме као морска неман.",
            "poem": 1
          },
          {
            "text": "Мојим је добрима напунио",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "трбушину своју, а мене је ојадио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Нека на Вавилон дође насиље учињено нада мном и мојом родбином",
            "poem": 1
          },
          {
            "text": "– рећи ће становница Сиона.",
            "poem": 2
          },
          {
            "text": "И моја крв на становнике Халдеје",
            "poem": 1
          },
          {
            "text": "– рећи ће Јерусалим.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "Зато овако каже Господ:",
          {
            "text": "„Бранићу те у парници твојој.",
            "poem": 1
          },
          {
            "text": "Осветићу те!",
            "poem": 2
          },
          {
            "text": "Пресушићу море његово",
            "poem": 1
          },
          {
            "text": "и извор му исушити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Вавилон ће постати гомила камења",
            "poem": 1
          },
          {
            "text": "и брлог шакала,",
            "poem": 2
          },
          {
            "text": "ругло и пустош",
            "poem": 1
          },
          {
            "text": "у којој нико не живи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "Заједно ће рикати као млади лавови,",
            "poem": 1
          },
          {
            "text": "режаће као лавићи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          {
            "text": "А када се раздраже",
            "poem": 1
          },
          {
            "text": "даћу им њихове гозбе",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и напићу их;",
            "poem": 2
          },
          {
            "text": "па нека славе",
            "poem": 1
          },
          {
            "text": "и спавају довека, нека се не буде",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          {
            "text": "Одвешћу их",
            "poem": 1
          },
          {
            "text": "као јагњад на клање",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и као овнове и јарце.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          {
            "text": "Како је поробљен Сисак",
            "poem": 1
          },
          {
            "noteId": 33
          },
          {
            "text": "и ухваћена слава све земље!",
            "poem": 2
          },
          {
            "text": "Како је Вавилон постао",
            "poem": 1
          },
          {
            "text": "ругло међу народима!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          {
            "text": "Море се дигло хуком таласа својих на Вавилон.",
            "poem": 1
          },
          {
            "text": "Прекрило га је!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          {
            "text": "Његови су градови постали пустош,",
            "poem": 1
          },
          {
            "text": "земља осушена,",
            "poem": 2
          },
          {
            "text": "пустара без икога у њима.",
            "poem": 1
          },
          {
            "text": "Тамо неће бити потомака људи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          {
            "text": "Казнићу Вила у Вавилону,",
            "poem": 1
          },
          {
            "text": "из уста ћу да му отмем оно што је прогутао.",
            "poem": 2
          },
          {
            "text": "Неће му поново хрлити народи,",
            "poem": 1
          },
          {
            "text": "а и зидине ће вавилонске пасти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          {
            "text": "Изађите из средине његове, о, народе мој!",
            "poem": 1
          },
          {
            "text": "Свако нека спасава главу",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "од распламтелог гнева Господњег.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          {
            "text": "Да вам не клоне срце,",
            "poem": 1
          },
          {
            "text": "не плашите се гласа што се чује по земљи.",
            "poem": 2
          },
          {
            "text": "Јер ће једне године стићи један глас,",
            "poem": 1
          },
          {
            "text": "па друге године други глас.",
            "poem": 2
          },
          {
            "text": "А у земљи ће бити насиље",
            "poem": 1
          },
          {
            "text": "и бориће се владар са владаром.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          {
            "text": "Зато, ево, долазе дани",
            "poem": 1
          },
          {
            "text": "када ћу да казним идоле Вавилона;",
            "poem": 2
          },
          {
            "text": "сва ће његова земља бити посрамљена,",
            "poem": 1
          },
          {
            "text": "а сви његови побијени ће падати усред њега.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          {
            "text": "Клицаће небеса и земља",
            "poem": 1
          },
          {
            "text": "и све у њима над Вавилоном,",
            "poem": 2
          },
          {
            "text": "јер са севера долазе затирачи",
            "poem": 1
          },
          {
            "text": "– говори Господ.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          {
            "text": "Вавилон ће пасти због побијених Израиљаца",
            "poem": 1
          },
          {
            "text": "као што су због Вавилона",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "падали побијени целе земље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          {
            "text": "Идите ви, који сте побегли од мача,",
            "poem": 1
          },
          {
            "text": "не остајте!",
            "poem": 2
          },
          {
            "text": "Сетите се Господа тамо далеко,",
            "poem": 1
          },
          {
            "text": "и Јерусалим у срцу носите.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 51,
        "content": [
          {
            "text": "Осрамоћени смо,",
            "poem": 1
          },
          {
            "text": "јер смо чули за ругло.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Лица нам је покрила срамота,",
            "poem": 2
          },
          {
            "text": "јер су туђинци дошли",
            "poem": 1
          },
          {
            "text": "у Светилишта Господњег Дома.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 52,
        "content": [
          {
            "text": "„Зато, ево, долазе дани – говори Господ –",
            "poem": 1
          },
          {
            "text": "казнићу његове идоле",
            "poem": 2
          },
          {
            "text": "и по свој земљи својој",
            "poem": 1
          },
          {
            "text": "роптаће на самрти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 53,
        "content": [
          {
            "text": "У небеса нека се Вавилон дигне,",
            "poem": 1
          },
          {
            "text": "нека се утврди у висини у свој сили својој,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "али ја шаљем затираче на њега",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 54,
        "content": [
          {
            "text": "Чујте вапај из Вавилона!",
            "poem": 1
          },
          {
            "text": "Разарање велико из земље халдејске!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 55,
        "content": [
          {
            "text": "Јер Господ сатире Вавилон,",
            "poem": 1
          },
          {
            "text": "вреву његову ућуткује.",
            "poem": 2
          },
          {
            "text": "И бучаће његови таласи као многе воде,",
            "poem": 1
          },
          {
            "text": "галамиће гласови њихови.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 56,
        "content": [
          {
            "text": "Затирач долази на Вавилон.",
            "poem": 1
          },
          {
            "text": "Поробиће његове ратнике,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "поломиће лукове њихове,",
            "poem": 2
          },
          {
            "text": "јер Господ је Бог који плаћа",
            "poem": 1
          },
          {
            "text": "и сигурно истом мером враћа.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 57,
        "content": [
          {
            "text": "Опићу његове главаре и мудраце његове,",
            "poem": 1
          },
          {
            "text": "његове господаре, достојанственике његове и његове ратнике.",
            "poem": 2
          },
          {
            "text": "И заспаће довека и будити се неће –",
            "poem": 1
          },
          {
            "text": "говори Цар,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Господ над војскама му је име.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 58,
        "content": [
          "Овако каже Господ над војскама:",
          {
            "text": "„Широке зидине Вавилона ће срушити,",
            "poem": 1
          },
          {
            "text": "а врата његова висока ће ватром спалити.",
            "poem": 2
          },
          {
            "text": "Народи су радили узалуд,",
            "poem": 1
          },
          {
            "text": "људи су за ватру ринтали.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 59,
        "content": [
          "Ово је налог који је пророк Јеремија издао Сораји, Ниријином сину и Масијином унуку, када је са Јудиним царем Седекијом отишао у Вавилон, четврте године његове владавине. А Сораја је био главни коморник."
        ]
      },
      {
        "type": "verse",
        "number": 60,
        "content": [
          "Наиме, Јеремија му је у једну књигу записао све зло које ће стићи Вавилон, баш све ове поруке које су записане о Вавилону."
        ]
      },
      {
        "type": "verse",
        "number": 61,
        "content": [
          "А онда је Јеремија рекао Сораји: „Чим дођеш у Вавилон пази да наглас прочиташ све ове речи."
        ]
      },
      {
        "type": "verse",
        "number": 62,
        "content": [
          "Реци: ’О, Господе! Ти си објавио да ћеш разорити ово место, да у њему не остане потомака људи ни стоке, већ да буде пустош довека.’"
        ]
      },
      {
        "type": "verse",
        "number": 63,
        "content": [
          "И када завршиш са читањем, вежи ову књигу за камен и баци је посред Еуфрата."
        ]
      },
      {
        "type": "verse",
        "number": 64,
        "content": [
          "А онда реци: ’Овако ће Вавилон да потоне и неће се дићи, због зла које доносим на њега! Малаксаће!’“ Овде се завршавају Јеремијине поруке."
        ]
      }
    ],
