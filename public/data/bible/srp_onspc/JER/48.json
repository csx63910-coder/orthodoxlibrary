  "chapter": {
    "number": 48,
    "content": [
      {
        "type": "heading",
        "content": [
          "Порука Моаву"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Овако каже Моаву, Господ над војскама, Бог Израиља:",
          {
            "text": "„Јао Нававу, јер ће се опустошити!",
            "poem": 1
          },
          {
            "text": "Киријатајим ће се посрамити и поробити;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "посрамиће се утврђење и развалити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Неће се више Моав дичити",
            "poem": 1
          },
          {
            "text": "јер му зло спремају у Есевону:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "’Хајде да га истребимо као народ.’",
            "poem": 2
          },
          {
            "text": "А и ти, Мадмане, ћеш ућутати,",
            "poem": 1
          },
          {
            "text": "јер мач на тебе креће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Чује се врисак из Оронајима.",
            "poem": 1
          },
          {
            "text": "Пустошење, разарање велико!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Моав је сломљен",
            "poem": 1
          },
          {
            "text": "и чује се плач његове нејачи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "На успону луитском",
            "poem": 1
          },
          {
            "text": "пењаће се непрестано плачући,",
            "poem": 2
          },
          {
            "text": "и слушаће вапај разарања",
            "poem": 1
          },
          {
            "text": "на падини Оронајима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Бежите! Животе спасавајте",
            "poem": 1
          },
          {
            "text": "и будите ко грм смреке у пустињи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Зато што се поуздајеш у своја дела",
            "poem": 1
          },
          {
            "text": "и у благо своје, и ти ћеш бити поробљен.",
            "poem": 2
          },
          {
            "text": "И Хамос",
            "poem": 1
          },
          {
            "noteId": 27
          },
          {
            "text": "ће отићи у ропство,",
            "poem": 1
          },
          {
            "text": "његови свештеници и његови главари заједно.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Затирач ће проћи од града до града",
            "poem": 1
          },
          {
            "text": "и ниједан неће измаћи.",
            "poem": 2
          },
          {
            "text": "Пропашће долина",
            "poem": 1
          },
          {
            "text": "и висораван ће бити уништена",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "како је казао Господ.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Дајте крила Моаву да полети,",
            "poem": 1
          },
          {
            "text": "да оде из својих градова",
            "poem": 2
          },
          {
            "text": "што ће постати рушевине",
            "poem": 1
          },
          {
            "text": "без становника у њима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Проклет свако ко немарно ради Господњи посао!",
            "poem": 1
          },
          {
            "text": "Проклет онај што од крви мач свој устеже!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Спокојан и сигуран је био Моав",
            "poem": 1
          },
          {
            "text": "од своје младости,",
            "poem": 2
          },
          {
            "text": "као талог непретакан из бурета у буре.",
            "poem": 1
          },
          {
            "text": "У изгнанство није ишао,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "укус и мирис му се нису мењали.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Зато, ево долазе дани",
            "poem": 1
          },
          {
            "text": "– говори Господ –",
            "poem": 2
          },
          {
            "text": "када ћу им послати претакаче",
            "poem": 1
          },
          {
            "text": "да их преточе у своју бурад,",
            "poem": 2
          },
          {
            "text": "а да испразне њихове крчаге",
            "poem": 1
          },
          {
            "text": "и скрше их.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Осрамотиће се Моавци због Хамоса",
            "poem": 1
          },
          {
            "text": "као што се због Ветиља,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "своје узданице, осрамотио дом Израиљев.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Како можеш да говориш: ’Ратници смо,",
            "poem": 1
          },
          {
            "text": "битке смо јунаци!’?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Моав је похаран, градови му освојени,",
            "poem": 1
          },
          {
            "text": "а најбољи младићи његови сишли су на клање",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "– говори цар, Господ над војскама му је име.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Близу је, долази пропаст Моава.",
            "poem": 1
          },
          {
            "text": "Жури, не застаје његово зло.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Жалите га, сви ви око њега,",
            "poem": 1
          },
          {
            "text": "сви што знате за његово име.",
            "poem": 2
          },
          {
            "text": "Па кажите: ’Жезло моћи, жезло славоносно –",
            "poem": 1
          },
          {
            "text": "како га сломише!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Спусти се из части своје,",
            "poem": 1
          },
          {
            "text": "на тло седи исушено, становнице,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ћерко девонска.",
            "poem": 2
          },
          {
            "text": "Онај што је похарао Моав",
            "poem": 1
          },
          {
            "text": "успиње се к теби",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да и твоја утврђења скрши.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "На пут стани и посматрај, становнице,",
            "poem": 1
          },
          {
            "text": "ћерко Ароира.",
            "poem": 2
          },
          {
            "text": "Човека што бежи и жену избеглу ти упитај:",
            "poem": 1
          },
          {
            "text": "’Шта се догодило?’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Моав је осрамоћен јер је срушен.",
            "poem": 1
          },
          {
            "text": "Вапите, плачите",
            "poem": 2
          },
          {
            "text": "и објавите у Арнону",
            "poem": 1
          },
          {
            "text": "да је Моав похаран.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Суд долази на висораван,",
            "poem": 1
          },
          {
            "text": "на Олон, на Јасу и Мифат;",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "на Девон, на Навав и Вет-Девлатаим;",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "на Киријатајим, на Вет-Гамул и на Вет-Меон;",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "на Кериот и на Восору,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "на све градове моавске земље који су далеко и који су близу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Сломљена је Моавова сила,",
            "poem": 1
          },
          {
            "text": "поломљена рука је његова",
            "poem": 2
          },
          {
            "text": "– говори Господ.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Опијте га,",
            "poem": 1
          },
          {
            "text": "јер је себе над Господом уздигао.",
            "poem": 2
          },
          {
            "text": "Али ваљаће се Моав у избљувку своме",
            "poem": 1
          },
          {
            "text": "и постаће прича другима за подсмех.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Није ли и теби Израиљ био прича за подсмех,",
            "poem": 1
          },
          {
            "text": "као лопов ухваћени,",
            "poem": 2
          },
          {
            "text": "па вртиш главом",
            "poem": 1
          },
          {
            "text": "кад о њему причаш?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Напустите градове и живите у врлетима,",
            "poem": 1
          },
          {
            "text": "становници Моава.",
            "poem": 2
          },
          {
            "text": "Постаните као голуб што се гнезди",
            "poem": 1
          },
          {
            "text": "у високој раселини.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "За Моавов смо понос чули,",
            "poem": 1
          },
          {
            "text": "за понос велики, за његову охолост,",
            "poem": 2
          },
          {
            "text": "за његову осорност и хвалисање,",
            "poem": 1
          },
          {
            "text": "и за гордост његовог срца.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "„Знам ја – говори Господ –",
            "poem": 1
          },
          {
            "text": "обест његову.",
            "poem": 2
          },
          {
            "text": "Лажно је његово хвалисање",
            "poem": 1
          },
          {
            "text": "и лажима ништа неће да постигне.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Кукам зато за Моавом,",
            "poem": 1
          },
          {
            "text": "плачем за свима њима, Моавцима.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Јечим за људима у Кир-Ересу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Плакаћу за тобом више, лозо сивамска,",
            "poem": 1
          },
          {
            "text": "него што сам плакао за Јазиром.",
            "poem": 2
          },
          {
            "text": "Младице твоје су биле пружене до мора,",
            "poem": 1
          },
          {
            "text": "све до мора јазирског.",
            "poem": 2
          },
          {
            "text": "А сада се на твоје, тек пристигло летње воће,",
            "poem": 1
          },
          {
            "text": "и на бербу твоју, устремио затирач.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Нестали су радост и весеље",
            "poem": 1
          },
          {
            "text": "из воћњака и из земље моавске.",
            "poem": 2
          },
          {
            "text": "Учинио сам да нестане вина из каца,",
            "poem": 1
          },
          {
            "text": "да газилац не гази грожђе у каци радујући се.",
            "poem": 2
          },
          {
            "text": "Биће вриске,",
            "poem": 1
          },
          {
            "text": "али не од радости.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Од Есевона до Елеалије и Јасе",
            "poem": 1
          },
          {
            "text": "се чује нарицање,",
            "poem": 2
          },
          {
            "text": "вичу од Соара до Оронајима и Еглат-Селисија",
            "poem": 1
          },
          {
            "text": "јер су се исушиле воде нимримске.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Истребићу у Моаву",
            "poem": 1
          },
          {
            "text": "– говори Господ –",
            "poem": 2
          },
          {
            "text": "оног што жртвује по узвишицама",
            "poem": 1
          },
          {
            "text": "и оног који кади својим боговима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "За Моавом као фрула јеца срце моје.",
            "poem": 1
          },
          {
            "text": "За људима Кир-Ереса као фрула јеца срце моје,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "зато што је настрадало оно што су стекли.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Све су главе оголеле",
            "poem": 1
          },
          {
            "text": "и све браде обријане.",
            "poem": 2
          },
          {
            "text": "Све су руке избраздане,",
            "poem": 1
          },
          {
            "text": "а кострет је на бедрима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "На свим крововима Моава",
            "poem": 1
          },
          {
            "text": "и на његовим трговима",
            "poem": 2
          },
          {
            "text": "само жалопојке,",
            "poem": 1
          },
          {
            "text": "јер сам скршио Моав",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "као крчаг који нико неће",
            "poem": 2
          },
          {
            "text": "– говори Господ.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          {
            "text": "Жалиће: „О, како је скршен!",
            "poem": 1
          },
          {
            "text": "Како је Моав окренуо главу јер је посрамљен.",
            "poem": 2
          },
          {
            "text": "Постао је Моав прича за подсмех",
            "poem": 1
          },
          {
            "text": "и ужасавање свим местима унаоколо.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "Јер овако каже Господ:",
          {
            "text": "„Ево, као орао се обрушава",
            "poem": 1
          },
          {
            "text": "и крила своја шири над Моавом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          {
            "text": "Кериот је освојен,",
            "poem": 1
          },
          {
            "text": "утврђења опкољена,",
            "poem": 2
          },
          {
            "text": "а срце ће моавских ратника",
            "poem": 1
          },
          {
            "text": "онога дана бити као срце породиље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          {
            "text": "Моав ће истребљен бити као народ,",
            "poem": 1
          },
          {
            "text": "јер је себе над Господом уздигао.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          {
            "text": "Чекају те страхота,",
            "poem": 1
          },
          {
            "text": "јама и замка, становниче Моава!",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          {
            "text": "Ко утекне од страхоте,",
            "poem": 1
          },
          {
            "text": "у јаму ће пасти;",
            "poem": 2
          },
          {
            "text": "ко се из јаме извуче,",
            "poem": 1
          },
          {
            "text": "у замку ће се ухватити!",
            "poem": 2
          },
          {
            "text": "Јер ја сам тај што на Моав доносим",
            "poem": 1
          },
          {
            "text": "годину њихове казне",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          {
            "text": "У сенци су Есевона",
            "poem": 1
          },
          {
            "text": "застали бегунци онемоћали,",
            "poem": 2
          },
          {
            "text": "јер је пожар кренуо од Есевона",
            "poem": 1
          },
          {
            "text": "и пламен из самога Сихона,",
            "poem": 2
          },
          {
            "text": "да прогута чело Моавово",
            "poem": 1
          },
          {
            "text": "и теме бунтовницима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          {
            "text": "Јао теби, Моаве!",
            "poem": 1
          },
          {
            "text": "Пропашће Хамосов народ!",
            "poem": 2
          },
          {
            "text": "Синове ће твоје одвести у ропство",
            "poem": 1
          },
          {
            "text": "и твоје ћерке у изгнанство.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          {
            "text": "Али вратићу изгнанике моавске",
            "poem": 1
          },
          {
            "text": "у последњим данима",
            "poem": 2
          },
          {
            "text": "– говори Господ.“",
            "poem": 3
          },
          "Довде је суд над Моавом."
        ]
      }
    ],
