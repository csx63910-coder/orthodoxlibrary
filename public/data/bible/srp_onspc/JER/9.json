  "book": {
    "id": "JER",
    "translationId": "srp_onspc",
    "name": "Књига пророка Јеремије",
    "commonName": "Књига пророка Јеремије",
    "title": "Књига пророка Јеремије",
    "order": 24,
    "numberOfChapters": 52,
    "sha256": "b33f8d3e722cccfab7e8d8c2e353b57c81d901db98dd37cafca596c2cc88e2e2",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/JER/1.json",
    "lastChapterNumber": 52,
    "lastChapterApiLink": "/api/srp_onspc/JER/52.json",
    "totalNumberOfVerses": 1364
  },
  "chapter": {
    "number": 9,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "О, кад би ми глава била вода,",
            "poem": 1
          },
          {
            "text": "а моје око врело суза,",
            "poem": 2
          },
          {
            "text": "па да оплакујем и дању и ноћу",
            "poem": 1
          },
          {
            "text": "изгинуле од ћерки мога народа!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "О, кад бих у пустињи имао",
            "poem": 1
          },
          {
            "text": "преноћиште за путнике,",
            "poem": 2
          },
          {
            "text": "могао бих да напустим свој народ",
            "poem": 1
          },
          {
            "text": "и да одем од њих.",
            "poem": 2
          },
          {
            "text": "Јер, сви су прељубници",
            "poem": 1
          },
          {
            "text": "и сабор неверника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "„Као свој лук они запињу језик лажима.",
            "poem": 1
          },
          {
            "text": "Али нису због истине",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "постали јаки у земљи,",
            "poem": 2
          },
          {
            "text": "јер хрле од зла до зла",
            "poem": 1
          },
          {
            "text": "и мене не познају",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Свако нек се пази од свога ближњег",
            "poem": 1
          },
          {
            "text": "и не верујте ниједном брату.",
            "poem": 2
          },
          {
            "text": "Јер сваки брат упорно вара",
            "poem": 1
          },
          {
            "text": "и сваки ближњи клевеће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "И свако вара свога ближњег",
            "poem": 1
          },
          {
            "text": "и не говоре истину.",
            "poem": 2
          },
          {
            "text": "Свој су језик научили да говори лажно.",
            "poem": 1
          },
          {
            "text": "Изнурени су од грешења.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ти живиш усред преваре,",
            "poem": 1
          },
          {
            "text": "а баш због преваре они одбијају да ме знају",
            "poem": 2
          },
          {
            "text": "– говори Господ.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Зато овако каже Господ над војскама:",
          {
            "text": "„Ево, претопићу их и опробаћу их.",
            "poem": 1
          },
          {
            "text": "Јер, како да поступим",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "са ћерком свог народа?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Њихов је језик стрела што убија",
            "poem": 1
          },
          {
            "text": "и говори превару.",
            "poem": 2
          },
          {
            "text": "Својим устима о миру са својим ближњим човек говори,",
            "poem": 1
          },
          {
            "text": "али у себи кује сплетку.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Зар због тога да их не казним?",
            "poem": 1
          },
          {
            "text": "– говори Господ.",
            "poem": 2
          },
          {
            "text": "Над народом попут овог",
            "poem": 1
          },
          {
            "text": "зар да се не освети моја душа?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Над брдима ћу да вапим,",
            "poem": 1
          },
          {
            "text": "нарицаћу нарицаљку над пустињским пашњацима",
            "poem": 2
          },
          {
            "text": "јер су опустошени. Нико туда не пролази,",
            "poem": 1
          },
          {
            "text": "и не чује се рика стоке.",
            "poem": 2
          },
          {
            "text": "Од птица па до животиња,",
            "poem": 1
          },
          {
            "text": "све је побегло и нестало.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "„Од Јерусалима ћу да учиним гомилу камења",
            "poem": 1
          },
          {
            "text": "и брлог шакала.",
            "poem": 2
          },
          {
            "text": "Од Јудиних градова ћу да направим",
            "poem": 1
          },
          {
            "text": "пустош у којој нико не живи.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ко је мудар човек да разуме ово и коме су уста Господња говорила да то растумачи? Због чега је земља настрадала и као пустиња опустошена да кроз њу нико не пролази?"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "И Господ рече: „Зато што су оставили мој Закон који сам пред њих поставио, и зато што нису слушали мој глас ни по њему ишли."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Него су ишли по самовољи свог срца за Валима, како су их њихови преци научили.“"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Зато овако каже Господ над војскама, Бог Израиљев: „Ево, ја ћу да нахраним овај народ пеленом и напојим га затрованом водом."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Расућу их међу народе које нису знали, ни они, ни њихови преци. Послаћу за њима мач док их не докрајчим.“"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "И ово каже Господ над војскама:",
          {
            "text": "„Размотрите, па сазовите нарикаче нека дођу.",
            "poem": 1
          },
          {
            "text": "Али пошаљи по оне које су веште, нека дођу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Али нека пожуре,",
            "poem": 1
          },
          {
            "text": "нека наричу над нама,",
            "poem": 2
          },
          {
            "text": "па да нам очи сузама роне",
            "poem": 1
          },
          {
            "text": "и да нам капци буду уплакани.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Ево, чује се нарицање са Сиона:",
            "poem": 1
          },
          {
            "text": "’О, како смо пропали!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Страховито смо осрамоћени,",
            "poem": 2
          },
          {
            "text": "јер смо напустили своју земљу",
            "poem": 1
          },
          {
            "text": "и домови су нам порушени.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Чујте, жене, реч Господњу.",
            "poem": 1
          },
          {
            "text": "Нека ваше ухо прими реч његових уста.",
            "poem": 2
          },
          {
            "text": "Научите своје ћерке да наричу",
            "poem": 1
          },
          {
            "text": "и свака жена своју сусетку да лелече.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Смрт се успузала на наше прозоре.",
            "poem": 1
          },
          {
            "text": "Дошла је у наше дворове,",
            "poem": 2
          },
          {
            "text": "истребила децу са улица",
            "poem": 1
          },
          {
            "text": "и младиће са тргова.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Реци: „Говори Господ:",
          {
            "text": "’Лешеви ће људи по тлу попадати",
            "poem": 1
          },
          {
            "text": "као гнојиво по пољу,",
            "poem": 2
          },
          {
            "text": "као сноп за жетеоцем,",
            "poem": 1
          },
          {
            "text": "а неће имати ко да га сакупи.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Овако каже Господ:",
          {
            "text": "„Нека се мудрац не хвали својом мудрошћу,",
            "poem": 1
          },
          {
            "text": "нека се јунак не хвали својим јунаштвом,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и богаташ нека се богатством својим не хвали.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "А ко хоће да се хвали,",
            "poem": 1
          },
          {
            "text": "нека се хвали тиме што мене познаје,",
            "poem": 2
          },
          {
            "text": "што прониче да сам ја Господ који чини милост,",
            "poem": 1
          },
          {
            "text": "правду и праведност на земљи,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и да у томе уживам –",
            "poem": 2
          },
          {
            "text": "овако каже Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Ево, долазе дани – говори Господ – када ћу казнити све оне само по телу обрезане:"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Египат и Јуду, Едом заједно са Амонцима и Моавцима; који избријавају зулуфе и који живе у пустињи. Јер сви су ти народи необрезани и сав је Израиљев дом необрезаног срца.“"
        ]
      }
    ],
