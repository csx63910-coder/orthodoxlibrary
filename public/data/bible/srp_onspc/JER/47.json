  "chapter": {
    "number": 47,
    "content": [
      {
        "type": "heading",
        "content": [
          "Порука Филистејцима"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Реч Господња која је дошла пророку Јеремији за Филистејце, пре него је фараон ударио на Газу:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Овако каже Господ:",
          {
            "text": "„Ево, дижу се воде са севера,",
            "poem": 1
          },
          {
            "text": "постају бујични потоци и плаве земљу",
            "poem": 2
          },
          {
            "text": "и све што је у њој,",
            "poem": 1
          },
          {
            "text": "град и оне што живе у њему.",
            "poem": 2
          },
          {
            "text": "И свако ће да завапи,",
            "poem": 1
          },
          {
            "text": "закукаће сваки становник земље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Од топота копита њихових ждребаца,",
            "poem": 1
          },
          {
            "text": "од вреве њихових кола",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и праска точкова њихових",
            "poem": 2
          },
          {
            "text": "ни очеви се, немоћни од страха",
            "poem": 1
          },
          {
            "text": "неће вратити по своју децу;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "због дана што долази",
            "poem": 1
          },
          {
            "text": "да сатре све Филистејце,",
            "poem": 2
          },
          {
            "text": "да истреби Тиру и Сидону",
            "poem": 1
          },
          {
            "text": "све преживеле помоћнике.",
            "poem": 2
          },
          {
            "text": "Јер Господ ће да похара Филистејце,",
            "poem": 1
          },
          {
            "text": "остатак острва Кафтор",
            "poem": 2
          },
          {
            "noteId": 26
          },
          {
            "text": ".",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Оћелавиће Газа!",
            "poem": 1
          },
          {
            "text": "Опустошиће Аскалон!",
            "poem": 2
          },
          {
            "text": "О, остаче њихове долине,",
            "poem": 1
          },
          {
            "text": "докле ћеш себе парати?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "’Јао, мачу Господњи,",
            "poem": 1
          },
          {
            "text": "колико се још примирити нећеш?!",
            "poem": 2
          },
          {
            "text": "Прибери се, у корице усучи се",
            "poem": 1
          },
          {
            "text": "и остани миран.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Како да се примири",
            "poem": 1
          },
          {
            "text": "када му је Господ заповедио?",
            "poem": 2
          },
          {
            "text": "За Аскалон и за обалу морску,",
            "poem": 1
          },
          {
            "text": "тамо га је он одредио.“",
            "poem": 2
          }
        ]
      }
    ],
