  "book": {
    "id": "JER",
    "translationId": "srp_onspc",
    "name": "Књига пророка Јеремије",
    "commonName": "Књига пророка Јеремије",
    "title": "Књига пророка Јеремије",
    "order": 24,
    "numberOfChapters": 52,
    "sha256": "b33f8d3e722cccfab7e8d8c2e353b57c81d901db98dd37cafca596c2cc88e2e2",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/JER/1.json",
    "lastChapterNumber": 52,
    "lastChapterApiLink": "/api/srp_onspc/JER/52.json",
    "totalNumberOfVerses": 1364
  },
  "chapter": {
    "number": 8,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "У то ће време – говори Господ – извадити кости Јудиних царева, кости главара, кости свештеника, кости пророка и кости становника Јерусалима из њихових гробова."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Разасуће их пред сунцем, месецом, пред свом небеском војском, пред онима које су волели и служили им, које су следили, тежили им и којима су се клањали. Неће их сакупити и неће их сахранити. Биће као гнојиво по тлу."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "А свем остатку овог злог рода, који преживи по свим местима у која ћу их прогнати, смрт ће бити дража од живота – говори Господ над војскама."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Грех и казна"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Реци им: ’Говори Господ:",
          {
            "text": "Зар не устају они који падају?",
            "poem": 1
          },
          {
            "text": "Зар се не враћа онај који се одвраћа?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "А зашто се одвратио овај народ,",
            "poem": 1
          },
          {
            "text": "Јерусалим, упоран у одметништву?",
            "poem": 2
          },
          {
            "text": "Држи се обмане",
            "poem": 1
          },
          {
            "text": "и одбија да се врати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Пазио сам и чуо: не говоре добро,",
            "poem": 1
          },
          {
            "text": "ниједан се не каје за своја зла",
            "poem": 2
          },
          {
            "text": "и не каже – Шта сам то урадио?",
            "poem": 1
          },
          {
            "text": "Сви су се одвратили на своју страну",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "као коњ што граби у битку.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Чак и рода на небесима зна своје време;",
            "poem": 1
          },
          {
            "text": "голуб, ласта и ждрал пазе на време када долазе;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а само мој народ не зна Господње прописе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Како можете да кажете: мудри смо!",
            "poem": 1
          },
          {
            "text": "Имамо Господњи Закон?",
            "poem": 2
          },
          {
            "text": "Гле, стварно га је лажним начинило",
            "poem": 1
          },
          {
            "text": "лажљиво перо зналаца Светог писма!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Мудраци су се осрамотили,",
            "poem": 1
          },
          {
            "text": "уплашили су се и заробљени су.",
            "poem": 2
          },
          {
            "text": "Ево, презрели су реч Господњу,",
            "poem": 1
          },
          {
            "text": "па каква им то мудрост преостаје?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Зато ћу њихове жене да дам другима,",
            "poem": 1
          },
          {
            "text": "а њихова поља новим газдама.",
            "poem": 2
          },
          {
            "text": "Јер баш сви, од најмањег до највећег,",
            "poem": 1
          },
          {
            "text": "грабе непоштени добитак.",
            "poem": 2
          },
          {
            "text": "Од пророка, па до свештеника,",
            "poem": 1
          },
          {
            "text": "баш сви варају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Они прелом ћерке мог народа",
            "poem": 1
          },
          {
            "text": "олако лече причајући:",
            "poem": 2
          },
          {
            "text": "Мир! Мир!",
            "poem": 1
          },
          {
            "text": "А нема мира.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Јесу ли се застидели зато што су учинили гадост?",
            "poem": 1
          },
          {
            "text": "Баш се нимало нису застидели",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и не знају за стид.",
            "poem": 2
          },
          {
            "text": "Зато ће пасти међу оне што падају",
            "poem": 1
          },
          {
            "text": "и у часу када их казним биће саплетени",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Покупићу их и докрајчићу их –",
            "poem": 1
          },
          {
            "text": "говори Господ –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "неће више бити грожђа на лози,",
            "poem": 2
          },
          {
            "text": "неће више бити плодова смокве на њеном стаблу",
            "poem": 1
          },
          {
            "text": "и лишће ће се осушити.",
            "poem": 2
          },
          {
            "text": "А ја ћу да их дам онима",
            "poem": 1
          },
          {
            "text": "што ће их прегазити.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "И зашто сада седимо?",
            "poem": 1
          },
          {
            "text": "Окупите се,",
            "poem": 2
          },
          {
            "text": "пођимо у утврђене градове",
            "poem": 1
          },
          {
            "text": "па да тамо изгинемо,",
            "poem": 2
          },
          {
            "text": "јер нас је Господ, наш Бог, одредио за пропаст.",
            "poem": 1
          },
          {
            "text": "Дао нам је да пијемо затровану воду",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер смо Господу згрешили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Надали смо се миру,",
            "poem": 1
          },
          {
            "text": "али ничег доброг;",
            "poem": 2
          },
          {
            "text": "и времену здравља,",
            "poem": 1
          },
          {
            "text": "а оно страва.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Од Дана се још чуло рзање њихових коња,",
            "poem": 1
          },
          {
            "text": "а од њиштања њихових ждребаца тресла се земља.",
            "poem": 2
          },
          {
            "text": "Дошли су, похарали земљу",
            "poem": 1
          },
          {
            "text": "и све што је у њој,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и град и становнике у њему.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "„Ево, шаљем на вас змије отровнице",
            "poem": 1
          },
          {
            "text": "против којих нема бајалице,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "па ће вас уједати",
            "poem": 2
          },
          {
            "text": "– говори Господ.“",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "О, кад бих се насмејао!",
            "poem": 1
          },
          {
            "text": "Ал’ тужан сам и срце ме боли.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Гле, вапај ћерке мога народа",
            "poem": 1
          },
          {
            "text": "из земље далеке:",
            "poem": 2
          },
          {
            "text": "„Зар Господ није на Сиону?",
            "poem": 1
          },
          {
            "text": "Њен цар није ту?“",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "„Али зашто ме гневе њиховим идолима,",
            "poem": 1
          },
          {
            "text": "тим туђинским ништавилима?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "„И жетва је прошла",
            "poem": 1
          },
          {
            "text": "и лето је крају дошло,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а ми спасени нисмо!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Разорило ме је разарање ћерке мога народа.",
            "poem": 1
          },
          {
            "text": "У црнини сам јер ме је грозота обузела!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Зар у Галаду нема мелема?",
            "poem": 1
          },
          {
            "text": "Зар тамо нема лекара?",
            "poem": 2
          },
          {
            "text": "Па зашто онда није оздравила",
            "poem": 1
          },
          {
            "text": "ћерка мога народа?",
            "poem": 2
          }
        ]
      }
    ],
