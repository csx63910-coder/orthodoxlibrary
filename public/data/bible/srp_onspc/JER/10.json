  "chapter": {
    "number": 10,
    "content": [
      {
        "type": "heading",
        "content": [
          "Бог и идоли"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Доме Израиљев, чујте реч коју вам говори Господ!"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "„Овако каже Господ:",
          {
            "text": "’Не учите се путу народа",
            "poem": 1
          },
          {
            "text": "и не плашите се небеских знакова",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "којих се плаше народи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Јер су обичаји тих народа празни.",
            "poem": 1
          },
          {
            "text": "Ето, то је тек дрво из шуме које је неко посекао,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "дело уметникове алатке.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Украсио га је сребром и златом.",
            "poem": 1
          },
          {
            "text": "Клиновима и чекићима га учвршћују",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да се не клати!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Личе на страшило у леји за краставце.",
            "poem": 1
          },
          {
            "text": "Не говоре,",
            "poem": 2
          },
          {
            "text": "и морају да се носе, јер не ходају.",
            "poem": 1
          },
          {
            "text": "Не плаши их се!",
            "poem": 2
          },
          {
            "text": "Они не могу да науде,",
            "poem": 1
          },
          {
            "text": "а не могу ни шта добро да ураде.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Нико није као ти, о, Господе!",
            "poem": 1
          },
          {
            "text": "Велики си,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и велико је твоје силно име.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Ко се не би бојао тебе,",
            "poem": 1
          },
          {
            "text": "Царе народа?",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Јер теби то доликује.",
            "poem": 2
          },
          {
            "text": "Међу свим мудрацима народа",
            "poem": 1
          },
          {
            "text": "и по свим њиховим царствима",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "нема никог као што си ти.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Сви су глупи и безумни,",
            "poem": 1
          },
          {
            "text": "јер је ништа поука од дрвета.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Из Тарсиса доносе ковано сребро",
            "poem": 1
          },
          {
            "text": "и злато из Уфаза,",
            "poem": 2
          },
          {
            "text": "дело уметника и рукотворину златара.",
            "poem": 1
          },
          {
            "text": "Одећа им је љубичаста и скерлетна",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и све је то дело вештих људи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "А Господ је истински Бог!",
            "poem": 1
          },
          {
            "text": "Он је Бог живи и вечни цар.",
            "poem": 2
          },
          {
            "text": "Од његовог гнева тресе се земља,",
            "poem": 1
          },
          {
            "text": "и народи не могу да истрпе јарост његову.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "„Овако им реците: ’Богови који нису начинили небеса и земљу ће нестати и са земље и испод небеса.’“"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Он је силом својом начинио земљу.",
            "poem": 1
          },
          {
            "text": "Мудрошћу својом он је основао васељену,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и својом је разборитошћу разапео небеса.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Глас он када пусти, воде хуче на небесима.",
            "poem": 1
          },
          {
            "text": "Он подиже облаке с краја земље,",
            "poem": 2
          },
          {
            "text": "киши муње даје",
            "poem": 1
          },
          {
            "text": "и изводи ветар из својих ризница.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Баш је од свог знања глуп сваки човек.",
            "poem": 1
          },
          {
            "text": "Због идола се сваки златар стиди,",
            "poem": 2
          },
          {
            "text": "јер су обмана његови ливени идоли.",
            "poem": 1
          },
          {
            "text": "Нема даха у њима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Они су испразни, творевине ругла.",
            "poem": 1
          },
          {
            "text": "Пропашће кад дође време за њихову казну.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Не следе Јакову такви као ови.",
            "poem": 1
          },
          {
            "text": "Јер он је тај који је све начинио.",
            "poem": 2
          },
          {
            "text": "Племе Израиљ његово је наследство,",
            "poem": 1
          },
          {
            "text": "а он се зове Господ над војскама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Разарање долази"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Покупи са земље свој завежљај,",
            "poem": 1
          },
          {
            "text": "ти која живиш под опсадом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Јер овако каже Господ:",
            "poem": 1
          },
          {
            "text": "„Ево, сад ћу као праћком",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да из земље избацим становнике.",
            "poem": 2
          },
          {
            "text": "Стиснућу их, да могу да схвате.“",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Јао мени због мог лома!",
            "poem": 1
          },
          {
            "text": "Тешка је моја рана.",
            "poem": 2
          },
          {
            "text": "А ја сам рекао:",
            "poem": 1
          },
          {
            "text": "„Ово је само болест, издржаћу је ја.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Мој је шатор похаран",
            "poem": 1
          },
          {
            "text": "и шаторска ужад покидана.",
            "poem": 2
          },
          {
            "text": "Деца су моја од мене отишла и нема их.",
            "poem": 1
          },
          {
            "text": "Нема никога да опет постави мој шатор,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "никога да подигне завесе на њему.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Пастири су се глупо понели",
            "poem": 1
          },
          {
            "text": "и нису тражили Господа.",
            "poem": 2
          },
          {
            "text": "Зато и нису напредовали",
            "poem": 1
          },
          {
            "text": "и раштркана су сва њихова стада.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Ево вести! Долази глас",
            "poem": 1
          },
          {
            "text": "и ломљава велика из северне земље:",
            "poem": 2
          },
          {
            "text": "да ће градови Јуде постати пустош",
            "poem": 1
          },
          {
            "text": "и јазбина шакала.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Јеремијина молитва"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Знам ја, о, Господе, да човек није владар свог пута,",
            "poem": 1
          },
          {
            "text": "и да онај који хода не управља својим корацима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Покарај ме, Господе, ал’ само по правди;",
            "poem": 1
          },
          {
            "text": "не у свом гневу,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да ме не нестане.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Излиј свој гнев на народе",
            "poem": 1
          },
          {
            "text": "што те не познају,",
            "poem": 2
          },
          {
            "text": "на родове који твоје име не призивају.",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Јер су они гутали Јакова и прогутали,",
            "poem": 1
          },
          {
            "text": "и прождрли су га,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "насеље му у пустош претворили.",
            "poem": 2
          }
        ]
      }
    ],
