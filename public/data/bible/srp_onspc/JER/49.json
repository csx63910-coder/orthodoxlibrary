  "chapter": {
    "number": 49,
    "content": [
      {
        "type": "heading",
        "content": [
          "Порука Амону"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "За Амонце овако каже Господ:",
          {
            "text": "„Зар Израиљ нема децу?",
            "poem": 1
          },
          {
            "text": "Зар Израиљ нема наследника?",
            "poem": 2
          },
          {
            "text": "Зашто је онда Малхом",
            "poem": 1
          },
          {
            "noteId": 28
          },
          {
            "text": "заузео Гад",
            "poem": 1
          },
          {
            "text": "и његов народ пребива у тамошњим градовима?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Зато, ево, долазе дани",
            "poem": 1
          },
          {
            "text": "– говори Господ –",
            "poem": 2
          },
          {
            "text": "узвикнућу Рави",
            "poem": 1
          },
          {
            "text": "синова Амонових бојни поклич.",
            "poem": 2
          },
          {
            "text": "Постаће пуста рушевина,",
            "poem": 1
          },
          {
            "text": "насеља ће јој ватром спалити,",
            "poem": 2
          },
          {
            "text": "а Израиљ ће да заузме",
            "poem": 1
          },
          {
            "text": "оно што су њему заузели",
            "poem": 2
          },
          {
            "text": "– овако каже Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Закукај, Есевоне, јер је Гај опустошен;",
            "poem": 1
          },
          {
            "text": "запомажите, насеља Равина,",
            "poem": 2
          },
          {
            "text": "опашите кострет, жалите,",
            "poem": 1
          },
          {
            "text": "тумарајте међу зидинама,",
            "poem": 2
          },
          {
            "text": "јер ће Малхом у изгнанство.",
            "poem": 1
          },
          {
            "text": "Отићи ће заједно са својим свештеницима",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и својим главарима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Зашто се хвалиш долинама?",
            "poem": 1
          },
          {
            "text": "Долине су твоје потопљене,",
            "poem": 2
          },
          {
            "text": "о, ћерко одметничка,",
            "poem": 1
          },
          {
            "text": "што се хвалиш својим благом:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "’Ко ће да удари на мене?’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ево, на тебе пуштам страхоту",
            "poem": 1
          },
          {
            "text": "од свих око тебе",
            "poem": 2
          },
          {
            "text": "– говори Господ Бог над војскама –",
            "poem": 3
          },
          {
            "text": "на све стране све ће протерати,",
            "poem": 1
          },
          {
            "text": "а бегунце неће имати ко да окупи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Али после овога ћу вратити изгнане синове Амонове",
            "poem": 1
          },
          {
            "text": "– говори Господ.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Порука Едому"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "За Едомце овако каже Господ над војскама:",
          {
            "text": "„Зар нема више мудрости у Теману?",
            "poem": 1
          },
          {
            "text": "Зар је ишчезао савет мудраца",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и зар су покварили њихову мудрост?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Бежите! Окрените се,",
            "poem": 1
          },
          {
            "text": "у дубине настаните, становници Дедана.",
            "poem": 2
          },
          {
            "text": "Пропаст на Исава доносим,",
            "poem": 1
          },
          {
            "text": "време када ћу га казнити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "И берачи грожђа да ти дођу,",
            "poem": 1
          },
          {
            "text": "пабирке зар не би оставили?",
            "poem": 2
          },
          {
            "text": "Да лопови харају те ноћу,",
            "poem": 1
          },
          {
            "text": "зар понели не би колико им треба?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Али ја ћу да оголим Исава,",
            "poem": 1
          },
          {
            "text": "да откријем скривена му места,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а он себе да сакрије неће моћи.",
            "poem": 2
          },
          {
            "text": "Уништићу му потомство, браћу, суседе",
            "poem": 1
          },
          {
            "text": "и више га неће бити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Остави своју сирочад и ја ћу их сачувати живе;",
            "poem": 1
          },
          {
            "text": "удовице твоје нека се у мене поуздају.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Јер овако каже Господ: „Ево, из чаше ће зацело пити и они којима није суђено да пију, па зашто би сасвим казне ти поштеђен био? Бићеш кажњен и зацело ћеш и ти пити."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Јер собом се заклињем – говори Господ – рушевина и ругло, пустош и клетва постаће Восора; и сви њени градови ће постати руине довека.“"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Од Господа сам чуо вести",
            "poem": 1
          },
          {
            "text": "и гласник је послан међу народе:",
            "poem": 2
          },
          {
            "text": "„Окупите се! Ударите на њега!",
            "poem": 1
          },
          {
            "text": "Устаните у бој!“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "„Јер, ево, учинио сам те незнатним међу народима",
            "poem": 1
          },
          {
            "text": "и презреним међу људима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Страховитост те је твоја обманула",
            "poem": 1
          },
          {
            "text": "и охолост твога срца,",
            "poem": 2
          },
          {
            "text": "ти што живиш у раселини стене,",
            "poem": 1
          },
          {
            "text": "становниче горских висина.",
            "poem": 2
          },
          {
            "text": "Све и да као орао своје гнездо у висине свијеш,",
            "poem": 1
          },
          {
            "text": "стровалићу те ја и оданде",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Едом ће постати пустош,",
            "poem": 1
          },
          {
            "text": "и свако ко поред њега прође ужаснут ће бити,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и звиждаће због свих рана његових.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Као кад су опустошени Содома и Гомора",
            "poem": 1
          },
          {
            "text": "и околни градови –",
            "poem": 2
          },
          {
            "text": "каже Господ –",
            "poem": 3
          },
          {
            "text": "тамо нико пребивати неће,",
            "poem": 1
          },
          {
            "text": "неће бити потомака људи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Гле, као лав што скаче из јорданског честара",
            "poem": 1
          },
          {
            "text": "на пашњак плодан,",
            "poem": 2
          },
          {
            "text": "ја ћу Едом потерати одатле у трену.",
            "poem": 1
          },
          {
            "text": "И ко год да је изабрани, ту ћу га ставити.",
            "poem": 2
          },
          {
            "text": "Јер, ко је као ја и ко ће против мене?",
            "poem": 1
          },
          {
            "text": "Ко је тај пастир који ће изаћи пред мене?“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Зато чујте намере Господње што их је за Едом намерио,",
            "poem": 1
          },
          {
            "text": "и његове науме што је за Теманце наумио:",
            "poem": 2
          },
          {
            "text": "стварно ће одвући најмлађе из стада,",
            "poem": 1
          },
          {
            "text": "опустошиће стварно због њих пашњак њихов.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "А од праска пада њиховога потрешће се земља;",
            "poem": 1
          },
          {
            "text": "вапај њиховога гласа ће се чути до Црвеног мора.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Гле, као орао се диже и обрушава се,",
            "poem": 1
          },
          {
            "text": "крила своја шири над Восором!",
            "poem": 2
          },
          {
            "text": "А срце ће едомских ратника",
            "poem": 1
          },
          {
            "text": "онога дана бити као срце породиље.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Порука Дамаску"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "О Дамаску:",
          {
            "text": "„Осрамотиће се и Амат и Арфад",
            "poem": 1
          },
          {
            "text": "због гласова лоших што су чули.",
            "poem": 2
          },
          {
            "text": "Истопи их стрепња;",
            "poem": 1
          },
          {
            "text": "на мору је лоше, нема му спокоја!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Клонуло је срце у Дамаску.",
            "poem": 1
          },
          {
            "text": "Окренуо се да бежи.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ужас га је обузео,",
            "poem": 2
          },
          {
            "text": "немир и болови су га спопали",
            "poem": 1
          },
          {
            "text": "као породиљу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Како то да није напуштен град славе,",
            "poem": 1
          },
          {
            "text": "град радости моје?!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Зато ће да попадају његови младићи по његовим трговима;",
            "poem": 1
          },
          {
            "text": "настрадаће тога дана сви људи ратници",
            "poem": 2
          },
          {
            "text": "– говори Господ над војскама.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Ја ћу ватром да запалим зидине Дамаска",
            "poem": 1
          },
          {
            "text": "и она ће да сагори Вен-Ададове дворове.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Порука Кедру и Асору"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "О Кедру и о царствима Асора које је освојио Навуходоносор, цар Вавилона:",
          {
            "lineBreak": true
          },
          "„Овако каже Господ:",
          {
            "text": "Устаните и идите у Кедар",
            "poem": 1
          },
          {
            "text": "и сатрите источне народе!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Узеће и њихове шаторе и њихова стада,",
            "poem": 1
          },
          {
            "text": "њихове шаторске засторе и све њихове ствари;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "њихове ће камиле узети за себе",
            "poem": 2
          },
          {
            "text": "и викаће на њих:",
            "poem": 1
          },
          {
            "text": "’Ужас одасвуд!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Бежите, утеците одмах,",
            "poem": 1
          },
          {
            "text": "у дубине се настаните, становници Асора",
            "poem": 2
          },
          {
            "text": "– говори Господ –",
            "poem": 3
          },
          {
            "text": "јер је за вас осмислио науме,",
            "poem": 1
          },
          {
            "text": "намерио се на вас Навуходоносор, цар Вавилона.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Устаните! Идите кротком народу",
            "poem": 1
          },
          {
            "text": "што спокојно живи",
            "poem": 2
          },
          {
            "text": "– говори Господ –",
            "poem": 3
          },
          {
            "text": "без врата и без крила на њима,",
            "poem": 1
          },
          {
            "text": "и живе сами.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Њихове ће камиле постати плен,",
            "poem": 1
          },
          {
            "text": "а обиље њихове стоке грабеж;",
            "poem": 2
          },
          {
            "text": "и ја ћу их развејати сваким ветром, те што избријавају зулуфе;",
            "poem": 1
          },
          {
            "text": "са свих страна ћу донети пропаст њихову на њих",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Асор ће постати јазбина шакала,",
            "poem": 1
          },
          {
            "text": "пустош довека.",
            "poem": 2
          },
          {
            "text": "Тамо нико пребивати неће,",
            "poem": 1
          },
          {
            "text": "потомака људи неће бити.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Порука Еламу"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "Реч Господња која је дошла пророку Јеремији за Елам, на почетку владавине Седекије, цара Јуде:"
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "Овако каже Господ над војскама:",
          {
            "text": "„Ево, ломим лук Еламов,",
            "poem": 1
          },
          {
            "text": "њихову највећу снагу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "На Елам доводим четири ветра,",
            "poem": 1
          },
          {
            "text": "са четири стране небеске.",
            "poem": 2
          },
          {
            "text": "Развејаћу их свим овим ветровима",
            "poem": 1
          },
          {
            "text": "и неће бити народа",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "у који неће отићи развејани из Елама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Поразићу Елам пред њиховим непријатељима",
            "poem": 1
          },
          {
            "text": "и пред онима што им раде о глави.",
            "poem": 2
          },
          {
            "text": "Пропаст доносим на њих,",
            "poem": 1
          },
          {
            "text": "жар свог гнева",
            "poem": 2
          },
          {
            "text": "– говори Господ –",
            "poem": 3
          },
          {
            "text": "послаћу за њима мач",
            "poem": 1
          },
          {
            "text": "све док их не истребим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "Престо свој у Еламу поставићу,",
            "poem": 1
          },
          {
            "text": "цара тамошњег и главаре истребићу",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          {
            "text": "Али вратићу изгнанике еламске",
            "poem": 1
          },
          {
            "text": "у последњим данима",
            "poem": 2
          },
          {
            "text": "– говори Господ.“",
            "poem": 3
          }
        ]
      }
    ],
