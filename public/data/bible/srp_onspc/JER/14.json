  "chapter": {
    "number": 14,
    "content": [
      {
        "type": "heading",
        "content": [
          "Суша, глад, рат"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Јеремији је дошла од Господа порука о суши:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Јуда плаче.",
            "poem": 1
          },
          {
            "text": "Градови јој пропадају,",
            "poem": 2
          },
          {
            "text": "а они леже по земљи у црно завијени.",
            "poem": 1
          },
          {
            "text": "Плач Јерусалима се разлеже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Моћници шаљу своје слуге по воду,",
            "poem": 1
          },
          {
            "text": "али када они стигну до чатрња,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "воде нема.",
            "poem": 2
          },
          {
            "text": "А онда се враћају празних посуда,",
            "poem": 1
          },
          {
            "text": "посрамљени и збуњени,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "покривених глава.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Тло је испуцало,",
            "poem": 1
          },
          {
            "text": "јер нема кише у земљи,",
            "poem": 2
          },
          {
            "text": "ратари су посрамљени",
            "poem": 1
          },
          {
            "text": "и покривају своје главе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "И кошута се оланила у пољу",
            "poem": 1
          },
          {
            "text": "и напустила младо,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер нема траве.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Дивљи магарци стоје по оголелим висовима",
            "poem": 1
          },
          {
            "text": "и као шакали дахћу.",
            "poem": 2
          },
          {
            "text": "Исколачили су очи",
            "poem": 1
          },
          {
            "text": "јер нема паше.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Наше кривице сведоче против нас.",
            "poem": 1
          },
          {
            "text": "А ти ипак, Господе, делуј ради свога имена,",
            "poem": 2
          },
          {
            "text": "јер су многа наша отпадништва.",
            "poem": 1
          },
          {
            "text": "Против тебе смо сагрешили!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Надо Израиљева,",
            "poem": 1
          },
          {
            "text": "Спаситељу његов у часу невоље!",
            "poem": 2
          },
          {
            "text": "Зашто си попут дошљака у земљи",
            "poem": 1
          },
          {
            "text": "и путника што би тек успут да преноћи?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Зашто си као сметен човек,",
            "poem": 1
          },
          {
            "text": "као јунак немоћан да спасе?",
            "poem": 2
          },
          {
            "text": "А ти си међу нама, о, Господе,",
            "poem": 1
          },
          {
            "text": "и твоје је име призвано на нас.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Не напуштај нас!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Ево шта каже Господ овом народу:",
          {
            "text": "„Они баш воле да лутају,",
            "poem": 1
          },
          {
            "text": "не спутавају у томе кораке своје.",
            "poem": 2
          },
          {
            "text": "И Господ их није прихватио",
            "poem": 1
          },
          {
            "text": "и сада се сећа њихових кривица",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и казниће њихове грехе.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Господ ми је рекао: „Не моли се за добро овог народа."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Постиће они, али ја нећу слушати њихов вапај. Жртвоваће они свеспалнице и житне жртве, али ја их нећу прихватити. Докрајчићу их мачем, глађу и помором.“"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "А ја сам узвратио: „О, Господе Боже! Ево пророци им говоре: ’Рат и глад нећете гледати! Неће вас то задесити! Јер ја ћу да вам дам сигуран мир на овом месту.’“"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Господ ми је одговорио: „Ти пророци пророкују лаж у моје име! Ја их нисам послао и нисам их овластио. Нисам им објавио лажно виђење и обмањивачку гаталицу, јер то они пророкују по свом срцу."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Зато овако каже Господ о тим пророцима који пророкују у моје име. Ја их нисам послао да вам кажу: ’Рат и глад вас неће задесити у овој земљи.’ Скончаће ти пророци и од рата и од глади!"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "А народ коме је пророковано ће од рата и глади бити побацан по улицама Јерусалима. Неће бити кога да их сахрани – њих, њихове жене, њихове синове и њихове ћерке – и ја ћу по њима да излијем њихову злобу."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "И ову ћу поруку још да им кажем:",
          {
            "text": "’Роне сузе очи моје",
            "poem": 1
          },
          {
            "text": "и ноћу и дању без престанка,",
            "poem": 2
          },
          {
            "text": "јер је девица мог народа",
            "poem": 1
          },
          {
            "text": "разорена великим разарањем.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Јако је рањена.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ако одем у поље –",
            "poem": 1
          },
          {
            "text": "тамо мачем поклани!",
            "poem": 2
          },
          {
            "text": "Ако одем у град –",
            "poem": 1
          },
          {
            "text": "тамо од глади болесни!",
            "poem": 2
          },
          {
            "text": "И пророк и свештеник",
            "poem": 1
          },
          {
            "text": "тумарају земљом и ништа не схватају.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Зар си Јуду сасвим одбацио?",
            "poem": 1
          },
          {
            "text": "Да ли ти је Сион души мрзак?",
            "poem": 2
          },
          {
            "text": "Зашто си нас ударио",
            "poem": 1
          },
          {
            "text": "и нема нам оздрављења?",
            "poem": 2
          },
          {
            "text": "Надали смо се миру –",
            "poem": 1
          },
          {
            "text": "а ничег доброга;",
            "poem": 2
          },
          {
            "text": "и времену оздрављења –",
            "poem": 1
          },
          {
            "text": "а оно страва!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Господе, ми смо свесни наше опакости",
            "poem": 1
          },
          {
            "text": "и кривице наших предака,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер смо ти згрешили.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Не презри нас због свог имена!",
            "poem": 1
          },
          {
            "text": "Не понизи престо своје славе.",
            "poem": 2
          },
          {
            "text": "Сети се свог савеза са нама",
            "poem": 1
          },
          {
            "text": "и немој га раскинути.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Да ли неки од идола других народа шаљу кишу?",
            "poem": 1
          },
          {
            "text": "А небеса зар дају пљускове?",
            "poem": 2
          },
          {
            "text": "Зар ниси то ти, Господе наш Боже?",
            "poem": 1
          },
          {
            "text": "Ти све то чиниш",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и ми те жељно ишчекујемо.",
            "poem": 2
          }
        ]
      }
    ],
