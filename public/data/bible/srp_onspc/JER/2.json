  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "heading",
        "content": [
          "Израиљ је заборавио Бога"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Дошла ми је реч Господња говорећи:"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "„Иди и објави у уши Јерусалима:",
          {
            "lineBreak": true
          },
          "’Говори Господ:",
          {
            "text": "„Сећам те се по привржености твоје",
            "poem": 1
          },
          {
            "text": "младости и љубави твог вереништва.",
            "poem": 2
          },
          {
            "text": "Ишла си за мном у пустињу,",
            "poem": 1
          },
          {
            "text": "у незасејану земљу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Свет је Израиљ био Господу,",
            "poem": 1
          },
          {
            "text": "првина његовог урода",
            "poem": 2
          },
          {
            "text": "и сви који су га гутали били би криви",
            "poem": 1
          },
          {
            "text": "и пропаст би их стигла",
            "poem": 2
          },
          {
            "text": "– говори Господ.“’“",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Чујте Господњу реч, доме Јаковљев",
            "poem": 1
          },
          {
            "text": "и сви родови Израиљевог дома.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Говори Господ:",
          {
            "text": "„Какву су неправду у мени нашли твоји преци",
            "poem": 1
          },
          {
            "text": "када су се удаљили од мене,",
            "poem": 2
          },
          {
            "text": "ишли за таштином",
            "poem": 1
          },
          {
            "text": "и постали ташти?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Нису питали: ’Где је Господ",
            "poem": 1
          },
          {
            "text": "који нас је довео из египатске земље,",
            "poem": 2
          },
          {
            "text": "који нас је водио у пустињи,",
            "poem": 1
          },
          {
            "text": "по земљи пустоши и јама,",
            "poem": 2
          },
          {
            "text": "по земљи сушној и мрачној,",
            "poem": 1
          },
          {
            "text": "по земљи којом нико крочио није",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и у којој нико пребивао није?’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "А ја сам вас довео у земљу воћњака,",
            "poem": 1
          },
          {
            "text": "да једете њено воће и њена добра.",
            "poem": 2
          },
          {
            "text": "И дошли сте и опоганили сте моју земљу,",
            "poem": 1
          },
          {
            "text": "и моје сте наследство претворили у гадост.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Свештеници нису рекли:",
            "poem": 1
          },
          {
            "text": "’Где је Господ?’",
            "poem": 2
          },
          {
            "text": "Они који се баве Законом ме нису познали,",
            "poem": 1
          },
          {
            "text": "и пастири се побунише против мене.",
            "poem": 2
          },
          {
            "text": "Пророци су прорицали уз помоћ Вала",
            "poem": 1
          },
          {
            "text": "и ишли за оним од чега нема користи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "И још ћу да се парничим с вама",
            "poem": 1
          },
          {
            "text": "– говори Господ –",
            "poem": 3
          },
          {
            "text": "и са децом ваше деце ћу да се парничим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Јер, пређите на китимска острва и видите,",
            "poem": 1
          },
          {
            "text": "и у Кедар пошаљите па онда добро размотрите.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Видите да ли се овако нешто већ догодило:",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Да ли је неки народ заменио богове",
            "poem": 1
          },
          {
            "text": "ако они и нису богови?",
            "poem": 2
          },
          {
            "text": "А мој народ је заменио своју Славу",
            "poem": 1
          },
          {
            "noteId": 1
          },
          {
            "text": "за оно од чега нема користи!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "О, небеса, ужасните се због овога,",
            "poem": 1
          },
          {
            "text": "згрозите се и опустошите",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Јер је два зла учинио мој народ:",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Заборавио је мене, извор свежих вода,",
            "poem": 1
          },
          {
            "text": "и себи исклесао бунаре,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "напукле бунаре што не држе воду.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Па зар је Израиљ роб, један од оних рођених у кући?",
            "poem": 1
          },
          {
            "text": "Зашто је постао плен?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "На њега ричу лавићи, урличу риком;",
            "poem": 1
          },
          {
            "text": "његову су земљу претворили у пустош,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "његови градови су порушени",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и ту више нико не пребива.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Чак ти је и народ из Нофа и Тафнеса",
            "poem": 1
          },
          {
            "text": "обријао теме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Зар то ниси сам себи урадио",
            "poem": 1
          },
          {
            "text": "напустивши Господа, свог Бога,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "у време када те је водио путем?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "И зато шта ти значи пут египатски",
            "poem": 1
          },
          {
            "text": "да пијеш воду сихорску",
            "poem": 2
          },
          {
            "noteId": 2
          },
          {
            "text": "?",
            "poem": 2
          },
          {
            "text": "И шта ти значи пут асирски",
            "poem": 1
          },
          {
            "text": "да пијеш воду из реке",
            "poem": 2
          },
          {
            "noteId": 3
          },
          {
            "text": "?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Казниће те твоје зло",
            "poem": 1
          },
          {
            "text": "и твоје отпадништво ће те прекорити.",
            "poem": 2
          },
          {
            "text": "Па знај и види, јер је зло и горко",
            "poem": 1
          },
          {
            "text": "што си напустио Господа, свог Бога,",
            "poem": 2
          },
          {
            "text": "и што нема у теби мога страха –",
            "poem": 1
          },
          {
            "text": "говори Господ, Бог над војскама.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Јер ја сам одавно скршио твој јарам",
            "poem": 1
          },
          {
            "text": "и твоје сам окове изломио.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Али ти си рекла: ’Нећу да ти служим.’",
            "poem": 2
          },
          {
            "text": "И на свакој узвишици,",
            "poem": 1
          },
          {
            "text": "и под сваким зеленим дрветом",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "си полегла као блудница.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "А ја, ја сам те посадио као племениту лозу,",
            "poem": 1
          },
          {
            "text": "баш поуздано семе.",
            "poem": 2
          },
          {
            "text": "И како си ми се променила",
            "poem": 1
          },
          {
            "text": "и изродила у вињагу?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Све и да се шалитром переш",
            "poem": 1
          },
          {
            "text": "и да прибавиш много цеђи,",
            "poem": 2
          },
          {
            "text": "штрчаће флека твоје кривице преда мном",
            "poem": 1
          },
          {
            "text": "– говори Господ Бог.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Како онда говориш: ’Нисам оскрнављена",
            "poem": 1
          },
          {
            "text": "и нисам ишла Валима?’",
            "poem": 2
          },
          {
            "text": "Сагледај своје трагове у долини",
            "poem": 1
          },
          {
            "text": "и схвати шта си урадила.",
            "poem": 2
          },
          {
            "text": "Ти си млада и брза камила",
            "poem": 1
          },
          {
            "text": "што тумараш којекуда;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "млада магарица навикла на дивљину",
            "poem": 1
          },
          {
            "text": "што у својој жудњи њуши ветар.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "И ко ће да је врати кад је у терању?",
            "poem": 2
          },
          {
            "text": "Неће малаксати сви који је траже,",
            "poem": 1
          },
          {
            "text": "јер ће је пронаћи у њеном месецу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Не дозволи да ти нога буде боса,",
            "poem": 1
          },
          {
            "text": "да ти грло буде суво.",
            "poem": 2
          },
          {
            "text": "Али ти си рекла: ’Ништа од тога!",
            "poem": 1
          },
          {
            "text": "Не, јер волим туђе богове",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и ићи ћу за њима.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Као лопов што се стиди када га ухвате,",
            "poem": 1
          },
          {
            "text": "тако ће да се осрамоти дом Израиљев.",
            "poem": 2
          },
          {
            "text": "Они – његови цареви, његови главари,",
            "poem": 1
          },
          {
            "text": "његови свештеници и његови пророци –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "који говоре дрвету: ’Ти си мој отац!’",
            "poem": 1
          },
          {
            "text": "И камену: ’Ти си ме родио!’",
            "poem": 2
          },
          {
            "text": "Јер су мени окренули леђа а не лице,",
            "poem": 1
          },
          {
            "text": "а у време своје пропасти ће рећи:",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "’Устани и спаси нас!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Па где су твоји богови које си направио за себе?",
            "poem": 1
          },
          {
            "text": "Нека устану ако могу да те спасу",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "у време твоје пропасти.",
            "poem": 2
          },
          {
            "text": "Јер, колики је број твојих градова –",
            "poem": 1
          },
          {
            "text": "о, Јудо – толико је твојих богова.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Зашто се парничите са мном?",
            "poem": 1
          },
          {
            "text": "Па сви сте се ви побунили против мене",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Узалуд сам ударао твоје синове",
            "poem": 1
          },
          {
            "text": "јер нису прихватили карање,",
            "poem": 2
          },
          {
            "text": "а твој је мач прогутао твоје пророке",
            "poem": 1
          },
          {
            "text": "као кад лав прождире.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "О, нараштају, размотрите реч Господњу:",
          {
            "text": "Зар сам Израиљу био пустиња",
            "poem": 1
          },
          {
            "text": "или земља мрклог мрака?",
            "poem": 2
          },
          {
            "text": "Зашто мој народ говори: ’Наскитасмо се",
            "poem": 1
          },
          {
            "text": "па нећемо поново да ти дођемо’?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Заборавља ли девица свој накит",
            "poem": 1
          },
          {
            "text": "и невеста свој појас?",
            "poem": 2
          },
          {
            "text": "А мој народ заборавља мене",
            "poem": 1
          },
          {
            "text": "данима без броја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Како си добро уредила свој пут да тражиш љубав,",
            "poem": 1
          },
          {
            "text": "да си и покваренице научила својим путевима!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Још се и крв нашла на твојим скутима,",
            "poem": 1
          },
          {
            "text": "све животи убогих и невиних,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "иако их ниси затекла док проваљују.",
            "poem": 2
          },
          {
            "text": "Али за све то ти кажеш:",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "’Ја сам недужна!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Његов се гнев свакако одвратио од мене.’",
            "poem": 2
          },
          {
            "text": "И ево, спорићу се с тобом",
            "poem": 1
          },
          {
            "text": "јер говориш: ’Сагрешила нисам.’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Зашто тако тумарајући",
            "poem": 1
          },
          {
            "text": "мењаш свој пут?",
            "poem": 2
          },
          {
            "text": "И од Египта ћеш се застидети",
            "poem": 1
          },
          {
            "text": "као што си се застидела Асирије.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "И од њега ћеш да одеш",
            "poem": 1
          },
          {
            "text": "с рукама својим на глави својој,",
            "poem": 2
          },
          {
            "text": "јер је Господ одбацио твоје узданице",
            "poem": 1
          },
          {
            "text": "да због њих не напредујеш.",
            "poem": 2
          }
        ]
      }
    ],
