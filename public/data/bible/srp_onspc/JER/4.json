  "book": {
    "id": "JER",
    "translationId": "srp_onspc",
    "name": "Књига пророка Јеремије",
    "commonName": "Књига пророка Јеремије",
    "title": "Књига пророка Јеремије",
    "order": 24,
    "numberOfChapters": 52,
    "sha256": "b33f8d3e722cccfab7e8d8c2e353b57c81d901db98dd37cafca596c2cc88e2e2",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/JER/1.json",
    "lastChapterNumber": 52,
    "lastChapterApiLink": "/api/srp_onspc/JER/52.json",
    "totalNumberOfVerses": 1364
  },
  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "„Ако се вратиш, о, Израиљу",
            "poem": 1
          },
          {
            "text": "– говори Господ – мени се врати;",
            "poem": 2
          },
          {
            "text": "и ако склониш своје гадости од мене",
            "poem": 1
          },
          {
            "text": "нећеш лутати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Заклињаћеш се:",
            "poem": 1
          },
          {
            "text": "’Тако ми живог Господа!’",
            "poem": 2
          },
          {
            "text": "у истини, у правди и у праведности.",
            "poem": 1
          },
          {
            "text": "И благословиће се њиме народи",
            "poem": 2
          },
          {
            "noteId": 5
          },
          {
            "lineBreak": true
          },
          {
            "text": "и њиме ће се хвалити.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Говори Господ Јудејцима и Јерусалиму:",
          {
            "text": "„Узорите своје неузорано тло",
            "poem": 1
          },
          {
            "text": "и не сејте у трње!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Обрежите се Господу",
            "poem": 1
          },
          {
            "text": "и уклоните обреске са својих срца –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "о, Јудејци и становници Јерусалима –",
            "poem": 2
          },
          {
            "text": "да се не би као ватра обрушио мој гнев",
            "poem": 1
          },
          {
            "text": "и распламтео се, а никог нема да гаси због зала ваших дела.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Пропаст са севера"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Објавите у Јуди и у Јерусалиму, најавите и реците:",
            "poem": 1
          },
          {
            "text": "’Затрубите у трубу по земљи!’",
            "poem": 2
          },
          {
            "text": "Испуните је повицима и реците:",
            "poem": 1
          },
          {
            "text": "’Окупимо се!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Хајдемо у утврђене градове!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Подигните заставу према Сиону.",
            "poem": 1
          },
          {
            "text": "Бежите и не стајте!",
            "poem": 2
          },
          {
            "text": "Јер ја са севера доносим пропаст",
            "poem": 1
          },
          {
            "text": "и велико разарање.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Подигао се лав из свог шипражја,",
            "poem": 1
          },
          {
            "text": "затирач народа је кренуо",
            "poem": 2
          },
          {
            "text": "и изашао из свог места,",
            "poem": 1
          },
          {
            "text": "да ти земљу претвори у пустош.",
            "poem": 2
          },
          {
            "text": "А твоји градови ће пасти у руине",
            "poem": 1
          },
          {
            "text": "без становника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Зато опашите кострет,",
            "poem": 1
          },
          {
            "text": "жалите и кукајте,",
            "poem": 2
          },
          {
            "text": "јер се од нас није окренуо",
            "poem": 1
          },
          {
            "text": "пламен Господњег гнева.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "„И тог ће дана – говори Господ –",
            "poem": 1
          },
          {
            "text": "да нестане срчаности у цару и у главарима.",
            "poem": 2
          },
          {
            "text": "Свештеници ће се ужаснути,",
            "poem": 1
          },
          {
            "text": "а пророци пренеразити.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "А ја сам рекао: „Јао, Господе Боже, заиста си сасвим заварао овај народ и Јерусалим говорећи: ’Мир вам припада’, а ево мач је дошао до грла.“"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "У то ће се време рећи овом народу и Јерусалиму: „Зажарени пустињски ветар са оголелих висова дуваће на ћерку мог народа, али не да развеје и очисти."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ветар прејак за све то долази за мене, па ћу сада и ја да им објавим судове.“"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Види! Као облаци он се ваља,",
            "poem": 1
          },
          {
            "text": "као олуја су бојна кола његова",
            "poem": 2
          },
          {
            "text": "и коњи су му од орлова бржи.",
            "poem": 1
          },
          {
            "text": "Тешко нама! Пропадосмо!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Опери од зла своје срце – о, Јерусалиме – да би био спасен.",
            "poem": 1
          },
          {
            "text": "Докле ће у теби да остају мисли твојих злодела?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Јер глас објављује из Дана,",
            "poem": 1
          },
          {
            "text": "најављује невољу из горја Јефремових.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "„Обзнаните народима.",
            "poem": 1
          },
          {
            "text": "Ево, најавите Јерусалиму:",
            "poem": 2
          },
          {
            "text": "’Војници опсадници долазе из далеке земље,",
            "poem": 1
          },
          {
            "text": "да буче покличима против Јудиних градова.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Као стражари на пољу га нападају, опседају га",
            "poem": 1
          },
          {
            "text": "јер се против мене побунио",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Твоји путеви и твоја дела",
            "poem": 1
          },
          {
            "text": "су ти донели ово.",
            "poem": 2
          },
          {
            "text": "Ово је твоја злоба –",
            "poem": 1
          },
          {
            "text": "горко је",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и до срца ти је проникло.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Моја утроба! Моја утроба!",
            "poem": 1
          },
          {
            "text": "Превијам се јер ми срце уздише.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "А моје срце неће да ћути",
            "poem": 2
          },
          {
            "text": "јер је звук трубе који си чула, душо моја,",
            "poem": 1
          },
          {
            "text": "бојни поклич.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Јављају о разарању за разарањем,",
            "poem": 1
          },
          {
            "text": "јер су сву земљу опустошили.",
            "poem": 2
          },
          {
            "text": "Напречац су опустошили моје шаторе",
            "poem": 1
          },
          {
            "text": "и за час моје завесе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Докле ћу да гледам заставу",
            "poem": 1
          },
          {
            "text": "и да слушам звук трубе?",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "„Баш је луд мој народ јер ме не познаје.",
            "poem": 1
          },
          {
            "text": "Они су будаласта, неуразумљена деца.",
            "poem": 2
          },
          {
            "text": "Вешти су да чине зло",
            "poem": 1
          },
          {
            "text": "а не знају да чине добро.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Кад сам погледао по земљи –",
            "poem": 1
          },
          {
            "text": "пустош и празнина.",
            "poem": 2
          },
          {
            "text": "И на небо –",
            "poem": 1
          },
          {
            "text": "остало без свога светла.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Погледао сам брда – а она се тресу;",
            "poem": 1
          },
          {
            "text": "и све узвишице – и оне се љуљају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "Погледао сам – а оно нема ни човека,",
            "poem": 1
          },
          {
            "text": "и све су небеске птице одлетеле.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Погледао сам – плодна долина је била као пустиња;",
            "poem": 1
          },
          {
            "text": "и сви њени градови су били оборени пред Господом",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и пред пламеном његовог гнева.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Јер говори Господ:",
          {
            "text": "„Пустош ће бити по свој земљи,",
            "poem": 1
          },
          {
            "text": "али нећу да је сасвим уништим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Због овога ће земља да тугује",
            "poem": 1
          },
          {
            "text": "и небо ће горе да поцрни.",
            "poem": 2
          },
          {
            "text": "Рекао сам, одлучио сам и нећу се покајати.",
            "poem": 1
          },
          {
            "text": "Не повлачим се од тога.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Од поклича коњаника и стрелаца",
            "poem": 1
          },
          {
            "text": "бежи сав град.",
            "poem": 2
          },
          {
            "text": "Људи се завлаче у честаре",
            "poem": 1
          },
          {
            "text": "и веру се по кршевима.",
            "poem": 2
          },
          {
            "text": "Сваки град је напуштен",
            "poem": 1
          },
          {
            "text": "и у њима нико не пребива.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "А ти – о, похарана – шта ти радиш?",
            "poem": 1
          },
          {
            "text": "Макар се и облачиш у скерлет,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "китиш се златним накитом",
            "poem": 2
          },
          {
            "text": "и бојама бојиш своје очи –",
            "poem": 1
          },
          {
            "text": "узалуд се улепшаваш.",
            "poem": 2
          },
          {
            "text": "Презрели су те твоји љубавници",
            "poem": 1
          },
          {
            "text": "и траже ти главу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Чујем: звучи као жена у боловима,",
            "poem": 1
          },
          {
            "text": "као врисак првороткиње глас је ћерке сионске.",
            "poem": 2
          },
          {
            "text": "Она сопће и шири руке:",
            "poem": 1
          },
          {
            "text": "„Тешко мени јер сам изнурена,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и мој је живот у рукама убица!“",
            "poem": 2
          }
        ]
      }
    ],
