  "chapter": {
    "number": 22,
    "content": [
      {
        "type": "heading",
        "content": [
          "Давидова победничка песма"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Давид је испевао Господу речи ове песме онога дана када га је Господ избавио из руку свих његових непријатеља и из Саулове руке."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Рекао је:",
          {
            "text": "Господе, стено моја,",
            "poem": 1
          },
          {
            "text": "тврђаво моја, избавитељу мој.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Мој Бог је мени стена,",
            "poem": 1
          },
          {
            "text": "где заклон налазим.",
            "poem": 2
          },
          {
            "text": "Штите мој, роже мог спасења,",
            "poem": 1
          },
          {
            "text": "заклоне мој, уточиште моје!",
            "poem": 2
          },
          {
            "text": "Од насиља ти ме избављаш.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Призваћу Господа славе предостојног,",
            "poem": 1
          },
          {
            "text": "и он ће ме спасти од мојих душмана.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Јер, смртни ме таласи окружише,",
            "poem": 1
          },
          {
            "text": "ужаснут сам разорним рекама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ужад су ме Света мртвих опколила,",
            "poem": 1
          },
          {
            "text": "смрт ме вреба са својим замкама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "У невољи завапих Господу,",
            "poem": 1
          },
          {
            "text": "и повиках ка Богу својему.",
            "poem": 2
          },
          {
            "text": "Из свог храма глас је мој чуо,",
            "poem": 1
          },
          {
            "text": "мој вапај стиже до његових ушију.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Тад се земља уздрма, затресе,",
            "poem": 1
          },
          {
            "text": "задрхташе темељи небески,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "стресоше се због његовог гнева.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Дим се диже њему из ноздрва,",
            "poem": 1
          },
          {
            "text": "огањ пламти из његових уста,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "жар угљени из њега избија.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Он небеса пресави и сиђе,",
            "poem": 1
          },
          {
            "text": "под ногама густа му је тама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Херувима узјаха, полете,",
            "poem": 1
          },
          {
            "text": "и заплови на крилима ветра.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Од таме начини око себе шатор,",
            "poem": 1
          },
          {
            "text": "од облака тамних, од зборишта вода.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Од сјаја пред њим угаљ ужарени бљују.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Тада Господ загрме с небеса,",
            "poem": 1
          },
          {
            "text": "разлеже се глас Свевишњега.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Стреле одапе и душмане расу,",
            "poem": 1
          },
          {
            "text": "бљесну муњом, смете их и разби.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Кад је Господ почео да кара,",
            "poem": 1
          },
          {
            "text": "кад му дах из ноздрва плану,",
            "poem": 2
          },
          {
            "text": "долине се морске показаше,",
            "poem": 1
          },
          {
            "text": "открише се темељи света.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Руку пружи са висина, дохвати ме,",
            "poem": 1
          },
          {
            "text": "из вода ме моћних извуче,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "од моћног ме избави душмана,",
            "poem": 1
          },
          {
            "text": "од оних јачих што ме мрзе.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Навалише на мене у дан моје муке,",
            "poem": 1
          },
          {
            "text": "али Господ ми је био ослонац.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Изведе ме на пространо место,",
            "poem": 1
          },
          {
            "text": "избави ме јер сам му по вољи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "Господ ми по правди мојој плати,",
            "poem": 1
          },
          {
            "text": "награди ми чистоћу руку мојих,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "јер путеве Господње сачувах;",
            "poem": 1
          },
          {
            "text": "Богу своме ја нисам скривио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "Судови његови сви су ми пред очима,",
            "poem": 1
          },
          {
            "text": "од одредби његових одвратио се нисам.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Пред њим сам ја био беспрекоран,",
            "poem": 1
          },
          {
            "text": "сачувао сам себе од кривице,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "по правди ме је мојој Господ наградио,",
            "poem": 1
          },
          {
            "text": "моја му је недужност пред очима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Ти вернима исказујеш верност,",
            "poem": 1
          },
          {
            "text": "беспрекорнима узвраћаш поштењем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "С чистима ти поступаш чисто,",
            "poem": 1
          },
          {
            "text": "а с опакима поступаш лукаво.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "Ти избављаш кротак народ,",
            "poem": 1
          },
          {
            "text": "а узносите гледаш да обориш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Јер ти си ми светиљка, Господе,",
            "poem": 1
          },
          {
            "text": "Господ моју таму расветљује.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Јер са тобом ја разбијам чету,",
            "poem": 1
          },
          {
            "text": "с Богом мојим прескачем зидине.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Пут је Божији беспрекоран,",
            "poem": 1
          },
          {
            "text": "реч је Господња у ватри прекаљена;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "штит је свима што у њему уточиште траже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Јер ко је Бог осим Господа?",
            "poem": 1
          },
          {
            "text": "Ко је стена осим нашег Бога?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          {
            "text": "Он је Бог, тврђава моја јака;",
            "poem": 1
          },
          {
            "text": "он пут мој чини беспрекорним.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          {
            "text": "Даде ми ноге хитре ко у кошуте,",
            "poem": 1
          },
          {
            "text": "постави ме чврсто на висине.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          {
            "text": "Руке моје учи војевању,",
            "poem": 1
          },
          {
            "text": "да лук бронзани натежем мишицама.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          {
            "text": "Ти ми дајеш штит спасења свога,",
            "poem": 1
          },
          {
            "text": "твој одазив чини ме великим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "text": "Шириш тло под кораком мојим,",
            "poem": 1
          },
          {
            "text": "да ми ноге не би посрнуле.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          {
            "text": "Душмане своје гоним и таманим,",
            "poem": 1
          },
          {
            "text": "не враћам се док их не докрајчим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          {
            "text": "Затирем их, разбијам, и неће се дићи,",
            "poem": 1
          },
          {
            "text": "и падају под моје ноге.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          {
            "text": "Ти ме опремаш снагом за битку,",
            "poem": 1
          },
          {
            "text": "и обараш пода мном моје противнике.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          {
            "text": "Ти учини да душмани моји",
            "poem": 1
          },
          {
            "text": "реп свој подвију преда мном,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да мрзитеље своје искореним.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          {
            "text": "Погледаше, али им спаса нема ниоткуда;",
            "poem": 1
          },
          {
            "text": "Господу завапише, али он им не одговара.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          {
            "text": "Измрвих их као прах земаљски,",
            "poem": 1
          },
          {
            "text": "изгазих их као блато са улица.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          {
            "text": "Ти ме избави од сукоба с мојим народом,",
            "poem": 1
          },
          {
            "text": "сачувао си ме за главу пуцима.",
            "poem": 2
          },
          {
            "text": "Народ који нисам знао, тај ми народ служи.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          {
            "text": "Туђинци ми ласкају,",
            "poem": 1
          },
          {
            "text": "чим ме чују, они ме слушају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          {
            "text": "Туђинци губе срчаност,",
            "poem": 1
          },
          {
            "text": "из својих тврђава излазе дрхћући.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          {
            "text": "Живео Господ! Благословена била стена моја!",
            "poem": 1
          },
          {
            "text": "Узвишен био Бог, стена мога спасења!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          {
            "text": "То је Бог што ме освећује,",
            "poem": 1
          },
          {
            "text": "он обара народе пода мном;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          {
            "text": "он ме решава мојих душмана.",
            "poem": 1
          },
          {
            "text": "Над мојим си ме мрзитељима узвисио,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "избавио ме од човека насилног.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          {
            "text": "Зато ћу те хвалити, Господе, међу пуцима,",
            "poem": 1
          },
          {
            "text": "твоје ћу име песмом прослављати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 51,
        "content": [
          {
            "text": "Велико спасење даје своме цару;",
            "poem": 1
          },
          {
            "text": "исказује милост помазанику своме, Давиду,",
            "poem": 2
          },
          {
            "text": "и његовом потомству довека.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
