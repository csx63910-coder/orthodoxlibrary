    "name": "Књига пророка Авакума",
    "commonName": "Књига пророка Авакума",
    "title": "Књига пророка Авакума",
    "order": 35,
    "numberOfChapters": 3,
    "sha256": "4317f6159e25fc9b13fdf89319345b32ae2d1cc2d2a1070e9c0e627c8b0d357a",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/HAB/1.json",
    "lastChapterNumber": 3,
    "lastChapterApiLink": "/api/srp_onspc/HAB/3.json",
    "totalNumberOfVerses": 56
  },
  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Пророштво које је видео пророк Авакум:"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Авакумова жалопојка"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "О, Господе, докле да вапим за помоћ,",
            "poem": 1
          },
          {
            "text": "а ти ме не чујеш!",
            "poem": 2
          },
          {
            "text": "Вичем о насиљу,",
            "poem": 1
          },
          {
            "text": "а ти не спасаваш!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Зашто дајеш да гледам поквареност,",
            "poem": 1
          },
          {
            "text": "да видим невољу?",
            "poem": 2
          },
          {
            "text": "Разарање и насиље су пред очима мојим.",
            "poem": 1
          },
          {
            "text": "Ено, и насиље и неслога се дижу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Зато Закон губи снагу,",
            "poem": 1
          },
          {
            "text": "зато правди никада нема места.",
            "poem": 2
          },
          {
            "text": "Злотвор опкољава праведника",
            "poem": 1
          },
          {
            "text": "и зато има места за правду искварену.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Господњи одговор"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "„У народе погледајте,",
            "poem": 1
          },
          {
            "text": "чудите се и дивите,",
            "poem": 2
          },
          {
            "text": "јер, ево, учинићу нешто у ваше дане,",
            "poem": 1
          },
          {
            "text": "у шта не бисте веровали",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да вам ко исприча.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Јер, ево подижем Халдејце,",
            "poem": 1
          },
          {
            "text": "суров и нагао народ",
            "poem": 2
          },
          {
            "text": "да широм земље",
            "poem": 1
          },
          {
            "text": "осваја туђа насеља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Страховит је и ужасан;",
            "poem": 1
          },
          {
            "text": "он одлучује шта је правда,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а шта достојанство.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Коњи су им хитрији од рисова",
            "poem": 1
          },
          {
            "text": "и свирепији од вукова у сумрак.",
            "poem": 2
          },
          {
            "text": "Коњаници им галопирају,",
            "poem": 1
          },
          {
            "text": "долазе издалека њихови коњаници;",
            "poem": 2
          },
          {
            "text": "лете, обрушавају се као лешинар",
            "poem": 1
          },
          {
            "text": "што би да ждере.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Сви долазе због насиља,",
            "poem": 1
          },
          {
            "text": "хорде су им окренуте истоку,",
            "poem": 2
          },
          {
            "text": "а заробљенике сакупљају",
            "poem": 1
          },
          {
            "text": "као да су песак.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Он се руга и царевима",
            "poem": 1
          },
          {
            "text": "и са владарима се шегачи.",
            "poem": 2
          },
          {
            "text": "Сваком се утврђењу смеје",
            "poem": 1
          },
          {
            "text": "док земљане насипе прави и осваја их.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Као ветар тада завиори и мине,",
            "poem": 1
          },
          {
            "text": "али крив је тај коме је божанство његова снага.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Авакумова друга жалопојка"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "О, Господе, зар ти ниси од давнина, мој Боже свети?",
            "poem": 1
          },
          {
            "text": "Нећемо ми умрети!",
            "poem": 2
          },
          {
            "text": "О, Господе, за суд си их одредио.",
            "poem": 1
          },
          {
            "text": "О, Стено, за прекор си их учврстио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Пречисте су очи твоје да би зло проматрале,",
            "poem": 1
          },
          {
            "text": "ти пакост не можеш да гледаш.",
            "poem": 2
          },
          {
            "text": "Зашто онда трпиш невернике,",
            "poem": 1
          },
          {
            "text": "ћутиш док зликовац прождире праведнијег од себе?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Створио си људе као рибе у мору",
            "poem": 1
          },
          {
            "text": "и као гмизавце што владара немају међу собом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "И он их све удицом вади,",
            "poem": 1
          },
          {
            "text": "вуче их својом мрежом",
            "poem": 2
          },
          {
            "text": "и у мрежу их скупља.",
            "poem": 1
          },
          {
            "text": "Зато се и радује и ликује.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Зато својој мрежи жртвује,",
            "poem": 1
          },
          {
            "text": "пали тамјан мрежи својој,",
            "poem": 2
          },
          {
            "text": "јер му она даје мастан оброк",
            "poem": 1
          },
          {
            "text": "и обиље хране.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "И хоће ли због тога да празни мрежу своју,",
            "poem": 1
          },
          {
            "text": "да истрајно сатирате народе без задршке?",
            "poem": 2
          }
        ]
      }
    ],
