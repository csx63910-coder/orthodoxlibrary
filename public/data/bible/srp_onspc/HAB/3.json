    "name": "Књига пророка Авакума",
    "commonName": "Књига пророка Авакума",
    "title": "Књига пророка Авакума",
    "order": 35,
    "numberOfChapters": 3,
    "sha256": "4317f6159e25fc9b13fdf89319345b32ae2d1cc2d2a1070e9c0e627c8b0d357a",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/HAB/1.json",
    "lastChapterNumber": 3,
    "lastChapterApiLink": "/api/srp_onspc/HAB/3.json",
    "totalNumberOfVerses": 56
  },
  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "heading",
        "content": [
          "Авакумова молитва"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Молитва пророка Авакума у облику нарицаљки:",
            "descriptive": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "О, Господе, чуо сам вест о теби",
            "poem": 1
          },
          {
            "text": "и уплашио сам се!",
            "poem": 2
          },
          {
            "text": "О, Господе, оживи дело своје у времену,",
            "poem": 1
          },
          {
            "text": "обнови га усред година,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "сети се да се смилујеш у гневу своме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Са Темана долази Бог",
            "poem": 1
          },
          {
            "text": "и Светитељ са Горе Фарана. Села",
            "poem": 2
          },
          {
            "noteId": 1
          },
          {
            "text": "Величанство његово покрива небеса,",
            "poem": 1
          },
          {
            "text": "а слава његова земљу испуњава.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Његово светло блиста,",
            "poem": 1
          },
          {
            "text": "а у руци му је двокрака муња,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "где је скровиште снаге његове.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Пред њим помор иде,",
            "poem": 1
          },
          {
            "text": "а пошаст га све у стопу прати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Када стане, тад се земља тресе;",
            "poem": 1
          },
          {
            "text": "кад погледа, народи поскачу;",
            "poem": 2
          },
          {
            "text": "растресу се вечити врхови",
            "poem": 1
          },
          {
            "text": "и слежу се брда древна,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер древни су путеви његови.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Видео сам тугу под шаторима Кушана,",
            "poem": 1
          },
          {
            "text": "подрхтавају шаторски застори земље мадијанске.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "О, Господе, јеси ли на реке гневан?",
            "poem": 1
          },
          {
            "text": "Гневиш ли се ти на реке",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "или си на море јаростан?",
            "poem": 2
          },
          {
            "text": "Ево, јездиш на коњима",
            "poem": 1
          },
          {
            "text": "својих бојних кола спасења.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Разоткривен и видно је постављен лук твој,",
            "poem": 1
          },
          {
            "text": "реч заклетве твоје шиба. Села",
            "poem": 2
          },
          {
            "text": "А реке браздају земљу.",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Гледају те, грче се планине,",
            "poem": 2
          },
          {
            "text": "куљају бујичне воде,",
            "poem": 1
          },
          {
            "text": "бездан се јавља хуком својим",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и руке своје високо диже.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Сунце и месец мирују у свом пребивалишту,",
            "poem": 1
          },
          {
            "text": "умину на светло стрела твојих",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и на блесак сјаја твога копља.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ти у љутњи земљу газиш,",
            "poem": 1
          },
          {
            "text": "у јарости ти народе вршеш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Излазиш због спасења свог народа,",
            "poem": 1
          },
          {
            "text": "због спасења помазаника свога дробиш главара зликовачког дома,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "разоткриваш од пете до врата. Села",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Њиховим копљима пробадаш главара њихових ратника,",
            "poem": 1
          },
          {
            "text": "а они јуришају да нас здробе,",
            "poem": 2
          },
          {
            "text": "и ликују као кад у потаји",
            "poem": 1
          },
          {
            "text": "прождиру сиромаха.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Ти газиш по мору коњима својим",
            "poem": 1
          },
          {
            "text": "и пене се велике воде.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "И ја сам то чуо и стомак ми се згрчио,",
            "poem": 1
          },
          {
            "text": "од тог звука ми задрхташе усне,",
            "poem": 2
          },
          {
            "text": "трулеж ми се увуче у кости,",
            "poem": 1
          },
          {
            "text": "а колена ми заклецаше.",
            "poem": 2
          },
          {
            "text": "Смирићу се све до дана невоље",
            "poem": 1
          },
          {
            "text": "што долази на народ који нас напада.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Ако смоква и не пропупи,",
            "poem": 1
          },
          {
            "text": "ако нема на чокоту плода;",
            "poem": 2
          },
          {
            "text": "изневери ли труд око маслине,",
            "poem": 1
          },
          {
            "text": "не роде ли поља храном,",
            "poem": 2
          },
          {
            "text": "нестане ли стадо из тора",
            "poem": 1
          },
          {
            "text": "и ишчезне стока из обора,",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "у Господу ја ћу да ускликнем",
            "poem": 1
          },
          {
            "text": "и веселим се у Богу мог спасења!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Господ Бог је моја снага!",
            "poem": 1
          },
          {
            "text": "Даде ми ноге хитре ко у кошуте,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "по мом кршу даде ми да ходам.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          "Хоровођи уз моје жичане инструменте."
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 1,
        "caller": "+",
        "text": "3,3 Осим на овом месту, на средини 9. и на крају 11. стиха, овај се појам среће седамдесетак пута у псалмима. Његово значење није сигурно и сматра се да је ритмичка одредница.",
        "reference": {
          "chapter": 3,
          "verse": 3
        }
      }
    ]
