  "book": {
    "id": "OBA",
    "translationId": "srp_onspc",
    "name": "Књига пророка Авдије",
    "commonName": "Књига пророка Авдије",
    "title": "Књига пророка Авдије",
    "order": 31,
    "numberOfChapters": 1,
    "sha256": "f9876b4b116073254ce1ac2b495d3762674a195d280e6ffc1c73cd73fd81db54",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/OBA/1.json",
    "lastChapterNumber": 1,
    "lastChapterApiLink": "/api/srp_onspc/OBA/1.json",
    "totalNumberOfVerses": 21
  },
  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "heading",
        "content": [
          "Авдијина визија"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Виђење Авдијино:",
          {
            "lineBreak": true
          },
          "Овако Господ Бог каже о Едому:",
          {
            "lineBreak": true
          },
          {
            "text": "Чули смо вест од Господа",
            "poem": 1
          },
          {
            "text": "и гласник је послан међу народе:",
            "poem": 2
          },
          {
            "text": "„Устаните! Дигнимо се у бој против њега!“",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "„Ево, учинио сам те незнатним међу народима",
            "poem": 1
          },
          {
            "text": "и врло презреним.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Дрскост срца твога те је обманула,",
            "poem": 1
          },
          {
            "text": "ти што живиш у раселини стене,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "становниче горских висина.",
            "poem": 2
          },
          {
            "text": "Говориш у срцу своме:",
            "poem": 1
          },
          {
            "text": "’Ко да ме доле, на земљу сруши?!’",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Све и да се ко орао винеш,",
            "poem": 1
          },
          {
            "text": "своје гнездо међу звезде свијеш,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "стровалићу те ја и оданде",
            "poem": 2
          },
          {
            "text": "– говори Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Ако ти лопови дођу",
            "poem": 1
          },
          {
            "text": "и по ноћи затирачи,",
            "poem": 2
          },
          {
            "text": "зар неће накрасти колико им треба?",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Ако ти дођу берачи грожђа,",
            "poem": 1
          },
          {
            "text": "зар неће оставити за пабирчење?",
            "poem": 2
          },
          {
            "text": "Али ти ћеш бити похаран!",
            "poem": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "О, како ће Исава да претресу!",
            "poem": 1
          },
          {
            "text": "Наћи ће му сва скривена блага.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Све до границе потерали те сви твоји савезници.",
            "poem": 1
          },
          {
            "text": "Обманули су те, надвладали те твоји вајни пријатељи.",
            "poem": 2
          },
          {
            "text": "Ти што твој хлеб једу, испод тебе копају ти јаму,",
            "poem": 1
          },
          {
            "text": "а ти о томе појма немаш.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Нећу ли оног дана – говори Господ –",
            "poem": 1
          },
          {
            "text": "сатрти мудраце едомске",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и учене с горе Исавове?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "О, Темане, препашће се твоји ратници,",
            "poem": 1
          },
          {
            "text": "сви са горе Исавове биће побијени.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Због насиља над Јаковом, братом твојим,",
            "poem": 1
          },
          {
            "text": "прекриће те стид",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и довека сатрвен ћеш бити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Оног дана када си стајао по страни,",
            "poem": 1
          },
          {
            "text": "од дана кад су му туђинци благо заробили,",
            "poem": 2
          },
          {
            "text": "кад незнанци грунуше на врата његова",
            "poem": 1
          },
          {
            "text": "и за Јерусалим жреб бацаше,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ти си био као један од њих.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Ниси смео да посматраш дан брата свога,",
            "poem": 1
          },
          {
            "text": "дан његове коби;",
            "poem": 2
          },
          {
            "text": "ниси смео да ликујеш над народом Јуде,",
            "poem": 1
          },
          {
            "text": "оног дана кад су разорени,",
            "poem": 2
          },
          {
            "text": "и злурадо да се цериш",
            "poem": 1
          },
          {
            "text": "на дан њиног јада.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Ниси смео да прођеш кроз врата мог народа",
            "poem": 1
          },
          {
            "text": "у онај дан њихове пропасти.",
            "poem": 2
          },
          {
            "text": "Ниси смео да посматраш зло њихово",
            "poem": 1
          },
          {
            "text": "у тај кобни дан,",
            "poem": 2
          },
          {
            "text": "да се пружаш за њиховим благом",
            "poem": 1
          },
          {
            "text": "на дан њиног јада.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ниси смео да стојиш на раскршћима,",
            "poem": 1
          },
          {
            "text": "бегунце његове да убијаш,",
            "poem": 2
          },
          {
            "text": "да његове издајеш преживеле",
            "poem": 1
          },
          {
            "text": "у том дану јада.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Близу је дан Господњи",
            "poem": 1
          },
          {
            "text": "свим народима.",
            "poem": 2
          },
          {
            "text": "Шта си чинио, чиниће се теби.",
            "poem": 1
          },
          {
            "text": "Обиће ти се о главу дела твоја.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Јер, као што сте пили на мојој светој гори",
            "poem": 1
          },
          {
            "text": "и сви народи ће истрајно пити.",
            "poem": 2
          },
          {
            "text": "И пиће и гутаће",
            "poem": 1
          },
          {
            "text": "и биће као да их није било.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "А на гори Сион спасење ће бити",
            "poem": 1
          },
          {
            "text": "и биће она светиња,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а дом ће Јаковљев запосести поседе своје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "Ватра ће постати дом Јаковљев,",
            "poem": 1
          },
          {
            "text": "дом Јосифов биће пламен,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а дом Исавов постаће стрњика.",
            "poem": 2
          },
          {
            "text": "И спалиће их, прогутаће их,",
            "poem": 1
          },
          {
            "text": "и неће се спасти нико",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "из дома Исавовог.“",
            "poem": 2
          },
          {
            "text": "Јер тако каже Господ.",
            "poem": 3
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Они из Негева ће освојити гору Исавову,",
            "poem": 1
          },
          {
            "text": "а они из равнице Филистеју.",
            "poem": 2
          },
          {
            "text": "Освојиће и подручје Јефремово и подручје Самарије,",
            "poem": 1
          },
          {
            "text": "а Венијамин ће освојити Галад.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "И изгнаници са бедема народа израиљског",
            "poem": 1
          },
          {
            "text": "наследиће земљу Хананаца до Сарепте.",
            "poem": 2
          },
          {
            "text": "А изгнаници из Јерусалима,",
            "poem": 1
          },
          {
            "text": "који су у Сефарду, запосешће градове Негева.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "И изаћи ће избављени на гору Сион",
            "poem": 1
          },
          {
            "text": "да суде гори Исавовој",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и Царство ће припадати Господу.",
            "poem": 2
          }
        ]
      }
    ],
