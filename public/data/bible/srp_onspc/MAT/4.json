  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "heading",
        "content": [
          "Ђаво искушава Исуса"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Тада је Дух одвео Исуса у пустињу, да га ђаво куша."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Пошто је Исус постио четрдесет дана и четрдесет ноћи, напокон огладне."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Кушач му тада приђе и рече му: „Ако си Син Божији, реци нека ови каменови постану хлебови.“"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Исус му одговори:",
          {
            "text": "„Неће човек живети само од хлеба,",
            "poem": 1
          },
          {
            "text": "већ од сваке речи која излази из Божијих уста.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Онда га је ђаво одвео у Свети град, поставио га на врх храма"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "и рекао му: „Ако си Син Божији, баци се доле јер је у Светом писму написано:",
          {
            "text": "’Он ће заповедити својим анђелима за тебе,",
            "poem": 1
          },
          {
            "text": "да те својим рукама понесу,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да ногом не би о камен запео.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Исус му одговори: „Написано је и ово: ’Не искушавај Господа, Бога свога.’“"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Тада је ђаво опет одвео Исуса на једну веома високу гору, показао му сва светска царства и њихову славу,"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "и рекао му: „Све ћу ти ово дати ако паднеш преда мном и поклониш ми се.“"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Тада му Исус одврати: „Одлази од мене, Сатано! Јер у Писму пише:",
          {
            "text": "’Господу Богу своме клањај се,",
            "poem": 1
          },
          {
            "text": "и њему једином служи.’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ђаво је након овога отишао од Исуса, а анђели су му приступили и служили му."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Почетак Исусовог јавног деловања"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Када је Исус чуо да је Јован одведен у тамницу, повукао се у Галилеју."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Напустио је Назарет и настанио се у Кафарнауму, крај мора, на подручју Завулоновог и Нефталимовог племена,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "да би се испунило оно што је Бог рекао преко пророка Исаије:"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "„Земља завулоновска и земља нефталимска,",
            "poem": 1
          },
          {
            "text": "на путу што води ка мору,",
            "poem": 2
          },
          {
            "text": "с друге стране Јордана,",
            "poem": 1
          },
          {
            "text": "Галилеја многобожачка;",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "народ што у тами седи,",
            "poem": 1
          },
          {
            "text": "велику је светлост угледао,",
            "poem": 2
          },
          {
            "text": "онима што у крају смрти живе,",
            "poem": 1
          },
          {
            "text": "и под њеном сенком седе,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "светлост јарка освану.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Од тада је Исус почео да проповеда и говори: „Покајте се, јер се приближило Царство небеско!“"
        ]
      },
      {
        "type": "heading",
        "content": [
          "Исус изабире себи ученике"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "А када је ишао поред Галилејског језера, Исус виде два брата, Симона, названог Петар, и његовог брата Андрију, како бацају мреже у море. Они су, наиме, били рибари."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Исус им рече: „Пођите за мном и ја ћу вас учинити рибарима људи.“"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Они су одмах оставили мреже и кренули за њим."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Пошавши одатле даље, видео је браћу Јакова и Јована, Заведејеве синове, како у бродићу са својим оцем Заведејем, крпе рибарске мреже, па их позва."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "И они су одмах оставили бродић и свог оца и кренули за њим."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Исус – учитељ и исцелитељ"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Исус је обилазио сву Галилеју. Поучавао је народ у њиховим синагогама, објављивао Радосну вест о Царству и лечио сваку болест и сваку немоћ у народу."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Глас о њему раширио се по свој Сирији. Људи су му доносили све болеснике који су патили од различитих болести и мука, опседнуте злим духовима, оболеле од падавице и непокретне, и он их је излечио."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "За њим је ишло мноштво света из Галилеје, Декапоља, Јерусалима, Јудеје, и с оне стране Јордана."
        ]
      }
    ],
