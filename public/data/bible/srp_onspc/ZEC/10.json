  "chapter": {
    "number": 10,
    "content": [
      {
        "type": "heading",
        "content": [
          "Господ ће да се постара за Јуду"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Тражите од Господа кишу у време пролећне кише.",
            "poem": 1
          },
          {
            "text": "Господ ствара грмљавину и пљускове,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "он даје свакоме растиње по пољу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Јер идоли објављују пакости,",
            "poem": 1
          },
          {
            "text": "сањари виде превару,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "лажне снове распредају.",
            "poem": 2
          },
          {
            "text": "Они таштином теше",
            "poem": 1
          },
          {
            "text": "и зато људи иду као овце,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "ојађени, јер нема пастира.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "„На пастире је планула срџба моја",
            "poem": 1
          },
          {
            "text": "и јарцима ја ћу да судим.",
            "poem": 2
          },
          {
            "text": "Јер Господ над војскама се о свом стаду брине",
            "poem": 1
          },
          {
            "text": "и о дому Јудином.",
            "poem": 2
          },
          {
            "text": "Он ће их учинити",
            "poem": 1
          },
          {
            "text": "својим силним ратним коњем.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Од њега је угаони камен,",
            "poem": 1
          },
          {
            "text": "од њега је клин у зиду;",
            "poem": 2
          },
          {
            "text": "од њега је ратни лук",
            "poem": 1
          },
          {
            "text": "и сваки владар долази од њега.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "И они ће бити као јунаци",
            "poem": 1
          },
          {
            "text": "што у боју газе душмане по блату улица.",
            "poem": 2
          },
          {
            "text": "Бориће се, јер ће Господ бити с њима",
            "poem": 1
          },
          {
            "text": "и посрамиће оне који јашу коње.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Ојачаћу дом Јудин",
            "poem": 1
          },
          {
            "text": "и дом Јосифов избавићу.",
            "poem": 2
          },
          {
            "text": "Обновићу их",
            "poem": 1
          },
          {
            "text": "јер сам им се смиловао.",
            "poem": 2
          },
          {
            "text": "И биће као да их одбацио нисам,",
            "poem": 1
          },
          {
            "text": "јер ја сам Господ,",
            "poem": 2
          },
          {
            "text": "ја сам Бог њихов",
            "poem": 1
          },
          {
            "text": "и ја ћу им се одазвати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Јефремовци ће бити као јунак моћни,",
            "poem": 1
          },
          {
            "text": "срца радоснога као од вина.",
            "poem": 2
          },
          {
            "text": "Деца њихова ће то видети и мило ће им бити.",
            "poem": 1
          },
          {
            "text": "Клицаће им срца у Господу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Зазвиждаћу им",
            "poem": 1
          },
          {
            "text": "и окупићу их.",
            "poem": 2
          },
          {
            "text": "Јер ја сам их откупио",
            "poem": 1
          },
          {
            "text": "и биће их мноштво као што их је мноштво и било.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Расејаћу их међу народе",
            "poem": 1
          },
          {
            "text": "и у далеким крајевима ће ме се сетити.",
            "poem": 2
          },
          {
            "text": "Живеће са својом децом",
            "poem": 1
          },
          {
            "text": "и онда ће се вратити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Вратићу их из египатске земље",
            "poem": 1
          },
          {
            "text": "и из Асирије.",
            "poem": 2
          },
          {
            "text": "Окупићу их у галадској земљи",
            "poem": 1
          },
          {
            "text": "и на Ливан довешћу их.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Неће за њих бити довољно места.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Кроз море олује ће проћи",
            "poem": 1
          },
          {
            "text": "и примириће морске таласе.",
            "poem": 2
          },
          {
            "text": "Осушиће дубине Нила,",
            "poem": 1
          },
          {
            "text": "понизиће понос Асирије,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а жезло ће египатско нестати.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Оснажићу их, ја Господ,",
            "poem": 1
          },
          {
            "text": "и у мом имену ће они корачати",
            "poem": 2
          },
          {
            "text": "– говори Господ.“",
            "poem": 3
          }
        ]
      }
    ],
