  "book": {
    "id": "ZEC",
    "translationId": "srp_onspc",
    "name": "Књига пророка Захарије",
    "commonName": "Књига пророка Захарије",
    "title": "Књига пророка Захарије",
    "order": 38,
    "numberOfChapters": 14,
    "sha256": "e899511d8cefb88923aad95e9d226d1f674cf87f07f7f82a9ae69c89e1d32977",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/ZEC/1.json",
    "lastChapterNumber": 14,
    "lastChapterApiLink": "/api/srp_onspc/ZEC/14.json",
    "totalNumberOfVerses": 211
  },
  "chapter": {
    "number": 11,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "О, Ливане, врата своја отвори",
            "poem": 1
          },
          {
            "text": "да прождере огањ твоје кедре!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Јадикуј, чемпресу, јер је пао кедар.",
            "poem": 1
          },
          {
            "text": "Та су моћна стабла уништена.",
            "poem": 2
          },
          {
            "text": "Јадикујте, храстови Васана,",
            "poem": 1
          },
          {
            "text": "јер је оборена густа шума.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Ево јаука пастирског ридања",
            "poem": 1
          },
          {
            "text": "јер је ојађен њихов сјај.",
            "poem": 2
          },
          {
            "text": "Ево јеке рикања лавића",
            "poem": 1
          },
          {
            "text": "јер су опустошени јордански честари.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Два пастира"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Овако каже Господ, мој Бог: „Напасај стадо које је за клање."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Купци њихови их кољу и не мисле да су криви. А они који их продају говоре: ’Благословен Господ! Обогатио сам се.’ Њихови пастири су немилосрдни према њима."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Зато ни ја више нећу да се смилујем на становнике земље – говори Господ. Ево, предајем свакога у руке његовог ближњег и у руке његовог цара. Они ће сатрти земљу, а ја нећу да их избавим из њихових руку.“"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "И ја сам напасао стадо за клање, баш оне најнезнатније у стаду. Узео сам два штапа. Један сам назвао „Благост“, а други сам назвао „Слога“, па сам напасао стадо."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Онда сам за месец дана збрисао три пастира јер су ми се смучили, а и ја сам њима огадио."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Онда сам рекао: „Нећу више да вас напасам! Нека скапа овца која је за смрт и нека пропадне која је за пропаст. А оне које преживе нека глођу једна другу.“"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Елем, узео сам „Благост“, свој штап, и преломио га. Тако сам раскинуо свој савез који сам склопио са свим народима."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Тог дана је био сломљен, па су и најнезнатнији у стаду, они што су у мене гледали, знали да је ова реч била од Господа."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Рекао сам им: „Ако је право у вашим очима ви ми дајте моју надницу. А ако није, не дајте ми.“ Онда су ми одмерили надницу од тридесет сребрњака."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Господ ми је рекао: „Баци грнчару ту силну вредност којом су ме проценили!“ И ја сам узео од њих тридесет сребрњака и бацио их грнчару Дома Господњег."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Затим сам преломио „Слогу“, свој други штап, и тако прекинуо братство између Јуде и Израиља."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Господ ми је казао: „Поново узми опрему безумног пастира."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Јер, ево, подижем у земљи пастира који неће марити за оне што скапавају, неће тражити залутале, неће лечити рањене, неће водити врлудаве. Он ће јести месо угојених оваца и кидаће им папке."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Јао безумном пастиру",
            "poem": 1
          },
          {
            "text": "који напушта стадо!",
            "poem": 2
          },
          {
            "text": "Мач му је над руком и над десним оком.",
            "poem": 1
          },
          {
            "text": "Рука му се сасвим осушила,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "десно му се око сасвим замутило!“",
            "poem": 2
          }
        ]
      }
    ],
