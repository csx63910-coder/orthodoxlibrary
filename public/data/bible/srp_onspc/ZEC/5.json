          "verse": 6
        }
      },
      {
        "noteId": 3,
        "caller": "+",
        "text": "5,6 У Септуагинти и сиријском рукопису стоји њихова грешност.",
        "reference": {
          "chapter": 5,
          "verse": 6
        }
      }
    ]
