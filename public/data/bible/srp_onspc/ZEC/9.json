  "chapter": {
    "number": 9,
    "content": [
      {
        "type": "heading",
        "content": [
          "Суд над непријатељима Израиља"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Пророштво:",
          {
            "lineBreak": true
          },
          {
            "text": "Реч Господња о земљи Адраху и о Дамаску,",
            "poem": 1
          },
          {
            "text": "одморишту његовом –",
            "poem": 2
          },
          {
            "text": "јер су на Господу очи света",
            "poem": 1
          },
          {
            "text": "и свих племена Израиља –",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "затим о Амату, који се граничи са њим,",
            "poem": 1
          },
          {
            "text": "као и о Тиру и о Сидону, јер су веома мудри.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Наиме, Тир је себи сазидао утврђење,",
            "poem": 1
          },
          {
            "text": "згрнуо је сребра као прашине",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и злата као блата са улица.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Гле! Господ ће га развластити,",
            "poem": 1
          },
          {
            "text": "у море ће бацати бедем његов,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а њега ће самог пламен да прогута.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Видеће то Аскалон па ће се препасти,",
            "poem": 1
          },
          {
            "text": "а Газа ће се згрчити од јаког бола,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "баш као и Акарон чија ће се нада обрукати.",
            "poem": 2
          },
          {
            "text": "Пострадаће цар Газе,",
            "poem": 1
          },
          {
            "text": "а у Аскалону никог неће бити.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Мешанци ће насељавати Азот",
            "poem": 1
          },
          {
            "text": "јер ћу Филистејцима да сломим понос.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Узећу им крв њихових гадости из уста,",
            "poem": 1
          },
          {
            "text": "између њихових зуба.",
            "poem": 2
          },
          {
            "text": "А остатак ће бити нашем Богу",
            "poem": 1
          },
          {
            "text": "као достојанственик у Јуди,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а Акарон ће бити попут Јевусејца.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Храму свом ћу на стражу да се поставим због војске,",
            "poem": 1
          },
          {
            "text": "због оних што пролазе и долазе.",
            "poem": 2
          },
          {
            "text": "Душман више неће да га гази",
            "poem": 1
          },
          {
            "text": "јер сада сам очима својим видео то.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Долазак цара Сиона"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Кличи радосно, о, ћерко сионска!",
            "poem": 1
          },
          {
            "text": "Подвикуј од среће, о, ћерко јерусалимска!",
            "poem": 2
          },
          {
            "text": "Ево, Цар твој к теби долази!",
            "poem": 1
          },
          {
            "text": "Праведан је и спасава.",
            "poem": 2
          },
          {
            "text": "Он је кротак и јаше на магарцу и на магарету,",
            "poem": 1
          },
          {
            "text": "младунцу магарице.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Уклонићу из Јефрема бојна кола",
            "poem": 1
          },
          {
            "text": "и коње из Јерусалима.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Изломићу ратне лукове",
            "poem": 2
          },
          {
            "text": "и он ће објавити мир народима,",
            "poem": 1
          },
          {
            "text": "владаће од мора до мора",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и од Еуфрата",
            "poem": 2
          },
          {
            "noteId": 5
          },
          {
            "text": "до крајева где земља престаје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Још ћу ти због крви твог савеза",
            "poem": 1
          },
          {
            "text": "ослободити твоје заробљенике из безводне јаме.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "О, затвореници,",
            "poem": 1
          },
          {
            "text": "у нади се вратите у утврђење!",
            "poem": 2
          },
          {
            "text": "Још тога ћу дана да објавим:",
            "poem": 1
          },
          {
            "text": "„Враћам ти двоструко.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Напећу себи Јуду као лук",
            "poem": 1
          },
          {
            "text": "и напунићу га Јефремом.",
            "poem": 2
          },
          {
            "text": "Подићи ћу твоје синове, Сионе",
            "poem": 1
          },
          {
            "text": "на синове твоје, Грчко.",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Учинићу те, Сионе, да си као мач ратника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Господ долази"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Господ ће се јавити над њима",
            "poem": 1
          },
          {
            "text": "и сукнуће као муња стрела његова.",
            "poem": 2
          },
          {
            "text": "Господ Бог ће зајечати трубом",
            "poem": 1
          },
          {
            "text": "и хујаће у вихорима с југа.",
            "poem": 2
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Господ над војскама ће бити заштита над њима,",
            "poem": 2
          },
          {
            "text": "па ће разарати",
            "poem": 1
          },
          {
            "text": "и обараће камењем из праћке.",
            "poem": 2
          },
          {
            "text": "Пиће и викаће као винопије",
            "poem": 1
          },
          {
            "text": "и биће пуни као пехар,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "као углови жртвеника.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Тога дана ће их избавити њихов Господ Бог",
            "poem": 1
          },
          {
            "text": "као стадо свог народа,",
            "poem": 2
          },
          {
            "text": "и они ће блистати као драгуљи из круне",
            "poem": 1
          },
          {
            "text": "над његовом земљом.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Какво је добро његово!",
            "poem": 1
          },
          {
            "text": "Каква је лепота његова!",
            "poem": 2
          },
          {
            "text": "Од жита ће бујати младићи",
            "poem": 1
          },
          {
            "text": "и девојке од шире.",
            "poem": 2
          }
        ]
      }
    ],
