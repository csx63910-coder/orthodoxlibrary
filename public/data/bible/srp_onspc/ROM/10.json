    "order": 45,
    "numberOfChapters": 16,
    "sha256": "0ba4ab6fcf54cc62e2802dd7e781eede1ea872b403d3310badb222dbe7b4c0de",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/ROM/1.json",
