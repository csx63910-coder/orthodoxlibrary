  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "heading",
        "content": [
          "Војска скакаваца"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Затрубите трубом на Сиону!",
            "poem": 1
          },
          {
            "text": "Повичите на мојој светој гори!",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "Нека задрхте сви становници земље.",
            "poem": 1
          },
          {
            "text": "Долази дан Господњи",
            "poem": 2
          },
          {
            "text": "и баш је близу!",
            "poem": 1
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Дан тамни и суморни,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "дан облака и густе таме.",
            "poem": 2
          },
          {
            "text": "Ко што се свитање шири преко брда,",
            "poem": 1
          },
          {
            "text": "такав је народ велики и моћни",
            "poem": 2
          },
          {
            "text": "каквог од давнина није било",
            "poem": 1
          },
          {
            "text": "и неће га бити годинама,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "из нараштаја у нараштај.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Пред њим ватра прождире,",
            "poem": 1
          },
          {
            "text": "а за њим спаљује пламен.",
            "poem": 2
          },
          {
            "text": "Пред њим је земља као врт еденски,",
            "poem": 1
          },
          {
            "text": "а за њим опустошена дивљина",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и нико му утекао није.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Лицем су слични лицима коња",
            "poem": 1
          },
          {
            "text": "и јуре као коњаници.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Тутње као бојна кола",
            "poem": 1
          },
          {
            "text": "кад врх гора поскакују;",
            "poem": 2
          },
          {
            "text": "праскају ко пламен ватре што стрњику гута,",
            "poem": 1
          },
          {
            "text": "као народ моћан што се за бој постројава.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Народи пред њима дрхте,",
            "poem": 1
          },
          {
            "text": "зажари се свако лице.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Трче као ратници,",
            "poem": 1
          },
          {
            "text": "ко борци се уз зидине пењу;",
            "poem": 2
          },
          {
            "text": "и сваки својим путем иде,",
            "poem": 1
          },
          {
            "text": "стазе своје не мењају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Један другог не саплићу,",
            "poem": 1
          },
          {
            "text": "својим путем корачају",
            "poem": 2
          },
          {
            "text": "и неће стати,",
            "poem": 1
          },
          {
            "text": "све и да на оружје насрну.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Вршљају по граду,",
            "poem": 1
          },
          {
            "text": "по зидинама трче,",
            "poem": 2
          },
          {
            "text": "у куће се пењу",
            "poem": 1
          },
          {
            "text": "и кроз прозоре проваљују попут лопова.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Пред њима земља дрхти",
            "poem": 1
          },
          {
            "text": "и небеса се потресају;",
            "poem": 2
          },
          {
            "text": "помрачују се сунце и месец,",
            "poem": 1
          },
          {
            "text": "а звезде гасну сјајем својим.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "А Господ ће глас свој да дигне",
            "poem": 1
          },
          {
            "text": "пред војском својом",
            "poem": 2
          },
          {
            "text": "јер је табор његов врло велик;",
            "poem": 1
          },
          {
            "text": "јер су моћни они што реч његову чине;",
            "poem": 2
          },
          {
            "text": "јер је велик и веома страшан дан Господњи,",
            "poem": 1
          },
          {
            "text": "ко да га издржи?",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Раздирање срца"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "„Зато сада – говори Господ –",
            "poem": 1
          },
          {
            "text": "вратите ми се свим срцем својим,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "у посту, жаљењу и вапају.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Срца своја раздерите,",
            "poem": 1
          },
          {
            "text": "а не одећу своју!",
            "poem": 2
          },
          {
            "text": "Вратите се Господу, Богу своме,",
            "poem": 1
          },
          {
            "text": "јер је милосрдан и милостив;",
            "poem": 2
          },
          {
            "text": "спор на срџбу, богат милосрђем",
            "poem": 1
          },
          {
            "text": "и сажаљив на несрећу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Ко зна? Можда се одврати, предомисли,",
            "poem": 1
          },
          {
            "text": "па за собом остави благослов –",
            "poem": 2
          },
          {
            "text": "житну жртву и изливницу за Господа, вашег Бога.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Затрубите трубом на Сиону!",
            "poem": 1
          },
          {
            "text": "Свети пост прогласите,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "позовите свечани сабор!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Окупите народ",
            "poem": 1
          },
          {
            "text": "и посветите збор.",
            "poem": 2
          },
          {
            "text": "Окупите старешине,",
            "poem": 1
          },
          {
            "text": "децу и одојчад.",
            "poem": 2
          },
          {
            "text": "Нека младожења изађе из своје собе",
            "poem": 1
          },
          {
            "text": "и млада из одаје своје.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Нека свештеници, слуге Господње,",
            "poem": 1
          },
          {
            "text": "плачу између трема и жртвеника.",
            "poem": 2
          },
          {
            "text": "Нека кажу: „Господе, поштеди свој народ!",
            "poem": 1
          },
          {
            "text": "Не дај срамоту на наследство своје,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "да му се ругају народи.",
            "poem": 2
          },
          {
            "text": "Зашто да се говори међу народима:",
            "poem": 1
          },
          {
            "text": "’Где је Бог њихов?’“",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Господњи одговор"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "И Господ ће да ревнује за своју земљу",
            "poem": 1
          },
          {
            "text": "и поштеди свој народ.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Одговориће Господ свом народу и рећи ће му:",
          {
            "text": "„Ево, даћу вам жита, вина и уља",
            "poem": 1
          },
          {
            "text": "да се тиме наситите.",
            "poem": 2
          },
          {
            "text": "И више вас нећу чинити руглом међу народима.",
            "poem": 1
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "Далеко од вас отераћу тог са севера.",
            "poem": 1
          },
          {
            "text": "Расејаћу га у земљу пусту и безводну:",
            "poem": 2
          },
          {
            "text": "лице његово према мору на исток,",
            "poem": 1
          },
          {
            "text": "и његов крај према мору на запад.",
            "poem": 2
          },
          {
            "text": "Дизаће се његов смрад,",
            "poem": 1
          },
          {
            "text": "шириће се његова трулеж,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер је велике ствари урадио.“",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "О, земљо, не страхуј!",
            "poem": 1
          },
          {
            "text": "Радуј се и весели јер је Господ велике ствари урадио!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "Не бојте се, о, пољске звери,",
            "poem": 1
          },
          {
            "text": "јер се зелене пашњаци пустињски",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и стабла рађају свој плод.",
            "poem": 2
          },
          {
            "text": "Смоква и чокот су дали обиље своје.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "И ви, народе сионски,",
            "poem": 1
          },
          {
            "text": "радујте се и веселите у Господу, своме Богу,",
            "poem": 2
          },
          {
            "text": "јер вам је дао учитеља праведности.",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "Излио вам је ра̂ну, јесењу кишу",
            "poem": 1
          },
          {
            "text": "и позну, пролећну кишу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "Гумна биће пуна жита,",
            "poem": 1
          },
          {
            "text": "вином и уљем ће се преливати каце.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "„Надокнадићу вам године које су појели скакавци,",
            "poem": 1
          },
          {
            "text": "црви, гусенице и губари,",
            "poem": 2
          },
          {
            "text": "та моја велика војска коју сам послао међу вас.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "И јешћете обилно и наситићете се.",
            "poem": 1
          },
          {
            "text": "Славићете име Господа, свога Бога,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "који вам је учинио чудесне ствари.",
            "poem": 2
          },
          {
            "text": "Неће се стидети мој народ довека.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "Схватићете да сам ја усред Израиља,",
            "poem": 1
          },
          {
            "text": "да сам ја, Господ, ваш Бог",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "и да другог нема!",
            "poem": 2
          },
          {
            "text": "И неће се стидети мој народ довека.",
            "poem": 1
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Дан Господњи"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "А након тога",
            "poem": 1
          },
          {
            "text": "излићу на све људе свога Духа,",
            "poem": 2
          },
          {
            "text": "па ће ваши синови и ћерке пророковати,",
            "poem": 1
          },
          {
            "text": "старци ће сањати снове,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а млади људи имати виђења.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Такође ћу у оне дане",
            "poem": 1
          },
          {
            "text": "излити свога Духа на слуге и слушкиње.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          {
            "text": "Учинићу да се покажу чудне појаве",
            "poem": 1
          },
          {
            "text": "на небу и на земљи –",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "крв, ватра и облаци дима.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          {
            "text": "Сунце ће потамнети,",
            "poem": 1
          },
          {
            "text": "а месец поцрвенети као крв",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "пре него што дође велики и славни дан Господњи.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          {
            "text": "Свако ко зазове име Господње,",
            "poem": 1
          },
          {
            "text": "биће спасен.",
            "poem": 2
          },
          {
            "text": "Јер ће на гори Сион и у Јерусалиму",
            "poem": 1
          },
          {
            "text": "бити спасење,",
            "poem": 2
          },
          {
            "text": "баш како је рекао Господ,",
            "poem": 1
          },
          {
            "text": "и од остатка који Господ позове.",
            "poem": 2
          }
        ]
      }
    ],
    "footnotes": []
  },
