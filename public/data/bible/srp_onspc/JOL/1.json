  "book": {
    "id": "JOL",
    "translationId": "srp_onspc",
    "name": "Књига пророка Јоила",
    "commonName": "Књига пророка Јоила",
    "title": "Књига пророка Јоила",
    "order": 29,
    "numberOfChapters": 3,
    "sha256": "0228cd4a4f5c9951695b375ca08b826472583b0b8e1809c83aad9eb08413abf3",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/srp_onspc/JOL/1.json",
    "lastChapterNumber": 3,
    "lastChapterApiLink": "/api/srp_onspc/JOL/3.json",
    "totalNumberOfVerses": 73
  },
  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ово је Господња реч која је дошла Јоилу, Фатуиловом сину."
        ]
      },
      {
        "type": "heading",
        "content": [
          "Најезда скакаваца"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Чујте ово, о, старешине;",
            "poem": 1
          },
          {
            "text": "послушајте, сви становници земаљски:",
            "poem": 2
          },
          {
            "text": "Зар се ово догодило у данима вашим",
            "poem": 1
          },
          {
            "text": "или у данима ваших предака?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Причајте о овом својој деци,",
            "poem": 1
          },
          {
            "text": "ваша деца својој деци",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а њихова деца новом поколењу.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Остатке губара појешће скакавци;",
            "poem": 1
          },
          {
            "text": "остатке скакаваца појешће црви;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "остатке црва појешће гусенице!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Пробудите се, о, ви пијани!",
            "poem": 1
          },
          {
            "text": "Заплачите и закукајте, винопије, због шире,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "зато што вам се од уста отела!",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Јер на моју земљу изађе народ силан",
            "poem": 1
          },
          {
            "text": "и броја им нема.",
            "poem": 2
          },
          {
            "text": "Зуби су им као лављи зуби,",
            "poem": 1
          },
          {
            "text": "а очњаци као у лавице.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Моју је лозу почупао,",
            "poem": 1
          },
          {
            "text": "моју је смокву изломио;",
            "poem": 2
          },
          {
            "text": "потпуно је оголио и бацио,",
            "poem": 1
          },
          {
            "text": "младице јој огулио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Наричи као млада жена",
            "poem": 1
          },
          {
            "text": "огрнута у кострет за мужем своје младости.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Нестале су житна жртва и изливница",
            "poem": 1
          },
          {
            "text": "из Дома Господњег.",
            "poem": 2
          },
          {
            "text": "У жалости су свештеници,",
            "poem": 1
          },
          {
            "text": "слуге Господње.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Поља су опустошена",
            "poem": 1
          },
          {
            "text": "и земља је у жалости",
            "poem": 2
          },
          {
            "text": "јер је жито сатрвено,",
            "poem": 1
          },
          {
            "text": "младо вино је пресахло,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а урод уља је подбацио.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "Стидите се, ратари,",
            "poem": 1
          },
          {
            "text": "кукајте, виноградари, за пшеницом и за јечмом,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер је пропала жетва на њиви.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "Лоза је пресахнула,",
            "poem": 1
          },
          {
            "text": "стабло смокве се спарушило.",
            "poem": 2
          },
          {
            "text": "Пресахнули су нар, палма, јабука",
            "poem": 1
          },
          {
            "text": "и сва стабла по пољу,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер је пресахла радост синова људских.",
            "poem": 2
          }
        ]
      },
      {
        "type": "heading",
        "content": [
          "Позив на пост и молитву"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "О, свештеници, опашите се и плачите!",
            "poem": 1
          },
          {
            "text": "Жалите, слуге жртвеника!",
            "poem": 2
          },
          {
            "text": "Дођите, слуге Бога мога,",
            "poem": 1
          },
          {
            "text": "ноћ пробдите у кострети",
            "poem": 2
          },
          {
            "text": "јер је из Дома Бога вашег",
            "poem": 1
          },
          {
            "text": "нестало житне жртве и изливнице.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "Свети пост прогласите,",
            "poem": 1
          },
          {
            "text": "позовите свечани сабор!",
            "poem": 2
          },
          {
            "text": "Окупите све старешине,",
            "poem": 1
          },
          {
            "text": "становнике земље у Дому Господа,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "вашег Бога, па вапите Господу!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Јао, каквог ли дана,",
            "poem": 1
          },
          {
            "text": "јер је близу дан Господњи",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "што долази као пустошење од Свемоћнога!",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "Зар нам није пред очима понестала храна",
            "poem": 1
          },
          {
            "text": "и радости и весеља из Дома нашег Бога?",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "Угнилише смокве на венцима;",
            "poem": 1
          },
          {
            "text": "опустошене су житнице;",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "порушени су амбари јер је жито пропало.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "О, како стока риче!",
            "poem": 1
          },
          {
            "text": "Тумарају крда говеда",
            "poem": 2
          },
          {
            "text": "јер испаше за њих нема,",
            "poem": 1
          },
          {
            "text": "а и стада оваца такође скапавају.",
            "poem": 2
          }
        ]
      },
      {
        "type": "line_break"
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Господе, ја тебе призивам",
            "poem": 1
          },
          {
            "text": "јер је пламен суше прогутао пустињске пашњаке,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "а пожар је спалио све пољско дрвеће.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "И пољске звери ти цвиле и жуде",
            "poem": 1
          },
          {
            "text": "јер су пресушила водена врела,",
            "poem": 2
          },
          {
            "lineBreak": true
          },
          {
            "text": "јер је пожар спалио пустињске пашњаке.",
            "poem": 2
          }
        ]
      }
    ],
