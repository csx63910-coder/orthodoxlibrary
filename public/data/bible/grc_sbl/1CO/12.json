    "order": 46,
    "numberOfChapters": 16,
    "sha256": "b48faa699405426ea3402b5d44335232f0031dff04ac6a6de92f7f86bca69a4f",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_sbl/1CO/1.json",
