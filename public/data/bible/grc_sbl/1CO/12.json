  "chapter": {
    "number": 12,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Περὶ δὲ τῶν πνευματικῶν, ἀδελφοί, οὐ θέλω ὑμᾶς ἀγνοεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "οἴδατε ὅτι ὅτε ἔθνη ἦτε πρὸς τὰ εἴδωλα τὰ ἄφωνα ὡς ἂν ἤγεσθε ἀπαγόμενοι."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "διὸ γνωρίζω ὑμῖν ὅτι οὐδεὶς ἐν πνεύματι θεοῦ λαλῶν λέγει· Ἀνάθεμα ⸀Ἰησοῦς",
          {
            "noteId": 216
          },
          "καὶ οὐδεὶς δύναται εἰπεῖν· ⸂Κύριος Ἰησοῦς",
          {
            "noteId": 217
          },
          "εἰ μὴ ἐν πνεύματι ἁγίῳ."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Διαιρέσεις δὲ χαρισμάτων εἰσίν, τὸ δὲ αὐτὸ πνεῦμα·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ διαιρέσεις διακονιῶν εἰσιν, καὶ ὁ αὐτὸς κύριος·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ διαιρέσεις ἐνεργημάτων εἰσίν, ⸂ὁ δὲ",
          {
            "noteId": 218
          },
          "⸀αὐτὸς",
          {
            "noteId": 219
          },
          "θεός, ὁ ἐνεργῶν τὰ πάντα ἐν πᾶσιν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἑκάστῳ δὲ δίδοται ἡ φανέρωσις τοῦ πνεύματος πρὸς τὸ συμφέρον."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ᾧ μὲν γὰρ διὰ τοῦ πνεύματος δίδοται λόγος σοφίας, ἄλλῳ δὲ λόγος γνώσεως κατὰ τὸ αὐτὸ πνεῦμα,"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "⸀ἑτέρῳ",
          {
            "noteId": 220
          },
          "πίστις ἐν τῷ αὐτῷ πνεύματι, ⸀ἄλλῳ",
          {
            "noteId": 221
          },
          "χαρίσματα ἰαμάτων ἐν τῷ ⸀ἑνὶ",
          {
            "noteId": 222
          },
          "πνεύματι,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "⸀ἄλλῳ",
          {
            "noteId": 223
          },
          "ἐνεργήματα δυνάμεων, ⸁ἄλλῳ",
          {
            "noteId": 224
          },
          "προφητεία, ⸀1ἄλλῳ",
          {
            "noteId": 225
          },
          "διακρίσεις πνευμάτων, ⸀ἑτέρῳ",
          {
            "noteId": 226
          },
          "γένη γλωσσῶν, ⸀2ἄλλῳ",
          {
            "noteId": 227
          },
          "ἑρμηνεία γλωσσῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "πάντα δὲ ταῦτα ἐνεργεῖ τὸ ἓν καὶ τὸ αὐτὸ πνεῦμα, διαιροῦν ἰδίᾳ ἑκάστῳ καθὼς βούλεται."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Καθάπερ γὰρ τὸ σῶμα ἕν ἐστιν καὶ μέλη ⸂πολλὰ ἔχει",
          {
            "noteId": 228
          },
          ", πάντα δὲ τὰ μέλη τοῦ ⸀σώματος",
          {
            "noteId": 229
          },
          "πολλὰ ὄντα ἕν ἐστιν σῶμα, οὕτως καὶ ὁ Χριστός·"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ γὰρ ἐν ἑνὶ πνεύματι ἡμεῖς πάντες",
          {
            "noteId": 230
          },
          "εἰς ἓν σῶμα ἐβαπτίσθημεν, εἴτε Ἰουδαῖοι εἴτε Ἕλληνες, εἴτε δοῦλοι εἴτε ἐλεύθεροι, καὶ ⸀πάντες ἓν πνεῦμα ἐποτίσθημεν."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Καὶ γὰρ τὸ σῶμα οὐκ ἔστιν ἓν μέλος ἀλλὰ πολλά."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ἐὰν εἴπῃ ὁ πούς· Ὅτι οὐκ εἰμὶ χείρ, οὐκ εἰμὶ ἐκ τοῦ σώματος, οὐ παρὰ τοῦτο οὐκ ἔστιν ἐκ τοῦ σώματος;"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ ἐὰν εἴπῃ τὸ οὖς· Ὅτι οὐκ εἰμὶ ὀφθαλμός, οὐκ εἰμὶ ἐκ τοῦ σώματος, οὐ παρὰ τοῦτο οὐκ ἔστιν ἐκ τοῦ σώματος·"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "εἰ ὅλον τὸ σῶμα ὀφθαλμός, ποῦ ἡ ἀκοή; εἰ ὅλον ἀκοή, ποῦ ἡ ὄσφρησις;"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "⸀νυνὶ",
          {
            "noteId": 231
          },
          "δὲ ὁ θεὸς ἔθετο τὰ μέλη, ἓν ἕκαστον αὐτῶν, ἐν τῷ σώματι καθὼς ἠθέλησεν."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "εἰ δὲ ἦν τὰ πάντα ἓν μέλος, ποῦ τὸ σῶμα;"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "νῦν δὲ πολλὰ ⸀μὲν",
          {
            "noteId": 232
          },
          "μέλη, ἓν δὲ σῶμα."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "οὐ δύναται δὲ ὁ ὀφθαλμὸς εἰπεῖν τῇ χειρί· Χρείαν σου οὐκ ἔχω, ἢ πάλιν ἡ κεφαλὴ τοῖς ποσίν· Χρείαν ὑμῶν οὐκ ἔχω·"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ἀλλὰ πολλῷ μᾶλλον τὰ δοκοῦντα μέλη τοῦ σώματος ἀσθενέστερα ὑπάρχειν ἀναγκαῖά ἐστιν,"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "καὶ ἃ δοκοῦμεν ἀτιμότερα εἶναι τοῦ σώματος, τούτοις τιμὴν περισσοτέραν περιτίθεμεν, καὶ τὰ ἀσχήμονα ἡμῶν εὐσχημοσύνην περισσοτέραν ἔχει,"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "τὰ δὲ εὐσχήμονα ἡμῶν οὐ χρείαν ⸀ἔχει",
          {
            "noteId": 233
          },
          "ἀλλὰ ὁ θεὸς συνεκέρασεν τὸ σῶμα, τῷ ⸀ὑστεροῦντι",
          {
            "noteId": 234
          },
          "περισσοτέραν δοὺς τιμήν,"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ἵνα μὴ ᾖ ⸀σχίσμα",
          {
            "noteId": 235
          },
          "ἐν τῷ σώματι, ἀλλὰ τὸ αὐτὸ ὑπὲρ ἀλλήλων μεριμνῶσι τὰ μέλη."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "καὶ ⸀εἴτε",
          {
            "noteId": 236
          },
          "πάσχει ἓν μέλος",
          {
            "noteId": 237
          },
          "συμπάσχει πάντα τὰ μέλη· εἴτε δοξάζεται ⸀μέλος, συγχαίρει πάντα τὰ μέλη."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Ὑμεῖς δέ ἐστε σῶμα Χριστοῦ καὶ μέλη ἐκ μέρους."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "καὶ οὓς μὲν ἔθετο ὁ θεὸς ἐν τῇ ἐκκλησίᾳ πρῶτον ἀποστόλους, δεύτερον προφήτας, τρίτον διδασκάλους, ἔπειτα",
          {
            "noteId": 238
          },
          "δυνάμεις, ⸀ἔπειτα χαρίσματα ἰαμάτων, ἀντιλήμψεις, κυβερνήσεις, γένη γλωσσῶν."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "μὴ πάντες ἀπόστολοι; μὴ πάντες προφῆται; μὴ πάντες διδάσκαλοι; μὴ πάντες δυνάμεις;"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "μὴ πάντες χαρίσματα ἔχουσιν ἰαμάτων; μὴ πάντες γλώσσαις λαλοῦσιν; μὴ πάντες διερμηνεύουσιν;"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "ζηλοῦτε δὲ τὰ χαρίσματα τὰ ⸀μείζονα",
          {
            "noteId": 239
          },
          "καὶ ἔτι καθʼ ὑπερβολὴν ὁδὸν ὑμῖν δείκνυμι."
        ]
      }
    ],
