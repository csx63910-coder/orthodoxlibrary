  "chapter": {
    "number": 16,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Περὶ δὲ τῆς λογείας τῆς εἰς τοὺς ἁγίους, ὥσπερ διέταξα ταῖς ἐκκλησίαις τῆς Γαλατίας, οὕτως καὶ ὑμεῖς ποιήσατε."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "κατὰ μίαν ⸀σαββάτου",
          {
            "noteId": 317
          },
          "ἕκαστος ὑμῶν παρʼ ἑαυτῷ τιθέτω θησαυρίζων ὅ τι ⸀ἐὰν",
          {
            "noteId": 318
          },
          "εὐοδῶται, ἵνα μὴ ὅταν ἔλθω τότε λογεῖαι γίνωνται."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ὅταν δὲ παραγένωμαι, οὓς ⸀ἐὰν",
          {
            "noteId": 319
          },
          "δοκιμάσητε διʼ ἐπιστολῶν, τούτους πέμψω ἀπενεγκεῖν τὴν χάριν ὑμῶν εἰς Ἰερουσαλήμ·"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἐὰν δὲ ⸂ἄξιον ᾖ",
          {
            "noteId": 320
          },
          "τοῦ κἀμὲ πορεύεσθαι, σὺν ἐμοὶ πορεύσονται."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Ἐλεύσομαι δὲ πρὸς ὑμᾶς ὅταν Μακεδονίαν διέλθω, Μακεδονίαν γὰρ διέρχομαι,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "πρὸς ὑμᾶς δὲ τυχὸν ⸀παραμενῶ",
          {
            "noteId": 321
          },
          "ἢ ⸀καὶ",
          {
            "noteId": 322
          },
          "παραχειμάσω, ἵνα ὑμεῖς με προπέμψητε οὗ ἐὰν πορεύωμαι."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "οὐ θέλω γὰρ",
          {
            "noteId": 323
          },
          "ὑμᾶς ἄρτι ἐν παρόδῳ ἰδεῖν, ἐλπίζω ⸀γὰρ χρόνον τινὰ ἐπιμεῖναι πρὸς ὑμᾶς, ἐὰν ὁ κύριος ⸀ἐπιτρέψῃ",
          {
            "noteId": 324
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "⸀ἐπιμενῶ",
          {
            "noteId": 325
          },
          "δὲ ἐν Ἐφέσῳ ἕως τῆς πεντηκοστῆς·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "θύρα γάρ μοι ἀνέῳγεν μεγάλη καὶ ἐνεργής, καὶ ἀντικείμενοι πολλοί."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Ἐὰν δὲ ἔλθῃ Τιμόθεος, βλέπετε ἵνα ἀφόβως γένηται πρὸς ὑμᾶς, τὸ γὰρ ἔργον κυρίου ἐργάζεται ὡς ⸀κἀγώ",
          {
            "noteId": 326
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "μή τις οὖν αὐτὸν ἐξουθενήσῃ. προπέμψατε δὲ αὐτὸν ἐν εἰρήνῃ, ἵνα ἔλθῃ πρός ⸀με",
          {
            "noteId": 327
          },
          "ἐκδέχομαι γὰρ αὐτὸν μετὰ τῶν ἀδελφῶν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Περὶ δὲ Ἀπολλῶ τοῦ ἀδελφοῦ, πολλὰ παρεκάλεσα αὐτὸν ἵνα ἔλθῃ πρὸς ὑμᾶς μετὰ τῶν ἀδελφῶν· καὶ πάντως οὐκ ἦν θέλημα ἵνα νῦν ἔλθῃ, ἐλεύσεται δὲ ὅταν εὐκαιρήσῃ."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Γρηγορεῖτε, στήκετε ἐν τῇ πίστει, ἀνδρίζεσθε, κραταιοῦσθε."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "πάντα ὑμῶν ἐν ἀγάπῃ γινέσθω."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Παρακαλῶ δὲ ὑμᾶς, ἀδελφοί· οἴδατε τὴν οἰκίαν Στεφανᾶ, ὅτι ἐστὶν ἀπαρχὴ τῆς Ἀχαΐας καὶ εἰς διακονίαν τοῖς ἁγίοις ἔταξαν ἑαυτούς·"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ἵνα καὶ ὑμεῖς ὑποτάσσησθε τοῖς τοιούτοις καὶ παντὶ τῷ συνεργοῦντι καὶ κοπιῶντι."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "χαίρω δὲ ἐπὶ τῇ παρουσίᾳ Στεφανᾶ καὶ Φορτουνάτου καὶ Ἀχαϊκοῦ, ὅτι τὸ ⸀ὑμέτερον",
          {
            "noteId": 328
          },
          "ὑστέρημα οὗτοι ἀνεπλήρωσαν,"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ἀνέπαυσαν γὰρ τὸ ἐμὸν πνεῦμα καὶ τὸ ὑμῶν. ἐπιγινώσκετε οὖν τοὺς τοιούτους."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Ἀσπάζονται ὑμᾶς αἱ ἐκκλησίαι τῆς Ἀσίας. ⸀ἀσπάζεται",
          {
            "noteId": 329
          },
          "ὑμᾶς ἐν κυρίῳ πολλὰ Ἀκύλας καὶ ⸀Πρίσκα",
          {
            "noteId": 330
          },
          "σὺν τῇ κατʼ οἶκον αὐτῶν ἐκκλησίᾳ."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἀσπάζονται ὑμᾶς οἱ ἀδελφοὶ πάντες. ἀσπάσασθε ἀλλήλους ἐν φιλήματι ἁγίῳ."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Ὁ ἀσπασμὸς τῇ ἐμῇ χειρὶ Παύλου."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "εἴ τις οὐ φιλεῖ τὸν ⸀κύριον",
          {
            "noteId": 331
          },
          "ἤτω ἀνάθεμα. ⸂Μαράνα θά",
          {
            "noteId": 332
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ἡ χάρις τοῦ κυρίου ⸀Ἰησοῦ",
          {
            "noteId": 333
          },
          "μεθʼ ὑμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ἡ ἀγάπη μου μετὰ πάντων ὑμῶν ἐν Χριστῷ ⸀Ἰησοῦ",
          {
            "noteId": 334
          },
          "‘/book’"
        ]
      }
    ],
