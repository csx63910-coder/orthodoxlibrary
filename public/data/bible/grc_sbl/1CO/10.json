  "chapter": {
    "number": 10,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Οὐ θέλω ⸀γὰρ",
          {
            "noteId": 164
          },
          "ὑμᾶς ἀγνοεῖν, ἀδελφοί, ὅτι οἱ πατέρες ἡμῶν πάντες ὑπὸ τὴν νεφέλην ἦσαν καὶ πάντες διὰ τῆς θαλάσσης διῆλθον,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ πάντες εἰς τὸν Μωϋσῆν ⸀ἐβαπτίσαντο",
          {
            "noteId": 165
          },
          "ἐν τῇ νεφέλῃ καὶ ἐν τῇ θαλάσσῃ,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ πάντες τὸ αὐτὸ ⸂πνευματικὸν βρῶμα",
          {
            "noteId": 166
          },
          "ἔφαγον"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ πάντες τὸ αὐτὸ ⸂πνευματικὸν ἔπιον πόμα",
          {
            "noteId": 167
          },
          ", ἔπινον γὰρ ἐκ πνευματικῆς ἀκολουθούσης πέτρας, ἡ ⸂πέτρα δὲ",
          {
            "noteId": 168
          },
          "ἦν ὁ Χριστός·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἀλλʼ οὐκ ἐν τοῖς πλείοσιν αὐτῶν ηὐδόκησεν ὁ θεός, κατεστρώθησαν γὰρ ἐν τῇ ἐρήμῳ."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ταῦτα δὲ τύποι ἡμῶν ἐγενήθησαν, εἰς τὸ μὴ εἶναι ἡμᾶς ἐπιθυμητὰς κακῶν, καθὼς κἀκεῖνοι ἐπεθύμησαν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "μηδὲ εἰδωλολάτραι γίνεσθε, καθώς τινες αὐτῶν· ὥσπερ γέγραπται· Ἐκάθισεν ὁ λαὸς φαγεῖν καὶ πεῖν, καὶ ἀνέστησαν παίζειν."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "μηδὲ πορνεύωμεν, καθώς τινες αὐτῶν ἐπόρνευσαν, καὶ ἔπεσαν μιᾷ ἡμέρᾳ εἴκοσι τρεῖς χιλιάδες."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "μηδὲ ἐκπειράζωμεν τὸν ⸀Χριστόν",
          {
            "noteId": 169
          },
          "⸀καθώς",
          {
            "noteId": 170
          },
          "τινες αὐτῶν ἐπείρασαν, καὶ ὑπὸ τῶν ὄφεων ⸀ἀπώλλυντο",
          {
            "noteId": 171
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "μηδὲ γογγύζετε, ⸀καθάπερ",
          {
            "noteId": 172
          },
          "τινὲς αὐτῶν ἐγόγγυσαν, καὶ ἀπώλοντο ὑπὸ τοῦ ὀλοθρευτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ταῦτα ⸀δὲ",
          {
            "noteId": 173
          },
          "⸂τυπικῶς συνέβαινεν",
          {
            "noteId": 174
          },
          "ἐκείνοις, ἐγράφη δὲ πρὸς νουθεσίαν ἡμῶν, εἰς οὓς τὰ τέλη τῶν αἰώνων ⸀κατήντηκεν",
          {
            "noteId": 175
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ὥστε ὁ δοκῶν ἑστάναι βλεπέτω μὴ πέσῃ,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "πειρασμὸς ὑμᾶς οὐκ εἴληφεν εἰ μὴ ἀνθρώπινος· πιστὸς δὲ ὁ θεός, ὃς οὐκ ἐάσει ὑμᾶς πειρασθῆναι ὑπὲρ ὃ δύνασθε, ἀλλὰ ποιήσει σὺν τῷ πειρασμῷ καὶ τὴν ἔκβασιν τοῦ ⸀δύνασθαι",
          {
            "noteId": 176
          },
          "ὑπενεγκεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Διόπερ, ἀγαπητοί μου, φεύγετε ἀπὸ τῆς εἰδωλολατρίας."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ὡς φρονίμοις λέγω· κρίνατε ὑμεῖς ὅ φημι."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "τὸ ποτήριον τῆς εὐλογίας ὃ εὐλογοῦμεν, οὐχὶ κοινωνία ⸂ἐστὶν τοῦ αἵματος τοῦ Χριστοῦ",
          {
            "noteId": 177
          },
          "; τὸν ἄρτον ὃν κλῶμεν, οὐχὶ κοινωνία τοῦ σώματος τοῦ Χριστοῦ ἐστιν;"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ὅτι εἷς ἄρτος, ἓν σῶμα οἱ πολλοί ἐσμεν, οἱ γὰρ πάντες ἐκ τοῦ ἑνὸς ἄρτου μετέχομεν."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "βλέπετε τὸν Ἰσραὴλ κατὰ σάρκα· ⸀οὐχ",
          {
            "noteId": 178
          },
          "οἱ ἐσθίοντες τὰς θυσίας κοινωνοὶ τοῦ θυσιαστηρίου εἰσίν;"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "τί οὖν φημι; ὅτι ⸂εἰδωλόθυτόν τί ἐστιν, ἢ ὅτι εἴδωλόν",
          {
            "noteId": 179
          },
          "τί ἐστιν;"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἀλλʼ ὅτι ἃ ⸀θύουσιν",
          {
            "noteId": 180
          },
          "δαιμονίοις ⸂καὶ οὐ θεῷ θύουσιν",
          {
            "noteId": 181
          },
          ", οὐ θέλω δὲ ὑμᾶς κοινωνοὺς τῶν δαιμονίων γίνεσθαι."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "οὐ δύνασθε ποτήριον κυρίου πίνειν καὶ ποτήριον δαιμονίων· οὐ δύνασθε τραπέζης κυρίου μετέχειν καὶ τραπέζης δαιμονίων."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ἢ παραζηλοῦμεν τὸν κύριον; μὴ ἰσχυρότεροι αὐτοῦ ἐσμεν;"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "⸀Πάντα",
          {
            "noteId": 182
          },
          "ἔξεστιν· ἀλλʼ οὐ πάντα συμφέρει. ⸁πάντα",
          {
            "noteId": 183
          },
          "ἔξεστιν· ἀλλʼ οὐ πάντα οἰκοδομεῖ."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "μηδεὶς τὸ ἑαυτοῦ ζητείτω ἀλλὰ τὸ τοῦ ⸀ἑτέρου",
          {
            "noteId": 184
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "πᾶν τὸ ἐν μακέλλῳ πωλούμενον ἐσθίετε μηδὲν ἀνακρίνοντες διὰ τὴν συνείδησιν,"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "τοῦ ⸂κυρίου γὰρ",
          {
            "noteId": 185
          },
          "ἡ γῆ καὶ τὸ πλήρωμα αὐτῆς."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "⸀εἴ",
          {
            "noteId": 186
          },
          "τις καλεῖ ὑμᾶς τῶν ἀπίστων καὶ θέλετε πορεύεσθαι, πᾶν τὸ παρατιθέμενον ὑμῖν ἐσθίετε μηδὲν ἀνακρίνοντες διὰ τὴν συνείδησιν·"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ἐὰν δέ τις ὑμῖν εἴπῃ· Τοῦτο ⸀ἱερόθυτόν",
          {
            "noteId": 187
          },
          "ἐστιν, μὴ ἐσθίετε διʼ ἐκεῖνον τὸν μηνύσαντα καὶ τὴν ⸀συνείδησιν",
          {
            "noteId": 188
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "συνείδησιν δὲ λέγω οὐχὶ τὴν ἑαυτοῦ ἀλλὰ τὴν τοῦ ἑτέρου· ἱνατί γὰρ ἡ ἐλευθερία μου κρίνεται ὑπὸ ἄλλης συνειδήσεως;"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "εἰ ἐγὼ χάριτι μετέχω, τί βλασφημοῦμαι ὑπὲρ οὗ ἐγὼ εὐχαριστῶ;"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "Εἴτε οὖν ἐσθίετε εἴτε πίνετε εἴτε τι ποιεῖτε, πάντα εἰς δόξαν θεοῦ ποιεῖτε."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "ἀπρόσκοποι ⸂καὶ Ἰουδαίοις γίνεσθε",
          {
            "noteId": 189
          },
          "καὶ Ἕλλησιν καὶ τῇ ἐκκλησίᾳ τοῦ θεοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "καθὼς κἀγὼ πάντα πᾶσιν ἀρέσκω, μὴ ζητῶν τὸ ἐμαυτοῦ ⸀σύμφορον",
          {
            "noteId": 190
          },
          "ἀλλὰ τὸ τῶν πολλῶν, ἵνα σωθῶσιν."
        ]
      }
    ],
