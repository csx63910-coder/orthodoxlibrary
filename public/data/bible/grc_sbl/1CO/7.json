  "chapter": {
    "number": 7,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Περὶ δὲ ὧν ⸀ἐγράψατε",
          {
            "noteId": 74
          },
          "καλὸν ἀνθρώπῳ γυναικὸς μὴ ἅπτεσθαι·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "διὰ δὲ τὰς πορνείας ἕκαστος τὴν ἑαυτοῦ γυναῖκα ἐχέτω, καὶ ἑκάστη τὸν ἴδιον ἄνδρα ἐχέτω."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "τῇ γυναικὶ ὁ ἀνὴρ τὴν ⸀ὀφειλὴν",
          {
            "noteId": 75
          },
          "ἀποδιδότω, ὁμοίως δὲ καὶ ἡ γυνὴ τῷ ἀνδρί."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἡ γυνὴ τοῦ ἰδίου σώματος οὐκ ἐξουσιάζει ἀλλὰ ὁ ἀνήρ· ὁμοίως δὲ καὶ ὁ ἀνὴρ τοῦ ἰδίου σώματος οὐκ ἐξουσιάζει ἀλλὰ ἡ γυνή."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "μὴ ἀποστερεῖτε ἀλλήλους, εἰ μήτι ἂν ἐκ συμφώνου πρὸς καιρὸν ἵνα ⸀σχολάσητε",
          {
            "noteId": 76
          },
          "⸀τῇ",
          {
            "noteId": 77
          },
          "προσευχῇ καὶ πάλιν ἐπὶ τὸ αὐτὸ ⸀ἦτε",
          {
            "noteId": 78
          },
          "ἵνα μὴ πειράζῃ ὑμᾶς ὁ Σατανᾶς διὰ τὴν ἀκρασίαν ὑμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "τοῦτο δὲ λέγω κατὰ συγγνώμην, οὐ κατʼ ἐπιταγήν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "θέλω ⸀δὲ",
          {
            "noteId": 79
          },
          "πάντας ἀνθρώπους εἶναι ὡς καὶ ἐμαυτόν· ἀλλὰ ἕκαστος ἴδιον ⸂ἔχει χάρισμα",
          {
            "noteId": 80
          },
          "ἐκ θεοῦ, ⸀ὁ",
          {
            "noteId": 81
          },
          "μὲν οὕτως, ⸁ὁ",
          {
            "noteId": 82
          },
          "δὲ οὕτως."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Λέγω δὲ τοῖς ἀγάμοις καὶ ταῖς χήραις, καλὸν ⸀αὐτοῖς",
          {
            "noteId": 83
          },
          "ἐὰν μείνωσιν ὡς κἀγώ·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "εἰ δὲ οὐκ ἐγκρατεύονται, γαμησάτωσαν, κρεῖττον γάρ ἐστιν ⸀γαμῆσαι",
          {
            "noteId": 84
          },
          "ἢ πυροῦσθαι."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Τοῖς δὲ γεγαμηκόσιν παραγγέλλω, οὐκ ἐγὼ ἀλλὰ ὁ κύριος, γυναῖκα ἀπὸ ἀνδρὸς μὴ χωρισθῆναι—"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ἐὰν δὲ καὶ χωρισθῇ, μενέτω ἄγαμος ἢ τῷ ἀνδρὶ καταλλαγήτω— καὶ ἄνδρα γυναῖκα μὴ ἀφιέναι."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Τοῖς δὲ λοιποῖς ⸂λέγω ἐγώ",
          {
            "noteId": 85
          },
          ", οὐχ ὁ κύριος· εἴ τις ἀδελφὸς γυναῖκα ἔχει ἄπιστον, καὶ αὕτη συνευδοκεῖ οἰκεῖν μετʼ αὐτοῦ, μὴ ἀφιέτω αὐτήν·"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ γυνὴ ⸂εἴ τις",
          {
            "noteId": 86
          },
          "ἔχει ἄνδρα ἄπιστον, καὶ ⸀οὗτος",
          {
            "noteId": 87
          },
          "συνευδοκεῖ οἰκεῖν μετʼ αὐτῆς, μὴ ἀφιέτω ⸂τὸν ἄνδρα",
          {
            "noteId": 88
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἡγίασται γὰρ ὁ ἀνὴρ ὁ ἄπιστος ἐν τῇ γυναικί, καὶ ἡγίασται ἡ γυνὴ ἡ ἄπιστος ἐν τῷ ⸀ἀδελφῷ",
          {
            "noteId": 89
          },
          "ἐπεὶ ἄρα τὰ τέκνα ὑμῶν ἀκάθαρτά ἐστιν, νῦν δὲ ἅγιά ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "εἰ δὲ ὁ ἄπιστος χωρίζεται, χωριζέσθω· οὐ δεδούλωται ὁ ἀδελφὸς ἢ ἡ ἀδελφὴ ἐν τοῖς τοιούτοις, ἐν δὲ εἰρήνῃ κέκληκεν ⸀ἡμᾶς",
          {
            "noteId": 90
          },
          "ὁ θεός."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "τί γὰρ οἶδας, γύναι, εἰ τὸν ἄνδρα σώσεις; ἢ τί οἶδας, ἄνερ, εἰ τὴν γυναῖκα σώσεις;"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Εἰ μὴ ἑκάστῳ ὡς ⸀ἐμέρισεν",
          {
            "noteId": 91
          },
          "ὁ ⸀κύριος",
          {
            "noteId": 92
          },
          "ἕκαστον ὡς κέκληκεν ὁ ⸀θεός",
          {
            "noteId": 93
          },
          "οὕτως περιπατείτω· καὶ οὕτως ἐν ταῖς ἐκκλησίαις πάσαις διατάσσομαι."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "περιτετμημένος τις ἐκλήθη; μὴ ἐπισπάσθω· ἐν ἀκροβυστίᾳ ⸂κέκληταί τις",
          {
            "noteId": 94
          },
          "; μὴ περιτεμνέσθω."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἡ περιτομὴ οὐδέν ἐστιν, καὶ ἡ ἀκροβυστία οὐδέν ἐστιν, ἀλλὰ τήρησις ἐντολῶν θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἕκαστος ἐν τῇ κλήσει ᾗ ἐκλήθη ἐν ταύτῃ μενέτω."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Δοῦλος ἐκλήθης; μή σοι μελέτω· ἀλλʼ εἰ καὶ δύνασαι ἐλεύθερος γενέσθαι, μᾶλλον χρῆσαι."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ὁ γὰρ ἐν κυρίῳ κληθεὶς δοῦλος ἀπελεύθερος κυρίου ἐστίν· ⸀ὁμοίως",
          {
            "noteId": 95
          },
          "ὁ ἐλεύθερος κληθεὶς δοῦλός ἐστιν Χριστοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "τιμῆς ἠγοράσθητε· μὴ γίνεσθε δοῦλοι ἀνθρώπων."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ἕκαστος ἐν ᾧ ἐκλήθη, ἀδελφοί, ἐν τούτῳ μενέτω παρὰ θεῷ."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Περὶ δὲ τῶν παρθένων ἐπιταγὴν κυρίου οὐκ ἔχω, γνώμην δὲ δίδωμι ὡς ἠλεημένος ὑπὸ κυρίου πιστὸς εἶναι."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "νομίζω οὖν τοῦτο καλὸν ὑπάρχειν διὰ τὴν ἐνεστῶσαν ἀνάγκην, ὅτι καλὸν ἀνθρώπῳ τὸ οὕτως εἶναι."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "δέδεσαι γυναικί; μὴ ζήτει λύσιν· λέλυσαι ἀπὸ γυναικός; μὴ ζήτει γυναῖκα·"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ἐὰν δὲ καὶ ⸀γαμήσῃς",
          {
            "noteId": 96
          },
          "οὐχ ἥμαρτες. καὶ ἐὰν γήμῃ ἡ παρθένος, οὐχ ἥμαρτεν. θλῖψιν δὲ τῇ σαρκὶ ἕξουσιν οἱ τοιοῦτοι, ἐγὼ δὲ ὑμῶν φείδομαι."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "τοῦτο δέ φημι, ἀδελφοί, ὁ καιρὸς συνεσταλμένος ⸂ἐστίν· τὸ λοιπὸν⸃ ἵνα καὶ οἱ ἔχοντες γυναῖκας ὡς μὴ ἔχοντες ὦσιν,",
          {
            "noteId": 97
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "καὶ οἱ κλαίοντες ὡς μὴ κλαίοντες, καὶ οἱ χαίροντες ὡς μὴ χαίροντες, καὶ οἱ ἀγοράζοντες ὡς μὴ κατέχοντες,"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "καὶ οἱ χρώμενοι ⸂τὸν κόσμον",
          {
            "noteId": 98
          },
          "ὡς μὴ καταχρώμενοι· παράγει γὰρ τὸ σχῆμα τοῦ κόσμου τούτου."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Θέλω δὲ ὑμᾶς ἀμερίμνους εἶναι. ὁ ἄγαμος μεριμνᾷ τὰ τοῦ κυρίου, πῶς ⸀ἀρέσῃ",
          {
            "noteId": 99
          },
          "τῷ κυρίῳ·"
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "ὁ δὲ γαμήσας μεριμνᾷ τὰ τοῦ κόσμου, πῶς ⸀ἀρέσῃ",
          {
            "noteId": 100
          },
          "τῇ γυναικί,"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "⸀καὶ",
          {
            "noteId": 101
          },
          "μεμέρισται. καὶ ἡ γυνὴ ⸂ἡ ἄγαμος",
          {
            "noteId": 102
          },
          "καὶ ἡ ⸀παρθένος",
          {
            "noteId": 103
          },
          "μεριμνᾷ τὰ τοῦ κυρίου, ἵνα ᾖ ἁγία καὶ ⸀τῷ",
          {
            "noteId": 104
          },
          "σώματι καὶ ⸁τῷ",
          {
            "noteId": 105
          },
          "πνεύματι· ἡ δὲ γαμήσασα μεριμνᾷ τὰ τοῦ κόσμου, πῶς ⸀ἀρέσῃ",
          {
            "noteId": 106
          },
          "τῷ ἀνδρί."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "τοῦτο δὲ πρὸς τὸ ὑμῶν αὐτῶν ⸀σύμφορον",
          {
            "noteId": 107
          },
          "λέγω, οὐχ ἵνα βρόχον ὑμῖν ἐπιβάλω, ἀλλὰ πρὸς τὸ εὔσχημον καὶ ⸀εὐπάρεδρον",
          {
            "noteId": 108
          },
          "τῷ κυρίῳ ἀπερισπάστως."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "Εἰ δέ τις ἀσχημονεῖν ἐπὶ τὴν παρθένον αὐτοῦ νομίζει ἐὰν ᾖ ὑπέρακμος, καὶ οὕτως ὀφείλει γίνεσθαι, ὃ θέλει ποιείτω· οὐχ ἁμαρτάνει· γαμείτωσαν."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "ὃς δὲ ἕστηκεν ⸂ἐν τῇ καρδίᾳ αὐτοῦ ἑδραῖος",
          {
            "noteId": 109
          },
          "μὴ ἔχων ἀνάγκην, ἐξουσίαν δὲ ἔχει περὶ τοῦ ἰδίου θελήματος, καὶ τοῦτο κέκρικεν ἐν τῇ ⸂ἰδίᾳ καρδίᾳ",
          {
            "noteId": 110
          },
          ", ⸀τηρεῖν",
          {
            "noteId": 111
          },
          "τὴν ἑαυτοῦ παρθένον, καλῶς ⸀ποιήσει",
          {
            "noteId": 112
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "ὥστε καὶ ὁ ⸀γαμίζων",
          {
            "noteId": 113
          },
          "⸂τὴν παρθένον ἑαυτοῦ",
          {
            "noteId": 114
          },
          "καλῶς ποιεῖ, ⸂καὶ ὁ",
          {
            "noteId": 115
          },
          "μὴ ⸁γαμίζων",
          {
            "noteId": 116
          },
          "κρεῖσσον ⸀ποιήσει",
          {
            "noteId": 117
          }
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "Γυνὴ ⸀δέδεται",
          {
            "noteId": 118
          },
          "ἐφʼ ὅσον χρόνον ζῇ ὁ ἀνὴρ αὐτῆς· ἐὰν ⸀δὲ",
          {
            "noteId": 119
          },
          "κοιμηθῇ ὁ ἀνήρ, ἐλευθέρα ἐστὶν ᾧ θέλει γαμηθῆναι, μόνον ἐν κυρίῳ·"
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "μακαριωτέρα δέ ἐστιν ἐὰν οὕτως μείνῃ, κατὰ τὴν ἐμὴν γνώμην, δοκῶ ⸀δὲ",
          {
            "noteId": 120
          },
          "κἀγὼ πνεῦμα θεοῦ ἔχειν."
        ]
      }
    ],
