  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ὅλως ἀκούεται ἐν ὑμῖν πορνεία, καὶ τοιαύτη πορνεία ἥτις οὐδὲ ἐν τοῖς ⸀ἔθνεσιν",
          {
            "noteId": 48
          },
          "ὥστε γυναῖκά τινα τοῦ πατρὸς ἔχειν."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ ὑμεῖς πεφυσιωμένοι ἐστέ, καὶ οὐχὶ μᾶλλον ἐπενθήσατε, ἵνα ⸀ἀρθῇ",
          {
            "noteId": 49
          },
          "ἐκ μέσου ὑμῶν ὁ τὸ ἔργον τοῦτο ⸀ποιήσας",
          {
            "noteId": 50
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Ἐγὼ μὲν γάρ, ⸀ἀπὼν",
          {
            "noteId": 51
          },
          "τῷ σώματι παρὼν δὲ τῷ πνεύματι, ἤδη κέκρικα ὡς παρὼν τὸν οὕτως τοῦτο κατεργασάμενον"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἐν τῷ ὀνόματι τοῦ κυρίου ἡμῶν ⸀Ἰησοῦ",
          {
            "noteId": 52
          },
          "συναχθέντων ὑμῶν καὶ τοῦ ἐμοῦ πνεύματος σὺν τῇ δυνάμει τοῦ κυρίου ἡμῶν ⸁Ἰησοῦ",
          {
            "noteId": 53
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "παραδοῦναι τὸν τοιοῦτον τῷ Σατανᾷ εἰς ὄλεθρον τῆς σαρκός, ἵνα τὸ πνεῦμα σωθῇ ἐν τῇ ἡμέρᾳ τοῦ ⸀κυρίου",
          {
            "noteId": 54
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Οὐ καλὸν τὸ καύχημα ὑμῶν. οὐκ οἴδατε ὅτι μικρὰ ζύμη ὅλον τὸ φύραμα ζυμοῖ;"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἐκκαθάρατε τὴν παλαιὰν ζύμην, ἵνα ἦτε νέον φύραμα, καθώς ἐστε ἄζυμοι. καὶ γὰρ τὸ πάσχα ⸀ἡμῶν",
          {
            "noteId": 55
          },
          "ἐτύθη Χριστός·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ὥστε ἑορτάζωμεν, μὴ ἐν ζύμῃ παλαιᾷ μηδὲ ἐν ζύμῃ κακίας καὶ πονηρίας, ἀλλʼ ἐν ἀζύμοις εἰλικρινείας καὶ ἀληθείας."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Ἔγραψα ὑμῖν ἐν τῇ ἐπιστολῇ μὴ συναναμίγνυσθαι πόρνοις,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "⸀οὐ",
          {
            "noteId": 56
          },
          "πάντως τοῖς πόρνοις τοῦ κόσμου τούτου ἢ τοῖς πλεονέκταις ⸀καὶ",
          {
            "noteId": 57
          },
          "ἅρπαξιν ἢ εἰδωλολάτραις, ἐπεὶ ⸀ὠφείλετε",
          {
            "noteId": 58
          },
          "ἄρα ἐκ τοῦ κόσμου ἐξελθεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "νῦν δὲ ἔγραψα ὑμῖν μὴ συναναμίγνυσθαι ἐάν τις ἀδελφὸς ὀνομαζόμενος ᾖ πόρνος ἢ πλεονέκτης ἢ εἰδωλολάτρης ἢ λοίδορος ἢ μέθυσος ἢ ἅρπαξ, τῷ τοιούτῳ μηδὲ συνεσθίειν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "τί γάρ ⸀μοι",
          {
            "noteId": 59
          },
          "τοὺς ἔξω κρίνειν; οὐχὶ τοὺς ἔσω ὑμεῖς κρίνετε,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "τοὺς δὲ ἔξω ὁ θεὸς ⸀κρίνει",
          {
            "noteId": 60
          },
          "⸀ἐξάρατε",
          {
            "noteId": 61
          },
          "τὸν πονηρὸν ἐξ ὑμῶν αὐτῶν."
        ]
      }
    ],
