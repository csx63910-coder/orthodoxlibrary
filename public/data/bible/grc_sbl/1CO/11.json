  "chapter": {
    "number": 11,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "μιμηταί μου γίνεσθε, καθὼς κἀγὼ Χριστοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Ἐπαινῶ δὲ ⸀ὑμᾶς",
          {
            "noteId": 191
          },
          "ὅτι πάντα μου μέμνησθε καὶ καθὼς παρέδωκα ὑμῖν τὰς παραδόσεις κατέχετε."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "θέλω δὲ ὑμᾶς εἰδέναι ὅτι παντὸς ἀνδρὸς ἡ κεφαλὴ ὁ Χριστός ἐστιν, κεφαλὴ δὲ γυναικὸς ὁ ἀνήρ, κεφαλὴ δὲ ⸀τοῦ",
          {
            "noteId": 192
          },
          "Χριστοῦ ὁ θεός."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "πᾶς ἀνὴρ προσευχόμενος ἢ προφητεύων κατὰ κεφαλῆς ἔχων καταισχύνει τὴν κεφαλὴν αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "πᾶσα δὲ γυνὴ προσευχομένη ἢ προφητεύουσα ἀκατακαλύπτῳ τῇ κεφαλῇ καταισχύνει τὴν κεφαλὴν ⸀αὐτῆς",
          {
            "noteId": 193
          },
          "ἓν γάρ ἐστιν καὶ τὸ αὐτὸ τῇ ἐξυρημένῃ."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "εἰ γὰρ οὐ κατακαλύπτεται γυνή, καὶ κειράσθω· εἰ δὲ αἰσχρὸν γυναικὶ τὸ κείρασθαι ἢ ξυρᾶσθαι, κατακαλυπτέσθω."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἀνὴρ μὲν γὰρ οὐκ ὀφείλει κατακαλύπτεσθαι τὴν κεφαλήν, εἰκὼν καὶ δόξα θεοῦ ὑπάρχων· ⸀ἡ",
          {
            "noteId": 194
          },
          "γυνὴ δὲ δόξα ἀνδρός ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "οὐ γάρ ἐστιν ἀνὴρ ἐκ γυναικός, ἀλλὰ γυνὴ ἐξ ἀνδρός·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ γὰρ οὐκ ἐκτίσθη ἀνὴρ διὰ τὴν γυναῖκα, ἀλλὰ γυνὴ διὰ τὸν ἄνδρα."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "διὰ τοῦτο ὀφείλει ἡ γυνὴ ἐξουσίαν ἔχειν ἐπὶ τῆς κεφαλῆς διὰ τοὺς ἀγγέλους."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "πλὴν οὔτε ⸂γυνὴ χωρὶς ἀνδρὸς οὔτε ἀνὴρ χωρὶς γυναικὸς",
          {
            "noteId": 195
          },
          "ἐν κυρίῳ·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ὥσπερ γὰρ ἡ γυνὴ ἐκ τοῦ ἀνδρός, οὕτως καὶ ὁ ἀνὴρ διὰ τῆς γυναικός· τὰ δὲ πάντα ἐκ τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ἐν ὑμῖν αὐτοῖς κρίνατε· πρέπον ἐστὶν γυναῖκα ἀκατακάλυπτον τῷ θεῷ προσεύχεσθαι;"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "⸀οὐδὲ",
          {
            "noteId": 196
          },
          "⸂ἡ φύσις αὐτὴ",
          {
            "noteId": 197
          },
          "διδάσκει ὑμᾶς ὅτι ἀνὴρ μὲν ἐὰν κομᾷ, ἀτιμία αὐτῷ ἐστιν,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "γυνὴ δὲ ἐὰν κομᾷ, δόξα αὐτῇ ἐστιν; ὅτι ἡ κόμη ἀντὶ περιβολαίου ⸀δέδοται",
          {
            "noteId": 198
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "εἰ δέ τις δοκεῖ φιλόνεικος εἶναι, ἡμεῖς τοιαύτην συνήθειαν οὐκ ἔχομεν, οὐδὲ αἱ ἐκκλησίαι τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Τοῦτο δὲ ⸂παραγγέλλων οὐκ ἐπαινῶ",
          {
            "noteId": 199
          },
          "ὅτι οὐκ εἰς τὸ κρεῖσσον ἀλλὰ εἰς τὸ ἧσσον συνέρχεσθε."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "πρῶτον μὲν γὰρ συνερχομένων ὑμῶν ἐν ἐκκλησίᾳ ἀκούω σχίσματα ἐν ὑμῖν ὑπάρχειν, καὶ μέρος τι πιστεύω."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "δεῖ γὰρ καὶ",
          {
            "noteId": 200
          },
          "αἱρέσεις ἐν ὑμῖν εἶναι, ἵνα ⸀καὶ οἱ δόκιμοι φανεροὶ γένωνται ἐν ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "συνερχομένων οὖν ὑμῶν ἐπὶ τὸ αὐτὸ οὐκ ἔστιν κυριακὸν δεῖπνον φαγεῖν,"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ἕκαστος γὰρ τὸ ἴδιον δεῖπνον προλαμβάνει ἐν τῷ φαγεῖν, καὶ ὃς μὲν πεινᾷ, ὃς δὲ μεθύει."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "μὴ γὰρ οἰκίας οὐκ ἔχετε εἰς τὸ ἐσθίειν καὶ πίνειν; ἢ τῆς ἐκκλησίας τοῦ θεοῦ καταφρονεῖτε, καὶ καταισχύνετε τοὺς μὴ ἔχοντας; τί ⸂εἴπω ὑμῖν",
          {
            "noteId": 201
          },
          "; ἐπαινέσω ὑμᾶς; ἐν τούτῳ οὐκ ἐπαινῶ."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Ἐγὼ γὰρ παρέλαβον ἀπὸ τοῦ κυρίου, ὃ καὶ παρέδωκα ὑμῖν, ὅτι ὁ κύριος Ἰησοῦς ἐν τῇ νυκτὶ ᾗ ⸀παρεδίδετο",
          {
            "noteId": 202
          },
          "ἔλαβεν ἄρτον"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "καὶ εὐχαριστήσας ἔκλασεν καὶ ⸀εἶπεν",
          {
            "noteId": 203
          },
          "Τοῦτό μού ἐστιν τὸ σῶμα τὸ ὑπὲρ ⸀ὑμῶν",
          {
            "noteId": 204
          },
          "τοῦτο ποιεῖτε εἰς τὴν ἐμὴν ἀνάμνησιν."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ὡσαύτως καὶ τὸ ποτήριον μετὰ τὸ δειπνῆσαι, λέγων· Τοῦτο τὸ ποτήριον ἡ καινὴ διαθήκη ἐστὶν ἐν τῷ ἐμῷ αἵματι· τοῦτο ποιεῖτε, ὁσάκις ⸀ἐὰν",
          {
            "noteId": 205
          },
          "πίνητε, εἰς τὴν ἐμὴν ἀνάμνησιν."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ὁσάκις γὰρ ⸀ἐὰν",
          {
            "noteId": 206
          },
          "ἐσθίητε τὸν ἄρτον τοῦτον καὶ τὸ ⸀ποτήριον",
          {
            "noteId": 207
          },
          "πίνητε, τὸν θάνατον τοῦ κυρίου καταγγέλλετε, ἄχρι ⸀οὗ",
          {
            "noteId": 208
          },
          "ἔλθῃ."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Ὥστε ὃς ἂν ἐσθίῃ τὸν ⸀ἄρτον",
          {
            "noteId": 209
          },
          "ἢ πίνῃ τὸ ποτήριον τοῦ κυρίου ⸀ἀναξίως",
          {
            "noteId": 210
          },
          "ἔνοχος ἔσται τοῦ σώματος καὶ τοῦ αἵματος τοῦ κυρίου."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "δοκιμαζέτω δὲ ἄνθρωπος ἑαυτόν, καὶ οὕτως ἐκ τοῦ ἄρτου ἐσθιέτω καὶ ἐκ τοῦ ποτηρίου πινέτω·"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "ὁ γὰρ ἐσθίων καὶ ⸀πίνων",
          {
            "noteId": 211
          },
          "κρίμα ἑαυτῷ ἐσθίει καὶ πίνει μὴ διακρίνων τὸ ⸀σῶμα",
          {
            "noteId": 212
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "διὰ τοῦτο ἐν ὑμῖν πολλοὶ ἀσθενεῖς καὶ ἄρρωστοι καὶ κοιμῶνται ἱκανοί."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "εἰ ⸀δὲ",
          {
            "noteId": 213
          },
          "ἑαυτοὺς διεκρίνομεν, οὐκ ἂν ἐκρινόμεθα·"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "κρινόμενοι δὲ ⸀ὑπὸ",
          {
            "noteId": 214
          },
          "κυρίου παιδευόμεθα, ἵνα μὴ σὺν τῷ κόσμῳ κατακριθῶμεν."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "Ὥστε, ἀδελφοί μου, συνερχόμενοι εἰς τὸ φαγεῖν ἀλλήλους ἐκδέχεσθε."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "⸀εἴ",
          {
            "noteId": 215
          },
          "τις πεινᾷ, ἐν οἴκῳ ἐσθιέτω, ἵνα μὴ εἰς κρίμα συνέρχησθε. Τὰ δὲ λοιπὰ ὡς ἂν ἔλθω διατάξομαι."
        ]
      }
    ],
