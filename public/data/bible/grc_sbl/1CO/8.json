  "chapter": {
    "number": 8,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Περὶ δὲ τῶν εἰδωλοθύτων, οἴδαμεν ὅτι πάντες γνῶσιν ἔχομεν. ἡ γνῶσις φυσιοῖ, ἡ δὲ ἀγάπη οἰκοδομεῖ."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "⸀εἴ",
          {
            "noteId": 121
          },
          "τις δοκεῖ ⸀ἐγνωκέναι",
          {
            "noteId": 122
          },
          "τι, ⸀οὔπω",
          {
            "noteId": 123
          },
          "⸀ἔγνω",
          {
            "noteId": 124
          },
          "καθὼς δεῖ γνῶναι·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "εἰ δέ τις ἀγαπᾷ τὸν θεόν, οὗτος ἔγνωσται ὑπʼ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Περὶ τῆς βρώσεως οὖν τῶν εἰδωλοθύτων οἴδαμεν ὅτι οὐδὲν εἴδωλον ἐν κόσμῳ, καὶ ὅτι οὐδεὶς ⸀θεὸς",
          {
            "noteId": 125
          },
          "εἰ μὴ εἷς."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ γὰρ εἴπερ εἰσὶν λεγόμενοι θεοὶ εἴτε ἐν οὐρανῷ εἴτε ἐπὶ γῆς, ὥσπερ εἰσὶν θεοὶ πολλοὶ καὶ κύριοι πολλοί,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἀλλʼ ἡμῖν εἷς θεὸς ὁ πατήρ, ἐξ οὗ τὰ πάντα καὶ ἡμεῖς εἰς αὐτόν, καὶ εἷς κύριος Ἰησοῦς Χριστός, διʼ οὗ τὰ πάντα καὶ ἡμεῖς διʼ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ἀλλʼ οὐκ ἐν πᾶσιν ἡ γνῶσις· τινὲς δὲ τῇ ⸀συνηθείᾳ",
          {
            "noteId": 126
          },
          "⸂ἕως ἄρτι τοῦ εἰδώλου",
          {
            "noteId": 127
          },
          "ὡς εἰδωλόθυτον ἐσθίουσιν, καὶ ἡ συνείδησις αὐτῶν ἀσθενὴς οὖσα μολύνεται."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "βρῶμα δὲ ἡμᾶς οὐ ⸀παραστήσει",
          {
            "noteId": 128
          },
          "τῷ θεῷ· οὔτε ⸂γὰρ ἐὰν φάγωμεν, περισσεύομεν, οὔτε ἐὰν μὴ φάγωμεν, ὑστερούμεθα",
          {
            "noteId": 129
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "βλέπετε δὲ μή πως ἡ ἐξουσία ὑμῶν αὕτη πρόσκομμα γένηται τοῖς ⸀ἀσθενέσιν",
          {
            "noteId": 130
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἐὰν γάρ τις ἴδῃ σὲ τὸν ἔχοντα γνῶσιν ἐν εἰδωλείῳ κατακείμενον, οὐχὶ ἡ συνείδησις αὐτοῦ ἀσθενοῦς ὄντος οἰκοδομηθήσεται εἰς τὸ τὰ εἰδωλόθυτα ἐσθίειν;"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "⸂ἀπόλλυται γὰρ",
          {
            "noteId": 131
          },
          "ὁ ἀσθενῶν ⸀ἐν",
          {
            "noteId": 132
          },
          "τῇ σῇ γνώσει, ⸂ὁ ἀδελφὸς",
          {
            "noteId": 133
          },
          "διʼ ὃν Χριστὸς ἀπέθανεν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "οὕτως δὲ ἁμαρτάνοντες εἰς τοὺς ἀδελφοὺς καὶ τύπτοντες αὐτῶν τὴν συνείδησιν ἀσθενοῦσαν εἰς Χριστὸν ἁμαρτάνετε."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "διόπερ εἰ βρῶμα σκανδαλίζει τὸν ἀδελφόν μου, οὐ μὴ φάγω κρέα εἰς τὸν αἰῶνα, ἵνα μὴ τὸν ἀδελφόν μου σκανδαλίσω."
        ]
      }
    ],
