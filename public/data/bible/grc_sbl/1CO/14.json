  "chapter": {
    "number": 14,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Διώκετε τὴν ἀγάπην, ζηλοῦτε δὲ τὰ πνευματικά, μᾶλλον δὲ ἵνα προφητεύητε."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ὁ γὰρ λαλῶν γλώσσῃ οὐκ ἀνθρώποις λαλεῖ ⸀ἀλλὰ",
          {
            "noteId": 252
          },
          "θεῷ, οὐδεὶς γὰρ ἀκούει, πνεύματι δὲ λαλεῖ μυστήρια·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ὁ δὲ προφητεύων ἀνθρώποις λαλεῖ οἰκοδομὴν καὶ παράκλησιν καὶ παραμυθίαν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ὁ λαλῶν γλώσσῃ ἑαυτὸν οἰκοδομεῖ· ὁ δὲ προφητεύων ἐκκλησίαν οἰκοδομεῖ."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "θέλω δὲ",
          {
            "noteId": 253
          },
          "πάντας ὑμᾶς λαλεῖν γλώσσαις, μᾶλλον δὲ ἵνα προφητεύητε· μείζων ⸀δὲ ὁ προφητεύων ἢ ὁ λαλῶν γλώσσαις, ἐκτὸς εἰ μὴ ⸀διερμηνεύῃ",
          {
            "noteId": 254
          },
          "ἵνα ἡ ἐκκλησία οἰκοδομὴν λάβῃ."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "⸀Νῦν",
          {
            "noteId": 255
          },
          "δέ, ἀδελφοί, ἐὰν ἔλθω πρὸς ὑμᾶς γλώσσαις λαλῶν, τί ὑμᾶς ὠφελήσω, ἐὰν μὴ ὑμῖν λαλήσω ἢ ἐν ἀποκαλύψει ἢ ἐν γνώσει ἢ ἐν προφητείᾳ ἢ ἐν διδαχῇ;"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ὅμως τὰ ἄψυχα φωνὴν διδόντα, εἴτε αὐλὸς εἴτε κιθάρα, ἐὰν διαστολὴν τοῖς φθόγγοις μὴ ⸀δῷ",
          {
            "noteId": 256
          },
          "πῶς γνωσθήσεται τὸ αὐλούμενον ἢ τὸ κιθαριζόμενον;"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ γὰρ ἐὰν ἄδηλον ⸂φωνὴν σάλπιγξ",
          {
            "noteId": 257
          },
          "δῷ, τίς παρασκευάσεται εἰς πόλεμον;"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "οὕτως καὶ ὑμεῖς διὰ τῆς γλώσσης ἐὰν μὴ εὔσημον λόγον δῶτε, πῶς γνωσθήσεται τὸ λαλούμενον; ἔσεσθε γὰρ εἰς ἀέρα λαλοῦντες."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "τοσαῦτα εἰ τύχοι γένη φωνῶν ⸀εἰσιν",
          {
            "noteId": 258
          },
          "ἐν κόσμῳ, καὶ ⸀οὐδὲν",
          {
            "noteId": 259
          },
          "ἄφωνον·"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ἐὰν οὖν μὴ εἰδῶ τὴν δύναμιν τῆς φωνῆς, ἔσομαι τῷ λαλοῦντι βάρβαρος καὶ ὁ λαλῶν ἐν ἐμοὶ βάρβαρος."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "οὕτως καὶ ὑμεῖς, ἐπεὶ ζηλωταί ἐστε πνευμάτων, πρὸς τὴν οἰκοδομὴν τῆς ἐκκλησίας ζητεῖτε ἵνα περισσεύητε."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "⸀Διὸ",
          {
            "noteId": 260
          },
          "ὁ λαλῶν γλώσσῃ προσευχέσθω ἵνα διερμηνεύῃ."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἐὰν γὰρ προσεύχωμαι γλώσσῃ, τὸ πνεῦμά μου προσεύχεται, ὁ δὲ νοῦς μου ἄκαρπός ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "τί οὖν ἐστιν; προσεύξομαι τῷ πνεύματι, προσεύξομαι δὲ καὶ τῷ νοΐ· ψαλῶ τῷ πνεύματι, ψαλῶ δὲ καὶ τῷ νοΐ·"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ἐπεὶ ἐὰν ⸀εὐλογῇς",
          {
            "noteId": 261
          },
          "⸀πνεύματι",
          {
            "noteId": 262
          },
          "ὁ ἀναπληρῶν τὸν τόπον τοῦ ἰδιώτου πῶς ἐρεῖ τὸ Ἀμήν ἐπὶ τῇ σῇ εὐχαριστίᾳ; ἐπειδὴ τί λέγεις οὐκ οἶδεν·"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "σὺ μὲν γὰρ καλῶς εὐχαριστεῖς, ἀλλʼ ὁ ἕτερος οὐκ οἰκοδομεῖται."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "εὐχαριστῶ τῷ ⸀θεῷ",
          {
            "noteId": 263
          },
          "πάντων ὑμῶν μᾶλλον ⸀γλώσσαις",
          {
            "noteId": 264
          },
          "⸀λαλῶ",
          {
            "noteId": 265
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἀλλὰ ἐν ἐκκλησίᾳ θέλω πέντε λόγους ⸂τῷ νοΐ",
          {
            "noteId": 266
          },
          "μου λαλῆσαι, ἵνα καὶ ἄλλους κατηχήσω, ἢ μυρίους λόγους ἐν γλώσσῃ."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Ἀδελφοί, μὴ παιδία γίνεσθε ταῖς φρεσίν, ἀλλὰ τῇ κακίᾳ νηπιάζετε, ταῖς δὲ φρεσὶν τέλειοι γίνεσθε."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ἐν τῷ νόμῳ γέγραπται ὅτι Ἐν ἑτερογλώσσοις καὶ ἐν χείλεσιν ⸀ἑτέρων",
          {
            "noteId": 267
          },
          "λαλήσω τῷ λαῷ τούτῳ, καὶ οὐδʼ οὕτως εἰσακούσονταί μου, λέγει κύριος."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ὥστε αἱ γλῶσσαι εἰς σημεῖόν εἰσιν οὐ τοῖς πιστεύουσιν ἀλλὰ τοῖς ἀπίστοις, ἡ δὲ προφητεία οὐ τοῖς ἀπίστοις ἀλλὰ τοῖς πιστεύουσιν."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ἐὰν οὖν συνέλθῃ ἡ ἐκκλησία ὅλη ἐπὶ τὸ αὐτὸ καὶ πάντες ⸂λαλῶσιν γλώσσαις",
          {
            "noteId": 268
          },
          ", εἰσέλθωσιν δὲ ἰδιῶται ἢ ἄπιστοι, οὐκ ἐροῦσιν ὅτι μαίνεσθε;"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ἐὰν δὲ πάντες προφητεύωσιν, εἰσέλθῃ δέ τις ἄπιστος ἢ ἰδιώτης, ἐλέγχεται ὑπὸ πάντων, ἀνακρίνεται ὑπὸ πάντων,"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "⸀τὰ",
          {
            "noteId": 269
          },
          "κρυπτὰ τῆς καρδίας αὐτοῦ φανερὰ γίνεται, καὶ οὕτως πεσὼν ἐπὶ πρόσωπον προσκυνήσει τῷ θεῷ, ἀπαγγέλλων ὅτι ⸂Ὄντως ὁ θεὸς",
          {
            "noteId": 270
          },
          "ἐν ὑμῖν ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Τί οὖν ἐστιν, ἀδελφοί; ὅταν συνέρχησθε, ⸀ἕκαστος",
          {
            "noteId": 271
          },
          "ψαλμὸν ἔχει, διδαχὴν ἔχει, ⸂ἀποκάλυψιν ἔχει, γλῶσσαν⸃ ἔχει, ἑρμηνείαν ἔχει· πάντα πρὸς οἰκοδομὴν γινέσθω.",
          {
            "noteId": 272
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "εἴτε γλώσσῃ τις λαλεῖ, κατὰ δύο ἢ τὸ πλεῖστον τρεῖς, καὶ ἀνὰ μέρος, καὶ εἷς διερμηνευέτω·"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ἐὰν δὲ μὴ ᾖ ⸀διερμηνευτής",
          {
            "noteId": 273
          },
          "σιγάτω ἐν ἐκκλησίᾳ, ἑαυτῷ δὲ λαλείτω καὶ τῷ θεῷ."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "προφῆται δὲ δύο ἢ τρεῖς λαλείτωσαν, καὶ οἱ ἄλλοι διακρινέτωσαν·"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ἐὰν δὲ ἄλλῳ ἀποκαλυφθῇ καθημένῳ, ὁ πρῶτος σιγάτω."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "δύνασθε γὰρ καθʼ ἕνα πάντες προφητεύειν, ἵνα πάντες μανθάνωσιν καὶ πάντες παρακαλῶνται"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "(καὶ πνεύματα προφητῶν προφήταις ὑποτάσσεται,"
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "οὐ γάρ ἐστιν ἀκαταστασίας ὁ θεὸς ἀλλὰ εἰρήνης), ὡς ἐν πάσαις ταῖς ἐκκλησίαις τῶν ἁγίων."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "Αἱ ⸀γυναῖκες",
          {
            "noteId": 274
          },
          "ἐν ταῖς ἐκκλησίαις σιγάτωσαν, οὐ γὰρ ⸀ἐπιτρέπεται",
          {
            "noteId": 275
          },
          "αὐταῖς λαλεῖν· ἀλλὰ ⸀ὑποτασσέσθωσαν",
          {
            "noteId": 276
          },
          "καθὼς καὶ ὁ νόμος λέγει."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "εἰ δέ τι ⸀μαθεῖν",
          {
            "noteId": 277
          },
          "θέλουσιν, ἐν οἴκῳ τοὺς ἰδίους ἄνδρας ἐπερωτάτωσαν, αἰσχρὸν γάρ ἐστιν γυναικὶ ⸂λαλεῖν ἐν ἐκκλησίᾳ",
          {
            "noteId": 278
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "ἢ ἀφʼ ὑμῶν ὁ λόγος τοῦ θεοῦ ἐξῆλθεν, ἢ εἰς ὑμᾶς μόνους κατήντησεν;"
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "Εἴ τις δοκεῖ προφήτης εἶναι ἢ πνευματικός, ἐπιγινωσκέτω ἃ γράφω ὑμῖν ὅτι κυρίου ⸀ἐστίν",
          {
            "noteId": 279
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "εἰ δέ τις ἀγνοεῖ, ⸀ἀγνοεῖται",
          {
            "noteId": 280
          }
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "ὥστε, ἀδελφοί ⸀μου",
          {
            "noteId": 281
          },
          "ζηλοῦτε τὸ προφητεύειν, καὶ τὸ λαλεῖν ⸂μὴ κωλύετε γλώσσαις",
          {
            "noteId": 282
          },
          "·"
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "πάντα ⸀δὲ",
          {
            "noteId": 283
          },
          "εὐσχημόνως καὶ κατὰ τάξιν γινέσθω."
        ]
      }
    ],
