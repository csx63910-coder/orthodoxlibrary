  "chapter": {
    "number": 6,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Τολμᾷ τις ὑμῶν πρᾶγμα ἔχων πρὸς τὸν ἕτερον κρίνεσθαι ἐπὶ τῶν ἀδίκων, καὶ οὐχὶ ἐπὶ τῶν ἁγίων;"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "⸀ἢ",
          {
            "noteId": 62
          },
          "οὐκ οἴδατε ὅτι οἱ ἅγιοι τὸν κόσμον κρινοῦσιν; καὶ εἰ ἐν ὑμῖν κρίνεται ὁ κόσμος, ἀνάξιοί ἐστε κριτηρίων ἐλαχίστων;"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "οὐκ οἴδατε ὅτι ἀγγέλους κρινοῦμεν, μήτιγε βιωτικά;"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "βιωτικὰ μὲν οὖν κριτήρια ἐὰν ἔχητε, τοὺς ἐξουθενημένους ἐν τῇ ἐκκλησίᾳ, τούτους καθίζετε;"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "πρὸς ἐντροπὴν ὑμῖν λέγω. οὕτως οὐκ ἔνι ἐν ὑμῖν ⸂οὐδεὶς σοφὸς",
          {
            "noteId": 63
          },
          "ὃς δυνήσεται διακρῖναι ἀνὰ μέσον τοῦ ⸀ἀδελφοῦ",
          {
            "noteId": 64
          },
          "αὐτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἀλλὰ ἀδελφὸς μετὰ ἀδελφοῦ κρίνεται, καὶ τοῦτο ἐπὶ ἀπίστων;"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἤδη μὲν ⸀οὖν",
          {
            "noteId": 65
          },
          "ὅλως ἥττημα ὑμῖν ἐστιν ὅτι κρίματα ἔχετε μεθʼ ἑαυτῶν· διὰ τί οὐχὶ μᾶλλον ἀδικεῖσθε; διὰ τί οὐχὶ μᾶλλον ἀποστερεῖσθε;"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἀλλὰ ὑμεῖς ἀδικεῖτε καὶ ἀποστερεῖτε, καὶ ⸀τοῦτο",
          {
            "noteId": 66
          },
          "ἀδελφούς."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Ἢ οὐκ οἴδατε ὅτι ἄδικοι ⸂θεοῦ βασιλείαν",
          {
            "noteId": 67
          },
          "οὐ κληρονομήσουσιν; μὴ πλανᾶσθε· οὔτε πόρνοι οὔτε εἰδωλολάτραι οὔτε μοιχοὶ οὔτε μαλακοὶ οὔτε ἀρσενοκοῖται"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "οὔτε ⸂κλέπται οὔτε πλεονέκται",
          {
            "noteId": 68
          },
          ", ⸀οὐ",
          {
            "noteId": 69
          },
          "μέθυσοι, οὐ λοίδοροι, οὐχ ἅρπαγες βασιλείαν ⸀θεοῦ",
          {
            "noteId": 70
          },
          "κληρονομήσουσιν."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ ταῦτά τινες ἦτε· ἀλλὰ ἀπελούσασθε, ἀλλὰ ἡγιάσθητε, ἀλλὰ ἐδικαιώθητε ἐν τῷ ὀνόματι τοῦ κυρίου ⸀Ἰησοῦ",
          {
            "noteId": 71
          },
          "καὶ ἐν τῷ πνεύματι τοῦ θεοῦ ἡμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Πάντα μοι ἔξεστιν· ἀλλʼ οὐ πάντα συμφέρει. πάντα μοι ἔξεστιν· ἀλλʼ οὐκ ἐγὼ ἐξουσιασθήσομαι ὑπό τινος."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "τὰ βρώματα τῇ κοιλίᾳ, καὶ ἡ κοιλία τοῖς βρώμασιν· ὁ δὲ θεὸς καὶ ταύτην καὶ ταῦτα καταργήσει. τὸ δὲ σῶμα οὐ τῇ πορνείᾳ ἀλλὰ τῷ κυρίῳ, καὶ ὁ κύριος τῷ σώματι·"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ὁ δὲ θεὸς καὶ τὸν κύριον ἤγειρεν καὶ ἡμᾶς ἐξεγερεῖ διὰ τῆς δυνάμεως αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "οὐκ οἴδατε ὅτι τὰ σώματα ὑμῶν μέλη Χριστοῦ ἐστιν; ἄρας οὖν τὰ μέλη τοῦ Χριστοῦ ποιήσω πόρνης μέλη; μὴ γένοιτο."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "⸀ἢ",
          {
            "noteId": 72
          },
          "οὐκ οἴδατε ὅτι ὁ κολλώμενος τῇ πόρνῃ ἓν σῶμά ἐστιν; Ἔσονται γάρ, φησίν, οἱ δύο εἰς σάρκα μίαν."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ὁ δὲ κολλώμενος τῷ κυρίῳ ἓν πνεῦμά ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "φεύγετε τὴν πορνείαν· πᾶν ἁμάρτημα ὃ ἐὰν ποιήσῃ ἄνθρωπος ἐκτὸς τοῦ σώματός ἐστιν, ὁ δὲ πορνεύων εἰς τὸ ἴδιον σῶμα ἁμαρτάνει."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἢ οὐκ οἴδατε ὅτι τὸ σῶμα ὑμῶν ναὸς τοῦ ἐν ὑμῖν ἁγίου πνεύματός ἐστιν, οὗ ἔχετε ἀπὸ θεοῦ; καὶ οὐκ ἐστὲ ἑαυτῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἠγοράσθητε γὰρ τιμῆς· δοξάσατε δὴ τὸν θεὸν ἐν τῷ σώματι ⸀ὑμῶν",
          {
            "noteId": 73
          }
        ]
      }
    ],
