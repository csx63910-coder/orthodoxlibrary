  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Κἀγώ, ἀδελφοί, οὐκ ἠδυνήθην ⸂λαλῆσαι ὑμῖν",
          {
            "noteId": 24
          },
          "ὡς πνευματικοῖς ἀλλʼ ὡς ⸀σαρκίνοις",
          {
            "noteId": 25
          },
          "ὡς νηπίοις ἐν Χριστῷ."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "γάλα ὑμᾶς ἐπότισα, ⸀οὐ",
          {
            "noteId": 26
          },
          "βρῶμα, οὔπω γὰρ ἐδύνασθε. ἀλλʼ ⸀οὐδὲ",
          {
            "noteId": 27
          },
          "ἔτι νῦν δύνασθε,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἔτι γὰρ σαρκικοί ἐστε. ὅπου γὰρ ἐν ὑμῖν ζῆλος καὶ ⸀ἔρις",
          {
            "noteId": 28
          },
          "οὐχὶ σαρκικοί ἐστε καὶ κατὰ ἄνθρωπον περιπατεῖτε;"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ὅταν γὰρ λέγῃ τις· Ἐγὼ μέν εἰμι Παύλου, ἕτερος δέ· Ἐγὼ Ἀπολλῶ, ⸂οὐκ ἄνθρωποί",
          {
            "noteId": 29
          },
          "ἐστε;"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "⸀Τί",
          {
            "noteId": 30
          },
          "οὖν ἐστιν ⸂Ἀπολλῶς; τί δέ ἐστιν Παῦλος⸃; ⸀διάκονοι διʼ ὧν ἐπιστεύσατε, καὶ ἑκάστῳ ὡς ὁ κύριος ἔδωκεν.",
          {
            "noteId": 31
          },
          {
            "noteId": 32
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἐγὼ ἐφύτευσα, Ἀπολλῶς ἐπότισεν, ἀλλὰ ὁ θεὸς ηὔξανεν·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ὥστε οὔτε ὁ φυτεύων ἐστίν τι οὔτε ὁ ποτίζων, ἀλλʼ ὁ αὐξάνων θεός."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ὁ φυτεύων δὲ καὶ ὁ ποτίζων ἕν εἰσιν, ἕκαστος δὲ τὸν ἴδιον μισθὸν λήμψεται κατὰ τὸν ἴδιον κόπον,"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "θεοῦ γάρ ἐσμεν συνεργοί· θεοῦ γεώργιον, θεοῦ οἰκοδομή ἐστε."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Κατὰ τὴν χάριν τοῦ θεοῦ τὴν δοθεῖσάν μοι ὡς σοφὸς ἀρχιτέκτων θεμέλιον ⸀ἔθηκα",
          {
            "noteId": 33
          },
          "ἄλλος δὲ ἐποικοδομεῖ. ἕκαστος δὲ βλεπέτω πῶς ἐποικοδομεῖ·"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "θεμέλιον γὰρ ἄλλον οὐδεὶς δύναται θεῖναι παρὰ τὸν κείμενον, ὅς ἐστιν Ἰησοῦς Χριστός·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "εἰ δέ τις ἐποικοδομεῖ ἐπὶ τὸν ⸀θεμέλιον",
          {
            "noteId": 34
          },
          "⸂χρυσόν, ἄργυρον⸃, λίθους τιμίους, ξύλα, χόρτον, καλάμην,",
          {
            "noteId": 35
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ἑκάστου τὸ ἔργον φανερὸν γενήσεται, ἡ γὰρ ἡμέρα δηλώσει· ὅτι ἐν πυρὶ ἀποκαλύπτεται, καὶ ἑκάστου τὸ ἔργον ὁποῖόν ἐστιν τὸ πῦρ ⸀αὐτὸ",
          {
            "noteId": 36
          },
          "δοκιμάσει."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "εἴ τινος τὸ ἔργον μενεῖ ὃ ἐποικοδόμησεν, μισθὸν λήμψεται·"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "εἴ τινος τὸ ἔργον κατακαήσεται, ζημιωθήσεται, αὐτὸς δὲ σωθήσεται, οὕτως δὲ ὡς διὰ πυρός."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Οὐκ οἴδατε ὅτι ναὸς θεοῦ ἐστε καὶ τὸ πνεῦμα τοῦ θεοῦ ⸂οἰκεῖ ἐν ὑμῖν",
          {
            "noteId": 37
          },
          ";"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "εἴ τις τὸν ναὸν τοῦ θεοῦ φθείρει, φθερεῖ τοῦτον ὁ θεός· ὁ γὰρ ναὸς τοῦ θεοῦ ἅγιός ἐστιν, οἵτινές ἐστε ὑμεῖς."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Μηδεὶς ἑαυτὸν ἐξαπατάτω· εἴ τις δοκεῖ σοφὸς εἶναι ἐν ὑμῖν ἐν τῷ αἰῶνι τούτῳ, μωρὸς γενέσθω, ἵνα γένηται σοφός,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἡ γὰρ σοφία τοῦ κόσμου τούτου μωρία παρὰ τῷ θεῷ ἐστιν· γέγραπται γάρ· Ὁ δρασσόμενος τοὺς σοφοὺς ἐν τῇ πανουργίᾳ αὐτῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "καὶ πάλιν· Κύριος γινώσκει τοὺς διαλογισμοὺς τῶν σοφῶν ὅτι εἰσὶν μάταιοι."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ὥστε μηδεὶς καυχάσθω ἐν ἀνθρώποις· πάντα γὰρ ὑμῶν ἐστιν,"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "εἴτε Παῦλος εἴτε Ἀπολλῶς εἴτε Κηφᾶς εἴτε κόσμος εἴτε ζωὴ εἴτε θάνατος εἴτε ἐνεστῶτα εἴτε μέλλοντα, πάντα ⸀ὑμῶν",
          {
            "noteId": 38
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ὑμεῖς δὲ Χριστοῦ, Χριστὸς δὲ θεοῦ."
        ]
      }
    ],
