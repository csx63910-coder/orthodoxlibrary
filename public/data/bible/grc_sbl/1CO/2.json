  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Κἀγὼ ἐλθὼν πρὸς ὑμᾶς, ἀδελφοί, ἦλθον οὐ καθʼ ὑπεροχὴν λόγου ἢ σοφίας καταγγέλλων ὑμῖν τὸ ⸀μαρτύριον",
          {
            "noteId": 13
          },
          "τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "οὐ γὰρ ἔκρινά ⸂τι εἰδέναι",
          {
            "noteId": 14
          },
          "ἐν ὑμῖν εἰ μὴ Ἰησοῦν Χριστὸν καὶ τοῦτον ἐσταυρωμένον·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "κἀγὼ ἐν ἀσθενείᾳ καὶ ἐν φόβῳ καὶ ἐν τρόμῳ πολλῷ ἐγενόμην πρὸς ὑμᾶς,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ ὁ λόγος μου καὶ τὸ κήρυγμά μου οὐκ ἐν ⸂πειθοῖ σοφίας",
          {
            "noteId": 15
          },
          "ἀλλʼ ἐν ἀποδείξει πνεύματος καὶ δυνάμεως,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἵνα ἡ πίστις ὑμῶν μὴ ᾖ ἐν σοφίᾳ ἀνθρώπων ἀλλʼ ἐν δυνάμει θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Σοφίαν δὲ λαλοῦμεν ἐν τοῖς τελείοις, σοφίαν δὲ οὐ τοῦ αἰῶνος τούτου οὐδὲ τῶν ἀρχόντων τοῦ αἰῶνος τούτου τῶν καταργουμένων·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἀλλὰ λαλοῦμεν ⸂θεοῦ σοφίαν",
          {
            "noteId": 16
          },
          "ἐν μυστηρίῳ, τὴν ἀποκεκρυμμένην, ἣν προώρισεν ὁ θεὸς πρὸ τῶν αἰώνων εἰς δόξαν ἡμῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἣν οὐδεὶς τῶν ἀρχόντων τοῦ αἰῶνος τούτου ἔγνωκεν, εἰ γὰρ ἔγνωσαν, οὐκ ἂν τὸν κύριον τῆς δόξης ἐσταύρωσαν·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ἀλλὰ καθὼς γέγραπται· Ἃ ὀφθαλμὸς οὐκ εἶδεν καὶ οὖς οὐκ ἤκουσεν καὶ ἐπὶ καρδίαν ἀνθρώπου οὐκ ἀνέβη, ⸀ὅσα",
          {
            "noteId": 17
          },
          "ἡτοίμασεν ὁ θεὸς τοῖς ἀγαπῶσιν αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἡμῖν ⸀γὰρ",
          {
            "noteId": 18
          },
          "⸂ἀπεκάλυψεν ὁ θεὸς",
          {
            "noteId": 19
          },
          "διὰ τοῦ ⸀πνεύματος",
          {
            "noteId": 20
          },
          "τὸ γὰρ πνεῦμα πάντα ἐραυνᾷ, καὶ τὰ βάθη τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "τίς γὰρ οἶδεν ἀνθρώπων τὰ τοῦ ἀνθρώπου εἰ μὴ τὸ πνεῦμα τοῦ ἀνθρώπου τὸ ἐν αὐτῷ; οὕτως καὶ τὰ τοῦ θεοῦ οὐδεὶς ⸀ἔγνωκεν",
          {
            "noteId": 21
          },
          "εἰ μὴ τὸ πνεῦμα τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ἡμεῖς δὲ οὐ τὸ πνεῦμα τοῦ κόσμου ἐλάβομεν ἀλλὰ τὸ πνεῦμα τὸ ἐκ τοῦ θεοῦ, ἵνα εἰδῶμεν τὰ ὑπὸ τοῦ θεοῦ χαρισθέντα ἡμῖν·"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ἃ καὶ λαλοῦμεν οὐκ ἐν διδακτοῖς ἀνθρωπίνης σοφίας λόγοις, ἀλλʼ ἐν διδακτοῖς ⸀πνεύματος",
          {
            "noteId": 22
          },
          "πνευματικοῖς πνευματικὰ συγκρίνοντες."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Ψυχικὸς δὲ ἄνθρωπος οὐ δέχεται τὰ τοῦ πνεύματος τοῦ θεοῦ, μωρία γὰρ αὐτῷ ἐστίν, καὶ οὐ δύναται γνῶναι, ὅτι πνευματικῶς ἀνακρίνεται·"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ὁ δὲ πνευματικὸς ἀνακρίνει ⸀τὰ",
          {
            "noteId": 23
          },
          "πάντα, αὐτὸς δὲ ὑπʼ οὐδενὸς ἀνακρίνεται."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "τίς γὰρ ἔγνω νοῦν κυρίου, ὃς συμβιβάσει αὐτόν; ἡμεῖς δὲ νοῦν Χριστοῦ ἔχομεν."
        ]
      }
    ],
