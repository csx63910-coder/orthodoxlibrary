  "chapter": {
    "number": 9,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Οὐκ εἰμὶ ⸂ἐλεύθερος; οὐκ εἰμὶ ἀπόστολος⸃; οὐχὶ ⸀Ἰησοῦν τὸν κύριον ἡμῶν ἑόρακα; οὐ τὸ ἔργον μου ὑμεῖς ἐστε ἐν κυρίῳ;",
          {
            "noteId": 134
          },
          {
            "noteId": 135
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "εἰ ἄλλοις οὐκ εἰμὶ ἀπόστολος, ἀλλά γε ὑμῖν εἰμι, ἡ γὰρ σφραγίς ⸂μου τῆς",
          {
            "noteId": 136
          },
          "ἀποστολῆς ὑμεῖς ἐστε ἐν κυρίῳ."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Ἡ ἐμὴ ἀπολογία τοῖς ἐμὲ ἀνακρίνουσίν ⸂ἐστιν αὕτη",
          {
            "noteId": 137
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "μὴ οὐκ ἔχομεν ἐξουσίαν φαγεῖν καὶ ⸀πεῖν",
          {
            "noteId": 138
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "μὴ οὐκ ἔχομεν ἐξουσίαν ἀδελφὴν γυναῖκα περιάγειν, ὡς καὶ οἱ λοιποὶ ἀπόστολοι καὶ οἱ ἀδελφοὶ τοῦ κυρίου καὶ Κηφᾶς;"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἢ μόνος ἐγὼ καὶ Βαρναβᾶς οὐκ ἔχομεν ἐξουσίαν ⸀μὴ",
          {
            "noteId": 139
          },
          "ἐργάζεσθαι;"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "τίς στρατεύεται ἰδίοις ὀψωνίοις ποτέ; τίς φυτεύει ἀμπελῶνα καὶ ⸂τὸν καρπὸν",
          {
            "noteId": 140
          },
          "αὐτοῦ οὐκ ἐσθίει; ⸀τίς",
          {
            "noteId": 141
          },
          "ποιμαίνει ποίμνην καὶ ἐκ τοῦ γάλακτος τῆς ποίμνης οὐκ ἐσθίει;"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Μὴ κατὰ ἄνθρωπον ταῦτα λαλῶ ἢ ⸂καὶ ὁ νόμος ταῦτα οὐ",
          {
            "noteId": 142
          },
          "λέγει;"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ἐν γὰρ τῷ Μωϋσέως νόμῳ γέγραπται· Οὐ ⸀κημώσεις",
          {
            "noteId": 143
          },
          "βοῦν ἀλοῶντα. μὴ τῶν βοῶν μέλει τῷ θεῷ,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἢ διʼ ἡμᾶς πάντως λέγει; διʼ ἡμᾶς γὰρ ἐγράφη, ὅτι ⸂ὀφείλει ἐπʼ ἐλπίδι",
          {
            "noteId": 144
          },
          "ὁ ἀροτριῶν ἀροτριᾶν, καὶ ὁ ἀλοῶν ⸂ἐπʼ ἐλπίδι τοῦ μετέχειν",
          {
            "noteId": 145
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "εἰ ἡμεῖς ὑμῖν τὰ πνευματικὰ ἐσπείραμεν, μέγα εἰ ἡμεῖς ὑμῶν τὰ σαρκικὰ θερίσομεν;"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "εἰ ἄλλοι τῆς ⸂ὑμῶν ἐξουσίας",
          {
            "noteId": 146
          },
          "μετέχουσιν, οὐ μᾶλλον ἡμεῖς;",
          {
            "noteId": 147
          },
          "Ἀλλʼ οὐκ ἐχρησάμεθα τῇ ἐξουσίᾳ ταύτῃ, ἀλλὰ πάντα στέγομεν ἵνα μή ⸂τινα ἐγκοπὴν⸃ δῶμεν τῷ εὐαγγελίῳ τοῦ Χριστοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "οὐκ οἴδατε ὅτι οἱ τὰ",
          {
            "noteId": 148
          },
          "ἱερὰ ἐργαζόμενοι ⸀τὰ ἐκ τοῦ ἱεροῦ ἐσθίουσιν, οἱ τῷ θυσιαστηρίῳ ⸀παρεδρεύοντες",
          {
            "noteId": 149
          },
          "τῷ θυσιαστηρίῳ συμμερίζονται;"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "οὕτως καὶ ὁ κύριος διέταξεν τοῖς τὸ εὐαγγέλιον καταγγέλλουσιν ἐκ τοῦ εὐαγγελίου ζῆν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Ἐγὼ δὲ ⸂οὐ κέχρημαι οὐδενὶ",
          {
            "noteId": 150
          },
          "τούτων. οὐκ ἔγραψα δὲ ταῦτα ἵνα οὕτως γένηται ἐν ἐμοί, καλὸν γάρ μοι μᾶλλον ἀποθανεῖν ἤ— τὸ καύχημά μου ⸂οὐδεὶς κενώσει",
          {
            "noteId": 151
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ἐὰν γὰρ εὐαγγελίζωμαι, οὐκ ἔστιν μοι καύχημα, ἀνάγκη γάρ",
          {
            "noteId": 152
          },
          "μοι ἐπίκειται· οὐαὶ ⸀γάρ μοί ἐστιν ἐὰν μὴ ⸀εὐαγγελίσωμαι",
          {
            "noteId": 153
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "εἰ γὰρ ἑκὼν τοῦτο πράσσω, μισθὸν ἔχω· εἰ δὲ ἄκων, οἰκονομίαν πεπίστευμαι."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "τίς οὖν ⸀μού",
          {
            "noteId": 154
          },
          "ἐστιν ὁ μισθός; ἵνα εὐαγγελιζόμενος ἀδάπανον θήσω τὸ ⸀εὐαγγέλιον",
          {
            "noteId": 155
          },
          "εἰς τὸ μὴ καταχρήσασθαι τῇ ἐξουσίᾳ μου ἐν τῷ εὐαγγελίῳ."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Ἐλεύθερος γὰρ ὢν ἐκ πάντων πᾶσιν ἐμαυτὸν ἐδούλωσα, ἵνα τοὺς πλείονας κερδήσω·"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "καὶ ἐγενόμην τοῖς Ἰουδαίοις ὡς Ἰουδαῖος, ἵνα Ἰουδαίους κερδήσω· τοῖς ὑπὸ νόμον ὡς ὑπὸ νόμον, ⸂μὴ ὢν αὐτὸς ὑπὸ νόμον",
          {
            "noteId": 156
          },
          ", ἵνα τοὺς ὑπὸ νόμον κερδήσω·"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "τοῖς ἀνόμοις ὡς ἄνομος, μὴ ὢν ἄνομος ⸀θεοῦ",
          {
            "noteId": 157
          },
          "ἀλλʼ ἔννομος ⸀Χριστοῦ",
          {
            "noteId": 158
          },
          "ἵνα ⸀κερδάνω",
          {
            "noteId": 159
          },
          "⸀τοὺς",
          {
            "noteId": 160
          },
          "ἀνόμους·"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ἐγενόμην τοῖς ⸀ἀσθενέσιν",
          {
            "noteId": 161
          },
          "ἀσθενής, ἵνα τοὺς ἀσθενεῖς κερδήσω· τοῖς πᾶσιν ⸀γέγονα",
          {
            "noteId": 162
          },
          "πάντα, ἵνα πάντως τινὰς σώσω."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "⸀πάντα",
          {
            "noteId": 163
          },
          "δὲ ποιῶ διὰ τὸ εὐαγγέλιον, ἵνα συγκοινωνὸς αὐτοῦ γένωμαι."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Οὐκ οἴδατε ὅτι οἱ ἐν σταδίῳ τρέχοντες πάντες μὲν τρέχουσιν, εἷς δὲ λαμβάνει τὸ βραβεῖον; οὕτως τρέχετε ἵνα καταλάβητε."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "πᾶς δὲ ὁ ἀγωνιζόμενος πάντα ἐγκρατεύεται, ἐκεῖνοι μὲν οὖν ἵνα φθαρτὸν στέφανον λάβωσιν, ἡμεῖς δὲ ἄφθαρτον."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ἐγὼ τοίνυν οὕτως τρέχω ὡς οὐκ ἀδήλως, οὕτως πυκτεύω ὡς οὐκ ἀέρα δέρων·"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "ἀλλὰ ὑπωπιάζω μου τὸ σῶμα καὶ δουλαγωγῶ, μή πως ἄλλοις κηρύξας αὐτὸς ἀδόκιμος γένωμαι."
        ]
      }
    ],
