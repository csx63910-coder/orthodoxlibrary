  "chapter": {
    "number": 15,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Γνωρίζω δὲ ὑμῖν, ἀδελφοί, τὸ εὐαγγέλιον ὃ εὐηγγελισάμην ὑμῖν, ὃ καὶ παρελάβετε, ἐν ᾧ καὶ ἑστήκατε,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "διʼ οὗ καὶ σῴζεσθε, τίνι λόγῳ εὐηγγελισάμην ὑμῖν, εἰ κατέχετε, ἐκτὸς εἰ μὴ εἰκῇ ἐπιστεύσατε."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Παρέδωκα γὰρ ὑμῖν ἐν πρώτοις, ὃ καὶ παρέλαβον, ὅτι Χριστὸς ἀπέθανεν ὑπὲρ τῶν ἁμαρτιῶν ἡμῶν κατὰ τὰς γραφάς,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ ὅτι ἐτάφη, καὶ ὅτι ἐγήγερται τῇ ⸂ἡμέρᾳ τῇ τρίτῃ",
          {
            "noteId": 284
          },
          "κατὰ τὰς γραφάς,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ ὅτι ὤφθη Κηφᾷ, εἶτα τοῖς δώδεκα·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἔπειτα ὤφθη ἐπάνω πεντακοσίοις ἀδελφοῖς ἐφάπαξ, ἐξ ὧν οἱ ⸀πλείονες",
          {
            "noteId": 285
          },
          "μένουσιν ἕως ἄρτι, τινὲς ⸀δὲ",
          {
            "noteId": 286
          },
          "ἐκοιμήθησαν·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἔπειτα ὤφθη Ἰακώβῳ, εἶτα τοῖς ἀποστόλοις πᾶσιν·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἔσχατον δὲ πάντων ὡσπερεὶ τῷ ἐκτρώματι ὤφθη κἀμοί."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ἐγὼ γάρ εἰμι ὁ ἐλάχιστος τῶν ἀποστόλων, ὃς οὐκ εἰμὶ ἱκανὸς καλεῖσθαι ἀπόστολος, διότι ἐδίωξα τὴν ἐκκλησίαν τοῦ θεοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "χάριτι δὲ θεοῦ εἰμι ὅ εἰμι, καὶ ἡ",
          {
            "noteId": 287
          },
          "χάρις αὐτοῦ ἡ εἰς ἐμὲ οὐ κενὴ ἐγενήθη, ἀλλὰ περισσότερον αὐτῶν πάντων ἐκοπίασα, οὐκ ἐγὼ δὲ ἀλλὰ ἡ χάρις τοῦ θεοῦ ⸀ἡ σὺν ἐμοί."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "εἴτε οὖν ἐγὼ εἴτε ἐκεῖνοι, οὕτως κηρύσσομεν καὶ οὕτως ἐπιστεύσατε."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Εἰ δὲ Χριστὸς κηρύσσεται ὅτι ἐκ νεκρῶν ἐγήγερται, πῶς λέγουσιν ⸂ἐν ὑμῖν τινες",
          {
            "noteId": 288
          },
          "ὅτι ἀνάστασις νεκρῶν οὐκ ἔστιν;"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "εἰ δὲ ἀνάστασις νεκρῶν οὐκ ἔστιν, οὐδὲ Χριστὸς ἐγήγερται·"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "εἰ δὲ Χριστὸς οὐκ ἐγήγερται, κενὸν ⸀ἄρα",
          {
            "noteId": 289
          },
          "τὸ κήρυγμα ἡμῶν, ⸀κενὴ",
          {
            "noteId": 290
          },
          "καὶ ἡ πίστις ⸀ὑμῶν",
          {
            "noteId": 291
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "εὑρισκόμεθα δὲ καὶ ψευδομάρτυρες τοῦ θεοῦ, ὅτι ἐμαρτυρήσαμεν κατὰ τοῦ θεοῦ ὅτι ἤγειρεν τὸν Χριστόν, ὃν οὐκ ἤγειρεν εἴπερ ἄρα νεκροὶ οὐκ ἐγείρονται."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "εἰ γὰρ νεκροὶ οὐκ ἐγείρονται, οὐδὲ Χριστὸς ἐγήγερται·"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "εἰ δὲ Χριστὸς οὐκ ἐγήγερται, ματαία ἡ πίστις ⸀ὑμῶν",
          {
            "noteId": 292
          },
          "ἔτι ἐστὲ ἐν ταῖς ἁμαρτίαις ὑμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ἄρα καὶ οἱ κοιμηθέντες ἐν Χριστῷ ἀπώλοντο."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "εἰ ἐν τῇ ζωῇ ταύτῃ ⸂ἐν Χριστῷ ἠλπικότες ἐσμὲν",
          {
            "noteId": 293
          },
          "μόνον, ἐλεεινότεροι πάντων ἀνθρώπων ἐσμέν."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Νυνὶ δὲ Χριστὸς ἐγήγερται ἐκ νεκρῶν, ἀπαρχὴ τῶν ⸀κεκοιμημένων",
          {
            "noteId": 294
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ἐπειδὴ γὰρ διʼ ἀνθρώπου ⸀θάνατος",
          {
            "noteId": 295
          },
          "καὶ διʼ ἀνθρώπου ἀνάστασις νεκρῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ὥσπερ γὰρ ἐν τῷ Ἀδὰμ πάντες ἀποθνῄσκουσιν, οὕτως καὶ ἐν τῷ Χριστῷ πάντες ζῳοποιηθήσονται."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ἕκαστος δὲ ἐν τῷ ἰδίῳ τάγματι· ἀπαρχὴ Χριστός, ἔπειτα οἱ τοῦ Χριστοῦ ἐν τῇ παρουσίᾳ αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "εἶτα τὸ τέλος, ὅταν ⸀παραδιδῷ",
          {
            "noteId": 296
          },
          "τὴν βασιλείαν τῷ θεῷ καὶ πατρί, ὅταν καταργήσῃ πᾶσαν ἀρχὴν καὶ πᾶσαν ἐξουσίαν καὶ δύναμιν,"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "δεῖ γὰρ αὐτὸν βασιλεύειν ἄχρι ⸀οὗ",
          {
            "noteId": 297
          },
          "θῇ πάντας τοὺς ἐχθροὺς ὑπὸ τοὺς πόδας αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ἔσχατος ἐχθρὸς καταργεῖται ὁ θάνατος,"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "πάντα γὰρ ὑπέταξεν ὑπὸ τοὺς πόδας αὐτοῦ. ὅταν δὲ εἴπῃ ὅτι πάντα ὑποτέτακται, δῆλον ὅτι ἐκτὸς τοῦ ὑποτάξαντος αὐτῷ τὰ πάντα."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ὅταν δὲ ὑποταγῇ αὐτῷ τὰ πάντα, ⸀τότε",
          {
            "noteId": 298
          },
          "αὐτὸς ὁ υἱὸς ὑποταγήσεται τῷ ὑποτάξαντι αὐτῷ τὰ πάντα",
          {
            "noteId": 299
          },
          "ἵνα ᾖ ὁ θεὸς ⸀πάντα ἐν πᾶσιν."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Ἐπεὶ τί ποιήσουσιν οἱ βαπτιζόμενοι ὑπὲρ τῶν νεκρῶν; εἰ ὅλως νεκροὶ οὐκ ἐγείρονται, τί καὶ βαπτίζονται ὑπὲρ ⸀αὐτῶν",
          {
            "noteId": 300
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "τί καὶ ἡμεῖς κινδυνεύομεν πᾶσαν ὥραν;"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "καθʼ ἡμέραν ἀποθνῄσκω, νὴ τὴν ὑμετέραν ⸀καύχησιν",
          {
            "noteId": 301
          },
          "ἣν ἔχω ἐν Χριστῷ Ἰησοῦ τῷ κυρίῳ ἡμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "εἰ κατὰ ἄνθρωπον ἐθηριομάχησα ἐν Ἐφέσῳ, τί μοι τὸ ὄφελος; εἰ νεκροὶ οὐκ ἐγείρονται, Φάγωμεν καὶ πίωμεν, αὔριον γὰρ ἀποθνῄσκομεν."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "μὴ πλανᾶσθε· φθείρουσιν ἤθη χρηστὰ ὁμιλίαι κακαί."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "ἐκνήψατε δικαίως καὶ μὴ ἁμαρτάνετε, ἀγνωσίαν γὰρ θεοῦ τινες ἔχουσιν· πρὸς ἐντροπὴν ὑμῖν ⸀λαλῶ",
          {
            "noteId": 302
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "Ἀλλὰ ἐρεῖ τις· Πῶς ἐγείρονται οἱ νεκροί, ποίῳ δὲ σώματι ἔρχονται;"
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "⸀ἄφρων",
          {
            "noteId": 303
          },
          "σὺ ὃ σπείρεις, οὐ ζῳοποιεῖται ἐὰν μὴ ἀποθάνῃ·"
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "καὶ ὃ σπείρεις, οὐ τὸ σῶμα τὸ γενησόμενον σπείρεις ἀλλὰ γυμνὸν κόκκον εἰ τύχοι σίτου ἤ τινος τῶν λοιπῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "ὁ δὲ θεὸς ⸂δίδωσιν αὐτῷ",
          {
            "noteId": 304
          },
          "σῶμα καθὼς ἠθέλησεν, καὶ ἑκάστῳ τῶν σπερμάτων ⸀ἴδιον",
          {
            "noteId": 305
          },
          "σῶμα."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "οὐ πᾶσα σὰρξ ἡ αὐτὴ σάρξ, ἀλλὰ ἄλλη μὲν ἀνθρώπων, ἄλλη δὲ σὰρξ κτηνῶν, ἄλλη δὲ ⸂σὰρξ πτηνῶν",
          {
            "noteId": 306
          },
          ", ἄλλη δὲ ⸀ἰχθύων",
          {
            "noteId": 307
          }
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "καὶ σώματα ἐπουράνια, καὶ σώματα ἐπίγεια· ἀλλὰ ἑτέρα μὲν ἡ τῶν ἐπουρανίων δόξα, ἑτέρα δὲ ἡ τῶν ἐπιγείων."
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "ἄλλη δόξα ἡλίου, καὶ ἄλλη δόξα σελήνης, καὶ ἄλλη δόξα ἀστέρων, ἀστὴρ γὰρ ἀστέρος διαφέρει ἐν δόξῃ."
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "Οὕτως καὶ ἡ ἀνάστασις τῶν νεκρῶν. σπείρεται ἐν φθορᾷ, ἐγείρεται ἐν ἀφθαρσίᾳ·"
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "σπείρεται ἐν ἀτιμίᾳ, ἐγείρεται ἐν δόξῃ· σπείρεται ἐν ἀσθενείᾳ, ἐγείρεται ἐν δυνάμει·"
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "σπείρεται σῶμα ψυχικόν, ἐγείρεται σῶμα πνευματικόν. ⸀Εἰ",
          {
            "noteId": 308
          },
          "ἔστιν σῶμα ψυχικόν, ⸂ἔστιν καὶ",
          {
            "noteId": 309
          },
          "πνευματικόν."
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "οὕτως καὶ γέγραπται· Ἐγένετο ὁ πρῶτος ἄνθρωπος Ἀδὰμ εἰς ψυχὴν ζῶσαν· ὁ ἔσχατος Ἀδὰμ εἰς πνεῦμα ζῳοποιοῦν."
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "ἀλλʼ οὐ πρῶτον τὸ πνευματικὸν ἀλλὰ τὸ ψυχικόν, ἔπειτα τὸ πνευματικόν."
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          "ὁ πρῶτος ἄνθρωπος",
          {
            "noteId": 310
          },
          "ἐκ γῆς χοϊκός, ὁ δεύτερος ⸀ἄνθρωπος ἐξ οὐρανοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          "οἷος ὁ χοϊκός, τοιοῦτοι καὶ οἱ χοϊκοί, καὶ οἷος ὁ ἐπουράνιος, τοιοῦτοι καὶ οἱ ἐπουράνιοι·"
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          "καὶ καθὼς ἐφορέσαμεν τὴν εἰκόνα τοῦ χοϊκοῦ, ⸀φορέσομεν",
          {
            "noteId": 311
          },
          "καὶ τὴν εἰκόνα τοῦ ἐπουρανίου."
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          "Τοῦτο δέ φημι, ἀδελφοί, ὅτι σὰρξ καὶ αἷμα βασιλείαν θεοῦ κληρονομῆσαι οὐ ⸀δύναται",
          {
            "noteId": 312
          },
          "οὐδὲ ἡ φθορὰ τὴν ἀφθαρσίαν κληρονομεῖ."
        ]
      },
      {
        "type": "verse",
        "number": 51,
        "content": [
          "ἰδοὺ μυστήριον ὑμῖν λέγω· ⸀πάντες",
          {
            "noteId": 313
          },
          "οὐ κοιμηθησόμεθα πάντες δὲ ἀλλαγησόμεθα,"
        ]
      },
      {
        "type": "verse",
        "number": 52,
        "content": [
          "ἐν ἀτόμῳ, ἐν ῥιπῇ ὀφθαλμοῦ, ἐν τῇ ἐσχάτῃ σάλπιγγι· σαλπίσει γάρ, καὶ οἱ νεκροὶ ἐγερθήσονται ἄφθαρτοι, καὶ ἡμεῖς ἀλλαγησόμεθα."
        ]
      },
      {
        "type": "verse",
        "number": 53,
        "content": [
          "δεῖ γὰρ τὸ φθαρτὸν τοῦτο ἐνδύσασθαι ἀφθαρσίαν καὶ τὸ θνητὸν τοῦτο ἐνδύσασθαι ἀθανασίαν."
        ]
      },
      {
        "type": "verse",
        "number": 54,
        "content": [
          "ὅταν δὲ τὸ ⸂φθαρτὸν τοῦτο ἐνδύσηται ἀφθαρσίαν καὶ τὸ",
          {
            "noteId": 314
          },
          "θνητὸν τοῦτο ἐνδύσηται ⸀ἀθανασίαν",
          {
            "noteId": 315
          },
          "τότε γενήσεται ὁ λόγος ὁ γεγραμμένος· Κατεπόθη ὁ θάνατος εἰς νῖκος."
        ]
      },
      {
        "type": "verse",
        "number": 55,
        "content": [
          "ποῦ σου, θάνατε, τὸ ⸂νῖκος; ποῦ σου, θάνατε, τὸ κέντρον⸃;",
          {
            "noteId": 316
          }
        ]
      },
      {
        "type": "verse",
        "number": 56,
        "content": [
          "τὸ δὲ κέντρον τοῦ θανάτου ἡ ἁμαρτία, ἡ δὲ δύναμις τῆς ἁμαρτίας ὁ νόμος·"
        ]
      },
      {
        "type": "verse",
        "number": 57,
        "content": [
          "τῷ δὲ θεῷ χάρις τῷ διδόντι ἡμῖν τὸ νῖκος διὰ τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 58,
        "content": [
          "Ὥστε, ἀδελφοί μου ἀγαπητοί, ἑδραῖοι γίνεσθε, ἀμετακίνητοι, περισσεύοντες ἐν τῷ ἔργῳ τοῦ κυρίου πάντοτε, εἰδότες ὅτι ὁ κόπος ὑμῶν οὐκ ἔστιν κενὸς ἐν κυρίῳ."
        ]
      }
    ],
