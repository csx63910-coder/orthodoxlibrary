  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Τὸ λοιπόν, ἀδελφοί μου, χαίρετε ἐν κυρίῳ. τὰ αὐτὰ γράφειν ὑμῖν ἐμοὶ μὲν οὐκ ὀκνηρόν, ὑμῖν δὲ ἀσφαλές."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Βλέπετε τοὺς κύνας, βλέπετε τοὺς κακοὺς ἐργάτας, βλέπετε τὴν κατατομήν."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἡμεῖς γάρ ἐσμεν ἡ περιτομή, οἱ πνεύματι θεοῦ λατρεύοντες καὶ καυχώμενοι ἐν Χριστῷ Ἰησοῦ καὶ οὐκ ἐν σαρκὶ πεποιθότες,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καίπερ ἐγὼ ἔχων πεποίθησιν καὶ ἐν σαρκί. Εἴ τις δοκεῖ ἄλλος πεποιθέναι ἐν σαρκί, ἐγὼ μᾶλλον·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "περιτομῇ ὀκταήμερος, ἐκ γένους Ἰσραήλ, φυλῆς Βενιαμίν, Ἑβραῖος ἐξ Ἑβραίων, κατὰ νόμον Φαρισαῖος,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "κατὰ ⸀ζῆλος",
          {
            "noteId": 30
          },
          "διώκων τὴν ἐκκλησίαν, κατὰ δικαιοσύνην τὴν ἐν νόμῳ γενόμενος ἄμεμπτος."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ἀλλὰ ἅτινα ἦν μοι κέρδη, ταῦτα ἥγημαι διὰ τὸν Χριστὸν ζημίαν."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἀλλὰ ⸀μενοῦνγε",
          {
            "noteId": 31
          },
          "καὶ ἡγοῦμαι πάντα ζημίαν εἶναι διὰ τὸ ὑπερέχον τῆς γνώσεως Χριστοῦ Ἰησοῦ τοῦ κυρίου μου διʼ ὃν τὰ πάντα ἐζημιώθην, καὶ ἡγοῦμαι ⸀σκύβαλα",
          {
            "noteId": 32
          },
          "ἵνα Χριστὸν κερδήσω"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ εὑρεθῶ ἐν αὐτῷ, μὴ ἔχων ἐμὴν δικαιοσύνην τὴν ἐκ νόμου ἀλλὰ τὴν διὰ πίστεως Χριστοῦ, τὴν ἐκ θεοῦ δικαιοσύνην ἐπὶ τῇ πίστει,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "τοῦ γνῶναι αὐτὸν καὶ τὴν δύναμιν τῆς ἀναστάσεως αὐτοῦ καὶ ⸀κοινωνίαν",
          {
            "noteId": 33
          },
          "παθημάτων αὐτοῦ, ⸀συμμορφιζόμενος",
          {
            "noteId": 34
          },
          "τῷ θανάτῳ αὐτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "εἴ πως καταντήσω εἰς τὴν ἐξανάστασιν ⸂τὴν ἐκ",
          {
            "noteId": 35
          },
          "νεκρῶν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Οὐχ ὅτι ἤδη ἔλαβον ἢ ἤδη τετελείωμαι, διώκω δὲ εἰ καὶ καταλάβω, ἐφʼ ᾧ καὶ κατελήμφθην ὑπὸ ⸀Χριστοῦ",
          {
            "noteId": 36
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ἀδελφοί, ἐγὼ ἐμαυτὸν ⸀οὐ",
          {
            "noteId": 37
          },
          "λογίζομαι κατειληφέναι· ἓν δέ, τὰ μὲν ὀπίσω ἐπιλανθανόμενος τοῖς δὲ ἔμπροσθεν ἐπεκτεινόμενος,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "κατὰ σκοπὸν διώκω ⸀εἰς",
          {
            "noteId": 38
          },
          "τὸ βραβεῖον τῆς ἄνω κλήσεως τοῦ θεοῦ ἐν Χριστῷ Ἰησοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ὅσοι οὖν τέλειοι, τοῦτο φρονῶμεν· καὶ εἴ τι ἑτέρως φρονεῖτε, καὶ τοῦτο ὁ θεὸς ὑμῖν ἀποκαλύψει·"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "πλὴν εἰς ὃ ἐφθάσαμεν, τῷ αὐτῷ ⸀στοιχεῖν",
          {
            "noteId": 39
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Συμμιμηταί μου γίνεσθε, ἀδελφοί, καὶ σκοπεῖτε τοὺς οὕτω περιπατοῦντας καθὼς ἔχετε τύπον ἡμᾶς·"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "πολλοὶ γὰρ περιπατοῦσιν οὓς πολλάκις ἔλεγον ὑμῖν, νῦν δὲ καὶ κλαίων λέγω, τοὺς ἐχθροὺς τοῦ σταυροῦ τοῦ Χριστοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ὧν τὸ τέλος ἀπώλεια, ὧν ὁ θεὸς ἡ κοιλία καὶ ἡ δόξα ἐν τῇ αἰσχύνῃ αὐτῶν, οἱ τὰ ἐπίγεια φρονοῦντες."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἡμῶν γὰρ τὸ πολίτευμα ἐν οὐρανοῖς ὑπάρχει, ἐξ οὗ καὶ σωτῆρα ἀπεκδεχόμεθα κύριον Ἰησοῦν Χριστόν,"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ὃς μετασχηματίσει τὸ σῶμα τῆς ταπεινώσεως ⸀ἡμῶν",
          {
            "noteId": 40
          },
          "σύμμορφον τῷ σώματι τῆς δόξης αὐτοῦ κατὰ τὴν ἐνέργειαν τοῦ δύνασθαι αὐτὸν καὶ ὑποτάξαι ⸀αὑτῷ",
          {
            "noteId": 41
          },
          "τὰ πάντα."
        ]
      }
    ],
