    "order": 50,
    "numberOfChapters": 4,
    "sha256": "4b55d9c778afd16decaed42678a69668e94b9de9e01af58d46b8a25cd55fe5ac",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_sbl/PHP/1.json",
