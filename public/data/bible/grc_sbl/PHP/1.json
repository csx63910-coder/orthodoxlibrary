  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Παῦλος καὶ Τιμόθεος δοῦλοι ⸂Χριστοῦ Ἰησοῦ",
          {
            "noteId": 0
          },
          "πᾶσιν τοῖς ἁγίοις ἐν Χριστῷ Ἰησοῦ τοῖς οὖσιν ἐν Φιλίπποις σὺν ἐπισκόποις καὶ διακόνοις·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "χάρις ὑμῖν καὶ εἰρήνη ἀπὸ θεοῦ πατρὸς ἡμῶν καὶ κυρίου Ἰησοῦ Χριστοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Εὐχαριστῶ τῷ θεῷ μου ἐπὶ πάσῃ τῇ μνείᾳ ὑμῶν"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "πάντοτε ἐν πάσῃ δεήσει μου ὑπὲρ πάντων ὑμῶν, μετὰ χαρᾶς τὴν δέησιν ποιούμενος,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἐπὶ τῇ κοινωνίᾳ ὑμῶν εἰς τὸ εὐαγγέλιον ἀπὸ ⸀τῆς",
          {
            "noteId": 1
          },
          "πρώτης ἡμέρας ἄχρι τοῦ νῦν,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "πεποιθὼς αὐτὸ τοῦτο ὅτι ὁ ἐναρξάμενος ἐν ὑμῖν ἔργον ἀγαθὸν ἐπιτελέσει ἄχρι ἡμέρας ⸂Χριστοῦ Ἰησοῦ",
          {
            "noteId": 2
          },
          "·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "καθώς ἐστιν δίκαιον ἐμοὶ τοῦτο φρονεῖν ὑπὲρ πάντων ὑμῶν, διὰ τὸ ἔχειν με ἐν τῇ καρδίᾳ ὑμᾶς, ἔν τε τοῖς δεσμοῖς μου καὶ ἐν τῇ ἀπολογίᾳ καὶ βεβαιώσει τοῦ εὐαγγελίου συγκοινωνούς μου τῆς χάριτος πάντας ὑμᾶς ὄντας·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "μάρτυς γάρ ⸀μου",
          {
            "noteId": 3
          },
          "ὁ θεός, ὡς ἐπιποθῶ πάντας ὑμᾶς ἐν σπλάγχνοις ⸂Χριστοῦ Ἰησοῦ",
          {
            "noteId": 4
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ τοῦτο προσεύχομαι ἵνα ἡ ἀγάπη ὑμῶν ἔτι μᾶλλον καὶ μᾶλλον περισσεύῃ ἐν ἐπιγνώσει καὶ πάσῃ αἰσθήσει,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "εἰς τὸ δοκιμάζειν ὑμᾶς τὰ διαφέροντα, ἵνα ἦτε εἰλικρινεῖς καὶ ἀπρόσκοποι εἰς ἡμέραν Χριστοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "πεπληρωμένοι ⸂καρπὸν δικαιοσύνης τὸν",
          {
            "noteId": 5
          },
          "διὰ Ἰησοῦ Χριστοῦ εἰς δόξαν καὶ ἔπαινον θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Γινώσκειν δὲ ὑμᾶς βούλομαι, ἀδελφοί, ὅτι τὰ κατʼ ἐμὲ μᾶλλον εἰς προκοπὴν τοῦ εὐαγγελίου ἐλήλυθεν,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ὥστε τοὺς δεσμούς μου φανεροὺς ἐν Χριστῷ γενέσθαι ἐν ὅλῳ τῷ πραιτωρίῳ καὶ τοῖς λοιποῖς πᾶσιν,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καὶ τοὺς πλείονας τῶν ἀδελφῶν ἐν κυρίῳ πεποιθότας τοῖς δεσμοῖς μου περισσοτέρως τολμᾶν ἀφόβως τὸν ⸀λόγον",
          {
            "noteId": 6
          },
          "λαλεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Τινὲς μὲν καὶ διὰ φθόνον καὶ ἔριν, τινὲς δὲ καὶ διʼ εὐδοκίαν τὸν Χριστὸν κηρύσσουσιν·"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "οἱ μὲν ἐξ ⸂ἀγάπης, εἰδότες ὅτι εἰς ἀπολογίαν τοῦ εὐαγγελίου κεῖμαι⸃,",
          {
            "noteId": 7
          },
          {
            "noteId": 8
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "οἱ δὲ ἐξ ⸂ἐριθείας τὸν Χριστὸν καταγγέλλουσιν, οὐχ ἁγνῶς, οἰόμενοι θλῖψιν ἐγείρειν τοῖς δεσμοῖς μου⸃."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "τί γάρ; πλὴν ⸀ὅτι",
          {
            "noteId": 9
          },
          "παντὶ τρόπῳ, εἴτε προφάσει εἴτε ἀληθείᾳ, Χριστὸς καταγγέλλεται, καὶ ἐν τούτῳ χαίρω· ἀλλὰ καὶ χαρήσομαι,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "οἶδα γὰρ ὅτι τοῦτό μοι ἀποβήσεται εἰς σωτηρίαν διὰ τῆς ὑμῶν δεήσεως καὶ ἐπιχορηγίας τοῦ πνεύματος Ἰησοῦ Χριστοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "κατὰ τὴν ἀποκαραδοκίαν καὶ ἐλπίδα μου ὅτι ἐν οὐδενὶ αἰσχυνθήσομαι, ἀλλʼ ἐν πάσῃ παρρησίᾳ ὡς πάντοτε καὶ νῦν μεγαλυνθήσεται Χριστὸς ἐν τῷ σώματί μου, εἴτε διὰ ζωῆς εἴτε διὰ θανάτου."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ἐμοὶ γὰρ τὸ ζῆν Χριστὸς καὶ τὸ ἀποθανεῖν κέρδος."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "εἰ δὲ τὸ ζῆν ἐν σαρκί, τοῦτό μοι καρπὸς ἔργου— καὶ τί αἱρήσομαι οὐ γνωρίζω·"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "συνέχομαι δὲ ἐκ τῶν δύο, τὴν ἐπιθυμίαν ἔχων εἰς τὸ ἀναλῦσαι καὶ σὺν Χριστῷ εἶναι, πολλῷ ⸀γὰρ",
          {
            "noteId": 10
          },
          "μᾶλλον κρεῖσσον,"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "τὸ δὲ ἐπιμένειν ⸀ἐν",
          {
            "noteId": 11
          },
          "τῇ σαρκὶ ἀναγκαιότερον διʼ ὑμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "καὶ τοῦτο πεποιθὼς οἶδα ὅτι μενῶ καὶ ⸀παραμενῶ",
          {
            "noteId": 12
          },
          "πᾶσιν ὑμῖν εἰς τὴν ὑμῶν προκοπὴν καὶ χαρὰν τῆς πίστεως,"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ἵνα τὸ καύχημα ὑμῶν περισσεύῃ ἐν Χριστῷ Ἰησοῦ ἐν ἐμοὶ διὰ τῆς ἐμῆς παρουσίας πάλιν πρὸς ὑμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Μόνον ἀξίως τοῦ εὐαγγελίου τοῦ Χριστοῦ πολιτεύεσθε, ἵνα εἴτε ἐλθὼν καὶ ἰδὼν ὑμᾶς εἴτε ἀπὼν ⸀ἀκούω",
          {
            "noteId": 13
          },
          "τὰ περὶ ὑμῶν, ὅτι στήκετε ἐν ἑνὶ πνεύματι, μιᾷ ψυχῇ συναθλοῦντες τῇ πίστει τοῦ εὐαγγελίου,"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "καὶ μὴ πτυρόμενοι ἐν μηδενὶ ὑπὸ τῶν ἀντικειμένων (ἥτις ⸂ἐστὶν αὐτοῖς",
          {
            "noteId": 14
          },
          "ἔνδειξις ἀπωλείας, ⸀ὑμῶν",
          {
            "noteId": 15
          },
          "δὲ σωτηρίας, καὶ τοῦτο ἀπὸ θεοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "ὅτι ὑμῖν ἐχαρίσθη τὸ ὑπὲρ Χριστοῦ, οὐ μόνον τὸ εἰς αὐτὸν πιστεύειν ἀλλὰ καὶ τὸ ὑπὲρ αὐτοῦ πάσχειν),"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "τὸν αὐτὸν ἀγῶνα ἔχοντες οἷον εἴδετε ἐν ἐμοὶ καὶ νῦν ἀκούετε ἐν ἐμοί."
        ]
      }
    ],
