  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "ἔκρινα ⸀γὰρ",
          {
            "noteId": 23
          },
          "ἐμαυτῷ τοῦτο, τὸ μὴ πάλιν ἐν λύπῃ πρὸς ὑμᾶς ἐλθεῖν·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "εἰ γὰρ ἐγὼ λυπῶ ὑμᾶς, καὶ ⸀τίς",
          {
            "noteId": 24
          },
          "ὁ εὐφραίνων με εἰ μὴ ὁ λυπούμενος ἐξ ἐμοῦ;"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ ⸀ἔγραψα",
          {
            "noteId": 25
          },
          "τοῦτο αὐτὸ ἵνα μὴ ἐλθὼν λύπην ⸀σχῶ",
          {
            "noteId": 26
          },
          "ἀφʼ ὧν ἔδει με χαίρειν, πεποιθὼς ἐπὶ πάντας ὑμᾶς ὅτι ἡ ἐμὴ χαρὰ πάντων ὑμῶν ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἐκ γὰρ πολλῆς θλίψεως καὶ συνοχῆς καρδίας ἔγραψα ὑμῖν διὰ πολλῶν δακρύων, οὐχ ἵνα λυπηθῆτε, ἀλλὰ τὴν ἀγάπην ἵνα γνῶτε ἣν ἔχω περισσοτέρως εἰς ὑμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Εἰ δέ τις λελύπηκεν, οὐκ ἐμὲ λελύπηκεν, ἀλλὰ ἀπὸ μέρους ἵνα μὴ ἐπιβαρῶ πάντας ὑμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἱκανὸν τῷ τοιούτῳ ἡ ἐπιτιμία αὕτη ἡ ὑπὸ τῶν πλειόνων,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ὥστε τοὐναντίον ⸀μᾶλλον",
          {
            "noteId": 27
          },
          "ὑμᾶς χαρίσασθαι καὶ παρακαλέσαι, μή πως τῇ περισσοτέρᾳ λύπῃ καταποθῇ ὁ τοιοῦτος."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "διὸ παρακαλῶ ὑμᾶς κυρῶσαι εἰς αὐτὸν ἀγάπην·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "εἰς τοῦτο γὰρ καὶ ἔγραψα ἵνα γνῶ τὴν δοκιμὴν ὑμῶν, εἰ εἰς πάντα ὑπήκοοί ἐστε."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ᾧ δέ τι χαρίζεσθε, κἀγώ· καὶ γὰρ ἐγὼ ⸂ὃ κεχάρισμαι, εἴ τι",
          {
            "noteId": 28
          },
          "κεχάρισμαι, διʼ ὑμᾶς ἐν προσώπῳ Χριστοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ἵνα μὴ πλεονεκτηθῶμεν ὑπὸ τοῦ Σατανᾶ, οὐ γὰρ αὐτοῦ τὰ νοήματα ἀγνοοῦμεν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ἐλθὼν δὲ εἰς τὴν Τρῳάδα εἰς τὸ εὐαγγέλιον τοῦ Χριστοῦ καὶ θύρας μοι ἀνεῳγμένης ἐν κυρίῳ,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "οὐκ ἔσχηκα ἄνεσιν τῷ πνεύματί μου τῷ μὴ εὑρεῖν με Τίτον τὸν ἀδελφόν μου, ἀλλὰ ἀποταξάμενος αὐτοῖς ἐξῆλθον εἰς Μακεδονίαν."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Τῷ δὲ θεῷ χάρις τῷ πάντοτε θριαμβεύοντι ἡμᾶς ἐν τῷ Χριστῷ καὶ τὴν ὀσμὴν τῆς γνώσεως αὐτοῦ φανεροῦντι διʼ ἡμῶν ἐν παντὶ τόπῳ·"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ὅτι Χριστοῦ εὐωδία ἐσμὲν τῷ θεῷ ἐν τοῖς σῳζομένοις καὶ ἐν τοῖς ἀπολλυμένοις,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "οἷς μὲν ὀσμὴ ⸀ἐκ",
          {
            "noteId": 29
          },
          "θανάτου εἰς θάνατον, οἷς δὲ ὀσμὴ ⸁ἐκ",
          {
            "noteId": 30
          },
          "ζωῆς εἰς ζωήν. καὶ πρὸς ταῦτα τίς ἱκανός;"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "οὐ γάρ ἐσμεν ὡς οἱ ⸀πολλοὶ",
          {
            "noteId": 31
          },
          "καπηλεύοντες τὸν λόγον τοῦ θεοῦ, ἀλλʼ ὡς ἐξ εἰλικρινείας, ἀλλʼ ὡς ἐκ θεοῦ ⸀κατέναντι",
          {
            "noteId": 32
          },
          "θεοῦ ἐν Χριστῷ λαλοῦμεν."
        ]
      }
    ],
