  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Παῦλος ἀπόστολος ⸂Χριστοῦ Ἰησοῦ",
          {
            "noteId": 0
          },
          "διὰ θελήματος θεοῦ καὶ Τιμόθεος ὁ ἀδελφὸς τῇ ἐκκλησίᾳ τοῦ θεοῦ τῇ οὔσῃ ἐν Κορίνθῳ, σὺν τοῖς ἁγίοις πᾶσιν τοῖς οὖσιν ἐν ὅλῃ τῇ Ἀχαΐᾳ·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "χάρις ὑμῖν καὶ εἰρήνη ἀπὸ θεοῦ πατρὸς ἡμῶν καὶ κυρίου Ἰησοῦ Χριστοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Εὐλογητὸς ὁ θεὸς καὶ πατὴρ τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ, ὁ πατὴρ τῶν οἰκτιρμῶν καὶ θεὸς πάσης παρακλήσεως,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ὁ παρακαλῶν ἡμᾶς ἐπὶ πάσῃ τῇ θλίψει ἡμῶν, εἰς τὸ δύνασθαι ἡμᾶς παρακαλεῖν τοὺς ἐν πάσῃ θλίψει διὰ τῆς παρακλήσεως ἧς παρακαλούμεθα αὐτοὶ ὑπὸ τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ὅτι καθὼς περισσεύει τὰ παθήματα τοῦ Χριστοῦ εἰς ἡμᾶς, οὕτως διὰ τοῦ Χριστοῦ περισσεύει καὶ ἡ παράκλησις ἡμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "εἴτε δὲ θλιβόμεθα, ὑπὲρ τῆς ὑμῶν παρακλήσεως καὶ σωτηρίας· ⸂εἴτε παρακαλούμεθα, ὑπὲρ τῆς ὑμῶν παρακλήσεως",
          {
            "noteId": 1
          },
          "τῆς ἐνεργουμένης ἐν ὑπομονῇ τῶν αὐτῶν παθημάτων ὧν καὶ ἡμεῖς πάσχομεν,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "καὶ ἡ ἐλπὶς ἡμῶν βεβαία ὑπὲρ ⸀ὑμῶν",
          {
            "noteId": 2
          },
          "εἰδότες ὅτι ⸀ὡς",
          {
            "noteId": 3
          },
          "κοινωνοί ἐστε τῶν παθημάτων, οὕτως καὶ τῆς παρακλήσεως."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Οὐ γὰρ θέλομεν ὑμᾶς ἀγνοεῖν, ἀδελφοί, ⸀ὑπὲρ",
          {
            "noteId": 4
          },
          "τῆς θλίψεως ἡμῶν τῆς ⸀γενομένης",
          {
            "noteId": 5
          },
          "ἐν τῇ Ἀσίᾳ, ὅτι καθʼ ὑπερβολὴν ⸂ὑπὲρ δύναμιν ἐβαρήθημεν",
          {
            "noteId": 6
          },
          ", ὥστε ἐξαπορηθῆναι ἡμᾶς καὶ τοῦ ζῆν·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ἀλλὰ αὐτοὶ ἐν ἑαυτοῖς τὸ ἀπόκριμα τοῦ θανάτου ἐσχήκαμεν, ἵνα μὴ πεποιθότες ὦμεν ἐφʼ ἑαυτοῖς ἀλλʼ ἐπὶ τῷ θεῷ τῷ ἐγείροντι τοὺς νεκρούς·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ὃς ἐκ τηλικούτου θανάτου ἐρρύσατο ἡμᾶς καὶ ⸀ῥύσεται",
          {
            "noteId": 7
          },
          "εἰς ὃν ἠλπίκαμεν ὅτι καὶ ἔτι ῥύσεται,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "συνυπουργούντων καὶ ὑμῶν ὑπὲρ ἡμῶν",
          {
            "noteId": 8
          },
          "τῇ δεήσει, ἵνα ἐκ πολλῶν προσώπων τὸ εἰς ἡμᾶς χάρισμα διὰ πολλῶν εὐχαριστηθῇ ὑπὲρ ⸀ἡμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ἡ γὰρ καύχησις ἡμῶν αὕτη ἐστίν, τὸ μαρτύριον τῆς συνειδήσεως ἡμῶν, ὅτι ἐν ⸀ἁγιότητι",
          {
            "noteId": 9
          },
          "καὶ εἰλικρινείᾳ ⸀τοῦ",
          {
            "noteId": 10
          },
          "θεοῦ, ⸀οὐκ",
          {
            "noteId": 11
          },
          "ἐν σοφίᾳ σαρκικῇ ἀλλʼ ἐν χάριτι θεοῦ, ἀνεστράφημεν ἐν τῷ κόσμῳ, περισσοτέρως δὲ πρὸς ὑμᾶς·"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "οὐ γὰρ ἄλλα γράφομεν ὑμῖν ἀλλʼ ἢ ἃ ἀναγινώσκετε ἢ καὶ ἐπιγινώσκετε, ἐλπίζω δὲ ⸀ὅτι",
          {
            "noteId": 12
          },
          "ἕως τέλους ἐπιγνώσεσθε,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καθὼς καὶ ἐπέγνωτε ἡμᾶς ἀπὸ μέρους, ὅτι καύχημα ὑμῶν ἐσμεν καθάπερ καὶ ὑμεῖς ἡμῶν",
          {
            "noteId": 13
          },
          "ἐν τῇ ἡμέρᾳ τοῦ κυρίου ⸀ἡμῶν Ἰησοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Καὶ ταύτῃ τῇ πεποιθήσει ἐβουλόμην ⸂πρότερον πρὸς ὑμᾶς ἐλθεῖν",
          {
            "noteId": 14
          },
          ", ἵνα δευτέραν ⸀χάριν",
          {
            "noteId": 15
          },
          "⸀σχῆτε",
          {
            "noteId": 16
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ διʼ ὑμῶν διελθεῖν εἰς Μακεδονίαν, καὶ πάλιν ἀπὸ Μακεδονίας ἐλθεῖν πρὸς ὑμᾶς καὶ ὑφʼ ὑμῶν προπεμφθῆναι εἰς τὴν Ἰουδαίαν."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "τοῦτο οὖν ⸀βουλόμενος",
          {
            "noteId": 17
          },
          "μήτι ἄρα τῇ ἐλαφρίᾳ ἐχρησάμην; ἢ ἃ βουλεύομαι κατὰ σάρκα βουλεύομαι, ἵνα ᾖ παρʼ ἐμοὶ τὸ Ναὶ ναὶ καὶ τὸ Οὒ οὔ;"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "πιστὸς δὲ ὁ θεὸς ὅτι ὁ λόγος ἡμῶν ὁ πρὸς ὑμᾶς οὐκ ⸀ἔστιν",
          {
            "noteId": 18
          },
          "Ναὶ καὶ Οὔ."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ὁ ⸂τοῦ θεοῦ γὰρ",
          {
            "noteId": 19
          },
          "υἱὸς ⸂Ἰησοῦς Χριστὸς",
          {
            "noteId": 20
          },
          "ὁ ἐν ὑμῖν διʼ ἡμῶν κηρυχθείς, διʼ ἐμοῦ καὶ Σιλουανοῦ καὶ Τιμοθέου, οὐκ ἐγένετο Ναὶ καὶ Οὒ, ἀλλὰ Ναὶ ἐν αὐτῷ γέγονεν·"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ὅσαι γὰρ ἐπαγγελίαι θεοῦ, ἐν αὐτῷ τὸ Ναί· ⸀διὸ",
          {
            "noteId": 21
          },
          "καὶ ⸂διʼ αὐτοῦ",
          {
            "noteId": 22
          },
          "τὸ Ἀμὴν τῷ θεῷ πρὸς δόξαν διʼ ἡμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ὁ δὲ βεβαιῶν ἡμᾶς σὺν ὑμῖν εἰς Χριστὸν καὶ χρίσας ἡμᾶς θεός,"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ὁ καὶ σφραγισάμενος ἡμᾶς καὶ δοὺς τὸν ἀρραβῶνα τοῦ πνεύματος ἐν ταῖς καρδίαις ἡμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Ἐγὼ δὲ μάρτυρα τὸν θεὸν ἐπικαλοῦμαι ἐπὶ τὴν ἐμὴν ψυχήν, ὅτι φειδόμενος ὑμῶν οὐκέτι ἦλθον εἰς Κόρινθον."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "οὐχ ὅτι κυριεύομεν ὑμῶν τῆς πίστεως, ἀλλὰ συνεργοί ἐσμεν τῆς χαρᾶς ὑμῶν, τῇ γὰρ πίστει ἑστήκατε."
        ]
      }
    ],
