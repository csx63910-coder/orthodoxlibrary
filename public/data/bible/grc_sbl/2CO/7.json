  "chapter": {
    "number": 7,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "ταύτας οὖν ἔχοντες τὰς ἐπαγγελίας, ἀγαπητοί, καθαρίσωμεν ἑαυτοὺς ἀπὸ παντὸς μολυσμοῦ σαρκὸς καὶ πνεύματος, ἐπιτελοῦντες ἁγιωσύνην ἐν φόβῳ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Χωρήσατε ἡμᾶς· οὐδένα ἠδικήσαμεν, οὐδένα ἐφθείραμεν, οὐδένα ἐπλεονεκτήσαμεν."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "⸂πρὸς κατάκρισιν οὐ",
          {
            "noteId": 78
          },
          "λέγω, προείρηκα γὰρ ὅτι ἐν ταῖς καρδίαις ἡμῶν ἐστε εἰς τὸ συναποθανεῖν καὶ συζῆν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "πολλή μοι παρρησία πρὸς ὑμᾶς, πολλή μοι καύχησις ὑπὲρ ὑμῶν· πεπλήρωμαι τῇ παρακλήσει, ὑπερπερισσεύομαι τῇ χαρᾷ ἐπὶ πάσῃ τῇ θλίψει ἡμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Καὶ γὰρ ἐλθόντων ἡμῶν εἰς Μακεδονίαν οὐδεμίαν ⸀ἔσχηκεν",
          {
            "noteId": 79
          },
          "ἄνεσιν ἡ σὰρξ ἡμῶν, ἀλλʼ ἐν παντὶ θλιβόμενοι— ἔξωθεν μάχαι, ἔσωθεν φόβοι—"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἀλλʼ ὁ παρακαλῶν τοὺς ταπεινοὺς παρεκάλεσεν ἡμᾶς ὁ θεὸς ἐν τῇ παρουσίᾳ Τίτου·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "οὐ μόνον δὲ ἐν τῇ παρουσίᾳ αὐτοῦ, ἀλλὰ καὶ ἐν τῇ παρακλήσει ᾗ παρεκλήθη ἐφʼ ὑμῖν, ἀναγγέλλων ἡμῖν τὴν ὑμῶν ἐπιπόθησιν, τὸν ὑμῶν ὀδυρμόν, τὸν ὑμῶν ζῆλον ὑπὲρ ἐμοῦ, ὥστε με μᾶλλον χαρῆναι."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ὅτι εἰ καὶ ἐλύπησα ὑμᾶς ἐν τῇ ἐπιστολῇ, οὐ μεταμέλομαι· εἰ καὶ μετεμελόμην (⸀βλέπω",
          {
            "noteId": 80
          },
          "ὅτι ἡ ἐπιστολὴ ἐκείνη εἰ καὶ πρὸς ὥραν ἐλύπησεν ὑμᾶς),"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "νῦν χαίρω, οὐχ ὅτι ἐλυπήθητε, ἀλλʼ ὅτι ἐλυπήθητε εἰς μετάνοιαν, ἐλυπήθητε γὰρ κατὰ θεόν, ἵνα ἐν μηδενὶ ζημιωθῆτε ἐξ ἡμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἡ γὰρ κατὰ θεὸν λύπη μετάνοιαν εἰς σωτηρίαν ἀμεταμέλητον ⸀ἐργάζεται",
          {
            "noteId": 81
          },
          "ἡ δὲ τοῦ κόσμου λύπη θάνατον κατεργάζεται."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ἰδοὺ γὰρ αὐτὸ τοῦτο τὸ κατὰ θεὸν ⸀λυπηθῆναι",
          {
            "noteId": 82
          },
          "πόσην κατειργάσατο ὑμῖν σπουδήν, ἀλλὰ ἀπολογίαν, ἀλλὰ ἀγανάκτησιν, ἀλλὰ φόβον, ἀλλὰ ἐπιπόθησιν, ἀλλὰ ζῆλον, ἀλλὰ ἐκδίκησιν· ἐν παντὶ συνεστήσατε ἑαυτοὺς ἁγνοὺς ⸀εἶναι",
          {
            "noteId": 83
          },
          "τῷ πράγματι."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ἄρα εἰ καὶ ἔγραψα ὑμῖν, οὐχ ⸀ἕνεκεν",
          {
            "noteId": 84
          },
          "τοῦ ἀδικήσαντος, ⸀οὐδὲ",
          {
            "noteId": 85
          },
          "⸁ἕνεκεν",
          {
            "noteId": 86
          },
          "τοῦ ἀδικηθέντος, ἀλλʼ ⸀1ἕνεκεν",
          {
            "noteId": 87
          },
          "τοῦ φανερωθῆναι τὴν σπουδὴν ὑμῶν τὴν ὑπὲρ ἡμῶν πρὸς ὑμᾶς ἐνώπιον τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "διὰ τοῦτο παρακεκλήμεθα.",
          {
            "noteId": 88
          },
          "Ἐπὶ δὲ τῇ παρακλήσει ⸀ἡμῶν περισσοτέρως μᾶλλον ἐχάρημεν ἐπὶ τῇ χαρᾷ Τίτου, ὅτι ἀναπέπαυται τὸ πνεῦμα αὐτοῦ ἀπὸ πάντων ὑμῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ὅτι εἴ τι αὐτῷ ὑπὲρ ὑμῶν κεκαύχημαι, οὐ κατῃσχύνθην, ἀλλʼ ὡς πάντα ἐν ἀληθείᾳ ἐλαλήσαμεν ὑμῖν, οὕτως καὶ ἡ",
          {
            "noteId": 89
          },
          "καύχησις ἡμῶν ⸀ἡ ἐπὶ Τίτου ἀλήθεια ἐγενήθη."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ τὰ σπλάγχνα αὐτοῦ περισσοτέρως εἰς ὑμᾶς ἐστιν ἀναμιμνῃσκομένου τὴν πάντων ὑμῶν ὑπακοήν, ὡς μετὰ φόβου καὶ τρόμου ἐδέξασθε αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "χαίρω ὅτι ἐν παντὶ θαρρῶ ἐν ὑμῖν."
        ]
      }
    ],
