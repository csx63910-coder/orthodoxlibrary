  "chapter": {
    "number": 13,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Τρίτον τοῦτο ἔρχομαι πρὸς ὑμᾶς· ἐπὶ στόματος δύο μαρτύρων καὶ τριῶν σταθήσεται πᾶν ῥῆμα."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "προείρηκα καὶ προλέγω ὡς παρὼν τὸ δεύτερον καὶ ἀπὼν ⸀νῦν",
          {
            "noteId": 168
          },
          "τοῖς προημαρτηκόσιν καὶ τοῖς λοιποῖς πᾶσιν, ὅτι ἐὰν ἔλθω εἰς τὸ πάλιν οὐ φείσομαι,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἐπεὶ δοκιμὴν ζητεῖτε τοῦ ἐν ἐμοὶ λαλοῦντος Χριστοῦ· ὃς εἰς ὑμᾶς οὐκ ἀσθενεῖ ἀλλὰ δυνατεῖ ἐν ὑμῖν,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ ⸀γὰρ",
          {
            "noteId": 169
          },
          "ἐσταυρώθη ἐξ ἀσθενείας, ἀλλὰ ζῇ ἐκ δυνάμεως θεοῦ. καὶ γὰρ ἡμεῖς ἀσθενοῦμεν ἐν αὐτῷ, ἀλλὰ ⸀ζήσομεν",
          {
            "noteId": 170
          },
          "σὺν αὐτῷ ἐκ δυνάμεως θεοῦ εἰς ὑμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Ἑαυτοὺς πειράζετε εἰ ἐστὲ ἐν τῇ πίστει, ἑαυτοὺς δοκιμάζετε· ἢ οὐκ ἐπιγινώσκετε ἑαυτοὺς ὅτι ⸂Ἰησοῦς Χριστὸς",
          {
            "noteId": 171
          },
          "ἐν ⸀ὑμῖν",
          {
            "noteId": 172
          },
          "εἰ μήτι ἀδόκιμοί ἐστε."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἐλπίζω δὲ ὅτι γνώσεσθε ὅτι ἡμεῖς οὐκ ἐσμὲν ἀδόκιμοι."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "⸀εὐχόμεθα",
          {
            "noteId": 173
          },
          "δὲ πρὸς τὸν θεὸν μὴ ποιῆσαι ὑμᾶς κακὸν μηδέν, οὐχ ἵνα ἡμεῖς δόκιμοι φανῶμεν, ἀλλʼ ἵνα ὑμεῖς τὸ καλὸν ποιῆτε, ἡμεῖς δὲ ὡς ἀδόκιμοι ὦμεν."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "οὐ γὰρ δυνάμεθά τι κατὰ τῆς ἀληθείας, ἀλλὰ ὑπὲρ τῆς ἀληθείας."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "χαίρομεν γὰρ ὅταν ἡμεῖς ἀσθενῶμεν, ὑμεῖς δὲ δυνατοὶ ἦτε· ⸀τοῦτο",
          {
            "noteId": 174
          },
          "καὶ εὐχόμεθα, τὴν ὑμῶν κατάρτισιν."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "διὰ τοῦτο ταῦτα ἀπὼν γράφω, ἵνα παρὼν μὴ ἀποτόμως χρήσωμαι κατὰ τὴν ἐξουσίαν ἣν ⸂ὁ κύριος ἔδωκέν μοι",
          {
            "noteId": 175
          },
          ", εἰς οἰκοδομὴν καὶ οὐκ εἰς καθαίρεσιν."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Λοιπόν, ἀδελφοί, χαίρετε, καταρτίζεσθε, παρακαλεῖσθε, τὸ αὐτὸ φρονεῖτε, εἰρηνεύετε, καὶ ὁ θεὸς τῆς ἀγάπης καὶ εἰρήνης ἔσται μεθʼ ὑμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ἀσπάσασθε ἀλλήλους ἐν ἁγίῳ φιλήματι. ἀσπάζονται ὑμᾶς οἱ ἅγιοι πάντες."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ἡ χάρις τοῦ κυρίου Ἰησοῦ Χριστοῦ καὶ ἡ ἀγάπη τοῦ θεοῦ καὶ ἡ κοινωνία τοῦ ἁγίου πνεύματος μετὰ πάντων ⸀ὑμῶν",
          {
            "noteId": 176
          },
          "‘p /’ ‘/book’"
        ]
      }
    ],
