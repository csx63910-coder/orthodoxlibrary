  "chapter": {
    "number": 12,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καυχᾶσθαι ⸀δεῖ",
          {
            "noteId": 140
          },
          "οὐ ⸂συμφέρον μέν",
          {
            "noteId": 141
          },
          ", ἐλεύσομαι ⸀δὲ",
          {
            "noteId": 142
          },
          "εἰς ὀπτασίας καὶ ἀποκαλύψεις κυρίου."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "οἶδα ἄνθρωπον ἐν Χριστῷ πρὸ ἐτῶν δεκατεσσάρων— εἴτε ἐν σώματι οὐκ οἶδα, εἴτε ἐκτὸς τοῦ σώματος οὐκ οἶδα, ὁ θεὸς οἶδεν— ἁρπαγέντα τὸν τοιοῦτον ἕως τρίτου οὐρανοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ οἶδα τὸν τοιοῦτον ἄνθρωπον— εἴτε ἐν σώματι εἴτε ⸀χωρὶς",
          {
            "noteId": 143
          },
          "τοῦ σώματος οὐκ οἶδα, ὁ θεὸς οἶδεν—"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ὅτι ἡρπάγη εἰς τὸν παράδεισον καὶ ἤκουσεν ἄρρητα ῥήματα ἃ οὐκ ἐξὸν ἀνθρώπῳ λαλῆσαι."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ὑπὲρ τοῦ τοιούτου καυχήσομαι, ὑπὲρ δὲ ἐμαυτοῦ οὐ καυχήσομαι εἰ μὴ ἐν ταῖς ⸀ἀσθενείαις",
          {
            "noteId": 144
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἐὰν γὰρ θελήσω καυχήσασθαι, οὐκ ἔσομαι ἄφρων, ἀλήθειαν γὰρ ἐρῶ· φείδομαι δέ, μή τι",
          {
            "noteId": 145
          },
          "εἰς ἐμὲ λογίσηται ὑπὲρ ὃ βλέπει με ἢ ἀκούει ⸀τι ἐξ ἐμοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "καὶ τῇ ὑπερβολῇ τῶν ἀποκαλύψεων. ⸀διὸ",
          {
            "noteId": 146
          },
          "ἵνα μὴ ὑπεραίρωμαι, ἐδόθη μοι σκόλοψ τῇ σαρκί, ἄγγελος ⸀Σατανᾶ",
          {
            "noteId": 147
          },
          "ἵνα με κολαφίζῃ, ⸂ἵνα μὴ ὑπεραίρωμαι",
          {
            "noteId": 148
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ὑπὲρ τούτου τρὶς τὸν κύριον παρεκάλεσα ἵνα ἀποστῇ ἀπʼ ἐμοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ εἴρηκέν μοι· Ἀρκεῖ σοι ἡ χάρις μου· ἡ γὰρ ⸀δύναμις",
          {
            "noteId": 149
          },
          "ἐν ἀσθενείᾳ ⸀τελεῖται",
          {
            "noteId": 150
          },
          "ἥδιστα οὖν μᾶλλον καυχήσομαι ἐν ταῖς ἀσθενείαις ⸀μου",
          {
            "noteId": 151
          },
          "ἵνα ἐπισκηνώσῃ ἐπʼ ἐμὲ ἡ δύναμις τοῦ Χριστοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "διὸ εὐδοκῶ ἐν ἀσθενείαις, ἐν ὕβρεσιν, ἐν ἀνάγκαις, ἐν διωγμοῖς ⸀καὶ",
          {
            "noteId": 152
          },
          "στενοχωρίαις, ὑπὲρ Χριστοῦ· ὅταν γὰρ ἀσθενῶ, τότε δυνατός εἰμι."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Γέγονα ⸀ἄφρων",
          {
            "noteId": 153
          },
          "ὑμεῖς με ἠναγκάσατε· ἐγὼ γὰρ ὤφειλον ὑφʼ ὑμῶν συνίστασθαι. οὐδὲν γὰρ ὑστέρησα τῶν ὑπερλίαν ἀποστόλων, εἰ καὶ οὐδέν εἰμι·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "τὰ μὲν σημεῖα τοῦ ἀποστόλου κατειργάσθη ἐν ὑμῖν ἐν πάσῃ ⸀ὑπομονῇ",
          {
            "noteId": 154
          },
          "σημείοις ⸀τε",
          {
            "noteId": 155
          },
          "καὶ τέρασιν καὶ δυνάμεσιν."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "τί γάρ ἐστιν ὃ ⸀ἡσσώθητε",
          {
            "noteId": 156
          },
          "ὑπὲρ τὰς λοιπὰς ἐκκλησίας, εἰ μὴ ὅτι αὐτὸς ἐγὼ οὐ κατενάρκησα ὑμῶν; χαρίσασθέ μοι τὴν ἀδικίαν ταύτην."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Ἰδοὺ τρίτον ⸀τοῦτο",
          {
            "noteId": 157
          },
          "ἑτοίμως ἔχω ἐλθεῖν πρὸς ὑμᾶς, καὶ οὐ ⸀καταναρκήσω",
          {
            "noteId": 158
          },
          "οὐ γὰρ ζητῶ τὰ ὑμῶν ἀλλὰ ὑμᾶς, οὐ γὰρ ὀφείλει τὰ τέκνα τοῖς γονεῦσιν θησαυρίζειν, ἀλλὰ οἱ γονεῖς τοῖς τέκνοις."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ἐγὼ δὲ ἥδιστα δαπανήσω καὶ ἐκδαπανηθήσομαι ὑπὲρ τῶν ψυχῶν ὑμῶν. ⸀εἰ",
          {
            "noteId": 159
          },
          "περισσοτέρως ὑμᾶς ⸀ἀγαπῶν",
          {
            "noteId": 160
          },
          "ἧσσον ἀγαπῶμαι;"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ἔστω δέ, ἐγὼ οὐ κατεβάρησα ὑμᾶς· ἀλλὰ ὑπάρχων πανοῦργος δόλῳ ὑμᾶς ἔλαβον."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "μή τινα ὧν ἀπέσταλκα πρὸς ὑμᾶς, διʼ αὐτοῦ ἐπλεονέκτησα ὑμᾶς;"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "παρεκάλεσα Τίτον καὶ συναπέστειλα τὸν ἀδελφόν· μήτι ἐπλεονέκτησεν ὑμᾶς Τίτος; οὐ τῷ αὐτῷ πνεύματι περιεπατήσαμεν; οὐ τοῖς αὐτοῖς ἴχνεσιν;"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "⸀Πάλαι",
          {
            "noteId": 161
          },
          "δοκεῖτε ὅτι ὑμῖν ἀπολογούμεθα; ⸀κατέναντι",
          {
            "noteId": 162
          },
          "θεοῦ ἐν Χριστῷ λαλοῦμεν. τὰ δὲ πάντα, ἀγαπητοί, ὑπὲρ τῆς ὑμῶν οἰκοδομῆς,"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "φοβοῦμαι γὰρ μή πως ἐλθὼν οὐχ οἵους θέλω εὕρω ὑμᾶς, κἀγὼ εὑρεθῶ ὑμῖν οἷον οὐ θέλετε, μή πως ⸀ἔρις",
          {
            "noteId": 163
          },
          "⸀ζῆλος",
          {
            "noteId": 164
          },
          "θυμοί, ἐριθεῖαι, καταλαλιαί, ψιθυρισμοί, φυσιώσεις, ἀκαταστασίαι·"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "μὴ πάλιν ⸂ἐλθόντος μου",
          {
            "noteId": 165
          },
          "⸀ταπεινώσῃ",
          {
            "noteId": 166
          },
          "⸀με",
          {
            "noteId": 167
          },
          "ὁ θεός μου πρὸς ὑμᾶς, καὶ πενθήσω πολλοὺς τῶν προημαρτηκότων καὶ μὴ μετανοησάντων ἐπὶ τῇ ἀκαθαρσίᾳ καὶ πορνείᾳ καὶ ἀσελγείᾳ ᾗ ἔπραξαν."
        ]
      }
    ],
