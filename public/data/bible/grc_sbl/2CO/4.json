  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Διὰ τοῦτο, ἔχοντες τὴν διακονίαν ταύτην καθὼς ἠλεήθημεν, οὐκ ⸀ἐγκακοῦμεν",
          {
            "noteId": 49
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἀλλὰ ἀπειπάμεθα τὰ κρυπτὰ τῆς αἰσχύνης, μὴ περιπατοῦντες ἐν πανουργίᾳ μηδὲ δολοῦντες τὸν λόγον τοῦ θεοῦ, ἀλλὰ τῇ φανερώσει τῆς ἀληθείας ⸀συνιστάνοντες",
          {
            "noteId": 50
          },
          "ἑαυτοὺς πρὸς πᾶσαν συνείδησιν ἀνθρώπων ἐνώπιον τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "εἰ δὲ καὶ ἔστιν κεκαλυμμένον τὸ εὐαγγέλιον ἡμῶν, ἐν τοῖς ἀπολλυμένοις ἐστὶν κεκαλυμμένον,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἐν οἷς ὁ θεὸς τοῦ αἰῶνος τούτου ἐτύφλωσεν τὰ νοήματα τῶν ἀπίστων εἰς τὸ μὴ ⸀αὐγάσαι",
          {
            "noteId": 51
          },
          "τὸν φωτισμὸν τοῦ εὐαγγελίου τῆς δόξης τοῦ Χριστοῦ, ὅς ἐστιν εἰκὼν τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "οὐ γὰρ ἑαυτοὺς κηρύσσομεν ἀλλὰ ⸂Χριστὸν Ἰησοῦν",
          {
            "noteId": 52
          },
          "κύριον, ἑαυτοὺς δὲ δούλους ὑμῶν διὰ Ἰησοῦν."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ὅτι ὁ θεὸς ὁ εἰπών· Ἐκ σκότους φῶς ⸀λάμψει",
          {
            "noteId": 53
          },
          "ὃς ἔλαμψεν ἐν ταῖς καρδίαις ἡμῶν πρὸς φωτισμὸν τῆς γνώσεως τῆς δόξης τοῦ θεοῦ ἐν προσώπῳ ⸀Χριστοῦ",
          {
            "noteId": 54
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ἔχομεν δὲ τὸν θησαυρὸν τοῦτον ἐν ὀστρακίνοις σκεύεσιν, ἵνα ἡ ὑπερβολὴ τῆς δυνάμεως ᾖ τοῦ θεοῦ καὶ μὴ ἐξ ἡμῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἐν παντὶ θλιβόμενοι ἀλλʼ οὐ στενοχωρούμενοι, ἀπορούμενοι ἀλλʼ οὐκ ἐξαπορούμενοι,"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "διωκόμενοι ἀλλʼ οὐκ ἐγκαταλειπόμενοι, καταβαλλόμενοι ἀλλʼ οὐκ ἀπολλύμενοι,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "πάντοτε τὴν νέκρωσιν ⸀τοῦ",
          {
            "noteId": 55
          },
          "Ἰησοῦ ἐν τῷ σώματι περιφέροντες, ἵνα καὶ ἡ ζωὴ τοῦ Ἰησοῦ ἐν τῷ σώματι ἡμῶν φανερωθῇ·"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ἀεὶ γὰρ ἡμεῖς οἱ ζῶντες εἰς θάνατον παραδιδόμεθα διὰ Ἰησοῦν, ἵνα καὶ ἡ ζωὴ τοῦ Ἰησοῦ φανερωθῇ ἐν τῇ θνητῇ σαρκὶ ἡμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ὥστε ⸀ὁ",
          {
            "noteId": 56
          },
          "θάνατος ἐν ἡμῖν ἐνεργεῖται, ἡ δὲ ζωὴ ἐν ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ἔχοντες δὲ τὸ αὐτὸ πνεῦμα τῆς πίστεως, κατὰ τὸ γεγραμμένον· Ἐπίστευσα, διὸ ἐλάλησα, καὶ ἡμεῖς πιστεύομεν, διὸ καὶ λαλοῦμεν,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "εἰδότες ὅτι ὁ ἐγείρας ⸀τὸν",
          {
            "noteId": 57
          },
          "Ἰησοῦν καὶ ἡμᾶς ⸀σὺν",
          {
            "noteId": 58
          },
          "Ἰησοῦ ἐγερεῖ καὶ παραστήσει σὺν ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "τὰ γὰρ πάντα διʼ ὑμᾶς, ἵνα ἡ χάρις πλεονάσασα διὰ τῶν πλειόνων τὴν εὐχαριστίαν περισσεύσῃ εἰς τὴν δόξαν τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Διὸ οὐκ ⸀ἐγκακοῦμεν",
          {
            "noteId": 59
          },
          "ἀλλʼ εἰ καὶ ὁ ἔξω ἡμῶν ἄνθρωπος διαφθείρεται, ἀλλʼ ὁ ⸂ἔσω ἡμῶν",
          {
            "noteId": 60
          },
          "ἀνακαινοῦται ἡμέρᾳ καὶ ἡμέρᾳ."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "τὸ γὰρ παραυτίκα ἐλαφρὸν τῆς θλίψεως ⸀ἡμῶν",
          {
            "noteId": 61
          },
          "καθʼ ὑπερβολὴν εἰς ὑπερβολὴν αἰώνιον βάρος δόξης κατεργάζεται ἡμῖν,"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "μὴ σκοπούντων ἡμῶν τὰ βλεπόμενα ἀλλὰ τὰ μὴ βλεπόμενα, τὰ γὰρ βλεπόμενα πρόσκαιρα, τὰ δὲ μὴ βλεπόμενα αἰώνια."
        ]
      }
    ],
