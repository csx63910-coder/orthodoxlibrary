  "chapter": {
    "number": 11,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ὄφελον ἀνείχεσθέ μου μικρόν ⸀τι",
          {
            "noteId": 120
          },
          "⸀ἀφροσύνης",
          {
            "noteId": 121
          },
          "ἀλλὰ καὶ ἀνέχεσθέ μου."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ζηλῶ γὰρ ὑμᾶς θεοῦ ζήλῳ, ἡρμοσάμην γὰρ ὑμᾶς ἑνὶ ἀνδρὶ παρθένον ἁγνὴν παραστῆσαι τῷ Χριστῷ·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "φοβοῦμαι δὲ μή πως, ὡς ὁ ὄφις ⸂ἐξηπάτησεν Εὕαν",
          {
            "noteId": 122
          },
          "ἐν τῇ πανουργίᾳ αὐτοῦ, ⸀φθαρῇ",
          {
            "noteId": 123
          },
          "τὰ νοήματα ὑμῶν ἀπὸ τῆς ἁπλότητος ⸂καὶ τῆς ἁγνότητος",
          {
            "noteId": 124
          },
          "τῆς εἰς τὸν Χριστόν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "εἰ μὲν γὰρ ὁ ἐρχόμενος ἄλλον Ἰησοῦν κηρύσσει ὃν οὐκ ἐκηρύξαμεν, ἢ πνεῦμα ἕτερον λαμβάνετε ὃ οὐκ ἐλάβετε, ἢ εὐαγγέλιον ἕτερον ὃ οὐκ ἐδέξασθε, καλῶς ⸀ἀνέχεσθε",
          {
            "noteId": 125
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "λογίζομαι γὰρ μηδὲν ὑστερηκέναι τῶν ὑπερλίαν ἀποστόλων·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "εἰ δὲ καὶ ἰδιώτης τῷ λόγῳ, ἀλλʼ οὐ τῇ γνώσει, ἀλλʼ ἐν παντὶ ⸀φανερώσαντες",
          {
            "noteId": 126
          },
          "ἐν πᾶσιν εἰς ὑμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ἢ ἁμαρτίαν ἐποίησα ἐμαυτὸν ταπεινῶν ἵνα ὑμεῖς ὑψωθῆτε, ὅτι δωρεὰν τὸ τοῦ θεοῦ εὐαγγέλιον εὐηγγελισάμην ὑμῖν;"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἄλλας ἐκκλησίας ἐσύλησα λαβὼν ὀψώνιον πρὸς τὴν ὑμῶν διακονίαν,"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ παρὼν πρὸς ὑμᾶς καὶ ὑστερηθεὶς οὐ κατενάρκησα οὐθενός· τὸ γὰρ ὑστέρημά μου προσανεπλήρωσαν οἱ ἀδελφοὶ ἐλθόντες ἀπὸ Μακεδονίας· καὶ ἐν παντὶ ἀβαρῆ ⸂ἐμαυτὸν ὑμῖν",
          {
            "noteId": 127
          },
          "ἐτήρησα καὶ τηρήσω."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἔστιν ἀλήθεια Χριστοῦ ἐν ἐμοὶ ὅτι ἡ καύχησις αὕτη οὐ φραγήσεται εἰς ἐμὲ ἐν τοῖς κλίμασι τῆς Ἀχαΐας."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "διὰ τί; ὅτι οὐκ ἀγαπῶ ὑμᾶς; ὁ θεὸς οἶδεν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ὃ δὲ ποιῶ καὶ ποιήσω, ἵνα ἐκκόψω τὴν ἀφορμὴν τῶν θελόντων ἀφορμήν, ἵνα ἐν ᾧ καυχῶνται εὑρεθῶσιν καθὼς καὶ ἡμεῖς."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "οἱ γὰρ τοιοῦτοι ψευδαπόστολοι, ἐργάται δόλιοι, μετασχηματιζόμενοι εἰς ἀποστόλους Χριστοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καὶ οὐ ⸀θαῦμα",
          {
            "noteId": 128
          },
          "αὐτὸς γὰρ ὁ Σατανᾶς μετασχηματίζεται εἰς ἄγγελον φωτός·"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "οὐ μέγα οὖν εἰ καὶ οἱ διάκονοι αὐτοῦ μετασχηματίζονται ὡς διάκονοι δικαιοσύνης, ὧν τὸ τέλος ἔσται κατὰ τὰ ἔργα αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Πάλιν λέγω, μή τίς με δόξῃ ἄφρονα εἶναι— εἰ δὲ μή γε, κἂν ὡς ἄφρονα δέξασθέ με, ἵνα κἀγὼ μικρόν τι καυχήσωμαι·"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ὃ λαλῶ οὐ ⸂κατὰ κύριον λαλῶ",
          {
            "noteId": 129
          },
          ", ἀλλʼ ὡς ἐν ἀφροσύνῃ, ἐν ταύτῃ τῇ ὑποστάσει τῆς καυχήσεως."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ἐπεὶ πολλοὶ καυχῶνται ⸀κατὰ",
          {
            "noteId": 130
          },
          "σάρκα, κἀγὼ καυχήσομαι."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἡδέως γὰρ ἀνέχεσθε τῶν ἀφρόνων φρόνιμοι ὄντες·"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἀνέχεσθε γὰρ εἴ τις ὑμᾶς καταδουλοῖ, εἴ τις κατεσθίει, εἴ τις λαμβάνει, εἴ τις ἐπαίρεται, εἴ τις ⸂εἰς πρόσωπον ὑμᾶς",
          {
            "noteId": 131
          },
          "δέρει."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "κατὰ ἀτιμίαν λέγω, ὡς ὅτι ἡμεῖς ⸀ἠσθενήκαμεν",
          {
            "noteId": 132
          },
          "ἐν ᾧ δʼ ἄν τις τολμᾷ, ἐν ἀφροσύνῃ λέγω, τολμῶ κἀγώ."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Ἑβραῖοί εἰσιν; κἀγώ. Ἰσραηλῖταί εἰσιν; κἀγώ. σπέρμα Ἀβραάμ εἰσιν; κἀγώ."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "διάκονοι Χριστοῦ εἰσιν; παραφρονῶν λαλῶ, ὑπὲρ ἐγώ· ἐν κόποις περισσοτέρως, ἐν ⸂φυλακαῖς περισσοτέρως, ἐν πληγαῖς ὑπερβαλλόντως",
          {
            "noteId": 133
          },
          ", ἐν θανάτοις πολλάκις·"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ὑπὸ Ἰουδαίων πεντάκις τεσσεράκοντα παρὰ μίαν ἔλαβον,"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "τρὶς ἐραβδίσθην, ἅπαξ ἐλιθάσθην, τρὶς ἐναυάγησα, νυχθήμερον ἐν τῷ βυθῷ πεποίηκα·"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ὁδοιπορίαις πολλάκις, κινδύνοις ποταμῶν, κινδύνοις λῃστῶν, κινδύνοις ἐκ γένους, κινδύνοις ἐξ ἐθνῶν, κινδύνοις ἐν πόλει, κινδύνοις ἐν ἐρημίᾳ, κινδύνοις ἐν θαλάσσῃ, κινδύνοις ἐν ψευδαδέλφοις,"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "⸀κόπῳ",
          {
            "noteId": 134
          },
          "καὶ μόχθῳ, ἐν ἀγρυπνίαις πολλάκις, ἐν λιμῷ καὶ δίψει, ἐν νηστείαις πολλάκις, ἐν ψύχει καὶ γυμνότητι·"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "χωρὶς τῶν παρεκτὸς ἡ ⸀ἐπίστασίς",
          {
            "noteId": 135
          },
          "⸀μοι",
          {
            "noteId": 136
          },
          "ἡ καθʼ ἡμέραν, ἡ μέριμνα πασῶν τῶν ἐκκλησιῶν."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "τίς ἀσθενεῖ, καὶ οὐκ ἀσθενῶ; τίς σκανδαλίζεται καὶ οὐκ ἐγὼ πυροῦμαι;"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Εἰ καυχᾶσθαι δεῖ, τὰ τῆς ἀσθενείας μου καυχήσομαι."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "ὁ θεὸς καὶ πατὴρ τοῦ κυρίου ⸀Ἰησοῦ",
          {
            "noteId": 137
          },
          "οἶδεν, ὁ ὢν εὐλογητὸς εἰς τοὺς αἰῶνας, ὅτι οὐ ψεύδομαι."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "ἐν Δαμασκῷ ὁ ἐθνάρχης Ἁρέτα τοῦ βασιλέως ἐφρούρει τὴν ⸂πόλιν Δαμασκηνῶν",
          {
            "noteId": 138
          },
          "πιάσαι ⸀με",
          {
            "noteId": 139
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "καὶ διὰ θυρίδος ἐν σαργάνῃ ἐχαλάσθην διὰ τοῦ τείχους καὶ ἐξέφυγον τὰς χεῖρας αὐτοῦ."
        ]
      }
    ],
