  "chapter": {
    "number": 9,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Περὶ μὲν γὰρ τῆς διακονίας τῆς εἰς τοὺς ἁγίους περισσόν μοί ἐστιν τὸ γράφειν ὑμῖν,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "οἶδα γὰρ τὴν προθυμίαν ὑμῶν ἣν ὑπὲρ ὑμῶν καυχῶμαι Μακεδόσιν ὅτι Ἀχαΐα παρεσκεύασται ἀπὸ πέρυσι, καὶ ⸀τὸ",
          {
            "noteId": 100
          },
          "ὑμῶν ζῆλος ἠρέθισε τοὺς πλείονας."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἔπεμψα δὲ τοὺς ἀδελφούς, ἵνα μὴ τὸ καύχημα ἡμῶν τὸ ὑπὲρ ὑμῶν κενωθῇ ἐν τῷ μέρει τούτῳ, ἵνα καθὼς ἔλεγον παρεσκευασμένοι ἦτε,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "μή πως ἐὰν ἔλθωσιν σὺν ἐμοὶ Μακεδόνες καὶ εὕρωσιν ὑμᾶς ἀπαρασκευάστους καταισχυνθῶμεν ἡμεῖς, ἵνα μὴ ⸀λέγωμεν",
          {
            "noteId": 101
          },
          "ὑμεῖς, ἐν τῇ ὑποστάσει ⸀ταύτῃ",
          {
            "noteId": 102
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἀναγκαῖον οὖν ἡγησάμην παρακαλέσαι τοὺς ἀδελφοὺς ἵνα προέλθωσιν ⸀εἰς",
          {
            "noteId": 103
          },
          "ὑμᾶς καὶ προκαταρτίσωσι τὴν ⸀προεπηγγελμένην",
          {
            "noteId": 104
          },
          "εὐλογίαν ὑμῶν, ταύτην ἑτοίμην εἶναι οὕτως ὡς εὐλογίαν καὶ μὴ ὡς πλεονεξίαν."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Τοῦτο δέ, ὁ σπείρων φειδομένως φειδομένως καὶ θερίσει, καὶ ὁ σπείρων ἐπʼ εὐλογίαις ἐπʼ εὐλογίαις καὶ θερίσει."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἕκαστος καθὼς ⸀προῄρηται",
          {
            "noteId": 105
          },
          "τῇ καρδίᾳ, μὴ ἐκ λύπης ἢ ἐξ ἀνάγκης· ἱλαρὸν γὰρ δότην ἀγαπᾷ ὁ θεός."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "⸀δυνατεῖ",
          {
            "noteId": 106
          },
          "δὲ ὁ θεὸς πᾶσαν χάριν περισσεῦσαι εἰς ὑμᾶς, ἵνα ἐν παντὶ πάντοτε πᾶσαν αὐτάρκειαν ἔχοντες περισσεύητε εἰς πᾶν ἔργον ἀγαθόν·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "(καθὼς γέγραπται· Ἐσκόρπισεν, ἔδωκεν τοῖς πένησιν, ἡ δικαιοσύνη αὐτοῦ μένει εἰς τὸν αἰῶνα·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ὁ δὲ ἐπιχορηγῶν ⸀σπόρον",
          {
            "noteId": 107
          },
          "τῷ σπείροντι καὶ ἄρτον εἰς βρῶσιν ⸀χορηγήσει",
          {
            "noteId": 108
          },
          "καὶ ⸀πληθυνεῖ",
          {
            "noteId": 109
          },
          "τὸν σπόρον ὑμῶν καὶ ⸀αὐξήσει",
          {
            "noteId": 110
          },
          "τὰ γενήματα τῆς δικαιοσύνης ὑμῶν·)"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ἐν παντὶ πλουτιζόμενοι εἰς πᾶσαν ἁπλότητα, ἥτις κατεργάζεται διʼ ἡμῶν εὐχαριστίαν τῷ θεῷ—"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ὅτι ἡ διακονία τῆς λειτουργίας ταύτης οὐ μόνον ἐστὶν προσαναπληροῦσα τὰ ὑστερήματα τῶν ἁγίων, ἀλλὰ καὶ περισσεύουσα διὰ πολλῶν εὐχαριστιῶν τῷ θεῷ—"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "διὰ τῆς δοκιμῆς τῆς διακονίας ταύτης δοξάζοντες τὸν θεὸν ἐπὶ τῇ ὑποταγῇ τῆς ὁμολογίας ὑμῶν εἰς τὸ εὐαγγέλιον τοῦ Χριστοῦ καὶ ἁπλότητι τῆς κοινωνίας εἰς αὐτοὺς καὶ εἰς πάντας,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καὶ αὐτῶν δεήσει ὑπὲρ ὑμῶν ἐπιποθούντων ὑμᾶς διὰ τὴν ὑπερβάλλουσαν χάριν τοῦ θεοῦ ἐφʼ ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "⸀χάρις",
          {
            "noteId": 111
          },
          "τῷ θεῷ ἐπὶ τῇ ἀνεκδιηγήτῳ αὐτοῦ δωρεᾷ."
        ]
      }
    ],
