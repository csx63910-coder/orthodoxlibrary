  "chapter": {
    "number": 8,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Γνωρίζομεν δὲ ὑμῖν, ἀδελφοί, τὴν χάριν τοῦ θεοῦ τὴν δεδομένην ἐν ταῖς ἐκκλησίαις τῆς Μακεδονίας,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ὅτι ἐν πολλῇ δοκιμῇ θλίψεως ἡ περισσεία τῆς χαρᾶς αὐτῶν καὶ ἡ κατὰ βάθους πτωχεία αὐτῶν ἐπερίσσευσεν εἰς ⸂τὸ πλοῦτος",
          {
            "noteId": 90
          },
          "τῆς ἁπλότητος αὐτῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ὅτι κατὰ δύναμιν, μαρτυρῶ, καὶ ⸀παρὰ",
          {
            "noteId": 91
          },
          "δύναμιν, αὐθαίρετοι"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "μετὰ πολλῆς παρακλήσεως δεόμενοι ἡμῶν, τὴν χάριν καὶ τὴν κοινωνίαν τῆς διακονίας τῆς εἰς τοὺς ἁγίους—"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ οὐ καθὼς ἠλπίσαμεν ἀλλʼ ἑαυτοὺς ἔδωκαν πρῶτον τῷ κυρίῳ καὶ ἡμῖν διὰ θελήματος θεοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "εἰς τὸ παρακαλέσαι ἡμᾶς Τίτον ἵνα καθὼς προενήρξατο οὕτως καὶ ἐπιτελέσῃ εἰς ὑμᾶς καὶ τὴν χάριν ταύτην·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἀλλʼ ὥσπερ ἐν παντὶ περισσεύετε, πίστει καὶ λόγῳ καὶ γνώσει καὶ πάσῃ σπουδῇ καὶ τῇ ἐξ ⸂ἡμῶν ἐν ὑμῖν",
          {
            "noteId": 92
          },
          "ἀγάπῃ, ἵνα καὶ ἐν ταύτῃ τῇ χάριτι περισσεύητε."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Οὐ κατʼ ἐπιταγὴν λέγω ἀλλὰ διὰ τῆς ἑτέρων σπουδῆς καὶ τὸ τῆς ὑμετέρας ἀγάπης γνήσιον δοκιμάζων·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "γινώσκετε γὰρ τὴν χάριν τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ, ὅτι διʼ ὑμᾶς ἐπτώχευσεν πλούσιος ὤν, ἵνα ὑμεῖς τῇ ἐκείνου πτωχείᾳ πλουτήσητε."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ γνώμην ἐν τούτῳ δίδωμι· τοῦτο γὰρ ὑμῖν συμφέρει, οἵτινες οὐ μόνον τὸ ποιῆσαι ἀλλὰ καὶ τὸ θέλειν προενήρξασθε ἀπὸ πέρυσι·"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "νυνὶ δὲ καὶ τὸ ποιῆσαι ἐπιτελέσατε, ὅπως καθάπερ ἡ προθυμία τοῦ θέλειν οὕτως καὶ τὸ ἐπιτελέσαι ἐκ τοῦ ἔχειν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "εἰ γὰρ ἡ προθυμία πρόκειται, καθὸ ἐὰν ⸀ἔχῃ",
          {
            "noteId": 93
          },
          "εὐπρόσδεκτος, οὐ καθὸ οὐκ ἔχει."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "οὐ γὰρ ἵνα ἄλλοις ἄνεσις, ⸀ὑμῖν",
          {
            "noteId": 94
          },
          "θλῖψις· ἀλλʼ ἐξ ἰσότητος"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἐν τῷ νῦν καιρῷ τὸ ὑμῶν περίσσευμα εἰς τὸ ἐκείνων ὑστέρημα, ἵνα καὶ τὸ ἐκείνων περίσσευμα γένηται εἰς τὸ ὑμῶν ὑστέρημα, ὅπως γένηται ἰσότης·"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καθὼς γέγραπται· Ὁ τὸ πολὺ οὐκ ἐπλεόνασεν, καὶ ὁ τὸ ὀλίγον οὐκ ἠλαττόνησεν."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Χάρις δὲ τῷ θεῷ τῷ ⸀διδόντι",
          {
            "noteId": 95
          },
          "τὴν αὐτὴν σπουδὴν ὑπὲρ ὑμῶν ἐν τῇ καρδίᾳ Τίτου,"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ὅτι τὴν μὲν παράκλησιν ἐδέξατο, σπουδαιότερος δὲ ὑπάρχων αὐθαίρετος ἐξῆλθεν πρὸς ὑμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "συνεπέμψαμεν δὲ μετʼ αὐτοῦ τὸν ἀδελφὸν οὗ ὁ ἔπαινος ἐν τῷ εὐαγγελίῳ διὰ πασῶν τῶν ἐκκλησιῶν—"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "οὐ μόνον δὲ ἀλλὰ καὶ χειροτονηθεὶς ὑπὸ τῶν ἐκκλησιῶν συνέκδημος ἡμῶν ⸀σὺν",
          {
            "noteId": 96
          },
          "τῇ χάριτι ταύτῃ τῇ διακονουμένῃ ὑφʼ ἡμῶν πρὸς τὴν ⸀αὐτοῦ",
          {
            "noteId": 97
          },
          "τοῦ κυρίου δόξαν καὶ προθυμίαν ἡμῶν—"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "στελλόμενοι τοῦτο μή τις ἡμᾶς μωμήσηται ἐν τῇ ἁδρότητι ταύτῃ τῇ διακονουμένῃ ὑφʼ ἡμῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "⸂προνοοῦμεν γὰρ",
          {
            "noteId": 98
          },
          "καλὰ οὐ μόνον ἐνώπιον κυρίου ἀλλὰ καὶ ἐνώπιον ἀνθρώπων."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "συνεπέμψαμεν δὲ αὐτοῖς τὸν ἀδελφὸν ἡμῶν ὃν ἐδοκιμάσαμεν ἐν πολλοῖς πολλάκις σπουδαῖον ὄντα, νυνὶ δὲ πολὺ σπουδαιότερον πεποιθήσει πολλῇ τῇ εἰς ὑμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "εἴτε ὑπὲρ Τίτου, κοινωνὸς ἐμὸς καὶ εἰς ὑμᾶς συνεργός· εἴτε ἀδελφοὶ ἡμῶν, ἀπόστολοι ἐκκλησιῶν, δόξα Χριστοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "τὴν οὖν ἔνδειξιν τῆς ἀγάπης ὑμῶν καὶ ἡμῶν καυχήσεως ὑπὲρ ὑμῶν εἰς αὐτοὺς ⸀ἐνδεικνύμενοι",
          {
            "noteId": 99
          },
          "εἰς πρόσωπον τῶν ἐκκλησιῶν."
        ]
      }
    ],
