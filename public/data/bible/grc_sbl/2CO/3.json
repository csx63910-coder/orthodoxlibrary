  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἀρχόμεθα πάλιν ἑαυτοὺς ⸀συνιστάνειν",
          {
            "noteId": 33
          },
          "⸀ἢ",
          {
            "noteId": 34
          },
          "μὴ χρῄζομεν ὥς τινες συστατικῶν ἐπιστολῶν πρὸς ὑμᾶς ἢ ἐξ ⸀ὑμῶν",
          {
            "noteId": 35
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἡ ἐπιστολὴ ἡμῶν ὑμεῖς ἐστε, ἐγγεγραμμένη ἐν ταῖς καρδίαις ἡμῶν, γινωσκομένη καὶ ἀναγινωσκομένη ὑπὸ πάντων ἀνθρώπων·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "φανερούμενοι ὅτι ἐστὲ ἐπιστολὴ Χριστοῦ διακονηθεῖσα ὑφʼ ἡμῶν, ἐγγεγραμμένη οὐ μέλανι ἀλλὰ πνεύματι θεοῦ ζῶντος, οὐκ ἐν πλαξὶν λιθίναις ἀλλʼ ἐν πλαξὶν καρδίαις σαρκίναις."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Πεποίθησιν δὲ τοιαύτην ἔχομεν διὰ τοῦ Χριστοῦ πρὸς τὸν θεόν."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "οὐχ ὅτι ⸂ἀφʼ ἑαυτῶν ἱκανοί ἐσμεν",
          {
            "noteId": 36
          },
          "λογίσασθαί τι ὡς ἐξ ⸀αὑτῶν",
          {
            "noteId": 37
          },
          "ἀλλʼ ἡ ἱκανότης ἡμῶν ἐκ τοῦ θεοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ὃς καὶ ἱκάνωσεν ἡμᾶς διακόνους καινῆς διαθήκης, οὐ γράμματος ἀλλὰ πνεύματος, τὸ γὰρ γράμμα ἀποκτέννει, τὸ δὲ πνεῦμα ζῳοποιεῖ."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Εἰ δὲ ἡ διακονία τοῦ θανάτου ἐν ⸀γράμμασιν",
          {
            "noteId": 38
          },
          "⸀ἐντετυπωμένη",
          {
            "noteId": 39
          },
          "λίθοις ἐγενήθη ἐν δόξῃ, ὥστε μὴ δύνασθαι ἀτενίσαι τοὺς υἱοὺς Ἰσραὴλ εἰς τὸ πρόσωπον Μωϋσέως διὰ τὴν δόξαν τοῦ προσώπου αὐτοῦ τὴν καταργουμένην,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "πῶς οὐχὶ μᾶλλον ἡ διακονία τοῦ πνεύματος ἔσται ἐν δόξῃ;"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "εἰ γὰρ ⸂τῇ διακονίᾳ",
          {
            "noteId": 40
          },
          "τῆς κατακρίσεως δόξα, πολλῷ μᾶλλον περισσεύει ἡ διακονία τῆς ⸀δικαιοσύνης",
          {
            "noteId": 41
          },
          "δόξῃ."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ γὰρ οὐ δεδόξασται τὸ δεδοξασμένον ἐν τούτῳ τῷ μέρει ⸀εἵνεκεν",
          {
            "noteId": 42
          },
          "τῆς ὑπερβαλλούσης δόξης·"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "εἰ γὰρ τὸ καταργούμενον διὰ δόξης, πολλῷ μᾶλλον τὸ μένον ἐν δόξῃ."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ἔχοντες οὖν τοιαύτην ἐλπίδα πολλῇ παρρησίᾳ χρώμεθα,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ οὐ καθάπερ Μωϋσῆς ἐτίθει κάλυμμα ἐπὶ τὸ πρόσωπον ⸀αὐτοῦ",
          {
            "noteId": 43
          },
          "πρὸς τὸ μὴ ἀτενίσαι τοὺς υἱοὺς Ἰσραὴλ εἰς τὸ τέλος τοῦ καταργουμένου."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἀλλὰ ἐπωρώθη τὰ νοήματα αὐτῶν. ἄχρι γὰρ τῆς σήμερον ⸀ἡμέρας",
          {
            "noteId": 44
          },
          "τὸ αὐτὸ κάλυμμα ἐπὶ τῇ ἀναγνώσει τῆς παλαιᾶς διαθήκης μένει μὴ ἀνακαλυπτόμενον, ⸀ὅτι",
          {
            "noteId": 45
          },
          "ἐν Χριστῷ καταργεῖται,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ἀλλʼ ἕως σήμερον ἡνίκα ⸂ἂν ἀναγινώσκηται",
          {
            "noteId": 46
          },
          "Μωϋσῆς κάλυμμα ἐπὶ τὴν καρδίαν αὐτῶν κεῖται·"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ἡνίκα ⸂δὲ ἐὰν",
          {
            "noteId": 47
          },
          "ἐπιστρέψῃ πρὸς κύριον, περιαιρεῖται τὸ κάλυμμα."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ὁ δὲ κύριος τὸ πνεῦμά ἐστιν· οὗ δὲ τὸ πνεῦμα ⸀κυρίου",
          {
            "noteId": 48
          },
          "ἐλευθερία."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ἡμεῖς δὲ πάντες ἀνακεκαλυμμένῳ προσώπῳ τὴν δόξαν κυρίου κατοπτριζόμενοι τὴν αὐτὴν εἰκόνα μεταμορφούμεθα ἀπὸ δόξης εἰς δόξαν, καθάπερ ἀπὸ κυρίου πνεύματος."
        ]
      }
    ],
