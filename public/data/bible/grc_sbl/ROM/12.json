  "chapter": {
    "number": 12,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Παρακαλῶ οὖν ὑμᾶς, ἀδελφοί, διὰ τῶν οἰκτιρμῶν τοῦ θεοῦ παραστῆσαι τὰ σώματα ὑμῶν θυσίαν ζῶσαν ἁγίαν ⸂εὐάρεστον τῷ θεῷ",
          {
            "noteId": 140
          },
          ", τὴν λογικὴν λατρείαν ὑμῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ μὴ ⸀συσχηματίζεσθε",
          {
            "noteId": 141
          },
          "τῷ αἰῶνι τούτῳ, ἀλλὰ ⸀μεταμορφοῦσθε",
          {
            "noteId": 142
          },
          "τῇ ἀνακαινώσει τοῦ ⸀νοός",
          {
            "noteId": 143
          },
          "εἰς τὸ δοκιμάζειν ὑμᾶς τί τὸ θέλημα τοῦ θεοῦ, τὸ ἀγαθὸν καὶ εὐάρεστον καὶ τέλειον."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Λέγω γὰρ διὰ τῆς χάριτος τῆς δοθείσης μοι παντὶ τῷ ὄντι ἐν ὑμῖν μὴ ὑπερφρονεῖν παρʼ ὃ δεῖ φρονεῖν, ἀλλὰ φρονεῖν εἰς τὸ σωφρονεῖν, ἑκάστῳ ὡς ὁ θεὸς ἐμέρισεν μέτρον πίστεως."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καθάπερ γὰρ ἐν ἑνὶ σώματι ⸂πολλὰ μέλη",
          {
            "noteId": 144
          },
          "ἔχομεν, τὰ δὲ μέλη πάντα οὐ τὴν αὐτὴν ἔχει πρᾶξιν,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "οὕτως οἱ πολλοὶ ἓν σῶμά ἐσμεν ἐν Χριστῷ, ⸀τὸ",
          {
            "noteId": 145
          },
          "δὲ καθʼ εἷς ἀλλήλων μέλη."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἔχοντες δὲ χαρίσματα κατὰ τὴν χάριν τὴν δοθεῖσαν ἡμῖν διάφορα, εἴτε προφητείαν κατὰ τὴν ἀναλογίαν τῆς πίστεως,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "εἴτε διακονίαν ἐν τῇ διακονίᾳ, εἴτε ὁ διδάσκων ἐν τῇ διδασκαλίᾳ,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "εἴτε ὁ παρακαλῶν ἐν τῇ παρακλήσει, ὁ μεταδιδοὺς ἐν ἁπλότητι, ὁ προϊστάμενος ἐν σπουδῇ, ὁ ἐλεῶν ἐν ἱλαρότητι."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Ἡ ἀγάπη ἀνυπόκριτος. ἀποστυγοῦντες τὸ πονηρόν, κολλώμενοι τῷ ἀγαθῷ·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "τῇ φιλαδελφίᾳ εἰς ἀλλήλους φιλόστοργοι, τῇ τιμῇ ἀλλήλους προηγούμενοι,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "τῇ σπουδῇ μὴ ὀκνηροί, τῷ πνεύματι ζέοντες, τῷ κυρίῳ δουλεύοντες,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "τῇ ἐλπίδι χαίροντες, τῇ θλίψει ὑπομένοντες, τῇ προσευχῇ προσκαρτεροῦντες,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ταῖς χρείαις τῶν ἁγίων κοινωνοῦντες, τὴν φιλοξενίαν διώκοντες."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "εὐλογεῖτε τοὺς ⸀διώκοντας",
          {
            "noteId": 146
          },
          "εὐλογεῖτε καὶ μὴ καταρᾶσθε."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "χαίρειν μετὰ ⸀χαιρόντων",
          {
            "noteId": 147
          },
          "κλαίειν μετὰ κλαιόντων."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "τὸ αὐτὸ εἰς ἀλλήλους φρονοῦντες, μὴ τὰ ὑψηλὰ φρονοῦντες ἀλλὰ τοῖς ταπεινοῖς συναπαγόμενοι. μὴ γίνεσθε φρόνιμοι παρʼ ἑαυτοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "μηδενὶ κακὸν ἀντὶ κακοῦ ἀποδιδόντες· προνοούμενοι καλὰ ἐνώπιον πάντων ἀνθρώπων·"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "εἰ δυνατόν, τὸ ἐξ ὑμῶν μετὰ πάντων ἀνθρώπων εἰρηνεύοντες·"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "μὴ ἑαυτοὺς ἐκδικοῦντες, ἀγαπητοί, ἀλλὰ δότε τόπον τῇ ὀργῇ, γέγραπται γάρ· Ἐμοὶ ἐκδίκησις, ἐγὼ ἀνταποδώσω, λέγει κύριος."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "⸂ἀλλὰ ἐὰν",
          {
            "noteId": 148
          },
          "πεινᾷ ὁ ἐχθρός σου, ψώμιζε αὐτόν· ἐὰν διψᾷ, πότιζε αὐτόν· τοῦτο γὰρ ποιῶν ἄνθρακας πυρὸς σωρεύσεις ἐπὶ τὴν κεφαλὴν αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "μὴ νικῶ ὑπὸ τοῦ κακοῦ, ἀλλὰ νίκα ἐν τῷ ἀγαθῷ τὸ κακόν."
        ]
      }
    ],
