  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Τί οὖν τὸ περισσὸν τοῦ Ἰουδαίου, ἢ τίς ἡ ὠφέλεια τῆς περιτομῆς;"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "πολὺ κατὰ πάντα τρόπον. πρῶτον μὲν ⸀γὰρ",
          {
            "noteId": 22
          },
          "ὅτι ἐπιστεύθησαν τὰ λόγια τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "τί γάρ; εἰ ἠπίστησάν τινες, μὴ ἡ ἀπιστία αὐτῶν τὴν πίστιν τοῦ θεοῦ καταργήσει;"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "μὴ γένοιτο· γινέσθω δὲ ὁ θεὸς ἀληθής, πᾶς δὲ ἄνθρωπος ψεύστης, ⸀καθὼς",
          {
            "noteId": 23
          },
          "γέγραπται· Ὅπως ἂν δικαιωθῇς ἐν τοῖς λόγοις σου καὶ ⸀νικήσεις",
          {
            "noteId": 24
          },
          "ἐν τῷ κρίνεσθαί σε."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "εἰ δὲ ἡ ἀδικία ἡμῶν θεοῦ δικαιοσύνην συνίστησιν, τί ἐροῦμεν; μὴ ἄδικος ὁ θεὸς ὁ ἐπιφέρων τὴν ὀργήν; κατὰ ἄνθρωπον λέγω."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "μὴ γένοιτο· ἐπεὶ πῶς κρινεῖ ὁ θεὸς τὸν κόσμον;"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "εἰ ⸀δὲ",
          {
            "noteId": 25
          },
          "ἡ ἀλήθεια τοῦ θεοῦ ἐν τῷ ἐμῷ ψεύσματι ἐπερίσσευσεν εἰς τὴν δόξαν αὐτοῦ, τί ἔτι κἀγὼ ὡς ἁμαρτωλὸς κρίνομαι,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ μὴ καθὼς βλασφημούμεθα καὶ καθώς φασίν τινες ἡμᾶς λέγειν ὅτι Ποιήσωμεν τὰ κακὰ ἵνα ἔλθῃ τὰ ἀγαθά; ὧν τὸ κρίμα ἔνδικόν ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Τί οὖν; προεχόμεθα; οὐ πάντως, προῃτιασάμεθα γὰρ Ἰουδαίους τε καὶ Ἕλληνας πάντας ὑφʼ ἁμαρτίαν εἶναι,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καθὼς γέγραπται ὅτι Οὐκ ἔστιν δίκαιος οὐδὲ εἷς,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "οὐκ ἔστιν ⸀ὁ",
          {
            "noteId": 26
          },
          "συνίων, οὐκ ἔστιν ⸁ὁ",
          {
            "noteId": 27
          },
          "ἐκζητῶν τὸν θεόν·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "πάντες ἐξέκλιναν, ἅμα ἠχρεώθησαν· οὐκ ⸀ἔστιν",
          {
            "noteId": 28
          },
          "ποιῶν χρηστότητα, οὐκ ἔστιν ἕως ἑνός."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "τάφος ἀνεῳγμένος ὁ λάρυγξ αὐτῶν, ταῖς γλώσσαις αὐτῶν ἐδολιοῦσαν, ἰὸς ἀσπίδων ὑπὸ τὰ χείλη αὐτῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ὧν τὸ στόμα ἀρᾶς καὶ πικρίας γέμει·"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ὀξεῖς οἱ πόδες αὐτῶν ἐκχέαι αἷμα,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "σύντριμμα καὶ ταλαιπωρία ἐν ταῖς ὁδοῖς αὐτῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καὶ ὁδὸν εἰρήνης οὐκ ἔγνωσαν."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "οὐκ ἔστιν φόβος θεοῦ ἀπέναντι τῶν ὀφθαλμῶν αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Οἴδαμεν δὲ ὅτι ὅσα ὁ νόμος λέγει τοῖς ἐν τῷ νόμῳ λαλεῖ, ἵνα πᾶν στόμα φραγῇ καὶ ὑπόδικος γένηται πᾶς ὁ κόσμος τῷ θεῷ·"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "διότι ἐξ ἔργων νόμου οὐ δικαιωθήσεται πᾶσα σὰρξ ἐνώπιον αὐτοῦ, διὰ γὰρ νόμου ἐπίγνωσις ἁμαρτίας."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Νυνὶ δὲ χωρὶς νόμου δικαιοσύνη θεοῦ πεφανέρωται, μαρτυρουμένη ὑπὸ τοῦ νόμου καὶ τῶν προφητῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "δικαιοσύνη δὲ θεοῦ διὰ πίστεως Ἰησοῦ Χριστοῦ, εἰς ⸀πάντας",
          {
            "noteId": 29
          },
          "τοὺς πιστεύοντας, οὐ γάρ ἐστιν διαστολή."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "πάντες γὰρ ἥμαρτον καὶ ὑστεροῦνται τῆς δόξης τοῦ θεοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "δικαιούμενοι δωρεὰν τῇ αὐτοῦ χάριτι διὰ τῆς ἀπολυτρώσεως τῆς ἐν Χριστῷ Ἰησοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ὃν προέθετο ὁ θεὸς ἱλαστήριον ⸀διὰ",
          {
            "noteId": 30
          },
          "πίστεως ἐν τῷ αὐτοῦ αἵματι εἰς ἔνδειξιν τῆς δικαιοσύνης αὐτοῦ διὰ τὴν πάρεσιν τῶν προγεγονότων ἁμαρτημάτων"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ἐν τῇ ἀνοχῇ τοῦ θεοῦ, πρὸς ⸀τὴν",
          {
            "noteId": 31
          },
          "ἔνδειξιν τῆς δικαιοσύνης αὐτοῦ ἐν τῷ νῦν καιρῷ, εἰς τὸ εἶναι αὐτὸν δίκαιον καὶ δικαιοῦντα τὸν ἐκ πίστεως Ἰησοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Ποῦ οὖν ἡ καύχησις; ἐξεκλείσθη. διὰ ποίου νόμου; τῶν ἔργων; οὐχί, ἀλλὰ διὰ νόμου πίστεως."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "λογιζόμεθα ⸀γὰρ",
          {
            "noteId": 32
          },
          "⸂δικαιοῦσθαι πίστει",
          {
            "noteId": 33
          },
          "ἄνθρωπον χωρὶς ἔργων νόμου."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "ἢ Ἰουδαίων ὁ θεὸς μόνον; ⸀οὐχὶ",
          {
            "noteId": 34
          },
          "καὶ ἐθνῶν; ναὶ καὶ ἐθνῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "⸀εἴπερ",
          {
            "noteId": 35
          },
          "εἷς ὁ θεός, ὃς δικαιώσει περιτομὴν ἐκ πίστεως καὶ ἀκροβυστίαν διὰ τῆς πίστεως."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "νόμον οὖν καταργοῦμεν διὰ τῆς πίστεως; μὴ γένοιτο, ἀλλὰ νόμον ⸀ἱστάνομεν",
          {
            "noteId": 36
          }
        ]
      }
    ],
