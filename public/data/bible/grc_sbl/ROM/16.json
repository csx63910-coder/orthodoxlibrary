  "chapter": {
    "number": 16,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Συνίστημι δὲ ὑμῖν Φοίβην τὴν ἀδελφὴν ἡμῶν, οὖσαν ⸀καὶ",
          {
            "noteId": 208
          },
          "διάκονον τῆς ἐκκλησίας τῆς ἐν Κεγχρεαῖς,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἵνα ⸂αὐτὴν προσδέξησθε",
          {
            "noteId": 209
          },
          "ἐν κυρίῳ ἀξίως τῶν ἁγίων, καὶ παραστῆτε αὐτῇ ἐν ᾧ ἂν ὑμῶν χρῄζῃ πράγματι, καὶ γὰρ αὐτὴ προστάτις πολλῶν ἐγενήθη καὶ ⸂ἐμοῦ αὐτοῦ",
          {
            "noteId": 210
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Ἀσπάσασθε Πρίσκαν καὶ Ἀκύλαν τοὺς συνεργούς μου ἐν Χριστῷ Ἰησοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "οἵτινες ὑπὲρ τῆς ψυχῆς μου τὸν ἑαυτῶν τράχηλον ὑπέθηκαν, οἷς οὐκ ἐγὼ μόνος εὐχαριστῶ ἀλλὰ καὶ πᾶσαι αἱ ἐκκλησίαι τῶν ἐθνῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ τὴν κατʼ οἶκον αὐτῶν ἐκκλησίαν. ἀσπάσασθε Ἐπαίνετον τὸν ἀγαπητόν μου, ὅς ἐστιν ἀπαρχὴ τῆς ⸀Ἀσίας",
          {
            "noteId": 211
          },
          "εἰς Χριστόν."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἀσπάσασθε ⸀Μαριάμ",
          {
            "noteId": 212
          },
          "ἥτις πολλὰ ἐκοπίασεν εἰς ⸀ὑμᾶς",
          {
            "noteId": 213
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἀσπάσασθε Ἀνδρόνικον καὶ ⸀Ἰουνίαν",
          {
            "noteId": 214
          },
          "τοὺς συγγενεῖς μου καὶ συναιχμαλώτους μου, οἵτινές εἰσιν ἐπίσημοι ἐν τοῖς ἀποστόλοις, οἳ καὶ πρὸ ἐμοῦ ⸀γέγοναν",
          {
            "noteId": 215
          },
          "ἐν Χριστῷ."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἀσπάσασθε ⸀Ἀμπλιᾶτον",
          {
            "noteId": 216
          },
          "τὸν ἀγαπητόν μου ἐν κυρίῳ."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ἀσπάσασθε Οὐρβανὸν τὸν συνεργὸν ἡμῶν ἐν Χριστῷ καὶ Στάχυν τὸν ἀγαπητόν μου."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἀσπάσασθε Ἀπελλῆν τὸν δόκιμον ἐν Χριστῷ. ἀσπάσασθε τοὺς ἐκ τῶν Ἀριστοβούλου."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ἀσπάσασθε Ἡρῳδίωνα τὸν ⸀συγγενῆ",
          {
            "noteId": 217
          },
          "μου. ἀσπάσασθε τοὺς ἐκ τῶν Ναρκίσσου τοὺς ὄντας ἐν κυρίῳ."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ἀσπάσασθε Τρύφαιναν καὶ Τρυφῶσαν τὰς κοπιώσας ἐν κυρίῳ. ἀσπάσασθε Περσίδα τὴν ἀγαπητήν, ἥτις πολλὰ ἐκοπίασεν ἐν κυρίῳ."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ἀσπάσασθε Ῥοῦφον τὸν ἐκλεκτὸν ἐν κυρίῳ καὶ τὴν μητέρα αὐτοῦ καὶ ἐμοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἀσπάσασθε Ἀσύγκριτον, Φλέγοντα, ⸂Ἑρμῆν, Πατροβᾶν, Ἑρμᾶν⸃ καὶ τοὺς σὺν αὐτοῖς ἀδελφούς.",
          {
            "noteId": 218
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ἀσπάσασθε Φιλόλογον καὶ Ἰουλίαν, Νηρέα καὶ τὴν ἀδελφὴν αὐτοῦ, καὶ Ὀλυμπᾶν καὶ τοὺς σὺν αὐτοῖς πάντας ἁγίους."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Ἀσπάσασθε ἀλλήλους ἐν φιλήματι ἁγίῳ. Ἀσπάζονται ὑμᾶς αἱ ἐκκλησίαι ⸀πᾶσαι",
          {
            "noteId": 219
          },
          "τοῦ Χριστοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Παρακαλῶ δὲ ὑμᾶς, ἀδελφοί, σκοπεῖν τοὺς τὰς διχοστασίας καὶ τὰ σκάνδαλα παρὰ τὴν διδαχὴν ἣν ὑμεῖς ἐμάθετε ποιοῦντας, καὶ ⸀ἐκκλίνετε",
          {
            "noteId": 220
          },
          "ἀπʼ αὐτῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "οἱ γὰρ τοιοῦτοι τῷ κυρίῳ ⸀ἡμῶν",
          {
            "noteId": 221
          },
          "Χριστῷ οὐ δουλεύουσιν ἀλλὰ τῇ ἑαυτῶν κοιλίᾳ, καὶ διὰ τῆς χρηστολογίας καὶ εὐλογίας ἐξαπατῶσι τὰς καρδίας τῶν ἀκάκων."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἡ γὰρ ὑμῶν ὑπακοὴ εἰς πάντας ἀφίκετο· ⸂ἐφʼ ὑμῖν οὖν χαίρω",
          {
            "noteId": 222
          },
          ", θέλω δὲ ὑμᾶς ⸀σοφοὺς",
          {
            "noteId": 223
          },
          "εἶναι εἰς τὸ ἀγαθόν, ἀκεραίους δὲ εἰς τὸ κακόν."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ὁ δὲ θεὸς τῆς εἰρήνης συντρίψει τὸν Σατανᾶν ὑπὸ τοὺς πόδας ὑμῶν ἐν τάχει. ἡ χάρις τοῦ κυρίου ἡμῶν Ἰησοῦ ⸀Χριστοῦ",
          {
            "noteId": 224
          },
          "μεθʼ ὑμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "⸀Ἀσπάζεται",
          {
            "noteId": 225
          },
          "ὑμᾶς Τιμόθεος ὁ συνεργός μου, καὶ Λούκιος καὶ Ἰάσων καὶ Σωσίπατρος οἱ συγγενεῖς μου."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ἀσπάζομαι ὑμᾶς ἐγὼ Τέρτιος ὁ γράψας τὴν ἐπιστολὴν ἐν κυρίῳ."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ἀσπάζεται ὑμᾶς Γάϊος ὁ ξένος μου καὶ ⸂ὅλης τῆς ἐκκλησίας",
          {
            "noteId": 226
          },
          ". ἀσπάζεται ὑμᾶς Ἔραστος ὁ οἰκονόμος τῆς πόλεως καὶ Κούαρτος ὁ ἀδελφός."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "⸂Ἡ χάρις τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ μετὰ πάντων ὑμῶν",
          {
            "noteId": 227
          },
          "⸃ ⸀Ἀμήν",
          {
            "noteId": 228
          },
          "‘p /’ ‘/book’"
        ]
      }
    ],
