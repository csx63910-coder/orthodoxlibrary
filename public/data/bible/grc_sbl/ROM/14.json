  "chapter": {
    "number": 14,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Τὸν δὲ ἀσθενοῦντα τῇ πίστει προσλαμβάνεσθε, μὴ εἰς διακρίσεις διαλογισμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ὃς μὲν πιστεύει φαγεῖν πάντα, ὁ δὲ ἀσθενῶν λάχανα ἐσθίει."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ὁ ἐσθίων τὸν μὴ ἐσθίοντα μὴ ἐξουθενείτω, ⸂ὁ δὲ",
          {
            "noteId": 160
          },
          "μὴ ἐσθίων τὸν ἐσθίοντα μὴ κρινέτω, ὁ θεὸς γὰρ αὐτὸν προσελάβετο."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "σὺ τίς εἶ ὁ κρίνων ἀλλότριον οἰκέτην; τῷ ἰδίῳ κυρίῳ στήκει ἢ πίπτει· σταθήσεται δέ, ⸂δυνατεῖ γὰρ",
          {
            "noteId": 161
          },
          "ὁ ⸀κύριος",
          {
            "noteId": 162
          },
          "στῆσαι αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Ὃς ⸀μὲν",
          {
            "noteId": 163
          },
          "κρίνει ἡμέραν παρʼ ἡμέραν, ὃς δὲ κρίνει πᾶσαν ἡμέραν· ἕκαστος ἐν τῷ ἰδίῳ νοῒ πληροφορείσθω·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ὁ φρονῶν τὴν ἡμέραν κυρίῳ ⸀φρονεῖ",
          {
            "noteId": 164
          },
          "καὶ ὁ ἐσθίων κυρίῳ ἐσθίει, εὐχαριστεῖ γὰρ τῷ θεῷ· καὶ ὁ μὴ ἐσθίων κυρίῳ οὐκ ἐσθίει, καὶ εὐχαριστεῖ τῷ θεῷ."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Οὐδεὶς γὰρ ἡμῶν ἑαυτῷ ζῇ, καὶ οὐδεὶς ἑαυτῷ ἀποθνῄσκει·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἐάν τε γὰρ ζῶμεν, τῷ κυρίῳ ζῶμεν, ἐάν τε ἀποθνῄσκωμεν, τῷ κυρίῳ ἀποθνῄσκομεν. ἐάν τε οὖν ζῶμεν ἐάν τε ἀποθνῄσκωμεν, τοῦ κυρίου ἐσμέν."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "εἰς τοῦτο γὰρ ⸀Χριστὸς",
          {
            "noteId": 165
          },
          "⸀ἀπέθανεν",
          {
            "noteId": 166
          },
          "καὶ ἔζησεν ἵνα καὶ νεκρῶν καὶ ζώντων κυριεύσῃ."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Σὺ δὲ τί κρίνεις τὸν ἀδελφόν σου; ἢ καὶ σὺ τί ἐξουθενεῖς τὸν ἀδελφόν σου; πάντες γὰρ παραστησόμεθα τῷ βήματι τοῦ ⸀θεοῦ",
          {
            "noteId": 167
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "γέγραπται γάρ· Ζῶ ἐγώ, λέγει κύριος, ὅτι ἐμοὶ κάμψει πᾶν γόνυ, καὶ ⸂πᾶσα γλῶσσα ἐξομολογήσεται",
          {
            "noteId": 168
          },
          "τῷ θεῷ."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "⸀ἄρα",
          {
            "noteId": 169
          },
          "ἕκαστος ἡμῶν περὶ ἑαυτοῦ λόγον ⸀δώσει",
          {
            "noteId": 170
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Μηκέτι οὖν ἀλλήλους κρίνωμεν· ἀλλὰ τοῦτο κρίνατε μᾶλλον, τὸ μὴ τιθέναι πρόσκομμα τῷ ἀδελφῷ ἢ σκάνδαλον."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "οἶδα καὶ πέπεισμαι ἐν κυρίῳ Ἰησοῦ ὅτι οὐδὲν κοινὸν διʼ ⸀ἑαυτοῦ",
          {
            "noteId": 171
          },
          "εἰ μὴ τῷ λογιζομένῳ τι κοινὸν εἶναι, ἐκείνῳ κοινόν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "εἰ ⸀γὰρ",
          {
            "noteId": 172
          },
          "διὰ βρῶμα ὁ ἀδελφός σου λυπεῖται, οὐκέτι κατὰ ἀγάπην περιπατεῖς. μὴ τῷ βρώματί σου ἐκεῖνον ἀπόλλυε ὑπὲρ οὗ Χριστὸς ἀπέθανεν."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "μὴ βλασφημείσθω οὖν ὑμῶν τὸ ἀγαθόν."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "οὐ γάρ ἐστιν ἡ βασιλεία τοῦ θεοῦ βρῶσις καὶ πόσις, ἀλλὰ δικαιοσύνη καὶ εἰρήνη καὶ χαρὰ ἐν πνεύματι ἁγίῳ·"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ὁ γὰρ ἐν ⸀τούτῳ",
          {
            "noteId": 173
          },
          "δουλεύων τῷ Χριστῷ εὐάρεστος τῷ θεῷ καὶ δόκιμος τοῖς ἀνθρώποις."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἄρα οὖν τὰ τῆς εἰρήνης διώκωμεν καὶ τὰ τῆς οἰκοδομῆς τῆς εἰς ἀλλήλους."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "μὴ ἕνεκεν βρώματος κατάλυε τὸ ἔργον τοῦ θεοῦ. πάντα μὲν καθαρά, ἀλλὰ κακὸν τῷ ἀνθρώπῳ τῷ διὰ προσκόμματος ἐσθίοντι."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "καλὸν τὸ μὴ φαγεῖν κρέα μηδὲ πιεῖν οἶνον μηδὲ ἐν ᾧ ὁ ἀδελφός σου προσκόπτει ⸂ἢ σκανδαλίζεται ἢ ἀσθενεῖ",
          {
            "noteId": 174
          },
          "·"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "σὺ πίστιν ⸀ἣν",
          {
            "noteId": 175
          },
          "ἔχεις κατὰ σεαυτὸν ἔχε ἐνώπιον τοῦ θεοῦ. μακάριος ὁ μὴ κρίνων ἑαυτὸν ἐν ᾧ δοκιμάζει·"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ὁ δὲ διακρινόμενος ἐὰν φάγῃ κατακέκριται, ὅτι οὐκ ἐκ πίστεως· πᾶν δὲ ὃ οὐκ ἐκ πίστεως ἁμαρτία ⸀ἐστίν",
          {
            "noteId": 176
          }
        ]
      }
    ],
