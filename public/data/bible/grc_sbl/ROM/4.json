  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Τί οὖν ἐροῦμεν ⸀εὑρηκέναι",
          {
            "noteId": 37
          },
          "Ἀβραὰμ τὸν ⸀προπάτορα",
          {
            "noteId": 38
          },
          "⸀ἡμῶν",
          {
            "noteId": 39
          },
          "κατὰ σάρκα;"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "εἰ γὰρ Ἀβραὰμ ἐξ ἔργων ἐδικαιώθη, ἔχει καύχημα· ἀλλʼ οὐ ⸀πρὸς",
          {
            "noteId": 40
          },
          "θεόν,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "τί γὰρ ἡ γραφὴ λέγει; Ἐπίστευσεν δὲ Ἀβραὰμ τῷ θεῷ καὶ ἐλογίσθη αὐτῷ εἰς δικαιοσύνην."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "τῷ δὲ ἐργαζομένῳ ὁ μισθὸς οὐ λογίζεται κατὰ χάριν ἀλλὰ κατὰ ὀφείλημα·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "τῷ δὲ μὴ ἐργαζομένῳ, πιστεύοντι δὲ ἐπὶ τὸν δικαιοῦντα τὸν ἀσεβῆ, λογίζεται ἡ πίστις αὐτοῦ εἰς δικαιοσύνην,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καθάπερ καὶ Δαυὶδ λέγει τὸν μακαρισμὸν τοῦ ἀνθρώπου ᾧ ὁ θεὸς λογίζεται δικαιοσύνην χωρὶς ἔργων·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Μακάριοι ὧν ἀφέθησαν αἱ ἀνομίαι καὶ ὧν ἐπεκαλύφθησαν αἱ ἁμαρτίαι,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "μακάριος ἀνὴρ ⸀οὗ",
          {
            "noteId": 41
          },
          "οὐ μὴ λογίσηται κύριος ἁμαρτίαν."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Ὁ μακαρισμὸς οὖν οὗτος ἐπὶ τὴν περιτομὴν ἢ καὶ ἐπὶ τὴν ἀκροβυστίαν; λέγομεν ⸀γάρ",
          {
            "noteId": 42
          },
          "Ἐλογίσθη τῷ Ἀβραὰμ ἡ πίστις εἰς δικαιοσύνην."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "πῶς οὖν ἐλογίσθη; ἐν περιτομῇ ὄντι ἢ ἐν ἀκροβυστίᾳ; οὐκ ἐν περιτομῇ ἀλλʼ ἐν ἀκροβυστίᾳ·"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ σημεῖον ἔλαβεν περιτομῆς, σφραγῖδα τῆς δικαιοσύνης τῆς πίστεως τῆς ἐν τῇ ἀκροβυστίᾳ, εἰς τὸ εἶναι αὐτὸν πατέρα πάντων τῶν πιστευόντων διʼ ἀκροβυστίας, εἰς τὸ ⸀λογισθῆναι",
          {
            "noteId": 43
          },
          "αὐτοῖς τὴν δικαιοσύνην,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "καὶ πατέρα περιτομῆς τοῖς οὐκ ἐκ περιτομῆς μόνον ἀλλὰ καὶ τοῖς στοιχοῦσιν τοῖς ἴχνεσιν τῆς ⸂ἐν ἀκροβυστίᾳ πίστεως",
          {
            "noteId": 44
          },
          "τοῦ πατρὸς ἡμῶν Ἀβραάμ."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Οὐ γὰρ διὰ νόμου ἡ ἐπαγγελία τῷ Ἀβραὰμ ἢ τῷ σπέρματι αὐτοῦ, τὸ κληρονόμον αὐτὸν ⸀εἶναι",
          {
            "noteId": 45
          },
          "κόσμου, ἀλλὰ διὰ δικαιοσύνης πίστεως·"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "εἰ γὰρ οἱ ἐκ νόμου κληρονόμοι, κεκένωται ἡ πίστις καὶ κατήργηται ἡ ἐπαγγελία·"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ὁ γὰρ νόμος ὀργὴν κατεργάζεται, οὗ ⸀δὲ",
          {
            "noteId": 46
          },
          "οὐκ ἔστιν νόμος, οὐδὲ παράβασις."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Διὰ τοῦτο ἐκ πίστεως, ἵνα κατὰ χάριν, εἰς τὸ εἶναι βεβαίαν τὴν ἐπαγγελίαν παντὶ τῷ σπέρματι, οὐ τῷ ἐκ τοῦ νόμου μόνον ἀλλὰ καὶ τῷ ἐκ πίστεως Ἀβραάμ (ὅς ἐστιν πατὴρ πάντων ἡμῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καθὼς γέγραπται ὅτι Πατέρα πολλῶν ἐθνῶν τέθεικά σε), κατέναντι οὗ ἐπίστευσεν θεοῦ τοῦ ζῳοποιοῦντος τοὺς νεκροὺς καὶ καλοῦντος τὰ μὴ ὄντα ὡς ὄντα·"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ὃς παρʼ ἐλπίδα ἐπʼ ἐλπίδι ἐπίστευσεν εἰς τὸ γενέσθαι αὐτὸν πατέρα πολλῶν ἐθνῶν κατὰ τὸ εἰρημένον· Οὕτως ἔσται τὸ σπέρμα σου·"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "καὶ μὴ ἀσθενήσας τῇ ⸀πίστει",
          {
            "noteId": 47
          },
          "κατενόησεν τὸ ἑαυτοῦ ⸀σῶμα",
          {
            "noteId": 48
          },
          "νενεκρωμένον, ἑκατονταετής που ὑπάρχων, καὶ τὴν νέκρωσιν τῆς μήτρας Σάρρας,"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "εἰς δὲ τὴν ἐπαγγελίαν τοῦ θεοῦ οὐ διεκρίθη τῇ ἀπιστίᾳ ἀλλὰ ἐνεδυναμώθη τῇ πίστει, δοὺς δόξαν τῷ θεῷ"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "καὶ πληροφορηθεὶς ὅτι ὃ ἐπήγγελται δυνατός ἐστιν καὶ ποιῆσαι."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "⸀διὸ",
          {
            "noteId": 49
          },
          "ἐλογίσθη αὐτῷ εἰς δικαιοσύνην."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Οὐκ ἐγράφη δὲ διʼ αὐτὸν μόνον ὅτι ἐλογίσθη αὐτῷ,"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ἀλλὰ καὶ διʼ ἡμᾶς οἷς μέλλει λογίζεσθαι, τοῖς πιστεύουσιν ἐπὶ τὸν ἐγείραντα Ἰησοῦν τὸν κύριον ἡμῶν ἐκ νεκρῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ὃς παρεδόθη διὰ τὰ παραπτώματα ἡμῶν καὶ ἠγέρθη διὰ τὴν δικαίωσιν ἡμῶν."
        ]
      }
    ],
