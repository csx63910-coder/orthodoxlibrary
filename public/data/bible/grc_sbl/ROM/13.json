  "chapter": {
    "number": 13,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Πᾶσα ψυχὴ ἐξουσίαις ὑπερεχούσαις ὑποτασσέσθω, οὐ γὰρ ἔστιν ἐξουσία εἰ μὴ ὑπὸ θεοῦ, αἱ δὲ ⸀οὖσαι",
          {
            "noteId": 149
          },
          "⸀ὑπὸ",
          {
            "noteId": 150
          },
          "θεοῦ τεταγμέναι εἰσίν."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ὥστε ὁ ἀντιτασσόμενος τῇ ἐξουσίᾳ τῇ τοῦ θεοῦ διαταγῇ ἀνθέστηκεν, οἱ δὲ ἀνθεστηκότες ἑαυτοῖς κρίμα λήμψονται."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "οἱ γὰρ ἄρχοντες οὐκ εἰσὶν φόβος ⸂τῷ ἀγαθῷ ἔργῳ",
          {
            "noteId": 151
          },
          "ἀλλὰ ⸂τῷ κακῷ",
          {
            "noteId": 152
          },
          ". θέλεις δὲ μὴ φοβεῖσθαι τὴν ἐξουσίαν; τὸ ἀγαθὸν ποίει, καὶ ἕξεις ἔπαινον ἐξ αὐτῆς·"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "θεοῦ γὰρ διάκονός ἐστιν σοὶ εἰς τὸ ἀγαθόν. ἐὰν δὲ τὸ κακὸν ποιῇς, φοβοῦ· οὐ γὰρ εἰκῇ τὴν μάχαιραν φορεῖ· θεοῦ γὰρ διάκονός ἐστιν, ἔκδικος εἰς ὀργὴν τῷ τὸ κακὸν πράσσοντι."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "διὸ ἀνάγκη ὑποτάσσεσθαι, οὐ μόνον διὰ τὴν ὀργὴν ἀλλὰ καὶ διὰ τὴν συνείδησιν,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "διὰ τοῦτο γὰρ καὶ φόρους τελεῖτε, λειτουργοὶ γὰρ θεοῦ εἰσιν εἰς αὐτὸ τοῦτο προσκαρτεροῦντες."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "⸀ἀπόδοτε",
          {
            "noteId": 153
          },
          "πᾶσι τὰς ὀφειλάς, τῷ τὸν φόρον τὸν φόρον, τῷ τὸ τέλος τὸ τέλος, τῷ τὸν φόβον τὸν φόβον, τῷ τὴν τιμὴν τὴν τιμήν."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Μηδενὶ μηδὲν ὀφείλετε, εἰ μὴ τὸ ⸂ἀλλήλους ἀγαπᾶν",
          {
            "noteId": 154
          },
          "· ὁ γὰρ ἀγαπῶν τὸν ἕτερον νόμον πεπλήρωκεν."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "τὸ γάρ· Οὐ μοιχεύσεις, Οὐ φονεύσεις, Οὐ κλέψεις, Οὐκ ἐπιθυμήσεις, καὶ εἴ τις ἑτέρα ἐντολή, ἐν ⸂τῷ λόγῳ τούτῳ",
          {
            "noteId": 155
          },
          "ἀνακεφαλαιοῦται, ⸂ἐν τῷ",
          {
            "noteId": 156
          },
          "· Ἀγαπήσεις τὸν πλησίον σου ὡς σεαυτόν."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἡ ἀγάπη τῷ πλησίον κακὸν οὐκ ἐργάζεται· πλήρωμα οὖν νόμου ἡ ἀγάπη."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Καὶ τοῦτο εἰδότες τὸν καιρόν, ὅτι ὥρα ⸂ἤδη ὑμᾶς",
          {
            "noteId": 157
          },
          "ἐξ ὕπνου ἐγερθῆναι, νῦν γὰρ ἐγγύτερον ἡμῶν ἡ σωτηρία ἢ ὅτε ἐπιστεύσαμεν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ἡ νὺξ προέκοψεν, ἡ δὲ ἡμέρα ἤγγικεν. ⸀ἀποβαλώμεθα",
          {
            "noteId": 158
          },
          "οὖν τὰ ἔργα τοῦ σκότους, ⸂ἐνδυσώμεθα δὲ",
          {
            "noteId": 159
          },
          "τὰ ὅπλα τοῦ φωτός."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ὡς ἐν ἡμέρᾳ εὐσχημόνως περιπατήσωμεν, μὴ κώμοις καὶ μέθαις, μὴ κοίταις καὶ ἀσελγείαις, μὴ ἔριδι καὶ ζήλῳ,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἀλλὰ ἐνδύσασθε τὸν κύριον Ἰησοῦν Χριστόν, καὶ τῆς σαρκὸς πρόνοιαν μὴ ποιεῖσθε εἰς ἐπιθυμίας."
        ]
      }
    ],
