  "chapter": {
    "number": 10,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἀδελφοί, ἡ μὲν εὐδοκία τῆς ἐμῆς καρδίας καὶ ἡ ⸀δέησις",
          {
            "noteId": 102
          },
          "πρὸς τὸν θεὸν ὑπὲρ ⸀αὐτῶν",
          {
            "noteId": 103
          },
          "εἰς σωτηρίαν."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "μαρτυρῶ γὰρ αὐτοῖς ὅτι ζῆλον θεοῦ ἔχουσιν· ἀλλʼ οὐ κατʼ ἐπίγνωσιν,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἀγνοοῦντες γὰρ τὴν τοῦ θεοῦ δικαιοσύνην, καὶ τὴν ⸀ἰδίαν",
          {
            "noteId": 104
          },
          "ζητοῦντες στῆσαι, τῇ δικαιοσύνῃ τοῦ θεοῦ οὐχ ὑπετάγησαν·"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "τέλος γὰρ νόμου Χριστὸς εἰς δικαιοσύνην παντὶ τῷ πιστεύοντι."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Μωϋσῆς γὰρ γράφει ⸂ὅτι τὴν δικαιοσύνην τὴν ἐκ ⸀τοῦ νόμου",
          {
            "noteId": 105
          },
          "ὁ ⸀ποιήσας ἄνθρωπος ζήσεται ἐν ⸀αὐτῇ.",
          {
            "noteId": 106
          },
          {
            "noteId": 107
          },
          {
            "noteId": 108
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἡ δὲ ἐκ πίστεως δικαιοσύνη οὕτως λέγει· Μὴ εἴπῃς ἐν τῇ καρδίᾳ σου· Τίς ἀναβήσεται εἰς τὸν οὐρανόν; τοῦτʼ ἔστιν Χριστὸν καταγαγεῖν·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἤ· Τίς καταβήσεται εἰς τὴν ἄβυσσον; τοῦτʼ ἔστιν Χριστὸν ἐκ νεκρῶν ἀναγαγεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἀλλὰ τί λέγει; Ἐγγύς σου τὸ ῥῆμά ἐστιν, ἐν τῷ στόματί σου καὶ ἐν τῇ καρδίᾳ σου, τοῦτʼ ἔστιν τὸ ῥῆμα τῆς πίστεως ὃ κηρύσσομεν."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ὅτι ἐὰν ⸀ὁμολογήσῃς",
          {
            "noteId": 109
          },
          "ἐν τῷ στόματί ⸀σου",
          {
            "noteId": 110
          },
          "κύριον Ἰησοῦν, καὶ πιστεύσῃς ἐν τῇ καρδίᾳ σου ὅτι ὁ θεὸς αὐτὸν ἤγειρεν ἐκ νεκρῶν, σωθήσῃ·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καρδίᾳ γὰρ πιστεύεται εἰς δικαιοσύνην, στόματι δὲ ὁμολογεῖται εἰς σωτηρίαν·"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "λέγει γὰρ ἡ γραφή· Πᾶς ὁ πιστεύων ἐπʼ αὐτῷ οὐ καταισχυνθήσεται."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "οὐ γάρ ἐστιν διαστολὴ Ἰουδαίου τε καὶ Ἕλληνος, ὁ γὰρ αὐτὸς κύριος πάντων, πλουτῶν εἰς πάντας τοὺς ἐπικαλουμένους αὐτόν·"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Πᾶς γὰρ ὃς ἂν ἐπικαλέσηται τὸ ὄνομα κυρίου σωθήσεται."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Πῶς οὖν ⸀ἐπικαλέσωνται",
          {
            "noteId": 111
          },
          "εἰς ὃν οὐκ ἐπίστευσαν; πῶς δὲ ⸀πιστεύσωσιν",
          {
            "noteId": 112
          },
          "οὗ οὐκ ἤκουσαν; πῶς δὲ ⸀ἀκούσωσιν",
          {
            "noteId": 113
          },
          "χωρὶς κηρύσσοντος;"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "πῶς δὲ ⸀κηρύξωσιν",
          {
            "noteId": 114
          },
          "ἐὰν μὴ ἀποσταλῶσιν; ⸀καθὼς",
          {
            "noteId": 115
          },
          "γέγραπται· Ὡς ὡραῖοι οἱ πόδες τῶν ⸀εὐαγγελιζομένων",
          {
            "noteId": 116
          },
          "⸀τὰ",
          {
            "noteId": 117
          },
          "ἀγαθά."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ἀλλʼ οὐ πάντες ὑπήκουσαν τῷ εὐαγγελίῳ· Ἠσαΐας γὰρ λέγει· Κύριε, τίς ἐπίστευσεν τῇ ἀκοῇ ἡμῶν;"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ἄρα ἡ πίστις ἐξ ἀκοῆς, ἡ δὲ ἀκοὴ διὰ ῥήματος ⸀Χριστοῦ",
          {
            "noteId": 118
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Ἀλλὰ λέγω, μὴ οὐκ ἤκουσαν; μενοῦνγε· Εἰς πᾶσαν τὴν γῆν ἐξῆλθεν ὁ φθόγγος αὐτῶν, καὶ εἰς τὰ πέρατα τῆς οἰκουμένης τὰ ῥήματα αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἀλλὰ λέγω, μὴ ⸂Ἰσραὴλ οὐκ ἔγνω",
          {
            "noteId": 119
          },
          "; πρῶτος Μωϋσῆς λέγει· Ἐγὼ παραζηλώσω ὑμᾶς ἐπʼ οὐκ ἔθνει, ἐπʼ ἔθνει ἀσυνέτῳ παροργιῶ ὑμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Ἠσαΐας δὲ ἀποτολμᾷ καὶ λέγει· Εὑρέθην ⸀ἐν",
          {
            "noteId": 120
          },
          "τοῖς ἐμὲ μὴ ζητοῦσιν, ἐμφανὴς ⸀ἐγενόμην",
          {
            "noteId": 121
          },
          "τοῖς ἐμὲ μὴ ἐπερωτῶσιν."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "πρὸς δὲ τὸν Ἰσραὴλ λέγει· Ὅλην τὴν ἡμέραν ἐξεπέτασα τὰς χεῖράς μου πρὸς λαὸν ἀπειθοῦντα καὶ ἀντιλέγοντα."
        ]
      }
    ],
