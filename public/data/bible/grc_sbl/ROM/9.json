  "chapter": {
    "number": 9,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἀλήθειαν λέγω ἐν Χριστῷ, οὐ ψεύδομαι, συμμαρτυρούσης μοι τῆς συνειδήσεώς μου ἐν πνεύματι ἁγίῳ,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ὅτι λύπη μοί ἐστιν μεγάλη καὶ ἀδιάλειπτος ὀδύνη τῇ καρδίᾳ μου·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ηὐχόμην γὰρ ⸂ἀνάθεμα εἶναι αὐτὸς ἐγὼ",
          {
            "noteId": 87
          },
          "ἀπὸ τοῦ Χριστοῦ ὑπὲρ τῶν ἀδελφῶν μου τῶν συγγενῶν μου κατὰ σάρκα,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "οἵτινές εἰσιν Ἰσραηλῖται, ὧν ἡ υἱοθεσία καὶ ἡ δόξα καὶ αἱ διαθῆκαι καὶ ἡ νομοθεσία καὶ ἡ λατρεία καὶ αἱ ἐπαγγελίαι,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ὧν οἱ πατέρες, καὶ ἐξ ὧν ὁ χριστὸς τὸ κατὰ σάρκα, ὁ ὢν ἐπὶ πάντων, θεὸς εὐλογητὸς εἰς τοὺς αἰῶνας· ἀμήν."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Οὐχ οἷον δὲ ὅτι ἐκπέπτωκεν ὁ λόγος τοῦ θεοῦ. οὐ γὰρ πάντες οἱ ἐξ Ἰσραήλ, οὗτοι Ἰσραήλ·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "οὐδʼ ὅτι εἰσὶν σπέρμα Ἀβραάμ, πάντες τέκνα, ἀλλʼ· Ἐν Ἰσαὰκ κληθήσεταί σοι σπέρμα."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "τοῦτʼ ἔστιν, οὐ τὰ τέκνα τῆς σαρκὸς ταῦτα τέκνα τοῦ θεοῦ, ἀλλὰ τὰ τέκνα τῆς ἐπαγγελίας λογίζεται εἰς σπέρμα·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ἐπαγγελίας γὰρ ὁ λόγος οὗτος· Κατὰ τὸν καιρὸν τοῦτον ἐλεύσομαι καὶ ἔσται τῇ Σάρρᾳ υἱός."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "οὐ μόνον δέ, ἀλλὰ καὶ Ῥεβέκκα ἐξ ἑνὸς κοίτην ἔχουσα, Ἰσαὰκ τοῦ πατρὸς ἡμῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "μήπω γὰρ γεννηθέντων μηδὲ πραξάντων τι ἀγαθὸν ἢ ⸀φαῦλον",
          {
            "noteId": 88
          },
          "ἵνα ἡ κατʼ ἐκλογὴν πρόθεσις τοῦ θεοῦ μένῃ,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "οὐκ ἐξ ἔργων ἀλλʼ ἐκ τοῦ καλοῦντος, ἐρρέθη αὐτῇ ὅτι Ὁ μείζων δουλεύσει τῷ ἐλάσσονι·"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "⸀καθὼς",
          {
            "noteId": 89
          },
          "γέγραπται· Τὸν Ἰακὼβ ἠγάπησα, τὸν δὲ Ἠσαῦ ἐμίσησα."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Τί οὖν ἐροῦμεν; μὴ ἀδικία παρὰ τῷ θεῷ; μὴ γένοιτο·"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "τῷ ⸂Μωϋσεῖ γὰρ",
          {
            "noteId": 90
          },
          "λέγει· Ἐλεήσω ὃν ἂν ἐλεῶ, καὶ οἰκτιρήσω ὃν ἂν οἰκτίρω."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ἄρα οὖν οὐ τοῦ θέλοντος οὐδὲ τοῦ τρέχοντος ἀλλὰ τοῦ ἐλεῶντος θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "λέγει γὰρ ἡ γραφὴ τῷ Φαραὼ ὅτι Εἰς αὐτὸ τοῦτο ἐξήγειρά σε ὅπως ἐνδείξωμαι ἐν σοὶ τὴν δύναμίν μου, καὶ ὅπως διαγγελῇ τὸ ὄνομά μου ἐν πάσῃ τῇ γῇ."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ἄρα οὖν ὃν θέλει ἐλεεῖ, ὃν δὲ θέλει σκληρύνει."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Ἐρεῖς ⸂μοι οὖν",
          {
            "noteId": 91
          },
          "· Τί ⸀οὖν",
          {
            "noteId": 92
          },
          "ἔτι μέμφεται; τῷ γὰρ βουλήματι αὐτοῦ τίς ἀνθέστηκεν;"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "⸂ὦ ἄνθρωπε, μενοῦνγε⸃ σὺ τίς εἶ ὁ ἀνταποκρινόμενος τῷ θεῷ; μὴ ἐρεῖ τὸ πλάσμα τῷ πλάσαντι Τί με ἐποίησας οὕτως;",
          {
            "noteId": 93
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ἢ οὐκ ἔχει ἐξουσίαν ὁ κεραμεὺς τοῦ πηλοῦ ἐκ τοῦ αὐτοῦ φυράματος ποιῆσαι ὃ μὲν εἰς τιμὴν σκεῦος ὃ δὲ εἰς ἀτιμίαν;"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "εἰ δὲ θέλων ὁ θεὸς ἐνδείξασθαι τὴν ὀργὴν καὶ γνωρίσαι τὸ δυνατὸν αὐτοῦ ἤνεγκεν ἐν πολλῇ μακροθυμίᾳ σκεύη ὀργῆς κατηρτισμένα εἰς ἀπώλειαν,"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "⸀καὶ",
          {
            "noteId": 94
          },
          "ἵνα γνωρίσῃ τὸν πλοῦτον τῆς δόξης αὐτοῦ ἐπὶ σκεύη ἐλέους, ἃ προητοίμασεν εἰς δόξαν,"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "οὓς καὶ ἐκάλεσεν ἡμᾶς οὐ μόνον ἐξ Ἰουδαίων ἀλλὰ καὶ ἐξ ἐθνῶν;—"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ὡς καὶ ἐν τῷ Ὡσηὲ λέγει· Καλέσω τὸν οὐ λαόν μου λαόν μου καὶ τὴν οὐκ ἠγαπημένην ἠγαπημένην·"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "καὶ ἔσται ἐν τῷ τόπῳ οὗ ἐρρέθη ⸀αὐτοῖς",
          {
            "noteId": 95
          },
          "Οὐ λαός μου ὑμεῖς, ἐκεῖ κληθήσονται υἱοὶ θεοῦ ζῶντος."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Ἠσαΐας δὲ κράζει ὑπὲρ τοῦ Ἰσραήλ· Ἐὰν ᾖ ὁ ἀριθμὸς τῶν υἱῶν Ἰσραὴλ ὡς ἡ ἄμμος τῆς θαλάσσης, τὸ ⸀ὑπόλειμμα",
          {
            "noteId": 96
          },
          "σωθήσεται·"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "λόγον γὰρ συντελῶν καὶ ⸀συντέμνων",
          {
            "noteId": 97
          },
          "ποιήσει κύριος ἐπὶ τῆς γῆς."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "καὶ καθὼς προείρηκεν Ἠσαΐας· Εἰ μὴ κύριος Σαβαὼθ ἐγκατέλιπεν ἡμῖν σπέρμα, ὡς Σόδομα ἂν ἐγενήθημεν καὶ ὡς Γόμορρα ἂν ὡμοιώθημεν."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Τί οὖν ἐροῦμεν; ὅτι ἔθνη τὰ μὴ διώκοντα δικαιοσύνην κατέλαβεν δικαιοσύνην, δικαιοσύνην δὲ τὴν ἐκ πίστεως·"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "Ἰσραὴλ δὲ διώκων νόμον",
          {
            "noteId": 98
          },
          "δικαιοσύνης εἰς ⸀νόμον οὐκ ἔφθασεν."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "διὰ τί; ὅτι οὐκ ἐκ πίστεως ἀλλʼ ὡς ἐξ ⸀ἔργων",
          {
            "noteId": 99
          },
          "⸀προσέκοψαν",
          {
            "noteId": 100
          },
          "τῷ λίθῳ τοῦ προσκόμματος,"
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "καθὼς γέγραπται· Ἰδοὺ τίθημι ἐν Σιὼν λίθον προσκόμματος καὶ",
          {
            "noteId": 101
          },
          "πέτραν σκανδάλου, ⸀καὶ ὁ πιστεύων ἐπʼ αὐτῷ οὐ καταισχυνθήσεται."
        ]
      }
    ],
