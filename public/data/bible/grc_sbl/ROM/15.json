  "chapter": {
    "number": 15,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ὀφείλομεν δὲ ἡμεῖς οἱ δυνατοὶ τὰ ἀσθενήματα τῶν ἀδυνάτων βαστάζειν, καὶ μὴ ἑαυτοῖς ἀρέσκειν."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἕκαστος ἡμῶν τῷ πλησίον ἀρεσκέτω εἰς τὸ ἀγαθὸν πρὸς οἰκοδομήν·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ γὰρ ὁ Χριστὸς οὐχ ἑαυτῷ ἤρεσεν· ἀλλὰ καθὼς γέγραπται· Οἱ ὀνειδισμοὶ τῶν ὀνειδιζόντων σε ἐπέπεσαν ἐπʼ ἐμέ."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ὅσα γὰρ προεγράφη, ⸀εἰς",
          {
            "noteId": 177
          },
          "τὴν ἡμετέραν διδασκαλίαν ⸀ἐγράφη",
          {
            "noteId": 178
          },
          "ἵνα διὰ τῆς ὑπομονῆς καὶ διὰ τῆς παρακλήσεως τῶν γραφῶν τὴν ἐλπίδα ἔχωμεν."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ὁ δὲ θεὸς τῆς ὑπομονῆς καὶ τῆς παρακλήσεως δῴη ὑμῖν τὸ αὐτὸ φρονεῖν ἐν ἀλλήλοις κατὰ ⸂Χριστὸν Ἰησοῦν",
          {
            "noteId": 179
          },
          ","
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἵνα ὁμοθυμαδὸν ἐν ἑνὶ στόματι δοξάζητε τὸν θεὸν καὶ πατέρα τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Διὸ προσλαμβάνεσθε ἀλλήλους, καθὼς καὶ ὁ Χριστὸς προσελάβετο ⸀ὑμᾶς",
          {
            "noteId": 180
          },
          "εἰς δόξαν ⸀τοῦ",
          {
            "noteId": 181
          },
          "θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "λέγω ⸀γὰρ",
          {
            "noteId": 182
          },
          "⸀Χριστὸν",
          {
            "noteId": 183
          },
          "διάκονον ⸀γεγενῆσθαι",
          {
            "noteId": 184
          },
          "περιτομῆς ὑπὲρ ἀληθείας θεοῦ, εἰς τὸ βεβαιῶσαι τὰς ἐπαγγελίας τῶν πατέρων,"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "τὰ δὲ ἔθνη ὑπὲρ ἐλέους δοξάσαι τὸν θεόν· καθὼς γέγραπται· Διὰ τοῦτο ἐξομολογήσομαί σοι ἐν ἔθνεσι, καὶ τῷ ὀνόματί σου ψαλῶ."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ πάλιν λέγει· Εὐφράνθητε, ἔθνη, μετὰ τοῦ λαοῦ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ πάλιν· Αἰνεῖτε, ⸂πάντα τὰ ἔθνη, τὸν κύριον⸃, καὶ ⸀ἐπαινεσάτωσαν αὐτὸν πάντες οἱ λαοί.",
          {
            "noteId": 185
          },
          {
            "noteId": 186
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "καὶ πάλιν Ἠσαΐας λέγει· Ἔσται ἡ ῥίζα τοῦ Ἰεσσαί, καὶ ὁ ἀνιστάμενος ἄρχειν ἐθνῶν· ἐπʼ αὐτῷ ἔθνη ἐλπιοῦσιν."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ὁ δὲ θεὸς τῆς ἐλπίδος πληρώσαι ὑμᾶς πάσης χαρᾶς καὶ εἰρήνης ἐν τῷ πιστεύειν, εἰς τὸ περισσεύειν ὑμᾶς ἐν τῇ ἐλπίδι ἐν δυνάμει πνεύματος ἁγίου."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Πέπεισμαι δέ, ἀδελφοί μου, καὶ αὐτὸς ἐγὼ περὶ ὑμῶν, ὅτι καὶ αὐτοὶ μεστοί ἐστε ἀγαθωσύνης, πεπληρωμένοι ⸀πάσης",
          {
            "noteId": 187
          },
          "γνώσεως, δυνάμενοι καὶ ⸀ἀλλήλους",
          {
            "noteId": 188
          },
          "νουθετεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "⸀τολμηρότερον",
          {
            "noteId": 189
          },
          "δὲ ἔγραψα ⸀ὑμῖν",
          {
            "noteId": 190
          },
          "ἀπὸ μέρους, ὡς ἐπαναμιμνῄσκων ὑμᾶς, διὰ τὴν χάριν τὴν δοθεῖσάν μοι ⸀ὑπὸ",
          {
            "noteId": 191
          },
          "τοῦ θεοῦ"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "εἰς τὸ εἶναί με λειτουργὸν ⸂Χριστοῦ Ἰησοῦ",
          {
            "noteId": 192
          },
          "εἰς τὰ ἔθνη, ἱερουργοῦντα τὸ εὐαγγέλιον τοῦ θεοῦ, ἵνα γένηται ἡ προσφορὰ τῶν ἐθνῶν εὐπρόσδεκτος, ἡγιασμένη ἐν πνεύματι ἁγίῳ."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ἔχω οὖν ⸀τὴν",
          {
            "noteId": 193
          },
          "καύχησιν ἐν Χριστῷ Ἰησοῦ τὰ πρὸς τὸν θεόν·"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "οὐ γὰρ τολμήσω ⸂τι λαλεῖν",
          {
            "noteId": 194
          },
          "ὧν οὐ κατειργάσατο Χριστὸς διʼ ἐμοῦ εἰς ὑπακοὴν ἐθνῶν, λόγῳ καὶ ἔργῳ,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἐν δυνάμει σημείων καὶ τεράτων, ἐν δυνάμει ⸀πνεύματος",
          {
            "noteId": 195
          },
          "ὥστε με ἀπὸ Ἰερουσαλὴμ καὶ κύκλῳ μέχρι τοῦ Ἰλλυρικοῦ πεπληρωκέναι τὸ εὐαγγέλιον τοῦ Χριστοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "οὕτως δὲ ⸀φιλοτιμούμενον",
          {
            "noteId": 196
          },
          "εὐαγγελίζεσθαι οὐχ ὅπου ὠνομάσθη Χριστός, ἵνα μὴ ἐπʼ ἀλλότριον θεμέλιον οἰκοδομῶ,"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ἀλλὰ καθὼς γέγραπται· ⸂Οἷς οὐκ ἀνηγγέλη περὶ αὐτοῦ ὄψονται",
          {
            "noteId": 197
          },
          ", καὶ οἳ οὐκ ἀκηκόασιν συνήσουσιν."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Διὸ καὶ ἐνεκοπτόμην τὰ πολλὰ τοῦ ἐλθεῖν πρὸς ὑμᾶς·"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "νυνὶ δὲ μηκέτι τόπον ἔχων ἐν τοῖς κλίμασι τούτοις, ἐπιποθίαν δὲ ἔχων τοῦ ἐλθεῖν πρὸς ὑμᾶς ἀπὸ ⸀ἱκανῶν",
          {
            "noteId": 198
          },
          "ἐτῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ὡς ⸀ἂν",
          {
            "noteId": 199
          },
          "πορεύωμαι εἰς τὴν ⸀Σπανίαν",
          {
            "noteId": 200
          },
          "ἐλπίζω γὰρ διαπορευόμενος θεάσασθαι ὑμᾶς καὶ ὑφʼ ὑμῶν προπεμφθῆναι ἐκεῖ ἐὰν ὑμῶν πρῶτον ἀπὸ μέρους ἐμπλησθῶ—"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "νυνὶ δὲ πορεύομαι εἰς Ἰερουσαλὴμ διακονῶν τοῖς ἁγίοις."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "εὐδόκησαν γὰρ Μακεδονία καὶ Ἀχαΐα κοινωνίαν τινὰ ποιήσασθαι εἰς τοὺς πτωχοὺς τῶν ἁγίων τῶν ἐν Ἰερουσαλήμ."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "εὐδόκησαν γάρ, καὶ ὀφειλέται ⸂εἰσὶν αὐτῶν",
          {
            "noteId": 201
          },
          "· εἰ γὰρ τοῖς πνευματικοῖς αὐτῶν ἐκοινώνησαν τὰ ἔθνη, ὀφείλουσιν καὶ ἐν τοῖς σαρκικοῖς λειτουργῆσαι αὐτοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "τοῦτο οὖν ἐπιτελέσας, καὶ σφραγισάμενος αὐτοῖς τὸν καρπὸν τοῦτον, ἀπελεύσομαι διʼ ὑμῶν ⸀εἰς",
          {
            "noteId": 202
          },
          "Σπανίαν·"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "οἶδα δὲ ὅτι ἐρχόμενος πρὸς ὑμᾶς ἐν πληρώματι ⸀εὐλογίας",
          {
            "noteId": 203
          },
          "Χριστοῦ ἐλεύσομαι."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Παρακαλῶ δὲ ὑμᾶς, ἀδελφοί, διὰ τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ καὶ διὰ τῆς ἀγάπης τοῦ πνεύματος συναγωνίσασθαί μοι ἐν ταῖς προσευχαῖς ὑπὲρ ἐμοῦ πρὸς τὸν θεόν,"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "ἵνα ῥυσθῶ ἀπὸ τῶν ἀπειθούντων ἐν τῇ Ἰουδαίᾳ ⸀καὶ",
          {
            "noteId": 204
          },
          "ἡ διακονία μου ἡ εἰς Ἰερουσαλὴμ εὐπρόσδεκτος ⸂τοῖς ἁγίοις γένηται",
          {
            "noteId": 205
          },
          ","
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "ἵνα ἐν χαρᾷ ⸀ἐλθὼν",
          {
            "noteId": 206
          },
          "πρὸς ὑμᾶς διὰ θελήματος ⸀θεοῦ",
          {
            "noteId": 207
          },
          "συναναπαύσωμαι ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "ὁ δὲ θεὸς τῆς εἰρήνης μετὰ πάντων ὑμῶν· ἀμήν."
        ]
      }
    ],
