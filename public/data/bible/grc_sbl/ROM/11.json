  "chapter": {
    "number": 11,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Λέγω οὖν, μὴ ἀπώσατο ὁ θεὸς τὸν λαὸν αὐτοῦ; μὴ γένοιτο· καὶ γὰρ ἐγὼ Ἰσραηλίτης εἰμί, ἐκ σπέρματος Ἀβραάμ, φυλῆς Βενιαμίν."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "οὐκ ἀπώσατο ὁ θεὸς τὸν λαὸν αὐτοῦ ὃν προέγνω. ἢ οὐκ οἴδατε ἐν Ἠλίᾳ τί λέγει ἡ γραφή, ὡς ἐντυγχάνει τῷ θεῷ κατὰ τοῦ ⸀Ἰσραήλ",
          {
            "noteId": 122
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Κύριε, τοὺς προφήτας σου ἀπέκτειναν, ⸀τὰ",
          {
            "noteId": 123
          },
          "θυσιαστήριά σου κατέσκαψαν, κἀγὼ ὑπελείφθην μόνος, καὶ ζητοῦσιν τὴν ψυχήν μου."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἀλλὰ τί λέγει αὐτῷ ὁ χρηματισμός; Κατέλιπον ἐμαυτῷ ἑπτακισχιλίους ἄνδρας, οἵτινες οὐκ ἔκαμψαν γόνυ τῇ Βάαλ."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "οὕτως οὖν καὶ ἐν τῷ νῦν καιρῷ λεῖμμα κατʼ ἐκλογὴν χάριτος γέγονεν·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "εἰ δὲ χάριτι, οὐκέτι ἐξ ἔργων, ἐπεὶ ἡ χάρις",
          {
            "noteId": 124
          },
          "οὐκέτι γίνεται ⸀χάρις."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "τί οὖν; ὃ ἐπιζητεῖ Ἰσραήλ, τοῦτο οὐκ ἐπέτυχεν, ἡ δὲ ἐκλογὴ ἐπέτυχεν· οἱ δὲ λοιποὶ ἐπωρώθησαν,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "⸀καθὼς",
          {
            "noteId": 125
          },
          "γέγραπται· Ἔδωκεν αὐτοῖς ὁ θεὸς πνεῦμα κατανύξεως, ὀφθαλμοὺς τοῦ μὴ βλέπειν καὶ ὦτα τοῦ μὴ ἀκούειν, ἕως τῆς σήμερον ἡμέρας."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ Δαυὶδ λέγει· Γενηθήτω ἡ τράπεζα αὐτῶν εἰς παγίδα καὶ εἰς θήραν καὶ εἰς σκάνδαλον καὶ εἰς ἀνταπόδομα αὐτοῖς,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "σκοτισθήτωσαν οἱ ὀφθαλμοὶ αὐτῶν τοῦ μὴ βλέπειν, καὶ τὸν νῶτον αὐτῶν διὰ παντὸς σύγκαμψον."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Λέγω οὖν, μὴ ἔπταισαν ἵνα πέσωσιν; μὴ γένοιτο· ἀλλὰ τῷ αὐτῶν παραπτώματι ἡ σωτηρία τοῖς ἔθνεσιν, εἰς τὸ παραζηλῶσαι αὐτούς."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "εἰ δὲ τὸ παράπτωμα αὐτῶν πλοῦτος κόσμου καὶ τὸ ἥττημα αὐτῶν πλοῦτος ἐθνῶν, πόσῳ μᾶλλον τὸ πλήρωμα αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ὑμῖν ⸀δὲ",
          {
            "noteId": 126
          },
          "λέγω τοῖς ἔθνεσιν. ἐφʼ ὅσον μὲν ⸀οὖν",
          {
            "noteId": 127
          },
          "εἰμι ἐγὼ ἐθνῶν ἀπόστολος, τὴν διακονίαν μου δοξάζω,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "εἴ πως παραζηλώσω μου τὴν σάρκα καὶ σώσω τινὰς ἐξ αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "εἰ γὰρ ἡ ἀποβολὴ αὐτῶν καταλλαγὴ κόσμου, τίς ἡ πρόσλημψις εἰ μὴ ζωὴ ἐκ νεκρῶν;"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "εἰ δὲ ἡ ἀπαρχὴ ἁγία, καὶ τὸ φύραμα· καὶ εἰ ἡ ῥίζα ἁγία, καὶ οἱ κλάδοι."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Εἰ δέ τινες τῶν κλάδων ἐξεκλάσθησαν, σὺ δὲ ἀγριέλαιος ὢν ἐνεκεντρίσθης ἐν αὐτοῖς καὶ συγκοινωνὸς τῆς ⸀ῥίζης",
          {
            "noteId": 128
          },
          "τῆς πιότητος τῆς ἐλαίας ἐγένου,"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "μὴ κατακαυχῶ τῶν κλάδων· εἰ δὲ κατακαυχᾶσαι, οὐ σὺ τὴν ῥίζαν βαστάζεις ἀλλὰ ἡ ῥίζα σέ."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἐρεῖς οὖν· Ἐξεκλάσθησαν κλάδοι ἵνα ἐγὼ ἐγκεντρισθῶ."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "καλῶς· τῇ ἀπιστίᾳ ἐξεκλάσθησαν, σὺ δὲ τῇ πίστει ἕστηκας. μὴ ⸂ὑψηλὰ φρόνει",
          {
            "noteId": 129
          },
          ", ἀλλὰ φοβοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "εἰ γὰρ ὁ θεὸς τῶν κατὰ φύσιν κλάδων οὐκ ἐφείσατο, ⸀οὐδὲ",
          {
            "noteId": 130
          },
          "σοῦ φείσεται."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ἴδε οὖν χρηστότητα καὶ ἀποτομία",
          {
            "noteId": 131
          },
          "θεοῦ· ἐπὶ μὲν τοὺς πεσόντας ⸀ἀποτομία, ἐπὶ δὲ σὲ ⸂χρηστότης θεοῦ",
          {
            "noteId": 132
          },
          ", ἐὰν ⸀ἐπιμένῃς",
          {
            "noteId": 133
          },
          "τῇ χρηστότητι, ἐπεὶ καὶ σὺ ἐκκοπήσῃ."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "κἀκεῖνοι δέ, ἐὰν μὴ ⸀ἐπιμένωσι",
          {
            "noteId": 134
          },
          "τῇ ἀπιστίᾳ, ἐγκεντρισθήσονται· δυνατὸς γάρ ⸂ἐστιν ὁ θεὸς",
          {
            "noteId": 135
          },
          "πάλιν ἐγκεντρίσαι αὐτούς."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "εἰ γὰρ σὺ ἐκ τῆς κατὰ φύσιν ἐξεκόπης ἀγριελαίου καὶ παρὰ φύσιν ἐνεκεντρίσθης εἰς καλλιέλαιον, πόσῳ μᾶλλον οὗτοι οἱ κατὰ φύσιν ἐγκεντρισθήσονται τῇ ἰδίᾳ ἐλαίᾳ."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Οὐ γὰρ θέλω ὑμᾶς ἀγνοεῖν, ἀδελφοί, τὸ μυστήριον τοῦτο, ἵνα μὴ ⸀ἦτε",
          {
            "noteId": 136
          },
          "ἑαυτοῖς φρόνιμοι, ὅτι πώρωσις ἀπὸ μέρους τῷ Ἰσραὴλ γέγονεν ἄχρι οὗ τὸ πλήρωμα τῶν ἐθνῶν εἰσέλθῃ,"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "καὶ οὕτως πᾶς Ἰσραὴλ σωθήσεται· καθὼς γέγραπται· Ἥξει ἐκ Σιὼν ὁ ⸀ῥυόμενος",
          {
            "noteId": 137
          },
          "ἀποστρέψει ἀσεβείας ἀπὸ Ἰακώβ."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "καὶ αὕτη αὐτοῖς ἡ παρʼ ἐμοῦ διαθήκη, ὅταν ἀφέλωμαι τὰς ἁμαρτίας αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "κατὰ μὲν τὸ εὐαγγέλιον ἐχθροὶ διʼ ὑμᾶς, κατὰ δὲ τὴν ἐκλογὴν ἀγαπητοὶ διὰ τοὺς πατέρας·"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "ἀμεταμέλητα γὰρ τὰ χαρίσματα καὶ ἡ κλῆσις τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ὥσπερ ⸀γὰρ",
          {
            "noteId": 138
          },
          "ὑμεῖς ποτε ἠπειθήσατε τῷ θεῷ, νῦν δὲ ἠλεήθητε τῇ τούτων ἀπειθείᾳ,"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "οὕτως καὶ οὗτοι νῦν",
          {
            "noteId": 139
          },
          "ἠπείθησαν τῷ ὑμετέρῳ ἐλέει ἵνα καὶ αὐτοὶ ⸀νῦν ἐλεηθῶσιν·"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "συνέκλεισεν γὰρ ὁ θεὸς τοὺς πάντας εἰς ἀπείθειαν ἵνα τοὺς πάντας ἐλεήσῃ."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "Ὦ βάθος πλούτου καὶ σοφίας καὶ γνώσεως θεοῦ· ὡς ἀνεξεραύνητα τὰ κρίματα αὐτοῦ καὶ ἀνεξιχνίαστοι αἱ ὁδοὶ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "Τίς γὰρ ἔγνω νοῦν κυρίου; ἢ τίς σύμβουλος αὐτοῦ ἐγένετο;"
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "ἢ τίς προέδωκεν αὐτῷ, καὶ ἀνταποδοθήσεται αὐτῷ;"
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "ὅτι ἐξ αὐτοῦ καὶ διʼ αὐτοῦ καὶ εἰς αὐτὸν τὰ πάντα· αὐτῷ ἡ δόξα εἰς τοὺς αἰῶνας, ἀμήν."
        ]
      }
    ],
