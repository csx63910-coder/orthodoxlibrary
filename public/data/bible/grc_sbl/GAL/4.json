  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Λέγω δέ, ἐφʼ ὅσον χρόνον ὁ κληρονόμος νήπιός ἐστιν, οὐδὲν διαφέρει δούλου κύριος πάντων ὤν,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἀλλὰ ὑπὸ ἐπιτρόπους ἐστὶ καὶ οἰκονόμους ἄχρι τῆς προθεσμίας τοῦ πατρός."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "οὕτως καὶ ἡμεῖς, ὅτε ἦμεν νήπιοι, ὑπὸ τὰ στοιχεῖα τοῦ κόσμου ⸀ἤμεθα",
          {
            "noteId": 41
          },
          "δεδουλωμένοι·"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ὅτε δὲ ἦλθεν τὸ πλήρωμα τοῦ χρόνου, ἐξαπέστειλεν ὁ θεὸς τὸν υἱὸν αὐτοῦ, γενόμενον ἐκ γυναικός, γενόμενον ὑπὸ νόμον,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἵνα τοὺς ὑπὸ νόμον ἐξαγοράσῃ, ἵνα τὴν υἱοθεσίαν ἀπολάβωμεν."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ὅτι δέ ἐστε υἱοί, ἐξαπέστειλεν ὁ θεὸς τὸ πνεῦμα τοῦ υἱοῦ αὐτοῦ εἰς τὰς καρδίας ⸀ἡμῶν",
          {
            "noteId": 42
          },
          "κρᾶζον· Αββα ὁ πατήρ."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ὥστε οὐκέτι εἶ δοῦλος ἀλλὰ υἱός· εἰ δὲ υἱός, καὶ κληρονόμος ⸂διὰ θεοῦ",
          {
            "noteId": 43
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Ἀλλὰ τότε μὲν οὐκ εἰδότες θεὸν ἐδουλεύσατε τοῖς ⸂φύσει μὴ",
          {
            "noteId": 44
          },
          "οὖσι θεοῖς·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "νῦν δὲ γνόντες θεόν, μᾶλλον δὲ γνωσθέντες ὑπὸ θεοῦ, πῶς ἐπιστρέφετε πάλιν ἐπὶ τὰ ἀσθενῆ καὶ πτωχὰ στοιχεῖα, οἷς πάλιν ἄνωθεν ⸀δουλεύειν",
          {
            "noteId": 45
          },
          "θέλετε;"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἡμέρας παρατηρεῖσθε καὶ μῆνας καὶ καιροὺς καὶ ἐνιαυτούς."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "φοβοῦμαι ὑμᾶς μή πως εἰκῇ κεκοπίακα εἰς ὑμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Γίνεσθε ὡς ἐγώ, ὅτι κἀγὼ ὡς ὑμεῖς, ἀδελφοί, δέομαι ὑμῶν. οὐδέν με ἠδικήσατε·"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "οἴδατε δὲ ὅτι διʼ ἀσθένειαν τῆς σαρκὸς εὐηγγελισάμην ὑμῖν τὸ πρότερον,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καὶ τὸν πειρασμὸν ⸀ὑμῶν",
          {
            "noteId": 46
          },
          "ἐν τῇ σαρκί μου οὐκ ἐξουθενήσατε οὐδὲ ἐξεπτύσατε, ἀλλὰ ὡς ἄγγελον θεοῦ ἐδέξασθέ με, ὡς Χριστὸν Ἰησοῦν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "⸀ποῦ",
          {
            "noteId": 47
          },
          "⸀οὖν",
          {
            "noteId": 48
          },
          "ὁ μακαρισμὸς ὑμῶν; μαρτυρῶ γὰρ ὑμῖν ὅτι εἰ δυνατὸν τοὺς ὀφθαλμοὺς ὑμῶν ⸀ἐξορύξαντες",
          {
            "noteId": 49
          },
          "ἐδώκατέ μοι."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ὥστε ἐχθρὸς ὑμῶν γέγονα ἀληθεύων ὑμῖν;"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ζηλοῦσιν ὑμᾶς οὐ καλῶς, ἀλλὰ ἐκκλεῖσαι ὑμᾶς θέλουσιν, ἵνα αὐτοὺς ζηλοῦτε."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καλὸν ⸀δὲ",
          {
            "noteId": 50
          },
          "ζηλοῦσθαι ἐν καλῷ πάντοτε, καὶ μὴ μόνον ἐν τῷ παρεῖναί με πρὸς ὑμᾶς,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "⸀τέκνα",
          {
            "noteId": 51
          },
          "μου, οὓς πάλιν ὠδίνω ⸀μέχρις",
          {
            "noteId": 52
          },
          "οὗ μορφωθῇ Χριστὸς ἐν ὑμῖν·"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἤθελον δὲ παρεῖναι πρὸς ὑμᾶς ἄρτι, καὶ ἀλλάξαι τὴν φωνήν μου, ὅτι ἀποροῦμαι ἐν ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Λέγετέ μοι, οἱ ὑπὸ νόμον θέλοντες εἶναι, τὸν νόμον οὐκ ἀκούετε;"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "γέγραπται γὰρ ὅτι Ἀβραὰμ δύο υἱοὺς ἔσχεν, ἕνα ἐκ τῆς παιδίσκης καὶ ἕνα ἐκ τῆς ἐλευθέρας·"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ἀλλʼ ὁ μὲν ἐκ τῆς παιδίσκης κατὰ σάρκα γεγέννηται, ὁ δὲ ἐκ τῆς ἐλευθέρας ⸀διʼ",
          {
            "noteId": 53
          },
          "ἐπαγγελίας."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ἅτινά ἐστιν ἀλληγορούμενα· αὗται γάρ εἰσιν δύο διαθῆκαι, μία μὲν ἀπὸ ὄρους Σινᾶ, εἰς δουλείαν γεννῶσα, ἥτις ἐστὶν Ἁγάρ,"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "τὸ ⸀δὲ",
          {
            "noteId": 54
          },
          "Ἁγὰρ",
          {
            "noteId": 55
          },
          "Σινᾶ ὄρος ἐστὶν ἐν τῇ Ἀραβίᾳ, συστοιχεῖ δὲ τῇ νῦν Ἰερουσαλήμ, δουλεύει ⸀γὰρ μετὰ τῶν τέκνων αὐτῆς·"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ἡ δὲ ἄνω Ἰερουσαλὴμ ἐλευθέρα ἐστίν, ἥτις ἐστὶν ⸀μήτηρ",
          {
            "noteId": 56
          },
          "ἡμῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "γέγραπται γάρ· Εὐφράνθητι, στεῖρα ἡ οὐ τίκτουσα, ῥῆξον καὶ βόησον, ἡ οὐκ ὠδίνουσα· ὅτι πολλὰ τὰ τέκνα τῆς ἐρήμου μᾶλλον ἢ τῆς ἐχούσης τὸν ἄνδρα."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "⸂ὑμεῖς δέ, ἀδελφοί, κατὰ Ἰσαὰκ ἐπαγγελίας τέκνα ἐστέ",
          {
            "noteId": 57
          },
          "·"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "ἀλλʼ ὥσπερ τότε ὁ κατὰ σάρκα γεννηθεὶς ἐδίωκε τὸν κατὰ πνεῦμα, οὕτως καὶ νῦν."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ἀλλὰ τί λέγει ἡ γραφή; Ἔκβαλε τὴν παιδίσκην καὶ τὸν υἱὸν αὐτῆς, οὐ γὰρ μὴ ⸀κληρονομήσει",
          {
            "noteId": 58
          },
          "ὁ υἱὸς τῆς παιδίσκης μετὰ τοῦ υἱοῦ τῆς ἐλευθέρας."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "⸀διό",
          {
            "noteId": 59
          },
          "ἀδελφοί, οὐκ ἐσμὲν παιδίσκης τέκνα ἀλλὰ τῆς ἐλευθέρας."
        ]
      }
    ],
