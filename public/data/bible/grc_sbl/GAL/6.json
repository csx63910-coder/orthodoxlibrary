  "chapter": {
    "number": 6,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἀδελφοί, ἐὰν καὶ προλημφθῇ ἄνθρωπος ἔν τινι παραπτώματι, ὑμεῖς οἱ πνευματικοὶ καταρτίζετε τὸν τοιοῦτον ἐν πνεύματι πραΰτητος, σκοπῶν σεαυτόν, μὴ καὶ σὺ πειρασθῇς."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἀλλήλων τὰ βάρη βαστάζετε, καὶ οὕτως ⸀ἀναπληρώσετε",
          {
            "noteId": 74
          },
          "τὸν νόμον τοῦ Χριστοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "εἰ γὰρ δοκεῖ τις εἶναί τι μηδὲν ὤν, ⸂φρεναπατᾷ ἑαυτόν",
          {
            "noteId": 75
          },
          "·"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "τὸ δὲ ἔργον ἑαυτοῦ δοκιμαζέτω ἕκαστος, καὶ τότε εἰς ἑαυτὸν μόνον τὸ καύχημα ἕξει καὶ οὐκ εἰς τὸν ἕτερον,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἕκαστος γὰρ τὸ ἴδιον φορτίον βαστάσει."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Κοινωνείτω δὲ ὁ κατηχούμενος τὸν λόγον τῷ κατηχοῦντι ἐν πᾶσιν ἀγαθοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "μὴ πλανᾶσθε, θεὸς οὐ μυκτηρίζεται· ὃ γὰρ ⸀ἐὰν",
          {
            "noteId": 76
          },
          "σπείρῃ ἄνθρωπος, τοῦτο καὶ θερίσει·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ὅτι ὁ σπείρων εἰς τὴν σάρκα ἑαυτοῦ ἐκ τῆς σαρκὸς θερίσει φθοράν, ὁ δὲ σπείρων εἰς τὸ πνεῦμα ἐκ τοῦ πνεύματος θερίσει ζωὴν αἰώνιον."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "τὸ δὲ καλὸν ποιοῦντες μὴ ⸀ἐγκακῶμεν",
          {
            "noteId": 77
          },
          "καιρῷ γὰρ ἰδίῳ θερίσομεν μὴ ἐκλυόμενοι."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἄρα οὖν ὡς καιρὸν ⸀ἔχομεν",
          {
            "noteId": 78
          },
          "ἐργαζώμεθα τὸ ἀγαθὸν πρὸς πάντας, μάλιστα δὲ πρὸς τοὺς οἰκείους τῆς πίστεως."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ἴδετε πηλίκοις ὑμῖν γράμμασιν ἔγραψα τῇ ἐμῇ χειρί."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ὅσοι θέλουσιν εὐπροσωπῆσαι ἐν σαρκί, οὗτοι ἀναγκάζουσιν ὑμᾶς περιτέμνεσθαι, μόνον ⸀ἵνα",
          {
            "noteId": 79
          },
          "τῷ σταυρῷ τοῦ ⸀Χριστοῦ",
          {
            "noteId": 80
          },
          "⸀μὴ",
          {
            "noteId": 81
          },
          "διώκωνται·"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "οὐδὲ γὰρ οἱ ⸀περιτεμνόμενοι",
          {
            "noteId": 82
          },
          "αὐτοὶ νόμον φυλάσσουσιν, ἀλλὰ θέλουσιν ὑμᾶς περιτέμνεσθαι ἵνα ἐν τῇ ὑμετέρᾳ σαρκὶ καυχήσωνται."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἐμοὶ δὲ μὴ γένοιτο καυχᾶσθαι εἰ μὴ ἐν τῷ σταυρῷ τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ, διʼ οὗ ἐμοὶ κόσμος ἐσταύρωται ⸀κἀγὼ",
          {
            "noteId": 83
          },
          "κόσμῳ."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "⸂οὔτε γὰρ",
          {
            "noteId": 84
          },
          "περιτομή τί ⸀ἐστιν",
          {
            "noteId": 85
          },
          "οὔτε ἀκροβυστία, ἀλλὰ καινὴ κτίσις."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ ὅσοι τῷ κανόνι τούτῳ στοιχήσουσιν, εἰρήνη ἐπʼ αὐτοὺς καὶ ἔλεος, καὶ ἐπὶ τὸν Ἰσραὴλ τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Τοῦ λοιποῦ κόπους μοι μηδεὶς παρεχέτω, ἐγὼ γὰρ τὰ στίγματα ⸀τοῦ",
          {
            "noteId": 86
          },
          "Ἰησοῦ ἐν τῷ σώματί μου βαστάζω."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Ἡ χάρις τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ μετὰ τοῦ πνεύματος ὑμῶν, ἀδελφοί· ἀμήν. ‘p /’ ‘/book’"
        ]
      }
    ],
