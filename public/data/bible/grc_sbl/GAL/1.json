  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Παῦλος ἀπόστολος, οὐκ ἀπʼ ἀνθρώπων οὐδὲ διʼ ἀνθρώπου ἀλλὰ διὰ Ἰησοῦ Χριστοῦ καὶ θεοῦ πατρὸς τοῦ ἐγείραντος αὐτὸν ἐκ νεκρῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ οἱ σὺν ἐμοὶ πάντες ἀδελφοί, ταῖς ἐκκλησίαις τῆς Γαλατίας·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "χάρις ὑμῖν καὶ εἰρήνη ἀπὸ θεοῦ πατρὸς ⸂καὶ κυρίου ἡμῶν",
          {
            "noteId": 0
          },
          "Ἰησοῦ Χριστοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "τοῦ δόντος ἑαυτὸν ⸀ὑπὲρ",
          {
            "noteId": 1
          },
          "τῶν ἁμαρτιῶν ἡμῶν ὅπως ἐξέληται ἡμᾶς ἐκ τοῦ ⸂αἰῶνος τοῦ ἐνεστῶτος",
          {
            "noteId": 2
          },
          "πονηροῦ κατὰ τὸ θέλημα τοῦ θεοῦ καὶ πατρὸς ἡμῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ᾧ ἡ δόξα εἰς τοὺς αἰῶνας τῶν αἰώνων· ἀμήν."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Θαυμάζω ὅτι οὕτως ταχέως μετατίθεσθε ἀπὸ τοῦ καλέσαντος ὑμᾶς ἐν χάριτι Χριστοῦ εἰς ἕτερον εὐαγγέλιον,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ὃ οὐκ ἔστιν ἄλλο· εἰ μή τινές εἰσιν οἱ ταράσσοντες ὑμᾶς καὶ θέλοντες μεταστρέψαι τὸ εὐαγγέλιον τοῦ Χριστοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἀλλὰ καὶ ἐὰν ἡμεῖς ἢ ἄγγελος ἐξ οὐρανοῦ ⸀εὐαγγελίζηται",
          {
            "noteId": 3
          },
          "⸀ὑμῖν",
          {
            "noteId": 4
          },
          "παρʼ ὃ εὐηγγελισάμεθα ὑμῖν, ἀνάθεμα ἔστω."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ὡς προειρήκαμεν, καὶ ἄρτι πάλιν λέγω, εἴ τις ὑμᾶς εὐαγγελίζεται παρʼ ὃ παρελάβετε, ἀνάθεμα ἔστω."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Ἄρτι γὰρ ἀνθρώπους πείθω ἢ τὸν θεόν; ἢ ζητῶ ἀνθρώποις ἀρέσκειν; ⸀εἰ",
          {
            "noteId": 5
          },
          "ἔτι ἀνθρώποις ἤρεσκον, Χριστοῦ δοῦλος οὐκ ἂν ἤμην."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Γνωρίζω ⸀γὰρ",
          {
            "noteId": 6
          },
          "ὑμῖν, ἀδελφοί, τὸ εὐαγγέλιον τὸ εὐαγγελισθὲν ὑπʼ ἐμοῦ ὅτι οὐκ ἔστιν κατὰ ἄνθρωπον·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "οὐδὲ γὰρ ἐγὼ παρὰ ἀνθρώπου παρέλαβον αὐτό, ⸀οὔτε",
          {
            "noteId": 7
          },
          "ἐδιδάχθην, ἀλλὰ διʼ ἀποκαλύψεως Ἰησοῦ Χριστοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ἠκούσατε γὰρ τὴν ἐμὴν ἀναστροφήν ποτε ἐν τῷ Ἰουδαϊσμῷ, ὅτι καθʼ ὑπερβολὴν ἐδίωκον τὴν ἐκκλησίαν τοῦ θεοῦ καὶ ἐπόρθουν αὐτήν,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καὶ προέκοπτον ἐν τῷ Ἰουδαϊσμῷ ὑπὲρ πολλοὺς συνηλικιώτας ἐν τῷ γένει μου, περισσοτέρως ζηλωτὴς ὑπάρχων τῶν πατρικῶν μου παραδόσεων."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ὅτε δὲ ⸀εὐδόκησεν",
          {
            "noteId": 8
          },
          "ὁ ἀφορίσας με ἐκ κοιλίας μητρός μου καὶ καλέσας διὰ τῆς χάριτος αὐτοῦ"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ἀποκαλύψαι τὸν υἱὸν αὐτοῦ ἐν ἐμοὶ ἵνα εὐαγγελίζωμαι αὐτὸν ἐν τοῖς ἔθνεσιν, εὐθέως οὐ προσανεθέμην σαρκὶ καὶ αἵματι,"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "οὐδὲ ἀνῆλθον εἰς Ἱεροσόλυμα πρὸς τοὺς πρὸ ἐμοῦ ἀποστόλους, ἀλλὰ ἀπῆλθον εἰς Ἀραβίαν, καὶ πάλιν ὑπέστρεψα εἰς Δαμασκόν."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Ἔπειτα μετὰ ⸂ἔτη τρία",
          {
            "noteId": 9
          },
          "ἀνῆλθον εἰς Ἱεροσόλυμα ἱστορῆσαι ⸀Κηφᾶν",
          {
            "noteId": 10
          },
          "καὶ ἐπέμεινα πρὸς αὐτὸν ἡμέρας δεκαπέντε·"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἕτερον δὲ τῶν ἀποστόλων οὐκ εἶδον, εἰ μὴ Ἰάκωβον τὸν ἀδελφὸν τοῦ κυρίου."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἃ δὲ γράφω ὑμῖν, ἰδοὺ ἐνώπιον τοῦ θεοῦ ὅτι οὐ ψεύδομαι."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ἔπειτα ἦλθον εἰς τὰ κλίματα τῆς Συρίας καὶ τῆς Κιλικίας."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ἤμην δὲ ἀγνοούμενος τῷ προσώπῳ ταῖς ἐκκλησίαις τῆς Ἰουδαίας ταῖς ἐν Χριστῷ,"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "μόνον δὲ ἀκούοντες ἦσαν ὅτι Ὁ διώκων ἡμᾶς ποτε νῦν εὐαγγελίζεται τὴν πίστιν ἥν ποτε ἐπόρθει,"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "καὶ ἐδόξαζον ἐν ἐμοὶ τὸν θεόν."
        ]
      }
    ],
