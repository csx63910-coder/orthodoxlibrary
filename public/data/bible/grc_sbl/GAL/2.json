  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἔπειτα διὰ δεκατεσσάρων ἐτῶν πάλιν ἀνέβην εἰς Ἱεροσόλυμα μετὰ Βαρναβᾶ συμπαραλαβὼν καὶ Τίτον·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἀνέβην δὲ κατὰ ἀποκάλυψιν· καὶ ἀνεθέμην αὐτοῖς τὸ εὐαγγέλιον ὃ κηρύσσω ἐν τοῖς ἔθνεσιν, κατʼ ἰδίαν δὲ τοῖς δοκοῦσιν, μή πως εἰς κενὸν τρέχω ἢ ἔδραμον."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἀλλʼ οὐδὲ Τίτος ὁ σὺν ἐμοί, Ἕλλην ὤν, ἠναγκάσθη περιτμηθῆναι·"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "διὰ δὲ τοὺς παρεισάκτους ψευδαδέλφους, οἵτινες παρεισῆλθον κατασκοπῆσαι τὴν ἐλευθερίαν ἡμῶν ἣν ἔχομεν ἐν Χριστῷ Ἰησοῦ, ἵνα ἡμᾶς ⸀καταδουλώσουσιν",
          {
            "noteId": 11
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "οἷς οὐδὲ πρὸς ὥραν εἴξαμεν τῇ ὑποταγῇ, ἵνα ἡ ἀλήθεια τοῦ εὐαγγελίου διαμείνῃ πρὸς ὑμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἀπὸ δὲ τῶν δοκούντων εἶναί τι— ὁποῖοί ποτε ἦσαν οὐδέν μοι διαφέρει· πρόσωπον ⸀θεὸς",
          {
            "noteId": 12
          },
          "ἀνθρώπου οὐ λαμβάνει— ἐμοὶ γὰρ οἱ δοκοῦντες οὐδὲν προσανέθεντο,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἀλλὰ τοὐναντίον ἰδόντες ὅτι πεπίστευμαι τὸ εὐαγγέλιον τῆς ἀκροβυστίας καθὼς Πέτρος τῆς περιτομῆς,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ὁ γὰρ ἐνεργήσας Πέτρῳ εἰς ἀποστολὴν τῆς περιτομῆς ἐνήργησεν καὶ ἐμοὶ εἰς τὰ ἔθνη,"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ γνόντες τὴν χάριν τὴν δοθεῖσάν μοι, Ἰάκωβος καὶ Κηφᾶς καὶ Ἰωάννης, οἱ δοκοῦντες στῦλοι εἶναι, δεξιὰς ἔδωκαν ἐμοὶ καὶ Βαρναβᾷ κοινωνίας, ἵνα ⸀ἡμεῖς",
          {
            "noteId": 13
          },
          "εἰς τὰ ἔθνη, αὐτοὶ δὲ εἰς τὴν περιτομήν·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "μόνον τῶν πτωχῶν ἵνα μνημονεύωμεν, ὃ καὶ ἐσπούδασα αὐτὸ τοῦτο ποιῆσαι."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ὅτε δὲ ἦλθεν ⸀Κηφᾶς",
          {
            "noteId": 14
          },
          "εἰς Ἀντιόχειαν, κατὰ πρόσωπον αὐτῷ ἀντέστην, ὅτι κατεγνωσμένος ἦν·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "πρὸ τοῦ γὰρ ἐλθεῖν τινας ἀπὸ Ἰακώβου μετὰ τῶν ἐθνῶν συνήσθιεν· ὅτε δὲ ⸀ἦλθον",
          {
            "noteId": 15
          },
          "ὑπέστελλεν καὶ ἀφώριζεν ἑαυτόν, φοβούμενος τοὺς ἐκ περιτομῆς."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ",
          {
            "noteId": 16
          },
          "συνυπεκρίθησαν αὐτῷ ⸀καὶ οἱ λοιποὶ Ἰουδαῖοι, ὥστε καὶ Βαρναβᾶς συναπήχθη αὐτῶν τῇ ὑποκρίσει."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἀλλʼ ὅτε εἶδον ὅτι οὐκ ὀρθοποδοῦσιν πρὸς τὴν ἀλήθειαν τοῦ εὐαγγελίου, εἶπον τῷ ⸀Κηφᾷ",
          {
            "noteId": 17
          },
          "ἔμπροσθεν πάντων· Εἰ σὺ Ἰουδαῖος ὑπάρχων ἐθνικῶς ⸂καὶ ⸀οὐκ Ἰουδαϊκῶς ζῇς",
          {
            "noteId": 18
          },
          ", ⸀πῶς τὰ ἔθνη ἀναγκάζεις Ἰουδαΐζειν;",
          {
            "noteId": 19
          },
          {
            "noteId": 20
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Ἡμεῖς φύσει Ἰουδαῖοι καὶ οὐκ ἐξ ἐθνῶν ἁμαρτωλοί,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "εἰδότες ⸀δὲ",
          {
            "noteId": 21
          },
          "ὅτι οὐ δικαιοῦται ἄνθρωπος ἐξ ἔργων νόμου ἐὰν μὴ διὰ πίστεως ⸂Ἰησοῦ Χριστοῦ",
          {
            "noteId": 22
          },
          ", καὶ ἡμεῖς εἰς Χριστὸν Ἰησοῦν ἐπιστεύσαμεν, ἵνα δικαιωθῶμεν ἐκ πίστεως Χριστοῦ καὶ οὐκ ἐξ ἔργων νόμου, ⸂ὅτι ἐξ ἔργων νόμου οὐ δικαιωθήσεται",
          {
            "noteId": 23
          },
          "πᾶσα σάρξ."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "εἰ δὲ ζητοῦντες δικαιωθῆναι ἐν Χριστῷ εὑρέθημεν καὶ αὐτοὶ ἁμαρτωλοί, ἆρα Χριστὸς ἁμαρτίας διάκονος; μὴ γένοιτο·"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "εἰ γὰρ ἃ κατέλυσα ταῦτα πάλιν οἰκοδομῶ, παραβάτην ἐμαυτὸν ⸀συνιστάνω",
          {
            "noteId": 24
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἐγὼ γὰρ διὰ νόμου νόμῳ ἀπέθανον ἵνα θεῷ ζήσω· Χριστῷ συνεσταύρωμαι·"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ζῶ δὲ οὐκέτι ἐγώ, ζῇ δὲ ἐν ἐμοὶ Χριστός· ὃ δὲ νῦν ζῶ ἐν σαρκί, ἐν πίστει ζῶ τῇ τοῦ ⸂υἱοῦ τοῦ θεοῦ",
          {
            "noteId": 25
          },
          "τοῦ ἀγαπήσαντός με καὶ παραδόντος ἑαυτὸν ὑπὲρ ἐμοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "οὐκ ἀθετῶ τὴν χάριν τοῦ θεοῦ· εἰ γὰρ διὰ νόμου δικαιοσύνη, ἄρα Χριστὸς δωρεὰν ἀπέθανεν."
        ]
      }
    ],
