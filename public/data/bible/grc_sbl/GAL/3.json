  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ὦ ἀνόητοι Γαλάται, τίς ὑμᾶς ⸀ἐβάσκανεν",
          {
            "noteId": 26
          },
          "οἷς κατʼ ὀφθαλμοὺς Ἰησοῦς Χριστὸς ⸀προεγράφη",
          {
            "noteId": 27
          },
          "ἐσταυρωμένος;"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "τοῦτο μόνον θέλω μαθεῖν ἀφʼ ὑμῶν, ἐξ ἔργων νόμου τὸ πνεῦμα ἐλάβετε ἢ ἐξ ἀκοῆς πίστεως;"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "οὕτως ἀνόητοί ἐστε; ἐναρξάμενοι πνεύματι νῦν σαρκὶ ἐπιτελεῖσθε;"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "τοσαῦτα ἐπάθετε εἰκῇ; εἴ γε καὶ εἰκῇ."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ὁ οὖν ἐπιχορηγῶν ὑμῖν τὸ πνεῦμα καὶ ἐνεργῶν δυνάμεις ἐν ὑμῖν ἐξ ἔργων νόμου ἢ ἐξ ἀκοῆς πίστεως;"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καθὼς Ἀβραὰμ ἐπίστευσεν τῷ θεῷ, καὶ ἐλογίσθη αὐτῷ εἰς δικαιοσύνην."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Γινώσκετε ἄρα ὅτι οἱ ἐκ πίστεως, οὗτοι ⸂υἱοί εἰσιν",
          {
            "noteId": 28
          },
          "Ἀβραάμ."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "προϊδοῦσα δὲ ἡ γραφὴ ὅτι ἐκ πίστεως δικαιοῖ τὰ ἔθνη ὁ θεὸς προευηγγελίσατο τῷ Ἀβραὰμ ὅτι Ἐνευλογηθήσονται ἐν σοὶ πάντα τὰ ἔθνη."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ὥστε οἱ ἐκ πίστεως εὐλογοῦνται σὺν τῷ πιστῷ Ἀβραάμ."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Ὅσοι γὰρ ἐξ ἔργων νόμου εἰσὶν ὑπὸ κατάραν εἰσίν, γέγραπται γὰρ ⸀ὅτι",
          {
            "noteId": 29
          },
          "Ἐπικατάρατος πᾶς ὃς οὐκ ⸀ἐμμένει",
          {
            "noteId": 30
          },
          "πᾶσιν τοῖς γεγραμμένοις ἐν τῷ βιβλίῳ τοῦ νόμου τοῦ ποιῆσαι αὐτά."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ὅτι δὲ ἐν νόμῳ οὐδεὶς δικαιοῦται παρὰ τῷ θεῷ δῆλον, ὅτι Ὁ δίκαιος ἐκ πίστεως ζήσεται,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ὁ δὲ νόμος οὐκ ἔστιν ἐκ πίστεως, ἀλλʼ· Ὁ ποιήσας ⸀αὐτὰ",
          {
            "noteId": 31
          },
          "ζήσεται ἐν αὐτοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Χριστὸς ἡμᾶς ἐξηγόρασεν ἐκ τῆς κατάρας τοῦ νόμου γενόμενος ὑπὲρ ἡμῶν κατάρα, ⸂ὅτι γέγραπται",
          {
            "noteId": 32
          },
          "· Ἐπικατάρατος πᾶς ὁ κρεμάμενος ἐπὶ ξύλου,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἵνα εἰς τὰ ἔθνη ἡ εὐλογία τοῦ Ἀβραὰμ γένηται ἐν ⸂Χριστῷ Ἰησοῦ",
          {
            "noteId": 33
          },
          ", ἵνα τὴν ἐπαγγελίαν τοῦ πνεύματος λάβωμεν διὰ τῆς πίστεως."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Ἀδελφοί, κατὰ ἄνθρωπον λέγω· ὅμως ἀνθρώπου κεκυρωμένην διαθήκην οὐδεὶς ἀθετεῖ ἢ ἐπιδιατάσσεται."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "τῷ δὲ Ἀβραὰμ ἐρρέθησαν αἱ ἐπαγγελίαι καὶ τῷ σπέρματι αὐτοῦ· οὐ λέγει· Καὶ τοῖς σπέρμασιν, ὡς ἐπὶ πολλῶν, ἀλλʼ ὡς ἐφʼ ἑνός· Καὶ τῷ σπέρματί σου, ὅς ἐστιν Χριστός."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "τοῦτο δὲ λέγω· διαθήκην προκεκυρωμένην ὑπὸ τοῦ ⸀θεοῦ",
          {
            "noteId": 34
          },
          "ὁ μετὰ ⸂τετρακόσια καὶ τριάκοντα ἔτη",
          {
            "noteId": 35
          },
          "γεγονὼς νόμος οὐκ ἀκυροῖ, εἰς τὸ καταργῆσαι τὴν ἐπαγγελίαν."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "εἰ γὰρ ἐκ νόμου ἡ κληρονομία, οὐκέτι ἐξ ἐπαγγελίας· τῷ δὲ Ἀβραὰμ διʼ ἐπαγγελίας κεχάρισται ὁ θεός."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Τί οὖν ὁ νόμος; τῶν παραβάσεων χάριν προσετέθη, ἄχρις ⸀οὗ",
          {
            "noteId": 36
          },
          "ἔλθῃ τὸ σπέρμα ᾧ ἐπήγγελται, διαταγεὶς διʼ ἀγγέλων ἐν χειρὶ μεσίτου·"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ὁ δὲ μεσίτης ἑνὸς οὐκ ἔστιν, ὁ δὲ θεὸς εἷς ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Ὁ οὖν νόμος κατὰ τῶν ἐπαγγελιῶν τοῦ θεοῦ; μὴ γένοιτο· εἰ γὰρ ἐδόθη νόμος ὁ δυνάμενος ζῳοποιῆσαι, ὄντως ⸂ἐκ νόμου ἂν",
          {
            "noteId": 37
          },
          "ἦν ἡ δικαιοσύνη."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ἀλλὰ συνέκλεισεν ἡ γραφὴ τὰ πάντα ὑπὸ ἁμαρτίαν ἵνα ἡ ἐπαγγελία ἐκ πίστεως Ἰησοῦ Χριστοῦ δοθῇ τοῖς πιστεύουσιν."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Πρὸ τοῦ δὲ ἐλθεῖν τὴν πίστιν ὑπὸ νόμον ἐφρουρούμεθα ⸀συγκλειόμενοι",
          {
            "noteId": 38
          },
          "εἰς τὴν μέλλουσαν πίστιν ἀποκαλυφθῆναι."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ὥστε ὁ νόμος παιδαγωγὸς ἡμῶν γέγονεν εἰς Χριστόν, ἵνα ἐκ πίστεως δικαιωθῶμεν·"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ἐλθούσης δὲ τῆς πίστεως οὐκέτι ὑπὸ παιδαγωγόν ἐσμεν."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "πάντες γὰρ υἱοὶ θεοῦ ἐστε διὰ τῆς πίστεως ἐν Χριστῷ Ἰησοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "ὅσοι γὰρ εἰς Χριστὸν ἐβαπτίσθητε, Χριστὸν ἐνεδύσασθε·"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "οὐκ ἔνι Ἰουδαῖος οὐδὲ Ἕλλην, οὐκ ἔνι δοῦλος οὐδὲ ἐλεύθερος, οὐκ ἔνι ἄρσεν καὶ θῆλυ· ⸀πάντες",
          {
            "noteId": 39
          },
          "γὰρ ὑμεῖς εἷς ἐστε ἐν Χριστῷ Ἰησοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "εἰ δὲ ὑμεῖς Χριστοῦ, ἄρα τοῦ Ἀβραὰμ σπέρμα ἐστέ, ⸀κατʼ",
          {
            "noteId": 40
          },
          "ἐπαγγελίαν κληρονόμοι."
        ]
      }
    ],
