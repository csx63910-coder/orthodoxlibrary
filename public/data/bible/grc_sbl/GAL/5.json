  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "τῇ ἐλευθερίᾳ ⸂ἡμᾶς Χριστὸς ἠλευθέρωσεν· στήκετε οὖν⸃ καὶ μὴ πάλιν ζυγῷ δουλείας ἐνέχεσθε.",
          {
            "noteId": 60
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Ἴδε ἐγὼ Παῦλος λέγω ὑμῖν ὅτι ἐὰν περιτέμνησθε Χριστὸς ὑμᾶς οὐδὲν ὠφελήσει."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "μαρτύρομαι δὲ πάλιν παντὶ ἀνθρώπῳ περιτεμνομένῳ ὅτι ὀφειλέτης ἐστὶν ὅλον τὸν νόμον ποιῆσαι."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "κατηργήθητε ⸀ἀπὸ",
          {
            "noteId": 61
          },
          "Χριστοῦ οἵτινες ἐν νόμῳ δικαιοῦσθε, τῆς χάριτος ἐξεπέσατε."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἡμεῖς γὰρ πνεύματι ἐκ πίστεως ἐλπίδα δικαιοσύνης ἀπεκδεχόμεθα."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἐν γὰρ Χριστῷ Ἰησοῦ οὔτε περιτομή τι ἰσχύει οὔτε ἀκροβυστία, ἀλλὰ πίστις διʼ ἀγάπης ἐνεργουμένη."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ἐτρέχετε καλῶς· τίς ὑμᾶς ἐνέκοψεν ⸀τῇ",
          {
            "noteId": 62
          },
          "ἀληθείᾳ μὴ πείθεσθαι;"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἡ πεισμονὴ οὐκ ἐκ τοῦ καλοῦντος ὑμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "μικρὰ ζύμη ὅλον τὸ φύραμα ζυμοῖ."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἐγὼ πέποιθα εἰς ὑμᾶς ἐν κυρίῳ ὅτι οὐδὲν ἄλλο φρονήσετε· ὁ δὲ ταράσσων ὑμᾶς βαστάσει τὸ κρίμα, ὅστις ⸀ἐὰν",
          {
            "noteId": 63
          },
          "ᾖ."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ἐγὼ δέ, ἀδελφοί, εἰ περιτομὴν ἔτι κηρύσσω, τί ἔτι διώκομαι; ἄρα κατήργηται τὸ σκάνδαλον τοῦ σταυροῦ."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ὄφελον καὶ ἀποκόψονται οἱ ἀναστατοῦντες ὑμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ὑμεῖς γὰρ ἐπʼ ἐλευθερίᾳ ἐκλήθητε, ἀδελφοί· μόνον μὴ τὴν ἐλευθερίαν εἰς ἀφορμὴν τῇ σαρκί, ἀλλὰ διὰ τῆς ἀγάπης δουλεύετε ἀλλήλοις·"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ὁ γὰρ πᾶς νόμος ἐν ἑνὶ λόγῳ ⸀πεπλήρωται",
          {
            "noteId": 64
          },
          "ἐν τῷ· Ἀγαπήσεις τὸν πλησίον σου ὡς ⸀σεαυτόν",
          {
            "noteId": 65
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "εἰ δὲ ἀλλήλους δάκνετε καὶ κατεσθίετε, βλέπετε μὴ ὑπʼ ἀλλήλων ἀναλωθῆτε."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Λέγω δέ, πνεύματι περιπατεῖτε καὶ ἐπιθυμίαν σαρκὸς οὐ μὴ τελέσητε."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ἡ γὰρ",
          {
            "noteId": 66
          },
          "σὰρξ ἐπιθυμεῖ κατὰ τοῦ πνεύματος, τὸ δὲ πνεῦμα κατὰ τῆς σαρκός, ταῦτα ⸀γὰρ ⸂ἀλλήλοις ἀντίκειται",
          {
            "noteId": 67
          },
          ", ἵνα μὴ ἃ ⸀ἐὰν",
          {
            "noteId": 68
          },
          "θέλητε ταῦτα ποιῆτε."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "εἰ δὲ πνεύματι ἄγεσθε, οὐκ ἐστὲ ὑπὸ νόμον."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "φανερὰ δέ ἐστιν",
          {
            "noteId": 69
          },
          "τὰ ἔργα τῆς σαρκός, ἅτινά ⸀ἐστιν πορνεία, ἀκαθαρσία, ἀσέλγεια,"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "εἰδωλολατρία, φαρμακεία, ἔχθραι, ⸂ἔρις, ζῆλος⸃, θυμοί, ἐριθεῖαι, διχοστασίαι, αἱρέσεις,",
          {
            "noteId": 70
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "⸀φθόνοι",
          {
            "noteId": 71
          },
          "μέθαι, κῶμοι, καὶ τὰ ὅμοια τούτοις, ἃ προλέγω ὑμῖν ⸀καθὼς",
          {
            "noteId": 72
          },
          "προεῖπον ὅτι οἱ τὰ τοιαῦτα πράσσοντες βασιλείαν θεοῦ οὐ κληρονομήσουσιν."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Ὁ δὲ καρπὸς τοῦ πνεύματός ἐστιν ἀγάπη, χαρά, εἰρήνη, μακροθυμία, χρηστότης, ἀγαθωσύνη, πίστις,"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "πραΰτης, ἐγκράτεια· κατὰ τῶν τοιούτων οὐκ ἔστιν νόμος."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "οἱ δὲ τοῦ ⸀Χριστοῦ",
          {
            "noteId": 73
          },
          "τὴν σάρκα ἐσταύρωσαν σὺν τοῖς παθήμασιν καὶ ταῖς ἐπιθυμίαις."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "εἰ ζῶμεν πνεύματι, πνεύματι καὶ στοιχῶμεν."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "μὴ γινώμεθα κενόδοξοι, ἀλλήλους προκαλούμενοι, ἀλλήλοις φθονοῦντες."
        ]
      }
    ],
