  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Τούτου χάριν ἐγὼ Παῦλος ὁ δέσμιος τοῦ Χριστοῦ Ἰησοῦ ὑπὲρ ὑμῶν τῶν ἐθνῶν—"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "εἴ γε ἠκούσατε τὴν οἰκονομίαν τῆς χάριτος τοῦ θεοῦ τῆς δοθείσης μοι εἰς ὑμᾶς·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "⸀κατὰ",
          {
            "noteId": 23
          },
          "ἀποκάλυψιν ⸀ἐγνωρίσθη",
          {
            "noteId": 24
          },
          "μοι τὸ μυστήριον, καθὼς προέγραψα ἐν ὀλίγῳ,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "πρὸς ὃ δύνασθε ἀναγινώσκοντες νοῆσαι τὴν σύνεσίν μου ἐν τῷ μυστηρίῳ τοῦ Χριστοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ὃ ἑτέραις γενεαῖς οὐκ ἐγνωρίσθη τοῖς υἱοῖς τῶν ἀνθρώπων ὡς νῦν ἀπεκαλύφθη τοῖς ἁγίοις ἀποστόλοις αὐτοῦ καὶ προφήταις ἐν πνεύματι,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "εἶναι τὰ ἔθνη συγκληρονόμα καὶ σύσσωμα καὶ συμμέτοχα τῆς ἐπαγγελίας ⸂ἐν Χριστῷ Ἰησοῦ",
          {
            "noteId": 25
          },
          "διὰ τοῦ εὐαγγελίου,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "οὗ ⸀ἐγενήθην",
          {
            "noteId": 26
          },
          "διάκονος κατὰ τὴν δωρεὰν τῆς χάριτος τοῦ θεοῦ ⸂τῆς δοθείσης",
          {
            "noteId": 27
          },
          "μοι κατὰ τὴν ἐνέργειαν τῆς δυνάμεως αὐτοῦ—"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἐμοὶ τῷ ἐλαχιστοτέρῳ πάντων ἁγίων ἐδόθη ἡ χάρις αὕτη— ⸀τοῖς",
          {
            "noteId": 28
          },
          "ἔθνεσιν εὐαγγελίσασθαι ⸂τὸ ἀνεξιχνίαστον πλοῦτος",
          {
            "noteId": 29
          },
          "τοῦ Χριστοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ φωτίσαι ⸀πάντας",
          {
            "noteId": 30
          },
          "τίς ἡ οἰκονομία τοῦ μυστηρίου τοῦ ἀποκεκρυμμένου ἀπὸ τῶν αἰώνων ἐν τῷ θεῷ τῷ τὰ πάντα ⸀κτίσαντι",
          {
            "noteId": 31
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἵνα γνωρισθῇ νῦν ταῖς ἀρχαῖς καὶ ταῖς ἐξουσίαις ἐν τοῖς ἐπουρανίοις διὰ τῆς ἐκκλησίας ἡ πολυποίκιλος σοφία τοῦ θεοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "κατὰ πρόθεσιν τῶν αἰώνων ἣν ἐποίησεν ἐν ⸀τῷ",
          {
            "noteId": 32
          },
          "Χριστῷ Ἰησοῦ τῷ κυρίῳ ἡμῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ἐν ᾧ ἔχομεν τὴν παρρησίαν ⸀καὶ",
          {
            "noteId": 33
          },
          "προσαγωγὴν ἐν πεποιθήσει διὰ τῆς πίστεως αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "διὸ αἰτοῦμαι μὴ ⸀ἐγκακεῖν",
          {
            "noteId": 34
          },
          "ἐν ταῖς θλίψεσίν μου ὑπὲρ ὑμῶν, ἥτις ἐστὶν δόξα ὑμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Τούτου χάριν κάμπτω τὰ γόνατά μου πρὸς τὸν ⸀πατέρα",
          {
            "noteId": 35
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ἐξ οὗ πᾶσα πατριὰ ἐν οὐρανοῖς καὶ ἐπὶ γῆς ὀνομάζεται,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ἵνα ⸀δῷ",
          {
            "noteId": 36
          },
          "ὑμῖν κατὰ ⸂τὸ πλοῦτος",
          {
            "noteId": 37
          },
          "τῆς δόξης αὐτοῦ δυνάμει κραταιωθῆναι διὰ τοῦ πνεύματος αὐτοῦ εἰς τὸν ἔσω ἄνθρωπον,"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "κατοικῆσαι τὸν Χριστὸν διὰ τῆς πίστεως ἐν ταῖς καρδίαις ὑμῶν ἐν ἀγάπῃ· ἐρριζωμένοι καὶ τεθεμελιωμένοι,"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ἵνα ἐξισχύσητε καταλαβέσθαι σὺν πᾶσιν τοῖς ἁγίοις τί τὸ πλάτος καὶ μῆκος καὶ ⸂ὕψος καὶ βάθος",
          {
            "noteId": 38
          },
          ","
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "γνῶναί τε τὴν ὑπερβάλλουσαν τῆς γνώσεως ἀγάπην τοῦ Χριστοῦ, ἵνα πληρωθῆτε εἰς πᾶν τὸ πλήρωμα τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Τῷ δὲ δυναμένῳ ὑπὲρ πάντα ποιῆσαι ὑπερεκπερισσοῦ ὧν αἰτούμεθα ἢ νοοῦμεν κατὰ τὴν δύναμιν τὴν ἐνεργουμένην ἐν ἡμῖν,"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "αὐτῷ ἡ δόξα ἐν τῇ ἐκκλησίᾳ ⸀καὶ",
          {
            "noteId": 39
          },
          "ἐν Χριστῷ Ἰησοῦ εἰς πάσας τὰς γενεὰς τοῦ αἰῶνος τῶν αἰώνων· ἀμήν."
        ]
      }
    ],
