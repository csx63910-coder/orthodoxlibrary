  "chapter": {
    "number": 6,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Τὰ τέκνα, ὑπακούετε τοῖς γονεῦσιν ὑμῶν ἐν κυρίῳ, τοῦτο γάρ ἐστιν δίκαιον·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "τίμα τὸν πατέρα σου καὶ τὴν μητέρα, ἥτις ἐστὶν ἐντολὴ πρώτη ἐν ἐπαγγελίᾳ,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἵνα εὖ σοι γένηται καὶ ἔσῃ μακροχρόνιος ἐπὶ τῆς γῆς."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Καὶ οἱ πατέρες, μὴ παροργίζετε τὰ τέκνα ὑμῶν, ἀλλὰ ἐκτρέφετε αὐτὰ ἐν παιδείᾳ καὶ νουθεσίᾳ κυρίου."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Οἱ δοῦλοι, ὑπακούετε τοῖς ⸂κατὰ σάρκα κυρίοις",
          {
            "noteId": 75
          },
          "μετὰ φόβου καὶ τρόμου ἐν ἁπλότητι τῆς καρδίας ὑμῶν ὡς τῷ Χριστῷ,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "μὴ κατʼ ὀφθαλμοδουλίαν ὡς ἀνθρωπάρεσκοι ἀλλʼ ὡς ⸀δοῦλοι",
          {
            "noteId": 76
          },
          "Χριστοῦ ποιοῦντες τὸ θέλημα τοῦ θεοῦ, ἐκ ψυχῆς"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "μετʼ εὐνοίας δουλεύοντες, ὡς τῷ κυρίῳ καὶ οὐκ ἀνθρώποις,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "εἰδότες ὅτι ⸂ἕκαστος, ὃ ἂν⸃ ποιήσῃ ἀγαθόν, τοῦτο ⸀κομίσεται ⸀παρὰ κυρίου, εἴτε δοῦλος εἴτε ἐλεύθερος.",
          {
            "noteId": 77
          },
          {
            "noteId": 78
          },
          {
            "noteId": 79
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Καὶ οἱ κύριοι, τὰ αὐτὰ ποιεῖτε πρὸς αὐτούς, ἀνιέντες τὴν ἀπειλήν, εἰδότες ὅτι καὶ ⸂αὐτῶν καὶ ὑμῶν",
          {
            "noteId": 80
          },
          "ὁ κύριός ἐστιν ἐν οὐρανοῖς, καὶ προσωπολημψία οὐκ ἔστιν παρʼ αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "⸂Τοῦ λοιποῦ",
          {
            "noteId": 81
          },
          "ἐνδυναμοῦσθε ἐν κυρίῳ καὶ ἐν τῷ κράτει τῆς ἰσχύος αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ἐνδύσασθε τὴν πανοπλίαν τοῦ θεοῦ πρὸς τὸ δύνασθαι ὑμᾶς στῆναι πρὸς τὰς μεθοδείας τοῦ διαβόλου·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ὅτι οὐκ ἔστιν ἡμῖν ἡ πάλη πρὸς αἷμα καὶ σάρκα, ἀλλὰ πρὸς τὰς ἀρχάς, πρὸς τὰς ἐξουσίας, πρὸς τοὺς κοσμοκράτορας τοῦ ⸀σκότους",
          {
            "noteId": 82
          },
          "τούτου, πρὸς τὰ πνευματικὰ τῆς πονηρίας ἐν τοῖς ἐπουρανίοις."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "διὰ τοῦτο ἀναλάβετε τὴν πανοπλίαν τοῦ θεοῦ, ἵνα δυνηθῆτε ἀντιστῆναι ἐν τῇ ἡμέρᾳ τῇ πονηρᾷ καὶ ἅπαντα κατεργασάμενοι στῆναι."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "στῆτε οὖν περιζωσάμενοι τὴν ὀσφὺν ὑμῶν ἐν ἀληθείᾳ, καὶ ἐνδυσάμενοι τὸν θώρακα τῆς δικαιοσύνης,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ ὑποδησάμενοι τοὺς πόδας ἐν ἑτοιμασίᾳ τοῦ εὐαγγελίου τῆς εἰρήνης,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "⸀ἐν",
          {
            "noteId": 83
          },
          "πᾶσιν ἀναλαβόντες τὸν θυρεὸν τῆς πίστεως, ἐν ᾧ δυνήσεσθε πάντα τὰ βέλη τοῦ ⸀πονηροῦ",
          {
            "noteId": 84
          },
          "πεπυρωμένα σβέσαι·"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καὶ τὴν περικεφαλαίαν τοῦ σωτηρίου ⸀δέξασθε",
          {
            "noteId": 85
          },
          "καὶ τὴν μάχαιραν τοῦ πνεύματος, ὅ ἐστιν ῥῆμα θεοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "διὰ πάσης προσευχῆς καὶ δεήσεως, προσευχόμενοι ἐν παντὶ καιρῷ ἐν πνεύματι, καὶ εἰς ⸀αὐτὸ",
          {
            "noteId": 86
          },
          "ἀγρυπνοῦντες ἐν πάσῃ προσκαρτερήσει καὶ δεήσει περὶ πάντων τῶν ἁγίων,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "καὶ ὑπὲρ ἐμοῦ, ἵνα μοι δοθῇ λόγος ἐν ἀνοίξει τοῦ στόματός μου, ἐν παρρησίᾳ γνωρίσαι τὸ μυστήριον τοῦ εὐαγγελίου"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ὑπὲρ οὗ πρεσβεύω ἐν ἁλύσει, ἵνα ἐν αὐτῷ παρρησιάσωμαι ὡς δεῖ με λαλῆσαι."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Ἵνα δὲ ⸂εἰδῆτε καὶ ὑμεῖς",
          {
            "noteId": 87
          },
          "τὰ κατʼ ἐμέ, τί πράσσω, πάντα ⸂γνωρίσει ὑμῖν",
          {
            "noteId": 88
          },
          "Τυχικὸς ὁ ἀγαπητὸς ἀδελφὸς καὶ πιστὸς διάκονος ἐν κυρίῳ,"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ὃν ἔπεμψα πρὸς ὑμᾶς εἰς αὐτὸ τοῦτο ἵνα γνῶτε τὰ περὶ ἡμῶν καὶ παρακαλέσῃ τὰς καρδίας ὑμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Εἰρήνη τοῖς ἀδελφοῖς καὶ ἀγάπη μετὰ πίστεως ἀπὸ θεοῦ πατρὸς καὶ κυρίου Ἰησοῦ Χριστοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ἡ χάρις μετὰ πάντων τῶν ἀγαπώντων τὸν κύριον ἡμῶν Ἰησοῦν Χριστὸν ἐν ⸀ἀφθαρσίᾳ",
          {
            "noteId": 89
          },
          "‘p /’ ‘/book’"
        ]
      }
    ],
