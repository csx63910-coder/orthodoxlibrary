  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "γίνεσθε οὖν μιμηταὶ τοῦ θεοῦ, ὡς τέκνα ἀγαπητά,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ περιπατεῖτε ἐν ἀγάπῃ, καθὼς καὶ ὁ Χριστὸς ἠγάπησεν ⸀ἡμᾶς",
          {
            "noteId": 51
          },
          "καὶ παρέδωκεν ἑαυτὸν ὑπὲρ ⸀ἡμῶν",
          {
            "noteId": 52
          },
          "προσφορὰν καὶ θυσίαν τῷ θεῷ εἰς ὀσμὴν εὐωδίας."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Πορνεία δὲ καὶ ⸂ἀκαθαρσία πᾶσα",
          {
            "noteId": 53
          },
          "ἢ πλεονεξία μηδὲ ὀνομαζέσθω ἐν ὑμῖν, καθὼς πρέπει ἁγίοις,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ αἰσχρότης καὶ μωρολογία ἢ εὐτραπελία, ⸂ἃ οὐκ ἀνῆκεν",
          {
            "noteId": 54
          },
          ", ἀλλὰ μᾶλλον εὐχαριστία."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "τοῦτο γὰρ ⸀ἴστε",
          {
            "noteId": 55
          },
          "γινώσκοντες ὅ",
          {
            "noteId": 56
          },
          "ι πᾶς πόρνος ἢ ἀκάθαρτος ἢ πλεονέκτης, ⸀ὅ ἐστιν εἰδωλολάτρης, οὐκ ἔχει κληρονομίαν ἐν τῇ βασιλείᾳ τοῦ Χριστοῦ καὶ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Μηδεὶς ὑμᾶς ἀπατάτω κενοῖς λόγοις, διὰ ταῦτα γὰρ ἔρχεται ἡ ὀργὴ τοῦ θεοῦ ἐπὶ τοὺς υἱοὺς τῆς ἀπειθείας."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "μὴ οὖν γίνεσθε συμμέτοχοι αὐτῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἦτε γάρ ποτε σκότος, νῦν δὲ φῶς ἐν κυρίῳ· ὡς τέκνα φωτὸς περιπατεῖτε,"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ὁ γὰρ καρπὸς τοῦ ⸀φωτὸς",
          {
            "noteId": 57
          },
          "ἐν πάσῃ ἀγαθωσύνῃ καὶ δικαιοσύνῃ καὶ ἀληθείᾳ,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "δοκιμάζοντες τί ἐστιν εὐάρεστον τῷ κυρίῳ·"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ μὴ συγκοινωνεῖτε τοῖς ἔργοις τοῖς ἀκάρποις τοῦ σκότους, μᾶλλον δὲ καὶ ἐλέγχετε,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "τὰ γὰρ κρυφῇ γινόμενα ὑπʼ αὐτῶν αἰσχρόν ἐστιν καὶ λέγειν·"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "τὰ δὲ πάντα ἐλεγχόμενα ὑπὸ τοῦ φωτὸς φανεροῦται,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "πᾶν γὰρ τὸ φανερούμενον φῶς ἐστιν. διὸ λέγει· Ἔγειρε, ὁ καθεύδων, καὶ ἀνάστα ἐκ τῶν νεκρῶν, καὶ ἐπιφαύσει σοι ὁ Χριστός."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Βλέπετε οὖν ⸂ἀκριβῶς πῶς",
          {
            "noteId": 58
          },
          "περιπατεῖτε, μὴ ὡς ἄσοφοι ἀλλʼ ὡς σοφοί,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ἐξαγοραζόμενοι τὸν καιρόν, ὅτι αἱ ἡμέραι πονηραί εἰσιν."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "διὰ τοῦτο μὴ γίνεσθε ἄφρονες, ἀλλὰ ⸀συνίετε",
          {
            "noteId": 59
          },
          "τί τὸ θέλημα τοῦ κυρίου·"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ μὴ μεθύσκεσθε οἴνῳ, ἐν ᾧ ἐστιν ἀσωτία, ἀλλὰ πληροῦσθε ἐν πνεύματι,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "λαλοῦντες ⸀ἑαυτοῖς",
          {
            "noteId": 60
          },
          "ψαλμοῖς καὶ ὕμνοις καὶ ᾠδαῖς πνευματικαῖς, ᾄδοντες καὶ ⸀ψάλλοντες",
          {
            "noteId": 61
          },
          "τῇ καρδίᾳ ὑμῶν τῷ κυρίῳ,"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "εὐχαριστοῦντες πάντοτε ὑπὲρ πάντων ἐν ὀνόματι τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ τῷ θεῷ καὶ πατρί,"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ὑποτασσόμενοι ἀλλήλοις ἐν φόβῳ Χριστοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Αἱ γυναῖκες τοῖς ἰδίοις ⸀ἀνδράσιν",
          {
            "noteId": 62
          },
          "ὡς τῷ κυρίῳ,"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ὅτι ἀνήρ ἐστιν κεφαλὴ τῆς γυναικὸς ὡς καὶ ὁ Χριστὸς κεφαλὴ τῆς ἐκκλησίας, ⸀αὐτὸς",
          {
            "noteId": 63
          },
          "σωτὴρ τοῦ σώματος."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ἀλλὰ ⸀ὡς",
          {
            "noteId": 64
          },
          "ἡ ἐκκλησία ὑποτάσσεται τῷ Χριστῷ, οὕτως καὶ αἱ γυναῖκες ⸀τοῖς",
          {
            "noteId": 65
          },
          "ἀνδράσιν ἐν παντί."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Οἱ ἄνδρες, ἀγαπᾶτε τὰς ⸀γυναῖκας",
          {
            "noteId": 66
          },
          "καθὼς καὶ ὁ Χριστὸς ἠγάπησεν τὴν ἐκκλησίαν καὶ ἑαυτὸν παρέδωκεν ὑπὲρ αὐτῆς,"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ἵνα αὐτὴν ἁγιάσῃ καθαρίσας τῷ λουτρῷ τοῦ ὕδατος ἐν ῥήματι,"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "ἵνα παραστήσῃ ⸀αὐτὸς",
          {
            "noteId": 67
          },
          "ἑαυτῷ ἔνδοξον τὴν ἐκκλησίαν, μὴ ἔχουσαν σπίλον ἢ ῥυτίδα ἤ τι τῶν τοιούτων, ἀλλʼ ἵνα ᾖ ἁγία καὶ ἄμωμος."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "οὕτως ὀφείλουσιν ⸀καὶ",
          {
            "noteId": 68
          },
          "οἱ ἄνδρες ἀγαπᾶν τὰς ἑαυτῶν γυναῖκας ὡς τὰ ἑαυτῶν σώματα· ὁ ἀγαπῶν τὴν ἑαυτοῦ γυναῖκα ἑαυτὸν ἀγαπᾷ,"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "οὐδεὶς γάρ ποτε τὴν ἑαυτοῦ σάρκα ἐμίσησεν, ἀλλὰ ἐκτρέφει καὶ θάλπει αὐτήν, καθὼς καὶ ὁ ⸀Χριστὸς",
          {
            "noteId": 69
          },
          "τὴν ἐκκλησίαν,"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ὅτι μέλη ἐσμὲν τοῦ σώματος ⸀αὐτοῦ",
          {
            "noteId": 70
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "ἀντὶ τούτου καταλείψει ἄνθρωπος ⸀τὸν",
          {
            "noteId": 71
          },
          "⸀πατέρα",
          {
            "noteId": 72
          },
          "καὶ ⸀τὴν",
          {
            "noteId": 73
          },
          "μητέρα καὶ προσκολληθήσεται ⸂τῇ γυναικὶ",
          {
            "noteId": 74
          },
          "αὐτοῦ, καὶ ἔσονται οἱ δύο εἰς σάρκα μίαν."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "τὸ μυστήριον τοῦτο μέγα ἐστίν, ἐγὼ δὲ λέγω εἰς Χριστὸν καὶ εἰς τὴν ἐκκλησίαν."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "πλὴν καὶ ὑμεῖς οἱ καθʼ ἕνα ἕκαστος τὴν ἑαυτοῦ γυναῖκα οὕτως ἀγαπάτω ὡς ἑαυτόν, ἡ δὲ γυνὴ ἵνα φοβῆται τὸν ἄνδρα."
        ]
      }
