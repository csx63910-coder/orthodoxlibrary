  "chapter": {
    "number": 7,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ συνάγονται πρὸς αὐτὸν οἱ Φαρισαῖοι καί τινες τῶν γραμματέων ἐλθόντες ἀπὸ Ἱεροσολύμων"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ ἰδόντες τινὰς τῶν μαθητῶν αὐτοῦ ⸂ὅτι κοιναῖς χερσίν, τοῦτʼ ἔστιν ἀνίπτοις, ἐσθίουσιν",
          {
            "noteId": 364
          },
          "⸀τοὺς",
          {
            "noteId": 365
          },
          "⸀ἄρτους",
          {
            "noteId": 366
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "οἱ γὰρ Φαρισαῖοι καὶ πάντες οἱ Ἰουδαῖοι ἐὰν μὴ πυγμῇ νίψωνται τὰς χεῖρας οὐκ ἐσθίουσιν, κρατοῦντες τὴν παράδοσιν τῶν πρεσβυτέρων,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ ἀπʼ ⸀ἀγορᾶς",
          {
            "noteId": 367
          },
          "ἐὰν μὴ ⸀βαπτίσωνται",
          {
            "noteId": 368
          },
          "οὐκ ἐσθίουσιν, καὶ ἄλλα πολλά ἐστιν ἃ παρέλαβον κρατεῖν, βαπτισμοὺς ποτηρίων καὶ ξεστῶν καὶ χαλκίων ⸂καὶ κλινῶν",
          {
            "noteId": 369
          },
          "—"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "⸀καὶ",
          {
            "noteId": 370
          },
          "ἐπερωτῶσιν αὐτὸν οἱ Φαρισαῖοι καὶ οἱ γραμματεῖς· Διὰ τί ⸂οὐ περιπατοῦσιν οἱ μαθηταί σου",
          {
            "noteId": 371
          },
          "κατὰ τὴν παράδοσιν τῶν πρεσβυτέρων, ἀλλὰ ⸀κοιναῖς",
          {
            "noteId": 372
          },
          "χερσὶν ἐσθίουσιν τὸν ἄρτον;"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ὁ ⸀δὲ",
          {
            "noteId": 373
          },
          "εἶπεν ⸀αὐτοῖς",
          {
            "noteId": 374
          },
          "Καλῶς ἐπροφήτευσεν Ἠσαΐας περὶ ὑμῶν τῶν ὑποκριτῶν, ὡς γέγραπται ⸀ὅτι",
          {
            "noteId": 375
          },
          "Οὗτος ὁ λαὸς τοῖς χείλεσίν με τιμᾷ, ἡ δὲ καρδία αὐτῶν πόρρω ἀπέχει ἀπʼ ἐμοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "μάτην δὲ σέβονταί με, διδάσκοντες διδασκαλίας ἐντάλματα ἀνθρώπων·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "⸀ἀφέντες",
          {
            "noteId": 376
          },
          "τὴν ἐντολὴν τοῦ θεοῦ κρατεῖτε τὴν παράδοσιν τῶν ⸀ἀνθρώπων",
          {
            "noteId": 377
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Καὶ ἔλεγεν αὐτοῖς· Καλῶς ἀθετεῖτε τὴν ἐντολὴν τοῦ θεοῦ, ἵνα τὴν παράδοσιν ὑμῶν ⸀τηρήσητε",
          {
            "noteId": 378
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Μωϋσῆς γὰρ εἶπεν· Τίμα τὸν πατέρα σου καὶ τὴν μητέρα σου, καί· Ὁ κακολογῶν πατέρα ἢ μητέρα θανάτῳ τελευτάτω·"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ὑμεῖς δὲ λέγετε· Ἐὰν εἴπῃ ἄνθρωπος τῷ πατρὶ ἢ τῇ μητρί· Κορβᾶν, ὅ ἐστιν Δῶρον, ὃ ἐὰν ἐξ ἐμοῦ ὠφεληθῇς,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "⸀οὐκέτι",
          {
            "noteId": 379
          },
          "ἀφίετε αὐτὸν οὐδὲν ποιῆσαι τῷ ⸀πατρὶ",
          {
            "noteId": 380
          },
          "ἢ τῇ ⸀μητρί",
          {
            "noteId": 381
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ἀκυροῦντες τὸν λόγον τοῦ θεοῦ τῇ παραδόσει ὑμῶν ᾗ παρεδώκατε· καὶ παρόμοια τοιαῦτα πολλὰ ποιεῖτε."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Καὶ προσκαλεσάμενος ⸀πάλιν",
          {
            "noteId": 382
          },
          "τὸν ὄχλον ἔλεγεν αὐτοῖς· ⸀Ἀκούσατέ",
          {
            "noteId": 383
          },
          "μου πάντες καὶ ⸀σύνετε",
          {
            "noteId": 384
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "οὐδέν ἐστιν ἔξωθεν τοῦ ἀνθρώπου εἰσπορευόμενον εἰς αὐτὸν ὃ δύναται ⸂κοινῶσαι αὐτόν",
          {
            "noteId": 385
          },
          "· ἀλλὰ τὰ ⸂ἐκ τοῦ ἀνθρώπου ἐκπορευόμενά",
          {
            "noteId": 386
          },
          "ἐστιν τὰ κοινοῦντα τὸν ⸀ἄνθρωπον",
          {
            "noteId": 387
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Καὶ ὅτε εἰσῆλθεν ⸀εἰς",
          {
            "noteId": 388
          },
          "οἶκον ἀπὸ τοῦ ὄχλου, ἐπηρώτων αὐτὸν οἱ μαθηταὶ αὐτοῦ ⸂τὴν παραβολήν",
          {
            "noteId": 389
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ λέγει αὐτοῖς· Οὕτως καὶ ὑμεῖς ἀσύνετοί ἐστε; οὐ νοεῖτε ὅτι πᾶν τὸ ἔξωθεν εἰσπορευόμενον εἰς τὸν ἄνθρωπον οὐ δύναται αὐτὸν κοινῶσαι,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ὅτι οὐκ εἰσπορεύεται αὐτοῦ εἰς τὴν καρδίαν ἀλλʼ εἰς τὴν κοιλίαν, καὶ εἰς τὸν ἀφεδρῶνα ἐκπορεύεται;— ⸀καθαρίζων",
          {
            "noteId": 390
          },
          "πάντα τὰ βρώματα."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἔλεγεν δὲ ὅτι Τὸ ἐκ τοῦ ἀνθρώπου ἐκπορευόμενον ἐκεῖνο κοινοῖ τὸν ἄνθρωπον·"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ἔσωθεν γὰρ ἐκ τῆς καρδίας τῶν ἀνθρώπων οἱ διαλογισμοὶ οἱ κακοὶ ἐκπορεύονται, ⸂πορνεῖαι, κλοπαί, φόνοι,",
          {
            "noteId": 391
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "μοιχεῖαι⸃, πλεονεξίαι, πονηρίαι, δόλος, ἀσέλγεια, ὀφθαλμὸς πονηρός, βλασφημία, ὑπερηφανία, ἀφροσύνη·"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "πάντα ταῦτα τὰ πονηρὰ ἔσωθεν ἐκπορεύεται καὶ κοινοῖ τὸν ἄνθρωπον."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "⸂Ἐκεῖθεν δὲ",
          {
            "noteId": 392
          },
          "ἀναστὰς ἀπῆλθεν εἰς τὰ ⸀ὅρια",
          {
            "noteId": 393
          },
          "⸀Τύρου",
          {
            "noteId": 394
          },
          "καὶ εἰσελθὼν εἰς οἰκίαν οὐδένα ἤθελεν γνῶναι, καὶ οὐκ ἠδυνήθη λαθεῖν·"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "⸂ἀλλʼ εὐθὺς ἀκούσασα",
          {
            "noteId": 395
          },
          "γυνὴ περὶ αὐτοῦ, ἧς εἶχεν τὸ θυγάτριον αὐτῆς πνεῦμα ἀκάθαρτον, ἐλθοῦσα προσέπεσεν πρὸς τοὺς πόδας αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "⸂ἡ δὲ γυνὴ ἦν",
          {
            "noteId": 396
          },
          "Ἑλληνίς, Συροφοινίκισσα τῷ γένει· καὶ ἠρώτα αὐτὸν ἵνα τὸ δαιμόνιον ἐκβάλῃ ἐκ τῆς θυγατρὸς αὐτῆς."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "⸂καὶ ἔλεγεν",
          {
            "noteId": 397
          },
          "αὐτῇ· Ἄφες πρῶτον χορτασθῆναι τὰ τέκνα, οὐ γὰρ ⸂καλόν ἐστιν",
          {
            "noteId": 398
          },
          "λαβεῖν τὸν ἄρτον τῶν τέκνων καὶ ⸂τοῖς κυναρίοις βαλεῖν",
          {
            "noteId": 399
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ἡ δὲ ἀπεκρίθη καὶ λέγει αὐτῷ· ⸀Κύριε",
          {
            "noteId": 400
          },
          "⸀καὶ",
          {
            "noteId": 401
          },
          "τὰ κυνάρια ὑποκάτω τῆς τραπέζης ⸀ἐσθίουσιν",
          {
            "noteId": 402
          },
          "ἀπὸ τῶν ψιχίων τῶν παιδίων."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "καὶ εἶπεν αὐτῇ· Διὰ τοῦτον τὸν λόγον ὕπαγε, ἐξελήλυθεν ⸂ἐκ τῆς θυγατρός σου τὸ δαιμόνιον",
          {
            "noteId": 403
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "καὶ ἀπελθοῦσα εἰς τὸν οἶκον αὐτῆς εὗρεν τὸ ⸂παιδίον βεβλημένον ἐπὶ τὴν κλίνην καὶ τὸ δαιμόνιον ἐξεληλυθός",
          {
            "noteId": 404
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "Καὶ πάλιν ἐξελθὼν ἐκ τῶν ὁρίων Τύρου ⸂ἦλθεν διὰ Σιδῶνος εἰς",
          {
            "noteId": 405
          },
          "τὴν θάλασσαν τῆς Γαλιλαίας ἀνὰ μέσον τῶν ὁρίων Δεκαπόλεως."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "καὶ",
          {
            "noteId": 406
          },
          "φέρουσιν αὐτῷ κωφὸν ⸀καὶ ⸀μογιλάλον",
          {
            "noteId": 407
          },
          "καὶ παρακαλοῦσιν αὐτὸν ἵνα ἐπιθῇ αὐτῷ τὴν χεῖρα."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "καὶ ἀπολαβόμενος αὐτὸν ἀπὸ τοῦ ὄχλου κατʼ ἰδίαν ἔβαλεν τοὺς δακτύλους αὐτοῦ εἰς τὰ ὦτα αὐτοῦ καὶ πτύσας ἥψατο τῆς γλώσσης αὐτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "καὶ ἀναβλέψας εἰς τὸν οὐρανὸν ἐστέναξεν, καὶ λέγει αὐτῷ· Εφφαθα, ὅ ἐστιν Διανοίχθητι·"
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "⸀καὶ",
          {
            "noteId": 408
          },
          "⸀ἠνοίγησαν",
          {
            "noteId": 409
          },
          "αὐτοῦ αἱ ἀκοαί, καὶ ἐλύθη ὁ δεσμὸς τῆς γλώσσης αὐτοῦ, καὶ ἐλάλει ὀρθῶς·"
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "καὶ διεστείλατο αὐτοῖς ἵνα μηδενὶ ⸀λέγωσιν",
          {
            "noteId": 410
          },
          "ὅσον δὲ ⸂αὐτοῖς διεστέλλετο, αὐτοὶ⸃ μᾶλλον περισσότερον ἐκήρυσσον.",
          {
            "noteId": 411
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "καὶ",
          {
            "noteId": 412
          },
          "ὑπερπερισσῶς ἐξεπλήσσοντο λέγοντες· Καλῶς πάντα πεποίηκεν, καὶ τοὺς κωφοὺς ποιεῖ ἀκούειν ⸀καὶ ἀλάλους λαλεῖν."
        ]
      }
    ],
