  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ ἦλθον εἰς τὸ πέραν τῆς θαλάσσης εἰς τὴν χώραν τῶν ⸀Γερασηνῶν",
          {
            "noteId": 230
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ ⸂ἐξελθόντος αὐτοῦ",
          {
            "noteId": 231
          },
          "ἐκ τοῦ πλοίου ⸂εὐθὺς ὑπήντησεν",
          {
            "noteId": 232
          },
          "αὐτῷ ἐκ τῶν μνημείων ἄνθρωπος ἐν πνεύματι ἀκαθάρτῳ,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ὃς τὴν κατοίκησιν εἶχεν ἐν τοῖς μνήμασιν, καὶ ⸂οὐδὲ ἁλύσει οὐκέτι",
          {
            "noteId": 233
          },
          "οὐδεὶς ἐδύνατο αὐτὸν δῆσαι"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "διὰ τὸ αὐτὸν πολλάκις πέδαις καὶ ἁλύσεσι δεδέσθαι καὶ διεσπάσθαι ὑπʼ αὐτοῦ τὰς ἁλύσεις καὶ τὰς πέδας συντετρῖφθαι, καὶ οὐδεὶς ⸂ἴσχυεν αὐτὸν",
          {
            "noteId": 234
          },
          "δαμάσαι·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ διὰ παντὸς νυκτὸς καὶ ἡμέρας ἐν τοῖς ⸂μνήμασιν καὶ ἐν τοῖς ὄρεσιν",
          {
            "noteId": 235
          },
          "ἦν κράζων καὶ κατακόπτων ἑαυτὸν λίθοις."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "⸂καὶ ἰδὼν",
          {
            "noteId": 236
          },
          "τὸν Ἰησοῦν ἀπὸ μακρόθεν ἔδραμεν καὶ προσεκύνησεν ⸀αὐτόν",
          {
            "noteId": 237
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "καὶ κράξας φωνῇ μεγάλῃ ⸀λέγει",
          {
            "noteId": 238
          },
          "Τί ἐμοὶ καὶ σοί, Ἰησοῦ υἱὲ τοῦ θεοῦ τοῦ ὑψίστου; ὁρκίζω σε τὸν θεόν, μή με βασανίσῃς."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἔλεγεν γὰρ αὐτῷ· Ἔξελθε τὸ πνεῦμα τὸ ἀκάθαρτον ἐκ τοῦ ἀνθρώπου."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ ἐπηρώτα αὐτόν· Τί ⸂ὄνομά σοι",
          {
            "noteId": 239
          },
          "; καὶ ⸂λέγει αὐτῷ",
          {
            "noteId": 240
          },
          "· ⸀Λεγιὼν",
          {
            "noteId": 241
          },
          "ὄνομά μοι, ὅτι πολλοί ἐσμεν·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ παρεκάλει αὐτὸν πολλὰ ἵνα μὴ ⸀αὐτὰ",
          {
            "noteId": 242
          },
          "ἀποστείλῃ ἔξω τῆς χώρας."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ἦν δὲ ἐκεῖ πρὸς τῷ ὄρει ἀγέλη χοίρων μεγάλη βοσκομένη·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "καὶ παρεκάλεσαν ⸀αὐτὸν",
          {
            "noteId": 243
          },
          "λέγοντες· Πέμψον ἡμᾶς εἰς τοὺς χοίρους, ἵνα εἰς αὐτοὺς εἰσέλθωμεν."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ ἐπέτρεψεν ⸀αὐτοῖς",
          {
            "noteId": 244
          },
          "καὶ ἐξελθόντα τὰ πνεύματα τὰ ἀκάθαρτα εἰσῆλθον εἰς τοὺς χοίρους, καὶ ὥρμησεν ἡ ἀγέλη κατὰ τοῦ κρημνοῦ εἰς τὴν θάλασσαν, ⸀ὡς",
          {
            "noteId": 245
          },
          "δισχίλιοι, καὶ ἐπνίγοντο ἐν τῇ θαλάσσῃ."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "⸂Καὶ οἱ",
          {
            "noteId": 246
          },
          "βόσκοντες ⸀αὐτοὺς",
          {
            "noteId": 247
          },
          "ἔφυγον καὶ ⸀ἀπήγγειλαν",
          {
            "noteId": 248
          },
          "εἰς τὴν πόλιν καὶ εἰς τοὺς ἀγρούς· καὶ ⸀ἦλθον",
          {
            "noteId": 249
          },
          "ἰδεῖν τί ἐστιν τὸ γεγονός."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ ἔρχονται πρὸς τὸν Ἰησοῦν, καὶ θεωροῦσιν τὸν δαιμονιζόμενον ⸀καθήμενον",
          {
            "noteId": 250
          },
          "ἱματισμένον καὶ σωφρονοῦντα, τὸν ἐσχηκότα τὸν ⸀λεγιῶνα",
          {
            "noteId": 251
          },
          "καὶ ἐφοβήθησαν."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "⸂καὶ διηγήσαντο",
          {
            "noteId": 252
          },
          "αὐτοῖς οἱ ἰδόντες πῶς ἐγένετο τῷ δαιμονιζομένῳ καὶ περὶ τῶν χοίρων."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καὶ ἤρξαντο παρακαλεῖν αὐτὸν ἀπελθεῖν ἀπὸ τῶν ὁρίων αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ ⸀ἐμβαίνοντος",
          {
            "noteId": 253
          },
          "αὐτοῦ εἰς τὸ πλοῖον παρεκάλει αὐτὸν ὁ δαιμονισθεὶς ἵνα ⸂μετʼ αὐτοῦ ᾖ",
          {
            "noteId": 254
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "⸀καὶ",
          {
            "noteId": 255
          },
          "οὐκ ἀφῆκεν αὐτόν, ἀλλὰ λέγει αὐτῷ· Ὕπαγε εἰς τὸν οἶκόν σου πρὸς τοὺς σούς, καὶ ⸀ἀπάγγειλον",
          {
            "noteId": 256
          },
          "αὐτοῖς ὅσα ⸂ὁ κύριός σοι",
          {
            "noteId": 257
          },
          "πεποίηκεν καὶ ἠλέησέν σε."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "καὶ ἀπῆλθεν καὶ ἤρξατο κηρύσσειν ἐν τῇ Δεκαπόλει ὅσα ἐποίησεν αὐτῷ ὁ Ἰησοῦς, καὶ πάντες ἐθαύμαζον."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Καὶ διαπεράσαντος τοῦ Ἰησοῦ ἐν τῷ πλοίῳ πάλιν εἰς τὸ πέραν συνήχθη ὄχλος πολὺς ἐπʼ αὐτόν, καὶ ἦν παρὰ τὴν θάλασσαν."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "⸀καὶ",
          {
            "noteId": 258
          },
          "ἔρχεται εἷς τῶν ἀρχισυναγώγων, ὀνόματι Ἰάϊρος, καὶ ἰδὼν αὐτὸν πίπτει πρὸς τοὺς πόδας αὐτοῦ"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "καὶ ⸀παρακαλεῖ",
          {
            "noteId": 259
          },
          "αὐτὸν πολλὰ λέγων ὅτι Τὸ θυγάτριόν μου ἐσχάτως ἔχει, ἵνα ἐλθὼν ἐπιθῇς ⸂τὰς χεῖρας αὐτῇ",
          {
            "noteId": 260
          },
          "⸀ἵνα",
          {
            "noteId": 261
          },
          "σωθῇ καὶ ⸀ζήσῃ",
          {
            "noteId": 262
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "καὶ ἀπῆλθεν μετʼ αὐτοῦ. Καὶ ἠκολούθει αὐτῷ ὄχλος πολύς, καὶ συνέθλιβον αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "καὶ ⸀γυνὴ",
          {
            "noteId": 263
          },
          "οὖσα ἐν ῥύσει αἵματος ⸂δώδεκα ἔτη",
          {
            "noteId": 264
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "καὶ πολλὰ παθοῦσα ὑπὸ πολλῶν ἰατρῶν καὶ δαπανήσασα τὰ παρʼ αὐτῆς πάντα καὶ μηδὲν ὠφεληθεῖσα ἀλλὰ μᾶλλον εἰς τὸ χεῖρον ἐλθοῦσα,"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "⸀ἀκούσασα",
          {
            "noteId": 265
          },
          "περὶ τοῦ Ἰησοῦ, ἐλθοῦσα ἐν τῷ ὄχλῳ ὄπισθεν ἥψατο τοῦ ἱματίου αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ἔλεγεν γὰρ ὅτι ⸂Ἐὰν ἅψωμαι κἂν τῶν ἱματίων αὐτοῦ",
          {
            "noteId": 266
          },
          "σωθήσομαι."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "καὶ ⸀εὐθὺς",
          {
            "noteId": 267
          },
          "ἐξηράνθη ἡ πηγὴ τοῦ αἵματος αὐτῆς, καὶ ἔγνω τῷ σώματι ὅτι ἴαται ἀπὸ τῆς μάστιγος."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "καὶ ⸀εὐθὺς",
          {
            "noteId": 268
          },
          "ὁ Ἰησοῦς ἐπιγνοὺς ἐν ἑαυτῷ τὴν ἐξ αὐτοῦ δύναμιν ἐξελθοῦσαν ἐπιστραφεὶς ἐν τῷ ὄχλῳ ἔλεγεν· Τίς μου ἥψατο τῶν ἱματίων;"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "καὶ ἔλεγον αὐτῷ οἱ μαθηταὶ αὐτοῦ· Βλέπεις τὸν ὄχλον συνθλίβοντά σε, καὶ λέγεις· Τίς μου ἥψατο;"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "καὶ περιεβλέπετο ἰδεῖν τὴν τοῦτο ποιήσασαν."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "ἡ δὲ γυνὴ φοβηθεῖσα καὶ τρέμουσα, εἰδυῖα ὃ γέγονεν ⸀αὐτῇ",
          {
            "noteId": 269
          },
          "ἦλθεν καὶ προσέπεσεν αὐτῷ καὶ εἶπεν αὐτῷ πᾶσαν τὴν ἀλήθειαν."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "ὁ δὲ εἶπεν αὐτῇ· ⸀Θυγάτηρ",
          {
            "noteId": 270
          },
          "ἡ πίστις σου σέσωκέν σε· ὕπαγε εἰς εἰρήνην, καὶ ἴσθι ὑγιὴς ἀπὸ τῆς μάστιγός σου."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "Ἔτι αὐτοῦ λαλοῦντος ἔρχονται ἀπὸ τοῦ ἀρχισυναγώγου λέγοντες ὅτι Ἡ θυγάτηρ σου ἀπέθανεν· τί ἔτι σκύλλεις τὸν διδάσκαλον;"
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "ὁ δὲ Ἰησοῦς ⸀παρακούσας",
          {
            "noteId": 271
          },
          "τὸν λόγον λαλούμενον λέγει τῷ ἀρχισυναγώγῳ· Μὴ φοβοῦ, μόνον πίστευε."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "καὶ οὐκ ἀφῆκεν οὐδένα ⸂μετʼ αὐτοῦ",
          {
            "noteId": 272
          },
          "συνακολουθῆσαι εἰ μὴ ⸀τὸν",
          {
            "noteId": 273
          },
          "Πέτρον καὶ Ἰάκωβον καὶ Ἰωάννην τὸν ἀδελφὸν Ἰακώβου."
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "καὶ ⸀ἔρχονται",
          {
            "noteId": 274
          },
          "εἰς τὸν οἶκον τοῦ ἀρχισυναγώγου, καὶ",
          {
            "noteId": 275
          },
          "θεωρεῖ θόρυβον ⸀καὶ κλαίοντας καὶ ἀλαλάζοντας πολλά,"
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "καὶ εἰσελθὼν λέγει αὐτοῖς· Τί θορυβεῖσθε καὶ κλαίετε; τὸ παιδίον οὐκ ἀπέθανεν ἀλλὰ καθεύδει."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "καὶ κατεγέλων αὐτοῦ. ⸀αὐτὸς",
          {
            "noteId": 276
          },
          "δὲ ἐκβαλὼν πάντας παραλαμβάνει τὸν πατέρα τοῦ παιδίου καὶ τὴν μητέρα καὶ τοὺς μετʼ αὐτοῦ, καὶ εἰσπορεύεται ὅπου ἦν τὸ ⸀παιδίον",
          {
            "noteId": 277
          }
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "καὶ κρατήσας τῆς χειρὸς τοῦ παιδίου λέγει αὐτῇ· Ταλιθα ⸀κουμ",
          {
            "noteId": 278
          },
          "ὅ ἐστιν μεθερμηνευόμενον· Τὸ κοράσιον, σοὶ λέγω, ⸀ἔγειρε",
          {
            "noteId": 279
          }
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "καὶ ⸀εὐθὺς",
          {
            "noteId": 280
          },
          "ἀνέστη τὸ κοράσιον καὶ περιεπάτει, ἦν γὰρ ἐτῶν δώδεκα. καὶ ἐξέστησαν ⸁εὐθὺς",
          {
            "noteId": 281
          },
          "ἐκστάσει μεγάλῃ."
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "καὶ διεστείλατο αὐτοῖς πολλὰ ἵνα μηδεὶς γνοῖ τοῦτο, καὶ εἶπεν δοθῆναι αὐτῇ φαγεῖν."
        ]
      }
    ],
