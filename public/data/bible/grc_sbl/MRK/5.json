        }
      },
      {
        "noteId": 247,
        "caller": "+",
        "text": "αὐτοὺς WH Treg NA28 ] τοὺς χοίρους RP",
        "reference": {
          "chapter": 5,
          "verse": 14
        }
      },
      {
