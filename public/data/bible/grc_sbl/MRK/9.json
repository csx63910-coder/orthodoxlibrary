  },
  "chapter": {
    "number": 9,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "καὶ ἔλεγεν αὐτοῖς· Ἀμὴν λέγω ὑμῖν ὅτι εἰσίν τινες ⸂τῶν ὧδε",
          {
            "noteId": 468
          },
          "ἑστηκότων οἵτινες οὐ μὴ γεύσωνται θανάτου ἕως ἂν ἴδωσιν τὴν βασιλείαν τοῦ θεοῦ ἐληλυθυῖαν ἐν δυνάμει."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Καὶ μετὰ ἡμέρας ἓξ παραλαμβάνει ὁ Ἰησοῦς τὸν Πέτρον καὶ",
          {
            "noteId": 469
          },
          "τὸν Ἰάκωβον ⸀καὶ Ἰωάννην, καὶ ἀναφέρει αὐτοὺς εἰς ὄρος ὑψηλὸν κατʼ ἰδίαν μόνους. καὶ μετεμορφώθη ἔμπροσθεν αὐτῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ τὰ ἱμάτια αὐτοῦ ⸀ἐγένετο",
          {
            "noteId": 470
          },
          "στίλβοντα λευκὰ ⸀λίαν",
          {
            "noteId": 471
          },
          "οἷα γναφεὺς ἐπὶ τῆς γῆς οὐ δύναται ⸀οὕτως",
          {
            "noteId": 472
          },
          "λευκᾶναι."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ ὤφθη αὐτοῖς Ἠλίας σὺν Μωϋσεῖ, καὶ ἦσαν συλλαλοῦντες τῷ Ἰησοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ ἀποκριθεὶς ὁ Πέτρος λέγει τῷ Ἰησοῦ· Ῥαββί, καλόν ἐστιν ἡμᾶς ὧδε εἶναι, καὶ ποιήσωμεν ⸂τρεῖς σκηνάς",
          {
            "noteId": 473
          },
          ", σοὶ μίαν καὶ Μωϋσεῖ μίαν καὶ Ἠλίᾳ μίαν."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "οὐ γὰρ ᾔδει τί ⸀ἀποκριθῇ",
          {
            "noteId": 474
          },
          "⸂ἔκφοβοι γὰρ ἐγένοντο",
          {
            "noteId": 475
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "καὶ ἐγένετο",
          {
            "noteId": 476
          },
          "νεφέλη ἐπισκιάζουσα αὐτοῖς, καὶ ⸀ἐγένετο φωνὴ ἐκ τῆς νεφέλης· Οὗτός ἐστιν ὁ υἱός μου ὁ ἀγαπητός, ⸂ἀκούετε αὐτοῦ",
          {
            "noteId": 477
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ ἐξάπινα περιβλεψάμενοι οὐκέτι οὐδένα εἶδον ⸂ἀλλὰ τὸν Ἰησοῦν μόνον μεθʼ ἑαυτῶν",
          {
            "noteId": 478
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "⸂Καὶ καταβαινόντων",
          {
            "noteId": 479
          },
          "αὐτῶν ⸀ἐκ",
          {
            "noteId": 480
          },
          "τοῦ ὄρους διεστείλατο αὐτοῖς ἵνα μηδενὶ ⸂ἃ εἶδον διηγήσωνται",
          {
            "noteId": 481
          },
          ", εἰ μὴ ὅταν ὁ υἱὸς τοῦ ἀνθρώπου ἐκ νεκρῶν ἀναστῇ."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ τὸν λόγον ἐκράτησαν πρὸς ἑαυτοὺς συζητοῦντες τί ἐστιν τὸ ἐκ νεκρῶν ἀναστῆναι."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ ἐπηρώτων αὐτὸν λέγοντες· Ὅτι λέγουσιν οἱ γραμματεῖς ὅτι Ἠλίαν δεῖ ἐλθεῖν πρῶτον;"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ὁ δὲ ⸀ἔφη",
          {
            "noteId": 482
          },
          "αὐτοῖς· Ἠλίας μὲν ἐλθὼν πρῶτον ⸀ἀποκαθιστάνει",
          {
            "noteId": 483
          },
          "πάντα, καὶ πῶς γέγραπται ἐπὶ τὸν υἱὸν τοῦ ἀνθρώπου ἵνα πολλὰ πάθῃ καὶ ⸀ἐξουδενηθῇ",
          {
            "noteId": 484
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ἀλλὰ λέγω ὑμῖν ὅτι καὶ Ἠλίας ἐλήλυθεν, καὶ ἐποίησαν αὐτῷ ὅσα ⸀ἤθελον",
          {
            "noteId": 485
          },
          "καθὼς γέγραπται ἐπʼ αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Καὶ ⸂ἐλθόντες πρὸς τοὺς μαθητὰς εἶδον",
          {
            "noteId": 486
          },
          "ὄχλον πολὺν περὶ αὐτοὺς καὶ γραμματεῖς συζητοῦντας ⸂πρὸς αὐτούς",
          {
            "noteId": 487
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ ⸀εὐθὺς",
          {
            "noteId": 488
          },
          "πᾶς ὁ ὄχλος ⸂ἰδόντες αὐτὸν ἐξεθαμβήθησαν",
          {
            "noteId": 489
          },
          ", καὶ προστρέχοντες ἠσπάζοντο αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ ἐπηρώτησεν ⸀αὐτούς",
          {
            "noteId": 490
          },
          "Τί συζητεῖτε πρὸς ⸀αὑτούς",
          {
            "noteId": 491
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καὶ ⸂ἀπεκρίθη αὐτῷ εἷς ἐκ τοῦ ὄχλου",
          {
            "noteId": 492
          },
          "· Διδάσκαλε, ἤνεγκα τὸν υἱόν μου πρὸς σέ, ἔχοντα πνεῦμα ἄλαλον·"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ ὅπου ⸀ἐὰν",
          {
            "noteId": 493
          },
          "αὐτὸν καταλάβῃ ῥήσσει αὐτόν, καὶ ἀφρίζει καὶ τρίζει τοὺς ⸀ὀδόντας",
          {
            "noteId": 494
          },
          "καὶ ξηραίνεται· καὶ εἶπα τοῖς μαθηταῖς σου ἵνα αὐτὸ ἐκβάλωσιν, καὶ οὐκ ἴσχυσαν."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ὁ δὲ ἀποκριθεὶς ⸀αὐτοῖς",
          {
            "noteId": 495
          },
          "λέγει· Ὦ γενεὰ ἄπιστος, ἕως πότε πρὸς ὑμᾶς ἔσομαι; ἕως πότε ἀνέξομαι ὑμῶν; φέρετε αὐτὸν πρός με."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "καὶ ἤνεγκαν αὐτὸν πρὸς αὐτόν. καὶ ἰδὼν αὐτὸν ⸂τὸ πνεῦμα εὐθὺς",
          {
            "noteId": 496
          },
          "⸀συνεσπάραξεν",
          {
            "noteId": 497
          },
          "αὐτόν, καὶ πεσὼν ἐπὶ τῆς γῆς ἐκυλίετο ἀφρίζων."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "καὶ ἐπηρώτησεν τὸν πατέρα αὐτοῦ· Πόσος χρόνος ἐστὶν ὡς τοῦτο γέγονεν αὐτῷ; ὁ δὲ εἶπεν· ⸀Ἐκ",
          {
            "noteId": 498
          },
          "παιδιόθεν·"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "καὶ πολλάκις ⸂καὶ εἰς πῦρ αὐτὸν",
          {
            "noteId": 499
          },
          "ἔβαλεν καὶ εἰς ὕδατα ἵνα ἀπολέσῃ αὐτόν· ἀλλʼ εἴ τι ⸀δύνῃ",
          {
            "noteId": 500
          },
          "βοήθησον ἡμῖν σπλαγχνισθεὶς ἐφʼ ἡμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ὁ δὲ Ἰησοῦς εἶπεν αὐτῷ· Τὸ Εἰ ⸀δύνῃ",
          {
            "noteId": 501
          },
          "πάντα δυνατὰ τῷ πιστεύοντι."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "⸀εὐθὺς",
          {
            "noteId": 502
          },
          "κράξας ὁ πατὴρ τοῦ ⸀παιδίου",
          {
            "noteId": 503
          },
          "ἔλεγεν· ⸀Πιστεύω",
          {
            "noteId": 504
          },
          "βοήθει μου τῇ ἀπιστίᾳ."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ἰδὼν δὲ ὁ Ἰησοῦς ὅτι ἐπισυντρέχει ὄχλος ἐπετίμησεν τῷ πνεύματι τῷ ἀκαθάρτῳ λέγων αὐτῷ· Τὸ ⸂ἄλαλον καὶ κωφὸν πνεῦμα",
          {
            "noteId": 505
          },
          ", ἐγὼ ⸂ἐπιτάσσω σοι",
          {
            "noteId": 506
          },
          ", ἔξελθε ἐξ αὐτοῦ καὶ μηκέτι εἰσέλθῃς εἰς αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "καὶ ⸂κράξας καὶ πολλὰ σπαράξας",
          {
            "noteId": 507
          },
          "ἐξῆλθεν· καὶ ἐγένετο ὡσεὶ νεκρὸς ὥστε ⸀τοὺς",
          {
            "noteId": 508
          },
          "πολλοὺς λέγειν ὅτι ἀπέθανεν."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "ὁ δὲ Ἰησοῦς κρατήσας ⸂τῆς χειρὸς αὐτοῦ",
          {
            "noteId": 509
          },
          "ἤγειρεν αὐτόν, καὶ ἀνέστη."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "καὶ ⸂εἰσελθόντος αὐτοῦ",
          {
            "noteId": 510
          },
          "εἰς οἶκον οἱ μαθηταὶ αὐτοῦ ⸂κατʼ ἰδίαν ἐπηρώτων αὐτόν",
          {
            "noteId": 511
          },
          "· Ὅτι ἡμεῖς οὐκ ἠδυνήθημεν ἐκβαλεῖν αὐτό;"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "καὶ εἶπεν αὐτοῖς· Τοῦτο τὸ γένος ἐν οὐδενὶ δύναται ἐξελθεῖν εἰ μὴ ἐν ⸀προσευχῇ",
          {
            "noteId": 512
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Κἀκεῖθεν ἐξελθόντες ⸀παρεπορεύοντο",
          {
            "noteId": 513
          },
          "διὰ τῆς Γαλιλαίας, καὶ οὐκ ἤθελεν ἵνα τις γνοῖ·"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "ἐδίδασκεν γὰρ τοὺς μαθητὰς αὐτοῦ καὶ ἔλεγεν αὐτοῖς ὅτι Ὁ υἱὸς τοῦ ἀνθρώπου παραδίδοται εἰς χεῖρας ἀνθρώπων, καὶ ἀποκτενοῦσιν αὐτόν, καὶ ἀποκτανθεὶς ⸂μετὰ τρεῖς ἡμέρας",
          {
            "noteId": 514
          },
          "ἀναστήσεται."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "οἱ δὲ ἠγνόουν τὸ ῥῆμα, καὶ ἐφοβοῦντο αὐτὸν ἐπερωτῆσαι."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "Καὶ ⸀ἦλθον",
          {
            "noteId": 515
          },
          "εἰς Καφαρναούμ. καὶ ἐν τῇ οἰκίᾳ γενόμενος ἐπηρώτα αὐτούς· Τί ἐν τῇ ⸀ὁδῷ",
          {
            "noteId": 516
          },
          "διελογίζεσθε;"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "οἱ δὲ ἐσιώπων, πρὸς ἀλλήλους γὰρ διελέχθησαν ἐν τῇ ὁδῷ τίς μείζων."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "καὶ καθίσας ἐφώνησεν τοὺς δώδεκα καὶ λέγει αὐτοῖς· Εἴ τις θέλει πρῶτος εἶναι ἔσται πάντων ἔσχατος καὶ πάντων διάκονος."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "καὶ λαβὼν παιδίον ἔστησεν αὐτὸ ἐν μέσῳ αὐτῶν καὶ ἐναγκαλισάμενος αὐτὸ εἶπεν αὐτοῖς·"
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "Ὃς ⸀ἂν",
          {
            "noteId": 517
          },
          "ἓν τῶν τοιούτων παιδίων δέξηται ἐπὶ τῷ ὀνόματί μου, ἐμὲ δέχεται· καὶ ὃς ⸁ἂν",
          {
            "noteId": 518
          },
          "ἐμὲ ⸀δέχηται",
          {
            "noteId": 519
          },
          "οὐκ ἐμὲ δέχεται ἀλλὰ τὸν ἀποστείλαντά με."
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "⸂Ἔφη αὐτῷ ὁ Ἰωάννης",
          {
            "noteId": 520
          },
          "· Διδάσκαλε, εἴδομέν τινα ⸀ἐν",
          {
            "noteId": 521
          },
          "τῷ ὀνόματί σου ἐκβάλλοντα δαιμόνια, ⸂καὶ ἐκωλύομεν αὐτόν, ὅτι οὐκ ἠκολούθει ἡμῖν",
          {
            "noteId": 522
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "ὁ δὲ Ἰησοῦς εἶπεν· Μὴ κωλύετε αὐτόν, οὐδεὶς γάρ ἐστιν ὃς ποιήσει δύναμιν ἐπὶ τῷ ὀνόματί μου καὶ δυνήσεται ταχὺ κακολογῆσαί με·"
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "ὃς γὰρ οὐκ ἔστιν καθʼ ⸂ἡμῶν, ὑπὲρ ἡμῶν",
          {
            "noteId": 523
          },
          "ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "Ὃς γὰρ ἂν ποτίσῃ ὑμᾶς ποτήριον ὕδατος ἐν ⸀ὀνόματι",
          {
            "noteId": 524
          },
          "ὅτι",
          {
            "noteId": 525
          },
          "χριστοῦ ἐστε, ἀμὴν λέγω ὑμῖν ⸀ὅτι οὐ μὴ ⸀ἀπολέσῃ",
          {
            "noteId": 526
          },
          "τὸν μισθὸν αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "Καὶ ὃς ⸀ἂν",
          {
            "noteId": 527
          },
          "σκανδαλίσῃ ἕνα τῶν μικρῶν ⸀τούτων",
          {
            "noteId": 528
          },
          "τῶν πιστευόντων ⸂εἰς ἐμέ",
          {
            "noteId": 529
          },
          ", καλόν ἐστιν αὐτῷ μᾶλλον εἰ περίκειται ⸂μύλος ὀνικὸς",
          {
            "noteId": 530
          },
          "περὶ τὸν τράχηλον αὐτοῦ καὶ βέβληται εἰς τὴν θάλασσαν."
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "Καὶ ἐὰν ⸀σκανδαλίζῃ",
          {
            "noteId": 531
          },
          "σε ἡ χείρ σου, ἀπόκοψον αὐτήν· καλόν ⸂ἐστίν σε",
          {
            "noteId": 532
          },
          "κυλλὸν ⸂εἰσελθεῖν εἰς τὴν ζωὴν",
          {
            "noteId": 533
          },
          "ἢ τὰς δύο χεῖρας ἔχοντα ἀπελθεῖν εἰς τὴν γέενναν, εἰς τὸ πῦρ τὸ ⸀ἄσβεστον",
          {
            "noteId": 534
          }
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "καὶ ἐὰν ὁ πούς σου σκανδαλίζῃ σε",
          {
            "noteId": 535
          },
          "ἀπόκοψον αὐτόν· καλόν ἐστίν ⸀σε εἰσελθεῖν εἰς τὴν ζωὴν χωλὸν ἢ τοὺς δύο πόδας ἔχοντα βληθῆναι εἰς τὴν ⸀γέενναν",
          {
            "noteId": 536
          }
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          "καὶ ἐὰν ὁ ὀφθαλμός σου σκανδαλίζῃ σε, ἔκβαλε αὐτόν· καλόν ⸀σέ",
          {
            "noteId": 537
          },
          "ἐστιν μονόφθαλμον εἰσελθεῖν εἰς τὴν",
          {
            "noteId": 538
          },
          "βασιλείαν τοῦ θεοῦ ἢ δύο ὀφθαλμοὺς ἔχοντα βληθῆναι εἰς ⸀τὴν ⸀γέενναν",
          {
            "noteId": 539
          }
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          "ὅπου ὁ σκώληξ αὐτῶν οὐ τελευτᾷ καὶ τὸ πῦρ οὐ σβέννυται."
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          "Πᾶς γὰρ πυρὶ ⸀ἁλισθήσεται",
          {
            "noteId": 540
          }
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          "καλὸν τὸ ἅλα",
          {
            "noteId": 541
          },
          "· ἐὰν δὲ τὸ ἅλας ἄναλον γένηται, ἐν τίνι αὐτὸ ἀρτύσετε; ἔχετε ἐν ἑαυτοῖς ⸀ἅλα, καὶ εἰρηνεύετε ἐν ἀλλήλοις."
        ]
      }
    ],
