  "chapter": {
    "number": 13,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ ἐκπορευομένου αὐτοῦ ἐκ τοῦ ἱεροῦ λέγει αὐτῷ εἷς τῶν μαθητῶν αὐτοῦ· Διδάσκαλε, ἴδε ποταποὶ λίθοι καὶ ποταπαὶ οἰκοδομαί."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ ὁ ⸀Ἰησοῦς",
          {
            "noteId": 725
          },
          "εἶπεν αὐτῷ· Βλέπεις ταύτας τὰς μεγάλας οἰκοδομάς; οὐ μὴ ἀφεθῇ ⸀ὧδε",
          {
            "noteId": 726
          },
          "λίθος ἐπὶ ⸀λίθον",
          {
            "noteId": 727
          },
          "ὃς οὐ μὴ καταλυθῇ."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Καὶ καθημένου αὐτοῦ εἰς τὸ Ὄρος τῶν Ἐλαιῶν κατέναντι τοῦ ἱεροῦ ⸀ἐπηρώτα",
          {
            "noteId": 728
          },
          "αὐτὸν κατʼ ἰδίαν Πέτρος καὶ Ἰάκωβος καὶ Ἰωάννης καὶ Ἀνδρέας·"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Εἰπὸν ἡμῖν πότε ταῦτα ἔσται, καὶ τί τὸ σημεῖον ὅταν μέλλῃ ⸂ταῦτα συντελεῖσθαι πάντα",
          {
            "noteId": 729
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ὁ δὲ Ἰησοῦς ⸂ἤρξατο λέγειν αὐτοῖς",
          {
            "noteId": 730
          },
          "· Βλέπετε μή τις ὑμᾶς πλανήσῃ·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "⸀πολλοὶ",
          {
            "noteId": 731
          },
          "ἐλεύσονται ἐπὶ τῷ ὀνόματί μου λέγοντες ὅτι Ἐγώ εἰμι, καὶ πολλοὺς πλανήσουσιν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ὅταν δὲ ⸀ἀκούσητε",
          {
            "noteId": 732
          },
          "πολέμους καὶ ἀκοὰς πολέμων, μὴ θροεῖσθε· ⸀δεῖ",
          {
            "noteId": 733
          },
          "γενέσθαι, ἀλλʼ οὔπω τὸ τέλος."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἐγερθήσεται γὰρ ἔθνος ἐπʼ ἔθνος καὶ βασιλεία ἐπὶ βασιλείαν, ⸀ἔσονται",
          {
            "noteId": 734
          },
          "σεισμοὶ κατὰ τόπους, ⸁ἔσονται",
          {
            "noteId": 735
          },
          "⸀λιμοί",
          {
            "noteId": 736
          },
          "⸀ἀρχὴ",
          {
            "noteId": 737
          },
          "ὠδίνων ταῦτα."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "βλέπετε δὲ ὑμεῖς ἑαυτούς· ⸀παραδώσουσιν",
          {
            "noteId": 738
          },
          "ὑμᾶς εἰς συνέδρια καὶ εἰς συναγωγὰς δαρήσεσθε καὶ ἐπὶ ἡγεμόνων καὶ βασιλέων σταθήσεσθε ἕνεκεν ἐμοῦ εἰς μαρτύριον αὐτοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ εἰς πάντα τὰ ἔθνη ⸂πρῶτον δεῖ",
          {
            "noteId": 739
          },
          "κηρυχθῆναι τὸ εὐαγγέλιον."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "⸂καὶ ὅταν",
          {
            "noteId": 740
          },
          "⸀ἄγωσιν",
          {
            "noteId": 741
          },
          "ὑμᾶς παραδιδόντες, μὴ προμεριμνᾶτε τί ⸀λαλήσητε",
          {
            "noteId": 742
          },
          "ἀλλʼ ὃ ἐὰν δοθῇ ὑμῖν ἐν ἐκείνῃ τῇ ὥρᾳ τοῦτο λαλεῖτε, οὐ γάρ ἐστε ὑμεῖς οἱ λαλοῦντες ἀλλὰ τὸ πνεῦμα τὸ ἅγιον."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "⸂καὶ παραδώσει",
          {
            "noteId": 743
          },
          "ἀδελφὸς ἀδελφὸν εἰς θάνατον καὶ πατὴρ τέκνον, καὶ ἐπαναστήσονται τέκνα ἐπὶ γονεῖς καὶ θανατώσουσιν αὐτούς·"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ ἔσεσθε μισούμενοι ὑπὸ πάντων διὰ τὸ ὄνομά μου. ὁ δὲ ὑπομείνας εἰς τέλος οὗτος σωθήσεται."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Ὅταν δὲ ἴδητε τὸ βδέλυγμα τῆς ἐρημώσεως ⸀ἑστηκότα",
          {
            "noteId": 744
          },
          "ὅπου οὐ δεῖ, ὁ ἀναγινώσκων νοείτω, τότε οἱ ἐν τῇ Ἰουδαίᾳ φευγέτωσαν εἰς τὰ ὄρη,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "⸀ὁ",
          {
            "noteId": 745
          },
          "ἐπὶ τοῦ δώματος μὴ ⸀καταβάτω",
          {
            "noteId": 746
          },
          "μηδὲ εἰσελθάτω ⸂τι ἆραι",
          {
            "noteId": 747
          },
          "ἐκ τῆς οἰκίας αὐτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ ὁ εἰς τὸν ⸀ἀγρὸν",
          {
            "noteId": 748
          },
          "μὴ ἐπιστρεψάτω εἰς τὰ ὀπίσω ἆραι τὸ ἱμάτιον αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "οὐαὶ δὲ ταῖς ἐν γαστρὶ ἐχούσαις καὶ ταῖς θηλαζούσαις ἐν ἐκείναις ταῖς ἡμέραις."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "προσεύχεσθε δὲ ἵνα μὴ ⸀γένηται",
          {
            "noteId": 749
          },
          "χειμῶνος·"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἔσονται γὰρ αἱ ἡμέραι ἐκεῖναι θλῖψις οἵα οὐ γέγονεν τοιαύτη ἀπʼ ἀρχῆς κτίσεως ⸀ἣν",
          {
            "noteId": 750
          },
          "ἔκτισεν ὁ θεὸς ἕως τοῦ νῦν καὶ οὐ μὴ γένηται."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "καὶ εἰ μὴ ⸂ἐκολόβωσεν κύριος",
          {
            "noteId": 751
          },
          "τὰς ἡμέρας, οὐκ ἂν ἐσώθη πᾶσα σάρξ. ἀλλὰ διὰ τοὺς ἐκλεκτοὺς οὓς ἐξελέξατο ἐκολόβωσεν τὰς ἡμέρας."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "⸀καὶ",
          {
            "noteId": 752
          },
          "τότε ἐάν τις ὑμῖν εἴπῃ· ⸀Ἴδε",
          {
            "noteId": 753
          },
          "ὧδε ὁ ⸀χριστός",
          {
            "noteId": 754
          },
          "⸁Ἴδε",
          {
            "noteId": 755
          },
          "ἐκεῖ, μὴ πιστεύετε·"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ἐγερθήσονται γὰρ ψευδόχριστοι καὶ ψευδοπροφῆται καὶ δώσουσιν σημεῖα καὶ τέρατα πρὸς τὸ ἀποπλανᾶν εἰ ⸀δυνατὸν",
          {
            "noteId": 756
          },
          "τοὺς ἐκλεκτούς·"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ὑμεῖς δὲ βλέπετε· ⸀προείρηκα",
          {
            "noteId": 757
          },
          "ὑμῖν πάντα."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Ἀλλὰ ἐν ἐκείναις ταῖς ἡμέραις μετὰ τὴν θλῖψιν ἐκείνην ὁ ἥλιος σκοτισθήσεται, καὶ ἡ σελήνη οὐ δώσει τὸ φέγγος αὐτῆς,"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "καὶ οἱ ἀστέρες ⸂ἔσονται ἐκ τοῦ οὐρανοῦ πίπτοντες",
          {
            "noteId": 758
          },
          ", καὶ αἱ δυνάμεις αἱ ἐν τοῖς οὐρανοῖς σαλευθήσονται."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "καὶ τότε ὄψονται τὸν υἱὸν τοῦ ἀνθρώπου ἐρχόμενον ἐν νεφέλαις μετὰ δυνάμεως πολλῆς καὶ δόξης·"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "καὶ τότε ἀποστελεῖ τοὺς ⸀ἀγγέλους",
          {
            "noteId": 759
          },
          "καὶ ἐπισυνάξει τοὺς ⸀ἐκλεκτοὺς",
          {
            "noteId": 760
          },
          "ἐκ τῶν τεσσάρων ἀνέμων ἀπʼ ἄκρου γῆς ἕως ἄκρου οὐρανοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Ἀπὸ δὲ τῆς συκῆς μάθετε τὴν παραβολήν· ὅταν ⸂ἤδη ὁ κλάδος αὐτῆς",
          {
            "noteId": 761
          },
          "ἁπαλὸς γένηται καὶ ἐκφύῃ τὰ φύλλα, γινώσκετε ὅτι ἐγγὺς τὸ θέρος ἐστίν·"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "οὕτως καὶ ὑμεῖς, ὅταν ⸂ἴδητε ταῦτα",
          {
            "noteId": 762
          },
          "γινόμενα, γινώσκετε ὅτι ἐγγύς ἐστιν ἐπὶ θύραις."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ἀμὴν λέγω ὑμῖν ὅτι οὐ μὴ παρέλθῃ ἡ γενεὰ αὕτη μέχρις οὗ ⸂ταῦτα πάντα",
          {
            "noteId": 763
          },
          "γένηται."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "ὁ οὐρανὸς καὶ ἡ γῆ ⸀παρελεύσονται",
          {
            "noteId": 764
          },
          "οἱ δὲ λόγοι μου οὐ ⸀μὴ",
          {
            "noteId": 765
          },
          "⸁παρελεύσονται",
          {
            "noteId": 766
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Περὶ δὲ τῆς",
          {
            "noteId": 767
          },
          "ἡμέρας ἐκείνης ἢ ⸀τῆς ὥρας οὐδεὶς οἶδεν, οὐδὲ οἱ ἄγγελοι ⸀ἐν",
          {
            "noteId": 768
          },
          "οὐρανῷ οὐδὲ ὁ υἱός, εἰ μὴ ὁ πατήρ."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "βλέπετε ⸀ἀγρυπνεῖτε",
          {
            "noteId": 769
          },
          "οὐκ οἴδατε γὰρ πότε ὁ καιρός ἐστιν·"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "ὡς ἄνθρωπος ἀπόδημος ἀφεὶς τὴν οἰκίαν αὐτοῦ καὶ δοὺς τοῖς δούλοις αὐτοῦ τὴν ἐξουσίαν, ⸀ἑκάστῳ",
          {
            "noteId": 770
          },
          "τὸ ἔργον αὐτοῦ, καὶ τῷ θυρωρῷ ἐνετείλατο ἵνα γρηγορῇ."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "γρηγορεῖτε οὖν, οὐκ οἴδατε γὰρ πότε ὁ κύριος τῆς οἰκίας ἔρχεται, ⸀ἢ",
          {
            "noteId": 771
          },
          "ὀψὲ ἢ ⸀μεσονύκτιον",
          {
            "noteId": 772
          },
          "ἢ ἀλεκτοροφωνίας ἢ πρωΐ,"
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "μὴ ἐλθὼν ἐξαίφνης εὕρῃ ὑμᾶς καθεύδοντας·"
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "⸀ὃ",
          {
            "noteId": 773
          },
          "δὲ ὑμῖν λέγω πᾶσιν λέγω· γρηγορεῖτε."
        ]
      }
    ],
