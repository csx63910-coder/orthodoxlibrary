    "order": 41,
    "numberOfChapters": 16,
    "sha256": "ee722f87ff9aab21a727f6cc520396de636d5b4c31becbd87dc005960b7fc69a",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_sbl/MRK/1.json",
    "lastChapterNumber": 16,
    "lastChapterApiLink": "/api/grc_sbl/MRK/16.json",
    "totalNumberOfVerses": 673
  },
  "chapter": {
    "number": 12,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ ἤρξατο αὐτοῖς ἐν παραβολαῖς ⸀λαλεῖν",
          {
            "noteId": 662
          },
          "Ἀμπελῶνα ⸂ἄνθρωπος ἐφύτευσεν",
          {
            "noteId": 663
          },
          ", καὶ περιέθηκεν φραγμὸν καὶ ὤρυξεν ὑπολήνιον καὶ ᾠκοδόμησεν πύργον, καὶ ἐξέδετο αὐτὸν γεωργοῖς, καὶ ἀπεδήμησεν."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ ἀπέστειλεν πρὸς τοὺς γεωργοὺς τῷ καιρῷ δοῦλον, ἵνα παρὰ τῶν γεωργῶν λάβῃ ἀπὸ ⸂τῶν καρπῶν",
          {
            "noteId": 664
          },
          "τοῦ ἀμπελῶνος·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "⸀καὶ",
          {
            "noteId": 665
          },
          "λαβόντες αὐτὸν ἔδειραν καὶ ἀπέστειλαν κενόν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ πάλιν ἀπέστειλεν πρὸς αὐτοὺς ἄλλον δοῦλον· ⸀κἀκεῖνον",
          {
            "noteId": 666
          },
          "⸀ἐκεφαλίωσαν",
          {
            "noteId": 667
          },
          "καὶ ⸀ἠτίμασαν",
          {
            "noteId": 668
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "⸀καὶ",
          {
            "noteId": 669
          },
          "ἄλλον ἀπέστειλεν· κἀκεῖνον ἀπέκτειναν, καὶ πολλοὺς ἄλλους, ⸂οὓς μὲν δέροντες οὓς δὲ ἀποκτέννοντες",
          {
            "noteId": 670
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἔτι ⸂ἕνα εἶχεν, υἱὸν ἀγαπητόν· ἀπέστειλεν",
          {
            "noteId": 671
          },
          "αὐτὸν ⸂ἔσχατον πρὸς αὐτοὺς",
          {
            "noteId": 672
          },
          "λέγων ὅτι Ἐντραπήσονται τὸν υἱόν μου."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἐκεῖνοι δὲ οἱ γεωργοὶ ⸂πρὸς ἑαυτοὺς εἶπαν",
          {
            "noteId": 673
          },
          "ὅτι Οὗτός ἐστιν ὁ κληρονόμος· δεῦτε ἀποκτείνωμεν αὐτόν, καὶ ἡμῶν ἔσται ἡ κληρονομία."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ λαβόντες ⸂ἀπέκτειναν αὐτόν, καὶ ἐξέβαλον αὐτὸν",
          {
            "noteId": 674
          },
          "ἔξω τοῦ ἀμπελῶνος."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "⸀τί",
          {
            "noteId": 675
          },
          "ποιήσει ὁ κύριος τοῦ ἀμπελῶνος; ἐλεύσεται καὶ ἀπολέσει τοὺς γεωργούς, καὶ δώσει τὸν ἀμπελῶνα ἄλλοις."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "οὐδὲ τὴν γραφὴν ταύτην ἀνέγνωτε· Λίθον ὃν ἀπεδοκίμασαν οἱ οἰκοδομοῦντες, οὗτος ἐγενήθη εἰς κεφαλὴν γωνίας·"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "παρὰ κυρίου ἐγένετο αὕτη, καὶ ἔστιν θαυμαστὴ ἐν ὀφθαλμοῖς ἡμῶν;"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Καὶ ἐζήτουν αὐτὸν κρατῆσαι, καὶ ἐφοβήθησαν τὸν ὄχλον, ἔγνωσαν γὰρ ὅτι πρὸς αὐτοὺς τὴν παραβολὴν εἶπεν. καὶ ἀφέντες αὐτὸν ἀπῆλθον."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Καὶ ἀποστέλλουσιν πρὸς αὐτόν τινας τῶν Φαρισαίων καὶ τῶν Ἡρῳδιανῶν ἵνα αὐτὸν ἀγρεύσωσιν λόγῳ."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "⸀καὶ",
          {
            "noteId": 676
          },
          "ἐλθόντες λέγουσιν αὐτῷ· Διδάσκαλε, οἴδαμεν ὅτι ἀληθὴς εἶ καὶ οὐ μέλει σοι περὶ οὐδενός, οὐ γὰρ βλέπεις εἰς πρόσωπον ἀνθρώπων, ἀλλʼ ἐπʼ ἀληθείας τὴν ὁδὸν τοῦ θεοῦ διδάσκεις· ἔξεστιν ⸂δοῦναι κῆνσον Καίσαρι",
          {
            "noteId": 677
          },
          "ἢ οὔ; δῶμεν ἢ μὴ δῶμεν;"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ὁ δὲ εἰδὼς αὐτῶν τὴν ὑπόκρισιν εἶπεν αὐτοῖς· Τί με πειράζετε; φέρετέ μοι δηνάριον ἵνα ἴδω."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "οἱ δὲ ἤνεγκαν. καὶ λέγει αὐτοῖς· Τίνος ἡ εἰκὼν αὕτη καὶ ἡ ἐπιγραφή; οἱ δὲ εἶπαν αὐτῷ· Καίσαρος."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "⸂ὁ δὲ",
          {
            "noteId": 678
          },
          "Ἰησοῦς εἶπεν ⸀αὐτοῖς",
          {
            "noteId": 679
          },
          "⸂Τὰ Καίσαρος ἀπόδοτε",
          {
            "noteId": 680
          },
          "Καίσαρι καὶ τὰ τοῦ θεοῦ τῷ θεῷ. καὶ ⸀ἐξεθαύμαζον",
          {
            "noteId": 681
          },
          "ἐπʼ αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Καὶ ἔρχονται Σαδδουκαῖοι πρὸς αὐτόν, οἵτινες λέγουσιν ἀνάστασιν μὴ εἶναι, καὶ ⸀ἐπηρώτων",
          {
            "noteId": 682
          },
          "αὐτὸν λέγοντες·"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Διδάσκαλε, Μωϋσῆς ἔγραψεν ἡμῖν ὅτι ἐάν τινος ἀδελφὸς ἀποθάνῃ καὶ καταλίπῃ γυναῖκα καὶ ⸂μὴ ἀφῇ τέκνον",
          {
            "noteId": 683
          },
          ", ἵνα λάβῃ ὁ ἀδελφὸς αὐτοῦ τὴν ⸀γυναῖκα",
          {
            "noteId": 684
          },
          "καὶ ἐξαναστήσῃ σπέρμα τῷ ἀδελφῷ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἑπτὰ ἀδελφοὶ ἦσαν· καὶ ὁ πρῶτος ἔλαβεν γυναῖκα, καὶ ἀποθνῄσκων οὐκ ἀφῆκεν σπέρμα·"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "καὶ ὁ δεύτερος ἔλαβεν αὐτήν, καὶ ἀπέθανεν ⸂μὴ καταλιπὼν",
          {
            "noteId": 685
          },
          "σπέρμα, καὶ ὁ τρίτος ὡσαύτως·"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "καὶ ⸂οἱ ἑπτὰ",
          {
            "noteId": 686
          },
          "οὐκ ἀφῆκαν σπέρμα· ⸀ἔσχατον",
          {
            "noteId": 687
          },
          "πάντων ⸂καὶ ἡ γυνὴ ἀπέθανεν",
          {
            "noteId": 688
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ἐν τῇ ἀναστάσει ⸂ὅταν ἀναστῶσιν",
          {
            "noteId": 689
          },
          "τίνος αὐτῶν ἔσται γυνή; οἱ γὰρ ἑπτὰ ἔσχον αὐτὴν γυναῖκα."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "⸂ἔφη αὐτοῖς ὁ Ἰησοῦς",
          {
            "noteId": 690
          },
          "· Οὐ διὰ τοῦτο πλανᾶσθε μὴ εἰδότες τὰς γραφὰς μηδὲ τὴν δύναμιν τοῦ θεοῦ;"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ὅταν γὰρ ἐκ νεκρῶν ἀναστῶσιν, οὔτε γαμοῦσιν οὔτε ⸀γαμίζονται",
          {
            "noteId": 691
          },
          "ἀλλʼ εἰσὶν ὡς ⸀ἄγγελοι",
          {
            "noteId": 692
          },
          "ἐν τοῖς οὐρανοῖς·"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "περὶ δὲ τῶν νεκρῶν ὅτι ἐγείρονται οὐκ ἀνέγνωτε ἐν τῇ βίβλῳ Μωϋσέως ἐπὶ τοῦ βάτου ⸀πῶς",
          {
            "noteId": 693
          },
          "εἶπεν αὐτῷ ὁ θεὸς λέγων· Ἐγὼ ὁ θεὸς Ἀβραὰμ καὶ ⸂ὁ θεὸς Ἰσαὰκ καὶ ὁ",
          {
            "noteId": 694
          },
          "θεὸς Ἰακώβ;"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "οὐκ ἔστιν ⸀θεὸς",
          {
            "noteId": 695
          },
          "νεκρῶν ⸀ἀλλὰ",
          {
            "noteId": 696
          },
          "ζώντων· ⸀πολὺ",
          {
            "noteId": 697
          },
          "πλανᾶσθε."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Καὶ προσελθὼν εἷς τῶν γραμματέων ἀκούσας αὐτῶν συζητούντων, ⸀ἰδὼν",
          {
            "noteId": 698
          },
          "ὅτι καλῶς ⸂ἀπεκρίθη αὐτοῖς",
          {
            "noteId": 699
          },
          ", ἐπηρώτησεν αὐτόν· Ποία ἐστὶν ⸂ἐντολὴ πρώτη πάντων",
          {
            "noteId": 700
          },
          ";"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "⸂ἀπεκρίθη ὁ Ἰησοῦς",
          {
            "noteId": 701
          },
          "ὅτι Πρώτη ⸀ἐστίν",
          {
            "noteId": 702
          },
          "Ἄκουε, Ἰσραήλ, κύριος ὁ θεὸς ἡμῶν κύριος εἷς ἐστιν,"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "καὶ ἀγαπήσεις κύριον τὸν θεόν σου ἐξ ὅλης ⸀τῆς",
          {
            "noteId": 703
          },
          "καρδίας σου",
          {
            "noteId": 704
          },
          "καὶ ἐξ ὅλης τῆς ψυχῆς σου καὶ ἐξ ὅλης τῆς διανοίας σου καὶ ἐξ ὅλης τῆς ἰσχύος ⸀σου."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "⸀δευτέρα",
          {
            "noteId": 705
          },
          "αὕτη· Ἀγαπήσεις τὸν πλησίον σου ὡς σεαυτόν. μείζων τούτων ἄλλη ἐντολὴ οὐκ ἔστιν."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "⸀καὶ",
          {
            "noteId": 706
          },
          "εἶπεν αὐτῷ ὁ γραμματεύς· Καλῶς, διδάσκαλε, ἐπʼ ἀληθείας εἶπες ὅτι εἷς ἐστιν καὶ οὐκ ἔστιν ἄλλος πλὴν αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "καὶ τὸ ἀγαπᾶν αὐτὸν ἐξ ὅλης ⸀τῆς",
          {
            "noteId": 707
          },
          "καρδίας καὶ ἐξ ὅλης τῆς ⸀συνέσεως",
          {
            "noteId": 708
          },
          "καὶ ἐξ ὅλης τῆς ἰσχύος καὶ τὸ ἀγαπᾶν τὸν πλησίον ὡς ἑαυτὸν ⸀περισσότερόν",
          {
            "noteId": 709
          },
          "ἐστιν πάντων τῶν ὁλοκαυτωμάτων καὶ θυσιῶν."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "καὶ ὁ Ἰησοῦς ἰδὼν ⸀αὐτὸν",
          {
            "noteId": 710
          },
          "ὅτι νουνεχῶς ἀπεκρίθη εἶπεν αὐτῷ· Οὐ μακρὰν εἶ ἀπὸ τῆς βασιλείας τοῦ θεοῦ. καὶ οὐδεὶς οὐκέτι ἐτόλμα αὐτὸν ἐπερωτῆσαι."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "Καὶ ἀποκριθεὶς ὁ Ἰησοῦς ἔλεγεν διδάσκων ἐν τῷ ἱερῷ· Πῶς λέγουσιν οἱ γραμματεῖς ὅτι ὁ χριστὸς υἱὸς ⸂Δαυίδ ἐστιν",
          {
            "noteId": 711
          },
          ";"
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "⸀αὐτὸς",
          {
            "noteId": 712
          },
          "Δαυὶδ εἶπεν ἐν ⸂τῷ πνεύματι τῷ",
          {
            "noteId": 713
          },
          "ἁγίῳ· ⸀Εἶπεν",
          {
            "noteId": 714
          },
          "⸀κύριος",
          {
            "noteId": 715
          },
          "τῷ κυρίῳ μου· ⸀Κάθου",
          {
            "noteId": 716
          },
          "ἐκ δεξιῶν μου ἕως ἂν θῶ τοὺς ἐχθρούς σου ⸀ὑποκάτω",
          {
            "noteId": 717
          },
          "τῶν ποδῶν σου."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "⸀αὐτὸς",
          {
            "noteId": 718
          },
          "Δαυὶδ λέγει αὐτὸν κύριον, καὶ πόθεν ⸂αὐτοῦ ἐστιν υἱός",
          {
            "noteId": 719
          },
          "; καὶ ὁ πολὺς ὄχλος ἤκουεν αὐτοῦ ἡδέως."
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "Καὶ ⸂ἐν τῇ διδαχῇ αὐτοῦ ἔλεγεν",
          {
            "noteId": 720
          },
          "· Βλέπετε ἀπὸ τῶν γραμματέων τῶν θελόντων ἐν στολαῖς περιπατεῖν καὶ ἀσπασμοὺς ἐν ταῖς ἀγοραῖς"
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "καὶ πρωτοκαθεδρίας ἐν ταῖς συναγωγαῖς καὶ πρωτοκλισίας ἐν τοῖς δείπνοις,"
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "οἱ κατεσθίοντες τὰς οἰκίας τῶν χηρῶν καὶ προφάσει μακρὰ προσευχόμενοι· οὗτοι λήμψονται περισσότερον κρίμα."
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "Καὶ ⸀καθίσας",
          {
            "noteId": 721
          },
          "⸀κατέναντι",
          {
            "noteId": 722
          },
          "τοῦ γαζοφυλακίου ἐθεώρει πῶς ὁ ὄχλος βάλλει χαλκὸν εἰς τὸ γαζοφυλάκιον· καὶ πολλοὶ πλούσιοι ἔβαλλον πολλά·"
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "καὶ ἐλθοῦσα μία χήρα πτωχὴ ἔβαλεν λεπτὰ δύο, ὅ ἐστιν κοδράντης."
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "καὶ προσκαλεσάμενος τοὺς μαθητὰς αὐτοῦ ⸀εἶπεν",
          {
            "noteId": 723
          },
          "αὐτοῖς· Ἀμὴν λέγω ὑμῖν ὅτι ἡ χήρα αὕτη ἡ πτωχὴ πλεῖον πάντων ⸀ἔβαλεν",
          {
            "noteId": 724
          },
          "τῶν βαλλόντων εἰς τὸ γαζοφυλάκιον·"
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "πάντες γὰρ ἐκ τοῦ περισσεύοντος αὐτοῖς ἔβαλον, αὕτη δὲ ἐκ τῆς ὑστερήσεως αὐτῆς πάντα ὅσα εἶχεν ἔβαλεν, ὅλον τὸν βίον αὐτῆς."
        ]
      }
    ],
