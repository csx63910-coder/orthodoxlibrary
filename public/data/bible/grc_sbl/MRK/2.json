  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ ⸀εἰσελθὼν",
          {
            "noteId": 64
          },
          "πάλιν εἰς Καφαρναοὺμ διʼ ⸀ἡμερῶν",
          {
            "noteId": 65
          },
          "ἠκούσθη ὅτι ⸂ἐν οἴκῳ",
          {
            "noteId": 66
          },
          "ἐστίν·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "⸀καὶ",
          {
            "noteId": 67
          },
          "συνήχθησαν πολλοὶ ὥστε μηκέτι χωρεῖν μηδὲ τὰ πρὸς τὴν θύραν, καὶ ἐλάλει αὐτοῖς τὸν λόγον."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ ἔρχονται ⸂φέροντες πρὸς αὐτὸν παραλυτικὸν",
          {
            "noteId": 68
          },
          "αἰρόμενον ὑπὸ τεσσάρων."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ μὴ δυνάμενοι ⸀προσενέγκαι",
          {
            "noteId": 69
          },
          "αὐτῷ διὰ τὸν ὄχλον ἀπεστέγασαν τὴν στέγην ὅπου",
          {
            "noteId": 70
          },
          "ἦν, καὶ ἐξορύξαντες χαλῶσι τὸν κράβαττον ⸀ὅπου ὁ παραλυτικὸς κατέκειτο."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "⸂καὶ ἰδὼν",
          {
            "noteId": 71
          },
          "ὁ Ἰησοῦς τὴν πίστιν αὐτῶν λέγει τῷ παραλυτικῷ· Τέκνον, ⸂ἀφίενταί σου",
          {
            "noteId": 72
          },
          "αἱ ⸀ἁμαρτίαι",
          {
            "noteId": 73
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἦσαν δέ τινες τῶν γραμματέων ἐκεῖ καθήμενοι καὶ διαλογιζόμενοι ἐν ταῖς καρδίαις αὐτῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Τί οὗτος οὕτως λαλεῖ; ⸀βλασφημεῖ",
          {
            "noteId": 74
          },
          "τίς δύναται ἀφιέναι ἁμαρτίας εἰ μὴ εἷς ὁ θεός;"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ ⸀εὐθὺς",
          {
            "noteId": 75
          },
          "ἐπιγνοὺς ὁ Ἰησοῦς τῷ πνεύματι αὐτοῦ ὅτι ⸀οὕτως",
          {
            "noteId": 76
          },
          "διαλογίζονται ἐν ἑαυτοῖς ⸀λέγει",
          {
            "noteId": 77
          },
          "αὐτοῖς· Τί ταῦτα διαλογίζεσθε ἐν ταῖς καρδίαις ὑμῶν;"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "τί ἐστιν εὐκοπώτερον, εἰπεῖν τῷ παραλυτικῷ· ⸀Ἀφίενταί",
          {
            "noteId": 78
          },
          "σου αἱ ἁμαρτίαι, ἢ εἰπεῖν· ⸀Ἔγειρε",
          {
            "noteId": 79
          },
          "καὶ ἆρον ⸂τὸν κράβαττόν σου",
          {
            "noteId": 80
          },
          "καὶ περιπάτει;"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἵνα δὲ εἰδῆτε ὅτι ἐξουσίαν ἔχει ὁ υἱὸς τοῦ ἀνθρώπου ⸂ἐπὶ τῆς γῆς ἀφιέναι ἁμαρτίας",
          {
            "noteId": 81
          },
          "— λέγει τῷ παραλυτικῷ·"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Σοὶ λέγω, ⸀ἔγειρε",
          {
            "noteId": 82
          },
          "ἆρον τὸν κράβαττόν σου καὶ ὕπαγε εἰς τὸν οἶκόν σου."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "καὶ ἠγέρθη ⸂καὶ εὐθὺς",
          {
            "noteId": 83
          },
          "ἄρας τὸν κράβαττον ἐξῆλθεν ⸀ἔμπροσθεν",
          {
            "noteId": 84
          },
          "πάντων, ὥστε ἐξίστασθαι πάντας καὶ δοξάζειν τὸν θεὸν λέγοντας ὅτι ⸂Οὕτως οὐδέποτε",
          {
            "noteId": 85
          },
          "εἴδομεν."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Καὶ ἐξῆλθεν πάλιν παρὰ τὴν θάλασσαν· καὶ πᾶς ὁ ὄχλος ἤρχετο πρὸς αὐτόν, καὶ ἐδίδασκεν αὐτούς."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καὶ παράγων εἶδεν Λευὶν τὸν τοῦ Ἁλφαίου καθήμενον ἐπὶ τὸ τελώνιον, καὶ λέγει αὐτῷ· Ἀκολούθει μοι. καὶ ἀναστὰς ἠκολούθησεν αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Καὶ ⸀γίνεται",
          {
            "noteId": 86
          },
          "κατακεῖσθαι αὐτὸν ἐν τῇ οἰκίᾳ αὐτοῦ, καὶ πολλοὶ τελῶναι καὶ ἁμαρτωλοὶ συνανέκειντο τῷ Ἰησοῦ καὶ τοῖς μαθηταῖς αὐτοῦ, ἦσαν γὰρ πολλοὶ καὶ ⸀ἠκολούθουν",
          {
            "noteId": 87
          },
          "αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ οἱ γραμματεῖς ⸂τῶν Φαρισαίων",
          {
            "noteId": 88
          },
          "⸀ἰδόντες",
          {
            "noteId": 89
          },
          "⸂ὅτι ἐσθίει",
          {
            "noteId": 90
          },
          "μετὰ τῶν ⸂ἁμαρτωλῶν καὶ τελωνῶν",
          {
            "noteId": 91
          },
          "ἔλεγον τοῖς μαθηταῖς αὐτοῦ· ⸀Ὅτι",
          {
            "noteId": 92
          },
          "μετὰ τῶν ⸂τελωνῶν καὶ ἁμαρτωλῶν",
          {
            "noteId": 93
          },
          "⸀ἐσθίει",
          {
            "noteId": 94
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καὶ ἀκούσας ὁ Ἰησοῦς λέγει αὐτοῖς ⸀ὅτι",
          {
            "noteId": 95
          },
          "Οὐ χρείαν ἔχουσιν οἱ ἰσχύοντες ἰατροῦ ἀλλʼ οἱ κακῶς ἔχοντες· οὐκ ἦλθον καλέσαι δικαίους ἀλλὰ ⸀ἁμαρτωλούς",
          {
            "noteId": 96
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Καὶ ἦσαν οἱ μαθηταὶ Ἰωάννου καὶ οἱ ⸀Φαρισαῖοι",
          {
            "noteId": 97
          },
          "νηστεύοντες. καὶ ἔρχονται καὶ λέγουσιν αὐτῷ· Διὰ τί οἱ μαθηταὶ",
          {
            "noteId": 98
          },
          "Ἰωάννου καὶ οἱ ⸀μαθηταὶ τῶν Φαρισαίων νηστεύουσιν, οἱ δὲ σοὶ μαθηταὶ οὐ νηστεύουσιν;"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "καὶ εἶπεν αὐτοῖς ὁ Ἰησοῦς· Μὴ δύνανται οἱ υἱοὶ τοῦ νυμφῶνος ἐν ᾧ ὁ νυμφίος μετʼ αὐτῶν ἐστιν νηστεύειν; ὅσον χρόνον ⸂ἔχουσιν τὸν νυμφίον μετʼ αὐτῶν",
          {
            "noteId": 99
          },
          "οὐ δύνανται νηστεύειν·"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἐλεύσονται δὲ ἡμέραι ὅταν ἀπαρθῇ ἀπʼ αὐτῶν ὁ νυμφίος, καὶ τότε νηστεύσουσιν ἐν ⸂ἐκείνῃ τῇ ἡμέρᾳ",
          {
            "noteId": 100
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "⸀Οὐδεὶς",
          {
            "noteId": 101
          },
          "ἐπίβλημα ῥάκους ἀγνάφου ἐπιράπτει ἐπὶ ⸂ἱμάτιον παλαιόν",
          {
            "noteId": 102
          },
          "· εἰ δὲ μή, αἴρει τὸ πλήρωμα ⸀ἀπʼ",
          {
            "noteId": 103
          },
          "αὐτοῦ τὸ καινὸν τοῦ παλαιοῦ, καὶ χεῖρον σχίσμα γίνεται."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "καὶ οὐδεὶς βάλλει οἶνον νέον εἰς ἀσκοὺς παλαιούς· εἰ δὲ μή, ⸂ῥήξει ὁ οἶνος",
          {
            "noteId": 104
          },
          "τοὺς ἀσκούς, καὶ ὁ οἶνος ⸂ἀπόλλυται καὶ οἱ ἀσκοί",
          {
            "noteId": 105
          },
          ". ἀλλὰ οἶνον νέον εἰς ἀσκοὺς ⸀καινούς",
          {
            "noteId": 106
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Καὶ ἐγένετο ⸂αὐτὸν ἐν τοῖς σάββασιν παραπορεύεσθαι",
          {
            "noteId": 107
          },
          "διὰ τῶν σπορίμων, καὶ ⸂οἱ μαθηταὶ αὐτοῦ ἤρξαντο",
          {
            "noteId": 108
          },
          "ὁδὸν ποιεῖν τίλλοντες τοὺς στάχυας."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "καὶ οἱ Φαρισαῖοι ἔλεγον αὐτῷ· Ἴδε τί ⸀ποιοῦσιν",
          {
            "noteId": 109
          },
          "τοῖς σάββασιν ὃ οὐκ ἔξεστιν;"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "καὶ ⸀λέγει",
          {
            "noteId": 110
          },
          "αὐτοῖς· Οὐδέποτε ἀνέγνωτε τί ἐποίησεν Δαυὶδ ὅτε χρείαν ἔσχεν καὶ ἐπείνασεν αὐτὸς καὶ οἱ μετʼ αὐτοῦ;"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "⸀πῶς",
          {
            "noteId": 111
          },
          "εἰσῆλθεν εἰς τὸν οἶκον τοῦ θεοῦ ἐπὶ Ἀβιαθὰρ ἀρχιερέως καὶ τοὺς ἄρτους τῆς προθέσεως ἔφαγεν, οὓς οὐκ ἔξεστιν φαγεῖν εἰ μὴ ⸂τοὺς ἱερεῖς",
          {
            "noteId": 112
          },
          ", καὶ ἔδωκεν καὶ τοῖς σὺν αὐτῷ οὖσιν;"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "καὶ",
          {
            "noteId": 113
          },
          "ἔλεγεν αὐτοῖς· Τὸ σάββατον διὰ τὸν ἄνθρωπον ἐγένετο ⸀καὶ οὐχ ὁ ἄνθρωπος διὰ τὸ σάββατον·"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ὥστε κύριός ἐστιν ὁ υἱὸς τοῦ ἀνθρώπου καὶ τοῦ σαββάτου."
        ]
      }
    ],
