  "chapter": {
    "number": 16,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ διαγενομένου τοῦ σαββάτου ⸀Μαρία",
          {
            "noteId": 915
          },
          "ἡ Μαγδαληνὴ καὶ Μαρία ⸂ἡ τοῦ",
          {
            "noteId": 916
          },
          "Ἰακώβου καὶ Σαλώμη ἠγόρασαν ἀρώματα ἵνα ἐλθοῦσαι ἀλείψωσιν αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ λίαν πρωῒ ⸂τῇ μιᾷ τῶν",
          {
            "noteId": 917
          },
          "σαββάτων ἔρχονται ἐπὶ τὸ μνημεῖον ἀνατείλαντος τοῦ ἡλίου."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ ἔλεγον πρὸς ἑαυτάς· Τίς ἀποκυλίσει ἡμῖν τὸν λίθον ⸀ἐκ",
          {
            "noteId": 918
          },
          "τῆς θύρας τοῦ μνημείου;"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ ἀναβλέψασαι θεωροῦσιν ὅτι ⸀ἀποκεκύλισται",
          {
            "noteId": 919
          },
          "ὁ λίθος, ἦν γὰρ μέγας σφόδρα."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ εἰσελθοῦσαι εἰς τὸ μνημεῖον εἶδον νεανίσκον καθήμενον ἐν τοῖς δεξιοῖς περιβεβλημένον στολὴν λευκήν, καὶ ἐξεθαμβήθησαν."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ὁ δὲ λέγει αὐταῖς· Μὴ ἐκθαμβεῖσθε· Ἰησοῦν ζητεῖτε τὸν Ναζαρηνὸν τὸν ἐσταυρωμένον· ἠγέρθη, οὐκ ἔστιν ὧδε· ἴδε ὁ τόπος ὅπου ἔθηκαν αὐτόν·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἀλλὰ ὑπάγετε εἴπατε τοῖς μαθηταῖς αὐτοῦ καὶ τῷ Πέτρῳ ὅτι Προάγει ὑμᾶς εἰς τὴν Γαλιλαίαν· ἐκεῖ αὐτὸν ὄψεσθε, καθὼς εἶπεν ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ ἐξελθοῦσαι ἔφυγον ἀπὸ τοῦ μνημείου, εἶχεν ⸀γὰρ",
          {
            "noteId": 920
          },
          "αὐτὰς τρόμος καὶ ἔκστασις· καὶ οὐδενὶ οὐδὲν εἶπαν, ἐφοβοῦντο ⸁γάρ",
          {
            "noteId": 921
          },
          "⟦Πάντα δὲ τὰ παρηγγελμένα τοῖς περὶ τὸν Πέτρον συντόμως ἐξήγγειλαν. μετὰ δὲ ταῦτα καὶ αὐτὸς ὁ Ἰησοῦς ἀπὸ ἀνατολῆς καὶ ἄχρι δύσεως ἐξαπέστειλεν διʼ αὐτῶν τὸ ἱερὸν καὶ ἄφθαρτον κήρυγμα τῆς αἰωνίου σωτηρίας. ἀμήν.⟧"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "noteId": 922
          },
          "Ἀναστὰς δὲ πρωῒ πρώτῃ σαββάτου ἐφάνη πρῶτον Μαρίᾳ τῇ Μαγδαληνῇ, ⸀παρʼ ἧς ἐκβεβλήκει ἑπτὰ δαιμόνια."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἐκείνη πορευθεῖσα ἀπήγγειλεν τοῖς μετʼ αὐτοῦ γενομένοις πενθοῦσι καὶ κλαίουσιν·"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "κἀκεῖνοι ἀκούσαντες ὅτι ζῇ καὶ ἐθεάθη ὑπʼ αὐτῆς ἠπίστησαν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Μετὰ δὲ ταῦτα δυσὶν ἐξ αὐτῶν περιπατοῦσιν ἐφανερώθη ἐν ἑτέρᾳ μορφῇ πορευομένοις εἰς ἀγρόν·"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "κἀκεῖνοι ἀπελθόντες ἀπήγγειλαν τοῖς λοιποῖς· οὐδὲ ἐκείνοις ἐπίστευσαν."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "noteId": 923
          },
          "στερον ⸀δὲ ἀνακειμένοις αὐτοῖς τοῖς ἕνδεκα ἐφανερώθη, καὶ ὠνείδισεν τὴν ἀπιστίαν αὐτῶν καὶ σκληροκαρδίαν ὅτι τοῖς θεασαμένοις αὐτὸν ⸀ἐγηγερμένον",
          {
            "noteId": 924
          },
          "οὐκ ἐπίστευσαν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ εἶπεν αὐτοῖς· Πορευθέντες εἰς τὸν κόσμον ἅπαντα κηρύξατε τὸ εὐαγγέλιον πάσῃ τῇ κτίσει."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ὁ πιστεύσας καὶ βαπτισθεὶς σωθήσεται, ὁ δὲ ἀπιστήσας κατακριθήσεται."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "σημεῖα δὲ τοῖς πιστεύσασιν ⸂ταῦτα παρακολουθήσει",
          {
            "noteId": 925
          },
          ", ἐν τῷ ὀνόματί μου δαιμόνια ἐκβαλοῦσιν, γλώσσαις λαλήσουσιν ⸀καιναῖς",
          {
            "noteId": 926
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "⸀ὄφεις",
          {
            "noteId": 927
          },
          "ἀροῦσιν κἂν θανάσιμόν τι πίωσιν οὐ μὴ αὐτοὺς βλάψῃ, ἐπὶ ἀρρώστους χεῖρας ἐπιθήσουσιν καὶ καλῶς ἕξουσιν."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "noteId": 928
          },
          "μὲν οὖν κύριος ⸀Ἰησοῦς μετὰ τὸ λαλῆσαι αὐτοῖς ἀνελήμφθη εἰς τὸν οὐρανὸν καὶ ἐκάθισεν ἐκ δεξιῶν τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "noteId": 929
          },
          "κεῖνοι δὲ ἐξελθόντες ἐκήρυξαν πανταχοῦ, τοῦ κυρίου συνεργοῦντος καὶ τὸν λόγον βεβαιοῦντος διὰ τῶν ἐπακολουθούντων ⸀σημείων.⟧ ‘/book’"
        ]
      }
    ],
