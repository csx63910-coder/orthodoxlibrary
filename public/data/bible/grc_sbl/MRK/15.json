          "verse": 12
        }
      },
      {
        "noteId": 870,
        "caller": "+",
        "text": "ἐποίησεν κακόν WH Treg NA28 ] κακὸν ἐποίησεν RP",
        "reference": {
          "chapter": 15,
          "verse": 14
        }
      },
      {
