  "chapter": {
    "number": 15,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ ⸀εὐθὺς",
          {
            "noteId": 857
          },
          "πρωῒ συμβούλιον ποιήσαντες οἱ ἀρχιερεῖς μετὰ τῶν πρεσβυτέρων καὶ γραμματέων καὶ ὅλον τὸ συνέδριον δήσαντες τὸν Ἰησοῦν ἀπήνεγκαν καὶ ⸀παρέδωκαν",
          {
            "noteId": 858
          },
          "Πιλάτῳ."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ ἐπηρώτησεν αὐτὸν ὁ Πιλᾶτος· Σὺ εἶ ὁ βασιλεὺς τῶν Ἰουδαίων; ὁ δὲ ἀποκριθεὶς ⸂αὐτῷ λέγει",
          {
            "noteId": 859
          },
          "· Σὺ λέγεις."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ κατηγόρουν αὐτοῦ οἱ ἀρχιερεῖς πολλά."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ὁ δὲ Πιλᾶτος πάλιν ⸀ἐπηρώτα",
          {
            "noteId": 860
          },
          "αὐτὸν λέγων· Οὐκ ἀποκρίνῃ οὐδέν; ἴδε πόσα σου ⸀κατηγοροῦσιν",
          {
            "noteId": 861
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ὁ δὲ Ἰησοῦς οὐκέτι οὐδὲν ἀπεκρίθη, ὥστε θαυμάζειν τὸν Πιλᾶτον."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Κατὰ δὲ ἑορτὴν ἀπέλυεν αὐτοῖς ἕνα δέσμιον ⸂ὃν παρῃτοῦντο",
          {
            "noteId": 862
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἦν δὲ ὁ λεγόμενος Βαραββᾶς μετὰ τῶν ⸀στασιαστῶν",
          {
            "noteId": 863
          },
          "δεδεμένος οἵτινες ἐν τῇ στάσει φόνον πεποιήκεισαν."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ ⸀ἀναβὰς",
          {
            "noteId": 864
          },
          "ὁ ὄχλος ἤρξατο αἰτεῖσθαι ⸀καθὼς",
          {
            "noteId": 865
          },
          "ἐποίει αὐτοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ὁ δὲ Πιλᾶτος ἀπεκρίθη αὐτοῖς λέγων· Θέλετε ἀπολύσω ὑμῖν τὸν βασιλέα τῶν Ἰουδαίων;"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἐγίνωσκεν γὰρ ὅτι διὰ φθόνον παραδεδώκεισαν αὐτὸν οἱ ἀρχιερεῖς."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "οἱ δὲ ἀρχιερεῖς ἀνέσεισαν τὸν ὄχλον ἵνα μᾶλλον τὸν Βαραββᾶν ἀπολύσῃ αὐτοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ὁ δὲ Πιλᾶτος ⸂πάλιν ἀποκριθεὶς ἔλεγεν",
          {
            "noteId": 866
          },
          "αὐτοῖς· Τί οὖν ⸀θέλετε",
          {
            "noteId": 867
          },
          "ποιήσω ⸂ὃν λέγετε",
          {
            "noteId": 868
          },
          "⸀τὸν",
          {
            "noteId": 869
          },
          "βασιλέα τῶν Ἰουδαίων;"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "οἱ δὲ πάλιν ἔκραξαν· Σταύρωσον αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ὁ δὲ Πιλᾶτος ἔλεγεν αὐτοῖς· Τί γὰρ ⸂ἐποίησεν κακόν",
          {
            "noteId": 870
          },
          "; οἱ δὲ ⸀περισσῶς",
          {
            "noteId": 871
          },
          "ἔκραξαν· Σταύρωσον αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ὁ δὲ Πιλᾶτος βουλόμενος τῷ ὄχλῳ τὸ ἱκανὸν ποιῆσαι ἀπέλυσεν αὐτοῖς τὸν Βαραββᾶν, καὶ παρέδωκεν τὸν Ἰησοῦν φραγελλώσας ἵνα σταυρωθῇ."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Οἱ δὲ στρατιῶται ἀπήγαγον αὐτὸν ἔσω τῆς αὐλῆς, ὅ ἐστιν πραιτώριον, καὶ συγκαλοῦσιν ὅλην τὴν σπεῖραν."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καὶ ⸀ἐνδιδύσκουσιν",
          {
            "noteId": 872
          },
          "αὐτὸν πορφύραν καὶ περιτιθέασιν αὐτῷ πλέξαντες ἀκάνθινον στέφανον·"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ ἤρξαντο ἀσπάζεσθαι αὐτόν· Χαῖρε, ⸀βασιλεῦ",
          {
            "noteId": 873
          },
          "τῶν Ἰουδαίων·"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "καὶ ἔτυπτον αὐτοῦ τὴν κεφαλὴν καλάμῳ καὶ ἐνέπτυον αὐτῷ, καὶ τιθέντες τὰ γόνατα προσεκύνουν αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "καὶ ὅτε ἐνέπαιξαν αὐτῷ, ἐξέδυσαν αὐτὸν τὴν πορφύραν καὶ ἐνέδυσαν αὐτὸν τὰ ἱμάτια ⸂τὰ ἴδια",
          {
            "noteId": 874
          },
          ". καὶ ἐξάγουσιν αὐτὸν ἵνα ⸀σταυρώσωσιν",
          {
            "noteId": 875
          },
          "αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Καὶ ἀγγαρεύουσιν παράγοντά τινα Σίμωνα Κυρηναῖον ἐρχόμενον ἀπʼ ἀγροῦ, τὸν πατέρα Ἀλεξάνδρου καὶ Ῥούφου, ἵνα ἄρῃ τὸν σταυρὸν αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "καὶ φέρουσιν αὐτὸν",
          {
            "noteId": 876
          },
          "ἐπὶ ⸀τὸν ⸀Γολγοθᾶν",
          {
            "noteId": 877
          },
          "τόπον, ὅ ἐστιν ⸀μεθερμηνευόμενον",
          {
            "noteId": 878
          },
          "Κρανίου Τόπος."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "καὶ ἐδίδουν ⸀αὐτῷ",
          {
            "noteId": 879
          },
          "ἐσμυρνισμένον οἶνον, ⸀ὃς",
          {
            "noteId": 880
          },
          "δὲ οὐκ ἔλαβεν."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "καὶ ⸂σταυροῦσιν αὐτὸν καὶ",
          {
            "noteId": 881
          },
          "διαμερίζονται τὰ ἱμάτια αὐτοῦ, βάλλοντες κλῆρον ἐπʼ αὐτὰ τίς τί ἄρῃ."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Ἦν δὲ ὥρα τρίτη καὶ ἐσταύρωσαν αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "καὶ ἦν ἡ ἐπιγραφὴ τῆς αἰτίας αὐτοῦ ἐπιγεγραμμένη· Ὁ βασιλεὺς τῶν Ἰουδαίων."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "καὶ σὺν αὐτῷ σταυροῦσιν δύο λῃστάς, ἕνα ἐκ δεξιῶν καὶ ἕνα ἐξ εὐωνύμων ⸀αὐτοῦ",
          {
            "noteId": 882
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Καὶ οἱ παραπορευόμενοι ἐβλασφήμουν αὐτὸν κινοῦντες τὰς κεφαλὰς αὐτῶν καὶ λέγοντες· Οὐὰ ὁ καταλύων τὸν ναὸν καὶ ⸂οἰκοδομῶν ἐν τρισὶν ἡμέραις",
          {
            "noteId": 883
          },
          ","
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "σῶσον σεαυτὸν ⸀καταβὰς",
          {
            "noteId": 884
          },
          "ἀπὸ τοῦ σταυροῦ."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "ὁμοίως καὶ οἱ ἀρχιερεῖς ἐμπαίζοντες πρὸς ἀλλήλους μετὰ τῶν γραμματέων ἔλεγον· Ἄλλους ἔσωσεν, ἑαυτὸν οὐ δύναται σῶσαι·"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "ὁ χριστὸς ὁ ⸀βασιλεὺς",
          {
            "noteId": 885
          },
          "Ἰσραὴλ καταβάτω νῦν ἀπὸ τοῦ σταυροῦ, ἵνα ἴδωμεν καὶ ⸀πιστεύσωμεν",
          {
            "noteId": 886
          },
          "καὶ οἱ συνεσταυρωμένοι ⸀σὺν",
          {
            "noteId": 887
          },
          "αὐτῷ ὠνείδιζον αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "⸂Καὶ γενομένης",
          {
            "noteId": 888
          },
          "ὥρας ἕκτης σκότος ἐγένετο ἐφʼ ὅλην τὴν γῆν ἕως ὥρας ἐνάτης."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "καὶ τῇ ⸂ἐνάτῃ ὥρᾳ",
          {
            "noteId": 889
          },
          "ἐβόησεν ὁ Ἰησοῦς φωνῇ ⸀μεγάλῃ",
          {
            "noteId": 890
          },
          "Ἐλωῒ ἐλωῒ ⸀λεμὰ",
          {
            "noteId": 891
          },
          "σαβαχθάνι; ὅ ἐστιν μεθερμηνευόμενον Ὁ θεός μου ὁ θεός μου, εἰς τί ⸂ἐγκατέλιπές με",
          {
            "noteId": 892
          },
          ";"
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "καί τινες τῶν παρεστηκότων ἀκούσαντες ἔλεγον· ⸀Ἴδε",
          {
            "noteId": 893
          },
          "Ἠλίαν φωνεῖ."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "δραμὼν δέ ⸂τις καὶ",
          {
            "noteId": 894
          },
          "γεμίσας σπόγγον ὄξους ⸀περιθεὶς",
          {
            "noteId": 895
          },
          "καλάμῳ ἐπότιζεν αὐτόν, λέγων· Ἄφετε ἴδωμεν εἰ ἔρχεται Ἠλίας καθελεῖν αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "ὁ δὲ Ἰησοῦς ἀφεὶς φωνὴν μεγάλην ἐξέπνευσεν."
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "καὶ τὸ καταπέτασμα τοῦ ναοῦ ἐσχίσθη εἰς δύο ἀπʼ ἄνωθεν ἕως κάτω."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "ἰδὼν δὲ ὁ κεντυρίων ὁ παρεστηκὼς ἐξ ἐναντίας αὐτοῦ ὅτι ⸀οὕτως",
          {
            "noteId": 896
          },
          "ἐξέπνευσεν εἶπεν· Ἀληθῶς ⸂οὗτος ὁ ἄνθρωπος",
          {
            "noteId": 897
          },
          "υἱὸς ⸂θεοῦ ἦν",
          {
            "noteId": 898
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "Ἦσαν δὲ καὶ γυναῖκες ἀπὸ μακρόθεν θεωροῦσαι, ἐν ⸀αἷς",
          {
            "noteId": 899
          },
          "καὶ ⸀Μαρία",
          {
            "noteId": 900
          },
          "ἡ",
          {
            "noteId": 901
          },
          "Μαγδαληνὴ καὶ Μαρία ⸀ἡ Ἰακώβου τοῦ μικροῦ καὶ ⸀Ἰωσῆτος",
          {
            "noteId": 902
          },
          "μήτηρ καὶ Σαλώμη,"
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "⸀αἳ",
          {
            "noteId": 903
          },
          "ὅτε ἦν ἐν τῇ Γαλιλαίᾳ ἠκολούθουν αὐτῷ καὶ διηκόνουν αὐτῷ, καὶ ἄλλαι πολλαὶ αἱ συναναβᾶσαι αὐτῷ εἰς Ἱεροσόλυμα."
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "Καὶ ἤδη ὀψίας γενομένης, ἐπεὶ ἦν παρασκευή, ὅ ἐστιν ⸀προσάββατον",
          {
            "noteId": 904
          }
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "⸀ἐλθὼν",
          {
            "noteId": 905
          },
          "Ἰωσὴφ ⸀ὁ",
          {
            "noteId": 906
          },
          "ἀπὸ Ἁριμαθαίας εὐσχήμων βουλευτής, ὃς καὶ αὐτὸς ἦν προσδεχόμενος τὴν βασιλείαν τοῦ θεοῦ, τολμήσας εἰσῆλθεν πρὸς ⸀τὸν",
          {
            "noteId": 907
          },
          "Πιλᾶτον καὶ ᾐτήσατο τὸ σῶμα τοῦ Ἰησοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "ὁ δὲ Πιλᾶτος ἐθαύμασεν εἰ ἤδη τέθνηκεν, καὶ προσκαλεσάμενος τὸν κεντυρίωνα ἐπηρώτησεν αὐτὸν εἰ ⸀πάλαι",
          {
            "noteId": 908
          },
          "ἀπέθανεν·"
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "καὶ γνοὺς ἀπὸ τοῦ κεντυρίωνος ἐδωρήσατο τὸ ⸀πτῶμα",
          {
            "noteId": 909
          },
          "τῷ Ἰωσήφ."
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "καὶ ἀγοράσας ⸀σινδόνα",
          {
            "noteId": 910
          },
          "καθελὼν αὐτὸν ἐνείλησεν τῇ σινδόνι καὶ ⸀ἔθηκεν",
          {
            "noteId": 911
          },
          "αὐτὸν ἐν ⸀μνημείῳ",
          {
            "noteId": 912
          },
          "ὃ ἦν λελατομημένον ἐκ πέτρας, καὶ προσεκύλισεν λίθον ἐπὶ τὴν θύραν τοῦ μνημείου."
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          "ἡ δὲ Μαρία ἡ Μαγδαληνὴ καὶ Μαρία ⸂ἡ Ἰωσῆτος",
          {
            "noteId": 913
          },
          "ἐθεώρουν ποῦ ⸀τέθειται",
          {
            "noteId": 914
          }
        ]
      }
    ],
