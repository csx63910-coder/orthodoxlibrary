  "chapter": {
    "number": 11,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ ὅτε ἐγγίζουσιν εἰς Ἱεροσόλυμα εἰς Βηθφαγὴ καὶ Βηθανίαν πρὸς τὸ Ὄρος τῶν Ἐλαιῶν, ἀποστέλλει δύο τῶν μαθητῶν αὐτοῦ"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ λέγει αὐτοῖς· Ὑπάγετε εἰς τὴν κώμην τὴν κατέναντι ὑμῶν, καὶ ⸀εὐθὺς",
          {
            "noteId": 608
          },
          "εἰσπορευόμενοι εἰς αὐτὴν εὑρήσετε πῶλον δεδεμένον ἐφʼ ὃν οὐδεὶς ⸀οὔπω",
          {
            "noteId": 609
          },
          "ἀνθρώπων ⸀ἐκάθισεν",
          {
            "noteId": 610
          },
          "⸂λύσατε αὐτὸν καὶ φέρετε",
          {
            "noteId": 611
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ ἐάν τις ὑμῖν εἴπῃ· Τί ποιεῖτε τοῦτο; εἴπατε ⸀ὅτι",
          {
            "noteId": 612
          },
          "Ὁ κύριος αὐτοῦ χρείαν ἔχει· καὶ ⸀εὐθὺς",
          {
            "noteId": 613
          },
          "αὐτὸν ἀποστέλλει ⸀πάλιν",
          {
            "noteId": 614
          },
          "ὧδε."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "⸂καὶ ἀπῆλθον",
          {
            "noteId": 615
          },
          "καὶ εὗρον πῶλον δεδεμένον ⸀πρὸς",
          {
            "noteId": 616
          },
          "θύραν ἔξω ἐπὶ τοῦ ἀμφόδου, καὶ λύουσιν αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καί τινες τῶν ἐκεῖ ἑστηκότων ἔλεγον αὐτοῖς· Τί ποιεῖτε λύοντες τὸν πῶλον;"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "οἱ δὲ εἶπαν αὐτοῖς καθὼς ⸀εἶπεν",
          {
            "noteId": 617
          },
          "ὁ Ἰησοῦς· καὶ ἀφῆκαν αὐτούς."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "καὶ ⸀φέρουσιν",
          {
            "noteId": 618
          },
          "τὸν πῶλον πρὸς τὸν Ἰησοῦν, καὶ ⸀ἐπιβάλλουσιν",
          {
            "noteId": 619
          },
          "αὐτῷ τὰ ἱμάτια αὐτῶν, καὶ ἐκάθισεν ἐπʼ ⸀αὐτόν",
          {
            "noteId": 620
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "⸂καὶ πολλοὶ",
          {
            "noteId": 621
          },
          "τὰ ἱμάτια αὐτῶν ἔστρωσαν εἰς τὴν ὁδόν, ἄλλοι δὲ στιβάδας ⸂κόψαντες ἐκ τῶν ἀγρῶν",
          {
            "noteId": 622
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ οἱ προάγοντες καὶ οἱ ἀκολουθοῦντες ⸀ἔκραζον",
          {
            "noteId": 623
          },
          "Ὡσαννά· Εὐλογημένος ὁ ἐρχόμενος ἐν ὀνόματι κυρίου·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Εὐλογημένη ἡ ἐρχομένη ⸀βασιλεία",
          {
            "noteId": 624
          },
          "τοῦ πατρὸς ἡμῶν Δαυίδ· Ὡσαννὰ ἐν τοῖς ὑψίστοις."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Καὶ εἰσῆλθεν εἰς ⸀Ἱεροσόλυμα",
          {
            "noteId": 625
          },
          "εἰς τὸ ἱερόν· καὶ περιβλεψάμενος πάντα ⸀ὀψὲ",
          {
            "noteId": 626
          },
          "ἤδη οὔσης τῆς ὥρας ἐξῆλθεν εἰς Βηθανίαν μετὰ τῶν δώδεκα."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Καὶ τῇ ἐπαύριον ἐξελθόντων αὐτῶν ἀπὸ Βηθανίας ἐπείνασεν."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ ἰδὼν συκῆν ⸀ἀπὸ",
          {
            "noteId": 627
          },
          "μακρόθεν ἔχουσαν φύλλα ἦλθεν εἰ ἄρα ⸂τι εὑρήσει",
          {
            "noteId": 628
          },
          "ἐν αὐτῇ, καὶ ἐλθὼν ἐπʼ αὐτὴν οὐδὲν εὗρεν εἰ μὴ φύλλα, ⸂ὁ γὰρ καιρὸς οὐκ ἦν",
          {
            "noteId": 629
          },
          "σύκων."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καὶ ⸀ἀποκριθεὶς",
          {
            "noteId": 630
          },
          "εἶπεν αὐτῇ· Μηκέτι ⸂εἰς τὸν αἰῶνα ἐκ σοῦ",
          {
            "noteId": 631
          },
          "μηδεὶς καρπὸν φάγοι. καὶ ἤκουον οἱ μαθηταὶ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Καὶ ἔρχονται εἰς Ἱεροσόλυμα. καὶ ⸀εἰσελθὼν",
          {
            "noteId": 632
          },
          "εἰς τὸ ἱερὸν ἤρξατο ἐκβάλλειν τοὺς",
          {
            "noteId": 633
          },
          "πωλοῦντας καὶ ⸀τοὺς ἀγοράζοντας ἐν τῷ ἱερῷ, καὶ τὰς τραπέζας τῶν κολλυβιστῶν καὶ τὰς καθέδρας τῶν πωλούντων τὰς περιστερὰς κατέστρεψεν"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ οὐκ ἤφιεν ἵνα τις διενέγκῃ σκεῦος διὰ τοῦ ἱεροῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καὶ ἐδίδασκεν ⸂καὶ ἔλεγεν",
          {
            "noteId": 634
          },
          "⸀αὐτοῖς",
          {
            "noteId": 635
          },
          "Οὐ γέγραπται ὅτι Ὁ οἶκός μου οἶκος προσευχῆς κληθήσεται πᾶσιν τοῖς ἔθνεσιν; ὑμεῖς δὲ ⸀πεποιήκατε",
          {
            "noteId": 636
          },
          "αὐτὸν σπήλαιον λῃστῶν."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ ἤκουσαν οἱ ⸂ἀρχιερεῖς καὶ οἱ γραμματεῖς",
          {
            "noteId": 637
          },
          ", καὶ ἐζήτουν πῶς αὐτὸν ἀπολέσωσιν· ἐφοβοῦντο γὰρ αὐτόν, ⸂πᾶς γὰρ",
          {
            "noteId": 638
          },
          "ὁ ὄχλος ἐξεπλήσσετο ἐπὶ τῇ διδαχῇ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Καὶ ⸀ὅταν",
          {
            "noteId": 639
          },
          "ὀψὲ ἐγένετο, ⸀ἐξεπορεύοντο",
          {
            "noteId": 640
          },
          "ἔξω τῆς πόλεως."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Καὶ ⸂παραπορευόμενοι πρωῒ",
          {
            "noteId": 641
          },
          "εἶδον τὴν συκῆν ἐξηραμμένην ἐκ ῥιζῶν."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "καὶ ἀναμνησθεὶς ὁ Πέτρος λέγει αὐτῷ· Ῥαββί, ἴδε ἡ συκῆ ἣν κατηράσω ἐξήρανται."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "καὶ ἀποκριθεὶς ὁ Ἰησοῦς λέγει αὐτοῖς· Ἔχετε πίστιν θεοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "⸀ἀμὴν",
          {
            "noteId": 642
          },
          "λέγω ὑμῖν ὅτι ὃς ἂν εἴπῃ τῷ ὄρει τούτῳ· Ἄρθητι καὶ βλήθητι εἰς τὴν θάλασσαν, καὶ μὴ διακριθῇ ἐν τῇ καρδίᾳ αὐτοῦ ἀλλὰ ⸀πιστεύῃ",
          {
            "noteId": 643
          },
          "ὅτι ⸂ὃ λαλεῖ γίνεται, ἔσται αὐτῷ",
          {
            "noteId": 644
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "διὰ τοῦτο λέγω ὑμῖν, πάντα ὅσα ⸂προσεύχεσθε καὶ αἰτεῖσθε",
          {
            "noteId": 645
          },
          ", πιστεύετε ὅτι ⸀ἐλάβετε",
          {
            "noteId": 646
          },
          "καὶ ἔσται ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "καὶ ὅταν ⸀στήκετε",
          {
            "noteId": 647
          },
          "προσευχόμενοι, ἀφίετε εἴ τι ἔχετε κατά τινος, ἵνα καὶ ὁ πατὴρ ὑμῶν",
          {
            "noteId": 648
          },
          "ὁ ἐν τοῖς οὐρανοῖς ἀφῇ ὑμῖν τὰ παραπτώματα ⸀ὑμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Καὶ ἔρχονται πάλιν εἰς Ἱεροσόλυμα. καὶ ἐν τῷ ἱερῷ περιπατοῦντος αὐτοῦ ἔρχονται πρὸς αὐτὸν οἱ ἀρχιερεῖς καὶ οἱ γραμματεῖς καὶ οἱ πρεσβύτεροι"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "καὶ ⸀ἔλεγον",
          {
            "noteId": 649
          },
          "αὐτῷ· Ἐν ποίᾳ ἐξουσίᾳ ταῦτα ποιεῖς; ⸀ἢ",
          {
            "noteId": 650
          },
          "τίς σοι ⸂ἔδωκεν τὴν ἐξουσίαν ταύτην",
          {
            "noteId": 651
          },
          "ἵνα ταῦτα ποιῇς;"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "ὁ δὲ ⸀Ἰησοῦς",
          {
            "noteId": 652
          },
          "εἶπεν αὐτοῖς· Ἐπερωτήσω ⸀ὑμᾶς",
          {
            "noteId": 653
          },
          "ἕνα λόγον, καὶ ἀποκρίθητέ μοι, καὶ ἐρῶ ὑμῖν ἐν ποίᾳ ἐξουσίᾳ ταῦτα ποιῶ·"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "τὸ",
          {
            "noteId": 654
          },
          "βάπτισμα ⸀τὸ Ἰωάννου ἐξ οὐρανοῦ ἦν ἢ ἐξ ἀνθρώπων; ἀποκρίθητέ μοι."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "καὶ ⸀διελογίζοντο",
          {
            "noteId": 655
          },
          "πρὸς ἑαυτοὺς λέγοντες· ⸂Τί εἴπωμεν;",
          {
            "noteId": 656
          },
          "ἐὰν εἴπωμεν· Ἐξ οὐρανοῦ, ἐρεῖ· Διὰ τί ⸀οὖν",
          {
            "noteId": 657
          },
          "οὐκ ἐπιστεύσατε αὐτῷ;"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "ἀλλὰ εἴπωμεν· Ἐξ ἀνθρώπων;— ἐφοβοῦντο τὸν ⸀ὄχλον",
          {
            "noteId": 658
          },
          "ἅπαντες γὰρ εἶχον τὸν Ἰωάννην ⸂ὄντως ὅτι",
          {
            "noteId": 659
          },
          "προφήτης ἦν."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "καὶ ἀποκριθέντες ⸂τῷ Ἰησοῦ λέγουσιν",
          {
            "noteId": 660
          },
          "· Οὐκ οἴδαμεν. καὶ ὁ ⸀Ἰησοῦς",
          {
            "noteId": 661
          },
          "λέγει αὐτοῖς· Οὐδὲ ἐγὼ λέγω ὑμῖν ἐν ποίᾳ ἐξουσίᾳ ταῦτα ποιῶ."
        ]
      }
    ],
