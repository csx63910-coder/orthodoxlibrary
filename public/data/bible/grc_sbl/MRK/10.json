    "lastChapterApiLink": "/api/grc_sbl/MRK/16.json",
    "totalNumberOfVerses": 673
  },
  "chapter": {
    "number": 10,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ ἐκεῖθεν ἀναστὰς ἔρχεται εἰς τὰ ὅρια τῆς Ἰουδαίας ⸀καὶ",
          {
            "noteId": 542
          },
          "πέραν τοῦ Ἰορδάνου, καὶ συμπορεύονται πάλιν ὄχλοι πρὸς αὐτόν, καὶ ὡς εἰώθει πάλιν ἐδίδασκεν αὐτούς."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "⸀Καὶ",
          {
            "noteId": 543
          },
          "⸀ἐπηρώτων",
          {
            "noteId": 544
          },
          "αὐτὸν εἰ ἔξεστιν ἀνδρὶ γυναῖκα ἀπολῦσαι, πειράζοντες αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ὁ δὲ ἀποκριθεὶς εἶπεν αὐτοῖς· Τί ὑμῖν ἐνετείλατο Μωϋσῆς;"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "οἱ δὲ εἶπαν· ⸂Ἐπέτρεψεν Μωϋσῆς",
          {
            "noteId": 545
          },
          "βιβλίον ἀποστασίου γράψαι καὶ ἀπολῦσαι."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "⸂ὁ δὲ",
          {
            "noteId": 546
          },
          "Ἰησοῦς εἶπεν αὐτοῖς· Πρὸς τὴν σκληροκαρδίαν ὑμῶν ἔγραψεν ὑμῖν τὴν ἐντολὴν ταύτην·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἀπὸ δὲ ἀρχῆς κτίσεως ἄρσεν καὶ θῆλυ ἐποίησεν ⸀αὐτούς",
          {
            "noteId": 547
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἕνεκεν τούτου καταλείψει ἄνθρωπος τὸν πατέρα αὐτοῦ καὶ τὴν μητέρα ⸂καὶ προσκολληθήσεται πρὸς τὴν γυναῖκα αὐτοῦ",
          {
            "noteId": 548
          },
          ","
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ ἔσονται οἱ δύο εἰς σάρκα μίαν· ὥστε οὐκέτι εἰσὶν δύο ἀλλὰ μία σάρξ·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ὃ οὖν ὁ θεὸς συνέζευξεν ἄνθρωπος μὴ χωριζέτω."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Καὶ ⸂εἰς τὴν οἰκίαν",
          {
            "noteId": 549
          },
          "πάλιν οἱ μαθηταὶ ⸂περὶ τούτου",
          {
            "noteId": 550
          },
          "⸀ἐπηρώτων",
          {
            "noteId": 551
          },
          "αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ λέγει αὐτοῖς· Ὃς ⸀ἂν",
          {
            "noteId": 552
          },
          "ἀπολύσῃ τὴν γυναῖκα αὐτοῦ καὶ γαμήσῃ ἄλλην μοιχᾶται ἐπʼ αὐτήν,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "καὶ ἐὰν ⸂αὐτὴ ἀπολύσασα τὸν ἄνδρα αὐτῆς γαμήσῃ ἄλλον",
          {
            "noteId": 553
          },
          "μοιχᾶται."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Καὶ προσέφερον αὐτῷ παιδία ἵνα ⸂αὐτῶν ἅψηται",
          {
            "noteId": 554
          },
          "· οἱ δὲ μαθηταὶ ⸂ἐπετίμησαν αὐτοῖς",
          {
            "noteId": 555
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἰδὼν δὲ ὁ Ἰησοῦς ἠγανάκτησεν καὶ εἶπεν αὐτοῖς· Ἄφετε τὰ παιδία ἔρχεσθαι πρός με, μὴ κωλύετε αὐτά, τῶν γὰρ τοιούτων ἐστὶν ἡ βασιλεία τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ἀμὴν λέγω ὑμῖν, ὃς ⸀ἂν",
          {
            "noteId": 556
          },
          "μὴ δέξηται τὴν βασιλείαν τοῦ θεοῦ ὡς παιδίον, οὐ μὴ εἰσέλθῃ εἰς αὐτήν."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ ἐναγκαλισάμενος αὐτὰ ⸂κατευλόγει τιθεὶς τὰς χεῖρας ἐπʼ αὐτά",
          {
            "noteId": 557
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Καὶ ἐκπορευομένου αὐτοῦ εἰς ὁδὸν προσδραμὼν εἷς καὶ γονυπετήσας αὐτὸν ἐπηρώτα αὐτόν· Διδάσκαλε ἀγαθέ, τί ποιήσω ἵνα ζωὴν αἰώνιον κληρονομήσω;"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ὁ δὲ Ἰησοῦς εἶπεν αὐτῷ· Τί με λέγεις ἀγαθόν; οὐδεὶς ἀγαθὸς εἰ μὴ εἷς ὁ θεός."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "τὰς ἐντολὰς οἶδας· Μὴ ⸂φονεύσῃς, Μὴ μοιχεύσῃς⸃, Μὴ κλέψῃς, Μὴ ψευδομαρτυρήσῃς, Μὴ ἀποστερήσῃς, Τίμα τὸν πατέρα σου καὶ τὴν μητέρα.",
          {
            "noteId": 558
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ὁ δὲ ⸀ἔφη",
          {
            "noteId": 559
          },
          "αὐτῷ· Διδάσκαλε, ταῦτα πάντα ἐφυλαξάμην ἐκ νεότητός μου."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ὁ δὲ Ἰησοῦς ἐμβλέψας αὐτῷ ἠγάπησε",
          {
            "noteId": 560
          },
          "αὐτὸν καὶ εἶπεν αὐτῷ· Ἕν ⸀σε ὑστερεῖ· ὕπαγε ὅσα ἔχεις πώλησον καὶ δὸς ⸀τοῖς",
          {
            "noteId": 561
          },
          "πτωχοῖς, καὶ ἕξεις θησαυρὸν ἐν οὐρανῷ, καὶ δεῦρο ἀκολούθει ⸀μοι",
          {
            "noteId": 562
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ὁ δὲ στυγνάσας ἐπὶ τῷ λόγῳ ἀπῆλθεν λυπούμενος, ἦν γὰρ ἔχων κτήματα πολλά."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Καὶ περιβλεψάμενος ὁ Ἰησοῦς λέγει τοῖς μαθηταῖς αὐτοῦ· Πῶς δυσκόλως οἱ τὰ χρήματα ἔχοντες εἰς τὴν βασιλείαν τοῦ θεοῦ εἰσελεύσονται."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "οἱ δὲ μαθηταὶ ἐθαμβοῦντο ἐπὶ τοῖς λόγοις αὐτοῦ. ὁ δὲ Ἰησοῦς πάλιν ἀποκριθεὶς λέγει αὐτοῖς· Τέκνα, πῶς δύσκολόν ⸀ἐστιν",
          {
            "noteId": 563
          },
          "εἰς τὴν βασιλείαν τοῦ θεοῦ εἰσελθεῖν·"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "εὐκοπώτερόν ἐστιν κάμηλον διὰ ⸂τῆς τρυμαλιᾶς τῆς",
          {
            "noteId": 564
          },
          "ῥαφίδος ⸀διελθεῖν",
          {
            "noteId": 565
          },
          "ἢ πλούσιον εἰς τὴν βασιλείαν τοῦ θεοῦ εἰσελθεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "οἱ δὲ περισσῶς ἐξεπλήσσοντο λέγοντες πρὸς ⸀ἑαυτούς",
          {
            "noteId": 566
          },
          "Καὶ τίς δύναται σωθῆναι;"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "⸀ἐμβλέψας",
          {
            "noteId": 567
          },
          "αὐτοῖς ὁ Ἰησοῦς λέγει· Παρὰ ἀνθρώποις ἀδύνατον ἀλλʼ οὐ παρὰ θεῷ, πάντα γὰρ ⸀δυνατὰ",
          {
            "noteId": 568
          },
          "παρὰ τῷ θεῷ."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Ἤρξατο ⸂λέγειν ὁ Πέτρος",
          {
            "noteId": 569
          },
          "αὐτῷ· Ἰδοὺ ἡμεῖς ἀφήκαμεν πάντα καὶ ⸀ἠκολουθήκαμέν",
          {
            "noteId": 570
          },
          "σοι."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "⸂ἔφη ὁ Ἰησοῦς",
          {
            "noteId": 571
          },
          "· Ἀμὴν λέγω ὑμῖν, οὐδείς ἐστιν ὃς ἀφῆκεν οἰκίαν ἢ ἀδελφοὺς ἢ ἀδελφὰς ἢ ⸂μητέρα ἢ πατέρα",
          {
            "noteId": 572
          },
          "ἢ τέκνα ἢ ἀγροὺς ἕνεκεν ἐμοῦ καὶ ἕνεκεν τοῦ εὐαγγελίου,"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ἐὰν μὴ λάβῃ ἑκατονταπλασίονα νῦν ἐν τῷ καιρῷ τούτῳ οἰκίας καὶ ἀδελφοὺς καὶ ἀδελφὰς καὶ ⸀μητέρας",
          {
            "noteId": 573
          },
          "καὶ τέκνα καὶ ἀγροὺς μετὰ διωγμῶν, καὶ ἐν τῷ αἰῶνι τῷ ἐρχομένῳ ζωὴν αἰώνιον."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "πολλοὶ δὲ ἔσονται πρῶτοι ἔσχατοι καὶ ⸀οἱ",
          {
            "noteId": 574
          },
          "ἔσχατοι πρῶτοι."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Ἦσαν δὲ ἐν τῇ ὁδῷ ἀναβαίνοντες εἰς Ἱεροσόλυμα, καὶ ἦν προάγων αὐτοὺς ὁ Ἰησοῦς, καὶ ἐθαμβοῦντο, ⸂οἱ δὲ",
          {
            "noteId": 575
          },
          "ἀκολουθοῦντες ἐφοβοῦντο. καὶ παραλαβὼν πάλιν τοὺς δώδεκα ἤρξατο αὐτοῖς λέγειν τὰ μέλλοντα αὐτῷ συμβαίνειν"
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "ὅτι Ἰδοὺ ἀναβαίνομεν εἰς Ἱεροσόλυμα, καὶ ὁ υἱὸς τοῦ ἀνθρώπου παραδοθήσεται τοῖς",
          {
            "noteId": 576
          },
          "ἀρχιερεῦσιν καὶ ⸀τοῖς γραμματεῦσιν, καὶ κατακρινοῦσιν αὐτὸν θανάτῳ καὶ παραδώσουσιν αὐτὸν τοῖς ἔθνεσιν"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "καὶ ἐμπαίξουσιν αὐτῷ καὶ ⸂ἐμπτύσουσιν αὐτῷ καὶ μαστιγώσουσιν αὐτὸν",
          {
            "noteId": 577
          },
          "καὶ ⸀ἀποκτενοῦσιν",
          {
            "noteId": 578
          },
          "καὶ ⸂μετὰ τρεῖς ἡμέρας",
          {
            "noteId": 579
          },
          "ἀναστήσεται."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "Καὶ προσπορεύονται αὐτῷ Ἰάκωβος καὶ Ἰωάννης ⸀οἱ",
          {
            "noteId": 580
          },
          "υἱοὶ Ζεβεδαίου λέγοντες ⸀αὐτῷ",
          {
            "noteId": 581
          },
          "Διδάσκαλε, θέλομεν ἵνα ὃ ἐὰν αἰτήσωμέν ⸀σε",
          {
            "noteId": 582
          },
          "ποιήσῃς ἡμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "ὁ δὲ εἶπεν αὐτοῖς· Τί θέλετε ⸀ποιήσω",
          {
            "noteId": 583
          },
          "ὑμῖν;"
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "οἱ δὲ εἶπαν αὐτῷ· Δὸς ἡμῖν ἵνα εἷς ⸂σου ἐκ δεξιῶν",
          {
            "noteId": 584
          },
          "καὶ εἷς ἐξ ⸀ἀριστερῶν",
          {
            "noteId": 585
          },
          "καθίσωμεν ἐν τῇ δόξῃ σου."
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "ὁ δὲ Ἰησοῦς εἶπεν αὐτοῖς· Οὐκ οἴδατε τί αἰτεῖσθε· δύνασθε πιεῖν τὸ ποτήριον ὃ ἐγὼ πίνω, ⸀ἢ",
          {
            "noteId": 586
          },
          "τὸ βάπτισμα ὃ ἐγὼ βαπτίζομαι βαπτισθῆναι;"
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "οἱ δὲ εἶπαν αὐτῷ· Δυνάμεθα. ὁ δὲ Ἰησοῦς εἶπεν αὐτοῖς· ⸀Τὸ",
          {
            "noteId": 587
          },
          "ποτήριον ὃ ἐγὼ πίνω πίεσθε καὶ τὸ βάπτισμα ὃ ἐγὼ βαπτίζομαι βαπτισθήσεσθε,"
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "τὸ δὲ καθίσαι ἐκ δεξιῶν μου ⸀ἢ",
          {
            "noteId": 588
          },
          "ἐξ εὐωνύμων οὐκ ἔστιν ἐμὸν δοῦναι, ἀλλʼ οἷς ἡτοίμασται."
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "Καὶ ἀκούσαντες οἱ δέκα ἤρξαντο ἀγανακτεῖν περὶ Ἰακώβου καὶ Ἰωάννου."
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "⸂καὶ προσκαλεσάμενος αὐτοὺς ὁ Ἰησοῦς",
          {
            "noteId": 589
          },
          "λέγει αὐτοῖς· Οἴδατε ὅτι οἱ δοκοῦντες ἄρχειν τῶν ἐθνῶν κατακυριεύουσιν αὐτῶν καὶ οἱ μεγάλοι αὐτῶν κατεξουσιάζουσιν αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "οὐχ οὕτως δέ ⸀ἐστιν",
          {
            "noteId": 590
          },
          "ἐν ὑμῖν· ἀλλʼ ὃς ⸀ἂν",
          {
            "noteId": 591
          },
          "θέλῃ ⸂μέγας γενέσθαι",
          {
            "noteId": 592
          },
          "ἐν ὑμῖν, ἔσται ὑμῶν διάκονος,"
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "καὶ ὃς ⸀ἂν",
          {
            "noteId": 593
          },
          "θέλῃ ⸂ἐν ὑμῖν εἶναι",
          {
            "noteId": 594
          },
          "πρῶτος, ἔσται πάντων δοῦλος·"
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "καὶ γὰρ ὁ υἱὸς τοῦ ἀνθρώπου οὐκ ἦλθεν διακονηθῆναι ἀλλὰ διακονῆσαι καὶ δοῦναι τὴν ψυχὴν αὐτοῦ λύτρον ἀντὶ πολλῶν."
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "Καὶ ἔρχονται εἰς Ἰεριχώ. καὶ ἐκπορευομένου αὐτοῦ ἀπὸ Ἰεριχὼ καὶ τῶν μαθητῶν αὐτοῦ καὶ ὄχλου ἱκανοῦ ⸀ὁ",
          {
            "noteId": 595
          },
          "υἱὸς Τιμαίου Βαρτιμαῖος ⸀τυφλὸς",
          {
            "noteId": 596
          },
          "⸂προσαίτης ἐκάθητο παρὰ τὴν ὁδόν",
          {
            "noteId": 597
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          "καὶ ἀκούσας ὅτι Ἰησοῦς ὁ ⸀Ναζαρηνός",
          {
            "noteId": 598
          },
          "ἐστιν ἤρξατο κράζειν καὶ λέγειν· ⸀Υἱὲ",
          {
            "noteId": 599
          },
          "Δαυὶδ Ἰησοῦ, ἐλέησόν με."
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          "καὶ ἐπετίμων αὐτῷ πολλοὶ ἵνα σιωπήσῃ· ὁ δὲ πολλῷ μᾶλλον ἔκραζεν· Υἱὲ Δαυίδ, ἐλέησόν με."
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          "καὶ στὰς ὁ Ἰησοῦς εἶπεν· ⸂Φωνήσατε αὐτόν",
          {
            "noteId": 600
          },
          ". καὶ φωνοῦσι τὸν τυφλὸν λέγοντες αὐτῷ· Θάρσει, ⸀ἔγειρε",
          {
            "noteId": 601
          },
          "φωνεῖ σε."
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          "ὁ δὲ ἀποβαλὼν τὸ ἱμάτιον αὐτοῦ ⸀ἀναπηδήσας",
          {
            "noteId": 602
          },
          "ἦλθεν πρὸς τὸν Ἰησοῦν."
        ]
      },
      {
        "type": "verse",
        "number": 51,
        "content": [
          "καὶ ἀποκριθεὶς ⸂αὐτῷ ὁ Ἰησοῦς εἶπεν",
          {
            "noteId": 603
          },
          "· Τί ⸂σοι θέλεις ποιήσω",
          {
            "noteId": 604
          },
          "; ὁ δὲ τυφλὸς εἶπεν αὐτῷ· Ραββουνι, ἵνα ἀναβλέψω."
        ]
      },
      {
        "type": "verse",
        "number": 52,
        "content": [
