  "chapter": {
    "number": 13,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ εἶδον ἐκ τῆς θαλάσσης θηρίον ἀναβαῖνον, ἔχον κέρατα δέκα καὶ κεφαλὰς ἑπτά, καὶ ἐπὶ τῶν κεράτων αὐτοῦ δέκα διαδήματα, καὶ ἐπὶ τὰς κεφαλὰς αὐτοῦ ⸀ὀνόματα",
          {
            "noteId": 230
          },
          "βλασφημίας."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ τὸ θηρίον ὃ εἶδον ἦν ὅμοιον παρδάλει, καὶ οἱ πόδες αὐτοῦ ὡς ἄρκου, καὶ τὸ στόμα αὐτοῦ ὡς στόμα λέοντος. καὶ ἔδωκεν αὐτῷ ὁ δράκων τὴν δύναμιν αὐτοῦ καὶ τὸν θρόνον αὐτοῦ καὶ ἐξουσίαν μεγάλην."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ μίαν ἐκ τῶν κεφαλῶν αὐτοῦ ⸀ὡς",
          {
            "noteId": 231
          },
          "ἐσφαγμένην εἰς θάνατον, καὶ ἡ πληγὴ τοῦ θανάτου αὐτοῦ ἐθεραπεύθη. καὶ ⸀ἐθαυμάσθη",
          {
            "noteId": 232
          },
          "⸂ὅλη ἡ γῆ",
          {
            "noteId": 233
          },
          "ὀπίσω τοῦ θηρίου,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ προσεκύνησαν τῷ δράκοντι ⸂ὅτι ἔδωκεν",
          {
            "noteId": 234
          },
          "τὴν ἐξουσίαν τῷ θηρίῳ, καὶ προσεκύνησαν τῷ θηρίῳ λέγοντες· Τίς ὅμοιος τῷ θηρίῳ, καὶ τίς ⸀δύναται",
          {
            "noteId": 235
          },
          "πολεμῆσαι μετʼ αὐτοῦ;"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Καὶ ἐδόθη αὐτῷ στόμα λαλοῦν μεγάλα καὶ ⸀βλασφημίας",
          {
            "noteId": 236
          },
          "καὶ ἐδόθη αὐτῷ ⸀ἐξουσία",
          {
            "noteId": 237
          },
          "ποιῆσαι μῆνας ⸀τεσσεράκοντα",
          {
            "noteId": 238
          },
          "δύο."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ ἤνοιξε τὸ στόμα αὐτοῦ εἰς ⸀βλασφημίας",
          {
            "noteId": 239
          },
          "πρὸς τὸν θεόν, βλασφημῆσαι τὸ ὄνομα αὐτοῦ καὶ τὴν σκηνὴν αὐτοῦ, τοὺς ἐν τῷ οὐρανῷ σκηνοῦντας."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "καὶ ἐδόθη αὐτῷ ποιῆσαι πόλεμον μετὰ τῶν ἁγίων καὶ νικῆσαι αὐτούς, καὶ ἐδόθη αὐτῷ ἐξουσία ἐπὶ πᾶσαν φυλὴν καὶ λαὸν καὶ γλῶσσαν καὶ ἔθνος."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ προσκυνήσουσιν ⸀αὐτὸν",
          {
            "noteId": 240
          },
          "πάντες οἱ κατοικοῦντες ἐπὶ τῆς γῆς, ⸀οὗ",
          {
            "noteId": 241
          },
          "οὐ γέγραπται τὸ ὄνομα ⸀αὐτοῦ",
          {
            "noteId": 242
          },
          "ἐν τῷ βιβλίῳ τῆς ζωῆς τοῦ ἀρνίου τοῦ ἐσφαγμένου ἀπὸ καταβολῆς κόσμου."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Εἴ τις ἔχει οὖς ἀκουσάτω."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "εἴ τις ⸂εἰς αἰχμαλωσίαν, εἰς αἰχμαλωσίαν",
          {
            "noteId": 243
          },
          "ὑπάγει· εἴ τις ἐν μαχαίρῃ ⸀ἀποκτανθῆναι",
          {
            "noteId": 244
          },
          "αὐτὸν ἐν μαχαίρῃ ἀποκτανθῆναι. ὧδέ ἐστιν ἡ ὑπομονὴ καὶ ἡ πίστις τῶν ἁγίων."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Καὶ εἶδον ἄλλο θηρίον ἀναβαῖνον ἐκ τῆς γῆς, καὶ εἶχεν κέρατα δύο ὅμοια ἀρνίῳ, καὶ ἐλάλει ὡς δράκων."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "καὶ τὴν ἐξουσίαν τοῦ πρώτου θηρίου πᾶσαν ποιεῖ",
          {
            "noteId": 245
          },
          "ἐνώπιον αὐτοῦ. καὶ ⸀ποιεῖ τὴν γῆν καὶ τοὺς ἐν αὐτῇ κατοικοῦντας ἵνα ⸀προσκυνήσουσιν",
          {
            "noteId": 246
          },
          "τὸ θηρίον τὸ πρῶτον, οὗ ἐθεραπεύθη ἡ πληγὴ τοῦ θανάτου αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ ποιεῖ σημεῖα μεγάλα, ⸂ἵνα καὶ πῦρ ποιῇ",
          {
            "noteId": 247
          },
          "ἐκ τοῦ οὐρανοῦ ⸂καταβαίνειν εἰς",
          {
            "noteId": 248
          },
          "τὴν γῆν ἐνώπιον τῶν ἀνθρώπων."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καὶ πλανᾷ ⸀τοὺς",
          {
            "noteId": 249
          },
          "κατοικοῦντας ἐπὶ τῆς γῆς διὰ τὰ σημεῖα ἃ ἐδόθη αὐτῷ ποιῆσαι ἐνώπιον τοῦ θηρίου, λέγων τοῖς κατοικοῦσιν ἐπὶ τῆς γῆς ποιῆσαι εἰκόνα τῷ θηρίῳ, ⸂ὃς ἔχει",
          {
            "noteId": 250
          },
          "τὴν πληγὴν ⸂τῆς μαχαίρης καὶ ἔζησεν",
          {
            "noteId": 251
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ ἐδόθη ⸀αὐτῷ",
          {
            "noteId": 252
          },
          "⸂δοῦναι πνεῦμα",
          {
            "noteId": 253
          },
          "τῇ εἰκόνι τοῦ θηρίου, ἵνα",
          {
            "noteId": 254
          },
          "καὶ λαλήσῃ ἡ εἰκὼν τοῦ θηρίου καὶ ποιήσῃ ⸀ἵνα ὅσοι ἐὰν μὴ προσκυνήσωσιν τῇ εἰκόνι τοῦ θηρίου ἀποκτανθῶσιν."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ ποιεῖ πάντας, τοὺς μικροὺς καὶ τοὺς μεγάλους, καὶ τοὺς πλουσίους καὶ τοὺς πτωχούς, καὶ τοὺς ἐλευθέρους καὶ τοὺς δούλους, ἵνα ⸀δῶσιν",
          {
            "noteId": 255
          },
          "αὐτοῖς ⸀χάραγμα",
          {
            "noteId": 256
          },
          "ἐπὶ τῆς χειρὸς αὐτῶν τῆς δεξιᾶς ἢ ἐπὶ τὸ μέτωπον αὐτῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καὶ ἵνα μή τις ⸀δύνηται",
          {
            "noteId": 257
          },
          "ἀγοράσαι ἢ πωλῆσαι εἰ μὴ ὁ ἔχων τὸ χάραγμα, τὸ ὄνομα τοῦ θηρίου ἢ τὸν ἀριθμὸν τοῦ ὀνόματος αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ὧδε ἡ σοφία ἐστίν· ὁ ἔχων νοῦν ψηφισάτω τὸν ἀριθμὸν τοῦ θηρίου, ἀριθμὸς γὰρ ἀνθρώπου ἐστίν· καὶ ὁ ἀριθμὸς ⸀αὐτοῦ",
          {
            "noteId": 258
          },
          "⸂ἑξακόσιοι ἑξήκοντα ἕξ",
          {
            "noteId": 259
          },
          "."
        ]
      }
    ],
