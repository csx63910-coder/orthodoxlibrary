  "chapter": {
    "number": 7,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "⸀Μετὰ",
          {
            "noteId": 128
          },
          "τοῦτο εἶδον τέσσαρας ἀγγέλους ἑστῶτας ἐπὶ τὰς τέσσαρας γωνίας τῆς γῆς, κρατοῦντας τοὺς τέσσαρας ἀνέμους τῆς γῆς, ἵνα μὴ πνέῃ ἄνεμος ἐπὶ τῆς γῆς μήτε ἐπὶ τῆς θαλάσσης μήτε ἐπὶ ⸀πᾶν",
          {
            "noteId": 129
          },
          "δένδρον."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ εἶδον ἄλλον ἄγγελον ἀναβαίνοντα ἀπὸ ἀνατολῆς ἡλίου, ἔχοντα σφραγῖδα θεοῦ ζῶντος, καὶ ἔκραξεν φωνῇ μεγάλῃ τοῖς τέσσαρσιν ἀγγέλοις οἷς ἐδόθη αὐτοῖς ἀδικῆσαι τὴν γῆν καὶ τὴν θάλασσαν,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "λέγων· Μὴ ἀδικήσητε τὴν γῆν μήτε τὴν θάλασσαν μήτε τὰ δένδρα, ⸀ἄχρι",
          {
            "noteId": 130
          },
          "σφραγίσωμεν τοὺς δούλους τοῦ θεοῦ ἡμῶν ἐπὶ τῶν μετώπων αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Καὶ ἤκουσα τὸν ἀριθμὸν τῶν ἐσφραγισμένων, ⸀ἑκατὸν",
          {
            "noteId": 131
          },
          "τεσσεράκοντα τέσσαρες χιλιάδες, ⸀ἐσφραγισμένοι",
          {
            "noteId": 132
          },
          "ἐκ πάσης φυλῆς υἱῶν Ἰσραήλ·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἐκ φυλῆς Ἰούδα δώδεκα χιλιάδες ⸀ἐσφραγισμένοι",
          {
            "noteId": 133
          },
          "ἐκ φυλῆς Ῥουβὴν δώδεκα χιλιάδες, ἐκ φυλῆς Γὰδ δώδεκα χιλιάδες,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἐκ φυλῆς Ἀσὴρ δώδεκα χιλιάδες, ἐκ φυλῆς Νεφθαλὶμ δώδεκα χιλιάδες, ἐκ φυλῆς Μανασσῆ δώδεκα χιλιάδες,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἐκ φυλῆς Συμεὼν δώδεκα χιλιάδες, ἐκ φυλῆς Λευὶ δώδεκα χιλιάδες, ἐκ φυλῆς Ἰσσαχὰρ δώδεκα χιλιάδες,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἐκ φυλῆς Ζαβουλὼν δώδεκα χιλιάδες,",
          {
            "noteId": 134
          },
          "ἐκ φυλῆς Ἰωσὴφ δώδεκα χιλιάδες, ἐκ φυλῆς Βενιαμὶν δώδεκα χιλιάδες ⸀ἐσφραγισμένοι."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Μετὰ ταῦτα εἶδον, καὶ ἰδοὺ ὄχλος πολύς, ὃν ἀριθμῆσαι ⸀αὐτὸν",
          {
            "noteId": 135
          },
          "οὐδεὶς ἐδύνατο, ἐκ παντὸς ἔθνους καὶ φυλῶν καὶ λαῶν καὶ γλωσσῶν, ⸀ἑστῶτες",
          {
            "noteId": 136
          },
          "ἐνώπιον τοῦ θρόνου καὶ ἐνώπιον τοῦ ἀρνίου, περιβεβλημένους στολὰς λευκάς, καὶ ⸀φοίνικες",
          {
            "noteId": 137
          },
          "ἐν ταῖς χερσὶν αὐτῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ κράζουσι φωνῇ μεγάλῃ λέγοντες· Ἡ σωτηρία τῷ θεῷ ἡμῶν τῷ καθημένῳ ἐπὶ τῷ θρόνῳ καὶ τῷ ἀρνίῳ."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ πάντες οἱ ἄγγελοι εἱστήκεισαν κύκλῳ τοῦ θρόνου καὶ τῶν πρεσβυτέρων καὶ τῶν τεσσάρων ζῴων, καὶ ἔπεσαν ἐνώπιον τοῦ θρόνου ἐπὶ τὰ πρόσωπα αὐτῶν καὶ προσεκύνησαν τῷ θεῷ,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "λέγοντες· Ἀμήν· ἡ εὐλογία καὶ ἡ δόξα καὶ ἡ σοφία καὶ ἡ εὐχαριστία καὶ ἡ τιμὴ καὶ ἡ δύναμις καὶ ἡ ἰσχὺς τῷ θεῷ ἡμῶν εἰς τοὺς αἰῶνας τῶν αἰώνων· ἀμήν."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Καὶ ἀπεκρίθη εἷς ἐκ τῶν πρεσβυτέρων λέγων μοι· Οὗτοι οἱ περιβεβλημένοι τὰς στολὰς τὰς λευκὰς τίνες εἰσὶν καὶ πόθεν ἦλθον;"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καὶ ⸀εἴρηκα",
          {
            "noteId": 138
          },
          "αὐτῷ· Κύριέ μου, σὺ οἶδας. καὶ εἶπέν μοι· Οὗτοί εἰσιν οἱ ἐρχόμενοι ἐκ τῆς θλίψεως τῆς μεγάλης, καὶ ἔπλυναν τὰς στολὰς αὐτῶν καὶ ἐλεύκαναν ⸀αὐτὰς",
          {
            "noteId": 139
          },
          "ἐν τῷ αἵματι τοῦ ἀρνίου."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "διὰ τοῦτό εἰσιν ἐνώπιον τοῦ θρόνου",
          {
            "noteId": 140
          },
          "τοῦ θεοῦ, καὶ λατρεύουσιν αὐτῷ ἡμέρας καὶ νυκτὸς ἐν τῷ ναῷ αὐτοῦ, καὶ ὁ καθήμενος ἐπὶ ⸂τοῦ θρόνου⸃ σκηνώσει ἐπʼ αὐτούς."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "οὐ πεινάσουσιν ἔτι ⸀οὐδὲ",
          {
            "noteId": 141
          },
          "διψήσουσιν ἔτι, οὐδὲ μὴ πέσῃ ἐπʼ αὐτοὺς ὁ ἥλιος οὐδὲ πᾶν καῦμα,"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ὅτι τὸ ἀρνίον τὸ ἀνὰ μέσον τοῦ θρόνου ⸀ποιμανεῖ",
          {
            "noteId": 142
          },
          "αὐτούς, καὶ ⸀ὁδηγήσει",
          {
            "noteId": 143
          },
          "αὐτοὺς ἐπὶ ζωῆς πηγὰς ὑδάτων· καὶ ἐξαλείψει ὁ θεὸς πᾶν δάκρυον ἐκ τῶν ὀφθαλμῶν αὐτῶν."
        ]
      }
    ],
