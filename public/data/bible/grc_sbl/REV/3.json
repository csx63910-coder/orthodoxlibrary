  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ τῷ ἀγγέλῳ τῆς ἐν Σάρδεσιν ἐκκλησίας γράψον· Τάδε λέγει ὁ ἔχων τὰ ἑπτὰ πνεύματα τοῦ θεοῦ καὶ τοὺς ἑπτὰ ἀστέρας· Οἶδά σου τὰ ἔργα, ὅτι ὄνομα ἔχεις ὅτι ζῇς, καὶ νεκρὸς εἶ."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "γίνου γρηγορῶν, καὶ στήρισον τὰ λοιπὰ ἃ ⸂ἔμελλον ἀποθανεῖν",
          {
            "noteId": 45
          },
          ", οὐ γὰρ εὕρηκά σου ⸀τὰ",
          {
            "noteId": 46
          },
          "ἔργα πεπληρωμένα ἐνώπιον τοῦ θεοῦ μου·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "μνημόνευε οὖν πῶς εἴληφας καὶ ἤκουσας καὶ τήρει, καὶ μετανόησον· ἐὰν οὖν μὴ γρηγορήσῃς, ⸀ἥξω",
          {
            "noteId": 47
          },
          "ὡς κλέπτης, καὶ οὐ μὴ ⸀γνῷς",
          {
            "noteId": 48
          },
          "ποίαν ὥραν ἥξω ἐπὶ σέ·"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἀλλὰ ⸂ἔχεις ὀλίγα",
          {
            "noteId": 49
          },
          "ὀνόματα ἐν Σάρδεσιν ἃ οὐκ ἐμόλυναν τὰ ἱμάτια αὐτῶν, καὶ περιπατήσουσιν μετʼ ἐμοῦ ἐν λευκοῖς, ὅτι ἄξιοί εἰσιν."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ὁ νικῶν ⸀οὕτως",
          {
            "noteId": 50
          },
          "περιβαλεῖται ἐν ἱματίοις λευκοῖς, καὶ οὐ μὴ ἐξαλείψω τὸ ὄνομα αὐτοῦ ἐκ τῆς βίβλου τῆς ζωῆς, καὶ ὁμολογήσω τὸ ὄνομα αὐτοῦ ἐνώπιον τοῦ πατρός μου καὶ ἐνώπιον τῶν ἀγγέλων αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ὁ ἔχων οὖς ἀκουσάτω τί τὸ πνεῦμα λέγει ταῖς ἐκκλησίαις."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Καὶ τῷ ἀγγέλῳ τῆς ἐν Φιλαδελφείᾳ ἐκκλησίας γράψον· Τάδε λέγει ὁ ἅγιος, ὁ ἀληθινός, ὁ ἔχων τὴν κλεῖν ⸀Δαυίδ",
          {
            "noteId": 51
          },
          "ὁ ἀνοίγων καὶ οὐδεὶς κλείσει, ⸂καὶ κλείων",
          {
            "noteId": 52
          },
          "καὶ οὐδεὶς ⸀ἀνοίγει",
          {
            "noteId": 53
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Οἶδά σου τὰ ἔργα— ἰδοὺ δέδωκα ἐνώπιόν σου θύραν ἠνεῳγμένην, ἣν οὐδεὶς δύναται κλεῖσαι αὐτήν— ὅτι μικρὰν ἔχεις δύναμιν, καὶ ἐτήρησάς μου τὸν λόγον, καὶ οὐκ ἠρνήσω τὸ ὄνομά μου."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ἰδοὺ ⸀διδῶ",
          {
            "noteId": 54
          },
          "ἐκ τῆς συναγωγῆς τοῦ Σατανᾶ, τῶν λεγόντων ἑαυτοὺς Ἰουδαίους εἶναι, καὶ οὐκ εἰσὶν ἀλλὰ ψεύδονται— ἰδοὺ ποιήσω αὐτοὺς ἵνα ⸂ἥξουσιν καὶ προσκυνήσουσιν",
          {
            "noteId": 55
          },
          "ἐνώπιον τῶν ποδῶν σου, καὶ γνῶσιν ὅτι ⸀ἐγὼ",
          {
            "noteId": 56
          },
          "ἠγάπησά σε."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ὅτι ἐτήρησας τὸν λόγον τῆς ὑπομονῆς μου, κἀγώ σε τηρήσω ἐκ τῆς ὥρας τοῦ πειρασμοῦ τῆς μελλούσης ἔρχεσθαι ἐπὶ τῆς οἰκουμένης ὅλης, πειράσαι τοὺς κατοικοῦντας ἐπὶ τῆς γῆς."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ἔρχομαι ταχύ· κράτει ὃ ἔχεις, ἵνα μηδεὶς λάβῃ τὸν στέφανόν σου."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ὁ νικῶν ποιήσω αὐτὸν στῦλον ἐν τῷ ναῷ τοῦ θεοῦ μου, καὶ ἔξω οὐ μὴ ἐξέλθῃ ἔτι, καὶ γράψω ἐπʼ αὐτὸν τὸ ὄνομα τοῦ θεοῦ μου καὶ τὸ ὄνομα τῆς πόλεως τοῦ θεοῦ μου, τῆς καινῆς Ἰερουσαλήμ, ἡ ⸀καταβαίνουσα",
          {
            "noteId": 57
          },
          "ἐκ τοῦ οὐρανοῦ ἀπὸ τοῦ θεοῦ μου, καὶ τὸ ὄνομά μου τὸ καινόν."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ὁ ἔχων οὖς ἀκουσάτω τί τὸ πνεῦμα λέγει ταῖς ἐκκλησίαις."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Καὶ τῷ ἀγγέλῳ τῆς ἐν Λαοδικείᾳ ἐκκλησίας γράψον· Τάδε λέγει ὁ Ἀμήν, ὁ μάρτυς ὁ πιστὸς ⸀καὶ",
          {
            "noteId": 58
          },
          "ἀληθινός, ἡ ἀρχὴ τῆς κτίσεως τοῦ θεοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Οἶδά σου τὰ ἔργα, ὅτι οὔτε ψυχρὸς εἶ οὔτε ζεστός. ὄφελον ψυχρὸς ἦς ἢ ζεστός."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "οὕτως, ὅτι χλιαρὸς εἶ καὶ ⸀οὔτε",
          {
            "noteId": 59
          },
          "ζεστὸς οὔτε ψυχρός, μέλλω σε ἐμέσαι ἐκ τοῦ στόματός μου."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ὅτι",
          {
            "noteId": 60
          },
          "λέγεις ⸀ὅτι Πλούσιός εἰμι καὶ πεπλούτηκα καὶ ⸀οὐδὲν",
          {
            "noteId": 61
          },
          "χρείαν ἔχω, καὶ",
          {
            "noteId": 62
          },
          "οὐκ οἶδας ὅτι σὺ εἶ ὁ ταλαίπωρος ⸀καὶ ἐλεεινὸς καὶ πτωχὸς καὶ τυφλὸς καὶ γυμνός,"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "συμβουλεύω σοι ἀγοράσαι ⸂παρʼ ἐμοῦ χρυσίον",
          {
            "noteId": 63
          },
          "πεπυρωμένον ἐκ πυρὸς ἵνα πλουτήσῃς, καὶ ἱμάτια λευκὰ ἵνα περιβάλῃ καὶ μὴ φανερωθῇ ἡ αἰσχύνη τῆς γυμνότητός σου, καὶ κολλούριον ⸀ἐγχρῖσαι",
          {
            "noteId": 64
          },
          "τοὺς ὀφθαλμούς σου ἵνα βλέπῃς."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἐγὼ ὅσους ἐὰν φιλῶ ἐλέγχω καὶ παιδεύω· ⸀ζήλευε",
          {
            "noteId": 65
          },
          "οὖν καὶ μετανόησον."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἰδοὺ ἕστηκα ἐπὶ τὴν θύραν καὶ",
          {
            "noteId": 66
          },
          "κρούω· ἐάν τις ἀκούσῃ τῆς φωνῆς μου καὶ ἀνοίξῃ τὴν θύραν, ⸀καὶ εἰσελεύσομαι πρὸς αὐτὸν καὶ δειπνήσω μετʼ αὐτοῦ καὶ αὐτὸς μετʼ ἐμοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ὁ νικῶν δώσω αὐτῷ καθίσαι μετʼ ἐμοῦ ἐν τῷ θρόνῳ μου, ὡς κἀγὼ ἐνίκησα καὶ ἐκάθισα μετὰ τοῦ πατρός μου ἐν τῷ θρόνῳ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ὁ ἔχων οὖς ἀκουσάτω τί τὸ πνεῦμα λέγει ταῖς ἐκκλησίαις."
        ]
      }
    ],
