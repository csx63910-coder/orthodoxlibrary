  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Μετὰ ταῦτα εἶδον, καὶ ἰδοὺ θύρα ἠνεῳγμένη ἐν τῷ οὐρανῷ, καὶ ἡ φωνὴ ἡ πρώτη ἣν ἤκουσα ὡς σάλπιγγος λαλούσης μετʼ ἐμοῦ, λέγων· Ἀνάβα ὧδε, καὶ δείξω σοι ἃ δεῖ γενέσθαι. μετὰ ταῦτα"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "⸀εὐθέως",
          {
            "noteId": 67
          },
          "ἐγενόμην ἐν πνεύματι· καὶ ἰδοὺ θρόνος ἔκειτο ἐν τῷ οὐρανῷ, καὶ ἐπὶ τὸν θρόνον καθήμενος,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "⸂καὶ ὁ καθήμενος",
          {
            "noteId": 68
          },
          "ὅμοιος ὁράσει λίθῳ ἰάσπιδι καὶ σαρδίῳ, καὶ ἶρις κυκλόθεν τοῦ θρόνου ⸂ὅμοιος ὁράσει σμαραγδίνῳ",
          {
            "noteId": 69
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ κυκλόθεν τοῦ θρόνου ⸀θρόνοι",
          {
            "noteId": 70
          },
          "εἴκοσι τέσσαρες, καὶ ἐπὶ τοὺς ⸀θρόνους",
          {
            "noteId": 71
          },
          "εἴκοσι τέσσαρας πρεσβυτέρους καθημένους περιβεβλημένους ⸀ἐν",
          {
            "noteId": 72
          },
          "ἱματίοις λευκοῖς, καὶ ἐπὶ τὰς κεφαλὰς αὐτῶν στεφάνους χρυσοῦς."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ ἐκ τοῦ θρόνου ἐκπορεύονται ἀστραπαὶ καὶ φωναὶ καὶ βρονταί· καὶ ἑπτὰ λαμπάδες πυρὸς καιόμεναι ἐνώπιον τοῦ θρόνου, ⸀ἅ",
          {
            "noteId": 73
          },
          "εἰσιν ⸀τὰ",
          {
            "noteId": 74
          },
          "ἑπτὰ πνεύματα τοῦ θεοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ ἐνώπιον τοῦ θρόνου ὡς θάλασσα ὑαλίνη ὁμοία κρυστάλλῳ. Καὶ ἐν μέσῳ τοῦ θρόνου καὶ κύκλῳ τοῦ θρόνου τέσσαρα ζῷα γέμοντα ὀφθαλμῶν ἔμπροσθεν καὶ ὄπισθεν·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "καὶ τὸ ζῷον τὸ πρῶτον ὅμοιον λέοντι, καὶ τὸ δεύτερον ζῷον ὅμοιον μόσχῳ, καὶ τὸ τρίτον ζῷον ⸀ἔχων",
          {
            "noteId": 75
          },
          "⸂τὸ πρόσωπον ὡς",
          {
            "noteId": 76
          },
          "ἀνθρώπου, καὶ τὸ τέταρτον ζῷον ὅμοιον ἀετῷ πετομένῳ·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ τὰ τέσσαρα ζῷα, ἓν ⸂καθʼ ἓν",
          {
            "noteId": 77
          },
          "⸀αὐτῶν",
          {
            "noteId": 78
          },
          "⸀ἔχων",
          {
            "noteId": 79
          },
          "ἀνὰ πτέρυγας ἕξ, κυκλόθεν καὶ ἔσωθεν γέμουσιν ὀφθαλμῶν· καὶ ἀνάπαυσιν οὐκ ἔχουσιν ἡμέρας καὶ νυκτὸς λέγοντες· Ἅγιος ἅγιος ἅγιος κύριος, ὁ θεός, ὁ παντοκράτωρ, ὁ ἦν καὶ ὁ ὢν καὶ ὁ ἐρχόμενος."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ ὅταν ⸀δώσουσιν",
          {
            "noteId": 80
          },
          "τὰ ζῷα δόξαν καὶ τιμὴν καὶ εὐχαριστίαν τῷ καθημένῳ ἐπὶ ⸂τῷ θρόνῳ",
          {
            "noteId": 81
          },
          ", τῷ ζῶντι εἰς τοὺς αἰῶνας τῶν αἰώνων,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "πεσοῦνται οἱ εἴκοσι τέσσαρες πρεσβύτεροι ἐνώπιον τοῦ καθημένου ἐπὶ τοῦ θρόνου, καὶ προσκυνήσουσιν τῷ ζῶντι εἰς τοὺς αἰῶνας τῶν αἰώνων, καὶ βαλοῦσιν τοὺς στεφάνους αὐτῶν ἐνώπιον τοῦ θρόνου, λέγοντες·"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ἄξιος εἶ, ὁ κύριος καὶ ὁ θεὸς ⸀ἡμῶν",
          {
            "noteId": 82
          },
          "λαβεῖν τὴν δόξαν καὶ τὴν τιμὴν καὶ τὴν δύναμιν, ὅτι σὺ ἔκτισας ⸀τὰ",
          {
            "noteId": 83
          },
          "πάντα, καὶ διὰ τὸ θέλημά σου ἦσαν καὶ ἐκτίσθησαν."
        ]
      }
    ],
