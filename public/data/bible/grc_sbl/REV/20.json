  "chapter": {
    "number": 20,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ εἶδον ἄγγελον καταβαίνοντα ἐκ τοῦ οὐρανοῦ, ἔχοντα τὴν κλεῖν τῆς ἀβύσσου καὶ ἅλυσιν μεγάλην ἐπὶ τὴν χεῖρα αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ ἐκράτησεν τὸν δράκοντα, ⸂ὁ ὄφις ὁ ἀρχαῖος",
          {
            "noteId": 381
          },
          ", ὅς ἐστιν Διάβολος καὶ ὁ ⸀Σατανᾶς",
          {
            "noteId": 382
          },
          "καὶ ἔδησεν αὐτὸν χίλια ἔτη,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ ἔβαλεν αὐτὸν εἰς τὴν ἄβυσσον, καὶ ἔκλεισεν καὶ ἐσφράγισεν ἐπάνω αὐτοῦ, ἵνα μὴ ⸀πλανήσῃ",
          {
            "noteId": 383
          },
          "ἔτι τὰ ἔθνη, ἄχρι τελεσθῇ τὰ χίλια ἔτη· ⸀μετὰ",
          {
            "noteId": 384
          },
          "ταῦτα δεῖ ⸂λυθῆναι αὐτὸν",
          {
            "noteId": 385
          },
          "μικρὸν χρόνον."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Καὶ εἶδον θρόνους, καὶ ἐκάθισαν ἐπʼ αὐτούς, καὶ κρίμα ἐδόθη αὐτοῖς, καὶ τὰς ψυχὰς τῶν πεπελεκισμένων διὰ τὴν μαρτυρίαν Ἰησοῦ καὶ διὰ τὸν λόγον τοῦ θεοῦ, καὶ οἵτινες οὐ προσεκύνησαν τὸ θηρίον οὐδὲ τὴν εἰκόνα αὐτοῦ καὶ οὐκ ἔλαβον τὸ χάραγμα ἐπὶ τὸ μέτωπον καὶ ἐπὶ τὴν χεῖρα αὐτῶν· καὶ ἔζησαν καὶ ἐβασίλευσαν μετὰ τοῦ χριστοῦ ⸀χίλια",
          {
            "noteId": 386
          },
          "ἔτη."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "⸀οἱ",
          {
            "noteId": 387
          },
          "λοιποὶ τῶν νεκρῶν οὐκ ἔζησαν ἄχρι τελεσθῇ τὰ χίλια ἔτη. αὕτη ἡ ἀνάστασις ἡ πρώτη."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "μακάριος καὶ ἅγιος ὁ ἔχων μέρος ἐν τῇ ἀναστάσει τῇ πρώτῃ· ἐπὶ τούτων ὁ δεύτερος θάνατος οὐκ ἔχει ἐξουσίαν, ἀλλʼ ἔσονται ἱερεῖς τοῦ θεοῦ καὶ τοῦ χριστοῦ, καὶ βασιλεύσουσιν μετʼ αὐτοῦ ⸀χίλια",
          {
            "noteId": 388
          },
          "ἔτη."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Καὶ ὅταν τελεσθῇ τὰ χίλια ἔτη, λυθήσεται ὁ Σατανᾶς ἐκ τῆς φυλακῆς αὐτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ",
          {
            "noteId": 389
          },
          "ἐξελεύσεται πλανῆσαι τὰ ἔθνη τὰ ἐν ταῖς τέσσαρσι γωνίαις τῆς γῆς, τὸν Γὼγ ⸀καὶ Μαγώγ, συναγαγεῖν αὐτοὺς εἰς τὸν πόλεμον, ὧν ὁ ἀριθμὸς ⸀αὐτῶν",
          {
            "noteId": 390
          },
          "ὡς ἡ ἄμμος τῆς θαλάσσης."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ ἀνέβησαν ἐπὶ τὸ πλάτος τῆς γῆς, καὶ ⸀ἐκύκλευσαν",
          {
            "noteId": 391
          },
          "τὴν παρεμβολὴν τῶν ἁγίων καὶ τὴν πόλιν τὴν ἠγαπημένην. καὶ κατέβη πῦρ ⸂ἐκ τοῦ οὐρανοῦ",
          {
            "noteId": 392
          },
          "καὶ κατέφαγεν αὐτούς·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ ὁ διάβολος ὁ πλανῶν αὐτοὺς ἐβλήθη εἰς τὴν λίμνην τοῦ πυρὸς καὶ θείου, ὅπου καὶ τὸ θηρίον καὶ ὁ ψευδοπροφήτης, καὶ βασανισθήσονται ἡμέρας καὶ νυκτὸς εἰς τοὺς αἰῶνας τῶν αἰώνων."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Καὶ εἶδον θρόνον μέγαν λευκὸν καὶ τὸν καθήμενον ⸂ἐπʼ αὐτοῦ",
          {
            "noteId": 393
          },
          ", οὗ ἀπὸ ⸀τοῦ",
          {
            "noteId": 394
          },
          "προσώπου ἔφυγεν ἡ γῆ καὶ ὁ οὐρανός, καὶ τόπος οὐχ εὑρέθη αὐτοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "καὶ εἶδον τοὺς νεκρούς, τοὺς μεγάλους καὶ τοὺς μικρούς, ἑστῶτας ἐνώπιον τοῦ θρόνου, καὶ βιβλία ἠνοίχθησαν· καὶ ἄλλο βιβλίον ἠνοίχθη, ὅ ἐστιν τῆς ζωῆς· καὶ ἐκρίθησαν οἱ νεκροὶ ἐκ τῶν γεγραμμένων ἐν τοῖς βιβλίοις κατὰ τὰ ἔργα αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ ἔδωκεν ἡ θάλασσα τοὺς νεκροὺς τοὺς ἐν αὐτῇ, καὶ ὁ θάνατος καὶ ὁ ᾅδης ἔδωκαν τοὺς νεκροὺς τοὺς ἐν αὐτοῖς, καὶ ἐκρίθησαν ἕκαστος κατὰ τὰ ἔργα αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καὶ ὁ θάνατος καὶ ὁ ᾅδης ἐβλήθησαν εἰς τὴν λίμνην τοῦ πυρός. οὗτος ὁ ⸂θάνατος ὁ δεύτερός",
          {
            "noteId": 395
          },
          "ἐστιν, ἡ λίμνη τοῦ πυρός."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ εἴ τις οὐχ εὑρέθη ἐν ⸂τῇ βίβλῳ",
          {
            "noteId": 396
          },
          "τῆς ζωῆς γεγραμμένος, ἐβλήθη εἰς τὴν λίμνην τοῦ πυρός."
        ]
      }
    ],
