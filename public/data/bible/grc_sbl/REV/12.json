  "chapter": {
    "number": 12,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ σημεῖον μέγα ὤφθη ἐν τῷ οὐρανῷ, γυνὴ περιβεβλημένη τὸν ἥλιον, καὶ ἡ σελήνη ὑποκάτω τῶν ποδῶν αὐτῆς, καὶ ἐπὶ τῆς κεφαλῆς αὐτῆς στέφανος ἀστέρων δώδεκα,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ ἐν γαστρὶ ἔχουσα· ⸂καὶ κράζει",
          {
            "noteId": 214
          },
          "ὠδίνουσα καὶ βασανιζομένη τεκεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ ὤφθη ἄλλο σημεῖον ἐν τῷ οὐρανῷ, καὶ ἰδοὺ δράκων ⸂μέγας πυρρός",
          {
            "noteId": 215
          },
          ", ἔχων κεφαλὰς ἑπτὰ καὶ κέρατα δέκα καὶ ἐπὶ τὰς κεφαλὰς αὐτοῦ ἑπτὰ διαδήματα,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ ἡ οὐρὰ αὐτοῦ σύρει τὸ τρίτον τῶν ἀστέρων τοῦ οὐρανοῦ, καὶ ἔβαλεν αὐτοὺς εἰς τὴν γῆν. καὶ ὁ δράκων ἕστηκεν ἐνώπιον τῆς γυναικὸς τῆς μελλούσης τεκεῖν, ἵνα ὅταν τέκῃ τὸ τέκνον αὐτῆς καταφάγῃ."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ ἔτεκεν υἱόν, ⸀ἄρσεν",
          {
            "noteId": 216
          },
          "ὃς μέλλει ποιμαίνειν πάντα τὰ ἔθνη ἐν ῥάβδῳ σιδηρᾷ· καὶ ἡρπάσθη τὸ τέκνον αὐτῆς πρὸς τὸν θεὸν καὶ πρὸς τὸν θρόνον αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ ἡ γυνὴ ἔφυγεν εἰς τὴν ἔρημον, ὅπου ἔχει ἐκεῖ τόπον ἡτοιμασμένον ⸀ἀπὸ",
          {
            "noteId": 217
          },
          "τοῦ θεοῦ, ἵνα ἐκεῖ ⸀τρέφωσιν",
          {
            "noteId": 218
          },
          "αὐτὴν ἡμέρας χιλίας διακοσίας ἑξήκοντα."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Καὶ ἐγένετο πόλεμος ἐν τῷ οὐρανῷ, ὁ Μιχαὴλ καὶ οἱ ἄγγελοι αὐτοῦ",
          {
            "noteId": 219
          },
          "⸀τοῦ πολεμῆσαι μετὰ τοῦ δράκοντος. καὶ ὁ δράκων ἐπολέμησεν καὶ οἱ ἄγγελοι αὐτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ οὐκ ⸀ἴσχυσεν",
          {
            "noteId": 220
          },
          "οὐδὲ τόπος εὑρέθη ⸀αὐτῶν",
          {
            "noteId": 221
          },
          "ἔτι ἐν τῷ οὐρανῷ."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ ἐβλήθη ὁ",
          {
            "noteId": 222
          },
          "δράκων ὁ μέγας, ὁ ὄφις ὁ ἀρχαῖος, ὁ καλούμενος Διάβολος καὶ ⸀ὁ Σατανᾶς, ὁ πλανῶν τὴν οἰκουμένην ὅλην— ἐβλήθη εἰς τὴν γῆν, καὶ οἱ ἄγγελοι αὐτοῦ μετʼ αὐτοῦ ἐβλήθησαν."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Καὶ ἤκουσα φωνὴν μεγάλην ἐν τῷ οὐρανῷ λέγουσαν· Ἄρτι ἐγένετο ἡ σωτηρία καὶ ἡ δύναμις καὶ ἡ βασιλεία τοῦ θεοῦ ἡμῶν καὶ ἡ ἐξουσία τοῦ χριστοῦ αὐτοῦ, ὅτι ἐβλήθη ὁ ⸀κατήγωρ",
          {
            "noteId": 223
          },
          "τῶν ἀδελφῶν ἡμῶν, ὁ κατηγορῶν ⸀αὐτοὺς",
          {
            "noteId": 224
          },
          "ἐνώπιον τοῦ θεοῦ ἡμῶν ἡμέρας καὶ νυκτός."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ αὐτοὶ ἐνίκησαν αὐτὸν διὰ τὸ αἷμα τοῦ ἀρνίου καὶ διὰ τὸν λόγον τῆς μαρτυρίας αὐτῶν, καὶ οὐκ ἠγάπησαν τὴν ψυχὴν αὐτῶν ἄχρι θανάτου·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "διὰ τοῦτο εὐφραίνεσθε, ⸀οἱ",
          {
            "noteId": 225
          },
          "οὐρανοὶ καὶ οἱ ἐν αὐτοῖς σκηνοῦντες. οὐαὶ ⸂τὴν γῆν καὶ τὴν θάλασσαν",
          {
            "noteId": 226
          },
          ", ὅτι κατέβη ὁ διάβολος πρὸς ὑμᾶς, ἔχων θυμὸν μέγαν, εἰδὼς ὅτι ὀλίγον καιρὸν ἔχει."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Καὶ ὅτε εἶδεν ὁ δράκων ὅτι ἐβλήθη εἰς τὴν γῆν, ἐδίωξεν τὴν γυναῖκα ἥτις ἔτεκεν τὸν ἄρσενα."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καὶ ἐδόθησαν τῇ γυναικὶ ⸀αἱ",
          {
            "noteId": 227
          },
          "δύο πτέρυγες τοῦ ἀετοῦ τοῦ μεγάλου, ἵνα πέτηται εἰς τὴν ἔρημον εἰς τὸν τόπον αὐτῆς, ⸂ὅπου τρέφεται",
          {
            "noteId": 228
          },
          "ἐκεῖ καιρὸν καὶ καιροὺς καὶ ἥμισυ καιροῦ ἀπὸ προσώπου τοῦ ὄφεως."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ ἔβαλεν ὁ ὄφις ἐκ τοῦ στόματος αὐτοῦ ὀπίσω τῆς γυναικὸς ὕδωρ ὡς ποταμόν, ἵνα αὐτὴν ποταμοφόρητον ποιήσῃ."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ ἐβοήθησεν ἡ γῆ τῇ γυναικί, καὶ ἤνοιξεν ἡ γῆ τὸ στόμα αὐτῆς καὶ κατέπιεν τὸν ποταμὸν ὃν ἔβαλεν ὁ δράκων ἐκ τοῦ στόματος αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καὶ ὠργίσθη ὁ δράκων ἐπὶ τῇ γυναικί, καὶ ἀπῆλθεν ποιῆσαι πόλεμον μετὰ τῶν λοιπῶν τοῦ σπέρματος αὐτῆς, τῶν τηρούντων τὰς ἐντολὰς τοῦ θεοῦ καὶ ἐχόντων τὴν μαρτυρίαν Ἰησοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ ⸀ἐστάθη",
          {
            "noteId": 229
          },
          "ἐπὶ τὴν ἄμμον τῆς θαλάσσης."
        ]
      }
    ],
