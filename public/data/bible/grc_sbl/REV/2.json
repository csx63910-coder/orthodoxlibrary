  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Τῷ ἀγγέλῳ ⸀τῆς",
          {
            "noteId": 17
          },
          "ἐν Ἐφέσῳ ἐκκλησίας γράψον· Τάδε λέγει ὁ κρατῶν τοὺς ἑπτὰ ἀστέρας ἐν τῇ δεξιᾷ αὐτοῦ, ὁ περιπατῶν ἐν μέσῳ τῶν ἑπτὰ λυχνιῶν τῶν χρυσῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Οἶδα τὰ ἔργα σου, καὶ τὸν ⸀κόπον",
          {
            "noteId": 18
          },
          "καὶ τὴν ὑπομονήν σου, καὶ ὅτι οὐ δύνῃ βαστάσαι κακούς, καὶ ἐπείρασας τοὺς λέγοντας ἑαυτοὺς ⸀ἀποστόλους",
          {
            "noteId": 19
          },
          "καὶ οὐκ εἰσίν, καὶ εὗρες αὐτοὺς ψευδεῖς·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ ὑπομονὴν ἔχεις, καὶ ἐβάστασας διὰ τὸ ὄνομά μου, καὶ ⸂οὐ κεκοπίακες",
          {
            "noteId": 20
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἀλλὰ ἔχω κατὰ σοῦ ὅτι τὴν ἀγάπην σου τὴν πρώτην ἀφῆκες."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "μνημόνευε οὖν πόθεν ⸀πέπτωκας",
          {
            "noteId": 21
          },
          "καὶ μετανόησον καὶ τὰ πρῶτα ἔργα ποίησον· εἰ δὲ μή, ἔρχομαί ⸀σοι",
          {
            "noteId": 22
          },
          "καὶ κινήσω τὴν λυχνίαν σου ἐκ τοῦ τόπου αὐτῆς, ἐὰν μὴ μετανοήσῃς."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἀλλὰ τοῦτο ἔχεις ὅτι μισεῖς τὰ ἔργα τῶν Νικολαϊτῶν, ἃ κἀγὼ μισῶ."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ὁ ἔχων οὖς ἀκουσάτω τί τὸ πνεῦμα λέγει ταῖς ἐκκλησίαις. τῷ νικῶντι δώσω αὐτῷ φαγεῖν ἐκ τοῦ ξύλου τῆς ζωῆς, ὅ ἐστιν ἐν τῷ παραδείσῳ τοῦ ⸀θεοῦ",
          {
            "noteId": 23
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Καὶ τῷ ἀγγέλῳ ⸀τῆς",
          {
            "noteId": 24
          },
          "ἐν Σμύρνῃ ἐκκλησίας γράψον· Τάδε λέγει ὁ πρῶτος καὶ ὁ ἔσχατος, ὃς ἐγένετο νεκρὸς καὶ ἔζησεν·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Οἶδά ⸀σου",
          {
            "noteId": 25
          },
          "τὴν θλῖψιν καὶ τὴν πτωχείαν, ἀλλὰ πλούσιος εἶ, καὶ τὴν βλασφημίαν ἐκ τῶν λεγόντων Ἰουδαίους εἶναι ἑαυτούς, καὶ οὐκ εἰσίν, ἀλλὰ συναγωγὴ τοῦ Σατανᾶ."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "⸀μηδὲν",
          {
            "noteId": 26
          },
          "φοβοῦ ἃ μέλλεις ⸀πάσχειν",
          {
            "noteId": 27
          },
          "⸀ἰδοὺ",
          {
            "noteId": 28
          },
          "μέλλει ⸀βάλλειν",
          {
            "noteId": 29
          },
          "ὁ διάβολος ἐξ ὑμῶν εἰς φυλακὴν ἵνα πειρασθῆτε, καὶ ⸀ἕξετε",
          {
            "noteId": 30
          },
          "θλῖψιν ἡμερῶν δέκα. γίνου πιστὸς ἄχρι θανάτου, καὶ δώσω σοι τὸν στέφανον τῆς ζωῆς."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ὁ ἔχων οὖς ἀκουσάτω τί τὸ πνεῦμα λέγει ταῖς ἐκκλησίαις. ὁ νικῶν οὐ μὴ ἀδικηθῇ ἐκ τοῦ θανάτου τοῦ δευτέρου."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Καὶ τῷ ἀγγέλῳ τῆς ἐν Περγάμῳ ἐκκλησίας γράψον· Τάδε λέγει ὁ ἔχων τὴν ῥομφαίαν τὴν δίστομον τὴν ὀξεῖαν·"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "⸀Οἶδα",
          {
            "noteId": 31
          },
          "ποῦ κατοικεῖς, ὅπου ὁ θρόνος τοῦ Σατανᾶ, καὶ",
          {
            "noteId": 32
          },
          "κρατεῖς τὸ ὄνομά μου, καὶ οὐκ ἠρνήσω τὴν πίστιν μου ⸀καὶ ἐν ταῖς ⸀ἡμέραις",
          {
            "noteId": 33
          },
          "Ἀντιπᾶς, ὁ μάρτυς μου",
          {
            "noteId": 34
          },
          "ὁ πιστός ⸀μου, ὃς ἀπεκτάνθη παρʼ ὑμῖν, ὅπου ὁ Σατανᾶς κατοικεῖ."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἀλλὰ ἔχω κατὰ σοῦ ὀλίγα, ὅτι ἔχεις ἐκεῖ κρατοῦντας τὴν διδαχὴν Βαλαάμ, ὃς ⸂ἐδίδασκεν τῷ",
          {
            "noteId": 35
          },
          "Βαλὰκ βαλεῖν σκάνδαλον ἐνώπιον τῶν υἱῶν Ἰσραήλ, ⸀φαγεῖν",
          {
            "noteId": 36
          },
          "εἰδωλόθυτα καὶ πορνεῦσαι·"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "οὕτως ἔχεις καὶ σὺ κρατοῦντας τὴν ⸀διδαχὴν",
          {
            "noteId": 37
          },
          "Νικολαϊτῶν ὁμοίως."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "μετανόησον οὖν· εἰ δὲ μή, ἔρχομαί σοι ταχύ, καὶ πολεμήσω μετʼ αὐτῶν ἐν τῇ ῥομφαίᾳ τοῦ στόματός μου."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ὁ ἔχων οὖς ἀκουσάτω τί τὸ πνεῦμα λέγει ταῖς ἐκκλησίαις. τῷ νικῶντι δώσω ⸀αὐτῷ",
          {
            "noteId": 38
          },
          "τοῦ μάννα τοῦ κεκρυμμένου, καὶ δώσω αὐτῷ ψῆφον λευκήν, καὶ ἐπὶ τὴν ψῆφον ὄνομα καινὸν γεγραμμένον ὃ οὐδεὶς οἶδεν εἰ μὴ ὁ λαμβάνων."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Καὶ τῷ ἀγγέλῳ ⸀τῆς",
          {
            "noteId": 39
          },
          "ἐν Θυατείροις ἐκκλησίας γράψον· Τάδε λέγει ὁ υἱὸς τοῦ θεοῦ, ὁ ἔχων τοὺς ὀφθαλμοὺς αὐτοῦ ὡς φλόγα πυρός, καὶ οἱ πόδες αὐτοῦ ὅμοιοι χαλκολιβάνῳ·"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Οἶδά σου τὰ ἔργα, καὶ τὴν ⸂ἀγάπην καὶ τὴν πίστιν",
          {
            "noteId": 40
          },
          "καὶ τὴν διακονίαν καὶ τὴν ὑπομονήν σου, καὶ τὰ ἔργα σου τὰ ἔσχατα πλείονα τῶν πρώτων."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἀλλὰ ἔχω κατὰ σοῦ ὅτι ἀφεῖς τὴν ⸀γυναῖκα",
          {
            "noteId": 41
          },
          "Ἰεζάβελ, ἡ ⸀λέγουσα",
          {
            "noteId": 42
          },
          "ἑαυτὴν προφῆτιν, καὶ διδάσκει καὶ πλανᾷ τοὺς ἐμοὺς δούλους πορνεῦσαι καὶ φαγεῖν εἰδωλόθυτα."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "καὶ ἔδωκα αὐτῇ χρόνον ἵνα μετανοήσῃ, καὶ οὐ θέλει μετανοῆσαι ἐκ τῆς πορνείας αὐτῆς."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ἰδοὺ βάλλω αὐτὴν εἰς κλίνην, καὶ τοὺς μοιχεύοντας μετʼ αὐτῆς εἰς θλῖψιν μεγάλην, ἐὰν μὴ ⸀μετανοήσωσιν",
          {
            "noteId": 43
          },
          "ἐκ τῶν ἔργων αὐτῆς·"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "καὶ τὰ τέκνα αὐτῆς ἀποκτενῶ ἐν θανάτῳ· καὶ γνώσονται πᾶσαι αἱ ἐκκλησίαι ὅτι ἐγώ εἰμι ὁ ἐραυνῶν νεφροὺς καὶ καρδίας, καὶ δώσω ὑμῖν ἑκάστῳ κατὰ τὰ ἔργα ὑμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ὑμῖν δὲ λέγω τοῖς λοιποῖς τοῖς ἐν Θυατείροις, ὅσοι οὐκ ἔχουσιν τὴν διδαχὴν ταύτην, οἵτινες οὐκ ἔγνωσαν τὰ βαθέα τοῦ Σατανᾶ, ὡς λέγουσιν, οὐ βάλλω ἐφʼ ὑμᾶς ἄλλο βάρος·"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "πλὴν ὃ ἔχετε κρατήσατε ἄχρι οὗ ἂν ἥξω."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "καὶ ὁ νικῶν καὶ ὁ τηρῶν ἄχρι τέλους τὰ ἔργα μου, δώσω αὐτῷ ἐξουσίαν ἐπὶ τῶν ἐθνῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "καὶ ποιμανεῖ αὐτοὺς ἐν ῥάβδῳ σιδηρᾷ ὡς τὰ σκεύη τὰ κεραμικὰ ⸀συντρίβεται",
          {
            "noteId": 44
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ὡς κἀγὼ εἴληφα παρὰ τοῦ πατρός μου, καὶ δώσω αὐτῷ τὸν ἀστέρα τὸν πρωϊνόν."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "ὁ ἔχων οὖς ἀκουσάτω τί τὸ πνεῦμα λέγει ταῖς ἐκκλησίαις."
        ]
      }
    ],
