  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ εἶδον ἐπὶ τὴν δεξιὰν τοῦ καθημένου ἐπὶ τοῦ θρόνου βιβλίον γεγραμμένον ἔσωθεν καὶ ⸀ὄπισθεν",
          {
            "noteId": 84
          },
          "κατεσφραγισμένον σφραγῖσιν ἑπτά."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ εἶδον ἄγγελον ἰσχυρὸν κηρύσσοντα ἐν φωνῇ μεγάλῃ· Τίς ⸀ἄξιος",
          {
            "noteId": 85
          },
          "ἀνοῖξαι τὸ βιβλίον καὶ λῦσαι τὰς σφραγῖδας αὐτοῦ;"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ οὐδεὶς ἐδύνατο ἐν τῷ ⸀οὐρανῷ",
          {
            "noteId": 86
          },
          "⸂οὐδὲ ἐπὶ τῆς γῆς οὐδὲ",
          {
            "noteId": 87
          },
          "ὑποκάτω τῆς γῆς ἀνοῖξαι τὸ βιβλίον οὔτε βλέπειν αὐτό."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ ⸀ἐγὼ",
          {
            "noteId": 88
          },
          "ἔκλαιον πολὺ ὅτι οὐδεὶς ἄξιος εὑρέθη ἀνοῖξαι τὸ βιβλίον οὔτε βλέπειν αὐτό·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ εἷς ἐκ τῶν πρεσβυτέρων λέγει μοι· Μὴ κλαῖε· ἰδοὺ ἐνίκησεν ὁ λέων ὁ ἐκ τῆς φυλῆς Ἰούδα, ἡ ῥίζα Δαυίδ, ⸀ἀνοῖξαι",
          {
            "noteId": 89
          },
          "τὸ βιβλίον καὶ τὰς ἑπτὰ σφραγῖδας αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Καὶ εἶδον ἐν μέσῳ τοῦ θρόνου καὶ τῶν τεσσάρων ζῴων καὶ ἐν μέσῳ τῶν πρεσβυτέρων ἀρνίον ⸀ἑστηκὸς",
          {
            "noteId": 90
          },
          "ὡς ἐσφαγμένον, ⸀ἔχων",
          {
            "noteId": 91
          },
          "κέρατα ἑπτὰ καὶ ὀφθαλμοὺς ἑπτά, ⸀οἵ",
          {
            "noteId": 92
          },
          "εἰσιν τὰ ἑπτὰ πνεύματα τοῦ θεοῦ, ⸀ἀπεσταλμένοι",
          {
            "noteId": 93
          },
          "εἰς πᾶσαν τὴν γῆν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "καὶ ἦλθεν καὶ εἴληφεν ἐκ τῆς δεξιᾶς τοῦ καθημένου ἐπὶ τοῦ θρόνου."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ ὅτε ἔλαβεν τὸ βιβλίον, τὰ τέσσαρα ζῷα καὶ οἱ εἴκοσι τέσσαρες πρεσβύτεροι ἔπεσαν ἐνώπιον τοῦ ἀρνίου, ἔχοντες ἕκαστος κιθάραν καὶ φιάλας χρυσᾶς γεμούσας θυμιαμάτων, αἵ εἰσιν ⸀αἱ",
          {
            "noteId": 94
          },
          "προσευχαὶ τῶν ἁγίων·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ ᾄδουσιν ᾠδὴν καινὴν λέγοντες· Ἄξιος εἶ λαβεῖν τὸ βιβλίον καὶ ἀνοῖξαι τὰς σφραγῖδας αὐτοῦ, ὅτι ἐσφάγης καὶ ἠγόρασας τῷ ⸀θεῷ",
          {
            "noteId": 95
          },
          "ἐν τῷ αἵματί σου ἐκ πάσης φυλῆς καὶ γλώσσης καὶ λαοῦ καὶ ἔθνους,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ ἐποίησας αὐτοὺς τῷ θεῷ ἡμῶν ⸀βασιλείαν",
          {
            "noteId": 96
          },
          "καὶ ἱερεῖς, καὶ ⸀βασιλεύουσιν",
          {
            "noteId": 97
          },
          "ἐπὶ τῆς γῆς."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Καὶ εἶδον, καὶ ⸀ἤκουσα",
          {
            "noteId": 98
          },
          "φωνὴν ἀγγέλων πολλῶν κύκλῳ τοῦ θρόνου καὶ τῶν ζῴων καὶ τῶν πρεσβυτέρων, καὶ ἦν ὁ ἀριθμὸς αὐτῶν μυριάδες μυριάδων καὶ χιλιάδες χιλιάδων,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "λέγοντες φωνῇ μεγάλῃ· Ἄξιόν ἐστιν τὸ ἀρνίον τὸ ἐσφαγμένον λαβεῖν τὴν δύναμιν ⸀καὶ",
          {
            "noteId": 99
          },
          "πλοῦτον καὶ σοφίαν καὶ ἰσχὺν καὶ τιμὴν καὶ δόξαν καὶ εὐλογίαν."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ πᾶν κτίσμα ὃ ἐν τῷ οὐρανῷ καὶ ἐπὶ τῆς γῆς καὶ ὑποκάτω τῆς γῆς καὶ ἐπὶ τῆς ⸀θαλάσσης",
          {
            "noteId": 100
          },
          "καὶ τὰ ἐν αὐτοῖς ⸀πάντα",
          {
            "noteId": 101
          },
          "ἤκουσα λέγοντας· Τῷ καθημένῳ ἐπὶ ⸂τῷ θρόνῳ",
          {
            "noteId": 102
          },
          "καὶ τῷ ἀρνίῳ ἡ εὐλογία καὶ ἡ τιμὴ καὶ ἡ δόξα καὶ τὸ κράτος εἰς τοὺς αἰῶνας τῶν ⸀αἰώνων",
          {
            "noteId": 103
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καὶ τὰ τέσσαρα ζῷα ⸀ἔλεγον",
          {
            "noteId": 104
          },
          "Ἀμήν. καὶ οἱ πρεσβύτεροι ἔπεσαν καὶ προσεκύνησαν."
        ]
      }
    ],
