  "chapter": {
    "number": 9,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ ὁ πέμπτος ἄγγελος ἐσάλπισεν· καὶ εἶδον ἀστέρα ἐκ τοῦ οὐρανοῦ πεπτωκότα εἰς τὴν γῆν, καὶ ἐδόθη αὐτῷ ἡ κλεὶς τοῦ φρέατος τῆς ἀβύσσου·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ ἤνοιξεν τὸ φρέαρ τῆς ἀβύσσου, καὶ ἀνέβη καπνὸς ἐκ τοῦ φρέατος ὡς καπνὸς καμίνου ⸀μεγάλης",
          {
            "noteId": 153
          },
          "καὶ ⸀ἐσκοτώθη",
          {
            "noteId": 154
          },
          "ὁ ἥλιος καὶ ὁ ἀὴρ ἐκ τοῦ καπνοῦ τοῦ φρέατος."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ ἐκ τοῦ καπνοῦ ἐξῆλθον ἀκρίδες εἰς τὴν γῆν, καὶ ἐδόθη αὐταῖς ἐξουσία ὡς ἔχουσιν ἐξουσίαν οἱ σκορπίοι τῆς γῆς."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ ἐρρέθη αὐταῖς ἵνα μὴ ⸀ἀδικήσουσιν",
          {
            "noteId": 155
          },
          "τὸν χόρτον τῆς γῆς οὐδὲ πᾶν χλωρὸν οὐδὲ πᾶν δένδρον, εἰ μὴ τοὺς ἀνθρώπους οἵτινες οὐκ ἔχουσι τὴν σφραγῖδα τοῦ θεοῦ ἐπὶ τῶν ⸀μετώπων",
          {
            "noteId": 156
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ ἐδόθη ⸀αὐτοῖς",
          {
            "noteId": 157
          },
          "ἵνα μὴ ἀποκτείνωσιν αὐτούς, ἀλλʼ ἵνα ⸀βασανισθήσονται",
          {
            "noteId": 158
          },
          "μῆνας πέντε· καὶ ὁ βασανισμὸς αὐτῶν ὡς βασανισμὸς σκορπίου, ὅταν παίσῃ ἄνθρωπον."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ ἐν ταῖς ἡμέραις ἐκείναις ζητήσουσιν οἱ ἄνθρωποι τὸν θάνατον καὶ οὐ μὴ εὑρήσουσιν αὐτόν, καὶ ἐπιθυμήσουσιν ἀποθανεῖν καὶ ⸀φεύγει",
          {
            "noteId": 159
          },
          "⸂ὁ θάνατος ἀπʼ αὐτῶν",
          {
            "noteId": 160
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Καὶ τὰ ὁμοιώματα τῶν ἀκρίδων ὅμοια ἵπποις ἡτοιμασμένοις εἰς πόλεμον, καὶ ἐπὶ τὰς κεφαλὰς αὐτῶν ὡς στέφανοι ⸂ὅμοιοι χρυσῷ",
          {
            "noteId": 161
          },
          ", καὶ τὰ πρόσωπα αὐτῶν ὡς πρόσωπα ἀνθρώπων,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ εἶχον τρίχας ὡς τρίχας γυναικῶν, καὶ οἱ ὀδόντες αὐτῶν ὡς λεόντων ἦσαν,"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ εἶχον θώρακας ὡς θώρακας σιδηροῦς, καὶ ἡ φωνὴ τῶν πτερύγων αὐτῶν ὡς φωνὴ ἁρμάτων ἵππων πολλῶν τρεχόντων εἰς πόλεμον·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ ἔχουσιν οὐρὰς ὁμοίας σκορπίοις καὶ κέντρα, καὶ ἐν ταῖς οὐραῖς αὐτῶν ⸂ἡ ἐξουσία αὐτῶν",
          {
            "noteId": 162
          },
          "ἀδικῆσαι τοὺς ἀνθρώπους μῆνας πέντε."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "⸂ἔχουσιν ἐπʼ αὐτῶν βασιλέα τὸν",
          {
            "noteId": 163
          },
          "ἄγγελον τῆς ἀβύσσου· ὄνομα αὐτῷ Ἑβραϊστὶ Ἀβαδδών, ⸂καὶ ἐν",
          {
            "noteId": 164
          },
          "τῇ Ἑλληνικῇ ὄνομα ἔχει Ἀπολλύων."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ἡ οὐαὶ ἡ μία ἀπῆλθεν· ἰδοὺ ἔρχεται ἔτι δύο οὐαὶ μετὰ ταῦτα."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Καὶ ὁ ἕκτος ἄγγελος ἐσάλπισεν· καὶ ἤκουσα φωνὴν μίαν ἐκ ⸀τῶν",
          {
            "noteId": 165
          },
          "κεράτων τοῦ θυσιαστηρίου τοῦ χρυσοῦ τοῦ ἐνώπιον τοῦ θεοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "⸀λέγοντα",
          {
            "noteId": 166
          },
          "τῷ ἕκτῳ ἀγγέλῳ, ὁ ἔχων τὴν σάλπιγγα· Λῦσον τοὺς τέσσαρας ἀγγέλους τοὺς δεδεμένους ἐπὶ τῷ ποταμῷ τῷ μεγάλῳ Εὐφράτῃ."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ",
          {
            "noteId": 167
          },
          "ἐλύθησαν οἱ τέσσαρες ἄγγελοι οἱ ἡτοιμασμένοι εἰς τὴν ὥραν ⸀καὶ ἡμέραν καὶ μῆνα καὶ ἐνιαυτόν, ἵνα ἀποκτείνωσιν τὸ τρίτον τῶν ἀνθρώπων."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ ὁ ἀριθμὸς τῶν στρατευμάτων τοῦ ⸀ἱππικοῦ",
          {
            "noteId": 168
          },
          "⸀δισμυριάδες",
          {
            "noteId": 169
          },
          "μυριάδων· ἤκουσα τὸν ἀριθμὸν αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καὶ οὕτως εἶδον τοὺς ἵππους ἐν τῇ ὁράσει καὶ τοὺς καθημένους ἐπʼ αὐτῶν, ἔχοντας θώρακας πυρίνους καὶ ὑακινθίνους καὶ θειώδεις· καὶ αἱ κεφαλαὶ τῶν ἵππων ὡς κεφαλαὶ λεόντων, καὶ ἐκ τῶν στομάτων αὐτῶν ἐκπορεύεται πῦρ καὶ καπνὸς καὶ θεῖον."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ἀπὸ τῶν τριῶν πληγῶν τούτων ἀπεκτάνθησαν τὸ τρίτον τῶν ἀνθρώπων, ⸀ἐκ",
          {
            "noteId": 170
          },
          "τοῦ πυρὸς καὶ τοῦ καπνοῦ καὶ τοῦ θείου τοῦ ἐκπορευομένου ἐκ τῶν στομάτων αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἡ γὰρ ἐξουσία τῶν ἵππων ἐν τῷ στόματι αὐτῶν ἐστιν καὶ ἐν ταῖς οὐραῖς αὐτῶν· αἱ γὰρ οὐραὶ αὐτῶν ὅμοιαι ⸀ὄφεσιν",
          {
            "noteId": 171
          },
          "ἔχουσαι κεφαλάς, καὶ ἐν αὐταῖς ἀδικοῦσιν."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Καὶ οἱ λοιποὶ τῶν ἀνθρώπων, οἳ οὐκ ἀπεκτάνθησαν ἐν ταῖς πληγαῖς ταύταις, ⸀οὐδὲ",
          {
            "noteId": 172
          },
          "μετενόησαν ἐκ τῶν ἔργων τῶν χειρῶν αὐτῶν, ἵνα μὴ ⸀προσκυνήσουσιν",
          {
            "noteId": 173
          },
          "τὰ δαιμόνια καὶ τὰ εἴδωλα τὰ χρυσᾶ καὶ τὰ ἀργυρᾶ καὶ τὰ χαλκᾶ καὶ τὰ λίθινα καὶ τὰ ξύλινα, ἃ οὔτε βλέπειν ⸀δύνανται",
          {
            "noteId": 174
          },
          "οὔτε ἀκούειν οὔτε περιπατεῖν,"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "καὶ οὐ μετενόησαν ἐκ τῶν φόνων αὐτῶν οὔτε ἐκ τῶν ⸀φαρμάκων",
          {
            "noteId": 175
          },
          "αὐτῶν οὔτε ἐκ τῆς πορνείας αὐτῶν οὔτε ἐκ τῶν κλεμμάτων αὐτῶν."
        ]
      }
    ],
