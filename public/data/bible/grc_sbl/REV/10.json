  "chapter": {
    "number": 10,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ εἶδον ⸀ἄλλον",
          {
            "noteId": 176
          },
          "ἄγγελον ἰσχυρὸν καταβαίνοντα ἐκ τοῦ οὐρανοῦ, περιβεβλημένον νεφέλην, καὶ ἡ ἶρις ἐπὶ ⸂τὴν κεφαλὴν",
          {
            "noteId": 177
          },
          "αὐτοῦ, καὶ τὸ πρόσωπον αὐτοῦ ὡς ὁ ἥλιος, καὶ οἱ πόδες αὐτοῦ ὡς στῦλοι πυρός,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ ἔχων ἐν τῇ χειρὶ αὐτοῦ ⸀βιβλαρίδιον",
          {
            "noteId": 178
          },
          "ἠνεῳγμένον. καὶ ἔθηκεν τὸν πόδα αὐτοῦ τὸν δεξιὸν ἐπὶ τῆς θαλάσσης, τὸν δὲ εὐώνυμον ἐπὶ τῆς γῆς,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ ἔκραξεν φωνῇ μεγάλῃ ὥσπερ λέων μυκᾶται. καὶ ὅτε ἔκραξεν, ἐλάλησαν αἱ ἑπτὰ βρονταὶ τὰς ἑαυτῶν φωνάς."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ ὅτε ἐλάλησαν αἱ ἑπτὰ βρονταί, ἤμελλον γράφειν· καὶ ἤκουσα φωνὴν ἐκ τοῦ οὐρανοῦ λέγουσαν· Σφράγισον ἃ ἐλάλησαν αἱ ἑπτὰ βρονταί, καὶ μὴ αὐτὰ γράψῃς."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ ὁ ἄγγελος, ὃν εἶδον ἑστῶτα ἐπὶ τῆς θαλάσσης καὶ ἐπὶ τῆς γῆς, ἦρεν τὴν χεῖρα αὐτοῦ τὴν δεξιὰν εἰς τὸν οὐρανόν,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ ⸀ὤμοσεν",
          {
            "noteId": 179
          },
          "τῷ ζῶντι εἰς τοὺς αἰῶνας τῶν αἰώνων, ὃς ἔκτισεν τὸν οὐρανὸν καὶ τὰ ἐν αὐτῷ καὶ τὴν γῆν καὶ τὰ ἐν αὐτῇ καὶ τὴν θάλασσαν καὶ τὰ ἐν αὐτῇ, ὅτι χρόνος οὐκέτι ἔσται·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἀλλʼ ἐν ταῖς ἡμέραις τῆς φωνῆς τοῦ ἑβδόμου ἀγγέλου, ὅταν μέλλῃ σαλπίζειν, καὶ ἐτελέσθη τὸ μυστήριον τοῦ θεοῦ, ὡς εὐηγγέλισεν τοὺς ⸂ἑαυτοῦ δούλους",
          {
            "noteId": 180
          },
          "τοὺς προφήτας."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Καὶ ἡ φωνὴ ἣν ἤκουσα ἐκ τοῦ οὐρανοῦ, πάλιν ⸀λαλοῦσαν",
          {
            "noteId": 181
          },
          "μετʼ ἐμοῦ καὶ ⸀λέγουσαν",
          {
            "noteId": 182
          },
          "Ὕπαγε λάβε τὸ ⸀βιβλίον",
          {
            "noteId": 183
          },
          "τὸ ἠνεῳγμένον ἐν τῇ χειρὶ τοῦ ἀγγέλου τοῦ ἑστῶτος ἐπὶ τῆς θαλάσσης καὶ ἐπὶ τῆς γῆς."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ ⸀ἀπῆλθα",
          {
            "noteId": 184
          },
          "πρὸς τὸν ἄγγελον λέγων αὐτῷ δοῦναί μοι τὸ ⸀βιβλαρίδιον",
          {
            "noteId": 185
          },
          "καὶ λέγει μοι· Λάβε καὶ κατάφαγε αὐτό, καὶ πικρανεῖ σου τὴν κοιλίαν, ἀλλʼ ἐν τῷ στόματί σου ἔσται γλυκὺ ὡς μέλι."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ ἔλαβον τὸ ⸀βιβλαρίδιον",
          {
            "noteId": 186
          },
          "ἐκ τῆς χειρὸς τοῦ ἀγγέλου καὶ κατέφαγον αὐτό, καὶ ἦν ἐν τῷ στόματί μου ὡς μέλι γλυκύ· καὶ ὅτε ἔφαγον αὐτό, ἐπικράνθη ἡ κοιλία μου."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Καὶ λέγουσίν μοι· Δεῖ σε πάλιν προφητεῦσαι ἐπὶ λαοῖς ⸀καὶ",
          {
            "noteId": 187
          },
          "ἔθνεσιν καὶ γλώσσαις καὶ βασιλεῦσιν πολλοῖς."
        ]
      }
    ],
