  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἀποκάλυψις Ἰησοῦ Χριστοῦ, ἣν ἔδωκεν αὐτῷ ὁ θεὸς δεῖξαι τοῖς δούλοις αὐτοῦ, ἃ δεῖ γενέσθαι ἐν τάχει, καὶ ἐσήμανεν ἀποστείλας διὰ τοῦ ἀγγέλου αὐτοῦ τῷ δούλῳ αὐτοῦ Ἰωάννῃ,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ὃς ἐμαρτύρησεν τὸν λόγον τοῦ θεοῦ καὶ τὴν μαρτυρίαν Ἰησοῦ Χριστοῦ, ὅσα εἶδεν."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "μακάριος ὁ ἀναγινώσκων καὶ οἱ ἀκούοντες τοὺς λόγους τῆς προφητείας καὶ τηροῦντες τὰ ἐν αὐτῇ γεγραμμένα, ὁ γὰρ καιρὸς ἐγγύς."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Ἰωάννης ταῖς ἑπτὰ ἐκκλησίαις ταῖς ἐν τῇ Ἀσίᾳ· χάρις ὑμῖν καὶ εἰρήνη ⸀ἀπὸ",
          {
            "noteId": 0
          },
          "ὁ ὢν καὶ ὁ ἦν καὶ ὁ ἐρχόμενος, καὶ ἀπὸ τῶν ἑπτὰ πνευμάτων ἃ ἐνώπιον τοῦ θρόνου αὐτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ ἀπὸ Ἰησοῦ Χριστοῦ, ὁ μάρτυς ὁ πιστός, ὁ πρωτότοκος τῶν νεκρῶν καὶ ὁ ἄρχων τῶν βασιλέων τῆς γῆς. Τῷ ἀγαπῶντι ἡμᾶς καὶ ⸀λύσαντι",
          {
            "noteId": 1
          },
          "ἡμᾶς ⸀ἐκ",
          {
            "noteId": 2
          },
          "τῶν ἁμαρτιῶν ἡμῶν ἐν τῷ αἵματι αὐτοῦ—"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ ἐποίησεν ἡμᾶς βασιλείαν, ἱερεῖς τῷ θεῷ καὶ πατρὶ αὐτοῦ— αὐτῷ ἡ δόξα καὶ τὸ κράτος εἰς τοὺς αἰῶνας ⸂τῶν αἰώνων",
          {
            "noteId": 3
          },
          "· ἀμήν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ἰδοὺ ἔρχεται μετὰ τῶν νεφελῶν, καὶ ὄψεται αὐτὸν πᾶς ὀφθαλμὸς καὶ οἵτινες αὐτὸν ἐξεκέντησαν, καὶ κόψονται ἐπʼ αὐτὸν πᾶσαι αἱ φυλαὶ τῆς γῆς. ναί, ἀμήν."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Ἐγώ εἰμι τὸ Ἄλφα καὶ τὸ Ὦ, λέγει κύριος, ὁ θεός, ὁ ὢν καὶ ὁ ἦν καὶ ὁ ἐρχόμενος, ὁ παντοκράτωρ."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Ἐγὼ Ἰωάννης, ὁ ἀδελφὸς ὑμῶν καὶ ⸀συγκοινωνὸς",
          {
            "noteId": 4
          },
          "ἐν",
          {
            "noteId": 5
          },
          "τῇ θλίψει καὶ",
          {
            "noteId": 6
          },
          "βασιλείᾳ καὶ ὑπομονῇ ⸀ἐν Ἰησοῦ",
          {
            "noteId": 7
          },
          "ἐγενόμην ἐν τῇ νήσῳ τῇ καλουμένῃ Πάτμῳ διὰ τὸν λόγον τοῦ θεοῦ ⸀καὶ τὴν μαρτυρίαν ⸀Ἰησοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἐγενόμην ἐν πνεύματι ἐν τῇ κυριακῇ ἡμέρᾳ, καὶ ἤκουσα ⸂ὀπίσω μου φωνὴν",
          {
            "noteId": 8
          },
          "μεγάλην ὡς σάλπιγγος"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "λεγούσης· Ὃ βλέπεις γράψον εἰς βιβλίον καὶ πέμψον ταῖς ἑπτὰ ἐκκλησίαις, εἰς Ἔφεσον καὶ εἰς Σμύρναν καὶ εἰς Πέργαμον καὶ εἰς Θυάτειρα καὶ εἰς Σάρδεις καὶ εἰς Φιλαδέλφειαν καὶ εἰς Λαοδίκειαν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "⸀Καὶ",
          {
            "noteId": 9
          },
          "ἐπέστρεψα βλέπειν τὴν φωνὴν ἥτις ἐλάλει μετʼ ἐμοῦ· καὶ ἐπιστρέψας εἶδον ἑπτὰ λυχνίας χρυσᾶς,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ ἐν μέσῳ ⸀τῶν",
          {
            "noteId": 10
          },
          "λυχνιῶν ὅμοιον ⸀υἱὸν",
          {
            "noteId": 11
          },
          "ἀνθρώπου, ἐνδεδυμένον ποδήρη καὶ περιεζωσμένον πρὸς τοῖς μαστοῖς ζώνην χρυσᾶν·"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἡ δὲ κεφαλὴ αὐτοῦ καὶ αἱ τρίχες λευκαὶ ὡς ἔριον λευκόν, ὡς χιών, καὶ οἱ ὀφθαλμοὶ αὐτοῦ ὡς φλὸξ πυρός,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ οἱ πόδες αὐτοῦ ὅμοιοι χαλκολιβάνῳ, ὡς ἐν καμίνῳ ⸀πεπυρωμένης",
          {
            "noteId": 12
          },
          "καὶ ἡ φωνὴ αὐτοῦ ὡς φωνὴ ὑδάτων πολλῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ ἔχων ἐν τῇ δεξιᾷ ⸂χειρὶ αὐτοῦ",
          {
            "noteId": 13
          },
          "ἀστέρας ἑπτά, καὶ ἐκ τοῦ στόματος αὐτοῦ ῥομφαία δίστομος ὀξεῖα ἐκπορευομένη, καὶ ἡ ὄψις αὐτοῦ ὡς ὁ ἥλιος φαίνει ἐν τῇ δυνάμει αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Καὶ ὅτε εἶδον αὐτόν, ἔπεσα πρὸς τοὺς πόδας αὐτοῦ ὡς νεκρός· καὶ ἔθηκεν τὴν δεξιὰν αὐτοῦ ἐπʼ ἐμὲ λέγων· Μὴ φοβοῦ· ἐγώ εἰμι ὁ πρῶτος καὶ ὁ ἔσχατος,"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ ὁ ζῶν— καὶ ἐγενόμην νεκρὸς καὶ ἰδοὺ ζῶν εἰμι εἰς τοὺς αἰῶνας τῶν ⸀αἰώνων",
          {
            "noteId": 14
          },
          "καὶ ἔχω τὰς κλεῖς τοῦ θανάτου καὶ τοῦ ᾅδου."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "γράψον οὖν ἃ εἶδες καὶ ἃ εἰσὶν καὶ ἃ μέλλει ⸀γίνεσθαι",
          {
            "noteId": 15
          },
          "μετὰ ταῦτα."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "τὸ μυστήριον τῶν ἑπτὰ ἀστέρων ⸀οὓς",
          {
            "noteId": 16
          },
          "εἶδες ἐπὶ τῆς δεξιᾶς μου, καὶ τὰς ἑπτὰ λυχνίας τὰς χρυσᾶς· οἱ ἑπτὰ ἀστέρες ἄγγελοι τῶν ἑπτὰ ἐκκλησιῶν εἰσίν, καὶ αἱ λυχνίαι αἱ ἑπτὰ ἑπτὰ ἐκκλησίαι εἰσίν."
        ]
      }
    ],
