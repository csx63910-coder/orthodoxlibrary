  "chapter": {
    "number": 6,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ εἶδον ⸀ὅτε",
          {
            "noteId": 105
          },
          "ἤνοιξεν τὸ ἀρνίον μίαν ἐκ τῶν ἑπτὰ σφραγίδων, καὶ ἤκουσα ἑνὸς ἐκ τῶν τεσσάρων ζῴων λέγοντος ὡς φωνῇ βροντῆς· ⸀Ἔρχου",
          {
            "noteId": 106
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ ⸂εἶδον, καὶ⸃ ἰδοὺ ἵππος λευκός, καὶ ὁ καθήμενος ἐπʼ αὐτὸν ἔχων τόξον, καὶ ἐδόθη αὐτῷ στέφανος, καὶ ἐξῆλθεν νικῶν καὶ ἵνα νικήσῃ.",
          {
            "noteId": 107
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Καὶ ὅτε ἤνοιξεν τὴν ⸂σφραγῖδα τὴν δευτέραν",
          {
            "noteId": 108
          },
          ", ἤκουσα τοῦ δευτέρου ζῴου λέγοντος· Ἔρχου."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ",
          {
            "noteId": 109
          },
          "ἐξῆλθεν ἄλλος ἵππος πυρρός, καὶ τῷ καθημένῳ ἐπʼ αὐτὸν ἐδόθη αὐτῷ λαβεῖν τὴν εἰρήνην ἐκ τῆς γῆς ⸀καὶ ἵνα ἀλλήλους ⸀σφάξουσιν",
          {
            "noteId": 110
          },
          "καὶ ἐδόθη αὐτῷ μάχαιρα μεγάλη."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Καὶ ὅτε ἤνοιξε τὴν σφραγῖδα τὴν τρίτην, ἤκουσα τοῦ τρίτου ζῴου λέγοντος· Ἔρχου. καὶ ⸀εἶδον",
          {
            "noteId": 111
          },
          "καὶ ἰδοὺ ἵππος μέλας, καὶ ὁ καθήμενος ἐπʼ αὐτὸν ἔχων ζυγὸν ἐν τῇ χειρὶ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ ἤκουσα ⸀ὡς",
          {
            "noteId": 112
          },
          "φωνὴν ἐν μέσῳ τῶν τεσσάρων ζῴων λέγουσαν· Χοῖνιξ σίτου δηναρίου, καὶ τρεῖς χοίνικες ⸀κριθῶν",
          {
            "noteId": 113
          },
          "δηναρίου· καὶ τὸ ἔλαιον καὶ τὸν οἶνον μὴ ἀδικήσῃς."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Καὶ ὅτε ἤνοιξεν τὴν σφραγῖδα τὴν τετάρτην, ἤκουσα ⸀φωνὴν",
          {
            "noteId": 114
          },
          "τοῦ τετάρτου ζῴου λέγοντος· ⸀Ἔρχου",
          {
            "noteId": 115
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ ⸂εἶδον, καὶ⸃ ἰδοὺ ἵππος χλωρός, καὶ ὁ καθήμενος ἐπάνω αὐτοῦ ὄνομα αὐτῷ ὁ Θάνατος, καὶ ὁ ᾅδης ἠκολούθει ⸂μετʼ αὐτοῦ⸃, καὶ ἐδόθη ⸀αὐτοῖς ἐξουσία ἐπὶ τὸ τέταρτον τῆς γῆς, ἀποκτεῖναι ἐν ῥομφαίᾳ καὶ ἐν λιμῷ καὶ ἐν θανάτῳ καὶ ὑπὸ τῶν θηρίων τῆς γῆς.",
          {
            "noteId": 116
          },
          {
            "noteId": 117
          },
          {
            "noteId": 118
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Καὶ ὅτε ἤνοιξεν τὴν πέμπτην σφραγῖδα, εἶδον ὑποκάτω τοῦ θυσιαστηρίου τὰς ψυχὰς τῶν ἐσφαγμένων διὰ τὸν λόγον τοῦ θεοῦ καὶ διὰ τὴν ⸀μαρτυρίαν",
          {
            "noteId": 119
          },
          "ἣν εἶχον."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ ἔκραξαν φωνῇ μεγάλῃ λέγοντες· Ἕως πότε, ὁ δεσπότης ὁ ἅγιος καὶ ἀληθινός, οὐ κρίνεις καὶ ἐκδικεῖς τὸ αἷμα ἡμῶν ἐκ τῶν κατοικούντων ἐπὶ τῆς γῆς;"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ ἐδόθη αὐτοῖς ἑκάστῳ στολὴ λευκή, καὶ ἐρρέθη αὐτοῖς ἵνα ⸀ἀναπαύσονται",
          {
            "noteId": 120
          },
          "ἔτι χρόνον ⸀μικρόν",
          {
            "noteId": 121
          },
          "ἕως ⸀πληρωθῶσιν",
          {
            "noteId": 122
          },
          "καὶ οἱ σύνδουλοι αὐτῶν",
          {
            "noteId": 123
          },
          "καὶ οἱ ἀδελφοὶ ⸀αὐτῶν οἱ μέλλοντες ⸀ἀποκτέννεσθαι",
          {
            "noteId": 124
          },
          "ὡς καὶ αὐτοί."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Καὶ εἶδον ὅτε ἤνοιξεν τὴν σφραγῖδα τὴν ἕκτην, καὶ σεισμὸς μέγας ἐγένετο, καὶ ὁ ἥλιος ⸂ἐγένετο μέλας",
          {
            "noteId": 125
          },
          "ὡς σάκκος τρίχινος, καὶ ἡ σελήνη ὅλη ἐγένετο ὡς αἷμα,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ οἱ ἀστέρες τοῦ οὐρανοῦ ἔπεσαν εἰς τὴν γῆν, ὡς συκῆ ⸀βάλλει",
          {
            "noteId": 126
          },
          "τοὺς ὀλύνθους αὐτῆς ὑπὸ ἀνέμου μεγάλου σειομένη,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καὶ ὁ οὐρανὸς ἀπεχωρίσθη ὡς βιβλίον ἑλισσόμενον, καὶ πᾶν ὄρος καὶ νῆσος ἐκ τῶν τόπων αὐτῶν ἐκινήθησαν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ οἱ βασιλεῖς τῆς γῆς καὶ οἱ μεγιστᾶνες καὶ οἱ χιλίαρχοι καὶ οἱ πλούσιοι καὶ οἱ ἰσχυροὶ καὶ πᾶς δοῦλος καὶ ἐλεύθερος ἔκρυψαν ἑαυτοὺς εἰς τὰ σπήλαια καὶ εἰς τὰς πέτρας τῶν ὀρέων·"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ λέγουσιν τοῖς ὄρεσιν καὶ ταῖς πέτραις· Πέσετε ἐφʼ ἡμᾶς καὶ κρύψατε ἡμᾶς ἀπὸ προσώπου τοῦ καθημένου ἐπὶ τοῦ θρόνου καὶ ἀπὸ τῆς ὀργῆς τοῦ ἀρνίου,"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ὅτι ἦλθεν ἡ ἡμέρα ἡ μεγάλη τῆς ὀργῆς ⸀αὐτῶν",
          {
            "noteId": 127
          },
          "καὶ τίς δύναται σταθῆναι;"
        ]
      }
    ],
