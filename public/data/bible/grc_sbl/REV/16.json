  "chapter": {
    "number": 16,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ ἤκουσα ⸂μεγάλης φωνῆς",
          {
            "noteId": 291
          },
          "ἐκ τοῦ ναοῦ λεγούσης τοῖς ἑπτὰ ἀγγέλοις· Ὑπάγετε καὶ ⸀ἐκχέετε",
          {
            "noteId": 292
          },
          "τὰς ἑπτὰ φιάλας τοῦ θυμοῦ τοῦ θεοῦ εἰς τὴν γῆν."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Καὶ ἀπῆλθεν ὁ πρῶτος καὶ ἐξέχεεν τὴν φιάλην αὐτοῦ εἰς τὴν γῆν· καὶ ἐγένετο ἕλκος κακὸν καὶ πονηρὸν ἐπὶ τοὺς ἀνθρώπους τοὺς ἔχοντας τὸ χάραγμα τοῦ θηρίου καὶ τοὺς προσκυνοῦντας τῇ εἰκόνι αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Καὶ ὁ ⸀δεύτερος",
          {
            "noteId": 293
          },
          "ἐξέχεεν τὴν φιάλην αὐτοῦ εἰς τὴν θάλασσαν· καὶ ἐγένετο αἷμα ὡς νεκροῦ, καὶ πᾶσα ψυχὴ ⸀ζωῆς",
          {
            "noteId": 294
          },
          "ἀπέθανεν ⸀τὰ",
          {
            "noteId": 295
          },
          "ἐν τῇ θαλάσσῃ."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Καὶ ὁ τρίτος ἐξέχεεν τὴν φιάλην αὐτοῦ εἰς τοὺς ποταμοὺς ⸀καὶ",
          {
            "noteId": 296
          },
          "τὰς πηγὰς τῶν ὑδάτων· καὶ ἐγένετο αἷμα."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ ἤκουσα τοῦ ἀγγέλου τῶν ὑδάτων λέγοντος· Δίκαιος εἶ, ὁ",
          {
            "noteId": 297
          },
          "ὢν καὶ ὁ ἦν, ⸀ὁ ὅσιος, ὅτι ταῦτα ἔκρινας,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ὅτι αἷμα ἁγίων καὶ προφητῶν ἐξέχεαν, καὶ αἷμα αὐτοῖς ⸀δέδωκας",
          {
            "noteId": 298
          },
          "πιεῖν· ἄξιοί εἰσιν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "καὶ ἤκουσα τοῦ θυσιαστηρίου λέγοντος· Ναί, κύριε, ὁ θεός, ὁ παντοκράτωρ, ἀληθιναὶ καὶ δίκαιαι αἱ κρίσεις σου."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Καὶ ὁ ⸀τέταρτος",
          {
            "noteId": 299
          },
          "ἐξέχεεν τὴν φιάλην αὐτοῦ ἐπὶ τὸν ἥλιον· καὶ ἐδόθη αὐτῷ καυματίσαι ⸂τοὺς ἀνθρώπους ἐν πυρί",
          {
            "noteId": 300
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ ἐκαυματίσθησαν οἱ ἄνθρωποι καῦμα μέγα· καὶ ⸀ἐβλασφήμησαν",
          {
            "noteId": 301
          },
          "τὸ ὄνομα τοῦ θεοῦ τοῦ ἔχοντος ⸀τὴν",
          {
            "noteId": 302
          },
          "ἐξουσίαν ἐπὶ τὰς πληγὰς ταύτας, καὶ οὐ μετενόησαν δοῦναι αὐτῷ δόξαν."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Καὶ ὁ πέμπτος ἐξέχεεν τὴν φιάλην αὐτοῦ ἐπὶ τὸν θρόνον τοῦ θηρίου· καὶ ἐγένετο ἡ βασιλεία αὐτοῦ ἐσκοτωμένη, καὶ ἐμασῶντο τὰς γλώσσας αὐτῶν ἐκ τοῦ πόνου,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ ἐβλασφήμησαν τὸν θεὸν τοῦ οὐρανοῦ ἐκ τῶν πόνων αὐτῶν καὶ ἐκ τῶν ἑλκῶν αὐτῶν, καὶ οὐ μετενόησαν ἐκ τῶν ἔργων αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Καὶ ὁ ἕκτος ἐξέχεεν τὴν φιάλην αὐτοῦ ἐπὶ τὸν",
          {
            "noteId": 303
          },
          "ποταμὸν τὸν μέγαν ⸀τὸν Εὐφράτην· καὶ ἐξηράνθη τὸ ὕδωρ αὐτοῦ, ἵνα ἑτοιμασθῇ ἡ ὁδὸς τῶν βασιλέων τῶν ἀπὸ ἀνατολῆς ἡλίου."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ εἶδον ἐκ τοῦ στόματος τοῦ δράκοντος καὶ ἐκ τοῦ στόματος τοῦ θηρίου καὶ ἐκ τοῦ στόματος τοῦ ψευδοπροφήτου πνεύματα ⸂τρία ἀκάθαρτα",
          {
            "noteId": 304
          },
          "ὡς βάτραχοι·"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "εἰσὶν γὰρ πνεύματα δαιμονίων ποιοῦντα σημεῖα, ἃ ἐκπορεύεται ἐπὶ τοὺς βασιλεῖς τῆς οἰκουμένης ὅλης, συναγαγεῖν αὐτοὺς εἰς τὸν πόλεμον τῆς ⸀ἡμέρας",
          {
            "noteId": 305
          },
          "τῆς μεγάλης τοῦ θεοῦ τοῦ παντοκράτορος—"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Ἰδοὺ ἔρχομαι ὡς κλέπτης. μακάριος ὁ γρηγορῶν καὶ τηρῶν τὰ ἱμάτια αὐτοῦ, ἵνα μὴ γυμνὸς περιπατῇ καὶ βλέπωσιν τὴν ἀσχημοσύνην αὐτοῦ—"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ συνήγαγεν αὐτοὺς εἰς τὸν τόπον τὸν καλούμενον Ἑβραϊστὶ Ἁρμαγεδών."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Καὶ ὁ ἕβδομος ἐξέχεεν τὴν φιάλην αὐτοῦ ἐπὶ τὸν ἀέρα— καὶ ἐξῆλθεν φωνὴ μεγάλη ⸀ἐκ",
          {
            "noteId": 306
          },
          "τοῦ ⸀ναοῦ",
          {
            "noteId": 307
          },
          "ἀπὸ τοῦ θρόνου λέγουσα· Γέγονεν—"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ ἐγένοντο ἀστραπαὶ καὶ ⸂φωναὶ καὶ βρονταί",
          {
            "noteId": 308
          },
          ", καὶ σεισμὸς ⸀ἐγένετο",
          {
            "noteId": 309
          },
          "μέγας, οἷος οὐκ ἐγένετο ἀφʼ οὗ ⸂ἄνθρωποι ἐγένοντο",
          {
            "noteId": 310
          },
          "ἐπὶ τῆς γῆς τηλικοῦτος σεισμὸς οὕτω μέγας,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "καὶ ἐγένετο ἡ πόλις ἡ μεγάλη εἰς τρία μέρη, καὶ αἱ πόλεις τῶν ἐθνῶν ἔπεσαν· καὶ Βαβυλὼν ἡ μεγάλη ἐμνήσθη ἐνώπιον τοῦ θεοῦ δοῦναι αὐτῇ τὸ ποτήριον τοῦ οἴνου τοῦ θυμοῦ τῆς ὀργῆς αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "καὶ πᾶσα νῆσος ἔφυγεν, καὶ ὄρη οὐχ εὑρέθησαν."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "καὶ χάλαζα μεγάλη ὡς ταλαντιαία καταβαίνει ἐκ τοῦ οὐρανοῦ ἐπὶ τοὺς ἀνθρώπους· καὶ ἐβλασφήμησαν οἱ ἄνθρωποι τὸν θεὸν ἐκ τῆς πληγῆς τῆς χαλάζης, ὅτι μεγάλη ἐστὶν ἡ πληγὴ αὐτῆς σφόδρα."
        ]
      }
    ],
