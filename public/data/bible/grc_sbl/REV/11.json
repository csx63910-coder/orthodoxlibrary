  "chapter": {
    "number": 11,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ ἐδόθη μοι κάλαμος ὅμοιος ῥάβδῳ, λέγων· ⸀Ἔγειρε",
          {
            "noteId": 188
          },
          "καὶ μέτρησον τὸν ναὸν τοῦ θεοῦ καὶ τὸ θυσιαστήριον καὶ τοὺς προσκυνοῦντας ἐν αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ τὴν αὐλὴν τὴν ἔξωθεν",
          {
            "noteId": 189
          },
          "τοῦ ναοῦ ἔκβαλε ⸀ἔξωθεν, καὶ μὴ αὐτὴν μετρήσῃς, ὅτι ἐδόθη τοῖς ἔθνεσιν, καὶ τὴν πόλιν τὴν ἁγίαν πατήσουσιν μῆνας ⸀τεσσεράκοντα",
          {
            "noteId": 190
          },
          "δύο."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ δώσω τοῖς δυσὶν μάρτυσίν μου, καὶ προφητεύσουσιν ἡμέρας χιλίας διακοσίας ἑξήκοντα, ⸀περιβεβλημένοι",
          {
            "noteId": 191
          },
          "σάκκους."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Οὗτοί εἰσιν αἱ δύο ἐλαῖαι καὶ αἱ δύο λυχνίαι αἱ ἐνώπιον τοῦ κυρίου τῆς γῆς ⸀ἑστῶτες",
          {
            "noteId": 192
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ εἴ τις αὐτοὺς θέλει ἀδικῆσαι, πῦρ ἐκπορεύεται ἐκ τοῦ στόματος αὐτῶν καὶ κατεσθίει τοὺς ἐχθροὺς αὐτῶν· καὶ εἴ τις ⸂θελήσῃ αὐτοὺς",
          {
            "noteId": 193
          },
          "ἀδικῆσαι, οὕτως δεῖ αὐτὸν ἀποκτανθῆναι."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "οὗτοι ἔχουσιν ⸂τὴν ἐξουσίαν κλεῖσαι τὸν οὐρανόν",
          {
            "noteId": 194
          },
          ", ἵνα μὴ ὑετὸς βρέχῃ τὰς ἡμέρας τῆς προφητείας αὐτῶν, καὶ ἐξουσίαν ἔχουσιν ἐπὶ τῶν ὑδάτων στρέφειν αὐτὰ εἰς αἷμα καὶ πατάξαι τὴν γῆν ⸂ἐν πάσῃ πληγῇ ὁσάκις ἐὰν θελήσωσιν",
          {
            "noteId": 195
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Καὶ ὅταν τελέσωσιν τὴν μαρτυρίαν αὐτῶν, τὸ θηρίον τὸ ἀναβαῖνον ἐκ τῆς ἀβύσσου ποιήσει μετʼ αὐτῶν πόλεμον καὶ νικήσει αὐτοὺς καὶ ἀποκτενεῖ αὐτούς."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ τὸ πτῶμα αὐτῶν ἐπὶ τῆς πλατείας τῆς πόλεως τῆς μεγάλης, ἥτις καλεῖται πνευματικῶς Σόδομα καὶ Αἴγυπτος, ὅπου καὶ ὁ κύριος αὐτῶν ἐσταυρώθη."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ",
          {
            "noteId": 196
          },
          "βλέπουσιν ἐκ τῶν λαῶν καὶ φυλῶν καὶ γλωσσῶν καὶ ἐθνῶν τὸ πτῶμα αὐτῶν ἡμέρας τρεῖς ⸀καὶ ἥμισυ, καὶ τὰ πτώματα αὐτῶν οὐκ ⸀ἀφίουσιν",
          {
            "noteId": 197
          },
          "τεθῆναι εἰς μνῆμα."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ οἱ κατοικοῦντες ἐπὶ τῆς γῆς χαίρουσιν ἐπʼ αὐτοῖς καὶ ⸀εὐφραίνονται",
          {
            "noteId": 198
          },
          "καὶ δῶρα ⸀πέμψουσιν",
          {
            "noteId": 199
          },
          "ἀλλήλοις, ὅτι οὗτοι οἱ δύο προφῆται ἐβασάνισαν τοὺς κατοικοῦντας ἐπὶ τῆς γῆς."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Καὶ μετὰ τὰς τρεῖς ἡμέρας καὶ ἥμισυ πνεῦμα ζωῆς ἐκ τοῦ θεοῦ εἰσῆλθεν ⸂ἐν αὐτοῖς",
          {
            "noteId": 200
          },
          ", καὶ ἔστησαν ἐπὶ τοὺς πόδας αὐτῶν, καὶ φόβος μέγας ⸀ἐπέπεσεν",
          {
            "noteId": 201
          },
          "ἐπὶ τοὺς θεωροῦντας αὐτούς·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "καὶ ⸀ἤκουσαν",
          {
            "noteId": 202
          },
          "⸂φωνῆς μεγάλης",
          {
            "noteId": 203
          },
          "ἐκ τοῦ οὐρανοῦ ⸀λεγούσης",
          {
            "noteId": 204
          },
          "αὐτοῖς· ⸀Ἀνάβατε",
          {
            "noteId": 205
          },
          "ὧδε, καὶ ἀνέβησαν εἰς τὸν οὐρανὸν ἐν τῇ νεφέλῃ, καὶ ἐθεώρησαν αὐτοὺς οἱ ἐχθροὶ αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ ἐν ἐκείνῃ τῇ ⸀ὥρᾳ",
          {
            "noteId": 206
          },
          "ἐγένετο σεισμὸς μέγας, καὶ τὸ δέκατον τῆς πόλεως ἔπεσεν, καὶ ἀπεκτάνθησαν ἐν τῷ σεισμῷ ὀνόματα ἀνθρώπων χιλιάδες ἑπτά, καὶ οἱ λοιποὶ ἔμφοβοι ἐγένοντο καὶ ἔδωκαν δόξαν τῷ θεῷ τοῦ οὐρανοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Ἡ οὐαὶ ἡ δευτέρα ἀπῆλθεν· ⸂ἰδοὺ ἡ οὐαὶ ἡ τρίτη",
          {
            "noteId": 207
          },
          "ἔρχεται ταχύ."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Καὶ ὁ ἕβδομος ἄγγελος ἐσάλπισεν· καὶ ἐγένοντο φωναὶ μεγάλαι ἐν τῷ οὐρανῷ ⸀λέγοντες",
          {
            "noteId": 208
          },
          "Ἐγένετο ἡ βασιλεία τοῦ κόσμου τοῦ κυρίου ἡμῶν καὶ τοῦ χριστοῦ αὐτοῦ, καὶ βασιλεύσει εἰς τοὺς αἰῶνας τῶν αἰώνων."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Καὶ οἱ εἴκοσι τέσσαρες πρεσβύτεροι οἱ ἐνώπιον τοῦ ⸂θεοῦ καθήμενοι",
          {
            "noteId": 209
          },
          "ἐπὶ τοὺς θρόνους αὐτῶν ἔπεσαν ἐπὶ τὰ πρόσωπα αὐτῶν καὶ προσεκύνησαν τῷ θεῷ,"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "λέγοντες· Εὐχαριστοῦμέν σοι, κύριε, ὁ θεός, ὁ παντοκράτωρ, ὁ ὢν καὶ ὁ ἦν, ὅτι εἴληφας τὴν δύναμίν σου τὴν μεγάλην καὶ ἐβασίλευσας."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ τὰ ἔθνη ὠργίσθησαν, καὶ ἦλθεν ἡ ὀργή σου καὶ ὁ καιρὸς τῶν νεκρῶν κριθῆναι καὶ δοῦναι τὸν μισθὸν τοῖς δούλοις σου τοῖς προφήταις καὶ τοῖς ἁγίοις καὶ τοῖς φοβουμένοις τὸ ὄνομά σου, ⸂τοὺς μικροὺς καὶ τοὺς μεγάλους",
          {
            "noteId": 210
          },
          ", καὶ διαφθεῖραι τοὺς διαφθείροντας τὴν γῆν."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Καὶ ἠνοίγη ὁ",
          {
            "noteId": 211
          },
          "ναὸς τοῦ θεοῦ ⸀ὁ ἐν τῷ οὐρανῷ, καὶ ὤφθη ἡ κιβωτὸς τῆς διαθήκης ⸀αὐτοῦ",
          {
            "noteId": 212
          },
          "ἐν τῷ ναῷ αὐτοῦ· καὶ ἐγένοντο ἀστραπαὶ καὶ φωναὶ καὶ βρονταὶ ⸂καὶ σεισμὸς",
          {
            "noteId": 213
          },
          "καὶ χάλαζα μεγάλη."
        ]
      }
    ],
