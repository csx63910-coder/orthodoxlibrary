  "chapter": {
    "number": 22,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ ἔδειξέν μοι ⸀ποταμὸν",
          {
            "noteId": 422
          },
          "ὕδατος ζωῆς λαμπρὸν ὡς κρύσταλλον, ἐκπορευόμενον ἐκ τοῦ θρόνου τοῦ θεοῦ καὶ τοῦ ἀρνίου"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἐν μέσῳ τῆς πλατείας αὐτῆς· καὶ τοῦ ποταμοῦ ἐντεῦθεν καὶ ἐκεῖθεν ξύλον ζωῆς ποιοῦν καρποὺς δώδεκα, κατὰ μῆνα ἕκαστον ⸀ἀποδιδοῦν",
          {
            "noteId": 423
          },
          "τὸν καρπὸν αὐτοῦ, καὶ τὰ φύλλα τοῦ ξύλου εἰς θεραπείαν τῶν ἐθνῶν."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ πᾶν κατάθεμα οὐκ ἔσται ἔτι. καὶ ὁ θρόνος τοῦ θεοῦ καὶ τοῦ ἀρνίου ἐν αὐτῇ ἔσται, καὶ οἱ δοῦλοι αὐτοῦ λατρεύσουσιν αὐτῷ,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ ὄψονται τὸ πρόσωπον αὐτοῦ, καὶ τὸ ὄνομα αὐτοῦ ἐπὶ τῶν μετώπων αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ νὺξ οὐκ ἔσται ⸀ἔτι",
          {
            "noteId": 424
          },
          "καὶ ⸂οὐκ ἔχουσιν χρείαν",
          {
            "noteId": 425
          },
          "⸀φωτὸς",
          {
            "noteId": 426
          },
          "λύχνου καὶ ⸀φῶς",
          {
            "noteId": 427
          },
          "ἡλίου, ὅτι κύριος ὁ θεὸς φωτίσει ⸀ἐπʼ",
          {
            "noteId": 428
          },
          "αὐτούς, καὶ βασιλεύσουσιν εἰς τοὺς αἰῶνας τῶν αἰώνων."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Καὶ ⸀εἶπέν",
          {
            "noteId": 429
          },
          "μοι· Οὗτοι οἱ λόγοι πιστοὶ καὶ ἀληθινοί, καὶ ⸀ὁ",
          {
            "noteId": 430
          },
          "κύριος, ὁ θεὸς τῶν πνευμάτων τῶν προφητῶν, ἀπέστειλεν τὸν ἄγγελον αὐτοῦ δεῖξαι τοῖς δούλοις αὐτοῦ ἃ δεῖ γενέσθαι ἐν τάχει·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "καὶ ἰδοὺ ἔρχομαι ταχύ· μακάριος ὁ τηρῶν τοὺς λόγους τῆς προφητείας τοῦ βιβλίου τούτου."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Κἀγὼ Ἰωάννης ὁ ἀκούων καὶ βλέπων ταῦτα. καὶ ὅτε ἤκουσα καὶ ἔβλεψα, ἔπεσα προσκυνῆσαι ἔμπροσθεν τῶν ποδῶν τοῦ ἀγγέλου τοῦ δεικνύοντός μοι ταῦτα."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ λέγει μοι· Ὅρα μή· σύνδουλός σού εἰμι καὶ τῶν ἀδελφῶν σου τῶν προφητῶν καὶ τῶν τηρούντων τοὺς λόγους τοῦ βιβλίου τούτου· τῷ θεῷ προσκύνησον."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Καὶ λέγει μοι· Μὴ σφραγίσῃς τοὺς λόγους τῆς προφητείας τοῦ βιβλίου τούτου, ὁ καιρὸς γὰρ ἐγγύς ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ὁ ἀδικῶν ἀδικησάτω ἔτι, καὶ ὁ ῥυπαρὸς ⸀ῥυπαρευθήτω",
          {
            "noteId": 431
          },
          "ἔτι, καὶ ὁ δίκαιος δικαιοσύνην ποιησάτω ἔτι, καὶ ὁ ἅγιος ἁγιασθήτω ἔτι."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ἰδοὺ ἔρχομαι ταχύ, καὶ ὁ μισθός μου μετʼ ἐμοῦ, ἀποδοῦναι ἑκάστῳ ὡς τὸ ἔργον ⸀ἐστὶν",
          {
            "noteId": 432
          },
          "αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ἐγὼ τὸ Ἄλφα καὶ τὸ Ὦ, ὁ πρῶτος καὶ ὁ ἔσχατος, ⸀ἡ",
          {
            "noteId": 433
          },
          "ἀρχὴ καὶ ⸀τὸ",
          {
            "noteId": 434
          },
          "τέλος."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Μακάριοι οἱ ⸂πλύνοντες τὰς στολὰς αὐτῶν",
          {
            "noteId": 435
          },
          ", ἵνα ἔσται ἡ ἐξουσία αὐτῶν ἐπὶ τὸ ξύλον τῆς ζωῆς καὶ τοῖς πυλῶσιν εἰσέλθωσιν εἰς τὴν πόλιν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ἔξω οἱ κύνες καὶ οἱ φάρμακοι καὶ οἱ πόρνοι καὶ οἱ φονεῖς καὶ οἱ εἰδωλολάτραι καὶ πᾶς φιλῶν καὶ ποιῶν ψεῦδος."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Ἐγὼ Ἰησοῦς ἔπεμψα τὸν ἄγγελόν μου μαρτυρῆσαι ὑμῖν ταῦτα ἐπὶ ταῖς ἐκκλησίαις. ἐγώ εἰμι ἡ ῥίζα καὶ τὸ γένος Δαυίδ, ὁ ἀστὴρ ὁ λαμπρός, ὁ πρωϊνός."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καὶ τὸ πνεῦμα καὶ ἡ νύμφη λέγουσιν· Ἔρχου· καὶ ὁ ἀκούων εἰπάτω· Ἔρχου· καὶ ὁ διψῶν ἐρχέσθω, ὁ θέλων λαβέτω ὕδωρ ζωῆς δωρεάν."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Μαρτυρῶ ἐγὼ παντὶ τῷ ἀκούοντι τοὺς λόγους τῆς προφητείας τοῦ βιβλίου τούτου· ἐάν τις ἐπιθῇ ἐπʼ αὐτά, ⸀ἐπιθήσει",
          {
            "noteId": 436
          },
          "ὁ θεὸς ἐπʼ αὐτὸν τὰς πληγὰς τὰς γεγραμμένας ἐν τῷ βιβλίῳ τούτῳ·"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "καὶ ἐάν τις ἀφέλῃ ἀπὸ τῶν λόγων τοῦ βιβλίου τῆς προφητείας ταύτης, ⸀ἀφελεῖ",
          {
            "noteId": 437
          },
          "ὁ θεὸς τὸ μέρος αὐτοῦ ἀπὸ τοῦ ξύλου τῆς ζωῆς καὶ ἐκ τῆς πόλεως τῆς ἁγίας, τῶν γεγραμμένων ἐν τῷ βιβλίῳ τούτῳ."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Λέγει ὁ μαρτυρῶν ταῦτα· Ναί· ἔρχομαι ταχύ. Ἀμήν· ⸀ἔρχου",
          {
            "noteId": 438
          },
          "κύριε Ἰησοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Ἡ χάρις τοῦ κυρίου ⸀Ἰησοῦ",
          {
            "noteId": 439
          },
          "μετὰ ⸀πάντων",
          {
            "noteId": 440
          }
        ]
      }
    ],
