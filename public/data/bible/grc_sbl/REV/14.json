  "chapter": {
    "number": 14,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ εἶδον, καὶ ἰδοὺ τὸ ἀρνίον ⸀ἑστὸς",
          {
            "noteId": 260
          },
          "ἐπὶ τὸ ὄρος Σιών, καὶ μετʼ ⸀αὐτοῦ",
          {
            "noteId": 261
          },
          "ἑκατὸν τεσσεράκοντα τέσσαρες χιλιάδες ἔχουσαι τὸ ὄνομα αὐτοῦ καὶ τὸ ὄνομα τοῦ πατρὸς αὐτοῦ γεγραμμένον ἐπὶ τῶν μετώπων αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ ἤκουσα φωνὴν ἐκ τοῦ οὐρανοῦ ὡς φωνὴν ὑδάτων πολλῶν καὶ ὡς φωνὴν βροντῆς μεγάλης, καὶ ἡ φωνὴ ἣν ἤκουσα ὡς κιθαρῳδῶν κιθαριζόντων ἐν ταῖς κιθάραις αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ ᾄδουσιν ⸀ὡς",
          {
            "noteId": 262
          },
          "ᾠδὴν καινὴν ἐνώπιον τοῦ θρόνου καὶ ἐνώπιον τῶν τεσσάρων ζῴων καὶ τῶν πρεσβυτέρων· καὶ οὐδεὶς ἐδύνατο μαθεῖν τὴν ᾠδὴν εἰ μὴ αἱ ἑκατὸν τεσσεράκοντα τέσσαρες χιλιάδες, οἱ ἠγορασμένοι ἀπὸ τῆς γῆς."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "οὗτοί εἰσιν οἳ μετὰ γυναικῶν οὐκ ἐμολύνθησαν, παρθένοι γάρ εἰσιν· ⸀οὗτοι",
          {
            "noteId": 263
          },
          "οἱ ἀκολουθοῦντες τῷ ἀρνίῳ ὅπου ἂν ⸀ὑπάγῃ",
          {
            "noteId": 264
          },
          "⸁οὗτοι",
          {
            "noteId": 265
          },
          "ἠγοράσθησαν ἀπὸ τῶν ἀνθρώπων ἀπαρχὴ τῷ θεῷ καὶ τῷ ἀρνίῳ,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ ⸂ἐν τῷ στόματι αὐτῶν οὐχ εὑρέθη",
          {
            "noteId": 266
          },
          "ψεῦδος· ⸀ἄμωμοί",
          {
            "noteId": 267
          },
          "εἰσιν."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Καὶ εἶδον ⸀ἄλλον",
          {
            "noteId": 268
          },
          "ἄγγελον πετόμενον ἐν μεσουρανήματι, ἔχοντα εὐαγγέλιον αἰώνιον εὐαγγελίσαι ⸀ἐπὶ",
          {
            "noteId": 269
          },
          "τοὺς καθημένους ἐπὶ τῆς γῆς καὶ ἐπὶ πᾶν ἔθνος καὶ φυλὴν καὶ γλῶσσαν καὶ λαόν,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "λέγων ἐν φωνῇ μεγάλῃ· Φοβήθητε τὸν ⸀θεὸν",
          {
            "noteId": 270
          },
          "καὶ δότε αὐτῷ δόξαν, ὅτι ἦλθεν ἡ ὥρα τῆς κρίσεως αὐτοῦ, καὶ προσκυνήσατε ⸂τῷ ποιήσαντι",
          {
            "noteId": 271
          },
          "τὸν οὐρανὸν καὶ",
          {
            "noteId": 272
          },
          "τὴν γῆν ⸀καὶ θάλασσαν καὶ πηγὰς ὑδάτων."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Καὶ ἄλλος ⸂δεύτερος ἄγγελος",
          {
            "noteId": 273
          },
          "ἠκολούθησεν λέγων· Ἔπεσεν, ⸀ἔπεσεν",
          {
            "noteId": 274
          },
          "Βαβυλὼν ἡ μεγάλη, ⸀ἣ",
          {
            "noteId": 275
          },
          "ἐκ τοῦ οἴνου τοῦ θυμοῦ τῆς πορνείας αὐτῆς πεπότικεν πάντα τὰ ἔθνη."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Καὶ ἄλλος ἄγγελος τρίτος ἠκολούθησεν αὐτοῖς λέγων ἐν φωνῇ μεγάλῃ· Εἴ τις προσκυνεῖ τὸ θηρίον καὶ τὴν εἰκόνα αὐτοῦ, καὶ λαμβάνει χάραγμα ἐπὶ τοῦ μετώπου αὐτοῦ ἢ ἐπὶ τὴν χεῖρα αὐτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ αὐτὸς πίεται ἐκ τοῦ οἴνου τοῦ θυμοῦ τοῦ θεοῦ τοῦ κεκερασμένου ἀκράτου ἐν τῷ ποτηρίῳ τῆς ὀργῆς αὐτοῦ, καὶ βασανισθήσεται ἐν πυρὶ καὶ θείῳ ἐνώπιον ⸂ἀγγέλων ἁγίων",
          {
            "noteId": 276
          },
          "καὶ ἐνώπιον τοῦ ἀρνίου."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ ὁ καπνὸς τοῦ βασανισμοῦ αὐτῶν εἰς αἰῶνας αἰώνων ἀναβαίνει, καὶ οὐκ ἔχουσιν ἀνάπαυσιν ἡμέρας καὶ νυκτός, οἱ προσκυνοῦντες τὸ θηρίον καὶ τὴν εἰκόνα αὐτοῦ, καὶ εἴ τις λαμβάνει τὸ χάραγμα τοῦ ὀνόματος αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ὧδε ἡ ὑπομονὴ τῶν ἁγίων ἐστίν, οἱ τηροῦντες τὰς ἐντολὰς τοῦ θεοῦ καὶ τὴν πίστιν Ἰησοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Καὶ ἤκουσα φωνῆς ἐκ τοῦ οὐρανοῦ λεγούσης· Γράψον· Μακάριοι οἱ νεκροὶ οἱ ἐν κυρίῳ ἀποθνῄσκοντες ἀπʼ ἄρτι. ⸂ναί, λέγει",
          {
            "noteId": 277
          },
          "τὸ πνεῦμα, ἵνα ⸀ἀναπαήσονται",
          {
            "noteId": 278
          },
          "ἐκ τῶν κόπων αὐτῶν, τὰ ⸀γὰρ",
          {
            "noteId": 279
          },
          "ἔργα αὐτῶν ἀκολουθεῖ μετʼ αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Καὶ εἶδον, καὶ ἰδοὺ νεφέλη λευκή, καὶ ἐπὶ τὴν νεφέλην καθήμενον ὅμοιον ⸀υἱὸν",
          {
            "noteId": 280
          },
          "ἀνθρώπου, ἔχων ἐπὶ τῆς κεφαλῆς αὐτοῦ στέφανον χρυσοῦν καὶ ἐν τῇ χειρὶ αὐτοῦ δρέπανον ὀξύ."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ ἄλλος ἄγγελος ἐξῆλθεν ἐκ τοῦ ναοῦ κράζων ἐν φωνῇ μεγάλῃ τῷ καθημένῳ ἐπὶ τῆς νεφέλης· Πέμψον τὸ δρέπανόν σου καὶ θέρισον, ὅτι ἦλθεν ἡ ὥρα θερίσαι, ὅτι ἐξηράνθη ὁ θερισμὸς τῆς γῆς."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ ἔβαλεν ὁ καθήμενος ἐπὶ ⸂τῆς νεφέλης",
          {
            "noteId": 281
          },
          "τὸ δρέπανον αὐτοῦ ἐπὶ τὴν γῆν, καὶ ἐθερίσθη ἡ γῆ."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Καὶ ἄλλος ἄγγελος ἐξῆλθεν ἐκ τοῦ ναοῦ τοῦ ἐν τῷ οὐρανῷ, ἔχων καὶ αὐτὸς δρέπανον ὀξύ."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ ἄλλος ⸀ἄγγελος",
          {
            "noteId": 282
          },
          "ἐκ τοῦ θυσιαστηρίου, ⸀ὁ",
          {
            "noteId": 283
          },
          "ἔχων ἐξουσίαν ἐπὶ τοῦ πυρός, καὶ ἐφώνησεν ⸀φωνῇ",
          {
            "noteId": 284
          },
          "μεγάλῃ τῷ ἔχοντι τὸ δρέπανον τὸ ὀξὺ λέγων· Πέμψον σου τὸ δρέπανον τὸ ὀξὺ καὶ τρύγησον τοὺς βότρυας τῆς ἀμπέλου τῆς γῆς, ὅτι ἤκμασαν αἱ σταφυλαὶ αὐτῆς."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "καὶ ἔβαλεν ὁ ἄγγελος τὸ δρέπανον αὐτοῦ εἰς τὴν γῆν, καὶ ἐτρύγησεν τὴν ἄμπελον τῆς γῆς, καὶ ἔβαλεν εἰς τὴν ληνὸν τοῦ θυμοῦ τοῦ θεοῦ τὸν μέγαν."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "καὶ ἐπατήθη ἡ ληνὸς ἔξωθεν τῆς πόλεως, καὶ ἐξῆλθεν αἷμα ἐκ τῆς ληνοῦ ἄχρι τῶν χαλινῶν τῶν ἵππων ἀπὸ σταδίων χιλίων ἑξακοσίων."
        ]
      }
    ],
