  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ὅθεν, ἀδελφοὶ ἅγιοι, κλήσεως ἐπουρανίου μέτοχοι, κατανοήσατε τὸν ἀπόστολον καὶ ἀρχιερέα τῆς ὁμολογίας ἡμῶν ⸀Ἰησοῦν",
          {
            "noteId": 12
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "πιστὸν ὄντα τῷ ποιήσαντι αὐτὸν ὡς καὶ Μωϋσῆς ⸀ἐν",
          {
            "noteId": 13
          },
          "τῷ οἴκῳ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "πλείονος γὰρ ⸂οὗτος δόξης",
          {
            "noteId": 14
          },
          "παρὰ Μωϋσῆν ἠξίωται καθʼ ὅσον πλείονα τιμὴν ἔχει τοῦ οἴκου ὁ κατασκευάσας αὐτόν·"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "πᾶς γὰρ οἶκος κατασκευάζεται ὑπό τινος, ὁ ⸀δὲ",
          {
            "noteId": 15
          },
          "πάντα κατασκευάσας θεός."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ Μωϋσῆς μὲν πιστὸς ἐν ὅλῳ τῷ οἴκῳ αὐτοῦ ὡς θεράπων εἰς μαρτύριον τῶν λαληθησομένων,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Χριστὸς δὲ ὡς υἱὸς ἐπὶ τὸν οἶκον αὐτοῦ· ⸀ὃς",
          {
            "noteId": 16
          },
          "οἶκός ἐσμεν ἡμεῖς, ⸀ἐὰν",
          {
            "noteId": 17
          },
          "τὴν παρρησίαν καὶ τὸ καύχημα τῆς ⸀ἐλπίδος",
          {
            "noteId": 18
          },
          "κατάσχωμεν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Διό, καθὼς λέγει τὸ πνεῦμα τὸ ἅγιον· Σήμερον ἐὰν τῆς φωνῆς αὐτοῦ ἀκούσητε,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "μὴ σκληρύνητε τὰς καρδίας ὑμῶν ὡς ἐν τῷ παραπικρασμῷ, κατὰ τὴν ἡμέραν τοῦ πειρασμοῦ ἐν τῇ ἐρήμῳ,"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "οὗ ⸀ἐπείρασαν",
          {
            "noteId": 19
          },
          "οἱ πατέρες ὑμῶν ⸂ἐν δοκιμασίᾳ",
          {
            "noteId": 20
          },
          "καὶ εἶδον τὰ ἔργα μου"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "τεσσεράκοντα ἔτη· διὸ προσώχθισα τῇ γενεᾷ ⸀ταύτῃ",
          {
            "noteId": 21
          },
          "καὶ εἶπον· Ἀεὶ πλανῶνται τῇ καρδίᾳ· αὐτοὶ δὲ οὐκ ἔγνωσαν τὰς ὁδούς μου·"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ὡς ὤμοσα ἐν τῇ ὀργῇ μου· Εἰ εἰσελεύσονται εἰς τὴν κατάπαυσίν μου."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "βλέπετε, ἀδελφοί, μήποτε ἔσται ἔν τινι ὑμῶν καρδία πονηρὰ ἀπιστίας ἐν τῷ ἀποστῆναι ἀπὸ θεοῦ ζῶντος,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ἀλλὰ παρακαλεῖτε ἑαυτοὺς καθʼ ἑκάστην ἡμέραν, ἄχρις οὗ τὸ Σήμερον καλεῖται, ἵνα μὴ σκληρυνθῇ ⸂τις ἐξ ὑμῶν",
          {
            "noteId": 22
          },
          "ἀπάτῃ τῆς ἁμαρτίας·"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "μέτοχοι γὰρ ⸂τοῦ Χριστοῦ γεγόναμεν",
          {
            "noteId": 23
          },
          ", ἐάνπερ τὴν ἀρχὴν τῆς ὑποστάσεως μέχρι τέλους βεβαίαν κατάσχωμεν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ἐν τῷ λέγεσθαι· Σήμερον ἐὰν τῆς φωνῆς αὐτοῦ ἀκούσητε, Μὴ σκληρύνητε τὰς καρδίας ὑμῶν ὡς ἐν τῷ παραπικρασμῷ."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "τίνες γὰρ ἀκούσαντες παρεπίκραναν; ἀλλʼ οὐ πάντες οἱ ἐξελθόντες ἐξ Αἰγύπτου διὰ Μωϋσέως;"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "τίσιν δὲ προσώχθισεν τεσσεράκοντα ἔτη; οὐχὶ τοῖς ἁμαρτήσασιν, ὧν τὰ κῶλα ἔπεσεν ἐν τῇ ἐρήμῳ;"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "τίσιν δὲ ὤμοσεν μὴ εἰσελεύσεσθαι εἰς τὴν κατάπαυσιν αὐτοῦ εἰ μὴ τοῖς ἀπειθήσασιν;"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "καὶ βλέπομεν ὅτι οὐκ ἠδυνήθησαν εἰσελθεῖν διʼ ἀπιστίαν."
        ]
      }
    ],
