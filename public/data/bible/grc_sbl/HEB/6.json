  "chapter": {
    "number": 6,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Διὸ ἀφέντες τὸν τῆς ἀρχῆς τοῦ Χριστοῦ λόγον ἐπὶ τὴν τελειότητα φερώμεθα, μὴ πάλιν θεμέλιον καταβαλλόμενοι μετανοίας ἀπὸ νεκρῶν ἔργων, καὶ πίστεως ἐπὶ θεόν,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "βαπτισμῶν ⸀διδαχὴν",
          {
            "noteId": 36
          },
          "ἐπιθέσεώς τε",
          {
            "noteId": 37
          },
          "χειρῶν, ἀναστάσεώς ⸀τε νεκρῶν καὶ κρίματος αἰωνίου."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ τοῦτο ⸀ποιήσομεν",
          {
            "noteId": 38
          },
          "ἐάνπερ ἐπιτρέπῃ ὁ θεός."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Ἀδύνατον γὰρ τοὺς ἅπαξ φωτισθέντας γευσαμένους τε τῆς δωρεᾶς τῆς ἐπουρανίου καὶ μετόχους γενηθέντας πνεύματος ἁγίου"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ καλὸν γευσαμένους θεοῦ ῥῆμα δυνάμεις τε μέλλοντος αἰῶνος,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ παραπεσόντας, πάλιν ἀνακαινίζειν εἰς μετάνοιαν, ἀνασταυροῦντας ἑαυτοῖς τὸν υἱὸν τοῦ θεοῦ καὶ παραδειγματίζοντας."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "γῆ γὰρ ἡ πιοῦσα τὸν ἐπʼ αὐτῆς ⸂ἐρχόμενον πολλάκις",
          {
            "noteId": 39
          },
          "ὑετόν, καὶ τίκτουσα βοτάνην εὔθετον ἐκείνοις διʼ οὓς καὶ γεωργεῖται, μεταλαμβάνει εὐλογίας ἀπὸ τοῦ θεοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἐκφέρουσα δὲ ἀκάνθας καὶ τριβόλους ἀδόκιμος καὶ κατάρας ἐγγύς, ἧς τὸ τέλος εἰς καῦσιν."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Πεπείσμεθα δὲ περὶ ὑμῶν, ἀγαπητοί, τὰ κρείσσονα καὶ ἐχόμενα σωτηρίας, εἰ καὶ οὕτως λαλοῦμεν·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "οὐ γὰρ ἄδικος ὁ θεὸς ἐπιλαθέσθαι τοῦ ἔργου ὑμῶν ⸀καὶ",
          {
            "noteId": 40
          },
          "τῆς ἀγάπης ἧς ἐνεδείξασθε εἰς τὸ ὄνομα αὐτοῦ, διακονήσαντες τοῖς ἁγίοις καὶ διακονοῦντες."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ἐπιθυμοῦμεν δὲ ἕκαστον ὑμῶν τὴν αὐτὴν ἐνδείκνυσθαι σπουδὴν πρὸς τὴν πληροφορίαν τῆς ἐλπίδος ἄχρι τέλους,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ἵνα μὴ νωθροὶ γένησθε, μιμηταὶ δὲ τῶν διὰ πίστεως καὶ μακροθυμίας κληρονομούντων τὰς ἐπαγγελίας."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Τῷ γὰρ Ἀβραὰμ ἐπαγγειλάμενος ὁ θεός, ἐπεὶ κατʼ οὐδενὸς εἶχεν μείζονος ὀμόσαι, ὤμοσεν καθʼ ἑαυτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "λέγων· ⸀Εἰ",
          {
            "noteId": 41
          },
          "μὴν εὐλογῶν εὐλογήσω σε καὶ πληθύνων πληθυνῶ σε·"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ οὕτως μακροθυμήσας ἐπέτυχεν τῆς ἐπαγγελίας."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "⸀ἄνθρωποι",
          {
            "noteId": 42
          },
          "γὰρ κατὰ τοῦ μείζονος ὀμνύουσιν, καὶ πάσης αὐτοῖς ἀντιλογίας πέρας εἰς βεβαίωσιν ὁ ὅρκος·"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ἐν ᾧ περισσότερον βουλόμενος ὁ θεὸς ἐπιδεῖξαι τοῖς κληρονόμοις τῆς ἐπαγγελίας τὸ ἀμετάθετον τῆς βουλῆς αὐτοῦ ἐμεσίτευσεν ὅρκῳ,"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ἵνα διὰ δύο πραγμάτων ἀμεταθέτων, ἐν οἷς ἀδύνατον ψεύσασθαι ⸀θεόν",
          {
            "noteId": 43
          },
          "ἰσχυρὰν παράκλησιν ἔχωμεν οἱ καταφυγόντες κρατῆσαι τῆς προκειμένης ἐλπίδος·"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἣν ὡς ἄγκυραν ἔχομεν τῆς ψυχῆς, ⸀ἀσφαλῆ",
          {
            "noteId": 44
          },
          "τε καὶ βεβαίαν καὶ εἰσερχομένην εἰς τὸ ἐσώτερον τοῦ καταπετάσματος,"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ὅπου πρόδρομος ὑπὲρ ἡμῶν εἰσῆλθεν Ἰησοῦς, κατὰ τὴν τάξιν Μελχισέδεκ ἀρχιερεὺς γενόμενος εἰς τὸν αἰῶνα."
        ]
      }
    ],
