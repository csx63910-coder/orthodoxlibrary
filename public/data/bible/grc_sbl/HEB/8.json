  "chapter": {
    "number": 8,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Κεφάλαιον δὲ ἐπὶ τοῖς λεγομένοις, τοιοῦτον ἔχομεν ἀρχιερέα, ὃς ἐκάθισεν ἐν δεξιᾷ τοῦ θρόνου τῆς μεγαλωσύνης ἐν τοῖς οὐρανοῖς,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "τῶν ἁγίων λειτουργὸς καὶ τῆς σκηνῆς τῆς ἀληθινῆς, ἣν ἔπηξεν ὁ κύριος, ⸀οὐκ",
          {
            "noteId": 58
          },
          "ἄνθρωπος."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "πᾶς γὰρ ἀρχιερεὺς εἰς τὸ προσφέρειν δῶρά τε καὶ θυσίας καθίσταται· ὅθεν ἀναγκαῖον ἔχειν τι καὶ τοῦτον ὃ προσενέγκῃ."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "εἰ μὲν ⸀οὖν",
          {
            "noteId": 59
          },
          "ἦν ἐπὶ γῆς, οὐδʼ ἂν ἦν ἱερεύς, ⸀ὄντων",
          {
            "noteId": 60
          },
          "τῶν προσφερόντων κατὰ ⸀νόμον",
          {
            "noteId": 61
          },
          "τὰ δῶρα·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "(οἵτινες ὑποδείγματι καὶ σκιᾷ λατρεύουσιν τῶν ἐπουρανίων, καθὼς κεχρημάτισται Μωϋσῆς μέλλων ἐπιτελεῖν τὴν σκηνήν, Ὅρα γάρ, φησίν, ποιήσεις πάντα κατὰ τὸν τύπον τὸν δειχθέντα σοι ἐν τῷ ὄρει)·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "⸀νυνὶ",
          {
            "noteId": 62
          },
          "δὲ διαφορωτέρας τέτυχεν λειτουργίας, ὅσῳ καὶ κρείττονός ἐστιν διαθήκης μεσίτης, ἥτις ἐπὶ κρείττοσιν ἐπαγγελίαις νενομοθέτηται."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Εἰ γὰρ ἡ πρώτη ἐκείνη ἦν ἄμεμπτος, οὐκ ἂν δευτέρας ἐζητεῖτο τόπος·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "μεμφόμενος γὰρ ⸀αὐτοὺς",
          {
            "noteId": 63
          },
          "λέγει· Ἰδοὺ ἡμέραι ἔρχονται, λέγει κύριος, καὶ συντελέσω ἐπὶ τὸν οἶκον Ἰσραὴλ καὶ ἐπὶ τὸν οἶκον Ἰούδα διαθήκην καινήν,"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "οὐ κατὰ τὴν διαθήκην ἣν ἐποίησα τοῖς πατράσιν αὐτῶν ἐν ἡμέρᾳ ἐπιλαβομένου μου τῆς χειρὸς αὐτῶν ἐξαγαγεῖν αὐτοὺς ἐκ γῆς Αἰγύπτου, ὅτι αὐτοὶ οὐκ ἐνέμειναν ἐν τῇ διαθήκῃ μου, κἀγὼ ἠμέλησα αὐτῶν, λέγει κύριος."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ὅτι αὕτη ἡ διαθήκη ἣν διαθήσομαι τῷ οἴκῳ Ἰσραὴλ μετὰ τὰς ἡμέρας ἐκείνας, λέγει κύριος, διδοὺς νόμους μου εἰς τὴν διάνοιαν αὐτῶν, καὶ ἐπὶ καρδίας αὐτῶν ἐπιγράψω αὐτούς, καὶ ἔσομαι αὐτοῖς εἰς θεόν καὶ αὐτοὶ ἔσονταί μοι εἰς λαόν."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ οὐ μὴ διδάξωσιν ἕκαστος τὸν πολίτην αὐτοῦ καὶ ἕκαστος τὸν ἀδελφὸν αὐτοῦ, λέγων· Γνῶθι τὸν κύριον, ὅτι πάντες εἰδήσουσίν με ἀπὸ ⸀μικροῦ",
          {
            "noteId": 64
          },
          "ἕως μεγάλου αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ὅτι ἵλεως ἔσομαι ταῖς ἀδικίαις αὐτῶν",
          {
            "noteId": 65
          },
          "καὶ τῶν ἁμαρτιῶν ⸀αὐτῶν οὐ μὴ μνησθῶ ἔτι."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ἐν τῷ λέγειν Καινὴν πεπαλαίωκεν τὴν πρώτην, τὸ δὲ παλαιούμενον καὶ γηράσκον ἐγγὺς ἀφανισμοῦ."
        ]
      }
    ],
