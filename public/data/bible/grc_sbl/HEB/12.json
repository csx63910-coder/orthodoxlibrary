  "chapter": {
    "number": 12,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Τοιγαροῦν καὶ ἡμεῖς, τοσοῦτον ἔχοντες περικείμενον ἡμῖν νέφος μαρτύρων, ὄγκον ἀποθέμενοι πάντα καὶ τὴν εὐπερίστατον ἁμαρτίαν, διʼ ὑπομονῆς τρέχωμεν τὸν προκείμενον ἡμῖν ἀγῶνα,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἀφορῶντες εἰς τὸν τῆς πίστεως ἀρχηγὸν καὶ τελειωτὴν Ἰησοῦν, ὃς ἀντὶ τῆς προκειμένης αὐτῷ χαρᾶς ὑπέμεινεν σταυρὸν αἰσχύνης καταφρονήσας, ἐν δεξιᾷ τε τοῦ θρόνου τοῦ θεοῦ κεκάθικεν."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Ἀναλογίσασθε γὰρ τὸν τοιαύτην ὑπομεμενηκότα ὑπὸ τῶν ἁμαρτωλῶν εἰς ⸀ἑαυτοὺς",
          {
            "noteId": 119
          },
          "ἀντιλογίαν, ἵνα μὴ κάμητε ταῖς ψυχαῖς ὑμῶν ἐκλυόμενοι."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "οὔπω μέχρις αἵματος ἀντικατέστητε πρὸς τὴν ἁμαρτίαν ἀνταγωνιζόμενοι,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ ἐκλέλησθε τῆς παρακλήσεως, ἥτις ὑμῖν ὡς υἱοῖς διαλέγεται, Υἱέ μου, μὴ ὀλιγώρει παιδείας κυρίου, μηδὲ ἐκλύου ὑπʼ αὐτοῦ ἐλεγχόμενος·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ὃν γὰρ ἀγαπᾷ κύριος παιδεύει, μαστιγοῖ δὲ πάντα υἱὸν ὃν παραδέχεται."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "εἰς παιδείαν ὑπομένετε· ὡς υἱοῖς ὑμῖν προσφέρεται ὁ θεός· τίς ⸀γὰρ",
          {
            "noteId": 120
          },
          "υἱὸς ὃν οὐ παιδεύει πατήρ;"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "εἰ δὲ χωρίς ἐστε παιδείας ἧς μέτοχοι γεγόνασι πάντες, ἄρα νόθοι ⸂καὶ οὐχ υἱοί ἐστε",
          {
            "noteId": 121
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "εἶτα τοὺς μὲν τῆς σαρκὸς ἡμῶν πατέρας εἴχομεν παιδευτὰς καὶ ἐνετρεπόμεθα· οὐ ⸀πολὺ",
          {
            "noteId": 122
          },
          "μᾶλλον ὑποταγησόμεθα τῷ πατρὶ τῶν πνευμάτων καὶ ζήσομεν;"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "οἱ μὲν γὰρ πρὸς ὀλίγας ἡμέρας κατὰ τὸ δοκοῦν αὐτοῖς ἐπαίδευον, ὁ δὲ ἐπὶ τὸ συμφέρον εἰς τὸ μεταλαβεῖν τῆς ἁγιότητος αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "πᾶσα ⸀δὲ",
          {
            "noteId": 123
          },
          "παιδεία πρὸς μὲν τὸ παρὸν οὐ δοκεῖ χαρᾶς εἶναι ἀλλὰ λύπης, ὕστερον δὲ καρπὸν εἰρηνικὸν τοῖς διʼ αὐτῆς γεγυμνασμένοις ἀποδίδωσιν δικαιοσύνης."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Διὸ τὰς παρειμένας χεῖρας καὶ τὰ παραλελυμένα γόνατα ἀνορθώσατε,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ τροχιὰς ὀρθὰς ⸀ποιεῖτε",
          {
            "noteId": 124
          },
          "τοῖς ποσὶν ὑμῶν, ἵνα μὴ τὸ χωλὸν ἐκτραπῇ, ἰαθῇ δὲ μᾶλλον."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Εἰρήνην διώκετε μετὰ πάντων, καὶ τὸν ἁγιασμόν, οὗ χωρὶς οὐδεὶς ὄψεται τὸν κύριον,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ἐπισκοποῦντες μή τις ὑστερῶν ἀπὸ τῆς χάριτος τοῦ θεοῦ, μή τις ῥίζα πικρίας ἄνω φύουσα ἐνοχλῇ καὶ ⸂διʼ αὐτῆς",
          {
            "noteId": 125
          },
          "μιανθῶσιν ⸀πολλοί",
          {
            "noteId": 126
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "μή τις πόρνος ἢ βέβηλος ὡς Ἠσαῦ, ὃς ἀντὶ βρώσεως μιᾶς ἀπέδετο τὰ πρωτοτόκια ⸀ἑαυτοῦ",
          {
            "noteId": 127
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ἴστε γὰρ ὅτι καὶ μετέπειτα θέλων κληρονομῆσαι τὴν εὐλογίαν ἀπεδοκιμάσθη, μετανοίας γὰρ τόπον οὐχ εὗρεν, καίπερ μετὰ δακρύων ἐκζητήσας αὐτήν."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Οὐ γὰρ προσεληλύθατε ⸀ψηλαφωμένῳ",
          {
            "noteId": 128
          },
          "καὶ κεκαυμένῳ πυρὶ καὶ γνόφῳ καὶ ⸀ζόφῳ",
          {
            "noteId": 129
          },
          "καὶ θυέλλῃ"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "καὶ σάλπιγγος ἤχῳ καὶ φωνῇ ῥημάτων, ἧς οἱ ἀκούσαντες παρῃτήσαντο ⸀μὴ",
          {
            "noteId": 130
          },
          "προστεθῆναι αὐτοῖς λόγον·"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "οὐκ ἔφερον γὰρ τὸ διαστελλόμενον· Κἂν θηρίον θίγῃ τοῦ ὄρους, λιθοβοληθήσεται·"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "καί, οὕτω φοβερὸν ἦν τὸ φανταζόμενον, Μωϋσῆς εἶπεν· Ἔκφοβός εἰμι καὶ ἔντρομος."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ἀλλὰ προσεληλύθατε Σιὼν ὄρει καὶ πόλει θεοῦ ζῶντος, Ἰερουσαλὴμ ἐπουρανίῳ, καὶ μυριάσιν ἀγγέλων, πανηγύρει"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "καὶ ἐκκλησίᾳ πρωτοτόκων ⸂ἀπογεγραμμένων ἐν οὐρανοῖς",
          {
            "noteId": 131
          },
          ", καὶ κριτῇ θεῷ πάντων, καὶ πνεύμασι δικαίων τετελειωμένων,"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "καὶ διαθήκης νέας μεσίτῃ Ἰησοῦ, καὶ αἵματι ῥαντισμοῦ κρεῖττον λαλοῦντι παρὰ τὸν Ἅβελ."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Βλέπετε μὴ παραιτήσησθε τὸν λαλοῦντα· εἰ γὰρ ἐκεῖνοι οὐκ ⸀ἐξέφυγον",
          {
            "noteId": 132
          },
          "⸂ἐπὶ γῆς παραιτησάμενοι τὸν",
          {
            "noteId": 133
          },
          "χρηματίζοντα, ⸀πολὺ",
          {
            "noteId": 134
          },
          "μᾶλλον ἡμεῖς οἱ τὸν ἀπʼ οὐρανῶν ἀποστρεφόμενοι·"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "οὗ ἡ φωνὴ τὴν γῆν ἐσάλευσεν τότε, νῦν δὲ ἐπήγγελται λέγων· Ἔτι ἅπαξ ἐγὼ ⸀σείσω",
          {
            "noteId": 135
          },
          "οὐ μόνον τὴν γῆν ἀλλὰ καὶ τὸν οὐρανόν."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "τὸ δὲ Ἔτι ἅπαξ δηλοῖ ⸂τῶν σαλευομένων",
          {
            "noteId": 136
          },
          "μετάθεσιν ὡς πεποιημένων, ἵνα μείνῃ τὰ μὴ σαλευόμενα."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "διὸ βασιλείαν ἀσάλευτον παραλαμβάνοντες ἔχωμεν χάριν, διʼ ἧς ⸀λατρεύωμεν",
          {
            "noteId": 137
          },
          "εὐαρέστως τῷ θεῷ μετὰ ⸂εὐλαβείας καὶ δέους",
          {
            "noteId": 138
          },
          ","
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "καὶ γὰρ ὁ θεὸς ἡμῶν πῦρ καταναλίσκον."
        ]
      }
    ],
