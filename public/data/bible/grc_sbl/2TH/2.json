  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἐρωτῶμεν δὲ ὑμᾶς, ἀδελφοί, ὑπὲρ τῆς παρουσίας τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ καὶ ἡμῶν ἐπισυναγωγῆς ἐπʼ αὐτόν,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "εἰς τὸ μὴ ταχέως σαλευθῆναι ὑμᾶς ἀπὸ τοῦ νοὸς ⸀μηδὲ",
          {
            "noteId": 4
          },
          "θροεῖσθαι μήτε διὰ πνεύματος μήτε διὰ λόγου μήτε διʼ ἐπιστολῆς ὡς διʼ ἡμῶν, ὡς ὅτι ἐνέστηκεν ἡ ἡμέρα τοῦ ⸀κυρίου",
          {
            "noteId": 5
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "μή τις ὑμᾶς ἐξαπατήσῃ κατὰ μηδένα τρόπον· ὅτι ἐὰν μὴ ἔλθῃ ἡ ἀποστασία πρῶτον καὶ ἀποκαλυφθῇ ὁ ἄνθρωπος τῆς ⸀ἀνομίας",
          {
            "noteId": 6
          },
          "ὁ υἱὸς τῆς ἀπωλείας,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ὁ ἀντικείμενος καὶ ὑπεραιρόμενος ἐπὶ πάντα λεγόμενον θεὸν ἢ σέβασμα, ὥστε αὐτὸν εἰς τὸν ναὸν τοῦ ⸀θεοῦ",
          {
            "noteId": 7
          },
          "καθίσαι ἀποδεικνύντα ἑαυτὸν ὅτι ἔστιν θεός."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "οὐ μνημονεύετε ὅτι ἔτι ὢν πρὸς ὑμᾶς ταῦτα ἔλεγον ὑμῖν;"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ νῦν τὸ κατέχον οἴδατε, εἰς τὸ ἀποκαλυφθῆναι αὐτὸν ἐν τῷ ⸀ἑαυτοῦ",
          {
            "noteId": 8
          },
          "καιρῷ·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "τὸ γὰρ μυστήριον ἤδη ἐνεργεῖται τῆς ἀνομίας· μόνον ὁ κατέχων ἄρτι ἕως ἐκ μέσου γένηται."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ τότε ἀποκαλυφθήσεται ὁ ἄνομος, ὃν ὁ κύριος ⸀Ἰησοῦς",
          {
            "noteId": 9
          },
          "⸀ἀνελεῖ",
          {
            "noteId": 10
          },
          "τῷ πνεύματι τοῦ στόματος αὐτοῦ καὶ καταργήσει τῇ ἐπιφανείᾳ τῆς παρουσίας αὐτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "οὗ ἐστιν ἡ παρουσία κατʼ ἐνέργειαν τοῦ Σατανᾶ ἐν πάσῃ δυνάμει καὶ σημείοις καὶ τέρασιν ψεύδους"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ ἐν πάσῃ ἀπάτῃ ⸀ἀδικίας",
          {
            "noteId": 11
          },
          "τοῖς ἀπολλυμένοις, ἀνθʼ ὧν τὴν ἀγάπην τῆς ἀληθείας οὐκ ἐδέξαντο εἰς τὸ σωθῆναι αὐτούς·"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ διὰ τοῦτο ⸀πέμπει",
          {
            "noteId": 12
          },
          "αὐτοῖς ὁ θεὸς ἐνέργειαν πλάνης εἰς τὸ πιστεῦσαι αὐτοὺς τῷ ψεύδει,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ἵνα κριθῶσιν ⸀πάντες",
          {
            "noteId": 13
          },
          "οἱ μὴ πιστεύσαντες τῇ",
          {
            "noteId": 14
          },
          "ἀληθείᾳ ἀλλὰ εὐδοκήσαντες ⸀τῇ ἀδικίᾳ."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ἡμεῖς δὲ ὀφείλομεν εὐχαριστεῖν τῷ θεῷ πάντοτε περὶ ὑμῶν, ἀδελφοὶ ἠγαπημένοι ὑπὸ κυρίου, ὅτι εἵλατο ὑμᾶς ὁ θεὸς ⸀ἀπαρχὴν",
          {
            "noteId": 15
          },
          "εἰς σωτηρίαν ἐν ἁγιασμῷ πνεύματος καὶ πίστει ἀληθείας,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "εἰς ⸀ὃ",
          {
            "noteId": 16
          },
          "ἐκάλεσεν ὑμᾶς διὰ τοῦ εὐαγγελίου ἡμῶν, εἰς περιποίησιν δόξης τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ἄρα οὖν, ἀδελφοί, στήκετε, καὶ κρατεῖτε τὰς παραδόσεις ἃς ἐδιδάχθητε εἴτε διὰ λόγου εἴτε διʼ ἐπιστολῆς ἡμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Αὐτὸς δὲ ὁ κύριος ἡμῶν Ἰησοῦς Χριστὸς καὶ ⸀θεὸς",
          {
            "noteId": 17
          },
          "⸀ὁ",
          {
            "noteId": 18
          },
          "πατὴρ ἡμῶν, ὁ ἀγαπήσας ἡμᾶς καὶ δοὺς παράκλησιν αἰωνίαν καὶ ἐλπίδα ἀγαθὴν ἐν χάριτι,"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "παρακαλέσαι ὑμῶν τὰς καρδίας καὶ ⸀στηρίξαι",
          {
            "noteId": 19
          },
          "ἐν παντὶ ⸂ἔργῳ καὶ λόγῳ",
          {
            "noteId": 20
          },
          "ἀγαθῷ."
        ]
      }
    ],
