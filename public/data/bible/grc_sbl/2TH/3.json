  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Τὸ λοιπὸν προσεύχεσθε, ἀδελφοί, περὶ ἡμῶν, ἵνα ὁ λόγος τοῦ κυρίου τρέχῃ καὶ δοξάζηται καθὼς καὶ πρὸς ὑμᾶς,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ ἵνα ῥυσθῶμεν ἀπὸ τῶν ἀτόπων καὶ πονηρῶν ἀνθρώπων, οὐ γὰρ πάντων ἡ πίστις."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "πιστὸς δέ ἐστιν ὁ κύριος, ὃς στηρίξει ὑμᾶς καὶ φυλάξει ἀπὸ τοῦ πονηροῦ."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "πεποίθαμεν δὲ ἐν κυρίῳ ἐφʼ ὑμᾶς, ὅτι ἃ ⸀παραγγέλλομεν",
          {
            "noteId": 21
          },
          "καὶ ποιεῖτε καὶ ποιήσετε."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ὁ δὲ κύριος κατευθύναι ὑμῶν τὰς καρδίας εἰς τὴν ἀγάπην τοῦ θεοῦ καὶ εἰς τὴν ὑπομονὴν τοῦ Χριστοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Παραγγέλλομεν δὲ ὑμῖν, ἀδελφοί, ἐν ὀνόματι τοῦ κυρίου ⸀ἡμῶν",
          {
            "noteId": 22
          },
          "Ἰησοῦ Χριστοῦ στέλλεσθαι ὑμᾶς ἀπὸ παντὸς ἀδελφοῦ ἀτάκτως περιπατοῦντος καὶ μὴ κατὰ τὴν παράδοσιν ἣν ⸀παρελάβοσαν",
          {
            "noteId": 23
          },
          "παρʼ ἡμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "αὐτοὶ γὰρ οἴδατε πῶς δεῖ μιμεῖσθαι ἡμᾶς, ὅτι οὐκ ἠτακτήσαμεν ἐν ὑμῖν"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "οὐδὲ δωρεὰν ἄρτον ἐφάγομεν παρά τινος, ἀλλʼ ἐν κόπῳ καὶ μόχθῳ ⸂νυκτὸς καὶ ἡμέρας",
          {
            "noteId": 24
          },
          "ἐργαζόμενοι πρὸς τὸ μὴ ἐπιβαρῆσαί τινα ὑμῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "οὐχ ὅτι οὐκ ἔχομεν ἐξουσίαν, ἀλλʼ ἵνα ἑαυτοὺς τύπον δῶμεν ὑμῖν εἰς τὸ μιμεῖσθαι ἡμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ γὰρ ὅτε ἦμεν πρὸς ὑμᾶς, τοῦτο παρηγγέλλομεν ὑμῖν, ὅτι εἴ τις οὐ θέλει ἐργάζεσθαι μηδὲ ἐσθιέτω."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ἀκούομεν γάρ τινας περιπατοῦντας ἐν ὑμῖν ἀτάκτως, μηδὲν ἐργαζομένους ἀλλὰ περιεργαζομένους·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "τοῖς δὲ τοιούτοις παραγγέλλομεν καὶ παρακαλοῦμεν ⸂ἐν κυρίῳ Ἰησοῦ Χριστῷ",
          {
            "noteId": 25
          },
          "ἵνα μετὰ ἡσυχίας ἐργαζόμενοι τὸν ἑαυτῶν ἄρτον ἐσθίωσιν."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ὑμεῖς δέ, ἀδελφοί, μὴ ⸀ἐγκακήσητε",
          {
            "noteId": 26
          },
          "καλοποιοῦντες."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Εἰ δέ τις οὐχ ὑπακούει τῷ λόγῳ ἡμῶν διὰ τῆς ἐπιστολῆς, τοῦτον σημειοῦσθε, ⸀μὴ",
          {
            "noteId": 27
          },
          "⸀συναναμίγνυσθαι",
          {
            "noteId": 28
          },
          "αὐτῷ, ἵνα ἐντραπῇ·"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ μὴ ὡς ἐχθρὸν ἡγεῖσθε, ἀλλὰ νουθετεῖτε ὡς ἀδελφόν."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Αὐτὸς δὲ ὁ κύριος τῆς εἰρήνης δῴη ὑμῖν τὴν εἰρήνην διὰ παντὸς ἐν παντὶ τρόπῳ. ὁ κύριος μετὰ πάντων ὑμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Ὁ ἀσπασμὸς τῇ ἐμῇ χειρὶ Παύλου, ὅ ἐστιν σημεῖον ἐν πάσῃ ἐπιστολῇ· οὕτως γράφω."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ἡ χάρις τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ μετὰ πάντων ⸀ὑμῶν",
          {
            "noteId": 29
          },
          "‘p /’ ‘/book’"
        ]
      }
    ],
