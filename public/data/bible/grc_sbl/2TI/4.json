  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "⸀Διαμαρτύρομαι",
          {
            "noteId": 22
          },
          "ἐνώπιον τοῦ θεοῦ καὶ ⸂Χριστοῦ Ἰησοῦ",
          {
            "noteId": 23
          },
          ", τοῦ μέλλοντος κρίνειν ζῶντας καὶ",
          {
            "noteId": 24
          },
          "νεκρούς, ⸀καὶ τὴν ἐπιφάνειαν αὐτοῦ καὶ τὴν βασιλείαν αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "κήρυξον τὸν λόγον, ἐπίστηθι εὐκαίρως ἀκαίρως, ἔλεγξον, ἐπιτίμησον, παρακάλεσον, ἐν πάσῃ μακροθυμίᾳ καὶ διδαχῇ."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἔσται γὰρ καιρὸς ὅτε τῆς ὑγιαινούσης διδασκαλίας οὐκ ἀνέξονται, ἀλλὰ κατὰ τὰς ⸂ἰδίας ἐπιθυμίας",
          {
            "noteId": 25
          },
          "ἑαυτοῖς ἐπισωρεύσουσιν διδασκάλους κνηθόμενοι τὴν ἀκοήν,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ ἀπὸ μὲν τῆς ἀληθείας τὴν ἀκοὴν ἀποστρέψουσιν, ἐπὶ δὲ τοὺς μύθους ἐκτραπήσονται."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "σὺ δὲ νῆφε ἐν πᾶσιν, κακοπάθησον, ἔργον ποίησον εὐαγγελιστοῦ, τὴν διακονίαν σου πληροφόρησον."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ἐγὼ γὰρ ἤδη σπένδομαι, καὶ ὁ καιρὸς τῆς ⸂ἀναλύσεώς μου",
          {
            "noteId": 26
          },
          "ἐφέστηκεν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "τὸν ⸂καλὸν ἀγῶνα",
          {
            "noteId": 27
          },
          "ἠγώνισμαι, τὸν δρόμον τετέλεκα, τὴν πίστιν τετήρηκα·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "λοιπὸν ἀπόκειταί μοι ὁ τῆς δικαιοσύνης στέφανος, ὃν ἀποδώσει μοι ὁ κύριος ἐν ἐκείνῃ τῇ ἡμέρᾳ, ὁ δίκαιος κριτής, οὐ μόνον δὲ ἐμοὶ ἀλλὰ καὶ πᾶσιν τοῖς ἠγαπηκόσι τὴν ἐπιφάνειαν αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Σπούδασον ἐλθεῖν πρός με ταχέως·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Δημᾶς γάρ με ⸀ἐγκατέλιπεν",
          {
            "noteId": 28
          },
          "ἀγαπήσας τὸν νῦν αἰῶνα, καὶ ἐπορεύθη εἰς Θεσσαλονίκην, Κρήσκης εἰς Γαλατίαν, Τίτος εἰς Δαλματίαν·"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Λουκᾶς ἐστιν μόνος μετʼ ἐμοῦ. Μᾶρκον ἀναλαβὼν ἄγε μετὰ σεαυτοῦ, ἔστιν γάρ μοι εὔχρηστος εἰς διακονίαν,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Τυχικὸν δὲ ἀπέστειλα εἰς Ἔφεσον."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "τὸν φαιλόνην, ὃν ⸀ἀπέλιπον",
          {
            "noteId": 29
          },
          "ἐν Τρῳάδι παρὰ Κάρπῳ, ἐρχόμενος φέρε, καὶ τὰ βιβλία, μάλιστα τὰς μεμβράνας."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Ἀλέξανδρος ὁ χαλκεὺς πολλά μοι κακὰ ἐνεδείξατο— ⸀ἀποδώσει",
          {
            "noteId": 30
          },
          "αὐτῷ ὁ κύριος κατὰ τὰ ἔργα αὐτοῦ—"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ὃν καὶ σὺ φυλάσσου, λίαν γὰρ ⸀ἀντέστη",
          {
            "noteId": 31
          },
          "τοῖς ἡμετέροις λόγοις."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Ἐν τῇ πρώτῃ μου ἀπολογίᾳ οὐδείς μοι ⸀παρεγένετο",
          {
            "noteId": 32
          },
          "ἀλλὰ πάντες με ⸀ἐγκατέλιπον",
          {
            "noteId": 33
          },
          "μὴ αὐτοῖς λογισθείη—"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ὁ δὲ κύριός μοι παρέστη καὶ ἐνεδυνάμωσέν με, ἵνα διʼ ἐμοῦ τὸ κήρυγμα πληροφορηθῇ καὶ ⸀ἀκούσωσιν",
          {
            "noteId": 34
          },
          "πάντα τὰ ἔθνη, καὶ ἐρρύσθην ἐκ στόματος λέοντος."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "⸀ῥύσεταί",
          {
            "noteId": 35
          },
          "με ὁ κύριος ἀπὸ παντὸς ἔργου πονηροῦ καὶ σώσει εἰς τὴν βασιλείαν αὐτοῦ τὴν ἐπουράνιον· ᾧ ἡ δόξα εἰς τοὺς αἰῶνας τῶν αἰώνων, ἀμήν."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Ἄσπασαι Πρίσκαν καὶ Ἀκύλαν καὶ τὸν Ὀνησιφόρου οἶκον."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Ἔραστος ἔμεινεν ἐν Κορίνθῳ, Τρόφιμον δὲ ⸀ἀπέλιπον",
          {
            "noteId": 36
          },
          "ἐν Μιλήτῳ ἀσθενοῦντα."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Σπούδασον πρὸ χειμῶνος ἐλθεῖν. Ἀσπάζεταί σε Εὔβουλος καὶ Πούδης καὶ Λίνος καὶ Κλαυδία καὶ οἱ ἀδελφοὶ πάντες."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Ὁ ⸀κύριος",
          {
            "noteId": 37
          },
          "μετὰ τοῦ πνεύματός σου. ἡ χάρις μεθʼ ⸀ὑμῶν",
          {
            "noteId": 38
          },
          "‘p /’ ‘/book’"
        ]
      }
    ],
