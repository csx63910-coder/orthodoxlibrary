    "title": "ΠΡΟΣ ΤΙΜΟΘΕΟΝ Β",
    "order": 55,
    "numberOfChapters": 4,
    "sha256": "2531b85b66c5f5076e05978d6d7849d12eabc5838871a4d0229756630384971d",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_sbl/2TI/1.json",
