  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Τοῦτο δὲ γίνωσκε ὅτι ἐν ἐσχάταις ἡμέραις ἐνστήσονται καιροὶ χαλεποί·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἔσονται γὰρ οἱ ἄνθρωποι φίλαυτοι, φιλάργυροι, ἀλαζόνες, ὑπερήφανοι, βλάσφημοι, γονεῦσιν ἀπειθεῖς, ἀχάριστοι, ἀνόσιοι,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἄστοργοι, ἄσπονδοι, διάβολοι, ἀκρατεῖς, ἀνήμεροι, ἀφιλάγαθοι,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "προδόται, προπετεῖς, τετυφωμένοι, φιλήδονοι μᾶλλον ἢ φιλόθεοι,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἔχοντες μόρφωσιν εὐσεβείας τὴν δὲ δύναμιν αὐτῆς ἠρνημένοι· καὶ τούτους ἀποτρέπου."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἐκ τούτων γάρ εἰσιν οἱ ἐνδύνοντες εἰς τὰς οἰκίας καὶ ⸀αἰχμαλωτίζοντες",
          {
            "noteId": 16
          },
          "γυναικάρια σεσωρευμένα ἁμαρτίαις, ἀγόμενα ἐπιθυμίαις ποικίλαις,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "πάντοτε μανθάνοντα καὶ μηδέποτε εἰς ἐπίγνωσιν ἀληθείας ἐλθεῖν δυνάμενα."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ὃν τρόπον δὲ Ἰάννης καὶ Ἰαμβρῆς ἀντέστησαν Μωϋσεῖ, οὕτως καὶ οὗτοι ἀνθίστανται τῇ ἀληθείᾳ, ἄνθρωποι κατεφθαρμένοι τὸν νοῦν, ἀδόκιμοι περὶ τὴν πίστιν."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ἀλλʼ οὐ προκόψουσιν ἐπὶ πλεῖον, ἡ γὰρ ἄνοια αὐτῶν ἔκδηλος ἔσται πᾶσιν, ὡς καὶ ἡ ἐκείνων ἐγένετο."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Σὺ δὲ ⸀παρηκολούθησάς",
          {
            "noteId": 17
          },
          "μου τῇ διδασκαλίᾳ, τῇ ἀγωγῇ, τῇ προθέσει, τῇ πίστει, τῇ μακροθυμίᾳ, τῇ ἀγάπῃ, τῇ ὑπομονῇ,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "τοῖς διωγμοῖς, τοῖς παθήμασιν, οἷά μοι ἐγένετο ἐν Ἀντιοχείᾳ, ἐν Ἰκονίῳ, ἐν Λύστροις, οἵους διωγμοὺς ὑπήνεγκα· καὶ ἐκ πάντων με ἐρρύσατο ὁ κύριος."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "καὶ πάντες δὲ οἱ θέλοντες ⸂ζῆν εὐσεβῶς",
          {
            "noteId": 18
          },
          "ἐν Χριστῷ Ἰησοῦ διωχθήσονται·"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "πονηροὶ δὲ ἄνθρωποι καὶ γόητες προκόψουσιν ἐπὶ τὸ χεῖρον, πλανῶντες καὶ πλανώμενοι."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "σὺ δὲ μένε ἐν οἷς ἔμαθες καὶ ἐπιστώθης, εἰδὼς παρὰ ⸀τίνων",
          {
            "noteId": 19
          },
          "ἔμαθες,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ ὅτι ἀπὸ βρέφους ⸀ἱερὰ",
          {
            "noteId": 20
          },
          "γράμματα οἶδας, τὰ δυνάμενά σε σοφίσαι εἰς σωτηρίαν διὰ πίστεως τῆς ἐν Χριστῷ Ἰησοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "πᾶσα γραφὴ θεόπνευστος καὶ ὠφέλιμος πρὸς διδασκαλίαν, πρὸς ⸀ἐλεγμόν",
          {
            "noteId": 21
          },
          "πρὸς ἐπανόρθωσιν, πρὸς παιδείαν τὴν ἐν δικαιοσύνῃ,"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ἵνα ἄρτιος ᾖ ὁ τοῦ θεοῦ ἄνθρωπος, πρὸς πᾶν ἔργον ἀγαθὸν ἐξηρτισμένος."
        ]
      }
    ],
