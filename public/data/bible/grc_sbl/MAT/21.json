  "chapter": {
    "number": 21,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ ὅτε ἤγγισαν εἰς",
          {
            "noteId": 519
          },
          "Ἱεροσόλυμα καὶ ἦλθον εἰς Βηθφαγὴ ⸀εἰς τὸ Ὄρος τῶν Ἐλαιῶν, τότε ⸀Ἰησοῦς",
          {
            "noteId": 520
          },
          "ἀπέστειλεν δύο μαθητὰς"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "λέγων αὐτοῖς· ⸀Πορεύεσθε",
          {
            "noteId": 521
          },
          "εἰς τὴν κώμην τὴν ⸀κατέναντι",
          {
            "noteId": 522
          },
          "ὑμῶν, καὶ ⸀εὐθέως",
          {
            "noteId": 523
          },
          "εὑρήσετε ὄνον δεδεμένην καὶ πῶλον μετʼ αὐτῆς· λύσαντες ⸀ἀγάγετέ",
          {
            "noteId": 524
          },
          "μοι."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ ἐάν τις ὑμῖν εἴπῃ τι, ἐρεῖτε ὅτι Ὁ κύριος αὐτῶν χρείαν ἔχει· ⸀εὐθὺς",
          {
            "noteId": 525
          },
          "δὲ ⸀ἀποστελεῖ",
          {
            "noteId": 526
          },
          "αὐτούς."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Τοῦτο ⸀δὲ",
          {
            "noteId": 527
          },
          "γέγονεν ἵνα πληρωθῇ τὸ ῥηθὲν διὰ τοῦ προφήτου λέγοντος·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Εἴπατε τῇ θυγατρὶ Σιών· Ἰδοὺ ὁ βασιλεύς σου ἔρχεταί σοι πραῢς καὶ ἐπιβεβηκὼς ἐπὶ",
          {
            "noteId": 528
          },
          "ὄνον καὶ ⸀ἐπὶ πῶλον υἱὸν ὑποζυγίου."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "πορευθέντες δὲ οἱ μαθηταὶ καὶ ποιήσαντες καθὼς ⸀συνέταξεν",
          {
            "noteId": 529
          },
          "αὐτοῖς ὁ Ἰησοῦς"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἤγαγον τὴν ὄνον καὶ τὸν πῶλον, καὶ ἐπέθηκαν ⸀ἐπʼ",
          {
            "noteId": 530
          },
          "αὐτῶν τὰ ⸀ἱμάτια",
          {
            "noteId": 531
          },
          "καὶ ἐπεκάθισεν ἐπάνω αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ὁ δὲ πλεῖστος ὄχλος ἔστρωσαν ἑαυτῶν τὰ ἱμάτια ἐν τῇ ὁδῷ, ἄλλοι δὲ ἔκοπτον κλάδους ἀπὸ τῶν δένδρων καὶ ἐστρώννυον ἐν τῇ ὁδῷ."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "οἱ δὲ ὄχλοι οἱ προάγοντες ⸀αὐτὸν",
          {
            "noteId": 532
          },
          "καὶ οἱ ἀκολουθοῦντες ἔκραζον λέγοντες· Ὡσαννὰ τῷ υἱῷ Δαυίδ· Εὐλογημένος ὁ ἐρχόμενος ἐν ὀνόματι κυρίου· Ὡσαννὰ ἐν τοῖς ὑψίστοις."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ εἰσελθόντος αὐτοῦ εἰς Ἱεροσόλυμα ἐσείσθη πᾶσα ἡ πόλις λέγουσα· Τίς ἐστιν οὗτος;"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "οἱ δὲ ὄχλοι ἔλεγον· Οὗτός ἐστιν ⸂ὁ προφήτης Ἰησοῦς",
          {
            "noteId": 533
          },
          "ὁ ἀπὸ Ναζαρὲθ τῆς Γαλιλαίας."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Καὶ εἰσῆλθεν ⸀Ἰησοῦς",
          {
            "noteId": 534
          },
          "εἰς τὸ ⸀ἱερόν",
          {
            "noteId": 535
          },
          "καὶ ἐξέβαλεν πάντας τοὺς πωλοῦντας καὶ ἀγοράζοντας ἐν τῷ ἱερῷ καὶ τὰς τραπέζας τῶν κολλυβιστῶν κατέστρεψεν καὶ τὰς καθέδρας τῶν πωλούντων τὰς περιστεράς,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ λέγει αὐτοῖς· Γέγραπται· Ὁ οἶκός μου οἶκος προσευχῆς κληθήσεται, ὑμεῖς δὲ αὐτὸν ⸀ποιεῖτε",
          {
            "noteId": 536
          },
          "σπήλαιον λῃστῶν."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Καὶ προσῆλθον αὐτῷ ⸂τυφλοὶ καὶ χωλοὶ",
          {
            "noteId": 537
          },
          "ἐν τῷ ἱερῷ, καὶ ἐθεράπευσεν αὐτούς."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ἰδόντες δὲ οἱ ἀρχιερεῖς καὶ οἱ γραμματεῖς τὰ θαυμάσια ἃ ἐποίησεν καὶ τοὺς",
          {
            "noteId": 538
          },
          "παῖδας ⸀τοὺς κράζοντας ἐν τῷ ἱερῷ καὶ λέγοντας· Ὡσαννὰ τῷ υἱῷ Δαυίδ, ἠγανάκτησαν"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ εἶπαν αὐτῷ· Ἀκούεις τί οὗτοι λέγουσιν; ὁ δὲ Ἰησοῦς λέγει αὐτοῖς· Ναί. οὐδέποτε ἀνέγνωτε ὅτι Ἐκ στόματος νηπίων καὶ θηλαζόντων κατηρτίσω αἶνον;"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καὶ καταλιπὼν αὐτοὺς ἐξῆλθεν ἔξω τῆς πόλεως εἰς Βηθανίαν, καὶ ηὐλίσθη ἐκεῖ."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "⸀Πρωῒ",
          {
            "noteId": 539
          },
          "δὲ ⸀ἐπανάγων",
          {
            "noteId": 540
          },
          "εἰς τὴν πόλιν ἐπείνασεν."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "καὶ ἰδὼν συκῆν μίαν ἐπὶ τῆς ὁδοῦ ἦλθεν ἐπʼ αὐτήν, καὶ οὐδὲν εὗρεν ἐν αὐτῇ εἰ μὴ φύλλα μόνον, καὶ λέγει αὐτῇ· ⸀Μηκέτι",
          {
            "noteId": 541
          },
          "ἐκ σοῦ καρπὸς γένηται εἰς τὸν αἰῶνα· καὶ ἐξηράνθη παραχρῆμα ἡ συκῆ."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "καὶ ἰδόντες οἱ μαθηταὶ ἐθαύμασαν λέγοντες· Πῶς παραχρῆμα ἐξηράνθη ἡ συκῆ;"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ἀποκριθεὶς δὲ ὁ Ἰησοῦς εἶπεν αὐτοῖς· Ἀμὴν λέγω ὑμῖν, ἐὰν ἔχητε πίστιν καὶ μὴ διακριθῆτε, οὐ μόνον τὸ τῆς συκῆς ποιήσετε, ἀλλὰ κἂν τῷ ὄρει τούτῳ εἴπητε· Ἄρθητι καὶ βλήθητι εἰς τὴν θάλασσαν, γενήσεται·"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "καὶ πάντα ὅσα ⸀ἂν",
          {
            "noteId": 542
          },
          "αἰτήσητε ἐν τῇ προσευχῇ πιστεύοντες λήμψεσθε."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Καὶ ⸂ἐλθόντος αὐτοῦ",
          {
            "noteId": 543
          },
          "εἰς τὸ ἱερὸν προσῆλθον αὐτῷ διδάσκοντι οἱ ἀρχιερεῖς καὶ οἱ πρεσβύτεροι τοῦ λαοῦ λέγοντες· Ἐν ποίᾳ ἐξουσίᾳ ταῦτα ποιεῖς; καὶ τίς σοι ἔδωκεν τὴν ἐξουσίαν ταύτην;"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ἀποκριθεὶς δὲ ὁ Ἰησοῦς εἶπεν αὐτοῖς· Ἐρωτήσω ὑμᾶς κἀγὼ λόγον ἕνα, ὃν ἐὰν εἴπητέ μοι κἀγὼ ὑμῖν ἐρῶ ἐν ποίᾳ ἐξουσίᾳ ταῦτα ποιῶ·"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "τὸ",
          {
            "noteId": 544
          },
          "βάπτισμα ⸀τὸ Ἰωάννου πόθεν ἦν; ἐξ οὐρανοῦ ἢ ἐξ ἀνθρώπων; οἱ δὲ διελογίζοντο ⸀ἐν",
          {
            "noteId": 545
          },
          "ἑαυτοῖς λέγοντες· Ἐὰν εἴπωμεν· Ἐξ οὐρανοῦ, ἐρεῖ ἡμῖν· Διὰ τί οὖν οὐκ ἐπιστεύσατε αὐτῷ;"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ἐὰν δὲ εἴπωμεν· Ἐξ ἀνθρώπων, φοβούμεθα τὸν ὄχλον, πάντες γὰρ ⸂ὡς προφήτην ἔχουσιν τὸν Ἰωάννην",
          {
            "noteId": 546
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "καὶ ἀποκριθέντες τῷ Ἰησοῦ εἶπαν· Οὐκ οἴδαμεν. ἔφη αὐτοῖς καὶ αὐτός· Οὐδὲ ἐγὼ λέγω ὑμῖν ἐν ποίᾳ ἐξουσίᾳ ταῦτα ποιῶ."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Τί δὲ ὑμῖν δοκεῖ; ἄνθρωπος εἶχεν τέκνα δύο. ⸀προσελθὼν",
          {
            "noteId": 547
          },
          "τῷ πρώτῳ εἶπεν· Τέκνον, ὕπαγε σήμερον ἐργάζου ἐν τῷ ⸀ἀμπελῶνι",
          {
            "noteId": 548
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "ὁ δὲ ἀποκριθεὶς εἶπεν· ⸂Οὐ θέλω· ὕστερον δὲ μεταμεληθεὶς⸃ ἀπῆλθεν.",
          {
            "noteId": 549
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "⸂προσελθὼν δὲ",
          {
            "noteId": 550
          },
          "τῷ ⸀δευτέρῳ",
          {
            "noteId": 551
          },
          "εἶπεν ὡσαύτως· ὁ δὲ ἀποκριθεὶς εἶπεν· ⸂Ἐγώ, κύριε· καὶ οὐκ⸃ ἀπῆλθεν.",
          {
            "noteId": 552
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "τίς ἐκ τῶν δύο ἐποίησεν τὸ θέλημα τοῦ πατρός; ⸀λέγουσιν",
          {
            "noteId": 553
          },
          "Ὁ ⸀πρῶτος",
          {
            "noteId": 554
          },
          "λέγει αὐτοῖς ὁ Ἰησοῦς· Ἀμὴν λέγω ὑμῖν ὅτι οἱ τελῶναι καὶ αἱ πόρναι προάγουσιν ὑμᾶς εἰς τὴν βασιλείαν τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "ἦλθεν γὰρ ⸂Ἰωάννης πρὸς ὑμᾶς",
          {
            "noteId": 555
          },
          "ἐν ὁδῷ δικαιοσύνης, καὶ οὐκ ἐπιστεύσατε αὐτῷ· οἱ δὲ τελῶναι καὶ αἱ πόρναι ἐπίστευσαν αὐτῷ· ὑμεῖς δὲ ἰδόντες ⸀οὐδὲ",
          {
            "noteId": 556
          },
          "μετεμελήθητε ὕστερον τοῦ πιστεῦσαι αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "Ἄλλην παραβολὴν ἀκούσατε. ⸀Ἄνθρωπος",
          {
            "noteId": 557
          },
          "ἦν οἰκοδεσπότης ὅστις ἐφύτευσεν ἀμπελῶνα καὶ φραγμὸν αὐτῷ περιέθηκεν καὶ ὤρυξεν ἐν αὐτῷ ληνὸν καὶ ᾠκοδόμησεν πύργον, καὶ ἐξέδετο αὐτὸν γεωργοῖς, καὶ ἀπεδήμησεν."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "ὅτε δὲ ἤγγισεν ὁ καιρὸς τῶν καρπῶν, ἀπέστειλεν τοὺς δούλους αὐτοῦ πρὸς τοὺς γεωργοὺς λαβεῖν τοὺς καρποὺς αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "καὶ λαβόντες οἱ γεωργοὶ τοὺς δούλους αὐτοῦ ὃν μὲν ἔδειραν, ὃν δὲ ἀπέκτειναν, ὃν δὲ ἐλιθοβόλησαν."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "πάλιν ἀπέστειλεν ἄλλους δούλους πλείονας τῶν πρώτων, καὶ ἐποίησαν αὐτοῖς ὡσαύτως."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "ὕστερον δὲ ἀπέστειλεν πρὸς αὐτοὺς τὸν υἱὸν αὐτοῦ λέγων· Ἐντραπήσονται τὸν υἱόν μου."
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "οἱ δὲ γεωργοὶ ἰδόντες τὸν υἱὸν εἶπον ἐν ἑαυτοῖς· Οὗτός ἐστιν ὁ κληρονόμος· δεῦτε ἀποκτείνωμεν αὐτὸν καὶ ⸀σχῶμεν",
          {
            "noteId": 558
          },
          "τὴν κληρονομίαν αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "καὶ λαβόντες αὐτὸν ἐξέβαλον ἔξω τοῦ ἀμπελῶνος καὶ ἀπέκτειναν."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "ὅταν οὖν ἔλθῃ ὁ κύριος τοῦ ἀμπελῶνος, τί ποιήσει τοῖς γεωργοῖς ἐκείνοις;"
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "λέγουσιν αὐτῷ· Κακοὺς κακῶς ἀπολέσει αὐτούς, καὶ τὸν ἀμπελῶνα ἐκδώσεται ἄλλοις γεωργοῖς, οἵτινες ἀποδώσουσιν αὐτῷ τοὺς καρποὺς ἐν τοῖς καιροῖς αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "Λέγει αὐτοῖς ὁ Ἰησοῦς· Οὐδέποτε ἀνέγνωτε ἐν ταῖς γραφαῖς· Λίθον ὃν ἀπεδοκίμασαν οἱ οἰκοδομοῦντες οὗτος ἐγενήθη εἰς κεφαλὴν γωνίας· παρὰ κυρίου ἐγένετο αὕτη, καὶ ἔστιν θαυμαστὴ ἐν ὀφθαλμοῖς ἡμῶν;"
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "διὰ τοῦτο λέγω ὑμῖν ὅτι ἀρθήσεται ἀφʼ ὑμῶν ἡ βασιλεία τοῦ θεοῦ καὶ δοθήσεται ἔθνει ποιοῦντι τοὺς καρποὺς αὐτῆς."
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "⸂Καὶ ὁ πεσὼν ἐπὶ τὸν λίθον τοῦτον συνθλασθήσεται· ἐφʼ ὃν δʼ ἂν πέσῃ λικμήσει αὐτόν.",
          {
            "noteId": 559
          }
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "Καὶ ἀκούσαντες οἱ ἀρχιερεῖς καὶ οἱ Φαρισαῖοι τὰς παραβολὰς αὐτοῦ ἔγνωσαν ὅτι περὶ αὐτῶν λέγει·"
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "καὶ ζητοῦντες αὐτὸν κρατῆσαι ἐφοβήθησαν τοὺς ὄχλους, ⸂ἐπεὶ εἰς",
          {
            "noteId": 560
          },
          "προφήτην αὐτὸν εἶχον."
        ]
      }
    ],
