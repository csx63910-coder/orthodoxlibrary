  "chapter": {
    "number": 17,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ μεθʼ ἡμέρας ἓξ παραλαμβάνει ὁ Ἰησοῦς τὸν Πέτρον καὶ Ἰάκωβον καὶ Ἰωάννην τὸν ἀδελφὸν αὐτοῦ, καὶ ἀναφέρει αὐτοὺς εἰς ὄρος ὑψηλὸν κατʼ ἰδίαν."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ μετεμορφώθη ἔμπροσθεν αὐτῶν, καὶ ἔλαμψεν τὸ πρόσωπον αὐτοῦ ὡς ὁ ἥλιος, τὰ δὲ ἱμάτια αὐτοῦ ⸀ἐγένετο",
          {
            "noteId": 377
          },
          "λευκὰ ὡς τὸ φῶς."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ ἰδοὺ ⸀ὤφθη",
          {
            "noteId": 378
          },
          "αὐτοῖς Μωϋσῆς καὶ Ἠλίας ⸂συλλαλοῦντες μετʼ αὐτοῦ⸃.",
          {
            "noteId": 379
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἀποκριθεὶς δὲ ὁ Πέτρος εἶπεν τῷ Ἰησοῦ· Κύριε, καλόν ἐστιν ἡμᾶς ὧδε εἶναι· εἰ θέλεις, ⸀ποιήσω",
          {
            "noteId": 380
          },
          "ὧδε τρεῖς σκηνάς, σοὶ μίαν καὶ Μωϋσεῖ μίαν καὶ ⸂Ἠλίᾳ μίαν",
          {
            "noteId": 381
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἔτι αὐτοῦ λαλοῦντος ἰδοὺ νεφέλη φωτεινὴ ἐπεσκίασεν αὐτούς, καὶ ἰδοὺ φωνὴ ἐκ τῆς νεφέλης λέγουσα· Οὗτός ἐστιν ὁ υἱός μου ὁ ἀγαπητός, ἐν ᾧ εὐδόκησα· ⸂ἀκούετε αὐτοῦ",
          {
            "noteId": 382
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ ἀκούσαντες οἱ μαθηταὶ ἔπεσαν ἐπὶ πρόσωπον αὐτῶν καὶ ἐφοβήθησαν σφόδρα."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "καὶ ⸂προσῆλθεν ὁ Ἰησοῦς καὶ ἁψάμενος αὐτῶν",
          {
            "noteId": 383
          },
          "εἶπεν· Ἐγέρθητε καὶ μὴ φοβεῖσθε."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἐπάραντες δὲ τοὺς ὀφθαλμοὺς αὐτῶν οὐδένα εἶδον εἰ μὴ ⸀αὐτὸν",
          {
            "noteId": 384
          },
          "Ἰησοῦν μόνον."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Καὶ καταβαινόντων αὐτῶν ἐκ τοῦ ὄρους ἐνετείλατο αὐτοῖς ὁ Ἰησοῦς λέγων· Μηδενὶ εἴπητε τὸ ὅραμα ἕως οὗ ὁ υἱὸς τοῦ ἀνθρώπου ἐκ νεκρῶν ⸀ἐγερθῇ",
          {
            "noteId": 385
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ ἐπηρώτησαν αὐτὸν οἱ ⸀μαθηταὶ",
          {
            "noteId": 386
          },
          "λέγοντες· Τί οὖν οἱ γραμματεῖς λέγουσιν ὅτι Ἠλίαν δεῖ ἐλθεῖν πρῶτον;"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ὁ ⸀δὲ",
          {
            "noteId": 387
          },
          "ἀποκριθεὶς ⸀εἶπεν",
          {
            "noteId": 388
          },
          "Ἠλίας μὲν ⸀ἔρχεται",
          {
            "noteId": 389
          },
          "καὶ ἀποκαταστήσει πάντα·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "λέγω δὲ ὑμῖν ὅτι Ἠλίας ἤδη ἦλθεν, καὶ οὐκ ἐπέγνωσαν αὐτὸν ἀλλὰ ἐποίησαν ἐν αὐτῷ ὅσα ἠθέλησαν· οὕτως καὶ ὁ υἱὸς τοῦ ἀνθρώπου μέλλει πάσχειν ὑπʼ αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "τότε συνῆκαν οἱ μαθηταὶ ὅτι περὶ Ἰωάννου τοῦ βαπτιστοῦ εἶπεν αὐτοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Καὶ ⸀ἐλθόντων",
          {
            "noteId": 390
          },
          "πρὸς τὸν ὄχλον προσῆλθεν αὐτῷ ἄνθρωπος γονυπετῶν αὐτὸν"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ λέγων· Κύριε, ἐλέησόν μου τὸν υἱόν, ὅτι σεληνιάζεται καὶ κακῶς ⸀πάσχει",
          {
            "noteId": 391
          },
          "πολλάκις γὰρ πίπτει εἰς τὸ πῦρ καὶ πολλάκις εἰς τὸ ὕδωρ."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ προσήνεγκα αὐτὸν τοῖς μαθηταῖς σου, καὶ οὐκ ἠδυνήθησαν αὐτὸν θεραπεῦσαι."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ἀποκριθεὶς δὲ ὁ Ἰησοῦς εἶπεν· Ὦ γενεὰ ἄπιστος καὶ διεστραμμένη, ἕως πότε ⸂μεθʼ ὑμῶν ἔσομαι",
          {
            "noteId": 392
          },
          "; ἕως πότε ἀνέξομαι ὑμῶν; φέρετέ μοι αὐτὸν ὧδε."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ ἐπετίμησεν αὐτῷ ὁ Ἰησοῦς, καὶ ἐξῆλθεν ἀπʼ αὐτοῦ τὸ δαιμόνιον· καὶ ἐθεραπεύθη ὁ παῖς ἀπὸ τῆς ὥρας ἐκείνης."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Τότε προσελθόντες οἱ μαθηταὶ τῷ Ἰησοῦ κατʼ ἰδίαν εἶπον· Διὰ τί ἡμεῖς οὐκ ἠδυνήθημεν ἐκβαλεῖν αὐτό;"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ὁ δὲ ⸀λέγει",
          {
            "noteId": 393
          },
          "αὐτοῖς· Διὰ τὴν ⸀ὀλιγοπιστίαν",
          {
            "noteId": 394
          },
          "ὑμῶν· ἀμὴν γὰρ λέγω ὑμῖν, ἐὰν ἔχητε πίστιν ὡς κόκκον σινάπεως, ἐρεῖτε τῷ ὄρει τούτῳ· ⸂Μετάβα ἔνθεν",
          {
            "noteId": 395
          },
          "ἐκεῖ, καὶ μεταβήσεται, καὶ οὐδὲν ἀδυνατήσει ⸀ὑμῖν",
          {
            "noteId": 396
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "⸀Συστρεφομένων",
          {
            "noteId": 397
          },
          "δὲ αὐτῶν ἐν τῇ Γαλιλαίᾳ εἶπεν αὐτοῖς ὁ Ἰησοῦς· Μέλλει ὁ υἱὸς τοῦ ἀνθρώπου παραδίδοσθαι εἰς χεῖρας ἀνθρώπων,"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "καὶ ἀποκτενοῦσιν αὐτόν, καὶ τῇ τρίτῃ ἡμέρᾳ ἐγερθήσεται. καὶ ἐλυπήθησαν σφόδρα."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Ἐλθόντων δὲ αὐτῶν εἰς Καφαρναοὺμ προσῆλθον οἱ τὰ δίδραχμα λαμβάνοντες τῷ Πέτρῳ καὶ εἶπαν· Ὁ διδάσκαλος ὑμῶν οὐ τελεῖ τὰ δίδραχμα;"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "λέγει· Ναί. καὶ ⸀ἐλθόντα",
          {
            "noteId": 398
          },
          "εἰς τὴν οἰκίαν προέφθασεν αὐτὸν ὁ Ἰησοῦς λέγων· Τί σοι δοκεῖ, Σίμων; οἱ βασιλεῖς τῆς γῆς ἀπὸ τίνων λαμβάνουσιν τέλη ἢ κῆνσον; ἀπὸ τῶν υἱῶν αὐτῶν ἢ ἀπὸ τῶν ἀλλοτρίων;"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "⸂εἰπόντος δέ",
          {
            "noteId": 399
          },
          "· Ἀπὸ τῶν ἀλλοτρίων, ἔφη αὐτῷ ὁ Ἰησοῦς· Ἄρα γε ἐλεύθεροί εἰσιν οἱ υἱοί."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "ἵνα δὲ μὴ σκανδαλίσωμεν αὐτούς, πορευθεὶς ⸀εἰς",
          {
            "noteId": 400
          },
          "θάλασσαν βάλε ἄγκιστρον καὶ τὸν ⸀ἀναβάντα",
          {
            "noteId": 401
          },
          "πρῶτον ἰχθὺν ἆρον, καὶ ἀνοίξας τὸ στόμα αὐτοῦ εὑρήσεις στατῆρα· ἐκεῖνον λαβὼν δὸς αὐτοῖς ἀντὶ ἐμοῦ καὶ σοῦ."
        ]
      }
    ],
