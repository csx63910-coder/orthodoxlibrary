  "chapter": {
    "number": 27,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Πρωΐας δὲ γενομένης συμβούλιον ἔλαβον πάντες οἱ ἀρχιερεῖς καὶ οἱ πρεσβύτεροι τοῦ λαοῦ κατὰ τοῦ Ἰησοῦ ὥστε θανατῶσαι αὐτόν·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ δήσαντες αὐτὸν ἀπήγαγον καὶ ⸀παρέδωκαν",
          {
            "noteId": 760
          },
          "Πιλάτῳ τῷ ἡγεμόνι."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Τότε ἰδὼν Ἰούδας ὁ ⸀παραδιδοὺς",
          {
            "noteId": 761
          },
          "αὐτὸν ὅτι κατεκρίθη μεταμεληθεὶς ⸀ἔστρεψεν",
          {
            "noteId": 762
          },
          "τὰ τριάκοντα ἀργύρια τοῖς ἀρχιερεῦσιν ⸀καὶ",
          {
            "noteId": 763
          },
          "πρεσβυτέροις"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "λέγων· Ἥμαρτον παραδοὺς αἷμα ⸀ἀθῷον",
          {
            "noteId": 764
          },
          "οἱ δὲ εἶπαν· Τί πρὸς ἡμᾶς; σὺ ⸀ὄψῃ",
          {
            "noteId": 765
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ ῥίψας τὰ ἀργύρια ⸂εἰς τὸν ναὸν",
          {
            "noteId": 766
          },
          "ἀνεχώρησεν, καὶ ἀπελθὼν ἀπήγξατο."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "οἱ δὲ ἀρχιερεῖς λαβόντες τὰ ἀργύρια εἶπαν· Οὐκ ἔξεστιν βαλεῖν αὐτὰ εἰς τὸν κορβανᾶν, ἐπεὶ τιμὴ αἵματός ἐστιν·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "συμβούλιον δὲ λαβόντες ἠγόρασαν ἐξ αὐτῶν τὸν Ἀγρὸν τοῦ Κεραμέως εἰς ταφὴν τοῖς ξένοις."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "διὸ ἐκλήθη ὁ ἀγρὸς ἐκεῖνος Ἀγρὸς Αἵματος ἕως τῆς σήμερον."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "τότε ἐπληρώθη τὸ ῥηθὲν διὰ Ἰερεμίου τοῦ προφήτου λέγοντος· Καὶ ἔλαβον τὰ τριάκοντα ἀργύρια, τὴν τιμὴν τοῦ τετιμημένου ὃν ἐτιμήσαντο ἀπὸ υἱῶν Ἰσραήλ,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ ἔδωκαν αὐτὰ εἰς τὸν ἀγρὸν τοῦ κεραμέως, καθὰ συνέταξέν μοι κύριος."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ὁ δὲ Ἰησοῦς ⸀ἐστάθη",
          {
            "noteId": 767
          },
          "ἔμπροσθεν τοῦ ἡγεμόνος· καὶ ἐπηρώτησεν αὐτὸν ὁ ἡγεμὼν λέγων· Σὺ εἶ ὁ βασιλεὺς τῶν Ἰουδαίων; ὁ δὲ Ἰησοῦς ⸀ἔφη",
          {
            "noteId": 768
          },
          "Σὺ λέγεις."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "καὶ",
          {
            "noteId": 769
          },
          "ἐν τῷ κατηγορεῖσθαι αὐτὸν ὑπὸ τῶν ἀρχιερέων ⸀καὶ πρεσβυτέρων οὐδὲν ἀπεκρίνατο."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "τότε λέγει αὐτῷ ὁ Πιλᾶτος· Οὐκ ἀκούεις πόσα σου καταμαρτυροῦσιν;"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καὶ οὐκ ἀπεκρίθη αὐτῷ πρὸς οὐδὲ ἓν ῥῆμα, ὥστε θαυμάζειν τὸν ἡγεμόνα λίαν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Κατὰ δὲ ἑορτὴν εἰώθει ὁ ἡγεμὼν ἀπολύειν ἕνα τῷ ὄχλῳ δέσμιον ὃν ἤθελον."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "εἶχον δὲ τότε δέσμιον ἐπίσημον λεγόμενον ⸀Ἰησοῦν",
          {
            "noteId": 770
          },
          "Βαραββᾶν."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "συνηγμένων οὖν αὐτῶν εἶπεν αὐτοῖς ὁ Πιλᾶτος· Τίνα θέλετε ἀπολύσω ὑμῖν, ⸂Ἰησοῦν τὸν",
          {
            "noteId": 771
          },
          "Βαραββᾶν ἢ Ἰησοῦν τὸν λεγόμενον χριστόν;"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ᾔδει γὰρ ὅτι διὰ φθόνον παρέδωκαν αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Καθημένου δὲ αὐτοῦ ἐπὶ τοῦ βήματος ἀπέστειλεν πρὸς αὐτὸν ἡ γυνὴ αὐτοῦ λέγουσα· Μηδὲν σοὶ καὶ τῷ δικαίῳ ἐκείνῳ, πολλὰ γὰρ ἔπαθον σήμερον κατʼ ὄναρ διʼ αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Οἱ δὲ ἀρχιερεῖς καὶ οἱ πρεσβύτεροι ἔπεισαν τοὺς ὄχλους ἵνα αἰτήσωνται τὸν Βαραββᾶν τὸν δὲ Ἰησοῦν ἀπολέσωσιν."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ἀποκριθεὶς δὲ ὁ ἡγεμὼν εἶπεν αὐτοῖς· Τίνα θέλετε ἀπὸ τῶν δύο ἀπολύσω ὑμῖν; οἱ δὲ εἶπαν· ⸀Τὸν",
          {
            "noteId": 772
          },
          "Βαραββᾶν."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "λέγει αὐτοῖς ὁ Πιλᾶτος· Τί οὖν ποιήσω Ἰησοῦν τὸν λεγόμενον χριστόν; ⸀λέγουσιν",
          {
            "noteId": 773
          },
          "πάντες· Σταυρωθήτω."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ὁ ⸀δὲ",
          {
            "noteId": 774
          },
          "ἔφη· Τί γὰρ κακὸν ἐποίησεν; οἱ δὲ περισσῶς ἔκραζον λέγοντες· Σταυρωθήτω."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Ἰδὼν δὲ ὁ Πιλᾶτος ὅτι οὐδὲν ὠφελεῖ ἀλλὰ μᾶλλον θόρυβος γίνεται λαβὼν ὕδωρ ἀπενίψατο τὰς χεῖρας ⸀ἀπέναντι",
          {
            "noteId": 775
          },
          "τοῦ ὄχλου λέγων· Ἀθῷός εἰμι ἀπὸ τοῦ ⸀αἵματος",
          {
            "noteId": 776
          },
          "τούτου· ὑμεῖς ὄψεσθε."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "καὶ ἀποκριθεὶς πᾶς ὁ λαὸς εἶπεν· Τὸ αἷμα αὐτοῦ ἐφʼ ἡμᾶς καὶ ἐπὶ τὰ τέκνα ἡμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "τότε ἀπέλυσεν αὐτοῖς τὸν Βαραββᾶν, τὸν δὲ Ἰησοῦν φραγελλώσας παρέδωκεν ἵνα σταυρωθῇ."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Τότε οἱ στρατιῶται τοῦ ἡγεμόνος παραλαβόντες τὸν Ἰησοῦν εἰς τὸ πραιτώριον συνήγαγον ἐπʼ αὐτὸν ὅλην τὴν σπεῖραν."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "καὶ ἐκδύσαντες αὐτὸν ⸂χλαμύδα κοκκίνην περιέθηκαν αὐτῷ",
          {
            "noteId": 777
          },
          ","
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "καὶ πλέξαντες στέφανον ἐξ ἀκανθῶν ἐπέθηκαν ἐπὶ ⸂τῆς κεφαλῆς",
          {
            "noteId": 778
          },
          "αὐτοῦ καὶ κάλαμον ⸂ἐν τῇ δεξιᾷ",
          {
            "noteId": 779
          },
          "αὐτοῦ, καὶ γονυπετήσαντες ἔμπροσθεν αὐτοῦ ⸀ἐνέπαιξαν",
          {
            "noteId": 780
          },
          "αὐτῷ λέγοντες· Χαῖρε, ⸀βασιλεῦ",
          {
            "noteId": 781
          },
          "τῶν Ἰουδαίων,"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "καὶ ἐμπτύσαντες εἰς αὐτὸν ἔλαβον τὸν κάλαμον καὶ ἔτυπτον εἰς τὴν κεφαλὴν αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "καὶ ὅτε ἐνέπαιξαν αὐτῷ, ἐξέδυσαν αὐτὸν τὴν χλαμύδα καὶ ἐνέδυσαν αὐτὸν τὰ ἱμάτια αὐτοῦ καὶ ἀπήγαγον αὐτὸν εἰς τὸ σταυρῶσαι."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Ἐξερχόμενοι δὲ εὗρον ἄνθρωπον Κυρηναῖον ὀνόματι Σίμωνα· τοῦτον ἠγγάρευσαν ἵνα ἄρῃ τὸν σταυρὸν αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "Καὶ ἐλθόντες εἰς τόπον λεγόμενον Γολγοθᾶ, ὅ ἐστιν ⸂Κρανίου Τόπος λεγόμενος",
          {
            "noteId": 782
          },
          ","
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "ἔδωκαν αὐτῷ πιεῖν ⸀οἶνον",
          {
            "noteId": 783
          },
          "μετὰ χολῆς μεμιγμένον· καὶ γευσάμενος οὐκ ⸀ἠθέλησεν",
          {
            "noteId": 784
          },
          "πιεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "σταυρώσαντες δὲ αὐτὸν διεμερίσαντο τὰ ἱμάτια αὐτοῦ βάλλοντες κλῆρον,"
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "καὶ καθήμενοι ἐτήρουν αὐτὸν ἐκεῖ."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "καὶ ἐπέθηκαν ἐπάνω τῆς κεφαλῆς αὐτοῦ τὴν αἰτίαν αὐτοῦ γεγραμμένην· Οὗτός ἐστιν Ἰησοῦς ὁ βασιλεὺς τῶν Ἰουδαίων."
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "Τότε σταυροῦνται σὺν αὐτῷ δύο λῃσταί, εἷς ἐκ δεξιῶν καὶ εἷς ἐξ εὐωνύμων."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "οἱ δὲ παραπορευόμενοι ἐβλασφήμουν αὐτὸν κινοῦντες τὰς κεφαλὰς αὐτῶν"
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "καὶ λέγοντες· Ὁ καταλύων τὸν ναὸν καὶ ἐν τρισὶν ἡμέραις οἰκοδομῶν, σῶσον σεαυτόν· εἰ υἱὸς εἶ τοῦ θεοῦ, ⸀κατάβηθι",
          {
            "noteId": 785
          },
          "ἀπὸ τοῦ σταυροῦ."
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "ὁμοίως ⸀καὶ",
          {
            "noteId": 786
          },
          "οἱ ἀρχιερεῖς ἐμπαίζοντες μετὰ τῶν γραμματέων καὶ ⸀πρεσβυτέρων",
          {
            "noteId": 787
          },
          "ἔλεγον·"
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "Ἄλλους ἔσωσεν, ἑαυτὸν οὐ δύναται σῶσαι· ⸀βασιλεὺς",
          {
            "noteId": 788
          },
          "Ἰσραήλ ἐστιν, καταβάτω νῦν ἀπὸ τοῦ σταυροῦ καὶ πιστεύσομεν ἐπʼ ⸀αὐτόν",
          {
            "noteId": 789
          }
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "πέποιθεν ἐπὶ τὸν θεόν, ῥυσάσθω ⸀νῦν",
          {
            "noteId": 790
          },
          "εἰ θέλει αὐτόν· εἶπεν γὰρ ὅτι Θεοῦ εἰμι υἱός."
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "τὸ δʼ αὐτὸ καὶ οἱ λῃσταὶ οἱ συσταυρωθέντες ⸀σὺν",
          {
            "noteId": 791
          },
          "αὐτῷ ὠνείδιζον αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "Ἀπὸ δὲ ἕκτης ὥρας σκότος ἐγένετο ἐπὶ πᾶσαν τὴν γῆν ἕως ὥρας ἐνάτης."
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "περὶ δὲ τὴν ἐνάτην ὥραν ⸀ἀνεβόησεν",
          {
            "noteId": 792
          },
          "ὁ Ἰησοῦς φωνῇ μεγάλῃ λέγων· ⸂Ἠλὶ ἠλὶ",
          {
            "noteId": 793
          },
          "λεμὰ σαβαχθάνι; τοῦτʼ ἔστιν· Θεέ μου θεέ μου, ἱνατί με ἐγκατέλιπες;"
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          "τινὲς δὲ τῶν ἐκεῖ ⸀ἑστηκότων",
          {
            "noteId": 794
          },
          "ἀκούσαντες ἔλεγον ὅτι Ἠλίαν φωνεῖ οὗτος."
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          "καὶ εὐθέως δραμὼν εἷς ἐξ αὐτῶν καὶ λαβὼν σπόγγον πλήσας τε ὄξους καὶ περιθεὶς καλάμῳ ἐπότιζεν αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          "οἱ δὲ λοιποὶ ⸀ἔλεγον",
          {
            "noteId": 795
          },
          "Ἄφες ἴδωμεν εἰ ἔρχεται Ἠλίας σώσων ⸀αὐτόν",
          {
            "noteId": 796
          }
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          "ὁ δὲ Ἰησοῦς πάλιν κράξας φωνῇ μεγάλῃ ἀφῆκεν τὸ πνεῦμα."
        ]
      },
      {
        "type": "verse",
        "number": 51,
        "content": [
          "καὶ ἰδοὺ τὸ καταπέτασμα τοῦ ναοῦ ἐσχίσθη ⸂ἀπʼ ἄνωθεν ἕως κάτω εἰς δύο",
          {
            "noteId": 797
          },
          ", καὶ ἡ γῆ ἐσείσθη, καὶ αἱ πέτραι ἐσχίσθησαν,"
        ]
      },
      {
        "type": "verse",
        "number": 52,
        "content": [
          "καὶ τὰ μνημεῖα ἀνεῴχθησαν καὶ πολλὰ σώματα τῶν κεκοιμημένων ἁγίων ⸀ἠγέρθησαν",
          {
            "noteId": 798
          }
        ]
      },
      {
        "type": "verse",
        "number": 53,
        "content": [
          "καὶ ἐξελθόντες ἐκ τῶν μνημείων μετὰ τὴν ἔγερσιν αὐτοῦ εἰσῆλθον εἰς τὴν ἁγίαν πόλιν καὶ ἐνεφανίσθησαν πολλοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 54,
        "content": [
          "Ὁ δὲ ἑκατόνταρχος καὶ οἱ μετʼ αὐτοῦ τηροῦντες τὸν Ἰησοῦν ἰδόντες τὸν σεισμὸν καὶ τὰ ⸀γενόμενα",
          {
            "noteId": 799
          },
          "ἐφοβήθησαν σφόδρα λέγοντες· Ἀληθῶς ⸂θεοῦ υἱὸς",
          {
            "noteId": 800
          },
          "ἦν οὗτος."
        ]
      },
      {
        "type": "verse",
        "number": 55,
        "content": [
          "Ἦσαν δὲ ἐκεῖ γυναῖκες πολλαὶ ἀπὸ μακρόθεν θεωροῦσαι, αἵτινες ἠκολούθησαν τῷ Ἰησοῦ ἀπὸ τῆς Γαλιλαίας διακονοῦσαι αὐτῷ·"
        ]
      },
      {
        "type": "verse",
        "number": 56,
        "content": [
          "ἐν αἷς ἦν Μαρία ἡ Μαγδαληνὴ καὶ Μαρία ἡ τοῦ Ἰακώβου καὶ ⸀Ἰωσὴφ",
          {
            "noteId": 801
          },
          "μήτηρ καὶ ἡ μήτηρ τῶν υἱῶν Ζεβεδαίου."
        ]
      },
      {
        "type": "verse",
        "number": 57,
        "content": [
          "Ὀψίας δὲ γενομένης ἦλθεν ἄνθρωπος πλούσιος ἀπὸ Ἁριμαθαίας, τοὔνομα Ἰωσήφ, ὃς καὶ αὐτὸς ⸀ἐμαθητεύθη",
          {
            "noteId": 802
          },
          "τῷ Ἰησοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 58,
        "content": [
          "οὗτος προσελθὼν τῷ Πιλάτῳ ᾐτήσατο τὸ σῶμα τοῦ Ἰησοῦ. τότε ὁ Πιλᾶτος ἐκέλευσεν ⸀ἀποδοθῆναι",
          {
            "noteId": 803
          }
        ]
      },
      {
        "type": "verse",
        "number": 59,
        "content": [
          "καὶ λαβὼν τὸ σῶμα ὁ Ἰωσὴφ ἐνετύλιξεν ⸀αὐτὸ",
          {
            "noteId": 804
          },
          "σινδόνι καθαρᾷ,"
        ]
      },
      {
        "type": "verse",
        "number": 60,
        "content": [
          "καὶ ἔθηκεν αὐτὸ ἐν τῷ καινῷ αὐτοῦ μνημείῳ ὃ ἐλατόμησεν ἐν τῇ πέτρᾳ, καὶ προσκυλίσας λίθον μέγαν τῇ θύρᾳ τοῦ μνημείου ἀπῆλθεν."
        ]
      },
      {
        "type": "verse",
        "number": 61,
        "content": [
          "ἦν δὲ ἐκεῖ ⸀Μαριὰμ",
          {
            "noteId": 805
          },
          "ἡ Μαγδαληνὴ καὶ ἡ ἄλλη Μαρία καθήμεναι ἀπέναντι τοῦ τάφου."
        ]
      },
      {
        "type": "verse",
        "number": 62,
        "content": [
          "Τῇ δὲ ἐπαύριον, ἥτις ἐστὶν μετὰ τὴν παρασκευήν, συνήχθησαν οἱ ἀρχιερεῖς καὶ οἱ Φαρισαῖοι πρὸς Πιλᾶτον"
        ]
      },
      {
        "type": "verse",
        "number": 63,
        "content": [
          "λέγοντες· Κύριε, ἐμνήσθημεν ὅτι ἐκεῖνος ὁ πλάνος εἶπεν ἔτι ζῶν· Μετὰ τρεῖς ἡμέρας ἐγείρομαι·"
        ]
      },
      {
        "type": "verse",
        "number": 64,
        "content": [
          "κέλευσον οὖν ἀσφαλισθῆναι τὸν τάφον ἕως τῆς τρίτης ἡμέρας, μήποτε ἐλθόντες οἱ μαθηταὶ ⸀αὐτοῦ",
          {
            "noteId": 806
          },
          "κλέψωσιν αὐτὸν καὶ εἴπωσιν τῷ λαῷ· Ἠγέρθη ἀπὸ τῶν νεκρῶν, καὶ ἔσται ἡ ἐσχάτη πλάνη χείρων τῆς πρώτης."
        ]
      },
      {
        "type": "verse",
        "number": 65,
        "content": [
          "⸀ἔφη",
          {
            "noteId": 807
          },
          "αὐτοῖς ὁ Πιλᾶτος· Ἔχετε κουστωδίαν· ὑπάγετε ἀσφαλίσασθε ὡς οἴδατε."
        ]
      },
      {
        "type": "verse",
        "number": 66,
        "content": [
          "οἱ δὲ πορευθέντες ἠσφαλίσαντο τὸν τάφον σφραγίσαντες τὸν λίθον μετὰ τῆς κουστωδίας."
        ]
      }
