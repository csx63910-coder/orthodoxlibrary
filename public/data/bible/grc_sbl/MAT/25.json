  "chapter": {
    "number": 25,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Τότε ὁμοιωθήσεται ἡ βασιλεία τῶν οὐρανῶν δέκα παρθένοις, αἵτινες λαβοῦσαι τὰς λαμπάδας ⸀ἑαυτῶν",
          {
            "noteId": 672
          },
          "ἐξῆλθον εἰς ⸀ὑπάντησιν",
          {
            "noteId": 673
          },
          "τοῦ νυμφίου."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "πέντε δὲ ⸂ἐξ αὐτῶν ἦσαν",
          {
            "noteId": 674
          },
          "⸂μωραὶ καὶ πέντε φρόνιμοι",
          {
            "noteId": 675
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "⸂αἱ γὰρ",
          {
            "noteId": 676
          },
          "μωραὶ λαβοῦσαι τὰς λαμπάδας αὐτῶν οὐκ ἔλαβον μεθʼ ἑαυτῶν ἔλαιον·"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "αἱ δὲ φρόνιμοι ἔλαβον ἔλαιον ἐν τοῖς ⸀ἀγγείοις",
          {
            "noteId": 677
          },
          "μετὰ τῶν λαμπάδων ⸀ἑαυτῶν",
          {
            "noteId": 678
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "χρονίζοντος δὲ τοῦ νυμφίου ἐνύσταξαν πᾶσαι καὶ ἐκάθευδον."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "μέσης δὲ νυκτὸς κραυγὴ γέγονεν· Ἰδοὺ ὁ ⸀νυμφίος",
          {
            "noteId": 679
          },
          "ἐξέρχεσθε εἰς ἀπάντησιν ⸀αὐτοῦ",
          {
            "noteId": 680
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "τότε ἠγέρθησαν πᾶσαι αἱ παρθένοι ἐκεῖναι καὶ ἐκόσμησαν τὰς λαμπάδας ⸀ἑαυτῶν",
          {
            "noteId": 681
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "αἱ δὲ μωραὶ ταῖς φρονίμοις εἶπαν· Δότε ἡμῖν ἐκ τοῦ ἐλαίου ὑμῶν, ὅτι αἱ λαμπάδες ἡμῶν σβέννυνται."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ἀπεκρίθησαν δὲ αἱ φρόνιμοι λέγουσαι· Μήποτε ⸂οὐ μὴ",
          {
            "noteId": 682
          },
          "ἀρκέσῃ ἡμῖν καὶ ὑμῖν· ⸀πορεύεσθε",
          {
            "noteId": 683
          },
          "μᾶλλον πρὸς τοὺς πωλοῦντας καὶ ἀγοράσατε ἑαυταῖς."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἀπερχομένων δὲ αὐτῶν ἀγοράσαι ἦλθεν ὁ νυμφίος, καὶ αἱ ἕτοιμοι εἰσῆλθον μετʼ αὐτοῦ εἰς τοὺς γάμους, καὶ ἐκλείσθη ἡ θύρα."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ὕστερον δὲ ἔρχονται καὶ αἱ λοιπαὶ παρθένοι λέγουσαι· Κύριε κύριε, ἄνοιξον ἡμῖν·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ὁ δὲ ἀποκριθεὶς εἶπεν· Ἀμὴν λέγω ὑμῖν, οὐκ οἶδα ὑμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "γρηγορεῖτε οὖν, ὅτι οὐκ οἴδατε τὴν ἡμέραν οὐδὲ τὴν ⸀ὥραν",
          {
            "noteId": 684
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Ὥσπερ γὰρ ἄνθρωπος ἀποδημῶν ἐκάλεσεν τοὺς ἰδίους δούλους καὶ παρέδωκεν αὐτοῖς τὰ ὑπάρχοντα αὐτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ ᾧ μὲν ἔδωκεν πέντε τάλαντα ᾧ δὲ δύο ᾧ δὲ ἕν, ἑκάστῳ κατὰ τὴν ἰδίαν δύναμιν, καὶ ἀπεδήμησεν. εὐθέως"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "⸀πορευθεὶς",
          {
            "noteId": 685
          },
          "ὁ τὰ πέντε τάλαντα λαβὼν ἠργάσατο ἐν αὐτοῖς καὶ ⸀ἐκέρδησεν",
          {
            "noteId": 686
          },
          "ἄλλα ⸀πέντε",
          {
            "noteId": 687
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "⸀ὡσαύτως",
          {
            "noteId": 688
          },
          "ὁ τὰ δύο ⸀ἐκέρδησεν",
          {
            "noteId": 689
          },
          "ἄλλα δύο·"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ὁ δὲ τὸ ἓν λαβὼν ἀπελθὼν ὤρυξεν ⸀γῆν",
          {
            "noteId": 690
          },
          "καὶ ⸀ἔκρυψεν",
          {
            "noteId": 691
          },
          "τὸ ἀργύριον τοῦ κυρίου αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "μετὰ δὲ ⸂πολὺν χρόνον",
          {
            "noteId": 692
          },
          "ἔρχεται ὁ κύριος τῶν δούλων ἐκείνων καὶ συναίρει ⸂λόγον μετʼ αὐτῶν",
          {
            "noteId": 693
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "καὶ προσελθὼν ὁ τὰ πέντε τάλαντα λαβὼν προσήνεγκεν ἄλλα πέντε τάλαντα λέγων· Κύριε, πέντε τάλαντά μοι παρέδωκας· ἴδε ἄλλα πέντε τάλαντα ⸀ἐκέρδησα",
          {
            "noteId": 694
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "⸀ἔφη",
          {
            "noteId": 695
          },
          "αὐτῷ ὁ κύριος αὐτοῦ· Εὖ, δοῦλε ἀγαθὲ καὶ πιστέ, ἐπὶ ὀλίγα ἦς πιστός, ἐπὶ πολλῶν σε καταστήσω· εἴσελθε εἰς τὴν χαρὰν τοῦ κυρίου σου."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "προσελθὼν ⸀δὲ",
          {
            "noteId": 696
          },
          "καὶ ὁ τὰ δύο ⸀τάλαντα",
          {
            "noteId": 697
          },
          "εἶπεν· Κύριε, δύο τάλαντά μοι παρέδωκας· ἴδε ἄλλα δύο τάλαντα ⸀ἐκέρδησα",
          {
            "noteId": 698
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ἔφη αὐτῷ ὁ κύριος αὐτοῦ· Εὖ, δοῦλε ἀγαθὲ καὶ πιστέ, ἐπὶ ὀλίγα ἦς πιστός, ἐπὶ πολλῶν σε καταστήσω· εἴσελθε εἰς τὴν χαρὰν τοῦ κυρίου σου."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "προσελθὼν δὲ καὶ ὁ τὸ ἓν τάλαντον εἰληφὼς εἶπεν· Κύριε, ἔγνων σε ὅτι σκληρὸς εἶ ἄνθρωπος, θερίζων ὅπου οὐκ ἔσπειρας καὶ συνάγων ὅθεν οὐ διεσκόρπισας·"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "καὶ φοβηθεὶς ἀπελθὼν ἔκρυψα τὸ τάλαντόν σου ἐν τῇ γῇ· ἴδε ἔχεις τὸ σόν."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ἀποκριθεὶς δὲ ὁ κύριος αὐτοῦ εἶπεν αὐτῷ· Πονηρὲ δοῦλε καὶ ὀκνηρέ, ᾔδεις ὅτι θερίζω ὅπου οὐκ ἔσπειρα καὶ συνάγω ὅθεν οὐ διεσκόρπισα;"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "ἔδει ⸂σε οὖν",
          {
            "noteId": 699
          },
          "βαλεῖν ⸂τὰ ἀργύριά",
          {
            "noteId": 700
          },
          "μου τοῖς τραπεζίταις, καὶ ἐλθὼν ἐγὼ ἐκομισάμην ἂν τὸ ἐμὸν σὺν τόκῳ."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ἄρατε οὖν ἀπʼ αὐτοῦ τὸ τάλαντον καὶ δότε τῷ ἔχοντι τὰ δέκα τάλαντα·"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "τῷ γὰρ ἔχοντι παντὶ δοθήσεται καὶ περισσευθήσεται· ⸂τοῦ δὲ",
          {
            "noteId": 701
          },
          "μὴ ἔχοντος καὶ ὃ ἔχει ἀρθήσεται ἀπʼ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "καὶ τὸν ἀχρεῖον δοῦλον ἐκβάλετε εἰς τὸ σκότος τὸ ἐξώτερον· ἐκεῖ ἔσται ὁ κλαυθμὸς καὶ ὁ βρυγμὸς τῶν ὀδόντων."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "Ὅταν δὲ ἔλθῃ ὁ υἱὸς τοῦ ἀνθρώπου ἐν τῇ δόξῃ αὐτοῦ καὶ πάντες ⸀οἱ",
          {
            "noteId": 702
          },
          "ἄγγελοι μετʼ αὐτοῦ, τότε καθίσει ἐπὶ θρόνου δόξης αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "καὶ ⸀συναχθήσονται",
          {
            "noteId": 703
          },
          "ἔμπροσθεν αὐτοῦ πάντα τὰ ἔθνη, καὶ ἀφορίσει αὐτοὺς ἀπʼ ἀλλήλων, ὥσπερ ὁ ποιμὴν ἀφορίζει τὰ πρόβατα ἀπὸ τῶν ἐρίφων,"
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "καὶ στήσει τὰ μὲν πρόβατα ἐκ δεξιῶν αὐτοῦ τὰ δὲ ἐρίφια ἐξ εὐωνύμων."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "τότε ἐρεῖ ὁ βασιλεὺς τοῖς ἐκ δεξιῶν αὐτοῦ· Δεῦτε, οἱ εὐλογημένοι τοῦ πατρός μου, κληρονομήσατε τὴν ἡτοιμασμένην ὑμῖν βασιλείαν ἀπὸ καταβολῆς κόσμου."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "ἐπείνασα γὰρ καὶ ἐδώκατέ μοι φαγεῖν, ἐδίψησα καὶ ἐποτίσατέ με, ξένος ἤμην καὶ συνηγάγετέ με,"
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "γυμνὸς καὶ περιεβάλετέ με, ἠσθένησα καὶ ἐπεσκέψασθέ με, ἐν φυλακῇ ἤμην καὶ ἤλθατε πρός με."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "τότε ἀποκριθήσονται αὐτῷ οἱ δίκαιοι λέγοντες· Κύριε, πότε σε εἴδομεν πεινῶντα καὶ ἐθρέψαμεν, ἢ διψῶντα καὶ ἐποτίσαμεν;"
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "πότε δέ σε εἴδομεν ξένον καὶ συνηγάγομεν, ἢ γυμνὸν καὶ περιεβάλομεν;"
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "πότε δέ σε εἴδομεν ⸀ἀσθενοῦντα",
          {
            "noteId": 704
          },
          "ἢ ἐν φυλακῇ καὶ ἤλθομεν πρός σε;"
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "καὶ ἀποκριθεὶς ὁ βασιλεὺς ἐρεῖ αὐτοῖς· Ἀμὴν λέγω ὑμῖν, ἐφʼ ὅσον ἐποιήσατε ἑνὶ τούτων τῶν ἀδελφῶν μου τῶν ἐλαχίστων, ἐμοὶ ἐποιήσατε."
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "τότε ἐρεῖ καὶ τοῖς ἐξ εὐωνύμων· Πορεύεσθε ἀπʼ ἐμοῦ ⸀οἱ",
          {
            "noteId": 705
          },
          "κατηραμένοι εἰς τὸ πῦρ τὸ αἰώνιον τὸ ἡτοιμασμένον τῷ διαβόλῳ καὶ τοῖς ἀγγέλοις αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "ἐπείνασα γὰρ καὶ οὐκ ἐδώκατέ μοι φαγεῖν, ⸀ἐδίψησα",
          {
            "noteId": 706
          },
          "καὶ οὐκ ἐποτίσατέ με,"
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "ξένος ἤμην καὶ οὐ συνηγάγετέ με, γυμνὸς καὶ οὐ περιεβάλετέ με, ἀσθενὴς καὶ ἐν φυλακῇ καὶ οὐκ ἐπεσκέψασθέ με."
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "τότε ἀποκριθήσονται καὶ αὐτοὶ λέγοντες· Κύριε, πότε σε εἴδομεν πεινῶντα ἢ διψῶντα ἢ ξένον ἢ γυμνὸν ἢ ἀσθενῆ ἢ ἐν φυλακῇ καὶ οὐ διηκονήσαμέν σοι;"
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "τότε ἀποκριθήσεται αὐτοῖς λέγων· Ἀμὴν λέγω ὑμῖν, ἐφʼ ὅσον οὐκ ἐποιήσατε ἑνὶ τούτων τῶν ἐλαχίστων, οὐδὲ ἐμοὶ ἐποιήσατε."
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "καὶ ἀπελεύσονται οὗτοι εἰς κόλασιν αἰώνιον, οἱ δὲ δίκαιοι εἰς ζωὴν αἰώνιον."
        ]
      }
    ],
