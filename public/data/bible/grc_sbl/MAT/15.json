  "chapter": {
    "number": 15,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Τότε προσέρχονται τῷ ⸀Ἰησοῦ",
          {
            "noteId": 318
          },
          "ἀπὸ Ἱεροσολύμων ⸂Φαρισαῖοι καὶ γραμματεῖς",
          {
            "noteId": 319
          },
          "λέγοντες"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Διὰ τί οἱ μαθηταί σου παραβαίνουσιν τὴν παράδοσιν τῶν πρεσβυτέρων; οὐ γὰρ νίπτονται τὰς χεῖρας ⸀αὐτῶν",
          {
            "noteId": 320
          },
          "ὅταν ἄρτον ἐσθίωσιν."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ὁ δὲ ἀποκριθεὶς εἶπεν αὐτοῖς· Διὰ τί καὶ ὑμεῖς παραβαίνετε τὴν ἐντολὴν τοῦ θεοῦ διὰ τὴν παράδοσιν ὑμῶν;"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ὁ γὰρ θεὸς ⸀εἶπεν",
          {
            "noteId": 321
          },
          "Τίμα τὸν πατέρα καὶ τὴν μητέρα, καί· Ὁ κακολογῶν πατέρα ἢ μητέρα θανάτῳ τελευτάτω·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ὑμεῖς δὲ λέγετε· Ὃς ἂν εἴπῃ τῷ πατρὶ ἢ τῇ μητρί· Δῶρον ὃ ἐὰν ἐξ ἐμοῦ ὠφεληθῇς,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "⸀οὐ",
          {
            "noteId": 322
          },
          "μὴ ⸀τιμήσει",
          {
            "noteId": 323
          },
          "τὸν πατέρα ⸀αὐτοῦ",
          {
            "noteId": 324
          },
          "καὶ ἠκυρώσατε ⸂τὸν λόγον",
          {
            "noteId": 325
          },
          "τοῦ θεοῦ διὰ τὴν παράδοσιν ὑμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ὑποκριταί, καλῶς ἐπροφήτευσεν περὶ ὑμῶν Ἠσαΐας λέγων·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "⸂Ὁ λαὸς οὗτος",
          {
            "noteId": 326
          },
          "τοῖς χείλεσίν με τιμᾷ, ἡ δὲ καρδία αὐτῶν πόρρω ἀπέχει ἀπʼ ἐμοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "μάτην δὲ σέβονταί με, διδάσκοντες διδασκαλίας ἐντάλματα ἀνθρώπων."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Καὶ προσκαλεσάμενος τὸν ὄχλον εἶπεν αὐτοῖς· Ἀκούετε καὶ συνίετε·"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "οὐ τὸ εἰσερχόμενον εἰς τὸ στόμα κοινοῖ τὸν ἄνθρωπον, ἀλλὰ τὸ ἐκπορευόμενον ἐκ τοῦ στόματος τοῦτο κοινοῖ τὸν ἄνθρωπον."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Τότε προσελθόντες οἱ ⸀μαθηταὶ",
          {
            "noteId": 327
          },
          "⸀λέγουσιν",
          {
            "noteId": 328
          },
          "αὐτῷ· Οἶδας ὅτι οἱ Φαρισαῖοι ἀκούσαντες τὸν λόγον ἐσκανδαλίσθησαν;"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ὁ δὲ ἀποκριθεὶς εἶπεν· Πᾶσα φυτεία ἣν οὐκ ἐφύτευσεν ὁ πατήρ μου ὁ οὐράνιος ἐκριζωθήσεται."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἄφετε αὐτούς· ⸂τυφλοί εἰσιν ὁδηγοὶ τυφλῶν",
          {
            "noteId": 329
          },
          "· τυφλὸς δὲ τυφλὸν ἐὰν ὁδηγῇ, ἀμφότεροι εἰς βόθυνον πεσοῦνται."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Ἀποκριθεὶς δὲ ὁ Πέτρος εἶπεν αὐτῷ· Φράσον ἡμῖν τὴν παραβολὴν ⸀ταύτην",
          {
            "noteId": 330
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ὁ ⸀δὲ",
          {
            "noteId": 331
          },
          "εἶπεν· Ἀκμὴν καὶ ὑμεῖς ἀσύνετοί ἐστε;"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "⸀οὐ",
          {
            "noteId": 332
          },
          "νοεῖτε ὅτι πᾶν τὸ εἰσπορευόμενον εἰς τὸ στόμα εἰς τὴν κοιλίαν χωρεῖ καὶ εἰς ἀφεδρῶνα ἐκβάλλεται;"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "τὰ δὲ ἐκπορευόμενα ἐκ τοῦ στόματος ἐκ τῆς καρδίας ἐξέρχεται, κἀκεῖνα κοινοῖ τὸν ἄνθρωπον."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἐκ γὰρ τῆς καρδίας ἐξέρχονται διαλογισμοὶ πονηροί, φόνοι, μοιχεῖαι, πορνεῖαι, κλοπαί, ψευδομαρτυρίαι, βλασφημίαι."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ταῦτά ἐστιν τὰ κοινοῦντα τὸν ἄνθρωπον, τὸ δὲ ἀνίπτοις χερσὶν φαγεῖν οὐ κοινοῖ τὸν ἄνθρωπον."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Καὶ ἐξελθὼν ἐκεῖθεν ὁ Ἰησοῦς ἀνεχώρησεν εἰς τὰ μέρη Τύρου καὶ Σιδῶνος."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "καὶ ἰδοὺ γυνὴ Χαναναία ἀπὸ τῶν ὁρίων ἐκείνων ἐξελθοῦσα ⸀ἔκραζεν",
          {
            "noteId": 333
          },
          "λέγουσα· Ἐλέησόν με, κύριε ⸀υἱὸς",
          {
            "noteId": 334
          },
          "Δαυίδ· ἡ θυγάτηρ μου κακῶς δαιμονίζεται."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ὁ δὲ οὐκ ἀπεκρίθη αὐτῇ λόγον. καὶ προσελθόντες οἱ μαθηταὶ αὐτοῦ ⸀ἠρώτουν",
          {
            "noteId": 335
          },
          "αὐτὸν λέγοντες· Ἀπόλυσον αὐτήν, ὅτι κράζει ὄπισθεν ἡμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ὁ δὲ ἀποκριθεὶς εἶπεν· Οὐκ ἀπεστάλην εἰ μὴ εἰς τὰ πρόβατα τὰ ἀπολωλότα οἴκου Ἰσραήλ."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ἡ δὲ ἐλθοῦσα ⸀προσεκύνει",
          {
            "noteId": 336
          },
          "αὐτῷ λέγουσα· Κύριε, βοήθει μοι."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ὁ δὲ ἀποκριθεὶς εἶπεν· Οὐκ ἔστιν καλὸν λαβεῖν τὸν ἄρτον τῶν τέκνων καὶ βαλεῖν τοῖς κυναρίοις."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "ἡ δὲ εἶπεν· Ναί, κύριε, καὶ γὰρ τὰ κυνάρια ἐσθίει ἀπὸ τῶν ψιχίων τῶν πιπτόντων ἀπὸ τῆς τραπέζης τῶν κυρίων αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "τότε ἀποκριθεὶς ὁ Ἰησοῦς εἶπεν αὐτῇ· Ὦ γύναι, μεγάλη σου ἡ πίστις· γενηθήτω σοι ὡς θέλεις. καὶ ἰάθη ἡ θυγάτηρ αὐτῆς ἀπὸ τῆς ὥρας ἐκείνης."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Καὶ μεταβὰς ἐκεῖθεν ὁ Ἰησοῦς ἦλθεν παρὰ τὴν θάλασσαν τῆς Γαλιλαίας, καὶ ἀναβὰς εἰς τὸ ὄρος ἐκάθητο ἐκεῖ."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "καὶ προσῆλθον αὐτῷ ὄχλοι πολλοὶ ἔχοντες μεθʼ ἑαυτῶν ⸂κωφούς, τυφλούς, χωλούς, κυλλούς",
          {
            "noteId": 337
          },
          ", καὶ ἑτέρους πολλούς, καὶ ἔρριψαν αὐτοὺς παρὰ τοὺς πόδας ⸀αὐτοῦ",
          {
            "noteId": 338
          },
          "καὶ ἐθεράπευσεν αὐτούς·"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "ὥστε ⸂τὸν ὄχλον",
          {
            "noteId": 339
          },
          "θαυμάσαι βλέποντας κωφοὺς λαλοῦντας ⸂κυλλοὺς ὑγιεῖς",
          {
            "noteId": 340
          },
          "⸀καὶ",
          {
            "noteId": 341
          },
          "χωλοὺς περιπατοῦντας καὶ τυφλοὺς βλέποντας· καὶ ἐδόξασαν τὸν θεὸν Ἰσραήλ."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Ὁ δὲ Ἰησοῦς προσκαλεσάμενος τοὺς μαθητὰς αὐτοῦ εἶπεν· Σπλαγχνίζομαι ἐπὶ τὸν ὄχλον, ὅτι ἤδη ἡμέραι τρεῖς προσμένουσίν μοι καὶ οὐκ ἔχουσιν τί φάγωσιν· καὶ ἀπολῦσαι αὐτοὺς νήστεις οὐ θέλω, μήποτε ἐκλυθῶσιν ἐν τῇ ὁδῷ."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "καὶ λέγουσιν αὐτῷ οἱ ⸀μαθηταί",
          {
            "noteId": 342
          },
          "Πόθεν ἡμῖν ἐν ἐρημίᾳ ἄρτοι τοσοῦτοι ὥστε χορτάσαι ὄχλον τοσοῦτον;"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "καὶ λέγει αὐτοῖς ὁ Ἰησοῦς· Πόσους ἄρτους ἔχετε; οἱ δὲ εἶπαν· Ἑπτά, καὶ ὀλίγα ἰχθύδια."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "καὶ ⸀παραγγείλας",
          {
            "noteId": 343
          },
          "⸂τῷ ὄχλῳ",
          {
            "noteId": 344
          },
          "ἀναπεσεῖν ἐπὶ τὴν γῆν"
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "⸀ἔλαβεν",
          {
            "noteId": 345
          },
          "τοὺς ἑπτὰ ἄρτους καὶ",
          {
            "noteId": 346
          },
          "τοὺς ἰχθύας ⸀καὶ εὐχαριστήσας ἔκλασεν καὶ ⸀ἐδίδου",
          {
            "noteId": 347
          },
          "τοῖς ⸀μαθηταῖς",
          {
            "noteId": 348
          },
          "οἱ δὲ μαθηταὶ ⸂τοῖς ὄχλοις",
          {
            "noteId": 349
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "καὶ ἔφαγον πάντες καὶ ἐχορτάσθησαν, καὶ ⸂τὸ περισσεῦον τῶν κλασμάτων ἦραν",
          {
            "noteId": 350
          },
          "ἑπτὰ σπυρίδας πλήρεις."
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "οἱ δὲ ἐσθίοντες ἦσαν τετρακισχίλιοι ἄνδρες χωρὶς γυναικῶν καὶ παιδίων."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "καὶ ἀπολύσας τοὺς ὄχλους ἐνέβη εἰς τὸ πλοῖον, καὶ ἦλθεν εἰς τὰ ὅρια ⸀Μαγαδάν",
          {
            "noteId": 351
          }
        ]
      }
    ],
