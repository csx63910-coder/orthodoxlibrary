  "chapter": {
    "number": 7,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Μὴ κρίνετε, ἵνα μὴ κριθῆτε·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἐν ᾧ γὰρ κρίματι κρίνετε κριθήσεσθε, καὶ ἐν ᾧ μέτρῳ μετρεῖτε μετρηθήσεται ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "τί δὲ βλέπεις τὸ κάρφος τὸ ἐν τῷ ὀφθαλμῷ τοῦ ἀδελφοῦ σου, τὴν δὲ ἐν τῷ σῷ ὀφθαλμῷ δοκὸν οὐ κατανοεῖς;"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἢ πῶς ἐρεῖς τῷ ἀδελφῷ σου· Ἄφες ἐκ",
          {
            "noteId": 101
          },
          "άλω τὸ κάρφος ⸀ἐκ τοῦ ὀφθαλμοῦ σου, καὶ ἰδοὺ ἡ δοκὸς ἐν τῷ ὀφθαλμῷ σοῦ;"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ὑποκριτά, ἔκβαλε πρῶτον ⸂ἐκ τοῦ ὀφθαλμοῦ σοῦ τὴν δοκόν",
          {
            "noteId": 102
          },
          ", καὶ τότε διαβλέψεις ἐκβαλεῖν τὸ κάρφος ἐκ τοῦ ὀφθαλμοῦ τοῦ ἀδελφοῦ σου."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Μὴ δῶτε τὸ ἅγιον τοῖς κυσίν, μηδὲ βάλητε τοὺς μαργαρίτας ὑμῶν ἔμπροσθεν τῶν χοίρων, μήποτε ⸀καταπατήσουσιν",
          {
            "noteId": 103
          },
          "αὐτοὺς ἐν τοῖς ποσὶν αὐτῶν καὶ στραφέντες ῥήξωσιν ὑμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Αἰτεῖτε, καὶ δοθήσεται ὑμῖν· ζητεῖτε, καὶ εὑρήσετε· κρούετε, καὶ ἀνοιγήσεται ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "πᾶς γὰρ ὁ αἰτῶν λαμβάνει καὶ ὁ ζητῶν εὑρίσκει καὶ τῷ κρούοντι ⸀ἀνοιγήσεται",
          {
            "noteId": 104
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ἢ τίς ⸀ἐστιν",
          {
            "noteId": 105
          },
          "ἐξ ὑμῶν ἄνθρωπος, ὃν ⸀αἰτήσει",
          {
            "noteId": 106
          },
          "ὁ υἱὸς αὐτοῦ ἄρτον— μὴ λίθον ἐπιδώσει αὐτῷ;"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "⸀ἢ",
          {
            "noteId": 107
          },
          "καὶ ⸂ἰχθὺν αἰτήσει",
          {
            "noteId": 108
          },
          "— μὴ ὄφιν ἐπιδώσει αὐτῷ;"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "εἰ οὖν ὑμεῖς πονηροὶ ὄντες οἴδατε δόματα ἀγαθὰ διδόναι τοῖς τέκνοις ὑμῶν, πόσῳ μᾶλλον ὁ πατὴρ ὑμῶν ὁ ἐν τοῖς οὐρανοῖς δώσει ἀγαθὰ τοῖς αἰτοῦσιν αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Πάντα οὖν ὅσα ⸀ἐὰν",
          {
            "noteId": 109
          },
          "θέλητε ἵνα ποιῶσιν ὑμῖν οἱ ἄνθρωποι, οὕτως καὶ ὑμεῖς ποιεῖτε αὐτοῖς· οὗτος γάρ ἐστιν ὁ νόμος καὶ οἱ προφῆται."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Εἰσέλθατε διὰ τῆς στενῆς πύλης· ὅτι πλατεῖα ⸂ἡ πύλη",
          {
            "noteId": 110
          },
          "καὶ εὐρύχωρος ἡ ὁδὸς ἡ ἀπάγουσα εἰς τὴν ἀπώλειαν, καὶ πολλοί εἰσιν οἱ εἰσερχόμενοι διʼ αὐτῆς·"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "⸀ὅτι",
          {
            "noteId": 111
          },
          "στενὴ ἡ πύλη καὶ τεθλιμμένη ἡ ὁδὸς ἡ ἀπάγουσα εἰς τὴν ζωήν, καὶ ὀλίγοι εἰσὶν οἱ εὑρίσκοντες αὐτήν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "⸀Προσέχετε",
          {
            "noteId": 112
          },
          "ἀπὸ τῶν ψευδοπροφητῶν, οἵτινες ἔρχονται πρὸς ὑμᾶς ἐν ἐνδύμασι προβάτων ἔσωθεν δέ εἰσιν λύκοι ἅρπαγες."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ἀπὸ τῶν καρπῶν αὐτῶν ἐπιγνώσεσθε αὐτούς. μήτι συλλέγουσιν ἀπὸ ἀκανθῶν ⸀σταφυλὰς",
          {
            "noteId": 113
          },
          "ἢ ἀπὸ τριβόλων σῦκα;"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "οὕτως πᾶν δένδρον ἀγαθὸν καρποὺς καλοὺς ποιεῖ, τὸ δὲ σαπρὸν δένδρον καρποὺς πονηροὺς ποιεῖ·"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "οὐ δύναται δένδρον ἀγαθὸν καρποὺς πονηροὺς ⸀ποιεῖν",
          {
            "noteId": 114
          },
          "οὐδὲ δένδρον σαπρὸν καρποὺς καλοὺς ποιεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "πᾶν δένδρον μὴ ποιοῦν καρπὸν καλὸν ἐκκόπτεται καὶ εἰς πῦρ βάλλεται."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἄρα γε ἀπὸ τῶν καρπῶν αὐτῶν ἐπιγνώσεσθε αὐτούς."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Οὐ πᾶς ὁ λέγων μοι· Κύριε κύριε εἰσελεύσεται εἰς τὴν βασιλείαν τῶν οὐρανῶν, ἀλλʼ ὁ ποιῶν τὸ θέλημα τοῦ πατρός μου τοῦ ἐν ⸀τοῖς",
          {
            "noteId": 115
          },
          "οὐρανοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "πολλοὶ ἐροῦσίν μοι ἐν ἐκείνῃ τῇ ἡμέρᾳ· Κύριε κύριε, οὐ τῷ σῷ ὀνόματι ἐπροφητεύσαμεν, καὶ τῷ σῷ ὀνόματι δαιμόνια ἐξεβάλομεν, καὶ τῷ σῷ ὀνόματι δυνάμεις πολλὰς ἐποιήσαμεν;"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "καὶ τότε ὁμολογήσω αὐτοῖς ὅτι Οὐδέποτε ἔγνων ὑμᾶς· ἀποχωρεῖτε ἀπʼ ἐμοῦ οἱ ἐργαζόμενοι τὴν ἀνομίαν."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Πᾶς οὖν ὅστις ἀκούει μου τοὺς λόγους τούτους καὶ ποιεῖ αὐτούς, ⸀ὁμοιωθήσεται",
          {
            "noteId": 116
          },
          "ἀνδρὶ φρονίμῳ, ὅστις ᾠκοδόμησεν ⸂αὐτοῦ τὴν οἰκίαν",
          {
            "noteId": 117
          },
          "ἐπὶ τὴν πέτραν."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "καὶ κατέβη ἡ βροχὴ καὶ ἦλθον οἱ ποταμοὶ καὶ ἔπνευσαν οἱ ἄνεμοι καὶ προσέπεσαν τῇ οἰκίᾳ ἐκείνῃ, καὶ οὐκ ἔπεσεν, τεθεμελίωτο γὰρ ἐπὶ τὴν πέτραν."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "καὶ πᾶς ὁ ἀκούων μου τοὺς λόγους τούτους καὶ μὴ ποιῶν αὐτοὺς ὁμοιωθήσεται ἀνδρὶ μωρῷ, ὅστις ᾠκοδόμησεν ⸂αὐτοῦ τὴν οἰκίαν",
          {
            "noteId": 118
          },
          "ἐπὶ τὴν ἄμμον."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "καὶ κατέβη ἡ βροχὴ καὶ ἦλθον οἱ ποταμοὶ καὶ ἔπνευσαν οἱ ἄνεμοι καὶ προσέκοψαν τῇ οἰκίᾳ ἐκείνῃ, καὶ ἔπεσεν, καὶ ἦν ἡ πτῶσις αὐτῆς μεγάλη."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Καὶ ἐγένετο ὅτε ⸀ἐτέλεσεν",
          {
            "noteId": 119
          },
          "ὁ Ἰησοῦς τοὺς λόγους τούτους, ἐξεπλήσσοντο οἱ ὄχλοι ἐπὶ τῇ διδαχῇ αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "ἦν γὰρ διδάσκων αὐτοὺς ὡς ἐξουσίαν ἔχων καὶ οὐχ ὡς οἱ γραμματεῖς ⸀αὐτῶν",
          {
            "noteId": 120
          }
        ]
      }
    ],
