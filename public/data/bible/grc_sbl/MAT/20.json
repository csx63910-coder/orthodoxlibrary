  "chapter": {
    "number": 20,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ὁμοία γάρ ἐστιν ἡ βασιλεία τῶν οὐρανῶν ἀνθρώπῳ οἰκοδεσπότῃ ὅστις ἐξῆλθεν ἅμα πρωῒ μισθώσασθαι ἐργάτας εἰς τὸν ἀμπελῶνα αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "⸂συμφωνήσας δὲ",
          {
            "noteId": 479
          },
          "μετὰ τῶν ἐργατῶν ἐκ δηναρίου τὴν ἡμέραν ἀπέστειλεν αὐτοὺς εἰς τὸν ἀμπελῶνα αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ ἐξελθὼν περὶ τρίτην ὥραν εἶδεν ἄλλους ἑστῶτας ἐν τῇ ἀγορᾷ ἀργούς·"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ ἐκείνοις εἶπεν· Ὑπάγετε καὶ ὑμεῖς εἰς τὸν ἀμπελῶνα, καὶ ὃ ἐὰν ᾖ δίκαιον δώσω ὑμῖν·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "οἱ δὲ ἀπῆλθον. ⸀πάλιν",
          {
            "noteId": 480
          },
          "ἐξελθὼν περὶ ἕκτην καὶ ἐνάτην ὥραν ἐποίησεν ὡσαύτως."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "περὶ δὲ τὴν ⸀ἑνδεκάτην",
          {
            "noteId": 481
          },
          "ἐξελθὼν εὗρεν ἄλλους ⸀ἑστῶτας",
          {
            "noteId": 482
          },
          "καὶ λέγει αὐτοῖς· Τί ὧδε ἑστήκατε ὅλην τὴν ἡμέραν ἀργοί;"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "λέγουσιν αὐτῷ· Ὅτι οὐδεὶς ἡμᾶς ἐμισθώσατο. λέγει αὐτοῖς· Ὑπάγετε καὶ ὑμεῖς εἰς τὸν ⸀ἀμπελῶνα",
          {
            "noteId": 483
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ὀψίας δὲ γενομένης λέγει ὁ κύριος τοῦ ἀμπελῶνος τῷ ἐπιτρόπῳ αὐτοῦ· Κάλεσον τοὺς ἐργάτας καὶ ἀπόδος ⸀αὐτοῖς",
          {
            "noteId": 484
          },
          "τὸν μισθὸν ἀρξάμενος ἀπὸ τῶν ἐσχάτων ἕως τῶν πρώτων."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "⸂καὶ ἐλθόντες",
          {
            "noteId": 485
          },
          "οἱ περὶ τὴν ἑνδεκάτην ὥραν ἔλαβον ἀνὰ δηνάριον."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "⸂καὶ ἐλθόντες",
          {
            "noteId": 486
          },
          "οἱ πρῶτοι ἐνόμισαν ὅτι ⸀πλεῖον",
          {
            "noteId": 487
          },
          "λήμψονται· καὶ ἔλαβον ⸂τὸ ἀνὰ δηνάριον καὶ αὐτοί",
          {
            "noteId": 488
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "λαβόντες δὲ ἐγόγγυζον κατὰ τοῦ οἰκοδεσπότου"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "⸀λέγοντες",
          {
            "noteId": 489
          },
          "Οὗτοι οἱ ἔσχατοι μίαν ὥραν ἐποίησαν, καὶ ἴσους ⸂αὐτοὺς ἡμῖν",
          {
            "noteId": 490
          },
          "ἐποίησας τοῖς βαστάσασι τὸ βάρος τῆς ἡμέρας καὶ τὸν καύσωνα."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ὁ δὲ ἀποκριθεὶς ⸂ἑνὶ αὐτῶν εἶπεν",
          {
            "noteId": 491
          },
          "· Ἑταῖρε, οὐκ ἀδικῶ σε· οὐχὶ δηναρίου συνεφώνησάς μοι;"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἆρον τὸ σὸν καὶ ὕπαγε· θέλω δὲ τούτῳ τῷ ἐσχάτῳ δοῦναι ὡς καὶ σοί·"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "⸀οὐκ",
          {
            "noteId": 492
          },
          "ἔξεστίν μοι ⸂ὃ θέλω ποιῆσαι",
          {
            "noteId": 493
          },
          "ἐν τοῖς ἐμοῖς; ⸀ἢ",
          {
            "noteId": 494
          },
          "ὁ ὀφθαλμός σου πονηρός ἐστιν ὅτι ἐγὼ ἀγαθός εἰμι;"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "οὕτως ἔσονται οἱ ἔσχατοι",
          {
            "noteId": 495
          },
          "πρῶτοι καὶ οἱ πρῶτοι ⸀ἔσχατοι."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "⸂Καὶ ἀναβαίνων ὁ",
          {
            "noteId": 496
          },
          "Ἰησοῦς εἰς Ἱεροσόλυμα παρέλαβεν τοὺς δώδεκα ⸀μαθητὰς",
          {
            "noteId": 497
          },
          "κατʼ ἰδίαν, ⸂καὶ ἐν τῇ ὁδῷ",
          {
            "noteId": 498
          },
          "εἶπεν αὐτοῖς·"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Ἰδοὺ ἀναβαίνομεν εἰς Ἱεροσόλυμα, καὶ ὁ υἱὸς τοῦ ἀνθρώπου παραδοθήσεται τοῖς ἀρχιερεῦσιν καὶ γραμματεῦσιν, καὶ κατακρινοῦσιν αὐτὸν θανάτῳ,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "καὶ παραδώσουσιν αὐτὸν τοῖς ἔθνεσιν εἰς τὸ ἐμπαῖξαι καὶ μαστιγῶσαι καὶ σταυρῶσαι, καὶ τῇ τρίτῃ ἡμέρᾳ ⸀ἐγερθήσεται",
          {
            "noteId": 499
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Τότε προσῆλθεν αὐτῷ ἡ μήτηρ τῶν υἱῶν Ζεβεδαίου μετὰ τῶν υἱῶν αὐτῆς προσκυνοῦσα καὶ αἰτοῦσά τι ⸀παρʼ",
          {
            "noteId": 500
          },
          "αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ὁ δὲ εἶπεν αὐτῇ· Τί θέλεις; λέγει αὐτῷ· Εἰπὲ ἵνα καθίσωσιν οὗτοι οἱ δύο υἱοί μου εἷς ἐκ δεξιῶν ⸀σου",
          {
            "noteId": 501
          },
          "καὶ εἷς ἐξ εὐωνύμων σου ἐν τῇ βασιλείᾳ σου."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ἀποκριθεὶς δὲ ὁ Ἰησοῦς εἶπεν· Οὐκ οἴδατε τί αἰτεῖσθε· δύνασθε πιεῖν τὸ ποτήριον ὃ ἐγὼ μέλλω ⸀πίνειν",
          {
            "noteId": 502
          },
          "λέγουσιν αὐτῷ· Δυνάμεθα."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "⸀λέγει",
          {
            "noteId": 503
          },
          "αὐτοῖς· Τὸ μὲν ποτήριόν μου ⸀πίεσθε",
          {
            "noteId": 504
          },
          "τὸ δὲ καθίσαι ἐκ δεξιῶν μου καὶ ἐξ ⸀εὐωνύμων",
          {
            "noteId": 505
          },
          "οὐκ ἔστιν ⸀ἐμὸν",
          {
            "noteId": 506
          },
          "δοῦναι, ἀλλʼ οἷς ἡτοίμασται ὑπὸ τοῦ πατρός μου."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Καὶ ἀκούσαντες οἱ δέκα ἠγανάκτησαν περὶ τῶν δύο ἀδελφῶν."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ὁ δὲ Ἰησοῦς προσκαλεσάμενος αὐτοὺς εἶπεν· Οἴδατε ὅτι οἱ ἄρχοντες τῶν ἐθνῶν κατακυριεύουσιν αὐτῶν καὶ οἱ μεγάλοι κατεξουσιάζουσιν αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "οὐχ οὕτως ⸀ἔσται",
          {
            "noteId": 507
          },
          "ἐν ὑμῖν· ἀλλʼ ὃς ⸀ἂν",
          {
            "noteId": 508
          },
          "θέλῃ ἐν ὑμῖν μέγας γενέσθαι ἔσται ὑμῶν διάκονος,"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "καὶ ὃς ⸀ἂν",
          {
            "noteId": 509
          },
          "θέλῃ ἐν ὑμῖν εἶναι πρῶτος ⸀ἔσται",
          {
            "noteId": 510
          },
          "ὑμῶν δοῦλος·"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ὥσπερ ὁ υἱὸς τοῦ ἀνθρώπου οὐκ ἦλθεν διακονηθῆναι ἀλλὰ διακονῆσαι καὶ δοῦναι τὴν ψυχὴν αὐτοῦ λύτρον ἀντὶ πολλῶν."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Καὶ ἐκπορευομένων αὐτῶν ἀπὸ Ἰεριχὼ ἠκολούθησεν αὐτῷ ὄχλος πολύς."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "καὶ ἰδοὺ δύο τυφλοὶ καθήμενοι παρὰ τὴν ὁδόν, ἀκούσαντες ὅτι Ἰησοῦς παράγει, ἔκραξαν λέγοντες· ⸂Κύριε, ἐλέησον ἡμᾶς⸃, ⸀υἱὸς Δαυίδ.",
          {
            "noteId": 511
          },
          {
            "noteId": 512
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "ὁ δὲ ὄχλος ἐπετίμησεν αὐτοῖς ἵνα σιωπήσωσιν· οἱ δὲ μεῖζον ⸀ἔκραξαν",
          {
            "noteId": 513
          },
          "λέγοντες· ⸂Κύριε, ἐλέησον ἡμᾶς⸃, ⸀υἱὸς Δαυίδ.",
          {
            "noteId": 514
          },
          {
            "noteId": 515
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "καὶ στὰς ὁ Ἰησοῦς ἐφώνησεν αὐτοὺς καὶ εἶπεν· Τί θέλετε ποιήσω ὑμῖν;"
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "λέγουσιν αὐτῷ· Κύριε, ἵνα ⸂ἀνοιγῶσιν οἱ ὀφθαλμοὶ ἡμῶν",
          {
            "noteId": 516
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "σπλαγχνισθεὶς δὲ ὁ Ἰησοῦς ἥψατο τῶν ⸀ὀμμάτων",
          {
            "noteId": 517
          },
          "αὐτῶν, καὶ εὐθέως ⸀ἀνέβλεψαν",
          {
            "noteId": 518
          },
          "καὶ ἠκολούθησαν αὐτῷ."
        ]
      }
    ],
