  },
  "chapter": {
    "number": 24,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ ἐξελθὼν ὁ Ἰησοῦς ⸂ἀπὸ τοῦ ἱεροῦ ἐπορεύετο",
          {
            "noteId": 633
          },
          ", καὶ προσῆλθον οἱ μαθηταὶ αὐτοῦ ἐπιδεῖξαι αὐτῷ τὰς οἰκοδομὰς τοῦ ἱεροῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ὁ δὲ ⸀ἀποκριθεὶς",
          {
            "noteId": 634
          },
          "εἶπεν αὐτοῖς· Οὐ βλέπετε ⸂ταῦτα πάντα",
          {
            "noteId": 635
          },
          "; ἀμὴν λέγω ὑμῖν, οὐ μὴ ἀφεθῇ ὧδε λίθος ἐπὶ λίθον ὃς οὐ καταλυθήσεται."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Καθημένου δὲ αὐτοῦ ἐπὶ τοῦ Ὄρους τῶν Ἐλαιῶν προσῆλθον αὐτῷ οἱ μαθηταὶ κατʼ ἰδίαν λέγοντες· Εἰπὸν ἡμῖν πότε ταῦτα ἔσται, καὶ",
          {
            "noteId": 636
          },
          "τί τὸ σημεῖον τῆς σῆς παρουσίας ⸀καὶ συντελείας τοῦ αἰῶνος."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ ἀποκριθεὶς ὁ Ἰησοῦς εἶπεν αὐτοῖς· Βλέπετε μή τις ὑμᾶς πλανήσῃ·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "πολλοὶ γὰρ ἐλεύσονται ἐπὶ τῷ ὀνόματί μου λέγοντες· Ἐγώ εἰμι ὁ χριστός, καὶ πολλοὺς πλανήσουσιν."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "μελλήσετε δὲ ἀκούειν πολέμους καὶ ἀκοὰς πολέμων· ὁρᾶτε, μὴ θροεῖσθε· δεῖ ⸀γὰρ",
          {
            "noteId": 637
          },
          "γενέσθαι, ἀλλʼ οὔπω ἐστὶν τὸ τέλος."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἐγερθήσεται γὰρ ἔθνος ἐπὶ ἔθνος καὶ βασιλεία ἐπὶ βασιλείαν, καὶ ἔσονται ⸀λιμοὶ",
          {
            "noteId": 638
          },
          "καὶ σεισμοὶ κατὰ τόπους·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "πάντα δὲ ταῦτα ἀρχὴ ὠδίνων."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Τότε παραδώσουσιν ὑμᾶς εἰς θλῖψιν καὶ ἀποκτενοῦσιν ὑμᾶς, καὶ ἔσεσθε μισούμενοι ὑπὸ πάντων τῶν ἐθνῶν διὰ τὸ ὄνομά μου."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ τότε σκανδαλισθήσονται πολλοὶ καὶ ἀλλήλους παραδώσουσιν καὶ μισήσουσιν ἀλλήλους·"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ πολλοὶ ψευδοπροφῆται ἐγερθήσονται καὶ πλανήσουσιν πολλούς·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "καὶ διὰ τὸ πληθυνθῆναι τὴν ἀνομίαν ψυγήσεται ἡ ἀγάπη τῶν πολλῶν."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ὁ δὲ ὑπομείνας εἰς τέλος οὗτος σωθήσεται."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καὶ κηρυχθήσεται τοῦτο τὸ εὐαγγέλιον τῆς βασιλείας ἐν ὅλῃ τῇ οἰκουμένῃ εἰς μαρτύριον πᾶσιν τοῖς ἔθνεσιν, καὶ τότε ἥξει τὸ τέλος."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Ὅταν οὖν ἴδητε τὸ βδέλυγμα τῆς ἐρημώσεως τὸ ῥηθὲν διὰ Δανιὴλ τοῦ προφήτου ⸀ἑστὸς",
          {
            "noteId": 639
          },
          "ἐν τόπῳ ἁγίῳ, ὁ ἀναγινώσκων νοείτω,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "τότε οἱ ἐν τῇ Ἰουδαίᾳ φευγέτωσαν ⸀ἐπὶ",
          {
            "noteId": 640
          },
          "τὰ ὄρη,"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ὁ ἐπὶ τοῦ δώματος μὴ ⸀καταβάτω",
          {
            "noteId": 641
          },
          "ἆραι τὰ ἐκ τῆς οἰκίας αὐτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ ὁ ἐν τῷ ἀγρῷ μὴ ἐπιστρεψάτω ὀπίσω ἆραι ⸂τὸ ἱμάτιον",
          {
            "noteId": 642
          },
          "αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "οὐαὶ δὲ ταῖς ἐν γαστρὶ ἐχούσαις καὶ ταῖς θηλαζούσαις ἐν ἐκείναις ταῖς ἡμέραις."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "προσεύχεσθε δὲ ἵνα μὴ γένηται ἡ φυγὴ ὑμῶν χειμῶνος μηδὲ σαββάτῳ·"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ἔσται γὰρ τότε θλῖψις μεγάλη οἵα οὐ γέγονεν ἀπʼ ἀρχῆς κόσμου ἕως τοῦ νῦν οὐδʼ οὐ μὴ γένηται."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "καὶ εἰ μὴ ἐκολοβώθησαν αἱ ἡμέραι ἐκεῖναι, οὐκ ἂν ἐσώθη πᾶσα σάρξ· διὰ δὲ τοὺς ἐκλεκτοὺς κολοβωθήσονται αἱ ἡμέραι ἐκεῖναι."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "τότε ἐάν τις ὑμῖν εἴπῃ· Ἰδοὺ ὧδε ὁ χριστός, ἤ· Ὧδε, μὴ πιστεύσητε·"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ἐγερθήσονται γὰρ ψευδόχριστοι καὶ ψευδοπροφῆται, καὶ δώσουσιν σημεῖα μεγάλα καὶ τέρατα ὥστε ⸀πλανῆσαι",
          {
            "noteId": 643
          },
          "εἰ δυνατὸν καὶ τοὺς ἐκλεκτούς·"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ἰδοὺ προείρηκα ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ἐὰν οὖν εἴπωσιν ὑμῖν· Ἰδοὺ ἐν τῇ ἐρήμῳ ἐστίν, μὴ ἐξέλθητε· Ἰδοὺ ἐν τοῖς ταμείοις, μὴ πιστεύσητε·"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "ὥσπερ γὰρ ἡ ἀστραπὴ ἐξέρχεται ἀπὸ ἀνατολῶν καὶ φαίνεται ἕως δυσμῶν, οὕτως ⸀ἔσται",
          {
            "noteId": 644
          },
          "ἡ παρουσία τοῦ υἱοῦ τοῦ ἀνθρώπου·"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "⸀ὅπου",
          {
            "noteId": 645
          },
          "ἐὰν ᾖ τὸ πτῶμα, ἐκεῖ συναχθήσονται οἱ ἀετοί."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Εὐθέως δὲ μετὰ τὴν θλῖψιν τῶν ἡμερῶν ἐκείνων ὁ ἥλιος σκοτισθήσεται, καὶ ἡ σελήνη οὐ δώσει τὸ φέγγος αὐτῆς, καὶ οἱ ἀστέρες πεσοῦνται ἀπὸ τοῦ οὐρανοῦ, καὶ αἱ δυνάμεις τῶν οὐρανῶν σαλευθήσονται."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "καὶ τότε φανήσεται τὸ σημεῖον τοῦ υἱοῦ τοῦ ἀνθρώπου ἐν ⸀τῷ",
          {
            "noteId": 646
          },
          "οὐρανῷ, καὶ τότε κόψονται πᾶσαι αἱ φυλαὶ τῆς γῆς καὶ ὄψονται τὸν υἱὸν τοῦ ἀνθρώπου ἐρχόμενον ἐπὶ τῶν νεφελῶν τοῦ οὐρανοῦ μετὰ δυνάμεως καὶ δόξης πολλῆς·"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "καὶ ἀποστελεῖ τοὺς ἀγγέλους αὐτοῦ μετὰ ⸀σάλπιγγος",
          {
            "noteId": 647
          },
          "μεγάλης, καὶ ἐπισυνάξουσιν τοὺς ἐκλεκτοὺς αὐτοῦ ἐκ τῶν",
          {
            "noteId": 648
          },
          "τεσσάρων ἀνέμων ἀπʼ ἄκρων οὐρανῶν ἕως ⸀τῶν ἄκρων αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Ἀπὸ δὲ τῆς συκῆς μάθετε τὴν παραβολήν· ὅταν ἤδη ὁ κλάδος αὐτῆς γένηται ἁπαλὸς καὶ τὰ φύλλα ἐκφύῃ, γινώσκετε ὅτι ἐγγὺς τὸ θέρος·"
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "οὕτως καὶ ὑμεῖς, ὅταν ἴδητε ⸂πάντα ταῦτα",
          {
            "noteId": 649
          },
          ", γινώσκετε ὅτι ἐγγύς ἐστιν ἐπὶ θύραις."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "ἀμὴν λέγω ὑμῖν ⸀ὅτι",
          {
            "noteId": 650
          },
          "οὐ μὴ παρέλθῃ ἡ γενεὰ αὕτη ἕως ἂν πάντα ταῦτα γένηται."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "ὁ οὐρανὸς καὶ ἡ γῆ ⸀παρελεύσεται",
          {
            "noteId": 651
          },
          "οἱ δὲ λόγοι μου οὐ μὴ παρέλθωσιν."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "Περὶ δὲ τῆς ἡμέρας ἐκείνης καὶ ὥρας οὐδεὶς οἶδεν, οὐδὲ οἱ ἄγγελοι τῶν οὐρανῶν ⸂οὐδὲ ὁ υἱός",
          {
            "noteId": 652
          },
          ", εἰ μὴ ὁ ⸀πατὴρ",
          {
            "noteId": 653
          },
          "μόνος."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "ὥσπερ ⸀γὰρ",
          {
            "noteId": 654
          },
          "αἱ ἡμέραι τοῦ Νῶε, οὕτως ⸀ἔσται",
          {
            "noteId": 655
          },
          "ἡ παρουσία τοῦ υἱοῦ τοῦ ἀνθρώπου·"
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "⸀ὡς",
          {
            "noteId": 656
          },
          "γὰρ ἦσαν ἐν ταῖς ⸀ἡμέραις",
          {
            "noteId": 657
          },
          "ταῖς πρὸ τοῦ κατακλυσμοῦ τρώγοντες καὶ πίνοντες, γαμοῦντες καὶ ⸀γαμίζοντες",
          {
            "noteId": 658
          },
          "ἄχρι ἧς ἡμέρας εἰσῆλθεν Νῶε εἰς τὴν κιβωτόν,"
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "καὶ",
          {
            "noteId": 659
          },
          "οὐκ ἔγνωσαν ἕως ἦλθεν ὁ κατακλυσμὸς καὶ ἦρεν ἅπαντας, οὕτως ἔσται ⸀καὶ ἡ παρουσία τοῦ υἱοῦ τοῦ ἀνθρώπου."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "τότε ⸂δύο ἔσονται",
          {
            "noteId": 660
          },
          "ἐν τῷ ἀγρῷ, ⸀εἷς",
          {
            "noteId": 661
          },
          "παραλαμβάνεται καὶ ⸁εἷς",
          {
            "noteId": 662
          },
          "ἀφίεται·"
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "δύο ἀλήθουσαι ἐν τῷ ⸀μύλῳ",
          {
            "noteId": 663
          },
          "μία παραλαμβάνεται καὶ μία ἀφίεται."
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "γρηγορεῖτε οὖν, ὅτι οὐκ οἴδατε ποίᾳ ⸀ἡμέρᾳ",
          {
            "noteId": 664
          },
          "ὁ κύριος ὑμῶν ἔρχεται."
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "ἐκεῖνο δὲ γινώσκετε ὅτι εἰ ᾔδει ὁ οἰκοδεσπότης ποίᾳ φυλακῇ ὁ κλέπτης ἔρχεται, ἐγρηγόρησεν ἂν καὶ οὐκ ἂν εἴασεν διορυχθῆναι τὴν οἰκίαν αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "διὰ τοῦτο καὶ ὑμεῖς γίνεσθε ἕτοιμοι, ὅτι ᾗ ⸂οὐ δοκεῖτε ὥρᾳ",
          {
            "noteId": 665
          },
          "ὁ υἱὸς τοῦ ἀνθρώπου ἔρχεται."
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "Τίς ἄρα ἐστὶν ὁ πιστὸς δοῦλος καὶ φρόνιμος ὃν κατέστησεν ὁ ⸀κύριος",
          {
            "noteId": 666
          },
          "ἐπὶ τῆς ⸀οἰκετείας",
          {
            "noteId": 667
          },
          "αὐτοῦ τοῦ ⸀δοῦναι",
          {
            "noteId": 668
          },
          "αὐτοῖς τὴν τροφὴν ἐν καιρῷ;"
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "μακάριος ὁ δοῦλος ἐκεῖνος ὃν ἐλθὼν ὁ κύριος αὐτοῦ εὑρήσει ⸂οὕτως ποιοῦντα",
          {
            "noteId": 669
          },
          "·"
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          "ἀμὴν λέγω ὑμῖν ὅτι ἐπὶ πᾶσιν τοῖς ὑπάρχουσιν αὐτοῦ καταστήσει αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          "ἐὰν δὲ εἴπῃ ὁ κακὸς δοῦλος ἐκεῖνος ἐν τῇ καρδίᾳ αὐτοῦ· Χρονίζει ⸂μου ὁ κύριος",
          {
            "noteId": 670
          },
          ","
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          "καὶ ἄρξηται τύπτειν τοὺς συνδούλους ⸂αὐτοῦ, ἐσθίῃ δὲ καὶ πίνῃ⸃ μετὰ τῶν μεθυόντων,",
          {
            "noteId": 671
          }
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          "ἥξει ὁ κύριος τοῦ δούλου ἐκείνου ἐν ἡμέρᾳ ᾗ οὐ προσδοκᾷ καὶ ἐν ὥρᾳ ᾗ οὐ γινώσκει,"
        ]
      },
      {
        "type": "verse",
        "number": 51,
        "content": [
          "καὶ διχοτομήσει αὐτὸν καὶ τὸ μέρος αὐτοῦ μετὰ τῶν ὑποκριτῶν θήσει· ἐκεῖ ἔσται ὁ κλαυθμὸς καὶ ὁ βρυγμὸς τῶν ὀδόντων."
        ]
      }
    ],
