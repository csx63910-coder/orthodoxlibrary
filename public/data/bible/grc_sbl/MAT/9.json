  "chapter": {
    "number": 9,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ ⸀ἐμβὰς",
          {
            "noteId": 146
          },
          "⸀εἰς",
          {
            "noteId": 147
          },
          "πλοῖον διεπέρασεν καὶ ἦλθεν εἰς τὴν ἰδίαν πόλιν."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Καὶ ἰδοὺ προσέφερον αὐτῷ παραλυτικὸν ἐπὶ κλίνης βεβλημένον. καὶ ἰδὼν ὁ Ἰησοῦς τὴν πίστιν αὐτῶν εἶπεν τῷ παραλυτικῷ· Θάρσει, τέκνον· ⸀ἀφίενταί",
          {
            "noteId": 148
          },
          "⸂σου αἱ ἁμαρτίαι",
          {
            "noteId": 149
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ ἰδού τινες τῶν γραμματέων εἶπαν ἐν ἑαυτοῖς· Οὗτος βλασφημεῖ."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ ⸀εἰδὼς",
          {
            "noteId": 150
          },
          "ὁ Ἰησοῦς τὰς ἐνθυμήσεις αὐτῶν εἶπεν· ⸀Ἱνατί",
          {
            "noteId": 151
          },
          "ἐνθυμεῖσθε πονηρὰ ἐν ταῖς καρδίαις ὑμῶν;"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "τί γάρ ἐστιν εὐκοπώτερον, εἰπεῖν· ⸀Ἀφίενταί",
          {
            "noteId": 152
          },
          "σου αἱ ἁμαρτίαι, ἢ εἰπεῖν· ⸀Ἔγειρε",
          {
            "noteId": 153
          },
          "καὶ περιπάτει;"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἵνα δὲ εἰδῆτε ὅτι ἐξουσίαν ἔχει ὁ υἱὸς τοῦ ἀνθρώπου ἐπὶ τῆς γῆς ἀφιέναι ἁμαρτίας— τότε λέγει τῷ παραλυτικῷ· ⸀Ἐγερθεὶς",
          {
            "noteId": 154
          },
          "ἆρόν σου τὴν κλίνην καὶ ὕπαγε εἰς τὸν οἶκόν σου."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "καὶ ἐγερθεὶς ἀπῆλθεν εἰς τὸν οἶκον αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἰδόντες δὲ οἱ ὄχλοι ⸀ἐφοβήθησαν",
          {
            "noteId": 155
          },
          "καὶ ἐδόξασαν τὸν θεὸν τὸν δόντα ἐξουσίαν τοιαύτην τοῖς ἀνθρώποις."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Καὶ παράγων ὁ Ἰησοῦς ἐκεῖθεν εἶδεν ἄνθρωπον καθήμενον ἐπὶ τὸ τελώνιον, Μαθθαῖον λεγόμενον, καὶ λέγει αὐτῷ· Ἀκολούθει μοι· καὶ ἀναστὰς ἠκολούθησεν αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Καὶ ἐγένετο αὐτοῦ ἀνακειμένου ἐν τῇ οἰκίᾳ, ⸀καὶ",
          {
            "noteId": 156
          },
          "ἰδοὺ πολλοὶ τελῶναι καὶ ἁμαρτωλοὶ ἐλθόντες συνανέκειντο τῷ Ἰησοῦ καὶ τοῖς μαθηταῖς αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ ἰδόντες οἱ Φαρισαῖοι ⸀ἔλεγον",
          {
            "noteId": 157
          },
          "τοῖς μαθηταῖς αὐτοῦ· Διὰ τί μετὰ τῶν τελωνῶν καὶ ἁμαρτωλῶν ἐσθίει ὁ διδάσκαλος ὑμῶν;"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ὁ ⸀δὲ",
          {
            "noteId": 158
          },
          "ἀκούσας ⸀εἶπεν",
          {
            "noteId": 159
          },
          "Οὐ χρείαν ἔχουσιν οἱ ἰσχύοντες ἰατροῦ ἀλλὰ οἱ κακῶς ἔχοντες."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "πορευθέντες δὲ μάθετε τί ἐστιν· Ἔλεος θέλω καὶ οὐ θυσίαν· οὐ γὰρ ἦλθον καλέσαι δικαίους ἀλλὰ ⸀ἁμαρτωλούς",
          {
            "noteId": 160
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Τότε προσέρχονται αὐτῷ οἱ μαθηταὶ Ἰωάννου λέγοντες· Διὰ τί ἡμεῖς καὶ οἱ Φαρισαῖοι νηστεύομεν ⸀πολλά",
          {
            "noteId": 161
          },
          "οἱ δὲ μαθηταί σου οὐ νηστεύουσιν;"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ εἶπεν αὐτοῖς ὁ Ἰησοῦς· Μὴ δύνανται οἱ υἱοὶ τοῦ νυμφῶνος πενθεῖν ἐφʼ ὅσον μετʼ αὐτῶν ἐστιν ὁ νυμφίος; ἐλεύσονται δὲ ἡμέραι ὅταν ἀπαρθῇ ἀπʼ αὐτῶν ὁ νυμφίος, καὶ τότε νηστεύσουσιν."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "οὐδεὶς δὲ ἐπιβάλλει ἐπίβλημα ῥάκους ἀγνάφου ἐπὶ ἱματίῳ παλαιῷ· αἴρει γὰρ τὸ πλήρωμα αὐτοῦ ἀπὸ τοῦ ἱματίου, καὶ χεῖρον σχίσμα γίνεται."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "οὐδὲ βάλλουσιν οἶνον νέον εἰς ἀσκοὺς παλαιούς· εἰ δὲ μή γε, ῥήγνυνται οἱ ἀσκοί, καὶ ὁ οἶνος ἐκχεῖται καὶ οἱ ἀσκοὶ ⸀ἀπόλλυνται",
          {
            "noteId": 162
          },
          "ἀλλὰ βάλλουσιν οἶνον νέον εἰς ἀσκοὺς καινούς, καὶ ἀμφότεροι συντηροῦνται."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Ταῦτα αὐτοῦ λαλοῦντος αὐτοῖς ἰδοὺ ἄρχων εἷς ⸀ἐλθὼν",
          {
            "noteId": 163
          },
          "προσεκύνει αὐτῷ λέγων ὅτι Ἡ θυγάτηρ μου ἄρτι ἐτελεύτησεν· ἀλλὰ ἐλθὼν ἐπίθες τὴν χεῖρά σου ἐπʼ αὐτήν, καὶ ζήσεται."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "καὶ ἐγερθεὶς ὁ Ἰησοῦς ⸀ἠκολούθει",
          {
            "noteId": 164
          },
          "αὐτῷ καὶ οἱ μαθηταὶ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Καὶ ἰδοὺ γυνὴ αἱμορροοῦσα δώδεκα ἔτη προσελθοῦσα ὄπισθεν ἥψατο τοῦ κρασπέδου τοῦ ἱματίου αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ἔλεγεν γὰρ ἐν ἑαυτῇ· Ἐὰν μόνον ἅψωμαι τοῦ ἱματίου αὐτοῦ σωθήσομαι."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ὁ δὲ Ἰησοῦς ⸀στραφεὶς",
          {
            "noteId": 165
          },
          "καὶ ἰδὼν αὐτὴν εἶπεν· Θάρσει, θύγατερ· ἡ πίστις σου σέσωκέν σε. καὶ ἐσώθη ἡ γυνὴ ἀπὸ τῆς ὥρας ἐκείνης."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "καὶ ἐλθὼν ὁ Ἰησοῦς εἰς τὴν οἰκίαν τοῦ ἄρχοντος καὶ ἰδὼν τοὺς αὐλητὰς καὶ τὸν ὄχλον θορυβούμενον"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "⸀ἔλεγεν",
          {
            "noteId": 166
          },
          "Ἀναχωρεῖτε, οὐ γὰρ ἀπέθανεν τὸ κοράσιον ἀλλὰ καθεύδει· καὶ κατεγέλων αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ὅτε δὲ ἐξεβλήθη ὁ ὄχλος, εἰσελθὼν ἐκράτησεν τῆς χειρὸς αὐτῆς, καὶ ἠγέρθη τὸ κοράσιον."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "καὶ ἐξῆλθεν ἡ φήμη αὕτη εἰς ὅλην τὴν γῆν ἐκείνην."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Καὶ παράγοντι ἐκεῖθεν τῷ Ἰησοῦ ἠκολούθησαν ⸀αὐτῷ",
          {
            "noteId": 167
          },
          "δύο τυφλοὶ κράζοντες καὶ λέγοντες· Ἐλέησον ἡμᾶς, ⸀υἱὲ",
          {
            "noteId": 168
          },
          "Δαυίδ."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ἐλθόντι δὲ εἰς τὴν οἰκίαν προσῆλθον αὐτῷ οἱ τυφλοί, καὶ λέγει αὐτοῖς ὁ Ἰησοῦς· Πιστεύετε ὅτι δύναμαι τοῦτο ποιῆσαι; λέγουσιν αὐτῷ· Ναί, κύριε."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "τότε ἥψατο τῶν ὀφθαλμῶν αὐτῶν λέγων· Κατὰ τὴν πίστιν ὑμῶν γενηθήτω ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "καὶ ἠνεῴχθησαν αὐτῶν οἱ ὀφθαλμοί. καὶ ⸀ἐνεβριμήθη",
          {
            "noteId": 169
          },
          "αὐτοῖς ὁ Ἰησοῦς λέγων· Ὁρᾶτε μηδεὶς γινωσκέτω·"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "οἱ δὲ ἐξελθόντες διεφήμισαν αὐτὸν ἐν ὅλῃ τῇ γῇ ἐκείνῃ."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Αὐτῶν δὲ ἐξερχομένων ἰδοὺ προσήνεγκαν αὐτῷ ⸀ἄνθρωπον",
          {
            "noteId": 170
          },
          "κωφὸν δαιμονιζόμενον·"
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "καὶ ἐκβληθέντος τοῦ δαιμονίου ἐλάλησεν ὁ κωφός. καὶ ἐθαύμασαν οἱ ὄχλοι λέγοντες· Οὐδέποτε ἐφάνη οὕτως ἐν τῷ Ἰσραήλ."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "οἱ δὲ Φαρισαῖοι ἔλεγον· Ἐν τῷ ἄρχοντι τῶν δαιμονίων ἐκβάλλει τὰ δαιμόνια."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "Καὶ περιῆγεν ὁ Ἰησοῦς τὰς πόλεις πάσας καὶ τὰς κώμας, διδάσκων ἐν ταῖς συναγωγαῖς αὐτῶν καὶ κηρύσσων τὸ εὐαγγέλιον τῆς βασιλείας καὶ θεραπεύων πᾶσαν νόσον καὶ πᾶσαν ⸀μαλακίαν",
          {
            "noteId": 171
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "Ἰδὼν δὲ τοὺς ὄχλους ἐσπλαγχνίσθη περὶ αὐτῶν ὅτι ἦσαν ἐσκυλμένοι καὶ ἐρριμμένοι ⸀ὡσεὶ",
          {
            "noteId": 172
          },
          "πρόβατα μὴ ἔχοντα ποιμένα."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "τότε λέγει τοῖς μαθηταῖς αὐτοῦ· Ὁ μὲν θερισμὸς πολύς, οἱ δὲ ἐργάται ὀλίγοι·"
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "δεήθητε οὖν τοῦ κυρίου τοῦ θερισμοῦ ὅπως ἐκβάλῃ ἐργάτας εἰς τὸν θερισμὸν αὐτοῦ."
        ]
      }
    ],
