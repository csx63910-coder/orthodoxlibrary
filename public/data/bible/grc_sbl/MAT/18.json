  "chapter": {
    "number": 18,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἐν ἐκείνῃ τῇ ὥρᾳ προσῆλθον οἱ μαθηταὶ τῷ Ἰησοῦ λέγοντες· Τίς ἄρα μείζων ἐστὶν ἐν τῇ βασιλείᾳ τῶν οὐρανῶν;"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ ⸀προσκαλεσάμενος",
          {
            "noteId": 402
          },
          "παιδίον ἔστησεν αὐτὸ ἐν μέσῳ αὐτῶν"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ εἶπεν· Ἀμὴν λέγω ὑμῖν, ἐὰν μὴ στραφῆτε καὶ γένησθε ὡς τὰ παιδία, οὐ μὴ εἰσέλθητε εἰς τὴν βασιλείαν τῶν οὐρανῶν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ὅστις οὖν ταπεινώσει ἑαυτὸν ὡς τὸ παιδίον τοῦτο, οὗτός ἐστιν ὁ μείζων ἐν τῇ βασιλείᾳ τῶν οὐρανῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ ὃς ⸀ἐὰν",
          {
            "noteId": 403
          },
          "δέξηται ⸂ἓν παιδίον τοιοῦτο",
          {
            "noteId": 404
          },
          "ἐπὶ τῷ ὀνόματί μου, ἐμὲ δέχεται."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ὃς δʼ ἂν σκανδαλίσῃ ἕνα τῶν μικρῶν τούτων τῶν πιστευόντων εἰς",
          {
            "noteId": 405
          },
          "ἐμέ, συμφέρει αὐτῷ ἵνα κρεμασθῇ μύλος ὀνικὸς ⸀εἰς τὸν τράχηλον αὐτοῦ καὶ καταποντισθῇ ἐν τῷ πελάγει τῆς θαλάσσης."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "οὐαὶ τῷ κόσμῳ ἀπὸ τῶν σκανδάλων· ἀνάγκη ⸀γὰρ",
          {
            "noteId": 406
          },
          "ἐλθεῖν τὰ σκάνδαλα, πλὴν οὐαὶ τῷ ⸀ἀνθρώπῳ",
          {
            "noteId": 407
          },
          "διʼ οὗ τὸ σκάνδαλον ἔρχεται."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Εἰ δὲ ἡ χείρ σου ἢ ὁ πούς σου σκανδαλίζει σε, ἔκκοψον ⸀αὐτὸν",
          {
            "noteId": 408
          },
          "καὶ βάλε ἀπὸ σοῦ· καλόν σοί ἐστιν εἰσελθεῖν εἰς τὴν ζωὴν ⸂κυλλὸν ἢ χωλόν",
          {
            "noteId": 409
          },
          ", ἢ δύο χεῖρας ἢ δύο πόδας ἔχοντα βληθῆναι εἰς τὸ πῦρ τὸ αἰώνιον."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ εἰ ὁ ὀφθαλμός σου σκανδαλίζει σε, ἔξελε αὐτὸν καὶ βάλε ἀπὸ σοῦ· καλόν σοί ἐστιν μονόφθαλμον εἰς τὴν ζωὴν εἰσελθεῖν, ἢ δύο ὀφθαλμοὺς ἔχοντα βληθῆναι εἰς τὴν γέενναν τοῦ πυρός."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Ὁρᾶτε μὴ καταφρονήσητε ἑνὸς τῶν μικρῶν τούτων, λέγω γὰρ ὑμῖν ὅτι οἱ ἄγγελοι αὐτῶν ἐν οὐρανοῖς",
          {
            "noteId": 410
          },
          "διὰ παντὸς βλέπουσι τὸ πρόσωπον τοῦ πατρός μου τοῦ ἐν ⸀οὐρανοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "τί ὑμῖν δοκεῖ; ἐὰν γένηταί τινι ἀνθρώπῳ ἑκατὸν πρόβατα καὶ πλανηθῇ ἓν ἐξ αὐτῶν, οὐχὶ ⸀ἀφήσει",
          {
            "noteId": 411
          },
          "τὰ ἐνενήκοντα ἐννέα ἐπὶ τὰ ὄρη ⸀καὶ",
          {
            "noteId": 412
          },
          "πορευθεὶς ζητεῖ τὸ πλανώμενον;"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ ἐὰν γένηται εὑρεῖν αὐτό, ἀμὴν λέγω ὑμῖν ὅτι χαίρει ἐπʼ αὐτῷ μᾶλλον ἢ ἐπὶ τοῖς ἐνενήκοντα ἐννέα τοῖς μὴ πεπλανημένοις."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "οὕτως οὐκ ἔστιν θέλημα ⸀ἔμπροσθεν",
          {
            "noteId": 413
          },
          "τοῦ πατρὸς ⸀ὑμῶν",
          {
            "noteId": 414
          },
          "τοῦ ἐν οὐρανοῖς ἵνα ἀπόληται ⸀ἓν",
          {
            "noteId": 415
          },
          "τῶν μικρῶν τούτων."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Ἐὰν δὲ ἁμαρτήσῃ ⸂εἰς σὲ",
          {
            "noteId": 416
          },
          "ὁ ἀδελφός σου, ⸀ὕπαγε",
          {
            "noteId": 417
          },
          "ἔλεγξον αὐτὸν μεταξὺ σοῦ καὶ αὐτοῦ μόνου. ἐάν σου ἀκούσῃ, ἐκέρδησας τὸν ἀδελφόν σου·"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ἐὰν δὲ μὴ ἀκούσῃ, παράλαβε μετὰ σοῦ ἔτι ἕνα ἢ δύο, ἵνα ἐπὶ στόματος δύο μαρτύρων ἢ τριῶν σταθῇ πᾶν ῥῆμα·"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ἐὰν δὲ παρακούσῃ αὐτῶν, εἰπὸν τῇ ἐκκλησίᾳ· ἐὰν δὲ καὶ τῆς ἐκκλησίας παρακούσῃ, ἔστω σοι ὥσπερ ὁ ἐθνικὸς καὶ ὁ τελώνης."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ἀμὴν λέγω ὑμῖν, ὅσα ⸀ἐὰν",
          {
            "noteId": 418
          },
          "δήσητε ἐπὶ τῆς γῆς ἔσται δεδεμένα ⸀ἐν",
          {
            "noteId": 419
          },
          "οὐρανῷ καὶ ὅσα ἐὰν λύσητε ἐπὶ τῆς γῆς ἔσται λελυμένα ⸁ἐν",
          {
            "noteId": 420
          },
          "οὐρανῷ."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Πάλιν ⸀ἀμὴν",
          {
            "noteId": 421
          },
          "λέγω ὑμῖν ὅτι ἐὰν δύο ⸂συμφωνήσωσιν ἐξ ὑμῶν",
          {
            "noteId": 422
          },
          "ἐπὶ τῆς γῆς περὶ παντὸς πράγματος οὗ ἐὰν αἰτήσωνται, γενήσεται αὐτοῖς παρὰ τοῦ πατρός μου τοῦ ἐν οὐρανοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "οὗ γάρ εἰσιν δύο ἢ τρεῖς συνηγμένοι εἰς τὸ ἐμὸν ὄνομα, ἐκεῖ εἰμι ἐν μέσῳ αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Τότε προσελθὼν ⸂αὐτῷ ὁ Πέτρος εἶπεν",
          {
            "noteId": 423
          },
          "· Κύριε, ποσάκις ἁμαρτήσει εἰς ἐμὲ ὁ ἀδελφός μου καὶ ἀφήσω αὐτῷ; ἕως ἑπτάκις;"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "λέγει αὐτῷ ὁ Ἰησοῦς· Οὐ λέγω σοι ἕως ἑπτάκις ἀλλὰ ἕως ἑβδομηκοντάκις ἑπτά."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Διὰ τοῦτο ὡμοιώθη ἡ βασιλεία τῶν οὐρανῶν ἀνθρώπῳ βασιλεῖ ὃς ἠθέλησεν συνᾶραι λόγον μετὰ τῶν δούλων αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ἀρξαμένου δὲ αὐτοῦ συναίρειν ⸀προσηνέχθη",
          {
            "noteId": 424
          },
          "⸂αὐτῷ εἷς⸃ ὀφειλέτης μυρίων ταλάντων.",
          {
            "noteId": 425
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "μὴ ἔχοντος δὲ αὐτοῦ ἀποδοῦναι ἐκέλευσεν αὐτὸν ὁ ⸀κύριος",
          {
            "noteId": 426
          },
          "πραθῆναι καὶ τὴν ⸀γυναῖκα",
          {
            "noteId": 427
          },
          "καὶ τὰ τέκνα καὶ πάντα ὅσα ⸀ἔχει",
          {
            "noteId": 428
          },
          "καὶ ἀποδοθῆναι."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "πεσὼν οὖν ὁ δοῦλος προσεκύνει αὐτῷ λέγων· ⸀Μακροθύμησον",
          {
            "noteId": 429
          },
          "ἐπʼ ⸀ἐμοί",
          {
            "noteId": 430
          },
          "καὶ πάντα ⸂ἀποδώσω σοι",
          {
            "noteId": 431
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "σπλαγχνισθεὶς δὲ ὁ κύριος τοῦ δούλου ἐκείνου ἀπέλυσεν αὐτόν, καὶ τὸ δάνειον ἀφῆκεν αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ἐξελθὼν δὲ ὁ δοῦλος ἐκεῖνος εὗρεν ἕνα τῶν συνδούλων αὐτοῦ ὃς ὤφειλεν αὐτῷ ἑκατὸν δηνάρια, καὶ κρατήσας αὐτὸν ἔπνιγεν λέγων· ⸀Ἀπόδος",
          {
            "noteId": 432
          },
          "εἴ τι ὀφείλεις."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "πεσὼν οὖν ὁ σύνδουλος ⸀αὐτοῦ",
          {
            "noteId": 433
          },
          "παρεκάλει αὐτὸν λέγων· Μακροθύμησον ἐπʼ ⸀ἐμοί",
          {
            "noteId": 434
          },
          "καὶ ἀποδώσω σοι."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ὁ δὲ οὐκ ἤθελεν, ἀλλὰ ἀπελθὼν ἔβαλεν αὐτὸν εἰς φυλακὴν ἕως ⸀οὗ",
          {
            "noteId": 435
          },
          "ἀποδῷ τὸ ὀφειλόμενον."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "ἰδόντες ⸀οὖν",
          {
            "noteId": 436
          },
          "οἱ σύνδουλοι αὐτοῦ τὰ γενόμενα ἐλυπήθησαν σφόδρα, καὶ ἐλθόντες διεσάφησαν τῷ κυρίῳ ἑαυτῶν πάντα τὰ γενόμενα."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "τότε προσκαλεσάμενος αὐτὸν ὁ κύριος αὐτοῦ λέγει αὐτῷ· Δοῦλε πονηρέ, πᾶσαν τὴν ὀφειλὴν ἐκείνην ἀφῆκά σοι, ἐπεὶ παρεκάλεσάς με·"
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "οὐκ ἔδει καὶ σὲ ἐλεῆσαι τὸν σύνδουλόν σου, ὡς κἀγὼ σὲ ἠλέησα;"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "καὶ ὀργισθεὶς ὁ κύριος αὐτοῦ παρέδωκεν αὐτὸν τοῖς βασανισταῖς ἕως οὗ ἀποδῷ πᾶν τὸ ⸀ὀφειλόμενον",
          {
            "noteId": 437
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "Οὕτως καὶ ὁ πατήρ μου ὁ ⸀οὐράνιος",
          {
            "noteId": 438
          },
          "ποιήσει ὑμῖν ἐὰν μὴ ἀφῆτε ἕκαστος τῷ ἀδελφῷ αὐτοῦ ἀπὸ τῶν καρδιῶν ⸀ὑμῶν",
          {
            "noteId": 439
          }
        ]
      }
    ],
