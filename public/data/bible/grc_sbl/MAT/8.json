  "chapter": {
    "number": 8,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "⸂Καταβάντος δὲ αὐτοῦ",
          {
            "noteId": 121
          },
          "ἀπὸ τοῦ ὄρους ἠκολούθησαν αὐτῷ ὄχλοι πολλοί."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ ἰδοὺ λεπρὸς ⸀προσελθὼν",
          {
            "noteId": 122
          },
          "προσεκύνει αὐτῷ λέγων· Κύριε, ἐὰν θέλῃς δύνασαί με καθαρίσαι."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ ἐκτείνας τὴν χεῖρα ἥψατο ⸀αὐτοῦ",
          {
            "noteId": 123
          },
          "λέγων· Θέλω, καθαρίσθητι· καὶ εὐθέως ἐκαθαρίσθη αὐτοῦ ἡ λέπρα."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ λέγει αὐτῷ ὁ Ἰησοῦς· Ὅρα μηδενὶ εἴπῃς, ἀλλὰ ὕπαγε σεαυτὸν δεῖξον τῷ ἱερεῖ, καὶ προσένεγκον τὸ δῶρον ὃ προσέταξεν Μωϋσῆς εἰς μαρτύριον αὐτοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "⸂Εἰσελθόντος δὲ αὐτοῦ",
          {
            "noteId": 124
          },
          "εἰς Καφαρναοὺμ προσῆλθεν αὐτῷ ἑκατόνταρχος παρακαλῶν αὐτὸν"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ λέγων· Κύριε, ὁ παῖς μου βέβληται ἐν τῇ οἰκίᾳ παραλυτικός, δεινῶς βασανιζόμενος."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "⸀καὶ",
          {
            "noteId": 125
          },
          "λέγει ⸀αὐτῷ",
          {
            "noteId": 126
          },
          "Ἐγὼ ἐλθὼν θεραπεύσω αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "⸂καὶ ἀποκριθεὶς",
          {
            "noteId": 127
          },
          "ὁ ἑκατόνταρχος ἔφη· Κύριε, οὐκ εἰμὶ ἱκανὸς ἵνα μου ὑπὸ τὴν στέγην εἰσέλθῃς· ἀλλὰ μόνον εἰπὲ λόγῳ, καὶ ἰαθήσεται ὁ παῖς μου·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ γὰρ ἐγὼ ἄνθρωπός εἰμι ὑπὸ ⸀ἐξουσίαν",
          {
            "noteId": 128
          },
          "ἔχων ὑπʼ ἐμαυτὸν στρατιώτας, καὶ λέγω τούτῳ· Πορεύθητι, καὶ πορεύεται, καὶ ἄλλῳ· Ἔρχου, καὶ ἔρχεται, καὶ τῷ δούλῳ μου· Ποίησον τοῦτο, καὶ ποιεῖ."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἀκούσας δὲ ὁ Ἰησοῦς ἐθαύμασεν καὶ εἶπεν τοῖς ἀκολουθοῦσιν· Ἀμὴν λέγω ὑμῖν, ⸂παρʼ οὐδενὶ τοσαύτην πίστιν ἐν τῷ Ἰσραὴλ",
          {
            "noteId": 129
          },
          "εὗρον."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "λέγω δὲ ὑμῖν ὅτι πολλοὶ ἀπὸ ἀνατολῶν καὶ δυσμῶν ἥξουσιν καὶ ἀνακλιθήσονται μετὰ Ἀβραὰμ καὶ Ἰσαὰκ καὶ Ἰακὼβ ἐν τῇ βασιλείᾳ τῶν οὐρανῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "οἱ δὲ υἱοὶ τῆς βασιλείας ἐκβληθήσονται εἰς τὸ σκότος τὸ ἐξώτερον· ἐκεῖ ἔσται ὁ κλαυθμὸς καὶ ὁ βρυγμὸς τῶν ὀδόντων."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ εἶπεν ὁ Ἰησοῦς τῷ ἑκατοντάρχῃ· Ὕπαγε, ⸀ὡς",
          {
            "noteId": 130
          },
          "ἐπίστευσας γενηθήτω σοι· καὶ ἰάθη ὁ ⸀παῖς",
          {
            "noteId": 131
          },
          "ἐν τῇ ὥρᾳ ἐκείνῃ."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Καὶ ἐλθὼν ὁ Ἰησοῦς εἰς τὴν οἰκίαν Πέτρου εἶδεν τὴν πενθερὰν αὐτοῦ βεβλημένην καὶ πυρέσσουσαν·"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ ἥψατο τῆς χειρὸς αὐτῆς, καὶ ἀφῆκεν αὐτὴν ὁ πυρετός, καὶ ἠγέρθη καὶ διηκόνει αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Ὀψίας δὲ γενομένης προσήνεγκαν αὐτῷ δαιμονιζομένους πολλούς· καὶ ἐξέβαλεν τὰ πνεύματα λόγῳ, καὶ πάντας τοὺς κακῶς ἔχοντας ἐθεράπευσεν·"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ὅπως πληρωθῇ τὸ ῥηθὲν διὰ Ἠσαΐου τοῦ προφήτου λέγοντος· Αὐτὸς τὰς ἀσθενείας ἡμῶν ἔλαβεν καὶ τὰς νόσους ἐβάστασεν."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Ἰδὼν δὲ ὁ Ἰησοῦς ⸂πολλοὺς ὄχλους",
          {
            "noteId": 132
          },
          "περὶ αὐτὸν ἐκέλευσεν ἀπελθεῖν εἰς τὸ πέραν."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "καὶ προσελθὼν εἷς γραμματεὺς εἶπεν αὐτῷ· Διδάσκαλε, ἀκολουθήσω σοι ὅπου ἐὰν ἀπέρχῃ."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "καὶ λέγει αὐτῷ ὁ Ἰησοῦς· Αἱ ἀλώπεκες φωλεοὺς ἔχουσιν καὶ τὰ πετεινὰ τοῦ οὐρανοῦ κατασκηνώσεις, ὁ δὲ υἱὸς τοῦ ἀνθρώπου οὐκ ἔχει ποῦ τὴν κεφαλὴν κλίνῃ."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ἕτερος δὲ τῶν ⸀μαθητῶν",
          {
            "noteId": 133
          },
          "εἶπεν αὐτῷ· Κύριε, ἐπίτρεψόν μοι πρῶτον ἀπελθεῖν καὶ θάψαι τὸν πατέρα μου."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ὁ δὲ Ἰησοῦς ⸀λέγει",
          {
            "noteId": 134
          },
          "αὐτῷ· Ἀκολούθει μοι, καὶ ἄφες τοὺς νεκροὺς θάψαι τοὺς ἑαυτῶν νεκρούς."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Καὶ ἐμβάντι αὐτῷ ⸀εἰς",
          {
            "noteId": 135
          },
          "πλοῖον ἠκολούθησαν αὐτῷ οἱ μαθηταὶ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "καὶ ἰδοὺ σεισμὸς μέγας ἐγένετο ἐν τῇ θαλάσσῃ, ὥστε τὸ πλοῖον καλύπτεσθαι ὑπὸ τῶν κυμάτων, αὐτὸς δὲ ἐκάθευδεν."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "καὶ ⸀προσελθόντες",
          {
            "noteId": 136
          },
          "ἤγειραν αὐτὸν λέγοντες· Κύριε, ⸀σῶσον",
          {
            "noteId": 137
          },
          "ἀπολλύμεθα."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "καὶ λέγει αὐτοῖς· Τί δειλοί ἐστε, ὀλιγόπιστοι; τότε ἐγερθεὶς ἐπετίμησεν τοῖς ἀνέμοις καὶ τῇ θαλάσσῃ, καὶ ἐγένετο γαλήνη μεγάλη."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "οἱ δὲ ἄνθρωποι ἐθαύμασαν λέγοντες· Ποταπός ἐστιν οὗτος ὅτι καὶ οἱ ἄνεμοι καὶ ἡ θάλασσα ⸂αὐτῷ ὑπακούουσιν",
          {
            "noteId": 138
          },
          ";"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Καὶ ⸂ἐλθόντος αὐτοῦ",
          {
            "noteId": 139
          },
          "εἰς τὸ πέραν εἰς τὴν χώραν τῶν ⸀Γαδαρηνῶν",
          {
            "noteId": 140
          },
          "ὑπήντησαν αὐτῷ δύο δαιμονιζόμενοι ἐκ τῶν μνημείων ἐξερχόμενοι, χαλεποὶ λίαν ὥστε μὴ ἰσχύειν τινὰ παρελθεῖν διὰ τῆς ὁδοῦ ἐκείνης."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "καὶ ἰδοὺ ἔκραξαν λέγοντες· Τί ἡμῖν καὶ ⸀σοί",
          {
            "noteId": 141
          },
          "υἱὲ τοῦ θεοῦ; ἦλθες ὧδε πρὸ καιροῦ βασανίσαι ἡμᾶς;"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ἦν δὲ μακρὰν ἀπʼ αὐτῶν ἀγέλη χοίρων πολλῶν βοσκομένη."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "οἱ δὲ δαίμονες παρεκάλουν αὐτὸν λέγοντες· Εἰ ἐκβάλλεις ἡμᾶς, ⸂ἀπόστειλον ἡμᾶς",
          {
            "noteId": 142
          },
          "εἰς τὴν ἀγέλην τῶν χοίρων."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "καὶ εἶπεν αὐτοῖς· Ὑπάγετε. οἱ δὲ ἐξελθόντες ἀπῆλθον εἰς ⸂τοὺς χοίρους",
          {
            "noteId": 143
          },
          "· καὶ ἰδοὺ ὥρμησεν πᾶσα ἡ ⸀ἀγέλη",
          {
            "noteId": 144
          },
          "κατὰ τοῦ κρημνοῦ εἰς τὴν θάλασσαν, καὶ ἀπέθανον ἐν τοῖς ὕδασιν."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "οἱ δὲ βόσκοντες ἔφυγον, καὶ ἀπελθόντες εἰς τὴν πόλιν ἀπήγγειλαν πάντα καὶ τὰ τῶν δαιμονιζομένων."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "καὶ ἰδοὺ πᾶσα ἡ πόλις ἐξῆλθεν εἰς ⸀ὑπάντησιν",
          {
            "noteId": 145
          },
          "τῷ Ἰησοῦ, καὶ ἰδόντες αὐτὸν παρεκάλεσαν ὅπως μεταβῇ ἀπὸ τῶν ὁρίων αὐτῶν."
        ]
      }
    ],
