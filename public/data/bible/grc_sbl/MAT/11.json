  "chapter": {
    "number": 11,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ ἐγένετο ὅτε ἐτέλεσεν ὁ Ἰησοῦς διατάσσων τοῖς δώδεκα μαθηταῖς αὐτοῦ, μετέβη ἐκεῖθεν τοῦ διδάσκειν καὶ κηρύσσειν ἐν ταῖς πόλεσιν αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Ὁ δὲ Ἰωάννης ἀκούσας ἐν τῷ δεσμωτηρίῳ τὰ ἔργα τοῦ χριστοῦ πέμψας ⸀διὰ",
          {
            "noteId": 199
          },
          "τῶν μαθητῶν αὐτοῦ"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "εἶπεν αὐτῷ· Σὺ εἶ ὁ ἐρχόμενος ἢ ἕτερον προσδοκῶμεν;"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ ἀποκριθεὶς ὁ Ἰησοῦς εἶπεν αὐτοῖς· Πορευθέντες ἀπαγγείλατε Ἰωάννῃ ἃ ἀκούετε καὶ βλέπετε·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "τυφλοὶ ἀναβλέπουσιν καὶ",
          {
            "noteId": 200
          },
          "χωλοὶ περιπατοῦσιν, λεπροὶ καθαρίζονται καὶ κωφοὶ ἀκούουσιν, ⸀καὶ νεκροὶ ἐγείρονται καὶ πτωχοὶ εὐαγγελίζονται·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ μακάριός ἐστιν ὃς ⸀ἐὰν",
          {
            "noteId": 201
          },
          "μὴ σκανδαλισθῇ ἐν ἐμοί."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Τούτων δὲ πορευομένων ἤρξατο ὁ Ἰησοῦς λέγειν τοῖς ὄχλοις περὶ Ἰωάννου· Τί ἐξήλθατε εἰς τὴν ἔρημον θεάσασθαι; κάλαμον ὑπὸ ἀνέμου σαλευόμενον;"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἀλλὰ τί ἐξήλθατε ἰδεῖν; ἄνθρωπον ἐν ⸀μαλακοῖς",
          {
            "noteId": 202
          },
          "ἠμφιεσμένον; ἰδοὺ οἱ τὰ μαλακὰ φοροῦντες ἐν τοῖς οἴκοις τῶν ⸀βασιλέων",
          {
            "noteId": 203
          },
          "⸀εἰσίν",
          {
            "noteId": 204
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ἀλλὰ τί ἐξήλθατε⸂; προφήτην ἰδεῖν⸃; ναί, λέγω ὑμῖν, καὶ περισσότερον προφήτου.",
          {
            "noteId": 205
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "⸀οὗτός",
          {
            "noteId": 206
          },
          "ἐστιν περὶ οὗ γέγραπται· Ἰδοὺ ἐγὼ ἀποστέλλω τὸν ἄγγελόν μου πρὸ προσώπου σου, ὃς κατασκευάσει τὴν ὁδόν σου ἔμπροσθέν σου."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ἀμὴν λέγω ὑμῖν, οὐκ ἐγήγερται ἐν γεννητοῖς γυναικῶν μείζων Ἰωάννου τοῦ βαπτιστοῦ· ὁ δὲ μικρότερος ἐν τῇ βασιλείᾳ τῶν οὐρανῶν μείζων αὐτοῦ ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ἀπὸ δὲ τῶν ἡμερῶν Ἰωάννου τοῦ βαπτιστοῦ ἕως ἄρτι ἡ βασιλεία τῶν οὐρανῶν βιάζεται, καὶ βιασταὶ ἁρπάζουσιν αὐτήν."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "πάντες γὰρ οἱ προφῆται καὶ ὁ νόμος ἕως Ἰωάννου ἐπροφήτευσαν·"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καὶ εἰ θέλετε δέξασθαι, αὐτός ἐστιν Ἠλίας ὁ μέλλων ἔρχεσθαι."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ὁ ἔχων ⸀ὦτα",
          {
            "noteId": 207
          },
          "ἀκουέτω."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Τίνι δὲ ὁμοιώσω τὴν γενεὰν ταύτην; ὁμοία ἐστὶν παιδίοις ⸂καθημένοις ἐν ταῖς ἀγοραῖς ἃ προσφωνοῦντα τοῖς ἑτέροις",
          {
            "noteId": 208
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "⸀λέγουσιν",
          {
            "noteId": 209
          },
          "Ηὐλήσαμεν ὑμῖν καὶ οὐκ ὠρχήσασθε· ⸀ἐθρηνήσαμεν καὶ οὐκ ἐκόψασθε·",
          {
            "noteId": 210
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ἦλθεν γὰρ Ἰωάννης μήτε ἐσθίων μήτε πίνων, καὶ λέγουσιν· Δαιμόνιον ἔχει·"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἦλθεν ὁ υἱὸς τοῦ ἀνθρώπου ἐσθίων καὶ πίνων, καὶ λέγουσιν· Ἰδοὺ ἄνθρωπος φάγος καὶ οἰνοπότης, τελωνῶν φίλος καὶ ἁμαρτωλῶν. καὶ ἐδικαιώθη ἡ σοφία ἀπὸ τῶν ⸀ἔργων",
          {
            "noteId": 211
          },
          "αὐτῆς."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Τότε ⸀ἤρξατο",
          {
            "noteId": 212
          },
          "ὀνειδίζειν τὰς πόλεις ἐν αἷς ἐγένοντο αἱ πλεῖσται δυνάμεις αὐτοῦ, ὅτι οὐ μετενόησαν·"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Οὐαί σοι, Χοραζίν· οὐαί σοι, Βηθσαϊδά· ὅτι εἰ ἐν Τύρῳ καὶ Σιδῶνι ἐγένοντο αἱ δυνάμεις αἱ γενόμεναι ἐν ὑμῖν, πάλαι ἂν ἐν σάκκῳ καὶ σποδῷ μετενόησαν."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "πλὴν λέγω ὑμῖν, Τύρῳ καὶ Σιδῶνι ἀνεκτότερον ἔσται ἐν ἡμέρᾳ κρίσεως ἢ ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "καὶ σύ, Καφαρναούμ, ⸂μὴ ἕως οὐρανοῦ ὑψωθήσῃ",
          {
            "noteId": 213
          },
          "; ἕως ᾅδου ⸀καταβήσῃ",
          {
            "noteId": 214
          },
          "ὅτι εἰ ἐν Σοδόμοις ⸀ἐγενήθησαν",
          {
            "noteId": 215
          },
          "αἱ δυνάμεις αἱ γενόμεναι ἐν σοί, ⸀ἔμεινεν",
          {
            "noteId": 216
          },
          "ἂν μέχρι τῆς σήμερον."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "πλὴν λέγω ὑμῖν ὅτι γῇ Σοδόμων ἀνεκτότερον ἔσται ἐν ἡμέρᾳ κρίσεως ἢ σοί."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Ἐν ἐκείνῳ τῷ καιρῷ ἀποκριθεὶς ὁ Ἰησοῦς εἶπεν· Ἐξομολογοῦμαί σοι, πάτερ κύριε τοῦ οὐρανοῦ καὶ τῆς γῆς, ὅτι ⸀ἔκρυψας",
          {
            "noteId": 217
          },
          "ταῦτα ἀπὸ σοφῶν καὶ συνετῶν, καὶ ἀπεκάλυψας αὐτὰ νηπίοις·"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ναί, ὁ πατήρ, ὅτι οὕτως ⸂εὐδοκία ἐγένετο",
          {
            "noteId": 218
          },
          "ἔμπροσθέν σου."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Πάντα μοι παρεδόθη ὑπὸ τοῦ πατρός μου, καὶ οὐδεὶς ἐπιγινώσκει τὸν υἱὸν εἰ μὴ ὁ πατήρ, οὐδὲ τὸν πατέρα τις ἐπιγινώσκει εἰ μὴ ὁ υἱὸς καὶ ᾧ ἐὰν βούληται ὁ υἱὸς ἀποκαλύψαι."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Δεῦτε πρός με πάντες οἱ κοπιῶντες καὶ πεφορτισμένοι, κἀγὼ ἀναπαύσω ὑμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "ἄρατε τὸν ζυγόν μου ἐφʼ ὑμᾶς καὶ μάθετε ἀπʼ ἐμοῦ, ὅτι πραΰς εἰμι καὶ ταπεινὸς τῇ καρδίᾳ, καὶ εὑρήσετε ἀνάπαυσιν ταῖς ψυχαῖς ὑμῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ὁ γὰρ ζυγός μου χρηστὸς καὶ τὸ φορτίον μου ἐλαφρόν ἐστιν."
        ]
      }
    ],
