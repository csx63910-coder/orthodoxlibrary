  "chapter": {
    "number": 22,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ ἀποκριθεὶς ὁ Ἰησοῦς πάλιν εἶπεν ⸂ἐν παραβολαῖς αὐτοῖς",
          {
            "noteId": 561
          },
          "λέγων·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Ὡμοιώθη ἡ βασιλεία τῶν οὐρανῶν ἀνθρώπῳ βασιλεῖ, ὅστις ἐποίησεν γάμους τῷ υἱῷ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ ἀπέστειλεν τοὺς δούλους αὐτοῦ καλέσαι τοὺς κεκλημένους εἰς τοὺς γάμους, καὶ οὐκ ἤθελον ἐλθεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "πάλιν ἀπέστειλεν ἄλλους δούλους λέγων· Εἴπατε τοῖς κεκλημένοις· Ἰδοὺ τὸ ἄριστόν μου ⸀ἡτοίμακα",
          {
            "noteId": 562
          },
          "οἱ ταῦροί μου καὶ τὰ σιτιστὰ τεθυμένα, καὶ πάντα ἕτοιμα· δεῦτε εἰς τοὺς γάμους."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "οἱ δὲ ἀμελήσαντες ἀπῆλθον, ⸀ὃς",
          {
            "noteId": 563
          },
          "μὲν εἰς τὸν ἴδιον ἀγρόν, ⸁ὃς",
          {
            "noteId": 564
          },
          "δὲ ⸀ἐπὶ",
          {
            "noteId": 565
          },
          "τὴν ἐμπορίαν αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "οἱ δὲ λοιποὶ κρατήσαντες τοὺς δούλους αὐτοῦ ὕβρισαν καὶ ἀπέκτειναν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "⸂ὁ δὲ βασιλεὺς",
          {
            "noteId": 566
          },
          "ὠργίσθη, καὶ πέμψας τὰ στρατεύματα αὐτοῦ ἀπώλεσεν τοὺς φονεῖς ἐκείνους καὶ τὴν πόλιν αὐτῶν ἐνέπρησεν."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "τότε λέγει τοῖς δούλοις αὐτοῦ· Ὁ μὲν γάμος ἕτοιμός ἐστιν, οἱ δὲ κεκλημένοι οὐκ ἦσαν ἄξιοι·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "πορεύεσθε οὖν ἐπὶ τὰς διεξόδους τῶν ὁδῶν, καὶ ὅσους ⸀ἐὰν",
          {
            "noteId": 567
          },
          "εὕρητε καλέσατε εἰς τοὺς γάμους."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ ἐξελθόντες οἱ δοῦλοι ἐκεῖνοι εἰς τὰς ὁδοὺς συνήγαγον πάντας ⸀οὓς",
          {
            "noteId": 568
          },
          "εὗρον, πονηρούς τε καὶ ἀγαθούς· καὶ ἐπλήσθη ὁ ⸀γάμος",
          {
            "noteId": 569
          },
          "ἀνακειμένων."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "εἰσελθὼν δὲ ὁ βασιλεὺς θεάσασθαι τοὺς ἀνακειμένους εἶδεν ἐκεῖ ἄνθρωπον οὐκ ἐνδεδυμένον ἔνδυμα γάμου·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "καὶ λέγει αὐτῷ· Ἑταῖρε, πῶς εἰσῆλθες ὧδε μὴ ἔχων ἔνδυμα γάμου; ὁ δὲ ἐφιμώθη."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "τότε ⸂ὁ βασιλεὺς εἶπεν",
          {
            "noteId": 570
          },
          "τοῖς διακόνοις· Δήσαντες αὐτοῦ πόδας καὶ χεῖρας ⸂ἐκβάλετε αὐτὸν",
          {
            "noteId": 571
          },
          "εἰς τὸ σκότος τὸ ἐξώτερον· ἐκεῖ ἔσται ὁ κλαυθμὸς καὶ ὁ βρυγμὸς τῶν ὀδόντων."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "πολλοὶ γάρ εἰσιν κλητοὶ ὀλίγοι δὲ ἐκλεκτοί."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Τότε πορευθέντες οἱ Φαρισαῖοι συμβούλιον ἔλαβον ὅπως αὐτὸν παγιδεύσωσιν ἐν λόγῳ."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ ἀποστέλλουσιν αὐτῷ τοὺς μαθητὰς αὐτῶν μετὰ τῶν Ἡρῳδιανῶν ⸀λέγοντες",
          {
            "noteId": 572
          },
          "Διδάσκαλε, οἴδαμεν ὅτι ἀληθὴς εἶ καὶ τὴν ὁδὸν τοῦ θεοῦ ἐν ἀληθείᾳ διδάσκεις, καὶ οὐ μέλει σοι περὶ οὐδενός, οὐ γὰρ βλέπεις εἰς πρόσωπον ἀνθρώπων·"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "εἰπὸν οὖν ἡμῖν τί σοι δοκεῖ· ἔξεστιν δοῦναι κῆνσον Καίσαρι ἢ οὔ;"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "γνοὺς δὲ ὁ Ἰησοῦς τὴν πονηρίαν αὐτῶν εἶπεν· Τί με πειράζετε, ὑποκριταί;"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἐπιδείξατέ μοι τὸ νόμισμα τοῦ κήνσου. οἱ δὲ προσήνεγκαν αὐτῷ δηνάριον."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "καὶ λέγει αὐτοῖς· Τίνος ἡ εἰκὼν αὕτη καὶ ἡ ἐπιγραφή;"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "λέγουσιν ⸀αὐτῷ",
          {
            "noteId": 573
          },
          "Καίσαρος. τότε λέγει αὐτοῖς· Ἀπόδοτε οὖν τὰ Καίσαρος Καίσαρι καὶ τὰ τοῦ θεοῦ τῷ θεῷ."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "καὶ ἀκούσαντες ἐθαύμασαν, καὶ ἀφέντες αὐτὸν ἀπῆλθαν."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Ἐν ἐκείνῃ τῇ ἡμέρᾳ προσῆλθον αὐτῷ Σαδδουκαῖοι, ⸀λέγοντες",
          {
            "noteId": 574
          },
          "μὴ εἶναι ἀνάστασιν, καὶ ἐπηρώτησαν αὐτὸν"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "λέγοντες· Διδάσκαλε, Μωϋσῆς εἶπεν· Ἐάν τις ἀποθάνῃ μὴ ἔχων τέκνα, ἐπιγαμβρεύσει ὁ ἀδελφὸς αὐτοῦ τὴν γυναῖκα αὐτοῦ καὶ ἀναστήσει σπέρμα τῷ ἀδελφῷ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ἦσαν δὲ παρʼ ἡμῖν ἑπτὰ ἀδελφοί· καὶ ὁ πρῶτος ⸀γήμας",
          {
            "noteId": 575
          },
          "ἐτελεύτησεν, καὶ μὴ ἔχων σπέρμα ἀφῆκεν τὴν γυναῖκα αὐτοῦ τῷ ἀδελφῷ αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ὁμοίως καὶ ὁ δεύτερος καὶ ὁ τρίτος, ἕως τῶν ἑπτά·"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "ὕστερον δὲ πάντων ἀπέθανεν ⸀ἡ",
          {
            "noteId": 576
          },
          "γυνή."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ἐν τῇ ⸂ἀναστάσει οὖν",
          {
            "noteId": 577
          },
          "τίνος τῶν ἑπτὰ ἔσται γυνή; πάντες γὰρ ἔσχον αὐτήν."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Ἀποκριθεὶς δὲ ὁ Ἰησοῦς εἶπεν αὐτοῖς· Πλανᾶσθε μὴ εἰδότες τὰς γραφὰς μηδὲ τὴν δύναμιν τοῦ θεοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ἐν γὰρ τῇ ἀναστάσει οὔτε γαμοῦσιν οὔτε ⸀γαμίζονται",
          {
            "noteId": 578
          },
          "ἀλλʼ ὡς ἄγγελοι ⸀θεοῦ",
          {
            "noteId": 579
          },
          "ἐν ⸀τῷ",
          {
            "noteId": 580
          },
          "οὐρανῷ εἰσιν·"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "περὶ δὲ τῆς ἀναστάσεως τῶν νεκρῶν οὐκ ἀνέγνωτε τὸ ῥηθὲν ὑμῖν ὑπὸ τοῦ θεοῦ λέγοντος·"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Ἐγώ εἰμι ὁ θεὸς",
          {
            "noteId": 581
          },
          "Ἀβραὰμ καὶ ὁ θεὸς Ἰσαὰκ καὶ ὁ θεὸς Ἰακώβ; οὐκ ἔστιν ⸂ὁ θεὸς⸃ νεκρῶν ἀλλὰ ζώντων."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "καὶ ἀκούσαντες οἱ ὄχλοι ἐξεπλήσσοντο ἐπὶ τῇ διδαχῇ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "Οἱ δὲ Φαρισαῖοι ἀκούσαντες ὅτι ἐφίμωσεν τοὺς Σαδδουκαίους συνήχθησαν ἐπὶ τὸ αὐτό."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "καὶ ἐπηρώτησεν εἷς ἐξ αὐτῶν νομικὸς πειράζων ⸀αὐτόν",
          {
            "noteId": 582
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "Διδάσκαλε, ποία ἐντολὴ μεγάλη ἐν τῷ νόμῳ;"
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "ὁ ⸀δὲ",
          {
            "noteId": 583
          },
          "ἔφη αὐτῷ· Ἀγαπήσεις κύριον τὸν θεόν σου ἐν ὅλῃ ⸀τῇ",
          {
            "noteId": 584
          },
          "καρδίᾳ σου καὶ ἐν ὅλῃ ⸁τῇ",
          {
            "noteId": 585
          },
          "ψυχῇ σου καὶ ἐν ὅλῃ τῇ διανοίᾳ σου·"
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "αὕτη ἐστὶν ⸂ἡ μεγάλη καὶ πρώτη",
          {
            "noteId": 586
          },
          "ἐντολή."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "Δευτέρα ⸀δὲ",
          {
            "noteId": 587
          },
          "ὁμοία ⸀αὐτῇ",
          {
            "noteId": 588
          },
          "Ἀγαπήσεις τὸν πλησίον σου ὡς σεαυτόν."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "ἐν ταύταις ταῖς δυσὶν ἐντολαῖς ὅλος ὁ νόμος ⸂κρέμαται καὶ οἱ προφῆται",
          {
            "noteId": 589
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "Συνηγμένων δὲ τῶν Φαρισαίων ἐπηρώτησεν αὐτοὺς ὁ Ἰησοῦς"
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "λέγων· Τί ὑμῖν δοκεῖ περὶ τοῦ χριστοῦ; τίνος υἱός ἐστιν; λέγουσιν αὐτῷ· Τοῦ Δαυίδ."
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "λέγει αὐτοῖς· Πῶς οὖν Δαυὶδ ἐν πνεύματι ⸂καλεῖ αὐτὸν κύριον",
          {
            "noteId": 590
          },
          "λέγων·"
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "⸀Εἶπεν",
          {
            "noteId": 591
          },
          "κύριος τῷ κυρίῳ μου· Κάθου ἐκ δεξιῶν μου ἕως ἂν θῶ τοὺς ἐχθρούς σου ⸀ὑποκάτω",
          {
            "noteId": 592
          },
          "τῶν ποδῶν σου;"
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "εἰ οὖν Δαυὶδ καλεῖ αὐτὸν κύριον, πῶς υἱὸς αὐτοῦ ἐστιν;"
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "καὶ οὐδεὶς ἐδύνατο ⸂ἀποκριθῆναι αὐτῷ",
          {
            "noteId": 593
          },
          "λόγον, οὐδὲ ἐτόλμησέν τις ἀπʼ ἐκείνης τῆς ἡμέρας ἐπερωτῆσαι αὐτὸν οὐκέτι."
        ]
      }
    ],
