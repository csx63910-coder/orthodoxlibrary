  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἐν δὲ ταῖς ἡμέραις ἐκείναις παραγίνεται Ἰωάννης ὁ βαπτιστὴς κηρύσσων ἐν τῇ ἐρήμῳ τῆς Ἰουδαίας"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "⸀καὶ",
          {
            "noteId": 24
          },
          "λέγων· Μετανοεῖτε, ἤγγικεν γὰρ ἡ βασιλεία τῶν οὐρανῶν."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "οὗτος γάρ ἐστιν ὁ ῥηθεὶς ⸀διὰ",
          {
            "noteId": 25
          },
          "Ἠσαΐου τοῦ προφήτου λέγοντος· Φωνὴ βοῶντος ἐν τῇ ἐρήμῳ· Ἑτοιμάσατε τὴν ὁδὸν κυρίου, εὐθείας ποιεῖτε τὰς τρίβους αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "αὐτὸς δὲ ὁ Ἰωάννης εἶχεν τὸ ἔνδυμα αὐτοῦ ἀπὸ τριχῶν καμήλου καὶ ζώνην δερματίνην περὶ τὴν ὀσφὺν αὐτοῦ, ἡ δὲ τροφὴ ⸂ἦν αὐτοῦ",
          {
            "noteId": 26
          },
          "ἀκρίδες καὶ μέλι ἄγριον."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "τότε ἐξεπορεύετο πρὸς αὐτὸν Ἱεροσόλυμα καὶ πᾶσα ἡ Ἰουδαία καὶ πᾶσα ἡ περίχωρος τοῦ Ἰορδάνου,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ ἐβαπτίζοντο ἐν τῷ Ἰορδάνῃ ⸀ποταμῷ",
          {
            "noteId": 27
          },
          "ὑπʼ αὐτοῦ ἐξομολογούμενοι τὰς ἁμαρτίας αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ἰδὼν δὲ πολλοὺς τῶν Φαρισαίων καὶ Σαδδουκαίων ἐρχομένους ἐπὶ τὸ βάπτισμα ⸀αὐτοῦ",
          {
            "noteId": 28
          },
          "εἶπεν αὐτοῖς· Γεννήματα ἐχιδνῶν, τίς ὑπέδειξεν ὑμῖν φυγεῖν ἀπὸ τῆς μελλούσης ὀργῆς;"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ποιήσατε οὖν καρπὸν ἄξιον τῆς μετανοίας"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ μὴ δόξητε λέγειν ἐν ἑαυτοῖς· Πατέρα ἔχομεν τὸν Ἀβραάμ, λέγω γὰρ ὑμῖν ὅτι δύναται ὁ θεὸς ἐκ τῶν λίθων τούτων ἐγεῖραι τέκνα τῷ Ἀβραάμ."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἤδη ⸀δὲ",
          {
            "noteId": 29
          },
          "ἡ ἀξίνη πρὸς τὴν ῥίζαν τῶν δένδρων κεῖται· πᾶν οὖν δένδρον μὴ ποιοῦν καρπὸν καλὸν ἐκκόπτεται καὶ εἰς πῦρ βάλλεται."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ἐγὼ μὲν ⸂ὑμᾶς βαπτίζω",
          {
            "noteId": 30
          },
          "ἐν ὕδατι εἰς μετάνοιαν· ὁ δὲ ὀπίσω μου ἐρχόμενος ἰσχυρότερός μού ἐστιν, οὗ οὐκ εἰμὶ ἱκανὸς τὰ ὑποδήματα βαστάσαι· αὐτὸς ὑμᾶς βαπτίσει ἐν πνεύματι ἁγίῳ ⸂καὶ πυρί",
          {
            "noteId": 31
          },
          "·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "οὗ τὸ πτύον ἐν τῇ χειρὶ αὐτοῦ, καὶ διακαθαριεῖ τὴν ἅλωνα αὐτοῦ καὶ συνάξει τὸν σῖτον αὐτοῦ εἰς τὴν ⸀ἀποθήκην",
          {
            "noteId": 32
          },
          "τὸ δὲ ἄχυρον κατακαύσει πυρὶ ἀσβέστῳ."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Τότε παραγίνεται ὁ Ἰησοῦς ἀπὸ τῆς Γαλιλαίας ἐπὶ τὸν Ἰορδάνην πρὸς τὸν Ἰωάννην τοῦ βαπτισθῆναι ὑπʼ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ὁ δὲ ⸀Ἰωάννης",
          {
            "noteId": 33
          },
          "διεκώλυεν αὐτὸν λέγων· Ἐγὼ χρείαν ἔχω ὑπὸ σοῦ βαπτισθῆναι, καὶ σὺ ἔρχῃ πρός με;"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ἀποκριθεὶς δὲ ὁ Ἰησοῦς εἶπεν ⸂πρὸς αὐτόν",
          {
            "noteId": 34
          },
          "· Ἄφες ἄρτι, οὕτως γὰρ πρέπον ἐστὶν ἡμῖν πληρῶσαι πᾶσαν δικαιοσύνην. τότε ἀφίησιν αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "⸂βαπτισθεὶς δὲ",
          {
            "noteId": 35
          },
          "ὁ Ἰησοῦς ⸂εὐθὺς ἀνέβη",
          {
            "noteId": 36
          },
          "ἀπὸ τοῦ ὕδατος· καὶ ἰδοὺ ⸀ἠνεῴχθησαν",
          {
            "noteId": 37
          },
          "οἱ οὐρανοί, καὶ εἶδεν ⸀πνεῦμα",
          {
            "noteId": 38
          },
          "θεοῦ καταβαῖνον ὡσεὶ ⸀περιστερὰν ἐρχόμενον ἐπʼ αὐτόν·",
          {
            "noteId": 39
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καὶ ἰδοὺ φωνὴ ἐκ τῶν οὐρανῶν λέγουσα· Οὗτός ἐστιν ὁ υἱός μου ὁ ἀγαπητός, ἐν ᾧ εὐδόκησα."
        ]
      }
    ],
