  "chapter": {
    "number": 23,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Τότε ὁ Ἰησοῦς ἐλάλησεν τοῖς ὄχλοις καὶ τοῖς μαθηταῖς αὐτοῦ"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "λέγων· Ἐπὶ τῆς Μωϋσέως καθέδρας ἐκάθισαν οἱ γραμματεῖς καὶ οἱ Φαρισαῖοι."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "πάντα οὖν ὅσα ⸀ἐὰν",
          {
            "noteId": 594
          },
          "εἴπωσιν ὑμῖν ⸂ποιήσατε καὶ τηρεῖτε",
          {
            "noteId": 595
          },
          ", κατὰ δὲ τὰ ἔργα αὐτῶν μὴ ποιεῖτε, λέγουσιν γὰρ καὶ οὐ ποιοῦσιν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "δεσμεύουσιν ⸀δὲ",
          {
            "noteId": 596
          },
          "φορτία ⸀βαρέα",
          {
            "noteId": 597
          },
          "καὶ ἐπιτιθέασιν ἐπὶ τοὺς ὤμους τῶν ἀνθρώπων, ⸂αὐτοὶ δὲ τῷ",
          {
            "noteId": 598
          },
          "δακτύλῳ αὐτῶν οὐ θέλουσιν κινῆσαι αὐτά."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "πάντα δὲ τὰ ἔργα αὐτῶν ποιοῦσιν πρὸς τὸ θεαθῆναι τοῖς ἀνθρώποις· πλατύνουσι ⸀γὰρ",
          {
            "noteId": 599
          },
          "τὰ φυλακτήρια αὐτῶν καὶ μεγαλύνουσι τὰ ⸀κράσπεδα",
          {
            "noteId": 600
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "φιλοῦσι ⸀δὲ",
          {
            "noteId": 601
          },
          "τὴν πρωτοκλισίαν ἐν τοῖς δείπνοις καὶ τὰς πρωτοκαθεδρίας ἐν ταῖς συναγωγαῖς"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "καὶ τοὺς ἀσπασμοὺς ἐν ταῖς ἀγοραῖς καὶ καλεῖσθαι ὑπὸ τῶν ἀνθρώπων· ⸀Ῥαββί",
          {
            "noteId": 602
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ὑμεῖς δὲ μὴ κληθῆτε· Ῥαββί, εἷς γάρ ἐστιν ὑμῶν ὁ ⸀διδάσκαλος",
          {
            "noteId": 603
          },
          "πάντες δὲ ὑμεῖς ἀδελφοί ἐστε·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ πατέρα μὴ καλέσητε ὑμῶν ἐπὶ τῆς γῆς, εἷς γάρ ἐστιν ⸂ὑμῶν ὁ πατὴρ",
          {
            "noteId": 604
          },
          "ὁ ⸀οὐράνιος",
          {
            "noteId": 605
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "μηδὲ κληθῆτε καθηγηταί, ⸂ὅτι καθηγητὴς ὑμῶν ἐστιν εἷς",
          {
            "noteId": 606
          },
          "ὁ χριστός·"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ὁ δὲ μείζων ὑμῶν ἔσται ὑμῶν διάκονος."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ὅστις δὲ ὑψώσει ἑαυτὸν ταπεινωθήσεται, καὶ ὅστις ταπεινώσει ἑαυτὸν ⸀ὑψωθήσεται",
          {
            "noteId": 607
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Οὐαὶ ⸀δὲ",
          {
            "noteId": 608
          },
          "ὑμῖν, γραμματεῖς καὶ Φαρισαῖοι ὑποκριταί, ὅτι κλείετε τὴν βασιλείαν τῶν οὐρανῶν ἔμπροσθεν τῶν ἀνθρώπων· ὑμεῖς γὰρ οὐκ εἰσέρχεσθε, οὐδὲ τοὺς εἰσερχομένους ἀφίετε ⸀εἰσελθεῖν",
          {
            "noteId": 609
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Οὐαὶ ὑμῖν, γραμματεῖς καὶ Φαρισαῖοι ὑποκριταί, ὅτι περιάγετε τὴν θάλασσαν καὶ τὴν ξηρὰν ποιῆσαι ἕνα προσήλυτον, καὶ ὅταν γένηται ποιεῖτε αὐτὸν υἱὸν γεέννης διπλότερον ὑμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Οὐαὶ ὑμῖν, ὁδηγοὶ τυφλοὶ οἱ λέγοντες· Ὃς ἂν ὀμόσῃ ἐν τῷ ναῷ, οὐδέν ἐστιν, ὃς δʼ ἂν ὀμόσῃ ἐν τῷ χρυσῷ τοῦ ναοῦ ὀφείλει."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "μωροὶ καὶ τυφλοί, τίς γὰρ μείζων ἐστίν, ὁ χρυσὸς ἢ ὁ ναὸς ὁ ⸀ἁγιάσας",
          {
            "noteId": 610
          },
          "τὸν χρυσόν;"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καί· Ὃς ⸀ἂν",
          {
            "noteId": 611
          },
          "ὀμόσῃ ἐν τῷ θυσιαστηρίῳ, οὐδέν ἐστιν, ὃς δʼ ἂν ὀμόσῃ ἐν τῷ δώρῳ τῷ ἐπάνω αὐτοῦ ὀφείλει."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "⸀τυφλοί",
          {
            "noteId": 612
          },
          "τί γὰρ μεῖζον, τὸ δῶρον ἢ τὸ θυσιαστήριον τὸ ἁγιάζον τὸ δῶρον;"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ὁ οὖν ὀμόσας ἐν τῷ θυσιαστηρίῳ ὀμνύει ἐν αὐτῷ καὶ ἐν πᾶσι τοῖς ἐπάνω αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "καὶ ὁ ὀμόσας ἐν τῷ ναῷ ὀμνύει ἐν αὐτῷ καὶ ἐν τῷ ⸀κατοικοῦντι",
          {
            "noteId": 613
          },
          "αὐτόν·"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "καὶ ὁ ὀμόσας ἐν τῷ οὐρανῷ ὀμνύει ἐν τῷ θρόνῳ τοῦ θεοῦ καὶ ἐν τῷ καθημένῳ ἐπάνω αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Οὐαὶ ὑμῖν, γραμματεῖς καὶ Φαρισαῖοι ὑποκριταί, ὅτι ἀποδεκατοῦτε τὸ ἡδύοσμον καὶ τὸ ἄνηθον καὶ τὸ κύμινον, καὶ ἀφήκατε τὰ βαρύτερα τοῦ νόμου, τὴν κρίσιν καὶ ⸂τὸ ἔλεος",
          {
            "noteId": 614
          },
          "καὶ τὴν πίστιν· ⸀ταῦτα",
          {
            "noteId": 615
          },
          "ἔδει ποιῆσαι κἀκεῖνα μὴ ⸀ἀφιέναι",
          {
            "noteId": 616
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ὁδηγοὶ τυφλοί, ⸀οἱ",
          {
            "noteId": 617
          },
          "διϋλίζοντες τὸν κώνωπα τὴν δὲ κάμηλον καταπίνοντες."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Οὐαὶ ὑμῖν, γραμματεῖς καὶ Φαρισαῖοι ὑποκριταί, ὅτι καθαρίζετε τὸ ἔξωθεν τοῦ ποτηρίου καὶ τῆς παροψίδος, ἔσωθεν δὲ γέμουσιν ἐξ ἁρπαγῆς καὶ ⸀ἀκρασίας",
          {
            "noteId": 618
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Φαρισαῖε τυφλέ, καθάρισον πρῶτον τὸ ἐντὸς τοῦ ποτηρίου ⸂καὶ τῆς παροψίδος",
          {
            "noteId": 619
          },
          ", ἵνα γένηται καὶ τὸ ἐκτὸς ⸀αὐτοῦ",
          {
            "noteId": 620
          },
          "καθαρόν."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Οὐαὶ ὑμῖν, γραμματεῖς καὶ Φαρισαῖοι ὑποκριταί, ὅτι ⸀παρομοιάζετε",
          {
            "noteId": 621
          },
          "τάφοις κεκονιαμένοις, οἵτινες ἔξωθεν μὲν φαίνονται ὡραῖοι ἔσωθεν δὲ γέμουσιν ὀστέων νεκρῶν καὶ πάσης ἀκαθαρσίας·"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "οὕτως καὶ ὑμεῖς ἔξωθεν μὲν φαίνεσθε τοῖς ἀνθρώποις δίκαιοι, ἔσωθεν δέ ⸂ἐστε μεστοὶ",
          {
            "noteId": 622
          },
          "ὑποκρίσεως καὶ ἀνομίας."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Οὐαὶ ὑμῖν, γραμματεῖς καὶ Φαρισαῖοι ὑποκριταί, ὅτι οἰκοδομεῖτε τοὺς τάφους τῶν προφητῶν καὶ κοσμεῖτε τὰ μνημεῖα τῶν δικαίων,"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "καὶ λέγετε· Εἰ ⸀ἤμεθα",
          {
            "noteId": 623
          },
          "ἐν ταῖς ἡμέραις τῶν πατέρων ἡμῶν, οὐκ ἂν ⸁ἤμεθα",
          {
            "noteId": 624
          },
          "⸂αὐτῶν κοινωνοὶ",
          {
            "noteId": 625
          },
          "ἐν τῷ αἵματι τῶν προφητῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "ὥστε μαρτυρεῖτε ἑαυτοῖς ὅτι υἱοί ἐστε τῶν φονευσάντων τοὺς προφήτας."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "καὶ ὑμεῖς πληρώσατε τὸ μέτρον τῶν πατέρων ὑμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "ὄφεις γεννήματα ἐχιδνῶν, πῶς φύγητε ἀπὸ τῆς κρίσεως τῆς γεέννης;"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "διὰ τοῦτο ἰδοὺ ἐγὼ ἀποστέλλω πρὸς ὑμᾶς προφήτας καὶ σοφοὺς καὶ γραμματεῖς· ⸀ἐξ",
          {
            "noteId": 626
          },
          "αὐτῶν ἀποκτενεῖτε καὶ σταυρώσετε, καὶ ἐξ αὐτῶν μαστιγώσετε ἐν ταῖς συναγωγαῖς ὑμῶν καὶ διώξετε ἀπὸ πόλεως εἰς πόλιν·"
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "ὅπως ἔλθῃ ἐφʼ ὑμᾶς πᾶν αἷμα δίκαιον ἐκχυννόμενον ἐπὶ τῆς γῆς ἀπὸ τοῦ αἵματος Ἅβελ τοῦ δικαίου ἕως τοῦ αἵματος Ζαχαρίου υἱοῦ Βαραχίου, ὃν ἐφονεύσατε μεταξὺ τοῦ ναοῦ καὶ τοῦ θυσιαστηρίου."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "ἀμὴν λέγω ὑμῖν, ⸀ἥξει",
          {
            "noteId": 627
          },
          "⸂ταῦτα πάντα",
          {
            "noteId": 628
          },
          "ἐπὶ τὴν γενεὰν ταύτην."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "Ἰερουσαλὴμ Ἰερουσαλήμ, ἡ ⸀ἀποκτείνουσα",
          {
            "noteId": 629
          },
          "τοὺς προφήτας καὶ λιθοβολοῦσα τοὺς ἀπεσταλμένους πρὸς αὐτήν— ποσάκις ἠθέλησα ἐπισυναγαγεῖν τὰ τέκνα σου, ὃν τρόπον ⸂ὄρνις ἐπισυνάγει",
          {
            "noteId": 630
          },
          "τὰ νοσσία ⸀αὐτῆς",
          {
            "noteId": 631
          },
          "ὑπὸ τὰς πτέρυγας, καὶ οὐκ ἠθελήσατε;"
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "ἰδοὺ ἀφίεται ὑμῖν ὁ οἶκος ὑμῶν ⸀ἔρημος",
          {
            "noteId": 632
          }
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "λέγω γὰρ ὑμῖν, οὐ μή με ἴδητε ἀπʼ ἄρτι ἕως ἂν εἴπητε· Εὐλογημένος ὁ ἐρχόμενος ἐν ὀνόματι κυρίου."
        ]
      }
    ],
