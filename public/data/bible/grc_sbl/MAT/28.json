  "chapter": {
    "number": 28,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ὀψὲ δὲ σαββάτων, τῇ ἐπιφωσκούσῃ εἰς μίαν σαββάτων, ἦλθεν ⸀Μαριὰμ",
          {
            "noteId": 808
          },
          "ἡ Μαγδαληνὴ καὶ ἡ ἄλλη Μαρία θεωρῆσαι τὸν τάφον."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ",
          {
            "noteId": 809
          },
          "ἰδοὺ σεισμὸς ἐγένετο μέγας· ἄγγελος γὰρ κυρίου καταβὰς ἐξ οὐρανοῦ ⸀καὶ προσελθὼν ἀπεκύλισε τὸν ⸀λίθον",
          {
            "noteId": 810
          },
          "καὶ ἐκάθητο ἐπάνω αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἦν δὲ ἡ εἰδέα αὐτοῦ ⸀ὡς",
          {
            "noteId": 811
          },
          "ἀστραπὴ καὶ τὸ ἔνδυμα αὐτοῦ λευκὸν ὡς χιών."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἀπὸ δὲ τοῦ φόβου αὐτοῦ ἐσείσθησαν οἱ τηροῦντες καὶ ἐγενήθησαν ⸀ὡς",
          {
            "noteId": 812
          },
          "νεκροί."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἀποκριθεὶς δὲ ὁ ἄγγελος εἶπεν ταῖς γυναιξίν· Μὴ φοβεῖσθε ὑμεῖς, οἶδα γὰρ ὅτι Ἰησοῦν τὸν ἐσταυρωμένον ζητεῖτε·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "οὐκ ἔστιν ὧδε, ἠγέρθη γὰρ καθὼς εἶπεν· δεῦτε ἴδετε τὸν τόπον ὅπου ⸀ἔκειτο",
          {
            "noteId": 813
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "καὶ ταχὺ πορευθεῖσαι εἴπατε τοῖς μαθηταῖς αὐτοῦ ὅτι Ἠγέρθη ἀπὸ τῶν νεκρῶν, καὶ ἰδοὺ προάγει ὑμᾶς εἰς τὴν Γαλιλαίαν, ἐκεῖ αὐτὸν ὄψεσθε· ἰδοὺ εἶπον ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ ⸀ἀπελθοῦσαι",
          {
            "noteId": 814
          },
          "ταχὺ ἀπὸ τοῦ μνημείου μετὰ φόβου καὶ χαρᾶς μεγάλης ἔδραμον ἀπαγγεῖλαι τοῖς μαθηταῖς αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "⸀καὶ",
          {
            "noteId": 815
          },
          "⸀ἰδοὺ",
          {
            "noteId": 816
          },
          "Ἰησοῦς ⸀ὑπήντησεν",
          {
            "noteId": 817
          },
          "αὐταῖς λέγων· Χαίρετε· αἱ δὲ προσελθοῦσαι ἐκράτησαν αὐτοῦ τοὺς πόδας καὶ προσεκύνησαν αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "τότε λέγει αὐταῖς ὁ Ἰησοῦς· Μὴ φοβεῖσθε· ὑπάγετε ἀπαγγείλατε τοῖς ἀδελφοῖς μου ἵνα ἀπέλθωσιν εἰς τὴν Γαλιλαίαν, κἀκεῖ με ὄψονται."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Πορευομένων δὲ αὐτῶν ἰδού τινες τῆς κουστωδίας ἐλθόντες εἰς τὴν πόλιν ἀπήγγειλαν τοῖς ἀρχιερεῦσιν ἅπαντα τὰ γενόμενα."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "καὶ συναχθέντες μετὰ τῶν πρεσβυτέρων συμβούλιόν τε λαβόντες ἀργύρια ἱκανὰ ἔδωκαν τοῖς στρατιώταις"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "λέγοντες· Εἴπατε ὅτι Οἱ μαθηταὶ αὐτοῦ νυκτὸς ἐλθόντες ἔκλεψαν αὐτὸν ἡμῶν κοιμωμένων·"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καὶ ἐὰν ἀκουσθῇ τοῦτο ⸀ἐπὶ",
          {
            "noteId": 818
          },
          "τοῦ ἡγεμόνος, ἡμεῖς πείσομεν ⸀αὐτὸν",
          {
            "noteId": 819
          },
          "καὶ ὑμᾶς ἀμερίμνους ποιήσομεν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "οἱ δὲ λαβόντες ⸀τὰ",
          {
            "noteId": 820
          },
          "ἀργύρια ἐποίησαν ὡς ἐδιδάχθησαν. Καὶ διεφημίσθη ὁ λόγος οὗτος παρὰ Ἰουδαίοις μέχρι τῆς σήμερον ⸀ἡμέρας",
          {
            "noteId": 821
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Οἱ δὲ ἕνδεκα μαθηταὶ ἐπορεύθησαν εἰς τὴν Γαλιλαίαν εἰς τὸ ὄρος οὗ ἐτάξατο αὐτοῖς ὁ Ἰησοῦς,"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καὶ ἰδόντες αὐτὸν ⸀προσεκύνησαν",
          {
            "noteId": 822
          },
          "οἱ δὲ ἐδίστασαν."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ προσελθὼν ὁ Ἰησοῦς ἐλάλησεν αὐτοῖς λέγων· Ἐδόθη μοι πᾶσα ἐξουσία ἐν οὐρανῷ καὶ ἐπὶ ⸀τῆς",
          {
            "noteId": 823
          },
          "γῆς·"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "πορευθέντες ⸀οὖν",
          {
            "noteId": 824
          },
          "μαθητεύσατε πάντα τὰ ἔθνη, ⸀βαπτίζοντες",
          {
            "noteId": 825
          },
          "αὐτοὺς εἰς τὸ ὄνομα τοῦ πατρὸς καὶ τοῦ υἱοῦ καὶ τοῦ ἁγίου πνεύματος,"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "διδάσκοντες αὐτοὺς τηρεῖν πάντα ὅσα ἐνετειλάμην ὑμῖν· καὶ ἰδοὺ ἐγὼ μεθʼ ὑμῶν εἰμι πάσας τὰς ἡμέρας ἕως τῆς συντελείας τοῦ ⸀αἰῶνος",
          {
            "noteId": 826
          },
          "‘p /’ ‘/book’"
        ]
      }
    ],
