  "chapter": {
    "number": 16,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ προσελθόντες οἱ Φαρισαῖοι καὶ Σαδδουκαῖοι πειράζοντες ἐπηρώτησαν αὐτὸν σημεῖον ἐκ τοῦ οὐρανοῦ ἐπιδεῖξαι αὐτοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ὁ δὲ ἀποκριθεὶς εἶπεν αὐτοῖς· ⸂Ὀψίας γενομένης λέγετε· Εὐδία, πυρράζει γὰρ ὁ οὐρανός·",
          {
            "noteId": 352
          },
          {
            "noteId": 353
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ πρωΐ· Σήμερον χειμών, πυρράζει γὰρ στυγνάζων ὁ οὐρανός. ⸀τὸ μὲν πρόσωπον τοῦ οὐρανοῦ γινώσκετε διακρίνειν, τὰ δὲ σημεῖα τῶν καιρῶν οὐ δύνασθε.⸃"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Γενεὰ πονηρὰ καὶ μοιχαλὶς σημεῖον ἐπιζητεῖ, καὶ σημεῖον οὐ δοθήσεται αὐτῇ εἰ μὴ τὸ σημεῖον ⸀Ἰωνᾶ",
          {
            "noteId": 354
          },
          "καὶ καταλιπὼν αὐτοὺς ἀπῆλθεν."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Καὶ ἐλθόντες οἱ ⸀μαθηταὶ",
          {
            "noteId": 355
          },
          "εἰς τὸ πέραν ἐπελάθοντο ἄρτους λαβεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ὁ δὲ Ἰησοῦς εἶπεν αὐτοῖς· Ὁρᾶτε καὶ προσέχετε ἀπὸ τῆς ζύμης τῶν Φαρισαίων καὶ Σαδδουκαίων."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "οἱ δὲ διελογίζοντο ἐν ἑαυτοῖς λέγοντες ὅτι Ἄρτους οὐκ ἐλάβομεν."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "γνοὺς δὲ ὁ Ἰησοῦς ⸀εἶπεν",
          {
            "noteId": 356
          },
          "Τί διαλογίζεσθε ἐν ἑαυτοῖς, ὀλιγόπιστοι, ὅτι ἄρτους οὐκ ⸀ἐλάβετε",
          {
            "noteId": 357
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "οὔπω νοεῖτε, οὐδὲ μνημονεύετε τοὺς πέντε ἄρτους τῶν πεντακισχιλίων καὶ πόσους κοφίνους ἐλάβετε;"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "οὐδὲ τοὺς ἑπτὰ ἄρτους τῶν τετρακισχιλίων καὶ πόσας σπυρίδας ἐλάβετε;"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "πῶς οὐ νοεῖτε ὅτι οὐ περὶ ⸀ἄρτων",
          {
            "noteId": 358
          },
          "εἶπον ὑμῖν; ⸂προσέχετε δὲ",
          {
            "noteId": 359
          },
          "ἀπὸ τῆς ζύμης τῶν Φαρισαίων καὶ Σαδδουκαίων."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "τότε συνῆκαν ὅτι οὐκ εἶπεν προσέχειν ἀπὸ τῆς ζύμης ⸂τῶν ἄρτων",
          {
            "noteId": 360
          },
          "ἀλλὰ ἀπὸ τῆς διδαχῆς τῶν Φαρισαίων καὶ Σαδδουκαίων."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ἐλθὼν δὲ ὁ Ἰησοῦς εἰς τὰ μέρη Καισαρείας τῆς Φιλίππου ἠρώτα τοὺς μαθητὰς αὐτοῦ λέγων· ⸀Τίνα",
          {
            "noteId": 361
          },
          "λέγουσιν οἱ ἄνθρωποι εἶναι τὸν υἱὸν τοῦ ἀνθρώπου;"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "οἱ δὲ εἶπαν· Οἱ μὲν Ἰωάννην τὸν βαπτιστήν, ἄλλοι δὲ Ἠλίαν, ἕτεροι δὲ Ἰερεμίαν ἢ ἕνα τῶν προφητῶν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "λέγει αὐτοῖς· Ὑμεῖς δὲ τίνα με λέγετε εἶναι;"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ἀποκριθεὶς δὲ Σίμων Πέτρος εἶπεν· Σὺ εἶ ὁ χριστὸς ὁ υἱὸς τοῦ θεοῦ τοῦ ζῶντος."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "⸂ἀποκριθεὶς δὲ",
          {
            "noteId": 362
          },
          "ὁ Ἰησοῦς εἶπεν αὐτῷ· Μακάριος εἶ, Σίμων Βαριωνᾶ, ὅτι σὰρξ καὶ αἷμα οὐκ ἀπεκάλυψέν σοι ἀλλʼ ὁ πατήρ μου ὁ ἐν τοῖς οὐρανοῖς·"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "κἀγὼ δέ σοι λέγω ὅτι σὺ εἶ Πέτρος, καὶ ἐπὶ ταύτῃ τῇ πέτρᾳ οἰκοδομήσω μου τὴν ἐκκλησίαν, καὶ πύλαι ᾅδου οὐ κατισχύσουσιν αὐτῆς·"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "⸀δώσω",
          {
            "noteId": 363
          },
          "σοι τὰς ⸀κλεῖδας",
          {
            "noteId": 364
          },
          "τῆς βασιλείας τῶν οὐρανῶν, καὶ ὃ ⸀ἐὰν",
          {
            "noteId": 365
          },
          "δήσῃς ἐπὶ τῆς γῆς ἔσται δεδεμένον ἐν τοῖς οὐρανοῖς, καὶ ὃ ⸁ἐὰν",
          {
            "noteId": 366
          },
          "λύσῃς ἐπὶ τῆς γῆς ἔσται λελυμένον ἐν τοῖς οὐρανοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "τότε ⸀διεστείλατο",
          {
            "noteId": 367
          },
          "τοῖς ⸀μαθηταῖς",
          {
            "noteId": 368
          },
          "ἵνα μηδενὶ εἴπωσιν ὅτι αὐτός ⸀ἐστιν",
          {
            "noteId": 369
          },
          "ὁ χριστός."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Ἀπὸ τότε ἤρξατο ⸂ὁ Ἰησοῦς",
          {
            "noteId": 370
          },
          "δεικνύειν τοῖς μαθηταῖς αὐτοῦ ὅτι δεῖ αὐτὸν ⸂εἰς Ἱεροσόλυμα ἀπελθεῖν",
          {
            "noteId": 371
          },
          "καὶ πολλὰ παθεῖν ἀπὸ τῶν πρεσβυτέρων καὶ ἀρχιερέων καὶ γραμματέων καὶ ἀποκτανθῆναι καὶ τῇ τρίτῃ ἡμέρᾳ ἐγερθῆναι."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "καὶ προσλαβόμενος αὐτὸν ὁ Πέτρος ἤρξατο ἐπιτιμᾶν αὐτῷ λέγων· Ἵλεώς σοι, κύριε· οὐ μὴ ἔσται σοι τοῦτο."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ὁ δὲ στραφεὶς εἶπεν τῷ Πέτρῳ· Ὕπαγε ὀπίσω μου, Σατανᾶ· σκάνδαλον ⸂εἶ ἐμοῦ",
          {
            "noteId": 372
          },
          ", ὅτι οὐ φρονεῖς τὰ τοῦ θεοῦ ἀλλὰ τὰ τῶν ἀνθρώπων."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Τότε ὁ Ἰησοῦς εἶπεν τοῖς μαθηταῖς αὐτοῦ· Εἴ τις θέλει ὀπίσω μου ἐλθεῖν, ἀπαρνησάσθω ἑαυτὸν καὶ ἀράτω τὸν σταυρὸν αὐτοῦ καὶ ἀκολουθείτω μοι."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ὃς γὰρ ⸀ἐὰν",
          {
            "noteId": 373
          },
          "θέλῃ τὴν ψυχὴν αὐτοῦ σῶσαι ἀπολέσει αὐτήν· ὃς δʼ ἂν ἀπολέσῃ τὴν ψυχὴν αὐτοῦ ἕνεκεν ἐμοῦ εὑρήσει αὐτήν."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "τί γὰρ ⸀ὠφεληθήσεται",
          {
            "noteId": 374
          },
          "ἄνθρωπος ἐὰν τὸν κόσμον ὅλον κερδήσῃ τὴν δὲ ψυχὴν αὐτοῦ ζημιωθῇ; ἢ τί δώσει ἄνθρωπος ἀντάλλαγμα τῆς ψυχῆς αὐτοῦ;"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "μέλλει γὰρ ὁ υἱὸς τοῦ ἀνθρώπου ἔρχεσθαι ἐν τῇ δόξῃ τοῦ πατρὸς αὐτοῦ μετὰ τῶν ἀγγέλων αὐτοῦ, καὶ τότε ἀποδώσει ἑκάστῳ κατὰ τὴν πρᾶξιν αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ἀμὴν λέγω ὑμῖν ⸀ὅτι",
          {
            "noteId": 375
          },
          "εἰσίν τινες ⸂τῶν ὧδε ἑστώτων",
          {
            "noteId": 376
          },
          "οἵτινες οὐ μὴ γεύσωνται θανάτου ἕως ἂν ἴδωσιν τὸν υἱὸν τοῦ ἀνθρώπου ἐρχόμενον ἐν τῇ βασιλείᾳ αὐτοῦ."
        ]
      }
    ],
