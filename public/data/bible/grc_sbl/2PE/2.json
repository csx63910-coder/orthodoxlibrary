    "totalNumberOfVerses": 61
  },
  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἐγένοντο δὲ καὶ ψευδοπροφῆται ἐν τῷ λαῷ, ὡς καὶ ἐν ὑμῖν ἔσονται ψευδοδιδάσκαλοι, οἵτινες παρεισάξουσιν αἱρέσεις ἀπωλείας, καὶ τὸν ἀγοράσαντα αὐτοὺς δεσπότην ἀρνούμενοι, ἐπάγοντες ἑαυτοῖς ταχινὴν ἀπώλειαν·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ πολλοὶ ἐξακολουθήσουσιν αὐτῶν ταῖς ἀσελγείαις, διʼ οὓς ἡ ὁδὸς τῆς ἀληθείας βλασφημηθήσεται·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ ἐν πλεονεξίᾳ πλαστοῖς λόγοις ὑμᾶς ἐμπορεύσονται· οἷς τὸ κρίμα ἔκπαλαι οὐκ ἀργεῖ, καὶ ἡ ἀπώλεια αὐτῶν οὐ ⸀νυστάζει",
          {
            "noteId": 10
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Εἰ γὰρ ὁ θεὸς ἀγγέλων ἁμαρτησάντων οὐκ ἐφείσατο, ἀλλὰ ⸀σειραῖς",
          {
            "noteId": 11
          },
          "ζόφου ταρταρώσας παρέδωκεν εἰς κρίσιν τηρουμένους,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ ἀρχαίου κόσμου οὐκ ἐφείσατο, ἀλλὰ ὄγδοον Νῶε δικαιοσύνης κήρυκα ἐφύλαξεν, κατακλυσμὸν κόσμῳ ἀσεβῶν ἐπάξας,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ πόλεις Σοδόμων καὶ Γομόρρας τεφρώσας ⸀καταστροφῇ",
          {
            "noteId": 12
          },
          "κατέκρινεν, ὑπόδειγμα μελλόντων ⸀ἀσεβέσιν",
          {
            "noteId": 13
          },
          "τεθεικώς,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "καὶ δίκαιον Λὼτ καταπονούμενον ὑπὸ τῆς τῶν ἀθέσμων ἐν ἀσελγείᾳ ἀναστροφῆς ἐρρύσατο—"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "βλέμματι γὰρ καὶ ἀκοῇ ⸀ὁ",
          {
            "noteId": 14
          },
          "δίκαιος ἐγκατοικῶν ἐν αὐτοῖς ἡμέραν ἐξ ἡμέρας ψυχὴν δικαίαν ἀνόμοις ἔργοις ἐβασάνιζεν—"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "οἶδεν κύριος εὐσεβεῖς ἐκ πειρασμοῦ ῥύεσθαι, ἀδίκους δὲ εἰς ἡμέραν κρίσεως κολαζομένους τηρεῖν,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "μάλιστα δὲ τοὺς ὀπίσω σαρκὸς ἐν ἐπιθυμίᾳ μιασμοῦ πορευομένους καὶ κυριότητος καταφρονοῦντας. Τολμηταί, αὐθάδεις, δόξας οὐ τρέμουσιν, βλασφημοῦντες,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ὅπου ἄγγελοι ἰσχύϊ καὶ δυνάμει μείζονες ὄντες οὐ φέρουσιν κατʼ ⸀αὐτῶν",
          {
            "noteId": 15
          },
          "βλάσφημον κρίσιν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "οὗτοι δέ, ὡς ἄλογα ζῷα ⸂γεγεννημένα φυσικὰ",
          {
            "noteId": 16
          },
          "εἰς ἅλωσιν καὶ φθοράν, ἐν οἷς ἀγνοοῦσιν βλασφημοῦντες, ἐν τῇ φθορᾷ αὐτῶν ⸂καὶ φθαρήσονται",
          {
            "noteId": 17
          },
          ","
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "⸀ἀδικούμενοι",
          {
            "noteId": 18
          },
          "μισθὸν ἀδικίας· ἡδονὴν ἡγούμενοι τὴν ἐν ἡμέρᾳ τρυφήν, σπίλοι καὶ μῶμοι ἐντρυφῶντες ἐν ταῖς ⸀ἀπάταις",
          {
            "noteId": 19
          },
          "αὐτῶν συνευωχούμενοι ὑμῖν,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ὀφθαλμοὺς ἔχοντες μεστοὺς μοιχαλίδος καὶ ⸀ἀκαταπαύστους",
          {
            "noteId": 20
          },
          "ἁμαρτίας, δελεάζοντες ψυχὰς ἀστηρίκτους, καρδίαν γεγυμνασμένην πλεονεξίας ἔχοντες, κατάρας τέκνα,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "⸀καταλιπόντες",
          {
            "noteId": 21
          },
          "εὐθεῖαν ὁδὸν ἐπλανήθησαν, ἐξακολουθήσαντες τῇ ὁδῷ τοῦ Βαλαὰμ τοῦ ⸀Βοσὸρ",
          {
            "noteId": 22
          },
          "ὃς μισθὸν ἀδικίας ἠγάπησεν"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ἔλεγξιν δὲ ἔσχεν ἰδίας παρανομίας· ὑποζύγιον ἄφωνον ἐν ἀνθρώπου φωνῇ φθεγξάμενον ἐκώλυσεν τὴν τοῦ προφήτου παραφρονίαν."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Οὗτοί εἰσιν πηγαὶ ἄνυδροι ⸂καὶ ὁμίχλαι",
          {
            "noteId": 23
          },
          "ὑπὸ λαίλαπος ἐλαυνόμεναι, οἷς ὁ ζόφος τοῦ ⸀σκότους",
          {
            "noteId": 24
          },
          "τετήρηται."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ὑπέρογκα γὰρ ματαιότητος φθεγγόμενοι δελεάζουσιν ἐν ἐπιθυμίαις σαρκὸς ἀσελγείαις τοὺς ⸀ὀλίγως",
          {
            "noteId": 25
          },
          "⸀ἀποφεύγοντας",
          {
            "noteId": 26
          },
          "τοὺς ἐν πλάνῃ ἀναστρεφομένους,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἐλευθερίαν αὐτοῖς ἐπαγγελλόμενοι, αὐτοὶ δοῦλοι ὑπάρχοντες τῆς φθορᾶς· ᾧ γάρ τις ἥττηται, τούτῳ ⸀καὶ",
          {
            "noteId": 27
          },
          "δεδούλωται."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "εἰ γὰρ ἀποφυγόντες τὰ μιάσματα τοῦ κόσμου ἐν ἐπιγνώσει τοῦ ⸀κυρίου",
          {
            "noteId": 28
          },
          "καὶ σωτῆρος Ἰησοῦ Χριστοῦ τούτοις δὲ πάλιν ἐμπλακέντες ἡττῶνται, γέγονεν αὐτοῖς τὰ ἔσχατα χείρονα τῶν πρώτων."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "κρεῖττον γὰρ ἦν αὐτοῖς μὴ ἐπεγνωκέναι τὴν ὁδὸν τῆς δικαιοσύνης ἢ ἐπιγνοῦσιν ⸀ὑποστρέψαι",
          {
            "noteId": 29
          },
          "ἐκ τῆς παραδοθείσης αὐτοῖς ἁγίας ἐντολῆς·"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "⸀συμβέβηκεν",
          {
            "noteId": 30
          },
          "αὐτοῖς τὸ τῆς ἀληθοῦς παροιμίας· Κύων ἐπιστρέψας ἐπὶ τὸ ἴδιον ἐξέραμα, καί· Ὗς λουσαμένη εἰς ⸀κυλισμὸν",
          {
            "noteId": 31
          },
          "βορβόρου."
        ]
      }
    ],
