  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ταύτην ἤδη, ἀγαπητοί, δευτέραν ὑμῖν γράφω ἐπιστολήν, ἐν αἷς διεγείρω ὑμῶν ἐν ὑπομνήσει τὴν εἰλικρινῆ διάνοιαν,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "μνησθῆναι τῶν προειρημένων ῥημάτων ὑπὸ τῶν ἁγίων προφητῶν καὶ τῆς τῶν ἀποστόλων ὑμῶν ἐντολῆς τοῦ κυρίου καὶ σωτῆρος,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "τοῦτο πρῶτον γινώσκοντες ὅτι ἐλεύσονται ἐπʼ ⸀ἐσχάτων",
          {
            "noteId": 32
          },
          "τῶν ἡμερῶν ⸂ἐν ἐμπαιγμονῇ",
          {
            "noteId": 33
          },
          "ἐμπαῖκται κατὰ τὰς ἰδίας ἐπιθυμίας αὐτῶν πορευόμενοι"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ λέγοντες· Ποῦ ἐστιν ἡ ἐπαγγελία τῆς παρουσίας αὐτοῦ; ἀφʼ ἧς γὰρ οἱ πατέρες ἐκοιμήθησαν, πάντα οὕτως διαμένει ἀπʼ ἀρχῆς κτίσεως."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "λανθάνει γὰρ αὐτοὺς τοῦτο θέλοντας ὅτι οὐρανοὶ ἦσαν ἔκπαλαι καὶ γῆ ἐξ ὕδατος καὶ διʼ ὕδατος συνεστῶσα τῷ τοῦ θεοῦ λόγῳ,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "⸂διʼ ὧν",
          {
            "noteId": 34
          },
          "ὁ τότε κόσμος ὕδατι κατακλυσθεὶς ἀπώλετο·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "οἱ δὲ νῦν οὐρανοὶ καὶ ἡ γῆ τῷ ⸀αὐτῷ",
          {
            "noteId": 35
          },
          "λόγῳ τεθησαυρισμένοι εἰσὶν πυρὶ τηρούμενοι εἰς ἡμέραν κρίσεως καὶ ἀπωλείας τῶν ἀσεβῶν ἀνθρώπων."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Ἓν δὲ τοῦτο μὴ λανθανέτω ὑμᾶς, ἀγαπητοί, ὅτι μία ἡμέρα παρὰ κυρίῳ ὡς χίλια ἔτη καὶ χίλια ἔτη ὡς ἡμέρα μία."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "οὐ βραδύνει ⸀κύριος",
          {
            "noteId": 36
          },
          "τῆς ἐπαγγελίας, ὥς τινες βραδύτητα ἡγοῦνται, ἀλλὰ μακροθυμεῖ εἰς ⸀ὑμᾶς",
          {
            "noteId": 37
          },
          "μὴ βουλόμενός τινας ἀπολέσθαι ἀλλὰ πάντας εἰς μετάνοιαν χωρῆσαι."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἥξει δὲ ⸀ἡμέρα",
          {
            "noteId": 38
          },
          "κυρίου ὡς ⸀κλέπτης",
          {
            "noteId": 39
          },
          "ἐν ᾗ οἱ οὐρανοὶ ῥοιζηδὸν παρελεύσονται, στοιχεῖα δὲ καυσούμενα ⸀λυθήσεται",
          {
            "noteId": 40
          },
          "καὶ γῆ καὶ τὰ ἐν αὐτῇ ἔργα ⸀εὑρεθήσεται",
          {
            "noteId": 41
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Τούτων ⸀οὕτως",
          {
            "noteId": 42
          },
          "πάντων λυομένων ποταποὺς δεῖ ὑπάρχειν ὑμᾶς ἐν ἁγίαις ἀναστροφαῖς καὶ εὐσεβείαις,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "προσδοκῶντας καὶ σπεύδοντας τὴν παρουσίαν τῆς τοῦ θεοῦ ἡμέρας, διʼ ἣν οὐρανοὶ πυρούμενοι λυθήσονται καὶ στοιχεῖα καυσούμενα τήκεται·"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καινοὺς δὲ οὐρανοὺς καὶ γῆν καινὴν κατὰ τὸ ἐπάγγελμα αὐτοῦ προσδοκῶμεν, ἐν οἷς δικαιοσύνη κατοικεῖ."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Διό, ἀγαπητοί, ταῦτα προσδοκῶντες σπουδάσατε ἄσπιλοι καὶ ἀμώμητοι αὐτῷ εὑρεθῆναι ἐν εἰρήνῃ,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ τὴν τοῦ κυρίου ἡμῶν μακροθυμίαν σωτηρίαν ἡγεῖσθε, καθὼς καὶ ὁ ἀγαπητὸς ἡμῶν ἀδελφὸς Παῦλος κατὰ τὴν ⸂δοθεῖσαν αὐτῷ",
          {
            "noteId": 43
          },
          "σοφίαν ἔγραψεν ὑμῖν,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ὡς καὶ ἐν πάσαις ⸀ταῖς",
          {
            "noteId": 44
          },
          "ἐπιστολαῖς λαλῶν ἐν αὐταῖς περὶ τούτων, ἐν ⸀αἷς",
          {
            "noteId": 45
          },
          "ἐστιν δυσνόητά τινα, ἃ οἱ ἀμαθεῖς καὶ ἀστήρικτοι ⸀στρεβλοῦσιν",
          {
            "noteId": 46
          },
          "ὡς καὶ τὰς λοιπὰς γραφὰς πρὸς τὴν ἰδίαν αὐτῶν ἀπώλειαν."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ὑμεῖς οὖν, ἀγαπητοί, προγινώσκοντες φυλάσσεσθε ἵνα μὴ τῇ τῶν ἀθέσμων πλάνῃ συναπαχθέντες ἐκπέσητε τοῦ ἰδίου στηριγμοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "αὐξάνετε δὲ ἐν χάριτι καὶ γνώσει τοῦ κυρίου ἡμῶν καὶ σωτῆρος Ἰησοῦ Χριστοῦ. αὐτῷ ἡ δόξα καὶ νῦν καὶ εἰς ἡμέραν αἰῶνος. ⸀ἀμήν",
          {
            "noteId": 47
          },
          "‘p /’ ‘/book’"
        ]
      }
    ],
