  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Παῦλος δέσμιος Χριστοῦ Ἰησοῦ καὶ Τιμόθεος ὁ ἀδελφὸς Φιλήμονι τῷ ἀγαπητῷ καὶ συνεργῷ ἡμῶν"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ Ἀπφίᾳ τῇ ⸀ἀδελφῇ",
          {
            "noteId": 0
          },
          "καὶ Ἀρχίππῳ τῷ συστρατιώτῃ ἡμῶν καὶ τῇ κατʼ οἶκόν σου ἐκκλησίᾳ·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "χάρις ὑμῖν καὶ εἰρήνη ἀπὸ θεοῦ πατρὸς ἡμῶν καὶ κυρίου Ἰησοῦ Χριστοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Εὐχαριστῶ τῷ θεῷ μου πάντοτε μνείαν σου ποιούμενος ἐπὶ τῶν προσευχῶν μου,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἀκούων σου τὴν ἀγάπην καὶ τὴν πίστιν ἣν ἔχεις ⸀πρὸς",
          {
            "noteId": 1
          },
          "τὸν κύριον Ἰησοῦν καὶ εἰς πάντας τοὺς ἁγίους,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ὅπως ἡ κοινωνία τῆς πίστεώς σου ἐνεργὴς γένηται ἐν ἐπιγνώσει παντὸς ἀγαθοῦ ⸀τοῦ",
          {
            "noteId": 2
          },
          "ἐν ἡμῖν εἰς ⸀Χριστόν",
          {
            "noteId": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "⸀χαρὰν",
          {
            "noteId": 4
          },
          "γὰρ ⸂πολλὴν ἔσχον",
          {
            "noteId": 5
          },
          "καὶ παράκλησιν ἐπὶ τῇ ἀγάπῃ σου, ὅτι τὰ σπλάγχνα τῶν ἁγίων ἀναπέπαυται διὰ σοῦ, ἀδελφέ."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Διό, πολλὴν ἐν Χριστῷ παρρησίαν ἔχων ἐπιτάσσειν σοι τὸ ἀνῆκον,"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "διὰ τὴν ἀγάπην μᾶλλον παρακαλῶ, τοιοῦτος ὢν ὡς Παῦλος πρεσβύτης νυνὶ δὲ καὶ δέσμιος ⸂Χριστοῦ Ἰησοῦ",
          {
            "noteId": 6
          },
          "—"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "παρακαλῶ σε περὶ τοῦ ἐμοῦ τέκνου, ὃν ἐγέννησα ἐν τοῖς ⸀δεσμοῖς",
          {
            "noteId": 7
          },
          "Ὀνήσιμον,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "τόν ποτέ σοι ἄχρηστον νυνὶ ⸀δὲ",
          {
            "noteId": 8
          },
          "σοὶ καὶ ἐμοὶ εὔχρηστον,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ὃν ἀνέπεμψά ⸂σοι αὐτόν, τοῦτʼ ἔστιν τὰ ἐμὰ σπλάγχνα",
          {
            "noteId": 9
          },
          "·"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ὃν ἐγὼ ἐβουλόμην πρὸς ἐμαυτὸν κατέχειν, ἵνα ὑπὲρ σοῦ ⸂μοι διακονῇ",
          {
            "noteId": 10
          },
          "ἐν τοῖς δεσμοῖς τοῦ εὐαγγελίου,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "χωρὶς δὲ τῆς σῆς γνώμης οὐδὲν ἠθέλησα ποιῆσαι, ἵνα μὴ ὡς κατὰ ἀνάγκην τὸ ἀγαθόν σου ᾖ ἀλλὰ κατὰ ἑκούσιον·"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "τάχα γὰρ διὰ τοῦτο ἐχωρίσθη πρὸς ὥραν ἵνα αἰώνιον αὐτὸν ἀπέχῃς,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "οὐκέτι ὡς δοῦλον ἀλλὰ ὑπὲρ δοῦλον, ἀδελφὸν ἀγαπητόν, μάλιστα ἐμοί, πόσῳ δὲ μᾶλλον σοὶ καὶ ἐν σαρκὶ καὶ ἐν κυρίῳ."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Εἰ οὖν με ἔχεις κοινωνόν, προσλαβοῦ αὐτὸν ὡς ἐμέ."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "εἰ δέ τι ἠδίκησέν σε ἢ ὀφείλει, τοῦτο ἐμοὶ ⸀ἐλλόγα",
          {
            "noteId": 11
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἐγὼ Παῦλος ἔγραψα τῇ ἐμῇ χειρί, ἐγὼ ἀποτίσω· ἵνα μὴ λέγω σοι ὅτι καὶ σεαυτόν μοι προσοφείλεις."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ναί, ἀδελφέ, ἐγώ σου ὀναίμην ἐν κυρίῳ· ἀνάπαυσόν μου τὰ σπλάγχνα ἐν ⸀Χριστῷ",
          {
            "noteId": 12
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "πεποιθὼς τῇ ὑπακοῇ σου ἔγραψά σοι, εἰδὼς ὅτι καὶ ὑπὲρ ⸀ἃ",
          {
            "noteId": 13
          },
          "λέγω ποιήσεις."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ἅμα δὲ καὶ ἑτοίμαζέ μοι ξενίαν, ἐλπίζω γὰρ ὅτι διὰ τῶν προσευχῶν ὑμῶν χαρισθήσομαι ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "⸀Ἀσπάζεταί",
          {
            "noteId": 14
          },
          "σε Ἐπαφρᾶς ὁ συναιχμάλωτός μου ἐν Χριστῷ Ἰησοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Μᾶρκος, Ἀρίσταρχος, Δημᾶς, Λουκᾶς, οἱ συνεργοί μου."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Ἡ χάρις τοῦ ⸀κυρίου",
          {
            "noteId": 15
          },
          "Ἰησοῦ Χριστοῦ μετὰ τοῦ πνεύματος ⸀ὑμῶν",
          {
            "noteId": 16
          },
          "‘p /’ ‘/book’"
        ]
      }
    ],
