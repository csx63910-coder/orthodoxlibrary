  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἄγε νῦν οἱ πλούσιοι, κλαύσατε ὀλολύζοντες ἐπὶ ταῖς ταλαιπωρίαις ὑμῶν ταῖς ἐπερχομέναις."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ὁ πλοῦτος ὑμῶν σέσηπεν, καὶ τὰ ἱμάτια ὑμῶν σητόβρωτα γέγονεν,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ὁ χρυσὸς ὑμῶν καὶ ὁ ἄργυρος κατίωται, καὶ ὁ ἰὸς αὐτῶν εἰς μαρτύριον ὑμῖν ἔσται καὶ φάγεται τὰς σάρκας ὑμῶν· ὡς πῦρ ἐθησαυρίσατε ἐν ἐσχάταις ἡμέραις."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἰδοὺ ὁ μισθὸς τῶν ἐργατῶν τῶν ἀμησάντων τὰς χώρας ὑμῶν ὁ ⸀ἀφυστερημένος",
          {
            "noteId": 75
          },
          "ἀφʼ ὑμῶν κράζει, καὶ αἱ βοαὶ τῶν θερισάντων εἰς τὰ ὦτα Κυρίου Σαβαὼθ ⸀εἰσεληλύθασιν",
          {
            "noteId": 76
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἐτρυφήσατε ἐπὶ τῆς γῆς καὶ ἐσπαταλήσατε, ἐθρέψατε τὰς καρδίας ⸀ὑμῶν",
          {
            "noteId": 77
          },
          "ἐν ἡμέρᾳ σφαγῆς."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "κατεδικάσατε, ἐφονεύσατε τὸν δίκαιον. οὐκ ἀντιτάσσεται ὑμῖν;"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Μακροθυμήσατε οὖν, ἀδελφοί, ἕως τῆς παρουσίας τοῦ κυρίου. ἰδοὺ ὁ γεωργὸς ἐκδέχεται τὸν τίμιον καρπὸν τῆς γῆς, μακροθυμῶν ἐπʼ ⸀αὐτῷ",
          {
            "noteId": 78
          },
          "ἕως ⸀λάβῃ",
          {
            "noteId": 79
          },
          "πρόϊμον καὶ ὄψιμον."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "μακροθυμήσατε καὶ ὑμεῖς, στηρίξατε τὰς καρδίας ὑμῶν, ὅτι ἡ παρουσία τοῦ κυρίου ἤγγικεν."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "μὴ στενάζετε, ⸂ἀδελφοί, κατʼ ἀλλήλων⸃, ἵνα μὴ κριθῆτε· ἰδοὺ ὁ κριτὴς πρὸ τῶν θυρῶν ἕστηκεν.",
          {
            "noteId": 80
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ὑπόδειγμα λάβετε, ⸀ἀδελφοί",
          {
            "noteId": 81
          },
          "τῆς κακοπαθίας καὶ τῆς μακροθυμίας τοὺς προφήτας, οἳ ἐλάλησαν ⸀ἐν",
          {
            "noteId": 82
          },
          "τῷ ὀνόματι κυρίου."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ἰδοὺ μακαρίζομεν τοὺς ⸀ὑπομείναντας",
          {
            "noteId": 83
          },
          "τὴν ὑπομονὴν Ἰὼβ ἠκούσατε, καὶ τὸ τέλος κυρίου ⸀εἴδετε",
          {
            "noteId": 84
          },
          "ὅτι πολύσπλαγχνός ἐστιν ⸂ὁ κύριος",
          {
            "noteId": 85
          },
          "καὶ οἰκτίρμων."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Πρὸ πάντων δέ, ἀδελφοί μου, μὴ ὀμνύετε, μήτε τὸν οὐρανὸν μήτε τὴν γῆν μήτε ἄλλον τινὰ ὅρκον· ἤτω δὲ ὑμῶν τὸ Ναὶ ναὶ καὶ τὸ Οὒ οὔ, ἵνα μὴ ⸂ὑπὸ κρίσιν",
          {
            "noteId": 86
          },
          "πέσητε."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Κακοπαθεῖ τις ἐν ὑμῖν; προσευχέσθω· εὐθυμεῖ τις; ψαλλέτω."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἀσθενεῖ τις ἐν ὑμῖν; προσκαλεσάσθω τοὺς πρεσβυτέρους τῆς ἐκκλησίας, καὶ προσευξάσθωσαν ἐπʼ αὐτὸν",
          {
            "noteId": 87
          },
          "ἀλείψαντες ⸀αὐτὸν ἐλαίῳ ἐν τῷ ὀνόματι τοῦ κυρίου·"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ ἡ εὐχὴ τῆς πίστεως σώσει τὸν κάμνοντα, καὶ ἐγερεῖ αὐτὸν ὁ κύριος· κἂν ἁμαρτίας ᾖ πεποιηκώς, ἀφεθήσεται αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ἐξομολογεῖσθε ⸀οὖν",
          {
            "noteId": 88
          },
          "ἀλλήλοις ⸂τὰς ἁμαρτίας",
          {
            "noteId": 89
          },
          "καὶ ⸀εὔχεσθε",
          {
            "noteId": 90
          },
          "ὑπὲρ ἀλλήλων, ὅπως ἰαθῆτε. πολὺ ἰσχύει δέησις δικαίου ἐνεργουμένη."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Ἠλίας ἄνθρωπος ἦν ὁμοιοπαθὴς ἡμῖν, καὶ προσευχῇ προσηύξατο τοῦ μὴ βρέξαι, καὶ οὐκ ἔβρεξεν ἐπὶ τῆς γῆς ἐνιαυτοὺς τρεῖς καὶ μῆνας ἕξ·"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ πάλιν προσηύξατο, καὶ ὁ οὐρανὸς ⸂ὑετὸν ἔδωκεν",
          {
            "noteId": 91
          },
          "καὶ ἡ γῆ ἐβλάστησεν τὸν καρπὸν αὐτῆς."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Ἀδελφοί ⸀μου",
          {
            "noteId": 92
          },
          "ἐάν τις ἐν ὑμῖν πλανηθῇ ἀπὸ τῆς ἀληθείας καὶ ἐπιστρέψῃ τις αὐτόν,"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "⸀γινωσκέτω",
          {
            "noteId": 93
          },
          "ὅτι ὁ ἐπιστρέψας ἁμαρτωλὸν ἐκ πλάνης ὁδοῦ αὐτοῦ",
          {
            "noteId": 94
          },
          "σώσει ψυχὴν ⸀αὐτοῦ ἐκ θανάτου καὶ καλύψει πλῆθος ἁμαρτιῶν. ‘p /’ ‘/book’"
        ]
      }
    ],
