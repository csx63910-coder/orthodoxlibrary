  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Πόθεν πόλεμοι καὶ ⸀πόθεν",
          {
            "noteId": 49
          },
          "μάχαι ἐν ὑμῖν; οὐκ ἐντεῦθεν, ἐκ τῶν ἡδονῶν ὑμῶν τῶν στρατευομένων ἐν τοῖς μέλεσιν ὑμῶν;"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἐπιθυμεῖτε, καὶ οὐκ ἔχετε· φονεύετε καὶ ζηλοῦτε, καὶ οὐ δύνασθε ἐπιτυχεῖν· μάχεσθε καὶ πολεμεῖτε. οὐκ ἔχετε διὰ τὸ μὴ αἰτεῖσθαι ὑμᾶς·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "αἰτεῖτε καὶ οὐ λαμβάνετε, διότι κακῶς αἰτεῖσθε, ἵνα ἐν ταῖς ἡδοναῖς ὑμῶν δαπανήσητε."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "⸀μοιχαλίδες",
          {
            "noteId": 50
          },
          "οὐκ οἴδατε ὅτι ἡ φιλία τοῦ κόσμου ἔχθρα τοῦ θεοῦ ἐστιν; ὃς ⸀ἐὰν",
          {
            "noteId": 51
          },
          "οὖν βουληθῇ φίλος εἶναι τοῦ κόσμου, ἐχθρὸς τοῦ θεοῦ καθίσταται."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἢ δοκεῖτε ὅτι κενῶς ἡ γραφὴ λέγει· Πρὸς φθόνον ἐπιποθεῖ τὸ πνεῦμα ὃ ⸀κατῴκισεν",
          {
            "noteId": 52
          },
          "ἐν ἡμῖν;"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "μείζονα δὲ δίδωσιν χάριν· διὸ λέγει· Ὁ θεὸς ὑπερηφάνοις ἀντιτάσσεται ταπεινοῖς δὲ δίδωσιν χάριν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ὑποτάγητε οὖν τῷ θεῷ· ἀντίστητε δὲ τῷ διαβόλῳ, καὶ φεύξεται ἀφʼ ὑμῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἐγγίσατε τῷ θεῷ, καὶ ⸀ἐγγιεῖ",
          {
            "noteId": 53
          },
          "ὑμῖν. καθαρίσατε χεῖρας, ἁμαρτωλοί, καὶ ἁγνίσατε καρδίας, δίψυχοι."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ταλαιπωρήσατε καὶ πενθήσατε καὶ κλαύσατε· ὁ γέλως ὑμῶν εἰς πένθος ⸀μετατραπήτω",
          {
            "noteId": 54
          },
          "καὶ ἡ χαρὰ εἰς κατήφειαν·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ταπεινώθητε ἐνώπιον ⸀κυρίου",
          {
            "noteId": 55
          },
          "καὶ ὑψώσει ὑμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Μὴ καταλαλεῖτε ἀλλήλων, ἀδελφοί· ὁ καταλαλῶν ἀδελφοῦ ⸀ἢ",
          {
            "noteId": 56
          },
          "κρίνων τὸν ἀδελφὸν αὐτοῦ καταλαλεῖ νόμου καὶ κρίνει νόμον· εἰ δὲ νόμον κρίνεις, οὐκ εἶ ποιητὴς νόμου ἀλλὰ κριτής."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "εἷς ⸀ἐστιν",
          {
            "noteId": 57
          },
          "νομοθέτης ⸂καὶ κριτής",
          {
            "noteId": 58
          },
          ", ὁ δυνάμενος σῶσαι καὶ ἀπολέσαι· σὺ δὲ τίς εἶ, ⸂ὁ κρίνων",
          {
            "noteId": 59
          },
          "τὸν ⸀πλησίον",
          {
            "noteId": 60
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ἄγε νῦν οἱ λέγοντες· Σήμερον ⸀ἢ",
          {
            "noteId": 61
          },
          "αὔριον ⸀πορευσόμεθα",
          {
            "noteId": 62
          },
          "εἰς τήνδε τὴν πόλιν καὶ ⸀ποιήσομεν",
          {
            "noteId": 63
          },
          "ἐκεῖ ⸀ἐνιαυτὸν",
          {
            "noteId": 64
          },
          "καὶ ⸀ἐμπορευσόμεθα",
          {
            "noteId": 65
          },
          "καὶ ⸀κερδήσομεν",
          {
            "noteId": 66
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "οἵτινες οὐκ ἐπίστασθε ⸀τὸ",
          {
            "noteId": 67
          },
          "τῆς αὔριον ⸀ποία",
          {
            "noteId": 68
          },
          "ἡ ζωὴ ὑμῶν· ἀτμὶς γάρ ⸀ἐστε",
          {
            "noteId": 69
          },
          "⸀ἡ",
          {
            "noteId": 70
          },
          "πρὸς ὀλίγον φαινομένη, ⸀ἔπειτα",
          {
            "noteId": 71
          },
          "καὶ ἀφανιζομένη·"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ἀντὶ τοῦ λέγειν ὑμᾶς· Ἐὰν ὁ κύριος ⸀θελήσῃ",
          {
            "noteId": 72
          },
          "καὶ ⸀ζήσομεν",
          {
            "noteId": 73
          },
          "καὶ ⸀ποιήσομεν",
          {
            "noteId": 74
          },
          "τοῦτο ἢ ἐκεῖνο."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "νῦν δὲ καυχᾶσθε ἐν ταῖς ἀλαζονείαις ὑμῶν· πᾶσα καύχησις τοιαύτη πονηρά ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "εἰδότι οὖν καλὸν ποιεῖν καὶ μὴ ποιοῦντι, ἁμαρτία αὐτῷ ἐστιν."
        ]
      }
    ],
