  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἀδελφοί μου, μὴ ἐν προσωπολημψίαις ἔχετε τὴν πίστιν τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ τῆς δόξης;"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἐὰν γὰρ εἰσέλθῃ ⸀εἰς",
          {
            "noteId": 11
          },
          "συναγωγὴν ὑμῶν ἀνὴρ χρυσοδακτύλιος ἐν ἐσθῆτι λαμπρᾷ, εἰσέλθῃ δὲ καὶ πτωχὸς ἐν ῥυπαρᾷ ἐσθῆτι,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "⸂ἐπιβλέψητε δὲ",
          {
            "noteId": 12
          },
          "ἐπὶ τὸν φοροῦντα τὴν ἐσθῆτα τὴν λαμπρὰν καὶ ⸀εἴπητε",
          {
            "noteId": 13
          },
          "Σὺ κάθου ὧδε καλῶς, καὶ τῷ πτωχῷ εἴπητε· Σὺ στῆθι ⸂ἢ κάθου ἐκεῖ",
          {
            "noteId": 14
          },
          "ὑπὸ τὸ ὑποπόδιόν μου,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "⸀οὐ",
          {
            "noteId": 15
          },
          "διεκρίθητε ἐν ἑαυτοῖς καὶ ἐγένεσθε κριταὶ διαλογισμῶν πονηρῶν;"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἀκούσατε, ἀδελφοί μου ἀγαπητοί. οὐχ ὁ θεὸς ἐξελέξατο τοὺς πτωχοὺς ⸂τῷ κόσμῳ",
          {
            "noteId": 16
          },
          "πλουσίους ἐν πίστει καὶ κληρονόμους τῆς βασιλείας ἧς ἐπηγγείλατο τοῖς ἀγαπῶσιν αὐτόν;"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ὑμεῖς δὲ ἠτιμάσατε τὸν πτωχόν. οὐχ οἱ πλούσιοι καταδυναστεύουσιν ὑμῶν, καὶ αὐτοὶ ἕλκουσιν ὑμᾶς εἰς κριτήρια;"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "οὐκ αὐτοὶ βλασφημοῦσιν τὸ καλὸν ὄνομα τὸ ἐπικληθὲν ἐφʼ ὑμᾶς;"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Εἰ μέντοι νόμον τελεῖτε βασιλικὸν κατὰ τὴν γραφήν Ἀγαπήσεις τὸν πλησίον σου ὡς σεαυτόν, καλῶς ποιεῖτε·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "εἰ δὲ προσωπολημπτεῖτε, ἁμαρτίαν ἐργάζεσθε, ἐλεγχόμενοι ὑπὸ τοῦ νόμου ὡς παραβάται."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ὅστις γὰρ ὅλον τὸν νόμον ⸂τηρήσῃ, πταίσῃ⸃ δὲ ἐν ἑνί, γέγονεν πάντων ἔνοχος.",
          {
            "noteId": 17
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ὁ γὰρ εἰπών· Μὴ ⸀μοιχεύσῃς",
          {
            "noteId": 18
          },
          "εἶπεν καί· Μὴ ⸀φονεύσῃς",
          {
            "noteId": 19
          },
          "εἰ δὲ οὐ ⸂μοιχεύεις φονεύεις",
          {
            "noteId": 20
          },
          "δέ, γέγονας παραβάτης νόμου."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "οὕτως λαλεῖτε καὶ οὕτως ποιεῖτε ὡς διὰ νόμου ἐλευθερίας μέλλοντες κρίνεσθαι."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ἡ γὰρ κρίσις ἀνέλεος τῷ μὴ ποιήσαντι ἔλεος",
          {
            "noteId": 21
          },
          "κατακαυχᾶται ⸀ἔλεος κρίσεως."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "⸀Τί",
          {
            "noteId": 22
          },
          "ὄφελος, ἀδελφοί μου, ἐὰν πίστιν λέγῃ τις ἔχειν ἔργα δὲ μὴ ἔχῃ; μὴ δύναται ἡ πίστις σῶσαι αὐτόν;"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "⸀ἐὰν",
          {
            "noteId": 23
          },
          "ἀδελφὸς ἢ ἀδελφὴ γυμνοὶ ὑπάρχωσιν καὶ ⸀λειπόμενοι",
          {
            "noteId": 24
          },
          "τῆς ἐφημέρου τροφῆς,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "εἴπῃ δέ τις αὐτοῖς ἐξ ὑμῶν· Ὑπάγετε ἐν εἰρήνῃ, θερμαίνεσθε καὶ χορτάζεσθε, μὴ δῶτε δὲ αὐτοῖς τὰ ἐπιτήδεια τοῦ σώματος, ⸀τί",
          {
            "noteId": 25
          },
          "ὄφελος;"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "οὕτως καὶ ἡ πίστις, ἐὰν μὴ ⸂ἔχῃ ἔργα",
          {
            "noteId": 26
          },
          ", νεκρά ἐστιν καθʼ ἑαυτήν."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Ἀλλʼ ἐρεῖ τις· Σὺ πίστιν ἔχεις κἀγὼ ἔργα ἔχω. δεῖξόν μοι τὴν πίστιν σου ⸀χωρὶς",
          {
            "noteId": 27
          },
          "τῶν ⸀ἔργων",
          {
            "noteId": 28
          },
          "κἀγώ ⸂σοι δείξω",
          {
            "noteId": 29
          },
          "ἐκ τῶν ἔργων μου τὴν ⸀πίστιν",
          {
            "noteId": 30
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "σὺ πιστεύεις ὅτι ⸂εἷς ἐστιν ὁ θεός",
          {
            "noteId": 31
          },
          "; καλῶς ποιεῖς· καὶ τὰ δαιμόνια πιστεύουσιν καὶ φρίσσουσιν."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "θέλεις δὲ γνῶναι, ὦ ἄνθρωπε κενέ, ὅτι ἡ πίστις χωρὶς τῶν ἔργων ⸀ἀργή",
          {
            "noteId": 32
          },
          "ἐστιν;"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Ἀβραὰμ ὁ πατὴρ ἡμῶν οὐκ ἐξ ἔργων ἐδικαιώθη, ἀνενέγκας Ἰσαὰκ τὸν υἱὸν αὐτοῦ ἐπὶ τὸ θυσιαστήριον;"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "βλέπεις ὅτι ἡ πίστις συνήργει τοῖς ἔργοις αὐτοῦ καὶ ἐκ τῶν ἔργων ἡ πίστις ἐτελειώθη,"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "καὶ ἐπληρώθη ἡ γραφὴ ἡ λέγουσα· Ἐπίστευσεν δὲ Ἀβραὰμ τῷ θεῷ, καὶ ἐλογίσθη αὐτῷ εἰς δικαιοσύνην, καὶ φίλος θεοῦ ἐκλήθη."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "⸀ὁρᾶτε",
          {
            "noteId": 33
          },
          "ὅτι ἐξ ἔργων δικαιοῦται ἄνθρωπος καὶ οὐκ ἐκ πίστεως μόνον."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ὁμοίως δὲ καὶ Ῥαὰβ ἡ πόρνη οὐκ ἐξ ἔργων ἐδικαιώθη, ὑποδεξαμένη τοὺς ἀγγέλους καὶ ἑτέρᾳ ὁδῷ ἐκβαλοῦσα;"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ὥσπερ ⸀γὰρ",
          {
            "noteId": 34
          },
          "τὸ σῶμα χωρὶς",
          {
            "noteId": 35
          },
          "πνεύματος νεκρόν ἐστιν, οὕτως καὶ ἡ πίστις ⸀χωρὶς ἔργων νεκρά ἐστιν."
        ]
      }
    ],
