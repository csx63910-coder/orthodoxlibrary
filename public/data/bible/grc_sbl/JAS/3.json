  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Μὴ πολλοὶ διδάσκαλοι γίνεσθε, ἀδελφοί μου, εἰδότες ὅτι μεῖζον κρίμα λημψόμεθα·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "πολλὰ γὰρ πταίομεν ἅπαντες. εἴ τις ἐν λόγῳ οὐ πταίει, οὗτος τέλειος ἀνήρ, δυνατὸς χαλιναγωγῆσαι καὶ ὅλον τὸ σῶμα."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "⸂εἰ δὲ",
          {
            "noteId": 36
          },
          "τῶν ἵππων τοὺς χαλινοὺς εἰς",
          {
            "noteId": 37
          },
          "τὰ στόματα βάλλομεν ⸀εἰς τὸ πείθεσθαι αὐτοὺς ἡμῖν, καὶ ὅλον τὸ σῶμα αὐτῶν μετάγομεν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἰδοὺ καὶ τὰ πλοῖα, τηλικαῦτα ὄντα καὶ ὑπὸ ⸂ἀνέμων σκληρῶν",
          {
            "noteId": 38
          },
          "ἐλαυνόμενα, μετάγεται ὑπὸ ἐλαχίστου πηδαλίου ὅπου ⸂ἡ ὁρμὴ τοῦ εὐθύνοντος βούλεται",
          {
            "noteId": 39
          },
          "·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "οὕτως καὶ ἡ γλῶσσα μικρὸν μέλος ἐστὶν καὶ ⸂μεγάλα αὐχεῖ",
          {
            "noteId": 40
          },
          ".",
          {
            "noteId": 41
          },
          "Ἰδοὺ ⸀ἡλίκον πῦρ ἡλίκην ὕλην ἀνάπτει·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ ἡ γλῶσσα πῦρ, ὁ κόσμος τῆς ⸀ἀδικίας",
          {
            "noteId": 42
          },
          "ἡ γλῶσσα καθίσταται ἐν τοῖς μέλεσιν ἡμῶν, ἡ σπιλοῦσα ὅλον τὸ σῶμα καὶ φλογίζουσα τὸν τροχὸν τῆς γενέσεως καὶ φλογιζομένη ὑπὸ τῆς γεέννης."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "πᾶσα γὰρ φύσις θηρίων τε καὶ πετεινῶν ἑρπετῶν τε καὶ ἐναλίων δαμάζεται καὶ δεδάμασται τῇ φύσει τῇ ἀνθρωπίνῃ·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "τὴν δὲ γλῶσσαν οὐδεὶς ⸂δαμάσαι δύναται ἀνθρώπων",
          {
            "noteId": 43
          },
          "· ⸀ἀκατάστατον",
          {
            "noteId": 44
          },
          "κακόν, μεστὴ ἰοῦ θανατηφόρου."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ἐν αὐτῇ εὐλογοῦμεν τὸν ⸀κύριον",
          {
            "noteId": 45
          },
          "καὶ πατέρα, καὶ ἐν αὐτῇ καταρώμεθα τοὺς ἀνθρώπους τοὺς καθʼ ὁμοίωσιν θεοῦ γεγονότας·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἐκ τοῦ αὐτοῦ στόματος ἐξέρχεται εὐλογία καὶ κατάρα. οὐ χρή, ἀδελφοί μου, ταῦτα οὕτως γίνεσθαι."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "μήτι ἡ πηγὴ ἐκ τῆς αὐτῆς ὀπῆς βρύει τὸ γλυκὺ καὶ τὸ πικρόν;"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "μὴ δύναται, ἀδελφοί μου, συκῆ ἐλαίας ποιῆσαι ἢ ἄμπελος σῦκα; ⸂οὔτε ἁλυκὸν",
          {
            "noteId": 46
          },
          "γλυκὺ ποιῆσαι ὕδωρ."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Τίς σοφὸς καὶ ἐπιστήμων ἐν ὑμῖν; δειξάτω ἐκ τῆς καλῆς ἀναστροφῆς τὰ ἔργα αὐτοῦ ἐν πραΰτητι σοφίας."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "εἰ δὲ ζῆλον πικρὸν ἔχετε καὶ ἐριθείαν ἐν τῇ καρδίᾳ ὑμῶν, μὴ κατακαυχᾶσθε καὶ ψεύδεσθε κατὰ τῆς ἀληθείας."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "οὐκ ἔστιν αὕτη ἡ σοφία ἄνωθεν κατερχομένη, ἀλλὰ ἐπίγειος, ψυχική, δαιμονιώδης·"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ὅπου γὰρ ζῆλος καὶ ἐριθεία, ἐκεῖ ἀκαταστασία καὶ πᾶν φαῦλον πρᾶγμα."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ἡ δὲ ἄνωθεν σοφία πρῶτον μὲν ἁγνή ἐστιν, ἔπειτα εἰρηνική, ἐπιεικής, εὐπειθής, μεστὴ ἐλέους καὶ καρπῶν ἀγαθῶν, ⸀ἀδιάκριτος",
          {
            "noteId": 47
          },
          "ἀνυπόκριτος·"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καρπὸς ⸀δὲ",
          {
            "noteId": 48
          },
          "δικαιοσύνης ἐν εἰρήνῃ σπείρεται τοῖς ποιοῦσιν εἰρήνην."
        ]
      }
    ],
