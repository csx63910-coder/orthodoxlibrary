  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ὁ πρεσβύτερος Γαΐῳ τῷ ἀγαπητῷ, ὃν ἐγὼ ἀγαπῶ ἐν ἀληθείᾳ."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Ἀγαπητέ, περὶ πάντων εὔχομαί σε εὐοδοῦσθαι καὶ ὑγιαίνειν, καθὼς εὐοδοῦταί σου ἡ ψυχή."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἐχάρην γὰρ λίαν ἐρχομένων ἀδελφῶν καὶ μαρτυρούντων σου τῇ ἀληθείᾳ, καθὼς σὺ ἐν ἀληθείᾳ περιπατεῖς."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "μειζοτέραν τούτων οὐκ ἔχω ⸀χαράν",
          {
            "noteId": 0
          },
          "ἵνα ἀκούω τὰ ἐμὰ τέκνα ἐν ⸀τῇ",
          {
            "noteId": 1
          },
          "ἀληθείᾳ περιπατοῦντα."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Ἀγαπητέ, πιστὸν ποιεῖς ὃ ἐὰν ἐργάσῃ εἰς τοὺς ἀδελφοὺς καὶ ⸀τοῦτο",
          {
            "noteId": 2
          },
          "ξένους,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "οἳ ἐμαρτύρησάν σου τῇ ἀγάπῃ ἐνώπιον ἐκκλησίας, οὓς καλῶς ποιήσεις προπέμψας ἀξίως τοῦ θεοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ὑπὲρ γὰρ τοῦ ὀνόματος ἐξῆλθον μηδὲν λαμβάνοντες ἀπὸ τῶν ⸀ἐθνικῶν",
          {
            "noteId": 3
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἡμεῖς οὖν ὀφείλομεν ⸀ὑπολαμβάνειν",
          {
            "noteId": 4
          },
          "τοὺς τοιούτους, ἵνα συνεργοὶ γινώμεθα τῇ ἀληθείᾳ."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Ἔγραψά ⸀τι",
          {
            "noteId": 5
          },
          "τῇ ἐκκλησίᾳ· ἀλλʼ ὁ φιλοπρωτεύων αὐτῶν Διοτρέφης οὐκ ἐπιδέχεται ἡμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "διὰ τοῦτο, ἐὰν ἔλθω, ὑπομνήσω αὐτοῦ τὰ ἔργα ἃ ποιεῖ, λόγοις πονηροῖς φλυαρῶν ἡμᾶς, καὶ μὴ ἀρκούμενος ἐπὶ τούτοις οὔτε αὐτὸς ἐπιδέχεται τοὺς ἀδελφοὺς καὶ τοὺς βουλομένους κωλύει καὶ ἐκ τῆς ἐκκλησίας ἐκβάλλει."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ἀγαπητέ, μὴ μιμοῦ τὸ κακὸν ἀλλὰ τὸ ἀγαθόν. ὁ ἀγαθοποιῶν ἐκ τοῦ θεοῦ ἐστιν· ὁ κακοποιῶν οὐχ ἑώρακεν τὸν θεόν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Δημητρίῳ μεμαρτύρηται ὑπὸ πάντων καὶ ὑπὸ αὐτῆς τῆς ἀληθείας· καὶ ἡμεῖς δὲ μαρτυροῦμεν, καὶ ⸀οἶδας",
          {
            "noteId": 6
          },
          "ὅτι ἡ μαρτυρία ἡμῶν ἀληθής ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Πολλὰ εἶχον ⸂γράψαι σοι",
          {
            "noteId": 7
          },
          ", ἀλλʼ οὐ θέλω διὰ μέλανος καὶ καλάμου σοι ⸀γράφειν",
          {
            "noteId": 8
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἐλπίζω δὲ εὐθέως ⸂σε ἰδεῖν",
          {
            "noteId": 9
          },
          ", καὶ στόμα πρὸς στόμα λαλήσομεν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Εἰρήνη σοι. ἀσπάζονταί σε οἱ φίλοι. ἀσπάζου τοὺς φίλους κατʼ ὄνομα. ‘p /’ ‘/book’"
        ]
      }
    ],
