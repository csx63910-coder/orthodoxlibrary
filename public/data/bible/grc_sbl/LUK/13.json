  "chapter": {
    "number": 13,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Παρῆσαν δέ τινες ἐν αὐτῷ τῷ καιρῷ ἀπαγγέλλοντες αὐτῷ περὶ τῶν Γαλιλαίων ὧν τὸ αἷμα Πιλᾶτος ἔμιξεν μετὰ τῶν θυσιῶν αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ ⸀ἀποκριθεὶς",
          {
            "noteId": 601
          },
          "εἶπεν αὐτοῖς· Δοκεῖτε ὅτι οἱ Γαλιλαῖοι οὗτοι ἁμαρτωλοὶ παρὰ πάντας τοὺς Γαλιλαίους ἐγένοντο, ὅτι ⸀ταῦτα",
          {
            "noteId": 602
          },
          "πεπόνθασιν;"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "οὐχί, λέγω ὑμῖν, ἀλλʼ ἐὰν μὴ μετανοῆτε πάντες ⸀ὁμοίως",
          {
            "noteId": 603
          },
          "ἀπολεῖσθε."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἢ ἐκεῖνοι οἱ ⸀δεκαοκτὼ",
          {
            "noteId": 604
          },
          "ἐφʼ οὓς ἔπεσεν ὁ πύργος ἐν τῷ Σιλωὰμ καὶ ἀπέκτεινεν αὐτούς, δοκεῖτε ὅτι ⸀αὐτοὶ",
          {
            "noteId": 605
          },
          "ὀφειλέται ἐγένοντο παρὰ πάντας ⸀τοὺς",
          {
            "noteId": 606
          },
          "ἀνθρώπους τοὺς ⸀κατοικοῦντας",
          {
            "noteId": 607
          },
          "Ἰερουσαλήμ;"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "οὐχί, λέγω ὑμῖν, ἀλλʼ ἐὰν μὴ ⸀μετανοῆτε",
          {
            "noteId": 608
          },
          "πάντες ⸀ὡσαύτως",
          {
            "noteId": 609
          },
          "ἀπολεῖσθε."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ἔλεγεν δὲ ταύτην τὴν παραβολήν. Συκῆν εἶχέν τις ⸂πεφυτευμένην ἐν τῷ ἀμπελῶνι αὐτοῦ",
          {
            "noteId": 610
          },
          ", καὶ ἦλθεν ζητῶν καρπὸν ἐν αὐτῇ καὶ οὐχ εὗρεν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "εἶπεν δὲ πρὸς τὸν ἀμπελουργόν· Ἰδοὺ τρία ἔτη ⸂ἀφʼ οὗ",
          {
            "noteId": 611
          },
          "ἔρχομαι ζητῶν καρπὸν ἐν τῇ συκῇ ταύτῃ καὶ οὐχ εὑρίσκω· ⸀ἔκκοψον",
          {
            "noteId": 612
          },
          "αὐτήν· ἱνατί καὶ τὴν γῆν καταργεῖ;"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ὁ δὲ ἀποκριθεὶς λέγει αὐτῷ· Κύριε, ἄφες αὐτὴν καὶ τοῦτο τὸ ἔτος, ἕως ὅτου σκάψω περὶ αὐτὴν καὶ βάλω κόπρια·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "κἂν μὲν ποιήσῃ καρπὸν ⸂εἰς τὸ μέλλον— εἰ δὲ μήγε,⸃ ἐκκόψεις αὐτήν.",
          {
            "noteId": 613
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Ἦν δὲ διδάσκων ἐν μιᾷ τῶν συναγωγῶν ἐν τοῖς σάββασιν."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ ἰδοὺ ⸀γυνὴ",
          {
            "noteId": 614
          },
          "πνεῦμα ἔχουσα ἀσθενείας ἔτη ⸀δεκαοκτώ",
          {
            "noteId": 615
          },
          "καὶ ἦν συγκύπτουσα καὶ μὴ δυναμένη ἀνακύψαι εἰς τὸ παντελές."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ἰδὼν δὲ αὐτὴν ὁ Ἰησοῦς προσεφώνησεν καὶ εἶπεν αὐτῇ· Γύναι, ἀπολέλυσαι τῆς ἀσθενείας σου,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ ἐπέθηκεν αὐτῇ τὰς χεῖρας· καὶ παραχρῆμα ἀνωρθώθη, καὶ ἐδόξαζεν τὸν θεόν."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἀποκριθεὶς δὲ ὁ ἀρχισυνάγωγος, ἀγανακτῶν ὅτι",
          {
            "noteId": 616
          },
          "τῷ σαββάτῳ ἐθεράπευσεν ὁ Ἰησοῦς, ἔλεγεν τῷ ὄχλῳ ⸀ὅτι Ἓξ ἡμέραι εἰσὶν ἐν αἷς δεῖ ἐργάζεσθαι· ἐν ⸀αὐταῖς",
          {
            "noteId": 617
          },
          "οὖν ἐρχόμενοι θεραπεύεσθε καὶ μὴ τῇ ἡμέρᾳ τοῦ σαββάτου."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ἀπεκρίθη ⸀δὲ",
          {
            "noteId": 618
          },
          "αὐτῷ ὁ κύριος καὶ εἶπεν· Ὑποκριταί, ἕκαστος ὑμῶν τῷ σαββάτῳ οὐ λύει τὸν βοῦν αὐτοῦ ἢ τὸν ὄνον ἀπὸ τῆς φάτνης καὶ ⸀ἀπαγαγὼν",
          {
            "noteId": 619
          },
          "ποτίζει;"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ταύτην δὲ θυγατέρα Ἀβραὰμ οὖσαν, ἣν ἔδησεν ὁ Σατανᾶς ἰδοὺ δέκα καὶ ὀκτὼ ἔτη, οὐκ ἔδει λυθῆναι ἀπὸ τοῦ δεσμοῦ τούτου τῇ ἡμέρᾳ τοῦ σαββάτου;"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καὶ ταῦτα λέγοντος αὐτοῦ κατῃσχύνοντο πάντες οἱ ἀντικείμενοι αὐτῷ, καὶ πᾶς ὁ ὄχλος ἔχαιρεν ἐπὶ πᾶσιν τοῖς ἐνδόξοις τοῖς γινομένοις ὑπʼ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Ἔλεγεν ⸀οὖν",
          {
            "noteId": 620
          },
          "Τίνι ὁμοία ἐστὶν ἡ βασιλεία τοῦ θεοῦ, καὶ τίνι ὁμοιώσω αὐτήν;"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ὁμοία ἐστὶν κόκκῳ σινάπεως, ὃν λαβὼν ἄνθρωπος ἔβαλεν εἰς κῆπον ἑαυτοῦ, καὶ ηὔξησεν καὶ ἐγένετο εἰς ⸀δένδρον",
          {
            "noteId": 621
          },
          "καὶ τὰ πετεινὰ τοῦ οὐρανοῦ κατεσκήνωσεν ἐν τοῖς κλάδοις αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "⸀Καὶ",
          {
            "noteId": 622
          },
          "πάλιν εἶπεν· Τίνι ὁμοιώσω τὴν βασιλείαν τοῦ θεοῦ;"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ὁμοία ἐστὶν ζύμῃ, ἣν λαβοῦσα γυνὴ ⸀ἔκρυψεν",
          {
            "noteId": 623
          },
          "εἰς ἀλεύρου σάτα τρία ἕως οὗ ἐζυμώθη ὅλον."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Καὶ διεπορεύετο κατὰ πόλεις καὶ κώμας διδάσκων καὶ πορείαν ποιούμενος εἰς ⸀Ἱεροσόλυμα",
          {
            "noteId": 624
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "εἶπεν δέ τις αὐτῷ· Κύριε, εἰ ὀλίγοι οἱ σῳζόμενοι; ὁ δὲ εἶπεν πρὸς αὐτούς·"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Ἀγωνίζεσθε εἰσελθεῖν διὰ τῆς στενῆς ⸀θύρας",
          {
            "noteId": 625
          },
          "ὅτι πολλοί, λέγω ὑμῖν, ζητήσουσιν εἰσελθεῖν καὶ οὐκ ἰσχύσουσιν,"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ἀφʼ οὗ ἂν ἐγερθῇ ὁ οἰκοδεσπότης καὶ ἀποκλείσῃ τὴν θύραν, καὶ ἄρξησθε ἔξω ἑστάναι καὶ κρούειν τὴν θύραν λέγοντες· ⸀Κύριε",
          {
            "noteId": 626
          },
          "ἄνοιξον ἡμῖν· καὶ ἀποκριθεὶς ἐρεῖ ὑμῖν· Οὐκ οἶδα ὑμᾶς πόθεν ἐστέ."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "τότε ἄρξεσθε λέγειν· Ἐφάγομεν ἐνώπιόν σου καὶ ἐπίομεν, καὶ ἐν ταῖς πλατείαις ἡμῶν ἐδίδαξας·"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "καὶ ἐρεῖ ⸀λέγων",
          {
            "noteId": 627
          },
          "ὑμῖν· Οὐκ ⸀οἶδα",
          {
            "noteId": 628
          },
          "πόθεν ἐστέ· ἀπόστητε ἀπʼ ἐμοῦ, πάντες ⸀ἐργάται",
          {
            "noteId": 629
          },
          "ἀδικίας."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ἐκεῖ ἔσται ὁ κλαυθμὸς καὶ ὁ βρυγμὸς τῶν ὀδόντων, ὅταν ⸀ὄψησθε",
          {
            "noteId": 630
          },
          "Ἀβραὰμ καὶ Ἰσαὰκ καὶ Ἰακὼβ καὶ πάντας τοὺς προφήτας ἐν τῇ βασιλείᾳ τοῦ θεοῦ, ὑμᾶς δὲ ἐκβαλλομένους ἔξω."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "καὶ ἥξουσιν ἀπὸ",
          {
            "noteId": 631
          },
          "ἀνατολῶν καὶ δυσμῶν καὶ ⸀ἀπὸ βορρᾶ καὶ νότου καὶ ἀνακλιθήσονται ἐν τῇ βασιλείᾳ τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "καὶ ἰδοὺ εἰσὶν ἔσχατοι οἳ ἔσονται πρῶτοι, καὶ εἰσὶν πρῶτοι οἳ ἔσονται ἔσχατοι."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "Ἐν αὐτῇ τῇ ⸀ὥρᾳ",
          {
            "noteId": 632
          },
          "προσῆλθάν τινες Φαρισαῖοι λέγοντες αὐτῷ· Ἔξελθε καὶ πορεύου ἐντεῦθεν, ὅτι Ἡρῴδης θέλει σε ἀποκτεῖναι."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "καὶ εἶπεν αὐτοῖς· Πορευθέντες εἴπατε τῇ ἀλώπεκι ταύτῃ· Ἰδοὺ ἐκβάλλω δαιμόνια καὶ ἰάσεις ⸀ἀποτελῶ",
          {
            "noteId": 633
          },
          "σήμερον καὶ αὔριον, καὶ τῇ τρίτῃ τελειοῦμαι."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "πλὴν δεῖ με σήμερον καὶ αὔριον καὶ τῇ ἐχομένῃ πορεύεσθαι, ὅτι οὐκ ἐνδέχεται προφήτην ἀπολέσθαι ἔξω Ἰερουσαλήμ."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "Ἰερουσαλὴμ Ἰερουσαλήμ, ἡ ἀποκτείνουσα τοὺς προφήτας καὶ λιθοβολοῦσα τοὺς ἀπεσταλμένους πρὸς αὐτήν— ποσάκις ἠθέλησα ἐπισυνάξαι τὰ τέκνα σου ὃν τρόπον ὄρνις τὴν ἑαυτῆς νοσσιὰν ὑπὸ τὰς πτέρυγας, καὶ οὐκ ἠθελήσατε."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "ἰδοὺ ἀφίεται ὑμῖν ὁ οἶκος ⸀ὑμῶν",
          {
            "noteId": 634
          },
          "λέγω ⸀δὲ",
          {
            "noteId": 635
          },
          "⸀ὑμῖν",
          {
            "noteId": 636
          },
          "οὐ μὴ ⸂ἴδητέ με",
          {
            "noteId": 637
          },
          "ἕως ⸂ἥξει ὅτε",
          {
            "noteId": 638
          },
          "εἴπητε· Εὐλογημένος ὁ ἐρχόμενος ἐν ὀνόματι κυρίου."
        ]
      }
    ],
