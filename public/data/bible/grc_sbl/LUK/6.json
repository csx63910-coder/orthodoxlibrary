  },
  "chapter": {
    "number": 6,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἐγένετο δὲ ἐν ⸀σαββάτῳ",
          {
            "noteId": 182
          },
          "διαπορεύεσθαι αὐτὸν ⸀διὰ",
          {
            "noteId": 183
          },
          "σπορίμων, καὶ ἔτιλλον οἱ μαθηταὶ αὐτοῦ ⸂καὶ ἤσθιον τοὺς στάχυας",
          {
            "noteId": 184
          },
          "ψώχοντες ταῖς χερσίν."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "τινὲς δὲ τῶν Φαρισαίων ⸀εἶπαν",
          {
            "noteId": 185
          },
          "Τί ποιεῖτε ὃ οὐκ ⸀ἔξεστιν",
          {
            "noteId": 186
          },
          "τοῖς σάββασιν;"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ ἀποκριθεὶς πρὸς αὐτοὺς εἶπεν ὁ Ἰησοῦς· Οὐδὲ τοῦτο ἀνέγνωτε ὃ ἐποίησεν Δαυὶδ ⸀ὁπότε",
          {
            "noteId": 187
          },
          "ἐπείνασεν αὐτὸς καὶ οἱ μετʼ αὐτοῦ ⸀ὄντες",
          {
            "noteId": 188
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "⸀ὡς",
          {
            "noteId": 189
          },
          "εἰσῆλθεν εἰς τὸν οἶκον τοῦ θεοῦ καὶ τοὺς ἄρτους τῆς προθέσεως ⸀λαβὼν",
          {
            "noteId": 190
          },
          "ἔφαγεν καὶ ⸀ἔδωκεν",
          {
            "noteId": 191
          },
          "τοῖς μετʼ αὐτοῦ, οὓς οὐκ ἔξεστιν φαγεῖν εἰ μὴ μόνους τοὺς ἱερεῖς;"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ ἔλεγεν ⸀αὐτοῖς",
          {
            "noteId": 192
          },
          "Κύριός ἐστιν ⸂τοῦ σαββάτου ὁ υἱὸς τοῦ ἀνθρώπου",
          {
            "noteId": 193
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ἐγένετο ⸀δὲ",
          {
            "noteId": 194
          },
          "ἐν ἑτέρῳ σαββάτῳ εἰσελθεῖν αὐτὸν εἰς τὴν συναγωγὴν καὶ διδάσκειν· καὶ ἦν ⸂ἄνθρωπος ἐκεῖ",
          {
            "noteId": 195
          },
          "καὶ ἡ χεὶρ αὐτοῦ ἡ δεξιὰ ἦν ξηρά·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "⸀παρετηροῦντο",
          {
            "noteId": 196
          },
          "⸀δὲ",
          {
            "noteId": 197
          },
          "οἱ γραμματεῖς καὶ οἱ Φαρισαῖοι εἰ ἐν τῷ σαββάτῳ ⸀θεραπεύει",
          {
            "noteId": 198
          },
          "ἵνα εὕρωσιν ⸀κατηγορεῖν",
          {
            "noteId": 199
          },
          "αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "αὐτὸς δὲ ᾔδει τοὺς διαλογισμοὺς αὐτῶν, ⸂εἶπεν δὲ",
          {
            "noteId": 200
          },
          "τῷ ⸀ἀνδρὶ",
          {
            "noteId": 201
          },
          "τῷ ξηρὰν ἔχοντι τὴν χεῖρα· ⸀Ἔγειρε",
          {
            "noteId": 202
          },
          "καὶ",
          {
            "noteId": 203
          },
          "στῆθι εἰς τὸ μέσον· ⸀καὶ ἀναστὰς ἔστη."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "εἶπεν ⸀δὲ",
          {
            "noteId": 204
          },
          "ὁ Ἰησοῦς πρὸς αὐτούς· ⸀Ἐπερωτῶ",
          {
            "noteId": 205
          },
          "ὑμᾶς, ⸀εἰ",
          {
            "noteId": 206
          },
          "ἔξεστιν ⸂τῷ σαββάτῳ",
          {
            "noteId": 207
          },
          "ἀγαθοποιῆσαι ἢ κακοποιῆσαι, ψυχὴν σῶσαι ἢ ⸀ἀπολέσαι",
          {
            "noteId": 208
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ περιβλεψάμενος πάντας αὐτοὺς εἶπεν αὐτῷ· Ἔκτεινον τὴν χεῖρά σου· ὁ δὲ ἐποίησεν, καὶ ἀπεκατεστάθη ἡ χεὶρ ⸀αὐτοῦ",
          {
            "noteId": 209
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "αὐτοὶ δὲ ἐπλήσθησαν ἀνοίας, καὶ διελάλουν πρὸς ἀλλήλους τί ἂν ποιήσαιεν τῷ Ἰησοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ἐγένετο δὲ ἐν ταῖς ἡμέραις ταύταις ⸂ἐξελθεῖν αὐτὸν",
          {
            "noteId": 210
          },
          "εἰς τὸ ὄρος προσεύξασθαι, καὶ ἦν διανυκτερεύων ἐν τῇ προσευχῇ τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ ὅτε ἐγένετο ἡμέρα, προσεφώνησεν τοὺς μαθητὰς αὐτοῦ, καὶ ἐκλεξάμενος ἀπʼ αὐτῶν δώδεκα, οὓς καὶ ἀποστόλους ὠνόμασεν,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Σίμωνα ὃν καὶ ὠνόμασεν Πέτρον καὶ Ἀνδρέαν τὸν ἀδελφὸν αὐτοῦ ⸀καὶ",
          {
            "noteId": 211
          },
          "Ἰάκωβον καὶ Ἰωάννην ⸁καὶ",
          {
            "noteId": 212
          },
          "Φίλιππον καὶ Βαρθολομαῖον"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "⸀καὶ",
          {
            "noteId": 213
          },
          "Μαθθαῖον καὶ Θωμᾶν ⸁καὶ",
          {
            "noteId": 214
          },
          "⸀Ἰάκωβον",
          {
            "noteId": 215
          },
          "Ἁλφαίου καὶ Σίμωνα τὸν καλούμενον Ζηλωτὴν"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "⸀καὶ",
          {
            "noteId": 216
          },
          "Ἰούδαν Ἰακώβου καὶ Ἰούδαν ⸀Ἰσκαριὼθ",
          {
            "noteId": 217
          },
          "⸀ὃς",
          {
            "noteId": 218
          },
          "ἐγένετο προδότης."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Καὶ καταβὰς μετʼ αὐτῶν ἔστη ἐπὶ τόπου πεδινοῦ, καὶ ὄχλος ⸀πολὺς",
          {
            "noteId": 219
          },
          "μαθητῶν αὐτοῦ, καὶ πλῆθος πολὺ τοῦ λαοῦ ἀπὸ πάσης τῆς Ἰουδαίας καὶ Ἰερουσαλὴμ καὶ τῆς παραλίου Τύρου καὶ Σιδῶνος,"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "οἳ ἦλθον ἀκοῦσαι αὐτοῦ καὶ ἰαθῆναι ἀπὸ τῶν νόσων αὐτῶν· καὶ οἱ ⸂ἐνοχλούμενοι ἀπὸ",
          {
            "noteId": 220
          },
          "πνευμάτων ⸀ἀκαθάρτων",
          {
            "noteId": 221
          },
          "ἐθεραπεύοντο·"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "καὶ πᾶς ὁ ὄχλος ⸀ἐζήτουν",
          {
            "noteId": 222
          },
          "ἅπτεσθαι αὐτοῦ, ὅτι δύναμις παρʼ αὐτοῦ ἐξήρχετο καὶ ἰᾶτο πάντας."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Καὶ αὐτὸς ἐπάρας τοὺς ὀφθαλμοὺς αὐτοῦ εἰς τοὺς μαθητὰς αὐτοῦ ἔλεγεν· Μακάριοι οἱ πτωχοί, ὅτι ὑμετέρα ἐστὶν ἡ βασιλεία τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "μακάριοι οἱ πεινῶντες νῦν, ὅτι χορτασθήσεσθε. μακάριοι οἱ κλαίοντες νῦν, ὅτι γελάσετε."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Μακάριοί ἐστε ὅταν μισήσωσιν ὑμᾶς οἱ ἄνθρωποι, καὶ ὅταν ἀφορίσωσιν ὑμᾶς καὶ ὀνειδίσωσιν καὶ ἐκβάλωσιν τὸ ὄνομα ὑμῶν ὡς πονηρὸν ἕνεκα τοῦ υἱοῦ τοῦ ἀνθρώπου·"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "χάρητε ἐν ἐκείνῃ τῇ ἡμέρᾳ καὶ σκιρτήσατε, ἰδοὺ γὰρ ὁ μισθὸς ὑμῶν πολὺς ἐν τῷ οὐρανῷ· κατὰ ⸂τὰ αὐτὰ",
          {
            "noteId": 223
          },
          "γὰρ ἐποίουν τοῖς προφήταις οἱ πατέρες αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "πλὴν οὐαὶ ὑμῖν τοῖς πλουσίοις, ὅτι ἀπέχετε τὴν παράκλησιν ὑμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "οὐαὶ ὑμῖν, οἱ ἐμπεπλησμένοι ⸀νῦν",
          {
            "noteId": 224
          },
          "ὅτι πεινάσετε. ⸀οὐαί",
          {
            "noteId": 225
          },
          "οἱ γελῶντες νῦν, ὅτι πενθήσετε καὶ κλαύσετε."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Οὐαὶ ὅταν ⸂καλῶς ὑμᾶς",
          {
            "noteId": 226
          },
          "εἴπωσιν ⸀πάντες",
          {
            "noteId": 227
          },
          "οἱ ἄνθρωποι, κατὰ ⸂τὰ αὐτὰ",
          {
            "noteId": 228
          },
          "γὰρ ἐποίουν τοῖς ψευδοπροφήταις οἱ πατέρες αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Ἀλλὰ ὑμῖν λέγω τοῖς ἀκούουσιν, ἀγαπᾶτε τοὺς ἐχθροὺς ὑμῶν, καλῶς ποιεῖτε τοῖς μισοῦσιν ὑμᾶς,"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "εὐλογεῖτε τοὺς καταρωμένους ⸀ὑμᾶς",
          {
            "noteId": 229
          },
          "προσεύχεσθε ⸀περὶ",
          {
            "noteId": 230
          },
          "τῶν ἐπηρεαζόντων ὑμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "τῷ τύπτοντί σε ἐπὶ τὴν σιαγόνα πάρεχε καὶ τὴν ἄλλην, καὶ ἀπὸ τοῦ αἴροντός σου τὸ ἱμάτιον καὶ τὸν χιτῶνα μὴ κωλύσῃς."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "⸀παντὶ",
          {
            "noteId": 231
          },
          "αἰτοῦντί σε δίδου, καὶ ἀπὸ τοῦ αἴροντος τὰ σὰ μὴ ἀπαίτει."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "καὶ καθὼς θέλετε ἵνα ποιῶσιν ὑμῖν οἱ ⸀ἄνθρωποι",
          {
            "noteId": 232
          },
          "ποιεῖτε αὐτοῖς ὁμοίως."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Καὶ εἰ ἀγαπᾶτε τοὺς ἀγαπῶντας ὑμᾶς, ποία ὑμῖν χάρις ἐστίν; καὶ γὰρ οἱ ἁμαρτωλοὶ τοὺς ἀγαπῶντας αὐτοὺς ἀγαπῶσιν."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "⸀καὶ",
          {
            "noteId": 233
          },
          "ἐὰν ἀγαθοποιῆτε τοὺς ἀγαθοποιοῦντας ὑμᾶς, ποία ὑμῖν χάρις ἐστίν; ⸁καὶ",
          {
            "noteId": 234
          },
          "οἱ ἁμαρτωλοὶ τὸ αὐτὸ ποιοῦσιν."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "καὶ ἐὰν ⸀δανίσητε",
          {
            "noteId": 235
          },
          "παρʼ ὧν ἐλπίζετε ⸀λαβεῖν",
          {
            "noteId": 236
          },
          "ποία ὑμῖν χάρις ἐστίν; ⸀καὶ",
          {
            "noteId": 237
          },
          "ἁμαρτωλοὶ ἁμαρτωλοῖς δανίζουσιν ἵνα ἀπολάβωσιν τὰ ἴσα."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "πλὴν ἀγαπᾶτε τοὺς ἐχθροὺς ὑμῶν καὶ ἀγαθοποιεῖτε καὶ δανίζετε μηδὲν ἀπελπίζοντες· καὶ ἔσται ὁ μισθὸς ὑμῶν πολύς, καὶ ἔσεσθε υἱοὶ Ὑψίστου, ὅτι αὐτὸς χρηστός ἐστιν ἐπὶ τοὺς ἀχαρίστους καὶ πονηρούς."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "⸀γίνεσθε",
          {
            "noteId": 238
          },
          "οἰκτίρμονες ⸀καθὼς",
          {
            "noteId": 239
          },
          "ὁ πατὴρ ὑμῶν οἰκτίρμων ἐστίν·"
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "Καὶ μὴ κρίνετε, καὶ",
          {
            "noteId": 240
          },
          "οὐ μὴ κριθῆτε· ⸀καὶ μὴ καταδικάζετε, καὶ οὐ μὴ καταδικασθῆτε. ἀπολύετε, καὶ ἀπολυθήσεσθε·"
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "δίδοτε, καὶ δοθήσεται ὑμῖν· μέτρον καλὸν πεπιεσμένον ⸀σεσαλευμένον",
          {
            "noteId": 241
          },
          "ὑπερεκχυννόμενον δώσουσιν εἰς τὸν κόλπον ὑμῶν· ⸂ᾧ γὰρ μέτρῳ",
          {
            "noteId": 242
          },
          "μετρεῖτε ἀντιμετρηθήσεται ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "Εἶπεν δὲ ⸀καὶ",
          {
            "noteId": 243
          },
          "παραβολὴν αὐτοῖς· Μήτι δύναται τυφλὸς τυφλὸν ὁδηγεῖν; οὐχὶ ἀμφότεροι εἰς βόθυνον ⸀ἐμπεσοῦνται",
          {
            "noteId": 244
          }
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "οὐκ ἔστιν μαθητὴς ὑπὲρ τὸν ⸀διδάσκαλον",
          {
            "noteId": 245
          },
          "κατηρτισμένος δὲ πᾶς ἔσται ὡς ὁ διδάσκαλος αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "τί δὲ βλέπεις τὸ κάρφος τὸ ἐν τῷ ὀφθαλμῷ τοῦ ἀδελφοῦ σου, τὴν δὲ δοκὸν τὴν ἐν τῷ ἰδίῳ ὀφθαλμῷ οὐ κατανοεῖς;"
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "⸀πῶς",
          {
            "noteId": 246
          },
          "δύνασαι λέγειν τῷ ἀδελφῷ σου· Ἀδελφέ, ἄφες ἐκβάλω τὸ κάρφος τὸ ἐν τῷ ὀφθαλμῷ σου, αὐτὸς τὴν ἐν τῷ ὀφθαλμῷ σοῦ δοκὸν οὐ βλέπων; ὑποκριτά, ἔκβαλε πρῶτον τὴν δοκὸν ἐκ τοῦ ὀφθαλμοῦ σοῦ, καὶ τότε διαβλέψεις ⸂τὸ κάρφος τὸ ἐν τῷ ὀφθαλμῷ τοῦ ἀδελφοῦ σου ἐκβαλεῖν",
          {
            "noteId": 247
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "Οὐ γάρ ἐστιν δένδρον καλὸν ποιοῦν καρπὸν σαπρόν, οὐδὲ ⸀πάλιν",
          {
            "noteId": 248
          },
          "δένδρον σαπρὸν ποιοῦν καρπὸν καλόν."
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "ἕκαστον γὰρ δένδρον ἐκ τοῦ ἰδίου καρποῦ γινώσκεται· οὐ γὰρ ἐξ ἀκανθῶν συλλέγουσιν σῦκα, οὐδὲ ἐκ βάτου ⸂σταφυλὴν τρυγῶσιν",
          {
            "noteId": 249
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "ὁ ἀγαθὸς ἄνθρωπος ἐκ τοῦ ἀγαθοῦ θησαυροῦ τῆς καρδίας ⸀αὐτοῦ",
          {
            "noteId": 250
          },
          "προφέρει τὸ ἀγαθόν, καὶ ὁ ⸀πονηρὸς",
          {
            "noteId": 251
          },
          "ἐκ τοῦ ⸀πονηροῦ",
          {
            "noteId": 252
          },
          "προφέρει τὸ πονηρόν· ἐκ γὰρ ⸀περισσεύματος",
          {
            "noteId": 253
          },
          "καρδίας λαλεῖ τὸ στόμα αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "Τί δέ με καλεῖτε· Κύριε κύριε, καὶ οὐ ποιεῖτε ἃ λέγω;"
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          "πᾶς ὁ ἐρχόμενος πρός με καὶ ἀκούων μου τῶν λόγων καὶ ποιῶν αὐτούς, ὑποδείξω ὑμῖν τίνι ἐστὶν ὅμοιος·"
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          "ὅμοιός ἐστιν ἀνθρώπῳ οἰκοδομοῦντι οἰκίαν ὃς ἔσκαψεν καὶ ἐβάθυνεν καὶ ἔθηκεν θεμέλιον ἐπὶ τὴν πέτραν· πλημμύρης δὲ γενομένης προσέρηξεν ὁ ποταμὸς τῇ οἰκίᾳ ἐκείνῃ, καὶ οὐκ ἴσχυσεν σαλεῦσαι αὐτὴν ⸂διὰ τὸ καλῶς οἰκοδομῆσθαι αὐτήν",
          {
            "noteId": 254
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          "ὁ δὲ ἀκούσας καὶ μὴ ποιήσας ὅμοιός ἐστιν ἀνθρώπῳ οἰκοδομήσαντι οἰκίαν ἐπὶ τὴν γῆν χωρὶς θεμελίου, ᾗ προσέρηξεν ὁ ποταμός, καὶ ⸂εὐθὺς συνέπεσεν",
          {
            "noteId": 255
          },
          ", καὶ ἐγένετο τὸ ῥῆγμα τῆς οἰκίας ἐκείνης μέγα."
        ]
      }
    ],
