  "chapter": {
    "number": 7,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "⸀Ἐπειδὴ",
          {
            "noteId": 256
          },
          "ἐπλήρωσεν πάντα τὰ ῥήματα αὐτοῦ εἰς τὰς ἀκοὰς τοῦ λαοῦ, εἰσῆλθεν εἰς Καφαρναούμ."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Ἑκατοντάρχου δέ τινος δοῦλος κακῶς ἔχων ἤμελλεν τελευτᾶν, ὃς ἦν αὐτῷ ἔντιμος."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἀκούσας δὲ περὶ τοῦ Ἰησοῦ ἀπέστειλεν πρὸς αὐτὸν πρεσβυτέρους τῶν Ἰουδαίων, ἐρωτῶν αὐτὸν ὅπως ἐλθὼν διασώσῃ τὸν δοῦλον αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "οἱ δὲ παραγενόμενοι πρὸς τὸν Ἰησοῦν παρεκάλουν αὐτὸν σπουδαίως λέγοντες ὅτι Ἄξιός ἐστιν ᾧ ⸀παρέξῃ",
          {
            "noteId": 257
          },
          "τοῦτο,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἀγαπᾷ γὰρ τὸ ἔθνος ἡμῶν καὶ τὴν συναγωγὴν αὐτὸς ᾠκοδόμησεν ἡμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ὁ δὲ Ἰησοῦς ἐπορεύετο σὺν αὐτοῖς. ἤδη δὲ αὐτοῦ οὐ μακρὰν ἀπέχοντος ἀπὸ τῆς οἰκίας ἔπεμψεν ⸂φίλους ὁ ἑκατοντάρχης",
          {
            "noteId": 258
          },
          "λέγων αὐτῷ· Κύριε, μὴ σκύλλου, οὐ γὰρ ⸂ἱκανός εἰμι",
          {
            "noteId": 259
          },
          "ἵνα ὑπὸ τὴν στέγην μου εἰσέλθῃς·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "διὸ οὐδὲ ἐμαυτὸν ἠξίωσα πρὸς σὲ ἐλθεῖν· ἀλλὰ εἰπὲ λόγῳ, καὶ ⸀ἰαθήτω",
          {
            "noteId": 260
          },
          "ὁ παῖς μου·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ γὰρ ἐγὼ ἄνθρωπός εἰμι ὑπὸ ἐξουσίαν τασσόμενος, ἔχων ὑπʼ ἐμαυτὸν στρατιώτας, καὶ λέγω τούτῳ· Πορεύθητι, καὶ πορεύεται, καὶ ἄλλῳ· Ἔρχου, καὶ ἔρχεται, καὶ τῷ δούλῳ μου· Ποίησον τοῦτο, καὶ ποιεῖ."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ἀκούσας δὲ ταῦτα ὁ Ἰησοῦς ἐθαύμασεν αὐτόν, καὶ στραφεὶς τῷ ἀκολουθοῦντι αὐτῷ ὄχλῳ εἶπεν· Λέγω ὑμῖν, ⸀οὐδὲ",
          {
            "noteId": 261
          },
          "ἐν τῷ Ἰσραὴλ τοσαύτην πίστιν εὗρον."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ ὑποστρέψαντες ⸂εἰς τὸν οἶκον οἱ πεμφθέντες",
          {
            "noteId": 262
          },
          "εὗρον ⸀τὸν",
          {
            "noteId": 263
          },
          "δοῦλον ὑγιαίνοντα."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Καὶ ἐγένετο ἐν τῷ ἑξῆς ⸀ἐπορεύθη",
          {
            "noteId": 264
          },
          "εἰς πόλιν καλουμένην Ναΐν, καὶ συνεπορεύοντο αὐτῷ οἱ μαθηταὶ ⸀αὐτοῦ",
          {
            "noteId": 265
          },
          "καὶ ὄχλος πολύς."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ὡς δὲ ἤγγισεν τῇ πύλῃ τῆς πόλεως, καὶ ἰδοὺ ἐξεκομίζετο τεθνηκὼς ⸂μονογενὴς υἱὸς",
          {
            "noteId": 266
          },
          "τῇ μητρὶ αὐτοῦ, καὶ αὐτὴ ⸀ἦν",
          {
            "noteId": 267
          },
          "χήρα, καὶ ὄχλος τῆς πόλεως ἱκανὸς ⸁ἦν",
          {
            "noteId": 268
          },
          "σὺν αὐτῇ."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ ἰδὼν αὐτὴν ὁ κύριος ἐσπλαγχνίσθη ἐπʼ αὐτῇ καὶ εἶπεν αὐτῇ· Μὴ κλαῖε."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καὶ προσελθὼν ἥψατο τῆς σοροῦ, οἱ δὲ βαστάζοντες ἔστησαν, καὶ εἶπεν· Νεανίσκε, σοὶ λέγω, ἐγέρθητι."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ ἀνεκάθισεν ὁ νεκρὸς καὶ ἤρξατο λαλεῖν, καὶ ἔδωκεν αὐτὸν τῇ μητρὶ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ἔλαβεν δὲ φόβος πάντας, καὶ ἐδόξαζον τὸν θεὸν λέγοντες ὅτι Προφήτης μέγας ⸀ἠγέρθη",
          {
            "noteId": 269
          },
          "ἐν ἡμῖν, καὶ ὅτι Ἐπεσκέψατο ὁ θεὸς τὸν λαὸν αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καὶ",
          {
            "noteId": 270
          },
          "ἐξῆλθεν ὁ λόγος οὗτος ἐν ὅλῃ τῇ Ἰουδαίᾳ περὶ αὐτοῦ ⸀καὶ πάσῃ τῇ περιχώρῳ."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Καὶ ἀπήγγειλαν Ἰωάννῃ οἱ μαθηταὶ αὐτοῦ περὶ πάντων τούτων. καὶ προσκαλεσάμενος δύο τινὰς τῶν μαθητῶν αὐτοῦ ὁ Ἰωάννης"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἔπεμψεν πρὸς τὸν ⸀κύριον",
          {
            "noteId": 271
          },
          "λέγων· Σὺ εἶ ὁ ἐρχόμενος ἢ ⸀ἄλλον",
          {
            "noteId": 272
          },
          "προσδοκῶμεν;"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "παραγενόμενοι δὲ πρὸς αὐτὸν οἱ ἄνδρες εἶπαν· Ἰωάννης ὁ βαπτιστὴς ⸀ἀπέστειλεν",
          {
            "noteId": 273
          },
          "ἡμᾶς πρὸς σὲ λέγων· Σὺ εἶ ὁ ἐρχόμενος ἢ ἄλλον προσδοκῶμεν;"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ἐν ⸀ἐκείνῃ",
          {
            "noteId": 274
          },
          "τῇ ὥρᾳ ἐθεράπευσεν πολλοὺς ἀπὸ νόσων καὶ μαστίγων καὶ πνευμάτων πονηρῶν, καὶ τυφλοῖς πολλοῖς ⸀ἐχαρίσατο",
          {
            "noteId": 275
          },
          "βλέπειν."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "καὶ ⸀ἀποκριθεὶς",
          {
            "noteId": 276
          },
          "εἶπεν αὐτοῖς· Πορευθέντες ἀπαγγείλατε Ἰωάννῃ ἃ εἴδετε καὶ ἠκούσατε· ⸀τυφλοὶ",
          {
            "noteId": 277
          },
          "ἀναβλέπουσιν, χωλοὶ περιπατοῦσιν, λεπροὶ καθαρίζονται, ⸀κωφοὶ",
          {
            "noteId": 278
          },
          "ἀκούουσιν, νεκροὶ ἐγείρονται, πτωχοὶ εὐαγγελίζονται·"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "καὶ μακάριός ἐστιν ὃς ἐὰν μὴ σκανδαλισθῇ ἐν ἐμοί."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Ἀπελθόντων δὲ τῶν ἀγγέλων Ἰωάννου ἤρξατο λέγειν ⸂πρὸς τοὺς ὄχλους",
          {
            "noteId": 279
          },
          "περὶ Ἰωάννου· Τί ⸀ἐξήλθατε",
          {
            "noteId": 280
          },
          "εἰς τὴν ἔρημον θεάσασθαι; κάλαμον ὑπὸ ἀνέμου σαλευόμενον;"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ἀλλὰ τί ⸀ἐξήλθατε",
          {
            "noteId": 281
          },
          "ἰδεῖν; ἄνθρωπον ἐν μαλακοῖς ἱματίοις ἠμφιεσμένον; ἰδοὺ οἱ ἐν ἱματισμῷ ἐνδόξῳ καὶ τρυφῇ ὑπάρχοντες ἐν τοῖς βασιλείοις εἰσίν."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ἀλλὰ τί ⸀ἐξήλθατε",
          {
            "noteId": 282
          },
          "ἰδεῖν; προφήτην; ναί, λέγω ὑμῖν, καὶ περισσότερον προφήτου."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "οὗτός ἐστιν περὶ οὗ γέγραπται· ⸀Ἰδοὺ",
          {
            "noteId": 283
          },
          "ἀποστέλλω τὸν ἄγγελόν μου πρὸ προσώπου σου, ὃς κατασκευάσει τὴν ὁδόν σου ἔμπροσθέν σου."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "⸀λέγω",
          {
            "noteId": 284
          },
          "ὑμῖν, μείζων ἐν γεννητοῖς γυναικῶν ⸀Ἰωάννου",
          {
            "noteId": 285
          },
          "οὐδείς ἐστιν· ὁ δὲ μικρότερος ἐν τῇ βασιλείᾳ τοῦ θεοῦ μείζων αὐτοῦ ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "(καὶ πᾶς ὁ λαὸς ἀκούσας καὶ οἱ τελῶναι ἐδικαίωσαν τὸν θεόν, βαπτισθέντες τὸ βάπτισμα Ἰωάννου·"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "οἱ δὲ Φαρισαῖοι καὶ οἱ νομικοὶ τὴν βουλὴν τοῦ θεοῦ ἠθέτησαν εἰς ἑαυτούς, μὴ βαπτισθέντες ὑπʼ αὐτοῦ.)"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "Τίνι οὖν ὁμοιώσω τοὺς ἀνθρώπους τῆς γενεᾶς ταύτης, καὶ τίνι εἰσὶν ὅμοιοι;"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "ὅμοιοί εἰσιν παιδίοις τοῖς ἐν ἀγορᾷ καθημένοις καὶ προσφωνοῦσιν ἀλλήλοις, ⸂ἃ λέγει",
          {
            "noteId": 286
          },
          "· Ηὐλήσαμεν ὑμῖν καὶ οὐκ ὠρχήσασθε· ⸀ἐθρηνήσαμεν",
          {
            "noteId": 287
          },
          "καὶ οὐκ ἐκλαύσατε·"
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "ἐλήλυθεν γὰρ Ἰωάννης ὁ βαπτιστὴς ⸀μὴ",
          {
            "noteId": 288
          },
          "⸂ἐσθίων ἄρτον μήτε πίνων οἶνον",
          {
            "noteId": 289
          },
          ", καὶ λέγετε· Δαιμόνιον ἔχει·"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "ἐλήλυθεν ὁ υἱὸς τοῦ ἀνθρώπου ἐσθίων καὶ πίνων, καὶ λέγετε· Ἰδοὺ ἄνθρωπος φάγος καὶ οἰνοπότης, φίλος τελωνῶν καὶ ἁμαρτωλῶν."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "καὶ ἐδικαιώθη ἡ σοφία ἀπὸ ⸂πάντων τῶν τέκνων αὐτῆς",
          {
            "noteId": 290
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "Ἠρώτα δέ τις αὐτὸν τῶν Φαρισαίων ἵνα φάγῃ μετʼ αὐτοῦ· καὶ εἰσελθὼν εἰς ⸂τὸν οἶκον",
          {
            "noteId": 291
          },
          "τοῦ Φαρισαίου ⸀κατεκλίθη",
          {
            "noteId": 292
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "καὶ ἰδοὺ γυνὴ ⸂ἥτις ἦν ἐν τῇ πόλει",
          {
            "noteId": 293
          },
          "ἁμαρτωλός, ⸀καὶ",
          {
            "noteId": 294
          },
          "ἐπιγνοῦσα ὅτι ⸀κατάκειται",
          {
            "noteId": 295
          },
          "ἐν τῇ οἰκίᾳ τοῦ Φαρισαίου, κομίσασα ἀλάβαστρον μύρου"
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "καὶ στᾶσα ⸂ὀπίσω παρὰ τοὺς πόδας αὐτοῦ",
          {
            "noteId": 296
          },
          "κλαίουσα, ⸂τοῖς δάκρυσιν ἤρξατο βρέχειν τοὺς πόδας αὐτοῦ",
          {
            "noteId": 297
          },
          "καὶ ταῖς θριξὶν τῆς κεφαλῆς αὐτῆς ἐξέμασσεν, καὶ κατεφίλει τοὺς πόδας αὐτοῦ καὶ ἤλειφεν τῷ μύρῳ."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "ἰδὼν δὲ ὁ Φαρισαῖος ὁ καλέσας αὐτὸν εἶπεν ἐν ἑαυτῷ λέγων· Οὗτος εἰ ⸀ἦν",
          {
            "noteId": 298
          },
          "προφήτης, ἐγίνωσκεν ἂν τίς καὶ ποταπὴ ἡ γυνὴ ἥτις ἅπτεται αὐτοῦ, ὅτι ἁμαρτωλός ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "καὶ ἀποκριθεὶς ὁ Ἰησοῦς εἶπεν πρὸς αὐτόν· Σίμων, ἔχω σοί τι εἰπεῖν. ὁ δέ· ⸂Διδάσκαλε, εἰπέ, φησίν⸃.",
          {
            "noteId": 299
          }
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "δύο χρεοφειλέται ἦσαν δανιστῇ τινι· ὁ εἷς ὤφειλεν δηνάρια πεντακόσια, ὁ δὲ ἕτερος πεντήκοντα."
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "μὴ ⸀ἐχόντων",
          {
            "noteId": 300
          },
          "αὐτῶν",
          {
            "noteId": 301
          },
          "ἀποδοῦναι ἀμφοτέροις ἐχαρίσατο. τίς οὖν ⸀αὐτῶν πλεῖον ⸂ἀγαπήσει αὐτόν",
          {
            "noteId": 302
          },
          ";"
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "⸀ἀποκριθεὶς",
          {
            "noteId": 303
          },
          "Σίμων εἶπεν· Ὑπολαμβάνω ὅτι ᾧ τὸ πλεῖον ἐχαρίσατο. ὁ δὲ εἶπεν αὐτῷ· Ὀρθῶς ἔκρινας."
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "καὶ στραφεὶς πρὸς τὴν γυναῖκα τῷ Σίμωνι ἔφη· Βλέπεις ταύτην τὴν γυναῖκα; εἰσῆλθόν σου εἰς τὴν οἰκίαν, ὕδωρ ⸀μοι",
          {
            "noteId": 304
          },
          "ἐπὶ ⸀πόδας",
          {
            "noteId": 305
          },
          "οὐκ ἔδωκας· αὕτη δὲ τοῖς δάκρυσιν ἔβρεξέν μου τοὺς πόδας καὶ ταῖς ⸀θριξὶν",
          {
            "noteId": 306
          },
          "αὐτῆς ἐξέμαξεν."
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "φίλημά μοι οὐκ ἔδωκας· αὕτη δὲ ἀφʼ ἧς εἰσῆλθον οὐ διέλιπεν καταφιλοῦσά μου τοὺς πόδας."
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "ἐλαίῳ τὴν κεφαλήν μου οὐκ ἤλειψας· αὕτη δὲ μύρῳ ἤλειψεν ⸂τοὺς πόδας μου",
          {
            "noteId": 307
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          "οὗ χάριν, λέγω σοι, ἀφέωνται αἱ ἁμαρτίαι αὐτῆς αἱ πολλαί, ὅτι ἠγάπησεν πολύ· ᾧ δὲ ὀλίγον ἀφίεται, ὀλίγον ἀγαπᾷ."
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          "εἶπεν δὲ αὐτῇ· Ἀφέωνταί σου αἱ ἁμαρτίαι."
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          "καὶ ἤρξαντο οἱ συνανακείμενοι λέγειν ἐν ἑαυτοῖς· Τίς οὗτός ἐστιν ὃς καὶ ἁμαρτίας ἀφίησιν;"
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          "εἶπεν δὲ πρὸς τὴν γυναῖκα· Ἡ πίστις σου σέσωκέν σε· πορεύου εἰς εἰρήνην."
        ]
      }
    ],
