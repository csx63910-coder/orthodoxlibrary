  },
  "chapter": {
    "number": 12,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἐν οἷς ἐπισυναχθεισῶν τῶν μυριάδων τοῦ ὄχλου, ὥστε καταπατεῖν ἀλλήλους, ἤρξατο λέγειν πρὸς τοὺς μαθητὰς αὐτοῦ πρῶτον· Προσέχετε ἑαυτοῖς ἀπὸ τῆς ζύμης, ⸂ἥτις ἐστὶν ὑπόκρισις, τῶν Φαρισαίων⸃.",
          {
            "noteId": 543
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "οὐδὲν δὲ συγκεκαλυμμένον ἐστὶν ὃ οὐκ ἀποκαλυφθήσεται, καὶ κρυπτὸν ὃ οὐ γνωσθήσεται."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἀνθʼ ὧν ὅσα ἐν τῇ σκοτίᾳ εἴπατε ἐν τῷ φωτὶ ἀκουσθήσεται, καὶ ὃ πρὸς τὸ οὖς ἐλαλήσατε ἐν τοῖς ταμείοις κηρυχθήσεται ἐπὶ τῶν δωμάτων."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Λέγω δὲ ὑμῖν τοῖς φίλοις μου, μὴ φοβηθῆτε ἀπὸ τῶν ἀποκτεινόντων τὸ σῶμα καὶ μετὰ ταῦτα μὴ ἐχόντων περισσότερόν τι ποιῆσαι."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ὑποδείξω δὲ ὑμῖν τίνα φοβηθῆτε· φοβήθητε τὸν μετὰ τὸ ἀποκτεῖναι ⸂ἔχοντα ἐξουσίαν",
          {
            "noteId": 544
          },
          "ἐμβαλεῖν εἰς τὴν γέενναν· ναί, λέγω ὑμῖν, τοῦτον φοβήθητε."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "οὐχὶ πέντε στρουθία ⸀πωλοῦνται",
          {
            "noteId": 545
          },
          "ἀσσαρίων δύο; καὶ ἓν ἐξ αὐτῶν οὐκ ἔστιν ἐπιλελησμένον ἐνώπιον τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἀλλὰ καὶ αἱ τρίχες τῆς κεφαλῆς ὑμῶν πᾶσαι ἠρίθμηνται· ⸀μὴ",
          {
            "noteId": 546
          },
          "φοβεῖσθε· πολλῶν στρουθίων διαφέρετε."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Λέγω δὲ ὑμῖν, πᾶς ὃς ἂν ⸀ὁμολογήσῃ",
          {
            "noteId": 547
          },
          "ἐν ἐμοὶ ἔμπροσθεν τῶν ἀνθρώπων, καὶ ὁ υἱὸς τοῦ ἀνθρώπου ὁμολογήσει ἐν αὐτῷ ἔμπροσθεν τῶν ἀγγέλων τοῦ θεοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ὁ δὲ ἀρνησάμενός με ἐνώπιον τῶν ἀνθρώπων ἀπαρνηθήσεται ἐνώπιον τῶν ἀγγέλων τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ πᾶς ὃς ἐρεῖ λόγον εἰς τὸν υἱὸν τοῦ ἀνθρώπου, ἀφεθήσεται αὐτῷ τῷ δὲ εἰς τὸ ἅγιον πνεῦμα βλασφημήσαντι οὐκ ἀφεθήσεται."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ὅταν δὲ ⸀εἰσφέρωσιν",
          {
            "noteId": 548
          },
          "ὑμᾶς ἐπὶ τὰς συναγωγὰς καὶ τὰς ἀρχὰς καὶ τὰς ἐξουσίας, μὴ ⸀μεριμνήσητε",
          {
            "noteId": 549
          },
          "πῶς ⸂ἢ τί",
          {
            "noteId": 550
          },
          "ἀπολογήσησθε ἢ τί εἴπητε·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "τὸ γὰρ ἅγιον πνεῦμα διδάξει ὑμᾶς ἐν αὐτῇ τῇ ὥρᾳ ἃ δεῖ εἰπεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Εἶπεν δέ τις ⸂ἐκ τοῦ ὄχλου αὐτῷ",
          {
            "noteId": 551
          },
          "· Διδάσκαλε, εἰπὲ τῷ ἀδελφῷ μου μερίσασθαι μετʼ ἐμοῦ τὴν κληρονομίαν."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ὁ δὲ εἶπεν αὐτῷ· Ἄνθρωπε, τίς με κατέστησεν ⸀κριτὴν",
          {
            "noteId": 552
          },
          "ἢ μεριστὴν ἐφʼ ὑμᾶς;"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "εἶπεν δὲ πρὸς αὐτούς· Ὁρᾶτε καὶ φυλάσσεσθε ἀπὸ ⸀πάσης",
          {
            "noteId": 553
          },
          "πλεονεξίας, ὅτι οὐκ ἐν τῷ περισσεύειν τινὶ ἡ ζωὴ ⸀αὐτοῦ",
          {
            "noteId": 554
          },
          "ἐστιν ἐκ τῶν ὑπαρχόντων ⸀αὐτῷ",
          {
            "noteId": 555
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "εἶπεν δὲ παραβολὴν πρὸς αὐτοὺς λέγων· Ἀνθρώπου τινὸς πλουσίου εὐφόρησεν ἡ χώρα."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καὶ διελογίζετο ἐν ⸀ἑαυτῷ",
          {
            "noteId": 556
          },
          "λέγων· Τί ποιήσω, ὅτι οὐκ ἔχω ποῦ συνάξω τοὺς καρπούς μου;"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ εἶπεν· Τοῦτο ποιήσω· καθελῶ μου τὰς ἀποθήκας καὶ μείζονας οἰκοδομήσω, καὶ συνάξω ἐκεῖ πάντα ⸂τὸν σῖτον",
          {
            "noteId": 557
          },
          "καὶ τὰ ἀγαθά μου,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "καὶ ἐρῶ τῇ ψυχῇ μου· Ψυχή, ἔχεις πολλὰ ἀγαθὰ κείμενα εἰς ἔτη πολλά· ἀναπαύου, φάγε, πίε, εὐφραίνου."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "εἶπεν δὲ αὐτῷ ὁ θεός· ⸀Ἄφρων",
          {
            "noteId": 558
          },
          "ταύτῃ τῇ νυκτὶ τὴν ψυχήν σου ⸀ἀπαιτοῦσιν",
          {
            "noteId": 559
          },
          "ἀπὸ σοῦ· ἃ δὲ ἡτοίμασας, τίνι ἔσται;"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "οὕτως ὁ θησαυρίζων ⸀ἑαυτῷ",
          {
            "noteId": 560
          },
          "καὶ μὴ εἰς θεὸν πλουτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Εἶπεν δὲ πρὸς τοὺς μαθητὰς αὐτοῦ· Διὰ τοῦτο ⸂λέγω ὑμῖν",
          {
            "noteId": 561
          },
          ", μὴ μεριμνᾶτε τῇ ⸀ψυχῇ",
          {
            "noteId": 562
          },
          "τί φάγητε, μηδὲ τῷ ⸀σώματι",
          {
            "noteId": 563
          },
          "τί ἐνδύσησθε."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ἡ ⸀γὰρ",
          {
            "noteId": 564
          },
          "ψυχὴ πλεῖόν ἐστιν τῆς τροφῆς καὶ τὸ σῶμα τοῦ ἐνδύματος."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "κατανοήσατε τοὺς κόρακας ὅτι οὐ σπείρουσιν οὐδὲ θερίζουσιν, οἷς οὐκ ἔστιν ταμεῖον οὐδὲ ἀποθήκη, καὶ ὁ θεὸς τρέφει αὐτούς· πόσῳ μᾶλλον ὑμεῖς διαφέρετε τῶν πετεινῶν."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "τίς δὲ ἐξ ὑμῶν μεριμνῶν δύναται ⸂ἐπὶ τὴν ἡλικίαν αὐτοῦ προσθεῖναι",
          {
            "noteId": 565
          },
          "⸀πῆχυν",
          {
            "noteId": 566
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "εἰ οὖν ⸀οὐδὲ",
          {
            "noteId": 567
          },
          "ἐλάχιστον δύνασθε, τί περὶ τῶν λοιπῶν μεριμνᾶτε;"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "κατανοήσατε τὰ κρίνα πῶς αὐξάνει· οὐ κοπιᾷ οὐδὲ νήθει· λέγω δὲ ὑμῖν, οὐδὲ Σολομὼν ἐν πάσῃ τῇ δόξῃ αὐτοῦ περιεβάλετο ὡς ἓν τούτων."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "εἰ δὲ ⸂ἐν ἀγρῷ τὸν χόρτον ὄντα σήμερον",
          {
            "noteId": 568
          },
          "καὶ αὔριον εἰς κλίβανον βαλλόμενον ὁ θεὸς οὕτως ⸀ἀμφιέζει",
          {
            "noteId": 569
          },
          "πόσῳ μᾶλλον ὑμᾶς, ὀλιγόπιστοι."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "καὶ",
          {
            "noteId": 570
          },
          "ὑμεῖς μὴ ζητεῖτε τί φάγητε ⸀καὶ τί πίητε, καὶ μὴ μετεωρίζεσθε,"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ταῦτα γὰρ πάντα τὰ ἔθνη τοῦ κόσμου ⸀ἐπιζητοῦσιν",
          {
            "noteId": 571
          },
          "ὑμῶν δὲ ὁ πατὴρ οἶδεν ὅτι χρῄζετε τούτων."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "πλὴν ζητεῖτε τὴν βασιλείαν ⸀αὐτοῦ",
          {
            "noteId": 572
          },
          "καὶ ⸀ταῦτα",
          {
            "noteId": 573
          },
          "προστεθήσεται ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Μὴ φοβοῦ, τὸ μικρὸν ποίμνιον, ὅτι εὐδόκησεν ὁ πατὴρ ὑμῶν δοῦναι ὑμῖν τὴν βασιλείαν."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "πωλήσατε τὰ ὑπάρχοντα ὑμῶν καὶ δότε ἐλεημοσύνην· ποιήσατε ἑαυτοῖς βαλλάντια μὴ παλαιούμενα, θησαυρὸν ἀνέκλειπτον ἐν τοῖς οὐρανοῖς, ὅπου κλέπτης οὐκ ἐγγίζει οὐδὲ σὴς διαφθείρει·"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "ὅπου γάρ ἐστιν ὁ θησαυρὸς ὑμῶν, ἐκεῖ καὶ ἡ καρδία ὑμῶν ἔσται."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "Ἔστωσαν ὑμῶν αἱ ὀσφύες περιεζωσμέναι καὶ οἱ λύχνοι καιόμενοι,"
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "καὶ ὑμεῖς ὅμοιοι ἀνθρώποις προσδεχομένοις τὸν κύριον ἑαυτῶν πότε ἀναλύσῃ ἐκ τῶν γάμων, ἵνα ἐλθόντος καὶ κρούσαντος εὐθέως ἀνοίξωσιν αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "μακάριοι οἱ δοῦλοι ἐκεῖνοι, οὓς ἐλθὼν ὁ κύριος εὑρήσει γρηγοροῦντας· ἀμὴν λέγω ὑμῖν ὅτι περιζώσεται καὶ ἀνακλινεῖ αὐτοὺς καὶ παρελθὼν διακονήσει αὐτοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "⸂κἂν ἐν τῇ δευτέρᾳ κἂν",
          {
            "noteId": 574
          },
          "ἐν τῇ τρίτῃ φυλακῇ ἔλθῃ καὶ εὕρῃ οὕτως, μακάριοί ⸀εἰσιν",
          {
            "noteId": 575
          },
          "ἐκεῖνοι."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "Τοῦτο δὲ γινώσκετε ὅτι εἰ ᾔδει ὁ οἰκοδεσπότης ποίᾳ ὥρᾳ ὁ κλέπτης ἔρχεται, ⸂οὐκ ἂν",
          {
            "noteId": 576
          },
          "ἀφῆκεν ⸀διορυχθῆναι",
          {
            "noteId": 577
          },
          "τὸν οἶκον αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "καὶ ⸀ὑμεῖς",
          {
            "noteId": 578
          },
          "γίνεσθε ἕτοιμοι, ὅτι ᾗ ὥρᾳ οὐ δοκεῖτε ὁ υἱὸς τοῦ ἀνθρώπου ἔρχεται."
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "Εἶπεν ⸀δὲ",
          {
            "noteId": 579
          },
          "ὁ Πέτρος· Κύριε, πρὸς ἡμᾶς τὴν παραβολὴν ταύτην λέγεις ἢ καὶ πρὸς πάντας;"
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "⸂καὶ εἶπεν",
          {
            "noteId": 580
          },
          "ὁ",
          {
            "noteId": 581
          },
          "κύριος· Τίς ἄρα ἐστὶν ὁ πιστὸ",
          {
            "noteId": 582
          },
          "οἰκονόμος, ⸀ὁ φρόνιμος, ὃν καταστήσει ὁ κύριος ἐπὶ τῆς θεραπείας αὐτοῦ τοῦ διδόναι ἐν καιρῷ ⸀τὸ σιτομέτριον;"
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "μακάριος ὁ δοῦλος ἐκεῖνος, ὃν ἐλθὼν ὁ κύριος αὐτοῦ εὑρήσει ποιοῦντα οὕτως·"
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "ἀληθῶς λέγω ὑμῖν ὅτι ἐπὶ πᾶσιν τοῖς ὑπάρχουσιν αὐτοῦ καταστήσει αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "ἐὰν δὲ εἴπῃ ὁ δοῦλος ἐκεῖνος ἐν τῇ καρδίᾳ αὐτοῦ· Χρονίζει ὁ κύριός μου ἔρχεσθαι, καὶ ἄρξηται τύπτειν τοὺς παῖδας καὶ τὰς παιδίσκας, ἐσθίειν τε καὶ πίνειν καὶ μεθύσκεσθαι,"
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "ἥξει ὁ κύριος τοῦ δούλου ἐκείνου ἐν ἡμέρᾳ ᾗ οὐ προσδοκᾷ καὶ ἐν ὥρᾳ ᾗ οὐ γινώσκει, καὶ διχοτομήσει αὐτὸν καὶ τὸ μέρος αὐτοῦ μετὰ τῶν ἀπίστων θήσει."
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          "ἐκεῖνος δὲ ὁ δοῦλος ὁ γνοὺς τὸ θέλημα τοῦ κυρίου ⸀αὐτοῦ",
          {
            "noteId": 583
          },
          "καὶ μὴ ἑτοιμάσας ⸀ἢ",
          {
            "noteId": 584
          },
          "ποιήσας πρὸς τὸ θέλημα αὐτοῦ δαρήσεται πολλάς·"
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          "ὁ δὲ μὴ γνοὺς ποιήσας δὲ ἄξια πληγῶν δαρήσεται ὀλίγας. παντὶ δὲ ᾧ ἐδόθη πολύ, πολὺ ζητηθήσεται παρʼ αὐτοῦ, καὶ ᾧ παρέθεντο πολύ, περισσότερον αἰτήσουσιν αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          "Πῦρ ἦλθον βαλεῖν ⸀ἐπὶ",
          {
            "noteId": 585
          },
          "τὴν γῆν, καὶ τί θέλω εἰ ἤδη ἀνήφθη;"
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          "βάπτισμα δὲ ἔχω βαπτισθῆναι, καὶ πῶς συνέχομαι ἕως ⸀ὅτου",
          {
            "noteId": 586
          },
          "τελεσθῇ."
        ]
      },
      {
        "type": "verse",
        "number": 51,
        "content": [
          "δοκεῖτε ὅτι εἰρήνην παρεγενόμην δοῦναι ἐν τῇ γῇ; οὐχί, λέγω ὑμῖν, ἀλλʼ ἢ διαμερισμόν."
        ]
      },
      {
        "type": "verse",
        "number": 52,
        "content": [
          "ἔσονται γὰρ ἀπὸ τοῦ νῦν πέντε ἐν ⸂ἑνὶ οἴκῳ",
          {
            "noteId": 587
          },
          "διαμεμερισμένοι, τρεῖς ἐπὶ δυσὶν καὶ δύο ἐπὶ τρισίν,"
        ]
      },
      {
        "type": "verse",
        "number": 53,
        "content": [
          "⸀διαμερισθήσονται",
          {
            "noteId": 588
          },
          "πατὴρ ἐπὶ",
          {
            "noteId": 589
          },
          "υἱῷ καὶ υἱὸς ἐπὶ πατρί, μήτηρ ⸀ἐπὶ ⸀θυγατέρα",
          {
            "noteId": 590
          },
          "καὶ θυγάτηρ ἐπὶ ⸂τὴν μητέρα",
          {
            "noteId": 591
          },
          ", πενθερὰ ἐπὶ τὴν νύμφην αὐτῆς καὶ νύμφη ἐπὶ τὴν ⸀πενθεράν",
          {
            "noteId": 592
          }
        ]
      },
      {
        "type": "verse",
        "number": 54,
        "content": [
          "Ἔλεγεν δὲ καὶ τοῖς ὄχλοις· Ὅταν ⸀ἴδητε",
          {
            "noteId": 593
          },
          "νεφέλην ἀνατέλλουσαν ⸀ἐπὶ",
          {
            "noteId": 594
          },
          "δυσμῶν, εὐθέως λέγετε ⸀ὅτι",
          {
            "noteId": 595
          },
          "Ὄμβρος ἔρχεται, καὶ γίνεται οὕτως·"
