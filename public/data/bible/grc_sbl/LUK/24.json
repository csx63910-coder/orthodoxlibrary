    "title": "ΚΑΤΑ ΛΟΥΚΑΝ",
    "order": 42,
    "numberOfChapters": 24,
    "sha256": "839f1e36ca0cd346cfcf1eb495dbaee8d3c56aba92f692b9696bd759f50e48be",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_sbl/LUK/1.json",
    "lastChapterNumber": 24,
    "lastChapterApiLink": "/api/grc_sbl/LUK/24.json",
    "totalNumberOfVerses": 1149
  },
  "chapter": {
    "number": 24,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "τῇ δὲ μιᾷ τῶν σαββάτων ὄρθρου βαθέως ⸂ἐπὶ τὸ μνῆμα ἦλθον",
          {
            "noteId": 1086
          },
          "φέρουσαι ἃ ἡτοίμασαν ⸀ἀρώματα",
          {
            "noteId": 1087
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "εὗρον δὲ τὸν λίθον ἀποκεκυλισμένον ἀπὸ τοῦ μνημείου,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "⸂εἰσελθοῦσαι δὲ",
          {
            "noteId": 1088
          },
          "οὐχ εὗρον τὸ ⸀σῶμα",
          {
            "noteId": 1089
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ ἐγένετο ἐν τῷ ⸀ἀπορεῖσθαι",
          {
            "noteId": 1090
          },
          "αὐτὰς περὶ τούτου καὶ ἰδοὺ ἄνδρες δύο ἐπέστησαν αὐταῖς ἐν ⸂ἐσθῆτι ἀστραπτούσῃ",
          {
            "noteId": 1091
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἐμφόβων δὲ γενομένων αὐτῶν καὶ κλινουσῶν ⸂τὰ πρόσωπα",
          {
            "noteId": 1092
          },
          "εἰς τὴν γῆν εἶπαν πρὸς αὐτάς· Τί ζητεῖτε τὸν ζῶντα μετὰ τῶν νεκρῶν;"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "⸂οὐκ ἔστιν ὧδε, ἀλλὰ ἠγέρθη.⸃ μνήσθητε ὡς ἐλάλησεν ὑμῖν ἔτι ὢν ἐν τῇ Γαλιλαίᾳ,",
          {
            "noteId": 1093
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "λέγων ⸂τὸν υἱὸν τοῦ ἀνθρώπου ὅτι δεῖ",
          {
            "noteId": 1094
          },
          "παραδοθῆναι εἰς χεῖρας ἀνθρώπων ἁμαρτωλῶν καὶ σταυρωθῆναι καὶ τῇ τρίτῃ ἡμέρᾳ ἀναστῆναι."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ ἐμνήσθησαν τῶν ῥημάτων αὐτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ ὑποστρέψασαι ἀπὸ τοῦ μνημείου ἀπήγγειλαν ταῦτα πάντα τοῖς ἕνδεκα καὶ πᾶσιν τοῖς λοιποῖς."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἦσαν δὲ ἡ",
          {
            "noteId": 1095
          },
          "Μαγδαληνὴ Μαρία καὶ Ἰωάννα καὶ Μαρία ⸀ἡ Ἰακώβου καὶ αἱ λοιπαὶ σὺν αὐταῖς· ⸀ἔλεγον",
          {
            "noteId": 1096
          },
          "πρὸς τοὺς ἀποστόλους ταῦτα."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ ἐφάνησαν ἐνώπιον αὐτῶν ὡσεὶ λῆρος τὰ ῥήματα ⸀ταῦτα",
          {
            "noteId": 1097
          },
          "καὶ ἠπίστουν αὐταῖς."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "⸂Ὁ δὲ Πέτρος ἀναστὰς ἔδραμεν ἐπὶ τὸ μνημεῖον· καὶ παρακύψας βλέπει τὰ ⸀ὀθόνια μόνα· καὶ ἀπῆλθεν πρὸς ⸀αὑτὸν θαυμάζων τὸ γεγονός",
          {
            "noteId": 1098
          },
          {
            "noteId": 1099
          },
          {
            "noteId": 1100
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Καὶ ἰδοὺ δύο ἐξ αὐτῶν ⸂ἐν αὐτῇ τῇ ἡμέρᾳ ἦσαν πορευόμενοι",
          {
            "noteId": 1101
          },
          "εἰς κώμην ἀπέχουσαν σταδίους ἑξήκοντα ἀπὸ Ἰερουσαλήμ, ᾗ ὄνομα Ἐμμαοῦς,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καὶ αὐτοὶ ὡμίλουν πρὸς ἀλλήλους περὶ πάντων τῶν συμβεβηκότων τούτων."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ ἐγένετο ἐν τῷ ὁμιλεῖν αὐτοὺς καὶ συζητεῖν καὶ ⸀αὐτὸς",
          {
            "noteId": 1102
          },
          "Ἰησοῦς ἐγγίσας συνεπορεύετο αὐτοῖς,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "οἱ δὲ ὀφθαλμοὶ αὐτῶν ἐκρατοῦντο τοῦ μὴ ἐπιγνῶναι αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "εἶπεν δὲ πρὸς αὐτούς· Τίνες οἱ λόγοι οὗτοι οὓς ἀντιβάλλετε πρὸς ἀλλήλους περιπατοῦντες; καὶ ⸀ἐστάθησαν",
          {
            "noteId": 1103
          },
          "σκυθρωποί."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ἀποκριθεὶς δὲ ⸂εἷς ὀνόματι",
          {
            "noteId": 1104
          },
          "Κλεοπᾶς εἶπεν πρὸς αὐτόν· Σὺ μόνος παροικεῖς Ἰερουσαλὴμ καὶ οὐκ ἔγνως τὰ γενόμενα ἐν αὐτῇ ἐν ταῖς ἡμέραις ταύταις;"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "καὶ εἶπεν αὐτοῖς· Ποῖα; οἱ δὲ εἶπαν αὐτῷ· Τὰ περὶ Ἰησοῦ τοῦ ⸀Ναζαρηνοῦ",
          {
            "noteId": 1105
          },
          "ὃς ἐγένετο ἀνὴρ προφήτης δυνατὸς ἐν ἔργῳ καὶ λόγῳ ἐναντίον τοῦ θεοῦ καὶ παντὸς τοῦ λαοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ὅπως τε παρέδωκαν αὐτὸν οἱ ἀρχιερεῖς καὶ οἱ ἄρχοντες ἡμῶν εἰς κρίμα θανάτου καὶ ἐσταύρωσαν αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ἡμεῖς δὲ ἠλπίζομεν ὅτι αὐτός ἐστιν ὁ μέλλων λυτροῦσθαι τὸν Ἰσραήλ· ἀλλά γε ⸀καὶ",
          {
            "noteId": 1106
          },
          "σὺν πᾶσιν τούτοις τρίτην ταύτην ἡμέραν ⸀ἄγει",
          {
            "noteId": 1107
          },
          "ἀφʼ οὗ ταῦτα ἐγένετο."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ἀλλὰ καὶ γυναῖκές τινες ἐξ ἡμῶν ἐξέστησαν ἡμᾶς, γενόμεναι ⸀ὀρθριναὶ",
          {
            "noteId": 1108
          },
          "ἐπὶ τὸ μνημεῖον"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "καὶ μὴ εὑροῦσαι τὸ σῶμα αὐτοῦ ἦλθον λέγουσαι καὶ ὀπτασίαν ἀγγέλων ἑωρακέναι, οἳ λέγουσιν αὐτὸν ζῆν."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "καὶ",
          {
            "noteId": 1109
          },
          "ἀπῆλθόν τινες τῶν σὺν ἡμῖν ἐπὶ τὸ μνημεῖον, καὶ εὗρον οὕτως καθὼς ⸀καὶ αἱ γυναῖκες εἶπον, αὐτὸν δὲ οὐκ εἶδον."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "καὶ αὐτὸς εἶπεν πρὸς αὐτούς· Ὦ ἀνόητοι καὶ βραδεῖς τῇ καρδίᾳ τοῦ πιστεύειν ἐπὶ πᾶσιν οἷς ἐλάλησαν οἱ προφῆται·"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "οὐχὶ ταῦτα ἔδει παθεῖν τὸν χριστὸν καὶ εἰσελθεῖν εἰς τὴν δόξαν αὐτοῦ;"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "καὶ ἀρξάμενος ἀπὸ Μωϋσέως καὶ ἀπὸ πάντων τῶν προφητῶν ⸀διερμήνευσεν",
          {
            "noteId": 1110
          },
          "αὐτοῖς ἐν πάσαις ταῖς γραφαῖς τὰ περὶ ⸀ἑαυτοῦ",
          {
            "noteId": 1111
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Καὶ ἤγγισαν εἰς τὴν κώμην οὗ ἐπορεύοντο, καὶ αὐτὸς ⸀προσεποιήσατο",
          {
            "noteId": 1112
          },
          "⸀πορρώτερον",
          {
            "noteId": 1113
          },
          "πορεύεσθαι."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "καὶ παρεβιάσαντο αὐτὸν λέγοντες· Μεῖνον μεθʼ ἡμῶν, ὅτι πρὸς ἑσπέραν ἐστὶν καὶ κέκλικεν ⸀ἤδη",
          {
            "noteId": 1114
          },
          "ἡ ἡμέρα. καὶ εἰσῆλθεν τοῦ μεῖναι σὺν αὐτοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "καὶ ἐγένετο ἐν τῷ κατακλιθῆναι αὐτὸν μετʼ αὐτῶν λαβὼν τὸν ἄρτον εὐλόγησεν καὶ κλάσας ἐπεδίδου αὐτοῖς·"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "αὐτῶν δὲ διηνοίχθησαν οἱ ὀφθαλμοὶ καὶ ἐπέγνωσαν αὐτόν· καὶ αὐτὸς ἄφαντος ἐγένετο ἀπʼ αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "καὶ εἶπαν πρὸς ἀλλήλους· Οὐχὶ ἡ καρδία ἡμῶν καιομένη ἦν ⸂ἐν ἡμῖν",
          {
            "noteId": 1115
          },
          "ὡς",
          {
            "noteId": 1116
          },
          "ἐλάλει ἡμῖν ἐν τῇ ὁδῷ, ⸀ὡς διήνοιγεν ἡμῖν τὰς γραφάς;"
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "καὶ ἀναστάντες αὐτῇ τῇ ὥρᾳ ὑπέστρεψαν εἰς Ἰερουσαλήμ, καὶ εὗρον ⸀ἠθροισμένους",
          {
            "noteId": 1117
          },
          "τοὺς ἕνδεκα καὶ τοὺς σὺν αὐτοῖς,"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "λέγοντας ὅτι ⸂ὄντως ἠγέρθη ὁ κύριος",
          {
            "noteId": 1118
          },
          "καὶ ὤφθη Σίμωνι."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "καὶ αὐτοὶ ἐξηγοῦντο τὰ ἐν τῇ ὁδῷ καὶ ὡς ἐγνώσθη αὐτοῖς ἐν τῇ κλάσει τοῦ ἄρτου."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "Ταῦτα δὲ αὐτῶν λαλούντων ⸀αὐτὸς",
          {
            "noteId": 1119
          },
          "ἔστη ἐν μέσῳ ⸀αὐτῶν",
          {
            "noteId": 1120
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "πτοηθέντες δὲ καὶ ἔμφοβοι γενόμενοι ἐδόκουν πνεῦμα θεωρεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "καὶ εἶπεν αὐτοῖς· Τί τεταραγμένοι ἐστέ, καὶ διὰ τί διαλογισμοὶ ἀναβαίνουσιν ἐν ⸂τῇ καρδίᾳ",
          {
            "noteId": 1121
          },
          "ὑμῶν;"
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "ἴδετε τὰς χεῖράς μου καὶ τοὺς πόδας μου ὅτι ⸂ἐγώ εἰμι αὐτός",
          {
            "noteId": 1122
          },
          "· ψηλαφήσατέ με καὶ ἴδετε, ὅτι πνεῦμα σάρκα καὶ ὀστέα οὐκ ἔχει καθὼς ἐμὲ θεωρεῖτε ἔχοντα."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "⸂[καὶ τοῦτο εἰπὼν ⸀ἔδειξεν αὐτοῖς τὰς χεῖρας καὶ τοὺς πόδας.]⸃",
          {
            "noteId": 1123
          },
          {
            "noteId": 1124
          }
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "ἔτι δὲ ἀπιστούντων αὐτῶν ἀπὸ τῆς χαρᾶς καὶ θαυμαζόντων εἶπεν αὐτοῖς· Ἔχετέ τι βρώσιμον ἐνθάδε;"
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "οἱ δὲ ἐπέδωκαν αὐτῷ ἰχθύος ὀπτοῦ ⸀μέρος",
          {
            "noteId": 1125
          }
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "καὶ λαβὼν ἐνώπιον αὐτῶν ἔφαγεν."
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "Εἶπεν δὲ ⸂πρὸς αὐτούς",
          {
            "noteId": 1126
          },
          "· Οὗτοι οἱ λόγοι ⸀μου",
          {
            "noteId": 1127
          },
          "οὓς ἐλάλησα πρὸς ὑμᾶς ἔτι ὢν σὺν ὑμῖν, ὅτι δεῖ πληρωθῆναι πάντα τὰ γεγραμμένα ἐν τῷ νόμῳ Μωϋσέως ⸀καὶ",
          {
            "noteId": 1128
          },
          "προφήταις καὶ ψαλμοῖς περὶ ἐμοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "τότε διήνοιξεν αὐτῶν τὸν νοῦν τοῦ συνιέναι τὰς γραφάς,"
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "καὶ εἶπεν αὐτοῖς ὅτι οὕτως ⸀γέγραπται",
          {
            "noteId": 1129
          },
          "παθεῖν τὸν χριστὸν καὶ ἀναστῆναι ἐκ νεκρῶν τῇ τρίτῃ ἡμέρᾳ,"
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          "καὶ",
          {
            "noteId": 1130
          },
          "κηρυχθῆναι ἐπὶ τῷ ὀνόματι αὐτοῦ μετάνοιαν ⸀καὶ ἄφεσιν ἁμαρτιῶν εἰς πάντα τὰ ἔθνη— ⸀ἀρξάμενοι",
          {
            "noteId": 1131
          },
          "ἀπὸ Ἰερουσαλήμ·"
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          "ὑμεῖς ⸀ἐστε",
          {
            "noteId": 1132
          },
          "μάρτυρες τούτων."
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          "καὶ ἰδοὺ ἐγὼ ⸀ἐξαποστέλλω",
          {
            "noteId": 1133
          },
          "τὴν ἐπαγγελίαν τοῦ πατρός μου ἐφʼ ὑμᾶς· ὑμεῖς δὲ καθίσατε ἐν τῇ ⸀πόλει",
          {
            "noteId": 1134
          },
          "ἕως οὗ ἐνδύσησθε ⸂ἐξ ὕψους δύναμιν",
          {
            "noteId": 1135
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          "Ἐξήγαγεν δὲ αὐτοὺς ⸀ἕως",
          {
            "noteId": 1136
          },
          "⸀πρὸς",
          {
            "noteId": 1137
          },
          "Βηθανίαν, καὶ ἐπάρας τὰς χεῖρας αὐτοῦ εὐλόγησεν αὐτούς."
        ]
      },
      {
        "type": "verse",
        "number": 51,
        "content": [
          "καὶ ἐγένετο ἐν τῷ εὐλογεῖν αὐτὸν αὐτοὺς διέστη ἀπʼ αὐτῶν ⸂[καὶ ἀνεφέρετο εἰς τὸν οὐρανόν",
          {
            "noteId": 1138
          },
          "⸃."
        ]
      },
      {
        "type": "verse",
        "number": 52,
        "content": [
          "καὶ αὐτοὶ ⸂[προσκυνήσαντες αὐτὸν",
          {
            "noteId": 1139
          },
          "⸃ ὑπέστρεψαν εἰς Ἰερουσαλὴμ μετὰ χαρᾶς μεγάλης,"
        ]
      },
      {
        "type": "verse",
        "number": 53,
        "content": [
          "καὶ ἦσαν διὰ παντὸς ἐν τῷ ἱερῷ ⸀εὐλογοῦντες",
          {
            "noteId": 1140
          },
          "τὸν ⸀θεόν",
          {
            "noteId": 1141
          },
          "‘p /’ ‘/book’"
        ]
      }
    ],
