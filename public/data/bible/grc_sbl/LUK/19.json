  "chapter": {
    "number": 19,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ εἰσελθὼν διήρχετο τὴν Ἰεριχώ."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ ἰδοὺ ἀνὴρ ὀνόματι ⸀καλούμενος",
          {
            "noteId": 816
          },
          "Ζακχαῖος, καὶ αὐτὸς",
          {
            "noteId": 817
          },
          "ἦν ἀρχιτελώνης καὶ ⸀αὐτὸς πλούσιος·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ ἐζήτει ἰδεῖν τὸν Ἰησοῦν τίς ἐστιν, καὶ οὐκ ἠδύνατο ἀπὸ τοῦ ὄχλου ὅτι τῇ ἡλικίᾳ μικρὸς ἦν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ προδραμὼν ⸂εἰς τὸ",
          {
            "noteId": 818
          },
          "ἔμπροσθεν ἀνέβη ἐπὶ συκομορέαν ἵνα ἴδῃ αὐτόν, ὅτι ἐκείνης ἤμελλεν διέρχεσθαι."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ ὡς ἦλθεν ἐπὶ τὸν τόπον, ἀναβλέψας ὁ ⸀Ἰησοῦς",
          {
            "noteId": 819
          },
          "εἶπεν πρὸς αὐτόν· Ζακχαῖε, σπεύσας κατάβηθι, σήμερον γὰρ ἐν τῷ οἴκῳ σου δεῖ με μεῖναι."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ σπεύσας κατέβη, καὶ ὑπεδέξατο αὐτὸν χαίρων."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "καὶ ἰδόντες πάντες διεγόγγυζον λέγοντες ὅτι Παρὰ ἁμαρτωλῷ ἀνδρὶ εἰσῆλθεν καταλῦσαι."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "σταθεὶς δὲ Ζακχαῖος εἶπεν πρὸς τὸν κύριον· Ἰδοὺ τὰ ⸀ἡμίσιά",
          {
            "noteId": 820
          },
          "⸂μου τῶν ὑπαρχόντων",
          {
            "noteId": 821
          },
          ", κύριε, ⸂τοῖς πτωχοῖς δίδωμι",
          {
            "noteId": 822
          },
          ", καὶ εἴ τινός τι ἐσυκοφάντησα ἀποδίδωμι τετραπλοῦν."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "εἶπεν δὲ πρὸς αὐτὸν ὁ Ἰησοῦς ὅτι Σήμερον σωτηρία τῷ οἴκῳ τούτῳ ἐγένετο, καθότι καὶ αὐτὸς υἱὸς Ἀβραάμ ἐστιν·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἦλθεν γὰρ ὁ υἱὸς τοῦ ἀνθρώπου ζητῆσαι καὶ σῶσαι τὸ ἀπολωλός."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ἀκουόντων δὲ αὐτῶν ταῦτα προσθεὶς εἶπεν παραβολὴν διὰ τὸ ἐγγὺς ⸂εἶναι Ἰερουσαλὴμ αὐτὸν",
          {
            "noteId": 823
          },
          "καὶ δοκεῖν αὐτοὺς ὅτι παραχρῆμα μέλλει ἡ βασιλεία τοῦ θεοῦ ἀναφαίνεσθαι·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "εἶπεν οὖν· Ἄνθρωπός τις εὐγενὴς ἐπορεύθη εἰς χώραν μακρὰν λαβεῖν ἑαυτῷ βασιλείαν καὶ ὑποστρέψαι."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καλέσας δὲ δέκα δούλους ἑαυτοῦ ἔδωκεν αὐτοῖς δέκα μνᾶς καὶ εἶπεν πρὸς αὐτούς· ⸀Πραγματεύσασθε",
          {
            "noteId": 824
          },
          "⸂ἐν ᾧ",
          {
            "noteId": 825
          },
          "ἔρχομαι."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "οἱ δὲ πολῖται αὐτοῦ ἐμίσουν αὐτόν, καὶ ἀπέστειλαν πρεσβείαν ὀπίσω αὐτοῦ λέγοντες· Οὐ θέλομεν τοῦτον βασιλεῦσαι ἐφʼ ἡμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ ἐγένετο ἐν τῷ ἐπανελθεῖν αὐτὸν λαβόντα τὴν βασιλείαν καὶ εἶπεν φωνηθῆναι αὐτῷ τοὺς δούλους τούτους οἷς ⸀δεδώκει",
          {
            "noteId": 826
          },
          "τὸ ἀργύριον, ἵνα ⸀γνοῖ",
          {
            "noteId": 827
          },
          "τί ⸀διεπραγματεύσαντο",
          {
            "noteId": 828
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "παρεγένετο δὲ ὁ πρῶτος λέγων· Κύριε, ἡ μνᾶ σου ⸂δέκα προσηργάσατο",
          {
            "noteId": 829
          },
          "μνᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καὶ εἶπεν αὐτῷ· ⸀Εὖγε",
          {
            "noteId": 830
          },
          "ἀγαθὲ δοῦλε, ὅτι ἐν ἐλαχίστῳ πιστὸς ἐγένου, ἴσθι ἐξουσίαν ἔχων ἐπάνω δέκα πόλεων."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ ἦλθεν ὁ δεύτερος λέγων· ⸂Ἡ μνᾶ σου, κύριε⸃, ἐποίησεν πέντε μνᾶς.",
          {
            "noteId": 831
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "εἶπεν δὲ καὶ τούτῳ· Καὶ σὺ ⸂ἐπάνω γίνου",
          {
            "noteId": 832
          },
          "πέντε πόλεων."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "καὶ ⸀ὁ",
          {
            "noteId": 833
          },
          "ἕτερος ἦλθεν λέγων· Κύριε, ἰδοὺ ἡ μνᾶ σου ἣν εἶχον ἀποκειμένην ἐν σουδαρίῳ·"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ἐφοβούμην γάρ σε ὅτι ἄνθρωπος αὐστηρὸς εἶ, αἴρεις ὃ οὐκ ἔθηκας καὶ θερίζεις ὃ οὐκ ἔσπειρας."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "⸀λέγει",
          {
            "noteId": 834
          },
          "αὐτῷ· Ἐκ τοῦ στόματός σου κρίνω σε, πονηρὲ δοῦλε· ᾔδεις ὅτι ἐγὼ ἄνθρωπος αὐστηρός εἰμι, αἴρων ὃ οὐκ ἔθηκα καὶ θερίζων ὃ οὐκ ἔσπειρα;"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "καὶ διὰ τί οὐκ ἔδωκάς ⸂μου τὸ ἀργύριον",
          {
            "noteId": 835
          },
          "ἐπὶ τράπεζαν; κἀγὼ ἐλθὼν σὺν τόκῳ ἂν ⸂αὐτὸ ἔπραξα",
          {
            "noteId": 836
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "καὶ τοῖς παρεστῶσιν εἶπεν· Ἄρατε ἀπʼ αὐτοῦ τὴν μνᾶν καὶ δότε τῷ τὰς δέκα μνᾶς ἔχοντι—"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "καὶ εἶπαν αὐτῷ· Κύριε, ἔχει δέκα μνᾶς—"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "⸀λέγω",
          {
            "noteId": 837
          },
          "ὑμῖν ὅτι παντὶ τῷ ἔχοντι δοθήσεται, ἀπὸ δὲ τοῦ μὴ ἔχοντος καὶ ὃ ἔχει ⸀ἀρθήσεται.",
          {
            "noteId": 838
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "πλὴν τοὺς ἐχθρούς μου ⸀τούτους",
          {
            "noteId": 839
          },
          "τοὺς μὴ θελήσαντάς με βασιλεῦσαι ἐπʼ αὐτοὺς",
          {
            "noteId": 840
          },
          "ἀγάγετε ὧδε καὶ κατασφάξατε ⸀αὐτοὺς ἔμπροσθέν μου."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Καὶ εἰπὼν ταῦτα ἐπορεύετο ἔμπροσθεν ἀναβαίνων εἰς Ἱεροσόλυμα."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Καὶ ἐγένετο ὡς ἤγγισεν εἰς Βηθφαγὴ καὶ Βηθανίαν πρὸς τὸ ὄρος τὸ καλούμενον Ἐλαιῶν, ἀπέστειλεν δύο τῶν ⸀μαθητῶν",
          {
            "noteId": 841
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "⸀λέγων",
          {
            "noteId": 842
          },
          "Ὑπάγετε εἰς τὴν κατέναντι κώμην, ἐν ᾗ εἰσπορευόμενοι εὑρήσετε πῶλον δεδεμένον, ἐφʼ ὃν οὐδεὶς πώποτε ἀνθρώπων ἐκάθισεν, ⸀καὶ",
          {
            "noteId": 843
          },
          "λύσαντες αὐτὸν ἀγάγετε."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "καὶ ἐάν τις ὑμᾶς ἐρωτᾷ· Διὰ τί λύετε; οὕτως ⸀ἐρεῖτε",
          {
            "noteId": 844
          },
          "ὅτι Ὁ κύριος αὐτοῦ χρείαν ἔχει."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "ἀπελθόντες δὲ οἱ ἀπεσταλμένοι εὗρον καθὼς εἶπεν αὐτοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "λυόντων δὲ αὐτῶν τὸν πῶλον εἶπαν οἱ κύριοι αὐτοῦ πρὸς αὐτούς· Τί λύετε τὸν πῶλον;"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "οἱ δὲ εἶπαν ⸀ὅτι",
          {
            "noteId": 845
          },
          "Ὁ κύριος αὐτοῦ χρείαν ἔχει."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "καὶ ἤγαγον αὐτὸν πρὸς τὸν Ἰησοῦν, καὶ ἐπιρίψαντες ⸀αὐτῶν",
          {
            "noteId": 846
          },
          "τὰ ἱμάτια ἐπὶ τὸν πῶλον ἐπεβίβασαν τὸν Ἰησοῦν·"
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "πορευομένου δὲ αὐτοῦ ὑπεστρώννυον τὰ ἱμάτια ⸀ἑαυτῶν",
          {
            "noteId": 847
          },
          "ἐν τῇ ὁδῷ."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "ἐγγίζοντος δὲ αὐτοῦ ἤδη πρὸς τῇ καταβάσει τοῦ Ὄρους τῶν Ἐλαιῶν ἤρξαντο ἅπαν τὸ πλῆθος τῶν μαθητῶν χαίροντες αἰνεῖν τὸν θεὸν φωνῇ μεγάλῃ περὶ ⸀πασῶν",
          {
            "noteId": 848
          },
          "ὧν εἶδον δυνάμεων,"
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "λέγοντες· Εὐλογημένος ὁ ἐρχόμενος ⸀βασιλεὺς",
          {
            "noteId": 849
          },
          "ἐν ὀνόματι κυρίου· ⸂ἐν οὐρανῷ εἰρήνη",
          {
            "noteId": 850
          },
          "καὶ δόξα ἐν ὑψίστοις."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "καί τινες τῶν Φαρισαίων ἀπὸ τοῦ ὄχλου εἶπαν πρὸς αὐτόν· Διδάσκαλε, ἐπιτίμησον τοῖς μαθηταῖς σου."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "καὶ ἀποκριθεὶς ⸀εἶπεν",
          {
            "noteId": 851
          },
          "Λέγω ὑμῖν, ⸀ὅτι",
          {
            "noteId": 852
          },
          "ἐὰν οὗτοι ⸀σιωπήσουσιν",
          {
            "noteId": 853
          },
          "οἱ λίθοι ⸀κράξουσιν",
          {
            "noteId": 854
          }
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "Καὶ ὡς ἤγγισεν, ἰδὼν τὴν πόλιν ἔκλαυσεν ἐπʼ ⸀αὐτήν",
          {
            "noteId": 855
          }
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "λέγων ὅτι Εἰ ἔγνως ⸂ἐν τῇ ἡμέρᾳ ταύτῃ καὶ σὺ",
          {
            "noteId": 856
          },
          "τὰ πρὸς ⸀εἰρήνην",
          {
            "noteId": 857
          },
          "νῦν δὲ ἐκρύβη ἀπὸ ὀφθαλμῶν σου."
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "ὅτι ἥξουσιν ἡμέραι ἐπὶ σὲ καὶ ⸀παρεμβαλοῦσιν",
          {
            "noteId": 858
          },
          "οἱ ἐχθροί σου χάρακά σοι καὶ περικυκλώσουσίν σε καὶ συνέξουσίν σε πάντοθεν,"
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "καὶ ἐδαφιοῦσίν σε καὶ τὰ τέκνα σου ἐν σοί, καὶ οὐκ ἀφήσουσιν ⸂λίθον ἐπὶ λίθον ἐν σοί",
          {
            "noteId": 859
          },
          ", ἀνθʼ ὧν οὐκ ἔγνως τὸν καιρὸν τῆς ἐπισκοπῆς σου."
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "Καὶ εἰσελθὼν εἰς τὸ ἱερὸν ἤρξατο ἐκβάλλειν τοὺς ⸀πωλοῦντας",
          {
            "noteId": 860
          }
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "λέγων αὐτοῖς· Γέγραπται· ⸂Καὶ ἔσται",
          {
            "noteId": 861
          },
          "ὁ οἶκός μου οἶκος ⸀προσευχῆς",
          {
            "noteId": 862
          },
          "ὑμεῖς δὲ αὐτὸν ἐποιήσατε σπήλαιον λῃστῶν."
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          "Καὶ ἦν διδάσκων τὸ καθʼ ἡμέραν ἐν τῷ ἱερῷ· οἱ δὲ ἀρχιερεῖς καὶ οἱ γραμματεῖς ἐζήτουν αὐτὸν ἀπολέσαι καὶ οἱ πρῶτοι τοῦ λαοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          "καὶ οὐχ ⸀εὕρισκον",
          {
            "noteId": 863
          },
          "τὸ τί ποιήσωσιν, ὁ λαὸς γὰρ ἅπας ἐξεκρέματο αὐτοῦ ἀκούων."
        ]
      }
    ],
