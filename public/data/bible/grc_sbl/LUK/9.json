  },
  "chapter": {
    "number": 9,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Συγκαλεσάμενος δὲ τοὺς δώδεκα ἔδωκεν αὐτοῖς δύναμιν καὶ ἐξουσίαν ἐπὶ πάντα τὰ δαιμόνια καὶ νόσους θεραπεύειν,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ ἀπέστειλεν αὐτοὺς κηρύσσειν τὴν βασιλείαν τοῦ θεοῦ καὶ ἰᾶσθαι ⸂τοὺς ἀσθενεῖς",
          {
            "noteId": 367
          },
          ","
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ εἶπεν πρὸς αὐτούς· Μηδὲν αἴρετε εἰς τὴν ὁδόν, μήτε ⸀ῥάβδον",
          {
            "noteId": 368
          },
          "μήτε πήραν μήτε ἄρτον μήτε ἀργύριον, μήτε ⸀ἀνὰ",
          {
            "noteId": 369
          },
          "δύο χιτῶνας ἔχειν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ εἰς ἣν ἂν οἰκίαν εἰσέλθητε, ἐκεῖ μένετε καὶ ἐκεῖθεν ἐξέρχεσθε."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ ὅσοι ⸀ἂν",
          {
            "noteId": 370
          },
          "μὴ ⸀δέχωνται",
          {
            "noteId": 371
          },
          "ὑμᾶς, ἐξερχόμενοι ἀπὸ τῆς πόλεως ⸀ἐκείνης",
          {
            "noteId": 372
          },
          "τὸν κονιορτὸν ἀπὸ τῶν ποδῶν ὑμῶν ⸀ἀποτινάσσετε",
          {
            "noteId": 373
          },
          "εἰς μαρτύριον ἐπʼ αὐτούς."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἐξερχόμενοι δὲ διήρχοντο κατὰ τὰς κώμας εὐαγγελιζόμενοι καὶ θεραπεύοντες πανταχοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ἤκουσεν δὲ Ἡρῴδης ὁ τετραάρχης τὰ ⸀γινόμενα",
          {
            "noteId": 374
          },
          "πάντα, καὶ διηπόρει διὰ τὸ λέγεσθαι ὑπό τινων ὅτι Ἰωάννης ⸀ἠγέρθη",
          {
            "noteId": 375
          },
          "ἐκ νεκρῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ὑπό τινων δὲ ὅτι Ἠλίας ἐφάνη, ἄλλων δὲ ὅτι προφήτης ⸀τις",
          {
            "noteId": 376
          },
          "τῶν ἀρχαίων ἀνέστη."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "⸂εἶπεν δὲ",
          {
            "noteId": 377
          },
          "⸀ὁ",
          {
            "noteId": 378
          },
          "Ἡρῴδης· Ἰωάννην ἐγὼ ἀπεκεφάλισα· τίς δέ ἐστιν οὗ",
          {
            "noteId": 379
          },
          "ος περὶ ⸀οὗ ἀκούω τοιαῦτα; καὶ ἐζήτει ἰδεῖν αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Καὶ ὑποστρέψαντες οἱ ἀπόστολοι διηγήσαντο αὐτῷ ὅσα ἐποίησαν. καὶ παραλαβὼν αὐτοὺς ὑπεχώρησεν κατʼ ἰδίαν εἰς ⸂πόλιν καλουμένην Βηθσαϊδά",
          {
            "noteId": 380
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "οἱ δὲ ὄχλοι γνόντες ἠκολούθησαν αὐτῷ. καὶ ⸀ἀποδεξάμενος",
          {
            "noteId": 381
          },
          "αὐτοὺς ἐλάλει αὐτοῖς περὶ τῆς βασιλείας τοῦ θεοῦ, καὶ τοὺς χρείαν ἔχοντας θεραπείας ἰᾶτο."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ἡ δὲ ἡμέρα ἤρξατο κλίνειν· προσελθόντες δὲ οἱ δώδεκα εἶπαν αὐτῷ· Ἀπόλυσον τὸν ὄχλον, ἵνα ⸀πορευθέντες",
          {
            "noteId": 382
          },
          "εἰς τὰς κύκλῳ κώμας ⸀καὶ",
          {
            "noteId": 383
          },
          "ἀγροὺς καταλύσωσιν καὶ εὕρωσιν ἐπισιτισμόν, ὅτι ὧδε ἐν ἐρήμῳ τόπῳ ἐσμέν."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "εἶπεν δὲ πρὸς αὐτούς· Δότε αὐτοῖς ⸂ὑμεῖς φαγεῖν",
          {
            "noteId": 384
          },
          ". οἱ δὲ εἶπαν· Οὐκ εἰσὶν ἡμῖν πλεῖον ἢ ⸂ἄρτοι πέντε",
          {
            "noteId": 385
          },
          "καὶ ἰχθύες δύο, εἰ μήτι πορευθέντες ἡμεῖς ἀγοράσωμεν εἰς πάντα τὸν λαὸν τοῦτον βρώματα."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἦσαν γὰρ ὡσεὶ",
          {
            "noteId": 386
          },
          "ἄνδρες πεντακισχίλιοι. εἶπεν δὲ πρὸς τοὺς μαθητὰς αὐτοῦ· Κατακλίνατε αὐτοὺς κλισίας ⸀ὡσεὶ ἀνὰ πεντήκοντα."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ ἐποίησαν οὕτως καὶ ⸀κατέκλιναν",
          {
            "noteId": 387
          },
          "ἅπαντας."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "λαβὼν δὲ τοὺς πέντε ἄρτους καὶ τοὺς δύο ἰχθύας ἀναβλέψας εἰς τὸν οὐρανὸν εὐλόγησεν αὐτοὺς καὶ κατέκλασεν καὶ ἐδίδου τοῖς μαθηταῖς ⸀παραθεῖναι",
          {
            "noteId": 388
          },
          "τῷ ὄχλῳ."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καὶ ἔφαγον καὶ ἐχορτάσθησαν πάντες, καὶ ἤρθη τὸ περισσεῦσαν αὐτοῖς κλασμάτων κόφινοι δώδεκα."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Καὶ ἐγένετο ἐν τῷ εἶναι αὐτὸν προσευχόμενον κατὰ μόνας συνῆσαν αὐτῷ οἱ μαθηταί, καὶ ἐπηρώτησεν αὐτοὺς λέγων· Τίνα με ⸂οἱ ὄχλοι λέγουσιν",
          {
            "noteId": 389
          },
          "εἶναι;"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "οἱ δὲ ἀποκριθέντες εἶπαν· Ἰωάννην τὸν βαπτιστήν, ἄλλοι δὲ Ἠλίαν, ἄλλοι δὲ ὅτι προφήτης τις τῶν ἀρχαίων ἀνέστη."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "εἶπεν δὲ αὐτοῖς· Ὑμεῖς δὲ τίνα με λέγετε εἶναι; ⸂Πέτρος δὲ ἀποκριθεὶς",
          {
            "noteId": 390
          },
          "εἶπεν· Τὸν χριστὸν τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Ὁ δὲ ἐπιτιμήσας αὐτοῖς παρήγγειλεν μηδενὶ ⸀λέγειν",
          {
            "noteId": 391
          },
          "τοῦτο,"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "εἰπὼν ὅτι Δεῖ τὸν υἱὸν τοῦ ἀνθρώπου πολλὰ παθεῖν καὶ ἀποδοκιμασθῆναι ἀπὸ τῶν πρεσβυτέρων καὶ ἀρχιερέων καὶ γραμματέων καὶ ἀποκτανθῆναι καὶ τῇ τρίτῃ ἡμέρᾳ ⸀ἐγερθῆναι",
          {
            "noteId": 392
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Ἔλεγεν δὲ πρὸς πάντας· Εἴ τις θέλει ὀπίσω μου ⸂ἔρχεσθαι, ἀρνησάσθω⸃ ἑαυτὸν καὶ ἀράτω τὸν σταυρὸν αὐτοῦ ⸂καθʼ ἡμέραν⸃, καὶ ἀκολουθείτω μοι.",
          {
            "noteId": 393
          },
          {
            "noteId": 394
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ὃς γὰρ ⸀ἂν",
          {
            "noteId": 395
          },
          "θέλῃ τὴν ψυχὴν αὐτοῦ σῶσαι, ἀπολέσει αὐτήν· ὃς δʼ ἂν ἀπολέσῃ τὴν ψυχὴν αὐτοῦ ἕνεκεν ἐμοῦ, οὗτος σώσει αὐτήν."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "τί γὰρ ὠφελεῖται ἄνθρωπος κερδήσας τὸν κόσμον ὅλον ἑαυτὸν δὲ ἀπολέσας ἢ ζημιωθείς;"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ὃς γὰρ ἂν ἐπαισχυνθῇ με καὶ τοὺς ἐμοὺς λόγους, τοῦτον ὁ υἱὸς τοῦ ἀνθρώπου ἐπαισχυνθήσεται, ὅταν ἔλθῃ ἐν τῇ δόξῃ αὐτοῦ καὶ τοῦ πατρὸς καὶ τῶν ἁγίων ἀγγέλων."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "λέγω δὲ ὑμῖν ἀληθῶς, εἰσίν τινες τῶν ⸀αὐτοῦ",
          {
            "noteId": 396
          },
          "⸀ἑστηκότων",
          {
            "noteId": 397
          },
          "οἳ οὐ μὴ γεύσωνται θανάτου ἕως ἂν ἴδωσιν τὴν βασιλείαν τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Ἐγένετο δὲ μετὰ τοὺς λόγους τούτους ὡσεὶ ἡμέραι ὀκτὼ ⸀καὶ",
          {
            "noteId": 398
          },
          "παραλαβὼν Πέτρον καὶ Ἰωάννην καὶ Ἰάκωβον ἀνέβη εἰς τὸ ὄρος προσεύξασθαι."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "καὶ ἐγένετο ἐν τῷ προσεύχεσθαι αὐτὸν τὸ εἶδος τοῦ προσώπου αὐτοῦ ἕτερον καὶ ὁ ἱματισμὸς αὐτοῦ λευκὸς ἐξαστράπτων."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "καὶ ἰδοὺ ἄνδρες δύο συνελάλουν αὐτῷ, οἵτινες ἦσαν Μωϋσῆς καὶ Ἠλίας,"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "οἳ ὀφθέντες ἐν δόξῃ ἔλεγον τὴν ἔξοδον αὐτοῦ ἣν ἤμελλεν πληροῦν ἐν Ἰερουσαλήμ."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "ὁ δὲ Πέτρος καὶ οἱ σὺν αὐτῷ ἦσαν βεβαρημένοι ὕπνῳ· διαγρηγορήσαντες δὲ εἶδον τὴν δόξαν αὐτοῦ καὶ τοὺς δύο ἄνδρας τοὺς συνεστῶτας αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "καὶ ἐγένετο ἐν τῷ διαχωρίζεσθαι αὐτοὺς ἀπʼ αὐτοῦ εἶπεν ⸀ὁ",
          {
            "noteId": 399
          },
          "Πέτρος πρὸς τὸν Ἰησοῦν· Ἐπιστάτα, καλόν ἐστιν ἡμᾶς ὧδε εἶναι, καὶ ποιήσωμεν σκηνὰς τρεῖς, μίαν σοὶ καὶ μίαν Μωϋσεῖ καὶ μίαν Ἠλίᾳ, μὴ εἰδὼς ὃ λέγει."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "ταῦτα δὲ αὐτοῦ λέγοντος ἐγένετο νεφέλη καὶ ⸀ἐπεσκίαζεν",
          {
            "noteId": 400
          },
          "αὐτούς· ἐφοβήθησαν δὲ ἐν τῷ ⸂εἰσελθεῖν αὐτοὺς",
          {
            "noteId": 401
          },
          "εἰς τὴν νεφέλην."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "καὶ φωνὴ ἐγένετο ἐκ τῆς νεφέλης λέγουσα· Οὗτός ἐστιν ὁ υἱός μου ὁ ⸀ἐκλελεγμένος",
          {
            "noteId": 402
          },
          "αὐτοῦ ἀκούετε."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "καὶ ἐν τῷ γενέσθαι τὴν φωνὴν ⸀εὑρέθη",
          {
            "noteId": 403
          },
          "Ἰησοῦς μόνος. καὶ αὐτοὶ ἐσίγησαν καὶ οὐδενὶ ἀπήγγειλαν ἐν ἐκείναις ταῖς ἡμέραις οὐδὲν ὧν ἑώρακαν."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "Ἐγένετο ⸀δὲ",
          {
            "noteId": 404
          },
          "τῇ ἑξῆς ἡμέρᾳ κατελθόντων αὐτῶν ἀπὸ τοῦ ὄρους συνήντησεν αὐτῷ ὄχλος πολύς."
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "καὶ ἰδοὺ ἀνὴρ ἀπὸ τοῦ ὄχλου ⸀ἐβόησεν",
          {
            "noteId": 405
          },
          "λέγων· Διδάσκαλε, δέομαί σου ἐπιβλέψαι ἐπὶ τὸν υἱόν μου, ὅτι μονογενής ⸂μοί ἐστιν",
          {
            "noteId": 406
          },
          ","
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "καὶ ἰδοὺ πνεῦμα λαμβάνει αὐτόν, καὶ ἐξαίφνης κράζει, καὶ σπαράσσει αὐτὸν μετὰ ἀφροῦ καὶ ⸀μόγις",
          {
            "noteId": 407
          },
          "ἀποχωρεῖ ἀπʼ αὐτοῦ συντρῖβον αὐτόν·"
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "καὶ ἐδεήθην τῶν μαθητῶν σου ἵνα ἐκβάλωσιν αὐτό, καὶ οὐκ ἠδυνήθησαν."
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "ἀποκριθεὶς δὲ ὁ Ἰησοῦς εἶπεν· Ὦ γενεὰ ἄπιστος καὶ διεστραμμένη, ἕως πότε ἔσομαι πρὸς ὑμᾶς καὶ ἀνέξομαι ὑμῶν; προσάγαγε ⸂ὧδε τὸν υἱόν σου",
          {
            "noteId": 408
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "ἔτι δὲ προσερχομένου αὐτοῦ ἔρρηξεν αὐτὸν τὸ δαιμόνιον καὶ συνεσπάραξεν· ἐπετίμησεν δὲ ὁ Ἰησοῦς τῷ πνεύματι τῷ ἀκαθάρτῳ, καὶ ἰάσατο τὸν παῖδα καὶ ἀπέδωκεν αὐτὸν τῷ πατρὶ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "ἐξεπλήσσοντο δὲ πάντες ἐπὶ τῇ μεγαλειότητι τοῦ θεοῦ.",
          {
            "noteId": 409
          },
          "Πάντων δὲ θαυμαζόντων ἐπὶ πᾶσιν οἷς ⸀ἐποίει εἶπεν πρὸς τοὺς μαθητὰς αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "Θέσθε ὑμεῖς εἰς τὰ ὦτα ὑμῶν τοὺς λόγους τούτους, ὁ γὰρ υἱὸς τοῦ ἀνθρώπου μέλλει παραδίδοσθαι εἰς χεῖρας ἀνθρώπων."
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "οἱ δὲ ἠγνόουν τὸ ῥῆμα τοῦτο, καὶ ἦν παρακεκαλυμμένον ἀπʼ αὐτῶν ἵνα μὴ αἴσθωνται αὐτό, καὶ ἐφοβοῦντο ἐρωτῆσαι αὐτὸν περὶ τοῦ ῥήματος τούτου."
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "Εἰσῆλθεν δὲ διαλογισμὸς ἐν αὐτοῖς, τὸ τίς ἂν εἴη μείζων αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          "ὁ δὲ Ἰησοῦς ⸀εἰδὼς",
          {
            "noteId": 410
          },
          "τὸν διαλογισμὸν τῆς καρδίας αὐτῶν ἐπιλαβόμενος ⸀παιδίον",
          {
            "noteId": 411
          },
          "ἔστησεν αὐτὸ παρʼ ἑαυτῷ,"
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          "καὶ εἶπεν αὐτοῖς· Ὃς ⸀ἂν",
          {
            "noteId": 412
          },
          "δέξηται τοῦτο τὸ παιδίον ἐπὶ τῷ ὀνόματί μου ἐμὲ δέχεται, καὶ ὃς ⸁ἂν",
          {
            "noteId": 413
          },
          "ἐμὲ δέξηται δέχεται τὸν ἀποστείλαντά με· ὁ γὰρ μικρότερος ἐν πᾶσιν ὑμῖν ὑπάρχων οὗτός ⸀ἐστιν",
          {
            "noteId": 414
          },
          "μέγας."
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          "Ἀποκριθεὶς ⸀δὲ",
          {
            "noteId": 415
          },
          "Ἰωάννης εἶπεν· Ἐπιστάτα, εἴδομέν τινα ⸀ἐν",
          {
            "noteId": 416
          },
          "τῷ ὀνόματί σου ἐκβάλλοντα δαιμόνια, καὶ ⸀ἐκωλύομεν",
          {
            "noteId": 417
          },
          "αὐτὸν ὅτι οὐκ ἀκολουθεῖ μεθʼ ἡμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          "⸂εἶπεν δὲ",
          {
            "noteId": 418
          },
          "πρὸς αὐτὸν ⸀ὁ",
          {
            "noteId": 419
          },
          "Ἰησοῦς· Μὴ κωλύετε, ὃς γὰρ οὐκ ἔστιν καθʼ ⸂ὑμῶν ὑπὲρ ὑμῶν",
