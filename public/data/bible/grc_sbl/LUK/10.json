  "chapter": {
    "number": 10,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Μετὰ δὲ ταῦτα ἀνέδειξεν ὁ κύριος ⸀καὶ",
          {
            "noteId": 437
          },
          "ἑτέρους ἑβδομήκοντα ⸀δύο",
          {
            "noteId": 438
          },
          "καὶ ἀπέστειλεν αὐτοὺς ἀνὰ δύο ⸁δύο",
          {
            "noteId": 439
          },
          "πρὸ προσώπου αὐτοῦ εἰς πᾶσαν πόλιν καὶ τόπον οὗ ἤμελλεν αὐτὸς ἔρχεσθαι."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἔλεγεν ⸀δὲ",
          {
            "noteId": 440
          },
          "πρὸς αὐτούς· Ὁ μὲν θερισμὸς πολύς, οἱ δὲ ἐργάται ὀλίγοι· δεήθητε οὖν τοῦ κυρίου τοῦ θερισμοῦ ὅπως ⸂ἐργάτας ἐκβάλῃ",
          {
            "noteId": 441
          },
          "εἰς τὸν θερισμὸν αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ὑπάγετε· ⸀ἰδοὺ",
          {
            "noteId": 442
          },
          "ἀποστέλλω ὑμᾶς ὡς ἄρνας ἐν μέσῳ λύκων."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "μὴ",
          {
            "noteId": 443
          },
          "βαστάζετε βαλλάντιον, μὴ πήραν, ⸀μὴ ὑποδήματα, καὶ μηδένα κατὰ τὴν ὁδὸν ἀσπάσησθε."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "εἰς ἣν δʼ ἂν ⸂εἰσέλθητε οἰκίαν",
          {
            "noteId": 444
          },
          "πρῶτον λέγετε· Εἰρήνη τῷ οἴκῳ τούτῳ."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ ἐὰν ⸂ᾖ ἐκεῖ",
          {
            "noteId": 445
          },
          "υἱὸς εἰρήνης, ἐπαναπαήσεται ἐπʼ αὐτὸν ἡ εἰρήνη ὑμῶν· εἰ δὲ μήγε, ἐφʼ ὑμᾶς ἀνακάμψει."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἐν αὐτῇ δὲ τῇ οἰκίᾳ μένετε, ἐσθίοντες καὶ πίνοντες τὰ παρʼ αὐτῶν, ἄξιος γὰρ ὁ ἐργάτης τοῦ μισθοῦ ⸀αὐτοῦ",
          {
            "noteId": 446
          },
          "μὴ μεταβαίνετε ἐξ οἰκίας εἰς οἰκίαν."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ εἰς ἣν ἂν πόλιν εἰσέρχησθε καὶ δέχωνται ὑμᾶς, ἐσθίετε τὰ παρατιθέμενα ὑμῖν,"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ θεραπεύετε τοὺς ἐν αὐτῇ ἀσθενεῖς, καὶ λέγετε αὐτοῖς· Ἤγγικεν ἐφʼ ὑμᾶς ἡ βασιλεία τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "εἰς ἣν δʼ ἂν πόλιν ⸀εἰσέλθητε",
          {
            "noteId": 447
          },
          "καὶ μὴ δέχωνται ὑμᾶς, ἐξελθόντες εἰς τὰς πλατείας αὐτῆς εἴπατε·"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Καὶ τὸν κονιορτὸν τὸν κολληθέντα ἡμῖν ἐκ τῆς πόλεως ὑμῶν ⸂εἰς τοὺς πόδας",
          {
            "noteId": 448
          },
          "ἀπομασσόμεθα ὑμῖν· πλὴν τοῦτο γινώσκετε ὅτι ⸀ἤγγικεν",
          {
            "noteId": 449
          },
          "ἡ βασιλεία τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "λέγω ὑμῖν ὅτι Σοδόμοις ἐν τῇ ἡμέρᾳ ἐκείνῃ ἀνεκτότερον ἔσται ἢ τῇ πόλει ἐκείνῃ."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Οὐαί σοι, Χοραζίν· οὐαί σοι, Βηθσαϊδά· ὅτι εἰ ἐν Τύρῳ καὶ Σιδῶνι ⸀ἐγενήθησαν",
          {
            "noteId": 450
          },
          "αἱ δυνάμεις αἱ γενόμεναι ἐν ὑμῖν, πάλαι ἂν ἐν σάκκῳ καὶ σποδῷ ⸀καθήμενοι",
          {
            "noteId": 451
          },
          "μετενόησαν."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "πλὴν Τύρῳ καὶ Σιδῶνι ἀνεκτότερον ἔσται ἐν τῇ κρίσει ἢ ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ σύ, Καφαρναούμ, ⸂μὴ ἕως οὐρανοῦ ὑψωθήσῃ",
          {
            "noteId": 452
          },
          "; ἕως ⸀τοῦ",
          {
            "noteId": 453
          },
          "ᾅδου ⸀καταβιβασθήσῃ",
          {
            "noteId": 454
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Ὁ ἀκούων ὑμῶν ἐμοῦ ἀκούει, καὶ ὁ ἀθετῶν ὑμᾶς ἐμὲ ἀθετεῖ· ὁ δὲ ἐμὲ ἀθετῶν ἀθετεῖ τὸν ἀποστείλαντά με."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Ὑπέστρεψαν δὲ οἱ ἑβδομήκοντα ⸀δύο",
          {
            "noteId": 455
          },
          "μετὰ χαρᾶς λέγοντες· Κύριε, καὶ τὰ δαιμόνια ὑποτάσσεται ἡμῖν ἐν τῷ ὀνόματί σου."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "εἶπεν δὲ αὐτοῖς· Ἐθεώρουν τὸν Σατανᾶν ὡς ἀστραπὴν ἐκ τοῦ οὐρανοῦ πεσόντα."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἰδοὺ ⸀δέδωκα",
          {
            "noteId": 456
          },
          "ὑμῖν τὴν ἐξουσίαν τοῦ πατεῖν ἐπάνω ὄφεων καὶ σκορπίων, καὶ ἐπὶ πᾶσαν τὴν δύναμιν τοῦ ἐχθροῦ, καὶ οὐδὲν ὑμᾶς οὐ μὴ ⸀ἀδικήσῃ",
          {
            "noteId": 457
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "πλὴν ἐν τούτῳ μὴ χαίρετε ὅτι τὰ πνεύματα ὑμῖν ὑποτάσσεται, χαίρετε δὲ ὅτι τὰ ὀνόματα ὑμῶν ⸀ἐγγέγραπται",
          {
            "noteId": 458
          },
          "ἐν τοῖς οὐρανοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Ἐν αὐτῇ τῇ ὥρᾳ ἠγαλλιάσατο ⸀τῷ",
          {
            "noteId": 459
          },
          "πνεύματι ⸂τῷ ἁγίῳ",
          {
            "noteId": 460
          },
          "καὶ εἶπεν· Ἐξομολογοῦμαί σοι, πάτερ κύριε τοῦ οὐρανοῦ καὶ τῆς γῆς, ὅτι ἀπέκρυψας ταῦτα ἀπὸ σοφῶν καὶ συνετῶν, καὶ ἀπεκάλυψας αὐτὰ νηπίοις· ναί, ὁ πατήρ, ὅτι οὕτως ⸂εὐδοκία ἐγένετο",
          {
            "noteId": 461
          },
          "ἔμπροσθέν σου."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "⸀πάντα",
          {
            "noteId": 462
          },
          "μοι παρεδόθη ὑπὸ τοῦ πατρός μου, καὶ οὐδεὶς γινώσκει τίς ἐστιν ὁ υἱὸς εἰ μὴ ὁ πατήρ, καὶ τίς ἐστιν ὁ πατὴρ εἰ μὴ ὁ υἱὸς καὶ ᾧ ⸀ἐὰν",
          {
            "noteId": 463
          },
          "βούληται ὁ υἱὸς ἀποκαλύψαι."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Καὶ στραφεὶς πρὸς τοὺς μαθητὰς κατʼ ἰδίαν εἶπεν· Μακάριοι οἱ ὀφθαλμοὶ οἱ βλέποντες ἃ βλέπετε."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "λέγω γὰρ ὑμῖν ὅτι πολλοὶ προφῆται καὶ βασιλεῖς ἠθέλησαν ἰδεῖν ἃ ὑμεῖς βλέπετε καὶ οὐκ εἶδαν, καὶ ἀκοῦσαι ἃ ἀκούετε καὶ οὐκ ἤκουσαν."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Καὶ ἰδοὺ νομικός τις ἀνέστη ἐκπειράζων ⸀αὐτὸν",
          {
            "noteId": 464
          },
          "λέγων· Διδάσκαλε, τί ποιήσας ζωὴν αἰώνιον κληρονομήσω;"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ὁ δὲ εἶπεν πρὸς αὐτόν· Ἐν τῷ νόμῳ τί γέγραπται; πῶς ἀναγινώσκεις;"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "ὁ δὲ ἀποκριθεὶς εἶπεν· Ἀγαπήσεις κύριον τὸν θεόν σου ἐξ ὅλης ⸀τῆς",
          {
            "noteId": 465
          },
          "καρδίας σου καὶ ⸂ἐν ὅλῃ τῇ ψυχῇ",
          {
            "noteId": 466
          },
          "σου καὶ ⸂ἐν ὅλῃ τῇ ἰσχύϊ",
          {
            "noteId": 467
          },
          "σου καὶ ⸂ἐν ὅλῃ τῇ διανοίᾳ",
          {
            "noteId": 468
          },
          "σου, καὶ τὸν πλησίον σου ὡς σεαυτόν."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "εἶπεν δὲ αὐτῷ· Ὀρθῶς ἀπεκρίθης· τοῦτο ποίει καὶ ζήσῃ."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Ὁ δὲ θέλων ⸀δικαιῶσαι",
          {
            "noteId": 469
          },
          "ἑαυτὸν εἶπεν πρὸς τὸν Ἰησοῦν· Καὶ τίς ἐστίν μου πλησίον;"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ὑπολαβὼν ⸀δὲ",
          {
            "noteId": 470
          },
          "ὁ Ἰησοῦς εἶπεν· Ἄνθρωπός τις κατέβαινεν ἀπὸ Ἰερουσαλὴμ εἰς Ἰεριχὼ καὶ λῃσταῖς περιέπεσεν, οἳ καὶ ἐκδύσαντες αὐτὸν καὶ πληγὰς ἐπιθέντες ἀπῆλθον ἀφέντες ⸀ἡμιθανῆ",
          {
            "noteId": 471
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "κατὰ συγκυρίαν δὲ ἱερεύς τις κατέβαινεν ἐν τῇ ὁδῷ ἐκείνῃ, καὶ ἰδὼν αὐτὸν ἀντιπαρῆλθεν·"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "ὁμοίως δὲ καὶ ⸀Λευίτης",
          {
            "noteId": 472
          },
          "κατὰ τὸν τόπον ἐλθὼν καὶ ἰδὼν ἀντιπαρῆλθεν."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "Σαμαρίτης δέ τις ὁδεύων ἦλθεν κατʼ αὐτὸν καὶ ⸀ἰδὼν",
          {
            "noteId": 473
          },
          "ἐσπλαγχνίσθη,"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "καὶ προσελθὼν κατέδησεν τὰ τραύματα αὐτοῦ ἐπιχέων ἔλαιον καὶ οἶνον, ἐπιβιβάσας δὲ αὐτὸν ἐπὶ τὸ ἴδιον κτῆνος ἤγαγεν αὐτὸν εἰς πανδοχεῖον καὶ ἐπεμελήθη αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "καὶ ἐπὶ τὴν ⸀αὔριον",
          {
            "noteId": 474
          },
          "ἐκβαλὼν ⸂δύο δηνάρια ἔδωκεν",
          {
            "noteId": 475
          },
          "τῷ πανδοχεῖ καὶ ⸀εἶπεν",
          {
            "noteId": 476
          },
          "Ἐπιμελήθητι αὐτοῦ, καὶ ὅ τι ἂν προσδαπανήσῃς ἐγὼ ἐν τῷ ἐπανέρχεσθαί με ἀποδώσω σοι."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "⸀τίς",
          {
            "noteId": 477
          },
          "τούτων τῶν τριῶν πλησίον δοκεῖ σοι γεγονέναι τοῦ ἐμπεσόντος εἰς τοὺς λῃστάς;"
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "ὁ δὲ",
          {
            "noteId": 478
          },
          "εἶπεν· Ὁ ποιήσας τὸ ἔλεος μετʼ αὐτοῦ. εἶπεν ⸀δὲ αὐτῷ ὁ Ἰησοῦς· Πορεύου καὶ σὺ ποίει ὁμοίως."
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "⸂Ἐν δὲ",
          {
            "noteId": 479
          },
          "τῷ πορεύεσθαι ⸀αὐτοὺς",
          {
            "noteId": 480
          },
          "αὐτὸς εἰσῆλθεν εἰς κώμην τινά· γυνὴ δέ τις ὀνόματι Μάρθα ὑπεδέξατο ⸀αὐτὸν",
          {
            "noteId": 481
          }
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "καὶ τῇδε ἦν ἀδελφὴ καλουμένη ⸀Μαριάμ",
          {
            "noteId": 482
          },
          "ἣ καὶ ⸂παρακαθεσθεῖσα πρὸς",
          {
            "noteId": 483
          },
          "τοὺς πόδας τοῦ ⸀Ἰησοῦ",
          {
            "noteId": 484
          },
          "ἤκουεν τὸν λόγον αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "ἡ δὲ Μάρθα περιεσπᾶτο περὶ πολλὴν διακονίαν· ἐπιστᾶσα δὲ εἶπεν· Κύριε, οὐ μέλει σοι ὅτι ἡ ἀδελφή μου μόνην με ⸀κατέλειπεν",
          {
            "noteId": 485
          },
          "διακονεῖν; ⸀εἰπὲ",
          {
            "noteId": 486
          },
          "οὖν αὐτῇ ἵνα μοι συναντιλάβηται."
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "ἀποκριθεὶς δὲ εἶπεν αὐτῇ ὁ ⸀κύριος",
          {
            "noteId": 487
          },
          "Μάρθα Μάρθα, μεριμνᾷς καὶ ⸀θορυβάζῃ",
          {
            "noteId": 488
          },
          "περὶ πολλά,"
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "⸂ὀλίγων δέ ἐστιν χρεία ἢ ἑνός",
          {
            "noteId": 489
          },
          "· ⸂Μαριὰμ γὰρ",
          {
            "noteId": 490
          },
          "τὴν ἀγαθὴν μερίδα ἐξελέξατο ἥτις οὐκ ἀφαιρεθήσεται ⸀αὐτῆς",
          {
            "noteId": 491
          }
        ]
      }
    ],
