  "chapter": {
    "number": 21,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἀναβλέψας δὲ εἶδεν τοὺς βάλλοντας ⸂εἰς τὸ γαζοφυλάκιον τὰ δῶρα αὐτῶν",
          {
            "noteId": 908
          },
          "πλουσίους."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "εἶδεν δέ ⸀τινα",
          {
            "noteId": 909
          },
          "χήραν πενιχρὰν βάλλουσαν ἐκεῖ ⸂λεπτὰ δύο",
          {
            "noteId": 910
          },
          ","
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ εἶπεν· Ἀληθῶς λέγω ὑμῖν ὅτι ἡ χήρα ⸂ἡ πτωχὴ αὕτη",
          {
            "noteId": 911
          },
          "πλεῖον πάντων ἔβαλεν·"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "⸀πάντες",
          {
            "noteId": 912
          },
          "γὰρ οὗτοι ἐκ τοῦ περισσεύοντος αὐτοῖς ἔβαλον εἰς τὰ ⸀δῶρα",
          {
            "noteId": 913
          },
          "αὕτη δὲ ἐκ τοῦ ὑστερήματος αὐτῆς ⸀πάντα",
          {
            "noteId": 914
          },
          "τὸν βίον ὃν εἶχεν ἔβαλεν."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Καί τινων λεγόντων περὶ τοῦ ἱεροῦ, ὅτι λίθοις καλοῖς καὶ ἀναθήμασιν κεκόσμηται εἶπεν·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ταῦτα ἃ θεωρεῖτε, ἐλεύσονται ἡμέραι ἐν αἷς οὐκ ἀφεθήσεται λίθος ἐπὶ ⸀λίθῳ",
          {
            "noteId": 915
          },
          "ὃς οὐ καταλυθήσεται."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ἐπηρώτησαν δὲ αὐτὸν λέγοντες· Διδάσκαλε, πότε οὖν ταῦτα ἔσται, καὶ τί τὸ σημεῖον ὅταν μέλλῃ ταῦτα γίνεσθαι;"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ὁ δὲ εἶπεν· Βλέπετε μὴ πλανηθῆτε· πολλοὶ γὰρ ἐλεύσονται ἐπὶ τῷ ὀνόματί μου ⸀λέγοντες",
          {
            "noteId": 916
          },
          "Ἐγώ εἰμι καί· Ὁ καιρὸς ἤγγικεν· ⸀μὴ",
          {
            "noteId": 917
          },
          "πορευθῆτε ὀπίσω αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ὅταν δὲ ἀκούσητε πολέμους καὶ ἀκαταστασίας, μὴ πτοηθῆτε· δεῖ γὰρ ταῦτα γενέσθαι πρῶτον, ἀλλʼ οὐκ εὐθέως τὸ τέλος."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "τότε ἔλεγεν αὐτοῖς· Ἐγερθήσεται ἔθνος ἐπʼ ἔθνος καὶ βασιλεία ἐπὶ βασιλείαν,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "σεισμοί τε μεγάλοι ⸂καὶ κατὰ τόπους",
          {
            "noteId": 918
          },
          "⸂λιμοὶ καὶ λοιμοὶ",
          {
            "noteId": 919
          },
          "ἔσονται, φόβητρά τε καὶ ⸂σημεῖα ἀπʼ οὐρανοῦ μεγάλα",
          {
            "noteId": 920
          },
          "ἔσται."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Πρὸ δὲ τούτων πάντων ἐπιβαλοῦσιν ἐφʼ ὑμᾶς τὰς",
          {
            "noteId": 921
          },
          "χεῖρας αὐτῶν καὶ διώξουσιν, παραδιδόντες εἰς ⸀τὰς συναγωγὰς καὶ φυλακάς, ⸀ἀπαγομένους",
          {
            "noteId": 922
          },
          "ἐπὶ βασιλεῖς καὶ ἡγεμόνας ἕνεκεν τοῦ ὀνόματός μου·"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "⸀ἀποβήσεται",
          {
            "noteId": 923
          },
          "ὑμῖν εἰς μαρτύριον."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "⸀θέτε",
          {
            "noteId": 924
          },
          "οὖν ⸂ἐν ταῖς καρδίαις",
          {
            "noteId": 925
          },
          "ὑμῶν μὴ προμελετᾶν ἀπολογηθῆναι,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ἐγὼ γὰρ δώσω ὑμῖν στόμα καὶ σοφίαν ᾗ οὐ δυνήσονται ⸂ἀντιστῆναι ἢ ἀντειπεῖν",
          {
            "noteId": 926
          },
          "⸀ἅπαντες",
          {
            "noteId": 927
          },
          "οἱ ἀντικείμενοι ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "παραδοθήσεσθε δὲ καὶ ὑπὸ γονέων καὶ ⸂ἀδελφῶν καὶ συγγενῶν καὶ φίλων",
          {
            "noteId": 928
          },
          ", καὶ θανατώσουσιν ἐξ ὑμῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καὶ ἔσεσθε μισούμενοι ὑπὸ πάντων διὰ τὸ ὄνομά μου."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ θρὶξ ἐκ τῆς κεφαλῆς ὑμῶν οὐ μὴ ἀπόληται."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἐν τῇ ὑπομονῇ ὑμῶν ⸀κτήσασθε",
          {
            "noteId": 929
          },
          "τὰς ψυχὰς ὑμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Ὅταν δὲ ἴδητε κυκλουμένην ὑπὸ ⸀στρατοπέδων",
          {
            "noteId": 930
          },
          "Ἰερουσαλήμ, τότε γνῶτε ὅτι ἤγγικεν ἡ ἐρήμωσις αὐτῆς."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "τότε οἱ ἐν τῇ Ἰουδαίᾳ φευγέτωσαν εἰς τὰ ὄρη, καὶ οἱ ἐν μέσῳ αὐτῆς ἐκχωρείτωσαν, καὶ οἱ ἐν ταῖς χώραις μὴ εἰσερχέσθωσαν εἰς αὐτήν,"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ὅτι ἡμέραι ἐκδικήσεως αὗταί εἰσιν τοῦ πλησθῆναι πάντα τὰ γεγραμμένα."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "⸀οὐαὶ",
          {
            "noteId": 931
          },
          "ταῖς ἐν γαστρὶ ἐχούσαις καὶ ταῖς θηλαζούσαις ἐν ἐκείναις ταῖς ἡμέραις· ἔσται γὰρ ἀνάγκη μεγάλη ἐπὶ τῆς γῆς καὶ ⸀ὀργὴ",
          {
            "noteId": 932
          },
          "τῷ λαῷ τούτῳ,"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "καὶ πεσοῦνται στόματι μαχαίρης καὶ αἰχμαλωτισθήσονται εἰς ⸂τὰ ἔθνη πάντα",
          {
            "noteId": 933
          },
          ", καὶ Ἰερουσαλὴμ ἔσται πατουμένη ὑπὸ ἐθνῶν, ἄχρι ⸀οὗ",
          {
            "noteId": 934
          },
          "⸀πληρωθῶσιν",
          {
            "noteId": 935
          },
          "καιροὶ ἐθνῶν."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Καὶ ⸀ἔσονται",
          {
            "noteId": 936
          },
          "σημεῖα ἐν ἡλίῳ καὶ σελήνῃ καὶ ἄστροις, καὶ ἐπὶ τῆς γῆς συνοχὴ ἐθνῶν ἐν ἀπορίᾳ ⸀ἤχους",
          {
            "noteId": 937
          },
          "θαλάσσης καὶ σάλου,"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ἀποψυχόντων ἀνθρώπων ἀπὸ φόβου καὶ προσδοκίας τῶν ἐπερχομένων τῇ οἰκουμένῃ, αἱ γὰρ δυνάμεις τῶν οὐρανῶν σαλευθήσονται."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "καὶ τότε ὄψονται τὸν υἱὸν τοῦ ἀνθρώπου ἐρχόμενον ἐν νεφέλῃ μετὰ δυνάμεως καὶ δόξης πολλῆς."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ἀρχομένων δὲ τούτων γίνεσθαι ἀνακύψατε καὶ ἐπάρατε τὰς κεφαλὰς ὑμῶν, διότι ἐγγίζει ἡ ἀπολύτρωσις ὑμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Καὶ εἶπεν παραβολὴν αὐτοῖς· Ἴδετε τὴν συκῆν καὶ πάντα τὰ δένδρα·"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ὅταν προβάλωσιν ἤδη, βλέποντες ἀφʼ ἑαυτῶν γινώσκετε ὅτι ἤδη ἐγγὺς τὸ θέρος ἐστίν·"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "οὕτως καὶ ὑμεῖς, ὅταν ἴδητε ταῦτα γινόμενα, γινώσκετε ὅτι ἐγγύς ἐστιν ἡ βασιλεία τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "ἀμὴν λέγω ὑμῖν ὅτι οὐ μὴ παρέλθῃ ἡ γενεὰ αὕτη ἕως ἂν πάντα γένηται."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "ὁ οὐρανὸς καὶ ἡ γῆ ⸀παρελεύσονται",
          {
            "noteId": 938
          },
          "οἱ δὲ λόγοι μου οὐ μὴ παρελεύσονται."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "Προσέχετε δὲ ἑαυτοῖς μήποτε βαρηθῶσιν ⸂ὑμῶν αἱ καρδίαι",
          {
            "noteId": 939
          },
          "ἐν κραιπάλῃ καὶ μέθῃ καὶ μερίμναις βιωτικαῖς, καὶ ⸂ἐπιστῇ ἐφʼ ὑμᾶς αἰφνίδιος",
          {
            "noteId": 940
          },
          "ἡ ἡμέρα ἐκείνη"
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "ὡς παγίς· ⸂ἐπεισελεύσεται γὰρ",
          {
            "noteId": 941
          },
          "ἐπὶ πάντας τοὺς καθημένους ἐπὶ πρόσωπον πάσης τῆς γῆς."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "ἀγρυπνεῖτε ⸀δὲ",
          {
            "noteId": 942
          },
          "ἐν παντὶ καιρῷ δεόμενοι ἵνα ⸀κατισχύσητε",
          {
            "noteId": 943
          },
          "ἐκφυγεῖν ⸀ταῦτα",
          {
            "noteId": 944
          },
          "πάντα τὰ μέλλοντα γίνεσθαι, καὶ σταθῆναι ἔμπροσθεν τοῦ υἱοῦ τοῦ ἀνθρώπου."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "Ἦν δὲ τὰς ἡμέρας ⸂ἐν τῷ ἱερῷ διδάσκων",
          {
            "noteId": 945
          },
          ", τὰς δὲ νύκτας ἐξερχόμενος ηὐλίζετο εἰς τὸ ὄρος τὸ καλούμενον Ἐλαιῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "καὶ πᾶς ὁ λαὸς ὤρθριζεν πρὸς αὐτὸν ἐν τῷ ἱερῷ ἀκούειν αὐτοῦ."
        ]
      }
    ],
