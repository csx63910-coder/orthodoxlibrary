  "chapter": {
    "number": 17,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Εἶπεν δὲ πρὸς τοὺς μαθητὰς ⸀αὐτοῦ",
          {
            "noteId": 736
          },
          "Ἀνένδεκτόν ἐστιν τοῦ ⸂τὰ σκάνδαλα μὴ ἐλθεῖν",
          {
            "noteId": 737
          },
          ", ⸂πλὴν οὐαὶ",
          {
            "noteId": 738
          },
          "διʼ οὗ ἔρχεται·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "λυσιτελεῖ αὐτῷ εἰ ⸂λίθος μυλικὸς",
          {
            "noteId": 739
          },
          "περίκειται περὶ τὸν τράχηλον αὐτοῦ καὶ ἔρριπται εἰς τὴν θάλασσαν ἢ ἵνα σκανδαλίσῃ ⸂τῶν μικρῶν τούτων ἕνα",
          {
            "noteId": 740
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "προσέχετε ἑαυτοῖς. ἐὰν ⸀ἁμάρτῃ",
          {
            "noteId": 741
          },
          "ὁ ἀδελφός σου ἐπιτίμησον αὐτῷ, καὶ ἐὰν μετανοήσῃ ἄφες αὐτῷ·"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ ἐὰν ἑπτάκις τῆς ἡμέρας ⸀ἁμαρτήσῃ",
          {
            "noteId": 742
          },
          "εἰς σὲ καὶ ⸀ἑπτάκις",
          {
            "noteId": 743
          },
          "ἐπιστρέψῃ ⸂πρὸς σὲ",
          {
            "noteId": 744
          },
          "λέγων· Μετανοῶ, ἀφήσεις αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Καὶ εἶπαν οἱ ἀπόστολοι τῷ κυρίῳ· Πρόσθες ἡμῖν πίστιν."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "εἶπεν δὲ ὁ κύριος· Εἰ ἔχετε πίστιν ὡς κόκκον σινάπεως, ἐλέγετε ἂν τῇ συκαμίνῳ ταύτῃ· Ἐκριζώθητι καὶ φυτεύθητι ἐν τῇ θαλάσσῃ· καὶ ὑπήκουσεν ἂν ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Τίς δὲ ἐξ ὑμῶν δοῦλον ἔχων ἀροτριῶντα ἢ ποιμαίνοντα, ὃς εἰσελθόντι ἐκ τοῦ ἀγροῦ ἐρεῖ ⸀αὐτῷ",
          {
            "noteId": 745
          },
          "Εὐθέως παρελθὼν ἀνάπεσε,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἀλλʼ οὐχὶ ἐρεῖ αὐτῷ· Ἑτοίμασον τί δειπνήσω καὶ περιζωσάμενος διακόνει μοι ἕως φάγω καὶ πίω, καὶ μετὰ ταῦτα φάγεσαι καὶ πίεσαι σύ;"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "μὴ ⸂ἔχει χάριν",
          {
            "noteId": 746
          },
          "τῷ ⸀δούλῳ",
          {
            "noteId": 747
          },
          "ὅτι ἐποίησεν τὰ ⸀διαταχθέντα",
          {
            "noteId": 748
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "οὕτως καὶ ὑμεῖς, ὅταν ποιήσητε πάντα τὰ διαταχθέντα ὑμῖν, λέγετε ὅτι Δοῦλοι ἀχρεῖοί ἐσμεν, ⸂ὃ ὠφείλομεν",
          {
            "noteId": 749
          },
          "ποιῆσαι πεποιήκαμεν."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Καὶ ἐγένετο ἐν τῷ ⸀πορεύεσθαι",
          {
            "noteId": 750
          },
          "εἰς Ἰερουσαλὴμ καὶ αὐτὸς διήρχετο διὰ ⸀μέσον",
          {
            "noteId": 751
          },
          "Σαμαρείας καὶ Γαλιλαίας."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "καὶ εἰσερχομένου αὐτοῦ εἴς τινα κώμην ⸀ἀπήντησαν",
          {
            "noteId": 752
          },
          "δέκα λεπροὶ ἄνδρες, οἳ ⸀ἔστησαν",
          {
            "noteId": 753
          },
          "πόρρωθεν,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ αὐτοὶ ἦραν φωνὴν λέγοντες· Ἰησοῦ ἐπιστάτα, ἐλέησον ἡμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καὶ ἰδὼν εἶπεν αὐτοῖς· Πορευθέντες ἐπιδείξατε ἑαυτοὺς τοῖς ἱερεῦσιν. καὶ ἐγένετο ἐν τῷ ὑπάγειν αὐτοὺς ἐκαθαρίσθησαν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "εἷς δὲ ἐξ αὐτῶν, ἰδὼν ὅτι ἰάθη, ὑπέστρεψεν μετὰ φωνῆς μεγάλης δοξάζων τὸν θεόν,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ ἔπεσεν ἐπὶ πρόσωπον παρὰ τοὺς πόδας αὐτοῦ εὐχαριστῶν αὐτῷ· καὶ αὐτὸς ἦν Σαμαρίτης."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ἀποκριθεὶς δὲ ὁ Ἰησοῦς εἶπεν· ⸀Οὐχὶ",
          {
            "noteId": 754
          },
          "οἱ δέκα ἐκαθαρίσθησαν; οἱ δὲ ἐννέα ποῦ;"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "οὐχ εὑρέθησαν ὑποστρέψαντες δοῦναι δόξαν τῷ θεῷ εἰ μὴ ὁ ἀλλογενὴς οὗτος;"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "καὶ εἶπεν αὐτῷ· Ἀναστὰς πορεύου· ἡ πίστις σου σέσωκέν σε."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Ἐπερωτηθεὶς δὲ ὑπὸ τῶν Φαρισαίων πότε ἔρχεται ἡ βασιλεία τοῦ θεοῦ ἀπεκρίθη αὐτοῖς καὶ εἶπεν· Οὐκ ἔρχεται ἡ βασιλεία τοῦ θεοῦ μετὰ παρατηρήσεως,"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "οὐδὲ ἐροῦσιν· Ἰδοὺ ὧδε ἤ· ⸀Ἐκεῖ",
          {
            "noteId": 755
          },
          "ἰδοὺ γὰρ ἡ βασιλεία τοῦ θεοῦ ἐντὸς ὑμῶν ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Εἶπεν δὲ πρὸς τοὺς μαθητάς· Ἐλεύσονται ἡμέραι ὅτε ἐπιθυμήσετε μίαν τῶν ἡμερῶν τοῦ υἱοῦ τοῦ ἀνθρώπου ἰδεῖν καὶ οὐκ ὄψεσθε."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "καὶ ἐροῦσιν ὑμῖν· Ἰδοὺ ⸂ἐκεῖ· Ἰδοὺ ὧδε",
          {
            "noteId": 756
          },
          "· μὴ ἀπέλθητε μηδὲ διώξητε."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ὥσπερ γὰρ ἡ ⸀ἀστραπὴ",
          {
            "noteId": 757
          },
          "ἀστράπτουσα ἐκ τῆς ⸂ὑπὸ τὸν",
          {
            "noteId": 758
          },
          "οὐρανὸν εἰς τὴν ὑπʼ οὐρανὸν λάμπει, οὕτως ἔσται ὁ υἱὸς τοῦ ἀνθρώπου ⸂ἐν τῇ ἡμέρᾳ αὐτοῦ",
          {
            "noteId": 759
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "πρῶτον δὲ δεῖ αὐτὸν πολλὰ παθεῖν καὶ ἀποδοκιμασθῆναι ἀπὸ τῆς γενεᾶς ταύτης."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "καὶ καθὼς ἐγένετο ἐν ταῖς ἡμέραις Νῶε, οὕτως ἔσται καὶ ἐν ταῖς ἡμέραις τοῦ υἱοῦ τοῦ ἀνθρώπου·"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "ἤσθιον, ἔπινον, ἐγάμουν, ⸀ἐγαμίζοντο",
          {
            "noteId": 760
          },
          "ἄχρι ἧς ἡμέρας εἰσῆλθεν Νῶε εἰς τὴν κιβωτόν, καὶ ἦλθεν ὁ κατακλυσμὸς καὶ ἀπώλεσεν ⸀πάντας",
          {
            "noteId": 761
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ὁμοίως ⸀καθὼς",
          {
            "noteId": 762
          },
          "ἐγένετο ἐν ταῖς ἡμέραις Λώτ· ἤσθιον, ἔπινον, ἠγόραζον, ἐπώλουν, ἐφύτευον, ᾠκοδόμουν·"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "ᾗ δὲ ἡμέρᾳ ἐξῆλθεν Λὼτ ἀπὸ Σοδόμων, ἔβρεξεν πῦρ καὶ θεῖον ἀπʼ οὐρανοῦ καὶ ἀπώλεσεν ⸀πάντας",
          {
            "noteId": 763
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "κατὰ ⸂τὰ αὐτὰ",
          {
            "noteId": 764
          },
          "ἔσται ᾗ ἡμέρᾳ ὁ υἱὸς τοῦ ἀνθρώπου ἀποκαλύπτεται."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "ἐν",
          {
            "noteId": 765
          },
          "ἐκείνῃ τῇ ἡμέρᾳ ὃς ἔσται ἐπὶ τοῦ δώματος καὶ τὰ σκεύη αὐτοῦ ἐν τῇ οἰκίᾳ, μὴ καταβάτω ἆραι αὐτά, καὶ ὁ ⸀ἐν ἀγρῷ ὁμοίως μὴ ἐπιστρεψάτω εἰς τὰ ὀπίσω."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "μνημονεύετε τῆς γυναικὸς Λώτ."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "ὃς ἐὰν ζητήσῃ τὴν ψυχὴν αὐτοῦ ⸀περιποιήσασθαι",
          {
            "noteId": 766
          },
          "ἀπολέσει αὐτήν, ⸂ὃς δʼ ἂν",
          {
            "noteId": 767
          },
          "⸀ἀπολέσῃ",
          {
            "noteId": 768
          },
          "ζῳογονήσει αὐτήν."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "λέγω ὑμῖν, ταύτῃ τῇ νυκτὶ ἔσονται δύο ἐπὶ κλίνης μιᾶς, ⸀ὁ",
          {
            "noteId": 769
          },
          "εἷς παραλημφθήσεται καὶ ὁ ἕτερος ἀφεθήσεται·"
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "⸂ἔσονται δύο",
          {
            "noteId": 770
          },
          "ἀλήθουσαι ἐπὶ τὸ αὐτό, ⸀ἡ",
          {
            "noteId": 771
          },
          "μία παραλημφθήσεται ⸂ἡ δὲ",
          {
            "noteId": 772
          },
          "ἑτέρα ⸀ἀφεθήσεται",
          {
            "noteId": 773
          }
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "καὶ ἀποκριθέντες λέγουσιν αὐτῷ· Ποῦ, κύριε; ὁ δὲ εἶπεν αὐτοῖς· Ὅπου τὸ σῶμα, ἐκεῖ ⸂καὶ οἱ ἀετοὶ ἐπισυναχθήσονται",
          {
            "noteId": 774
          },
          "."
        ]
      }
    ],
