  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἐγένετο δὲ ἐν τῷ τὸν ὄχλον ἐπικεῖσθαι αὐτῷ ⸀καὶ",
          {
            "noteId": 140
          },
          "ἀκούειν τὸν λόγον τοῦ θεοῦ καὶ αὐτὸς ἦν ἑστὼς παρὰ τὴν λίμνην Γεννησαρέτ,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ εἶδεν ⸂δύο πλοῖα",
          {
            "noteId": 141
          },
          "ἑστῶτα παρὰ τὴν λίμνην, οἱ δὲ ἁλιεῖς ⸂ἀπʼ αὐτῶν ἀποβάντες",
          {
            "noteId": 142
          },
          "⸀ἔπλυνον",
          {
            "noteId": 143
          },
          "τὰ δίκτυα."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἐμβὰς δὲ εἰς ἓν τῶν πλοίων, ὃ ⸀ἦν",
          {
            "noteId": 144
          },
          "Σίμωνος, ἠρώτησεν αὐτὸν ἀπὸ τῆς γῆς ἐπαναγαγεῖν ὀλίγον, ⸂καθίσας δὲ ἐκ τοῦ πλοίου ἐδίδασκεν",
          {
            "noteId": 145
          },
          "τοὺς ὄχλους."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ὡς δὲ ἐπαύσατο λαλῶν, εἶπεν πρὸς τὸν Σίμωνα· Ἐπανάγαγε εἰς τὸ βάθος καὶ χαλάσατε τὰ δίκτυα ὑμῶν εἰς ἄγραν."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ ἀποκριθεὶς ⸀Σίμων",
          {
            "noteId": 146
          },
          "⸀εἶπεν",
          {
            "noteId": 147
          },
          "Ἐπιστάτα, διʼ ⸀ὅλης",
          {
            "noteId": 148
          },
          "νυκτὸς κοπιάσαντες οὐδὲν ἐλάβομεν, ἐπὶ δὲ τῷ ῥήματί σου χαλάσω ⸂τὰ δίκτυα",
          {
            "noteId": 149
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ τοῦτο ποιήσαντες συνέκλεισαν πλῆθος ἰχθύων πολύ, ⸀διερρήσσετο",
          {
            "noteId": 150
          },
          "δὲ ⸂τὰ δίκτυα",
          {
            "noteId": 151
          },
          "αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "καὶ κατένευσαν τοῖς ⸀μετόχοις",
          {
            "noteId": 152
          },
          "ἐν τῷ ἑτέρῳ πλοίῳ τοῦ ἐλθόντας συλλαβέσθαι αὐτοῖς· καὶ ἦλθον, καὶ ἔπλησαν ἀμφότερα τὰ πλοῖα ὥστε βυθίζεσθαι αὐτά."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἰδὼν δὲ Σίμων Πέτρος προσέπεσεν τοῖς γόνασιν Ἰησοῦ λέγων· Ἔξελθε ἀπʼ ἐμοῦ, ὅτι ἀνὴρ ἁμαρτωλός εἰμι, κύριε·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "θάμβος γὰρ περιέσχεν αὐτὸν καὶ πάντας τοὺς σὺν αὐτῷ ἐπὶ τῇ ἄγρᾳ τῶν ἰχθύων ⸀ὧν",
          {
            "noteId": 153
          },
          "συνέλαβον,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ὁ",
          {
            "noteId": 154
          },
          "οίως δὲ καὶ Ἰάκωβον καὶ Ἰωάννην υἱοὺς Ζεβεδαίου, οἳ ἦσαν κοινωνοὶ τῷ Σίμωνι. καὶ εἶπεν πρὸς τὸν Σίμωνα ⸀ὁ Ἰησοῦς· Μὴ φοβοῦ· ἀπὸ τοῦ νῦν ἀνθρώπους ἔσῃ ζωγρῶν."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ καταγαγόντες τὰ πλοῖα ἐπὶ τὴν γῆν ἀφέντες ⸀πάντα",
          {
            "noteId": 155
          },
          "ἠκολούθησαν αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Καὶ ἐγένετο ἐν τῷ εἶναι αὐτὸν ἐν μιᾷ τῶν πόλεων καὶ ἰδοὺ ἀνὴρ πλήρης λέπρας· ⸂καὶ ἰδὼν",
          {
            "noteId": 156
          },
          "τὸν Ἰησοῦν πεσὼν ἐπὶ πρόσωπον ἐδεήθη αὐτοῦ λέγων· Κύριε, ἐὰν θέλῃς δύνασαί με καθαρίσαι."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ ἐκτείνας τὴν χεῖρα ἥψατο αὐτοῦ ⸀εἰπών",
          {
            "noteId": 157
          },
          "Θέλω, καθαρίσθητι· καὶ εὐθέως ἡ λέπρα ἀπῆλθεν ἀπʼ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καὶ αὐτὸς παρήγγειλεν αὐτῷ μηδενὶ εἰπεῖν, ἀλλὰ ἀπελθὼν δεῖξον σεαυτὸν τῷ ἱερεῖ, καὶ προσένεγκε περὶ τοῦ καθαρισμοῦ σου καθὼς προσέταξεν Μωϋσῆς εἰς μαρτύριον αὐτοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "διήρχετο δὲ μᾶλλον ὁ λόγος περὶ αὐτοῦ, καὶ συνήρχοντο ὄχλοι πολλοὶ ἀκούειν καὶ ⸀θεραπεύεσθαι",
          {
            "noteId": 158
          },
          "ἀπὸ τῶν ἀσθενειῶν αὐτῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "αὐτὸς δὲ ἦν ὑποχωρῶν ἐν ταῖς ἐρήμοις καὶ προσευχόμενος."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Καὶ ἐγένετο ἐν μιᾷ τῶν ἡμερῶν καὶ αὐτὸς ἦν διδάσκων, καὶ ἦσαν καθήμενοι Φαρισαῖοι καὶ νομοδιδάσκαλοι οἳ ἦσαν ἐληλυθότες ἐκ πάσης κώμης τῆς Γαλιλαίας καὶ Ἰουδαίας καὶ Ἰερουσαλήμ· καὶ δύναμις κυρίου ἦν εἰς τὸ ἰᾶσθαι ⸀αὐτόν",
          {
            "noteId": 159
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ ἰδοὺ ἄνδρες φέροντες ἐπὶ κλίνης ἄνθρωπον ὃς ἦν παραλελυμένος, καὶ ἐζήτουν αὐτὸν εἰσενεγκεῖν καὶ ⸀θεῖναι",
          {
            "noteId": 160
          },
          "ἐνώπιον αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "καὶ μὴ εὑρόντες ποίας εἰσενέγκωσιν αὐτὸν διὰ τὸν ὄχλον ἀναβάντες ἐπὶ τὸ δῶμα διὰ τῶν κεράμων καθῆκαν αὐτὸν σὺν τῷ κλινιδίῳ εἰς τὸ μέσον ἔμπροσθεν τοῦ Ἰησοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "καὶ ἰδὼν τὴν πίστιν αὐτῶν ⸀εἶπεν",
          {
            "noteId": 161
          },
          "Ἄνθρωπε, ἀφέωνταί σοι αἱ ἁμαρτίαι σου."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "καὶ ἤρξαντο διαλογίζεσθαι οἱ γραμματεῖς καὶ οἱ Φαρισαῖοι λέγοντες· Τίς ἐστιν οὗτος ὃς λαλεῖ βλασφημίας; τίς δύναται ⸂ἁμαρτίας ἀφεῖναι",
          {
            "noteId": 162
          },
          "εἰ μὴ μόνος ὁ θεός;"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ἐπιγνοὺς δὲ ὁ Ἰησοῦς τοὺς διαλογισμοὺς αὐτῶν ἀποκριθεὶς εἶπεν πρὸς αὐτούς· Τί διαλογίζεσθε ἐν ταῖς καρδίαις ὑμῶν;"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "τί ἐστιν εὐκοπώτερον, εἰπεῖν· Ἀφέωνταί σοι αἱ ἁμαρτίαι σου, ἢ εἰπεῖν· ⸀Ἔγειρε",
          {
            "noteId": 163
          },
          "καὶ περιπάτει;"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ἵνα δὲ εἰδῆτε ὅτι ⸂ὁ υἱὸς τοῦ ἀνθρώπου ἐξουσίαν ἔχει",
          {
            "noteId": 164
          },
          "ἐπὶ τῆς γῆς ἀφιέναι ἁμαρτίας— εἶπεν τῷ παραλελυμένῳ· Σοὶ λέγω, ⸀ἔγειρε",
          {
            "noteId": 165
          },
          "καὶ ἄρας τὸ κλινίδιόν σου πορεύου εἰς τὸν οἶκόν σου."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "καὶ παραχρῆμα ἀναστὰς ἐνώπιον αὐτῶν, ἄρας ἐφʼ ὃ κατέκειτο, ἀπῆλθεν εἰς τὸν οἶκον αὐτοῦ δοξάζων τὸν θεόν."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "καὶ ἔκστασις ἔλαβεν ἅπαντας καὶ ἐδόξαζον τὸν θεόν, καὶ ἐπλήσθησαν φόβου λέγοντες ὅτι Εἴδομεν παράδοξα σήμερον."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Καὶ μετὰ ταῦτα ἐξῆλθεν καὶ ἐθεάσατο τελώνην ὀνόματι Λευὶν καθήμενον ἐπὶ τὸ τελώνιον, καὶ εἶπεν αὐτῷ· Ἀκολούθει μοι."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "καὶ καταλιπὼν ⸀πάντα",
          {
            "noteId": 166
          },
          "ἀναστὰς ⸀ἠκολούθει",
          {
            "noteId": 167
          },
          "αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Καὶ ἐποίησεν δοχὴν μεγάλην Λευὶς αὐτῷ ἐν τῇ οἰκίᾳ αὐτοῦ· καὶ ἦν ὄχλος ⸂πολὺς τελωνῶν",
          {
            "noteId": 168
          },
          "καὶ ἄλλων οἳ ἦσαν μετʼ αὐτῶν κατακείμενοι."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "καὶ ἐγόγγυζον οἱ ⸂Φαρισαῖοι καὶ οἱ γραμματεῖς αὐτῶν",
          {
            "noteId": 169
          },
          "πρὸς τοὺς μαθητὰς αὐτοῦ λέγοντες· Διὰ τί μετὰ τῶν τελωνῶν καὶ ἁμαρτωλῶν ἐσθίετε καὶ πίνετε;"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "καὶ ἀποκριθεὶς ὁ Ἰησοῦς εἶπεν πρὸς αὐτούς· Οὐ χρείαν ἔχουσιν οἱ ὑγιαίνοντες ἰατροῦ ἀλλὰ οἱ κακῶς ἔχοντες·"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "οὐκ ἐλήλυθα καλέσαι δικαίους ἀλλὰ ἁμαρτωλοὺς εἰς μετάνοιαν."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "Οἱ",
          {
            "noteId": 170
          },
          "δὲ εἶπαν πρὸς αὐτόν· ⸀Οἱ μαθηταὶ Ἰωάννου νηστεύουσιν πυκνὰ καὶ δεήσεις ποιοῦνται, ὁμοίως καὶ οἱ τῶν Φαρισαίων, οἱ δὲ σοὶ ἐσθίουσιν καὶ πίνουσιν."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "ὁ ⸀δὲ",
          {
            "noteId": 171
          },
          "εἶπεν πρὸς αὐτούς· Μὴ δύνασθε τοὺς υἱοὺς τοῦ νυμφῶνος ἐν ᾧ ὁ νυμφίος μετʼ αὐτῶν ἐστιν ποιῆσαι ⸀νηστεῦσαι",
          {
            "noteId": 172
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "ἐλεύσονται δὲ ἡμέραι, καὶ ὅταν ἀπαρθῇ ἀπʼ αὐτῶν ὁ νυμφίος τότε νηστεύσουσιν ἐν ἐκείναις ταῖς ἡμέραις."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "ἔλεγεν δὲ καὶ παραβολὴν πρὸς αὐτοὺς ὅτι Οὐδεὶς ἐπίβλημα ⸀ἀπὸ",
          {
            "noteId": 173
          },
          "ἱματίου καινοῦ ⸀σχίσας",
          {
            "noteId": 174
          },
          "ἐπιβάλλει ἐπὶ ἱμάτιον παλαιόν· εἰ δὲ μήγε, καὶ τὸ καινὸν ⸀σχίσει",
          {
            "noteId": 175
          },
          "καὶ τῷ παλαιῷ οὐ ⸂συμφωνήσει τὸ ἐπίβλημα",
          {
            "noteId": 176
          },
          "τὸ ἀπὸ τοῦ καινοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "καὶ οὐδεὶς βάλλει οἶνον νέον εἰς ἀσκοὺς παλαιούς· εἰ δὲ μήγε, ῥήξει ὁ ⸂οἶνος ὁ νέος",
          {
            "noteId": 177
          },
          "τοὺς ἀσκούς, καὶ αὐτὸς ἐκχυθήσεται καὶ οἱ ἀσκοὶ ἀπολοῦνται·"
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "ἀλλὰ οἶνον νέον εἰς ἀσκοὺς καινοὺς ⸀βλητέον",
          {
            "noteId": 178
          }
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "⸀καὶ",
          {
            "noteId": 179
          },
          "οὐδεὶς πιὼν ⸀παλαιὸν",
          {
            "noteId": 180
          },
          "θέλει νέον· λέγει γάρ· Ὁ παλαιὸς ⸀χρηστός",
          {
            "noteId": 181
          },
          "ἐστιν."
        ]
      }
    ],
