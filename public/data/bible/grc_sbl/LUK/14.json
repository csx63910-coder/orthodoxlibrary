  "chapter": {
    "number": 14,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ ἐγένετο ἐν τῷ ἐλθεῖν αὐτὸν εἰς οἶκόν τινος τῶν ἀρχόντων τῶν Φαρισαίων σαββάτῳ φαγεῖν ἄρτον καὶ αὐτοὶ ἦσαν παρατηρούμενοι αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ ἰδοὺ ἄνθρωπός τις ἦν ὑδρωπικὸς ἔμπροσθεν αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ ἀποκριθεὶς ὁ Ἰησοῦς εἶπεν πρὸς τοὺς νομικοὺς καὶ Φαρισαίους λέγων· ⸀Ἔξεστιν",
          {
            "noteId": 639
          },
          "τῷ σαββάτῳ ⸂θεραπεῦσαι ἢ οὔ",
          {
            "noteId": 640
          },
          ";"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "οἱ δὲ ἡσύχασαν. καὶ ἐπιλαβόμενος ἰάσατο αὐτὸν καὶ ἀπέλυσεν."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "⸀καὶ",
          {
            "noteId": 641
          },
          "πρὸς αὐτοὺς εἶπεν· Τίνος ὑμῶν υἱὸς ἢ βοῦς εἰς φρέαρ ⸀πεσεῖται",
          {
            "noteId": 642
          },
          "καὶ οὐκ εὐθέως ἀνασπάσει αὐτὸν ⸀ἐν",
          {
            "noteId": 643
          },
          "ἡμέρᾳ τοῦ σαββάτου;"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ οὐκ ἴσχυσαν ⸀ἀνταποκριθῆναι",
          {
            "noteId": 644
          },
          "πρὸς ταῦτα."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ἔλεγεν δὲ πρὸς τοὺς κεκλημένους παραβολήν, ἐπέχων πῶς τὰς πρωτοκλισίας ἐξελέγοντο, λέγων πρὸς αὐτούς·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Ὅταν κληθῇς ὑπό τινος εἰς γάμους, μὴ κατακλιθῇς εἰς τὴν πρωτοκλισίαν, μήποτε ἐντιμότερός σου ᾖ κεκλημένος ὑπʼ αὐτοῦ"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ ἐλθὼν ὁ σὲ καὶ αὐτὸν καλέσας ἐρεῖ σοι· Δὸς τούτῳ τόπον, καὶ τότε ἄρξῃ μετὰ αἰσχύνης τὸν ἔσχατον τόπον κατέχειν."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἀλλʼ ὅταν κληθῇς πορευθεὶς ἀνάπεσε εἰς τὸν ἔσχατον τόπον, ἵνα ὅταν ἔλθῃ ὁ κεκληκώς σε ⸀ἐρεῖ",
          {
            "noteId": 645
          },
          "σοι· Φίλε, προσανάβηθι ἀνώτερον· τότε ἔσται σοι δόξα ἐνώπιον ⸀πάντων",
          {
            "noteId": 646
          },
          "τῶν συνανακειμένων σοι."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ὅτι πᾶς ὁ ὑψῶν ἑαυτὸν ταπεινωθήσεται καὶ ὁ ταπεινῶν ἑαυτὸν ὑψωθήσεται."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ἔλεγεν δὲ καὶ τῷ κεκληκότι αὐτόν· Ὅταν ποιῇς ἄριστον ἢ δεῖπνον, μὴ φώνει τοὺς φίλους σου μηδὲ τοὺς ἀδελφούς σου μηδὲ τοὺς συγγενεῖς σου μηδὲ γείτονας πλουσίους, μήποτε καὶ αὐτοὶ ⸂ἀντικαλέσωσίν σε",
          {
            "noteId": 647
          },
          "καὶ γένηται ⸂ἀνταπόδομά σοι",
          {
            "noteId": 648
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ἀλλʼ ὅταν ⸂δοχὴν ποιῇς",
          {
            "noteId": 649
          },
          ", κάλει πτωχούς, ἀναπείρους, χωλούς, τυφλούς·"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καὶ μακάριος ἔσῃ, ὅτι οὐκ ἔχουσιν ἀνταποδοῦναί σοι, ἀνταποδοθήσεται γάρ σοι ἐν τῇ ἀναστάσει τῶν δικαίων."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Ἀκούσας δέ τις τῶν συνανακειμένων ταῦτα εἶπεν αὐτῷ· Μακάριος ⸀ὅστις",
          {
            "noteId": 650
          },
          "φάγεται ⸀ἄρτον",
          {
            "noteId": 651
          },
          "ἐν τῇ βασιλείᾳ τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ὁ δὲ εἶπεν αὐτῷ· Ἄνθρωπός τις ⸀ἐποίει",
          {
            "noteId": 652
          },
          "δεῖπνον μέγα, καὶ ἐκάλεσεν πολλούς,"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καὶ ἀπέστειλεν τὸν δοῦλον αὐτοῦ τῇ ὥρᾳ τοῦ δείπνου εἰπεῖν τοῖς κεκλημένοις· Ἔρχεσθε, ὅτι ἤδη ἕτοιμά ⸀ἐστιν",
          {
            "noteId": 653
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ ἤρξαντο ἀπὸ μιᾶς ⸂πάντες παραιτεῖσθαι",
          {
            "noteId": 654
          },
          ". ὁ πρῶτος εἶπεν αὐτῷ· Ἀγρὸν ἠγόρασα καὶ ἔχω ἀνάγκην ⸀ἐξελθὼν",
          {
            "noteId": 655
          },
          "ἰδεῖν αὐτόν· ἐρωτῶ σε, ἔχε με παρῃτημένον."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "καὶ ἕτερος εἶπεν· Ζεύγη βοῶν ἠγόρασα πέντε καὶ πορεύομαι δοκιμάσαι αὐτά· ἐρωτῶ σε, ἔχε με παρῃτημένον."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "καὶ ἕτερος εἶπεν· Γυναῖκα ἔγημα καὶ διὰ τοῦτο οὐ δύναμαι ἐλθεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "καὶ παραγενόμενος ὁ ⸀δοῦλος",
          {
            "noteId": 656
          },
          "ἀπήγγειλεν τῷ κυρίῳ αὐτοῦ ταῦτα. τότε ὀργισθεὶς ὁ οἰκοδεσπότης εἶπεν τῷ δούλῳ αὐτοῦ· Ἔξελθε ταχέως εἰς τὰς πλατείας καὶ ῥύμας τῆς πόλεως, καὶ τοὺς πτωχοὺς καὶ ἀναπείρους καὶ ⸂τυφλοὺς καὶ χωλοὺς",
          {
            "noteId": 657
          },
          "εἰσάγαγε ὧδε."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "καὶ εἶπεν ὁ δοῦλος· Κύριε, γέγονεν ⸀ὃ",
          {
            "noteId": 658
          },
          "ἐπέταξας, καὶ ἔτι τόπος ἐστίν."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "καὶ εἶπεν ὁ κύριος πρὸς τὸν δοῦλον· Ἔξελθε εἰς τὰς ὁδοὺς καὶ φραγμοὺς καὶ ἀνάγκασον εἰσελθεῖν, ἵνα γεμισθῇ ⸂μου ὁ οἶκος",
          {
            "noteId": 659
          },
          "·"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "λέγω γὰρ ὑμῖν ὅτι οὐδεὶς τῶν ἀνδρῶν ἐκείνων τῶν κεκλημένων γεύσεταί μου τοῦ ⸀δείπνου",
          {
            "noteId": 660
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Συνεπορεύοντο δὲ αὐτῷ ὄχλοι πολλοί, καὶ στραφεὶς εἶπεν πρὸς αὐτούς·"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Εἴ τις ἔρχεται πρός με καὶ οὐ μισεῖ τὸν πατέρα ⸀ἑαυτοῦ",
          {
            "noteId": 661
          },
          "καὶ τὴν μητέρα καὶ τὴν γυναῖκα καὶ τὰ τέκνα καὶ τοὺς ἀδελφοὺς καὶ τὰς ἀδελφάς, ἔτι ⸀τε",
          {
            "noteId": 662
          },
          "καὶ τὴν ⸂ψυχὴν ἑαυτοῦ",
          {
            "noteId": 663
          },
          ", οὐ δύναται ⸂εἶναί μου μαθητής",
          {
            "noteId": 664
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "⸀ὅστις",
          {
            "noteId": 665
          },
          "οὐ βαστάζει τὸν σταυρὸν ⸀ἑαυτοῦ",
          {
            "noteId": 666
          },
          "καὶ ἔρχεται ὀπίσω μου, οὐ δύναται εἶναί μου μαθητής."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "τίς γὰρ ἐξ ⸀ὑμῶν",
          {
            "noteId": 667
          },
          "θέλων πύργον οἰκοδομῆσαι οὐχὶ πρῶτον καθίσας ψηφίζει τὴν δαπάνην, εἰ ⸀ἔχει",
          {
            "noteId": 668
          },
          "εἰς ἀπαρτισμόν;"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "ἵνα μήποτε θέντος αὐτοῦ θεμέλιον καὶ μὴ ἰσχύοντος ἐκτελέσαι πάντες οἱ θεωροῦντες ἄρξωνται ⸂αὐτῷ ἐμπαίζειν",
          {
            "noteId": 669
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "λέγοντες ὅτι Οὗτος ὁ ἄνθρωπος ἤρξατο οἰκοδομεῖν καὶ οὐκ ἴσχυσεν ἐκτελέσαι."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "ἢ τίς βασιλεὺς πορευόμενος ⸂ἑτέρῳ βασιλεῖ συμβαλεῖν",
          {
            "noteId": 670
          },
          "εἰς πόλεμον οὐχὶ καθίσας πρῶτον ⸀βουλεύσεται",
          {
            "noteId": 671
          },
          "εἰ δυνατός ἐστιν ἐν δέκα χιλιάσιν ⸀ὑπαντῆσαι",
          {
            "noteId": 672
          },
          "τῷ μετὰ εἴκοσι χιλιάδων ἐρχομένῳ ἐπʼ αὐτόν;"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "εἰ δὲ μήγε, ἔτι ⸂αὐτοῦ πόρρω",
          {
            "noteId": 673
          },
          "ὄντος πρεσβείαν ἀποστείλας ἐρωτᾷ ⸀τὰ",
          {
            "noteId": 674
          },
          "πρὸς εἰρήνην."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "οὕτως οὖν πᾶς ἐξ ὑμῶν ὃς οὐκ ἀποτάσσεται πᾶσιν τοῖς ἑαυτοῦ ὑπάρχουσιν οὐ δύναται ⸂εἶναί μου",
          {
            "noteId": 675
          },
          "μαθητής."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "Καλὸν ⸀οὖν",
          {
            "noteId": 676
          },
          "τὸ ἅλας· ἐὰν δὲ ⸀καὶ",
          {
            "noteId": 677
          },
          "τὸ ἅλας μωρανθῇ, ἐν τίνι ἀρτυθήσεται;"
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "οὔτε εἰς γῆν οὔτε εἰς κοπρίαν εὔθετόν ἐστιν· ἔξω βάλλουσιν αὐτό. ὁ ἔχων ὦτα ἀκούειν ἀκουέτω."
        ]
      }
    ],
