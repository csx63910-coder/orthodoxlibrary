    "sha256": "839f1e36ca0cd346cfcf1eb495dbaee8d3c56aba92f692b9696bd759f50e48be",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_sbl/LUK/1.json",
