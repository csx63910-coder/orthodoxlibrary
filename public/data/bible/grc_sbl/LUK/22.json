  },
  "chapter": {
    "number": 22,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἤγγιζεν δὲ ἡ ἑορτὴ τῶν ἀζύμων ἡ λεγομένη Πάσχα."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ ἐζήτουν οἱ ἀρχιερεῖς καὶ οἱ γραμματεῖς τὸ πῶς ἀνέλωσιν αὐτόν, ἐφοβοῦντο γὰρ τὸν λαόν."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Εἰσῆλθεν δὲ Σατανᾶς εἰς Ἰούδαν τὸν ⸀καλούμενον",
          {
            "noteId": 946
          },
          "Ἰσκαριώτην, ὄντα ἐκ τοῦ ἀριθμοῦ τῶν δώδεκα·"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ ἀπελθὼν συνελάλησεν τοῖς ἀρχιερεῦσιν καὶ στρατηγοῖς τὸ πῶς ⸂αὐτοῖς παραδῷ αὐτόν",
          {
            "noteId": 947
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ ἐχάρησαν καὶ συνέθεντο αὐτῷ ἀργύριον δοῦναι."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ ἐξωμολόγησεν, καὶ ἐζήτει εὐκαιρίαν τοῦ παραδοῦναι αὐτὸν ⸂ἄτερ ὄχλου αὐτοῖς",
          {
            "noteId": 948
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ἦλθεν δὲ ἡ ἡμέρα τῶν ἀζύμων, ⸀ᾗ",
          {
            "noteId": 949
          },
          "ἔδει θύεσθαι τὸ πάσχα·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ ἀπέστειλεν Πέτρον καὶ Ἰωάννην εἰπών· Πορευθέντες ἑτοιμάσατε ἡμῖν τὸ πάσχα ἵνα φάγωμεν."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "οἱ δὲ εἶπαν αὐτῷ· Ποῦ θέλεις ⸀ἑτοιμάσωμεν",
          {
            "noteId": 950
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ὁ δὲ εἶπεν αὐτοῖς· Ἰδοὺ εἰσελθόντων ὑμῶν εἰς τὴν πόλιν συναντήσει ὑμῖν ἄνθρωπος κεράμιον ὕδατος βαστάζων· ἀκολουθήσατε αὐτῷ εἰς τὴν οἰκίαν ⸂εἰς ἣν",
          {
            "noteId": 951
          },
          "εἰσπορεύεται."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ ἐρεῖτε τῷ οἰκοδεσπότῃ τῆς οἰκίας· Λέγει σοι ὁ διδάσκαλος· Ποῦ ἐστιν τὸ κατάλυμα ὅπου τὸ πάσχα μετὰ τῶν μαθητῶν μου φάγω;"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "κἀκεῖνος ὑμῖν δείξει ἀνάγαιον μέγα ἐστρωμένον· ἐκεῖ ἑτοιμάσατε."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ἀπελθόντες δὲ εὗρον καθὼς ⸀εἰρήκει",
          {
            "noteId": 952
          },
          "αὐτοῖς, καὶ ἡτοίμασαν τὸ πάσχα."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Καὶ ὅτε ἐγένετο ἡ ὥρα, ἀνέπεσεν καὶ ⸀οἱ",
          {
            "noteId": 953
          },
          "ἀπόστολοι σὺν αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ εἶπεν πρὸς αὐτούς· Ἐπιθυμίᾳ ἐπεθύμησα τοῦτο τὸ πάσχα φαγεῖν μεθʼ ὑμῶν πρὸ τοῦ με παθεῖν·"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "λέγω γὰρ ὑμῖν ⸀ὅτι",
          {
            "noteId": 954
          },
          "οὐ μὴ φάγω ⸀αὐτὸ",
          {
            "noteId": 955
          },
          "ἕως ὅτου πληρωθῇ ἐν τῇ βασιλείᾳ τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καὶ δεξάμενος ποτήριον εὐχαριστήσας εἶπεν· Λάβετε τοῦτο καὶ διαμερίσατε ⸂εἰς ἑαυτούς",
          {
            "noteId": 956
          },
          "·"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "λέγω γὰρ ὑμῖν, ⸀οὐ",
          {
            "noteId": 957
          },
          "μὴ πίω ἀπὸ τοῦ ⸂νῦν ἀπὸ τοῦ",
          {
            "noteId": 958
          },
          "γενήματος τῆς ἀμπέλου ἕως ⸀οὗ",
          {
            "noteId": 959
          },
          "ἡ βασιλεία τοῦ θεοῦ ἔλθῃ."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "καὶ λαβὼν ἄρτον εὐχαριστήσας ἔκλασεν καὶ ἔδωκεν αὐτοῖς λέγων· Τοῦτό ἐστιν τὸ σῶμά μου ⸂[τὸ ὑπὲρ ὑμῶν διδόμενον· τοῦτο ποιεῖτε εἰς τὴν ἐμὴν ἀνάμνησιν.",
          {
            "noteId": 960
          },
          {
            "noteId": 961
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "⸄καὶ τὸ ποτήριον ὡσαύτως⸅ μετὰ τὸ δειπνῆσαι, λέγων· Τοῦτο τὸ ποτήριον ἡ καινὴ διαθήκη ἐν τῷ αἵματί μου, τὸ ὑπὲρ ὑμῶν ἐκχυννόμενον]⸃."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "πλὴν ἰδοὺ ἡ χεὶρ τοῦ παραδιδόντος με μετʼ ἐμοῦ ἐπὶ τῆς τραπέζης·"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "⸂ὅτι ὁ υἱὸς μὲν",
          {
            "noteId": 962
          },
          "τοῦ ἀνθρώπου ⸂κατὰ τὸ ὡρισμένον πορεύεται",
          {
            "noteId": 963
          },
          ", πλὴν οὐαὶ τῷ ἀνθρώπῳ ἐκείνῳ διʼ οὗ παραδίδοται."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "καὶ αὐτοὶ ἤρξαντο συζητεῖν πρὸς ἑαυτοὺς τὸ τίς ἄρα εἴη ἐξ αὐτῶν ὁ τοῦτο μέλλων πράσσειν."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Ἐγένετο δὲ καὶ φιλονεικία ἐν αὐτοῖς, τὸ τίς αὐτῶν δοκεῖ εἶναι μείζων."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ὁ δὲ εἶπεν αὐτοῖς· Οἱ βασιλεῖς τῶν ἐθνῶν κυριεύουσιν αὐτῶν καὶ οἱ ἐξουσιάζοντες αὐτῶν εὐεργέται καλοῦνται."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ὑμεῖς δὲ οὐχ οὕτως, ἀλλʼ ὁ μείζων ἐν ὑμῖν ⸀γινέσθω",
          {
            "noteId": 964
          },
          "ὡς ὁ νεώτερος, καὶ ὁ ἡγούμενος ὡς ὁ διακονῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "τίς γὰρ μείζων, ὁ ἀνακείμενος ἢ ὁ διακονῶν; οὐχὶ ὁ ἀνακείμενος; ἐγὼ δὲ ⸂ἐν μέσῳ ὑμῶν εἰμι",
          {
            "noteId": 965
          },
          "ὡς ὁ διακονῶν."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Ὑμεῖς δέ ἐστε οἱ διαμεμενηκότες μετʼ ἐμοῦ ἐν τοῖς πειρασμοῖς μου·"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "κἀγὼ διατίθεμαι ὑμῖν, καθὼς διέθετό μοι ὁ πατήρ μου βασιλείαν,"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ἵνα ⸀ἔσθητε",
          {
            "noteId": 966
          },
          "καὶ πίνητε ἐπὶ τῆς τραπέζης μου ⸂ἐν τῇ βασιλείᾳ μου",
          {
            "noteId": 967
          },
          ", καὶ ⸀καθήσεσθε",
          {
            "noteId": 968
          },
          "ἐπὶ θρόνων ⸂τὰς δώδεκα φυλὰς κρίνοντες",
          {
            "noteId": 969
          },
          "τοῦ Ἰσραήλ."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "⸀Σίμων",
          {
            "noteId": 970
          },
          "Σίμων, ἰδοὺ ὁ Σατανᾶς ἐξῃτήσατο ὑμᾶς τοῦ σινιάσαι ὡς τὸν σῖτον·"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "ἐγὼ δὲ ἐδεήθην περὶ σοῦ ἵνα μὴ ἐκλίπῃ ἡ πίστις σου· καὶ σύ ποτε ἐπιστρέψας ⸀στήρισον",
          {
            "noteId": 971
          },
          "τοὺς ἀδελφούς σου."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "ὁ δὲ εἶπεν αὐτῷ· Κύριε, μετὰ σοῦ ἕτοιμός εἰμι καὶ εἰς φυλακὴν καὶ εἰς θάνατον πορεύεσθαι."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "ὁ δὲ εἶπεν· Λέγω σοι, Πέτρε, οὐ ⸀φωνήσει",
          {
            "noteId": 972
          },
          "σήμερον ἀλέκτωρ ⸀ἕως",
          {
            "noteId": 973
          },
          "τρίς ⸂με ἀπαρνήσῃ εἰδέναι",
          {
            "noteId": 974
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "Καὶ εἶπεν αὐτοῖς· Ὅτε ἀπέστειλα ὑμᾶς ἄτερ βαλλαντίου καὶ πήρας καὶ ὑποδημάτων, μή τινος ὑστερήσατε; οἱ δὲ εἶπαν· Οὐθενός."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "εἶπεν ⸀δὲ",
          {
            "noteId": 975
          },
          "αὐτοῖς· Ἀλλὰ νῦν ὁ ἔχων βαλλάντιον ἀράτω, ὁμοίως καὶ πήραν, καὶ ὁ μὴ ἔχων ⸀πωλησάτω",
          {
            "noteId": 976
          },
          "τὸ ἱμάτιον αὐτοῦ καὶ ⸀ἀγορασάτω",
          {
            "noteId": 977
          },
          "μάχαιραν."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "λέγω γὰρ ὑμῖν ⸀ὅτι",
          {
            "noteId": 978
          },
          "τοῦτο τὸ",
          {
            "noteId": 979
          },
          "γεγραμμένον δεῖ τελεσθῆναι ἐν ἐμοί, τό· Καὶ μετὰ ἀνόμων ἐλογίσθη· καὶ γὰρ ⸀τὸ περὶ ἐμοῦ τέλος ἔχει."
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "οἱ δὲ εἶπαν· Κύριε, ἰδοὺ μάχαιραι ὧδε δύο. ὁ δὲ εἶπεν αὐτοῖς· Ἱκανόν ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "Καὶ ἐξελθὼν ἐπορεύθη κατὰ τὸ ἔθος εἰς τὸ Ὄρος τῶν Ἐλαιῶν· ἠκολούθησαν δὲ αὐτῷ καὶ οἱ ⸀μαθηταί",
          {
            "noteId": 980
          }
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "γενόμενος δὲ ἐπὶ τοῦ τόπου εἶπεν αὐτοῖς· Προσεύχεσθε μὴ εἰσελθεῖν εἰς πειρασμόν."
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "καὶ αὐτὸς ἀπεσπάσθη ἀπʼ αὐτῶν ὡσεὶ λίθου βολήν, καὶ θεὶς τὰ γόνατα προσηύχετο"
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "λέγων· Πάτερ, εἰ βούλει ⸀παρένεγκε",
          {
            "noteId": 981
          },
          "⸂τοῦτο τὸ ποτήριον",
          {
            "noteId": 982
          },
          "ἀπʼ ἐμοῦ· πλὴν μὴ τὸ θέλημά μου ἀλλὰ τὸ σὸν ⸀γινέσθω",
          {
            "noteId": 983
          }
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "⸂ὤφθη δὲ αὐτῷ ἄγγελος ⸀ἀπʼ οὐρανοῦ ἐνισχύων αὐτόν.",
          {
            "noteId": 984
          },
          {
            "noteId": 985
          },
          {
            "noteId": 986
          }
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "καὶ γενόμενος ἐν ἀγωνίᾳ ἐκτενέστερον προσηύχετο· ⸄καὶ ἐγένετο⸅ ὁ ἱδρὼς αὐτοῦ ὡσεὶ θρόμβοι αἵματος καταβαίνοντες ἐπὶ τὴν γῆν.⸃"
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "καὶ ἀναστὰς ἀπὸ τῆς προσευχῆς ἐλθὼν πρὸς τοὺς μαθητὰς εὗρεν ⸂κοιμωμένους αὐτοὺς",
          {
            "noteId": 987
          },
          "ἀπὸ τῆς λύπης,"
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "καὶ εἶπεν αὐτοῖς· Τί καθεύδετε; ἀναστάντες προσεύχεσθε, ἵνα μὴ εἰσέλθητε εἰς πειρασμόν."
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          "⸀Ἔτι",
          {
            "noteId": 988
          },
          "αὐτοῦ λαλοῦντος ἰδοὺ ὄχλος, καὶ ὁ λεγόμενος Ἰούδας εἷς τῶν δώδεκα προήρχετο αὐτούς, καὶ ἤγγισεν τῷ Ἰησοῦ φιλῆσαι αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          "⸂Ἰησοῦς δὲ",
          {
            "noteId": 989
          },
          "εἶπεν αὐτῷ· Ἰούδα, φιλήματι τὸν υἱὸν τοῦ ἀνθρώπου παραδίδως;"
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          "ἰδόντες δὲ οἱ περὶ αὐτὸν τὸ ἐσόμενον ⸀εἶπαν",
          {
            "noteId": 990
          },
          "Κύριε, εἰ πατάξομεν ἐν μαχαίρῃ;"
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          "καὶ ἐπάταξεν εἷς τις ἐξ αὐτῶν ⸂τοῦ ἀρχιερέως τὸν δοῦλον",
          {
            "noteId": 991
          },
          "καὶ ἀφεῖλεν ⸂τὸ οὖς αὐτοῦ",
          {
            "noteId": 992
          },
          "τὸ δεξιόν."
        ]
      },
      {
        "type": "verse",
        "number": 51,
        "content": [
          "ἀποκριθεὶς δὲ ὁ Ἰησοῦς εἶπεν· Ἐᾶτε ἕως τούτου· καὶ ἁψάμενος τοῦ ⸀ὠτίου",
          {
            "noteId": 993
          },
          "ἰάσατο αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 52,
        "content": [
          "εἶπεν ⸀δὲ",
          {
            "noteId": 994
          },
          "Ἰησοῦς πρὸς τοὺς παραγενομένους ἐπʼ αὐτὸν ἀρχιερεῖς καὶ στρατηγοὺς τοῦ ἱεροῦ καὶ πρεσβυτέρους· Ὡς ἐπὶ λῃστὴν ⸀ἐξήλθατε",
          {
            "noteId": 995
          },
          "μετὰ μαχαιρῶν καὶ ξύλων;"
        ]
      },
      {
        "type": "verse",
        "number": 53,
        "content": [
          "καθʼ ἡμέραν ὄντος μου μεθʼ ὑμῶν ἐν τῷ ἱερῷ οὐκ ἐξετείνατε τὰς χεῖρας ἐπʼ ἐμέ· ἀλλʼ αὕτη ⸂ἐστὶν ὑμῶν",
          {
            "noteId": 996
          },
          "ἡ ὥρα καὶ ἡ ἐξουσία τοῦ σκότους."
        ]
      },
      {
        "type": "verse",
        "number": 54,
        "content": [
          "Συλλαβόντες δὲ αὐτὸν ἤγαγον καὶ ⸀εἰσήγαγον",
          {
            "noteId": 997
          },
          "εἰς ⸂τὴν οἰκίαν",
          {
            "noteId": 998
          },
          "τοῦ ἀρχιερέως· ὁ δὲ Πέτρος ἠκολούθει μακρόθεν."
        ]
      },
      {
        "type": "verse",
        "number": 55,
        "content": [
          "⸀περιαψάντων",
          {
            "noteId": 999
          },
          "δὲ πῦρ ἐν μέσῳ τῆς αὐλῆς καὶ ⸀συγκαθισάντων",
          {
            "noteId": 1000
          },
          "ἐκάθητο ὁ Πέτρος ⸀μέσος",
          {
            "noteId": 1001
          },
          "αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 56,
        "content": [
          "ἰδοῦσα δὲ αὐτὸν παιδίσκη τις καθήμενον πρὸς τὸ φῶς καὶ ἀτενίσασα αὐτῷ εἶπεν· Καὶ οὗτος σὺν αὐτῷ ἦν·"
        ]
      },
      {
        "type": "verse",
        "number": 57,
        "content": [
          "ὁ δὲ ⸀ἠρνήσατο",
          {
            "noteId": 1002
          },
          "λέγων· ⸂Οὐκ οἶδα αὐτόν, γύναι⸃.",
          {
            "noteId": 1003
          }
        ]
      },
      {
        "type": "verse",
        "number": 58,
        "content": [
          "καὶ μετὰ βραχὺ ἕτερος ἰδὼν αὐτὸν ἔφη",
          {
            "noteId": 1004
          },
          "Καὶ σὺ ἐξ αὐτῶν εἶ· ὁ δὲ Πέτρος ⸀ἔφη· Ἄνθρωπε, οὐκ εἰμί."
        ]
      },
      {
        "type": "verse",
        "number": 59,
        "content": [
          "καὶ διαστάσης ὡσεὶ ὥρας μιᾶς ἄλλος τις διϊσχυρίζετο λέγων· Ἐπʼ ἀληθείας καὶ οὗτος μετʼ αὐτοῦ ἦν, καὶ γὰρ Γαλιλαῖός ἐστιν·"
        ]
      },
      {
        "type": "verse",
        "number": 60,
        "content": [
          "εἶπεν δὲ ὁ Πέτρος· Ἄνθρωπε, οὐκ οἶδα ὃ λέγεις. καὶ παραχρῆμα ἔτι λαλοῦντος αὐτοῦ ἐφώνησεν ἀλέκτωρ."
        ]
      },
      {
        "type": "verse",
        "number": 61,
        "content": [
          "καὶ στραφεὶς ὁ κύριος ἐνέβλεψεν τῷ Πέτρῳ, καὶ ὑπεμνήσθη ὁ Πέτρος τοῦ ⸀λόγου",
          {
            "noteId": 1005
          },
          "τοῦ κυρίου ὡς εἶπεν αὐτῷ ὅτι Πρὶν ἀλέκτορα φωνῆσαι ⸀σήμερον",
          {
            "noteId": 1006
          },
          "ἀπαρνήσῃ με τρίς."
        ]
      },
      {
        "type": "verse",
        "number": 62,
        "content": [
          "καὶ ἐξελθὼν ⸀ἔξω",
          {
            "noteId": 1007
          },
          "ἔκλαυσεν πικρῶς."
        ]
      },
      {
        "type": "verse",
        "number": 63,
        "content": [
          "Καὶ οἱ ἄνδρες οἱ συνέχοντες ⸀αὐτὸν",
          {
            "noteId": 1008
          },
          "ἐνέπαιζον αὐτῷ δέροντες,"
        ]
      },
      {
        "type": "verse",
        "number": 64,
        "content": [
          "καὶ περικαλύψαντες ⸂αὐτὸν ἐπηρώτων",
          {
            "noteId": 1009
          },
          "λέγοντες· Προφήτευσον, τίς ἐστιν ὁ παίσας σε;"
        ]
      },
      {
        "type": "verse",
        "number": 65,
        "content": [
          "καὶ ἕτερα πολλὰ βλασφημοῦντες ἔλεγον εἰς αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 66,
        "content": [
          "Καὶ ὡς ἐγένετο ἡμέρα, συνήχθη τὸ πρεσβυτέριον τοῦ λαοῦ, ἀρχιερεῖς ⸀τε",
          {
            "noteId": 1010
          },
          "καὶ γραμματεῖς, καὶ ⸀ἀπήγαγον",
          {
            "noteId": 1011
          },
          "αὐτὸν εἰς τὸ συνέδριον αὐτῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 67,
        "content": [
          "λέγοντες· Εἰ σὺ εἶ ὁ χριστός, εἰπὸν ἡμῖν. εἶπεν δὲ αὐτοῖς· Ἐὰν ὑμῖν εἴπω οὐ μὴ πιστεύσητε·"
        ]
      },
      {
        "type": "verse",
        "number": 68,
        "content": [
          "ἐὰν ⸀δὲ",
          {
            "noteId": 1012
          },
          "ἐρωτήσω, οὐ μὴ ⸀ἀποκριθῆτε",
          {
            "noteId": 1013
          }
        ]
      },
      {
        "type": "verse",
        "number": 69,
        "content": [
          "ἀπὸ τοῦ νῦν ⸀δὲ",
          {
            "noteId": 1014
          },
          "ἔσται ὁ υἱὸς τοῦ ἀνθρώπου καθήμενος ἐκ δεξιῶν τῆς δυνάμεως τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 70,
        "content": [
          "εἶπαν δὲ πάντες· Σὺ οὖν εἶ ὁ υἱὸς τοῦ θεοῦ; ὁ δὲ πρὸς αὐτοὺς ἔφη· Ὑμεῖς λέγετε ὅτι ἐγώ εἰμι."
        ]
      },
      {
        "type": "verse",
        "number": 71,
        "content": [
          "οἱ δὲ εἶπαν· Τί ἔτι ⸂ἔχομεν μαρτυρίας χρείαν",
          {
            "noteId": 1015
          },
          "; αὐτοὶ γὰρ ἠκούσαμεν ἀπὸ τοῦ στόματος αὐτοῦ."
        ]
      }
