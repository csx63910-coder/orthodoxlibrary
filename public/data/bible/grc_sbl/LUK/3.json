  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἐν ἔτει δὲ πεντεκαιδεκάτῳ τῆς ἡγεμονίας Τιβερίου Καίσαρος, ἡγεμονεύοντος Ποντίου Πιλάτου τῆς Ἰουδαίας, καὶ τετρααρχοῦντος τῆς Γαλιλαίας Ἡρῴδου, Φιλίππου δὲ τοῦ ἀδελφοῦ αὐτοῦ τετρααρχοῦντος τῆς Ἰτουραίας καὶ Τραχωνίτιδος χώρας, καὶ Λυσανίου τῆς Ἀβιληνῆς τετρααρχοῦντος,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἐπὶ ἀρχιερέως Ἅννα καὶ Καϊάφα, ἐγένετο ῥῆμα θεοῦ ἐπὶ Ἰωάννην τὸν Ζαχαρίου υἱὸν ἐν τῇ ἐρήμῳ."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ ἦλθεν εἰς ⸀πᾶσαν",
          {
            "noteId": 81
          },
          "περίχωρον τοῦ Ἰορδάνου κηρύσσων βάπτισμα μετανοίας εἰς ἄφεσιν ἁμαρτιῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ὡς γέγραπται ἐν βίβλῳ λόγων Ἠσαΐου τοῦ ⸀προφήτου",
          {
            "noteId": 82
          },
          "Φωνὴ βοῶντος ἐν τῇ ἐρήμῳ· Ἑτοιμάσατε τὴν ὁδὸν κυρίου, εὐθείας ποιεῖτε τὰς τρίβους αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "πᾶσα φάραγξ πληρωθήσεται καὶ πᾶν ὄρος καὶ βουνὸς ταπεινωθήσεται, καὶ ἔσται τὰ σκολιὰ εἰς ⸀εὐθείαν",
          {
            "noteId": 83
          },
          "καὶ αἱ τραχεῖαι εἰς ὁδοὺς λείας·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ ὄψεται πᾶσα σὰρξ τὸ σωτήριον τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ἔλεγεν οὖν τοῖς ἐκπορευομένοις ὄχλοις βαπτισθῆναι ὑπʼ αὐτοῦ· Γεννήματα ἐχιδνῶν, τίς ὑπέδειξεν ὑμῖν φυγεῖν ἀπὸ τῆς μελλούσης ὀργῆς;"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ποιήσατε οὖν καρποὺς ἀξίους τῆς μετανοίας· καὶ μὴ ἄρξησθε λέγειν ἐν ἑαυτοῖς· Πατέρα ἔχομεν τὸν Ἀβραάμ, λέγω γὰρ ὑμῖν ὅτι δύναται ὁ θεὸς ἐκ τῶν λίθων τούτων ἐγεῖραι τέκνα τῷ Ἀβραάμ."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ἤδη δὲ καὶ ἡ ἀξίνη πρὸς τὴν ῥίζαν τῶν δένδρων κεῖται· πᾶν οὖν δένδρον μὴ ποιοῦν καρπὸν καλὸν ἐκκόπτεται καὶ εἰς πῦρ βάλλεται."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Καὶ ἐπηρώτων αὐτὸν οἱ ὄχλοι λέγοντες· Τί οὖν ⸀ποιήσωμεν",
          {
            "noteId": 84
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ἀποκριθεὶς δὲ ⸀ἔλεγεν",
          {
            "noteId": 85
          },
          "αὐτοῖς· Ὁ ἔχων δύο χιτῶνας μεταδότω τῷ μὴ ἔχοντι, καὶ ὁ ἔχων βρώματα ὁμοίως ποιείτω."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ἦλθον δὲ καὶ τελῶναι βαπτισθῆναι καὶ εἶπαν πρὸς αὐτόν· Διδάσκαλε, τί ⸀ποιήσωμεν",
          {
            "noteId": 86
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ὁ δὲ εἶπεν πρὸς αὐτούς· Μηδὲν πλέον παρὰ τὸ διατεταγμένον ὑμῖν πράσσετε."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἐπηρώτων δὲ αὐτὸν καὶ στρατευόμενοι λέγοντες· ⸂Τί ποιήσωμεν καὶ ἡμεῖς",
          {
            "noteId": 87
          },
          "; καὶ εἶπεν ⸀αὐτοῖς",
          {
            "noteId": 88
          },
          "Μηδένα διασείσητε μηδὲ συκοφαντήσητε, καὶ ἀρκεῖσθε τοῖς ὀψωνίοις ὑμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Προσδοκῶντος δὲ τοῦ λαοῦ καὶ διαλογιζομένων πάντων ἐν ταῖς καρδίαις αὐτῶν περὶ τοῦ Ἰωάννου, μήποτε αὐτὸς εἴη ὁ χριστός,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ἀπεκρίνατο ⸂λέγων πᾶσιν ὁ Ἰωάννης",
          {
            "noteId": 89
          },
          "· Ἐγὼ μὲν ὕδατι βαπτίζω ὑμᾶς· ἔρχεται δὲ ὁ ἰσχυρότερός μου, οὗ οὐκ εἰμὶ ἱκανὸς λῦσαι τὸν ἱμάντα τῶν ὑποδημάτων αὐτοῦ· αὐτὸς ὑμᾶς βαπτίσει ἐν πνεύματι ἁγίῳ καὶ πυρί·"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "οὗ τὸ πτύον ἐν τῇ χειρὶ αὐτοῦ ⸀διακαθᾶραι",
          {
            "noteId": 90
          },
          "τὴν ἅλωνα αὐτοῦ καὶ ⸀συναγαγεῖν",
          {
            "noteId": 91
          },
          "τὸν σῖτον εἰς τὴν ἀποθήκην αὐτοῦ, τὸ δὲ ἄχυρον κατακαύσει πυρὶ ἀσβέστῳ."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Πολλὰ μὲν οὖν καὶ ἕτερα παρακαλῶν εὐηγγελίζετο τὸν λαόν·"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ὁ δὲ Ἡρῴδης ὁ τετραάρχης, ἐλεγχόμενος ὑπʼ αὐτοῦ περὶ Ἡρῳδιάδος τῆς γυναικὸς τοῦ ἀδελφοῦ αὐτοῦ καὶ περὶ πάντων ὧν ἐποίησεν πονηρῶν ὁ Ἡρῴδης,"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "προσέθηκεν καὶ",
          {
            "noteId": 92
          },
          "τοῦτο ἐπὶ πᾶσιν, ⸀καὶ κατέκλεισεν τὸν Ἰωάννην ⸀ἐν",
          {
            "noteId": 93
          },
          "φυλακῇ."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Ἐγένετο δὲ ἐν τῷ βαπτισθῆναι ἅπαντα τὸν λαὸν καὶ Ἰησοῦ βαπτισθέντος καὶ προσευχομένου ἀνεῳχθῆναι τὸν οὐρανὸν"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "καὶ καταβῆναι τὸ πνεῦμα τὸ ἅγιον σωματικῷ εἴδει ⸀ὡς",
          {
            "noteId": 94
          },
          "περιστερὰν ἐπʼ αὐτόν, καὶ φωνὴν ἐξ οὐρανοῦ ⸀γενέσθαι",
          {
            "noteId": 95
          },
          "Σὺ εἶ ὁ υἱός μου ὁ ἀγαπητός, ἐν σοὶ εὐδόκησα."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Καὶ αὐτὸς ⸀ἦν",
          {
            "noteId": 96
          },
          "Ἰησοῦς ⸂ἀρχόμενος ὡσεὶ ἐτῶν τριάκοντα",
          {
            "noteId": 97
          },
          ", ὢν ⸂υἱός, ὡς ἐνομίζετο⸃, Ἰωσὴφ τοῦ Ἠλὶ",
          {
            "noteId": 98
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "τοῦ Μαθθὰτ τοῦ Λευὶ τοῦ Μελχὶ τοῦ Ἰανναὶ τοῦ Ἰωσὴφ"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "τοῦ Ματταθίου τοῦ Ἀμὼς τοῦ Ναοὺμ τοῦ Ἑσλὶ τοῦ Ναγγαὶ"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "τοῦ Μάαθ τοῦ Ματταθίου τοῦ Σεμεῒν τοῦ ⸀Ἰωσὴχ",
          {
            "noteId": 99
          },
          "τοῦ Ἰωδὰ"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "τοῦ Ἰωανὰν τοῦ Ῥησὰ τοῦ Ζοροβαβὲλ τοῦ Σαλαθιὴλ τοῦ Νηρὶ"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "τοῦ Μελχὶ τοῦ Ἀδδὶ τοῦ Κωσὰμ τοῦ Ἐλμαδὰμ τοῦ Ἢρ"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "τοῦ ⸀Ἰησοῦ",
          {
            "noteId": 100
          },
          "τοῦ Ἐλιέζερ τοῦ Ἰωρὶμ τοῦ Μαθθὰτ τοῦ Λευὶ"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "τοῦ Συμεὼν τοῦ Ἰούδα τοῦ Ἰωσὴφ τοῦ Ἰωνὰμ τοῦ Ἐλιακὶμ"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "τοῦ Μελεὰ τοῦ Μεννὰ τοῦ Ματταθὰ τοῦ Ναθὰμ τοῦ Δαυὶδ"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "τοῦ Ἰεσσαὶ τοῦ Ἰωβὴλ τοῦ Βόος τοῦ ⸀Σαλὰ",
          {
            "noteId": 101
          },
          "τοῦ Ναασσὼν"
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "τοῦ ⸂Ἀμιναδὰβ τοῦ Ἀδμὶν τοῦ Ἀρνὶ",
          {
            "noteId": 102
          },
          "τοῦ Ἑσρὼμ τοῦ Φαρὲς τοῦ Ἰούδα"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "τοῦ Ἰακὼβ τοῦ Ἰσαὰκ τοῦ Ἀβραὰμ τοῦ Θάρα τοῦ Ναχὼρ"
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "τοῦ Σεροὺχ τοῦ Ῥαγαὺ τοῦ Φάλεκ τοῦ Ἔβερ τοῦ Σαλὰ"
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "τοῦ Καϊνὰμ τοῦ Ἀρφαξὰδ τοῦ Σὴμ τοῦ Νῶε τοῦ Λάμεχ"
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "τοῦ Μαθουσαλὰ τοῦ Ἑνὼχ τοῦ Ἰάρετ τοῦ Μαλελεὴλ τοῦ Καϊνὰμ"
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "τοῦ Ἐνὼς τοῦ Σὴθ τοῦ Ἀδὰμ τοῦ θεοῦ."
        ]
      }
    ],
