  "chapter": {
    "number": 16,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἔλεγεν δὲ καὶ πρὸς τοὺς ⸀μαθητάς",
          {
            "noteId": 711
          },
          "Ἄνθρωπός τις ἦν πλούσιος ὃς εἶχεν οἰκονόμον, καὶ οὗτος διεβλήθη αὐτῷ ὡς διασκορπίζων τὰ ὑπάρχοντα αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ φωνήσας αὐτὸν εἶπεν αὐτῷ· Τί τοῦτο ἀκούω περὶ σοῦ; ἀπόδος τὸν λόγον τῆς οἰκονομίας σου, οὐ γὰρ ⸀δύνῃ",
          {
            "noteId": 712
          },
          "ἔτι οἰκονομεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "εἶπεν δὲ ἐν ἑαυτῷ ὁ οἰκονόμος· Τί ποιήσω ὅτι ὁ κύριός μου ἀφαιρεῖται τὴν οἰκονομίαν ἀπʼ ἐμοῦ; σκάπτειν οὐκ ἰσχύω, ἐπαιτεῖν αἰσχύνομαι·"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἔγνων τί ποιήσω, ἵνα ὅταν μετασταθῶ ⸀ἐκ",
          {
            "noteId": 713
          },
          "τῆς οἰκονομίας δέξωνταί με εἰς τοὺς οἴκους ⸀ἑαυτῶν",
          {
            "noteId": 714
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ προσκαλεσάμενος ἕνα ἕκαστον τῶν χρεοφειλετῶν τοῦ κυρίου ἑαυτοῦ ἔλεγεν τῷ πρώτῳ· Πόσον ὀφείλεις τῷ κυρίῳ μου;"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ὁ δὲ",
          {
            "noteId": 715
          },
          "εἶπεν· Ἑκατὸν βάτους ἐλαίου· ⸂ὁ δὲ⸃ εἶπεν αὐτῷ· Δέξαι σου ⸂τὰ γράμματα",
          {
            "noteId": 716
          },
          "καὶ καθίσας ταχέως γράψον πεντήκοντα."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἔπειτα ἑτέρῳ εἶπεν· Σὺ δὲ πόσον ὀφείλεις; ὁ δὲ εἶπεν· Ἑκατὸν κόρους σίτου· ⸀λέγει",
          {
            "noteId": 717
          },
          "αὐτῷ· Δέξαι σου ⸂τὰ γράμματα",
          {
            "noteId": 718
          },
          "καὶ γράψον ὀγδοήκοντα."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ ἐπῄνεσεν ὁ κύριος τὸν οἰκονόμον τῆς ἀδικίας ὅτι φρονίμως ἐποίησεν· ὅτι οἱ υἱοὶ τοῦ αἰῶνος τούτου φρονιμώτεροι ὑπὲρ τοὺς υἱοὺς τοῦ φωτὸς εἰς τὴν γενεὰν τὴν ἑαυτῶν εἰσιν."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ ἐγὼ ὑμῖν λέγω, ⸂ἑαυτοῖς ποιήσατε",
          {
            "noteId": 719
          },
          "φίλους ἐκ τοῦ μαμωνᾶ τῆς ἀδικίας, ἵνα ὅταν ⸀ἐκλίπῃ",
          {
            "noteId": 720
          },
          "δέξωνται ὑμᾶς εἰς τὰς αἰωνίους σκηνάς."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Ὁ πιστὸς ἐν ἐλαχίστῳ καὶ ἐν πολλῷ πιστός ἐστιν, καὶ ὁ ἐν ἐλαχίστῳ ἄδικος καὶ ἐν πολλῷ ἄδικός ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "εἰ οὖν ἐν τῷ ἀδίκῳ μαμωνᾷ πιστοὶ οὐκ ἐγένεσθε, τὸ ἀληθινὸν τίς ὑμῖν πιστεύσει;"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "καὶ εἰ ἐν τῷ ἀλλοτρίῳ πιστοὶ οὐκ ἐγένεσθε, τὸ ⸀ὑμέτερον",
          {
            "noteId": 721
          },
          "τίς ⸂δώσει ὑμῖν",
          {
            "noteId": 722
          },
          ";"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "οὐδεὶς οἰκέτης δύναται δυσὶ κυρίοις δουλεύειν· ἢ γὰρ τὸν ἕνα μισήσει καὶ τὸν ἕτερον ἀγαπήσει, ἢ ἑνὸς ἀνθέξεται καὶ τοῦ ἑτέρου καταφρονήσει. οὐ δύνασθε θεῷ δουλεύειν καὶ μαμωνᾷ."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Ἤκουον δὲ ταῦτα ⸀πάντα",
          {
            "noteId": 723
          },
          "οἱ Φαρισαῖοι φιλάργυροι ὑπάρχοντες, καὶ ἐξεμυκτήριζον αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ εἶπεν αὐτοῖς· Ὑμεῖς ἐστε οἱ δικαιοῦντες ἑαυτοὺς ἐνώπιον τῶν ἀνθρώπων, ὁ δὲ θεὸς γινώσκει τὰς καρδίας ὑμῶν· ὅτι τὸ ἐν ἀνθρώποις ὑψηλὸν βδέλυγμα ἐνώπιον τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Ὁ νόμος καὶ οἱ προφῆται ⸀μέχρι",
          {
            "noteId": 724
          },
          "Ἰωάννου· ἀπὸ τότε ἡ βασιλεία τοῦ θεοῦ εὐαγγελίζεται καὶ πᾶς εἰς αὐτὴν βιάζεται."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Εὐκοπώτερον δέ ἐστιν τὸν οὐρανὸν καὶ τὴν γῆν παρελθεῖν ἢ τοῦ νόμου μίαν κεραίαν πεσεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Πᾶς ὁ ἀπολύων τὴν γυναῖκα αὐτοῦ καὶ",
          {
            "noteId": 725
          },
          "γαμῶν ἑτέραν μοιχεύει, ⸀καὶ ὁ ἀπολελυμένην ἀπὸ ἀνδρὸς γαμῶν μοιχεύει."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Ἄνθρωπος δέ τις ἦν πλούσιος, καὶ ἐνεδιδύσκετο πορφύραν καὶ βύσσον εὐφραινόμενος καθʼ ἡμέραν λαμπρῶς."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "πτωχὸς δέ ⸀τις",
          {
            "noteId": 726
          },
          "ὀνόματι ⸀Λάζαρος",
          {
            "noteId": 727
          },
          "ἐβέβλητο πρὸς τὸν πυλῶνα αὐτοῦ εἱλκωμένος"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "καὶ ἐπιθυμῶν χορτασθῆναι ⸀ἀπὸ",
          {
            "noteId": 728
          },
          "τῶν πιπτόντων ἀπὸ τῆς τραπέζης τοῦ πλουσίου· ἀλλὰ καὶ οἱ κύνες ἐρχόμενοι ⸀ἐπέλειχον",
          {
            "noteId": 729
          },
          "τὰ ἕλκη αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ἐγένετο δὲ ἀποθανεῖν τὸν πτωχὸν καὶ ἀπενεχθῆναι αὐτὸν ὑπὸ τῶν ἀγγέλων εἰς τὸν κόλπον Ἀβραάμ· ἀπέθανεν δὲ καὶ ὁ πλούσιος καὶ ἐτάφη."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "καὶ ἐν τῷ ᾅδῃ ἐπάρας τοὺς ὀφθαλμοὺς αὐτοῦ, ὑπάρχων ἐν βασάνοις, ⸀ὁρᾷ",
          {
            "noteId": 730
          },
          "Ἀβραὰμ ἀπὸ μακρόθεν καὶ Λάζαρον ἐν τοῖς κόλποις αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "καὶ αὐτὸς φωνήσας εἶπεν· Πάτερ Ἀβραάμ, ἐλέησόν με καὶ πέμψον Λάζαρον ἵνα βάψῃ τὸ ἄκρον τοῦ δακτύλου αὐτοῦ ὕδατος καὶ καταψύξῃ τὴν γλῶσσάν μου, ὅτι ὀδυνῶμαι ἐν τῇ φλογὶ ταύτῃ."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "εἶπεν δὲ Ἀβραάμ· Τέκνον, μνήσθητι ὅτι ⸀ἀπέλαβες",
          {
            "noteId": 731
          },
          "τὰ ἀγαθά σου ἐν τῇ ζωῇ σου, καὶ Λάζαρος ὁμοίως τὰ κακά· νῦν δὲ ὧδε παρακαλεῖται σὺ δὲ ὀδυνᾶσαι."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "καὶ ⸀ἐν",
          {
            "noteId": 732
          },
          "πᾶσι τούτοις μεταξὺ ἡμῶν καὶ ὑμῶν χάσμα μέγα ἐστήρικται, ὅπως οἱ θέλοντες διαβῆναι ἔνθεν πρὸς ὑμᾶς μὴ δύνωνται, ⸀μηδὲ ἐκεῖθεν πρὸς ἡμᾶς διαπερῶσιν.",
          {
            "noteId": 733
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "εἶπεν δέ· Ἐρωτῶ ⸂σε οὖν",
          {
            "noteId": 734
          },
          ", πάτερ, ἵνα πέμψῃς αὐτὸν εἰς τὸν οἶκον τοῦ πατρός μου,"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ἔχω γὰρ πέντε ἀδελφούς, ὅπως διαμαρτύρηται αὐτοῖς, ἵνα μὴ καὶ αὐτοὶ ἔλθωσιν εἰς τὸν τόπον τοῦτον τῆς βασάνου."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "λέγει ⸀δὲ",
          {
            "noteId": 735
          },
          "Ἀβραάμ· Ἔχουσι Μωϋσέα καὶ τοὺς προφήτας· ἀκουσάτωσαν αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ὁ δὲ εἶπεν· Οὐχί, πάτερ Ἀβραάμ, ἀλλʼ ἐάν τις ἀπὸ νεκρῶν πορευθῇ πρὸς αὐτοὺς μετανοήσουσιν."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "εἶπεν δὲ αὐτῷ· Εἰ Μωϋσέως καὶ τῶν προφητῶν οὐκ ἀκούουσιν, οὐδʼ ἐάν τις ἐκ νεκρῶν ἀναστῇ πεισθήσονται."
        ]
      }
    ],
