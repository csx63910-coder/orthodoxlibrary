  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἐγένετο δὲ ἐν ταῖς ἡμέραις ἐκείναις ἐξῆλθεν δόγμα παρὰ Καίσαρος Αὐγούστου ἀπογράφεσθαι πᾶσαν τὴν οἰκουμένην·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "(⸀αὕτη",
          {
            "noteId": 40
          },
          "ἀπογραφὴ πρώτη ἐγένετο ἡγεμονεύοντος τῆς Συρίας Κυρηνίου·)"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ ἐπορεύοντο πάντες ἀπογράφεσθαι, ἕκαστος εἰς τὴν ⸀ἑαυτοῦ",
          {
            "noteId": 41
          },
          "πόλιν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Ἀνέβη δὲ καὶ Ἰωσὴφ ἀπὸ τῆς Γαλιλαίας ἐκ πόλεως Ναζαρὲθ εἰς τὴν Ἰουδαίαν εἰς πόλιν Δαυὶδ ἥτις καλεῖται Βηθλέεμ, διὰ τὸ εἶναι αὐτὸν ἐξ οἴκου καὶ πατριᾶς Δαυίδ,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἀπογράψασθαι σὺν Μαριὰμ τῇ ⸂ἐμνηστευμένῃ αὐτῷ",
          {
            "noteId": 42
          },
          ", οὔσῃ ἐγκύῳ."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἐγένετο δὲ ἐν τῷ εἶναι αὐτοὺς ἐκεῖ ἐπλήσθησαν αἱ ἡμέραι τοῦ τεκεῖν αὐτήν,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "καὶ ἔτεκεν τὸν υἱὸν αὐτῆς τὸν πρωτότοκον, καὶ ἐσπαργάνωσεν αὐτὸν καὶ ἀνέκλινεν αὐτὸν ⸀ἐν",
          {
            "noteId": 43
          },
          "φάτνῃ, διότι οὐκ ἦν αὐτοῖς τόπος ἐν τῷ καταλύματι."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Καὶ ποιμένες ἦσαν ἐν τῇ χώρᾳ τῇ αὐτῇ ἀγραυλοῦντες καὶ φυλάσσοντες φυλακὰς τῆς νυκτὸς ἐπὶ τὴν ποίμνην αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "⸀καὶ",
          {
            "noteId": 44
          },
          "ἄγγελος κυρίου ἐπέστη αὐτοῖς καὶ δόξα κυρίου περιέλαμψεν αὐτούς, καὶ ἐφοβήθησαν φόβον μέγαν·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ εἶπεν αὐτοῖς ὁ ἄγγελος· Μὴ φοβεῖσθε, ἰδοὺ γὰρ εὐαγγελίζομαι ὑμῖν χαρὰν μεγάλην ἥτις ἔσται παντὶ τῷ λαῷ,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ὅτι ἐτέχθη ὑμῖν σήμερον σωτὴρ ὅς ἐστιν χριστὸς κύριος ἐν πόλει Δαυίδ·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "καὶ τοῦτο ὑμῖν ⸀τὸ",
          {
            "noteId": 45
          },
          "σημεῖον, εὑρήσετε βρέφος ἐσπαργανωμένον ⸀καὶ",
          {
            "noteId": 46
          },
          "κείμενον ἐν φάτνῃ."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ ἐξαίφνης ἐγένετο σὺν τῷ ἀγγέλῳ πλῆθος στρατιᾶς ⸀οὐρανίου",
          {
            "noteId": 47
          },
          "αἰνούντων τὸν θεὸν καὶ λεγόντων·"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Δόξα ἐν ὑψίστοις θεῷ καὶ ἐπὶ γῆς εἰρήνη ἐν ἀνθρώποις ⸀εὐδοκίας",
          {
            "noteId": 48
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Καὶ ἐγένετο ὡς ἀπῆλθον ἀπʼ αὐτῶν εἰς τὸν οὐρανὸν οἱ",
          {
            "noteId": 49
          },
          "ἄγγελοι, ⸀οἱ ποιμένες ⸀ἐλάλουν",
          {
            "noteId": 50
          },
          "πρὸς ἀλλήλους· Διέλθωμεν δὴ ἕως Βηθλέεμ καὶ ἴδωμεν τὸ ῥῆμα τοῦτο τὸ γεγονὸς ὃ ὁ κύριος ἐγνώρισεν ἡμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ ἦλθαν σπεύσαντες καὶ ἀνεῦραν τήν τε Μαριὰμ καὶ τὸν Ἰωσὴφ καὶ τὸ βρέφος κείμενον ἐν τῇ φάτνῃ·"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ἰδόντες δὲ ⸀ἐγνώρισαν",
          {
            "noteId": 51
          },
          "περὶ τοῦ ῥήματος τοῦ λαληθέντος αὐτοῖς περὶ τοῦ παιδίου τούτου."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ πάντες οἱ ἀκούσαντες ἐθαύμασαν περὶ τῶν λαληθέντων ὑπὸ τῶν ποιμένων πρὸς αὐτούς,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἡ δὲ ⸀Μαρία",
          {
            "noteId": 52
          },
          "πάντα συνετήρει τὰ ῥήματα ταῦτα συμβάλλουσα ἐν τῇ καρδίᾳ αὐτῆς."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "καὶ ὑπέστρεψαν οἱ ποιμένες δοξάζοντες καὶ αἰνοῦντες τὸν θεὸν ἐπὶ πᾶσιν οἷς ἤκουσαν καὶ εἶδον καθὼς ἐλαλήθη πρὸς αὐτούς."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Καὶ ὅτε ἐπλήσθησαν ἡμέραι ὀκτὼ τοῦ περιτεμεῖν αὐτόν, καὶ ἐκλήθη τὸ ὄνομα αὐτοῦ Ἰησοῦς, τὸ κληθὲν ὑπὸ τοῦ ἀγγέλου πρὸ τοῦ συλλημφθῆναι αὐτὸν ἐν τῇ κοιλίᾳ."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Καὶ ὅτε ἐπλήσθησαν αἱ ἡμέραι τοῦ καθαρισμοῦ αὐτῶν κατὰ τὸν νόμον Μωϋσέως, ἀνήγαγον αὐτὸν εἰς Ἱεροσόλυμα παραστῆσαι τῷ κυρίῳ,"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "καθὼς γέγραπται ἐν νόμῳ κυρίου ὅτι Πᾶν ἄρσεν διανοῖγον μήτραν ἅγιον τῷ κυρίῳ κληθήσεται,"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "καὶ τοῦ δοῦναι θυσίαν κατὰ τὸ εἰρημένον ἐν ⸀τῷ",
          {
            "noteId": 53
          },
          "νόμῳ κυρίου, ζεῦγος τρυγόνων ἢ δύο νοσσοὺς περιστερῶν."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Καὶ ἰδοὺ ⸂ἄνθρωπος ἦν",
          {
            "noteId": 54
          },
          "ἐν Ἰερουσαλὴμ ᾧ ὄνομα Συμεών, καὶ ὁ ἄνθρωπος οὗτος δίκαιος καὶ εὐλαβής, προσδεχόμενος παράκλησιν τοῦ Ἰσραήλ, καὶ πνεῦμα ἦν ἅγιον ἐπʼ αὐτόν·"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "καὶ ἦν αὐτῷ κεχρηματισμένον ὑπὸ τοῦ πνεύματος τοῦ ἁγίου μὴ ἰδεῖν θάνατον πρὶν ⸂ἢ ἂν",
          {
            "noteId": 55
          },
          "ἴδῃ τὸν χριστὸν κυρίου."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "καὶ ἦλθεν ἐν τῷ πνεύματι εἰς τὸ ἱερόν· καὶ ἐν τῷ εἰσαγαγεῖν τοὺς γονεῖς τὸ παιδίον Ἰησοῦν τοῦ ποιῆσαι αὐτοὺς κατὰ τὸ εἰθισμένον τοῦ νόμου περὶ αὐτοῦ"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "καὶ αὐτὸς ἐδέξατο αὐτὸ εἰς τὰς ⸀ἀγκάλας",
          {
            "noteId": 56
          },
          "καὶ εὐλόγησεν τὸν θεὸν καὶ εἶπεν·"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Νῦν ἀπολύεις τὸν δοῦλόν σου, δέσποτα, κατὰ τὸ ῥῆμά σου ἐν εἰρήνῃ·"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ὅτι εἶδον οἱ ὀφθαλμοί μου τὸ σωτήριόν σου"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "ὃ ἡτοίμασας κατὰ πρόσωπον πάντων τῶν λαῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "φῶς εἰς ἀποκάλυψιν ἐθνῶν καὶ δόξαν λαοῦ σου Ἰσραήλ."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "καὶ ἦν ⸂ὁ πατὴρ αὐτοῦ",
          {
            "noteId": 57
          },
          "καὶ ἡ ⸀μήτηρ",
          {
            "noteId": 58
          },
          "θαυμάζοντες ἐπὶ τοῖς λαλουμένοις περὶ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "καὶ εὐλόγησεν αὐτοὺς Συμεὼν καὶ εἶπεν πρὸς Μαριὰμ τὴν μητέρα αὐτοῦ· Ἰδοὺ οὗτος κεῖται εἰς πτῶσιν καὶ ἀνάστασιν πολλῶν ἐν τῷ Ἰσραὴλ καὶ εἰς σημεῖον ἀντιλεγόμενον,"
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "καὶ σοῦ ⸀δὲ",
          {
            "noteId": 59
          },
          "αὐτῆς τὴν ψυχὴν διελεύσεται ῥομφαία, ὅπως ἂν ἀποκαλυφθῶσιν ἐκ πολλῶν καρδιῶν διαλογισμοί."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "Καὶ ἦν Ἅννα προφῆτις, θυγάτηρ Φανουήλ, ἐκ φυλῆς Ἀσήρ (αὕτη προβεβηκυῖα ἐν ἡμέραις πολλαῖς, ζήσασα ⸂μετὰ ἀνδρὸς ἔτη",
          {
            "noteId": 60
          },
          "ἑπτὰ ἀπὸ τῆς παρθενίας αὐτῆς,"
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "καὶ αὐτὴ χήρα ⸀ἕως",
          {
            "noteId": 61
          },
          "ἐτῶν ὀγδοήκοντα τεσσάρων,) ἣ οὐκ ⸀ἀφίστατο",
          {
            "noteId": 62
          },
          "τοῦ ἱεροῦ νηστείαις καὶ δεήσεσιν λατρεύουσα νύκτα καὶ ἡμέραν."
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "⸀καὶ",
          {
            "noteId": 63
          },
          "αὐτῇ τῇ ὥρᾳ ἐπιστᾶσα ἀνθωμολογεῖτο τῷ ⸀θεῷ",
          {
            "noteId": 64
          },
          "καὶ ἐλάλει περὶ αὐτοῦ πᾶσιν τοῖς προσδεχομένοις ⸀λύτρωσιν Ἰερουσαλήμ.",
          {
            "noteId": 65
          }
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "Καὶ ὡς ἐτέλεσαν ⸀πάντα",
          {
            "noteId": 66
          },
          "τὰ κατὰ τὸν νόμον κυρίου, ⸀ἐπέστρεψαν",
          {
            "noteId": 67
          },
          "εἰς",
          {
            "noteId": 68
          },
          "τὴν Γαλιλαίαν ⸀εἰς πόλιν ἑαυτῶν Ναζαρέθ."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "Τὸ δὲ παιδίον ηὔξανεν καὶ ἐκραταιοῦτο ⸂πληρούμενον σοφίᾳ",
          {
            "noteId": 69
          },
          ", καὶ χάρις θεοῦ ἦν ἐπʼ αὐτό."
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "Καὶ ἐπορεύοντο οἱ γονεῖς αὐτοῦ κατʼ ἔτος εἰς Ἰερουσαλὴμ τῇ ἑορτῇ τοῦ πάσχα."
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "καὶ ὅτε ἐγένετο ἐτῶν δώδεκα, ⸀ἀναβαινόντων",
          {
            "noteId": 70
          },
          "⸀αὐτῶν",
          {
            "noteId": 71
          },
          "κατὰ τὸ ἔθος τῆς ἑορτῆς"
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "καὶ τελειωσάντων τὰς ἡμέρας, ἐν τῷ ὑποστρέφειν αὐτοὺς ὑπέμεινεν Ἰησοῦς ὁ παῖς ἐν Ἰερουσαλήμ, καὶ οὐκ ⸂ἔγνωσαν οἱ γονεῖς",
          {
            "noteId": 72
          },
          "αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "νομίσαντες δὲ αὐτὸν ⸂εἶναι ἐν τῇ συνοδίᾳ",
          {
            "noteId": 73
          },
          "ἦλθον ἡμέρας ὁδὸν καὶ",
          {
            "noteId": 74
          },
          "ἀνεζήτουν αὐτὸν ἐν τοῖς συγγενεῦσιν ⸀καὶ τοῖς γνωστοῖς,"
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "καὶ μὴ ⸀εὑρόντες",
          {
            "noteId": 75
          },
          "ὑπέστρεψαν εἰς Ἰερουσαλὴμ ⸀ἀναζητοῦντες",
          {
            "noteId": 76
          },
          "αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "καὶ ἐγένετο μετὰ ἡμέρας τρεῖς εὗρον αὐτὸν ἐν τῷ ἱερῷ καθεζόμενον ἐν μέσῳ τῶν διδασκάλων καὶ ἀκούοντα αὐτῶν καὶ ἐπερωτῶντα αὐτούς·"
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          "ἐξίσταντο δὲ πάντες οἱ ἀκούοντες αὐτοῦ ἐπὶ τῇ συνέσει καὶ ταῖς ἀποκρίσεσιν αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          "καὶ ἰδόντες αὐτὸν ἐξεπλάγησαν, καὶ ⸂εἶπεν πρὸς αὐτὸν ἡ μήτηρ αὐτοῦ",
          {
            "noteId": 77
          },
          "· Τέκνον, τί ἐποίησας ἡμῖν οὕτως; ἰδοὺ ὁ πατήρ σου καὶ ἐγὼ ὀδυνώμενοι ⸀ἐζητοῦμέν",
          {
            "noteId": 78
          },
          "σε."
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          "καὶ εἶπεν πρὸς αὐτούς· Τί ὅτι ἐζητεῖτέ με; οὐκ ᾔδειτε ὅτι ἐν τοῖς τοῦ πατρός μου δεῖ εἶναί με;"
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          "καὶ αὐτοὶ οὐ συνῆκαν τὸ ῥῆμα ὃ ἐλάλησεν αὐτοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 51,
        "content": [
          "καὶ κατέβη μετʼ αὐτῶν καὶ ἦλθεν εἰς Ναζαρέθ, καὶ ἦν ὑποτασσόμενος αὐτοῖς. καὶ ἡ μήτηρ αὐτοῦ διετήρει πάντα τὰ ῥήματα ⸀ταῦτα",
          {
            "noteId": 79
          },
          "ἐν τῇ καρδίᾳ αὐτῆς."
        ]
      },
      {
        "type": "verse",
        "number": 52,
        "content": [
          "Καὶ Ἰησοῦς προέκοπτεν ⸂σοφίᾳ καὶ ἡλικίᾳ",
          {
            "noteId": 80
          },
          "καὶ χάριτι παρὰ θεῷ καὶ ἀνθρώποις."
        ]
      }
    ],
