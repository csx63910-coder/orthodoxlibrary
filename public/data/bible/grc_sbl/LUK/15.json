  "chapter": {
    "number": 15,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἦσαν δὲ ⸂αὐτῷ ἐγγίζοντες",
          {
            "noteId": 678
          },
          "πάντες οἱ τελῶναι καὶ οἱ ἁμαρτωλοὶ ἀκούειν αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ διεγόγγυζον οἵ ⸀τε",
          {
            "noteId": 679
          },
          "Φαρισαῖοι καὶ οἱ γραμματεῖς λέγοντες ὅτι Οὗτος ἁμαρτωλοὺς προσδέχεται καὶ συνεσθίει αὐτοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "εἶπεν δὲ πρὸς αὐτοὺς τὴν παραβολὴν ταύτην λέγων·"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Τίς ἄνθρωπος ἐξ ὑμῶν ἔχων ἑκατὸν πρόβατα καὶ ⸀ἀπολέσας",
          {
            "noteId": 680
          },
          "⸂ἐξ αὐτῶν ἓν",
          {
            "noteId": 681
          },
          "οὐ καταλείπει τὰ ἐνενήκοντα ἐννέα ἐν τῇ ἐρήμῳ καὶ πορεύεται ἐπὶ τὸ ἀπολωλὸς ἕως εὕρῃ αὐτό;"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ εὑρὼν ἐπιτίθησιν ἐπὶ τοὺς ὤμους ⸀αὐτοῦ",
          {
            "noteId": 682
          },
          "χαίρων,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ ἐλθὼν εἰς τὸν οἶκον συγκαλεῖ τοὺς φίλους καὶ τοὺς γείτονας, λέγων αὐτοῖς· Συγχάρητέ μοι ὅτι εὗρον τὸ πρόβατόν μου τὸ ἀπολωλός."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "λέγω ὑμῖν ὅτι οὕτως χαρὰ ⸂ἐν τῷ οὐρανῷ ἔσται",
          {
            "noteId": 683
          },
          "ἐπὶ ἑνὶ ἁμαρτωλῷ μετανοοῦντι ἢ ἐπὶ ἐνενήκοντα ἐννέα δικαίοις οἵτινες οὐ χρείαν ἔχουσιν μετανοίας."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Ἢ τίς γυνὴ δραχμὰς ἔχουσα δέκα, ἐὰν ἀπολέσῃ δραχμὴν μίαν, οὐχὶ ἅπτει λύχνον καὶ σαροῖ τὴν οἰκίαν καὶ ζητεῖ ἐπιμελῶς ἕως ⸀οὗ",
          {
            "noteId": 684
          },
          "εὕρῃ;"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ εὑροῦσα ⸀συγκαλεῖ",
          {
            "noteId": 685
          },
          "τὰς φίλας ⸀καὶ",
          {
            "noteId": 686
          },
          "γείτονας λέγουσα· Συγχάρητέ μοι ὅτι εὗρον τὴν δραχμὴν ἣν ἀπώλεσα."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "οὕτως, λέγω ὑμῖν, ⸂γίνεται χαρὰ",
          {
            "noteId": 687
          },
          "ἐνώπιον τῶν ἀγγέλων τοῦ θεοῦ ἐπὶ ἑνὶ ἁμαρτωλῷ μετανοοῦντι."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Εἶπεν δέ· Ἄνθρωπός τις εἶχεν δύο υἱούς."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "καὶ εἶπεν ὁ νεώτερος αὐτῶν τῷ πατρί· Πάτερ, δός μοι τὸ ἐπιβάλλον μέρος τῆς οὐσίας· ⸂ὁ δὲ",
          {
            "noteId": 688
          },
          "διεῖλεν αὐτοῖς τὸν βίον."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ μετʼ οὐ πολλὰς ἡμέρας συναγαγὼν ⸀πάντα",
          {
            "noteId": 689
          },
          "ὁ νεώτερος υἱὸς ἀπεδήμησεν εἰς χώραν μακράν, καὶ ἐκεῖ διεσκόρπισεν τὴν οὐσίαν αὐτοῦ ζῶν ἀσώτως."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "δαπανήσαντος δὲ αὐτοῦ πάντα ἐγένετο λιμὸς ⸀ἰσχυρὰ",
          {
            "noteId": 690
          },
          "κατὰ τὴν χώραν ἐκείνην, καὶ αὐτὸς ἤρξατο ὑστερεῖσθαι."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ πορευθεὶς ἐκολλήθη ἑνὶ τῶν πολιτῶν τῆς χώρας ἐκείνης, καὶ ἔπεμψεν αὐτὸν εἰς τοὺς ἀγροὺς αὐτοῦ βόσκειν χοίρους·"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ ἐπεθύμει ⸂γεμίσαι τὴν κοιλίαν αὐτοῦ ἀπὸ",
          {
            "noteId": 691
          },
          "τῶν κερατίων ὧν ἤσθιον οἱ χοῖροι, καὶ οὐδεὶς ἐδίδου αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "εἰς ἑαυτὸν δὲ ἐλθὼν ⸀ἔφη",
          {
            "noteId": 692
          },
          "Πόσοι μίσθιοι τοῦ πατρός μου ⸀περισσεύονται",
          {
            "noteId": 693
          },
          "ἄρτων, ἐγὼ δὲ ⸂λιμῷ ὧδε",
          {
            "noteId": 694
          },
          "ἀπόλλυμαι·"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ἀναστὰς πορεύσομαι πρὸς τὸν πατέρα μου καὶ ἐρῶ αὐτῷ· Πάτερ, ἥμαρτον εἰς τὸν οὐρανὸν καὶ ἐνώπιόν σου,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "⸀οὐκέτι",
          {
            "noteId": 695
          },
          "εἰμὶ ἄξιος κληθῆναι υἱός σου· ποίησόν με ὡς ἕνα τῶν μισθίων σου."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "καὶ ἀναστὰς ἦλθεν πρὸς τὸν πατέρα ⸀ἑαυτοῦ",
          {
            "noteId": 696
          },
          "ἔτι δὲ αὐτοῦ μακρὰν ἀπέχοντος εἶδεν αὐτὸν ὁ πατὴρ αὐτοῦ καὶ ἐσπλαγχνίσθη καὶ δραμὼν ἐπέπεσεν ἐπὶ τὸν τράχηλον αὐτοῦ καὶ κατεφίλησεν αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "εἶπεν δὲ ⸂ὁ υἱὸς αὐτῷ",
          {
            "noteId": 697
          },
          "· Πάτερ, ἥμαρτον εἰς τὸν οὐρανὸν καὶ ἐνώπιόν σου, ⸀οὐκέτι",
          {
            "noteId": 698
          },
          "εἰμὶ ἄξιος κληθῆναι υἱός ⸀σου",
          {
            "noteId": 699
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "εἶπεν δὲ ὁ πατὴρ πρὸς τοὺς δούλους αὐτοῦ· ⸀Ταχὺ",
          {
            "noteId": 700
          },
          "⸀ἐξενέγκατε",
          {
            "noteId": 701
          },
          "στολὴν τὴν πρώτην καὶ ἐνδύσατε αὐτόν, καὶ δότε δακτύλιον εἰς τὴν χεῖρα αὐτοῦ καὶ ὑποδήματα εἰς τοὺς πόδας,"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "καὶ ⸀φέρετε",
          {
            "noteId": 702
          },
          "τὸν μόσχον τὸν σιτευτόν, θύσατε, καὶ φαγόντες εὐφρανθῶμεν,"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ὅτι οὗτος ὁ υἱός μου νεκρὸς ἦν καὶ ἀνέζησεν, ⸂ἦν ἀπολωλὼς",
          {
            "noteId": 703
          },
          "καὶ εὑρέθη. καὶ ἤρξαντο εὐφραίνεσθαι."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Ἦν δὲ ὁ υἱὸς αὐτοῦ ὁ πρεσβύτερος ἐν ἀγρῷ· καὶ ὡς ἐρχόμενος ἤγγισεν τῇ οἰκίᾳ, ἤκουσεν συμφωνίας καὶ χορῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "καὶ προσκαλεσάμενος ἕνα τῶν παίδων ἐπυνθάνετο τί ⸀ἂν",
          {
            "noteId": 704
          },
          "εἴη ταῦτα·"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "ὁ δὲ εἶπεν αὐτῷ ὅτι Ὁ ἀδελφός σου ἥκει, καὶ ἔθυσεν ὁ πατήρ σου τὸν μόσχον τὸν σιτευτόν, ὅτι ὑγιαίνοντα αὐτὸν ἀπέλαβεν."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ὠργίσθη δὲ",
          {
            "noteId": 705
          },
          "καὶ οὐκ ἤθελεν εἰσελθεῖν. ὁ ⸀δὲ πατὴρ αὐτοῦ ἐξελθὼν παρεκάλει αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "ὁ δὲ ἀποκριθεὶς εἶπεν τῷ πατρὶ ⸀αὐτοῦ",
          {
            "noteId": 706
          },
          "Ἰδοὺ τοσαῦτα ἔτη δουλεύω σοι καὶ οὐδέποτε ἐντολήν σου παρῆλθον, καὶ ἐμοὶ οὐδέποτε ἔδωκας ἔριφον ἵνα μετὰ τῶν φίλων μου εὐφρανθῶ·"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ὅτε δὲ ὁ υἱός σου οὗτος ὁ καταφαγών σου τὸν βίον ⸀μετὰ",
          {
            "noteId": 707
          },
          "πορνῶν ἦλθεν, ἔθυσας αὐτῷ τὸν ⸂σιτευτὸν μόσχον",
          {
            "noteId": 708
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "ὁ δὲ εἶπεν αὐτῷ· Τέκνον, σὺ πάντοτε μετʼ ἐμοῦ εἶ, καὶ πάντα τὰ ἐμὰ σά ἐστιν·"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "εὐφρανθῆναι δὲ καὶ χαρῆναι ἔδει, ὅτι ὁ ἀδελφός σου οὗτος νεκρὸς ἦν καὶ ⸀ἔζησεν",
          {
            "noteId": 709
          },
          "καὶ ⸀ἀπολωλὼς",
          {
            "noteId": 710
          },
          "καὶ εὑρέθη."
        ]
      }
    ],
