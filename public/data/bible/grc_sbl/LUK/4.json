  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἰησοῦς δὲ ⸂πλήρης πνεύματος ἁγίου",
          {
            "noteId": 103
          },
          "ὑπέστρεψεν ἀπὸ τοῦ Ἰορδάνου, καὶ ἤγετο ἐν τῷ πνεύματι ⸂ἐν τῇ ἐρήμῳ",
          {
            "noteId": 104
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἡμέρας τεσσεράκοντα πειραζόμενος ὑπὸ τοῦ διαβόλου. καὶ οὐκ ἔφαγεν οὐδὲν ἐν ταῖς ἡμέραις ἐκείναις, καὶ συντελεσθεισῶν ⸀αὐτῶν",
          {
            "noteId": 105
          },
          "ἐπείνασεν."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "⸂εἶπεν δὲ",
          {
            "noteId": 106
          },
          "αὐτῷ ὁ διάβολος· Εἰ υἱὸς εἶ τοῦ θεοῦ, εἰπὲ τῷ λίθῳ τούτῳ ἵνα γένηται ἄρτος."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ ἀπεκρίθη ⸂πρὸς αὐτὸν ὁ Ἰησοῦς",
          {
            "noteId": 107
          },
          "· Γέγραπται ὅτι Οὐκ ἐπʼ ἄρτῳ μόνῳ ζήσεται ⸀ὁ",
          {
            "noteId": 108
          },
          "⸀ἄνθρωπος",
          {
            "noteId": 109
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Καὶ ἀναγαγὼν ⸀αὐτὸν",
          {
            "noteId": 110
          },
          "ἔδειξεν αὐτῷ πάσας τὰς βασιλείας τῆς οἰκουμένης ἐν στιγμῇ χρόνου·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ εἶπεν αὐτῷ ὁ διάβολος· Σοὶ δώσω τὴν ἐξουσίαν ταύτην ἅπασαν καὶ τὴν δόξαν αὐτῶν, ὅτι ἐμοὶ παραδέδοται καὶ ᾧ ⸀ἂν",
          {
            "noteId": 111
          },
          "θέλω δίδωμι αὐτήν·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "σὺ οὖν ἐὰν προσκυνήσῃς ἐνώπιον ἐμοῦ, ἔσται σοῦ πᾶσα."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ ἀποκριθεὶς ⸂ὁ Ἰησοῦς εἶπεν αὐτῷ",
          {
            "noteId": 112
          },
          "· Γέγραπται· ⸂Κύριον τὸν θεόν σου προσκυνήσεις",
          {
            "noteId": 113
          },
          "καὶ αὐτῷ μόνῳ λατρεύσεις."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "⸂Ἤγαγεν δὲ",
          {
            "noteId": 114
          },
          "αὐτὸν εἰς Ἰερουσαλὴμ καὶ ⸀ἔστησεν",
          {
            "noteId": 115
          },
          "ἐπὶ τὸ πτερύγιον τοῦ ἱεροῦ, καὶ εἶπεν αὐτῷ· Εἰ υἱὸς εἶ τοῦ θεοῦ, βάλε σεαυτὸν ἐντεῦθεν κάτω·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "γέγραπται γὰρ ὅτι Τοῖς ἀγγέλοις αὐτοῦ ἐντελεῖται περὶ σοῦ τοῦ διαφυλάξαι σε,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ ⸀ὅτι",
          {
            "noteId": 116
          },
          "Ἐπὶ χειρῶν ἀροῦσίν σε μήποτε προσκόψῃς πρὸς λίθον τὸν πόδα σου."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "καὶ ἀποκριθεὶς εἶπεν αὐτῷ ὁ Ἰησοῦς ὅτι Εἴρηται· Οὐκ ἐκπειράσεις κύριον τὸν θεόν σου."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ συντελέσας πάντα πειρασμὸν ὁ διάβολος ἀπέστη ἀπʼ αὐτοῦ ἄχρι καιροῦ."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Καὶ ὑπέστρεψεν ὁ Ἰησοῦς ἐν τῇ δυνάμει τοῦ πνεύματος εἰς τὴν Γαλιλαίαν. καὶ φήμη ἐξῆλθεν καθʼ ὅλης τῆς περιχώρου περὶ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ αὐτὸς ἐδίδασκεν ἐν ταῖς συναγωγαῖς αὐτῶν, δοξαζόμενος ὑπὸ πάντων."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Καὶ ἦλθεν ⸀εἰς",
          {
            "noteId": 117
          },
          "Ναζαρά, οὗ ἦν τεθραμμένος, καὶ εἰσῆλθεν κατὰ τὸ εἰωθὸς αὐτῷ ἐν τῇ ἡμέρᾳ τῶν σαββάτων εἰς τὴν συναγωγήν, καὶ ἀνέστη ἀναγνῶναι."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καὶ ἐπεδόθη αὐτῷ βιβλίον ⸂τοῦ προφήτου Ἠσαΐου",
          {
            "noteId": 118
          },
          "καὶ ⸀ἀναπτύξας",
          {
            "noteId": 119
          },
          "τὸ βιβλίον εὗρεν τὸν τόπον οὗ ἦν γεγραμμένον·"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Πνεῦμα κυρίου ἐπʼ ἐμέ, οὗ εἵνεκεν ἔχρισέν με",
          {
            "noteId": 120
          },
          "εὐαγγελίσασθαι πτωχοῖς, ἀπέσταλκέν ⸀με κηρύξαι αἰχμαλώτοις ἄφεσιν καὶ τυφλοῖς ἀνάβλεψιν, ἀποστεῖλαι τεθραυσμένους ἐν ἀφέσει,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "κηρύξαι ἐνιαυτὸν κυρίου δεκτόν."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "καὶ πτύξας τὸ βιβλίον ἀποδοὺς τῷ ὑπηρέτῃ ἐκάθισεν· καὶ πάντων ⸂οἱ ὀφθαλμοὶ ἐν τῇ συναγωγῇ",
          {
            "noteId": 121
          },
          "ἦσαν ἀτενίζοντες αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ἤρξατο δὲ λέγειν πρὸς αὐτοὺς ὅτι Σήμερον πεπλήρωται ἡ γραφὴ αὕτη ἐν τοῖς ὠσὶν ὑμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "καὶ πάντες ἐμαρτύρουν αὐτῷ καὶ ἐθαύμαζον ἐπὶ τοῖς λόγοις τῆς χάριτος τοῖς ἐκπορευομένοις ἐκ τοῦ στόματος αὐτοῦ, καὶ ἔλεγον· ⸂Οὐχὶ υἱός ἐστιν Ἰωσὴφ οὗτος",
          {
            "noteId": 122
          },
          ";"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "καὶ εἶπεν πρὸς αὐτούς· Πάντως ἐρεῖτέ μοι τὴν παραβολὴν ταύτην· Ἰατρέ, θεράπευσον σεαυτόν· ὅσα ἠκούσαμεν γενόμενα ⸂εἰς τὴν Καφαρναοὺμ",
          {
            "noteId": 123
          },
          "ποίησον καὶ ὧδε ἐν τῇ πατρίδι σου."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "εἶπεν δέ· Ἀμὴν λέγω ὑμῖν ὅτι οὐδεὶς προφήτης δεκτός ἐστιν ἐν τῇ πατρίδι αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ἐπʼ ἀληθείας δὲ λέγω ὑμῖν, πολλαὶ χῆραι ἦσαν ἐν ταῖς ἡμέραις Ἠλίου ἐν τῷ Ἰσραήλ, ὅτε ἐκλείσθη ὁ οὐρανὸς ⸀ἐπὶ",
          {
            "noteId": 124
          },
          "ἔτη τρία καὶ μῆνας ἕξ, ὡς ἐγένετο λιμὸς μέγας ἐπὶ πᾶσαν τὴν γῆν,"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "καὶ πρὸς οὐδεμίαν αὐτῶν ἐπέμφθη Ἠλίας εἰ μὴ εἰς Σάρεπτα τῆς ⸀Σιδωνίας",
          {
            "noteId": 125
          },
          "πρὸς γυναῖκα χήραν."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "καὶ πολλοὶ λεπροὶ ἦσαν ⸂ἐν τῷ Ἰσραὴλ ἐπὶ Ἐλισαίου τοῦ προφήτου",
          {
            "noteId": 126
          },
          ", καὶ οὐδεὶς αὐτῶν ἐκαθαρίσθη, εἰ μὴ Ναιμὰν ὁ Σύρος."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "καὶ ἐπλήσθησαν πάντες θυμοῦ ἐν τῇ συναγωγῇ ἀκούοντες ταῦτα,"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "καὶ ἀναστάντες ἐξέβαλον αὐτὸν ἔξω τῆς πόλεως, καὶ ἤγαγον αὐτὸν ἕως ὀφρύος τοῦ ὄρους ἐφʼ οὗ ἡ πόλις ⸂ᾠκοδόμητο αὐτῶν, ὥστε⸃ κατακρημνίσαι αὐτόν·",
          {
            "noteId": 127
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "αὐτὸς δὲ διελθὼν διὰ μέσου αὐτῶν ἐπορεύετο."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "Καὶ κατῆλθεν εἰς Καφαρναοὺμ πόλιν τῆς Γαλιλαίας. καὶ ἦν διδάσκων αὐτοὺς ἐν τοῖς σάββασιν·"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "καὶ ἐξεπλήσσοντο ἐπὶ τῇ διδαχῇ αὐτοῦ, ὅτι ἐν ἐξουσίᾳ ἦν ὁ λόγος αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "καὶ ἐν τῇ συναγωγῇ ἦν ἄνθρωπος ἔχων πνεῦμα δαιμονίου ἀκαθάρτου, καὶ ἀνέκραξεν φωνῇ μεγάλῃ·"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "⸀Ἔα",
          {
            "noteId": 128
          },
          "τί ἡμῖν καὶ σοί, Ἰησοῦ Ναζαρηνέ; ἦλθες ἀπολέσαι ἡμᾶς; οἶδά σε τίς εἶ, ὁ ἅγιος τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "καὶ ἐπετίμησεν αὐτῷ ὁ Ἰησοῦς λέγων· Φιμώθητι καὶ ἔξελθε ⸀ἀπʼ",
          {
            "noteId": 129
          },
          "αὐτοῦ. καὶ ῥίψαν αὐτὸ",
          {
            "noteId": 130
          },
          "τὸ δαιμόνιον εἰς ⸀τὸ μέσον ἐξῆλθεν ἀπʼ αὐτοῦ μηδὲν βλάψαν αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "καὶ ἐγένετο θάμβος ἐπὶ πάντας, καὶ συνελάλουν πρὸς ἀλλήλους λέγοντες· Τίς ὁ λόγος οὗτος ὅτι ἐν ἐξουσίᾳ καὶ δυνάμει ἐπιτάσσει τοῖς ἀκαθάρτοις πνεύμασιν, καὶ ἐξέρχονται;"
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "καὶ ἐξεπορεύετο ἦχος περὶ αὐτοῦ εἰς πάντα τόπον τῆς περιχώρου."
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "Ἀναστὰς δὲ ⸀ἀπὸ",
          {
            "noteId": 131
          },
          "τῆς συναγωγῆς εἰσῆλθεν εἰς τὴν οἰκίαν Σίμωνος. πενθερὰ δὲ τοῦ Σίμωνος ἦν συνεχομένη πυρετῷ μεγάλῳ, καὶ ἠρώτησαν αὐτὸν περὶ αὐτῆς."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "καὶ ἐπιστὰς ἐπάνω αὐτῆς ἐπετίμησεν τῷ πυρετῷ, καὶ ἀφῆκεν αὐτήν· παραχρῆμα δὲ ἀναστᾶσα διηκόνει αὐτοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "Δύνοντος δὲ τοῦ ἡλίου ⸀ἅπαντες",
          {
            "noteId": 132
          },
          "ὅσοι εἶχον ἀσθενοῦντας νόσοις ποικίλαις ἤγαγον αὐτοὺς πρὸς αὐτόν· ὁ δὲ ἑνὶ ἑκάστῳ αὐτῶν τὰς χεῖρας ⸂ἐπιτιθεὶς ἐθεράπευεν",
          {
            "noteId": 133
          },
          "αὐτούς."
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "ἐξήρχετο δὲ καὶ δαιμόνια ἀπὸ πολλῶν ⸀κραυγάζοντα",
          {
            "noteId": 134
          },
          "καὶ λέγοντα ὅτι Σὺ ⸀εἶ",
          {
            "noteId": 135
          },
          "ὁ υἱὸς τοῦ θεοῦ. καὶ ἐπιτιμῶν οὐκ εἴα αὐτὰ λαλεῖν, ὅτι ᾔδεισαν τὸν χριστὸν αὐτὸν εἶναι."
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "Γενομένης δὲ ἡμέρας ἐξελθὼν ἐπορεύθη εἰς ἔρημον τόπον· καὶ οἱ ὄχλοι ἐπεζήτουν αὐτόν, καὶ ἦλθον ἕως αὐτοῦ, καὶ κατεῖχον αὐτὸν τοῦ μὴ πορεύεσθαι ἀπʼ αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "ὁ δὲ εἶπεν πρὸς αὐτοὺς ὅτι Καὶ ταῖς ἑτέραις πόλεσιν εὐαγγελίσασθαί με δεῖ τὴν βασιλείαν τοῦ θεοῦ, ὅτι ⸀ἐπὶ",
          {
            "noteId": 136
          },
          "τοῦτο ⸀ἀπεστάλην",
          {
            "noteId": 137
          }
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "καὶ ἦν κηρύσσων ⸂εἰς τὰς συναγωγὰς",
          {
            "noteId": 138
          },
          "τῆς ⸀Ἰουδαίας",
          {
            "noteId": 139
          }
        ]
      }
    ],
