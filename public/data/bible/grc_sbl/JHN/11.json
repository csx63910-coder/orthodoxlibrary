  },
  "chapter": {
    "number": 11,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἦν δέ τις ἀσθενῶν, Λάζαρος ἀπὸ Βηθανίας ἐκ τῆς κώμης Μαρίας καὶ Μάρθας τῆς ἀδελφῆς αὐτῆς."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἦν δὲ ⸀Μαριὰμ",
          {
            "noteId": 379
          },
          "ἡ ἀλείψασα τὸν κύριον μύρῳ καὶ ἐκμάξασα τοὺς πόδας αὐτοῦ ταῖς θριξὶν αὐτῆς, ἧς ὁ ἀδελφὸς Λάζαρος ἠσθένει."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἀπέστειλαν οὖν αἱ ἀδελφαὶ πρὸς αὐτὸν λέγουσαι· Κύριε, ἴδε ὃν φιλεῖς ἀσθενεῖ."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἀκούσας δὲ ὁ Ἰησοῦς εἶπεν· Αὕτη ἡ ἀσθένεια οὐκ ἔστιν πρὸς θάνατον ἀλλʼ ὑπὲρ τῆς δόξης τοῦ θεοῦ ἵνα δοξασθῇ ὁ υἱὸς τοῦ θεοῦ διʼ αὐτῆς."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἠγάπα δὲ ὁ Ἰησοῦς τὴν Μάρθαν καὶ τὴν ἀδελφὴν αὐτῆς καὶ τὸν Λάζαρον."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ὡς οὖν ἤκουσεν ὅτι ἀσθενεῖ, τότε μὲν ἔμεινεν ἐν ᾧ ἦν τόπῳ δύο ἡμέρας·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἔπειτα μετὰ τοῦτο λέγει τοῖς μαθηταῖς· Ἄγωμεν εἰς τὴν Ἰουδαίαν πάλιν."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "λέγουσιν αὐτῷ οἱ μαθηταί· Ῥαββί, νῦν ἐζήτουν σε λιθάσαι οἱ Ἰουδαῖοι, καὶ πάλιν ὑπάγεις ἐκεῖ;"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ἀπεκρίθη Ἰησοῦς· Οὐχὶ δώδεκα ⸂ὧραί εἰσιν",
          {
            "noteId": 380
          },
          "τῆς ἡμέρας; ἐάν τις περιπατῇ ἐν τῇ ἡμέρᾳ, οὐ προσκόπτει, ὅτι τὸ φῶς τοῦ κόσμου τούτου βλέπει·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἐὰν δέ τις περιπατῇ ἐν τῇ νυκτί, προσκόπτει, ὅτι τὸ φῶς οὐκ ἔστιν ἐν αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ταῦτα εἶπεν, καὶ μετὰ τοῦτο λέγει αὐτοῖς· Λάζαρος ὁ φίλος ἡμῶν κεκοίμηται, ἀλλὰ πορεύομαι ἵνα ἐξυπνίσω αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "εἶπαν οὖν οἱ μαθηταὶ ⸀αὐτῷ",
          {
            "noteId": 381
          },
          "Κύριε, εἰ κεκοίμηται σωθήσεται."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "εἰρήκει δὲ ὁ Ἰησοῦς περὶ τοῦ θανάτου αὐτοῦ. ἐκεῖνοι δὲ ἔδοξαν ὅτι περὶ τῆς κοιμήσεως τοῦ ὕπνου λέγει."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "τότε οὖν εἶπεν αὐτοῖς ὁ Ἰησοῦς παρρησίᾳ· Λάζαρος ἀπέθανεν,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ χαίρω διʼ ὑμᾶς, ἵνα πιστεύσητε, ὅτι οὐκ ἤμην ἐκεῖ· ἀλλὰ ἄγωμεν πρὸς αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "εἶπεν οὖν Θωμᾶς ὁ λεγόμενος Δίδυμος τοῖς συμμαθηταῖς· Ἄγωμεν καὶ ἡμεῖς ἵνα ἀποθάνωμεν μετʼ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Ἐλθὼν οὖν ὁ Ἰησοῦς εὗρεν αὐτὸν τέσσαρας ⸂ἤδη ἡμέρας",
          {
            "noteId": 382
          },
          "ἔχοντα ἐν τῷ μνημείῳ."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ἦν δὲ ⸀ἡ",
          {
            "noteId": 383
          },
          "Βηθανία ἐγγὺς τῶν Ἱεροσολύμων ὡς ἀπὸ σταδίων δεκαπέντε."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "⸂πολλοὶ δὲ",
          {
            "noteId": 384
          },
          "ἐκ τῶν Ἰουδαίων ἐληλύθεισαν πρὸς ⸀τὴν",
          {
            "noteId": 385
          },
          "Μάρθαν καὶ ⸀Μαριὰμ",
          {
            "noteId": 386
          },
          "ἵνα παραμυθήσωνται αὐτὰς περὶ τοῦ ⸀ἀδελφοῦ",
          {
            "noteId": 387
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἡ οὖν Μάρθα ὡς ἤκουσεν ὅτι Ἰησοῦς ἔρχεται ὑπήντησεν αὐτῷ· ⸀Μαρία",
          {
            "noteId": 388
          },
          "δὲ ἐν τῷ οἴκῳ ἐκαθέζετο."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "εἶπεν οὖν ⸀ἡ",
          {
            "noteId": 389
          },
          "Μάρθα πρὸς ⸀τὸν",
          {
            "noteId": 390
          },
          "Ἰησοῦν· Κύριε, εἰ ἦς ὧδε ⸂οὐκ ἂν ἀπέθανεν ὁ ἀδελφός μου",
          {
            "noteId": 391
          },
          "·"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "⸀καὶ",
          {
            "noteId": 392
          },
          "νῦν οἶδα ὅτι ὅσα ἂν αἰτήσῃ τὸν θεὸν δώσει σοι ὁ θεός."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "λέγει αὐτῇ ὁ Ἰησοῦς· Ἀναστήσεται ὁ ἀδελφός σου."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "λέγει αὐτῷ ⸀ἡ",
          {
            "noteId": 393
          },
          "Μάρθα· Οἶδα ὅτι ἀναστήσεται ἐν τῇ ἀναστάσει ἐν τῇ ἐσχάτῃ ἡμέρᾳ."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "εἶπεν αὐτῇ ὁ Ἰησοῦς· Ἐγώ εἰμι ἡ ἀνάστασις καὶ ἡ ζωή· ὁ πιστεύων εἰς ἐμὲ κἂν ἀποθάνῃ ζήσεται,"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "καὶ πᾶς ὁ ζῶν καὶ πιστεύων εἰς ἐμὲ οὐ μὴ ἀποθάνῃ εἰς τὸν αἰῶνα· πιστεύεις τοῦτο;"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "λέγει αὐτῷ· Ναί, κύριε· ἐγὼ πεπίστευκα ὅτι σὺ εἶ ὁ χριστὸς ὁ υἱὸς τοῦ θεοῦ ὁ εἰς τὸν κόσμον ἐρχόμενος."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Καὶ ⸀τοῦτο",
          {
            "noteId": 394
          },
          "εἰποῦσα ἀπῆλθεν καὶ ἐφώνησεν ⸀Μαριὰμ",
          {
            "noteId": 395
          },
          "τὴν ἀδελφὴν αὐτῆς λάθρᾳ εἰποῦσα· Ὁ διδάσκαλος πάρεστιν καὶ φωνεῖ σε."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "ἐκείνη ⸀δὲ",
          {
            "noteId": 396
          },
          "ὡς ἤκουσεν ⸀ἠγέρθη",
          {
            "noteId": 397
          },
          "ταχὺ καὶ ⸀ἤρχετο",
          {
            "noteId": 398
          },
          "πρὸς αὐτόν·"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "οὔπω δὲ ἐληλύθει ὁ Ἰησοῦς εἰς τὴν κώμην, ἀλλʼ ἦν ⸀ἔτι",
          {
            "noteId": 399
          },
          "ἐν τῷ τόπῳ ὅπου ὑπήντησεν αὐτῷ ἡ Μάρθα."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "οἱ οὖν Ἰουδαῖοι οἱ ὄντες μετʼ αὐτῆς ἐν τῇ οἰκίᾳ καὶ παραμυθούμενοι αὐτήν, ἰδόντες τὴν ⸀Μαριὰμ",
          {
            "noteId": 400
          },
          "ὅτι ταχέως ἀνέστη καὶ ἐξῆλθεν, ἠκολούθησαν αὐτῇ ⸀δόξαντες",
          {
            "noteId": 401
          },
          "ὅτι ὑπάγει εἰς τὸ μνημεῖον ἵνα κλαύσῃ ἐκεῖ."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "ἡ οὖν ⸀Μαριὰμ",
          {
            "noteId": 402
          },
          "ὡς ἦλθεν ὅπου ⸀ἦν",
          {
            "noteId": 403
          },
          "Ἰησοῦς ἰδοῦσα αὐτὸν ἔπεσεν αὐτοῦ ⸀πρὸς",
          {
            "noteId": 404
          },
          "τοὺς πόδας, λέγουσα αὐτῷ· Κύριε, εἰ ἦς ὧδε οὐκ ἄν ⸂μου ἀπέθανεν",
          {
            "noteId": 405
          },
          "ὁ ἀδελφός."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "Ἰησοῦς οὖν ὡς εἶδεν αὐτὴν κλαίουσαν καὶ τοὺς συνελθόντας αὐτῇ Ἰουδαίους κλαίοντας ἐνεβριμήσατο τῷ πνεύματι καὶ ἐτάραξεν ἑαυτόν,"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "καὶ εἶπεν· Ποῦ τεθείκατε αὐτόν; λέγουσιν αὐτῷ· Κύριε, ἔρχου καὶ ἴδε."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "ἐδάκρυσεν ὁ Ἰησοῦς."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "ἔλεγον οὖν οἱ Ἰουδαῖοι· Ἴδε πῶς ἐφίλει αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "τινὲς δὲ ἐξ αὐτῶν εἶπαν· Οὐκ ἐδύνατο οὗτος ὁ ἀνοίξας τοὺς ὀφθαλμοὺς τοῦ τυφλοῦ ποιῆσαι ἵνα καὶ οὗτος μὴ ἀποθάνῃ;"
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "Ἰησοῦς οὖν πάλιν ἐμβριμώμενος ἐν ἑαυτῷ ἔρχεται εἰς τὸ μνημεῖον· ἦν δὲ σπήλαιον, καὶ λίθος ἐπέκειτο ἐπʼ αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "λέγει ὁ Ἰησοῦς· Ἄρατε τὸν λίθον. λέγει αὐτῷ ἡ ἀδελφὴ τοῦ ⸀τετελευτηκότος",
          {
            "noteId": 406
          },
          "Μάρθα· Κύριε, ἤδη ὄζει, τεταρταῖος γάρ ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "λέγει αὐτῇ ὁ Ἰησοῦς· Οὐκ εἶπόν σοι ὅτι ἐὰν πιστεύσῃς ⸀ὄψῃ",
          {
            "noteId": 407
          },
          "τὴν δόξαν τοῦ θεοῦ;"
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "ἦραν οὖν τὸν ⸀λίθον",
          {
            "noteId": 408
          },
          "ὁ δὲ Ἰησοῦς ἦρεν τοὺς ὀφθαλμοὺς ἄνω καὶ εἶπεν· Πάτερ, εὐχαριστῶ σοι ὅτι ἤκουσάς μου,"
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "ἐγὼ δὲ ᾔδειν ὅτι πάντοτέ μου ἀκούεις· ἀλλὰ διὰ τὸν ὄχλον τὸν περιεστῶτα εἶπον, ἵνα πιστεύσωσιν ὅτι σύ με ἀπέστειλας."
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "καὶ ταῦτα εἰπὼν φωνῇ μεγάλῃ ἐκραύγασεν· Λάζαρε, δεῦρο ἔξω."
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "⸀ἐξῆλθεν",
          {
            "noteId": 409
          },
          "ὁ τεθνηκὼς δεδεμένος τοὺς πόδας καὶ τὰς χεῖρας κειρίαις, καὶ ἡ ὄψις αὐτοῦ σουδαρίῳ περιεδέδετο. λέγει ⸂αὐτοῖς ὁ Ἰησοῦς",
          {
            "noteId": 410
          },
          "· Λύσατε αὐτὸν",
          {
            "noteId": 411
          },
          "καὶ ἄφετε ⸀αὐτὸν ὑπάγειν."
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "Πολλοὶ οὖν ἐκ τῶν Ἰουδαίων, οἱ ἐλθόντες πρὸς τὴν ⸀Μαριὰμ",
          {
            "noteId": 412
          },
          "καὶ θεασάμενοι ⸀ἃ",
          {
            "noteId": 413
          },
          "⸀ἐποίησεν",
          {
            "noteId": 414
          },
          "ἐπίστευσαν εἰς αὐτόν·"
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "τινὲς δὲ ἐξ αὐτῶν ἀπῆλθον πρὸς τοὺς Φαρισαίους καὶ εἶπαν αὐτοῖς ἃ ⸀ἐποίησεν",
          {
            "noteId": 415
          },
          "Ἰησοῦς."
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          "συνήγαγον οὖν οἱ ἀρχιερεῖς καὶ οἱ Φαρισαῖοι συνέδριον, καὶ ἔλεγον· Τί ποιοῦμεν ὅτι οὗτος ὁ ἄνθρωπος πολλὰ ⸂ποιεῖ σημεῖα",
          {
            "noteId": 416
          },
          ";"
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          "ἐὰν ἀφῶμεν αὐτὸν οὕτως, πάντες πιστεύσουσιν εἰς αὐτόν, καὶ ἐλεύσονται οἱ Ῥωμαῖοι καὶ ἀροῦσιν ἡμῶν καὶ τὸν τόπον καὶ τὸ ἔθνος."
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          "εἷς δέ τις ἐξ αὐτῶν Καϊάφας, ἀρχιερεὺς ὢν τοῦ ἐνιαυτοῦ ἐκείνου, εἶπεν αὐτοῖς· Ὑμεῖς οὐκ οἴδατε οὐδέν,"
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          "οὐδὲ ⸀λογίζεσθε",
          {
            "noteId": 417
          },
          "ὅτι συμφέρει ⸀ὑμῖν",
          {
            "noteId": 418
          },
          "ἵνα εἷς ἄνθρωπος ἀποθάνῃ ὑπὲρ τοῦ λαοῦ καὶ μὴ ὅλον τὸ ἔθνος ἀπόληται."
        ]
      },
      {
        "type": "verse",
        "number": 51,
        "content": [
          "τοῦτο δὲ ἀφʼ ἑαυτοῦ οὐκ εἶπεν, ἀλλὰ ἀρχιερεὺς ὢν τοῦ ἐνιαυτοῦ ἐκείνου ἐπροφήτευσεν ὅτι ἔμελλεν Ἰησοῦς ἀποθνῄσκειν ὑπὲρ τοῦ ἔθνους,"
        ]
      },
      {
        "type": "verse",
        "number": 52,
        "content": [
          "καὶ οὐχ ὑπὲρ τοῦ ἔθνους μόνον, ἀλλʼ ἵνα καὶ τὰ τέκνα τοῦ θεοῦ τὰ διεσκορπισμένα συναγάγῃ εἰς ἕν."
        ]
      },
      {
        "type": "verse",
        "number": 53,
        "content": [
          "ἀπʼ ἐκείνης οὖν τῆς ἡμέρας ⸀ἐβουλεύσαντο",
          {
            "noteId": 419
          },
          "ἵνα ἀποκτείνωσιν αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 54,
        "content": [
          "⸂Ὁ οὖν Ἰησοῦς",
          {
            "noteId": 420
          },
          "οὐκέτι παρρησίᾳ περιεπάτει ἐν τοῖς Ἰουδαίοις, ἀλλὰ ἀπῆλθεν ἐκεῖθεν εἰς τὴν χώραν ἐγγὺς τῆς ἐρήμου, εἰς Ἐφραὶμ λεγομένην πόλιν, κἀκεῖ ⸀ἔμεινεν",
          {
            "noteId": 421
          },
          "μετὰ τῶν ⸀μαθητῶν",
          {
            "noteId": 422
          }
        ]
      },
      {
        "type": "verse",
        "number": 55,
        "content": [
          "Ἦν δὲ ἐγγὺς τὸ πάσχα τῶν Ἰουδαίων, καὶ ἀνέβησαν πολλοὶ εἰς Ἱεροσόλυμα ἐκ τῆς χώρας πρὸ τοῦ πάσχα ἵνα ἁγνίσωσιν ἑαυτούς."
        ]
      },
      {
        "type": "verse",
        "number": 56,
        "content": [
          "ἐζήτουν οὖν τὸν Ἰησοῦν καὶ ἔλεγον μετʼ ἀλλήλων ἐν τῷ ἱερῷ ἑστηκότες· Τί δοκεῖ ὑμῖν; ὅτι οὐ μὴ ἔλθῃ εἰς τὴν ἑορτήν;"
        ]
      },
      {
        "type": "verse",
        "number": 57,
        "content": [
          "δεδώκεισαν ⸀δὲ",
          {
            "noteId": 423
          },
          "οἱ ἀρχιερεῖς καὶ οἱ Φαρισαῖοι ⸀ἐντολὰς",
          {
            "noteId": 424
          },
