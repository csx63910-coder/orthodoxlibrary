  "chapter": {
    "number": 16,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ταῦτα λελάληκα ὑμῖν ἵνα μὴ σκανδαλισθῆτε."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἀποσυναγώγους ποιήσουσιν ὑμᾶς· ἀλλʼ ἔρχεται ὥρα ἵνα πᾶς ὁ ἀποκτείνας ὑμᾶς δόξῃ λατρείαν προσφέρειν τῷ θεῷ."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ ταῦτα ποιήσουσιν ὅτι οὐκ ἔγνωσαν τὸν πατέρα οὐδὲ ἐμέ."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἀλλὰ ταῦτα λελάληκα ὑμῖν ἵνα ὅταν ἔλθῃ ἡ ὥρα ⸀αὐτῶν",
          {
            "noteId": 569
          },
          "μνημονεύητε ⸁αὐτῶν",
          {
            "noteId": 570
          },
          "ὅτι ἐγὼ εἶπον ὑμῖν. Ταῦτα δὲ ὑμῖν ἐξ ἀρχῆς οὐκ εἶπον, ὅτι μεθʼ ὑμῶν ἤμην."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "νῦν δὲ ὑπάγω πρὸς τὸν πέμψαντά με καὶ οὐδεὶς ἐξ ὑμῶν ἐρωτᾷ με· Ποῦ ὑπάγεις;"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἀλλʼ ὅτι ταῦτα λελάληκα ὑμῖν ἡ λύπη πεπλήρωκεν ὑμῶν τὴν καρδίαν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἀλλʼ ἐγὼ τὴν ἀλήθειαν λέγω ὑμῖν, συμφέρει ὑμῖν ἵνα ἐγὼ ἀπέλθω. ἐὰν ⸀γὰρ",
          {
            "noteId": 571
          },
          "μὴ ἀπέλθω, ὁ παράκλητος ⸂οὐ μὴ ἔλθῃ",
          {
            "noteId": 572
          },
          "πρὸς ὑμᾶς· ἐὰν δὲ πορευθῶ, πέμψω αὐτὸν πρὸς ὑμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ ἐλθὼν ἐκεῖνος ἐλέγξει τὸν κόσμον περὶ ἁμαρτίας καὶ περὶ δικαιοσύνης καὶ περὶ κρίσεως·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "περὶ ἁμαρτίας μέν, ὅτι οὐ πιστεύουσιν εἰς ἐμέ·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "περὶ δικαιοσύνης δέ, ὅτι πρὸς τὸν ⸀πατέρα",
          {
            "noteId": 573
          },
          "ὑπάγω καὶ οὐκέτι θεωρεῖτέ με·"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "περὶ δὲ κρίσεως, ὅτι ὁ ἄρχων τοῦ κόσμου τούτου κέκριται."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ἔτι πολλὰ ἔχω ⸂ὑμῖν λέγειν",
          {
            "noteId": 574
          },
          ", ἀλλʼ οὐ δύνασθε βαστάζειν ἄρτι·"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ὅταν δὲ ἔλθῃ ἐκεῖνος, τὸ πνεῦμα τῆς ἀληθείας, ὁδηγήσει ὑμᾶς ⸂ἐν τῇ ἀληθείᾳ πάσῃ",
          {
            "noteId": 575
          },
          ", οὐ γὰρ λαλήσει ἀφʼ ἑαυτοῦ, ἀλλʼ ὅσα ⸀ἀκούσει",
          {
            "noteId": 576
          },
          "λαλήσει, καὶ τὰ ἐρχόμενα ἀναγγελεῖ ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἐκεῖνος ἐμὲ δοξάσει, ὅτι ἐκ τοῦ ἐμοῦ λήμψεται καὶ ἀναγγελεῖ ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "πάντα ὅσα ἔχει ὁ πατὴρ ἐμά ἐστιν· διὰ τοῦτο εἶπον ὅτι ἐκ τοῦ ἐμοῦ λαμβάνει καὶ ἀναγγελεῖ ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Μικρὸν καὶ ⸀οὐκέτι",
          {
            "noteId": 577
          },
          "θεωρεῖτέ με",
          {
            "noteId": 578
          },
          "καὶ πάλιν μικρὸν καὶ ὄψεσθέ ⸀με."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "εἶπαν οὖν ἐκ τῶν μαθητῶν αὐτοῦ πρὸς ἀλλήλους· Τί ἐστιν τοῦτο ὃ λέγει ἡμῖν· Μικρὸν καὶ οὐ θεωρεῖτέ με, καὶ πάλιν μικρὸν καὶ ὄψεσθέ με; καί· ⸀Ὅτι",
          {
            "noteId": 579
          },
          "ὑπάγω πρὸς τὸν πατέρα;"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ἔλεγον οὖν· ⸂Τί ἐστιν τοῦτο",
          {
            "noteId": 580
          },
          "ὃ ⸀λέγει",
          {
            "noteId": 581
          },
          "μικρόν; οὐκ οἴδαμεν τί λαλεῖ."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "⸀ἔγνω",
          {
            "noteId": 582
          },
          "Ἰησοῦς ὅτι ἤθελον αὐτὸν ἐρωτᾶν, καὶ εἶπεν αὐτοῖς· Περὶ τούτου ζητεῖτε μετʼ ἀλλήλων ὅτι εἶπον· Μικρὸν καὶ οὐ θεωρεῖτέ με, καὶ πάλιν μικρὸν καὶ ὄψεσθέ με;"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἀμὴν ἀμὴν λέγω ὑμῖν ὅτι κλαύσετε καὶ θρηνήσετε ὑμεῖς",
          {
            "noteId": 583
          },
          "ὁ δὲ κόσμος χαρήσεται· ⸀ὑμεῖς λυπηθήσεσθε, ἀλλʼ ἡ λύπη ὑμῶν εἰς χαρὰν γενήσεται."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ἡ γυνὴ ὅταν τίκτῃ λύπην ἔχει, ὅτι ἦλθεν ἡ ὥρα αὐτῆς· ὅταν δὲ γεννήσῃ τὸ παιδίον, οὐκέτι μνημονεύει τῆς θλίψεως διὰ τὴν χαρὰν ὅτι ἐγεννήθη ἄνθρωπος εἰς τὸν κόσμον."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "καὶ ὑμεῖς οὖν ⸂νῦν μὲν λύπην",
          {
            "noteId": 584
          },
          "ἔχετε· πάλιν δὲ ὄψομαι ὑμᾶς, καὶ χαρήσεται ὑμῶν ἡ καρδία, καὶ τὴν χαρὰν ὑμῶν οὐδεὶς ⸀αἴρει",
          {
            "noteId": 585
          },
          "ἀφʼ ὑμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "καὶ ἐν ἐκείνῃ τῇ ἡμέρᾳ ἐμὲ οὐκ ἐρωτήσετε οὐδέν· ἀμὴν ἀμὴν λέγω ὑμῖν, ⸂ἄν τι",
          {
            "noteId": 586
          },
          "αἰτήσητε τὸν πατέρα ⸂δώσει ὑμῖν ἐν τῷ ὀνόματί μου",
          {
            "noteId": 587
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ἕως ἄρτι οὐκ ᾐτήσατε οὐδὲν ἐν τῷ ὀνόματί μου· αἰτεῖτε καὶ λήμψεσθε, ἵνα ἡ χαρὰ ὑμῶν ᾖ πεπληρωμένη."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Ταῦτα ἐν παροιμίαις λελάληκα ὑμῖν· ⸀ἔρχεται",
          {
            "noteId": 588
          },
          "ὥρα ὅτε οὐκέτι ἐν παροιμίαις λαλήσω ὑμῖν ἀλλὰ παρρησίᾳ περὶ τοῦ πατρὸς ⸀ἀπαγγελῶ",
          {
            "noteId": 589
          },
          "ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ἐν ἐκείνῃ τῇ ἡμέρᾳ ἐν τῷ ὀνόματί μου αἰτήσεσθε, καὶ οὐ λέγω ὑμῖν ὅτι ἐγὼ ἐρωτήσω τὸν πατέρα περὶ ὑμῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "αὐτὸς γὰρ ὁ πατὴρ φιλεῖ ὑμᾶς, ὅτι ὑμεῖς ἐμὲ πεφιλήκατε καὶ πεπιστεύκατε ὅτι ἐγὼ παρὰ τοῦ ⸀θεοῦ",
          {
            "noteId": 590
          },
          "ἐξῆλθον."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ἐξῆλθον ⸀ἐκ",
          {
            "noteId": 591
          },
          "τοῦ πατρὸς καὶ ἐλήλυθα εἰς τὸν κόσμον· πάλιν ἀφίημι τὸν κόσμον καὶ πορεύομαι πρὸς τὸν πατέρα."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "⸀Λέγουσιν",
          {
            "noteId": 592
          },
          "οἱ μαθηταὶ αὐτοῦ· Ἴδε νῦν ⸀ἐν",
          {
            "noteId": 593
          },
          "παρρησίᾳ λαλεῖς, καὶ παροιμίαν οὐδεμίαν λέγεις."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "νῦν οἴδαμεν ὅτι οἶδας πάντα καὶ οὐ χρείαν ἔχεις ἵνα τίς σε ἐρωτᾷ· ἐν τούτῳ πιστεύομεν ὅτι ἀπὸ θεοῦ ἐξῆλθες."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "ἀπεκρίθη ⸀αὐτοῖς",
          {
            "noteId": 594
          },
          "Ἰησοῦς· Ἄρτι πιστεύετε;"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "ἰδοὺ ἔρχεται ὥρα ⸀καὶ",
          {
            "noteId": 595
          },
          "ἐλήλυθεν ἵνα σκορπισθῆτε ἕκαστος εἰς τὰ ἴδια κἀμὲ μόνον ἀφῆτε· καὶ οὐκ εἰμὶ μόνος, ὅτι ὁ πατὴρ μετʼ ἐμοῦ ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "ταῦτα λελάληκα ὑμῖν ἵνα ἐν ἐμοὶ εἰρήνην ἔχητε· ἐν τῷ κόσμῳ θλῖψιν ἔχετε, ἀλλὰ θαρσεῖτε, ἐγὼ νενίκηκα τὸν κόσμον."
        ]
      }
    ],
