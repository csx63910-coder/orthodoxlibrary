  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἦν δὲ ἄνθρωπος ἐκ τῶν Φαρισαίων, Νικόδημος ὄνομα αὐτῷ, ἄρχων τῶν Ἰουδαίων·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "οὗτος ἦλθεν πρὸς αὐτὸν νυκτὸς καὶ εἶπεν αὐτῷ· Ῥαββί, οἴδαμεν ὅτι ἀπὸ θεοῦ ἐλήλυθας διδάσκαλος· οὐδεὶς γὰρ ⸂δύναται ταῦτα τὰ σημεῖα",
          {
            "noteId": 48
          },
          "ποιεῖν ἃ σὺ ποιεῖς, ἐὰν μὴ ᾖ ὁ θεὸς μετʼ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "⸀ἀπεκρίθη",
          {
            "noteId": 49
          },
          "Ἰησοῦς καὶ εἶπεν αὐτῷ· Ἀμὴν ἀμὴν λέγω σοι, ἐὰν μή τις γεννηθῇ ἄνωθεν, οὐ δύναται ἰδεῖν τὴν βασιλείαν τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "λέγει πρὸς αὐτὸν ⸀ὁ",
          {
            "noteId": 50
          },
          "Νικόδημος· Πῶς δύναται ἄνθρωπος γεννηθῆναι γέρων ὤν; μὴ δύναται εἰς τὴν κοιλίαν τῆς μητρὸς αὐτοῦ δεύτερον εἰσελθεῖν καὶ γεννηθῆναι;"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "⸀ἀπεκρίθη",
          {
            "noteId": 51
          },
          "Ἰησοῦς· Ἀμὴν ἀμὴν λέγω σοι, ἐὰν μή τις γεννηθῇ ἐξ ὕδατος καὶ πνεύματος, οὐ δύναται εἰσελθεῖν εἰς τὴν βασιλείαν τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "τὸ γεγεννημένον ἐκ τῆς σαρκὸς σάρξ ἐστιν, καὶ τὸ γεγεννημένον ἐκ τοῦ πνεύματος πνεῦμά ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "μὴ θαυμάσῃς ὅτι εἶπόν σοι Δεῖ ὑμᾶς γεννηθῆναι ἄνωθεν."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "τὸ πνεῦμα ὅπου θέλει πνεῖ, καὶ τὴν φωνὴν αὐτοῦ ἀκούεις, ἀλλʼ οὐκ οἶδας πόθεν ἔρχεται καὶ ποῦ ὑπάγει· οὕτως ἐστὶν πᾶς ὁ γεγεννημένος ἐκ τοῦ πνεύματος."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ἀπεκρίθη Νικόδημος καὶ εἶπεν αὐτῷ· Πῶς δύναται ταῦτα γενέσθαι;"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἀπεκρίθη Ἰησοῦς καὶ εἶπεν αὐτῷ· Σὺ εἶ ὁ διδάσκαλος τοῦ Ἰσραὴλ καὶ ταῦτα οὐ γινώσκεις;"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ἀμὴν ἀμὴν λέγω σοι ὅτι ὃ οἴδαμεν λαλοῦμεν καὶ ὃ ἑωράκαμεν μαρτυροῦμεν, καὶ τὴν μαρτυρίαν ἡμῶν οὐ λαμβάνετε."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "εἰ τὰ ἐπίγεια εἶπον ὑμῖν καὶ οὐ πιστεύετε, πῶς ἐὰν εἴπω ὑμῖν τὰ ἐπουράνια πιστεύσετε;"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ οὐδεὶς ἀναβέβηκεν εἰς τὸν οὐρανὸν εἰ μὴ ὁ ἐκ τοῦ οὐρανοῦ καταβάς, ὁ υἱὸς τοῦ ⸀ἀνθρώπου",
          {
            "noteId": 52
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καὶ καθὼς Μωϋσῆς ὕψωσεν τὸν ὄφιν ἐν τῇ ἐρήμῳ, οὕτως ὑψωθῆναι δεῖ τὸν υἱὸν τοῦ ἀνθρώπου,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ἵνα πᾶς ὁ πιστεύων ⸂ἐν αὐτῷ",
          {
            "noteId": 53
          },
          "ἔχῃ ζωὴν αἰώνιον."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Οὕτως γὰρ ἠγάπησεν ὁ θεὸς τὸν κόσμον ὥστε τὸν ⸀υἱὸν",
          {
            "noteId": 54
          },
          "τὸν μονογενῆ ἔδωκεν, ἵνα πᾶς ὁ πιστεύων εἰς αὐτὸν μὴ ἀπόληται ἀλλὰ ἔχῃ ζωὴν αἰώνιον."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "οὐ γὰρ ἀπέστειλεν ὁ θεὸς τὸν ⸀υἱὸν",
          {
            "noteId": 55
          },
          "εἰς τὸν κόσμον ἵνα κρίνῃ τὸν κόσμον, ἀλλʼ ἵνα σωθῇ ὁ κόσμος διʼ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ὁ πιστεύων εἰς αὐτὸν οὐ κρίνεται· ὁ ⸀δὲ",
          {
            "noteId": 56
          },
          "μὴ πιστεύων ἤδη κέκριται, ὅτι μὴ πεπίστευκεν εἰς τὸ ὄνομα τοῦ μονογενοῦς υἱοῦ τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "αὕτη δέ ἐστιν ἡ κρίσις ὅτι τὸ φῶς ἐλήλυθεν εἰς τὸν κόσμον καὶ ἠγάπησαν οἱ ἄνθρωποι μᾶλλον τὸ σκότος ἢ τὸ φῶς, ἦν γὰρ ⸂αὐτῶν πονηρὰ",
          {
            "noteId": 57
          },
          "τὰ ἔργα."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "πᾶς γὰρ ὁ φαῦλα πράσσων μισεῖ τὸ φῶς καὶ οὐκ ἔρχεται πρὸς τὸ φῶς, ἵνα μὴ ἐλεγχθῇ τὰ ἔργα αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ὁ δὲ ποιῶν τὴν ἀλήθειαν ἔρχεται πρὸς τὸ φῶς, ἵνα φανερωθῇ αὐτοῦ τὰ ἔργα ὅτι ἐν θεῷ ἐστιν εἰργασμένα."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Μετὰ ταῦτα ἦλθεν ὁ Ἰησοῦς καὶ οἱ μαθηταὶ αὐτοῦ εἰς τὴν Ἰουδαίαν γῆν, καὶ ἐκεῖ διέτριβεν μετʼ αὐτῶν καὶ ἐβάπτιζεν."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ἦν δὲ καὶ ⸀ὁ",
          {
            "noteId": 58
          },
          "Ἰωάννης βαπτίζων ἐν Αἰνὼν ἐγγὺς τοῦ Σαλείμ, ὅτι ὕδατα πολλὰ ἦν ἐκεῖ, καὶ παρεγίνοντο καὶ ἐβαπτίζοντο·"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "οὔπω γὰρ ἦν βεβλημένος εἰς τὴν φυλακὴν ⸀ὁ",
          {
            "noteId": 59
          },
          "Ἰωάννης."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Ἐγένετο οὖν ζήτησις ἐκ τῶν μαθητῶν Ἰωάννου μετὰ Ἰουδαίου περὶ καθαρισμοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "καὶ ἦλθον πρὸς τὸν Ἰωάννην καὶ εἶπαν αὐτῷ· Ῥαββί, ὃς ἦν μετὰ σοῦ πέραν τοῦ Ἰορδάνου, ᾧ σὺ μεμαρτύρηκας, ἴδε οὗτος βαπτίζει καὶ πάντες ἔρχονται πρὸς αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "ἀπεκρίθη Ἰωάννης καὶ εἶπεν· Οὐ δύναται ἄνθρωπος λαμβάνειν ⸂οὐδὲ ἓν",
          {
            "noteId": 60
          },
          "ἐὰν μὴ ᾖ δεδομένον αὐτῷ ἐκ τοῦ οὐρανοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "αὐτοὶ ὑμεῖς ⸀μοι",
          {
            "noteId": 61
          },
          "μαρτυρεῖτε ὅτι ⸀εἶπον",
          {
            "noteId": 62
          },
          "Οὐκ εἰμὶ ἐγὼ ὁ χριστός, ἀλλʼ ὅτι Ἀπεσταλμένος εἰμὶ ἔμπροσθεν ἐκείνου."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "ὁ ἔχων τὴν νύμφην νυμφίος ἐστίν· ὁ δὲ φίλος τοῦ νυμφίου ὁ ἑστηκὼς καὶ ἀκούων αὐτοῦ, χαρᾷ χαίρει διὰ τὴν φωνὴν τοῦ νυμφίου. αὕτη οὖν ἡ χαρὰ ἡ ἐμὴ πεπλήρωται."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ἐκεῖνον δεῖ αὐξάνειν, ἐμὲ δὲ ἐλαττοῦσθαι."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "Ὁ ἄνωθεν ἐρχόμενος ἐπάνω πάντων ἐστίν. ὁ ὢν ἐκ τῆς γῆς ἐκ τῆς γῆς ἐστιν καὶ ἐκ τῆς γῆς λαλεῖ· ὁ ἐκ τοῦ οὐρανοῦ ἐρχόμενος ἐπάνω πάντων ἐστίν·"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "⸀ὃ",
          {
            "noteId": 63
          },
          "ἑώρακεν καὶ ἤκουσεν τοῦτο μαρτυρεῖ, καὶ τὴν μαρτυρίαν αὐτοῦ οὐδεὶς λαμβάνει."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "ὁ λαβὼν αὐτοῦ τὴν μαρτυρίαν ἐσφράγισεν ὅτι ὁ θεὸς ἀληθής ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "ὃν γὰρ ἀπέστειλεν ὁ θεὸς τὰ ῥήματα τοῦ θεοῦ λαλεῖ, οὐ γὰρ ἐκ μέτρου ⸀δίδωσιν",
          {
            "noteId": 64
          },
          "τὸ πνεῦμα."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "ὁ πατὴρ ἀγαπᾷ τὸν υἱόν, καὶ πάντα δέδωκεν ἐν τῇ χειρὶ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "ὁ πιστεύων εἰς τὸν υἱὸν ἔχει ζωὴν αἰώνιον· ὁ δὲ ἀπειθῶν τῷ υἱῷ οὐκ ὄψεται ζωήν, ἀλλʼ ἡ ὀργὴ τοῦ θεοῦ μένει ἐπʼ αὐτόν."
        ]
      }
    ],
