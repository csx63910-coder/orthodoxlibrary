  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Μετὰ ταῦτα ⸀ἦν",
          {
            "noteId": 104
          },
          "ἑορτὴ τῶν Ἰουδαίων, καὶ ⸀ἀνέβη",
          {
            "noteId": 105
          },
          "Ἰησοῦς εἰς Ἱεροσόλυμα."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἔστιν δὲ ἐν τοῖς Ἱεροσολύμοις ἐπὶ τῇ προβατικῇ κολυμβήθρα ἡ ἐπιλεγομένη Ἑβραϊστὶ ⸀Βηθεσδά",
          {
            "noteId": 106
          },
          "πέντε στοὰς ἔχουσα·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἐν ταύταις κατέκειτο ⸀πλῆθος",
          {
            "noteId": 107
          },
          "τῶν ἀσθενούντων, τυφλῶν, χωλῶν, ⸀ξηρῶν",
          {
            "noteId": 108
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἦν δέ τις ἄνθρωπος ἐκεῖ ⸀τριάκοντα",
          {
            "noteId": 109
          },
          "ὀκτὼ ἔτη ἔχων ἐν τῇ ἀσθενείᾳ ⸀αὐτοῦ",
          {
            "noteId": 110
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "τοῦτον ἰδὼν ὁ Ἰησοῦς κατακείμενον, καὶ γνοὺς ὅτι πολὺν ἤδη χρόνον ἔχει, λέγει αὐτῷ· Θέλεις ὑγιὴς γενέσθαι;"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἀπεκρίθη αὐτῷ ὁ ἀσθενῶν· Κύριε, ἄνθρωπον οὐκ ἔχω ἵνα ὅταν ταραχθῇ τὸ ὕδωρ βάλῃ με εἰς τὴν κολυμβήθραν· ἐν ᾧ δὲ ἔρχομαι ἐγὼ ἄλλος πρὸ ἐμοῦ καταβαίνει."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "λέγει αὐτῷ ὁ Ἰησοῦς· ⸀Ἔγειρε",
          {
            "noteId": 111
          },
          "ἆρον τὸν κράβαττόν σου καὶ περιπάτει."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ εὐθέως ἐγένετο ὑγιὴς ὁ ἄνθρωπος καὶ ἦρε τὸν κράβαττον αὐτοῦ καὶ περιεπάτει. Ἦν δὲ σάββατον ἐν ἐκείνῃ τῇ ἡμέρᾳ."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἔλεγον οὖν οἱ Ἰουδαῖοι τῷ τεθεραπευμένῳ· Σάββατόν ἐστιν, ⸀καὶ",
          {
            "noteId": 112
          },
          "οὐκ ἔξεστίν σοι ἆραι τὸν ⸀κράβαττον",
          {
            "noteId": 113
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "⸂ὃς δὲ",
          {
            "noteId": 114
          },
          "ἀπεκρίθη αὐτοῖς· Ὁ ποιήσας με ὑγιῆ ἐκεῖνός μοι εἶπεν Ἆρον τὸν κράβαττόν σου καὶ περιπάτει."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ἠρώτησαν ⸀οὖν",
          {
            "noteId": 115
          },
          "αὐτόν· Τίς ἐστιν ὁ ἄνθρωπος ὁ εἰπών σοι· ⸀Ἆρον",
          {
            "noteId": 116
          },
          "καὶ περιπάτει;"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ὁ δὲ ἰαθεὶς οὐκ ᾔδει τίς ἐστιν, ὁ γὰρ Ἰησοῦς ἐξένευσεν ὄχλου ὄντος ἐν τῷ τόπῳ."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "μετὰ ταῦτα εὑρίσκει αὐτὸν ὁ Ἰησοῦς ἐν τῷ ἱερῷ καὶ εἶπεν αὐτῷ· Ἴδε ὑγιὴς γέγονας· μηκέτι ἁμάρτανε, ἵνα μὴ χεῖρόν ⸂σοί τι",
          {
            "noteId": 117
          },
          "γένηται."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ἀπῆλθεν ὁ ἄνθρωπος καὶ ⸀ἀνήγγειλεν",
          {
            "noteId": 118
          },
          "τοῖς Ἰουδαίοις ὅτι Ἰησοῦς ἐστιν ὁ ποιήσας αὐτὸν ὑγιῆ."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ διὰ τοῦτο ἐδίωκον ⸂οἱ Ἰουδαῖοι τὸν Ἰησοῦν",
          {
            "noteId": 119
          },
          "ὅτι ταῦτα ἐποίει ἐν σαββάτῳ."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ὁ ⸀δὲ",
          {
            "noteId": 120
          },
          "ἀπεκρίνατο αὐτοῖς· Ὁ πατήρ μου ἕως ἄρτι ἐργάζεται κἀγὼ ἐργάζομαι."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "διὰ τοῦτο οὖν μᾶλλον ἐζήτουν αὐτὸν οἱ Ἰουδαῖοι ἀποκτεῖναι ὅτι οὐ μόνον ἔλυε τὸ σάββατον, ἀλλὰ καὶ πατέρα ἴδιον ἔλεγε τὸν θεόν, ἴσον ἑαυτὸν ποιῶν τῷ θεῷ."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Ἀπεκρίνατο οὖν ὁ Ἰησοῦς καὶ ⸀ἔλεγεν",
          {
            "noteId": 121
          },
          "αὐτοῖς· Ἀμὴν ἀμὴν λέγω ὑμῖν, οὐ δύναται ὁ υἱὸς ποιεῖν ἀφʼ ἑαυτοῦ οὐδὲν ⸀ἐὰν",
          {
            "noteId": 122
          },
          "μή τι βλέπῃ τὸν πατέρα ποιοῦντα· ἃ γὰρ ἂν ἐκεῖνος ποιῇ, ταῦτα καὶ ὁ υἱὸς ὁμοίως ποιεῖ."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ὁ γὰρ πατὴρ φιλεῖ τὸν υἱὸν καὶ πάντα δείκνυσιν αὐτῷ ἃ αὐτὸς ποιεῖ, καὶ μείζονα τούτων δείξει αὐτῷ ἔργα, ἵνα ὑμεῖς θαυμάζητε."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ὥσπερ γὰρ ὁ πατὴρ ἐγείρει τοὺς νεκροὺς καὶ ζῳοποιεῖ, οὕτως καὶ ὁ υἱὸς οὓς θέλει ζῳοποιεῖ."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "οὐδὲ γὰρ ὁ πατὴρ κρίνει οὐδένα, ἀλλὰ τὴν κρίσιν πᾶσαν δέδωκεν τῷ υἱῷ,"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ἵνα πάντες τιμῶσι τὸν υἱὸν καθὼς τιμῶσι τὸν πατέρα. ὁ μὴ τιμῶν τὸν υἱὸν οὐ τιμᾷ τὸν πατέρα τὸν πέμψαντα αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Ἀμὴν ἀμὴν λέγω ὑμῖν ὅτι ὁ τὸν λόγον μου ἀκούων καὶ πιστεύων τῷ πέμψαντί με ἔχει ζωὴν αἰώνιον, καὶ εἰς κρίσιν οὐκ ἔρχεται ἀλλὰ μεταβέβηκεν ἐκ τοῦ θανάτου εἰς τὴν ζωήν."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Ἀμὴν ἀμὴν λέγω ὑμῖν ὅτι ἔρχεται ὥρα καὶ νῦν ἐστιν ὅτε οἱ νεκροὶ ⸀ἀκούσουσιν",
          {
            "noteId": 123
          },
          "τῆς φωνῆς τοῦ υἱοῦ τοῦ θεοῦ καὶ οἱ ἀκούσαντες ⸀ζήσουσιν",
          {
            "noteId": 124
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ὥσπερ γὰρ ὁ πατὴρ ἔχει ζωὴν ἐν ἑαυτῷ, οὕτως ⸂καὶ τῷ υἱῷ ἔδωκεν",
          {
            "noteId": 125
          },
          "ζωὴν ἔχειν ἐν ἑαυτῷ·"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "καὶ ἐξουσίαν ἔδωκεν ⸀αὐτῷ",
          {
            "noteId": 126
          },
          "κρίσιν ποιεῖν, ὅτι υἱὸς ἀνθρώπου ἐστίν."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "μὴ θαυμάζετε τοῦτο, ὅτι ἔρχεται ὥρα ἐν ᾗ πάντες οἱ ἐν τοῖς μνημείοις ⸀ἀκούσουσιν",
          {
            "noteId": 127
          },
          "τῆς φωνῆς αὐτοῦ"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "καὶ ἐκπορεύσονται οἱ τὰ ἀγαθὰ ποιήσαντες εἰς ἀνάστασιν ζωῆς, οἱ ⸀δὲ",
          {
            "noteId": 128
          },
          "τὰ φαῦλα πράξαντες εἰς ἀνάστασιν κρίσεως."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Οὐ δύναμαι ἐγὼ ποιεῖν ἀπʼ ἐμαυτοῦ οὐδέν· καθὼς ἀκούω κρίνω, καὶ ἡ κρίσις ἡ ἐμὴ δικαία ἐστίν, ὅτι οὐ ζητῶ τὸ θέλημα τὸ ἐμὸν ἀλλὰ τὸ θέλημα τοῦ πέμψαντός ⸀με",
          {
            "noteId": 129
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "Ἐὰν ἐγὼ μαρτυρῶ περὶ ἐμαυτοῦ, ἡ μαρτυρία μου οὐκ ἔστιν ἀληθής·"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "ἄλλος ἐστὶν ὁ μαρτυρῶν περὶ ἐμοῦ, καὶ οἶδα ὅτι ἀληθής ἐστιν ἡ μαρτυρία ἣν μαρτυρεῖ περὶ ἐμοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "ὑμεῖς ἀπεστάλκατε πρὸς Ἰωάννην, καὶ μεμαρτύρηκε τῇ ἀληθείᾳ·"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "ἐγὼ δὲ οὐ παρὰ ἀνθρώπου τὴν μαρτυρίαν λαμβάνω, ἀλλὰ ταῦτα λέγω ἵνα ὑμεῖς σωθῆτε."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "ἐκεῖνος ἦν ὁ λύχνος ὁ καιόμενος καὶ φαίνων, ὑμεῖς δὲ ἠθελήσατε ἀγαλλιαθῆναι πρὸς ὥραν ἐν τῷ φωτὶ αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "ἐγὼ δὲ ἔχω τὴν μαρτυρίαν ⸀μείζω",
          {
            "noteId": 130
          },
          "τοῦ Ἰωάννου, τὰ γὰρ ἔργα ἃ ⸀δέδωκέν",
          {
            "noteId": 131
          },
          "μοι ὁ πατὴρ ἵνα τελειώσω αὐτά, αὐτὰ τὰ ἔργα ⸀ἃ",
          {
            "noteId": 132
          },
          "ποιῶ, μαρτυρεῖ περὶ ἐμοῦ ὅτι ὁ πατήρ με ἀπέσταλκεν,"
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "καὶ ὁ πέμψας με πατὴρ ⸀ἐκεῖνος",
          {
            "noteId": 133
          },
          "μεμαρτύρηκεν περὶ ἐμοῦ. οὔτε φωνὴν αὐτοῦ ⸂πώποτε ἀκηκόατε",
          {
            "noteId": 134
          },
          "οὔτε εἶδος αὐτοῦ ἑωράκατε,"
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "καὶ τὸν λόγον αὐτοῦ οὐκ ἔχετε ⸂ἐν ὑμῖν μένοντα",
          {
            "noteId": 135
          },
          ", ὅτι ὃν ἀπέστειλεν ἐκεῖνος τούτῳ ὑμεῖς οὐ πιστεύετε."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "Ἐραυνᾶτε τὰς γραφάς, ὅτι ὑμεῖς δοκεῖτε ἐν αὐταῖς ζωὴν αἰώνιον ἔχειν· καὶ ἐκεῖναί εἰσιν αἱ μαρτυροῦσαι περὶ ἐμοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "καὶ οὐ θέλετε ἐλθεῖν πρός με ἵνα ζωὴν ἔχητε."
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "δόξαν παρὰ ἀνθρώπων οὐ λαμβάνω,"
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "ἀλλὰ ἔγνωκα ὑμᾶς ὅτι τὴν ἀγάπην τοῦ θεοῦ οὐκ ἔχετε ἐν ἑαυτοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "ἐγὼ ἐλήλυθα ἐν τῷ ὀνόματι τοῦ πατρός μου καὶ οὐ λαμβάνετέ με· ἐὰν ἄλλος ἔλθῃ ἐν τῷ ὀνόματι τῷ ἰδίῳ, ἐκεῖνον λήμψεσθε."
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "πῶς δύνασθε ὑμεῖς πιστεῦσαι, δόξαν παρʼ ἀλλήλων λαμβάνοντες, καὶ τὴν δόξαν τὴν παρὰ τοῦ μόνου θεοῦ οὐ ζητεῖτε;"
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "μὴ δοκεῖτε ὅτι ἐγὼ κατηγορήσω ὑμῶν πρὸς τὸν πατέρα· ἔστιν ὁ κατηγορῶν ὑμῶν Μωϋσῆς, εἰς ὃν ὑμεῖς ἠλπίκατε."
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "εἰ γὰρ ἐπιστεύετε Μωϋσεῖ, ἐπιστεύετε ἂν ἐμοί, περὶ γὰρ ἐμοῦ ἐκεῖνος ἔγραψεν."
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          "εἰ δὲ τοῖς ἐκείνου γράμμασιν οὐ πιστεύετε, πῶς τοῖς ἐμοῖς ῥήμασιν πιστεύσετε;"
        ]
      }
    ],
