  },
  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ὡς οὖν ἔγνω ὁ ⸀Ἰησοῦς",
          {
            "noteId": 65
          },
          "ὅτι ἤκουσαν οἱ Φαρισαῖοι ὅτι Ἰησοῦς πλείονας μαθητὰς ποιεῖ καὶ βαπτίζει ἢ Ἰωάννης—"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καίτοιγε Ἰησοῦς αὐτὸς οὐκ ἐβάπτιζεν ἀλλʼ οἱ μαθηταὶ αὐτοῦ—"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἀφῆκεν τὴν Ἰουδαίαν καὶ ἀπῆλθεν ⸀πάλιν",
          {
            "noteId": 66
          },
          "εἰς τὴν Γαλιλαίαν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἔδει δὲ αὐτὸν διέρχεσθαι διὰ τῆς Σαμαρείας."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἔρχεται οὖν εἰς πόλιν τῆς Σαμαρείας λεγομένην Συχὰρ πλησίον τοῦ χωρίου ὃ ἔδωκεν Ἰακὼβ ⸀τῷ",
          {
            "noteId": 67
          },
          "Ἰωσὴφ τῷ υἱῷ αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἦν δὲ ἐκεῖ πηγὴ τοῦ Ἰακώβ. ὁ οὖν Ἰησοῦς κεκοπιακὼς ἐκ τῆς ὁδοιπορίας ἐκαθέζετο οὕτως ἐπὶ τῇ πηγῇ· ὥρα ἦν ⸀ὡς",
          {
            "noteId": 68
          },
          "ἕκτη."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ἔρχεται γυνὴ ἐκ τῆς Σαμαρείας ἀντλῆσαι ὕδωρ. λέγει αὐτῇ ὁ Ἰησοῦς· Δός μοι πεῖν·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "οἱ γὰρ μαθηταὶ αὐτοῦ ἀπεληλύθεισαν εἰς τὴν πόλιν, ἵνα τροφὰς ἀγοράσωσιν."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "λέγει οὖν αὐτῷ ἡ γυνὴ ἡ Σαμαρῖτις· Πῶς σὺ Ἰουδαῖος ὢν παρʼ ἐμοῦ πεῖν αἰτεῖς ⸂γυναικὸς Σαμαρίτιδος οὔσης",
          {
            "noteId": 69
          },
          "; οὐ γὰρ συγχρῶνται Ἰουδαῖοι Σαμαρίταις."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἀπεκρίθη Ἰησοῦς καὶ εἶπεν αὐτῇ· Εἰ ᾔδεις τὴν δωρεὰν τοῦ θεοῦ καὶ τίς ἐστιν ὁ λέγων σοι· Δός μοι πεῖν, σὺ ἂν ᾔτησας αὐτὸν καὶ ἔδωκεν ἄν σοι ὕδωρ ζῶν."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "λέγει αὐτῷ ⸂ἡ γυνή",
          {
            "noteId": 70
          },
          "· Κύριε, οὔτε ἄντλημα ἔχεις καὶ τὸ φρέαρ ἐστὶν βαθύ· πόθεν οὖν ἔχεις τὸ ὕδωρ τὸ ζῶν;"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "μὴ σὺ μείζων εἶ τοῦ πατρὸς ἡμῶν Ἰακώβ, ὃς ἔδωκεν ἡμῖν τὸ φρέαρ καὶ αὐτὸς ἐξ αὐτοῦ ἔπιεν καὶ οἱ υἱοὶ αὐτοῦ καὶ τὰ θρέμματα αὐτοῦ;"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ἀπεκρίθη Ἰησοῦς καὶ εἶπεν αὐτῇ· Πᾶς ὁ πίνων ἐκ τοῦ ὕδατος τούτου διψήσει πάλιν·"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ὃς δʼ ἂν πίῃ ἐκ τοῦ ὕδατος οὗ ἐγὼ δώσω αὐτῷ, οὐ μὴ ⸀διψήσει",
          {
            "noteId": 71
          },
          "εἰς τὸν αἰῶνα, ἀλλὰ τὸ ὕδωρ ὃ δώσω αὐτῷ γενήσεται ἐν αὐτῷ πηγὴ ὕδατος ἁλλομένου εἰς ζωὴν αἰώνιον."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "λέγει πρὸς αὐτὸν ἡ γυνή· Κύριε, δός μοι τοῦτο τὸ ὕδωρ, ἵνα μὴ διψῶ μηδὲ ⸀διέρχωμαι",
          {
            "noteId": 72
          },
          "ἐνθάδε ἀντλεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Λέγει ⸀αὐτῇ",
          {
            "noteId": 73
          },
          "Ὕπαγε φώνησον ⸂τὸν ἄνδρα σου",
          {
            "noteId": 74
          },
          "καὶ ἐλθὲ ἐνθάδε."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ἀπεκρίθη ἡ γυνὴ καὶ εἶπεν ⸀αὐτῷ",
          {
            "noteId": 75
          },
          "Οὐκ ἔχω ἄνδρα. λέγει αὐτῇ ὁ Ἰησοῦς· Καλῶς εἶπας ὅτι Ἄνδρα οὐκ ἔχω·"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "πέντε γὰρ ἄνδρας ἔσχες, καὶ νῦν ὃν ἔχεις οὐκ ἔστιν σου ἀνήρ· τοῦτο ἀληθὲς εἴρηκας."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "λέγει αὐτῷ ἡ γυνή· Κύριε, θεωρῶ ὅτι προφήτης εἶ σύ."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "οἱ πατέρες ἡμῶν ἐν τῷ ὄρει τούτῳ προσεκύνησαν· καὶ ὑμεῖς λέγετε ὅτι ἐν Ἱεροσολύμοις ἐστὶν ὁ τόπος ὅπου ⸂προσκυνεῖν δεῖ",
          {
            "noteId": 76
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "λέγει αὐτῇ ὁ Ἰησοῦς· ⸂Πίστευέ μοι, γύναι",
          {
            "noteId": 77
          },
          ", ὅτι ἔρχεται ὥρα ὅτε οὔτε ἐν τῷ ὄρει τούτῳ οὔτε ἐν Ἱεροσολύμοις προσκυνήσετε τῷ πατρί."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ὑμεῖς προσκυνεῖτε ὃ οὐκ οἴδατε, ἡμεῖς προσκυνοῦμεν ὃ οἴδαμεν, ὅτι ἡ σωτηρία ἐκ τῶν Ἰουδαίων ἐστίν·"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ἀλλὰ ἔρχεται ὥρα καὶ νῦν ἐστιν, ὅτε οἱ ἀληθινοὶ προσκυνηταὶ προσκυνήσουσιν τῷ πατρὶ ἐν πνεύματι καὶ ἀληθείᾳ, καὶ γὰρ ὁ πατὴρ τοιούτους ζητεῖ τοὺς προσκυνοῦντας αὐτόν·"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "πνεῦμα ὁ θεός, καὶ τοὺς προσκυνοῦντας αὐτὸν ἐν πνεύματι καὶ ἀληθείᾳ δεῖ προσκυνεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "λέγει αὐτῷ ἡ γυνή· Οἶδα ὅτι Μεσσίας ἔρχεται, ὁ λεγόμενος χριστός· ὅταν ἔλθῃ ἐκεῖνος, ἀναγγελεῖ ἡμῖν ⸀ἅπαντα",
          {
            "noteId": 78
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "λέγει αὐτῇ ὁ Ἰησοῦς· Ἐγώ εἰμι, ὁ λαλῶν σοι."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Καὶ ἐπὶ τούτῳ ἦλθαν οἱ μαθηταὶ αὐτοῦ, καὶ ⸀ἐθαύμαζον",
          {
            "noteId": 79
          },
          "ὅτι μετὰ γυναικὸς ἐλάλει· οὐδεὶς μέντοι εἶπεν· Τί ζητεῖς; ἢ τί λαλεῖς μετʼ αὐτῆς;"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ἀφῆκεν οὖν τὴν ὑδρίαν αὐτῆς ἡ γυνὴ καὶ ἀπῆλθεν εἰς τὴν πόλιν καὶ λέγει τοῖς ἀνθρώποις·"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Δεῦτε ἴδετε ἄνθρωπον ὃς εἶπέ μοι πάντα ⸀ὅσα",
          {
            "noteId": 80
          },
          "ἐποίησα· μήτι οὗτός ἐστιν ὁ χριστός;"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ἐξῆλθον ἐκ τῆς πόλεως καὶ ἤρχοντο πρὸς αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "⸀Ἐν",
          {
            "noteId": 81
          },
          "τῷ μεταξὺ ἠρώτων αὐτὸν οἱ μαθηταὶ λέγοντες· Ῥαββί, φάγε."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "ὁ δὲ εἶπεν αὐτοῖς· Ἐγὼ βρῶσιν ἔχω φαγεῖν ἣν ὑμεῖς οὐκ οἴδατε."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "ἔλεγον οὖν οἱ μαθηταὶ πρὸς ἀλλήλους· Μή τις ἤνεγκεν αὐτῷ φαγεῖν;"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "λέγει αὐτοῖς ὁ Ἰησοῦς· Ἐμὸν βρῶμά ἐστιν ἵνα ⸀ποιήσω",
          {
            "noteId": 82
          },
          "τὸ θέλημα τοῦ πέμψαντός με καὶ τελειώσω αὐτοῦ τὸ ἔργον."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "οὐχ ὑμεῖς λέγετε ὅτι Ἔτι τετράμηνός ἐστιν καὶ ὁ θερισμὸς ἔρχεται; ἰδοὺ λέγω ὑμῖν, ἐπάρατε τοὺς ὀφθαλμοὺς ὑμῶν καὶ θεάσασθε τὰς χώρας ὅτι λευκαί εἰσιν πρὸς θερισμόν· ἤδη"
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "⸀ὁ",
          {
            "noteId": 83
          },
          "θερίζων μισθὸν λαμβάνει καὶ συνάγει καρπὸν εἰς ζωὴν αἰώνιον, ⸀ἵνα",
          {
            "noteId": 84
          },
          "ὁ σπείρων ὁμοῦ χαίρῃ καὶ ὁ θερίζων."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "ἐν γὰρ τούτῳ ὁ λόγος ⸀ἐστὶν",
          {
            "noteId": 85
          },
          "ἀληθινὸς ὅτι Ἄλλος ἐστὶν ὁ σπείρων καὶ ἄλλος ὁ θερίζων·"
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "ἐγὼ ἀπέστειλα ὑμᾶς θερίζειν ὃ οὐχ ὑμεῖς κεκοπιάκατε· ἄλλοι κεκοπιάκασιν, καὶ ὑμεῖς εἰς τὸν κόπον αὐτῶν εἰσεληλύθατε."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "Ἐκ δὲ τῆς πόλεως ἐκείνης πολλοὶ ἐπίστευσαν εἰς αὐτὸν τῶν Σαμαριτῶν διὰ τὸν λόγον τῆς γυναικὸς μαρτυρούσης ὅτι Εἶπέν μοι πάντα ⸀ἃ",
          {
            "noteId": 86
          },
          "ἐποίησα."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "ὡς οὖν ἦλθον πρὸς αὐτὸν οἱ Σαμαρῖται, ἠρώτων αὐτὸν μεῖναι παρʼ αὐτοῖς· καὶ ἔμεινεν ἐκεῖ δύο ἡμέρας."
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "καὶ πολλῷ πλείους ἐπίστευσαν διὰ τὸν λόγον αὐτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "τῇ τε γυναικὶ ἔλεγον ὅτι Οὐκέτι διὰ τὴν σὴν λαλιὰν πιστεύομεν· αὐτοὶ γὰρ ἀκηκόαμεν, καὶ οἴδαμεν ὅτι οὗτός ἐστιν ἀληθῶς ὁ σωτὴρ τοῦ ⸀κόσμου",
          {
            "noteId": 87
          }
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "Μετὰ δὲ τὰς δύο ἡμέρας ἐξῆλθεν ⸀ἐκεῖθεν",
          {
            "noteId": 88
          },
          "εἰς τὴν Γαλιλαίαν·"
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "αὐτὸς ⸀γὰρ",
          {
            "noteId": 89
          },
          "Ἰησοῦς ἐμαρτύρησεν ὅτι προφήτης ἐν τῇ ἰδίᾳ πατρίδι τιμὴν οὐκ ἔχει."
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "ὅτε οὖν ἦλθεν εἰς τὴν Γαλιλαίαν, ἐδέξαντο αὐτὸν οἱ Γαλιλαῖοι, πάντα ἑωρακότες ⸀ὅσα",
          {
            "noteId": 90
          },
          "ἐποίησεν ἐν Ἱεροσολύμοις ἐν τῇ ἑορτῇ, καὶ αὐτοὶ γὰρ ἦλθον εἰς τὴν ἑορτήν."
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "Ἦλθεν οὖν ⸀πάλιν",
          {
            "noteId": 91
          },
          "εἰς τὴν Κανὰ τῆς Γαλιλαίας, ὅπου ἐποίησεν τὸ ὕδωρ οἶνον. καὶ ἦν τις βασιλικὸς οὗ ὁ υἱὸς ἠσθένει ἐν Καφαρναούμ."
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          "οὗτος ἀκούσας ὅτι Ἰησοῦς ἥκει ἐκ τῆς Ἰουδαίας εἰς τὴν Γαλιλαίαν ἀπῆλθεν πρὸς αὐτὸν καὶ ⸀ἠρώτα",
          {
            "noteId": 92
          },
          "ἵνα καταβῇ καὶ ἰάσηται αὐτοῦ τὸν υἱόν, ἤμελλεν γὰρ ἀποθνῄσκειν."
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          "εἶπεν οὖν ὁ Ἰησοῦς πρὸς αὐτόν· Ἐὰν μὴ σημεῖα καὶ τέρατα ἴδητε, οὐ μὴ πιστεύσητε."
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          "λέγει πρὸς αὐτὸν ὁ βασιλικός· Κύριε, κατάβηθι πρὶν ἀποθανεῖν τὸ παιδίον μου."
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          "λέγει αὐτῷ ὁ Ἰησοῦς· Πορεύου· ὁ υἱός σου ζῇ. ⸀ἐπίστευσεν",
          {
            "noteId": 93
          },
          "ὁ ἄνθρωπος τῷ λόγῳ ⸀ὃν",
          {
            "noteId": 94
          },
          "εἶπεν αὐτῷ ὁ Ἰησοῦς καὶ ἐπορεύετο."
        ]
      },
      {
        "type": "verse",
        "number": 51,
        "content": [
          "ἤδη δὲ αὐτοῦ καταβαίνοντος οἱ δοῦλοι αὐτοῦ ⸀ὑπήντησαν",
          {
            "noteId": 95
          },
          "⸀αὐτῷ",
          {
            "noteId": 96
          },
          "λέγοντες ὅτι ὁ παῖς ⸀αὐτοῦ",
          {
            "noteId": 97
          },
          "ζῇ."
        ]
      },
      {
        "type": "verse",
        "number": 52,
        "content": [
          "ἐπύθετο οὖν ⸂τὴν ὥραν παρʼ αὐτῶν",
          {
            "noteId": 98
          },
          "ἐν ᾗ κομψότερον ἔσχεν· ⸂εἶπαν οὖν",
          {
            "noteId": 99
          },
          "αὐτῷ ὅτι ⸀Ἐχθὲς",
          {
            "noteId": 100
          },
          "ὥραν ἑβδόμην ἀφῆκεν αὐτὸν ὁ πυρετός."
        ]
      },
      {
        "type": "verse",
        "number": 53,
        "content": [
          "ἔγνω οὖν ὁ πατὴρ ⸀ὅτι",
          {
            "noteId": 101
          },
          "ἐκείνῃ τῇ ὥρᾳ ἐν ᾗ εἶπεν αὐτῷ ὁ ⸀Ἰησοῦς",
          {
            "noteId": 102
          },
          "Ὁ υἱός σου ζῇ, καὶ ἐπίστευσεν αὐτὸς καὶ ἡ οἰκία αὐτοῦ ὅλη."
        ]
      },
      {
        "type": "verse",
        "number": 54,
        "content": [
          "τοῦτο ⸀δὲ",
          {
            "noteId": 103
          },
          "πάλιν δεύτερον σημεῖον ἐποίησεν ὁ Ἰησοῦς ἐλθὼν ἐκ τῆς Ἰουδαίας εἰς τὴν Γαλιλαίαν."
        ]
      }
    ],
