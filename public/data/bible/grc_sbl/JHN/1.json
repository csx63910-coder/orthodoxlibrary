  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἐν ἀρχῇ ἦν ὁ λόγος, καὶ ὁ λόγος ἦν πρὸς τὸν θεόν, καὶ θεὸς ἦν ὁ λόγος."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "οὗτος ἦν ἐν ἀρχῇ πρὸς τὸν θεόν."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "πάντα διʼ αὐτοῦ ἐγένετο, καὶ χωρὶς αὐτοῦ ἐγένετο οὐδὲ ἕν. ὃ γέγονεν"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἐν αὐτῷ ζωὴ ἦν, καὶ ἡ ζωὴ ἦν τὸ φῶς τῶν ἀνθρώπων·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ τὸ φῶς ἐν τῇ σκοτίᾳ φαίνει, καὶ ἡ σκοτία αὐτὸ οὐ κατέλαβεν."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ἐγένετο ἄνθρωπος ἀπεσταλμένος παρὰ θεοῦ, ὄνομα αὐτῷ Ἰωάννης·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "οὗτος ἦλθεν εἰς μαρτυρίαν, ἵνα μαρτυρήσῃ περὶ τοῦ φωτός, ἵνα πάντες πιστεύσωσιν διʼ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "οὐκ ἦν ἐκεῖνος τὸ φῶς, ἀλλʼ ἵνα μαρτυρήσῃ περὶ τοῦ φωτός."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ἦν τὸ φῶς τὸ ἀληθινὸν ὃ φωτίζει πάντα ἄνθρωπον ἐρχόμενον εἰς τὸν κόσμον."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Ἐν τῷ κόσμῳ ἦν, καὶ ὁ κόσμος διʼ αὐτοῦ ἐγένετο, καὶ ὁ κόσμος αὐτὸν οὐκ ἔγνω."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "εἰς τὰ ἴδια ἦλθεν, καὶ οἱ ἴδιοι αὐτὸν οὐ παρέλαβον."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ὅσοι δὲ ἔλαβον αὐτόν, ἔδωκεν αὐτοῖς ἐξουσίαν τέκνα θεοῦ γενέσθαι, τοῖς πιστεύουσιν εἰς τὸ ὄνομα αὐτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "οἳ οὐκ ἐξ αἱμάτων οὐδὲ ἐκ θελήματος σαρκὸς οὐδὲ ἐκ θελήματος ἀνδρὸς ἀλλʼ ἐκ θεοῦ ἐγεννήθησαν."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Καὶ ὁ λόγος σὰρξ ἐγένετο καὶ ἐσκήνωσεν ἐν ἡμῖν, καὶ ἐθεασάμεθα τὴν δόξαν αὐτοῦ, δόξαν ὡς μονογενοῦς παρὰ πατρός, πλήρης χάριτος καὶ ἀληθείας·"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "(Ἰωάννης μαρτυρεῖ περὶ αὐτοῦ καὶ κέκραγεν λέγων· Οὗτος ἦν ⸂ὃν εἶπον",
          {
            "noteId": 0
          },
          "· Ὁ ὀπίσω μου ἐρχόμενος ἔμπροσθέν μου γέγονεν, ὅτι πρῶτός μου ἦν·)"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "⸀ὅτι",
          {
            "noteId": 1
          },
          "ἐκ τοῦ πληρώματος αὐτοῦ ἡμεῖς πάντες ἐλάβομεν, καὶ χάριν ἀντὶ χάριτος·"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ὅτι ὁ νόμος διὰ Μωϋσέως ἐδόθη, ἡ χάρις καὶ ἡ ἀλήθεια διὰ Ἰησοῦ Χριστοῦ ἐγένετο."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "θεὸν οὐδεὶς ἑώρακεν πώποτε· ⸂μονογενὴς θεὸς",
          {
            "noteId": 2
          },
          "ὁ ὢν εἰς τὸν κόλπον τοῦ πατρὸς ἐκεῖνος ἐξηγήσατο."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Καὶ αὕτη ἐστὶν ἡ μαρτυρία τοῦ Ἰωάννου ὅτε ⸀ἀπέστειλαν",
          {
            "noteId": 3
          },
          "οἱ Ἰουδαῖοι ἐξ Ἱεροσολύμων ἱερεῖς καὶ Λευίτας ἵνα ἐρωτήσωσιν αὐτόν· Σὺ τίς εἶ;"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "καὶ ὡμολόγησεν καὶ οὐκ ἠρνήσατο, καὶ ὡμολόγησεν ὅτι ⸂Ἐγὼ οὐκ εἰμὶ",
          {
            "noteId": 4
          },
          "ὁ χριστός."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "καὶ ἠρώτησαν αὐτόν· Τί οὖν; ⸂σὺ Ἠλίας εἶ",
          {
            "noteId": 5
          },
          "; καὶ λέγει· Οὐκ εἰμί. Ὁ προφήτης εἶ σύ; καὶ ἀπεκρίθη· Οὔ."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "εἶπαν οὖν αὐτῷ· Τίς εἶ; ἵνα ἀπόκρισιν δῶμεν τοῖς πέμψασιν ἡμᾶς· τί λέγεις περὶ σεαυτοῦ;"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ἔφη· Ἐγὼ φωνὴ βοῶντος ἐν τῇ ἐρήμῳ· Εὐθύνατε τὴν ὁδὸν κυρίου, καθὼς εἶπεν Ἠσαΐας ὁ προφήτης."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "⸀Καὶ",
          {
            "noteId": 6
          },
          "ἀπεσταλμένοι ἦσαν ἐκ τῶν Φαρισαίων."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "καὶ ἠρώτησαν αὐτὸν καὶ εἶπαν αὐτῷ· Τί οὖν βαπτίζεις εἰ σὺ οὐκ εἶ ὁ χριστὸς ⸂οὐδὲ Ἠλίας οὐδὲ",
          {
            "noteId": 7
          },
          "ὁ προφήτης;"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ἀπεκρίθη αὐτοῖς ὁ Ἰωάννης λέγων· Ἐγὼ βαπτίζω ἐν ὕδατι· ⸀μέσος",
          {
            "noteId": 8
          },
          "ὑμῶν ⸀ἕστηκεν",
          {
            "noteId": 9
          },
          "ὃν ὑμεῖς οὐκ οἴδατε,"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "⸀ὁ",
          {
            "noteId": 10
          },
          "ὀπίσω μου ⸀ἐρχόμενος",
          {
            "noteId": 11
          },
          "οὗ ⸂οὐκ εἰμὶ",
          {
            "noteId": 12
          },
          "ἄξιος ἵνα λύσω αὐτοῦ τὸν ἱμάντα τοῦ ὑποδήματος."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ταῦτα ἐν Βηθανίᾳ ἐγένετο πέραν τοῦ Ἰορδάνου, ὅπου ἦν ⸀ὁ",
          {
            "noteId": 13
          },
          "Ἰωάννης βαπτίζων."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Τῇ ἐπαύριον βλέπει τὸν Ἰησοῦν ἐρχόμενον πρὸς αὐτόν, καὶ λέγει· Ἴδε ὁ ἀμνὸς τοῦ θεοῦ ὁ αἴρων τὴν ἁμαρτίαν τοῦ κόσμου."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "οὗτός ἐστιν ⸀ὑπὲρ",
          {
            "noteId": 14
          },
          "οὗ ἐγὼ εἶπον· Ὀπίσω μου ἔρχεται ἀνὴρ ὃς ἔμπροσθέν μου γέγονεν, ὅτι πρῶτός μου ἦν·"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "κἀγὼ οὐκ ᾔδειν αὐτόν, ἀλλʼ ἵνα φανερωθῇ τῷ Ἰσραὴλ διὰ τοῦτο ἦλθον ἐγὼ ⸀ἐν",
          {
            "noteId": 15
          },
          "ὕδατι βαπτίζων."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "καὶ ἐμαρτύρησεν Ἰωάννης λέγων ὅτι Τεθέαμαι τὸ πνεῦμα καταβαῖνον ⸀ὡς",
          {
            "noteId": 16
          },
          "περιστερὰν ἐξ οὐρανοῦ, καὶ ἔμεινεν ἐπʼ αὐτόν·"
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "κἀγὼ οὐκ ᾔδειν αὐτόν, ἀλλʼ ὁ πέμψας με βαπτίζειν ἐν ὕδατι ἐκεῖνός μοι εἶπεν· Ἐφʼ ὃν ἂν ἴδῃς τὸ πνεῦμα καταβαῖνον καὶ μένον ἐπʼ αὐτόν, οὗτός ἐστιν ὁ βαπτίζων ἐν πνεύματι ἁγίῳ·"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "κἀγὼ ἑώρακα, καὶ μεμαρτύρηκα ὅτι οὗτός ἐστιν ὁ ⸀ἐκλεκτὸς",
          {
            "noteId": 17
          },
          "τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "Τῇ ἐπαύριον πάλιν εἱστήκει ⸀ὁ",
          {
            "noteId": 18
          },
          "Ἰωάννης καὶ ἐκ τῶν μαθητῶν αὐτοῦ δύο,"
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "καὶ ἐμβλέψας τῷ Ἰησοῦ περιπατοῦντι λέγει· Ἴδε ὁ ἀμνὸς τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "καὶ ἤκουσαν ⸂οἱ δύο μαθηταὶ αὐτοῦ",
          {
            "noteId": 19
          },
          "λαλοῦντος καὶ ἠκολούθησαν τῷ Ἰησοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "στραφεὶς δὲ ὁ Ἰησοῦς καὶ θεασάμενος αὐτοὺς ἀκολουθοῦντας λέγει αὐτοῖς· Τί ζητεῖτε; οἱ δὲ εἶπαν αὐτῷ· Ῥαββί (ὃ λέγεται ⸀μεθερμηνευόμενον",
          {
            "noteId": 20
          },
          "Διδάσκαλε), ποῦ μένεις;"
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "λέγει αὐτοῖς· Ἔρχεσθε καὶ ⸂ὄψεσθε. ἦλθαν οὖν",
          {
            "noteId": 21
          },
          "καὶ εἶδαν ποῦ μένει, καὶ παρʼ αὐτῷ ἔμειναν τὴν ἡμέραν ἐκείνην· ὥρα ἦν ὡς δεκάτη."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "ἦν Ἀνδρέας ὁ ἀδελφὸς Σίμωνος Πέτρου εἷς ἐκ τῶν δύο τῶν ἀκουσάντων παρὰ Ἰωάννου καὶ ἀκολουθησάντων αὐτῷ·"
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "εὑρίσκει οὗτος ⸀πρῶτον",
          {
            "noteId": 22
          },
          "τὸν ἀδελφὸν τὸν ἴδιον Σίμωνα καὶ λέγει αὐτῷ· Εὑρήκαμεν τὸν Μεσσίαν (ὅ ἐστιν μεθερμηνευόμενον χριστός)."
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "⸀ἤγαγεν",
          {
            "noteId": 23
          },
          "αὐτὸν πρὸς τὸν Ἰησοῦν. ἐμβλέψας αὐτῷ ὁ Ἰησοῦς εἶπεν· Σὺ εἶ Σίμων ὁ υἱὸς ⸀Ἰωάννου",
          {
            "noteId": 24
          },
          "σὺ κληθήσῃ Κηφᾶς (ὃ ἑρμηνεύεται Πέτρος)."
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "Τῇ ἐπαύριον ἠθέλησεν ἐξελθεῖν εἰς τὴν Γαλιλαίαν. καὶ εὑρίσκει Φίλιππον καὶ λέγει αὐτῷ ὁ Ἰησοῦς· Ἀκολούθει μοι."
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "ἦν δὲ ὁ Φίλιππος ἀπὸ Βηθσαϊδά, ἐκ τῆς πόλεως Ἀνδρέου καὶ Πέτρου."
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "εὑρίσκει Φίλιππος τὸν Ναθαναὴλ καὶ λέγει αὐτῷ· Ὃν ἔγραψεν Μωϋσῆς ἐν τῷ νόμῳ καὶ οἱ προφῆται εὑρήκαμεν, ⸀Ἰησοῦν",
          {
            "noteId": 25
          },
          "υἱὸν τοῦ Ἰωσὴφ τὸν ἀπὸ Ναζαρέτ."
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "καὶ εἶπεν αὐτῷ Ναθαναήλ· Ἐκ Ναζαρὲτ δύναταί τι ἀγαθὸν εἶναι; λέγει αὐτῷ ⸀ὁ",
          {
            "noteId": 26
          },
          "Φίλιππος· Ἔρχου καὶ ἴδε."
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          "εἶδεν ⸀ὁ",
          {
            "noteId": 27
          },
          "Ἰησοῦς τὸν Ναθαναὴλ ἐρχόμενον πρὸς αὐτὸν καὶ λέγει περὶ αὐτοῦ· Ἴδε ἀληθῶς Ἰσραηλίτης ἐν ᾧ δόλος οὐκ ἔστιν."
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          "λέγει αὐτῷ Ναθαναήλ· Πόθεν με γινώσκεις; ἀπεκρίθη Ἰησοῦς καὶ εἶπεν αὐτῷ· Πρὸ τοῦ σε Φίλιππον φωνῆσαι ὄντα ὑπὸ τὴν συκῆν εἶδόν σε."
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          "ἀπεκρίθη ⸂αὐτῷ Ναθαναήλ",
          {
            "noteId": 28
          },
          "· Ῥαββί, σὺ εἶ ὁ υἱὸς τοῦ θεοῦ, σὺ ⸂βασιλεὺς εἶ",
          {
            "noteId": 29
          },
          "τοῦ Ἰσραήλ."
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          "ἀπεκρίθη Ἰησοῦς καὶ εἶπεν αὐτῷ· Ὅτι εἶπόν σοι ⸀ὅτι",
          {
            "noteId": 30
          },
          "εἶδόν σε ὑποκάτω τῆς συκῆς πιστεύεις; μείζω τούτων ⸀ὄψῃ",
          {
            "noteId": 31
          }
        ]
      },
      {
        "type": "verse",
        "number": 51,
        "content": [
          "καὶ λέγει αὐτῷ· Ἀμὴν ἀμὴν λέγω ⸀ὑμῖν",
          {
            "noteId": 32
          },
          "ὄψεσθε τὸν οὐρανὸν ἀνεῳγότα καὶ τοὺς ἀγγέλους τοῦ θεοῦ ἀναβαίνοντας καὶ καταβαίνοντας ἐπὶ τὸν υἱὸν τοῦ ἀνθρώπου."
        ]
      }
    ],
