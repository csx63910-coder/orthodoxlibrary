  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ τῇ ⸂ἡμέρᾳ τῇ τρίτῃ",
          {
            "noteId": 33
          },
          "γάμος ἐγένετο ἐν Κανὰ τῆς Γαλιλαίας, καὶ ἦν ἡ μήτηρ τοῦ Ἰησοῦ ἐκεῖ·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἐκλήθη δὲ καὶ ὁ Ἰησοῦς καὶ οἱ μαθηταὶ αὐτοῦ εἰς τὸν γάμον."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ ὑστερήσαντος οἴνου λέγει ἡ μήτηρ τοῦ Ἰησοῦ πρὸς αὐτόν· Οἶνον οὐκ ἔχουσιν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "⸀καὶ",
          {
            "noteId": 34
          },
          "λέγει αὐτῇ ὁ Ἰησοῦς· Τί ἐμοὶ καὶ σοί, γύναι; οὔπω ἥκει ἡ ὥρα μου."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "λέγει ἡ μήτηρ αὐτοῦ τοῖς διακόνοις· ⸂Ὅ τι",
          {
            "noteId": 35
          },
          "ἂν λέγῃ ὑμῖν ποιήσατε."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἦσαν δὲ ἐκεῖ ⸂λίθιναι ὑδρίαι",
          {
            "noteId": 36
          },
          "ἓξ ⸂κατὰ τὸν καθαρισμὸν τῶν Ἰουδαίων κείμεναι",
          {
            "noteId": 37
          },
          ", χωροῦσαι ἀνὰ μετρητὰς δύο ἢ τρεῖς."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "λέγει αὐτοῖς ὁ Ἰησοῦς· Γεμίσατε τὰς ὑδρίας ὕδατος· καὶ ἐγέμισαν αὐτὰς ἕως ἄνω."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ λέγει αὐτοῖς· Ἀντλήσατε νῦν καὶ φέρετε τῷ ἀρχιτρικλίνῳ· ⸂οἱ δὲ",
          {
            "noteId": 38
          },
          "ἤνεγκαν."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ὡς δὲ ἐγεύσατο ὁ ἀρχιτρίκλινος τὸ ὕδωρ οἶνον γεγενημένον, καὶ οὐκ ᾔδει πόθεν ἐστίν, οἱ δὲ διάκονοι ᾔδεισαν οἱ ἠντληκότες τὸ ὕδωρ, φωνεῖ τὸν νυμφίον ὁ ἀρχιτρίκλινος"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ λέγει αὐτῷ· Πᾶς ἄνθρωπος πρῶτον τὸν καλὸν οἶνον τίθησιν, καὶ ὅταν ⸀μεθυσθῶσιν",
          {
            "noteId": 39
          },
          "τὸν ἐλάσσω· σὺ τετήρηκας τὸν καλὸν οἶνον ἕως ἄρτι."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ταύτην ⸀ἐποίησεν",
          {
            "noteId": 40
          },
          "ἀρχὴν τῶν σημείων ὁ Ἰησοῦς ἐν Κανὰ τῆς Γαλιλαίας καὶ ἐφανέρωσεν τὴν δόξαν αὐτοῦ, καὶ ἐπίστευσαν εἰς αὐτὸν οἱ μαθηταὶ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Μετὰ τοῦτο κατέβη εἰς Καφαρναοὺμ αὐτὸς καὶ ἡ μήτηρ αὐτοῦ καὶ οἱ ⸀ἀδελφοὶ",
          {
            "noteId": 41
          },
          "καὶ οἱ μαθηταὶ αὐτοῦ, καὶ ἐκεῖ ἔμειναν οὐ πολλὰς ἡμέρας."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Καὶ ἐγγὺς ἦν τὸ πάσχα τῶν Ἰουδαίων, καὶ ἀνέβη εἰς Ἱεροσόλυμα ὁ Ἰησοῦς."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καὶ εὗρεν ἐν τῷ ἱερῷ τοὺς πωλοῦντας βόας καὶ πρόβατα καὶ περιστερὰς καὶ τοὺς κερματιστὰς καθημένους,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ ποιήσας φραγέλλιον ἐκ σχοινίων πάντας ἐξέβαλεν ἐκ τοῦ ἱεροῦ τά τε πρόβατα καὶ τοὺς βόας, καὶ τῶν κολλυβιστῶν ἐξέχεεν ⸂τὰ κέρματα",
          {
            "noteId": 42
          },
          "καὶ τὰς τραπέζας ⸀ἀνέστρεψεν",
          {
            "noteId": 43
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ τοῖς τὰς περιστερὰς πωλοῦσιν εἶπεν· Ἄρατε ταῦτα ἐντεῦθεν, μὴ ποιεῖτε τὸν οἶκον τοῦ πατρός μου οἶκον ἐμπορίου."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "⸀ἐμνήσθησαν",
          {
            "noteId": 44
          },
          "οἱ μαθηταὶ αὐτοῦ ὅτι γεγραμμένον ἐστίν· Ὁ ζῆλος τοῦ οἴκου σου καταφάγεταί με."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ἀπεκρίθησαν οὖν οἱ Ἰουδαῖοι καὶ εἶπαν αὐτῷ· Τί σημεῖον δεικνύεις ἡμῖν, ὅτι ταῦτα ποιεῖς;"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἀπεκρίθη Ἰησοῦς καὶ εἶπεν αὐτοῖς· Λύσατε τὸν ναὸν τοῦτον καὶ ἐν τρισὶν ἡμέραις ἐγερῶ αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "εἶπαν οὖν οἱ Ἰουδαῖοι· Τεσσεράκοντα καὶ ἓξ ἔτεσιν οἰκοδομήθη ὁ ναὸς οὗτος, καὶ σὺ ἐν τρισὶν ἡμέραις ἐγερεῖς αὐτόν;"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ἐκεῖνος δὲ ἔλεγεν περὶ τοῦ ναοῦ τοῦ σώματος αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ὅτε οὖν ἠγέρθη ἐκ νεκρῶν, ἐμνήσθησαν οἱ μαθηταὶ αὐτοῦ ὅτι τοῦτο ἔλεγεν, καὶ ἐπίστευσαν τῇ γραφῇ καὶ τῷ λόγῳ ⸀ὃν",
          {
            "noteId": 45
          },
          "εἶπεν ὁ Ἰησοῦς."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Ὡς δὲ ἦν ἐν τοῖς Ἱεροσολύμοις ἐν τῷ πάσχα ἐν τῇ ἑορτῇ, πολλοὶ ἐπίστευσαν εἰς τὸ ὄνομα αὐτοῦ, θεωροῦντες αὐτοῦ τὰ σημεῖα ἃ ἐποίει·"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "αὐτὸς ⸀δὲ",
          {
            "noteId": 46
          },
          "Ἰησοῦς οὐκ ἐπίστευεν ⸀αὑτὸν",
          {
            "noteId": 47
          },
          "αὐτοῖς διὰ τὸ αὐτὸν γινώσκειν πάντας"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "καὶ ὅτι οὐ χρείαν εἶχεν ἵνα τις μαρτυρήσῃ περὶ τοῦ ἀνθρώπου, αὐτὸς γὰρ ἐγίνωσκεν τί ἦν ἐν τῷ ἀνθρώπῳ."
        ]
      }
    ],
