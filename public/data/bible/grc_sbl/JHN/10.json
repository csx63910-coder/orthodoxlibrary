  "chapter": {
    "number": 10,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἀμὴν ἀμὴν λέγω ὑμῖν, ὁ μὴ εἰσερχόμενος διὰ τῆς θύρας εἰς τὴν αὐλὴν τῶν προβάτων ἀλλὰ ἀναβαίνων ἀλλαχόθεν ἐκεῖνος κλέπτης ἐστὶν καὶ λῃστής·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ὁ δὲ εἰσερχόμενος διὰ τῆς θύρας ποιμήν ἐστιν τῶν προβάτων."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "τούτῳ ὁ θυρωρὸς ἀνοίγει, καὶ τὰ πρόβατα τῆς φωνῆς αὐτοῦ ἀκούει καὶ τὰ ἴδια πρόβατα ⸀φωνεῖ",
          {
            "noteId": 336
          },
          "κατʼ ὄνομα καὶ ἐξάγει αὐτά."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "⸀ὅταν",
          {
            "noteId": 337
          },
          "τὰ ἴδια ⸀πάντα",
          {
            "noteId": 338
          },
          "ἐκβάλῃ, ἔμπροσθεν αὐτῶν πορεύεται, καὶ τὰ πρόβατα αὐτῷ ἀκολουθεῖ, ὅτι οἴδασιν τὴν φωνὴν αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἀλλοτρίῳ δὲ οὐ μὴ ⸀ἀκολουθήσουσιν",
          {
            "noteId": 339
          },
          "ἀλλὰ φεύξονται ἀπʼ αὐτοῦ, ὅτι οὐκ οἴδασι τῶν ἀλλοτρίων τὴν φωνήν."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ταύτην τὴν παροιμίαν εἶπεν αὐτοῖς ὁ Ἰησοῦς· ἐκεῖνοι δὲ οὐκ ἔγνωσαν τίνα ⸀ἦν",
          {
            "noteId": 340
          },
          "ἃ ἐλάλει αὐτοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Εἶπεν οὖν πάλιν ⸀αὐτοῖς",
          {
            "noteId": 341
          },
          "ὁ Ἰησοῦς· Ἀμὴν ἀμὴν λέγω ὑμῖν ⸀ὅτι",
          {
            "noteId": 342
          },
          "ἐγώ εἰμι ἡ θύρα τῶν προβάτων."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "πάντες ὅσοι ἦλθον ⸂πρὸ ἐμοῦ",
          {
            "noteId": 343
          },
          "κλέπται εἰσὶν καὶ λῃσταί· ἀλλʼ οὐκ ἤκουσαν αὐτῶν τὰ πρόβατα."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ἐγώ εἰμι ἡ θύρα· διʼ ἐμοῦ ἐάν τις εἰσέλθῃ σωθήσεται καὶ εἰσελεύσεται καὶ ἐξελεύσεται καὶ νομὴν εὑρήσει."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ὁ κλέπτης οὐκ ἔρχεται εἰ μὴ ἵνα κλέψῃ καὶ θύσῃ καὶ ἀπολέσῃ· ἐγὼ ἦλθον ἵνα ζωὴν ἔχωσιν καὶ περισσὸν ἔχωσιν."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ἐγώ εἰμι ὁ ποιμὴν ὁ καλός· ὁ ποιμὴν ὁ καλὸς τὴν ψυχὴν αὐτοῦ τίθησιν ὑπὲρ τῶν προβάτων·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ὁ ⸀μισθωτὸς",
          {
            "noteId": 344
          },
          "καὶ οὐκ ὢν ποιμήν, οὗ οὐκ ⸀ἔστιν",
          {
            "noteId": 345
          },
          "τὰ πρόβατα ἴδια, θεωρεῖ τὸν λύκον ἐρχόμενον καὶ ἀφίησιν τὰ πρόβατα καὶ φεύγει— καὶ ὁ λύκος ἁρπάζει αὐτὰ καὶ ⸀σκορπίζει",
          {
            "noteId": 346
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "⸀ὅτι",
          {
            "noteId": 347
          },
          "μισθωτός ἐστιν καὶ οὐ μέλει αὐτῷ περὶ τῶν προβάτων."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἐγώ εἰμι ὁ ποιμὴν ὁ καλός, καὶ γινώσκω τὰ ἐμὰ καὶ ⸂γινώσκουσί με τὰ ἐμά",
          {
            "noteId": 348
          },
          ","
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καθὼς γινώσκει με ὁ πατὴρ κἀγὼ γινώσκω τὸν πατέρα, καὶ τὴν ψυχήν μου τίθημι ὑπὲρ τῶν προβάτων."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ ἄλλα πρόβατα ἔχω ἃ οὐκ ἔστιν ἐκ τῆς αὐλῆς ταύτης· κἀκεῖνα ⸂δεῖ με",
          {
            "noteId": 349
          },
          "ἀγαγεῖν, καὶ τῆς φωνῆς μου ἀκούσουσιν, καὶ ⸀γενήσονται",
          {
            "noteId": 350
          },
          "μία ποίμνη, εἷς ποιμήν."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "διὰ τοῦτό ⸂με ὁ πατὴρ",
          {
            "noteId": 351
          },
          "ἀγαπᾷ ὅτι ἐγὼ τίθημι τὴν ψυχήν μου, ἵνα πάλιν λάβω αὐτήν."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "οὐδεὶς ⸀αἴρει",
          {
            "noteId": 352
          },
          "αὐτὴν ἀπʼ ἐμοῦ, ἀλλʼ ἐγὼ τίθημι αὐτὴν ἀπʼ ἐμαυτοῦ. ἐξουσίαν ἔχω θεῖναι αὐτήν, καὶ ἐξουσίαν ἔχω πάλιν λαβεῖν αὐτήν· ταύτην τὴν ἐντολὴν ἔλαβον παρὰ τοῦ πατρός μου."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "⸀Σχίσμα",
          {
            "noteId": 353
          },
          "πάλιν ἐγένετο ἐν τοῖς Ἰουδαίοις διὰ τοὺς λόγους τούτους."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἔλεγον δὲ πολλοὶ ἐξ αὐτῶν· Δαιμόνιον ἔχει καὶ μαίνεται· τί αὐτοῦ ἀκούετε;"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "⸀ἄλλοι",
          {
            "noteId": 354
          },
          "ἔλεγον· Ταῦτα τὰ ῥήματα οὐκ ἔστιν δαιμονιζομένου· μὴ δαιμόνιον δύναται τυφλῶν ὀφθαλμοὺς ⸀ἀνοῖξαι",
          {
            "noteId": 355
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Ἐγένετο ⸀τότε",
          {
            "noteId": 356
          },
          "τὰ ἐγκαίνια ἐν ⸀τοῖς",
          {
            "noteId": 357
          },
          "Ἱεροσολύμοις· ⸀χειμὼν",
          {
            "noteId": 358
          },
          "ἦν,"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "καὶ περιεπάτει ὁ Ἰησοῦς ἐν τῷ ἱερῷ ἐν τῇ στοᾷ ⸀τοῦ",
          {
            "noteId": 359
          },
          "Σολομῶνος."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ἐκύκλωσαν οὖν αὐτὸν οἱ Ἰουδαῖοι καὶ ἔλεγον αὐτῷ· Ἕως πότε τὴν ψυχὴν ἡμῶν αἴρεις; εἰ σὺ εἶ ὁ χριστός, εἰπὲ ἡμῖν παρρησίᾳ."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ἀπεκρίθη αὐτοῖς ὁ Ἰησοῦς· Εἶπον ὑμῖν καὶ οὐ πιστεύετε· τὰ ἔργα ἃ ἐγὼ ποιῶ ἐν τῷ ὀνόματι τοῦ πατρός μου ταῦτα μαρτυρεῖ περὶ ἐμοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ἀλλὰ ὑμεῖς οὐ πιστεύετε, ⸂ὅτι οὐκ",
          {
            "noteId": 360
          },
          "ἐστὲ ἐκ τῶν προβάτων τῶν ⸀ἐμῶν",
          {
            "noteId": 361
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "τὰ πρόβατα τὰ ἐμὰ τῆς φωνῆς μου ⸀ἀκούουσιν",
          {
            "noteId": 362
          },
          "κἀγὼ γινώσκω αὐτά, καὶ ἀκολουθοῦσίν μοι,"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "κἀγὼ ⸂δίδωμι αὐτοῖς ζωὴν αἰώνιον",
          {
            "noteId": 363
          },
          ", καὶ οὐ μὴ ἀπόλωνται εἰς τὸν αἰῶνα, καὶ οὐχ ἁρπάσει τις αὐτὰ ἐκ τῆς χειρός μου."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "ὁ πατήρ μου ⸀ὃ",
          {
            "noteId": 364
          },
          "δέδωκέν ⸀μοι",
          {
            "noteId": 365
          },
          "⸂πάντων μεῖζων",
          {
            "noteId": 366
          },
          "ἐστίν, καὶ οὐδεὶς δύναται ἁρπάζειν ἐκ τῆς χειρὸς τοῦ ⸀πατρός",
          {
            "noteId": 367
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ἐγὼ καὶ ὁ πατὴρ ἕν ἐσμεν."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "Ἐβάστασαν ⸀οὖν",
          {
            "noteId": 368
          },
          "πάλιν λίθους οἱ Ἰουδαῖοι ἵνα λιθάσωσιν αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "ἀπεκρίθη αὐτοῖς ὁ Ἰησοῦς· Πολλὰ ⸂ἔργα καλὰ ἔδειξα ὑμῖν",
          {
            "noteId": 369
          },
          "ἐκ τοῦ ⸀πατρός",
          {
            "noteId": 370
          },
          "διὰ ποῖον αὐτῶν ἔργον ⸂ἐμὲ λιθάζετε",
          {
            "noteId": 371
          },
          ";"
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "ἀπεκρίθησαν αὐτῷ οἱ ⸀Ἰουδαῖοι",
          {
            "noteId": 372
          },
          "Περὶ καλοῦ ἔργου οὐ λιθάζομέν σε ἀλλὰ περὶ βλασφημίας, καὶ ὅτι σὺ ἄνθρωπος ὢν ποιεῖς σεαυτὸν θεόν."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "ἀπεκρίθη αὐτοῖς ὁ Ἰησοῦς· Οὐκ ἔστιν γεγραμμένον ἐν τῷ νόμῳ ὑμῶν ⸀ὅτι",
          {
            "noteId": 373
          },
          "Ἐγὼ εἶπα· Θεοί ἐστε;"
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "εἰ ἐκείνους εἶπεν θεοὺς πρὸς οὓς ὁ λόγος τοῦ θεοῦ ἐγένετο, καὶ οὐ δύναται λυθῆναι ἡ γραφή,"
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "ὃν ὁ πατὴρ ἡγίασεν καὶ ἀπέστειλεν εἰς τὸν κόσμον ὑμεῖς λέγετε ὅτι Βλασφημεῖς, ὅτι εἶπον· Υἱὸς τοῦ θεοῦ εἰμι;"
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "εἰ οὐ ποιῶ τὰ ἔργα τοῦ πατρός μου, μὴ πιστεύετέ μοι·"
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "εἰ δὲ ποιῶ, κἂν ἐμοὶ μὴ πιστεύητε τοῖς ἔργοις ⸀πιστεύετε",
          {
            "noteId": 374
          },
          "ἵνα γνῶτε καὶ ⸀γινώσκητε",
          {
            "noteId": 375
          },
          "ὅτι ἐν ἐμοὶ ὁ πατὴρ κἀγὼ ἐν ⸂τῷ πατρί",
          {
            "noteId": 376
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "ἐζήτουν οὖν ⸂πάλιν αὐτὸν",
          {
            "noteId": 377
          },
          "πιάσαι· καὶ ἐξῆλθεν ἐκ τῆς χειρὸς αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "Καὶ ἀπῆλθεν πάλιν πέραν τοῦ Ἰορδάνου εἰς τὸν τόπον ὅπου ἦν Ἰωάννης τὸ πρῶτον βαπτίζων, καὶ ἔμεινεν ἐκεῖ."
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "καὶ πολλοὶ ἦλθον πρὸς αὐτὸν καὶ ἔλεγον ὅτι Ἰωάννης μὲν σημεῖον ἐποίησεν οὐδέν, πάντα δὲ ὅσα εἶπεν Ἰωάννης περὶ τούτου ἀληθῆ ἦν."
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "καὶ ⸂πολλοὶ ἐπίστευσαν εἰς αὐτὸν ἐκεῖ",
          {
            "noteId": 378
          },
          "."
        ]
      }
    ],
