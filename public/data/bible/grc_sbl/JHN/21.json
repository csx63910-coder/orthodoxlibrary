  "chapter": {
    "number": 21,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Μετὰ ταῦτα ἐφανέρωσεν ἑαυτὸν πάλιν ⸀ὁ",
          {
            "noteId": 742
          },
          "Ἰησοῦς τοῖς μαθηταῖς ἐπὶ τῆς θαλάσσης τῆς Τιβεριάδος· ἐφανέρωσεν δὲ οὕτως."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἦσαν ὁμοῦ Σίμων Πέτρος καὶ Θωμᾶς ὁ λεγόμενος Δίδυμος καὶ Ναθαναὴλ ὁ ἀπὸ Κανὰ τῆς Γαλιλαίας καὶ οἱ τοῦ Ζεβεδαίου καὶ ἄλλοι ἐκ τῶν μαθητῶν αὐτοῦ δύο."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "λέγει αὐτοῖς Σίμων Πέτρος· Ὑπάγω ἁλιεύειν· λέγουσιν αὐτῷ· Ἐρχόμεθα καὶ ἡμεῖς σὺν σοί. ἐξῆλθον καὶ ἐνέβησαν εἰς τὸ ⸀πλοῖον",
          {
            "noteId": 743
          },
          "καὶ ἐν ἐκείνῃ τῇ νυκτὶ ἐπίασαν οὐδέν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Πρωΐας δὲ ἤδη ⸀γενομένης",
          {
            "noteId": 744
          },
          "⸀ἔστη",
          {
            "noteId": 745
          },
          "Ἰησοῦς εἰς τὸν αἰγιαλόν· οὐ μέντοι ᾔδεισαν οἱ μαθηταὶ ὅτι Ἰησοῦς ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "λέγει οὖν αὐτοῖς ⸀ὁ",
          {
            "noteId": 746
          },
          "Ἰησοῦς· Παιδία, μή τι προσφάγιον ἔχετε; ἀπεκρίθησαν αὐτῷ· Οὔ."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ὁ δὲ εἶπεν αὐτοῖς· Βάλετε εἰς τὰ δεξιὰ μέρη τοῦ πλοίου τὸ δίκτυον, καὶ εὑρήσετε. ἔβαλον οὖν, καὶ οὐκέτι αὐτὸ ἑλκύσαι ⸀ἴσχυον",
          {
            "noteId": 747
          },
          "ἀπὸ τοῦ πλήθους τῶν ἰχθύων."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "λέγει οὖν ὁ μαθητὴς ἐκεῖνος ὃν ἠγάπα ὁ Ἰησοῦς τῷ Πέτρῳ· Ὁ κύριός ἐστιν. Σίμων οὖν Πέτρος, ἀκούσας ὅτι ὁ κύριός ἐστιν, τὸν ἐπενδύτην διεζώσατο, ἦν γὰρ γυμνός, καὶ ἔβαλεν ἑαυτὸν εἰς τὴν θάλασσαν·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "οἱ δὲ ἄλλοι μαθηταὶ τῷ πλοιαρίῳ ἦλθον, οὐ γὰρ ἦσαν μακρὰν ἀπὸ τῆς γῆς ἀλλὰ ὡς ἀπὸ πηχῶν διακοσίων, σύροντες τὸ δίκτυον τῶν ἰχθύων."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Ὡς οὖν ἀπέβησαν εἰς τὴν γῆν βλέπουσιν ἀνθρακιὰν κειμένην καὶ ὀψάριον ἐπικείμενον καὶ ἄρτον."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "λέγει αὐτοῖς ὁ Ἰησοῦς· Ἐνέγκατε ἀπὸ τῶν ὀψαρίων ὧν ἐπιάσατε νῦν."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ἀνέβη ⸀οὖν",
          {
            "noteId": 748
          },
          "Σίμων Πέτρος καὶ εἵλκυσεν τὸ δίκτυον ⸂εἰς τὴν γῆν",
          {
            "noteId": 749
          },
          "μεστὸν ἰχθύων μεγάλων ἑκατὸν πεντήκοντα τριῶν· καὶ τοσούτων ὄντων οὐκ ἐσχίσθη τὸ δίκτυον."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "λέγει αὐτοῖς ὁ Ἰησοῦς· Δεῦτε ἀριστήσατε. οὐδεὶς ⸀δὲ",
          {
            "noteId": 750
          },
          "ἐτόλμα τῶν μαθητῶν ἐξετάσαι αὐτόν· Σὺ τίς εἶ; εἰδότες ὅτι ὁ κύριός ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "⸀ἔρχεται",
          {
            "noteId": 751
          },
          "⸀ὁ",
          {
            "noteId": 752
          },
          "Ἰησοῦς καὶ λαμβάνει τὸν ἄρτον καὶ δίδωσιν αὐτοῖς, καὶ τὸ ὀψάριον ὁμοίως."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "τοῦτο ἤδη τρίτον ἐφανερώθη ⸀ὁ",
          {
            "noteId": 753
          },
          "Ἰησοῦς τοῖς ⸀μαθηταῖς",
          {
            "noteId": 754
          },
          "ἐγερθεὶς ἐκ νεκρῶν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Ὅτε οὖν ἠρίστησαν λέγει τῷ Σίμωνι Πέτρῳ ὁ Ἰησοῦς· Σίμων ⸀Ἰωάννου",
          {
            "noteId": 755
          },
          "ἀγαπᾷς με πλέον τούτων; λέγει αὐτῷ· Ναί, κύριε, σὺ οἶδας ὅτι φιλῶ σε. λέγει αὐτῷ· Βόσκε τὰ ἀρνία μου."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "λέγει αὐτῷ πάλιν δεύτερον· Σίμων ⸀Ἰωάννου",
          {
            "noteId": 756
          },
          "ἀγαπᾷς με; λέγει αὐτῷ· Ναί, κύριε, σὺ οἶδας ὅτι φιλῶ σε. λέγει αὐτῷ· Ποίμαινε τὰ πρόβατά μου."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "λέγει αὐτῷ τὸ τρίτον· Σίμων ⸀Ἰωάννου",
          {
            "noteId": 757
          },
          "φιλεῖς με; ἐλυπήθη ὁ Πέτρος ὅτι εἶπεν",
          {
            "noteId": 758
          },
          "αὐτῷ τὸ τρίτον· Φιλεῖς με; καὶ ⸀εἶπεν αὐτῷ· Κύριε, ⸂πάντα σὺ",
          {
            "noteId": 759
          },
          "οἶδας, σὺ γινώσκεις ὅτι φιλῶ σε. λέγει αὐτῷ ⸀ὁ",
          {
            "noteId": 760
          },
          "Ἰησοῦς· Βόσκε τὰ ⸀πρόβατά",
          {
            "noteId": 761
          },
          "μου."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ἀμὴν ἀμὴν λέγω σοι, ὅτε ἦς νεώτερος, ἐζώννυες σεαυτὸν καὶ περιεπάτεις ὅπου ἤθελες· ὅταν δὲ γηράσῃς, ἐκτενεῖς τὰς χεῖράς σου, καὶ ἄλλος ⸂σε ζώσει",
          {
            "noteId": 762
          },
          "καὶ οἴσει ὅπου οὐ θέλεις."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "τοῦτο δὲ εἶπεν σημαίνων ποίῳ θανάτῳ δοξάσει τὸν θεόν. καὶ τοῦτο εἰπὼν λέγει αὐτῷ· Ἀκολούθει μοι."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "⸀Ἐπιστραφεὶς",
          {
            "noteId": 763
          },
          "ὁ Πέτρος βλέπει τὸν μαθητὴν ὃν ἠγάπα ὁ Ἰησοῦς ἀκολουθοῦντα, ὃς καὶ ἀνέπεσεν ἐν τῷ δείπνῳ ἐπὶ τὸ στῆθος αὐτοῦ καὶ εἶπεν· Κύριε, τίς ἐστιν ὁ παραδιδούς σε;"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "τοῦτον ⸀οὖν",
          {
            "noteId": 764
          },
          "ἰδὼν ὁ Πέτρος λέγει τῷ Ἰησοῦ· Κύριε, οὗτος δὲ τί;"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "λέγει αὐτῷ ὁ Ἰησοῦς· Ἐὰν αὐτὸν θέλω μένειν ἕως ἔρχομαι, τί πρὸς σέ; σύ ⸂μοι ἀκολούθει",
          {
            "noteId": 765
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ἐξῆλθεν οὖν ⸂οὗτος ὁ λόγος",
          {
            "noteId": 766
          },
          "εἰς τοὺς ἀδελφοὺς ὅτι ὁ μαθητὴς ἐκεῖνος οὐκ ἀποθνῄσκει. ⸂οὐκ εἶπεν δὲ",
          {
            "noteId": 767
          },
          "αὐτῷ ὁ Ἰησοῦς ὅτι οὐκ ἀποθνῄσκει ἀλλʼ· Ἐὰν αὐτὸν θέλω μένειν ἕως ἔρχομαι, τί πρὸς σέ;"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Οὗτός ἐστιν ὁ",
          {
            "noteId": 768
          },
          "μαθητὴς ὁ μαρτυρῶν περὶ τούτων καὶ ⸀ὁ γράψας ταῦτα, καὶ οἴδαμεν ὅτι ἀληθὴς ⸂αὐτοῦ ἡ μαρτυρία ἐστίν",
          {
            "noteId": 769
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ἔστιν δὲ καὶ ἄλλα πολλὰ ⸀ἃ",
          {
            "noteId": 770
          },
          "ἐποίησεν ὁ Ἰησοῦς, ἅτινα ἐὰν γράφηται καθʼ ἕν, οὐδʼ αὐτὸν οἶμαι τὸν κόσμον ⸀χωρήσειν",
          {
            "noteId": 771
          },
          "τὰ γραφόμενα ⸀βιβλία",
          {
            "noteId": 772
          },
          "‘/book’"
        ]
      }
    ],
