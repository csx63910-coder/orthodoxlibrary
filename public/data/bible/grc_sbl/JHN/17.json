  "chapter": {
    "number": 17,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ταῦτα ⸀ἐλάλησεν",
          {
            "noteId": 596
          },
          "Ἰησοῦς, καὶ ⸂ἐπάρας τοὺς ὀφθαλμοὺς αὐτοῦ εἰς τὸν οὐρανὸν εἶπεν",
          {
            "noteId": 597
          },
          "· Πάτερ, ἐλήλυθεν ἡ ὥρα· δόξασόν σου τὸν υἱόν, ⸀ἵνα",
          {
            "noteId": 598
          },
          "ὁ ⸀υἱὸς",
          {
            "noteId": 599
          },
          "δοξάσῃ σέ,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καθὼς ἔδωκας αὐτῷ ἐξουσίαν πάσης σαρκός, ἵνα πᾶν ὃ δέδωκας αὐτῷ ⸀δώσῃ",
          {
            "noteId": 600
          },
          "αὐτοῖς ζωὴν αἰώνιον."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "αὕτη δέ ἐστιν ἡ αἰώνιος ζωὴ ἵνα γινώσκωσι σὲ τὸν μόνον ἀληθινὸν θεὸν καὶ ὃν ἀπέστειλας Ἰησοῦν Χριστόν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἐγώ σε ἐδόξασα ἐπὶ τῆς γῆς, τὸ ἔργον ⸀τελειώσας",
          {
            "noteId": 601
          },
          "ὃ δέδωκάς μοι ἵνα ποιήσω·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ νῦν δόξασόν με σύ, πάτερ, παρὰ σεαυτῷ τῇ δόξῃ ᾗ εἶχον πρὸ τοῦ τὸν κόσμον εἶναι παρὰ σοί."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ἐφανέρωσά σου τὸ ὄνομα τοῖς ἀνθρώποις οὓς ⸀ἔδωκάς",
          {
            "noteId": 602
          },
          "μοι ἐκ τοῦ κόσμου. σοὶ ἦσαν κἀμοὶ αὐτοὺς ⸁ἔδωκας",
          {
            "noteId": 603
          },
          "καὶ τὸν λόγον σου τετήρηκαν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "νῦν ἔγνωκαν ὅτι πάντα ὅσα ⸀δέδωκάς",
          {
            "noteId": 604
          },
          "μοι παρὰ σοῦ ⸀εἰσιν",
          {
            "noteId": 605
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ὅτι τὰ ῥήματα ἃ ⸀ἔδωκάς",
          {
            "noteId": 606
          },
          "μοι δέδωκα αὐτοῖς, καὶ αὐτοὶ ἔλαβον καὶ ἔγνωσαν ἀληθῶς ὅτι παρὰ σοῦ ἐξῆλθον, καὶ ἐπίστευσαν ὅτι σύ με ἀπέστειλας."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ἐγὼ περὶ αὐτῶν ἐρωτῶ· οὐ περὶ τοῦ κόσμου ἐρωτῶ ἀλλὰ περὶ ὧν δέδωκάς μοι, ὅτι σοί εἰσιν,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ τὰ ἐμὰ πάντα σά ἐστιν καὶ τὰ σὰ ἐμά, καὶ δεδόξασμαι ἐν αὐτοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ οὐκέτι εἰμὶ ἐν τῷ κόσμῳ, καὶ ⸀αὐτοὶ",
          {
            "noteId": 607
          },
          "ἐν τῷ κόσμῳ εἰσίν, κἀγὼ πρὸς σὲ ἔρχομαι. πάτερ ἅγιε, τήρησον αὐτοὺς ἐν τῷ ὀνόματί σου ᾧ δέδωκάς μοι, ἵνα ὦσιν ἓν ⸀καθὼς",
          {
            "noteId": 608
          },
          "ἡμεῖς."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ὅτε ἤμην μετʼ ⸀αὐτῶν",
          {
            "noteId": 609
          },
          "ἐγὼ ἐτήρουν αὐτοὺς ἐν τῷ ὀνόματί σου ⸀ᾧ",
          {
            "noteId": 610
          },
          "δέδωκάς μοι, ⸀καὶ",
          {
            "noteId": 611
          },
          "ἐφύλαξα, καὶ οὐδεὶς ἐξ αὐτῶν ἀπώλετο εἰ μὴ ὁ υἱὸς τῆς ἀπωλείας, ἵνα ἡ γραφὴ πληρωθῇ."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "νῦν δὲ πρὸς σὲ ἔρχομαι, καὶ ταῦτα λαλῶ ἐν τῷ κόσμῳ ἵνα ἔχωσιν τὴν χαρὰν τὴν ἐμὴν πεπληρωμένην ἐν ⸀ἑαυτοῖς",
          {
            "noteId": 612
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἐγὼ δέδωκα αὐτοῖς τὸν λόγον σου, καὶ ὁ κόσμος ἐμίσησεν αὐτούς, ὅτι οὐκ εἰσὶν ἐκ τοῦ κόσμου καθὼς ἐγὼ οὐκ εἰμὶ ἐκ τοῦ κόσμου."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "οὐκ ἐρωτῶ ἵνα ἄρῃς αὐτοὺς ἐκ τοῦ κόσμου ἀλλʼ ἵνα τηρήσῃς αὐτοὺς ἐκ τοῦ πονηροῦ."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ἐκ τοῦ κόσμου οὐκ εἰσὶν καθὼς ἐγὼ ⸂οὐκ εἰμὶ ἐκ τοῦ κόσμου",
          {
            "noteId": 613
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ἁγίασον αὐτοὺς ἐν τῇ ⸀ἀληθείᾳ",
          {
            "noteId": 614
          },
          "ὁ λόγος ὁ σὸς ἀλήθειά ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καθὼς ἐμὲ ἀπέστειλας εἰς τὸν κόσμον, κἀγὼ ἀπέστειλα αὐτοὺς εἰς τὸν κόσμον·"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "καὶ ὑπὲρ αὐτῶν ἐγὼ ἁγιάζω ἐμαυτόν, ἵνα ⸂ὦσιν καὶ αὐτοὶ",
          {
            "noteId": 615
          },
          "ἡγιασμένοι ἐν ἀληθείᾳ."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Οὐ περὶ τούτων δὲ ἐρωτῶ μόνον, ἀλλὰ καὶ περὶ τῶν πιστευόντων διὰ τοῦ λόγου αὐτῶν εἰς ἐμέ,"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ἵνα πάντες ἓν ὦσιν, καθὼς σύ, ⸀πάτερ",
          {
            "noteId": 616
          },
          "ἐν ἐμοὶ κἀγὼ ἐν σοί, ἵνα καὶ αὐτοὶ ἐν ⸀ἡμῖν",
          {
            "noteId": 617
          },
          "ὦσιν, ἵνα ὁ κόσμος ⸀πιστεύῃ",
          {
            "noteId": 618
          },
          "ὅτι σύ με ἀπέστειλας."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "κἀγὼ τὴν δόξαν ἣν δέδωκάς μοι δέδωκα αὐτοῖς, ἵνα ὦσιν ἓν καθὼς ἡμεῖς ⸀ἕν",
          {
            "noteId": 619
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ἐγὼ ἐν αὐτοῖς καὶ σὺ ἐν ἐμοί, ἵνα",
          {
            "noteId": 620
          },
          "ὦσιν τετελειωμένοι εἰς ἕν, ⸀ἵνα γινώσκῃ ὁ κόσμος ὅτι σύ με ἀπέστειλας καὶ ἠγάπησας αὐτοὺς καθὼς ἐμὲ ἠγάπησας."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "⸀πάτερ",
          {
            "noteId": 621
          },
          "⸀ὃ",
          {
            "noteId": 622
          },
          "δέδωκάς",
          {
            "noteId": 623
          },
          "μοι, θέλω ἵνα ὅπου εἰμὶ ἐγὼ κἀκεῖνοι ὦσιν μετʼ ἐμοῦ, ἵνα θεωρῶσιν τὴν δόξαν τὴν ἐμὴν ἣν ⸀δέδωκάς μοι, ὅτι ἠγάπησάς με πρὸ καταβολῆς κόσμου."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "⸀Πάτερ",
          {
            "noteId": 624
          },
          "δίκαιε, καὶ ὁ κόσμος σε οὐκ ἔγνω, ἐγὼ δέ σε ἔγνων, καὶ οὗτοι ἔγνωσαν ὅτι σύ με ἀπέστειλας,"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "καὶ ἐγνώρισα αὐτοῖς τὸ ὄνομά σου καὶ γνωρίσω, ἵνα ἡ ἀγάπη ἣν ἠγάπησάς με ἐν αὐτοῖς ᾖ κἀγὼ ἐν αὐτοῖς."
        ]
      }
    ],
