  "chapter": {
    "number": 15,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἐγώ εἰμι ἡ ἄμπελος ἡ ἀληθινή, καὶ ὁ πατήρ μου ὁ γεωργός ἐστιν·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "πᾶν κλῆμα ἐν ἐμοὶ μὴ φέρον καρπὸν αἴρει αὐτό, καὶ πᾶν τὸ καρπὸν φέρον καθαίρει αὐτὸ ἵνα ⸂καρπὸν πλείονα",
          {
            "noteId": 551
          },
          "φέρῃ."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἤδη ὑμεῖς καθαροί ἐστε διὰ τὸν λόγον ὃν λελάληκα ὑμῖν·"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "μείνατε ἐν ἐμοί, κἀγὼ ἐν ὑμῖν. καθὼς τὸ κλῆμα οὐ δύναται καρπὸν φέρειν ἀφʼ ἑαυτοῦ ἐὰν μὴ ⸀μένῃ",
          {
            "noteId": 552
          },
          "ἐν τῇ ἀμπέλῳ, οὕτως οὐδὲ ὑμεῖς ἐὰν μὴ ἐν ἐμοὶ ⸀μένητε",
          {
            "noteId": 553
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἐγώ εἰμι ἡ ἄμπελος, ὑμεῖς τὰ κλήματα. ὁ μένων ἐν ἐμοὶ κἀγὼ ἐν αὐτῷ οὗτος φέρει καρπὸν πολύν, ὅτι χωρὶς ἐμοῦ οὐ δύνασθε ποιεῖν οὐδέν."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἐὰν μή τις ⸀μένῃ",
          {
            "noteId": 554
          },
          "ἐν ἐμοί, ἐβλήθη ἔξω ὡς τὸ κλῆμα καὶ ἐξηράνθη, καὶ συνάγουσιν αὐτὰ καὶ εἰς τὸ πῦρ βάλλουσιν καὶ καίεται."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἐὰν μείνητε ἐν ἐμοὶ καὶ τὰ ῥήματά μου ἐν ὑμῖν μείνῃ, ὃ ἐὰν θέλητε ⸀αἰτήσασθε",
          {
            "noteId": 555
          },
          "καὶ γενήσεται ὑμῖν·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἐν τούτῳ ἐδοξάσθη ὁ πατήρ μου ἵνα καρπὸν πολὺν φέρητε καὶ ⸀γένησθε",
          {
            "noteId": 556
          },
          "ἐμοὶ μαθηταί."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καθὼς ἠγάπησέν με ὁ πατήρ, κἀγὼ ⸂ὑμᾶς ἠγάπησα",
          {
            "noteId": 557
          },
          ", μείνατε ἐν τῇ ἀγάπῃ τῇ ἐμῇ."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἐὰν τὰς ἐντολάς μου τηρήσητε, μενεῖτε ἐν τῇ ἀγάπῃ μου, καθὼς ἐγὼ ⸂τὰς ἐντολὰς τοῦ πατρός μου",
          {
            "noteId": 558
          },
          "τετήρηκα καὶ μένω αὐτοῦ ἐν τῇ ἀγάπῃ."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ταῦτα λελάληκα ὑμῖν ἵνα ἡ χαρὰ ἡ ἐμὴ ἐν ὑμῖν ⸀ᾖ",
          {
            "noteId": 559
          },
          "καὶ ἡ χαρὰ ὑμῶν πληρωθῇ."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Αὕτη ἐστὶν ἡ ἐντολὴ ἡ ἐμὴ ἵνα ἀγαπᾶτε ἀλλήλους καθὼς ἠγάπησα ὑμᾶς·"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "μείζονα ταύτης ἀγάπην οὐδεὶς ἔχει, ἵνα τις τὴν ψυχὴν αὐτοῦ θῇ ὑπὲρ τῶν φίλων αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ὑμεῖς φίλοι μού ἐστε ἐὰν ποιῆτε ⸀ἃ",
          {
            "noteId": 560
          },
          "ἐγὼ ἐντέλλομαι ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "οὐκέτι ⸂λέγω ὑμᾶς",
          {
            "noteId": 561
          },
          "δούλους, ὅτι ὁ δοῦλος οὐκ οἶδεν τί ποιεῖ αὐτοῦ ὁ κύριος· ὑμᾶς δὲ εἴρηκα φίλους, ὅτι πάντα ἃ ἤκουσα παρὰ τοῦ πατρός μου ἐγνώρισα ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "οὐχ ὑμεῖς με ἐξελέξασθε, ἀλλʼ ἐγὼ ἐξελεξάμην ὑμᾶς, καὶ ἔθηκα ὑμᾶς ἵνα ὑμεῖς ὑπάγητε καὶ καρπὸν φέρητε καὶ ὁ καρπὸς ὑμῶν μένῃ, ἵνα ὅ τι ἂν αἰτήσητε τὸν πατέρα ἐν τῷ ὀνόματί μου δῷ ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ταῦτα ἐντέλλομαι ὑμῖν ἵνα ἀγαπᾶτε ἀλλήλους."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Εἰ ὁ κόσμος ὑμᾶς μισεῖ, γινώσκετε ὅτι ἐμὲ πρῶτον ⸀ὑμῶν",
          {
            "noteId": 562
          },
          "μεμίσηκεν."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "εἰ ἐκ τοῦ κόσμου ἦτε, ὁ κόσμος ἂν τὸ ἴδιον ἐφίλει· ὅτι δὲ ἐκ τοῦ κόσμου οὐκ ἐστέ, ἀλλʼ ἐγὼ ἐξελεξάμην ὑμᾶς ἐκ τοῦ κόσμου, διὰ τοῦτο μισεῖ ὑμᾶς ὁ κόσμος."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "μνημονεύετε τοῦ λόγου οὗ ἐγὼ εἶπον ὑμῖν· Οὐκ ἔστιν δοῦλος μείζων τοῦ κυρίου αὐτοῦ· εἰ ἐμὲ ἐδίωξαν, καὶ ὑμᾶς διώξουσιν· εἰ τὸν λόγον μου ἐτήρησαν, καὶ τὸν ὑμέτερον τηρήσουσιν."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ἀλλὰ ταῦτα πάντα ποιήσουσιν ⸂εἰς ὑμᾶς",
          {
            "noteId": 563
          },
          "διὰ τὸ ὄνομά μου, ὅτι οὐκ οἴδασιν τὸν πέμψαντά με."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "εἰ μὴ ἦλθον καὶ ἐλάλησα αὐτοῖς, ἁμαρτίαν οὐκ ⸀εἴχοσαν",
          {
            "noteId": 564
          },
          "νῦν δὲ πρόφασιν οὐκ ἔχουσιν περὶ τῆς ἁμαρτίας αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ὁ ἐμὲ μισῶν καὶ τὸν πατέρα μου μισεῖ."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "εἰ τὰ ἔργα μὴ ἐποίησα ἐν αὐτοῖς ἃ οὐδεὶς ἄλλος ⸀ἐποίησεν",
          {
            "noteId": 565
          },
          "ἁμαρτίαν οὐκ ⸀εἴχοσαν",
          {
            "noteId": 566
          },
          "νῦν δὲ καὶ ἑωράκασιν καὶ μεμισήκασιν καὶ ἐμὲ καὶ τὸν πατέρα μου."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ἀλλʼ ἵνα πληρωθῇ ὁ λόγος ὁ ⸂ἐν τῷ νόμῳ αὐτῶν γεγραμμένος",
          {
            "noteId": 567
          },
          "ὅτι Ἐμίσησάν με δωρεάν."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "⸀Ὅταν",
          {
            "noteId": 568
          },
          "ἔλθῃ ὁ παράκλητος ὃν ἐγὼ πέμψω ὑμῖν παρὰ τοῦ πατρός, τὸ πνεῦμα τῆς ἀληθείας ὃ παρὰ τοῦ πατρὸς ἐκπορεύεται, ἐκεῖνος μαρτυρήσει περὶ ἐμοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "καὶ ὑμεῖς δὲ μαρτυρεῖτε, ὅτι ἀπʼ ἀρχῆς μετʼ ἐμοῦ ἐστε."
        ]
      }
    ],
