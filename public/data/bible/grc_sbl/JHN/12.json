  },
  "chapter": {
    "number": 12,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ὁ οὖν Ἰησοῦς πρὸ ἓξ ἡμερῶν τοῦ πάσχα ἦλθεν εἰς Βηθανίαν, ὅπου ἦν ⸀Λάζαρος",
          {
            "noteId": 425
          },
          "ὃν ἤγειρεν ἐκ νεκρῶν ⸀Ἰησοῦς",
          {
            "noteId": 426
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἐποίησαν οὖν αὐτῷ δεῖπνον ἐκ",
          {
            "noteId": 427
          },
          "ῖ, καὶ ἡ Μάρθα διηκόνει, ὁ δὲ Λάζαρος εἷς ἦν ⸀ἐκ τῶν ἀνακειμένων σὺν αὐτῷ·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἡ οὖν ⸀Μαριὰμ",
          {
            "noteId": 428
          },
          "λαβοῦσα λίτραν μύρου νάρδου πιστικῆς πολυτίμου ἤλειψεν τοὺς πόδας τοῦ Ἰησοῦ καὶ ἐξέμαξεν ταῖς θριξὶν αὐτῆς τοὺς πόδας αὐτοῦ· ἡ δὲ οἰκία ἐπληρώθη ἐκ τῆς ὀσμῆς τοῦ μύρου."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "λέγει ⸀δὲ",
          {
            "noteId": 429
          },
          "⸂Ἰούδας ὁ Ἰσκαριώτης εἷς τῶν μαθητῶν αὐτοῦ",
          {
            "noteId": 430
          },
          ", ὁ μέλλων αὐτὸν παραδιδόναι·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Διὰ τί τοῦτο τὸ μύρον οὐκ ἐπράθη τριακοσίων δηναρίων καὶ ἐδόθη πτωχοῖς;"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "εἶπεν δὲ τοῦτο οὐχ ὅτι περὶ τῶν πτωχῶν ἔμελεν αὐτῷ, ἀλλʼ ὅτι κλέπτης ἦν καὶ τὸ γλωσσόκομον ⸀ἔχων",
          {
            "noteId": 431
          },
          "τὰ βαλλόμενα ἐβάσταζεν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "εἶπεν οὖν ὁ Ἰησοῦς· Ἄφες αὐτήν, ⸀ἵνα",
          {
            "noteId": 432
          },
          "εἰς τὴν ἡμέραν τοῦ ἐνταφιασμοῦ μου ⸀τηρήσῃ",
          {
            "noteId": 433
          },
          "αὐτό·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "τοὺς πτωχοὺς γὰρ πάντοτε ἔχετε μεθʼ ἑαυτῶν, ἐμὲ δὲ οὐ πάντοτε ἔχετε."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Ἔγνω ⸀οὖν",
          {
            "noteId": 434
          },
          "ὄχλος πολὺς ἐκ τῶν Ἰουδαίων ὅτι ἐκεῖ ἐστιν, καὶ ἦλθον οὐ διὰ τὸν Ἰησοῦν μόνον, ἀλλʼ ἵνα καὶ τὸν Λάζαρον ἴδωσιν ὃν ἤγειρεν ἐκ νεκρῶν."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἐβουλεύσαντο δὲ οἱ ἀρχιερεῖς ἵνα καὶ τὸν Λάζαρον ἀποκτείνωσιν,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ὅτι πολλοὶ διʼ αὐτὸν ὑπῆγον τῶν Ἰουδαίων καὶ ἐπίστευον εἰς τὸν Ἰησοῦν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Τῇ ἐπαύριον ⸀ὁ",
          {
            "noteId": 435
          },
          "ὄχλος πολὺς ὁ ἐλθὼν εἰς τὴν ἑορτήν, ἀκούσαντες ὅτι ἔρχεται ⸁ὁ",
          {
            "noteId": 436
          },
          "Ἰησοῦς εἰς Ἱεροσόλυμα,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ἔλαβον τὰ βαΐα τῶν φοινίκων καὶ ἐξῆλθον εἰς ὑπάντησιν αὐτῷ, καὶ ⸀ἐκραύγαζον",
          {
            "noteId": 437
          },
          "Ὡσαννά, εὐλογημένος ὁ ἐρχόμενος ἐν ὀνόματι κυρίου, ⸂καὶ ὁ",
          {
            "noteId": 438
          },
          "βασιλεὺς τοῦ Ἰσραήλ."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "εὑρὼν δὲ ὁ Ἰησοῦς ὀνάριον ἐκάθισεν ἐπʼ αὐτό, καθώς ἐστιν γεγραμμένον·"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Μὴ φοβοῦ, θυγάτηρ Σιών· ἰδοὺ ὁ βασιλεύς σου ἔρχεται, καθήμενος ἐπὶ πῶλον ὄνου."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "⸀ταῦτα",
          {
            "noteId": 439
          },
          "οὐκ ἔγνωσαν ⸂αὐτοῦ οἱ μαθηταὶ",
          {
            "noteId": 440
          },
          "τὸ πρῶτον, ἀλλʼ ὅτε ἐδοξάσθη Ἰησοῦς τότε ἐμνήσθησαν ὅτι ταῦτα ἦν ἐπʼ αὐτῷ γεγραμμένα καὶ ταῦτα ἐποίησαν αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ἐμαρτύρει οὖν ὁ ὄχλος ὁ ὢν μετʼ αὐτοῦ ὅτε τὸν Λάζαρον ἐφώνησεν ἐκ τοῦ μνημείου καὶ ἤγειρεν αὐτὸν ἐκ νεκρῶν."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "διὰ τοῦτο ⸀καὶ",
          {
            "noteId": 441
          },
          "ὑπήντησεν αὐτῷ ὁ ὄχλος ὅτι ⸀ἤκουσαν",
          {
            "noteId": 442
          },
          "τοῦτο αὐτὸν πεποιηκέναι τὸ σημεῖον."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "οἱ οὖν Φαρισαῖοι εἶπαν πρὸς ἑαυτούς· Θεωρεῖτε ὅτι οὐκ ὠφελεῖτε οὐδέν· ἴδε ὁ ⸀κόσμος",
          {
            "noteId": 443
          },
          "ὀπίσω αὐτοῦ ἀπῆλθεν."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Ἦσαν δὲ ⸂Ἕλληνές τινες",
          {
            "noteId": 444
          },
          "ἐκ τῶν ἀναβαινόντων ἵνα προσκυνήσωσιν ἐν τῇ ἑορτῇ·"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "οὗτοι οὖν προσῆλθον Φιλίππῳ τῷ ἀπὸ Βηθσαϊδὰ τῆς Γαλιλαίας, καὶ ἠρώτων αὐτὸν λέγοντες· Κύριε, θέλομεν τὸν Ἰησοῦν ἰδεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ἔρχεται ⸀ὁ",
          {
            "noteId": 445
          },
          "Φίλιππος καὶ λέγει τῷ Ἀνδρέᾳ· ⸀ἔρχεται",
          {
            "noteId": 446
          },
          "Ἀνδρέας καὶ",
          {
            "noteId": 447
          },
          "Φίλιππος ⸀καὶ λέγουσιν τῷ Ἰησοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ὁ δὲ Ἰησοῦς ⸀ἀποκρίνεται",
          {
            "noteId": 448
          },
          "αὐτοῖς λέγων· Ἐλήλυθεν ἡ ὥρα ἵνα δοξασθῇ ὁ υἱὸς τοῦ ἀνθρώπου."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ἀμὴν ἀμὴν λέγω ὑμῖν, ἐὰν μὴ ὁ κόκκος τοῦ σίτου πεσὼν εἰς τὴν γῆν ἀποθάνῃ, αὐτὸς μόνος μένει· ἐὰν δὲ ἀποθάνῃ, πολὺν καρπὸν φέρει."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ὁ φιλῶν τὴν ψυχὴν αὐτοῦ ⸀ἀπολλύει",
          {
            "noteId": 449
          },
          "αὐτήν, καὶ ὁ μισῶν τὴν ψυχὴν αὐτοῦ ἐν τῷ κόσμῳ τούτῳ εἰς ζωὴν αἰώνιον φυλάξει αὐτήν."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ἐὰν ἐμοί ⸂τις διακονῇ",
          {
            "noteId": 450
          },
          "ἐμοὶ ἀκολουθείτω, καὶ ὅπου εἰμὶ ἐγὼ ἐκεῖ καὶ ὁ διάκονος ὁ ἐμὸς ἔσται· ⸀ἐάν",
          {
            "noteId": 451
          },
          "τις ἐμοὶ διακονῇ τιμήσει αὐτὸν ὁ πατήρ."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Νῦν ἡ ψυχή μου τετάρακται, καὶ τί εἴπω; πάτερ, σῶσόν με ἐκ τῆς ὥρας ταύτης. ἀλλὰ διὰ τοῦτο ἦλθον εἰς τὴν ὥραν ταύτην."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "πάτερ, δόξασόν σου τὸ ὄνομα. ἦλθεν οὖν φωνὴ ἐκ τοῦ οὐρανοῦ· Καὶ ἐδόξασα καὶ πάλιν δοξάσω."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "ὁ οὖν ὄχλος ὁ ἑστὼς καὶ ἀκούσας ἔλεγεν βροντὴν γεγονέναι· ἄλλοι ἔλεγον· Ἄγγελος αὐτῷ λελάληκεν."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ἀπεκρίθη ⸂Ἰησοῦς καὶ εἶπεν",
          {
            "noteId": 452
          },
          "· Οὐ διʼ ἐμὲ ⸂ἡ φωνὴ αὕτη",
          {
            "noteId": 453
          },
          "γέγονεν ἀλλὰ διʼ ὑμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "νῦν κρίσις ἐστὶν τοῦ κόσμου τούτου, νῦν ὁ ἄρχων τοῦ κόσμου τούτου ἐκβληθήσεται ἔξω·"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "κἀγὼ ⸀ἐὰν",
          {
            "noteId": 454
          },
          "ὑψωθῶ ἐκ τῆς γῆς, πάντας ἑλκύσω πρὸς ἐμαυτόν."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "τοῦτο δὲ ἔλεγεν σημαίνων ποίῳ θανάτῳ ἤμελλεν ἀποθνῄσκειν."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "ἀπεκρίθη ⸀οὖν",
          {
            "noteId": 455
          },
          "αὐτῷ ὁ ὄχλος· Ἡμεῖς ἠκούσαμεν ἐκ τοῦ νόμου ὅτι ὁ χριστὸς μένει εἰς τὸν αἰῶνα, καὶ πῶς ⸂λέγεις σὺ",
          {
            "noteId": 456
          },
          "⸀ὅτι",
          {
            "noteId": 457
          },
          "δεῖ ὑψωθῆναι τὸν υἱὸν τοῦ ἀνθρώπου; τίς ἐστιν οὗτος ὁ υἱὸς τοῦ ἀνθρώπου;"
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "εἶπεν οὖν αὐτοῖς ὁ Ἰησοῦς· Ἔτι μικρὸν χρόνον τὸ φῶς ⸂ἐν ὑμῖν",
          {
            "noteId": 458
          },
          "ἐστιν. περιπατεῖτε ⸀ὡς",
          {
            "noteId": 459
          },
          "τὸ φῶς ἔχετε, ἵνα μὴ σκοτία ὑμᾶς καταλάβῃ, καὶ ὁ περιπατῶν ἐν τῇ σκοτίᾳ οὐκ οἶδεν ποῦ ὑπάγει."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "⸀ὡς",
          {
            "noteId": 460
          },
          "τὸ φῶς ἔχετε, πιστεύετε εἰς τὸ φῶς, ἵνα υἱοὶ φωτὸς γένησθε.",
          {
            "noteId": 461
          },
          "Ταῦτα ⸀ἐλάλησεν Ἰησοῦς, καὶ ἀπελθὼν ἐκρύβη ἀπʼ αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "τοσαῦτα δὲ αὐτοῦ σημεῖα πεποιηκότος ἔμπροσθεν αὐτῶν οὐκ ἐπίστευον εἰς αὐτόν,"
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "ἵνα ὁ λόγος Ἠσαΐου τοῦ προφήτου πληρωθῇ ὃν εἶπεν· Κύριε, τίς ἐπίστευσεν τῇ ἀκοῇ ἡμῶν; καὶ ὁ βραχίων κυρίου τίνι ἀπεκαλύφθη;"
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "διὰ τοῦτο οὐκ ἠδύναντο πιστεύειν ὅτι πάλιν εἶπεν Ἠσαΐας·"
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "Τετύφλωκεν αὐτῶν τοὺς ὀφθαλμοὺς καὶ ⸀ἐπώρωσεν",
          {
            "noteId": 462
          },
          "αὐτῶν τὴν καρδίαν, ἵνα μὴ ἴδωσιν τοῖς ὀφθαλμοῖς καὶ νοήσωσιν τῇ καρδίᾳ καὶ ⸀στραφῶσιν",
          {
            "noteId": 463
          },
          "καὶ ⸀ἰάσομαι",
          {
            "noteId": 464
          },
          "αὐτούς."
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "ταῦτα εἶπεν Ἠσαΐας ⸀ὅτι",
          {
            "noteId": 465
          },
          "εἶδεν τὴν δόξαν αὐτοῦ, καὶ ἐλάλησεν περὶ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "ὅμως μέντοι καὶ ἐκ τῶν ἀρχόντων πολλοὶ ἐπίστευσαν εἰς αὐτόν, ἀλλὰ διὰ τοὺς Φαρισαίους οὐχ ὡμολόγουν ἵνα μὴ ἀποσυνάγωγοι γένωνται,"
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "ἠγάπησαν γὰρ τὴν δόξαν τῶν ἀνθρώπων μᾶλλον ἤπερ τὴν δόξαν τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "Ἰησοῦς δὲ ἔκραξεν καὶ εἶπεν· Ὁ πιστεύων εἰς ἐμὲ οὐ πιστεύει εἰς ἐμὲ ἀλλὰ εἰς τὸν πέμψαντά με,"
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "καὶ ὁ θεωρῶν ἐμὲ θεωρεῖ τὸν πέμψαντά με."
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "ἐγὼ φῶς εἰς τὸν κόσμον ἐλήλυθα, ἵνα πᾶς ὁ πιστεύων εἰς ἐμὲ ἐν τῇ σκοτίᾳ μὴ μείνῃ."
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          "καὶ ἐάν τίς μου ἀκούσῃ τῶν ῥημάτων καὶ μὴ ⸀φυλάξῃ",
          {
            "noteId": 466
          },
          "ἐγὼ οὐ κρίνω αὐτόν, οὐ γὰρ ἦλθον ἵνα κρίνω τὸν κόσμον ἀλλʼ ἵνα σώσω τὸν κόσμον."
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          "ὁ ἀθετῶν ἐμὲ καὶ μὴ λαμβάνων τὰ ῥήματά μου ἔχει τὸν κρίνοντα αὐτόν· ὁ λόγος ὃν ἐλάλησα ἐκεῖνος κρινεῖ αὐτὸν ἐν τῇ ἐσχάτῃ ἡμέρᾳ·"
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          "ὅτι ἐγὼ ἐξ ἐμαυτοῦ οὐκ ἐλάλησα, ἀλλʼ ὁ πέμψας με πατὴρ αὐτός μοι ἐντολὴν ⸀δέδωκεν",
          {
            "noteId": 467
          },
          "τί εἴπω καὶ τί λαλήσω."
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          "καὶ οἶδα ὅτι ἡ ἐντολὴ αὐτοῦ ζωὴ αἰώνιός ἐστιν. ἃ οὖν ⸂ἐγὼ λαλῶ",
          {
            "noteId": 468
          },
          ", καθὼς εἴρηκέν μοι ὁ πατήρ, οὕτως λαλῶ."
        ]
      }
    ],
