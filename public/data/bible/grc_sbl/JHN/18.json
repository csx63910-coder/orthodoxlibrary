  "chapter": {
    "number": 18,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ταῦτα ⸀εἰπὼν",
          {
            "noteId": 625
          },
          "Ἰησοῦς ἐξῆλθεν σὺν τοῖς μαθηταῖς αὐτοῦ",
          {
            "noteId": 626
          },
          "πέραν τοῦ χειμάρρου ⸀τοῦ Κεδρὼν ὅπου ἦν κῆπος, εἰς ὃν εἰσῆλθεν αὐτὸς καὶ οἱ μαθηταὶ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ᾔδει δὲ καὶ Ἰούδας ὁ παραδιδοὺς αὐτὸν τὸν τόπον, ὅτι πολλάκις ⸀συνήχθη",
          {
            "noteId": 627
          },
          "Ἰησοῦς ἐκεῖ μετὰ τῶν μαθητῶν αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ὁ οὖν Ἰούδας λαβὼν τὴν σπεῖραν καὶ ἐκ τῶν",
          {
            "noteId": 628
          },
          "ἀρχιερέων καὶ ⸂ἐκ τῶν⸃ Φαρισαίων ὑπηρέτας ἔρχεται ἐκεῖ μετὰ φανῶν καὶ λαμπάδων καὶ ὅπλων."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Ἰησοῦς ⸀οὖν",
          {
            "noteId": 629
          },
          "εἰδὼς πάντα τὰ ἐρχόμενα ἐπʼ αὐτὸν ⸂ἐξῆλθεν, καὶ λέγει⸃ αὐτοῖς· Τίνα ζητεῖτε;",
          {
            "noteId": 630
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἀπεκρίθησαν αὐτῷ· Ἰησοῦν τὸν Ναζωραῖον. λέγει ⸀αὐτοῖς",
          {
            "noteId": 631
          },
          "Ἐγώ εἰμι. εἱστήκει δὲ καὶ Ἰούδας ὁ παραδιδοὺς αὐτὸν μετʼ αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ὡς οὖν εἶπεν ⸀αὐτοῖς",
          {
            "noteId": 632
          },
          "Ἐγώ εἰμι, ἀπῆλθον εἰς τὰ ὀπίσω καὶ ἔπεσαν χαμαί."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "πάλιν οὖν ⸂ἐπηρώτησεν αὐτούς",
          {
            "noteId": 633
          },
          "· Τίνα ζητεῖτε; οἱ δὲ εἶπαν· Ἰησοῦν τὸν Ναζωραῖον."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἀπεκρίθη Ἰησοῦς· Εἶπον ὑμῖν ὅτι ἐγώ εἰμι· εἰ οὖν ἐμὲ ζητεῖτε, ἄφετε τούτους ὑπάγειν·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ἵνα πληρωθῇ ὁ λόγος ὃν εἶπεν ὅτι Οὓς δέδωκάς μοι οὐκ ἀπώλεσα ἐξ αὐτῶν οὐδένα."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Σίμων οὖν Πέτρος ἔχων μάχαιραν εἵλκυσεν αὐτὴν καὶ ἔπαισεν τὸν τοῦ ἀρχιερέως δοῦλον καὶ ἀπέκοψεν αὐτοῦ τὸ ⸀ὠτάριον",
          {
            "noteId": 634
          },
          "τὸ δεξιόν. ἦν δὲ ὄνομα τῷ δούλῳ Μάλχος."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "εἶπεν οὖν ὁ Ἰησοῦς τῷ Πέτρῳ· Βάλε τὴν ⸀μάχαιραν",
          {
            "noteId": 635
          },
          "εἰς τὴν θήκην· τὸ ποτήριον ὃ δέδωκέν μοι ὁ πατὴρ οὐ μὴ πίω αὐτό;"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ἡ οὖν σπεῖρα καὶ ὁ χιλίαρχος καὶ οἱ ὑπηρέται τῶν Ἰουδαίων συνέλαβον τὸν Ἰησοῦν καὶ ἔδησαν αὐτὸν"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ ⸀ἤγαγον",
          {
            "noteId": 636
          },
          "πρὸς Ἅνναν πρῶτον· ἦν γὰρ πενθερὸς τοῦ Καϊάφα, ὃς ἦν ἀρχιερεὺς τοῦ ἐνιαυτοῦ ἐκείνου·"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἦν δὲ Καϊάφας ὁ συμβουλεύσας τοῖς Ἰουδαίοις ὅτι συμφέρει ἕνα ἄνθρωπον ⸀ἀποθανεῖν",
          {
            "noteId": 637
          },
          "ὑπὲρ τοῦ λαοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Ἠκολούθει δὲ τῷ Ἰησοῦ Σίμων Πέτρος ⸀καὶ",
          {
            "noteId": 638
          },
          "ἄλλος μαθητής. ὁ δὲ μαθητὴς ἐκεῖνος ἦν γνωστὸς τῷ ἀρχιερεῖ καὶ συνεισῆλθεν τῷ Ἰησοῦ εἰς τὴν αὐλὴν τοῦ ἀρχιερέως,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ὁ",
          {
            "noteId": 639
          },
          "δὲ Πέτρος εἱστήκει πρὸς τῇ θύρᾳ ἔξω. ἐξῆλθεν οὖν ὁ μαθητὴς ὁ ἄλλος ⸀ὁ γνωστὸς ⸂τοῦ ἀρχιερέως",
          {
            "noteId": 640
          },
          "καὶ εἶπεν τῇ θυρωρῷ καὶ εἰσήγαγεν τὸν Πέτρον."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "λέγει οὖν ⸂τῷ Πέτρῳ ἡ παιδίσκη ἡ θυρωρός",
          {
            "noteId": 641
          },
          "· Μὴ καὶ σὺ ἐκ τῶν μαθητῶν εἶ τοῦ ἀνθρώπου τούτου; λέγει ἐκεῖνος· Οὐκ εἰμί."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "εἱστήκεισαν δὲ οἱ δοῦλοι καὶ οἱ ὑπηρέται ἀνθρακιὰν πεποιηκότες, ὅτι ψῦχος ἦν, καὶ ἐθερμαίνοντο· ἦν δὲ ⸂καὶ ὁ Πέτρος μετʼ αὐτῶν",
          {
            "noteId": 642
          },
          "ἑστὼς καὶ θερμαινόμενος."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Ὁ οὖν ἀρχιερεὺς ἠρώτησεν τὸν Ἰησοῦν περὶ τῶν μαθητῶν αὐτοῦ καὶ περὶ τῆς διδαχῆς αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἀπεκρίθη ⸀αὐτῷ",
          {
            "noteId": 643
          },
          "Ἰησοῦς· Ἐγὼ παρρησίᾳ ⸀λελάληκα",
          {
            "noteId": 644
          },
          "τῷ κόσμῳ· ἐγὼ πάντοτε ἐδίδαξα ἐν συναγωγῇ καὶ ἐν τῷ ἱερῷ, ὅπου ⸀πάντες",
          {
            "noteId": 645
          },
          "οἱ Ἰουδαῖοι συνέρχονται, καὶ ἐν κρυπτῷ ἐλάλησα οὐδέν·"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "τί με ⸂ἐρωτᾷς; ἐρώτησον",
          {
            "noteId": 646
          },
          "τοὺς ἀκηκοότας τί ἐλάλησα αὐτοῖς· ἴδε οὗτοι οἴδασιν ἃ εἶπον ἐγώ."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ταῦτα δὲ αὐτοῦ εἰπόντος εἷς ⸂παρεστηκὼς τῶν ὑπηρετῶν",
          {
            "noteId": 647
          },
          "ἔδωκεν ῥάπισμα τῷ Ἰησοῦ εἰπών· Οὕτως ἀποκρίνῃ τῷ ἀρχιερεῖ;"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ἀπεκρίθη ⸀αὐτῷ",
          {
            "noteId": 648
          },
          "Ἰησοῦς· Εἰ κακῶς ἐλάλησα, μαρτύρησον περὶ τοῦ κακοῦ· εἰ δὲ καλῶς, τί με δέρεις;"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ἀπέστειλεν ⸀οὖν",
          {
            "noteId": 649
          },
          "αὐτὸν ὁ Ἅννας δεδεμένον πρὸς Καϊάφαν τὸν ἀρχιερέα."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Ἦν δὲ Σίμων Πέτρος ἑστὼς καὶ θερμαινόμενος. εἶπον οὖν αὐτῷ· Μὴ καὶ σὺ ἐκ τῶν μαθητῶν αὐτοῦ εἶ; ⸀ἠρνήσατο",
          {
            "noteId": 650
          },
          "ἐκεῖνος καὶ εἶπεν· Οὐκ εἰμί."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "λέγει εἷς ἐκ τῶν δούλων τοῦ ἀρχιερέως, συγγενὴς ὢν οὗ ἀπέκοψεν Πέτρος τὸ ὠτίον· Οὐκ ἐγώ σε εἶδον ἐν τῷ κήπῳ μετʼ αὐτοῦ;"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "πάλιν οὖν ⸀ἠρνήσατο",
          {
            "noteId": 651
          },
          "Πέτρος· καὶ εὐθέως ἀλέκτωρ ἐφώνησεν."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Ἄγουσιν οὖν τὸν Ἰησοῦν ἀπὸ τοῦ Καϊάφα εἰς τὸ πραιτώριον· ἦν δὲ πρωΐ· καὶ αὐτοὶ οὐκ εἰσῆλθον εἰς τὸ πραιτώριον, ἵνα μὴ μιανθῶσιν ⸀ἀλλὰ",
          {
            "noteId": 652
          },
          "φάγωσιν τὸ πάσχα."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "ἐξῆλθεν οὖν ὁ Πιλᾶτος ⸀ἔξω",
          {
            "noteId": 653
          },
          "πρὸς αὐτοὺς καὶ ⸀φησίν",
          {
            "noteId": 654
          },
          "Τίνα κατηγορίαν φέρετε ⸀κατὰ",
          {
            "noteId": 655
          },
          "τοῦ ἀνθρώπου τούτου;"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ἀπεκρίθησαν καὶ εἶπαν αὐτῷ· Εἰ μὴ ἦν οὗτος ⸂κακὸν ποιῶν",
          {
            "noteId": 656
          },
          ", οὐκ ἄν σοι παρεδώκαμεν αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "εἶπεν οὖν αὐτοῖς ⸀ὁ",
          {
            "noteId": 657
          },
          "Πιλᾶτος· Λάβετε αὐτὸν ὑμεῖς, καὶ κατὰ τὸν νόμον ὑμῶν κρίνατε αὐτόν. ⸀εἶπον",
          {
            "noteId": 658
          },
          "αὐτῷ οἱ Ἰουδαῖοι· Ἡμῖν οὐκ ἔξεστιν ἀποκτεῖναι οὐδένα·"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "ἵνα ὁ λόγος τοῦ Ἰησοῦ πληρωθῇ ὃν εἶπεν σημαίνων ποίῳ θανάτῳ ἤμελλεν ἀποθνῄσκειν."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "Εἰσῆλθεν οὖν ⸂πάλιν εἰς τὸ πραιτώριον",
          {
            "noteId": 659
          },
          "ὁ Πιλᾶτος καὶ ἐφώνησεν τὸν Ἰησοῦν καὶ εἶπεν αὐτῷ· Σὺ εἶ ὁ βασιλεὺς τῶν Ἰουδαίων;"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "⸀ἀπεκρίθη",
          {
            "noteId": 660
          },
          "Ἰησοῦς· ⸂Ἀπὸ σεαυτοῦ",
          {
            "noteId": 661
          },
          "σὺ τοῦτο λέγεις ἢ ἄλλοι ⸂εἶπόν σοι",
          {
            "noteId": 662
          },
          "περὶ ἐμοῦ;"
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "ἀπεκρίθη ὁ Πιλᾶτος· Μήτι ἐγὼ Ἰουδαῖός εἰμι; τὸ ἔθνος τὸ σὸν καὶ οἱ ἀρχιερεῖς παρέδωκάν σε ἐμοί· τί ἐποίησας;"
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "ἀπεκρίθη Ἰησοῦς· Ἡ βασιλεία ἡ ἐμὴ οὐκ ἔστιν ἐκ τοῦ κόσμου τούτου· εἰ ἐκ τοῦ κόσμου τούτου ἦν ἡ βασιλεία ἡ ἐμή, οἱ ὑπηρέται ⸂οἱ ἐμοὶ ἠγωνίζοντο ἄν",
          {
            "noteId": 663
          },
          ", ἵνα μὴ παραδοθῶ τοῖς Ἰουδαίοις· νῦν δὲ ἡ βασιλεία ἡ ἐμὴ οὐκ ἔστιν ἐντεῦθεν."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "εἶπεν οὖν αὐτῷ ὁ",
          {
            "noteId": 664
          },
          "Πιλᾶτος· Οὐκοῦν βασιλεὺς εἶ σύ; ἀπεκρίθη ⸀ὁ Ἰησοῦς· Σὺ λέγεις ὅτι βασιλεύς ⸀εἰμι",
          {
            "noteId": 665
          },
          "ἐγὼ εἰς τοῦτο γεγέννημαι καὶ εἰς τοῦτο ἐλήλυθα εἰς τὸν κόσμον ἵνα μαρτυρήσω τῇ ἀληθείᾳ· πᾶς ὁ ὢν ἐκ τῆς ἀληθείας ἀκούει μου τῆς φωνῆς."
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "λέγει αὐτῷ ὁ Πιλᾶτος· Τί ἐστιν ἀλήθεια; Καὶ τοῦτο εἰπὼν πάλιν ἐξῆλθεν πρὸς τοὺς Ἰουδαίους, καὶ λέγει αὐτοῖς· Ἐγὼ οὐδεμίαν ⸂εὑρίσκω ἐν αὐτῷ αἰτίαν",
          {
            "noteId": 666
          },
          "·"
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "ἔστιν δὲ συνήθεια ὑμῖν ἵνα ἕνα ⸂ἀπολύσω ὑμῖν⸃",
          {
            "noteId": 667
          },
          "ἐν τῷ πάσχα· βούλεσθε οὖν ⸄ἀπολύσω ὑμῖν⸅",
          {
            "noteId": 668
          },
          "τὸν βασιλέα τῶν Ἰουδαίων;"
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "ἐκραύγασαν οὖν ⸀πάλιν",
          {
            "noteId": 669
          },
          "λέγοντες· Μὴ τοῦτον ἀλλὰ τὸν Βαραββᾶν. ἦν δὲ ὁ Βαραββᾶς λῃστής."
        ]
      }
    ],
