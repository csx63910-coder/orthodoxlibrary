  "chapter": {
    "number": 9,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ παράγων εἶδεν ἄνθρωπον τυφλὸν ἐκ γενετῆς."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ ἠρώτησαν αὐτὸν οἱ μαθηταὶ αὐτοῦ λέγοντες· Ῥαββί, τίς ἥμαρτεν, οὗτος ἢ οἱ γονεῖς αὐτοῦ, ἵνα τυφλὸς γεννηθῇ;"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἀπεκρίθη Ἰησοῦς· Οὔτε οὗτος ἥμαρτεν οὔτε οἱ γονεῖς αὐτοῦ, ἀλλʼ ἵνα φανερωθῇ τὰ ἔργα τοῦ θεοῦ ἐν αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "⸀ἡμᾶς",
          {
            "noteId": 296
          },
          "δεῖ ἐργάζεσθαι τὰ ἔργα τοῦ πέμψαντός με ἕως ἡμέρα ἐστίν· ἔρχεται νὺξ ὅτε οὐδεὶς δύναται ἐργάζεσθαι."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ὅταν ἐν τῷ κόσμῳ ὦ, φῶς εἰμι τοῦ κόσμου."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ταῦτα εἰπὼν ἔπτυσεν χαμαὶ καὶ ἐποίησεν πηλὸν ἐκ τοῦ πτύσματος, καὶ ⸀ἐπέχρισεν",
          {
            "noteId": 297
          },
          "⸀αὐτοῦ",
          {
            "noteId": 298
          },
          "τὸν πηλὸν ἐπὶ τοὺς ⸀ὀφθαλμούς",
          {
            "noteId": 299
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "καὶ εἶπεν αὐτῷ· Ὕπαγε νίψαι εἰς τὴν κολυμβήθραν τοῦ Σιλωάμ (ὃ ἑρμηνεύεται Ἀπεσταλμένος). ἀπῆλθεν οὖν καὶ ἐνίψατο, καὶ ἦλθεν βλέπων."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "οἱ οὖν γείτονες καὶ οἱ θεωροῦντες αὐτὸν τὸ πρότερον ὅτι ⸀προσαίτης",
          {
            "noteId": 300
          },
          "ἦν ἔλεγον· Οὐχ οὗτός ἐστιν ὁ καθήμενος καὶ προσαιτῶν;"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ἄλλοι ἔλεγον ὅτι Οὗτός ἐστιν· ἄλλοι ⸂ἔλεγον· Οὐχί, ἀλλὰ⸃ ὅμοιος αὐτῷ ἐστιν. ἐκεῖνος ἔλεγεν ὅτι Ἐγώ εἰμι.",
          {
            "noteId": 301
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἔλεγον οὖν αὐτῷ· ⸀Πῶς",
          {
            "noteId": 302
          },
          "ἠνεῴχθησάν σου οἱ ὀφθαλμοί;"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ἀπεκρίθη ⸀ἐκεῖνος",
          {
            "noteId": 303
          },
          "⸂Ὁ ἄνθρωπος ὁ",
          {
            "noteId": 304
          },
          "λεγόμενος Ἰησοῦς πηλὸν ἐποίησεν καὶ ἐπέχρισέν μου τοὺς ὀφθαλμοὺς καὶ εἶπέν μοι ⸀ὅτι",
          {
            "noteId": 305
          },
          "Ὕπαγε εἰς ⸀τὸν",
          {
            "noteId": 306
          },
          "Σιλωὰμ καὶ νίψαι· ἀπελθὼν ⸀οὖν",
          {
            "noteId": 307
          },
          "καὶ νιψάμενος ἀνέβλεψα."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "⸂καὶ εἶπαν",
          {
            "noteId": 308
          },
          "αὐτῷ· Ποῦ ἐστιν ἐκεῖνος; λέγει· Οὐκ οἶδα."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ἄγουσιν αὐτὸν πρὸς τοὺς Φαρισαίους τόν ποτε τυφλόν."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἦν δὲ σάββατον ⸂ἐν ᾗ ἡμέρᾳ",
          {
            "noteId": 309
          },
          "τὸν πηλὸν ἐποίησεν ὁ Ἰησοῦς καὶ ἀνέῳξεν αὐτοῦ τοὺς ὀφθαλμούς."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "πάλιν οὖν ἠρώτων αὐτὸν καὶ οἱ Φαρισαῖοι πῶς ἀνέβλεψεν. ὁ δὲ εἶπεν αὐτοῖς· Πηλὸν ἐπέθηκέν μου ἐπὶ τοὺς ὀφθαλμούς, καὶ ἐνιψάμην, καὶ βλέπω."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ἔλεγον οὖν ἐκ τῶν Φαρισαίων τινές· ⸂Οὐκ ἔστιν οὗτος παρὰ θεοῦ ὁ ἄνθρωπος",
          {
            "noteId": 310
          },
          ", ὅτι τὸ σάββατον οὐ τηρεῖ. ⸀ἄλλοι",
          {
            "noteId": 311
          },
          "ἔλεγον· Πῶς δύναται ἄνθρωπος ἁμαρτωλὸς τοιαῦτα σημεῖα ποιεῖν; καὶ σχίσμα ἦν ἐν αὐτοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "λέγουσιν ⸀οὖν",
          {
            "noteId": 312
          },
          "τῷ τυφλῷ πάλιν· ⸂Τί σὺ",
          {
            "noteId": 313
          },
          "λέγεις περὶ αὐτοῦ, ὅτι ἠνέῳξέν σου τοὺς ὀφθαλμούς; ὁ δὲ εἶπεν ὅτι Προφήτης ἐστίν."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Οὐκ ἐπίστευσαν οὖν οἱ Ἰουδαῖοι περὶ αὐτοῦ ὅτι ⸂ἦν τυφλὸς",
          {
            "noteId": 314
          },
          "καὶ ἀνέβλεψεν, ἕως ὅτου ἐφώνησαν τοὺς γονεῖς αὐτοῦ ⸂τοῦ ἀναβλέψαντος",
          {
            "noteId": 315
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "καὶ ἠρώτησαν αὐτοὺς λέγοντες· Οὗτός ἐστιν ὁ υἱὸς ὑμῶν, ὃν ὑμεῖς λέγετε ὅτι τυφλὸς ἐγεννήθη; πῶς οὖν ⸂βλέπει ἄρτι",
          {
            "noteId": 316
          },
          ";"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἀπεκρίθησαν ⸀οὖν",
          {
            "noteId": 317
          },
          "οἱ γονεῖς αὐτοῦ καὶ εἶπαν· Οἴδαμεν ὅτι οὗτός ἐστιν ὁ υἱὸς ἡμῶν καὶ ὅτι τυφλὸς ἐγεννήθη·"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "πῶς δὲ νῦν βλέπει οὐκ οἴδαμεν, ἢ τίς ἤνοιξεν αὐτοῦ τοὺς ὀφθαλμοὺς ἡμεῖς οὐκ οἴδαμεν· ⸂αὐτὸν ἐρωτήσατε, ἡλικίαν ἔχει⸃, αὐτὸς περὶ ἑαυτοῦ λαλήσει.",
          {
            "noteId": 318
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ταῦτα εἶπαν οἱ γονεῖς αὐτοῦ ὅτι ἐφοβοῦντο τοὺς Ἰουδαίους, ἤδη γὰρ συνετέθειντο οἱ Ἰουδαῖοι ἵνα ἐάν τις αὐτὸν ὁμολογήσῃ χριστόν, ἀποσυνάγωγος γένηται."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "διὰ τοῦτο οἱ γονεῖς αὐτοῦ εἶπαν ὅτι Ἡλικίαν ἔχει, αὐτὸν ⸀ἐπερωτήσατε",
          {
            "noteId": 319
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Ἐφώνησαν οὖν ⸂τὸν ἄνθρωπον ἐκ δευτέρου",
          {
            "noteId": 320
          },
          "ὃς ἦν τυφλὸς καὶ εἶπαν αὐτῷ· Δὸς δόξαν τῷ θεῷ· ἡμεῖς οἴδαμεν ὅτι ⸂οὗτος ὁ ἄνθρωπος",
          {
            "noteId": 321
          },
          "ἁμαρτωλός ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ἀπεκρίθη οὖν ⸀ἐκεῖνος",
          {
            "noteId": 322
          },
          "Εἰ ἁμαρτωλός ἐστιν οὐκ οἶδα· ἓν οἶδα ὅτι τυφλὸς ὢν ἄρτι βλέπω."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "εἶπον ⸂οὖν αὐτῷ",
          {
            "noteId": 323
          },
          "· Τί ἐποίησέν σοι; πῶς ἤνοιξέν σου τοὺς ὀφθαλμούς;"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "ἀπεκρίθη αὐτοῖς· Εἶπον ὑμῖν ἤδη καὶ οὐκ ἠκούσατε· τί πάλιν θέλετε ἀκούειν; μὴ καὶ ὑμεῖς θέλετε αὐτοῦ μαθηταὶ γενέσθαι;"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "⸀ἐλοιδόρησαν",
          {
            "noteId": 324
          },
          "αὐτὸν καὶ εἶπον· Σὺ ⸂μαθητὴς εἶ",
          {
            "noteId": 325
          },
          "ἐκείνου, ἡμεῖς δὲ τοῦ Μωϋσέως ἐσμὲν μαθηταί·"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "ἡμεῖς οἴδαμεν ὅτι Μωϋσεῖ λελάληκεν ὁ θεός, τοῦτον δὲ οὐκ οἴδαμεν πόθεν ἐστίν."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ἀπεκρίθη ὁ ἄνθρωπος καὶ εἶπεν αὐτοῖς· Ἐν ⸂τούτῳ γὰρ τὸ",
          {
            "noteId": 326
          },
          "θαυμαστόν ἐστιν ὅτι ὑμεῖς οὐκ οἴδατε πόθεν ἐστίν, καὶ ἤνοιξέν μου τοὺς ὀφθαλμούς."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "⸀οἴδαμεν",
          {
            "noteId": 327
          },
          "ὅτι ⸂ἁμαρτωλῶν ὁ θεὸς",
          {
            "noteId": 328
          },
          "οὐκ ἀκούει, ἀλλʼ ἐάν τις θεοσεβὴς ᾖ καὶ τὸ θέλημα αὐτοῦ ποιῇ τούτου ἀκούει."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "ἐκ τοῦ αἰῶνος οὐκ ἠκούσθη ὅτι ἠνέῳξέν τις ὀφθαλμοὺς τυφλοῦ γεγεννημένου·"
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "εἰ μὴ ἦν οὗτος παρὰ θεοῦ, οὐκ ἠδύνατο ποιεῖν οὐδέν."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "ἀπεκρίθησαν καὶ εἶπαν αὐτῷ· Ἐν ἁμαρτίαις σὺ ἐγεννήθης ὅλος, καὶ σὺ διδάσκεις ἡμᾶς; καὶ ἐξέβαλον αὐτὸν ἔξω."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "⸀Ἤκουσεν",
          {
            "noteId": 329
          },
          "Ἰησοῦς ὅτι ἐξέβαλον αὐτὸν ἔξω, καὶ εὑρὼν αὐτὸν ⸀εἶπεν",
          {
            "noteId": 330
          },
          "Σὺ πιστεύεις εἰς τὸν υἱὸν τοῦ ⸀ἀνθρώπου",
          {
            "noteId": 331
          }
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "ἀπεκρίθη ἐκεῖνος καὶ εἶπεν· Καὶ τίς ἐστιν, κύριε, ἵνα πιστεύσω εἰς αὐτόν;"
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "⸀εἶπεν",
          {
            "noteId": 332
          },
          "αὐτῷ ὁ Ἰησοῦς· Καὶ ἑώρακας αὐτὸν καὶ ὁ λαλῶν μετὰ σοῦ ἐκεῖνός ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "ὁ δὲ ἔφη· Πιστεύω, κύριε· καὶ προσεκύνησεν αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "καὶ εἶπεν ὁ Ἰησοῦς· Εἰς κρίμα ἐγὼ εἰς τὸν κόσμον τοῦτον ἦλθον, ἵνα οἱ μὴ βλέποντες βλέπωσιν καὶ οἱ βλέποντες τυφλοὶ γένωνται."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "⸀ἤκουσαν",
          {
            "noteId": 333
          },
          "ἐκ τῶν Φαρισαίων ταῦτα οἱ ⸂μετʼ αὐτοῦ ὄντες",
          {
            "noteId": 334
          },
          ", καὶ εἶπον αὐτῷ· Μὴ καὶ ἡμεῖς τυφλοί ἐσμεν;"
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "εἶπεν αὐτοῖς ὁ Ἰησοῦς· Εἰ τυφλοὶ ἦτε, οὐκ ἂν εἴχετε ἁμαρτίαν· νῦν δὲ λέγετε ὅτι Βλέπομεν· ⸀ἡ",
          {
            "noteId": 335
          },
          "ἁμαρτία ὑμῶν μένει."
        ]
      }
    ],
