  "chapter": {
    "number": 14,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Μὴ ταρασσέσθω ὑμῶν ἡ καρδία· πιστεύετε εἰς τὸν θεόν, καὶ εἰς ἐμὲ πιστεύετε."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἐν τῇ οἰκίᾳ τοῦ πατρός μου μοναὶ πολλαί εἰσιν· εἰ δὲ μή, εἶπον ἂν ὑμῖν ⸀ὅτι",
          {
            "noteId": 516
          },
          "πορεύομαι ἑτοιμάσαι τόπον ὑμῖν·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ",
          {
            "noteId": 517
          },
          "ἐὰν πορευθῶ ⸀καὶ ἑτοιμάσω ⸂τόπον ὑμῖν",
          {
            "noteId": 518
          },
          ", πάλιν ἔρχομαι καὶ παραλήμψομαι ὑμᾶς πρὸς ἐμαυτόν, ἵνα ὅπου εἰμὶ ἐγὼ καὶ ὑμεῖς ἦτε."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ ὅπου ἐγὼ ὑπάγω οἴδατε ⸂τὴν ὁδόν",
          {
            "noteId": 519
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "λέγει αὐτῷ Θωμᾶς· Κύριε, οὐκ οἴδαμεν ποῦ ὑπάγεις· ⸀πῶς",
          {
            "noteId": 520
          },
          "⸂δυνάμεθα τὴν ὁδὸν εἰδέναι",
          {
            "noteId": 521
          },
          ";"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "λέγει αὐτῷ ⸀ὁ",
          {
            "noteId": 522
          },
          "Ἰησοῦς· Ἐγώ εἰμι ἡ ὁδὸς καὶ ἡ ἀλήθεια καὶ ἡ ζωή· οὐδεὶς ἔρχεται πρὸς τὸν πατέρα εἰ μὴ διʼ ἐμοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "εἰ ⸀ἐγνώκειτέ",
          {
            "noteId": 523
          },
          "με, καὶ τὸν πατέρα μου ⸂ἂν ᾔδειτε",
          {
            "noteId": 524
          },
          "· ⸀ἀπʼ",
          {
            "noteId": 525
          },
          "ἄρτι γινώσκετε αὐτὸν καὶ ἑωράκατε ⸀αὐτόν",
          {
            "noteId": 526
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Λέγει αὐτῷ Φίλιππος· Κύριε, δεῖξον ἡμῖν τὸν πατέρα, καὶ ἀρκεῖ ἡμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "λέγει αὐτῷ ὁ Ἰησοῦς· ⸂Τοσούτῳ χρόνῳ",
          {
            "noteId": 527
          },
          "μεθʼ ὑμῶν εἰμι καὶ οὐκ ἔγνωκάς με, Φίλιππε; ὁ ἑωρακὼς ἐμὲ ἑώρακεν τὸν πατέρα· ⸀πῶς",
          {
            "noteId": 528
          },
          "σὺ λέγεις· Δεῖξον ἡμῖν τὸν πατέρα;"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "οὐ πιστεύεις ὅτι ἐγὼ ἐν τῷ πατρὶ καὶ ὁ πατὴρ ἐν ἐμοί ἐστιν; τὰ ῥήματα ἃ ἐγὼ ⸀λέγω",
          {
            "noteId": 529
          },
          "ὑμῖν ἀπʼ ἐμαυτοῦ οὐ λαλῶ, ὁ δὲ ⸀πατὴρ",
          {
            "noteId": 530
          },
          "ἐν ἐμοὶ ⸀μένων",
          {
            "noteId": 531
          },
          "ποιεῖ τὰ ἔργα ⸀αὐτοῦ",
          {
            "noteId": 532
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "πιστεύετέ μοι ὅτι ἐγὼ ἐν τῷ πατρὶ καὶ ὁ πατὴρ ἐν ἐμοί· εἰ δὲ μή, διὰ τὰ ἔργα αὐτὰ ⸀πιστεύετε",
          {
            "noteId": 533
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ἀμὴν ἀμὴν λέγω ὑμῖν, ὁ πιστεύων εἰς ἐμὲ τὰ ἔργα ἃ ἐγὼ ποιῶ κἀκεῖνος ποιήσει, καὶ μείζονα τούτων ποιήσει, ὅτι ἐγὼ πρὸς τὸν ⸀πατέρα",
          {
            "noteId": 534
          },
          "πορεύομαι·"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ ὅ τι ἂν αἰτήσητε ἐν τῷ ὀνόματί μου τοῦτο ποιήσω, ἵνα δοξασθῇ ὁ πατὴρ ἐν τῷ υἱῷ·"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἐάν τι αἰτήσητέ ⸀με",
          {
            "noteId": 535
          },
          "ἐν τῷ ὀνόματί μου ⸀ἐγὼ",
          {
            "noteId": 536
          },
          "ποιήσω."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Ἐὰν ἀγαπᾶτέ με, τὰς ἐντολὰς τὰς ἐμὰς ⸀τηρήσετε",
          {
            "noteId": 537
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "κἀγὼ ἐρωτήσω τὸν πατέρα καὶ ἄλλον παράκλητον δώσει ὑμῖν ἵνα ⸀ᾖ",
          {
            "noteId": 538
          },
          "μεθʼ ὑμῶν εἰς τὸν ⸀αἰῶνα",
          {
            "noteId": 539
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "τὸ πνεῦμα τῆς ἀληθείας, ὃ ὁ κόσμος οὐ δύναται λαβεῖν, ὅτι οὐ θεωρεῖ αὐτὸ οὐδὲ ⸀γινώσκει",
          {
            "noteId": 540
          },
          "⸀ὑμεῖς",
          {
            "noteId": 541
          },
          "γινώσκετε αὐτό, ὅτι παρʼ ὑμῖν μένει καὶ ἐν ὑμῖν ⸀ἔσται",
          {
            "noteId": 542
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Οὐκ ἀφήσω ὑμᾶς ὀρφανούς, ἔρχομαι πρὸς ὑμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἔτι μικρὸν καὶ ὁ κόσμος με οὐκέτι θεωρεῖ, ὑμεῖς δὲ θεωρεῖτέ με, ὅτι ἐγὼ ζῶ καὶ ὑμεῖς ⸀ζήσετε",
          {
            "noteId": 543
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἐν ἐκείνῃ τῇ ἡμέρᾳ ⸂γνώσεσθε ὑμεῖς",
          {
            "noteId": 544
          },
          "ὅτι ἐγὼ ἐν τῷ πατρί μου καὶ ὑμεῖς ἐν ἐμοὶ κἀγὼ ἐν ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ὁ ἔχων τὰς ἐντολάς μου καὶ τηρῶν αὐτὰς ἐκεῖνός ἐστιν ὁ ἀγαπῶν με· ὁ δὲ ἀγαπῶν με ἀγαπηθήσεται ὑπὸ τοῦ πατρός μου, κἀγὼ ἀγαπήσω αὐτὸν καὶ ἐμφανίσω αὐτῷ ἐμαυτόν."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "λέγει αὐτῷ Ἰούδας, οὐχ ὁ Ἰσκαριώτης· Κύριε, ⸀τί",
          {
            "noteId": 545
          },
          "γέγονεν ὅτι ἡμῖν μέλλεις ἐμφανίζειν σεαυτὸν καὶ οὐχὶ τῷ κόσμῳ;"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ἀπεκρίθη Ἰησοῦς καὶ εἶπεν αὐτῷ· Ἐάν τις ἀγαπᾷ με τὸν λόγον μου τηρήσει, καὶ ὁ πατήρ μου ἀγαπήσει αὐτόν, καὶ πρὸς αὐτὸν ἐλευσόμεθα καὶ μονὴν παρʼ αὐτῷ ⸀ποιησόμεθα",
          {
            "noteId": 546
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ὁ μὴ ἀγαπῶν με τοὺς λόγους μου οὐ τηρεῖ· καὶ ὁ λόγος ὃν ἀκούετε οὐκ ἔστιν ἐμὸς ἀλλὰ τοῦ πέμψαντός με πατρός."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Ταῦτα λελάληκα ὑμῖν παρʼ ὑμῖν μένων·"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ὁ δὲ παράκλητος, τὸ πνεῦμα τὸ ἅγιον ὃ πέμψει ὁ πατὴρ ἐν τῷ ὀνόματί μου, ἐκεῖνος ὑμᾶς διδάξει πάντα καὶ ὑπομνήσει ὑμᾶς πάντα ἃ εἶπον ⸀ὑμῖν",
          {
            "noteId": 547
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "εἰρήνην ἀφίημι ὑμῖν, εἰρήνην τὴν ἐμὴν δίδωμι ὑμῖν· οὐ καθὼς ὁ κόσμος δίδωσιν ἐγὼ δίδωμι ὑμῖν. μὴ ταρασσέσθω ὑμῶν ἡ καρδία μηδὲ δειλιάτω."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ἠκούσατε ὅτι",
          {
            "noteId": 548
          },
          "ἐγὼ εἶπον ὑμῖν· Ὑπάγω καὶ ἔρχομαι πρὸς ὑμᾶς. εἰ ἠγαπᾶτέ με ἐχάρητε ἄν, ⸀ὅτι πορεύομαι πρὸς τὸν πατέρα, ὅτι ὁ ⸀πατὴρ",
          {
            "noteId": 549
          },
          "μείζων μού ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "καὶ νῦν εἴρηκα ὑμῖν πρὶν γενέσθαι, ἵνα ὅταν γένηται πιστεύσητε."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "οὐκέτι πολλὰ λαλήσω μεθʼ ὑμῶν, ἔρχεται γὰρ ὁ τοῦ κόσμου ἄρχων· καὶ ἐν ἐμοὶ οὐκ ἔχει οὐδέν,"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "ἀλλʼ ἵνα γνῷ ὁ κόσμος ὅτι ἀγαπῶ τὸν πατέρα, καὶ καθὼς ⸀ἐνετείλατο",
          {
            "noteId": 550
          },
          "μοι ὁ πατὴρ οὕτως ποιῶ. Ἐγείρεσθε, ἄγωμεν ἐντεῦθεν."
        ]
      }
    ],
