  },
  "chapter": {
    "number": 6,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Μετὰ ταῦτα ἀπῆλθεν ὁ Ἰησοῦς πέραν τῆς θαλάσσης τῆς Γαλιλαίας τῆς Τιβεριάδος."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "⸂ἠκολούθει δὲ",
          {
            "noteId": 136
          },
          "αὐτῷ ὄχλος πολύς, ὅτι ⸀ἐθεώρουν",
          {
            "noteId": 137
          },
          "τὰ σημεῖα ἃ ἐποίει ἐπὶ τῶν ἀσθενούντων."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἀνῆλθεν δὲ εἰς τὸ ⸀ὄρος",
          {
            "noteId": 138
          },
          "Ἰησοῦς, καὶ ἐκεῖ ἐκάθητο μετὰ τῶν μαθητῶν αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἦν δὲ ἐγγὺς τὸ πάσχα, ἡ ἑορτὴ τῶν Ἰουδαίων."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἐπάρας οὖν ⸂τοὺς ὀφθαλμοὺς ὁ Ἰησοῦς",
          {
            "noteId": 139
          },
          "καὶ θεασάμενος ὅτι πολὺς ὄχλος ἔρχεται πρὸς",
          {
            "noteId": 140
          },
          "αὐτὸν λέγει ⸀πρὸς Φίλιππον· Πόθεν ⸀ἀγοράσωμεν",
          {
            "noteId": 141
          },
          "ἄρτους ἵνα φάγωσιν οὗτοι;"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "τοῦτο δὲ ἔλεγεν πειράζων αὐτόν, αὐτὸς γὰρ ᾔδει τί ἔμελλεν ποιεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἀπεκρίθη ⸀αὐτῷ",
          {
            "noteId": 142
          },
          "Φίλιππος· Διακοσίων δηναρίων ἄρτοι οὐκ ἀρκοῦσιν αὐτοῖς ἵνα ⸀ἕκαστος",
          {
            "noteId": 143
          },
          "βραχύ ⸀τι",
          {
            "noteId": 144
          },
          "λάβῃ."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "λέγει αὐτῷ εἷς ἐκ τῶν μαθητῶν αὐτοῦ, Ἀνδρέας ὁ ἀδελφὸς Σίμωνος Πέτρου·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Ἔστιν ⸀παιδάριον",
          {
            "noteId": 145
          },
          "ὧδε ⸀ὃς",
          {
            "noteId": 146
          },
          "ἔχει πέντε ἄρτους κριθίνους καὶ δύο ὀψάρια· ἀλλὰ ταῦτα τί ἐστιν εἰς τοσούτους;"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "⸀εἶπεν",
          {
            "noteId": 147
          },
          "ὁ Ἰησοῦς· Ποιήσατε τοὺς ἀνθρώπους ἀναπεσεῖν. ἦν δὲ χόρτος πολὺς ἐν τῷ τόπῳ. ἀνέπεσαν οὖν οἱ ἄνδρες τὸν ἀριθμὸν ⸀ὡς",
          {
            "noteId": 148
          },
          "πεντακισχίλιοι."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ἔλαβεν ⸀οὖν",
          {
            "noteId": 149
          },
          "τοὺς ἄρτους ὁ Ἰησοῦς καὶ εὐχαριστήσας ⸀διέδωκεν",
          {
            "noteId": 150
          },
          "τοῖς ἀνακειμένοις, ὁμοίως καὶ ἐκ τῶν ὀψαρίων ὅσον ἤθελον."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ὡς δὲ ἐνεπλήσθησαν λέγει τοῖς μαθηταῖς αὐτοῦ· Συναγάγετε τὰ περισσεύσαντα κλάσματα, ἵνα μή τι ἀπόληται."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "συνήγαγον οὖν, καὶ ἐγέμισαν δώδεκα κοφίνους κλασμάτων ἐκ τῶν πέντε ἄρτων τῶν κριθίνων ἃ ⸀ἐπερίσσευσαν",
          {
            "noteId": 151
          },
          "τοῖς βεβρωκόσιν."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "οἱ οὖν ἄνθρωποι ἰδόντες ⸂ὃ ἐποίησεν σημεῖον",
          {
            "noteId": 152
          },
          "⸀ἔλεγον",
          {
            "noteId": 153
          },
          "ὅτι Οὗτός ἐστιν ἀληθῶς ὁ προφήτης ὁ ἐρχόμενος εἰς τὸν κόσμον."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Ἰησοῦς οὖν γνοὺς ὅτι μέλλουσιν ἔρχεσθαι καὶ ἁρπάζειν αὐτὸν ἵνα ⸀ποιήσωσιν",
          {
            "noteId": 154
          },
          "βασιλέα ἀνεχώρησεν ⸀πάλιν",
          {
            "noteId": 155
          },
          "εἰς τὸ ὄρος αὐτὸς μόνος."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Ὡς δὲ ὀψία ἐγένετο κατέβησαν οἱ μαθηταὶ αὐτοῦ ἐπὶ τὴν θάλασσαν,"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καὶ ἐμβάντες ⸀εἰς",
          {
            "noteId": 156
          },
          "πλοῖον ἤρχοντο πέραν τῆς θαλάσσης εἰς Καφαρναούμ. καὶ σκοτία ἤδη ἐγεγόνει καὶ ⸀οὔπω",
          {
            "noteId": 157
          },
          "ἐληλύθει πρὸς αὐτοὺς ὁ Ἰησοῦς,"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ἥ τε θάλασσα ἀνέμου μεγάλου πνέοντος ⸀διεγείρετο",
          {
            "noteId": 158
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἐληλακότες οὖν ὡς σταδίους εἴκοσι πέντε ἢ τριάκοντα θεωροῦσιν τὸν Ἰησοῦν περιπατοῦντα ἐπὶ τῆς θαλάσσης καὶ ἐγγὺς τοῦ πλοίου γινόμενον, καὶ ἐφοβήθησαν."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ὁ δὲ λέγει αὐτοῖς· Ἐγώ εἰμι, μὴ φοβεῖσθε."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ἤθελον οὖν λαβεῖν αὐτὸν εἰς τὸ πλοῖον, καὶ εὐθέως ⸂ἐγένετο τὸ πλοῖον",
          {
            "noteId": 159
          },
          "ἐπὶ τῆς γῆς εἰς ἣν ὑπῆγον."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Τῇ ἐπαύριον ὁ ὄχλος ὁ ἑστηκὼς πέραν τῆς θαλάσσης ⸀εἶδον",
          {
            "noteId": 160
          },
          "ὅτι πλοιάριον ἄλλο οὐκ ἦν ἐκεῖ εἰ μὴ ⸀ἕν",
          {
            "noteId": 161
          },
          "καὶ ὅτι οὐ συνεισῆλθεν τοῖς μαθηταῖς αὐτοῦ ὁ Ἰησοῦς εἰς τὸ ⸀πλοῖον",
          {
            "noteId": 162
          },
          "ἀλλὰ μόνοι οἱ μαθηταὶ αὐτοῦ ἀπῆλθον·"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "⸀ἀλλὰ",
          {
            "noteId": 163
          },
          "ἦλθεν ⸀πλοιάρια",
          {
            "noteId": 164
          },
          "ἐκ Τιβεριάδος ἐγγὺς τοῦ τόπου ὅπου ἔφαγον τὸν ἄρτον εὐχαριστήσαντος τοῦ κυρίου."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ὅτε οὖν εἶδεν ὁ ὄχλος ὅτι Ἰησοῦς οὐκ ἔστιν ἐκεῖ οὐδὲ οἱ μαθηταὶ αὐτοῦ, ἐνέβησαν αὐτοὶ εἰς τὰ ⸀πλοιάρια",
          {
            "noteId": 165
          },
          "καὶ ἦλθον εἰς Καφαρναοὺμ ζητοῦντες τὸν Ἰησοῦν."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Καὶ εὑρόντες αὐτὸν πέραν τῆς θαλάσσης εἶπον αὐτῷ· Ῥαββί, πότε ὧδε γέγονας;"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ἀπεκρίθη αὐτοῖς ὁ Ἰησοῦς καὶ εἶπεν· Ἀμὴν ἀμὴν λέγω ὑμῖν, ζητεῖτέ με οὐχ ὅτι εἴδετε σημεῖα ἀλλʼ ὅτι ἐφάγετε ἐκ τῶν ἄρτων καὶ ἐχορτάσθητε·"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "ἐργάζεσθε μὴ τὴν βρῶσιν τὴν ἀπολλυμένην ἀλλὰ τὴν βρῶσιν τὴν μένουσαν εἰς ζωὴν αἰώνιον, ἣν ὁ υἱὸς τοῦ ἀνθρώπου ὑμῖν δώσει, τοῦτον γὰρ ὁ πατὴρ ἐσφράγισεν ὁ θεός."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "εἶπον οὖν πρὸς αὐτόν· Τί ποιῶμεν ἵνα ἐργαζώμεθα τὰ ἔργα τοῦ θεοῦ;"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "ἀπεκρίθη ⸀ὁ",
          {
            "noteId": 166
          },
          "Ἰησοῦς καὶ εἶπεν αὐτοῖς· Τοῦτό ἐστιν τὸ ἔργον τοῦ θεοῦ ἵνα ⸀πιστεύητε",
          {
            "noteId": 167
          },
          "εἰς ὃν ἀπέστειλεν ἐκεῖνος."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "εἶπον οὖν αὐτῷ· Τί οὖν ποιεῖς σὺ σημεῖον, ἵνα ἴδωμεν καὶ πιστεύσωμέν σοι; τί ἐργάζῃ;"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "οἱ πατέρες ἡμῶν τὸ μάννα ἔφαγον ἐν τῇ ἐρήμῳ, καθώς ἐστιν γεγραμμένον· Ἄρτον ἐκ τοῦ οὐρανοῦ ἔδωκεν αὐτοῖς φαγεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "εἶπεν οὖν αὐτοῖς ὁ Ἰησοῦς· Ἀμὴν ἀμὴν λέγω ὑμῖν, οὐ Μωϋσῆς ⸀δέδωκεν",
          {
            "noteId": 168
          },
          "ὑμῖν τὸν ἄρτον ἐκ τοῦ οὐρανοῦ, ἀλλʼ ὁ πατήρ μου δίδωσιν ὑμῖν τὸν ἄρτον ἐκ τοῦ οὐρανοῦ τὸν ἀληθινόν·"
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "ὁ γὰρ ἄρτος τοῦ θεοῦ ἐστιν ὁ καταβαίνων ἐκ τοῦ οὐρανοῦ καὶ ζωὴν διδοὺς τῷ κόσμῳ."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "εἶπον οὖν πρὸς αὐτόν· Κύριε, πάντοτε δὸς ἡμῖν τὸν ἄρτον τοῦτον."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "⸀Εἶπεν",
          {
            "noteId": 169
          },
          "αὐτοῖς ὁ Ἰησοῦς· Ἐγώ εἰμι ὁ ἄρτος τῆς ζωῆς· ὁ ἐρχόμενος πρὸς ἐμὲ",
          {
            "noteId": 170
          },
          "οὐ μὴ πεινάσῃ, καὶ ὁ πιστεύων εἰς ⸀ἐμὲ οὐ μὴ ⸀διψήσει",
          {
            "noteId": 171
          },
          "πώποτε."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "ἀλλʼ εἶπον ὑμῖν ὅτι καὶ ἑωράκατέ με καὶ οὐ πιστεύετε."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "πᾶν ὃ δίδωσίν μοι ὁ πατὴρ πρὸς ἐμὲ ἥξει, καὶ τὸν ἐρχόμε",
          {
            "noteId": 172
          },
          "ον πρός ⸀με οὐ μὴ ἐκβάλω ἔξω,"
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "ὅτι καταβέβηκα ⸀ἀπὸ",
          {
            "noteId": 173
          },
          "τοῦ οὐρανοῦ οὐχ ἵνα ποιῶ τὸ θέλημα τὸ ἐμὸν ἀλλὰ τὸ θέλημα τοῦ πέμψαντός με·"
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "τοῦτο δέ ἐστιν τὸ θέλημα τοῦ πέμψαντός ⸀με",
          {
            "noteId": 174
          },
          "ἵνα πᾶν ὃ δέδωκέν μοι μὴ ἀπολέσω ἐξ αὐτοῦ ἀλλὰ ἀναστήσω ⸀αὐτὸ",
          {
            "noteId": 175
          },
          "τῇ ἐσχάτῃ ἡμέρᾳ."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "τοῦτο ⸀γάρ",
          {
            "noteId": 176
          },
          "ἐστιν τὸ θέλημα τοῦ ⸂πατρός μου",
          {
            "noteId": 177
          },
          "ἵνα πᾶς ὁ θεωρῶν τὸν υἱὸν καὶ πιστεύων εἰς αὐτὸν ἔχῃ ζωὴν αἰώνιον, καὶ ἀναστήσω αὐτὸν ⸀ἐγὼ",
          {
            "noteId": 178
          },
          "τῇ ἐσχάτῃ ἡμέρᾳ."
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "Ἐγόγγυζον οὖν οἱ Ἰουδαῖοι περὶ αὐτοῦ ὅτι εἶπεν· Ἐγώ εἰμι ὁ ἄρτος ὁ καταβὰς ἐκ τοῦ οὐρανοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "καὶ ἔλεγον· ⸀Οὐχ",
          {
            "noteId": 179
          },
          "οὗτός ἐστιν Ἰησοῦς ὁ υἱὸς Ἰωσήφ, οὗ ἡμεῖς οἴδαμεν τὸν πατέρα καὶ τὴν μητέρα; πῶς ⸀νῦν",
          {
            "noteId": 180
          },
          "⸀λέγει",
          {
            "noteId": 181
          },
          "ὅτι Ἐκ τοῦ οὐρανοῦ καταβέβηκα;"
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "⸀ἀπεκρίθη",
          {
            "noteId": 182
          },
          "Ἰησοῦς καὶ εἶπεν αὐτοῖς· Μὴ γογγύζετε μετʼ ἀλλήλων."
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "οὐδεὶς δύναται ἐλθεῖν πρός ⸀με",
          {
            "noteId": 183
          },
          "ἐὰν μὴ ὁ πατὴρ ὁ πέμψας με ἑλκύσῃ αὐτόν, κἀγὼ ἀναστήσω αὐτὸν ἐν τῇ ἐσχάτῃ ἡμέρᾳ."
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "ἔστιν γεγραμμένον ἐν τοῖς προφήταις· Καὶ ἔσονται πάντες διδακτοὶ θεοῦ· ⸀πᾶς",
          {
            "noteId": 184
          },
          "ὁ ⸀ἀκούσας",
          {
            "noteId": 185
          },
          "παρὰ τοῦ πατρὸς καὶ μαθὼν ἔρχεται πρὸς ⸀ἐμέ",
          {
            "noteId": 186
          }
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "οὐχ ὅτι τὸν πατέρα ⸂ἑώρακέν τις",
          {
            "noteId": 187
          },
          "εἰ μὴ ὁ ὢν παρὰ τοῦ θεοῦ, οὗτος ἑώρακεν τὸν πατέρα."
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          "ἀμὴν ἀμὴν λέγω ὑμῖν, ὁ ⸀πιστεύων",
          {
            "noteId": 188
          },
          "ἔχει ζωὴν αἰώνιον."
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          "ἐγώ εἰμι ὁ ἄρτος τῆς ζωῆς·"
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          "οἱ πατέρες ὑμῶν ἔφαγον ⸂ἐν τῇ ἐρήμῳ τὸ μάννα",
          {
            "noteId": 189
          },
          "καὶ ἀπέθανον·"
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          "οὗτός ἐστιν ὁ ἄρτος ὁ ἐκ τοῦ οὐρανοῦ καταβαίνων ἵνα τις ἐξ αὐτοῦ φάγῃ καὶ μὴ ἀποθάνῃ·"
        ]
      },
      {
        "type": "verse",
        "number": 51,
        "content": [
          "ἐγώ εἰμι ὁ ἄρτος ὁ ζῶν ὁ ἐκ τοῦ οὐρανοῦ καταβάς· ἐάν τις φάγῃ ἐκ τούτου τοῦ ἄρτου ⸀ζήσει",
          {
            "noteId": 190
          },
          "εἰς τὸν αἰῶνα, καὶ ὁ ἄρτος δὲ ὃν ἐγὼ δώσω ἡ σάρξ μού ⸀ἐστιν",
          {
            "noteId": 191
          },
          "ὑπὲρ τῆς τοῦ κόσμου ζωῆς."
        ]
      },
      {
        "type": "verse",
        "number": 52,
        "content": [
          "Ἐμάχοντο οὖν πρὸς ἀλλήλους οἱ Ἰουδαῖοι λέγοντες· Πῶς δύναται οὗτος ἡμῖν δοῦναι τὴν σάρκα ⸀αὐτοῦ",
          {
            "noteId": 192
          },
          "φαγεῖν;"
        ]
      },
      {
        "type": "verse",
        "number": 53,
        "content": [
          "εἶπεν οὖν αὐτοῖς ὁ Ἰησοῦς· Ἀμὴν ἀμὴν λέγω ὑμῖν, ἐὰν μὴ φάγητε τὴν σάρκα τοῦ υἱοῦ τοῦ ἀνθρώπου καὶ πίητε αὐτοῦ τὸ αἷμα, οὐκ ἔχετε ζωὴν ἐν ἑαυτοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 54,
        "content": [
          "ὁ τρώγων μου τὴν σάρκα καὶ πίνων μου τὸ αἷμα ἔχει ζωὴν αἰώνιον, κἀγὼ ἀναστήσω αὐτὸν τῇ ἐσχάτῃ ἡμέρᾳ."
        ]
      },
      {
        "type": "verse",
        "number": 55,
        "content": [
          "ἡ γὰρ σάρξ μου ⸀ἀληθής",
          {
            "noteId": 193
          },
          "ἐστι βρῶσις, καὶ τὸ αἷμά μου ⸁ἀληθής",
          {
            "noteId": 194
          },
          "ἐστι πόσις."
        ]
      },
      {
        "type": "verse",
        "number": 56,
        "content": [
          "ὁ τρώγων μου τὴν σάρκα καὶ πίνων μου τὸ αἷμα ἐν ἐμοὶ μένει κἀγὼ ἐν αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 57,
        "content": [
          "καθὼς ἀπέστειλέν με ὁ ζῶν πατὴρ κἀγὼ ζῶ διὰ τὸν πατέρα, καὶ ὁ τρώγων με κἀκεῖνος ⸀ζήσει",
          {
            "noteId": 195
          },
          "διʼ ἐμέ."
        ]
      },
      {
        "type": "verse",
        "number": 58,
        "content": [
          "οὗτός ἐστιν ὁ ἄρτος ὁ ⸀ἐξ",
          {
            "noteId": 196
          },
          "οὐρανοῦ καταβάς, οὐ καθὼς ἔφαγον οἱ ⸀πατέρες",
          {
            "noteId": 197
          },
          "καὶ ἀπέθανον· ὁ τρώγων τοῦτον τὸν ἄρτον ⸀ζήσει",
          {
            "noteId": 198
          },
          "εἰς τὸν αἰῶνα."
        ]
      },
      {
        "type": "verse",
        "number": 59,
        "content": [
          "ταῦτα εἶπεν ἐν συναγωγῇ διδάσκων ἐν Καφαρναούμ."
        ]
      },
      {
        "type": "verse",
        "number": 60,
        "content": [
          "Πολλοὶ οὖν ἀκούσαντες ἐκ τῶν μαθητῶν αὐτοῦ εἶπαν· Σκληρός ἐστιν ⸂ὁ λόγος οὗτος",
          {
            "noteId": 199
          },
          "· τίς δύναται αὐτοῦ ἀκούειν;"
        ]
      },
      {
        "type": "verse",
        "number": 61,
        "content": [
          "εἰδὼς δὲ ὁ Ἰησοῦς ἐν ἑαυτῷ ὅτι γογγύζουσιν περὶ τούτου οἱ μαθηταὶ αὐτοῦ εἶπεν αὐτοῖς· Τοῦτο ὑμᾶς σκανδαλίζει;"
        ]
      },
      {
        "type": "verse",
        "number": 62,
        "content": [
          "ἐὰν οὖν θεωρῆτε τὸν υἱὸν τοῦ ἀνθρώπου ἀναβαίνοντα ὅπου ἦν τὸ πρότερον;"
        ]
      },
      {
        "type": "verse",
        "number": 63,
        "content": [
          "τὸ πνεῦμά ἐστιν τὸ ζῳοποιοῦν, ἡ σὰρξ οὐκ ὠφελεῖ οὐδέν· τὰ ῥήματα ἃ ἐγὼ ⸀λελάληκα",
          {
            "noteId": 200
          },
          "ὑμῖν πνεῦμά ἐστιν καὶ ζωή ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 64,
        "content": [
          "ἀλλὰ εἰσὶν ἐξ ὑμῶν τινες οἳ οὐ πιστεύουσιν. ᾔδει γὰρ ἐξ ἀρχῆς ὁ Ἰησοῦς τίνες εἰσὶν οἱ μὴ πιστεύοντες καὶ τίς ἐστιν ὁ παραδώσων αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 65,
        "content": [
          "καὶ ἔλεγεν· Διὰ τοῦτο εἴρηκα ὑμῖν ὅτι οὐδεὶς δύναται ἐλθεῖν πρός με ἐὰν μὴ ᾖ δεδομένον αὐτῷ ἐκ τοῦ ⸀πατρός",
          {
            "noteId": 201
          }
        ]
      },
      {
        "type": "verse",
        "number": 66,
        "content": [
          "Ἐκ τούτου πολλοὶ ⸀ἐκ",
          {
            "noteId": 202
          },
          "⸂τῶν μαθητῶν αὐτοῦ ἀπῆλθον",
          {
            "noteId": 203
          },
          "εἰς τὰ ὀπίσω καὶ οὐκέτι μετʼ αὐτοῦ περιεπάτουν."
        ]
      },
      {
        "type": "verse",
        "number": 67,
        "content": [
          "εἶπεν οὖν ὁ Ἰησοῦς τοῖς δώδεκα· Μὴ καὶ ὑμεῖς θέλετε ὑπάγειν;"
        ]
      },
      {
        "type": "verse",
        "number": 68,
        "content": [
          "⸀ἀπεκρίθη",
          {
            "noteId": 204
          },
          "αὐτῷ Σίμων Πέτρος· Κύριε, πρὸς τίνα ἀπελευσόμεθα; ῥήματα ζωῆς αἰωνίου ἔχεις,"
        ]
      },
      {
        "type": "verse",
        "number": 69,
        "content": [
          "καὶ ἡμεῖς πεπιστεύκαμεν καὶ ἐγνώκαμεν ὅτι σὺ εἶ ὁ ⸀ἅγιος",
          {
            "noteId": 205
          },
          "τοῦ ⸀θεοῦ",
          {
            "noteId": 206
          }
        ]
      },
      {
        "type": "verse",
        "number": 70,
        "content": [
          "ἀπεκρίθη αὐτοῖς ὁ Ἰησοῦς· Οὐκ ἐγὼ ὑμᾶς τοὺς δώδεκα ἐξελεξάμην; καὶ ἐξ ὑμῶν εἷς διάβολός ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 71,
        "content": [
          "ἔλεγεν δὲ τὸν Ἰούδαν Σίμωνος ⸀Ἰσκαριώτου",
          {
            "noteId": 207
          },
          "οὗτος γὰρ ἔμελλεν ⸂παραδιδόναι αὐτόν",
          {
            "noteId": 208
          },
          ", ⸀εἷς",
          {
            "noteId": 209
          },
          "ἐκ τῶν δώδεκα."
        ]
      }
