  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Αὐτοὶ γὰρ οἴδατε, ἀδελφοί, τὴν εἴσοδον ἡμῶν τὴν πρὸς ὑμᾶς ὅτι οὐ κενὴ γέγονεν,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἀλλὰ προπαθόντες καὶ ὑβρισθέντες καθὼς οἴδατε ἐν Φιλίπποις ἐπαρρησιασάμεθα ἐν τῷ θεῷ ἡμῶν λαλῆσαι πρὸς ὑμᾶς τὸ εὐαγγέλιον τοῦ θεοῦ ἐν πολλῷ ἀγῶνι."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἡ γὰρ παράκλησις ἡμῶν οὐκ ἐκ πλάνης οὐδὲ",
          {
            "noteId": 11
          },
          "ἐξ ἀκαθαρσίας ⸀οὐδὲ ἐν δόλῳ,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἀλλὰ καθὼς δεδοκιμάσμεθα ὑπὸ τοῦ θεοῦ πιστευθῆναι τὸ εὐαγγέλιον οὕτως λαλοῦμεν, οὐχ ὡς ἀνθρώποις ἀρέσκοντες ἀλλὰ ⸀θεῷ",
          {
            "noteId": 12
          },
          "τῷ δοκιμάζοντι τὰς καρδίας ἡμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "οὔτε γάρ ποτε ἐν",
          {
            "noteId": 13
          },
          "λόγῳ κολακείας ἐγενήθημεν, καθὼς οἴδατε, οὔτε ⸀ἐν προφάσει πλεονεξίας, θεὸς μάρτυς,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "οὔτε ζητοῦντες ἐξ ἀνθρώπων δόξαν, οὔτε ἀφʼ ὑμῶν οὔτε ἀπʼ ἄλλων,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "δυνάμενοι ἐν βάρει εἶναι ὡς Χριστοῦ ἀπόστολοι· ἀλλὰ ἐγενήθημεν ⸀ἤπιοι",
          {
            "noteId": 14
          },
          "ἐν μέσῳ ὑμῶν, ὡς ⸀ἐὰν",
          {
            "noteId": 15
          },
          "τροφὸς θάλπῃ τὰ ἑαυτῆς τέκνα·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "οὕτως ὁμειρόμενοι ὑμῶν εὐδοκοῦμεν μεταδοῦναι ὑμῖν οὐ μόνον τὸ εὐαγγέλιον τοῦ θεοῦ ἀλλὰ καὶ τὰς ἑαυτῶν ψυχάς, διότι ἀγαπητοὶ ἡμῖν ⸀ἐγενήθητε",
          {
            "noteId": 16
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Μνημονεύετε γάρ, ἀδελφοί, τὸν κόπον ἡμῶν καὶ τὸν μόχθον· ⸀νυκτὸς",
          {
            "noteId": 17
          },
          "καὶ ἡμέρας ἐργαζόμενοι πρὸς τὸ μὴ ἐπιβαρῆσαί τινα ὑμῶν ἐκηρύξαμεν εἰς ὑμᾶς τὸ εὐαγγέλιον τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ὑμεῖς μάρτυρες καὶ ὁ θεός, ὡς ὁσίως καὶ δικαίως καὶ ἀμέμπτως ὑμῖν τοῖς πιστεύουσιν ἐγενήθημεν,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καθάπερ οἴδατε ὡς ἕνα ἕκαστον ὑμῶν ὡς πατὴρ τέκνα ἑαυτοῦ"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "παρακαλοῦντες ὑμᾶς καὶ παραμυθούμενοι καὶ μαρτυρόμενοι, εἰς τὸ ⸀περιπατεῖν",
          {
            "noteId": 18
          },
          "ὑμᾶς ἀξίως τοῦ θεοῦ τοῦ καλοῦντος ὑμᾶς εἰς τὴν ἑαυτοῦ βασιλείαν καὶ δόξαν."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "⸀Καὶ",
          {
            "noteId": 19
          },
          "διὰ τοῦτο καὶ ἡμεῖς εὐχαριστοῦμεν τῷ θεῷ ἀδιαλείπτως, ὅτι παραλαβόντες λόγον ἀκοῆς παρʼ ἡμῶν τοῦ θεοῦ ἐδέξασθε οὐ λόγον ἀνθρώπων ἀλλὰ καθὼς ⸂ἀληθῶς ἐστὶν",
          {
            "noteId": 20
          },
          "λόγον θεοῦ, ὃς καὶ ἐνεργεῖται ἐν ὑμῖν τοῖς πιστεύουσιν."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ὑμεῖς γὰρ μιμηταὶ ἐγενήθητε, ἀδελφοί, τῶν ἐκκλησιῶν τοῦ θεοῦ τῶν οὐσῶν ἐν τῇ Ἰουδαίᾳ ἐν Χριστῷ Ἰησοῦ, ὅτι τὰ αὐτὰ ἐπάθετε καὶ ὑμεῖς ὑπὸ τῶν ἰδίων συμφυλετῶν καθὼς καὶ αὐτοὶ ὑπὸ τῶν Ἰουδαίων"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "τῶν καὶ τὸν κύριον ἀποκτεινάντων Ἰησοῦν καὶ ⸀τοὺς",
          {
            "noteId": 21
          },
          "προφήτας καὶ ἡμᾶς ἐκδιωξάντων, καὶ θεῷ μὴ ἀρεσκόντων, καὶ πᾶσιν ἀνθρώποις ἐναντίων,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "κωλυόντων ἡμᾶς τοῖς ἔθνεσιν λαλῆσαι ἵνα σωθῶσιν, εἰς τὸ ἀναπληρῶσαι αὐτῶν τὰς ἁμαρτίας πάντοτε. ἔφθασεν δὲ ἐπʼ αὐτοὺς ἡ ⸀ὀργὴ",
          {
            "noteId": 22
          },
          "εἰς τέλος."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Ἡμεῖς δέ, ἀδελφοί, ἀπορφανισθέντες ἀφʼ ὑμῶν πρὸς καιρὸν ὥρας, προσώπῳ οὐ καρδίᾳ, περισσοτέρως ἐσπουδάσαμεν τὸ πρόσωπον ὑμῶν ἰδεῖν ἐν πολλῇ ἐπιθυμίᾳ."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "⸀διότι",
          {
            "noteId": 23
          },
          "ἠθελήσαμεν ἐλθεῖν πρὸς ὑμᾶς, ἐγὼ μὲν Παῦλος καὶ ἅπαξ καὶ δίς, καὶ ἐνέκοψεν ἡμᾶς ὁ Σατανᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "τίς γὰρ ἡμῶν ἐλπὶς ἢ χαρὰ ἢ στέφανος καυχήσεως— ἢ οὐχὶ καὶ ὑμεῖς— ἔμπροσθεν τοῦ κυρίου ἡμῶν Ἰησοῦ ἐν τῇ αὐτοῦ παρουσίᾳ;"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ὑμεῖς γάρ ἐστε ἡ δόξα ἡμῶν καὶ ἡ χαρά."
        ]
      }
    ],
