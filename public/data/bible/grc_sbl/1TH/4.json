  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Λοιπὸν ⸀οὖν",
          {
            "noteId": 31
          },
          "ἀδελφοί, ἐρωτῶμεν ὑμᾶς καὶ παρακαλοῦμεν ἐν κυρίῳ Ἰησοῦ, ⸀ἵνα",
          {
            "noteId": 32
          },
          "καθὼς παρελάβετε παρʼ ἡμῶν τὸ πῶς δεῖ ὑμᾶς περιπατεῖν καὶ ἀρέσκειν θεῷ, ⸂καθὼς καὶ περιπατεῖτε",
          {
            "noteId": 33
          },
          ", ἵνα περισσεύητε μᾶλλον."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "οἴδατε γὰρ τίνας παραγγελίας ἐδώκαμεν ὑμῖν διὰ τοῦ κυρίου Ἰησοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "τοῦτο γάρ ἐστιν θέλημα τοῦ θεοῦ, ὁ ἁγιασμὸς ὑμῶν, ἀπέχεσθαι ὑμᾶς ἀπὸ τῆς πορνείας,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "εἰδέναι ἕκαστον ὑμῶν τὸ ἑαυτοῦ σκεῦος κτᾶσθαι ἐν ἁγιασμῷ καὶ τιμῇ,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "μὴ ἐν πάθει ἐπιθυμίας καθάπερ καὶ τὰ ἔθνη τὰ μὴ εἰδότα τὸν θεόν,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "τὸ μὴ ὑπερβαίνειν καὶ πλεονεκτεῖν ἐν τῷ πράγματι τὸν ἀδελφὸν αὐτοῦ, διότι ἔκδικος ⸀κύριος",
          {
            "noteId": 34
          },
          "περὶ πάντων τούτων, καθὼς καὶ προείπαμεν ὑμῖν καὶ διεμαρτυράμεθα."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "οὐ γὰρ ἐκάλεσεν ἡμᾶς ὁ θεὸς ἐπὶ ἀκαθαρσίᾳ ἀλλʼ ἐν ἁγιασμῷ."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "τοιγαροῦν ὁ ἀθετῶν οὐκ ἄνθρωπον ἀθετεῖ ἀλλὰ τὸν θεὸν τὸν ⸀καὶ",
          {
            "noteId": 35
          },
          "⸀διδόντα",
          {
            "noteId": 36
          },
          "τὸ πνεῦμα αὐτοῦ τὸ ἅγιον εἰς ὑμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Περὶ δὲ τῆς φιλαδελφίας οὐ χρείαν ἔχετε γράφειν ὑμῖν, αὐτοὶ γὰρ ὑμεῖς θεοδίδακτοί ἐστε εἰς τὸ ἀγαπᾶν ἀλλήλους·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ γὰρ ποιεῖτε αὐτὸ εἰς πάντας τοὺς ἀδελφοὺς τοὺς ἐν ὅλῃ τῇ Μακεδονίᾳ. παρακαλοῦμεν δὲ ὑμᾶς, ἀδελφοί, περισσεύειν μᾶλλον,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ φιλοτιμεῖσθαι ἡσυχάζειν καὶ πράσσειν τὰ ἴδια καὶ ἐργάζεσθαι ⸀ταῖς",
          {
            "noteId": 37
          },
          "χερσὶν ὑμῶν, καθὼς ὑμῖν παρηγγείλαμεν,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ἵνα περιπατῆτε εὐσχημόνως πρὸς τοὺς ἔξω καὶ μηδενὸς χρείαν ἔχητε."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Οὐ θέλομεν δὲ ὑμᾶς ἀγνοεῖν, ἀδελφοί, περὶ τῶν ⸀κοιμωμένων",
          {
            "noteId": 38
          },
          "ἵνα μὴ λυπῆσθε καθὼς καὶ οἱ λοιποὶ οἱ μὴ ἔχοντες ἐλπίδα."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "εἰ γὰρ πιστεύομεν ὅτι Ἰησοῦς ἀπέθανεν καὶ ἀνέστη, οὕτως καὶ ὁ θεὸς τοὺς κοιμηθέντας διὰ τοῦ Ἰησοῦ ἄξει σὺν αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "τοῦτο γὰρ ὑμῖν λέγομεν ἐν λόγῳ κυρίου, ὅτι ἡμεῖς οἱ ζῶντες οἱ περιλειπόμενοι εἰς τὴν παρουσίαν τοῦ κυρίου οὐ μὴ φθάσωμεν τοὺς κοιμηθέντας·"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ὅτι αὐτὸς ὁ κύριος ἐν κελεύσματι, ἐν φωνῇ ἀρχαγγέλου καὶ ἐν σάλπιγγι θεοῦ, καταβήσεται ἀπʼ οὐρανοῦ, καὶ οἱ νεκροὶ ἐν Χριστῷ ἀναστήσονται πρῶτον,"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ἔπειτα ἡμεῖς οἱ ζῶντες οἱ περιλειπόμενοι ἅμα σὺν αὐτοῖς ἁρπαγησόμεθα ἐν νεφέλαις εἰς ἀπάντησιν τοῦ κυρίου εἰς ἀέρα· καὶ οὕτως πάντοτε σὺν κυρίῳ ἐσόμεθα."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ὥστε παρακαλεῖτε ἀλλήλους ἐν τοῖς λόγοις τούτοις."
        ]
      }
    ],
