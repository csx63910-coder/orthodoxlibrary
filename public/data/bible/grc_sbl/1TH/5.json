    "title": "ΠΡΟΣ ΘΕΣΣΑΛΟΝΙΚΕΙΣ Α",
    "order": 52,
    "numberOfChapters": 5,
    "sha256": "069dd0ba759b39075f2363ae21b28d539dc2c5315eb6131e989b4bd240f25fc5",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_sbl/1TH/1.json",
