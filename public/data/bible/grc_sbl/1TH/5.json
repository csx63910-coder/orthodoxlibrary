  },
  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Περὶ δὲ τῶν χρόνων καὶ τῶν καιρῶν, ἀδελφοί, οὐ χρείαν ἔχετε ὑμῖν γράφεσθαι,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "αὐτοὶ γὰρ ἀκριβῶς οἴδατε ⸀ὅτι",
          {
            "noteId": 39
          },
          "ἡμέρα κυρίου ὡς κλέπτης ἐν νυκτὶ οὕτως ἔρχεται."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "⸀ὅταν",
          {
            "noteId": 40
          },
          "λέγωσιν· Εἰρήνη καὶ ἀσφάλεια, τότε αἰφνίδιος αὐτοῖς ἐφίσταται ὄλεθρος ὥσπερ ἡ ὠδὶν τῇ ἐν γαστρὶ ἐχούσῃ, καὶ οὐ μὴ ἐκφύγωσιν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ὑμεῖς δέ, ἀδελφοί, οὐκ ἐστὲ ἐν σκότει, ἵνα ἡ ἡμέρα ὑμᾶς ὡς ⸀κλέπτης",
          {
            "noteId": 41
          },
          "καταλάβῃ,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "πάντες ⸀γὰρ",
          {
            "noteId": 42
          },
          "ὑμεῖς υἱοὶ φωτός ἐστε καὶ υἱοὶ ἡμέρας. οὐκ ἐσμὲν νυκτὸς οὐδὲ σκότους·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἄρα οὖν μὴ καθεύδωμεν ⸀ὡς",
          {
            "noteId": 43
          },
          "οἱ λοιποί, ἀλλὰ γρηγορῶμεν καὶ νήφωμεν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "οἱ γὰρ καθεύδοντες νυκτὸς καθεύδουσιν, καὶ οἱ μεθυσκόμενοι νυκτὸς μεθύουσιν·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἡμεῖς δὲ ἡμέρας ὄντες νήφωμεν, ἐνδυσάμενοι θώρακα πίστεως καὶ ἀγάπης καὶ περικεφαλαίαν ἐλπίδα σωτηρίας·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ὅτι οὐκ ἔθετο ἡμᾶς ὁ θεὸς εἰς ὀργὴν ἀλλὰ εἰς περιποίησιν σωτηρίας διὰ τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "τοῦ ἀποθανόντος ⸀περὶ",
          {
            "noteId": 44
          },
          "ἡμῶν ἵνα εἴτε γρηγορῶμεν εἴτε καθεύδωμεν ἅμα σὺν αὐτῷ ζήσωμεν."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "διὸ παρακαλεῖτε ἀλλήλους καὶ οἰκοδομεῖτε εἷς τὸν ἕνα, καθὼς καὶ ποιεῖτε."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ἐρωτῶμεν δὲ ὑμᾶς, ἀδελφοί, εἰδέναι τοὺς κοπιῶντας ἐν ὑμῖν καὶ προϊσταμένους ὑμῶν ἐν κυρίῳ καὶ νουθετοῦντας ὑμᾶς,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ ἡγεῖσθαι αὐτοὺς ⸀ὑπερεκπερισσοῦ",
          {
            "noteId": 45
          },
          "ἐν ἀγάπῃ διὰ τὸ ἔργον αὐτῶν. εἰρηνεύετε ἐν ⸀ἑαυτοῖς",
          {
            "noteId": 46
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "παρακαλοῦμεν δὲ ὑμᾶς, ἀδελφοί, νουθετεῖτε τοὺς ἀτάκτους, παραμυθεῖσθε τοὺς ὀλιγοψύχους, ἀντέχεσθε τῶν ἀσθενῶν, μακροθυμεῖτε πρὸς πάντας."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ὁρᾶτε μή τις κακὸν ἀντὶ κακοῦ τινι ἀποδῷ, ἀλλὰ πάντοτε τὸ ἀγαθὸν ⸀διώκετε",
          {
            "noteId": 47
          },
          "εἰς ἀλλήλους καὶ εἰς πάντας."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "πάντοτε χαίρετε,"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ἀδιαλείπτως προσεύχεσθε,"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ἐν παντὶ εὐχαριστεῖτε· τοῦτο γὰρ θέλημα θεοῦ ἐν Χριστῷ Ἰησοῦ εἰς ὑμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "τὸ πνεῦμα μὴ σβέννυτε,"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "προφητείας μὴ ἐξουθενεῖτε·"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "πάντα δὲ δοκιμάζετε, τὸ καλὸν κατέχετε,"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ἀπὸ παντὸς εἴδους πονηροῦ ἀπέχεσθε."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Αὐτὸς δὲ ὁ θεὸς τῆς εἰρήνης ἁγιάσαι ὑμᾶς ὁλοτελεῖς, καὶ ὁλόκληρον ὑμῶν τὸ πνεῦμα καὶ ἡ ψυχὴ καὶ τὸ σῶμα ἀμέμπτως ἐν τῇ παρουσίᾳ τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ τηρηθείη."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "πιστὸς ὁ καλῶν ὑμᾶς, ὃς καὶ ποιήσει."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Ἀδελφοί, ⸀προσεύχεσθε",
          {
            "noteId": 48
          },
          "περὶ ἡμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ἀσπάσασθε τοὺς ἀδελφοὺς πάντας ἐν φιλήματι ἁγίῳ."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "⸀ἐνορκίζω",
          {
            "noteId": 49
          },
          "ὑμᾶς τὸν κύριον ἀναγνωσθῆναι τὴν ἐπιστολὴν πᾶσιν ⸀τοῖς",
          {
            "noteId": 50
          },
          "ἀδελφοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ἡ χάρις τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ μεθʼ ⸀ὑμῶν",
          {
            "noteId": 51
          },
          "‘p /’ ‘/book’"
        ]
      }
    ],
