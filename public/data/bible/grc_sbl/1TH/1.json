  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Παῦλος καὶ Σιλουανὸς καὶ Τιμόθεος τῇ ἐκκλησίᾳ Θεσσαλονικέων ἐν θεῷ πατρὶ καὶ κυρίῳ Ἰησοῦ Χριστῷ· χάρις ὑμῖν καὶ ⸀εἰρήνη",
          {
            "noteId": 0
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Εὐχαριστοῦμεν τῷ θεῷ πάντοτε περὶ πάντων ὑμῶν ⸀μνείαν",
          {
            "noteId": 1
          },
          "ποιούμενοι ἐπὶ τῶν προσευχῶν ἡμῶν, ἀδιαλείπτως"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "μνημονεύοντες ὑμῶν τοῦ ἔργου τῆς πίστεως καὶ τοῦ κόπου τῆς ἀγάπης καὶ τῆς ὑπομονῆς τῆς ἐλπίδος τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ ἔμπροσθεν τοῦ θεοῦ καὶ πατρὸς ἡμῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "εἰδότες, ἀδελφοὶ ἠγαπημένοι ὑπὸ ⸀θεοῦ",
          {
            "noteId": 2
          },
          "τὴν ἐκλογὴν ὑμῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ὅτι τὸ εὐαγγέλιον ἡμῶν οὐκ ἐγενήθη εἰς ὑμᾶς ἐν λόγῳ μόνον ἀλλὰ καὶ",
          {
            "noteId": 3
          },
          "ἐν",
          {
            "noteId": 4
          },
          "δυνάμει καὶ ἐν πνεύματι ἁγίῳ ⸀καὶ πληροφορίᾳ πολλῇ, καθὼς οἴδατε οἷοι ἐγενήθημεν ⸀ἐν ὑμῖν διʼ ὑμᾶς·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ ὑμεῖς μιμηταὶ ἡμῶν ἐγενήθητε καὶ τοῦ κυρίου, δεξάμενοι τὸν λόγον ἐν θλίψει πολλῇ μετὰ χαρᾶς πνεύματος ἁγίου,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ὥστε γενέσθαι ὑμᾶς ⸀τύπον",
          {
            "noteId": 5
          },
          "πᾶσιν τοῖς πιστεύουσιν ἐν",
          {
            "noteId": 6
          },
          "τῇ Μακεδονίᾳ καὶ ⸀ἐν τῇ Ἀχαΐᾳ."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἀφʼ ὑμῶν γὰρ ἐξήχηται ὁ λόγος τοῦ κυρίου οὐ μόνον ἐν τῇ Μακεδονίᾳ ⸀καὶ",
          {
            "noteId": 7
          },
          "Ἀχαΐᾳ, ⸀ἀλλʼ",
          {
            "noteId": 8
          },
          "ἐν παντὶ τόπῳ ἡ πίστις ὑμῶν ἡ πρὸς τὸν θεὸν ἐξελήλυθεν, ὥστε μὴ χρείαν ⸂ἔχειν ἡμᾶς",
          {
            "noteId": 9
          },
          "λαλεῖν τι·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "αὐτοὶ γὰρ περὶ ἡμῶν ἀπαγγέλλουσιν ὁποίαν εἴσοδον ἔσχομεν πρὸς ὑμᾶς, καὶ πῶς ἐπεστρέψατε πρὸς τὸν θεὸν ἀπὸ τῶν εἰδώλων δουλεύειν θεῷ ζῶντι καὶ ἀληθινῷ,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ ἀναμένειν τὸν υἱὸν αὐτοῦ ἐκ",
          {
            "noteId": 10
          },
          "τῶν οὐρανῶν, ὃν ἤγειρεν ἐκ τῶν νεκρῶν, Ἰησοῦν τὸν ῥυόμενον ἡμᾶς ⸀ἐκ τῆς ὀργῆς τῆς ἐρχομένης."
        ]
      }
    ],
