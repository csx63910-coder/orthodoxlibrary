    "title": "ΠΡΟΣ ΤΙΜΟΘΕΟΝ Α",
    "order": 54,
    "numberOfChapters": 6,
    "sha256": "8e2810b091fe9feca6d92a2e6bf3d21ef0f44c4443fe6aea75bdc2a45e0fb7dc",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_sbl/1TI/1.json",
    "lastChapterNumber": 6,
    "lastChapterApiLink": "/api/grc_sbl/1TI/6.json",
    "totalNumberOfVerses": 113
  },
  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Παῦλος ἀπόστολος ⸂Χριστοῦ Ἰησοῦ",
          {
            "noteId": 0
          },
          "κατʼ ἐπιταγὴν θεοῦ σωτῆρος ἡμῶν καὶ ⸂Χριστοῦ Ἰησοῦ",
          {
            "noteId": 1
          },
          "τῆς ἐλπίδος ἡμῶν"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Τιμοθέῳ γνησίῳ τέκνῳ ἐν πίστει· χάρις, ἔλεος, εἰρήνη ἀπὸ θεοῦ ⸀πατρὸς",
          {
            "noteId": 2
          },
          "καὶ Χριστοῦ Ἰησοῦ τοῦ κυρίου ἡμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Καθὼς παρεκάλεσά σε προσμεῖναι ἐν Ἐφέσῳ, πορευόμενος εἰς Μακεδονίαν, ἵνα παραγγείλῃς τισὶν μὴ ἑτεροδιδασκαλεῖν"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "μηδὲ προσέχειν μύθοις καὶ γενεαλογίαις ἀπεράντοις, αἵτινες ⸀ἐκζητήσεις",
          {
            "noteId": 3
          },
          "παρέχουσι μᾶλλον ἢ οἰκονομίαν θεοῦ τὴν ἐν πίστει—"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "τὸ δὲ τέλος τῆς παραγγελίας ἐστὶν ἀγάπη ἐκ καθαρᾶς καρδίας καὶ συνειδήσεως ἀγαθῆς καὶ πίστεως ἀνυποκρίτου,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ὧν τινες ἀστοχήσαντες ἐξετράπησαν εἰς ματαιολογίαν,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "θέλοντες εἶναι νομοδιδάσκαλοι, μὴ νοοῦντες μήτε ἃ λέγουσιν μήτε περὶ τίνων διαβεβαιοῦνται."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Οἴδαμεν δὲ ὅτι καλὸς ὁ νόμος ἐάν τις αὐτῷ νομίμως χρῆται,"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "εἰδὼς τοῦτο, ὅτι δικαίῳ νόμος οὐ κεῖται, ἀνόμοις δὲ καὶ ἀνυποτάκτοις, ἀσεβέσι καὶ ἁμαρτωλοῖς, ἀνοσίοις καὶ βεβήλοις, πατρολῴαις καὶ μητρολῴαις, ἀνδροφόνοις,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "πόρνοις, ἀρσενοκοίταις, ἀνδραποδισταῖς, ψεύσταις, ἐπιόρκοις, καὶ εἴ τι ἕτερον τῇ ὑγιαινούσῃ διδασκαλίᾳ ἀντίκειται,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "κατὰ τὸ εὐαγγέλιον τῆς δόξης τοῦ μακαρίου θεοῦ, ὃ ἐπιστεύθην ἐγώ."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "⸀Χάριν",
          {
            "noteId": 4
          },
          "ἔχω τῷ ἐνδυναμώσαντί με Χριστῷ Ἰησοῦ τῷ κυρίῳ ἡμῶν, ὅτι πιστόν με ἡγήσατο θέμενος εἰς διακονίαν,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "⸀τὸ",
          {
            "noteId": 5
          },
          "πρότερον ὄντα βλάσφημον καὶ διώκτην καὶ ὑβριστήν· ἀλλὰ ἠλεήθην, ὅτι ἀγνοῶν ἐποίησα ἐν ἀπιστίᾳ,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ὑπερεπλεόνασεν δὲ ἡ χάρις τοῦ κυρίου ἡμῶν μετὰ πίστεως καὶ ἀγάπης τῆς ἐν Χριστῷ Ἰησοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "πιστὸς ὁ λόγος καὶ πάσης ἀποδοχῆς ἄξιος, ὅτι Χριστὸς Ἰησοῦς ἦλθεν εἰς τὸν κόσμον ἁμαρτωλοὺς σῶσαι· ὧν πρῶτός εἰμι ἐγώ,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ἀλλὰ διὰ τοῦτο ἠλεήθην, ἵνα ἐν ἐμοὶ πρώτῳ ἐνδείξηται ⸂Χριστὸς Ἰησοῦς",
          {
            "noteId": 6
          },
          "τὴν ⸀ἅπασαν",
          {
            "noteId": 7
          },
          "μακροθυμίαν, πρὸς ὑποτύπωσιν τῶν μελλόντων πιστεύειν ἐπʼ αὐτῷ εἰς ζωὴν αἰώνιον."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "τῷ δὲ βασιλεῖ τῶν αἰώνων, ἀφθάρτῳ, ἀοράτῳ, ⸀μόνῳ",
          {
            "noteId": 8
          },
          "θεῷ, τιμὴ καὶ δόξα εἰς τοὺς αἰῶνας τῶν αἰώνων· ἀμήν."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Ταύτην τὴν παραγγελίαν παρατίθεμαί σοι, τέκνον Τιμόθεε, κατὰ τὰς προαγούσας ἐπὶ σὲ προφητείας, ἵνα ⸀στρατεύῃ",
          {
            "noteId": 9
          },
          "ἐν αὐταῖς τὴν καλὴν στρατείαν,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἔχων πίστιν καὶ ἀγαθὴν συνείδησιν, ἥν τινες ἀπωσάμενοι περὶ τὴν πίστιν ἐναυάγησαν·"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ὧν ἐστιν Ὑμέναιος καὶ Ἀλέξανδρος, οὓς παρέδωκα τῷ Σατανᾷ ἵνα παιδευθῶσι μὴ βλασφημεῖν."
        ]
      }
    ],
