    "commonName": "ΠΡΟΣ ΤΙΜΟΘΕΟΝ Α",
    "title": "ΠΡΟΣ ΤΙΜΟΘΕΟΝ Α",
    "order": 54,
    "numberOfChapters": 6,
    "sha256": "8e2810b091fe9feca6d92a2e6bf3d21ef0f44c4443fe6aea75bdc2a45e0fb7dc",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_sbl/1TI/1.json",
    "lastChapterNumber": 6,
    "lastChapterApiLink": "/api/grc_sbl/1TI/6.json",
    "totalNumberOfVerses": 113
  },
  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Τὸ δὲ πνεῦμα ῥητῶς λέγει ὅτι ἐν ὑστέροις καιροῖς ἀποστήσονταί τινες τῆς πίστεως, προσέχοντες πνεύμασι πλάνοις καὶ διδασκαλίαις δαιμονίων"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἐν ὑποκρίσει ψευδολόγων, κεκαυστηριασμένων τὴν ἰδίαν συνείδησιν,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "κωλυόντων γαμεῖν, ἀπέχεσθαι βρωμάτων ἃ ὁ θεὸς ἔκτισεν εἰς μετάλημψιν μετὰ εὐχαριστίας τοῖς πιστοῖς καὶ ἐπεγνωκόσι τὴν ἀλήθειαν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ὅτι πᾶν κτίσμα θεοῦ καλόν, καὶ οὐδὲν ἀπόβλητον μετὰ εὐχαριστίας λαμβανόμενον,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἁγιάζεται γὰρ διὰ λόγου θεοῦ καὶ ἐντεύξεως."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ταῦτα ὑποτιθέμενος τοῖς ἀδελφοῖς καλὸς ἔσῃ διάκονος ⸂Χριστοῦ Ἰησοῦ",
          {
            "noteId": 22
          },
          ", ἐντρεφόμενος τοῖς λόγοις τῆς πίστεως καὶ τῆς καλῆς διδασκαλίας ᾗ παρηκολούθηκας,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "τοὺς δὲ βεβήλους καὶ γραώδεις μύθους παραιτοῦ. γύμναζε δὲ σεαυτὸν πρὸς εὐσέβειαν·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἡ γὰρ σωματικὴ γυμνασία πρὸς ὀλίγον ἐστὶν ὠφέλιμος, ἡ δὲ εὐσέβεια πρὸς πάντα ὠφέλιμός ἐστιν, ἐπαγγελίαν ἔχουσα ζωῆς τῆς νῦν καὶ τῆς μελλούσης."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "πιστὸς ὁ λόγος καὶ πάσης ἀποδοχῆς ἄξιος,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "εἰς τοῦτο ⸀γὰρ",
          {
            "noteId": 23
          },
          "κοπιῶμεν καὶ ⸀ὀνειδιζόμεθα",
          {
            "noteId": 24
          },
          "ὅτι ἠλπίκαμεν ἐπὶ θεῷ ζῶντι, ὅς ἐστιν σωτὴρ πάντων ἀνθρώπων, μάλιστα πιστῶν."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Παράγγελλε ταῦτα καὶ δίδασκε."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "μηδείς σου τῆς νεότητος καταφρονείτω, ἀλλὰ τύπος γίνου τῶν πιστῶν ἐν λόγῳ, ἐν ἀναστροφῇ, ἐν ⸀ἀγάπῃ",
          {
            "noteId": 25
          },
          "ἐν πίστει, ἐν ἁγνείᾳ."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ἕως ἔρχομαι πρόσεχε τῇ ἀναγνώσει, τῇ παρακλήσει, τῇ διδασκαλίᾳ."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "μὴ ἀμέλει τοῦ ἐν σοὶ χαρίσματος, ὃ ἐδόθη σοι διὰ προφητείας μετὰ ἐπιθέσεως τῶν χειρῶν τοῦ πρεσβυτερίου."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ταῦτα μελέτα, ἐν τούτοις ἴσθι, ἵνα σου ἡ προκοπὴ φανερὰ ⸀ᾖ",
          {
            "noteId": 26
          },
          "πᾶσιν·"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ἔπεχε σεαυτῷ καὶ τῇ διδασκαλίᾳ· ἐπίμενε αὐτοῖς· τοῦτο γὰρ ποιῶν καὶ σεαυτὸν σώσεις καὶ τοὺς ἀκούοντάς σου."
        ]
      }
    ],
