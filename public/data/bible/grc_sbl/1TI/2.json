  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Παρακαλῶ οὖν πρῶτον πάντων ποιεῖσθαι δεήσεις, προσευχάς, ἐντεύξεις, εὐχαριστίας, ὑπὲρ πάντων ἀνθρώπων,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ὑπὲρ βασιλέων καὶ πάντων τῶν ἐν ὑπεροχῇ ὄντων, ἵνα ἤρεμον καὶ ἡσύχιον βίον διάγωμεν ἐν πάσῃ εὐσεβείᾳ καὶ σεμνότητι."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "⸀τοῦτο",
          {
            "noteId": 10
          },
          "καλὸν καὶ ἀπόδεκτον ἐνώπιον τοῦ σωτῆρος ἡμῶν θεοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ὃς πάντας ἀνθρώπους θέλει σωθῆναι καὶ εἰς ἐπίγνωσιν ἀληθείας ἐλθεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "εἷς γὰρ θεός, εἷς καὶ μεσίτης θεοῦ καὶ ἀνθρώπων ἄνθρωπος Χριστὸς Ἰησοῦς,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ὁ δοὺς ἑαυτὸν ἀντίλυτρον ὑπὲρ πάντων, τὸ μαρτύριον καιροῖς ἰδίοις·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "εἰς ὃ ἐτέθην ἐγὼ κῆρυξ καὶ ἀπόστολος— ἀλήθειαν ⸀λέγω",
          {
            "noteId": 11
          },
          "οὐ ψεύδομαι— διδάσκαλος ἐθνῶν ἐν πίστει καὶ ἀληθείᾳ."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Βούλομαι οὖν προσεύχεσθαι τοὺς ἄνδρας ἐν παντὶ τόπῳ, ἐπαίροντας ὁσίους χεῖρας χωρὶς ὀργῆς καὶ ⸀διαλογισμοῦ",
          {
            "noteId": 12
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ὡσαύτως ⸀καὶ",
          {
            "noteId": 13
          },
          "γυναῖκας ἐν καταστολῇ κοσμίῳ μετὰ αἰδοῦς καὶ",
          {
            "noteId": 14
          },
          "σωφροσύνης κοσμεῖν ἑαυτάς, μὴ ἐν πλέγμασιν ⸀καὶ ⸀χρυσίῳ",
          {
            "noteId": 15
          },
          "ἢ μαργαρίταις ἢ ἱματισμῷ πολυτελεῖ,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἀλλʼ ὃ πρέπει γυναιξὶν ἐπαγγελλομέναις θεοσέβειαν, διʼ ἔργων ἀγαθῶν."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "γυνὴ ἐν ἡσυχίᾳ μανθανέτω ἐν πάσῃ ὑποταγῇ·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "⸂διδάσκειν δὲ γυναικὶ",
          {
            "noteId": 16
          },
          "οὐκ ἐπιτρέπω, οὐδὲ αὐθεντεῖν ἀνδρός, ἀλλʼ εἶναι ἐν ἡσυχίᾳ."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ἀδὰμ γὰρ πρῶτος ἐπλάσθη, εἶτα Εὕα·"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καὶ Ἀδὰμ οὐκ ἠπατήθη, ἡ δὲ γυνὴ ⸀ἐξαπατηθεῖσα",
          {
            "noteId": 17
          },
          "ἐν παραβάσει γέγονεν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "σωθήσεται δὲ διὰ τῆς τεκνογονίας, ἐὰν μείνωσιν ἐν πίστει καὶ ἀγάπῃ καὶ ἁγιασμῷ μετὰ σωφροσύνης."
        ]
      }
    ],
