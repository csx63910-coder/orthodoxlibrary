  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Πέτρος ἀπόστολος Ἰησοῦ Χριστοῦ ἐκλεκτοῖς παρεπιδήμοις διασπορᾶς Πόντου, Γαλατίας, Καππαδοκίας, Ἀσίας, καὶ Βιθυνίας,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "κατὰ πρόγνωσιν θεοῦ πατρός, ἐν ἁγιασμῷ πνεύματος, εἰς ὑπακοὴν καὶ ῥαντισμὸν αἵματος Ἰησοῦ Χριστοῦ· χάρις ὑμῖν καὶ εἰρήνη πληθυνθείη."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Εὐλογητὸς ὁ θεὸς καὶ πατὴρ τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ, ὁ κατὰ τὸ πολὺ αὐτοῦ ἔλεος ἀναγεννήσας ἡμᾶς εἰς ἐλπίδα ζῶσαν διʼ ἀναστάσεως Ἰησοῦ Χριστοῦ ἐκ νεκρῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "εἰς κληρονομίαν ἄφθαρτον καὶ ἀμίαντον καὶ ἀμάραντον, τετηρημένην ἐν οὐρανοῖς εἰς ὑμᾶς"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "τοὺς ἐν δυνάμει θεοῦ φρουρουμένους διὰ πίστεως εἰς σωτηρίαν ἑτοίμην ἀποκαλυφθῆναι ἐν καιρῷ ἐσχάτῳ."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἐν ᾧ ἀγαλλιᾶσθε, ὀλίγον ἄρτι εἰ ⸀δέον",
          {
            "noteId": 0
          },
          "⸀λυπηθέντες",
          {
            "noteId": 1
          },
          "ἐν ποικίλοις πειρασμοῖς,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἵνα τὸ δοκίμιον ὑμῶν τῆς πίστεως ⸀πολυτιμότερον",
          {
            "noteId": 2
          },
          "χρυσίου τοῦ ἀπολλυμένου διὰ πυρὸς δὲ δοκιμαζομένου εὑρεθῇ εἰς ἔπαινον καὶ ⸂δόξαν καὶ τιμὴν",
          {
            "noteId": 3
          },
          "ἐν ἀποκαλύψει Ἰησοῦ Χριστοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ὃν οὐκ ⸀ἰδόντες",
          {
            "noteId": 4
          },
          "ἀγαπᾶτε, εἰς ὃν ἄρτι μὴ ὁρῶντες πιστεύοντες δὲ ⸀ἀγαλλιᾶσθε",
          {
            "noteId": 5
          },
          "χαρᾷ ἀνεκλαλήτῳ καὶ δεδοξασμένῃ,"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "κομιζόμενοι τὸ τέλος τῆς πίστεως ⸀ὑμῶν",
          {
            "noteId": 6
          },
          "σωτηρίαν ψυχῶν."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Περὶ ἧς σωτηρίας ἐξεζήτησαν καὶ ἐξηραύνησαν προφῆται οἱ περὶ τῆς εἰς ὑμᾶς χάριτος προφητεύσαντες,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ἐραυνῶντες εἰς τίνα ἢ ποῖον καιρὸν ἐδήλου τὸ ἐν αὐτοῖς πνεῦμα Χριστοῦ προμαρτυρόμενον τὰ εἰς Χριστὸν παθήματα καὶ τὰς μετὰ ταῦτα δόξας·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "οἷς ἀπεκαλύφθη ὅτι οὐχ ἑαυτοῖς ὑμῖν δὲ διηκόνουν αὐτά, ἃ νῦν ἀνηγγέλη ὑμῖν διὰ τῶν εὐαγγελισαμένων ⸀ὑμᾶς",
          {
            "noteId": 7
          },
          "πνεύματι ἁγίῳ ἀποσταλέντι ἀπʼ οὐρανοῦ, εἰς ἃ ἐπιθυμοῦσιν ἄγγελοι παρακύψαι."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Διὸ ἀναζωσάμενοι τὰς ὀσφύας τῆς διανοίας ὑμῶν, νήφοντες τελείως, ἐλπίσατε ἐπὶ τὴν φερομένην ὑμῖν χάριν ἐν ἀποκαλύψει Ἰησοῦ Χριστοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ὡς τέκνα ὑπακοῆς, μὴ συσχηματιζόμενοι ταῖς πρότερον ἐν τῇ ἀγνοίᾳ ὑμῶν ἐπιθυμίαις,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ἀλλὰ κατὰ τὸν καλέσαντα ὑμᾶς ἅγιον καὶ αὐτοὶ ἅγιοι ἐν πάσῃ ἀναστροφῇ γενήθητε,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "διότι γέγραπται ⸀ὅτι",
          {
            "noteId": 8
          },
          "Ἅγιοι ⸀ἔσεσθε",
          {
            "noteId": 9
          },
          "ὅτι ἐγὼ ⸀ἅγιος",
          {
            "noteId": 10
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Καὶ εἰ πατέρα ἐπικαλεῖσθε τὸν ἀπροσωπολήμπτως κρίνοντα κατὰ τὸ ἑκάστου ἔργον, ἐν φόβῳ τὸν τῆς παροικίας ὑμῶν χρόνον ἀναστράφητε·"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "εἰδότες ὅτι οὐ φθαρτοῖς, ἀργυρίῳ ἢ χρυσίῳ, ἐλυτρώθητε ἐκ τῆς ματαίας ὑμῶν ἀναστροφῆς πατροπαραδότου,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἀλλὰ τιμίῳ αἵματι ὡς ἀμνοῦ ἀμώμου καὶ ἀσπίλου Χριστοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "προεγνωσμένου μὲν πρὸ καταβολῆς κόσμου, φανερωθέντος δὲ ἐπʼ ⸀ἐσχάτου",
          {
            "noteId": 11
          },
          "τῶν χρόνων διʼ ὑμᾶς"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "τοὺς διʼ αὐτοῦ ⸀πιστοὺς",
          {
            "noteId": 12
          },
          "εἰς θεὸν τὸν ἐγείραντα αὐτὸν ἐκ νεκρῶν καὶ δόξαν αὐτῷ δόντα, ὥστε τὴν πίστιν ὑμῶν καὶ ἐλπίδα εἶναι εἰς θεόν."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Τὰς ψυχὰς ὑμῶν ἡγνικότες ἐν τῇ ὑπακοῇ τῆς ⸀ἀληθείας",
          {
            "noteId": 13
          },
          "εἰς φιλαδελφίαν ἀνυπόκριτον ⸀ἐκ",
          {
            "noteId": 14
          },
          "καρδίας ἀλλήλους ἀγαπήσατε ἐκτενῶς,"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ἀναγεγεννημένοι οὐκ ἐκ σπορᾶς φθαρτῆς ἀλλὰ ἀφθάρτου, διὰ λόγου ζῶντος θεοῦ καὶ ⸀μένοντος",
          {
            "noteId": 15
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "διότι πᾶσα σὰρξ ὡς χόρτος, καὶ πᾶσα δόξα ⸀αὐτῆς",
          {
            "noteId": 16
          },
          "ὡς ἄνθος",
          {
            "noteId": 17
          },
          "χόρτου· ἐξηράνθη ὁ χόρτος, καὶ τὸ ⸀ἄνθος ἐξέπεσεν·"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "τὸ δὲ ῥῆμα κυρίου μένει εἰς τὸν αἰῶνα. τοῦτο δέ ἐστιν τὸ ῥῆμα τὸ εὐαγγελισθὲν εἰς ὑμᾶς."
        ]
      }
    ],
