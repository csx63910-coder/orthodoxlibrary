    "order": 60,
    "numberOfChapters": 5,
    "sha256": "5fdd93a7c517d7a45c8185e838fbd9f6f86e0694ccbd1d5acd37c64289637ee2",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_sbl/1PE/1.json",
