  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Χριστοῦ οὖν ⸀παθόντος",
          {
            "noteId": 56
          },
          "σαρκὶ καὶ ὑμεῖς τὴν αὐτὴν ἔννοιαν ὁπλίσασθε, ὅτι ὁ ⸀παθὼν",
          {
            "noteId": 57
          },
          "σαρκὶ πέπαυται ⸀ἁμαρτίας",
          {
            "noteId": 58
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "εἰς τὸ μηκέτι ἀνθρώπων ἐπιθυμίαις ἀλλὰ θελήματι θεοῦ τὸν ἐπίλοιπον ἐν σαρκὶ βιῶσαι χρόνον."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἀρκετὸς ⸀γὰρ",
          {
            "noteId": 59
          },
          "ὁ παρεληλυθὼς ⸀χρόνος",
          {
            "noteId": 60
          },
          "τὸ ⸀βούλημα",
          {
            "noteId": 61
          },
          "τῶν ἐθνῶν ⸀κατειργάσθαι",
          {
            "noteId": 62
          },
          "πεπορευμένους ἐν ἀσελγείαις, ἐπιθυμίαις, οἰνοφλυγίαις, κώμοις, πότοις, καὶ ἀθεμίτοις εἰδωλολατρίαις."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἐν ᾧ ξενίζονται μὴ συντρεχόντων ὑμῶν εἰς τὴν αὐτὴν τῆς ἀσωτίας ἀνάχυσιν, βλασφημοῦντες·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "οἳ ἀποδώσουσιν λόγον τῷ ἑτοίμως ⸂ἔχοντι κρῖναι",
          {
            "noteId": 63
          },
          "ζῶντας καὶ νεκρούς·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "εἰς τοῦτο γὰρ καὶ νεκροῖς εὐηγγελίσθη ἵνα κριθῶσι μὲν κατὰ ἀνθρώπους σαρκὶ ζῶσι δὲ κατὰ θεὸν πνεύματι."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Πάντων δὲ τὸ τέλος ἤγγικεν. σωφρονήσατε οὖν καὶ νήψατε ⸀εἰς",
          {
            "noteId": 64
          },
          "προσευχάς·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "πρὸ ⸀πάντων",
          {
            "noteId": 65
          },
          "τὴν εἰς ἑαυτοὺς ἀγάπην ἐκτενῆ ἔχοντες, ὅτι ἀγάπη ⸀καλύπτει",
          {
            "noteId": 66
          },
          "πλῆθος ἁμαρτιῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "φιλόξενοι εἰς ἀλλήλους ἄνευ ⸀γογγυσμοῦ",
          {
            "noteId": 67
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἕκαστος καθὼς ἔλαβεν χάρισμα, εἰς ἑαυτοὺς αὐτὸ διακονοῦντες ὡς καλοὶ οἰκονόμοι ποικίλης χάριτος θεοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "εἴ τις λαλεῖ, ὡς λόγια θεοῦ· εἴ τις διακονεῖ, ὡς ἐξ ἰσχύος ⸀ἧς",
          {
            "noteId": 68
          },
          "χορηγεῖ ὁ θεός· ἵνα ἐν πᾶσιν δοξάζηται ὁ θεὸς διὰ Ἰησοῦ Χριστοῦ, ᾧ ἐστιν ἡ δόξα καὶ τὸ κράτος εἰς τοὺς αἰῶνας τῶν αἰώνων· ἀμήν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ἀγαπητοί, μὴ ξενίζεσθε τῇ ἐν ὑμῖν πυρώσει πρὸς πειρασμὸν ὑμῖν γινομένῃ ὡς ξένου ὑμῖν συμβαίνοντος,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ἀλλὰ καθὸ κοινωνεῖτε τοῖς τοῦ Χριστοῦ παθήμασιν χαίρετε, ἵνα καὶ ἐν τῇ ἀποκαλύψει τῆς δόξης αὐτοῦ χαρῆτε ἀγαλλιώμενοι."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "εἰ ὀνειδίζεσθε ἐν ὀνόματι Χριστοῦ, μακάριοι, ὅτι τὸ τῆς δόξης καὶ τὸ τοῦ θεοῦ πνεῦμα ἐφʼ ὑμᾶς ⸀ἀναπαύεται",
          {
            "noteId": 69
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "μὴ γάρ τις ὑμῶν πασχέτω ὡς φονεὺς ἢ κλέπτης ἢ κακοποιὸς ἢ ὡς ἀλλοτριεπίσκοπος·"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "εἰ δὲ ὡς Χριστιανός, μὴ αἰσχυνέσθω, δοξαζέτω δὲ τὸν θεὸν ἐν τῷ ⸀ὀνόματι",
          {
            "noteId": 70
          },
          "τούτῳ."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ὅτι ὁ καιρὸς τοῦ ἄρξασθαι τὸ κρίμα ἀπὸ τοῦ οἴκου τοῦ θεοῦ· εἰ δὲ πρῶτον ἀφʼ ἡμῶν, τί τὸ τέλος τῶν ἀπειθούντων τῷ τοῦ θεοῦ εὐαγγελίῳ;"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ εἰ ὁ",
          {
            "noteId": 71
          },
          "δίκαιος μόλις σῴζεται, ⸀ὁ ἀσεβὴς καὶ ἁμαρτωλὸς ποῦ φανεῖται;"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ὥστε καὶ οἱ πάσχοντες κατὰ τὸ θέλημα τοῦ ⸀θεοῦ",
          {
            "noteId": 72
          },
          "πιστῷ κτίστῃ παρατιθέσθωσαν τὰς ψυχὰς ⸀αὐτῶν",
          {
            "noteId": 73
          },
          "ἐν ἀγαθοποιΐᾳ."
        ]
      }
    ],
