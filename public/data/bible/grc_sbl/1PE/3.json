  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "⸀Ὁμοίως",
          {
            "noteId": 35
          },
          "γυναῖκες ὑποτασσόμεναι τοῖς ἰδίοις ἀνδράσιν, ἵνα ⸀καὶ",
          {
            "noteId": 36
          },
          "εἴ τινες ἀπειθοῦσιν τῷ λόγῳ διὰ τῆς τῶν γυναικῶν ἀναστροφῆς ἄνευ λόγου κερδηθήσονται"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἐποπτεύσαντες τὴν ἐν φόβῳ ἁγνὴν ἀναστροφὴν ὑμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ὧν ἔστω οὐχ ὁ ἔξωθεν ἐμπλοκῆς τριχῶν καὶ περιθέσεως χρυσίων ἢ ἐνδύσεως ἱματίων κόσμος,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἀλλʼ ὁ κρυπτὸς τῆς καρδίας ἄνθρωπος ἐν τῷ ἀφθάρτῳ τοῦ ⸂πραέως καὶ ἡσυχίου",
          {
            "noteId": 37
          },
          "πνεύματος, ὅ ἐστιν ἐνώπιον τοῦ θεοῦ πολυτελές."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "οὕτως γάρ ποτε καὶ αἱ ἅγιαι γυναῖκες αἱ ἐλπίζουσαι ⸀εἰς",
          {
            "noteId": 38
          },
          "θεὸν ἐκόσμουν ἑαυτάς, ὑποτασσόμεναι τοῖς ἰδίοις ἀνδράσιν,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ὡς Σάρρα ⸀ὑπήκουσεν",
          {
            "noteId": 39
          },
          "τῷ Ἀβραάμ, κύριον αὐτὸν καλοῦσα· ἧς ἐγενήθητε τέκνα ἀγαθοποιοῦσαι καὶ μὴ φοβούμεναι μηδεμίαν πτόησιν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Οἱ ἄνδρες ὁμοίως συνοικοῦντες κατὰ γνῶσιν, ὡς ἀσθενεστέρῳ σκεύει τῷ γυναικείῳ ἀπονέμοντες τιμήν, ὡς καὶ ⸀συγκληρονόμοις",
          {
            "noteId": 40
          },
          "χάριτος ζωῆς, εἰς τὸ μὴ ἐγκόπτεσθαι τὰς προσευχὰς ὑμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Τὸ δὲ τέλος πάντες ὁμόφρονες, συμπαθεῖς, φιλάδελφοι, εὔσπλαγχνοι, ⸀ταπεινόφρονες",
          {
            "noteId": 41
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "μὴ ἀποδιδόντες κακὸν ἀντὶ κακοῦ ἢ λοιδορίαν ἀντὶ λοιδορίας τοὐναντίον δὲ ⸀εὐλογοῦντες",
          {
            "noteId": 42
          },
          "ὅτι εἰς τοῦτο ἐκλήθητε ἵνα εὐλογίαν κληρονομήσητε."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ὁ γὰρ θέλων ζωὴν ἀγαπᾶν καὶ ἰδεῖν ἡμέρας ἀγαθὰς παυσάτω τὴν ⸀γλῶσσαν",
          {
            "noteId": 43
          },
          "ἀπὸ κακοῦ καὶ ⸀χείλη",
          {
            "noteId": 44
          },
          "τοῦ μὴ λαλῆσαι δόλον,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ἐκκλινάτω ⸀δὲ",
          {
            "noteId": 45
          },
          "ἀπὸ κακοῦ καὶ ποιησάτω ἀγαθόν, ζητησάτω εἰρήνην καὶ διωξάτω αὐτήν·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ὅτι ὀφθαλμοὶ κυρίου ἐπὶ δικαίους καὶ ὦτα αὐτοῦ εἰς δέησιν αὐτῶν, πρόσωπον δὲ κυρίου ἐπὶ ποιοῦντας κακά."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Καὶ τίς ὁ κακώσων ὑμᾶς ἐὰν τοῦ ἀγαθοῦ ⸀ζηλωταὶ",
          {
            "noteId": 46
          },
          "γένησθε;"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἀλλʼ εἰ καὶ πάσχοιτε διὰ δικαιοσύνην, μακάριοι. τὸν δὲ φόβον αὐτῶν μὴ φοβηθῆτε μηδὲ ταραχθῆτε,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "κύριον δὲ τὸν ⸀Χριστὸν",
          {
            "noteId": 47
          },
          "ἁγιάσατε ἐν ταῖς καρδίαις ὑμῶν, ⸀ἕτοιμοι",
          {
            "noteId": 48
          },
          "ἀεὶ πρὸς ἀπολογίαν παντὶ τῷ αἰτοῦντι ὑμᾶς λόγον περὶ τῆς ἐν ὑμῖν ἐλπίδος,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "⸀ἀλλὰ",
          {
            "noteId": 49
          },
          "μετὰ πραΰτητος καὶ φόβου, συνείδησιν ἔχοντες ἀγαθήν, ἵνα ἐν ᾧ ⸀καταλαλεῖσθε",
          {
            "noteId": 50
          },
          "καταισχυνθῶσιν οἱ ἐπηρεάζοντες ὑμῶν τὴν ἀγαθὴν ἐν Χριστῷ ἀναστροφήν."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "κρεῖττον γὰρ ἀγαθοποιοῦντας, εἰ θέλοι τὸ θέλημα τοῦ θεοῦ, πάσχειν ἢ κακοποιοῦντας."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ὅτι καὶ Χριστὸς ἅπαξ περὶ ἁμαρτιῶν ⸀ἔπαθεν",
          {
            "noteId": 51
          },
          "δίκαιος ὑπὲρ ἀδίκων, ἵνα ⸀ὑμᾶς",
          {
            "noteId": 52
          },
          "προσαγάγῃ τῷ θεῷ, θανατωθεὶς μὲν σαρκὶ ζῳοποιηθεὶς δὲ πνεύματι·"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἐν ᾧ καὶ τοῖς ἐν φυλακῇ πνεύμασιν πορευθεὶς ἐκήρυξεν,"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἀπειθήσασίν ποτε ὅτε ἀπεξεδέχετο ἡ τοῦ θεοῦ μακροθυμία ἐν ἡμέραις Νῶε κατασκευαζομένης κιβωτοῦ εἰς ἣν ⸀ὀλίγοι",
          {
            "noteId": 53
          },
          "τοῦτʼ ἔστιν ὀκτὼ ψυχαί, διεσώθησαν διʼ ὕδατος."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ὃ ⸂καὶ ὑμᾶς ἀντίτυπον νῦν",
          {
            "noteId": 54
          },
          "σῴζει βάπτισμα, οὐ σαρκὸς ἀπόθεσις ῥύπου ἀλλὰ συνειδήσεως ἀγαθῆς ἐπερώτημα εἰς θεόν, διʼ ἀναστάσεως Ἰησοῦ Χριστοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ὅς ἐστιν ἐν ⸀δεξιᾷ",
          {
            "noteId": 55
          },
          "θεοῦ πορευθεὶς εἰς οὐρανὸν ὑποταγέντων αὐτῷ ἀγγέλων καὶ ἐξουσιῶν καὶ δυνάμεων."
        ]
      }
    ],
