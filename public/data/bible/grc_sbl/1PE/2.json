  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἀποθέμενοι οὖν πᾶσαν κακίαν καὶ πάντα δόλον καὶ ⸀ὑποκρίσεις",
          {
            "noteId": 18
          },
          "καὶ φθόνους καὶ πάσας καταλαλιάς,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ὡς ἀρτιγέννητα βρέφη τὸ λογικὸν ἄδολον γάλα ἐπιποθήσατε, ἵνα ἐν αὐτῷ αὐξηθῆτε ⸂εἰς σωτηρίαν",
          {
            "noteId": 19
          },
          ","
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "⸀εἰ",
          {
            "noteId": 20
          },
          "ἐγεύσασθε ὅτι χρηστὸς ὁ κύριος."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Πρὸς ὃν προσερχόμενοι, λίθον ζῶντα, ὑπὸ ἀνθρώπων μὲν ἀποδεδοκιμασμένον παρὰ δὲ θεῷ ἐκλεκτὸν ἔντιμον"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ αὐτοὶ ὡς λίθοι ζῶντες οἰκοδομεῖσθε οἶκος πνευματικὸς ⸀εἰς",
          {
            "noteId": 21
          },
          "ἱεράτευμα ἅγιον, ἀνενέγκαι πνευματικὰς θυσίας ⸀εὐπροσδέκτους",
          {
            "noteId": 22
          },
          "θεῷ διὰ Ἰησοῦ Χριστοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "διότι περιέχει ⸀ἐν",
          {
            "noteId": 23
          },
          "γραφῇ· Ἰδοὺ τίθημι ἐν Σιὼν λίθον ⸂ἀκρογωνιαῖον ἐκλεκτὸν",
          {
            "noteId": 24
          },
          "ἔντιμον, καὶ ὁ πιστεύων ἐπʼ αὐτῷ οὐ μὴ καταισχυνθῇ."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ὑμῖν οὖν ἡ τιμὴ τοῖς πιστεύουσιν· ⸀ἀπιστοῦσιν",
          {
            "noteId": 25
          },
          "δὲ ⸀λίθος",
          {
            "noteId": 26
          },
          "ὃν ἀπεδοκίμασαν οἱ οἰκοδομοῦντες οὗτος ἐγενήθη εἰς κεφαλὴν γωνίας"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ λίθος προσκόμματος καὶ πέτρα σκανδάλου· οἳ προσκόπτουσιν τῷ λόγῳ ἀπειθοῦντες· εἰς ὃ καὶ ἐτέθησαν."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Ὑμεῖς δὲ γένος ἐκλεκτόν, βασίλειον ἱεράτευμα, ἔθνος ἅγιον, λαὸς εἰς περιποίησιν, ὅπως τὰς ἀρετὰς ἐξαγγείλητε τοῦ ἐκ σκότους ὑμᾶς καλέσαντος εἰς τὸ θαυμαστὸν αὐτοῦ φῶς·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "οἵ ποτε οὐ λαὸς νῦν δὲ λαὸς θεοῦ, οἱ οὐκ ἠλεημένοι νῦν δὲ ἐλεηθέντες."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ἀγαπητοί, παρακαλῶ ὡς παροίκους καὶ παρεπιδήμους ἀπέχεσθαι τῶν σαρκικῶν ἐπιθυμιῶν, αἵτινες στρατεύονται κατὰ τῆς ψυχῆς·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "τὴν ἀναστροφὴν ὑμῶν ⸂ἐν τοῖς ἔθνεσιν ἔχοντες καλήν",
          {
            "noteId": 27
          },
          ", ἵνα, ἐν ᾧ καταλαλοῦσιν ὑμῶν ὡς κακοποιῶν, ἐκ τῶν καλῶν ἔργων ⸀ἐποπτεύοντες",
          {
            "noteId": 28
          },
          "δοξάσωσι τὸν θεὸν ἐν ἡμέρᾳ ἐπισκοπῆς."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "⸀Ὑποτάγητε",
          {
            "noteId": 29
          },
          "πάσῃ ἀνθρωπίνῃ κτίσει διὰ τὸν κύριον· εἴτε βασιλεῖ ὡς ὑπερέχοντι,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "εἴτε ἡγεμόσιν ὡς διʼ αὐτοῦ πεμπομένοις εἰς ἐκδίκησιν κακοποιῶν ἔπαινον δὲ ἀγαθοποιῶν"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "(ὅτι οὕτως ἐστὶν τὸ θέλημα τοῦ θεοῦ, ἀγαθοποιοῦντας φιμοῦν τὴν τῶν ἀφρόνων ἀνθρώπων ἀγνωσίαν)·"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ὡς ἐλεύθεροι, καὶ μὴ ὡς ἐπικάλυμμα ἔχοντες τῆς κακίας τὴν ἐλευθερίαν, ἀλλʼ ὡς ⸂θεοῦ δοῦλοι",
          {
            "noteId": 30
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "πάντας τιμήσατε, τὴν ἀδελφότητα ⸀ἀγαπᾶτε",
          {
            "noteId": 31
          },
          "τὸν θεὸν φοβεῖσθε, τὸν βασιλέα τιμᾶτε."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Οἱ οἰκέται ὑποτασσόμενοι ἐν παντὶ φόβῳ τοῖς δεσπόταις, οὐ μόνον τοῖς ἀγαθοῖς καὶ ἐπιεικέσιν ἀλλὰ καὶ τοῖς σκολιοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "τοῦτο γὰρ χάρις εἰ διὰ συνείδησιν θεοῦ ὑποφέρει τις λύπας πάσχων ἀδίκως·"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ποῖον γὰρ κλέος εἰ ἁμαρτάνοντες καὶ κολαφιζόμενοι ὑπομενεῖτε; ἀλλʼ εἰ ἀγαθοποιοῦντες καὶ πάσχοντες ὑπομενεῖτε, τοῦτο χάρις παρὰ θεῷ."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "εἰς τοῦτο γὰρ ἐκλήθητε, ὅτι καὶ Χριστὸς ἔπαθεν ὑπὲρ ⸀ὑμῶν",
          {
            "noteId": 32
          },
          "ὑμῖν ὑπολιμπάνων ὑπογραμμὸν ἵνα ἐπακολουθήσητε τοῖς ἴχνεσιν αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ὃς ἁμαρτίαν οὐκ ἐποίησεν οὐδὲ εὑρέθη δόλος ἐν τῷ στόματι αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ὃς λοιδορούμενος οὐκ ἀντελοιδόρει, πάσχων οὐκ ἠπείλει, παρεδίδου δὲ τῷ κρίνοντι δικαίως·"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ὃς τὰς ἁμαρτίας ἡμῶν αὐτὸς ἀνήνεγκεν ἐν τῷ σώματι αὐτοῦ ἐπὶ τὸ ξύλον, ἵνα ταῖς ἁμαρτίαις ἀπογενόμενοι τῇ δικαιοσύνῃ ζήσωμεν· οὗ τῷ ⸀μώλωπι",
          {
            "noteId": 33
          },
          "ἰάθητε."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ἦτε γὰρ ὡς πρόβατα ⸀πλανώμενοι",
          {
            "noteId": 34
          },
          "ἀλλὰ ἐπεστράφητε νῦν ἐπὶ τὸν ποιμένα καὶ ἐπίσκοπον τῶν ψυχῶν ὑμῶν."
        ]
      }
    ],
