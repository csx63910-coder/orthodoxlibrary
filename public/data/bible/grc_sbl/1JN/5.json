  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Πᾶς ὁ πιστεύων ὅτι Ἰησοῦς ἐστιν ὁ χριστὸς ἐκ τοῦ θεοῦ γεγέννηται, καὶ",
          {
            "noteId": 52
          },
          "πᾶς ὁ ἀγαπῶν τὸν γεννήσαντα ἀγαπᾷ ⸀καὶ τὸν γεγεννημένον ἐξ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἐν τούτῳ γινώσκομεν ὅτι ἀγαπῶμεν τὰ τέκνα τοῦ θεοῦ, ὅταν τὸν θεὸν ἀγαπῶμεν καὶ τὰς ἐντολὰς αὐτοῦ ⸀ποιῶμεν",
          {
            "noteId": 53
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "αὕτη γάρ ἐστιν ἡ ἀγάπη τοῦ θεοῦ ἵνα τὰς ἐντολὰς αὐτοῦ τηρῶμεν, καὶ αἱ ἐντολαὶ αὐτοῦ βαρεῖαι οὐκ εἰσίν,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ὅτι πᾶν τὸ γεγεννημένον ἐκ τοῦ θεοῦ νικᾷ τὸν κόσμον. καὶ αὕτη ἐστὶν ἡ νίκη ἡ νικήσασα τὸν κόσμον, ἡ πίστις ἡμῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "τίς ⸂δέ ἐστιν",
          {
            "noteId": 54
          },
          "ὁ νικῶν τὸν κόσμον εἰ μὴ ὁ πιστεύων ὅτι Ἰησοῦς ἐστιν ὁ υἱὸς τοῦ θεοῦ;"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Οὗτός ἐστιν ὁ ἐλθὼν διʼ ὕδατος καὶ αἵματος, Ἰησοῦς Χριστός· οὐκ ἐν",
          {
            "noteId": 55
          },
          "τῷ ὕδατι μόνον ἀλλʼ ἐν τῷ ὕδατι καὶ ⸀ἐν τῷ αἵματι· καὶ τὸ πνεῦμά ἐστιν τὸ μαρτυροῦν, ὅτι τὸ πνεῦμά ἐστιν ἡ ἀλήθεια."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ὅτι τρεῖς εἰσιν οἱ μαρτυροῦντες,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "τὸ πνεῦμα καὶ τὸ ὕδωρ καὶ τὸ αἷμα, καὶ οἱ τρεῖς εἰς τὸ ἕν εἰσιν."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "εἰ τὴν μαρτυρίαν τῶν ἀνθρώπων λαμβάνομεν, ἡ μαρτυρία τοῦ θεοῦ μείζων ἐστίν, ὅτι",
          {
            "noteId": 56
          },
          "αὕτη ἐστὶν ἡ μαρτυρία τοῦ θεοῦ ⸀ὅτι μεμαρτύρηκεν περὶ τοῦ υἱοῦ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ὁ πιστεύων εἰς τὸν υἱὸν τοῦ θεοῦ ἔχει τὴν μαρτυρίαν ἐν ⸀αὑτῷ",
          {
            "noteId": 57
          },
          "ὁ μὴ πιστεύων τῷ θεῷ ψεύστην πεποίηκεν αὐτόν, ὅτι οὐ πεπίστευκεν εἰς τὴν μαρτυρίαν ἣν μεμαρτύρηκεν ὁ θεὸς περὶ τοῦ υἱοῦ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ αὕτη ἐστὶν ἡ μαρτυρία, ὅτι ζωὴν αἰώνιον ἔδωκεν ⸂ὁ θεὸς ἡμῖν",
          {
            "noteId": 58
          },
          ", καὶ αὕτη ἡ ζωὴ ἐν τῷ υἱῷ αὐτοῦ ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ὁ ἔχων τὸν υἱὸν ἔχει τὴν ζωήν· ὁ μὴ ἔχων τὸν υἱὸν τοῦ θεοῦ τὴν ζωὴν οὐκ ἔχει."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ταῦτα ἔγραψα ⸀ὑμῖν",
          {
            "noteId": 59
          },
          "ἵνα εἰδῆτε ὅτι ζωὴν ⸂ἔχετε αἰώνιον",
          {
            "noteId": 60
          },
          ", ⸂τοῖς πιστεύουσιν",
          {
            "noteId": 61
          },
          "εἰς τὸ ὄνομα τοῦ υἱοῦ τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καὶ αὕτη ἐστὶν ἡ παρρησία ἣν ἔχομεν πρὸς αὐτόν, ὅτι ἐάν τι αἰτώμεθα κατὰ τὸ θέλημα αὐτοῦ ἀκούει ἡμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ ἐὰν",
          {
            "noteId": 62
          },
          "οἴδαμεν ὅτι ἀκούει ἡμῶν ὃ ⸀ἐὰν αἰτώμεθα, οἴδαμεν ὅτι ἔχομεν τὰ αἰτήματα ἃ ᾐτήκαμεν ⸀ἀπʼ",
          {
            "noteId": 63
          },
          "αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ἐάν τις ἴδῃ τὸν ἀδελφὸν αὐτοῦ ἁμαρτάνοντα ἁμαρτίαν μὴ πρὸς θάνατον, αἰτήσει, καὶ δώσει αὐτῷ ζωήν, τοῖς ἁμαρτάνουσιν μὴ πρὸς θάνατον. ἔστιν ἁμαρτία πρὸς θάνατον· οὐ περὶ ἐκείνης λέγω ἵνα ἐρωτήσῃ."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "πᾶσα ἀδικία ἁμαρτία ἐστίν, καὶ ἔστιν ἁμαρτία οὐ πρὸς θάνατον."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Οἴδαμεν ὅτι πᾶς ὁ γεγεννημένος ἐκ τοῦ θεοῦ οὐχ ἁμαρτάνει, ἀλλʼ ὁ γεννηθεὶς ἐκ τοῦ θεοῦ τηρεῖ ⸀αὐτόν",
          {
            "noteId": 64
          },
          "καὶ ὁ πονηρὸς οὐχ ἅπτεται αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "οἴδαμεν ὅτι ἐκ τοῦ θεοῦ ἐσμεν, καὶ ὁ κόσμος ὅλος ἐν τῷ πονηρῷ κεῖται."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "οἴδαμεν δὲ ὅτι ὁ υἱὸς τοῦ θεοῦ ἥκει, καὶ δέδωκεν ἡμῖν διάνοιαν ἵνα ⸀γινώσκωμεν",
          {
            "noteId": 65
          },
          "τὸν ἀληθινόν· καὶ ἐσμὲν ἐν τῷ ἀληθινῷ, ἐν τῷ υἱῷ αὐτοῦ Ἰησοῦ Χριστῷ. οὗτός ἐστιν ὁ ἀληθινὸς θεὸς καὶ ζωὴ αἰώνιος."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Τεκνία, φυλάξατε ἑαυτὰ ἀπὸ τῶν ⸀εἰδώλων",
          {
            "noteId": 66
          },
          "‘p /’ ‘/book’"
        ]
      }
    ],
