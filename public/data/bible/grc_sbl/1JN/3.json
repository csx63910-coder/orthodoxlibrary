  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "ἴδετε ποταπὴν ἀγάπην δέδωκεν ἡμῖν ὁ πατὴρ ἵνα τέκνα θεοῦ κληθῶμεν, ⸂καὶ ἐσμέν",
          {
            "noteId": 23
          },
          ". διὰ τοῦτο ὁ κόσμος οὐ γινώσκει ⸀ἡμᾶς",
          {
            "noteId": 24
          },
          "ὅτι οὐκ ἔγνω αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἀγαπητοί, νῦν τέκνα θεοῦ ἐσμεν, καὶ οὔπω ἐφανερώθη τί ἐσόμεθα. ⸀οἴδαμεν",
          {
            "noteId": 25
          },
          "ὅτι ἐὰν φανερωθῇ ὅμοιοι αὐτῷ ἐσόμεθα, ὅτι ὀψόμεθα αὐτὸν καθώς ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ πᾶς ὁ ἔχων τὴν ἐλπίδα ταύτην ἐπʼ αὐτῷ ἁγνίζει ἑαυτὸν καθὼς ἐκεῖνος ἁγνός ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Πᾶς ὁ ποιῶν τὴν ἁμαρτίαν καὶ τὴν ἀνομίαν ποιεῖ, καὶ ἡ ἁμαρτία ἐστὶν ἡ ἀνομία."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ οἴδατε ὅτι ἐκεῖνος ἐφανερώθη ἵνα τὰς ⸀ἁμαρτίας",
          {
            "noteId": 26
          },
          "ἄρῃ, καὶ ἁμαρτία ἐν αὐτῷ οὐκ ἔστιν."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "πᾶς ὁ ἐν αὐτῷ μένων οὐχ ἁμαρτάνει· πᾶς ὁ ἁμαρτάνων οὐχ ἑώρακεν αὐτὸν οὐδὲ ἔγνωκεν αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "⸀τεκνία",
          {
            "noteId": 27
          },
          "μηδεὶς πλανάτω ὑμᾶς· ὁ ποιῶν τὴν δικαιοσύνην δίκαιός ἐστιν, καθὼς ἐκεῖνος δίκαιός ἐστιν·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ὁ ποιῶν τὴν ἁμαρτίαν ἐκ τοῦ διαβόλου ἐστίν, ὅτι ἀπʼ ἀρχῆς ὁ διάβολος ἁμαρτάνει. εἰς τοῦτο ἐφανερώθη ὁ υἱὸς τοῦ θεοῦ ἵνα λύσῃ τὰ ἔργα τοῦ διαβόλου."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "πᾶς ὁ γεγεννημένος ἐκ τοῦ θεοῦ ἁμαρτίαν οὐ ποιεῖ, ὅτι σπέρμα αὐτοῦ ἐν αὐτῷ μένει, καὶ οὐ δύναται ἁμαρτάνειν, ὅτι ἐκ τοῦ θεοῦ γεγέννηται."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἐν τούτῳ φανερά ἐστιν τὰ τέκνα τοῦ θεοῦ καὶ τὰ τέκνα τοῦ διαβόλου· πᾶς ὁ μὴ ποιῶν δικαιοσύνην οὐκ ἔστιν ἐκ τοῦ θεοῦ, καὶ ὁ μὴ ἀγαπῶν τὸν ἀδελφὸν αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ὅτι αὕτη ἐστὶν ἡ ἀγγελία ἣν ἠκούσατε ἀπʼ ἀρχῆς, ἵνα ἀγαπῶμεν ἀλλήλους·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "οὐ καθὼς Κάϊν ἐκ τοῦ πονηροῦ ἦν καὶ ἔσφαξεν τὸν ἀδελφὸν αὐτοῦ· καὶ χάριν τίνος ἔσφαξεν αὐτόν; ὅτι τὰ ἔργα αὐτοῦ πονηρὰ ἦν, τὰ δὲ τοῦ ἀδελφοῦ αὐτοῦ δίκαια."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "⸀μὴ",
          {
            "noteId": 28
          },
          "θαυμάζετε, ⸀ἀδελφοί",
          {
            "noteId": 29
          },
          "εἰ μισεῖ ὑμᾶς ὁ κόσμος."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἡμεῖς οἴδαμεν ὅτι μεταβεβήκαμεν ἐκ τοῦ θανάτου εἰς τὴν ζωήν, ὅτι ἀγαπῶμεν τοὺς ἀδελφούς· ὁ μὴ ⸀ἀγαπῶν",
          {
            "noteId": 30
          },
          "μένει ἐν τῷ θανάτῳ."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "πᾶς ὁ μισῶν τὸν ἀδελφὸν αὐτοῦ ἀνθρωποκτόνος ἐστίν, καὶ οἴδατε ὅτι πᾶς ἀνθρωποκτόνος οὐκ ἔχει ζωὴν αἰώνιον ἐν ⸀αὐτῷ",
          {
            "noteId": 31
          },
          "μένουσαν."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ἐν τούτῳ ἐγνώκαμεν τὴν ἀγάπην, ὅτι ἐκεῖνος ὑπὲρ ἡμῶν τὴν ψυχὴν αὐτοῦ ἔθηκεν· καὶ ἡμεῖς ὀφείλομεν ὑπὲρ τῶν ἀδελφῶν τὰς ψυχὰς ⸀θεῖναι",
          {
            "noteId": 32
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ὃς δʼ ἂν ἔχῃ τὸν βίον τοῦ κόσμου καὶ θεωρῇ τὸν ἀδελφὸν αὐτοῦ χρείαν ἔχοντα καὶ κλείσῃ τὰ σπλάγχνα αὐτοῦ ἀπʼ αὐτοῦ, πῶς ἡ ἀγάπη τοῦ θεοῦ μένει ἐν αὐτῷ;"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "⸀Τεκνία",
          {
            "noteId": 33
          },
          "μὴ ἀγαπῶμεν λόγῳ μηδὲ τῇ γλώσσῃ ἀλλὰ ἐν ἔργῳ καὶ ἀληθείᾳ."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "⸀ἐν",
          {
            "noteId": 34
          },
          "τούτῳ ⸀γνωσόμεθα",
          {
            "noteId": 35
          },
          "ὅτι ἐκ τῆς ἀληθείας ἐσμέν, καὶ ἔμπροσθεν αὐτοῦ πείσομεν ⸂τὴν καρδίαν",
          {
            "noteId": 36
          },
          "ἡμῶν"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ὅτι ἐὰν καταγινώσκῃ ἡμῶν ἡ καρδία, ὅτι μείζων ἐστὶν ὁ θεὸς τῆς καρδίας ἡμῶν καὶ γινώσκει πάντα."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ἀγαπητοί, ἐὰν ἡ καρδία ⸂μὴ καταγινώσκῃ ἡμῶν",
          {
            "noteId": 37
          },
          ", παρρησίαν ἔχομεν πρὸς τὸν θεόν,"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "καὶ ὃ ⸀ἐὰν",
          {
            "noteId": 38
          },
          "αἰτῶμεν λαμβάνομεν ⸀ἀπʼ",
          {
            "noteId": 39
          },
          "αὐτοῦ, ὅτι τὰς ἐντολὰς αὐτοῦ τηροῦμεν καὶ τὰ ἀρεστὰ ἐνώπιον αὐτοῦ ποιοῦμεν."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "καὶ αὕτη ἐστὶν ἡ ἐντολὴ αὐτοῦ, ἵνα ⸀πιστεύσωμεν",
          {
            "noteId": 40
          },
          "τῷ ὀνόματι τοῦ υἱοῦ αὐτοῦ Ἰησοῦ Χριστοῦ καὶ ἀγαπῶμεν ἀλλήλους, καθὼς ἔδωκεν ἐντολὴν ⸀ἡμῖν",
          {
            "noteId": 41
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "καὶ ὁ τηρῶν τὰς ἐντολὰς αὐτοῦ ἐν αὐτῷ μένει καὶ αὐτὸς ἐν αὐτῷ· καὶ ἐν τούτῳ γινώσκομεν ὅτι μένει ἐν ἡμῖν, ἐκ τοῦ πνεύματος οὗ ἡμῖν ἔδωκεν."
        ]
      }
    ],
