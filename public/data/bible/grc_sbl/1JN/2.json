  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Τεκνία μου, ταῦτα γράφω ὑμῖν ἵνα μὴ ἁμάρτητε. καὶ ἐάν τις ἁμάρτῃ, παράκλητον ἔχομεν πρὸς τὸν πατέρα Ἰησοῦν Χριστὸν δίκαιον,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ αὐτὸς ἱλασμός ἐστιν περὶ τῶν ἁμαρτιῶν ἡμῶν, οὐ περὶ τῶν ἡμετέρων δὲ μόνον ἀλλὰ καὶ περὶ ὅλου τοῦ κόσμου."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Καὶ ἐν τούτῳ γινώσκομεν ὅτι ἐγνώκαμεν αὐτόν, ἐὰν τὰς ἐντολὰς αὐτοῦ τηρῶμεν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ὁ λέγων ⸀ὅτι",
          {
            "noteId": 6
          },
          "Ἔγνωκα αὐτὸν καὶ τὰς ἐντολὰς αὐτοῦ μὴ τηρῶν ψεύστης ἐστίν, καὶ ἐν τούτῳ ἡ ἀλήθεια οὐκ ἔστιν·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ὃς δʼ ἂν τηρῇ αὐτοῦ τὸν λόγον, ἀληθῶς ἐν τούτῳ ἡ ἀγάπη τοῦ θεοῦ τετελείωται. ἐν τούτῳ γινώσκομεν ὅτι ἐν αὐτῷ ἐσμεν·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ὁ λέγων ἐν αὐτῷ μένειν ὀφείλει καθὼς ἐκεῖνος περιεπάτησεν καὶ ⸀αὐτὸς",
          {
            "noteId": 7
          },
          "περιπατεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "⸀Ἀγαπητοί",
          {
            "noteId": 8
          },
          "οὐκ ἐντολὴν καινὴν γράφω ὑμῖν, ἀλλʼ ἐντολὴν παλαιὰν ἣν εἴχετε ἀπʼ ἀρχῆς· ἡ ἐντολὴ ἡ παλαιά ἐστιν ὁ λόγος ὃν ⸀ἠκούσατε",
          {
            "noteId": 9
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "πάλιν ἐντολὴν καινὴν γράφω ὑμῖν, ὅ ἐστιν ἀληθὲς ἐν αὐτῷ καὶ ἐν ὑμῖν, ὅτι ἡ σκοτία παράγεται καὶ τὸ φῶς τὸ ἀληθινὸν ἤδη φαίνει."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ὁ λέγων ἐν τῷ φωτὶ εἶναι καὶ τὸν ἀδελφὸν αὐτοῦ μισῶν ἐν τῇ σκοτίᾳ ἐστὶν ἕως ἄρτι."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ὁ ἀγαπῶν τὸν ἀδελφὸν αὐτοῦ ἐν τῷ φωτὶ μένει, καὶ σκάνδαλον ἐν αὐτῷ οὐκ ἔστιν·"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ὁ δὲ μισῶν τὸν ἀδελφὸν αὐτοῦ ἐν τῇ σκοτίᾳ ἐστὶν καὶ ἐν τῇ σκοτίᾳ περιπατεῖ, καὶ οὐκ οἶδεν ποῦ ὑπάγει, ὅτι ἡ σκοτία ἐτύφλωσεν τοὺς ὀφθαλμοὺς αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Γράφω ὑμῖν, τεκνία, ὅτι ἀφέωνται ὑμῖν αἱ ἁμαρτίαι διὰ τὸ ὄνομα αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "γράφω ὑμῖν, πατέρες, ὅτι ἐγνώκατε τὸν ἀπʼ ἀρχῆς· γράφω ὑμῖν, νεανίσκοι, ὅτι νενικήκατε τὸν πονηρόν."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "⸀ἔγραψα",
          {
            "noteId": 10
          },
          "ὑμῖν, παιδία, ὅτι ἐγνώκατε τὸν πατέρα· ἔγραψα ὑμῖν, πατέρες, ὅτι ἐγνώκατε τὸν ἀπʼ ἀρχῆς· ἔγραψα ὑμῖν, νεανίσκοι, ὅτι ἰσχυροί ἐστε καὶ ὁ λόγος τοῦ θεοῦ ἐν ὑμῖν μένει καὶ νενικήκατε τὸν πονηρόν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Μὴ ἀγαπᾶτε τὸν κόσμον μηδὲ τὰ ἐν τῷ κόσμῳ. ἐάν τις ἀγαπᾷ τὸν κόσμον, οὐκ ἔστιν ἡ ἀγάπη τοῦ πατρὸς ἐν αὐτῷ·"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ὅτι πᾶν τὸ ἐν τῷ κόσμῳ, ἡ ἐπιθυμία τῆς σαρκὸς καὶ ἡ ἐπιθυμία τῶν ὀφθαλμῶν καὶ ἡ ἀλαζονεία τοῦ βίου, οὐκ ἔστιν ἐκ τοῦ πατρός, ἀλλὰ ἐκ τοῦ κόσμου ἐστίν·"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καὶ ὁ κόσμος παράγεται καὶ ἡ ἐπιθυμία αὐτοῦ, ὁ δὲ ποιῶν τὸ θέλημα τοῦ θεοῦ μένει εἰς τὸν αἰῶνα."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Παιδία, ἐσχάτη ὥρα ἐστίν, καὶ καθὼς ἠκούσατε ⸀ὅτι",
          {
            "noteId": 11
          },
          "ἀντίχριστος ἔρχεται, καὶ νῦν ἀντίχριστοι πολλοὶ γεγόνασιν· ὅθεν γινώσκομεν ὅτι ἐσχάτη ὥρα ἐστίν."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἐξ ἡμῶν ἐξῆλθαν, ἀλλʼ οὐκ ἦσαν ἐξ ἡμῶν· εἰ γὰρ ⸂ἐξ ἡμῶν ἦσαν",
          {
            "noteId": 12
          },
          ", μεμενήκεισαν ἂν μεθʼ ἡμῶν· ἀλλʼ ἵνα φανερωθῶσιν ὅτι οὐκ εἰσὶν πάντες ἐξ ἡμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "καὶ",
          {
            "noteId": 13
          },
          "ὑμεῖς χρῖσμα ἔχετε ἀπὸ τοῦ ἁγίου ⸀καὶ οἴδατε ⸀πάντες",
          {
            "noteId": 14
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "οὐκ ἔγραψα ὑμῖν ὅτι οὐκ οἴδατε τὴν ἀλήθειαν, ἀλλʼ ὅτι οἴδατε αὐτήν, καὶ ὅτι πᾶν ψεῦδος ἐκ τῆς ἀληθείας οὐκ ἔστιν."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "τίς ἐστιν ὁ ψεύστης εἰ μὴ ὁ ἀρνούμενος ὅτι Ἰησοῦς οὐκ ἔστιν ὁ χριστός; οὗτός ἐστιν ὁ ἀντίχριστος, ὁ ἀρνούμενος τὸν πατέρα καὶ τὸν υἱόν."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "πᾶς ὁ ἀρνούμενος τὸν υἱὸν οὐδὲ τὸν πατέρα ἔχει· ⸂ὁ ὁμολογῶν τὸν υἱὸν καὶ τὸν πατέρα ἔχει",
          {
            "noteId": 15
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "⸀ὑμεῖς",
          {
            "noteId": 16
          },
          "ὃ ἠκούσατε ἀπʼ ἀρχῆς, ἐν ὑμῖν μενέτω· ἐὰν ἐν ὑμῖν μείνῃ ὃ ἀπʼ ἀρχῆς ἠκούσατε, καὶ ὑμεῖς ἐν τῷ υἱῷ καὶ ἐν τῷ πατρὶ μενεῖτε."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "καὶ αὕτη ἐστὶν ἡ ἐπαγγελία ἣν αὐτὸς ἐπηγγείλατο ἡμῖν, τὴν ζωὴν τὴν αἰώνιον."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Ταῦτα ἔγραψα ὑμῖν περὶ τῶν πλανώντων ὑμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "καὶ ὑμεῖς τὸ χρῖσμα ὃ ἐλάβετε ἀπʼ αὐτοῦ ⸂μένει ἐν ὑμῖν",
          {
            "noteId": 17
          },
          ", καὶ οὐ χρείαν ἔχετε ἵνα τις διδάσκῃ ὑμᾶς· ἀλλʼ ὡς τὸ ⸀αὐτοῦ",
          {
            "noteId": 18
          },
          "χρῖσμα διδάσκει ὑμᾶς περὶ πάντων, καὶ ἀληθές ἐστιν καὶ οὐκ ἔστιν ψεῦδος, καὶ καθὼς ἐδίδαξεν ὑμᾶς, ⸀μένετε",
          {
            "noteId": 19
          },
          "ἐν αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Καὶ νῦν, τεκνία, μένετε ἐν αὐτῷ, ἵνα ⸀ἐὰν",
          {
            "noteId": 20
          },
          "φανερωθῇ ⸀σχῶμεν",
          {
            "noteId": 21
          },
          "παρρησίαν καὶ μὴ αἰσχυνθῶμεν ἀπʼ αὐτοῦ ἐν τῇ παρουσίᾳ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "ἐὰν εἰδῆτε ὅτι",
          {
            "noteId": 22
          },
          "δίκαιός ἐστιν, γινώσκετε ⸀ὅτι πᾶς ὁ ποιῶν τὴν δικαιοσύνην ἐξ αὐτοῦ γεγέννηται."
        ]
      }
    ],
