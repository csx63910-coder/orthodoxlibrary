    "order": 62,
    "numberOfChapters": 5,
    "sha256": "cd7d166fa91521aec560874f41d308116a174e1458930f1e0447ba0b17611378",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_sbl/1JN/1.json",
