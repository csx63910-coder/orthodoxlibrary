  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ὑπομίμνῃσκε αὐτοὺς ⸀ἀρχαῖς",
          {
            "noteId": 16
          },
          "ἐξουσίαις ὑποτάσσεσθαι πειθαρχεῖν, πρὸς πᾶν ἔργον ἀγαθὸν ἑτοίμους εἶναι,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "μηδένα βλασφημεῖν, ἀμάχους εἶναι, ἐπιεικεῖς, πᾶσαν ἐνδεικνυμένους πραΰτητα πρὸς πάντας ἀνθρώπους."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἦμεν γάρ ποτε καὶ ἡμεῖς ἀνόητοι, ἀπειθεῖς, πλανώμενοι, δουλεύοντες ἐπιθυμίαις καὶ ἡδοναῖς ποικίλαις, ἐν κακίᾳ καὶ φθόνῳ διάγοντες, στυγητοί, μισοῦντες ἀλλήλους."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ὅτε δὲ ἡ χρηστότης καὶ ἡ φιλανθρωπία ἐπεφάνη τοῦ σωτῆρος ἡμῶν θεοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "οὐκ ἐξ ἔργων τῶν ἐν δικαιοσύνῃ ⸀ἃ",
          {
            "noteId": 17
          },
          "ἐποιήσαμεν ἡμεῖς ἀλλὰ κατὰ ⸂τὸ αὐτοῦ ἔλεος",
          {
            "noteId": 18
          },
          "ἔσωσεν ἡμᾶς διὰ λουτροῦ παλιγγενεσίας καὶ ἀνακαινώσεως πνεύματος ἁγίου,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "οὗ ἐξέχεεν ἐφʼ ἡμᾶς πλουσίως διὰ Ἰησοῦ Χριστοῦ τοῦ σωτῆρος ἡμῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἵνα δικαιωθέντες τῇ ἐκείνου χάριτι κληρονόμοι ⸀γενηθῶμεν",
          {
            "noteId": 19
          },
          "κατʼ ἐλπίδα ζωῆς αἰωνίου."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Πιστὸς ὁ λόγος, καὶ περὶ τούτων βούλομαί σε διαβεβαιοῦσθαι, ἵνα φροντίζωσιν καλῶν ἔργων προΐστασθαι οἱ πεπιστευκότες θεῷ. ταῦτά ⸀ἐστιν",
          {
            "noteId": 20
          },
          "καλὰ καὶ ὠφέλιμα τοῖς ἀνθρώποις·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "μωρὰς δὲ ζητήσεις καὶ γενεαλογίας καὶ ⸀ἔρεις",
          {
            "noteId": 21
          },
          "καὶ μάχας νομικὰς περιΐστασο, εἰσὶν γὰρ ἀνωφελεῖς καὶ μάταιοι."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "αἱρετικὸν ἄνθρωπον μετὰ μίαν καὶ δευτέραν νουθεσίαν παραιτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "εἰδὼς ὅτι ἐξέστραπται ὁ τοιοῦτος καὶ ἁμαρτάνει, ὢν αὐτοκατάκριτος."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ὅταν πέμψω Ἀρτεμᾶν πρὸς σὲ ἢ Τυχικόν, σπούδασον ἐλθεῖν πρός με εἰς Νικόπολιν, ἐκεῖ γὰρ κέκρικα παραχειμάσαι."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ζηνᾶν τὸν νομικὸν καὶ ⸀Ἀπολλῶν",
          {
            "noteId": 22
          },
          "σπουδαίως πρόπεμψον, ἵνα μηδὲν αὐτοῖς λείπῃ."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "μανθανέτωσαν δὲ καὶ οἱ ἡμέτεροι καλῶν ἔργων προΐστασθαι εἰς τὰς ἀναγκαίας χρείας, ἵνα μὴ ὦσιν ἄκαρποι."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Ἀσπάζονταί σε οἱ μετʼ ἐμοῦ πάντες. ἄσπασαι τοὺς φιλοῦντας ἡμᾶς ἐν πίστει. ἡ χάρις μετὰ πάντων ⸀ὑμῶν",
          {
            "noteId": 23
          },
          "‘p /’ ‘/book’"
        ]
      }
    ],
