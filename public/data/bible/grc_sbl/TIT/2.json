  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Σὺ δὲ λάλει ἃ πρέπει τῇ ὑγιαινούσῃ διδασκαλίᾳ."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "πρεσβύτας νηφαλίους εἶναι, σεμνούς, σώφρονας, ὑγιαίνοντας τῇ πίστει, τῇ ἀγάπῃ, τῇ ὑπομονῇ."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Πρεσβύτιδας ὡσαύτως ἐν καταστήματι ἱεροπρεπεῖς, μὴ διαβόλους ⸀μηδὲ",
          {
            "noteId": 6
          },
          "οἴνῳ πολλῷ δεδουλωμένας, καλοδιδασκάλους,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἵνα ⸀σωφρονίζωσι",
          {
            "noteId": 7
          },
          "τὰς νέας φιλάνδρους εἶναι, φιλοτέκνους,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "σώφρονας, ἁγνάς, ⸀οἰκουργούς",
          {
            "noteId": 8
          },
          "ἀγαθάς, ὑποτασσομένας τοῖς ἰδίοις ἀνδράσιν, ἵνα μὴ ὁ λόγος τοῦ θεοῦ βλασφημῆται."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Τοὺς νεωτέρους ὡσαύτως παρακάλει σωφρονεῖν·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "περὶ πάντα σεαυτὸν παρεχόμενος τύπον καλῶν ἔργων, ἐν τῇ διδασκαλίᾳ ⸀ἀφθορίαν",
          {
            "noteId": 9
          },
          "⸀σεμνότητα",
          {
            "noteId": 10
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "λόγον ὑγιῆ ἀκατάγνωστον, ἵνα ὁ ἐξ ἐναντίας ἐντραπῇ μηδὲν ἔχων ⸂λέγειν περὶ ἡμῶν",
          {
            "noteId": 11
          },
          "φαῦλον."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Δούλους ἰδίοις δεσπόταις ὑποτάσσεσθαι ἐν πᾶσιν, εὐαρέστους εἶναι, μὴ ἀντιλέγοντας,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "μὴ νοσφιζομένους, ἀλλὰ ⸂πᾶσαν πίστιν",
          {
            "noteId": 12
          },
          "ἐνδεικνυμένους ἀγαθήν, ἵνα τὴν",
          {
            "noteId": 13
          },
          "διδασκαλίαν ⸀τὴν τοῦ σωτῆρος ἡμῶν θεοῦ κοσμῶσιν ἐν πᾶσιν."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ἐπεφάνη γὰρ ἡ χάρις τοῦ ⸀θεοῦ",
          {
            "noteId": 14
          },
          "σωτήριος πᾶσιν ἀνθρώποις"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "παιδεύουσα ἡμᾶς, ἵνα ἀρνησάμενοι τὴν ἀσέβειαν καὶ τὰς κοσμικὰς ἐπιθυμίας σωφρόνως καὶ δικαίως καὶ εὐσεβῶς ζήσωμεν ἐν τῷ νῦν αἰῶνι,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "προσδεχόμενοι τὴν μακαρίαν ἐλπίδα καὶ ἐπιφάνειαν τῆς δόξης τοῦ μεγάλου θεοῦ καὶ σωτῆρος ἡμῶν ⸂Ἰησοῦ Χριστοῦ",
          {
            "noteId": 15
          },
          ","
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ὃς ἔδωκεν ἑαυτὸν ὑπὲρ ἡμῶν ἵνα λυτρώσηται ἡμᾶς ἀπὸ πάσης ἀνομίας καὶ καθαρίσῃ ἑαυτῷ λαὸν περιούσιον, ζηλωτὴν καλῶν ἔργων."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Ταῦτα λάλει καὶ παρακάλει καὶ ἔλεγχε μετὰ πάσης ἐπιταγῆς· μηδείς σου περιφρονείτω."
        ]
      }
    ],
