  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ὁ πρεσβύτερος ἐκλεκτῇ κυρίᾳ καὶ τοῖς τέκνοις αὐτῆς, οὓς ἐγὼ ἀγαπῶ ἐν ἀληθείᾳ, καὶ οὐκ ἐγὼ μόνος ἀλλὰ καὶ πάντες οἱ ἐγνωκότες τὴν ἀλήθειαν,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "διὰ τὴν ἀλήθειαν τὴν μένουσαν ἐν ἡμῖν, καὶ μεθʼ ἡμῶν ἔσται εἰς τὸν αἰῶνα·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἔσται μεθʼ ἡμῶν χάρις ἔλεος εἰρήνη παρὰ",
          {
            "noteId": 0
          },
          "θεοῦ πατρός, καὶ ⸀παρὰ Ἰησοῦ Χριστοῦ τοῦ υἱοῦ τοῦ πατρός, ἐν ἀληθείᾳ καὶ ἀγάπῃ."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Ἐχάρην λίαν ὅτι εὕρηκα ἐκ τῶν τέκνων σου περιπατοῦντας ἐν ἀληθείᾳ, καθὼς ἐντολὴν ἐλάβομεν παρὰ τοῦ πατρός."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ νῦν ἐρωτῶ σε, κυρία, οὐχ ὡς ἐντολὴν ⸂καινὴν γράφων σοι",
          {
            "noteId": 1
          },
          "ἀλλὰ ἣν εἴχομεν ἀπʼ ἀρχῆς, ἵνα ἀγαπῶμεν ἀλλήλους."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ αὕτη ἐστὶν ἡ ἀγάπη, ἵνα περιπατῶμεν κατὰ τὰς ἐντολὰς αὐτοῦ· αὕτη ⸂ἡ ἐντολή ἐστιν",
          {
            "noteId": 2
          },
          ", καθὼς ἠκούσατε ἀπʼ ἀρχῆς, ἵνα ἐν αὐτῇ περιπατῆτε."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ὅτι πολλοὶ πλάνοι ⸀ἐξῆλθον",
          {
            "noteId": 3
          },
          "εἰς τὸν κόσμον, οἱ μὴ ὁμολογοῦντες Ἰησοῦν Χριστὸν ἐρχόμενον ἐν σαρκί· οὗτός ἐστιν ὁ πλάνος καὶ ὁ ἀντίχριστος."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "βλέπετε ἑαυτούς, ἵνα μὴ ⸀ἀπολέσητε",
          {
            "noteId": 4
          },
          "ἃ ⸀εἰργασάμεθα",
          {
            "noteId": 5
          },
          "ἀλλὰ μισθὸν πλήρη ⸀ἀπολάβητε",
          {
            "noteId": 6
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "πᾶς ὁ ⸀προάγων",
          {
            "noteId": 7
          },
          "καὶ μὴ μένων ἐν τῇ διδαχῇ",
          {
            "noteId": 8
          },
          "τοῦ Χριστοῦ θεὸν οὐκ ἔχει· ὁ μένων ἐν τῇ ⸀διδαχῇ, οὗτος καὶ τὸν πατέρα καὶ τὸν υἱὸν ἔχει."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "εἴ τις ἔρχεται πρὸς ὑμᾶς καὶ ταύτην τὴν διδαχὴν οὐ φέρει, μὴ λαμβάνετε αὐτὸν εἰς οἰκίαν καὶ χαίρειν αὐτῷ μὴ λέγετε·"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ὁ ⸂λέγων γὰρ",
          {
            "noteId": 9
          },
          "αὐτῷ χαίρειν κοινωνεῖ τοῖς ἔργοις αὐτοῦ τοῖς πονηροῖς."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Πολλὰ ἔχων ὑμῖν γράφειν οὐκ ἐβουλήθην διὰ χάρτου καὶ μέλανος, ἀλλὰ ἐλπίζω ⸀γενέσθαι",
          {
            "noteId": 10
          },
          "πρὸς ὑμᾶς καὶ στόμα πρὸς στόμα λαλῆσαι, ἵνα ἡ χαρὰ ⸀ὑμῶν",
          {
            "noteId": 11
          },
          "⸂πεπληρωμένη ᾖ",
          {
            "noteId": 12
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ἀσπάζεταί σε τὰ τέκνα τῆς ἀδελφῆς σου τῆς ⸀ἐκλεκτῆς",
          {
            "noteId": 13
          },
          "‘p /’ ‘/book’"
        ]
      }
    ],
