  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "οἱ κύριοι, τὸ δίκαιον καὶ τὴν ἰσότητα τοῖς δούλοις παρέχεσθε, εἰδότες ὅτι καὶ ὑμεῖς ἔχετε κύριον ἐν ⸀οὐρανῷ",
          {
            "noteId": 62
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Τῇ προσευχῇ προσκαρτερεῖτε, γρηγοροῦντες ἐν αὐτῇ ἐν εὐχαριστίᾳ,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "προσευχόμενοι ἅμα καὶ περὶ ἡμῶν, ἵνα ὁ θεὸς ἀνοίξῃ ἡμῖν θύραν τοῦ λόγου, λαλῆσαι τὸ μυστήριον τοῦ Χριστοῦ, διʼ ὃ καὶ δέδεμαι,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἵνα φανερώσω αὐτὸ ὡς δεῖ με λαλῆσαι."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Ἐν σοφίᾳ περιπατεῖτε πρὸς τοὺς ἔξω, τὸν καιρὸν ἐξαγοραζόμενοι."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ὁ λόγος ὑμῶν πάντοτε ἐν χάριτι, ἅλατι ἠρτυμένος, εἰδέναι πῶς δεῖ ὑμᾶς ἑνὶ ἑκάστῳ ἀποκρίνεσθαι."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Τὰ κατʼ ἐμὲ πάντα γνωρίσει ὑμῖν Τυχικὸς ὁ ἀγαπητὸς ἀδελφὸς καὶ πιστὸς διάκονος καὶ σύνδουλος ἐν κυρίῳ,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ὃν ἔπεμψα πρὸς ὑμᾶς εἰς αὐτὸ τοῦτο ἵνα ⸀γνῶτε",
          {
            "noteId": 63
          },
          "τὰ περὶ ⸀ἡμῶν",
          {
            "noteId": 64
          },
          "καὶ παρακαλέσῃ τὰς καρδίας ὑμῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "σὺν Ὀνησίμῳ τῷ πιστῷ καὶ ἀγαπητῷ ἀδελφῷ, ὅς ἐστιν ἐξ ὑμῶν· πάντα ὑμῖν γνωρίσουσιν τὰ ὧδε."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Ἀσπάζεται ὑμᾶς Ἀρίσταρχος ὁ συναιχμάλωτός μου, καὶ Μᾶρκος ὁ ἀνεψιὸς Βαρναβᾶ (περὶ οὗ ἐλάβετε ἐντολάς, ἐὰν ἔλθῃ πρὸς ὑμᾶς δέξασθε αὐτόν),"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ Ἰησοῦς ὁ λεγόμενος Ἰοῦστος, οἱ ὄντες ἐκ περιτομῆς, οὗτοι μόνοι συνεργοὶ εἰς τὴν βασιλείαν τοῦ θεοῦ, οἵτινες ἐγενήθησάν μοι παρηγορία."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ἀσπάζεται ὑμᾶς Ἐπαφρᾶς ὁ ἐξ ὑμῶν, δοῦλος ⸀Χριστοῦ",
          {
            "noteId": 65
          },
          "πάντοτε ἀγωνιζόμενος ὑπὲρ ὑμῶν ἐν ταῖς προσευχαῖς, ἵνα ⸀σταθῆτε",
          {
            "noteId": 66
          },
          "τέλειοι καὶ ⸀πεπληροφορημένοι",
          {
            "noteId": 67
          },
          "ἐν παντὶ θελήματι τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "μαρτυρῶ γὰρ αὐτῷ ὅτι ἔχει ⸂πολὺν πόνον",
          {
            "noteId": 68
          },
          "ὑπὲρ ὑμῶν καὶ τῶν ἐν Λαοδικείᾳ καὶ τῶν ἐν Ἱεραπόλει."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἀσπάζεται ὑμᾶς Λουκᾶς ὁ ἰατρὸς ὁ ἀγαπητὸς καὶ Δημᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ἀσπάσασθε τοὺς ἐν Λαοδικείᾳ ἀδελφοὺς καὶ ⸂Νύμφαν καὶ τὴν κατʼ οἶκον αὐτῆς",
          {
            "noteId": 69
          },
          "ἐκκλησίαν."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ ὅταν ἀναγνωσθῇ παρʼ ὑμῖν ἡ ἐπιστολή, ποιήσατε ἵνα καὶ ἐν τῇ ⸀Λαοδικέων",
          {
            "noteId": 70
          },
          "ἐκκλησίᾳ ἀναγνωσθῇ, καὶ τὴν ἐκ Λαοδικείας ἵνα καὶ ὑμεῖς ἀναγνῶτε."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καὶ εἴπατε Ἀρχίππῳ· Βλέπε τὴν διακονίαν ἣν παρέλαβες ἐν κυρίῳ, ἵνα αὐτὴν πληροῖς."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Ὁ ἀσπασμὸς τῇ ἐμῇ χειρὶ Παύλου. μνημονεύετέ μου τῶν δεσμῶν. ἡ χάρις μεθʼ ⸀ὑμῶν",
          {
            "noteId": 71
          },
          "‘p /’ ‘/book’"
        ]
      }
    ],
