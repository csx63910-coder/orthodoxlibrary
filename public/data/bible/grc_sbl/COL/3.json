  "chapter": {
    "number": 3,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Εἰ οὖν συνηγέρθητε τῷ Χριστῷ, τὰ ἄνω ζητεῖτε, οὗ ὁ Χριστός ἐστιν ἐν δεξιᾷ τοῦ θεοῦ καθήμενος·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "τὰ ἄνω φρονεῖτε, μὴ τὰ ἐπὶ τῆς γῆς,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἀπεθάνετε γάρ, καὶ ἡ ζωὴ ὑμῶν κέκρυπται σὺν τῷ Χριστῷ ἐν τῷ θεῷ·"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ὅταν ὁ Χριστὸς φανερωθῇ, ἡ ζωὴ ⸀ὑμῶν",
          {
            "noteId": 38
          },
          "τότε καὶ ὑμεῖς σὺν αὐτῷ φανερωθήσεσθε ἐν δόξῃ."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Νεκρώσατε οὖν τὰ ⸀μέλη",
          {
            "noteId": 39
          },
          "τὰ ἐπὶ τῆς γῆς, πορνείαν, ἀκαθαρσίαν, πάθος, ἐπιθυμίαν κακήν, καὶ τὴν πλεονεξίαν ἥτις ἐστὶν εἰδωλολατρία,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "διʼ ἃ ἔρχεται ἡ ὀργὴ τοῦ θεοῦ ⸂ἐπὶ τοὺς υἱοὺς τῆς ἀπειθείας",
          {
            "noteId": 40
          },
          "·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἐν οἷς καὶ ὑμεῖς περιεπατήσατέ ποτε ὅτε ἐζῆτε ἐν ⸀τούτοις",
          {
            "noteId": 41
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "νυνὶ δὲ ἀπόθεσθε καὶ ὑμεῖς τὰ πάντα, ὀργήν, θυμόν, κακίαν, βλασφημίαν, αἰσχρολογίαν ἐκ τοῦ στόματος ὑμῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "μὴ ψεύδεσθε εἰς ἀλλήλους· ἀπεκδυσάμενοι τὸν παλαιὸν ἄνθρωπον σὺν ταῖς πράξεσιν αὐτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ ἐνδυσάμενοι τὸν νέον τὸν ἀνακαινούμενον εἰς ἐπίγνωσιν κατʼ εἰκόνα τοῦ κτίσαντος αὐτόν,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ὅπου οὐκ ἔνι Ἕλλην καὶ Ἰουδαῖος, περιτομὴ καὶ ἀκροβυστία, βάρβαρος, Σκύθης, δοῦλος, ἐλεύθερος, ἀλλὰ ⸀τὰ",
          {
            "noteId": 42
          },
          "πάντα καὶ ἐν πᾶσιν Χριστός."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ἐνδύσασθε οὖν ὡς ἐκλεκτοὶ τοῦ θεοῦ, ἅγιοι καὶ ἠγαπημένοι, σπλάγχνα οἰκτιρμοῦ, χρηστότητα, ταπεινοφροσύνην, πραΰτητα, μακροθυμίαν,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ἀνεχόμενοι ἀλλήλων καὶ χαριζόμενοι ἑαυτοῖς ἐάν τις πρός τινα ἔχῃ μομφήν· καθὼς καὶ ὁ ⸀κύριος",
          {
            "noteId": 43
          },
          "ἐχαρίσατο ὑμῖν οὕτως καὶ ὑμεῖς·"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἐπὶ πᾶσιν δὲ τούτοις τὴν ἀγάπην, ⸀ὅ",
          {
            "noteId": 44
          },
          "ἐστιν σύνδεσμος τῆς τελειότητος."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ ἡ εἰρήνη τοῦ ⸀Χριστοῦ",
          {
            "noteId": 45
          },
          "βραβευέτω ἐν ταῖς καρδίαις ὑμῶν, εἰς ἣν καὶ ἐκλήθητε ἐν ἑνὶ σώματι· καὶ εὐχάριστοι γίνεσθε."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ὁ λόγος τοῦ Χριστοῦ ἐνοικείτω ἐν ὑμῖν πλουσίως ἐν πάσῃ σοφίᾳ· διδάσκοντες καὶ νουθετοῦντες ἑαυτοὺς ⸀ψαλμοῖς",
          {
            "noteId": 46
          },
          "⸀ὕμνοις",
          {
            "noteId": 47
          },
          "ᾠδαῖς πνευματικαῖς ⸀ἐν",
          {
            "noteId": 48
          },
          "χάριτι, ᾄδοντες ἐν ⸂ταῖς καρδίαις",
          {
            "noteId": 49
          },
          "ὑμῶν τῷ ⸀θεῷ",
          {
            "noteId": 50
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καὶ πᾶν ⸂ὅ τι",
          {
            "noteId": 51
          },
          "⸀ἐὰν",
          {
            "noteId": 52
          },
          "ποιῆτε ἐν λόγῳ ἢ ἐν ἔργῳ, πάντα ἐν ὀνόματι κυρίου Ἰησοῦ, εὐχαριστοῦντες τῷ ⸀θεῷ",
          {
            "noteId": 53
          },
          "πατρὶ διʼ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Αἱ γυναῖκες, ὑποτάσσεσθε ⸀τοῖς",
          {
            "noteId": 54
          },
          "ἀνδράσιν, ὡς ἀνῆκεν ἐν κυρίῳ."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "οἱ ἄνδρες, ἀγαπᾶτε τὰς γυναῖκας καὶ μὴ πικραίνεσθε πρὸς αὐτάς."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Τὰ τέκνα, ὑπακούετε τοῖς γονεῦσιν κατὰ πάντα, τοῦτο γὰρ ⸂εὐάρεστόν ἐστιν",
          {
            "noteId": 55
          },
          "ἐν κυρίῳ."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "οἱ πατέρες, μὴ ἐρεθίζετε τὰ τέκνα ὑμῶν, ἵνα μὴ ἀθυμῶσιν."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "οἱ δοῦλοι, ὑπακούετε κατὰ πάντα τοῖς κατὰ σάρκα κυρίοις, μὴ ἐν ⸀ὀφθαλμοδουλίαις",
          {
            "noteId": 56
          },
          "ὡς ἀνθρωπάρεσκοι, ἀλλʼ ἐν ἁπλότητι καρδίας, φοβούμενοι τὸν ⸀κύριον",
          {
            "noteId": 57
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "⸀ὃ",
          {
            "noteId": 58
          },
          "ἐὰν ποιῆτε, ἐκ ψυχῆς ἐργάζεσθε, ὡς τῷ κυρίῳ καὶ οὐκ ἀνθρώποις,"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "εἰδότες ὅτι ἀπὸ κυρίου ⸀ἀπολήμψεσθε",
          {
            "noteId": 59
          },
          "τὴν ἀνταπόδοσιν τῆς κληρονομίας· ⸀τῷ",
          {
            "noteId": 60
          },
          "κυρίῳ Χριστῷ δουλεύετε·"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ὁ ⸀γὰρ",
          {
            "noteId": 61
          },
          "ἀδικῶν κομίσεται ὃ ἠδίκησεν, καὶ οὐκ ἔστιν προσωπολημψία."
        ]
      }
    ],
