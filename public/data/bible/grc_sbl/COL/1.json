  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Παῦλος ἀπόστολος ⸂Χριστοῦ Ἰησοῦ",
          {
            "noteId": 0
          },
          "διὰ θελήματος θεοῦ καὶ Τιμόθεος ὁ ἀδελφὸς"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "τοῖς ἐν ⸀Κολοσσαῖς",
          {
            "noteId": 1
          },
          "ἁγίοις καὶ πιστοῖς ἀδελφοῖς ἐν Χριστῷ· χάρις ὑμῖν καὶ εἰρήνη ἀπὸ θεοῦ πατρὸς ⸀ἡμῶν",
          {
            "noteId": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "Εὐχαριστοῦμεν τῷ ⸀θεῷ",
          {
            "noteId": 3
          },
          "πατρὶ τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ πάντοτε ⸀περὶ",
          {
            "noteId": 4
          },
          "ὑμῶν προσευχόμενοι,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἀκούσαντες τὴν πίστιν ὑμῶν ἐν Χριστῷ Ἰησοῦ καὶ τὴν ἀγάπην ⸂ἣν ἔχετε",
          {
            "noteId": 5
          },
          "εἰς πάντας τοὺς ἁγίους"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "διὰ τὴν ἐλπίδα τὴν ἀποκειμένην ὑμῖν ἐν τοῖς οὐρανοῖς, ἣν προηκούσατε ἐν τῷ λόγῳ τῆς ἀληθείας τοῦ εὐαγγελίου"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "τοῦ παρόντος εἰς ὑμᾶς, καθὼς καὶ ἐν παντὶ τῷ ⸀κόσμῳ",
          {
            "noteId": 6
          },
          "ἐστὶν καρποφορούμενον καὶ αὐξανόμενον καθὼς καὶ ἐν ὑμῖν, ἀφʼ ἧς ἡμέρας ἠκούσατε καὶ ἐπέγνωτε τὴν χάριν τοῦ θεοῦ ἐν ἀληθείᾳ·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "⸀καθὼς",
          {
            "noteId": 7
          },
          "ἐμάθετε ἀπὸ Ἐπαφρᾶ τοῦ ἀγαπητοῦ συνδούλου ἡμῶν",
          {
            "noteId": 8
          },
          "ὅς ἐστιν πιστὸς ὑπὲρ ⸀ἡμῶν διάκονος τοῦ Χριστοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ὁ καὶ δηλώσας ἡμῖν τὴν ὑμῶν ἀγάπην ἐν πνεύματι."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Διὰ τοῦτο καὶ ἡμεῖς, ἀφʼ ἧς ἡμέρας ἠκούσαμεν, οὐ παυόμεθα ὑπὲρ ὑμῶν προσευχόμενοι καὶ αἰτούμενοι ἵνα πληρωθῆτε τὴν ἐπίγνωσιν τοῦ θελήματος αὐτοῦ ἐν πάσῃ σοφίᾳ καὶ συνέσει πνευματικῇ,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "⸀περιπατῆσαι",
          {
            "noteId": 9
          },
          "ἀξίως τοῦ κυρίου εἰς πᾶσαν ἀρεσκείαν ἐν παντὶ ἔργῳ ἀγαθῷ καρποφοροῦντες καὶ αὐξανόμενοι ⸂τῇ ἐπιγνώσει",
          {
            "noteId": 10
          },
          "τοῦ θεοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ἐν πάσῃ δυνάμει δυναμούμενοι κατὰ τὸ κράτος τῆς δόξης αὐτοῦ εἰς πᾶσαν ὑπομονὴν καὶ μακροθυμίαν μετὰ χαρᾶς,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "εὐχαριστοῦντες τῷ πατρὶ τῷ ἱκανώσαντι ⸀ὑμᾶς",
          {
            "noteId": 11
          },
          "εἰς τὴν μερίδα τοῦ κλήρου τῶν ἁγίων ἐν τῷ φωτί,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ὃς ἐρρύσατο ἡμᾶς ἐκ τῆς ἐξουσίας τοῦ σκότους καὶ μετέστησεν εἰς τὴν βασιλείαν τοῦ υἱοῦ τῆς ἀγάπης αὐτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἐν ᾧ ἔχομεν τὴν ἀπολύτρωσιν, τὴν ἄφεσιν τῶν ἁμαρτιῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ὅς ἐστιν εἰκὼν τοῦ θεοῦ τοῦ ἀοράτου, πρωτότοκος πάσης κτίσεως,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ὅτι ἐν αὐτῷ ἐκτίσθη τὰ ⸀πάντα",
          {
            "noteId": 12
          },
          "ἐν τοῖς οὐρανοῖς ⸀καὶ",
          {
            "noteId": 13
          },
          "ἐπὶ τῆς γῆς, τὰ ὁρατὰ καὶ τὰ ἀόρατα, εἴτε θρόνοι εἴτε κυριότητες εἴτε ἀρχαὶ εἴτε ἐξουσίαι· τὰ πάντα διʼ αὐτοῦ καὶ εἰς αὐτὸν ἔκτισται·"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "καὶ αὐτός ἐστιν πρὸ πάντων καὶ τὰ πάντα ἐν αὐτῷ συνέστηκεν,"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ αὐτός ἐστιν",
          {
            "noteId": 14
          },
          "ἡ κεφαλὴ τοῦ σώματος τῆς ἐκκλησίας· ὅς ⸀ἐστιν ἀρχή, πρωτότοκος ἐκ τῶν νεκρῶν, ἵνα γένηται ἐν πᾶσιν αὐτὸς πρωτεύων,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ὅτι ἐν αὐτῷ εὐδόκησεν πᾶν τὸ πλήρωμα κατοικῆσαι"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "καὶ διʼ αὐτοῦ",
          {
            "noteId": 15
          },
          "ἀποκαταλλάξαι τὰ πάντα εἰς αὐτόν, εἰρηνοποιήσας διὰ τοῦ αἵματος τοῦ σταυροῦ αὐτοῦ, ⸂[διʼ αὐτοῦ]⸃ εἴτε τὰ ἐπὶ τῆς γῆς εἴτε τὰ ⸀ἐν",
          {
            "noteId": 16
          },
          "τοῖς οὐρανοῖς·"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "καὶ ὑμᾶς ποτε ὄντας ἀπηλλοτριωμένους καὶ ἐχθροὺς τῇ διανοίᾳ ἐν τοῖς ἔργοις τοῖς πονηροῖς—"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "νυνὶ δὲ ⸀ἀποκατηλλάγητε",
          {
            "noteId": 17
          },
          "ἐν τῷ σώματι τῆς σαρκὸς αὐτοῦ διὰ τοῦ θανάτου— παραστῆσαι ὑμᾶς ἁγίους καὶ ἀμώμους καὶ ἀνεγκλήτους κατενώπιον αὐτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "εἴ γε ἐπιμένετε τῇ πίστει τεθεμελιωμένοι καὶ ἑδραῖοι καὶ μὴ μετακινούμενοι ἀπὸ τῆς ἐλπίδος τοῦ εὐαγγελίου οὗ ἠκούσατε, τοῦ κηρυχθέντος ἐν ⸀πάσῃ",
          {
            "noteId": 18
          },
          "κτίσει τῇ ὑπὸ τὸν οὐρανόν, οὗ ἐγενόμην ἐγὼ Παῦλος διάκονος."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Νῦν χαίρω ἐν τοῖς παθήμασιν ὑπὲρ ὑμῶν, καὶ ἀνταναπληρῶ τὰ ὑστερήματα τῶν θλίψεων τοῦ Χριστοῦ ἐν τῇ σαρκί μου ὑπὲρ τοῦ σώματος αὐτοῦ, ὅ ἐστιν ἡ ἐκκλησία,"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ἧς ἐγενόμην ἐγὼ διάκονος κατὰ τὴν οἰκονομίαν τοῦ θεοῦ τὴν δοθεῖσάν μοι εἰς ὑμᾶς πληρῶσαι τὸν λόγον τοῦ θεοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "τὸ μυστήριον τὸ ἀποκεκρυμμένον ἀπὸ τῶν αἰώνων καὶ ἀπὸ τῶν γενεῶν,— ⸀νῦν",
          {
            "noteId": 19
          },
          "δὲ ἐφανερώθη τοῖς ἁγίοις αὐτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "οἷς ἠθέλησεν ὁ θεὸς γνωρίσαι τί τὸ πλοῦτος τῆς δόξης τοῦ μυστηρίου τούτου ἐν τοῖς ἔθνεσιν, ⸀ὅ",
          {
            "noteId": 20
          },
          "ἐστιν Χριστὸς ἐν ὑμῖν, ἡ ἐλπὶς τῆς δόξης·"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ὃν ἡμεῖς καταγγέλλομεν νουθετοῦντες πάντα ἄνθρωπον καὶ διδάσκοντες πάντα ἄνθρωπον ἐν πάσῃ σοφίᾳ, ἵνα παραστήσωμεν πάντα ἄνθρωπον τέλειον ἐν ⸀Χριστῷ",
          {
            "noteId": 21
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "εἰς ὃ καὶ κοπιῶ ἀγωνιζόμενος κατὰ τὴν ἐνέργειαν αὐτοῦ τὴν ἐνεργουμένην ἐν ἐμοὶ ἐν δυνάμει."
        ]
      }
    ],
