  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Θέλω γὰρ ὑμᾶς εἰδέναι ἡλίκον ἀγῶνα ἔχω ⸀ὑπὲρ",
          {
            "noteId": 22
          },
          "ὑμῶν καὶ τῶν ἐν Λαοδικείᾳ καὶ ὅσοι οὐχ ἑόρακαν τὸ πρόσωπόν μου ἐν σαρκί,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἵνα παρακληθῶσιν αἱ καρδίαι αὐτῶν, ⸀συμβιβασθέντες",
          {
            "noteId": 23
          },
          "ἐν ἀγάπῃ καὶ εἰς ⸂πᾶν πλοῦτος",
          {
            "noteId": 24
          },
          "τῆς πληροφορίας τῆς συνέσεως, εἰς ἐπίγνωσιν τοῦ μυστηρίου τοῦ ⸀θεοῦ",
          {
            "noteId": 25
          },
          "Χριστοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἐν ᾧ εἰσιν πάντες οἱ θησαυροὶ τῆς σοφίας ⸀καὶ",
          {
            "noteId": 26
          },
          "γνώσεως ἀπόκρυφοι."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "⸀τοῦτο",
          {
            "noteId": 27
          },
          "λέγω ἵνα ⸀μηδεὶς",
          {
            "noteId": 28
          },
          "ὑμᾶς παραλογίζηται ἐν πιθανολογίᾳ."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "εἰ γὰρ καὶ τῇ σαρκὶ ἄπειμι, ἀλλὰ τῷ πνεύματι σὺν ὑμῖν εἰμι, χαίρων καὶ βλέπων ὑμῶν τὴν τάξιν καὶ τὸ στερέωμα τῆς εἰς Χριστὸν πίστεως ὑμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ὡς οὖν παρελάβετε τὸν Χριστὸν Ἰησοῦν τὸν κύριον, ἐν αὐτῷ περιπατεῖτε,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἐρριζωμένοι καὶ ἐποικοδομούμενοι ἐν αὐτῷ καὶ ⸀βεβαιούμενοι",
          {
            "noteId": 29
          },
          "τῇ πίστει καθὼς ἐδιδάχθητε, ⸀περισσεύοντες",
          {
            "noteId": 30
          },
          "ἐν εὐχαριστίᾳ."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Βλέπετε μή τις ὑμᾶς ἔσται ὁ συλαγωγῶν διὰ τῆς φιλοσοφίας καὶ κενῆς ἀπάτης κατὰ τὴν παράδοσιν τῶν ἀνθρώπων, κατὰ τὰ στοιχεῖα τοῦ κόσμου καὶ οὐ κατὰ Χριστόν·"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ὅτι ἐν αὐτῷ κατοικεῖ πᾶν τὸ πλήρωμα τῆς θεότητος σωματικῶς,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ ἐστὲ ἐν αὐτῷ πεπληρωμένοι, ὅς ἐστιν ἡ κεφαλὴ πάσης ἀρχῆς καὶ ἐξουσίας,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ἐν ᾧ καὶ περιετμήθητε περιτομῇ ἀχειροποιήτῳ ἐν τῇ ἀπεκδύσει τοῦ ⸀σώματος",
          {
            "noteId": 31
          },
          "τῆς σαρκός, ἐν τῇ περιτομῇ τοῦ Χριστοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "συνταφέντες αὐτῷ ἐν τῷ ⸀βαπτισμῷ",
          {
            "noteId": 32
          },
          "ἐν ᾧ καὶ συνηγέρθητε διὰ τῆς πίστεως τῆς ἐνεργείας τοῦ θεοῦ τοῦ ἐγείραντος αὐτὸν ⸀ἐκ",
          {
            "noteId": 33
          },
          "νεκρῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ ὑμᾶς νεκροὺς ὄντας ⸀ἐν",
          {
            "noteId": 34
          },
          "τοῖς παραπτώμασιν καὶ τῇ ἀκροβυστίᾳ τῆς σαρκὸς ὑμῶν, συνεζωοποίησεν ὑμᾶς σὺν αὐτῷ· χαρισάμενος ἡμῖν πάντα τὰ παραπτώματα,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἐξαλείψας τὸ καθʼ ἡμῶν χειρόγραφον τοῖς δόγμασιν ὃ ἦν ὑπεναντίον ἡμῖν, καὶ αὐτὸ ἦρκεν ἐκ τοῦ μέσου προσηλώσας αὐτὸ τῷ σταυρῷ·"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ἀπεκδυσάμενος τὰς ἀρχὰς καὶ τὰς ἐξουσίας ἐδειγμάτισεν ἐν παρρησίᾳ, θριαμβεύσας αὐτοὺς ἐν αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Μὴ οὖν τις ὑμᾶς κρινέτω ἐν βρώσει ⸀ἢ",
          {
            "noteId": 35
          },
          "ἐν πόσει ἢ ἐν μέρει ἑορτῆς ἢ νουμηνίας ἢ σαββάτων,"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ἅ ἐστιν σκιὰ τῶν μελλόντων, τὸ δὲ σῶμα ⸀τοῦ",
          {
            "noteId": 36
          },
          "Χριστοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "μηδεὶς ὑμᾶς καταβραβευέτω θέλων ἐν ταπεινοφροσύνῃ καὶ θρησκείᾳ τῶν ἀγγέλων, ⸀ἃ",
          {
            "noteId": 37
          },
          "ἑόρακεν ἐμβατεύων, εἰκῇ φυσιούμενος ὑπὸ τοῦ νοὸς τῆς σαρκὸς αὐτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "καὶ οὐ κρατῶν τὴν κεφαλήν, ἐξ οὗ πᾶν τὸ σῶμα διὰ τῶν ἁφῶν καὶ συνδέσμων ἐπιχορηγούμενον καὶ συμβιβαζόμενον αὔξει τὴν αὔξησιν τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Εἰ ἀπεθάνετε σὺν Χριστῷ ἀπὸ τῶν στοιχείων τοῦ κόσμου, τί ὡς ζῶντες ἐν κόσμῳ δογματίζεσθε·"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Μὴ ἅψῃ μηδὲ γεύσῃ μηδὲ θίγῃς,"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ἅ ἐστιν πάντα εἰς φθορὰν τῇ ἀποχρήσει, κατὰ τὰ ἐντάλματα καὶ διδασκαλίας τῶν ἀνθρώπων;"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ἅτινά ἐστιν λόγον μὲν ἔχοντα σοφίας ἐν ἐθελοθρησκίᾳ καὶ ταπεινοφροσύνῃ καὶ ἀφειδίᾳ σώματος, οὐκ ἐν τιμῇ τινι πρὸς πλησμονὴν τῆς σαρκός."
        ]
      }
    ],
