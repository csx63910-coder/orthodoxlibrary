  "chapter": {
    "number": 14,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἐγένετο δὲ ἐν Ἰκονίῳ κατὰ τὸ αὐτὸ εἰσελθεῖν αὐτοὺς εἰς τὴν συναγωγὴν τῶν Ἰουδαίων καὶ λαλῆσαι οὕτως ὥστε πιστεῦσαι Ἰουδαίων τε καὶ Ἑλλήνων πολὺ πλῆθος."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "οἱ δὲ ⸀ἀπειθήσαντες",
          {
            "noteId": 492
          },
          "Ἰουδαῖοι ἐπήγειραν καὶ ἐκάκωσαν τὰς ψυχὰς τῶν ἐθνῶν κατὰ τῶν ἀδελφῶν."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἱκανὸν μὲν οὖν χρόνον διέτριψαν παρρησιαζόμενοι ἐπὶ τῷ",
          {
            "noteId": 493
          },
          "κυρίῳ τῷ μαρτυροῦντι ⸀τῷ λόγῳ τῆς χάριτος αὐτοῦ, διδόντι σημεῖα καὶ τέρατα γίνεσθαι διὰ τῶν χειρῶν αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἐσχίσθη δὲ τὸ πλῆθος τῆς πόλεως, καὶ οἱ μὲν ἦσαν σὺν τοῖς Ἰουδαίοις οἱ δὲ σὺν τοῖς ἀποστόλοις."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ὡς δὲ ἐγένετο ὁρμὴ τῶν ἐθνῶν τε καὶ Ἰουδαίων σὺν τοῖς ἄρχουσιν αὐτῶν ὑβρίσαι καὶ λιθοβολῆσαι αὐτούς,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "συνιδόντες κατέφυγον εἰς τὰς πόλεις τῆς Λυκαονίας Λύστραν καὶ Δέρβην καὶ τὴν περίχωρον,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "κἀκεῖ ⸂εὐαγγελιζόμενοι ἦσαν",
          {
            "noteId": 494
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Καί τις ἀνὴρ ⸂ἀδύνατος ἐν Λύστροις",
          {
            "noteId": 495
          },
          "τοῖς ποσὶν ἐκάθητο, χωλὸς ἐκ κοιλίας μητρὸς ⸀αὐτοῦ",
          {
            "noteId": 496
          },
          "ὃς οὐδέποτε ⸀περιεπάτησεν",
          {
            "noteId": 497
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "οὗτος ⸀ἤκουσεν",
          {
            "noteId": 498
          },
          "τοῦ Παύλου λαλοῦντος· ὃς ἀτενίσας αὐτῷ καὶ ἰδὼν ὅτι ⸂ἔχει πίστιν",
          {
            "noteId": 499
          },
          "τοῦ σωθῆναι"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "εἶπεν ⸀μεγάλῃ",
          {
            "noteId": 500
          },
          "φωνῇ· Ἀνάστηθι ἐπὶ τοὺς πόδας σου ⸀ὀρθός",
          {
            "noteId": 501
          },
          "καὶ ⸀ἥλατο",
          {
            "noteId": 502
          },
          "καὶ περιεπάτει."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "οἵ ⸀τε",
          {
            "noteId": 503
          },
          "ὄχλοι ἰδόντες ὃ ⸀ἐποίησεν",
          {
            "noteId": 504
          },
          "Παῦλος ἐπῆραν τὴν φωνὴν αὐτῶν Λυκαονιστὶ λέγοντες· Οἱ θεοὶ ὁμοιωθέντες ἀνθρώποις κατέβησαν πρὸς ἡμᾶς"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ἐκάλουν τε ⸀τὸν",
          {
            "noteId": 505
          },
          "Βαρναβᾶν Δία, τὸν δὲ Παῦλον Ἑρμῆν, ἐπειδὴ αὐτὸς ἦν ὁ ἡγούμενος τοῦ λόγου."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ὅ ⸀τε",
          {
            "noteId": 506
          },
          "ἱερεὺς τοῦ Διὸς τοῦ ὄντος πρὸ τῆς ⸀πόλεως",
          {
            "noteId": 507
          },
          "ταύρους καὶ στέμματα ἐπὶ τοὺς πυλῶνας ἐνέγκας σὺν τοῖς ὄχλοις ἤθελεν θύειν."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἀκούσαντες δὲ οἱ ἀπόστολοι Βαρναβᾶς καὶ Παῦλος, διαρρήξαντες τὰ ἱμάτια ⸀αὐτῶν",
          {
            "noteId": 508
          },
          "⸀ἐξεπήδησαν",
          {
            "noteId": 509
          },
          "εἰς τὸν ὄχλον κράζοντες"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ λέγοντες· Ἄνδρες, τί ταῦτα ποιεῖτε; καὶ ἡμεῖς ὁμοιοπαθεῖς ἐσμεν ὑμῖν ἄνθρωποι, εὐαγγελιζόμενοι ὑμᾶς ἀπὸ τούτων τῶν ματαίων ἐπιστρέφειν ἐπὶ ⸀θεὸν",
          {
            "noteId": 510
          },
          "ζῶντα ὃς ἐποίησεν τὸν οὐρανὸν καὶ τὴν γῆν καὶ τὴν θάλασσαν καὶ πάντα τὰ ἐν αὐτοῖς·"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ὃς ἐν ταῖς παρῳχημέναις γενεαῖς εἴασεν πάντα τὰ ἔθνη πορεύεσθαι ταῖς ὁδοῖς αὐτῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "⸀καίτοι",
          {
            "noteId": 511
          },
          "οὐκ ἀμάρτυρον ⸀αὑτὸν",
          {
            "noteId": 512
          },
          "ἀφῆκεν ⸀ἀγαθουργῶν",
          {
            "noteId": 513
          },
          "οὐρανόθεν ὑμῖν ὑετοὺς διδοὺς καὶ καιροὺς καρποφόρους, ἐμπιπλῶν τροφῆς καὶ εὐφροσύνης τὰς καρδίας ⸀ὑμῶν",
          {
            "noteId": 514
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ ταῦτα λέγοντες μόλις κατέπαυσαν τοὺς ὄχλους τοῦ μὴ θύειν αὐτοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Ἐπῆλθαν δὲ ἀπὸ Ἀντιοχείας καὶ Ἰκονίου Ἰουδαῖοι, καὶ πείσαντες τοὺς ὄχλους καὶ λιθάσαντες τὸν Παῦλον ἔσυρον ἔξω τῆς πόλεως, ⸀νομίζοντες",
          {
            "noteId": 515
          },
          "αὐτὸν τεθνηκέναι."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "κυκλωσάντων δὲ ⸂τῶν μαθητῶν αὐτὸν",
          {
            "noteId": 516
          },
          "ἀναστὰς εἰσῆλθεν εἰς τὴν πόλιν. καὶ τῇ ἐπαύριον ἐξῆλθεν σὺν τῷ Βαρναβᾷ εἰς Δέρβην."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Εὐαγγελισάμενοί τε τὴν πόλιν ἐκείνην καὶ μαθητεύσαντες ἱκανοὺς ὑπέστρεψαν εἰς τὴν Λύστραν καὶ ⸀εἰς",
          {
            "noteId": 517
          },
          "Ἰκόνιον καὶ ⸁εἰς",
          {
            "noteId": 518
          },
          "Ἀντιόχειαν,"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ἐπιστηρίζοντες τὰς ψυχὰς τῶν μαθητῶν, παρακαλοῦντες ἐμμένειν τῇ πίστει καὶ ὅτι διὰ πολλῶν θλίψεων δεῖ ἡμᾶς εἰσελθεῖν εἰς τὴν βασιλείαν τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "χειροτονήσαντες δὲ αὐτοῖς ⸂κατʼ ἐκκλησίαν πρεσβυτέρους",
          {
            "noteId": 519
          },
          "προσευξάμενοι μετὰ νηστειῶν παρέθεντο αὐτοὺς τῷ κυρίῳ εἰς ὃν πεπιστεύκεισαν."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "καὶ διελθόντες τὴν",
          {
            "noteId": 520
          },
          "Πισιδίαν ἦλθον εἰς ⸀τὴν Παμφυλίαν,"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "καὶ λαλήσαντες ἐν Πέργῃ τὸν λόγον κατέβησαν εἰς Ἀττάλειαν,"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "κἀκεῖθεν ἀπέπλευσαν εἰς Ἀντιόχειαν, ὅθεν ἦσαν παραδεδομένοι τῇ χάριτι τοῦ θεοῦ εἰς τὸ ἔργον ὃ ἐπλήρωσαν."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "παραγενόμενοι δὲ καὶ συναγαγόντες τὴν ἐκκλησίαν ⸀ἀνήγγελλον",
          {
            "noteId": 521
          },
          "ὅσα ἐποίησεν ὁ θεὸς μετʼ αὐτῶν καὶ ὅτι ἤνοιξεν τοῖς ἔθνεσιν θύραν πίστεως."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "διέτριβον ⸀δὲ",
          {
            "noteId": 522
          },
          "χρόνον οὐκ ὀλίγον σὺν τοῖς μαθηταῖς."
        ]
      }
    ],
