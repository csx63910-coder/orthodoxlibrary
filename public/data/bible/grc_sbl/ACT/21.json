      {
        "noteId": 795,
        "caller": "+",
        "text": "ἤλθομεν WH Treg NA28 ] οἱ περὶ τὸν Παῦλον ἦλθον RP",
        "reference": {
          "chapter": 21,
          "verse": 8
        }
      },
      {
        "noteId": 796,
