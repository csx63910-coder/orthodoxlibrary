  "chapter": {
    "number": 21,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ὡς δὲ ἐγένετο ἀναχθῆναι ἡμᾶς ἀποσπασθέντας ἀπʼ αὐτῶν, εὐθυδρομήσαντες ἤλθομεν εἰς τὴν ⸀Κῶ",
          {
            "noteId": 784
          },
          "τῇ δὲ ἑξῆς εἰς τὴν Ῥόδον, κἀκεῖθεν εἰς Πάταρα·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ εὑρόντες πλοῖον διαπερῶν εἰς Φοινίκην ἐπιβάντες ἀνήχθημεν."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "⸀ἀναφάναντες",
          {
            "noteId": 785
          },
          "δὲ τὴν Κύπρον καὶ καταλιπόντες αὐτὴν εὐώνυμον ἐπλέομεν εἰς Συρίαν, καὶ ⸀κατήλθομεν",
          {
            "noteId": 786
          },
          "εἰς Τύρον, ἐκεῖσε γὰρ ⸂τὸ πλοῖον ἦν",
          {
            "noteId": 787
          },
          "ἀποφορτιζόμενον τὸν γόμον."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "⸂ἀνευρόντες δὲ τοὺς",
          {
            "noteId": 788
          },
          "μαθητὰς ἐπεμείναμεν αὐτοῦ ἡμέρας ἑπτά, οἵτινες τῷ Παύλῳ ἔλεγον διὰ τοῦ πνεύματος μὴ ⸀ἐπιβαίνειν",
          {
            "noteId": 789
          },
          "εἰς ⸀Ἱεροσόλυμα",
          {
            "noteId": 790
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ὅτε δὲ ἐγένετο ⸂ἐξαρτίσαι ἡμᾶς",
          {
            "noteId": 791
          },
          "τὰς ἡμέρας, ἐξελθόντες ἐπορευόμεθα προπεμπόντων ἡμᾶς πάντων σὺν γυναιξὶ καὶ τέκνοις ἕως ἔξω τῆς πόλεως, καὶ θέντες τὰ γόνατα ἐπὶ τὸν αἰγιαλὸν ⸀προσευξάμενοι",
          {
            "noteId": 792
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "⸂ἀπησπασάμεθα ἀλλήλους, καὶ⸃ ⸀ἐνέβημεν εἰς τὸ πλοῖον, ἐκεῖνοι δὲ ὑπέστρεψαν εἰς τὰ ἴδια.",
          {
            "noteId": 793
          },
          {
            "noteId": 794
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ἡμεῖς δὲ τὸν πλοῦν διανύσαντες ἀπὸ Τύρου κατηντήσαμεν εἰς Πτολεμαΐδα, καὶ ἀσπασάμενοι τοὺς ἀδελφοὺς ἐμείναμεν ἡμέραν μίαν παρʼ αὐτοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "τῇ δὲ ἐπαύριον ἐξελθόντες ⸀ἤλθομεν",
          {
            "noteId": 795
          },
          "εἰς Καισάρειαν, καὶ εἰσελθόντες εἰς τὸν οἶκον Φιλίππου τοῦ εὐαγγελιστοῦ ὄντος ἐκ τῶν ἑπτὰ ἐμείναμεν παρʼ αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "τούτῳ δὲ ἦσαν θυγατέρες ⸂τέσσαρες παρθένοι",
          {
            "noteId": 796
          },
          "προφητεύουσαι."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἐπιμενόντων ⸀δὲ",
          {
            "noteId": 797
          },
          "ἡμέρας πλείους κατῆλθέν τις ἀπὸ τῆς Ἰουδαίας προφήτης ὀνόματι Ἅγαβος,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ ἐλθὼν πρὸς ἡμᾶς καὶ ἄρας τὴν ζώνην τοῦ Παύλου δήσας ⸀ἑαυτοῦ",
          {
            "noteId": 798
          },
          "τοὺς πόδας καὶ τὰς χεῖρας εἶπεν· Τάδε λέγει τὸ πνεῦμα τὸ ἅγιον Τὸν ἄνδρα οὗ ἐστιν ἡ ζώνη αὕτη, οὕτως δήσουσιν ἐν Ἰερουσαλὴμ οἱ Ἰουδαῖοι καὶ παραδώσουσιν εἰς χεῖρας ἐθνῶν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ὡς δὲ ἠκούσαμεν ταῦτα, παρεκαλοῦμεν ἡμεῖς τε καὶ οἱ ἐντόπιοι τοῦ μὴ ἀναβαίνειν αὐτὸν εἰς Ἰερουσαλήμ."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "⸂τότε ἀπεκρίθη",
          {
            "noteId": 799
          },
          "ὁ Παῦλος· Τί ποιεῖτε κλαίοντες καὶ συνθρύπτοντές μου τὴν καρδίαν; ἐγὼ γὰρ οὐ μόνον δεθῆναι ἀλλὰ καὶ ἀποθανεῖν εἰς Ἰερουσαλὴμ ἑτοίμως ἔχω ὑπὲρ τοῦ ὀνόματος τοῦ κυρίου Ἰησοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "μὴ πειθομένου δὲ αὐτοῦ ἡσυχάσαμεν εἰπόντες· ⸂Τοῦ κυρίου τὸ θέλημα",
          {
            "noteId": 800
          },
          "⸀γινέσθω",
          {
            "noteId": 801
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Μετὰ δὲ τὰς ἡμέρας ταύτας ἐπισκευασάμενοι ἀνεβαίνομεν εἰς ⸀Ἱεροσόλυμα",
          {
            "noteId": 802
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "συνῆλθον δὲ καὶ τῶν μαθητῶν ἀπὸ Καισαρείας σὺν ἡμῖν, ἄγοντες παρʼ ᾧ ξενισθῶμεν Μνάσωνί τινι Κυπρίῳ, ἀρχαίῳ μαθητῇ."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Γενομένων δὲ ἡμῶν εἰς Ἱεροσόλυμα ἀσμένως ⸀ἀπεδέξαντο",
          {
            "noteId": 803
          },
          "ἡμᾶς οἱ ἀδελφοί."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "τῇ δὲ ἐπιούσῃ εἰσῄει ὁ Παῦλος σὺν ἡμῖν πρὸς Ἰάκωβον, πάντες τε παρεγένοντο οἱ πρεσβύτεροι."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "καὶ ἀσπασάμενος αὐτοὺς ἐξηγεῖτο καθʼ ἓν ἕκαστον ὧν ἐποίησεν ὁ θεὸς ἐν τοῖς ἔθνεσιν διὰ τῆς διακονίας αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "οἱ δὲ ἀκούσαντες ἐδόξαζον τὸν ⸀θεόν",
          {
            "noteId": 804
          },
          "⸂εἶπόν τε",
          {
            "noteId": 805
          },
          "αὐτῷ· Θεωρεῖς, ἀδελφέ, πόσαι μυριάδες εἰσὶν ⸂ἐν τοῖς Ἰουδαίοις",
          {
            "noteId": 806
          },
          "τῶν πεπιστευκότων, καὶ πάντες ζηλωταὶ τοῦ νόμου ὑπάρχουσιν·"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "κατηχήθησαν δὲ περὶ σοῦ ὅτι ἀποστασίαν διδάσκεις ἀπὸ Μωϋσέως τοὺς κατὰ τὰ ἔθνη πάντας Ἰουδαίους, λέγων μὴ περιτέμνειν αὐτοὺς τὰ τέκνα μηδὲ τοῖς ἔθεσιν περιπατεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "τί οὖν ἐστιν; πάντως ⸀ἀκούσονται",
          {
            "noteId": 807
          },
          "ὅτι ἐλήλυθας."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "τοῦτο οὖν ποίησον ὅ σοι λέγομεν· εἰσὶν ἡμῖν ἄνδρες τέσσαρες εὐχὴν ἔχοντες ⸀ἀφʼ",
          {
            "noteId": 808
          },
          "ἑαυτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "τούτους παραλαβὼν ἁγνίσθητι σὺν αὐτοῖς καὶ δαπάνησον ἐπʼ αὐτοῖς ἵνα ⸀ξυρήσονται",
          {
            "noteId": 809
          },
          "τὴν κεφαλήν, καὶ ⸀γνώσονται",
          {
            "noteId": 810
          },
          "πάντες ὅτι ὧν κατήχηνται περὶ σοῦ οὐδέν ἐστιν, ἀλλὰ στοιχεῖς καὶ αὐτὸς ⸂φυλάσσων τὸν νόμον",
          {
            "noteId": 811
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "περὶ δὲ τῶν πεπιστευκότων ἐθνῶν ἡμεῖς ⸀ἀπεστείλαμεν",
          {
            "noteId": 812
          },
          "⸀κρίναντες",
          {
            "noteId": 813
          },
          "φυλάσσεσθαι αὐτοὺς τό τε εἰδωλόθυτον ⸀καὶ",
          {
            "noteId": 814
          },
          "αἷμα καὶ πνικτὸν καὶ πορνείαν."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "τότε ὁ Παῦλος παραλαβὼν τοὺς ἄνδρας τῇ ἐχομένῃ ἡμέρᾳ σὺν αὐτοῖς ἁγνισθεὶς εἰσῄει εἰς τὸ ἱερόν, διαγγέλλων τὴν ἐκπλήρωσιν τῶν ἡμερῶν τοῦ ἁγνισμοῦ ἕως οὗ προσηνέχθη ὑπὲρ ἑνὸς ἑκάστου αὐτῶν ἡ προσφορά."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Ὡς δὲ ἔμελλον αἱ ἑπτὰ ἡμέραι συντελεῖσθαι, οἱ ἀπὸ τῆς Ἀσίας Ἰουδαῖοι θεασάμενοι αὐτὸν ἐν τῷ ἱερῷ συνέχεον πάντα τὸν ὄχλον καὶ ἐπέβαλον ⸂ἐπʼ αὐτὸν τὰς χεῖρας",
          {
            "noteId": 815
          },
          ","
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "κράζοντες· Ἄνδρες Ἰσραηλῖται, βοηθεῖτε· οὗτός ἐστιν ὁ ἄνθρωπος ὁ κατὰ τοῦ λαοῦ καὶ τοῦ νόμου καὶ τοῦ τόπου τούτου πάντας ⸀πανταχῇ",
          {
            "noteId": 816
          },
          "διδάσκων, ἔτι τε καὶ Ἕλληνας εἰσήγαγεν εἰς τὸ ἱερὸν καὶ κεκοίνωκεν τὸν ἅγιον τόπον τοῦτον."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "ἦσαν γὰρ ⸀προεωρακότες",
          {
            "noteId": 817
          },
          "Τρόφιμον τὸν Ἐφέσιον ἐν τῇ πόλει σὺν αὐτῷ, ὃν ἐνόμιζον ὅτι εἰς τὸ ἱερὸν εἰσήγαγεν ὁ Παῦλος."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ἐκινήθη τε ἡ πόλις ὅλη καὶ ἐγένετο συνδρομὴ τοῦ λαοῦ, καὶ ἐπιλαβόμενοι τοῦ Παύλου εἷλκον αὐτὸν ἔξω τοῦ ἱεροῦ, καὶ εὐθέως ἐκλείσθησαν αἱ θύραι."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "ζητούντων ⸀τε",
          {
            "noteId": 818
          },
          "αὐτὸν ἀποκτεῖναι ἀνέβη φάσις τῷ χιλιάρχῳ τῆς σπείρης ὅτι ὅλη ⸀συγχύννεται",
          {
            "noteId": 819
          },
          "Ἰερουσαλήμ,"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "ὃς ἐξαυτῆς παραλαβὼν στρατιώτας καὶ ἑκατοντάρχας κατέδραμεν ἐπʼ αὐτούς, οἱ δὲ ἰδόντες τὸν χιλίαρχον καὶ τοὺς στρατιώτας ἐπαύσαντο τύπτοντες τὸν Παῦλον."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "⸂τότε ἐγγίσας",
          {
            "noteId": 820
          },
          "ὁ χιλίαρχος ἐπελάβετο αὐτοῦ καὶ ἐκέλευσε δεθῆναι ἁλύσεσι δυσί, καὶ ἐπυνθάνετο ⸀τίς",
          {
            "noteId": 821
          },
          "εἴη καὶ τί ἐστιν πεποιηκώς."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "ἄλλοι δὲ ἄλλο τι ⸀ἐπεφώνουν",
          {
            "noteId": 822
          },
          "ἐν τῷ ὄχλῳ· μὴ ⸂δυναμένου δὲ αὐτοῦ",
          {
            "noteId": 823
          },
          "γνῶναι τὸ ἀσφαλὲς διὰ τὸν θόρυβον ἐκέλευσεν ἄγεσθαι αὐτὸν εἰς τὴν παρεμβολήν."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "ὅτε δὲ ἐγένετο ἐπὶ τοὺς ἀναβαθμούς, συνέβη βαστάζεσθαι αὐτὸν ὑπὸ τῶν στρατιωτῶν διὰ τὴν βίαν τοῦ ὄχλου,"
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "ἠκολούθει γὰρ τὸ πλῆθος τοῦ λαοῦ ⸀κράζοντες",
          {
            "noteId": 824
          },
          "Αἶρε αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "Μέλλων τε εἰσάγεσθαι εἰς τὴν παρεμβολὴν ὁ Παῦλος λέγει τῷ χιλιάρχῳ· Εἰ ἔξεστίν μοι εἰπεῖν ⸀τι",
          {
            "noteId": 825
          },
          "πρὸς σέ; ὁ δὲ ἔφη· Ἑλληνιστὶ γινώσκεις;"
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "οὐκ ἄρα σὺ εἶ ὁ Αἰγύπτιος ὁ πρὸ τούτων τῶν ἡμερῶν ἀναστατώσας καὶ ἐξαγαγὼν εἰς τὴν ἔρημον τοὺς τετρακισχιλίους ἄνδρας τῶν σικαρίων;"
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "εἶπεν δὲ ὁ Παῦλος· Ἐγὼ ἄνθρωπος μέν εἰμι Ἰουδαῖος, Ταρσεὺς τῆς Κιλικίας, οὐκ ἀσήμου πόλεως πολίτης· δέομαι δέ σου, ἐπίτρεψόν μοι λαλῆσαι πρὸς τὸν λαόν."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "ἐπιτρέψαντος δὲ αὐτοῦ ὁ Παῦλος ἑστὼς ἐπὶ τῶν ἀναβαθμῶν κατέσεισε τῇ χειρὶ τῷ λαῷ, πολλῆς δὲ σιγῆς γενομένης ⸀προσεφώνησεν",
          {
            "noteId": 826
          },
          "τῇ Ἑβραΐδι διαλέκτῳ λέγων"
        ]
      }
    ],
