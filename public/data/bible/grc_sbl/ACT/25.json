  "chapter": {
    "number": 25,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Φῆστος οὖν ἐπιβὰς τῇ ἐπαρχείᾳ μετὰ τρεῖς ἡμέρας ἀνέβη εἰς Ἱεροσόλυμα ἀπὸ Καισαρείας,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἐνεφάνισάν ⸀τε",
          {
            "noteId": 934
          },
          "αὐτῷ ⸂οἱ ἀρχιερεῖς",
          {
            "noteId": 935
          },
          "καὶ οἱ πρῶτοι τῶν Ἰουδαίων κατὰ τοῦ Παύλου, καὶ παρεκάλουν αὐτὸν"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "αἰτούμενοι χάριν κατʼ αὐτοῦ ὅπως μεταπέμψηται αὐτὸν εἰς Ἰερουσαλήμ, ἐνέδραν ποιοῦντες ἀνελεῖν αὐτὸν κατὰ τὴν ὁδόν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ὁ μὲν οὖν Φῆστος ἀπεκρίθη τηρεῖσθαι τὸν Παῦλον ⸂εἰς Καισάρειαν",
          {
            "noteId": 936
          },
          ", ἑαυτὸν δὲ μέλλειν ἐν τάχει ἐκπορεύεσθαι·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Οἱ οὖν ⸂ἐν ὑμῖν, φησίν, δυνατοὶ⸃ συγκαταβάντες εἴ τί ἐστιν ἐν τῷ ἀνδρὶ ⸀ἄτοπον κατηγορείτωσαν αὐτοῦ.",
          {
            "noteId": 937
          },
          {
            "noteId": 938
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Διατρίψας δὲ ἐν αὐτοῖς ἡμέρας ⸂οὐ πλείους ὀκτὼ",
          {
            "noteId": 939
          },
          "ἢ δέκα, καταβὰς εἰς Καισάρειαν, τῇ ἐπαύριον καθίσας ἐπὶ τοῦ βήματος ἐκέλευσεν τὸν Παῦλον ἀχθῆναι."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "παραγενομένου δὲ αὐτοῦ περιέστησαν ⸀αὐτὸν",
          {
            "noteId": 940
          },
          "οἱ ἀπὸ Ἱεροσολύμων καταβεβηκότες Ἰουδαῖοι, πολλὰ καὶ βαρέα αἰτιώματα ⸀καταφέροντες",
          {
            "noteId": 941
          },
          "ἃ οὐκ ἴσχυον ἀποδεῖξαι,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "⸂τοῦ Παύλου ἀπολογουμένου",
          {
            "noteId": 942
          },
          "ὅτι Οὔτε εἰς τὸν νόμον τῶν Ἰουδαίων οὔτε εἰς τὸ ἱερὸν οὔτε εἰς Καίσαρά τι ἥμαρτον."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ὁ Φῆστος δὲ ⸂θέλων τοῖς Ἰουδαίοις",
          {
            "noteId": 943
          },
          "χάριν καταθέσθαι ἀποκριθεὶς τῷ Παύλῳ εἶπεν· Θέλεις εἰς Ἱεροσόλυμα ἀναβὰς ἐκεῖ περὶ τούτων ⸀κριθῆναι",
          {
            "noteId": 944
          },
          "ἐπʼ ἐμοῦ;"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "εἶπεν δὲ ὁ Παῦλος· ⸂Ἐπὶ τοῦ βήματος Καίσαρος ἑστώς",
          {
            "noteId": 945
          },
          "εἰμι, οὗ με δεῖ κρίνεσθαι. Ἰουδαίους οὐδὲν ⸀ἠδίκησα",
          {
            "noteId": 946
          },
          "ὡς καὶ σὺ κάλλιον ἐπιγινώσκεις."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "εἰ μὲν ⸀οὖν",
          {
            "noteId": 947
          },
          "ἀδικῶ καὶ ἄξιον θανάτου πέπραχά τι, οὐ παραιτοῦμαι τὸ ἀποθανεῖν· εἰ δὲ οὐδέν ἐστιν ὧν οὗτοι κατηγοροῦσίν μου, οὐδείς με δύναται αὐτοῖς χαρίσασθαι· Καίσαρα ἐπικαλοῦμαι."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "τότε ὁ Φῆστος συλλαλήσας μετὰ τοῦ συμβουλίου ἀπεκρίθη· Καίσαρα ἐπικέκλησαι, ἐπὶ Καίσαρα πορεύσῃ."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ἡμερῶν δὲ διαγενομένων τινῶν Ἀγρίππας ὁ βασιλεὺς καὶ Βερνίκη κατήντησαν εἰς Καισάρειαν ἀσπασάμενοι τὸν Φῆστον."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ὡς δὲ πλείους ἡμέρας ⸀διέτριβον",
          {
            "noteId": 948
          },
          "ἐκεῖ, ὁ Φῆστος τῷ βασιλεῖ ἀνέθετο τὰ κατὰ τὸν Παῦλον λέγων· Ἀνήρ τίς ἐστιν καταλελειμμένος ὑπὸ Φήλικος δέσμιος,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "περὶ οὗ γενομένου μου εἰς Ἱεροσόλυμα ἐνεφάνισαν οἱ ἀρχιερεῖς καὶ οἱ πρεσβύτεροι τῶν Ἰουδαίων, αἰτούμενοι κατʼ αὐτοῦ ⸀καταδίκην",
          {
            "noteId": 949
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "πρὸς οὓς ἀπεκρίθην ὅτι οὐκ ἔστιν ἔθος Ῥωμαίοις χαρίζεσθαί τινα ⸀ἄνθρωπον",
          {
            "noteId": 950
          },
          "πρὶν ἢ ὁ κατηγορούμενος κατὰ πρόσωπον ἔχοι τοὺς κατηγόρους τόπον τε ἀπολογίας λάβοι περὶ τοῦ ἐγκλήματος."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "συνελθόντων ⸀οὖν",
          {
            "noteId": 951
          },
          "ἐνθάδε ἀναβολὴν μηδεμίαν ποιησάμενος τῇ ἑξῆς καθίσας ἐπὶ τοῦ βήματος ἐκέλευσα ἀχθῆναι τὸν ἄνδρα·"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "περὶ οὗ σταθέντες οἱ κατήγοροι οὐδεμίαν αἰτίαν ⸀ἔφερον",
          {
            "noteId": 952
          },
          "ὧν ⸂ἐγὼ ὑπενόουν",
          {
            "noteId": 953
          },
          "⸀πονηρῶν",
          {
            "noteId": 954
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ζητήματα δέ τινα περὶ τῆς ἰδίας δεισιδαιμονίας εἶχον πρὸς αὐτὸν καὶ περί τινος Ἰησοῦ τεθνηκότος, ὃν ἔφασκεν ὁ Παῦλος ζῆν."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἀπορούμενος δὲ ἐγὼ τὴν περὶ ⸀τούτων",
          {
            "noteId": 955
          },
          "ζήτησιν ἔλεγον εἰ βούλοιτο πορεύεσθαι εἰς ⸀Ἱεροσόλυμα",
          {
            "noteId": 956
          },
          "κἀκεῖ κρίνεσθαι περὶ τούτων."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "τοῦ δὲ Παύλου ἐπικαλεσαμένου τηρηθῆναι αὐτὸν εἰς τὴν τοῦ Σεβαστοῦ διάγνωσιν, ἐκέλευσα τηρεῖσθαι αὐτὸν ἕως οὗ ⸀ἀναπέμψω",
          {
            "noteId": 957
          },
          "αὐτὸν πρὸς Καίσαρα."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Ἀγρίππας δὲ πρὸς τὸν ⸀Φῆστον",
          {
            "noteId": 958
          },
          "Ἐβουλόμην καὶ αὐτὸς τοῦ ἀνθρώπου ἀκοῦσαι. ⸀Αὔριον",
          {
            "noteId": 959
          },
          "φησίν, ἀκούσῃ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Τῇ οὖν ἐπαύριον ἐλθόντος τοῦ Ἀγρίππα καὶ τῆς Βερνίκης μετὰ πολλῆς φαντασίας καὶ εἰσελθόντων εἰς τὸ ἀκροατήριον σύν ⸀τε",
          {
            "noteId": 960
          },
          "χιλιάρχοις καὶ ἀνδράσιν τοῖς κατʼ ⸀ἐξοχὴν",
          {
            "noteId": 961
          },
          "τῆς πόλεως καὶ κελεύσαντος τοῦ Φήστου ἤχθη ὁ Παῦλος."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "καί φησιν ὁ Φῆστος· Ἀγρίππα βασιλεῦ καὶ πάντες οἱ συμπαρόντες ἡμῖν ἄνδρες, θεωρεῖτε τοῦτον περὶ οὗ ⸀ἅπαν",
          {
            "noteId": 962
          },
          "τὸ πλῆθος τῶν Ἰουδαίων ⸀ἐνέτυχόν",
          {
            "noteId": 963
          },
          "μοι ἔν τε Ἱεροσολύμοις καὶ ἐνθάδε, ⸀βοῶντες",
          {
            "noteId": 964
          },
          "μὴ δεῖν ⸂αὐτὸν ζῆν",
          {
            "noteId": 965
          },
          "μηκέτι."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ἐγὼ δὲ ⸀κατελαβόμην",
          {
            "noteId": 966
          },
          "μηδὲν ἄξιον ⸂αὐτὸν θανάτου",
          {
            "noteId": 967
          },
          "πεπραχέναι, ⸀αὐτοῦ",
          {
            "noteId": 968
          },
          "δὲ τούτου ἐπικαλεσαμένου τὸν Σεβαστὸν ἔκρινα ⸀πέμπειν",
          {
            "noteId": 969
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "περὶ οὗ ἀσφαλές τι γράψαι τῷ κυρίῳ οὐκ ἔχω· διὸ προήγαγον αὐτὸν ἐφʼ ὑμῶν καὶ μάλιστα ἐπὶ σοῦ, βασιλεῦ Ἀγρίππα, ὅπως τῆς ἀνακρίσεως γενομένης σχῶ τί ⸀γράψω",
          {
            "noteId": 970
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "ἄλογον γάρ μοι δοκεῖ πέμποντα δέσμιον μὴ καὶ τὰς κατʼ αὐτοῦ αἰτίας σημᾶναι."
        ]
      }
    ],
