  "chapter": {
    "number": 22,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἄνδρες ἀδελφοὶ καὶ πατέρες, ἀκούσατέ μου τῆς πρὸς ὑμᾶς νυνὶ ἀπολογίας."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Ἀκούσαντες δὲ ὅτι τῇ Ἑβραΐδι διαλέκτῳ προσεφώνει αὐτοῖς μᾶλλον παρέσχον ἡσυχίαν. καὶ φησίν·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "⸀Ἐγώ",
          {
            "noteId": 827
          },
          "εἰμι ἀνὴρ Ἰουδαῖος, γεγεννημένος ἐν Ταρσῷ τῆς Κιλικίας, ἀνατεθραμμένος δὲ ἐν τῇ πόλει ταύτῃ παρὰ τοὺς πόδας Γαμαλιήλ, πεπαιδευμένος κατὰ ἀκρίβειαν τοῦ πατρῴου νόμου, ζηλωτὴς ὑπάρχων τοῦ θεοῦ καθὼς πάντες ὑμεῖς ἐστε σήμερον,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ὃς ταύτην τὴν ὁδὸν ἐδίωξα ἄχρι θανάτου, δεσμεύων καὶ παραδιδοὺς εἰς φυλακὰς ἄνδρας τε καὶ γυναῖκας,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ὡς καὶ ὁ ἀρχιερεὺς μαρτυρεῖ μοι καὶ πᾶν τὸ πρεσβυτέριον· παρʼ ὧν καὶ ἐπιστολὰς δεξάμενος πρὸς τοὺς ἀδελφοὺς εἰς Δαμασκὸν ἐπορευόμην ἄξων καὶ τοὺς ἐκεῖσε ὄντας δεδεμένους εἰς Ἰερουσαλὴμ ἵνα τιμωρηθῶσιν."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ἐγένετο δέ μοι πορευομένῳ καὶ ἐγγίζοντι τῇ Δαμασκῷ περὶ μεσημβρίαν ἐξαίφνης ἐκ τοῦ οὐρανοῦ περιαστράψαι φῶς ἱκανὸν περὶ ἐμέ,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἔπεσά τε εἰς τὸ ἔδαφος καὶ ἤκουσα φωνῆς λεγούσης μοι· Σαοὺλ Σαούλ, τί με διώκεις;"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἐγὼ δὲ ἀπεκρίθην· Τίς εἶ, κύριε; εἶπέν τε πρὸς ⸀ἐμέ",
          {
            "noteId": 828
          },
          "Ἐγώ εἰμι Ἰησοῦς ὁ Ναζωραῖος ὃν σὺ διώκεις."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "οἱ δὲ σὺν ἐμοὶ ὄντες τὸ μὲν φῶς ⸀ἐθεάσαντο",
          {
            "noteId": 829
          },
          "τὴν δὲ φωνὴν οὐκ ἤκουσαν τοῦ λαλοῦντός μοι."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "εἶπον δέ· Τί ποιήσω, κύριε; ὁ δὲ κύριος εἶπεν πρός με· Ἀναστὰς πορεύου εἰς Δαμασκόν, κἀκεῖ σοι λαληθήσεται περὶ πάντων ὧν τέτακταί σοι ποιῆσαι."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ὡς δὲ οὐκ ἐνέβλεπον ἀπὸ τῆς δόξης τοῦ φωτὸς ἐκείνου, χειραγωγούμενος ὑπὸ τῶν συνόντων μοι ἦλθον εἰς Δαμασκόν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ἁνανίας δέ τις ἀνὴρ ⸀εὐλαβὴς",
          {
            "noteId": 830
          },
          "κατὰ τὸν νόμον μαρτυρούμενος ὑπὸ πάντων τῶν κατοικούντων Ἰουδαίων,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ἐλθὼν πρὸς ⸀ἐμὲ",
          {
            "noteId": 831
          },
          "καὶ ἐπιστὰς εἶπέν μοι· Σαοὺλ ἀδελφέ, ἀνάβλεψον· κἀγὼ αὐτῇ τῇ ὥρᾳ ἀνέβλεψα εἰς αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ὁ δὲ εἶπεν· Ὁ θεὸς τῶν πατέρων ἡμῶν προεχειρίσατό σε γνῶναι τὸ θέλημα αὐτοῦ καὶ ἰδεῖν τὸν δίκαιον καὶ ἀκοῦσαι φωνὴν ἐκ τοῦ στόματος αὐτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ὅτι ἔσῃ μάρτυς αὐτῷ πρὸς πάντας ἀνθρώπους ὧν ἑώρακας καὶ ἤκουσας."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ νῦν τί μέλλεις; ἀναστὰς βάπτισαι καὶ ἀπόλουσαι τὰς ἁμαρτίας σου ἐπικαλεσάμενος τὸ ὄνομα ⸀αὐτοῦ",
          {
            "noteId": 832
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Ἐγένετο δέ μοι ὑποστρέψαντι εἰς Ἰερουσαλὴμ καὶ προσευχομένου μου ἐν τῷ ἱερῷ γενέσθαι με ἐν ἐκστάσει"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ ἰδεῖν αὐτὸν λέγοντά μοι· Σπεῦσον καὶ ἔξελθε ἐν τάχει ἐξ Ἰερουσαλήμ, διότι οὐ παραδέξονταί ⸀σου",
          {
            "noteId": 833
          },
          "μαρτυρίαν περὶ ἐμοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "κἀγὼ εἶπον· Κύριε, αὐτοὶ ἐπίστανται ὅτι ἐγὼ ἤμην φυλακίζων καὶ δέρων κατὰ τὰς συναγωγὰς τοὺς πιστεύοντας ἐπὶ σέ·"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "καὶ ὅτε ⸀ἐξεχύννετο",
          {
            "noteId": 834
          },
          "τὸ αἷμα Στεφάνου τοῦ μάρτυρός σου, καὶ",
          {
            "noteId": 835
          },
          "αὐτὸς ἤμην ἐφεστὼς καὶ συνευδοκῶν ⸀καὶ φυλάσσων τὰ ἱμάτια τῶν ἀναιρούντων αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "καὶ εἶπεν πρός με· Πορεύου, ὅτι ἐγὼ εἰς ἔθνη μακρὰν ἐξαποστελῶ σε."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Ἤκουον δὲ αὐτοῦ ἄχρι τούτου τοῦ λόγου καὶ ἐπῆραν τὴν φωνὴν αὐτῶν λέγοντες· Αἶρε ἀπὸ τῆς γῆς τὸν τοιοῦτον, οὐ γὰρ καθῆκεν αὐτὸν ζῆν."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "⸀κραυγαζόντων",
          {
            "noteId": 836
          },
          "⸀τε",
          {
            "noteId": 837
          },
          "αὐτῶν καὶ ῥιπτούντων τὰ ἱμάτια καὶ κονιορτὸν βαλλόντων εἰς τὸν ἀέρα,"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ἐκέλευσεν ⸂ὁ χιλίαρχος εἰσάγεσθαι αὐτὸν",
          {
            "noteId": 838
          },
          "εἰς τὴν παρεμβολήν, ⸀εἴπας",
          {
            "noteId": 839
          },
          "μάστιξιν ἀνετάζεσθαι αὐτὸν ἵνα ἐπιγνῷ διʼ ἣν αἰτίαν οὕτως ἐπεφώνουν αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ὡς δὲ ⸀προέτειναν",
          {
            "noteId": 840
          },
          "αὐτὸν τοῖς ἱμᾶσιν εἶπεν πρὸς τὸν ἑστῶτα ἑκατόνταρχον ὁ Παῦλος· Εἰ ἄνθρωπον Ῥωμαῖον καὶ ἀκατάκριτον ἔξεστιν ὑμῖν μαστίζειν;"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ἀκούσας δὲ ὁ ἑκατοντάρχης προσελθὼν ⸂τῷ χιλιάρχῳ ἀπήγγειλεν",
          {
            "noteId": 841
          },
          "λέγων· ⸀Τί",
          {
            "noteId": 842
          },
          "μέλλεις ποιεῖν; ὁ γὰρ ἄνθρωπος οὗτος Ῥωμαῖός ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "προσελθὼν δὲ ὁ χιλίαρχος εἶπεν αὐτῷ· Λέγε μοι, ⸀σὺ",
          {
            "noteId": 843
          },
          "Ῥωμαῖος εἶ; ὁ δὲ ἔφη· Ναί."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ἀπεκρίθη ⸀δὲ",
          {
            "noteId": 844
          },
          "ὁ χιλίαρχος· Ἐγὼ πολλοῦ κεφαλαίου τὴν πολιτείαν ταύτην ἐκτησάμην. ὁ δὲ Παῦλος ἔφη· Ἐγὼ δὲ καὶ γεγέννημαι."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "εὐθέως οὖν ἀπέστησαν ἀπʼ αὐτοῦ οἱ μέλλοντες αὐτὸν ἀνετάζειν· καὶ ὁ χιλίαρχος δὲ ἐφοβήθη ἐπιγνοὺς ὅτι Ῥωμαῖός ἐστιν καὶ ὅτι ⸂αὐτὸν ἦν",
          {
            "noteId": 845
          },
          "δεδεκώς."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Τῇ δὲ ἐπαύριον βουλόμενος γνῶναι τὸ ἀσφαλὲς τὸ τί κατηγορεῖται ⸀ὑπὸ",
          {
            "noteId": 846
          },
          "τῶν Ἰουδαίων ἔλυσεν ⸀αὐτόν",
          {
            "noteId": 847
          },
          "καὶ ἐκέλευσεν ⸀συνελθεῖν",
          {
            "noteId": 848
          },
          "τοὺς ἀρχιερεῖς καὶ ⸀πᾶν",
          {
            "noteId": 849
          },
          "τὸ ⸀συνέδριον",
          {
            "noteId": 850
          },
          "καὶ καταγαγὼν τὸν Παῦλον ἔστησεν εἰς αὐτούς."
        ]
      }
    ],
