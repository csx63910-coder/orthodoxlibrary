        }
      },
      {
        "noteId": 337,
        "caller": "+",
        "text": "αὐτῷ WH Treg NA28 ] τῷ Κορνηλίῳ RP",
        "reference": {
          "chapter": 10,
          "verse": 7
        }
      },
      {
