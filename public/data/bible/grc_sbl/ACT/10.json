  },
  "chapter": {
    "number": 10,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἀνὴρ δέ ⸀τις",
          {
            "noteId": 331
          },
          "ἐν Καισαρείᾳ ὀνόματι Κορνήλιος, ἑκατοντάρχης ἐκ σπείρης τῆς καλουμένης Ἰταλικῆς,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "εὐσεβὴς καὶ φοβούμενος τὸν θεὸν σὺν παντὶ τῷ οἴκῳ αὐτοῦ, ⸀ποιῶν",
          {
            "noteId": 332
          },
          "ἐλεημοσύνας πολλὰς τῷ λαῷ καὶ δεόμενος τοῦ θεοῦ διὰ παντός,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "εἶδεν ἐν ὁράματι φανερῶς ὡσεὶ ⸀περὶ",
          {
            "noteId": 333
          },
          "ὥραν ἐνάτην τῆς ἡμέρας ἄγγελον τοῦ θεοῦ εἰσελθόντα πρὸς αὐτὸν καὶ εἰπόντα αὐτῷ· Κορνήλιε."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ὁ δὲ ἀτενίσας αὐτῷ καὶ ἔμφοβος γενόμενος εἶπεν· Τί ἐστιν, κύριε; εἶπεν δὲ αὐτῷ· Αἱ προσευχαί σου καὶ αἱ ἐλεημοσύναι σου ἀνέβησαν εἰς μνημόσυνον ⸀ἔμπροσθεν",
          {
            "noteId": 334
          },
          "τοῦ θεοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ νῦν πέμψον ⸂ἄνδρας εἰς Ἰόππην",
          {
            "noteId": 335
          },
          "καὶ μετάπεμψαι Σίμωνά ⸂τινα ὃς ἐπικαλεῖται Πέτρος",
          {
            "noteId": 336
          },
          "·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "οὗτος ξενίζεται παρά τινι Σίμωνι βυρσεῖ, ᾧ ἐστιν οἰκία παρὰ θάλασσαν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ὡς δὲ ἀπῆλθεν ὁ ἄγγελος ὁ λαλῶν ⸀αὐτῷ",
          {
            "noteId": 337
          },
          "φωνήσας δύο τῶν ⸀οἰκετῶν",
          {
            "noteId": 338
          },
          "καὶ στρατιώτην εὐσεβῆ τῶν προσκαρτερούντων αὐτῷ"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ ἐξηγησάμενος ⸂ἅπαντα αὐτοῖς",
          {
            "noteId": 339
          },
          "ἀπέστειλεν αὐτοὺς εἰς τὴν Ἰόππην."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Τῇ δὲ ἐπαύριον ὁδοιπορούντων ἐκείνων καὶ τῇ πόλει ἐγγιζόντων ἀνέβη Πέτρος ἐπὶ τὸ δῶμα προσεύξασθαι περὶ ὥραν ἕκτην."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἐγένετο δὲ πρόσπεινος καὶ ἤθελεν γεύσασθαι· παρασκευαζόντων δὲ ⸀αὐτῶν",
          {
            "noteId": 340
          },
          "⸀ἐγένετο",
          {
            "noteId": 341
          },
          "ἐπʼ αὐτὸν ἔκστασις,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ θεωρεῖ τὸν οὐρανὸν ἀνεῳγμένον καὶ ⸀καταβαῖνον",
          {
            "noteId": 342
          },
          "σκεῦός τι ὡς ὀθόνην μεγάλην τέσσαρσιν ⸀ἀρχαῖς",
          {
            "noteId": 343
          },
          "καθιέμενον ἐπὶ τῆς γῆς,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ἐν ᾧ ὑπῆρχεν πάντα τὰ τετράποδα ⸂καὶ ἑρπετὰ τῆς γῆς καὶ",
          {
            "noteId": 344
          },
          "πετεινὰ τοῦ οὐρανοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ ἐγένετο φωνὴ πρὸς αὐτόν· Ἀναστάς, Πέτρε, θῦσον καὶ φάγε."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ὁ δὲ Πέτρος εἶπεν· Μηδαμῶς, κύριε, ὅτι οὐδέποτε ἔφαγον πᾶν κοινὸν ⸀καὶ",
          {
            "noteId": 345
          },
          "ἀκάθαρτον."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ φωνὴ πάλιν ἐκ δευτέρου πρὸς αὐτόν· Ἃ ὁ θεὸς ἐκαθάρισεν σὺ μὴ κοίνου."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "τοῦτο δὲ ἐγένετο ἐπὶ τρίς, καὶ ⸀εὐθὺς",
          {
            "noteId": 346
          },
          "ἀνελήμφθη τὸ σκεῦος εἰς τὸν οὐρανόν."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Ὡς δὲ ἐν ἑαυτῷ διηπόρει ὁ Πέτρος τί ἂν εἴη τὸ ὅραμα ὃ εἶδεν, ⸀ἰδοὺ",
          {
            "noteId": 347
          },
          "οἱ ἄνδρες οἱ ἀπεσταλμένοι ⸀ὑπὸ",
          {
            "noteId": 348
          },
          "τοῦ",
          {
            "noteId": 349
          },
          "Κορνηλίου διερωτήσαντες τὴν οἰκίαν ⸀τοῦ Σίμωνος ἐπέστησαν ἐπὶ τὸν πυλῶνα,"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ φωνήσαντες ⸀ἐπυνθάνοντο",
          {
            "noteId": 350
          },
          "εἰ Σίμων ὁ ἐπικαλούμενος Πέτρος ἐνθάδε ξενίζεται."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "τοῦ δὲ Πέτρου διενθυμουμένου περὶ τοῦ ὁράματος εἶπεν ⸂αὐτῷ τὸ πνεῦμα",
          {
            "noteId": 351
          },
          "· Ἰδοὺ ⸀ἄνδρες",
          {
            "noteId": 352
          },
          "⸀ζητοῦντές",
          {
            "noteId": 353
          },
          "σε·"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἀλλὰ ἀναστὰς κατάβηθι καὶ πορεύου σὺν αὐτοῖς μηδὲν διακρινόμενος, ⸀ὅτι",
          {
            "noteId": 354
          },
          "ἐγὼ ἀπέσταλκα αὐτούς."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "καταβὰς δὲ Πέτρος πρὸς τοὺς ἄνδρας εἶπεν· Ἰδοὺ ἐγώ εἰμι ὃν ζητεῖτε· τίς ἡ αἰτία διʼ ἣν πάρεστε;"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "οἱ δὲ εἶπαν· Κορνήλιος ἑκατοντάρχης, ἀνὴρ δίκαιος καὶ φοβούμενος τὸν θεὸν μαρτυρούμενός τε ὑπὸ ὅλου τοῦ ἔθνους τῶν Ἰουδαίων, ἐχρηματίσθη ὑπὸ ἀγγέλου ἁγίου μεταπέμψασθαί σε εἰς τὸν οἶκον αὐτοῦ καὶ ἀκοῦσαι ῥήματα παρὰ σοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "εἰσκαλεσάμενος οὖν αὐτοὺς ἐξένισεν.",
          {
            "noteId": 355
          },
          "Τῇ δὲ ἐπαύριον ⸀ἀναστὰς ἐξῆλθεν σὺν αὐτοῖς, καί τινες τῶν ἀδελφῶν τῶν ἀπὸ Ἰόππης συνῆλθον αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "⸂τῇ δὲ",
          {
            "noteId": 356
          },
          "ἐπαύριον ⸀εἰσῆλθεν",
          {
            "noteId": 357
          },
          "εἰς τὴν Καισάρειαν. ὁ δὲ Κορνήλιος ἦν προσδοκῶν αὐτοὺς συγκαλεσάμενος τοὺς συγγενεῖς αὐτοῦ καὶ τοὺς ἀναγκαίους φίλους."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ὡς δὲ ἐγένετο τοῦ εἰσελθεῖν τὸν Πέτρον, συναντήσας αὐτῷ ὁ Κορνήλιος πεσὼν ἐπὶ τοὺς πόδας προσεκύνησεν."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ὁ δὲ Πέτρος ⸂ἤγειρεν αὐτὸν",
          {
            "noteId": 358
          },
          "λέγων· Ἀνάστηθι· καὶ ἐγὼ αὐτὸς ἄνθρωπός εἰμι."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "καὶ συνομιλῶν αὐτῷ εἰσῆλθεν, καὶ εὑρίσκει συνεληλυθότας πολλούς,"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ἔφη τε πρὸς αὐτούς· Ὑμεῖς ἐπίστασθε ὡς ἀθέμιτόν ἐστιν ἀνδρὶ Ἰουδαίῳ κολλᾶσθαι ἢ προσέρχεσθαι ἀλλοφύλῳ· κἀμοὶ ὁ θεὸς ἔδειξεν μηδένα κοινὸν ἢ ἀκάθαρτον λέγειν ἄνθρωπον·"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "διὸ καὶ ἀναντιρρήτως ἦλθον μεταπεμφθείς. πυνθάνομαι οὖν τίνι λόγῳ μετεπέμψασθέ με."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Καὶ ὁ Κορνήλιος ἔφη· Ἀπὸ τετάρτης ἡμέρας μέχρι ταύτης τῆς ὥρας ⸀ἤμην",
          {
            "noteId": 359
          },
          "τὴν ⸀ἐνάτην",
          {
            "noteId": 360
          },
          "προσευχόμενος ἐν τῷ οἴκῳ μου, καὶ ἰδοὺ ἀνὴρ ἔστη ἐνώπιόν μου ἐν ἐσθῆτι λαμπρᾷ"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "καὶ φησί· Κορνήλιε, εἰσηκούσθη σου ἡ προσευχὴ καὶ αἱ ἐλεημοσύναι σου ἐμνήσθησαν ἐνώπιον τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "πέμψον οὖν εἰς Ἰόππην καὶ μετακάλεσαι Σίμωνα ὃς ἐπικαλεῖται Πέτρος· οὗτος ξενίζεται ἐν οἰκίᾳ Σίμωνος βυρσέως παρὰ ⸀θάλασσαν",
          {
            "noteId": 361
          }
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "ἐξαυτῆς οὖν ἔπεμψα πρὸς σέ, σύ τε καλῶς ἐποίησας παραγενόμενος. νῦν οὖν πάντες ἡμεῖς ἐνώπιον τοῦ θεοῦ πάρεσμεν ἀκοῦσαι πάντα τὰ προστεταγμένα σοι ὑπὸ τοῦ ⸀κυρίου",
          {
            "noteId": 362
          }
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "Ἀνοίξας δὲ Πέτρος τὸ στόμα εἶπεν· Ἐπʼ ἀληθείας καταλαμβάνομαι ὅτι οὐκ ἔστιν προσωπολήμπτης ὁ θεός,"
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "ἀλλʼ ἐν παντὶ ἔθνει ὁ φοβούμενος αὐτὸν καὶ ἐργαζόμενος δικαιοσύνην δεκτὸς αὐτῷ ἐστιν."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "τὸν λόγον ⸀ὃν",
          {
            "noteId": 363
          },
          "ἀπέστειλεν τοῖς υἱοῖς Ἰσραὴλ εὐαγγελιζόμενος εἰρήνην διὰ Ἰησοῦ Χριστοῦ· οὗτός ἐστιν πάντων κύριος."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "ὑμεῖς οἴδατε τὸ γενόμενον ῥῆμα καθʼ ὅλης τῆς Ἰουδαίας, ⸀ἀρξάμενος",
          {
            "noteId": 364
          },
          "ἀπὸ τῆς Γαλιλαίας μετὰ τὸ βάπτισμα ὃ ἐκήρυξεν Ἰωάννης,"
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "Ἰησοῦν τὸν ἀπὸ Ναζαρέθ, ὡς ἔχρισεν αὐτὸν ὁ θεὸς πνεύματι ἁγίῳ καὶ δυνάμει, ὃς διῆλθεν εὐεργετῶν καὶ ἰώμενος πάντας τοὺς καταδυναστευομένους ὑπὸ τοῦ διαβόλου, ὅτι ὁ θεὸς ἦν μετʼ αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "καὶ ⸀ἡμεῖς",
          {
            "noteId": 365
          },
          "μάρτυρες πάντων ὧν ἐποίησεν ἔν τε τῇ χώρᾳ τῶν Ἰουδαίων ⸀καὶ",
          {
            "noteId": 366
          },
          "Ἰερουσαλήμ· ὃν καὶ ἀνεῖλαν κρεμάσαντες ἐπὶ ξύλου."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "τοῦτον ὁ θεὸς ἤγειρεν ⸀τῇ",
          {
            "noteId": 367
          },
          "τρίτῃ ἡμέρᾳ καὶ ἔδωκεν αὐτὸν ἐμφανῆ γενέσθαι,"
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "οὐ παντὶ τῷ λαῷ ἀλλὰ μάρτυσι τοῖς προκεχειροτονημένοις ὑπὸ τοῦ θεοῦ, ἡμῖν, οἵτινες συνεφάγομεν καὶ συνεπίομεν αὐτῷ μετὰ τὸ ἀναστῆναι αὐτὸν ἐκ νεκρῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "καὶ παρήγγειλεν ἡμῖν κηρύξαι τῷ λαῷ καὶ διαμαρτύρασθαι ὅτι ⸀οὗτός",
          {
            "noteId": 368
          },
          "ἐστιν ὁ ὡρισμένος ὑπὸ τοῦ θεοῦ κριτὴς ζώντων καὶ νεκρῶν."
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "τούτῳ πάντες οἱ προφῆται μαρτυροῦσιν, ἄφεσιν ἁμαρτιῶν λαβεῖν διὰ τοῦ ὀνόματος αὐτοῦ πάντα τὸν πιστεύοντα εἰς αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "Ἔτι λαλοῦντος τοῦ Πέτρου τὰ ῥήματα ταῦτα ἐπέπεσε τὸ πνεῦμα τὸ ἅγιον ἐπὶ πάντας τοὺς ἀκούοντας τὸν λόγον."
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "καὶ ἐξέστησαν οἱ ἐκ περιτομῆς πιστοὶ ⸀ὅσοι",
          {
            "noteId": 369
          },
          "συνῆλθαν τῷ Πέτρῳ, ὅτι καὶ ἐπὶ τὰ ἔθνη ἡ δωρεὰ τοῦ ⸂ἁγίου πνεύματος",
          {
            "noteId": 370
          },
          "ἐκκέχυται·"
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "ἤκουον γὰρ αὐτῶν λαλούντων γλώσσαις καὶ μεγαλυνόντων τὸν θεόν. τότε ⸀ἀπεκρίθη",
          {
            "noteId": 371
          },
          "Πέτρος·"
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          "Μήτι τὸ ὕδωρ ⸂δύναται κωλῦσαί",
          {
            "noteId": 372
          },
          "τις τοῦ μὴ βαπτισθῆναι τούτους οἵτινες τὸ πνεῦμα τὸ ἅγιον ἔλαβον ⸀ὡς",
          {
            "noteId": 373
          },
          "καὶ ἡμεῖς;"
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          "προσέταξεν ⸀δὲ",
          {
            "noteId": 374
          },
          "αὐτοὺς ⸂ἐν τῷ ὀνόματι Ἰησοῦ Χριστοῦ βαπτισθῆναι",
          {
            "noteId": 375
          },
          ". τότε ἠρώτησαν αὐτὸν ἐπιμεῖναι ἡμέρας τινάς."
        ]
      }
    ],
