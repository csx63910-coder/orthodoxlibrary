  },
  "chapter": {
    "number": 13,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἦσαν ⸀δὲ",
          {
            "noteId": 434
          },
          "ἐν Ἀντιοχείᾳ κατὰ τὴν οὖσαν ἐκκλησίαν προφῆται καὶ διδάσκαλοι ὅ τε Βαρναβᾶς καὶ Συμεὼν ὁ καλούμενος Νίγερ, καὶ Λούκιος ὁ Κυρηναῖος, Μαναήν τε Ἡρῴδου τοῦ τετραάρχου σύντροφος καὶ Σαῦλος."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "λειτουργούντων δὲ αὐτῶν τῷ κυρίῳ καὶ",
          {
            "noteId": 435
          },
          "νηστευόντων εἶπεν τὸ πνεῦμα τὸ ἅγιον· Ἀφορίσατε δή μοι τὸν Βαρναβᾶν ⸀καὶ Σαῦλον εἰς τὸ ἔργον ὃ προσκέκλημαι αὐτούς."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "τότε νηστεύσαντες καὶ προσευξάμενοι καὶ ἐπιθέντες τὰς χεῖρας αὐτοῖς ἀπέλυσαν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "⸀Αὐτοὶ",
          {
            "noteId": 436
          },
          "μὲν οὖν ἐκπεμφθέντες ὑπὸ τοῦ ⸂ἁγίου πνεύματος",
          {
            "noteId": 437
          },
          "κατῆλθον ⸀εἰς",
          {
            "noteId": 438
          },
          "Σελεύκειαν, ἐκεῖθέν ⸀τε",
          {
            "noteId": 439
          },
          "ἀπέπλευσαν ⸁εἰς",
          {
            "noteId": 440
          },
          "Κύπρον,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ γενόμενοι ἐν Σαλαμῖνι κατήγγελλον τὸν λόγον τοῦ θεοῦ ἐν ταῖς συναγωγαῖς τῶν Ἰουδαίων· εἶχον δὲ καὶ Ἰωάννην ὑπηρέτην."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "διελθόντες δὲ ⸀ὅλην",
          {
            "noteId": 441
          },
          "τὴν νῆσον ἄχρι Πάφου εὗρον ⸀ἄνδρα",
          {
            "noteId": 442
          },
          "τινὰ μάγον ψευδοπροφήτην Ἰουδαῖον ᾧ ὄνομα ⸀Βαριησοῦ",
          {
            "noteId": 443
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ὃς ἦν σὺν τῷ ἀνθυπάτῳ Σεργίῳ Παύλῳ, ἀνδρὶ συνετῷ. οὗτος προσκαλεσάμενος Βαρναβᾶν καὶ Σαῦλον ἐπεζήτησεν ἀκοῦσαι τὸν λόγον τοῦ θεοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἀνθίστατο δὲ αὐτοῖς Ἐλύμας ὁ μάγος, οὕτως γὰρ μεθερμηνεύεται τὸ ὄνομα αὐτοῦ, ζητῶν διαστρέψαι τὸν ἀνθύπατον ἀπὸ τῆς πίστεως."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Σαῦλος δέ, ὁ καὶ Παῦλος, πλησθεὶς πνεύματος ⸀ἁγίου",
          {
            "noteId": 444
          },
          "ἀτενίσας εἰς αὐτὸν"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "εἶπεν· Ὦ πλήρης παντὸς δόλου καὶ πάσης ῥᾳδιουργίας, υἱὲ διαβόλου, ἐχθρὲ πάσης δικαιοσύνης, οὐ παύσῃ διαστρέφων τὰς ⸀ὁδοὺς",
          {
            "noteId": 445
          },
          "κυρίου τὰς εὐθείας;"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ νῦν ἰδοὺ χεὶρ κυρίου ἐπὶ σέ, καὶ ἔσῃ τυφλὸς μὴ βλέπων τὸν ἥλιον ἄχρι καιροῦ. παραχρῆμα ⸀δὲ",
          {
            "noteId": 446
          },
          "⸀ἔπεσεν",
          {
            "noteId": 447
          },
          "ἐπʼ αὐτὸν ἀχλὺς καὶ σκότος, καὶ περιάγων ἐζήτει χειραγωγούς."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "τότε ἰδὼν ὁ ἀνθύπατος τὸ γεγονὸς ἐπίστευσεν ἐκπλησσόμενος ἐπὶ τῇ διδαχῇ τοῦ κυρίου."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ἀναχθέντες δὲ ἀπὸ τῆς Πάφου οἱ ⸀περὶ",
          {
            "noteId": 448
          },
          "Παῦλον ἦλθον εἰς Πέργην τῆς Παμφυλίας· Ἰωάννης δὲ ἀποχωρήσας ἀπʼ αὐτῶν ὑπέστρεψεν εἰς Ἱεροσόλυμα."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "αὐτοὶ δὲ διελθόντες ἀπὸ τῆς Πέργης παρεγένοντο εἰς Ἀντιόχειαν ⸂τὴν Πισιδίαν",
          {
            "noteId": 449
          },
          ", καὶ ⸀εἰσελθόντες",
          {
            "noteId": 450
          },
          "εἰς τὴν συναγωγὴν τῇ ἡμέρᾳ τῶν σαββάτων ἐκάθισαν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "μετὰ δὲ τὴν ἀνάγνωσιν τοῦ νόμου καὶ τῶν προφητῶν ἀπέστειλαν οἱ ἀρχισυνάγωγοι πρὸς αὐτοὺς λέγοντες· Ἄνδρες ἀδελφοί, εἴ ⸀τίς",
          {
            "noteId": 451
          },
          "ἐστιν ⸂ἐν ὑμῖν λόγος",
          {
            "noteId": 452
          },
          "παρακλήσεως πρὸς τὸν λαόν, λέγετε."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ἀναστὰς δὲ Παῦλος καὶ κατασείσας τῇ χειρὶ εἶπεν· Ἄνδρες Ἰσραηλῖται καὶ οἱ φοβούμενοι τὸν θεόν, ἀκούσατε."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ὁ θεὸς τοῦ λαοῦ τούτου ⸀Ἰσραὴλ",
          {
            "noteId": 453
          },
          "ἐξελέξατο τοὺς πατέρας ἡμῶν, καὶ τὸν λαὸν ὕψωσεν ἐν τῇ παροικίᾳ ἐν γῇ ⸀Αἰγύπτου",
          {
            "noteId": 454
          },
          "καὶ μετὰ βραχίονος ὑψηλοῦ ἐξήγαγεν αὐτοὺς ἐξ αὐτῆς,"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καί, ὡς τεσσερακονταετῆ χρόνον ἐτροποφόρησεν αὐτοὺς ἐν τῇ ἐρήμῳ,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "⸀καὶ",
          {
            "noteId": 455
          },
          "καθελὼν ἔθνη ἑπτὰ ἐν γῇ Χανάαν ⸀κατεκληρονόμησεν",
          {
            "noteId": 456
          },
          "τὴν γῆν αὐτῶν"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "⸂ὡς ἔτεσι τετρακοσίοις καὶ πεντήκοντα. καὶ μετὰ ταῦτα⸃ ἔδωκεν κριτὰς ἕως Σαμουὴλ ⸀τοῦ προφήτου.",
          {
            "noteId": 457
          },
          {
            "noteId": 458
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "κἀκεῖθεν ᾐτήσαντο βασιλέα, καὶ ἔδωκεν αὐτοῖς ὁ θεὸς τὸν Σαοὺλ υἱὸν Κίς, ἄνδρα ἐκ φυλῆς Βενιαμίν, ἔτη τεσσεράκοντα·"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "καὶ μεταστήσας αὐτὸν ἤγειρεν ⸂τὸν Δαυὶδ αὐτοῖς",
          {
            "noteId": 459
          },
          "εἰς βασιλέα, ᾧ καὶ εἶπεν μαρτυρήσας· Εὗρον Δαυὶδ τὸν τοῦ Ἰεσσαί, ἄνδρα κατὰ τὴν καρδίαν μου, ὃς ποιήσει πάντα τὰ θελήματά μου."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "τούτου ὁ θεὸς ἀπὸ τοῦ σπέρματος κατʼ ἐπαγγελίαν ἤγαγεν τῷ Ἰσραὴλ ⸂σωτῆρα Ἰησοῦν",
          {
            "noteId": 460
          },
          ","
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "προκηρύξαντος Ἰωάννου πρὸ προσώπου τῆς εἰσόδου αὐτοῦ βάπτισμα μετανοίας ⸂παντὶ τῷ λαῷ",
          {
            "noteId": 461
          },
          "Ἰσραήλ."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ὡς δὲ ἐπλήρου ⸀Ἰωάννης",
          {
            "noteId": 462
          },
          "τὸν δρόμον, ἔλεγεν· ⸂Τί ἐμὲ",
          {
            "noteId": 463
          },
          "ὑπονοεῖτε εἶναι; οὐκ εἰμὶ ἐγώ· ἀλλʼ ἰδοὺ ἔρχεται μετʼ ἐμὲ οὗ οὐκ εἰμὶ ἄξιος τὸ ὑπόδημα τῶν ποδῶν λῦσαι."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Ἄνδρες ἀδελφοί, υἱοὶ γένους Ἀβραὰμ καὶ οἱ ἐν ὑμῖν φοβούμενοι τὸν θεόν, ⸀ἡμῖν",
          {
            "noteId": 464
          },
          "ὁ λόγος τῆς σωτηρίας ταύτης ⸀ἐξαπεστάλη",
          {
            "noteId": 465
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "οἱ γὰρ κατοικοῦντες ἐν Ἰερουσαλὴμ καὶ οἱ ἄρχοντες αὐτῶν τοῦτον ἀγνοήσαντες καὶ τὰς φωνὰς τῶν προφητῶν τὰς κατὰ πᾶν σάββατον ἀναγινωσκομένας κρίναντες ἐπλήρωσαν,"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "καὶ μηδεμίαν αἰτίαν θανάτου εὑρόντες ᾐτήσαντο Πιλᾶτον ἀναιρεθῆναι αὐτόν·"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "ὡς δὲ ἐτέλεσαν πάντα τὰ περὶ αὐτοῦ γεγραμμένα, καθελόντες ἀπὸ τοῦ ξύλου ἔθηκαν εἰς μνημεῖον."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ὁ δὲ θεὸς ἤγειρεν αὐτὸν ἐκ νεκρῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "ὃς ὤφθη ἐπὶ ἡμέρας πλείους τοῖς συναναβᾶσιν αὐτῷ ἀπὸ τῆς Γαλιλαίας εἰς Ἰερουσαλήμ, οἵτινες ⸀νῦν",
          {
            "noteId": 466
          },
          "εἰσὶ μάρτυρες αὐτοῦ πρὸς τὸν λαόν."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "καὶ ἡμεῖς ὑμᾶς εὐαγγελιζόμεθα τὴν πρὸς τοὺς πατέρας ἐπαγγελίαν γενομένην"
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "ὅτι ταύτην ὁ θεὸς ἐκπεπλήρωκεν τοῖς τέκνοις ⸀ἡμῶν",
          {
            "noteId": 467
          },
          "ἀναστήσας Ἰησοῦν, ὡς καὶ ἐν τῷ ⸂ψαλμῷ γέγραπται τῷ δευτέρῳ",
          {
            "noteId": 468
          },
          "· Υἱός μου εἶ σύ, ἐγὼ σήμερον γεγέννηκά σε."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "ὅτι δὲ ἀνέστησεν αὐτὸν ἐκ νεκρῶν μηκέτι μέλλοντα ὑποστρέφειν εἰς διαφθοράν, οὕτως εἴρηκεν ὅτι Δώσω ὑμῖν τὰ ὅσια Δαυὶδ τὰ πιστά."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "⸀διότι",
          {
            "noteId": 469
          },
          "καὶ ἐν ἑτέρῳ λέγει· Οὐ δώσεις τὸν ὅσιόν σου ἰδεῖν διαφθοράν·"
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "Δαυὶδ μὲν γὰρ ἰδίᾳ γενεᾷ ὑπηρετήσας τῇ τοῦ θεοῦ βουλῇ ἐκοιμήθη καὶ προσετέθη πρὸς τοὺς πατέρας αὐτοῦ καὶ εἶδεν διαφθοράν,"
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "ὃν δὲ ὁ θεὸς ἤγειρεν οὐκ εἶδεν διαφθοράν."
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "γνωστὸν οὖν ἔστω ὑμῖν, ἄνδρες ἀδελφοί, ὅτι διὰ τούτου ὑμῖν ἄφεσις ἁμαρτιῶν καταγγέλλεται, καὶ ἀπὸ πάντων ὧν οὐκ ἠδυνήθητε ⸀ἐν",
          {
            "noteId": 470
          },
          "νόμῳ Μωϋσέως δικαιωθῆναι"
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "ἐν τούτῳ πᾶς ὁ πιστεύων δικαιοῦται."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "βλέπετε οὖν μὴ ⸀ἐπέλθῃ",
          {
            "noteId": 471
          },
          "τὸ εἰρημένον ἐν τοῖς προφήταις·"
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "Ἴδετε, οἱ καταφρονηταί, καὶ θαυμάσατε καὶ ἀφανίσθητε, ὅτι ἔργον ⸂ἐργάζομαι ἐγὼ",
          {
            "noteId": 472
          },
          "ἐν ταῖς ἡμέραις ὑμῶν, ⸀ἔργον",
          {
            "noteId": 473
          },
          "ὃ οὐ μὴ πιστεύσητε ἐάν τις ἐκδιηγῆται ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "Ἐξιόντων δὲ ⸀αὐτῶν",
          {
            "noteId": 474
          },
          "⸀παρεκάλουν",
          {
            "noteId": 475
          },
          "εἰς τὸ μεταξὺ σάββατον λαληθῆναι αὐτοῖς τὰ ῥήματα ⸀ταῦτα",
          {
            "noteId": 476
          }
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "λυθείσης δὲ τῆς συναγωγῆς ἠκολούθησαν πολλοὶ τῶν Ἰουδαίων καὶ τῶν σεβομένων προσηλύτων τῷ Παύλῳ καὶ τῷ Βαρναβᾷ, οἵτινες προσλαλοῦντες ⸀αὐτοῖς",
          {
            "noteId": 477
          },
          "ἔπειθον αὐτοὺς ⸀προσμένειν",
          {
            "noteId": 478
          },
          "τῇ χάριτι τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "Τῷ ⸀δὲ",
          {
            "noteId": 479
          },
          "ἐρχομένῳ σαββάτῳ σχεδὸν πᾶσα ἡ πόλις συνήχθη ἀκοῦσαι τὸν λόγον τοῦ ⸀κυρίου",
          {
            "noteId": 480
          }
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "ἰδόντες δὲ οἱ Ἰουδαῖοι τοὺς ὄχλους ἐπλήσθησαν ζήλου καὶ ἀντέλεγον τοῖς ⸀ὑπὸ",
          {
            "noteId": 481
          },
          "Παύλου ⸀λαλουμένοις",
          {
            "noteId": 482
          },
          "⸀βλασφημοῦντες",
          {
            "noteId": 483
          }
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "παρρησιασάμενοί ⸀τε",
          {
            "noteId": 484
          },
          "ὁ Παῦλος καὶ ὁ Βαρναβᾶς εἶπαν· Ὑμῖν ἦν ἀναγκαῖον πρῶτον λαληθῆναι τὸν λόγον τοῦ θεοῦ· ⸀ἐπειδὴ",
          {
            "noteId": 485
          },
          "ἀπωθεῖσθε αὐτὸν καὶ οὐκ ἀξίους κρίνετε ἑαυτοὺς τῆς αἰωνίου ζωῆς, ἰδοὺ στρεφόμεθα εἰς τὰ ἔθνη·"
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          "οὕτως γὰρ ἐντέταλται ἡμῖν ὁ κύριος· Τέθεικά σε εἰς φῶς ἐθνῶν τοῦ εἶναί σε εἰς σωτηρίαν ἕως ἐσχάτου τῆς γῆς."
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          "ἀκούοντα δὲ τὰ ἔθνη ⸀ἔχαιρον",
          {
            "noteId": 486
          },
          "καὶ ἐδόξαζον τὸν λόγον τοῦ ⸀κυρίου",
          {
            "noteId": 487
          },
          "καὶ ἐπίστευσαν ὅσοι ἦσαν τεταγμένοι εἰς ζωὴν αἰώνιον·"
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          "διεφέρετο δὲ ὁ λόγος τοῦ κυρίου διʼ ὅλης τῆς χώρας."
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          "οἱ δὲ Ἰουδαῖοι παρώτρυναν τὰς σεβομένας ⸀γυναῖκας",
          {
            "noteId": 488
          },
          "τὰς εὐσχήμονας καὶ",
          {
            "noteId": 489
          },
