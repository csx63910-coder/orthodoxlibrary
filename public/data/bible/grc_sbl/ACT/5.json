  "chapter": {
    "number": 5,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἀνὴρ δέ τις Ἁνανίας ὀνόματι σὺν Σαπφίρῃ τῇ γυναικὶ αὐτοῦ ἐπώλησεν κτῆμα"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ ἐνοσφίσατο ἀπὸ τῆς τιμῆς, συνειδυίης καὶ τῆς ⸀γυναικός",
          {
            "noteId": 143
          },
          "καὶ ἐνέγκας μέρος τι παρὰ τοὺς πόδας τῶν ἀποστόλων ἔθηκεν."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "εἶπεν δὲ ⸀ὁ",
          {
            "noteId": 144
          },
          "Πέτρος· Ἁνανία, διὰ τί ἐπλήρωσεν ὁ Σατανᾶς τὴν καρδίαν σου, ψεύσασθαί σε τὸ πνεῦμα τὸ ἅγιον καὶ ⸀νοσφίσασθαι",
          {
            "noteId": 145
          },
          "ἀπὸ τῆς τιμῆς τοῦ χωρίου;"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "οὐχὶ μένον σοὶ ἔμενεν καὶ πραθὲν ἐν τῇ σῇ ἐξουσίᾳ ὑπῆρχεν; τί ὅτι ἔθου ἐν τῇ καρδίᾳ σου τὸ πρᾶγμα τοῦτο; οὐκ ἐψεύσω ἀνθρώποις ἀλλὰ τῷ θεῷ."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἀκούων δὲ ὁ Ἁνανίας τοὺς λόγους τούτους πεσὼν ἐξέψυξεν· καὶ ἐγένετο φόβος μέγας ἐπὶ πάντας τοὺς ⸀ἀκούοντας",
          {
            "noteId": 146
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἀναστάντες δὲ οἱ νεώτεροι συνέστειλαν αὐτὸν καὶ ἐξενέγκαντες ἔθαψαν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ἐγένετο δὲ ὡς ὡρῶν τριῶν διάστημα καὶ ἡ γυνὴ αὐτοῦ μὴ εἰδυῖα τὸ γεγονὸς εἰσῆλθεν."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἀπεκρίθη δὲ ⸂πρὸς αὐτὴν",
          {
            "noteId": 147
          },
          "⸀Πέτρος",
          {
            "noteId": 148
          },
          "Εἰπέ μοι, εἰ τοσούτου τὸ χωρίον ἀπέδοσθε; ἡ δὲ εἶπεν· Ναί, τοσούτου."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ὁ δὲ ⸀Πέτρος",
          {
            "noteId": 149
          },
          "πρὸς αὐτήν· Τί ὅτι συνεφωνήθη ὑμῖν πειράσαι τὸ πνεῦμα κυρίου; ἰδοὺ οἱ πόδες τῶν θαψάντων τὸν ἄνδρα σου ἐπὶ τῇ θύρᾳ καὶ ἐξοίσουσίν σε."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ἔπεσεν δὲ παραχρῆμα ⸀πρὸς",
          {
            "noteId": 150
          },
          "τοὺς πόδας αὐτοῦ καὶ ἐξέψυξεν· εἰσελθόντες δὲ οἱ νεανίσκοι εὗρον αὐτὴν νεκράν, καὶ ἐξενέγκαντες ἔθαψαν πρὸς τὸν ἄνδρα αὐτῆς."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ ἐγένετο φόβος μέγας ἐφʼ ὅλην τὴν ἐκκλησίαν καὶ ἐπὶ πάντας τοὺς ἀκούοντας ταῦτα."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Διὰ δὲ τῶν χειρῶν τῶν ἀποστόλων ἐγίνετο σημεῖα καὶ τέρατα ⸂πολλὰ ἐν τῷ λαῷ",
          {
            "noteId": 151
          },
          "· καὶ ἦσαν ὁμοθυμαδὸν ⸀ἅπαντες",
          {
            "noteId": 152
          },
          "ἐν τῇ Στοᾷ Σολομῶντος·"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "τῶν δὲ λοιπῶν οὐδεὶς ἐτόλμα κολλᾶσθαι αὐτοῖς, ἀλλʼ ἐμεγάλυνεν αὐτοὺς ὁ λαός,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "μᾶλλον δὲ προσετίθεντο πιστεύοντες τῷ κυρίῳ πλήθη ἀνδρῶν τε καὶ γυναικῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ὥστε ⸂καὶ εἰς",
          {
            "noteId": 153
          },
          "τὰς πλατείας ἐκφέρειν τοὺς ἀσθενεῖς καὶ τιθέναι ἐπὶ ⸀κλιναρίων",
          {
            "noteId": 154
          },
          "καὶ κραβάττων, ἵνα ἐρχομένου Πέτρου κἂν ἡ σκιὰ ⸀ἐπισκιάσῃ",
          {
            "noteId": 155
          },
          "τινὶ αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "συνήρχετο δὲ καὶ τὸ πλῆθος τῶν πέριξ ⸀πόλεων",
          {
            "noteId": 156
          },
          "Ἰερουσαλήμ, φέροντες ἀσθενεῖς καὶ ὀχλουμένους ὑπὸ πνευμάτων ἀκαθάρτων, οἵτινες ἐθεραπεύοντο ἅπαντες."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Ἀναστὰς δὲ ὁ ἀρχιερεὺς καὶ πάντες οἱ σὺν αὐτῷ, ἡ οὖσα αἵρεσις τῶν Σαδδουκαίων, ἐπλήσθησαν ζήλου"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ ἐπέβαλον τὰς ⸀χεῖρας",
          {
            "noteId": 157
          },
          "ἐπὶ τοὺς ἀποστόλους καὶ ἔθεντο αὐτοὺς ἐν τηρήσει δημοσίᾳ."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἄγγελος δὲ κυρίου ⸀διὰ",
          {
            "noteId": 158
          },
          "νυκτὸς ⸀ἤνοιξε",
          {
            "noteId": 159
          },
          "τὰς θύρας τῆς φυλακῆς ἐξαγαγών τε αὐτοὺς εἶπεν·"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Πορεύεσθε καὶ σταθέντες λαλεῖτε ἐν τῷ ἱερῷ τῷ λαῷ πάντα τὰ ῥήματα τῆς ζωῆς ταύτης."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ἀκούσαντες δὲ εἰσῆλθον ὑπὸ τὸν ὄρθρον εἰς τὸ ἱερὸν καὶ ἐδίδασκον. Παραγενόμενος δὲ ὁ ἀρχιερεὺς καὶ οἱ σὺν αὐτῷ συνεκάλεσαν τὸ συνέδριον καὶ πᾶσαν τὴν γερουσίαν τῶν υἱῶν Ἰσραήλ, καὶ ἀπέστειλαν εἰς τὸ δεσμωτήριον ἀχθῆναι αὐτούς."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "οἱ δὲ ⸂παραγενόμενοι ὑπηρέται",
          {
            "noteId": 160
          },
          "οὐχ εὗρον αὐτοὺς ἐν τῇ φυλακῇ, ἀναστρέψαντες δὲ ἀπήγγειλαν"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "λέγοντες ὅτι ⸀Τὸ",
          {
            "noteId": 161
          },
          "δεσμωτήριον εὕρομεν κεκλεισμένον ἐν πάσῃ ἀσφαλείᾳ καὶ τοὺς φύλακας ἑστῶτας ⸀ἐπὶ",
          {
            "noteId": 162
          },
          "τῶν θυρῶν, ἀνοίξαντες δὲ ἔσω οὐδένα εὕρομεν."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ὡς δὲ ἤκουσαν τοὺς λόγους τούτους ὅ ⸀τε",
          {
            "noteId": 163
          },
          "στρατηγὸς τοῦ ἱεροῦ καὶ οἱ ἀρχιερεῖς, διηπόρουν περὶ αὐτῶν τί ἂν γένοιτο τοῦτο."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "παραγενόμενος δέ τις ἀπήγγειλεν αὐτοῖς ὅτι Ἰδοὺ οἱ ἄνδρες οὓς ἔθεσθε ἐν τῇ φυλακῇ εἰσὶν ἐν τῷ ἱερῷ ἑστῶτες καὶ διδάσκοντες τὸν λαόν."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "τότε ἀπελθὼν ὁ στρατηγὸς σὺν τοῖς ὑπηρέταις ⸀ἤγαγεν",
          {
            "noteId": 164
          },
          "αὐτούς, οὐ μετὰ βίας, ἐφοβοῦντο γὰρ τὸν λαόν, ⸀μὴ",
          {
            "noteId": 165
          },
          "λιθασθῶσιν."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Ἀγαγόντες δὲ αὐτοὺς ἔστησαν ἐν τῷ συνεδρίῳ. καὶ ἐπηρώτησεν αὐτοὺς ὁ ἀρχιερεὺς"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "⸀λέγων",
          {
            "noteId": 166
          },
          "Παραγγελίᾳ παρηγγείλαμεν ὑμῖν μὴ διδάσκειν ἐπὶ τῷ ὀνόματι τούτῳ, καὶ ἰδοὺ πεπληρώκατε τὴν Ἰερουσαλὴμ τῆς διδαχῆς ὑμῶν, καὶ βούλεσθε ἐπαγαγεῖν ἐφʼ ἡμᾶς τὸ αἷμα τοῦ ἀνθρώπου τούτου."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "ἀποκριθεὶς δὲ Πέτρος καὶ οἱ ἀπόστολοι εἶπαν· Πειθαρχεῖν δεῖ θεῷ μᾶλλον ἢ ἀνθρώποις."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ὁ θεὸς τῶν πατέρων ἡμῶν ἤγειρεν Ἰησοῦν, ὃν ὑμεῖς διεχειρίσασθε κρεμάσαντες ἐπὶ ξύλου·"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "τοῦ",
          {
            "noteId": 167
          },
          "ον ὁ θεὸς ἀρχηγὸν καὶ σωτῆρα ὕψωσεν τῇ δεξιᾷ αὐτοῦ, ⸀τοῦ δοῦναι μετάνοιαν τῷ Ἰσραὴλ καὶ ἄφεσιν ἁμαρτιῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "καὶ ἡμεῖς ⸀ἐσμεν",
          {
            "noteId": 168
          },
          "μάρτυρες τῶν ῥημάτων τούτων, καὶ τὸ ⸀πνεῦμα",
          {
            "noteId": 169
          },
          "τὸ ἅγιον ὃ ἔδωκεν ὁ θεὸς τοῖς πειθαρχοῦσιν αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "Οἱ δὲ ⸀ἀκούσαντες",
          {
            "noteId": 170
          },
          "διεπρίοντο καὶ ἐβούλοντο ἀνελεῖν αὐτούς."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "ἀναστὰς δέ τις ἐν τῷ συνεδρίῳ Φαρισαῖος ὀνόματι Γαμαλιήλ, νομοδιδάσκαλος τίμιος παντὶ τῷ λαῷ, ἐκέλευσεν ἔξω ⸀βραχὺ",
          {
            "noteId": 171
          },
          "τοὺς ⸀ἀνθρώπους",
          {
            "noteId": 172
          },
          "ποιῆσαι,"
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "εἶπέν τε πρὸς αὐτούς· Ἄνδρες Ἰσραηλῖται, προσέχετε ἑαυτοῖς ἐπὶ τοῖς ἀνθρώποις τούτοις τί μέλλετε πράσσειν."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "πρὸ γὰρ τούτων τῶν ἡμερῶν ἀνέστη Θευδᾶς, λέγων εἶναί τινα ἑαυτόν, ᾧ ⸀προσεκλίθη",
          {
            "noteId": 173
          },
          "⸂ἀνδρῶν ἀριθμὸς ὡς",
          {
            "noteId": 174
          },
          "τετρακοσίων· ὃς ἀνῃρέθη, καὶ πάντες ὅσοι ἐπείθοντο αὐτῷ διελύθησαν καὶ ἐγένοντο εἰς οὐδέν."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "μετὰ τοῦτον ἀνέστη Ἰούδας ὁ Γαλιλαῖος ἐν ταῖς ἡμέραις τῆς ἀπογραφῆς καὶ ἀπέστησε ⸀λαὸν",
          {
            "noteId": 175
          },
          "ὀπίσω αὐτοῦ· κἀκεῖνος ἀπώλετο καὶ πάντες ὅσοι ἐπείθοντο αὐτῷ διεσκορπίσθησαν."
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "καὶ τὰ νῦν λέγω ὑμῖν, ἀπόστητε ἀπὸ τῶν ἀνθρώπων τούτων καὶ ⸀ἄφετε",
          {
            "noteId": 176
          },
          "αὐτούς· (ὅτι ἐὰν ᾖ ἐξ ἀνθρώπων ἡ βουλὴ ⸀αὕτη",
          {
            "noteId": 177
          },
          "ἢ τὸ ἔργον τοῦτο, καταλυθήσεται,"
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "εἰ δὲ ἐκ θεοῦ ἐστιν, οὐ ⸀δυνήσεσθε",
          {
            "noteId": 178
          },
          "καταλῦσαι ⸀αὐτούς",
          {
            "noteId": 179
          },
          ") μήποτε καὶ θεομάχοι εὑρεθῆτε. ἐπείσθησαν δὲ αὐτῷ,"
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "καὶ προσκαλεσάμενοι τοὺς ἀποστόλους δείραντες παρήγγειλαν μὴ λαλεῖν ἐπὶ τῷ ὀνόματι τοῦ Ἰησοῦ καὶ ⸀ἀπέλυσαν",
          {
            "noteId": 180
          }
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "οἱ μὲν οὖν ἐπορεύοντο χαίροντες ἀπὸ προσώπου τοῦ συνεδρίου ὅτι ⸂κατηξιώθησαν ὑπὲρ τοῦ ὀνόματος",
          {
            "noteId": 181
          },
          "ἀτιμασθῆναι·"
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "πᾶσάν τε ἡμέραν ἐν τῷ ἱερῷ καὶ κατʼ οἶκον οὐκ ἐπαύοντο διδάσκοντες καὶ εὐαγγελιζόμενοι ⸂τὸν χριστὸν Ἰησοῦν",
          {
            "noteId": 182
          },
          "."
        ]
      }
    ],
