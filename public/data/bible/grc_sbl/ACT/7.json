  },
  "chapter": {
    "number": 7,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Εἶπεν δὲ ὁ ἀρχιερεύς· ⸀Εἰ",
          {
            "noteId": 191
          },
          "ταῦτα οὕτως ἔχει;"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ὁ δὲ ἔφη· Ἄνδρες ἀδελφοὶ καὶ πατέρες, ἀκούσατε· Ὁ θεὸς τῆς δόξης ὤφθη τῷ πατρὶ ἡμῶν Ἀβραὰμ ὄντι ἐν τῇ Μεσοποταμίᾳ πρὶν ἢ κατοικῆσαι αὐτὸν ἐν Χαρράν,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ εἶπεν πρὸς αὐτόν· Ἔξελθε ἐκ",
          {
            "noteId": 192
          },
          "τῆς γῆς σου καὶ ⸀ἐκ τῆς συγγενείας σου, καὶ δεῦρο εἰς ⸀τὴν",
          {
            "noteId": 193
          },
          "γῆν ἣν ἄν σοι δείξω."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "τότε ἐξελθὼν ἐκ γῆς Χαλδαίων κατῴκησεν ἐν Χαρράν. κἀκεῖθεν μετὰ τὸ ἀποθανεῖν τὸν πατέρα αὐτοῦ μετῴκισεν αὐτὸν εἰς τὴν γῆν ταύτην εἰς ἣν ὑμεῖς νῦν κατοικεῖτε,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "καὶ οὐκ ἔδωκεν αὐτῷ κληρονομίαν ἐν αὐτῇ οὐδὲ βῆμα ποδός, καὶ ἐπηγγείλατο δοῦναι αὐτῷ εἰς κατάσχεσιν αὐτὴν καὶ τῷ σπέρματι αὐτοῦ μετʼ αὐτόν, οὐκ ὄντος αὐτῷ τέκνου."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἐλάλησεν ⸀δὲ",
          {
            "noteId": 194
          },
          "οὕτως ὁ θεὸς ὅτι ἔσται τὸ σπέρμα αὐτοῦ πάροικον ἐν γῇ ἀλλοτρίᾳ, καὶ δουλώσουσιν αὐτὸ καὶ κακώσουσιν ἔτη τετρακόσια·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "καὶ τὸ ἔθνος ᾧ ⸀ἐὰν",
          {
            "noteId": 195
          },
          "⸀δουλεύσουσιν",
          {
            "noteId": 196
          },
          "κρινῶ ἐγώ, ⸂ὁ θεὸς εἶπεν",
          {
            "noteId": 197
          },
          ", καὶ μετὰ ταῦτα ἐξελεύσονται καὶ λατρεύσουσίν μοι ἐν τῷ τόπῳ τούτῳ."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ ἔδωκεν αὐτῷ διαθήκην περιτομῆς· καὶ οὕτως ἐγέννησεν τὸν Ἰσαὰκ καὶ περιέτεμεν αὐτὸν τῇ ἡμέρᾳ τῇ ὀγδόῃ, ⸀καὶ",
          {
            "noteId": 198
          },
          "Ἰσαὰκ τὸν Ἰακώβ, ⸁καὶ",
          {
            "noteId": 199
          },
          "Ἰακὼβ τοὺς δώδεκα πατριάρχας."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Καὶ οἱ πατριάρχαι ζηλώσαντες τὸν Ἰωσὴφ ἀπέδοντο εἰς Αἴγυπτον· καὶ ἦν ὁ θεὸς μετʼ αὐτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ",
          {
            "noteId": 200
          },
          "ἐξείλατο αὐτὸν ἐκ πασῶν τῶν θλίψεων αὐτοῦ, καὶ ἔδωκεν αὐτῷ χάριν καὶ σοφίαν ἐναντίον Φαραὼ βασιλέως Αἰγύπτου, καὶ κατέστησεν αὐτὸν ἡγούμενον ἐπʼ Αἴγυπτον ⸀καὶ ὅλον τὸν οἶκον αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ἦλθεν δὲ λιμὸς ἐφʼ ὅλην τὴν ⸀Αἴγυπτον",
          {
            "noteId": 201
          },
          "καὶ Χανάαν καὶ θλῖψις μεγάλη, καὶ οὐχ ηὕρισκον χορτάσματα οἱ πατέρες ἡμῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ἀκούσας δὲ Ἰακὼβ ὄντα ⸂σιτία εἰς Αἴγυπτον",
          {
            "noteId": 202
          },
          "ἐξαπέστειλεν τοὺς πατέρας ἡμῶν πρῶτον·"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ ἐν τῷ δευτέρῳ ⸀ἀνεγνωρίσθη",
          {
            "noteId": 203
          },
          "Ἰωσὴφ τοῖς ἀδελφοῖς αὐτοῦ, καὶ φανερὸν ἐγένετο τῷ Φαραὼ τὸ ⸀γένος",
          {
            "noteId": 204
          },
          "Ἰωσήφ."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἀποστείλας δὲ Ἰωσὴφ μετεκαλέσατο ⸂Ἰακὼβ τὸν πατέρα αὐτοῦ",
          {
            "noteId": 205
          },
          "καὶ πᾶσαν τὴν συγγένειαν ἐν ψυχαῖς ἑβδομήκοντα πέντε,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "⸂καὶ κατέβη",
          {
            "noteId": 206
          },
          "Ἰακὼβ εἰς Αἴγυπτον. καὶ ἐτελεύτησεν αὐτὸς καὶ οἱ πατέρες ἡμῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ μετετέθησαν εἰς Συχὲμ καὶ ἐτέθησαν ἐν τῷ μνήματι ⸀ᾧ",
          {
            "noteId": 207
          },
          "ὠνήσατο Ἀβραὰμ τιμῆς ἀργυρίου παρὰ τῶν υἱῶν Ἑμμὼρ ⸀ἐν",
          {
            "noteId": 208
          },
          "Συχέμ."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Καθὼς δὲ ἤγγιζεν ὁ χρόνος τῆς ἐπαγγελίας ἧς ⸀ὡμολόγησεν",
          {
            "noteId": 209
          },
          "ὁ θεὸς τῷ Ἀβραάμ, ηὔξησεν ὁ λαὸς καὶ ἐπληθύνθη ἐν Αἰγύπτῳ,"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ἄχρι οὗ ἀνέστη βασιλεὺς ἕτερος ⸂ἐπʼ Αἴγυπτον",
          {
            "noteId": 210
          },
          ", ὃς οὐκ ᾔδει τὸν Ἰωσήφ."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "οὗτος κατασοφισάμενος τὸ γένος ἡμῶν ἐκάκωσεν τοὺς ⸀πατέρας",
          {
            "noteId": 211
          },
          "τοῦ ποιεῖν ⸂τὰ βρέφη ἔκθετα",
          {
            "noteId": 212
          },
          "αὐτῶν εἰς τὸ μὴ ζῳογονεῖσθαι."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἐν ᾧ καιρῷ ἐγεννήθη Μωϋσῆς, καὶ ἦν ἀστεῖος τῷ θεῷ· ὃς ἀνετράφη μῆνας τρεῖς ἐν τῷ οἴκῳ τοῦ πατρός·"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "⸂ἐκτεθέντος δὲ αὐτοῦ ἀνείλατο αὐτὸν",
          {
            "noteId": 213
          },
          "ἡ θυγάτηρ Φαραὼ καὶ ἀνεθρέψατο αὐτὸν ἑαυτῇ εἰς υἱόν."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "καὶ ἐπαιδεύθη ⸀Μωϋσῆς",
          {
            "noteId": 214
          },
          "πάσῃ σοφίᾳ Αἰγυπτίων, ἦν δὲ δυνατὸς ἐν λόγοις καὶ ἔργοις ⸀αὐτοῦ",
          {
            "noteId": 215
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Ὡς δὲ ἐπληροῦτο αὐτῷ τεσσερακονταετὴς χρόνος, ἀνέβη ἐπὶ τὴν καρδίαν αὐτοῦ ἐπισκέψασθαι τοὺς ἀδελφοὺς αὐτοῦ τοὺς υἱοὺς Ἰσραήλ."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "καὶ ἰδών τινα ἀδικούμενον ἠμύνατο καὶ ἐποίησεν ἐκδίκησιν τῷ καταπονουμένῳ πατάξας τὸν Αἰγύπτιον."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ἐνόμιζεν δὲ συνιέναι τοὺς ⸀ἀδελφοὺς",
          {
            "noteId": 216
          },
          "ὅτι ὁ θεὸς διὰ χειρὸς αὐτοῦ δίδωσιν ⸂σωτηρίαν αὐτοῖς",
          {
            "noteId": 217
          },
          ", οἱ δὲ οὐ συνῆκαν."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "τῇ τε ἐπιούσῃ ἡμέρᾳ ὤφθη αὐτοῖς μαχομένοις καὶ ⸀συνήλλασσεν",
          {
            "noteId": 218
          },
          "αὐτοὺς εἰς εἰρήνην εἰπών· Ἄνδρες, ἀδελφοί ⸀ἐστε",
          {
            "noteId": 219
          },
          "ἱνατί ἀδικεῖτε ἀλλήλους;"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "ὁ δὲ ἀδικῶν τὸν πλησίον ἀπώσατο αὐτὸν εἰπών· Τίς σε κατέστησεν ἄρχοντα καὶ δικαστὴν ἐφʼ ⸀ἡμῶν",
          {
            "noteId": 220
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "μὴ ἀνελεῖν με σὺ θέλεις ὃν τρόπον ἀνεῖλες ⸀ἐχθὲς",
          {
            "noteId": 221
          },
          "τὸν Αἰγύπτιον;"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "ἔφυγεν δὲ Μωϋσῆς ἐν τῷ λόγῳ τούτῳ, καὶ ἐγένετο πάροικος ἐν γῇ Μαδιάμ, οὗ ἐγέννησεν υἱοὺς δύο."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Καὶ πληρωθέντων ἐτῶν τεσσεράκοντα ὤφθη αὐτῷ ἐν τῇ ἐρήμῳ τοῦ ὄρους Σινᾶ ⸀ἄγγελος",
          {
            "noteId": 222
          },
          "ἐν φλογὶ πυρὸς βάτου·"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "ὁ δὲ Μωϋσῆς ἰδὼν ⸀ἐθαύμασεν",
          {
            "noteId": 223
          },
          "τὸ ὅραμα. προσερχομένου δὲ αὐτοῦ κατανοῆσαι ἐγένετο φωνὴ ⸀κυρίου",
          {
            "noteId": 224
          }
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Ἐγὼ ὁ θεὸς τῶν πατέρων σου, ὁ θεὸς Ἀβραὰμ ⸀καὶ",
          {
            "noteId": 225
          },
          "Ἰσαὰκ ⸁καὶ",
          {
            "noteId": 226
          },
          "Ἰακώβ. ἔντρομος δὲ γενόμενος Μωϋσῆς οὐκ ἐτόλμα κατανοῆσαι."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "εἶπεν δὲ αὐτῷ ὁ κύριος· Λῦσον τὸ ὑπόδημα τῶν ποδῶν σου, ὁ γὰρ τόπος ⸀ἐφʼ",
          {
            "noteId": 227
          },
          "ᾧ ἕστηκας γῆ ἁγία ἐστίν."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "ἰδὼν εἶδον τὴν κάκωσιν τοῦ λαοῦ μου τοῦ ἐν Αἰγύπτῳ, καὶ τοῦ στεναγμοῦ ⸀αὐτοῦ",
          {
            "noteId": 228
          },
          "ἤκουσα, καὶ κατέβην ἐξελέσθαι αὐτούς· καὶ νῦν δεῦρο ⸀ἀποστείλω",
          {
            "noteId": 229
          },
          "σε εἰς Αἴγυπτον."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "Τοῦτον τὸν Μωϋσῆν, ὃν ἠρνήσαντο εἰπόντες· Τίς σε κατέστησεν ἄρχοντα καὶ",
          {
            "noteId": 230
          },
          "δικαστήν, τοῦτον ὁ θεὸς ⸀καὶ ἄρχοντα καὶ λυτρωτὴν ⸂ἀπέσταλκεν σὺν",
          {
            "noteId": 231
          },
          "χειρὶ ἀγγέλου τοῦ ὀφθέντος αὐτῷ ἐν τῇ βάτῳ."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "οὗτος ἐξήγαγεν αὐτοὺς ποιήσας τέρατα καὶ σημεῖα ἐν ⸀γῇ",
          {
            "noteId": 232
          },
          "Αἰγύπτῳ καὶ ἐν Ἐρυθρᾷ Θαλάσσῃ καὶ ἐν τῇ ἐρήμῳ ἔτη τεσσεράκοντα."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "οὗτός ἐστιν ὁ Μωϋσῆς ὁ ⸀εἴπας",
          {
            "noteId": 233
          },
          "τοῖς υἱοῖς Ἰσραήλ· Προφήτην ὑμῖν ἀναστήσει ⸂ὁ θεὸς",
          {
            "noteId": 234
          },
          "ἐκ τῶν ἀδελφῶν ὑμῶν ὡς ἐμέ."
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "οὗτός ἐστιν ὁ γενόμενος ἐν τῇ ἐκκλησίᾳ ἐν τῇ ἐρήμῳ μετὰ τοῦ ἀγγέλου τοῦ λαλοῦντος αὐτῷ ἐν τῷ ὄρει Σινᾶ καὶ τῶν πατέρων ἡμῶν, ὃς ἐδέξατο ⸀λόγια",
          {
            "noteId": 235
          },
          "ζῶντα δοῦναι ⸀ἡμῖν",
          {
            "noteId": 236
          }
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "ᾧ οὐκ ἠθέλησαν ὑπήκοοι γενέσθαι οἱ πατέρες ἡμῶν, ἀλλὰ ἀπώσαντο καὶ ἐστράφησαν ⸂ἐν ταῖς καρδίαις",
          {
            "noteId": 237
          },
          "αὐτῶν εἰς Αἴγυπτον,"
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "εἰπόντες τῷ Ἀαρών· Ποίησον ἡμῖν θεοὺς οἳ προπορεύσονται ἡμῶν· ὁ γὰρ Μωϋσῆς οὗτος, ὃς ἐξήγαγεν ἡμᾶς ἐκ γῆς Αἰγύπτου, οὐκ οἴδαμεν τί ⸀ἐγένετο",
          {
            "noteId": 238
          },
          "αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "καὶ ἐμοσχοποίησαν ἐν ταῖς ἡμέραις ἐκείναις καὶ ἀνήγαγον θυσίαν τῷ εἰδώλῳ, καὶ εὐφραίνοντο ἐν τοῖς ἔργοις τῶν χειρῶν αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "ἔστρεψεν δὲ ὁ θεὸς καὶ παρέδωκεν αὐτοὺς λατρεύειν τῇ στρατιᾷ τοῦ οὐρανοῦ, καθὼς γέγραπται ἐν βίβλῳ τῶν προφητῶν· Μὴ σφάγια καὶ θυσίας προσηνέγκατέ μοι ἔτη τεσσεράκοντα ἐν τῇ ἐρήμῳ, οἶκος Ἰσραήλ;"
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "καὶ ἀνελάβετε τὴν σκηνὴν τοῦ Μολὸχ καὶ τὸ ἄστρον τοῦ ⸀θεοῦ",
          {
            "noteId": 239
          },
          "⸀Ῥαιφάν",
          {
            "noteId": 240
          },
          "τοὺς τύπους οὓς ἐποιήσατε προσκυνεῖν αὐτοῖς. καὶ μετοικιῶ ὑμᾶς ἐπέκεινα Βαβυλῶνος."
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "Ἡ σκηνὴ τοῦ μαρτυρίου ἦν τοῖς πατράσιν ἡμῶν ἐν τῇ ἐρήμῳ, καθὼς διετάξατο ὁ λαλῶν τῷ Μωϋσῇ ποιῆσαι αὐτὴν κατὰ τὸν τύπον ὃν ἑωράκει,"
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "ἣν καὶ εἰσήγαγον διαδεξάμενοι οἱ πατέρες ἡμῶν μετὰ Ἰησοῦ ἐν τῇ κατασχέσει τῶν ἐθνῶν ὧν ἐξῶσεν ὁ θεὸς ἀπὸ προσώπου τῶν πατέρων ἡμῶν ἕως τῶν ἡμερῶν Δαυίδ·"
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "ὃς εὗρεν χάριν ἐνώπιον τοῦ θεοῦ καὶ ᾐτήσατο εὑρεῖν σκήνωμα τῷ ⸀θεῷ",
          {
            "noteId": 241
          },
          "Ἰακώβ."
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          "Σολομῶν δὲ οἰκοδόμησεν αὐτῷ οἶκον."
        ]
      },
      {
        "type": "verse",
        "number": 48,
        "content": [
          "ἀλλʼ οὐχ ὁ ὕψιστος ἐν ⸀χειροποιήτοις",
          {
            "noteId": 242
          },
          "κατοικεῖ· καθὼς ὁ προφήτης λέγει·"
        ]
      },
      {
        "type": "verse",
        "number": 49,
        "content": [
          "Ὁ οὐρανός μοι θρόνος, ⸂ἡ δὲ",
          {
            "noteId": 243
          },
          "γῆ ὑποπόδιον τῶν ποδῶν μου· ποῖον οἶκον οἰκοδομήσετέ μοι, λέγει κύριος, ἢ τίς τόπος τῆς καταπαύσεώς μου;"
        ]
      },
      {
        "type": "verse",
        "number": 50,
        "content": [
          "οὐχὶ ἡ χείρ μου ἐποίησεν ταῦτα πάντα;"
        ]
      },
      {
        "type": "verse",
        "number": 51,
        "content": [
          "Σκληροτράχηλοι καὶ ἀπερίτμητοι ⸀καρδίαις",
          {
            "noteId": 244
          },
          "καὶ τοῖς ὠσίν, ὑμεῖς ἀεὶ τῷ πνεύματι τῷ ἁγίῳ ἀντιπίπτετε, ὡς οἱ πατέρες ὑμῶν καὶ ὑμεῖς."
        ]
      },
      {
        "type": "verse",
        "number": 52,
        "content": [
          "τίνα τῶν προφητῶν οὐκ ἐδίωξαν οἱ πατέρες ὑμῶν; καὶ ἀπέκτειναν τοὺς προκαταγγείλαντας περὶ τῆς ἐλεύσεως τοῦ δικαίου οὗ νῦν ὑμεῖς προδόται καὶ φονεῖς ⸀ἐγένεσθε",
          {
            "noteId": 245
          }
        ]
      },
      {
        "type": "verse",
        "number": 53,
        "content": [
          "οἵτινες ἐλάβετε τὸν νόμον εἰς διαταγὰς ἀγγέλων, καὶ οὐκ ἐφυλάξατε."
        ]
      },
      {
        "type": "verse",
        "number": 54,
        "content": [
          "Ἀκούοντες δὲ ταῦτα διεπρίοντο ταῖς καρδίαις αὐτῶν καὶ ἔβρυχον τοὺς ὀδόντας ἐπʼ αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 55,
        "content": [
          "ὑπάρχων δὲ πλήρης πνεύματος ἁγίου ἀτενίσας εἰς τὸν οὐρανὸν εἶδεν δόξαν θεοῦ καὶ Ἰησοῦν ἑστῶτα ἐκ δεξιῶν τοῦ θεοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 56,
        "content": [
          "καὶ εἶπεν· Ἰδοὺ θεωρῶ τοὺς οὐρανοὺς ⸀διηνοιγμένους",
          {
            "noteId": 246
          },
          "καὶ τὸν υἱὸν τοῦ ἀνθρώπου ἐκ δεξιῶν ἑστῶτα τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 57,
        "content": [
          "κράξαντες δὲ φωνῇ μεγάλῃ συνέσχον τὰ ὦτα αὐτῶν, καὶ ὥρμησαν ὁμοθυμαδὸν ἐπʼ αὐτόν,"
        ]
      },
      {
        "type": "verse",
        "number": 58,
        "content": [
          "καὶ ἐκβαλόντες ἔξω τῆς πόλεως ἐλιθοβόλουν. καὶ οἱ μάρτυρες ἀπέθεντο τὰ ἱμάτια ⸀αὐτῶν",
          {
            "noteId": 247
          },
          "παρὰ τοὺς πόδας νεανίου καλουμένου Σαύλου."
        ]
      },
      {
        "type": "verse",
        "number": 59,
        "content": [
          "καὶ ἐλιθοβόλουν τὸν Στέφανον ἐπικαλούμενον καὶ λέγοντα· Κύριε Ἰησοῦ, δέξαι τὸ πνεῦμά μου·"
        ]
      },
      {
        "type": "verse",
        "number": 60,
        "content": [
          "θεὶς δὲ τὰ γόνατα ἔκραξεν φωνῇ μεγάλῃ· Κύριε, μὴ στήσῃς αὐτοῖς ⸂ταύτην τὴν ἁμαρτίαν",
          {
            "noteId": 248
          },
          "· καὶ τοῦτο εἰπὼν ἐκοιμήθη."
        ]
      }
