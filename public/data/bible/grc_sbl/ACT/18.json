  "chapter": {
    "number": 18,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "⸀Μετὰ",
          {
            "noteId": 659
          },
          "ταῦτα ⸀χωρισθεὶς",
          {
            "noteId": 660
          },
          "ἐκ τῶν Ἀθηνῶν ἦλθεν εἰς Κόρινθον."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ εὑρών τινα Ἰουδαῖον ὀνόματι Ἀκύλαν, Ποντικὸν τῷ γένει, προσφάτως ἐληλυθότα ἀπὸ τῆς Ἰταλίας καὶ Πρίσκιλλαν γυναῖκα αὐτοῦ διὰ τὸ ⸀διατεταχέναι",
          {
            "noteId": 661
          },
          "Κλαύδιον χωρίζεσθαι πάντας τοὺς Ἰουδαίους ⸀ἀπὸ",
          {
            "noteId": 662
          },
          "τῆς Ῥώμης, προσῆλθεν αὐτοῖς,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ διὰ τὸ ὁμότεχνον εἶναι ἔμενεν παρʼ αὐτοῖς καὶ ⸀ἠργάζετο",
          {
            "noteId": 663
          },
          "ἦσαν γὰρ σκηνοποιοὶ ⸂τῇ τέχνῃ",
          {
            "noteId": 664
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "διελέγετο δὲ ἐν τῇ συναγωγῇ κατὰ πᾶν σάββατον, ἔπειθέν τε Ἰουδαίους καὶ Ἕλληνας."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Ὡς δὲ κατῆλθον ἀπὸ τῆς Μακεδονίας ὅ τε Σιλᾶς καὶ ὁ Τιμόθεος, συνείχετο τῷ ⸀λόγῳ",
          {
            "noteId": 665
          },
          "ὁ Παῦλος, διαμαρτυρόμενος τοῖς Ἰουδαίοις ⸀εἶναι",
          {
            "noteId": 666
          },
          "τὸν χριστὸν Ἰησοῦν."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἀντιτασσομένων δὲ αὐτῶν καὶ βλασφημούντων ἐκτιναξάμενος τὰ ἱμάτια εἶπεν πρὸς αὐτούς· Τὸ αἷμα ὑμῶν ἐπὶ τὴν κεφαλὴν ὑμῶν· καθαρὸς ἐγώ· ἀπὸ τοῦ νῦν εἰς τὰ ἔθνη πορεύσομαι."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "καὶ μεταβὰς ἐκεῖθεν ⸀εἰσῆλθεν",
          {
            "noteId": 667
          },
          "εἰς οἰκίαν τινὸς ὀνόματι ⸀Τιτίου",
          {
            "noteId": 668
          },
          "Ἰούστου σεβομένου τὸν θεόν, οὗ ἡ οἰκία ἦν συνομοροῦσα τῇ συναγωγῇ."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Κρίσπος δὲ ὁ ἀρχισυνάγωγος ἐπίστευσεν τῷ κυρίῳ σὺν ὅλῳ τῷ οἴκῳ αὐτοῦ, καὶ πολλοὶ τῶν Κορινθίων ἀκούοντες ἐπίστευον καὶ ἐβαπτίζοντο."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "εἶπεν δὲ ὁ κύριος ⸂ἐν νυκτὶ διʼ ὁράματος",
          {
            "noteId": 669
          },
          "τῷ Παύλῳ· Μὴ φοβοῦ, ἀλλὰ λάλει καὶ μὴ σιωπήσῃς,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "διότι ἐγώ εἰμι μετὰ σοῦ καὶ οὐδεὶς ἐπιθήσεταί σοι τοῦ κακῶσαί σε, διότι λαός ἐστί μοι πολὺς ἐν τῇ πόλει ταύτῃ."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ἐκάθισεν ⸀δὲ",
          {
            "noteId": 670
          },
          "ἐνιαυτὸν καὶ μῆνας ἓξ διδάσκων ἐν αὐτοῖς τὸν λόγον τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Γαλλίωνος δὲ ⸂ἀνθυπάτου ὄντος",
          {
            "noteId": 671
          },
          "τῆς Ἀχαΐας κατεπέστησαν ⸂ὁμοθυμαδὸν οἱ Ἰουδαῖοι",
          {
            "noteId": 672
          },
          "τῷ Παύλῳ καὶ ἤγαγον αὐτὸν ἐπὶ τὸ βῆμα,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "λέγοντες ὅτι Παρὰ τὸν νόμον ⸂ἀναπείθει οὗτος",
          {
            "noteId": 673
          },
          "τοὺς ἀνθρώπους σέβεσθαι τὸν θεόν."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "μέλλοντος δὲ τοῦ Παύλου ἀνοίγειν τὸ στόμα εἶπεν ὁ Γαλλίων πρὸς τοὺς Ἰουδαίους· Εἰ ⸀μὲν",
          {
            "noteId": 674
          },
          "ἦν ἀδίκημά τι ἢ ῥᾳδιούργημα πονηρόν, ὦ Ἰουδαῖοι, κατὰ λόγον ἂν ἀνεσχόμην ὑμῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "εἰ δὲ ⸀ζητήματά",
          {
            "noteId": 675
          },
          "ἐστιν περὶ λόγου καὶ ὀνομάτων καὶ νόμου τοῦ καθʼ ὑμᾶς, ὄψεσθε αὐτοί· ⸀κριτὴς",
          {
            "noteId": 676
          },
          "ἐγὼ τούτων οὐ βούλομαι εἶναι."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ ἀπήλασεν αὐτοὺς ἀπὸ τοῦ βήματος."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ἐπιλαβόμενοι δὲ ⸀πάντες",
          {
            "noteId": 677
          },
          "Σωσθένην τὸν ἀρχισυνάγωγον ἔτυπτον ἔμπροσθεν τοῦ βήματος· καὶ οὐδὲν τούτων τῷ Γαλλίωνι ⸀ἔμελεν",
          {
            "noteId": 678
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Ὁ δὲ Παῦλος ἔτι προσμείνας ἡμέρας ἱκανὰς τοῖς ἀδελφοῖς ἀποταξάμενος ἐξέπλει εἰς τὴν Συρίαν, καὶ σὺν αὐτῷ Πρίσκιλλα καὶ Ἀκύλας, κειράμενος ⸂ἐν Κεγχρεαῖς τὴν κεφαλήν",
          {
            "noteId": 679
          },
          ", εἶχεν γὰρ εὐχήν."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "⸀κατήντησαν",
          {
            "noteId": 680
          },
          "δὲ εἰς Ἔφεσον, κἀκείνους κατέλιπεν αὐτοῦ, αὐτὸς δὲ εἰσελθὼν εἰς τὴν συναγωγὴν ⸀διελέξατο",
          {
            "noteId": 681
          },
          "τοῖς Ἰουδαίοις."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἐρωτώντων δὲ αὐτῶν ἐπὶ πλείονα χρόνον ⸀μεῖναι",
          {
            "noteId": 682
          },
          "οὐκ ἐπένευσεν,"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "⸂ἀλλὰ ἀποταξάμενος καὶ",
          {
            "noteId": 683
          },
          "⸀εἰπών",
          {
            "noteId": 684
          },
          "⸀Πάλιν ἀνακάμψω πρὸς ὑμᾶς τοῦ θεοῦ θέλοντος ἀνήχθη ἀπὸ τῆς Ἐφέσου,",
          {
            "noteId": 685
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "καὶ κατελθὼν εἰς Καισάρειαν, ἀναβὰς καὶ ἀσπασάμενος τὴν ἐκκλησίαν, κατέβη εἰς Ἀντιόχειαν,"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "καὶ ποιήσας χρόνον τινὰ ἐξῆλθεν, διερχόμενος καθεξῆς τὴν Γαλατικὴν χώραν καὶ Φρυγίαν, ⸀στηρίζων",
          {
            "noteId": 686
          },
          "πάντας τοὺς μαθητάς."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Ἰουδαῖος δέ τις Ἀπολλῶς ὀνόματι, Ἀλεξανδρεὺς τῷ γένει, ἀνὴρ λόγιος, κατήντησεν εἰς Ἔφεσον, δυνατὸς ὢν ἐν ταῖς γραφαῖς."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "οὗτος ἦν κατηχημένος τὴν ὁδὸν τοῦ κυρίου, καὶ ζέων τῷ πνεύματι ἐλάλει καὶ ἐδίδασκεν ἀκριβῶς τὰ περὶ τοῦ ⸀Ἰησοῦ",
          {
            "noteId": 687
          },
          "ἐπιστάμενος μόνον τὸ βάπτισμα Ἰωάννου."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "οὗτός τε ἤρξατο παρρησιάζεσθαι ἐν τῇ συναγωγῇ· ἀκούσαντες δὲ αὐτοῦ ⸂Πρίσκιλλα καὶ Ἀκύλας",
          {
            "noteId": 688
          },
          "προσελάβοντο αὐτὸν καὶ ἀκριβέστερον αὐτῷ ἐξέθεντο τὴν ⸂ὁδὸν τοῦ θεοῦ",
          {
            "noteId": 689
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "βουλομένου δὲ αὐτοῦ διελθεῖν εἰς τὴν Ἀχαΐαν προτρεψάμενοι οἱ ἀδελφοὶ ἔγραψαν τοῖς μαθηταῖς ἀποδέξασθαι αὐτόν· ὃς παραγενόμενος συνεβάλετο πολὺ τοῖς πεπιστευκόσιν διὰ τῆς χάριτος·"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "εὐτόνως γὰρ τοῖς Ἰουδαίοις διακατηλέγχετο δημοσίᾳ ἐπιδεικνὺς διὰ τῶν γραφῶν εἶναι τὸν χριστὸν Ἰησοῦν."
        ]
      }
