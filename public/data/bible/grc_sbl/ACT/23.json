  "chapter": {
    "number": 23,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "ἀτενίσας δὲ ⸂ὁ Παῦλος τῷ συνεδρίῳ",
          {
            "noteId": 851
          },
          "εἶπεν· Ἄνδρες ἀδελφοί, ἐγὼ πάσῃ συνειδήσει ἀγαθῇ πεπολίτευμαι τῷ θεῷ ἄχρι ταύτης τῆς ἡμέρας."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ὁ δὲ ἀρχιερεὺς Ἁνανίας ἐπέταξεν τοῖς παρεστῶσιν αὐτῷ τύπτειν αὐτοῦ τὸ στόμα."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "τότε ὁ Παῦλος πρὸς αὐτὸν εἶπεν· Τύπτειν σε μέλλει ὁ θεός, τοῖχε κεκονιαμένε· καὶ σὺ κάθῃ κρίνων με κατὰ τὸν νόμον, καὶ παρανομῶν κελεύεις με τύπτεσθαι;"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "οἱ δὲ παρεστῶτες εἶπαν· Τὸν ἀρχιερέα τοῦ θεοῦ λοιδορεῖς;"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἔφη τε ὁ Παῦλος· Οὐκ ᾔδειν, ἀδελφοί, ὅτι",
          {
            "noteId": 852
          },
          "ἐστὶν ἀρχιερεύς· γέγραπται γὰρ ⸀ὅτι Ἄρχοντα τοῦ λαοῦ σου οὐκ ἐρεῖς κακῶς."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Γνοὺς δὲ ὁ Παῦλος ὅτι τὸ ἓν μέρος ἐστὶν Σαδδουκαίων τὸ δὲ ἕτερον Φαρισαίων ⸀ἔκραζεν",
          {
            "noteId": 853
          },
          "ἐν τῷ συνεδρίῳ· Ἄνδρες ἀδελφοί, ἐγὼ Φαρισαῖός εἰμι, υἱὸς ⸀Φαρισαίων",
          {
            "noteId": 854
          },
          "περὶ ἐλπίδος καὶ ἀναστάσεως νεκρῶν ⸀ἐγὼ",
          {
            "noteId": 855
          },
          "κρίνομαι."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "τοῦτο δὲ αὐτοῦ ⸀λαλοῦντος",
          {
            "noteId": 856
          },
          "ἐγένετο στάσις τῶν Φαρισαίων ⸂καὶ Σαδδουκαίων",
          {
            "noteId": 857
          },
          ", καὶ ἐσχίσθη τὸ πλῆθος."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Σαδδουκαῖοι ⸀μὲν",
          {
            "noteId": 858
          },
          "γὰρ λέγουσιν μὴ εἶναι ἀνάστασιν ⸀μήτε",
          {
            "noteId": 859
          },
          "ἄγγελον μήτε πνεῦμα, Φαρισαῖοι δὲ ὁμολογοῦσιν τὰ ἀμφότερα."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ἐγένετο δὲ κραυγὴ μεγάλη, καὶ ἀναστάντες ⸂τινὲς τῶν γραμματέων",
          {
            "noteId": 860
          },
          "τοῦ μέρους τῶν Φαρισαίων διεμάχοντο λέγοντες· Οὐδὲν κακὸν εὑρίσκομεν ἐν τῷ ἀνθρώπῳ τούτῳ· εἰ δὲ πνεῦμα ἐλάλησεν αὐτῷ ἢ ⸀ἄγγελος",
          {
            "noteId": 861
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "πολλῆς δὲ ⸀γινομένης",
          {
            "noteId": 862
          },
          "στάσεως ⸀φοβηθεὶς",
          {
            "noteId": 863
          },
          "ὁ χιλίαρχος μὴ διασπασθῇ ὁ Παῦλος ὑπʼ αὐτῶν ἐκέλευσεν τὸ στράτευμα ⸀καταβὰν",
          {
            "noteId": 864
          },
          "ἁρπάσαι αὐτὸν ἐκ μέσου αὐτῶν, ἄγειν ⸀τε",
          {
            "noteId": 865
          },
          "εἰς τὴν παρεμβολήν."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Τῇ δὲ ἐπιούσῃ νυκτὶ ἐπιστὰς αὐτῷ ὁ κύριος εἶπεν· ⸀Θάρσει",
          {
            "noteId": 866
          },
          "ὡς γὰρ διεμαρτύρω τὰ περὶ ἐμοῦ εἰς Ἰερουσαλὴμ οὕτω σε δεῖ καὶ εἰς Ῥώμην μαρτυρῆσαι."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Γενομένης δὲ ἡμέρας ποιήσαντες ⸂συστροφὴν οἱ Ἰουδαῖοι",
          {
            "noteId": 867
          },
          "ἀνεθεμάτισαν ἑαυτοὺς λέγοντες μήτε φαγεῖν μήτε πιεῖν ἕως οὗ ἀποκτείνωσιν τὸν Παῦλον."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ἦσαν δὲ πλείους τεσσεράκοντα οἱ ταύτην τὴν συνωμοσίαν ⸀ποιησάμενοι",
          {
            "noteId": 868
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "οἵτινες προσελθόντες τοῖς ἀρχιερεῦσιν καὶ τοῖς πρεσβυτέροις εἶπαν· Ἀναθέματι ἀνεθεματίσαμεν ἑαυτοὺς μηδενὸς γεύσασθαι ἕως οὗ ἀποκτείνωμεν τὸν Παῦλον."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "νῦν οὖν ὑμεῖς ἐμφανίσατε τῷ χιλιάρχῳ σὺν τῷ συνεδρίῳ ⸀ὅπως",
          {
            "noteId": 869
          },
          "⸂καταγάγῃ αὐτὸν εἰς",
          {
            "noteId": 870
          },
          "ὑμᾶς ὡς μέλλοντας διαγινώσκειν ἀκριβέστερον τὰ περὶ αὐτοῦ· ἡμεῖς δὲ πρὸ τοῦ ἐγγίσαι αὐτὸν ἕτοιμοί ἐσμεν τοῦ ἀνελεῖν αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Ἀκούσας δὲ ὁ υἱὸς τῆς ἀδελφῆς Παύλου ⸂τὴν ἐνέδραν",
          {
            "noteId": 871
          },
          "παραγενόμενος καὶ εἰσελθὼν εἰς τὴν παρεμβολὴν ἀπήγγειλεν τῷ Παύλῳ."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "προσκαλεσάμενος δὲ ὁ Παῦλος ἕνα τῶν ἑκατονταρχῶν ἔφη· Τὸν νεανίαν τοῦτον ⸀ἄπαγε",
          {
            "noteId": 872
          },
          "πρὸς τὸν χιλίαρχον, ἔχει γὰρ ⸂ἀπαγγεῖλαί τι",
          {
            "noteId": 873
          },
          "αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ὁ μὲν οὖν παραλαβὼν αὐτὸν ἤγαγεν πρὸς τὸν χιλίαρχον καὶ φησίν· Ὁ δέσμιος Παῦλος προσκαλεσάμενός με ἠρώτησεν τοῦτον τὸν ⸀νεανίαν",
          {
            "noteId": 874
          },
          "ἀγαγεῖν πρὸς σέ, ἔχοντά τι λαλῆσαί σοι."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἐπιλαβόμενος δὲ τῆς χειρὸς αὐτοῦ ὁ χιλίαρχος καὶ ἀναχωρήσας κατʼ ἰδίαν ἐπυνθάνετο· Τί ἐστιν ὃ ἔχεις ἀπαγγεῖλαί μοι;"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "εἶπεν δὲ ὅτι Οἱ Ἰουδαῖοι συνέθεντο τοῦ ἐρωτῆσαί σε ὅπως αὔριον ⸂τὸν Παῦλον καταγάγῃς εἰς τὸ συνέδριον",
          {
            "noteId": 875
          },
          "ὡς ⸀μέλλον",
          {
            "noteId": 876
          },
          "τι ἀκριβέστερον πυνθάνεσθαι περὶ αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "σὺ οὖν μὴ πεισθῇς αὐτοῖς, ἐνεδρεύουσιν γὰρ αὐτὸν ἐξ αὐτῶν ἄνδρες πλείους τεσσεράκοντα, οἵτινες ἀνεθεμάτισαν ἑαυτοὺς μήτε φαγεῖν μήτε πιεῖν ἕως οὗ ἀνέλωσιν αὐτόν, καὶ νῦν ⸂εἰσιν ἕτοιμοι",
          {
            "noteId": 877
          },
          "προσδεχόμενοι τὴν ἀπὸ σοῦ ἐπαγγελίαν."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ὁ μὲν οὖν χιλίαρχος ἀπέλυσε τὸν ⸀νεανίσκον",
          {
            "noteId": 878
          },
          "παραγγείλας μηδενὶ ἐκλαλῆσαι ὅτι ταῦτα ἐνεφάνισας πρὸς ⸀ἐμέ",
          {
            "noteId": 879
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Καὶ προσκαλεσάμενός ⸂τινας δύο",
          {
            "noteId": 880
          },
          "τῶν ἑκατονταρχῶν εἶπεν· Ἑτοιμάσατε στρατιώτας διακοσίους ὅπως πορευθῶσιν ἕως Καισαρείας, καὶ ἱππεῖς ἑβδομήκοντα καὶ δεξιολάβους διακοσίους, ἀπὸ τρίτης ὥρας τῆς νυκτός,"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "κτήνη τε παραστῆσαι ἵνα ἐπιβιβάσαντες τὸν Παῦλον διασώσωσι πρὸς Φήλικα τὸν ἡγεμόνα,"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "γράψας ἐπιστολὴν ⸀ἔχουσαν",
          {
            "noteId": 881
          },
          "τὸν τύπον τοῦτον·"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Κλαύδιος Λυσίας τῷ κρατίστῳ ἡγεμόνι Φήλικι χαίρειν."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "τὸν ἄνδρα τοῦτον συλλημφθέντα ὑπὸ τῶν Ἰουδαίων καὶ μέλλοντα ἀναιρεῖσθαι ὑπʼ αὐτῶν ἐπιστὰς σὺν τῷ στρατεύματι ⸀ἐξειλάμην",
          {
            "noteId": 882
          },
          "μαθὼν ὅτι Ῥωμαῖός ἐστιν,"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "βουλόμενός ⸀τε",
          {
            "noteId": 883
          },
          "⸀ἐπιγνῶναι",
          {
            "noteId": 884
          },
          "τὴν αἰτίαν διʼ ἣν ἐνεκάλουν αὐτῷ, ⸀κατήγαγον",
          {
            "noteId": 885
          },
          "εἰς τὸ συνέδριον αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "ὃν εὗρον ἐγκαλούμενον περὶ ζητημάτων τοῦ νόμου αὐτῶν, μηδὲ",
          {
            "noteId": 886
          },
          "⸀δὲ ἄξιον θανάτου ἢ δεσμῶν ⸂ἔχοντα ἔγκλημα",
          {
            "noteId": 887
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "μηνυθείσης δέ μοι ἐπιβουλῆς εἰς τὸν ⸀ἄνδρα",
          {
            "noteId": 888
          },
          "ἔσεσθαι ⸀ἐξαυτῆς",
          {
            "noteId": 889
          },
          "ἔπεμψα πρὸς σέ, παραγγείλας καὶ τοῖς κατηγόροις ⸀λέγειν",
          {
            "noteId": 890
          },
          "πρὸς αὐτὸν ἐπὶ ⸀σοῦ",
          {
            "noteId": 891
          }
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "Οἱ μὲν οὖν στρατιῶται κατὰ τὸ διατεταγμένον αὐτοῖς ἀναλαβόντες τὸν Παῦλον ἤγαγον ⸀διὰ",
          {
            "noteId": 892
          },
          "νυκτὸς εἰς τὴν Ἀντιπατρίδα·"
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "τῇ δὲ ἐπαύριον ἐάσαντες τοὺς ἱππεῖς ⸀ἀπέρχεσθαι",
          {
            "noteId": 893
          },
          "σὺν αὐτῷ ὑπέστρεψαν εἰς τὴν παρεμβολήν·"
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "οἵτινες εἰσελθόντες εἰς τὴν Καισάρειαν καὶ ἀναδόντες τὴν ἐπιστολὴν τῷ ἡγεμόνι παρέστησαν καὶ τὸν Παῦλον αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "ἀναγνοὺς ⸀δὲ",
          {
            "noteId": 894
          },
          "καὶ ἐπερωτήσας ἐκ ποίας ⸀ἐπαρχείας",
          {
            "noteId": 895
          },
          "ἐστὶν καὶ πυθόμενος ὅτι ἀπὸ Κιλικίας,"
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "Διακούσομαί σου, ἔφη, ὅταν καὶ οἱ κατήγοροί σου παραγένωνται· ⸀κελεύσας",
          {
            "noteId": 896
          },
          "ἐν τῷ πραιτωρίῳ ⸀τοῦ",
          {
            "noteId": 897
          },
          "Ἡρῴδου φυλάσσεσθαι ⸀αὐτόν",
          {
            "noteId": 898
          }
        ]
      }
    ],
