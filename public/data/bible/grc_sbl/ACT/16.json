  "chapter": {
    "number": 16,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Κατήντησεν δὲ ⸀καὶ",
          {
            "noteId": 563
          },
          "εἰς",
          {
            "noteId": 564
          },
          "Δέρβην καὶ ⸀εἰς Λύστραν. καὶ ἰδοὺ μαθητής τις ἦν ἐκεῖ ὀνόματι Τιμόθεος, υἱὸς ⸀γυναικὸς",
          {
            "noteId": 565
          },
          "Ἰουδαίας πιστῆς, πατρὸς δὲ Ἕλληνος,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ὃς ἐμαρτυρεῖτο ὑπὸ τῶν ἐν Λύστροις καὶ Ἰκονίῳ ἀδελφῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "τοῦτον ἠθέλησεν ὁ Παῦλος σὺν αὐτῷ ἐξελθεῖν, καὶ λαβὼν περιέτεμεν αὐτὸν διὰ τοὺς Ἰουδαίους τοὺς ὄντας ἐν τοῖς τόποις ἐκείνοις, ᾔδεισαν γὰρ ἅπαντες ⸂ὅτι Ἕλλην ὁ πατὴρ αὐτοῦ",
          {
            "noteId": 566
          },
          "ὑπῆρχεν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ὡς δὲ διεπορεύοντο τὰς πόλεις, ⸀παρεδίδοσαν",
          {
            "noteId": 567
          },
          "αὐτοῖς φυλάσσειν τὰ δόγματα τὰ κεκριμένα ὑπὸ τῶν ἀποστόλων ⸀καὶ",
          {
            "noteId": 568
          },
          "πρεσβυτέρων τῶν ἐν ⸀Ἱεροσολύμοις",
          {
            "noteId": 569
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "αἱ μὲν οὖν ἐκκλησίαι ἐστερεοῦντο τῇ πίστει καὶ ἐπερίσσευον τῷ ἀριθμῷ καθʼ ἡμέραν."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "⸀Διῆλθον",
          {
            "noteId": 570
          },
          "δὲ τὴν Φρυγίαν ⸀καὶ",
          {
            "noteId": 571
          },
          "Γαλατικὴν χώραν, κωλυθέντες ὑπὸ τοῦ ἁγίου πνεύματος λαλῆσαι τὸν λόγον ἐν τῇ Ἀσίᾳ,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἐλθόντες ⸀δὲ",
          {
            "noteId": 572
          },
          "κατὰ τὴν Μυσίαν ἐπείραζον ⸀εἰς",
          {
            "noteId": 573
          },
          "τὴν Βιθυνίαν ⸀πορευθῆναι",
          {
            "noteId": 574
          },
          "καὶ οὐκ εἴασεν αὐτοὺς τὸ πνεῦμα ⸀Ἰησοῦ",
          {
            "noteId": 575
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "παρελθόντες δὲ τὴν Μυσίαν κατέβησαν εἰς Τρῳάδα."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ ὅραμα ⸀διὰ",
          {
            "noteId": 576
          },
          "νυκτὸς ⸂τῷ Παύλῳ ὤφθη",
          {
            "noteId": 577
          },
          ", ἀνὴρ ⸂Μακεδών τις ἦν",
          {
            "noteId": 578
          },
          "ἑστὼς ⸀καὶ",
          {
            "noteId": 579
          },
          "παρακαλῶν αὐτὸν καὶ λέγων· Διαβὰς εἰς Μακεδονίαν βοήθησον ἡμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ὡς δὲ τὸ ὅραμα εἶδεν, εὐθέως ἐζητήσαμεν ἐξελθεῖν ⸀εἰς",
          {
            "noteId": 580
          },
          "Μακεδονίαν, συμβιβάζοντες ὅτι προσκέκληται ἡμᾶς ὁ ⸀θεὸς",
          {
            "noteId": 581
          },
          "εὐαγγελίσασθαι αὐτούς."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ἀναχθέντες ⸀οὖν",
          {
            "noteId": 582
          },
          "⸀ἀπὸ",
          {
            "noteId": 583
          },
          "Τρῳάδος εὐθυδρομήσαμεν εἰς Σαμοθρᾴκην, τῇ ⸀δὲ",
          {
            "noteId": 584
          },
          "ἐπιούσῃ εἰς ⸂Νέαν Πόλιν",
          {
            "noteId": 585
          },
          ","
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "⸀κἀκεῖθεν",
          {
            "noteId": 586
          },
          "εἰς Φιλίππους, ἥτις ἐστὶν ⸂πρώτη τῆς μερίδος",
          {
            "noteId": 587
          },
          "Μακεδονίας πόλις, κολωνία. ἦμεν δὲ ἐν ⸀ταύτῃ",
          {
            "noteId": 588
          },
          "τῇ πόλει διατρίβοντες ἡμέρας τινάς."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "τῇ τε ἡμέρᾳ τῶν σαββάτων ἐξήλθομεν ἔξω τῆς ⸀πύλης",
          {
            "noteId": 589
          },
          "παρὰ ποταμὸν οὗ ⸂ἐνομίζομεν προσευχὴν",
          {
            "noteId": 590
          },
          "εἶναι, καὶ καθίσαντες ἐλαλοῦμεν ταῖς συνελθούσαις γυναιξίν."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καί τις γυνὴ ὀνόματι Λυδία, πορφυρόπωλις πόλεως Θυατείρων σεβομένη τὸν θεόν, ἤκουεν, ἧς ὁ κύριος διήνοιξεν τὴν καρδίαν προσέχειν τοῖς λαλουμένοις ὑπὸ ⸀τοῦ",
          {
            "noteId": 591
          },
          "Παύλου."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ὡς δὲ ἐβαπτίσθη καὶ ὁ οἶκος αὐτῆς, παρεκάλεσεν λέγουσα· Εἰ κεκρίκατέ με πιστὴν τῷ κυρίῳ εἶναι, εἰσελθόντες εἰς τὸν οἶκόν μου ⸀μένετε",
          {
            "noteId": 592
          },
          "καὶ παρεβιάσατο ἡμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Ἐγένετο δὲ πορευομένων ἡμῶν εἰς ⸀τὴν",
          {
            "noteId": 593
          },
          "προσευχὴν παιδίσκην τινὰ ἔχουσαν πνεῦμα ⸀πύθωνα",
          {
            "noteId": 594
          },
          "⸀ὑπαντῆσαι",
          {
            "noteId": 595
          },
          "ἡμῖν, ἥτις ἐργασίαν πολλὴν παρεῖχεν τοῖς κυρίοις αὐτῆς μαντευομένη·"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "αὕτη ⸀κατακολουθοῦσα",
          {
            "noteId": 596
          },
          "τῷ Παύλῳ καὶ ἡμῖν ἔκραζεν λέγουσα· Οὗτοι οἱ ἄνθρωποι δοῦλοι τοῦ θεοῦ τοῦ ὑψίστου εἰσίν, οἵτινες καταγγέλλουσιν ⸀ὑμῖν",
          {
            "noteId": 597
          },
          "ὁδὸν σωτηρίας."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "τοῦτο δὲ",
          {
            "noteId": 598
          },
          "ἐποίει ἐπὶ πολλὰς ἡμέρας. διαπονηθεὶς ⸀δὲ Παῦλος καὶ ἐπιστρέψας τῷ πνεύματι εἶπεν· Παραγγέλλω σοι ⸀ἐν",
          {
            "noteId": 599
          },
          "ὀνόματι Ἰησοῦ Χριστοῦ ἐξελθεῖν ἀπʼ αὐτῆς· καὶ ἐξῆλθεν αὐτῇ τῇ ὥρᾳ."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Ἰδόντες δὲ οἱ κύριοι αὐτῆς ὅτι ἐξῆλθεν ἡ ἐλπὶς τῆς ἐργασίας αὐτῶν ἐπιλαβόμενοι τὸν Παῦλον καὶ τὸν Σιλᾶν εἵλκυσαν εἰς τὴν ἀγορὰν ἐπὶ τοὺς ἄρχοντας,"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "καὶ προσαγαγόντες αὐτοὺς τοῖς στρατηγοῖς εἶπαν· Οὗτοι οἱ ἄνθρωποι ἐκταράσσουσιν ἡμῶν τὴν πόλιν Ἰουδαῖοι ὑπάρχοντες,"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "καὶ καταγγέλλουσιν ἔθη ἃ οὐκ ἔξεστιν ἡμῖν παραδέχεσθαι οὐδὲ ποιεῖν Ῥωμαίοις οὖσιν."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "καὶ συνεπέστη ὁ ὄχλος κατʼ αὐτῶν, καὶ οἱ στρατηγοὶ περιρήξαντες αὐτῶν τὰ ἱμάτια ἐκέλευον ῥαβδίζειν,"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "πολλάς ⸀τε",
          {
            "noteId": 600
          },
          "ἐπιθέντες αὐτοῖς πληγὰς ἔβαλον εἰς φυλακήν, παραγγείλαντες τῷ δεσμοφύλακι ἀσφαλῶς τηρεῖν αὐτούς·"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ὃς παραγγελίαν τοιαύτην ⸀λαβὼν",
          {
            "noteId": 601
          },
          "ἔβαλεν αὐτοὺς εἰς τὴν ἐσωτέραν φυλακὴν καὶ τοὺς πόδας ⸂ἠσφαλίσατο αὐτῶν",
          {
            "noteId": 602
          },
          "εἰς τὸ ξύλον."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Κατὰ δὲ τὸ μεσονύκτιον Παῦλος καὶ Σιλᾶς προσευχόμενοι ὕμνουν τὸν θεόν, ἐπηκροῶντο δὲ αὐτῶν οἱ δέσμιοι·"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ἄφνω δὲ",
          {
            "noteId": 603
          },
          "σεισμὸς ἐγένετο μέγας ὥστε σαλευθῆναι τὰ θεμέλια τοῦ δεσμωτηρίου, ἠνεῴχθησαν ⸀δὲ παραχρῆμα αἱ θύραι πᾶσαι, καὶ πάντων τὰ δεσμὰ ἀνέθη."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "ἔξυπνος δὲ γενόμενος ὁ δεσμοφύλαξ καὶ ἰδὼν ἀνεῳγμένας τὰς θύρας τῆς φυλακῆς σπασάμενος ⸀τὴν",
          {
            "noteId": 604
          },
          "μάχαιραν ἤμελλεν ἑαυτὸν ἀναιρεῖν, νομίζων ἐκπεφευγέναι τοὺς δεσμίους."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ἐφώνησεν δὲ ⸂φωνῇ μεγάλῃ ὁ Παῦλος",
          {
            "noteId": 605
          },
          "λέγων· Μηδὲν πράξῃς σεαυτῷ κακόν, ἅπαντες γάρ ἐσμεν ἐνθάδε."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "αἰτήσας δὲ φῶτα εἰσεπήδησεν καὶ ἔντρομος γενόμενος προσέπεσεν τῷ",
          {
            "noteId": 606
          },
          "Παύλῳ καὶ ⸀τῷ Σιλᾷ,"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "καὶ προαγαγὼν αὐτοὺς ἔξω ἔφη· Κύριοι, τί με δεῖ ποιεῖν ἵνα σωθῶ;"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "οἱ δὲ εἶπαν· Πίστευσον ἐπὶ τὸν κύριον ⸀Ἰησοῦν",
          {
            "noteId": 607
          },
          "καὶ σωθήσῃ σὺ καὶ ὁ οἶκός σου."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "καὶ ἐλάλησαν αὐτῷ τὸν λόγον τοῦ ⸀κυρίου",
          {
            "noteId": 608
          },
          "⸀σὺν",
          {
            "noteId": 609
          },
          "πᾶσι τοῖς ἐν τῇ οἰκίᾳ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "καὶ παραλαβὼν αὐτοὺς ἐν ἐκείνῃ τῇ ὥρᾳ τῆς νυκτὸς ἔλουσεν ἀπὸ τῶν πληγῶν, καὶ ἐβαπτίσθη αὐτὸς καὶ οἱ αὐτοῦ ⸀πάντες",
          {
            "noteId": 610
          },
          "παραχρῆμα,"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "ἀναγαγών τε αὐτοὺς εἰς τὸν ⸀οἶκον",
          {
            "noteId": 611
          },
          "παρέθηκεν τράπεζαν καὶ ⸀ἠγαλλιάσατο",
          {
            "noteId": 612
          },
          "πανοικεὶ πεπιστευκὼς τῷ θεῷ."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "Ἡμέρας δὲ γενομένης ἀπέστειλαν οἱ στρατηγοὶ τοὺς ῥαβδούχους λέγοντες· Ἀπόλυσον τοὺς ἀνθρώπους ἐκείνους."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "ἀπήγγειλεν δὲ ὁ δεσμοφύλαξ τοὺς λόγους ⸀τούτους",
          {
            "noteId": 613
          },
          "πρὸς τὸν Παῦλον, ὅτι Ἀπέσταλκαν οἱ στρατηγοὶ ἵνα ἀπολυθῆτε· νῦν οὖν ἐξελθόντες πορεύεσθε ἐν εἰρήνῃ."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "ὁ δὲ Παῦλος ἔφη πρὸς αὐτούς· Δείραντες ἡμᾶς",
          {
            "noteId": 614
          },
          "δημοσίᾳ ἀκατακρίτους, ἀνθρώπους Ῥωμαίους ὑπάρχοντας, ἔβαλαν εἰς φυλακήν· καὶ νῦν λάθρᾳ ἡμᾶς ἐκβάλλουσιν; οὐ γάρ, ἀλλὰ ἐλθόντες αὐτοὶ ⸀ἡμᾶς ἐξαγαγέτωσαν."
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "⸀ἀπήγγειλαν",
          {
            "noteId": 615
          },
          "δὲ τοῖς στρατηγοῖς οἱ ῥαβδοῦχοι τὰ ῥήματα ταῦτα· ⸂ἐφοβήθησαν δὲ",
          {
            "noteId": 616
          },
          "ἀκούσαντες ὅτι Ῥωμαῖοί εἰσιν,"
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "καὶ ἐλθόντες παρεκάλεσαν αὐτούς, καὶ ἐξαγαγόντες ἠρώτων ⸂ἀπελθεῖν ἀπὸ",
          {
            "noteId": 617
          },
          "τῆς πόλεως."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "ἐξελθόντες δὲ ⸀ἀπὸ",
          {
            "noteId": 618
          },
          "τῆς φυλακῆς εἰσῆλθον πρὸς τὴν Λυδίαν, καὶ ἰδόντες ⸂παρεκάλεσαν τοὺς ἀδελφοὺς",
          {
            "noteId": 619
          },
          "καὶ ἐξῆλθαν."
        ]
      }
    ],
