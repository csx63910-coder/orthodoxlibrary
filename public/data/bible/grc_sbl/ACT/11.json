  "chapter": {
    "number": 11,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἤκουσαν δὲ οἱ ἀπόστολοι καὶ οἱ ἀδελφοὶ οἱ ὄντες κατὰ τὴν Ἰουδαίαν ὅτι καὶ τὰ ἔθνη ἐδέξαντο τὸν λόγον τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "⸂ὅτε δὲ",
          {
            "noteId": 376
          },
          "ἀνέβη Πέτρος εἰς ⸀Ἰερουσαλήμ",
          {
            "noteId": 377
          },
          "διεκρίνοντο πρὸς αὐτὸν οἱ ἐκ περιτομῆς"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "λέγοντες ὅτι ⸂Εἰσῆλθες πρὸς ἄνδρας ἀκροβυστίαν ἔχοντας καὶ συνέφαγες",
          {
            "noteId": 378
          },
          "αὐτοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἀρξάμενος ⸀δὲ",
          {
            "noteId": 379
          },
          "Πέτρος ἐξετίθετο αὐτοῖς καθεξῆς λέγων·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Ἐγὼ ἤμην ἐν πόλει Ἰόππῃ προσευχόμενος καὶ εἶδον ἐν ἐκστάσει ὅραμα, καταβαῖνον σκεῦός τι ὡς ὀθόνην μεγάλην τέσσαρσιν ἀρχαῖς καθιεμένην ἐκ τοῦ οὐρανοῦ, καὶ ἦλθεν ἄχρι ἐμοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "εἰς ἣν ἀτενίσας κατενόουν καὶ εἶδον τὰ τετράποδα τῆς γῆς καὶ τὰ θηρία καὶ τὰ ἑρπετὰ καὶ τὰ πετεινὰ τοῦ οὐρανοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἤκουσα δὲ ⸀καὶ",
          {
            "noteId": 380
          },
          "φωνῆς λεγούσης μοι· Ἀναστάς, Πέτρε, θῦσον καὶ φάγε."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "εἶπον δέ· Μηδαμῶς, κύριε, ⸀ὅτι",
          {
            "noteId": 381
          },
          "κοινὸν ἢ ἀκάθαρτον οὐδέποτε εἰσῆλθεν εἰς τὸ στόμα μου."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ἀπεκρίθη δὲ ⸂φωνὴ ἐκ δευτέρου",
          {
            "noteId": 382
          },
          "ἐκ τοῦ οὐρανοῦ· Ἃ ὁ θεὸς ἐκαθάρισεν σὺ μὴ κοίνου."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "τοῦτο δὲ ἐγένετο ἐπὶ τρίς, καὶ ⸂ἀνεσπάσθη πάλιν",
          {
            "noteId": 383
          },
          "ἅπαντα εἰς τὸν οὐρανόν."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ ἰδοὺ ἐξαυτῆς τρεῖς ἄνδρες ἐπέστησαν ἐπὶ τὴν οἰκίαν ἐν ᾗ ⸀ἦμεν",
          {
            "noteId": 384
          },
          "ἀπεσταλμένοι ἀπὸ Καισαρείας πρός με."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "εἶπεν δὲ ⸂τὸ πνεῦμά μοι",
          {
            "noteId": 385
          },
          "συνελθεῖν αὐτοῖς μηδὲν ⸀διακρίναντα",
          {
            "noteId": 386
          },
          "ἦλθον δὲ σὺν ἐμοὶ καὶ οἱ ἓξ ἀδελφοὶ οὗτοι, καὶ εἰσήλθομεν εἰς τὸν οἶκον τοῦ ἀνδρός."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ἀπήγγειλεν ⸀δὲ",
          {
            "noteId": 387
          },
          "ἡμῖν πῶς εἶδεν τὸν ἄγγελον ἐν τῷ οἴκῳ αὐτοῦ σταθέντα καὶ ⸀εἰπόντα",
          {
            "noteId": 388
          },
          "Ἀπόστειλον εἰς ⸀Ἰόππην",
          {
            "noteId": 389
          },
          "καὶ μετάπεμψαι Σίμωνα τὸν ἐπικαλούμενον Πέτρον,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ὃς λαλήσει ῥήματα πρὸς σὲ ἐν οἷς σωθήσῃ σὺ καὶ πᾶς ὁ οἶκός σου."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ἐν δὲ τῷ ἄρξασθαί με λαλεῖν ἐπέπεσεν τὸ πνεῦμα τὸ ἅγιον ἐπʼ αὐτοὺς ὥσπερ καὶ ἐφʼ ἡμᾶς ἐν ἀρχῇ."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ἐμνήσθην δὲ τοῦ",
          {
            "noteId": 390
          },
          "ῥήματος ⸀τοῦ κυρίου ὡς ἔλεγεν· Ἰωάννης μὲν ἐβάπτισεν ὕδατι, ὑμεῖς δὲ βαπτισθήσεσθε ἐν πνεύματι ἁγίῳ."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "εἰ οὖν τὴν ἴσην δωρεὰν ἔδωκεν αὐτοῖς ὁ θεὸς ὡς καὶ ἡμῖν πιστεύσασιν ἐπὶ τὸν κύριον Ἰησοῦν Χριστόν, ⸀ἐγὼ",
          {
            "noteId": 391
          },
          "τίς ἤμην δυνατὸς κωλῦσαι τὸν θεόν;"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ἀκούσαντες δὲ ταῦτα ἡσύχασαν καὶ ⸀ἐδόξασαν",
          {
            "noteId": 392
          },
          "τὸν θεὸν λέγοντες· ⸀Ἄρα",
          {
            "noteId": 393
          },
          "καὶ τοῖς ἔθνεσιν ὁ θεὸς τὴν μετάνοιαν ⸂εἰς ζωὴν ἔδωκεν",
          {
            "noteId": 394
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Οἱ μὲν οὖν διασπαρέντες ἀπὸ τῆς θλίψεως τῆς γενομένης ἐπὶ Στεφάνῳ διῆλθον ἕως Φοινίκης καὶ Κύπρου καὶ Ἀντιοχείας μηδενὶ λαλοῦντες τὸν λόγον εἰ μὴ μόνον Ἰουδαίοις."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἦσαν δέ τινες ἐξ αὐτῶν ἄνδρες Κύπριοι καὶ Κυρηναῖοι, οἵτινες ⸀ἐλθόντες",
          {
            "noteId": 395
          },
          "εἰς Ἀντιόχειαν ἐλάλουν ⸀καὶ",
          {
            "noteId": 396
          },
          "πρὸς τοὺς ⸀Ἑλληνιστάς",
          {
            "noteId": 397
          },
          "εὐαγγελιζόμενοι τὸν κύριον Ἰησοῦν."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "καὶ ἦν χεὶρ κυρίου μετʼ αὐτῶν, πολύς τε ἀριθμὸς ⸀ὁ",
          {
            "noteId": 398
          },
          "πιστεύσας ἐπέστρεψεν ἐπὶ τὸν κύριον."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ἠκούσθη δὲ ὁ λόγος εἰς τὰ ὦτα τῆς ἐκκλησίας τῆς ⸀οὔσης",
          {
            "noteId": 399
          },
          "ἐν ⸀Ἰερουσαλὴμ",
          {
            "noteId": 400
          },
          "περὶ αὐτῶν, καὶ ἐξαπέστειλαν ⸀Βαρναβᾶν",
          {
            "noteId": 401
          },
          "ἕως Ἀντιοχείας·"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "ὃς παραγενόμενος καὶ ἰδὼν τὴν",
          {
            "noteId": 402
          },
          "χάριν ⸀τὴν τοῦ θεοῦ, ἐχάρη καὶ παρεκάλει πάντας τῇ προθέσει τῆς καρδίας ⸀προσμένειν",
          {
            "noteId": 403
          },
          "τῷ κυρίῳ,"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ὅτι ἦν ἀνὴρ ἀγαθὸς καὶ πλήρης πνεύματος ἁγίου καὶ πίστεως. καὶ προσετέθη ὄχλος ἱκανὸς τῷ κυρίῳ."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ἐξῆλθεν δὲ εἰς ⸀Ταρσὸν",
          {
            "noteId": 404
          },
          "ἀναζητῆσαι Σαῦλον,"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "καὶ εὑρὼν ⸀ἤγαγεν",
          {
            "noteId": 405
          },
          "εἰς Ἀντιόχειαν. ἐγένετο δὲ ⸂αὐτοῖς καὶ",
          {
            "noteId": 406
          },
          "ἐν",
          {
            "noteId": 407
          },
          "αυτὸν ὅλον συναχθῆναι ⸀ἐν τῇ ἐκκλησίᾳ καὶ διδάξαι ὄχλον ἱκανόν, χρηματίσαι τε ⸀πρώτως",
          {
            "noteId": 408
          },
          "ἐν Ἀντιοχείᾳ τοὺς μαθητὰς Χριστιανούς."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Ἐν ταύταις δὲ ταῖς ἡμέραις κατῆλθον ἀπὸ Ἱεροσολύμων προφῆται εἰς Ἀντιόχειαν·"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ἀναστὰς δὲ εἷς ἐξ αὐτῶν ὀνόματι Ἅγαβος ἐσήμανεν διὰ τοῦ πνεύματος λιμὸν ⸀μεγάλην",
          {
            "noteId": 409
          },
          "μέλλειν ἔσεσθαι ἐφʼ ὅλην τὴν οἰκουμένην· ⸀ἥτις",
          {
            "noteId": 410
          },
          "ἐγένετο ἐπὶ ⸀Κλαυδίου",
          {
            "noteId": 411
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "τῶν δὲ μαθητῶν καθὼς εὐπορεῖτό τις ὥρισαν ἕκαστος αὐτῶν εἰς διακονίαν πέμψαι τοῖς κατοικοῦσιν ἐν τῇ Ἰουδαίᾳ ἀδελφοῖς·"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ὃ καὶ ἐποίησαν ἀποστείλαντες πρὸς τοὺς πρεσβυτέρους διὰ χειρὸς Βαρναβᾶ καὶ Σαύλου."
        ]
      }
