  "chapter": {
    "number": 17,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Διοδεύσαντες δὲ τὴν",
          {
            "noteId": 620
          },
          "Ἀμφίπολιν καὶ ⸀τὴν Ἀπολλωνίαν ἦλθον εἰς Θεσσαλονίκην, ὅπου ⸀ἦν",
          {
            "noteId": 621
          },
          "συναγωγὴ τῶν Ἰουδαίων."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "κατὰ δὲ τὸ εἰωθὸς τῷ Παύλῳ εἰσῆλθεν πρὸς αὐτοὺς καὶ ἐπὶ σάββατα τρία διελέξατο αὐτοῖς ἀπὸ τῶν γραφῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "διανοίγων καὶ παρατιθέμενος ὅτι τὸν χριστὸν ἔδει παθεῖν καὶ ἀναστῆναι ἐκ νεκρῶν, καὶ ὅτι οὗτός ἐστιν ⸂ὁ χριστός, ὁ",
          {
            "noteId": 622
          },
          "Ἰησοῦς ὃν ἐγὼ καταγγέλλω ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καί τινες ἐξ αὐτῶν ἐπείσθησαν καὶ προσεκληρώθησαν τῷ Παύλῳ καὶ τῷ Σιλᾷ, τῶν τε σεβομένων Ἑλλήνων ⸂πλῆθος πολὺ",
          {
            "noteId": 623
          },
          "γυναικῶν τε τῶν πρώτων οὐκ ὀλίγαι."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "⸂ζηλώσαντες δὲ οἱ Ἰουδαῖοι καὶ προσλαβόμενοι",
          {
            "noteId": 624
          },
          "τῶν ἀγοραίων ⸂ἄνδρας τινὰς",
          {
            "noteId": 625
          },
          "πονηροὺς καὶ ὀχλοποιήσαντες ἐθορύβουν τὴν πόλιν, ⸂καὶ ἐπιστάντες",
          {
            "noteId": 626
          },
          "τῇ οἰκίᾳ Ἰάσονος ἐζήτουν αὐτοὺς ⸀προαγαγεῖν",
          {
            "noteId": 627
          },
          "εἰς τὸν δῆμον·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "μὴ εὑρόντες δὲ αὐτοὺς ⸀ἔσυρον",
          {
            "noteId": 628
          },
          "Ἰάσονα καί τινας ἀδελφοὺς ἐπὶ τοὺς πολιτάρχας, βοῶντες ὅτι Οἱ τὴν οἰκουμένην ἀναστατώσαντες οὗτοι καὶ ἐνθάδε πάρεισιν,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "οὓς ὑποδέδεκται Ἰάσων· καὶ οὗτοι πάντες ἀπέναντι τῶν δογμάτων Καίσαρος πράσσουσι, βασιλέα ⸂ἕτερον λέγοντες",
          {
            "noteId": 629
          },
          "εἶναι Ἰησοῦν."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἐτάραξαν δὲ τὸν ὄχλον καὶ τοὺς πολιτάρχας ἀκούοντας ταῦτα,"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ λαβόντες τὸ ἱκανὸν παρὰ τοῦ Ἰάσονος καὶ τῶν λοιπῶν ἀπέλυσαν αὐτούς."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Οἱ δὲ ἀδελφοὶ εὐθέως ⸀διὰ",
          {
            "noteId": 630
          },
          "νυκτὸς ἐξέπεμψαν τόν τε Παῦλον καὶ τὸν Σιλᾶν εἰς Βέροιαν, οἵτινες παραγενόμενοι εἰς τὴν συναγωγὴν ⸂τῶν Ἰουδαίων ἀπῄεσαν",
          {
            "noteId": 631
          },
          "·"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "οὗτοι δὲ ἦσαν εὐγενέστεροι τῶν ἐν Θεσσαλονίκῃ, οἵτινες ἐδέξαντο τὸ",
          {
            "noteId": 632
          },
          "λόγον μετὰ πάσης προθυμίας, ⸀τὸ καθʼ ἡμέραν ἀνακρίνοντες τὰς γραφὰς εἰ ἔχοι ταῦτα οὕτως."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "πολλοὶ μὲν οὖν ἐξ αὐτῶν ἐπίστευσαν, καὶ τῶν Ἑλληνίδων γυναικῶν τῶν εὐσχημόνων καὶ ἀνδρῶν οὐκ ὀλίγοι."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ὡς δὲ ἔγνωσαν οἱ ἀπὸ τῆς Θεσσαλονίκης Ἰουδαῖοι ὅτι καὶ ἐν τῇ Βεροίᾳ κατηγγέλη ὑπὸ τοῦ Παύλου ὁ λόγος τοῦ θεοῦ, ἦλθον κἀκεῖ σαλεύοντες ⸂καὶ ταράσσοντες",
          {
            "noteId": 633
          },
          "τοὺς ὄχλους."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "εὐθέως δὲ τότε τὸν Παῦλον ἐξαπέστειλαν οἱ ἀδελφοὶ πορεύεσθαι ⸀ἕως",
          {
            "noteId": 634
          },
          "ἐπὶ τὴν θάλασσαν· ⸂ὑπέμεινάν τε",
          {
            "noteId": 635
          },
          "ὅ τε Σιλᾶς καὶ ὁ Τιμόθεος ἐκεῖ."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "οἱ δὲ ⸀καθιστάνοντες",
          {
            "noteId": 636
          },
          "τὸν Παῦλον ⸀ἤγαγον",
          {
            "noteId": 637
          },
          "ἕως Ἀθηνῶν, καὶ λαβόντες ἐντολὴν πρὸς τὸν",
          {
            "noteId": 638
          },
          "Σιλᾶν καὶ ⸀τὸν Τιμόθεον ἵνα ὡς τάχιστα ἔλθωσιν πρὸς αὐτὸν ἐξῄεσαν."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Ἐν δὲ ταῖς Ἀθήναις ἐκδεχομένου αὐτοὺς τοῦ Παύλου, παρωξύνετο τὸ πνεῦμα αὐτοῦ ἐν αὐτῷ ⸀θεωροῦντος",
          {
            "noteId": 639
          },
          "κατείδωλον οὖσαν τὴν πόλιν."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "διελέγετο μὲν οὖν ἐν τῇ συναγωγῇ τοῖς Ἰουδαίοις καὶ τοῖς σεβομένοις καὶ ἐν τῇ ἀγορᾷ κατὰ πᾶσαν ἡμέραν πρὸς τοὺς παρατυγχάνοντας."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "τινὲς δὲ καὶ",
          {
            "noteId": 640
          },
          "τῶν Ἐπικουρείων ⸀καὶ Στοϊκῶν φιλοσόφων συνέβαλλον αὐτῷ, καί τινες ἔλεγον· Τί ἂν θέλοι ὁ σπερμολόγος οὗτος λέγειν; οἱ δέ· Ξένων δαιμονίων δοκεῖ καταγγελεὺς εἶναι· ὅτι τὸν Ἰησοῦν καὶ τὴν ἀνάστασιν εὐηγγελίζετο."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἐπιλαβόμενοί ⸀τε",
          {
            "noteId": 641
          },
          "αὐτοῦ ἐπὶ τὸν Ἄρειον Πάγον ἤγαγον, λέγοντες· Δυνάμεθα γνῶναι τίς ἡ καινὴ αὕτη ἡ ὑπὸ σοῦ λαλουμένη διδαχή;"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ξενίζοντα γάρ τινα εἰσφέρεις εἰς τὰς ἀκοὰς ἡμῶν· βουλόμεθα οὖν γνῶναι ⸂τίνα θέλει",
          {
            "noteId": 642
          },
          "ταῦτα εἶναι."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Ἀθηναῖοι δὲ πάντες καὶ οἱ ἐπιδημοῦντες ξένοι εἰς οὐδὲν ἕτερον ηὐκαίρουν ἢ",
          {
            "noteId": 643
          },
          "λέγειν τι",
          {
            "noteId": 644
          },
          "⸀ἢ ἀκούειν ⸀τι καινότερον."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Σταθεὶς ⸀δὲ",
          {
            "noteId": 645
          },
          "Παῦλος ἐν μέσῳ τοῦ Ἀρείου Πάγου ἔφη· Ἄνδρες Ἀθηναῖοι, κατὰ πάντα ὡς δεισιδαιμονεστέρους ὑμᾶς θεωρῶ·"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "διερχόμενος γὰρ καὶ ἀναθεωρῶν τὰ σεβάσματα ὑμῶν εὗρον καὶ βωμὸν ἐν ᾧ ἐπεγέγραπτο· Ἀγνώστῳ θεῷ. ⸀ὃ",
          {
            "noteId": 646
          },
          "οὖν ἀγνοοῦντες εὐσεβεῖτε, ⸀τοῦτο",
          {
            "noteId": 647
          },
          "ἐγὼ καταγγέλλω ὑμῖν."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ὁ θεὸς ὁ ποιήσας τὸν κόσμον καὶ πάντα τὰ ἐν αὐτῷ, οὗτος οὐρανοῦ καὶ γῆς ⸂ὑπάρχων κύριος",
          {
            "noteId": 648
          },
          "οὐκ ἐν χειροποιήτοις ναοῖς κατοικεῖ"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "οὐδὲ ὑπὸ χειρῶν ⸀ἀνθρωπίνων",
          {
            "noteId": 649
          },
          "θεραπεύεται προσδεόμενός τινος, αὐτὸς διδοὺς πᾶσι ζωὴν καὶ πνοὴν ⸂καὶ τὰ",
          {
            "noteId": 650
          },
          "πάντα·"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ἐποίησέν τε ἐξ ⸀ἑνὸς",
          {
            "noteId": 651
          },
          "πᾶν ἔθνος ἀνθρώπων κατοικεῖν ἐπὶ ⸂παντὸς προσώπου",
          {
            "noteId": 652
          },
          "τῆς γῆς, ὁρίσας προστεταγμένους καιροὺς καὶ τὰς ὁροθεσίας τῆς κατοικίας αὐτῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "ζητεῖν τὸν ⸀θεὸν",
          {
            "noteId": 653
          },
          "εἰ ἄρα γε ψηλαφήσειαν αὐτὸν καὶ εὕροιεν, καί γε οὐ μακρὰν ἀπὸ ἑνὸς ἑκάστου ἡμῶν ὑπάρχοντα."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ἐν αὐτῷ γὰρ ζῶμεν καὶ κινούμεθα καὶ ἐσμέν, ὡς καί τινες τῶν καθʼ ὑμᾶς ποιητῶν εἰρήκασιν· Τοῦ γὰρ καὶ γένος ἐσμέν."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "γένος οὖν ὑπάρχοντες τοῦ θεοῦ οὐκ ὀφείλομεν νομίζειν χρυσῷ ἢ ἀργύρῳ ἢ λίθῳ, χαράγματι τέχνης καὶ ἐνθυμήσεως ἀνθρώπου, τὸ θεῖον εἶναι ὅμοιον."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "τοὺς μὲν οὖν χρόνους τῆς ἀγνοίας ὑπεριδὼν ὁ θεὸς τὰ νῦν ⸀παραγγέλλει",
          {
            "noteId": 654
          },
          "τοῖς ἀνθρώποις ⸀πάντας",
          {
            "noteId": 655
          },
          "πανταχοῦ μετανοεῖν,"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "⸀καθότι",
          {
            "noteId": 656
          },
          "ἔστησεν ἡμέραν ἐν ᾗ μέλλει κρίνειν τὴν οἰκουμένην ἐν δικαιοσύνῃ ἐν ἀνδρὶ ᾧ ὥρισεν, πίστιν παρασχὼν πᾶσιν ἀναστήσας αὐτὸν ἐκ νεκρῶν."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Ἀκούσαντες δὲ ἀνάστασιν νεκρῶν οἱ μὲν ἐχλεύαζον οἱ δὲ εἶπαν Ἀκουσόμεθά σου ⸂περὶ τούτου καὶ πάλιν",
          {
            "noteId": 657
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "⸀οὕτως",
          {
            "noteId": 658
          },
          "ὁ Παῦλος ἐξῆλθεν ἐκ μέσου αὐτῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "τινὲς δὲ ἄνδρες κολληθέντες αὐτῷ ἐπίστευσαν, ἐν οἷς καὶ Διονύσιος ὁ Ἀρεοπαγίτης καὶ γυνὴ ὀνόματι Δάμαρις καὶ ἕτεροι σὺν αὐτοῖς."
        ]
      }
    ],
