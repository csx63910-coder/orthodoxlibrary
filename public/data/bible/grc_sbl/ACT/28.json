  "chapter": {
    "number": 28,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ διασωθέντες τότε ⸀ἐπέγνωμεν",
          {
            "noteId": 1050
          },
          "ὅτι ⸀Μελίτη",
          {
            "noteId": 1051
          },
          "ἡ νῆσος καλεῖται."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "οἵ ⸀τε",
          {
            "noteId": 1052
          },
          "βάρβαροι παρεῖχον οὐ τὴν τυχοῦσαν φιλανθρωπίαν ἡμῖν, ⸀ἅψαντες",
          {
            "noteId": 1053
          },
          "γὰρ πυρὰν προσελάβοντο πάντας ἡμᾶς διὰ τὸν ὑετὸν τὸν ἐφεστῶτα καὶ διὰ τὸ ψῦχος."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "συστρέψαντος δὲ τοῦ Παύλου φρυγάνων ⸀τι",
          {
            "noteId": 1054
          },
          "πλῆθος καὶ ἐπιθέντος ἐπὶ τὴν πυράν, ἔχιδνα ⸀ἀπὸ",
          {
            "noteId": 1055
          },
          "τῆς θέρμης ⸀ἐξελθοῦσα",
          {
            "noteId": 1056
          },
          "καθῆψε τῆς χειρὸς αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ὡς δὲ εἶδον οἱ βάρβαροι κρεμάμενον τὸ θηρίον ἐκ τῆς χειρὸς αὐτοῦ, ⸂πρὸς ἀλλήλους ἔλεγον",
          {
            "noteId": 1057
          },
          "· Πάντως φονεύς ἐστιν ὁ ἄνθρωπος οὗτος ὃν διασωθέντα ἐκ τῆς θαλάσσης ἡ δίκη ζῆν οὐκ εἴασεν."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ὁ μὲν οὖν ἀποτινάξας τὸ θηρίον εἰς τὸ πῦρ ἔπαθεν οὐδὲν κακόν·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "οἱ δὲ προσεδόκων αὐτὸν μέλλειν πίμπρασθαι ἢ καταπίπτειν ἄφνω νεκρόν. ἐπὶ πολὺ δὲ αὐτῶν προσδοκώντων καὶ θεωρούντων μηδὲν ἄτοπον εἰς αὐτὸν γινόμενον, ⸀μεταβαλόμενοι",
          {
            "noteId": 1058
          },
          "ἔλεγον ⸂αὐτὸν εἶναι θεόν",
          {
            "noteId": 1059
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "Ἐν δὲ τοῖς περὶ τὸν τόπον ἐκεῖνον ὑπῆρχεν χωρία τῷ πρώτῳ τῆς νήσου ὀνόματι Ποπλίῳ, ὃς ἀναδεξάμενος ἡμᾶς ⸂τρεῖς ἡμέρας",
          {
            "noteId": 1060
          },
          "φιλοφρόνως ἐξένισεν."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἐγένετο δὲ τὸν πατέρα τοῦ Ποπλίου πυρετοῖς καὶ ⸀δυσεντερίῳ",
          {
            "noteId": 1061
          },
          "συνεχόμενον κατακεῖσθαι, πρὸς ὃν ὁ Παῦλος εἰσελθὼν καὶ προσευξάμενος ἐπιθεὶς τὰς χεῖρας αὐτῷ ἰάσατο αὐτόν."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "τούτου ⸀δὲ",
          {
            "noteId": 1062
          },
          "γενομένου καὶ οἱ λοιποὶ οἱ ⸂ἐν τῇ νήσῳ ἔχοντες ἀσθενείας",
          {
            "noteId": 1063
          },
          "προσήρχοντο καὶ ἐθεραπεύοντο,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "οἳ καὶ πολλαῖς τιμαῖς ἐτίμησαν ἡμᾶς καὶ ἀναγομένοις ἐπέθεντο τὰ πρὸς ⸂τὰς χρείας",
          {
            "noteId": 1064
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Μετὰ δὲ τρεῖς μῆνας ⸀ἀνήχθημεν",
          {
            "noteId": 1065
          },
          "ἐν πλοίῳ παρακεχειμακότι ἐν τῇ νήσῳ Ἀλεξανδρίνῳ, παρασήμῳ Διοσκούροις."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "καὶ καταχθέντες εἰς Συρακούσας ἐπεμείναμεν ἡμέρας τρεῖς,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ὅθεν ⸀περιελόντες",
          {
            "noteId": 1066
          },
          "κατηντήσαμεν εἰς Ῥήγιον. καὶ μετὰ μίαν ἡμέραν ἐπιγενομένου νότου δευτεραῖοι ἤλθομεν εἰς Ποτιόλους,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "οὗ εὑρόντες ἀδελφοὺς παρεκλήθημεν ⸀παρʼ",
          {
            "noteId": 1067
          },
          "αὐτοῖς ἐπιμεῖναι ἡμέρας ἑπτά· καὶ οὕτως εἰς τὴν Ῥώμην ἤλθαμεν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "κἀκεῖθεν οἱ ἀδελφοὶ ἀκούσαντες τὰ περὶ ἡμῶν ⸀ἦλθαν",
          {
            "noteId": 1068
          },
          "εἰς ἀπάντησιν ἡμῖν ἄχρι Ἀππίου Φόρου καὶ Τριῶν Ταβερνῶν, οὓς ἰδὼν ὁ Παῦλος εὐχαριστήσας τῷ θεῷ ἔλαβε θάρσος."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Ὅτε δὲ ⸀εἰσήλθομεν",
          {
            "noteId": 1069
          },
          "εἰς Ῥώμην, ⸂ἐπετράπη τῷ Παύλῳ",
          {
            "noteId": 1070
          },
          "μένειν καθʼ ἑαυτὸν σὺν τῷ φυλάσσοντι αὐτὸν στρατιώτῃ."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Ἐγένετο δὲ μετὰ ἡμέρας τρεῖς συγκαλέσασθαι ⸀αὐτὸν",
          {
            "noteId": 1071
          },
          "τοὺς ὄντας τῶν Ἰουδαίων πρώτους· συνελθόντων δὲ αὐτῶν ἔλεγεν πρὸς αὐτούς· ⸂Ἐγώ, ἄνδρες ἀδελφοί⸃, οὐδὲν ἐναντίον ποιήσας τῷ λαῷ ἢ τοῖς ἔθεσι τοῖς πατρῴοις δέσμιος ἐξ Ἱεροσολύμων παρεδόθην εἰς τὰς χεῖρας τῶν Ῥωμαίων,",
          {
            "noteId": 1072
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "οἵτινες ἀνακρίναντές με ἐβούλοντο ἀπολῦσαι διὰ τὸ μηδεμίαν αἰτίαν θανάτου ὑπάρχειν ἐν ἐμοί·"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἀντιλεγόντων δὲ τῶν Ἰουδαίων ἠναγκάσθην ἐπικαλέσασθαι Καίσαρα, οὐχ ὡς τοῦ ἔθνους μου ἔχων τι ⸀κατηγορεῖν",
          {
            "noteId": 1073
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "διὰ ταύτην οὖν τὴν αἰτίαν παρεκάλεσα ὑμᾶς ἰδεῖν καὶ προσλαλῆσαι, ἕνεκεν γὰρ τῆς ἐλπίδος τοῦ Ἰσραὴλ τὴν ἅλυσιν ταύτην περίκειμαι."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "οἱ δὲ πρὸς αὐτὸν εἶπαν· Ἡμεῖς οὔτε γράμματα περὶ σοῦ ἐδεξάμεθα ἀπὸ τῆς Ἰουδαίας, οὔτε παραγενόμενός τις τῶν ἀδελφῶν ἀπήγγειλεν ἢ ἐλάλησέν τι περὶ σοῦ πονηρόν."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ἀξιοῦμεν δὲ παρὰ σοῦ ἀκοῦσαι ἃ φρονεῖς, περὶ μὲν γὰρ τῆς αἱρέσεως ταύτης γνωστὸν ⸂ἡμῖν ἐστιν",
          {
            "noteId": 1074
          },
          "ὅτι πανταχοῦ ἀντιλέγεται."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Ταξάμενοι δὲ αὐτῷ ἡμέραν ⸀ἧκον",
          {
            "noteId": 1075
          },
          "πρὸς αὐτὸν εἰς τὴν ξενίαν πλείονες, οἷς ἐξετίθετο διαμαρτυρόμενος τὴν βασιλείαν τοῦ θεοῦ πείθων τε ⸀αὐτοὺς",
          {
            "noteId": 1076
          },
          "περὶ τοῦ Ἰησοῦ ἀπό τε τοῦ νόμου Μωϋσέως καὶ τῶν προφητῶν ἀπὸ πρωῒ ἕως ἑσπέρας."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "καὶ οἱ μὲν ἐπείθοντο τοῖς λεγομένοις οἱ δὲ ἠπίστουν,"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ἀσύμφωνοι δὲ ὄντες πρὸς ἀλλήλους ἀπελύοντο, εἰπόντος τοῦ Παύλου ῥῆμα ἓν ὅτι Καλῶς τὸ πνεῦμα τὸ ἅγιον ἐλάλησεν διὰ Ἠσαΐου τοῦ προφήτου πρὸς τοὺς πατέρας ⸀ὑμῶν",
          {
            "noteId": 1077
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "⸀λέγων",
          {
            "noteId": 1078
          },
          "Πορεύθητι πρὸς τὸν λαὸν τοῦτον καὶ εἰπόν· Ἀκοῇ ἀκούσετε καὶ οὐ μὴ συνῆτε, καὶ βλέποντες βλέψετε καὶ οὐ μὴ ἴδητε·"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "ἐπαχύνθη γὰρ ἡ καρδία τοῦ λαοῦ τούτου, καὶ τοῖς ὠσὶν βαρέως ἤκουσαν, καὶ τοὺς ὀφθαλμοὺς αὐτῶν ἐκάμμυσαν· μήποτε ἴδωσιν τοῖς ὀφθαλμοῖς καὶ τοῖς ὠσὶν ἀκούσωσιν καὶ τῇ καρδίᾳ συνῶσιν καὶ ἐπιστρέψωσιν, καὶ ἰάσομαι αὐτούς."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "γνωστὸν οὖν ⸂ἔστω ὑμῖν",
          {
            "noteId": 1079
          },
          "ὅτι τοῖς ἔθνεσιν ἀπεστάλη ⸀τοῦτο",
          {
            "noteId": 1080
          },
          "τὸ σωτήριον τοῦ θεοῦ· αὐτοὶ καὶ ⸀ἀκούσονται",
          {
            "noteId": 1081
          }
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "⸀Ἐνέμεινεν",
          {
            "noteId": 1082
          },
          "⸀δὲ",
          {
            "noteId": 1083
          },
          "διετίαν ὅλην ἐν ἰδίῳ μισθώματι, καὶ ἀπεδέχετο πάντας τοὺς εἰσπορευομένους πρὸς αὐτόν,"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "κηρύσσων τὴν βασιλείαν τοῦ θεοῦ καὶ διδάσκων τὰ περὶ τοῦ κυρίου Ἰησοῦ Χριστοῦ μετὰ πάσης παρρησίας ἀκωλύτως. ‘/book’"
        ]
      }
    ],
