  "chapter": {
    "number": 26,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἀγρίππας δὲ πρὸς τὸν Παῦλον ἔφη· Ἐπιτρέπεταί σοι ⸀ὑπὲρ",
          {
            "noteId": 971
          },
          "σεαυτοῦ λέγειν. τότε ὁ Παῦλος ⸂ἐκτείνας τὴν χεῖρα ἀπελογεῖτο",
          {
            "noteId": 972
          },
          "·"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "Περὶ πάντων ὧν ἐγκαλοῦμαι ὑπὸ Ἰουδαίων, βασιλεῦ Ἀγρίππα, ἥγημαι ἐμαυτὸν μακάριον ἐπὶ σοῦ μέλλων ⸂σήμερον ἀπολογεῖσθαι",
          {
            "noteId": 973
          },
          ","
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "μάλιστα γνώστην ὄντα σε πάντων τῶν κατὰ Ἰουδαίους ⸀ἐθῶν",
          {
            "noteId": 974
          },
          "τε καὶ ζητημάτων· διὸ ⸀δέομαι",
          {
            "noteId": 975
          },
          "μακροθύμως ἀκοῦσαί μου."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "Τὴν μὲν οὖν βίωσίν μου ⸀τὴν",
          {
            "noteId": 976
          },
          "ἐκ νεότητος τὴν ἀπʼ ἀρχῆς γενομένην ἐν τῷ ἔθνει μου ἔν ⸀τε",
          {
            "noteId": 977
          },
          "Ἱεροσολύμοις ἴσασι ⸀πάντες",
          {
            "noteId": 978
          },
          "Ἰουδαῖοι,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "προγινώσκοντές με ἄνωθεν, ἐὰν θέλωσι μαρτυρεῖν, ὅτι κατὰ τὴν ἀκριβεστάτην αἵρεσιν τῆς ἡμετέρας θρησκείας ἔζησα Φαρισαῖος."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ νῦν ἐπʼ ἐλπίδι τῆς ⸀εἰς",
          {
            "noteId": 979
          },
          "τοὺς πατέρας ⸀ἡμῶν",
          {
            "noteId": 980
          },
          "ἐπαγγελίας γενομένης ὑπὸ τοῦ θεοῦ ἕστηκα κρινόμενος,"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "εἰς ἣν τὸ δωδεκάφυλον ἡμῶν ἐν ἐκτενείᾳ νύκτα καὶ ἡμέραν λατρεῦον ἐλπίζει καταντῆσαι· περὶ ἧς ἐλπίδος ἐγκαλοῦμαι ⸂ὑπὸ Ἰουδαίων, βασιλεῦ⸃·",
          {
            "noteId": 981
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "τί ἄπιστον κρίνεται παρʼ ὑμῖν εἰ ὁ θεὸς νεκροὺς ἐγείρει;"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Ἐγὼ μὲν οὖν ἔδοξα ἐμαυτῷ πρὸς τὸ ὄνομα Ἰησοῦ τοῦ Ναζωραίου δεῖν πολλὰ ἐναντία πρᾶξαι·"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "ὃ καὶ ἐποίησα ἐν Ἱεροσολύμοις, καὶ πολλούς ⸀τε",
          {
            "noteId": 982
          },
          "τῶν ἁγίων ἐγὼ ⸀ἐν",
          {
            "noteId": 983
          },
          "φυλακαῖς κατέκλεισα τὴν παρὰ τῶν ἀρχιερέων ἐξουσίαν λαβών, ἀναιρουμένων τε αὐτῶν κατήνεγκα ψῆφον,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ κατὰ πάσας τὰς συναγωγὰς πολλάκις τιμωρῶν αὐτοὺς ἠνάγκαζον βλασφημεῖν, περισσῶς τε ἐμμαινόμενος αὐτοῖς ἐδίωκον ἕως καὶ εἰς τὰς ἔξω πόλεις."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ἐν ⸀οἷς",
          {
            "noteId": 984
          },
          "πορευόμενος εἰς τὴν Δαμασκὸν μετʼ ἐξουσίας καὶ ἐπιτροπῆς ⸀τῆς",
          {
            "noteId": 985
          },
          "τῶν ἀρχιερέων"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ἡμέρας μέσης κατὰ τὴν ὁδὸν εἶδον, βασιλεῦ, οὐρανόθεν ὑπὲρ τὴν λαμπρότητα τοῦ ἡλίου περιλάμψαν με φῶς καὶ τοὺς σὺν ἐμοὶ πορευομένους·"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "πάντων ⸀τε",
          {
            "noteId": 986
          },
          "καταπεσόντων ἡμῶν εἰς τὴν γῆν ἤκουσα φωνὴν ⸀λέγουσαν",
          {
            "noteId": 987
          },
          "πρός ⸀με",
          {
            "noteId": 988
          },
          "τῇ Ἑβραΐδι διαλέκτῳ· Σαοὺλ Σαούλ, τί με διώκεις; σκληρόν σοι πρὸς κέντρα λακτίζειν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ἐγὼ δὲ εἶπα· Τίς εἶ, κύριε; ὁ δὲ ⸀κύριος",
          {
            "noteId": 989
          },
          "εἶπεν· Ἐγώ εἰμι Ἰησοῦς ὃν σὺ διώκεις·"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ἀλλὰ ἀνάστηθι καὶ στῆθι ἐπὶ τοὺς πόδας σου· εἰς τοῦτο γὰρ ὤφθην σοι, προχειρίσασθαί σε ὑπηρέτην καὶ μάρτυρα ὧν τε εἶδές ⸀με",
          {
            "noteId": 990
          },
          "ὧν τε ὀφθήσομαί σοι,"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ἐξαιρούμενός σε ἐκ",
          {
            "noteId": 991
          },
          "τοῦ λαοῦ καὶ ⸀ἐκ τῶν ἐθνῶν, εἰς οὓς ἐγὼ ⸂ἀποστέλλω σε",
          {
            "noteId": 992
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ἀνοῖξαι ὀφθαλμοὺς αὐτῶν, τοῦ ⸀ἐπιστρέψαι",
          {
            "noteId": 993
          },
          "ἀπὸ σκότους εἰς φῶς καὶ τῆς ἐξουσίας τοῦ Σατανᾶ ἐπὶ τὸν θεόν, τοῦ λαβεῖν αὐτοὺς ἄφεσιν ἁμαρτιῶν καὶ κλῆρον ἐν τοῖς ἡγιασμένοις πίστει τῇ εἰς ἐμέ."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Ὅθεν, βασιλεῦ Ἀγρίππα, οὐκ ἐγενόμην ἀπειθὴς τῇ οὐρανίῳ ὀπτασίᾳ,"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἀλλὰ τοῖς ἐν Δαμασκῷ πρῶτόν ⸀τε",
          {
            "noteId": 994
          },
          "καὶ Ἱεροσολύμοις, ⸀πᾶσάν",
          {
            "noteId": 995
          },
          "τε τὴν χώραν τῆς Ἰουδαίας, καὶ τοῖς ἔθνεσιν ⸀ἀπήγγελλον",
          {
            "noteId": 996
          },
          "μετανοεῖν καὶ ἐπιστρέφειν ἐπὶ τὸν θεόν, ἄξια τῆς μετανοίας ἔργα πράσσοντας."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ἕνεκα τούτων ⸂με Ἰουδαῖοι",
          {
            "noteId": 997
          },
          "⸀συλλαβόμενοι",
          {
            "noteId": 998
          },
          "ἐν τῷ ἱερῷ ἐπειρῶντο διαχειρίσασθαι."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ἐπικουρίας οὖν τυχὼν τῆς ⸀ἀπὸ",
          {
            "noteId": 999
          },
          "τοῦ θεοῦ ἄχρι τῆς ἡμέρας ταύτης ἕστηκα μαρτυρόμενος μικρῷ τε καὶ μεγάλῳ, οὐδὲν ἐκτὸς λέγων ὧν τε οἱ προφῆται ἐλάλησαν μελλόντων γίνεσθαι καὶ Μωϋσῆς,"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "εἰ παθητὸς ὁ χριστός, εἰ πρῶτος ἐξ ἀναστάσεως νεκρῶν φῶς μέλλει καταγγέλλειν τῷ ⸀τε",
          {
            "noteId": 1000
          },
          "λαῷ καὶ τοῖς ἔθνεσιν."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Ταῦτα δὲ αὐτοῦ ἀπολογουμένου ὁ Φῆστος μεγάλῃ τῇ φωνῇ ⸀φησιν",
          {
            "noteId": 1001
          },
          "Μαίνῃ, Παῦλε· τὰ πολλά σε γράμματα εἰς μανίαν περιτρέπει."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ὁ δὲ ⸀Παῦλος",
          {
            "noteId": 1002
          },
          "Οὐ μαίνομαι, φησίν, κράτιστε Φῆστε, ἀλλὰ ἀληθείας καὶ σωφροσύνης ῥήματα ἀποφθέγγομαι."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ἐπίσταται γὰρ περὶ τούτων ὁ βασιλεύς, πρὸς ὃν ⸀καὶ",
          {
            "noteId": 1003
          },
          "παρρησιαζόμενος λαλῶ· λανθάνειν γὰρ ⸀αὐτὸν",
          {
            "noteId": 1004
          },
          "τούτων οὐ πείθομαι ⸀οὐθέν",
          {
            "noteId": 1005
          },
          "οὐ γάρ ⸀ἐστιν",
          {
            "noteId": 1006
          },
          "ἐν γωνίᾳ πεπραγμένον τοῦτο."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "πιστεύεις, βασιλεῦ Ἀγρίππα, τοῖς προφήταις; οἶδα ὅτι πιστεύεις."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ὁ δὲ Ἀγρίππας πρὸς τὸν ⸀Παῦλον",
          {
            "noteId": 1007
          },
          "Ἐν ὀλίγῳ με πείθεις Χριστιανὸν ⸀ποιῆσαι",
          {
            "noteId": 1008
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "ὁ δὲ ⸀Παῦλος",
          {
            "noteId": 1009
          },
          "Εὐξαίμην ἂν τῷ θεῷ καὶ ἐν ὀλίγῳ καὶ ἐν ⸀μεγάλῳ",
          {
            "noteId": 1010
          },
          "οὐ μόνον σὲ ἀλλὰ καὶ πάντας τοὺς ἀκούοντάς μου σήμερον γενέσθαι τοιούτους ὁποῖος καὶ ἐγώ εἰμι παρεκτὸς τῶν δεσμῶν τούτων."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "⸀Ἀνέστη",
          {
            "noteId": 1011
          },
          "⸀τε",
          {
            "noteId": 1012
          },
          "ὁ βασιλεὺς καὶ ὁ ἡγεμὼν ἥ τε Βερνίκη καὶ οἱ συγκαθήμενοι αὐτοῖς,"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "καὶ ἀναχωρήσαντες ἐλάλουν πρὸς ἀλλήλους λέγοντες ὅτι Οὐδὲν θανάτου ⸂ἢ δεσμῶν ἄξιον",
          {
            "noteId": 1013
          },
          "⸀τι",
          {
            "noteId": 1014
          },
          "πράσσει ὁ ἄνθρωπος οὗτος."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Ἀγρίππας δὲ τῷ Φήστῳ ἔφη· Ἀπολελύσθαι ἐδύνατο ὁ ἄνθρωπος οὗτος εἰ μὴ ἐπεκέκλητο Καίσαρα."
        ]
      }
    ],
