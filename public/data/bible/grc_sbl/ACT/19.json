  "chapter": {
    "number": 19,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ἐγένετο δὲ ἐν τῷ τὸν Ἀπολλῶ εἶναι ἐν Κορίνθῳ Παῦλον διελθόντα τὰ ἀνωτερικὰ μέρη ⸀ἐλθεῖν",
          {
            "noteId": 690
          },
          "εἰς Ἔφεσον καὶ ⸀εὑρεῖν",
          {
            "noteId": 691
          },
          "τινας μαθητάς,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "εἶπέν ⸀τε",
          {
            "noteId": 692
          },
          "πρὸς αὐτούς· Εἰ πνεῦμα ἅγιον ἐλάβετε πιστεύσαντες; οἱ ⸀δὲ",
          {
            "noteId": 693
          },
          "πρὸς αὐτόν· Ἀλλʼ οὐδʼ εἰ πνεῦμα ἅγιον ἔστιν ἠκούσαμεν."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "εἶπέν ⸀τε",
          {
            "noteId": 694
          },
          "Εἰς τί οὖν ἐβαπτίσθητε; οἱ δὲ εἶπαν· Εἰς τὸ Ἰωάννου βάπτισμα."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "εἶπεν δὲ Παῦλος· ⸀Ἰωάννης",
          {
            "noteId": 695
          },
          "ἐβάπτισεν βάπτισμα μετανοίας, τῷ λαῷ λέγων εἰς τὸν",
          {
            "noteId": 696
          },
          "ἐρχόμενον μετʼ αὐτὸν ἵνα πιστεύσωσιν, τοῦτʼ ἔστιν εἰς ⸀τὸν Ἰησοῦν."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἀκούσαντες δὲ ἐβαπτίσθησαν εἰς τὸ ὄνομα τοῦ κυρίου Ἰησοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "καὶ ἐπιθέντος αὐτοῖς τοῦ ⸀Παύλου",
          {
            "noteId": 697
          },
          "χεῖρας ἦλθε τὸ πνεῦμα τὸ ἅγιον ἐπʼ αὐτούς, ἐλάλουν τε γλώσσαις καὶ ἐπροφήτευον."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἦσαν δὲ οἱ πάντες ἄνδρες ὡσεὶ ⸀δώδεκα",
          {
            "noteId": 698
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "Εἰσελθὼν δὲ εἰς τὴν συναγωγὴν ἐπαρρησιάζετο ἐπὶ μῆνας τρεῖς διαλεγόμενος καὶ ⸀πείθων",
          {
            "noteId": 699
          },
          "περὶ τῆς βασιλείας τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "ὡς δέ τινες ἐσκληρύνοντο καὶ ἠπείθουν κακολογοῦντες τὴν ὁδὸν ἐνώπιον τοῦ πλήθους, ἀποστὰς ἀπʼ αὐτῶν ἀφώρισεν τοὺς μαθητάς, καθʼ ἡμέραν διαλεγόμενος ἐν τῇ σχολῇ ⸀Τυράννου",
          {
            "noteId": 700
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "τοῦτο δὲ ἐγένετο ἐπὶ ἔτη δύο, ὥστε πάντας τοὺς κατοικοῦντας τὴν Ἀσίαν ἀκοῦσαι τὸν λόγον τοῦ ⸀κυρίου",
          {
            "noteId": 701
          },
          "Ἰουδαίους τε καὶ Ἕλληνας."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Δυνάμεις τε οὐ τὰς τυχούσας ⸂ὁ θεὸς ἐποίει",
          {
            "noteId": 702
          },
          "διὰ τῶν χειρῶν Παύλου,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ὥστε καὶ ἐπὶ τοὺς ἀσθενοῦντας ⸀ἀποφέρεσθαι",
          {
            "noteId": 703
          },
          "ἀπὸ τοῦ χρωτὸς αὐτοῦ σουδάρια ἢ σιμικίνθια καὶ ἀπαλλάσσεσθαι ἀπʼ αὐτῶν τὰς νόσους, τά τε πνεύματα τὰ πονηρὰ ⸀ἐκπορεύεσθαι",
          {
            "noteId": 704
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ἐπεχείρησαν δέ τινες ⸀καὶ",
          {
            "noteId": 705
          },
          "τῶν περιερχομένων Ἰουδαίων ἐξορκιστῶν ὀνομάζειν ἐπὶ τοὺς ἔχοντας τὰ πνεύματα τὰ πονηρὰ τὸ ὄνομα τοῦ κυρίου Ἰησοῦ λέγοντες· ⸀Ὁρκίζω",
          {
            "noteId": 706
          },
          "ὑμᾶς τὸν Ἰησοῦν ⸀ὃν",
          {
            "noteId": 707
          },
          "Παῦλος κηρύσσει."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ἦσαν δέ ⸀τινος",
          {
            "noteId": 708
          },
          "Σκευᾶ Ἰουδαίου ἀρχιερέως ἑπτὰ ⸀υἱοὶ",
          {
            "noteId": 709
          },
          "τοῦτο ποιοῦντες."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ἀποκριθὲν δὲ τὸ πνεῦμα τὸ πονηρὸν εἶπεν ⸀αὐτοῖς",
          {
            "noteId": 710
          },
          "⸀Τὸν",
          {
            "noteId": 711
          },
          "Ἰησοῦν γινώσκω καὶ τὸν Παῦλον ἐπίσταμαι, ὑμεῖς δὲ τίνες ἐστέ;"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "καὶ ⸀ἐφαλόμενος",
          {
            "noteId": 712
          },
          "⸂ὁ ἄνθρωπος ἐπʼ αὐτοὺς",
          {
            "noteId": 713
          },
          "ἐν ᾧ ἦν τὸ πνεῦμα τὸ πονηρὸν ⸂κατακυριεύσας ἀμφοτέρων",
          {
            "noteId": 714
          },
          "ἴσχυσεν κατʼ αὐτῶν, ὥστε γυμνοὺς καὶ τετραυματισμένους ἐκφυγεῖν ἐκ τοῦ οἴκου ἐκείνου."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "τοῦτο δὲ ἐγένετο γνωστὸν πᾶσιν Ἰουδαίοις τε καὶ Ἕλλησιν τοῖς κατοικοῦσιν τὴν Ἔφεσον, καὶ ⸀ἐπέπεσεν",
          {
            "noteId": 715
          },
          "φόβος ἐπὶ πάντας αὐτούς, καὶ ἐμεγαλύνετο τὸ ὄνομα τοῦ κυρίου Ἰησοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "πολλοί τε τῶν πεπιστευκότων ἤρχοντο ἐξομολογούμενοι καὶ ἀναγγέλλοντες τὰς πράξεις αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ἱκανοὶ δὲ τῶν τὰ περίεργα πραξάντων συνενέγκαντες τὰς βίβλους κατέκαιον ἐνώπιον πάντων· καὶ συνεψήφισαν τὰς τιμὰς αὐτῶν καὶ εὗρον ἀργυρίου μυριάδας πέντε."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "οὕτως κατὰ κράτος ⸂τοῦ κυρίου ὁ λόγος",
          {
            "noteId": 716
          },
          "ηὔξανεν καὶ ἴσχυεν."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Ὡς δὲ ἐπληρώθη ταῦτα, ἔθετο ὁ Παῦλος ἐν τῷ πνεύματι διελθὼν τὴν Μακεδονίαν καὶ Ἀχαΐαν πορεύεσθαι εἰς ⸀Ἱεροσόλυμα",
          {
            "noteId": 717
          },
          "εἰπὼν ὅτι Μετὰ τὸ γενέσθαι με ἐκεῖ δεῖ με καὶ Ῥώμην ἰδεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ἀποστείλας δὲ εἰς τὴν Μακεδονίαν δύο τῶν διακονούντων αὐτῷ, Τιμόθεον καὶ Ἔραστον, αὐτὸς ἐπέσχεν χρόνον εἰς τὴν Ἀσίαν."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Ἐγένετο δὲ κατὰ τὸν καιρὸν ἐκεῖνον τάραχος οὐκ ὀλίγος περὶ τῆς ὁδοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Δημήτριος γάρ τις ὀνόματι, ἀργυροκόπος, ποιῶν ναοὺς ἀργυροῦς Ἀρτέμιδος παρείχετο τοῖς τεχνίταις ⸂οὐκ ὀλίγην ἐργασίαν",
          {
            "noteId": 718
          },
          ","
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "οὓς συναθροίσας καὶ τοὺς περὶ τὰ τοιαῦτα ἐργάτας εἶπεν· Ἄνδρες, ἐπίστασθε ὅτι ἐκ ταύτης τῆς ἐργασίας ἡ εὐπορία ⸀ἡμῖν",
          {
            "noteId": 719
          },
          "ἐστιν,"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "καὶ θεωρεῖτε καὶ ἀκούετε ὅτι οὐ μόνον Ἐφέσου ἀλλὰ σχεδὸν πάσης τῆς Ἀσίας ὁ Παῦλος οὗτος πείσας μετέστησεν ἱκανὸν ὄχλον, λέγων ὅτι οὐκ εἰσὶν θεοὶ οἱ διὰ χειρῶν γινόμενοι."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "οὐ μόνον δὲ τοῦτο κινδυνεύει ἡμῖν τὸ μέρος εἰς ἀπελεγμὸν ἐλθεῖν, ἀλλὰ καὶ τὸ τῆς μεγάλης θεᾶς ⸂Ἀρτέμιδος ἱερὸν",
          {
            "noteId": 720
          },
          "εἰς οὐθὲν λογισθῆναι, μέλλειν ⸀τε",
          {
            "noteId": 721
          },
          "καὶ καθαιρεῖσθαι ⸂τῆς μεγαλειότητος",
          {
            "noteId": 722
          },
          "αὐτῆς, ἣν ὅλη ἡ Ἀσία καὶ ἡ οἰκουμένη σέβεται."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "Ἀκούσαντες δὲ καὶ γενόμενοι πλήρεις θυμοῦ ἔκραζον λέγοντες· Μεγάλη ἡ Ἄρτεμις Ἐφεσίων."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "καὶ ἐπλήσθη ἡ ⸀πόλις",
          {
            "noteId": 723
          },
          "τῆς συγχύσεως, ὥρμησάν τε ὁμοθυμαδὸν εἰς τὸ θέατρον συναρπάσαντες Γάϊον καὶ Ἀρίσταρχον Μακεδόνας, συνεκδήμους Παύλου."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "⸂Παύλου δὲ",
          {
            "noteId": 724
          },
          "βουλομένου εἰσελθεῖν εἰς τὸν δῆμον οὐκ εἴων αὐτὸν οἱ μαθηταί·"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "τινὲς δὲ καὶ τῶν Ἀσιαρχῶν, ὄντες αὐτῷ φίλοι, πέμψαντες πρὸς αὐτὸν παρεκάλουν μὴ δοῦναι ἑαυτὸν εἰς τὸ θέατρον."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "ἄλλοι μὲν οὖν ἄλλο τι ἔκραζον, ἦν γὰρ ἡ ἐκκλησία συγκεχυμένη, καὶ οἱ πλείους οὐκ ᾔδεισαν τίνος ἕνεκα συνεληλύθεισαν."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "ἐκ δὲ τοῦ ὄχλου ⸀συνεβίβασαν",
          {
            "noteId": 725
          },
          "Ἀλέξανδρον προβαλόντων αὐτὸν τῶν Ἰουδαίων, ὁ δὲ Ἀλέξανδρος κατασείσας τὴν χεῖρα ἤθελεν ἀπολογεῖσθαι τῷ δήμῳ."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "ἐπιγνόντες δὲ ὅτι Ἰουδαῖός ἐστιν φωνὴ ἐγένετο μία ἐκ πάντων ⸀ὡς",
          {
            "noteId": 726
          },
          "ἐπὶ ὥρας δύο κραζόντων· Μεγάλη ἡ Ἄρτεμις Ἐφεσίων."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "καταστείλας δὲ ⸂ὁ γραμματεὺς τὸν ὄχλον",
          {
            "noteId": 727
          },
          "φησίν· Ἄνδρες Ἐφέσιοι, τίς γάρ ἐστιν ⸀ἀνθρώπων",
          {
            "noteId": 728
          },
          "ὃς οὐ γινώσκει τὴν Ἐφεσίων πόλιν νεωκόρον οὖσαν τῆς ⸀μεγάλης",
          {
            "noteId": 729
          },
          "Ἀρτέμιδος καὶ τοῦ διοπετοῦς;"
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "ἀναντιρρήτων οὖν ὄντων τούτων δέον ἐστὶν ὑμᾶς κατεσταλμένους ὑπάρχειν καὶ μηδὲν προπετὲς πράσσειν."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "ἠγάγετε γὰρ τοὺς ἄνδρας τούτους οὔτε ἱεροσύλους οὔτε βλασφημοῦντας τὴν θεὸν ⸀ἡμῶν",
          {
            "noteId": 730
          }
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "εἰ μὲν οὖν Δημήτριος καὶ οἱ σὺν αὐτῷ τεχνῖται ἔχουσιν πρός τινα λόγον, ἀγοραῖοι ἄγονται καὶ ἀνθύπατοί εἰσιν, ἐγκαλείτωσαν ἀλλήλοις."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "εἰ δέ τι ⸀περαιτέρω",
          {
            "noteId": 731
          },
          "ἐπιζητεῖτε, ἐν τῇ ἐννόμῳ ἐκκλησίᾳ ἐπιλυθήσεται."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "καὶ γὰρ κινδυνεύομεν ἐγκαλεῖσθαι στάσεως περὶ τῆς σήμερον μηδενὸς αἰτίου ὑπάρχοντος περὶ οὗ οὐ δυνησόμεθα ⸀ἀποδοῦναι",
          {
            "noteId": 732
          },
          "λόγον ⸀περὶ",
          {
            "noteId": 733
          },
          "τῆς συστροφῆς ταύτης. καὶ ταῦτα εἰπὼν ἀπέλυσεν τὴν ἐκκλησίαν."
        ]
      }
    ],
