  "chapter": {
    "number": 9,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ὁ δὲ Σαῦλος ἔτι ἐμπνέων ἀπειλῆς καὶ φόνου εἰς τοὺς μαθητὰς τοῦ κυρίου, προσελθὼν τῷ ἀρχιερεῖ"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ᾐτήσατο παρʼ αὐτοῦ ἐπιστολὰς εἰς Δαμασκὸν πρὸς τὰς συναγωγάς, ὅπως ἐάν τινας εὕρῃ τῆς ὁδοῦ ὄντας, ἄνδρας τε καὶ γυναῖκας, δεδεμένους ἀγάγῃ εἰς Ἰερουσαλήμ."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "ἐν δὲ τῷ πορεύεσθαι ἐγένετο αὐτὸν ἐγγίζειν τῇ Δαμασκῷ, ⸂ἐξαίφνης τε αὐτὸν περιήστραψεν",
          {
            "noteId": 281
          },
          "φῶς ⸀ἐκ",
          {
            "noteId": 282
          },
          "τοῦ οὐρανοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ πεσὼν ἐπὶ τὴν γῆν ἤκουσεν φωνὴν λέγουσαν αὐτῷ Σαοὺλ Σαούλ, τί με διώκεις;"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "εἶπεν δέ",
          {
            "noteId": 283
          },
          "Τίς εἶ, κύριε; ὁ ⸀δέ· Ἐγώ εἰμι Ἰησοῦς ὃν σὺ διώκεις·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ἀλλὰ ἀνάστηθι καὶ εἴσελθε εἰς τὴν πόλιν, καὶ λαληθήσεταί σοι ⸂ὅ τί",
          {
            "noteId": 284
          },
          "σε δεῖ ποιεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "οἱ δὲ ἄνδρες οἱ συνοδεύοντες αὐτῷ εἱστήκεισαν ἐνεοί, ἀκούοντες μὲν τῆς φωνῆς μηδένα δὲ θεωροῦντες."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἠγέρθη δὲ ⸀Σαῦλος",
          {
            "noteId": 285
          },
          "ἀπὸ τῆς γῆς, ἀνεῳγμένων ⸀δὲ",
          {
            "noteId": 286
          },
          "τῶν ὀφθαλμῶν αὐτοῦ ⸀οὐδὲν",
          {
            "noteId": 287
          },
          "ἔβλεπεν· χειραγωγοῦντες δὲ αὐτὸν εἰσήγαγον εἰς Δαμασκόν."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ ἦν ἡμέρας τρεῖς μὴ βλέπων, καὶ οὐκ ἔφαγεν οὐδὲ ἔπιεν."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Ἦν δέ τις μαθητὴς ἐν Δαμασκῷ ὀνόματι Ἁνανίας, καὶ εἶπεν πρὸς αὐτὸν ⸂ἐν ὁράματι ὁ κύριος",
          {
            "noteId": 288
          },
          "· Ἁνανία. ὁ δὲ εἶπεν· Ἰδοὺ ἐγώ, κύριε."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ὁ δὲ κύριος πρὸς αὐτόν· ⸀Ἀναστὰς",
          {
            "noteId": 289
          },
          "πορεύθητι ἐπὶ τὴν ῥύμην τὴν καλουμένην Εὐθεῖαν καὶ ζήτησον ἐν οἰκίᾳ Ἰούδα Σαῦλον ὀνόματι Ταρσέα, ἰδοὺ γὰρ προσεύχεται,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "καὶ εἶδεν ⸂ἄνδρα ἐν ὁράματι Ἁνανίαν ὀνόματι",
          {
            "noteId": 290
          },
          "εἰσελθόντα καὶ ἐπιθέντα αὐτῷ ⸀χεῖρας",
          {
            "noteId": 291
          },
          "ὅπως ἀναβλέψῃ."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ἀπεκρίθη δὲ Ἁνανίας· Κύριε, ⸀ἤκουσα",
          {
            "noteId": 292
          },
          "ἀπὸ πολλῶν περὶ τοῦ ἀνδρὸς τούτου, ὅσα κακὰ ⸂τοῖς ἁγίοις σου ἐποίησεν",
          {
            "noteId": 293
          },
          "ἐν Ἰερουσαλήμ·"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καὶ ὧδε ἔχει ἐξουσίαν παρὰ τῶν ἀρχιερέων δῆσαι πάντας τοὺς ἐπικαλουμένους τὸ ὄνομά σου."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "εἶπεν δὲ πρὸς αὐτὸν ὁ κύριος· Πορεύου, ὅτι σκεῦος ἐκλογῆς ⸂ἐστίν μοι",
          {
            "noteId": 294
          },
          "οὗτος τοῦ βαστάσαι τὸ ὄνομά μου ἐνώπιον ⸀ἐθνῶν",
          {
            "noteId": 295
          },
          "⸀τε",
          {
            "noteId": 296
          },
          "καὶ βασιλέων υἱῶν τε Ἰσραήλ,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ἐγὼ γὰρ ὑποδείξω αὐτῷ ὅσα δεῖ αὐτὸν ὑπὲρ τοῦ ὀνόματός μου παθεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ἀπῆλθεν δὲ Ἁνανίας καὶ εἰσῆλθεν εἰς τὴν οἰκίαν, καὶ ἐπιθεὶς ἐπʼ αὐτὸν τὰς χεῖρας εἶπεν· Σαοὺλ ἀδελφέ, ὁ κύριος ἀπέσταλκέν με, ⸀Ἰησοῦς",
          {
            "noteId": 297
          },
          "ὁ ὀφθείς σοι ἐν τῇ ὁδῷ ᾗ ἤρχου, ὅπως ἀναβλέψῃς καὶ πλησθῇς πνεύματος ἁγίου."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ εὐθέως ἀπέπεσαν ⸂αὐτοῦ ἀπὸ τῶν ὀφθαλμῶν",
          {
            "noteId": 298
          },
          "⸀ὡς",
          {
            "noteId": 299
          },
          "λεπίδες, ἀνέβλεψέν τε καὶ ἀναστὰς ἐβαπτίσθη,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "καὶ λαβὼν τροφὴν ⸀ἐνίσχυσεν",
          {
            "noteId": 300
          },
          "Ἐγένετο ⸀δὲ",
          {
            "noteId": 301
          },
          "μετὰ τῶν ἐν Δαμασκῷ μαθητῶν ἡμέρας τινὰς,"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "καὶ εὐθέως ἐν ταῖς συναγωγαῖς ἐκήρυσσεν τὸν ⸀Ἰησοῦν",
          {
            "noteId": 302
          },
          "ὅτι οὗτός ἐστιν ὁ υἱὸς τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ἐξίσταντο δὲ πάντες οἱ ἀκούοντες καὶ ἔλεγον· Οὐχ οὗτός ἐστιν ὁ πορθήσας ⸀ἐν",
          {
            "noteId": 303
          },
          "Ἰερουσαλὴμ τοὺς ἐπικαλουμένους τὸ ὄνομα τοῦτο, καὶ ὧδε εἰς τοῦτο ἐληλύθει ἵνα δεδεμένους αὐτοὺς ἀγάγῃ ἐπὶ τοὺς ἀρχιερεῖς;"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Σαῦλος δὲ μᾶλλον ἐνεδυναμοῦτο καὶ ⸀συνέχυννεν",
          {
            "noteId": 304
          },
          "⸀τοὺς",
          {
            "noteId": 305
          },
          "Ἰουδαίους τοὺς κατοικοῦντας ἐν Δαμασκῷ, συμβιβάζων ὅτι οὗτός ἐστιν ὁ χριστός."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Ὡς δὲ ἐπληροῦντο ἡμέραι ἱκαναί, συνεβουλεύσαντο οἱ Ἰουδαῖοι ἀνελεῖν αὐτόν·"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ἐγνώσθη δὲ τῷ Σαύλῳ ἡ ἐπιβουλὴ αὐτῶν. ⸂παρετηροῦντο δὲ καὶ",
          {
            "noteId": 306
          },
          "τὰς πύλας ἡμέρας τε καὶ νυκτὸς ὅπως αὐτὸν ἀνέλωσιν·"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "λαβόντες δὲ ⸂οἱ μαθηταὶ αὐτοῦ",
          {
            "noteId": 307
          },
          "νυκτὸς ⸂διὰ τοῦ τείχους καθῆκαν αὐτὸν",
          {
            "noteId": 308
          },
          "χαλάσαντες ἐν σπυρίδι."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "Παραγενόμενος δὲ ⸀εἰς",
          {
            "noteId": 309
          },
          "Ἰερουσαλὴμ ⸀ἐπείραζεν",
          {
            "noteId": 310
          },
          "κολλᾶσθαι τοῖς μαθηταῖς· καὶ πάντες ἐφοβοῦντο αὐτόν, μὴ πιστεύοντες ὅτι ἐστὶν μαθητής."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Βαρναβᾶς δὲ ἐπιλαβόμενος αὐτὸν ἤγαγεν πρὸς τοὺς ἀποστόλους, καὶ διηγήσατο αὐτοῖς πῶς ἐν τῇ ὁδῷ εἶδεν τὸν κύριον καὶ ὅτι ἐλάλησεν αὐτῷ καὶ πῶς ἐν Δαμασκῷ ἐπαρρησιάσατο ἐν τῷ ὀνόματι ⸀τοῦ",
          {
            "noteId": 311
          },
          "Ἰησοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "καὶ ἦν μετʼ αὐτῶν εἰσπορευόμενος ⸂καὶ ἐκπορευόμενος",
          {
            "noteId": 312
          },
          "εἰς ⸀Ἰερουσαλήμ",
          {
            "noteId": 313
          },
          "παρρησιαζόμενος ἐν τῷ ὀνόματι τοῦ ⸀κυρίου",
          {
            "noteId": 314
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "ἐλάλει τε καὶ συνεζήτει πρὸς τοὺς Ἑλληνιστάς· οἱ δὲ ἐπεχείρουν ⸂ἀνελεῖν αὐτόν",
          {
            "noteId": 315
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ἐπιγνόντες δὲ οἱ ἀδελφοὶ κατήγαγον αὐτὸν εἰς Καισάρειαν καὶ ἐξαπέστειλαν αὐτὸν εἰς Ταρσόν."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "⸂Ἡ μὲν οὖν ἐκκλησία καθʼ ὅλης τῆς Ἰουδαίας καὶ Γαλιλαίας καὶ Σαμαρείας εἶχεν εἰρήνην οἰκοδομουμένη, καὶ πορευομένη τῷ φόβῳ τοῦ κυρίου καὶ τῇ παρακλήσει τοῦ ἁγίου πνεύματος ἐπληθύνετο",
          {
            "noteId": 316
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Ἐγένετο δὲ Πέτρον διερχόμενον διὰ πάντων κατελθεῖν καὶ πρὸς τοὺς ἁγίους τοὺς κατοικοῦντας Λύδδα."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "εὗρεν δὲ ἐκεῖ ἄνθρωπόν τινα ⸂ὀνόματι Αἰνέαν",
          {
            "noteId": 317
          },
          "ἐξ ἐτῶν ὀκτὼ κατακείμενον ἐπὶ ⸀κραβάττου",
          {
            "noteId": 318
          },
          "ὃς ἦν παραλελυμένος."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "καὶ εἶπεν αὐτῷ ὁ Πέτρος· Αἰνέα, ἰᾶταί σε Ἰησοῦς ⸀Χριστός",
          {
            "noteId": 319
          },
          "ἀνάστηθι καὶ στρῶσον σεαυτῷ· καὶ εὐθέως ἀνέστη."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "καὶ εἶδαν αὐτὸν πάντες οἱ κατοικοῦντες Λύδδα καὶ τὸν ⸀Σαρῶνα",
          {
            "noteId": 320
          },
          "οἵτινες ἐπέστρεψαν ἐπὶ τὸν κύριον."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "Ἐν Ἰόππῃ δέ τις ἦν μαθήτρια ὀνόματι Ταβιθά, ἣ διερμηνευομένη λέγεται Δορκάς· αὕτη ἦν πλήρης ⸂ἔργων ἀγαθῶν",
          {
            "noteId": 321
          },
          "καὶ ἐλεημοσυνῶν ὧν ἐποίει."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "ἐγένετο δὲ ἐν ταῖς ἡμέραις ἐκείναις ἀσθενήσασαν αὐτὴν ἀποθανεῖν· λούσαντες δὲ ⸂ἔθηκαν αὐτὴν",
          {
            "noteId": 322
          },
          "ἐν ὑπερῴῳ."
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "ἐγγὺς δὲ οὔσης Λύδδας τῇ Ἰόππῃ οἱ μαθηταὶ ἀκούσαντες ὅτι Πέτρος ἐστὶν ἐν αὐτῇ ἀπέστειλαν ⸂δύο ἄνδρας",
          {
            "noteId": 323
          },
          "πρὸς αὐτὸν παρακαλοῦντες· Μὴ ⸀ὀκνήσῃς",
          {
            "noteId": 324
          },
          "διελθεῖν ἕως ⸀ἡμῶν",
          {
            "noteId": 325
          }
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "ἀναστὰς δὲ Πέτρος συνῆλθεν αὐτοῖς· ὃν παραγενόμενον ἀνήγαγον εἰς τὸ ὑπερῷον, καὶ παρέστησαν αὐτῷ πᾶσαι αἱ χῆραι κλαίουσαι καὶ ἐπιδεικνύμεναι χιτῶνας καὶ ἱμάτια ὅσα ἐποίει μετʼ αὐτῶν οὖσα ἡ Δορκάς."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "ἐκβαλὼν δὲ ἔξω πάντας ὁ Πέτρος ⸀καὶ",
          {
            "noteId": 326
          },
          "θεὶς τὰ γόνατα προσηύξατο, καὶ ἐπιστρέψας πρὸς τὸ σῶμα εἶπεν· Ταβιθά, ἀνάστηθι. ἡ δὲ ἤνοιξεν τοὺς ὀφθαλμοὺς αὐτῆς, καὶ ἰδοῦσα τὸν Πέτρον ἀνεκάθισεν."
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "δοὺς δὲ αὐτῇ χεῖρα ἀνέστησεν αὐτήν, φωνήσας δὲ τοὺς ἁγίους καὶ τὰς χήρας παρέστησεν αὐτὴν ζῶσαν."
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "γνωστὸν δὲ ἐγένετο καθʼ ὅλης ⸀τῆς",
          {
            "noteId": 327
          },
          "Ἰόππης, καὶ ⸂ἐπίστευσαν πολλοὶ",
          {
            "noteId": 328
          },
          "ἐπὶ τὸν κύριον."
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "ἐγένετο ⸀δὲ",
          {
            "noteId": 329
          },
          "ἡμέρας ἱκανὰς ⸀μεῖναι",
          {
            "noteId": 330
          },
          "ἐν Ἰόππῃ παρά τινι Σίμωνι βυρσεῖ."
        ]
      }
    ],
