  "chapter": {
    "number": 12,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Κατʼ ἐκεῖνον δὲ τὸν καιρὸν ἐπέβαλεν Ἡρῴδης ὁ βασιλεὺς τὰς χεῖρας κακῶσαί τινας τῶν ἀπὸ τῆς ἐκκλησίας."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἀνεῖλεν δὲ Ἰάκωβον τὸν ἀδελφὸν Ἰωάννου μαχαίρῃ."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "⸂ἰδὼν δὲ",
          {
            "noteId": 412
          },
          "ὅτι ἀρεστόν ἐστιν τοῖς Ἰουδαίοις προσέθετο συλλαβεῖν καὶ Πέτρον (ἦσαν ⸀δὲ",
          {
            "noteId": 413
          },
          "ἡμέραι τῶν ἀζύμων),"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ὃν καὶ πιάσας ἔθετο εἰς φυλακήν, παραδοὺς τέσσαρσιν τετραδίοις στρατιωτῶν φυλάσσειν αὐτόν, βουλόμενος μετὰ τὸ πάσχα ἀναγαγεῖν αὐτὸν τῷ λαῷ."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ὁ μὲν οὖν Πέτρος ἐτηρεῖτο ἐν τῇ φυλακῇ· προσευχὴ δὲ ἦν ⸀ἐκτενῶς",
          {
            "noteId": 414
          },
          "γινομένη ὑπὸ τῆς ἐκκλησίας πρὸς τὸν θεὸν ⸀περὶ",
          {
            "noteId": 415
          },
          "αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Ὅτε δὲ ἤμελλεν ⸂προαγαγεῖν αὐτὸν",
          {
            "noteId": 416
          },
          "ὁ Ἡρῴδης, τῇ νυκτὶ ἐκείνῃ ἦν ὁ Πέτρος κοιμώμενος μεταξὺ δύο στρατιωτῶν δεδεμένος ἁλύσεσιν δυσίν, φύλακές τε πρὸ τῆς θύρας ἐτήρουν τὴν φυλακήν."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "καὶ ἰδοὺ ἄγγελος κυρίου ἐπέστη, καὶ φῶς ἔλαμψεν ἐν τῷ οἰκήματι· πατάξας δὲ τὴν πλευρὰν τοῦ Πέτρου ἤγειρεν αὐτὸν λέγων· Ἀνάστα ἐν τάχει· καὶ ἐξέπεσαν αὐτοῦ αἱ ἁλύσεις ἐκ τῶν χειρῶν."
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "εἶπεν ⸀δὲ",
          {
            "noteId": 417
          },
          "ὁ ἄγγελος πρὸς αὐτόν· ⸀Ζῶσαι",
          {
            "noteId": 418
          },
          "καὶ ὑπόδησαι τὰ σανδάλιά σου· ἐποίησεν δὲ οὕτως. καὶ λέγει αὐτῷ· Περιβαλοῦ τὸ ἱμάτιόν σου καὶ ἀκολούθει μοι."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ ἐξελθὼν ⸀ἠκολούθει",
          {
            "noteId": 419
          },
          "καὶ οὐκ ᾔδει ὅτι ἀληθές ἐστιν τὸ γινόμενον διὰ τοῦ ἀγγέλου, ἐδόκει δὲ ὅραμα βλέπειν."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "διελθόντες δὲ πρώτην φυλακὴν καὶ δευτέραν ἦλθαν ἐπὶ τὴν πύλην τὴν σιδηρᾶν τὴν φέρουσαν εἰς τὴν πόλιν, ἥτις αὐτομάτη ἠνοίγη αὐτοῖς, καὶ ἐξελθόντες προῆλθον ῥύμην μίαν, καὶ εὐθέως ἀπέστη ὁ ἄγγελος ἀπʼ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "καὶ ὁ Πέτρος ⸂ἐν ἑαυτῷ γενόμενος",
          {
            "noteId": 420
          },
          "εἶπεν· Νῦν οἶδα ἀληθῶς ὅτι ἐξαπέστειλεν ⸀ὁ",
          {
            "noteId": 421
          },
          "κύριος τὸν ἄγγελον αὐτοῦ καὶ ἐξείλατό με ἐκ χειρὸς Ἡρῴδου καὶ πάσης τῆς προσδοκίας τοῦ λαοῦ τῶν Ἰουδαίων."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Συνιδών τε ἦλθεν ἐπὶ τὴν οἰκίαν ⸀τῆς",
          {
            "noteId": 422
          },
          "Μαρίας τῆς μητρὸς Ἰωάννου τοῦ ἐπικαλουμένου Μάρκου, οὗ ἦσαν ἱκανοὶ συνηθροισμένοι καὶ προσευχόμενοι."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "κρούσαντος δὲ ⸀αὐτοῦ",
          {
            "noteId": 423
          },
          "τὴν θύραν τοῦ πυλῶνος προσῆλθε παιδίσκη ὑπακοῦσαι ὀνόματι Ῥόδη,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "καὶ ἐπιγνοῦσα τὴν φωνὴν τοῦ Πέτρου ἀπὸ τῆς χαρᾶς οὐκ ἤνοιξεν τὸν πυλῶνα, εἰσδραμοῦσα δὲ ἀπήγγειλεν ἑστάναι τὸν Πέτρον πρὸ τοῦ πυλῶνος."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "οἱ δὲ πρὸς αὐτὴν εἶπαν· Μαίνῃ. ἡ δὲ διϊσχυρίζετο οὕτως ἔχειν. οἱ δὲ ἔλεγον· Ὁ ἄγγελός ⸂ἐστιν αὐτοῦ",
          {
            "noteId": 424
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ὁ δὲ Πέτρος ἐπέμενεν κρούων· ἀνοίξαντες δὲ εἶδαν αὐτὸν καὶ ἐξέστησαν."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "κατασείσας δὲ αὐτοῖς τῇ χειρὶ σιγᾶν διηγήσατο αὐτοῖς πῶς ὁ κύριος αὐτὸν ἐξήγαγεν ἐκ τῆς φυλακῆς, εἶπέν ⸀τε",
          {
            "noteId": 425
          },
          "Ἀπαγγείλατε Ἰακώβῳ καὶ τοῖς ἀδελφοῖς ταῦτα. καὶ ἐξελθὼν ἐπορεύθη εἰς ἕτερον τόπον."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Γενομένης δὲ ἡμέρας ἦν τάραχος οὐκ ὀλίγος ἐν τοῖς στρατιώταις, τί ἄρα ὁ Πέτρος ἐγένετο."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "Ἡρῴδης δὲ ἐπιζητήσας αὐτὸν καὶ μὴ εὑρὼν ἀνακρίνας τοὺς φύλακας ἐκέλευσεν ἀπαχθῆναι, καὶ κατελθὼν ἀπὸ τῆς Ἰουδαίας ⸀εἰς",
          {
            "noteId": 426
          },
          "Καισάρειαν διέτριβεν."
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "Ἦν ⸀δὲ",
          {
            "noteId": 427
          },
          "θυμομαχῶν Τυρίοις καὶ Σιδωνίοις· ὁμοθυμαδὸν δὲ παρῆσαν πρὸς αὐτόν, καὶ πείσαντες Βλάστον τὸν ἐπὶ τοῦ κοιτῶνος τοῦ βασιλέως ᾐτοῦντο εἰρήνην διὰ τὸ τρέφεσθαι αὐτῶν τὴν χώραν ἀπὸ τῆς βασιλικῆς."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "τακτῇ δὲ ἡμέρᾳ ὁ Ἡρῴδης ἐνδυσάμενος ἐσθῆτα βασιλικὴν ⸀καὶ",
          {
            "noteId": 428
          },
          "καθίσας ἐπὶ τοῦ βήματος ἐδημηγόρει πρὸς αὐτούς·"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ὁ δὲ δῆμος ἐπεφώνει· ⸂Θεοῦ φωνὴ",
          {
            "noteId": 429
          },
          "καὶ οὐκ ἀνθρώπου."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "παραχρῆμα δὲ ἐπάταξεν αὐτὸν ἄγγελος κυρίου ἀνθʼ ὧν οὐκ ἔδωκεν ⸀τὴν",
          {
            "noteId": 430
          },
          "δόξαν τῷ θεῷ, καὶ γενόμενος σκωληκόβρωτος ἐξέψυξεν."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Ὁ δὲ λόγος τοῦ ⸀θεοῦ",
          {
            "noteId": 431
          },
          "ηὔξανεν καὶ ἐπληθύνετο."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Βαρναβᾶς δὲ καὶ Σαῦλος ὑπέστρεψαν, ⸀εἰς",
          {
            "noteId": 432
          },
          "Ἰερουσαλὴμ πληρώσαντες τὴν διακονίαν, ⸀συμπαραλαβόντες",
          {
            "noteId": 433
          },
          "Ἰωάννην τὸν ἐπικληθέντα Μᾶρκον."
        ]
      }
    ],
