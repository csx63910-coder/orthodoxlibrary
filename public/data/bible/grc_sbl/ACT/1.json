  "chapter": {
    "number": 1,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Τὸν μὲν πρῶτον λόγον ἐποιησάμην περὶ πάντων, ὦ Θεόφιλε, ὧν ἤρξατο ⸀ὁ",
          {
            "noteId": 0
          },
          "Ἰησοῦς ποιεῖν τε καὶ διδάσκειν"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἄχρι ἧς ἡμέρας ἐντειλάμενος τοῖς ἀποστόλοις διὰ πνεύματος ἁγίου οὓς ἐξελέξατο ἀνελήμφθη·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "οἷς καὶ παρέστησεν ἑαυτὸν ζῶντα μετὰ τὸ παθεῖν αὐτὸν ἐν πολλοῖς τεκμηρίοις, διʼ ἡμερῶν τεσσεράκοντα ὀπτανόμενος αὐτοῖς καὶ λέγων τὰ περὶ τῆς βασιλείας τοῦ θεοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ συναλιζόμενος παρήγγειλεν αὐτοῖς ἀπὸ Ἱεροσολύμων μὴ χωρίζεσθαι, ἀλλὰ περιμένειν τὴν ἐπαγγελίαν τοῦ πατρὸς ἣν ἠκούσατέ μου·"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ὅτι Ἰωάννης μὲν ἐβάπτισεν ὕδατι, ὑμεῖς δὲ ⸂ἐν πνεύματι βαπτισθήσεσθε",
          {
            "noteId": 1
          },
          "ἁγίῳ οὐ μετὰ πολλὰς ταύτας ἡμέρας."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Οἱ μὲν οὖν συνελθόντες ⸀ἠρώτων",
          {
            "noteId": 2
          },
          "αὐτὸν λέγοντες· Κύριε, εἰ ἐν τῷ χρόνῳ τούτῳ ἀποκαθιστάνεις τὴν βασιλείαν τῷ Ἰσραήλ;"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "εἶπεν ⸀δὲ",
          {
            "noteId": 3
          },
          "πρὸς αὐτούς· Οὐχ ὑμῶν ἐστιν γνῶναι χρόνους ἢ καιροὺς οὓς ὁ πατὴρ ἔθετο ἐν τῇ ἰδίᾳ ἐξουσίᾳ,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "ἀλλὰ λήμψεσθε δύναμιν ἐπελθόντος τοῦ ἁγίου πνεύματος ἐφʼ ὑμᾶς, καὶ ἔσεσθέ ⸀μου",
          {
            "noteId": 4
          },
          "μάρτυρες ἔν τε Ἰερουσαλὴμ καὶ ἐν πάσῃ τῇ Ἰουδαίᾳ καὶ Σαμαρείᾳ καὶ ἕως ἐσχάτου τῆς γῆς."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ ταῦτα εἰπὼν βλεπόντων αὐτῶν ἐπήρθη καὶ νεφέλη ὑπέλαβεν αὐτὸν ἀπὸ τῶν ὀφθαλμῶν αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "καὶ ὡς ἀτενίζοντες ἦσαν εἰς τὸν οὐρανὸν πορευομένου αὐτοῦ, καὶ ἰδοὺ ἄνδρες δύο παρειστήκεισαν αὐτοῖς ἐν ⸂ἐσθήσεσι λευκαῖς",
          {
            "noteId": 5
          },
          ","
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "οἳ καὶ εἶπαν· Ἄνδρες Γαλιλαῖοι, τί ἑστήκατε ⸀βλέποντες",
          {
            "noteId": 6
          },
          "εἰς τὸν οὐρανόν; οὗτος ὁ Ἰησοῦς ὁ ἀναλημφθεὶς ἀφʼ ὑμῶν εἰς τὸν οὐρανὸν οὕτως ἐλεύσεται ὃν τρόπον ἐθεάσασθε αὐτὸν πορευόμενον εἰς τὸν οὐρανόν."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Τότε ὑπέστρεψαν εἰς Ἰερουσαλὴμ ἀπὸ ὄρους τοῦ καλουμένου Ἐλαιῶνος, ὅ ἐστιν ἐγγὺς Ἰερουσαλὴμ σαββάτου ἔχον ὁδόν."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "καὶ ὅτε εἰσῆλθον, ⸂εἰς τὸ ὑπερῷον ἀνέβησαν",
          {
            "noteId": 7
          },
          "οὗ ἦσαν καταμένοντες, ὅ τε Πέτρος καὶ ⸂Ἰωάννης καὶ Ἰάκωβος",
          {
            "noteId": 8
          },
          "καὶ Ἀνδρέας, Φίλιππος καὶ Θωμᾶς, Βαρθολομαῖος καὶ Μαθθαῖος, Ἰάκωβος Ἁλφαίου καὶ Σίμων ὁ ζηλωτὴς καὶ Ἰούδας Ἰακώβου."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "οὗτοι πάντες ἦσαν προσκαρτεροῦντες ὁμοθυμαδὸν τῇ ⸀προσευχῇ",
          {
            "noteId": 9
          },
          "σὺν γυναιξὶν καὶ ⸀Μαριὰμ",
          {
            "noteId": 10
          },
          "τῇ μητρὶ τοῦ Ἰησοῦ καὶ ⸀σὺν",
          {
            "noteId": 11
          },
          "τοῖς ἀδελφοῖς αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "Καὶ ἐν ταῖς ἡμέραις ταύταις ἀναστὰς Πέτρος ἐν μέσῳ τῶν ⸀ἀδελφῶν",
          {
            "noteId": 12
          },
          "εἶπεν (ἦν τε ὄχλος ὀνομάτων ἐπὶ τὸ αὐτὸ ⸀ὡς",
          {
            "noteId": 13
          },
          "ἑκατὸν εἴκοσι)·"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Ἄνδρες ἀδελφοί, ἔδει πληρωθῆναι τὴν ⸀γραφὴν",
          {
            "noteId": 14
          },
          "ἣν προεῖπε τὸ πνεῦμα τὸ ἅγιον διὰ στόματος Δαυὶδ περὶ Ἰούδα τοῦ γενομένου ὁδηγοῦ τοῖς συλλαβοῦσιν ⸀Ἰησοῦν",
          {
            "noteId": 15
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ὅτι κατηριθμημένος ἦν ⸀ἐν",
          {
            "noteId": 16
          },
          "ἡμῖν καὶ ἔλαχεν τὸν κλῆρον τῆς διακονίας ταύτης.—"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "Οὗτος μὲν οὖν ἐκτήσατο χωρίον ἐκ μισθοῦ τῆς ἀδικίας, καὶ πρηνὴς γενόμενος ἐλάκησεν μέσος, καὶ ἐξεχύθη πάντα τὰ σπλάγχνα αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "καὶ γνωστὸν ἐγένετο πᾶσι τοῖς κατοικοῦσιν Ἰερουσαλήμ, ὥστε κληθῆναι τὸ χωρίον ἐκεῖνο τῇ ⸀ἰδίᾳ",
          {
            "noteId": 17
          },
          "διαλέκτῳ αὐτῶν Ἁκελδαμάχ, τοῦτʼ ἔστιν Χωρίον Αἵματος.—"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "γέγραπται γὰρ ἐν βίβλῳ ψαλμῶν· Γενηθήτω ἡ ἔπαυλις αὐτοῦ ἔρημος καὶ μὴ ἔστω ὁ κατοικῶν ἐν αὐτῇ, καί· Τὴν ἐπισκοπὴν αὐτοῦ ⸀λαβέτω",
          {
            "noteId": 18
          },
          "ἕτερος."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "δεῖ οὖν τῶν συνελθόντων ἡμῖν ἀνδρῶν ἐν παντὶ χρόνῳ ⸀ᾧ",
          {
            "noteId": 19
          },
          "εἰσῆλθεν καὶ ἐξῆλθεν ἐφʼ ἡμᾶς ὁ κύριος Ἰησοῦς,"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ἀρξάμενος ἀπὸ τοῦ βαπτίσματος Ἰωάννου ἕως τῆς ἡμέρας ἧς ἀνελήμφθη ἀφʼ ἡμῶν, μάρτυρα τῆς ἀναστάσεως αὐτοῦ ⸂σὺν ἡμῖν γενέσθαι",
          {
            "noteId": 20
          },
          "ἕνα τούτων."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "καὶ ἔστησαν δύο, Ἰωσὴφ τὸν καλούμενον Βαρσαββᾶν, ὃς ἐπεκλήθη Ἰοῦστος, καὶ Μαθθίαν."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "καὶ προσευξάμενοι εἶπαν Σὺ κύριε καρδιογνῶστα πάντων, ἀνάδειξον ὃν ἐξελέξω, ἐκ τούτων τῶν δύο ἕνα,"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "λαβεῖν τὸν ⸀τόπον",
          {
            "noteId": 21
          },
          "τῆς διακονίας ταύτης καὶ ἀποστολῆς, ⸀ἀφʼ",
          {
            "noteId": 22
          },
          "ἧς παρέβη Ἰούδας πορευθῆναι εἰς τὸν τόπον τὸν ἴδιον."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "καὶ ἔδωκαν κλήρους ⸀αὐτοῖς",
          {
            "noteId": 23
          },
          "καὶ ἔπεσεν ὁ κλῆρος ἐπὶ Μαθθίαν, καὶ συγκατεψηφίσθη μετὰ τῶν ἕνδεκα ἀποστόλων."
        ]
      }
    ],
