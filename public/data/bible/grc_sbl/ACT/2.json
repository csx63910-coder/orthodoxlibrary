  },
  "chapter": {
    "number": 2,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καὶ ἐν τῷ συμπληροῦσθαι τὴν ἡμέραν τῆς πεντηκοστῆς ἦσαν ⸂πάντες ὁμοῦ",
          {
            "noteId": 24
          },
          "ἐπὶ τὸ αὐτό,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "καὶ ἐγένετο ἄφνω ἐκ τοῦ οὐρανοῦ ἦχος ὥσπερ φερομένης πνοῆς βιαίας καὶ ἐπλήρωσεν ὅλον τὸν οἶκον οὗ ἦσαν καθήμενοι,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ ὤφθησαν αὐτοῖς διαμεριζόμεναι γλῶσσαι ὡσεὶ πυρός, ⸂καὶ ἐκάθισεν",
          {
            "noteId": 25
          },
          "ἐφʼ ἕνα ἕκαστον αὐτῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "καὶ ἐπλήσθησαν ⸀πάντες",
          {
            "noteId": 26
          },
          "πνεύματος ἁγίου, καὶ ἤρξαντο λαλεῖν ἑτέραις γλώσσαις καθὼς τὸ πνεῦμα ἐδίδου ⸂ἀποφθέγγεσθαι αὐτοῖς",
          {
            "noteId": 27
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Ἦσαν δὲ ⸀ἐν",
          {
            "noteId": 28
          },
          "Ἰερουσαλὴμ κατοικοῦντες Ἰουδαῖοι, ἄνδρες εὐλαβεῖς ἀπὸ παντὸς ἔθνους τῶν ὑπὸ τὸν οὐρανόν·"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "γενομένης δὲ τῆς φωνῆς ταύτης συνῆλθε τὸ πλῆθος καὶ συνεχύθη, ὅτι ⸀ἤκουον",
          {
            "noteId": 29
          },
          "εἷς ἕκαστος τῇ ἰδίᾳ διαλέκτῳ λαλούντων αὐτῶν·"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἐξίσταντο ⸀δὲ",
          {
            "noteId": 30
          },
          "καὶ ἐθαύμαζον ⸀λέγοντες",
          {
            "noteId": 31
          },
          "⸀Οὐχ",
          {
            "noteId": 32
          },
          "ἰδοὺ ⸀πάντες",
          {
            "noteId": 33
          },
          "οὗτοί εἰσιν οἱ λαλοῦντες Γαλιλαῖοι;"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ πῶς ἡμεῖς ἀκούομεν ἕκαστος τῇ ἰδίᾳ διαλέκτῳ ἡμῶν ἐν ᾗ ἐγεννήθημεν;"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Πάρθοι καὶ Μῆδοι καὶ Ἐλαμῖται, καὶ οἱ κατοικοῦντες τὴν Μεσοποταμίαν, Ἰουδαίαν τε καὶ Καππαδοκίαν, Πόντον καὶ τὴν Ἀσίαν,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Φρυγίαν τε καὶ Παμφυλίαν, Αἴγυπτον καὶ τὰ μέρη τῆς Λιβύης τῆς κατὰ Κυρήνην, καὶ οἱ ἐπιδημοῦντες Ῥωμαῖοι,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "Ἰουδαῖοί τε καὶ προσήλυτοι, Κρῆτες καὶ Ἄραβες, ἀκούομεν λαλούντων αὐτῶν ταῖς ἡμετέραις γλώσσαις τὰ μεγαλεῖα τοῦ θεοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ἐξίσταντο δὲ πάντες καὶ ⸀διηπόρουν",
          {
            "noteId": 34
          },
          "ἄλλος πρὸς ἄλλον λέγοντες· Τί ⸀θέλει",
          {
            "noteId": 35
          },
          "τοῦτο εἶναι;"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "ἕτεροι δὲ ⸀διαχλευάζοντες",
          {
            "noteId": 36
          },
          "ἔλεγον ὅτι Γλεύκους μεμεστωμένοι εἰσίν."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Σταθεὶς δὲ ⸀ὁ",
          {
            "noteId": 37
          },
          "Πέτρος σὺν τοῖς ἕνδεκα ἐπῆρεν τὴν φωνὴν αὐτοῦ καὶ ἀπεφθέγξατο αὐτοῖς· Ἄνδρες Ἰουδαῖοι καὶ οἱ κατοικοῦντες Ἰερουσαλὴμ ⸀πάντες",
          {
            "noteId": 38
          },
          "τοῦτο ὑμῖν γνωστὸν ἔστω καὶ ἐνωτίσασθε τὰ ῥήματά μου."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "οὐ γὰρ ὡς ὑμεῖς ὑπολαμβάνετε οὗτοι μεθύουσιν, ἔστιν γὰρ ὥρα τρίτη τῆς ἡμέρας,"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ἀλλὰ τοῦτό ἐστιν τὸ εἰρημένον διὰ τοῦ προφήτου Ἰωήλ·"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "Καὶ ἔσται ἐν ταῖς ἐσχάταις ἡμέραις, λέγει ὁ θεός, ἐκχεῶ ἀπὸ τοῦ πνεύματός μου ἐπὶ πᾶσαν σάρκα, καὶ προφητεύσουσιν οἱ υἱοὶ ὑμῶν καὶ αἱ θυγατέρες ὑμῶν, καὶ οἱ νεανίσκοι ὑμῶν ὁράσεις ὄψονται, καὶ οἱ πρεσβύτεροι ὑμῶν ⸀ἐνυπνίοις",
          {
            "noteId": 39
          },
          "ἐνυπνιασθήσονται·"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καί γε ἐπὶ τοὺς δούλους μου καὶ ἐπὶ τὰς δούλας μου ἐν ταῖς ἡμέραις ἐκείναις ἐκχεῶ ἀπὸ τοῦ πνεύματός μου, καὶ προφητεύσουσιν."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "καὶ δώσω τέρατα ἐν τῷ οὐρανῷ ἄνω καὶ σημεῖα ἐπὶ τῆς γῆς κάτω, αἷμα καὶ πῦρ καὶ ἀτμίδα καπνοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ὁ ἥλιος μεταστραφήσεται εἰς σκότος καὶ ἡ σελήνη εἰς αἷμα πρὶν ⸀ἢ",
          {
            "noteId": 40
          },
          "⸀ἐλθεῖν",
          {
            "noteId": 41
          },
          "ἡμέραν κυρίου τὴν μεγάλην καὶ ἐπιφανῆ."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "καὶ ἔσται πᾶς ὃς ⸀ἐὰν",
          {
            "noteId": 42
          },
          "ἐπικαλέσηται τὸ ὄνομα κυρίου σωθήσεται."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Ἄνδρες Ἰσραηλῖται, ἀκούσατε τοὺς λόγους τούτους. Ἰησοῦν τὸν Ναζωραῖον, ἄνδρα ⸂ἀποδεδειγμένον ἀπὸ τοῦ θεοῦ",
          {
            "noteId": 43
          },
          "εἰς ὑμᾶς δυνάμεσι καὶ τέρασι καὶ σημείοις οἷς ἐποίησεν διʼ αὐτοῦ ὁ θεὸς ἐν μέσῳ ὑμῶν, ⸀καθὼς",
          {
            "noteId": 44
          },
          "αὐτοὶ οἴδατε,"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "τοῦτον τῇ ὡρισμένῃ βουλῇ καὶ προγνώσει τοῦ θεοῦ ⸀ἔκδοτον",
          {
            "noteId": 45
          },
          "διὰ ⸀χειρὸς",
          {
            "noteId": 46
          },
          "ἀνόμων προσπήξαντες ἀνείλατε,"
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ὃν ὁ θεὸς ἀνέστησεν λύσας τὰς ὠδῖνας τοῦ θανάτου, καθότι οὐκ ἦν δυνατὸν κρατεῖσθαι αὐτὸν ὑπʼ αὐτοῦ·"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "Δαυὶδ γὰρ λέγει εἰς αὐτόν· Προορώμην τὸν κύριον ἐνώπιόν μου διὰ παντός, ὅτι ἐκ δεξιῶν μού ἐστιν ἵνα μὴ σαλευθῶ."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "διὰ τοῦτο ηὐφράνθη ⸂ἡ καρδία μου",
          {
            "noteId": 47
          },
          "καὶ ἠγαλλιάσατο ἡ γλῶσσά μου, ἔτι δὲ καὶ ἡ σάρξ μου κατασκηνώσει ἐπʼ ἐλπίδι·"
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "ὅτι οὐκ ἐγκαταλείψεις τὴν ψυχήν μου εἰς ⸀ᾅδην",
          {
            "noteId": 48
          },
          "οὐδὲ δώσεις τὸν ὅσιόν σου ἰδεῖν διαφθοράν."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ἐγνώρισάς μοι ὁδοὺς ζωῆς, πληρώσεις με εὐφροσύνης μετὰ τοῦ προσώπου σου."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "Ἄνδρες ἀδελφοί, ἐξὸν εἰπεῖν μετὰ παρρησίας πρὸς ὑμᾶς περὶ τοῦ πατριάρχου Δαυίδ, ὅτι καὶ ἐτελεύτησεν καὶ ἐτάφη, καὶ τὸ μνῆμα αὐτοῦ ἔστιν ἐν ἡμῖν ἄχρι τῆς ἡμέρας ταύτης·"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "προφήτης οὖν ὑπάρχων, καὶ εἰδὼς ὅτι ὅρκῳ ὤμοσεν αὐτῷ ὁ θεὸς ἐκ καρποῦ τῆς ὀσφύος ⸀αὐτοῦ",
          {
            "noteId": 49
          },
          "καθίσαι ἐπὶ ⸂τὸν θρόνον",
          {
            "noteId": 50
          },
          "αὐτοῦ,"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "προϊδὼν ἐλάλησεν περὶ τῆς ἀναστάσεως τοῦ χριστοῦ ὅτι ⸂οὔτε ἐγκατελείφθη",
          {
            "noteId": 51
          },
          "εἰς ⸀ᾅδην",
          {
            "noteId": 52
          },
          "⸀οὔτε",
          {
            "noteId": 53
          },
          "ἡ σὰρξ αὐτοῦ εἶδεν διαφθοράν."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "τοῦτον τὸν Ἰησοῦν ἀνέστησεν ὁ θεός, οὗ πάντες ἡμεῖς ἐσμεν μάρτυρες."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "τῇ δεξιᾷ οὖν τοῦ θεοῦ ὑψωθεὶς τήν τε ἐπαγγελίαν τοῦ ⸂πνεύματος τοῦ ἁγίου",
          {
            "noteId": 54
          },
          "λαβὼν παρὰ τοῦ πατρὸς ἐξέχεεν τοῦτο ⸀ὃ",
          {
            "noteId": 55
          },
          "⸀ὑμεῖς",
          {
            "noteId": 56
          },
          "βλέπετε καὶ ἀκούετε."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "οὐ γὰρ Δαυὶδ ἀνέβη εἰς τοὺς οὐρανούς, λέγει δὲ αὐτός· Εἶπεν ⸀ὁ",
          {
            "noteId": 57
          },
          "κύριος τῷ κυρίῳ μου· Κάθου ἐκ δεξιῶν μου,"
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "ἕως ἂν θῶ τοὺς ἐχθρούς σου ὑποπόδιον τῶν ποδῶν σου."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "ἀσφαλῶς οὖν γινωσκέτω πᾶς οἶκος Ἰσραὴλ ὅτι καὶ κύριον ⸂αὐτὸν καὶ χριστὸν",
          {
            "noteId": 58
          },
          "⸂ἐποίησεν ὁ θεός",
          {
            "noteId": 59
          },
          ", τοῦτον τὸν Ἰησοῦν ὃν ὑμεῖς ἐσταυρώσατε."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "Ἀκούσαντες δὲ κατενύγησαν ⸂τὴν καρδίαν",
          {
            "noteId": 60
          },
          ", εἶπόν τε πρὸς τὸν Πέτρον καὶ τοὺς λοιποὺς ἀποστόλους· Τί ⸀ποιήσωμεν",
          {
            "noteId": 61
          },
          "ἄνδρες ἀδελφοί;"
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "Πέτρος δὲ ⸂πρὸς αὐτούς· Μετανοήσατε",
          {
            "noteId": 62
          },
          ", καὶ βαπτισθήτω ἕκαστος ὑμῶν ⸀ἐπὶ",
          {
            "noteId": 63
          },
          "τῷ ὀνόματι Ἰησοῦ Χριστοῦ εἰς ἄφεσιν ⸀τῶν",
          {
            "noteId": 64
          },
          "ἁμαρτιῶν ⸀ὑμῶν",
          {
            "noteId": 65
          },
          "καὶ λήμψεσθε τὴν δωρεὰν τοῦ ἁγίου πνεύματος·"
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "ὑμῖν γάρ ἐστιν ἡ ἐπαγγελία καὶ τοῖς τέκνοις ὑμῶν καὶ πᾶσι τοῖς εἰς μακρὰν ὅσους ἂν προσκαλέσηται κύριος ὁ θεὸς ἡμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "ἑτέροις τε λόγοις πλείοσιν διεμαρτύρατο, καὶ παρεκάλει ⸀αὐτοὺς",
          {
            "noteId": 66
          },
          "λέγων· Σώθητε ἀπὸ τῆς γενεᾶς τῆς σκολιᾶς ταύτης."
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "οἱ μὲν ⸀οὖν",
          {
            "noteId": 67
          },
          "ἀποδεξάμενοι τὸν λόγον αὐτοῦ ἐβαπτίσθησαν, καὶ προσετέθησαν ⸀ἐν",
          {
            "noteId": 68
          },
          "τῇ ἡμέρᾳ ἐκείνῃ ψυχαὶ ὡσεὶ τρισχίλιαι."
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "ἦσαν δὲ προσκαρτεροῦντες τῇ διδαχῇ τῶν ἀποστόλων καὶ τῇ ⸀κοινωνίᾳ",
          {
            "noteId": 69
          },
          "τῇ κλάσει τοῦ ἄρτου καὶ ταῖς προσευχαῖς."
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "⸀Ἐγίνετο",
          {
            "noteId": 70
          },
          "δὲ πάσῃ ψυχῇ φόβος, πολλά ⸀τε",
          {
            "noteId": 71
          },
          "τέρατα καὶ σημεῖα διὰ τῶν ἀποστόλων ἐγίνετο."
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "πάντες δὲ οἱ ⸀πιστεύοντες",
          {
            "noteId": 72
          },
          "⸂ἦσαν ἐπὶ τὸ αὐτὸ καὶ",
          {
            "noteId": 73
          },
          "εἶχον ἅπαντα κοινά,"
        ]
      },
      {
        "type": "verse",
        "number": 45,
        "content": [
          "καὶ τὰ κτήματα καὶ τὰς ὑπάρξεις ἐπίπρασκον καὶ διεμέριζον αὐτὰ πᾶσιν καθότι ἄν τις χρείαν εἶχεν·"
        ]
      },
      {
        "type": "verse",
        "number": 46,
        "content": [
          "καθʼ ἡμέραν τε προσκαρτεροῦντες ὁμοθυμαδὸν ἐν τῷ ἱερῷ, κλῶντές τε κατʼ οἶκον ἄρτον, μετελάμβανον τροφῆς ἐν ἀγαλλιάσει καὶ ἀφελότητι καρδίας,"
        ]
      },
      {
        "type": "verse",
        "number": 47,
        "content": [
          "αἰνοῦντες τὸν θεὸν καὶ ἔχοντες χάριν πρὸς ὅλον τὸν λαόν. ὁ δὲ κύριος προσετίθει τοὺς σῳζομένους καθʼ ἡμέραν ⸂ἐπὶ τὸ αὐτό",
          {
            "noteId": 74
          },
          "."
        ]
      }
    ],
