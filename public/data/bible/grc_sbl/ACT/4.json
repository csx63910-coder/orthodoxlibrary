  "chapter": {
    "number": 4,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Λαλούντων δὲ αὐτῶν πρὸς τὸν λαὸν ἐπέστησαν αὐτοῖς οἱ ⸀ἱερεῖς",
          {
            "noteId": 106
          },
          "καὶ ὁ στρατηγὸς τοῦ ἱεροῦ καὶ οἱ Σαδδουκαῖοι,"
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "διαπονούμενοι διὰ τὸ διδάσκειν αὐτοὺς τὸν λαὸν καὶ καταγγέλλειν ἐν τῷ Ἰησοῦ τὴν ἀνάστασιν ⸂τὴν ἐκ",
          {
            "noteId": 107
          },
          "νεκρῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "καὶ ἐπέβαλον αὐτοῖς τὰς χεῖρας καὶ ἔθεντο εἰς τήρησιν εἰς τὴν αὔριον, ἦν γὰρ ἑσπέρα ἤδη."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "πολλοὶ δὲ τῶν ἀκουσάντων τὸν λόγον ἐπίστευσαν, καὶ ἐγενήθη ⸀ὁ",
          {
            "noteId": 108
          },
          "ἀριθμὸς τῶν ἀνδρῶν ⸀ὡς",
          {
            "noteId": 109
          },
          "χιλιάδες πέντε."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "Ἐγένετο δὲ ἐπὶ τὴν αὔριον συναχθῆναι αὐτῶν τοὺς ἄρχοντας καὶ ⸀τοὺς",
          {
            "noteId": 110
          },
          "πρεσβυτέρους καὶ ⸁τοὺς",
          {
            "noteId": 111
          },
          "γραμματεῖς ⸀ἐν",
          {
            "noteId": 112
          },
          "Ἰερουσαλήμ"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "(καὶ ⸂Ἅννας ὁ ἀρχιερεὺς καὶ Καϊάφας καὶ Ἰωάννης καὶ Ἀλέξανδρος",
          {
            "noteId": 113
          },
          "καὶ ὅσοι ἦσαν ἐκ γένους ἀρχιερατικοῦ),"
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "καὶ στήσαντες αὐτοὺς ἐν ⸀τῷ",
          {
            "noteId": 114
          },
          "μέσῳ ἐπυνθάνοντο· Ἐν ποίᾳ δυνάμει ἢ ἐν ποίῳ ὀνόματι ἐποιήσατε τοῦτο ὑμεῖς;"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "τότε Πέτρος πλησθεὶς πνεύματος ἁγίου εἶπεν πρὸς αὐτούς· Ἄρχοντες τοῦ λαοῦ καὶ ⸀πρεσβύτεροι",
          {
            "noteId": 115
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "εἰ ἡμεῖς σήμερον ἀνακρινόμεθα ἐπὶ εὐεργεσίᾳ ἀνθρώπου ἀσθενοῦς, ἐν τίνι οὗτος σέσωσται,"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "γνωστὸν ἔστω πᾶσιν ὑμῖν καὶ παντὶ τῷ λαῷ Ἰσραὴλ ὅτι ἐν τῷ ὀνόματι Ἰησοῦ Χριστοῦ τοῦ Ναζωραίου, ὃν ὑμεῖς ἐσταυρώσατε, ὃν ὁ θεὸς ἤγειρεν ἐκ νεκρῶν, ἐν τούτῳ οὗτος παρέστηκεν ἐνώπιον ὑμῶν ὑγιής."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "οὗτός ἐστιν ὁ λίθος ὁ ἐξουθενηθεὶς ὑφʼ ὑμῶν τῶν ⸀οἰκοδόμων",
          {
            "noteId": 116
          },
          "ὁ γενόμενος εἰς κεφαλὴν γωνίας."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "καὶ οὐκ ἔστιν ἐν ἄλλῳ οὐδενὶ ἡ σωτηρία, ⸀οὐδὲ",
          {
            "noteId": 117
          },
          "γὰρ ὄνομά ἐστιν ἕτερον ⸂ὑπὸ τὸν οὐρανὸν",
          {
            "noteId": 118
          },
          "τὸ δεδομένον ἐν ἀνθρώποις ἐν ᾧ δεῖ σωθῆναι ἡμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Θεωροῦντες δὲ τὴν τοῦ Πέτρου παρρησίαν καὶ Ἰωάννου καὶ καταλαβόμενοι ὅτι ἄνθρωποι ἀγράμματοί εἰσιν καὶ ἰδιῶται, ἐθαύμαζον, ἐπεγίνωσκόν τε αὐτοὺς ὅτι σὺν τῷ Ἰησοῦ ἦσαν,"
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "τόν ⸀τε",
          {
            "noteId": 119
          },
          "ἄνθρωπον βλέποντες σὺν αὐτοῖς ἑστῶτα τὸν τεθεραπευμένον οὐδὲν εἶχον ἀντειπεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "κελεύσαντες δὲ αὐτοὺς ἔξω τοῦ συνεδρίου ἀπελθεῖν συνέβαλλον πρὸς ἀλλήλους"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "λέγοντες· Τί ⸀ποιήσωμεν",
          {
            "noteId": 120
          },
          "τοῖς ἀνθρώποις τούτοις; ὅτι μὲν γὰρ γνωστὸν σημεῖον γέγονεν διʼ αὐτῶν πᾶσιν τοῖς κατοικοῦσιν Ἰερουσαλὴμ φανερόν, καὶ οὐ δυνάμεθα ⸀ἀρνεῖσθαι",
          {
            "noteId": 121
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ἀλλʼ ἵνα μὴ ἐπὶ πλεῖον διανεμηθῇ εἰς τὸν λαόν, ⸀ἀπειλησώμεθα",
          {
            "noteId": 122
          },
          "αὐτοῖς μηκέτι λαλεῖν ἐπὶ τῷ ὀνόματι τούτῳ μηδενὶ ἀνθρώπων."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "καὶ καλέσαντες αὐτοὺς παρήγγειλαν ⸀τὸ",
          {
            "noteId": 123
          },
          "καθόλου μὴ φθέγγεσθαι μηδὲ διδάσκειν ἐπὶ τῷ ὀνόματι τοῦ Ἰησοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "ὁ δὲ Πέτρος καὶ Ἰωάννης ἀποκριθέντες ⸂εἶπον πρὸς αὐτούς",
          {
            "noteId": 124
          },
          "· Εἰ δίκαιόν ἐστιν ἐνώπιον τοῦ θεοῦ ὑμῶν ἀκούειν μᾶλλον ἢ τοῦ θεοῦ, κρίνατε,"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "οὐ δυνάμεθα γὰρ ἡμεῖς ἃ εἴδαμεν καὶ ἠκούσαμεν μὴ λαλεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "οἱ δὲ προσαπειλησάμενοι ἀπέλυσαν αὐτούς, μηδὲν εὑρίσκοντες τὸ πῶς ⸀κολάσωνται",
          {
            "noteId": 125
          },
          "αὐτούς, διὰ τὸν λαόν, ὅτι πάντες ἐδόξαζον τὸν θεὸν ἐπὶ τῷ γεγονότι·"
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "ἐτῶν γὰρ ἦν πλειόνων τεσσεράκοντα ὁ ἄνθρωπος ἐφʼ ὃν ⸀γεγόνει",
          {
            "noteId": 126
          },
          "τὸ σημεῖον τοῦτο τῆς ἰάσεως."
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "Ἀπολυθέντες δὲ ἦλθον πρὸς τοὺς ἰδίους καὶ ἀπήγγειλαν ὅσα πρὸς αὐτοὺς οἱ ἀρχιερεῖς καὶ οἱ πρεσβύτεροι εἶπαν."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "οἱ δὲ ἀκούσαντες ὁμοθυμαδὸν ἦραν φωνὴν πρὸς τὸν θεὸν καὶ εἶπαν· Δέσποτα, ⸀σὺ",
          {
            "noteId": 127
          },
          "ὁ ποιήσας τὸν οὐρανὸν καὶ τὴν γῆν καὶ τὴν θάλασσαν καὶ πάντα τὰ ἐν αὐτοῖς,"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ὁ ⸂τοῦ πατρὸς ἡμῶν",
          {
            "noteId": 128
          },
          "διὰ ⸂πνεύματος ἁγίου",
          {
            "noteId": 129
          },
          "στόματος Δαυὶδ παιδός σου εἰπών· Ἱνατί ἐφρύαξαν ἔθνη καὶ λαοὶ ἐμελέτησαν κενά;"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "παρέστησαν οἱ βασιλεῖς τῆς γῆς καὶ οἱ ἄρχοντες συνήχθησαν ἐπὶ τὸ αὐτὸ κατὰ τοῦ κυρίου καὶ κατὰ τοῦ χριστοῦ αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "συνήχθησαν γὰρ ἐπʼ ἀληθείας ⸂ἐν τῇ πόλει ταύτῃ",
          {
            "noteId": 130
          },
          "ἐπὶ τὸν ἅγιον παῖδά σου Ἰησοῦν, ὃν ἔχρισας, Ἡρῴδης τε καὶ Πόντιος Πιλᾶτος σὺν ἔθνεσιν καὶ λαοῖς Ἰσραήλ,"
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ποιῆσαι ὅσα ἡ χείρ σου καὶ ἡ ⸀βουλὴ",
          {
            "noteId": 131
          },
          "προώρισεν γενέσθαι."
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "καὶ τὰ νῦν, κύριε, ἔπιδε ἐπὶ τὰς ἀπειλὰς αὐτῶν καὶ δὸς τοῖς δούλοις σου μετὰ παρρησίας πάσης λαλεῖν τὸν λόγον σου,"
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "ἐν τῷ τὴν χεῖρά ⸀σου",
          {
            "noteId": 132
          },
          "ἐκτείνειν σε εἰς ἴασιν καὶ σημεῖα καὶ τέρατα γίνεσθαι διὰ τοῦ ὀνόματος τοῦ ἁγίου παιδός σου Ἰησοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "καὶ δεηθέντων αὐτῶν ἐσαλεύθη ὁ τόπος ἐν ᾧ ἦσαν συνηγμένοι, καὶ ἐπλήσθησαν ἅπαντες ⸂τοῦ ἁγίου πνεύματος",
          {
            "noteId": 133
          },
          ", καὶ ἐλάλουν τὸν λόγον τοῦ θεοῦ μετὰ παρρησίας."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Τοῦ δὲ πλήθους τῶν πιστευσάντων ἦν ⸀καρδία",
          {
            "noteId": 134
          },
          "καὶ ⸀ψυχὴ",
          {
            "noteId": 135
          },
          "μία, καὶ οὐδὲ εἷς τι τῶν ὑπαρχόντων ⸀αὐτῷ",
          {
            "noteId": 136
          },
          "ἔλεγεν ἴδιον εἶναι, ἀλλʼ ἦν αὐτοῖς ⸀πάντα",
          {
            "noteId": 137
          },
          "κοινά."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "καὶ ⸂δυνάμει μεγάλῃ",
          {
            "noteId": 138
          },
          "ἀπεδίδουν τὸ μαρτύριον οἱ ἀπόστολοι ⸂τῆς ἀναστάσεως τοῦ κυρίου Ἰησοῦ",
          {
            "noteId": 139
          },
          ", χάρις τε μεγάλη ἦν ἐπὶ πάντας αὐτούς."
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "οὐδὲ γὰρ ἐνδεής τις ⸀ἦν",
          {
            "noteId": 140
          },
          "ἐν αὐτοῖς· ὅσοι γὰρ κτήτορες χωρίων ἢ οἰκιῶν ὑπῆρχον, πωλοῦντες ἔφερον τὰς τιμὰς τῶν πιπρασκομένων"
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "καὶ ἐτίθουν παρὰ τοὺς πόδας τῶν ἀποστόλων· διεδίδετο δὲ ἑκάστῳ καθότι ἄν τις χρείαν εἶχεν."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "⸀Ἰωσὴφ",
          {
            "noteId": 141
          },
          "δὲ ὁ ἐπικληθεὶς Βαρναβᾶς ἀπὸ τῶν ἀποστόλων, ὅ ἐστιν μεθερμηνευόμενον υἱὸς παρακλήσεως, Λευίτης, Κύπριος τῷ γένει,"
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "ὑπάρχοντος αὐτῷ ἀγροῦ πωλήσας ἤνεγκεν τὸ χρῆμα καὶ ἔθηκεν ⸀παρὰ",
          {
            "noteId": 142
          },
          "τοὺς πόδας τῶν ἀποστόλων."
        ]
      }
    ],
