  "chapter": {
    "number": 15,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Καί τινες κατελθόντες ἀπὸ τῆς Ἰουδαίας ἐδίδασκον τοὺς ἀδελφοὺς ὅτι Ἐὰν μὴ ⸀περιτμηθῆτε",
          {
            "noteId": 523
          },
          "τῷ",
          {
            "noteId": 524
          },
          "ἔθει ⸀τῷ Μωϋσέως, οὐ δύνασθε σωθῆναι."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "γενομένης ⸀δὲ",
          {
            "noteId": 525
          },
          "στάσεως καὶ ζητήσεως οὐκ ὀλίγης τῷ Παύλῳ καὶ τῷ Βαρναβᾷ πρὸς αὐτοὺς ἔταξαν ἀναβαίνειν Παῦλον καὶ Βαρναβᾶν καί τινας ἄλλους ἐξ αὐτῶν πρὸς τοὺς ἀποστόλους καὶ πρεσβυτέρους εἰς Ἰερουσαλὴμ περὶ τοῦ ζητήματος τούτου."
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "οἱ μὲν οὖν προπεμφθέντε",
          {
            "noteId": 526
          },
          "ὑπὸ τῆς ἐκκλησίας διήρχοντο τήν ⸀τε Φοινίκην καὶ Σαμάρειαν ἐκδιηγούμενοι τὴν ἐπιστροφὴν τῶν ἐθνῶν, καὶ ἐποίουν χαρὰν μεγάλην πᾶσι τοῖς ἀδελφοῖς."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "παραγενόμενοι δὲ εἰς ⸀Ἱεροσόλυμα",
          {
            "noteId": 527
          },
          "⸀παρεδέχθησαν",
          {
            "noteId": 528
          },
          "⸀ἀπὸ",
          {
            "noteId": 529
          },
          "τῆς ἐκκλησίας καὶ τῶν ἀποστόλων καὶ τῶν πρεσβυτέρων, ἀνήγγειλάν τε ὅσα ὁ θεὸς ἐποίησεν μετʼ αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "ἐξανέστησαν δέ τινες τῶν ἀπὸ τῆς αἱρέσεως τῶν Φαρισαίων πεπιστευκότες, λέγοντες ὅτι δεῖ περιτέμνειν αὐτοὺς παραγγέλλειν τε τηρεῖν τὸν νόμον Μωϋσέως."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "Συνήχθησάν ⸀τε",
          {
            "noteId": 530
          },
          "οἱ ἀπόστολοι καὶ οἱ πρεσβύτεροι ἰδεῖν περὶ τοῦ λόγου τούτου."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "πολλῆς δὲ ⸀ζητήσεως",
          {
            "noteId": 531
          },
          "γενομένης ἀναστὰς Πέτρος εἶπεν πρὸς αὐτούς· Ἄνδρες ἀδελφοί, ὑμεῖς ἐπίστασθε ὅτι ἀφʼ ἡμερῶν ἀρχαίων ⸂ἐν ὑμῖν ἐξελέξατο ὁ θεὸς",
          {
            "noteId": 532
          },
          "διὰ τοῦ στόματός μου ἀκοῦσαι τὰ ἔθνη τὸν λόγον τοῦ εὐαγγελίου καὶ πιστεῦσαι,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "καὶ ὁ καρδιογνώστης θεὸς ἐμαρτύρησεν αὐτοῖς ⸀δοὺς",
          {
            "noteId": 533
          },
          "τὸ πνεῦμα τὸ ἅγιον καθὼς καὶ ἡμῖν,"
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "καὶ ⸀οὐθὲν",
          {
            "noteId": 534
          },
          "διέκρινεν μεταξὺ ἡμῶν τε καὶ αὐτῶν, τῇ πίστει καθαρίσας τὰς καρδίας αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "νῦν οὖν τί πειράζετε τὸν θεόν, ἐπιθεῖναι ζυγὸν ἐπὶ τὸν τράχηλον τῶν μαθητῶν ὃν οὔτε οἱ πατέρες ἡμῶν οὔτε ἡμεῖς ἰσχύσαμεν βαστάσαι;"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ἀλλὰ διὰ τῆς χάριτος τοῦ κυρίου Ἰησοῦ πιστεύομεν σωθῆναι καθʼ ὃν τρόπον κἀκεῖνοι."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "Ἐσίγησεν δὲ πᾶν τὸ πλῆθος, καὶ ἤκουον Βαρναβᾶ καὶ Παύλου ἐξηγουμένων ὅσα ἐποίησεν ὁ θεὸς σημεῖα καὶ τέρατα ἐν τοῖς ἔθνεσιν διʼ αὐτῶν."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "μετὰ δὲ τὸ σιγῆσαι αὐτοὺς ἀπεκρίθη Ἰάκωβος λέγων· Ἄνδρες ἀδελφοί, ἀκούσατέ μου."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "Συμεὼν ἐξηγήσατο καθὼς πρῶτον ὁ θεὸς ἐπεσκέψατο λαβεῖν ἐξ ἐθνῶν ⸀λαὸν",
          {
            "noteId": 535
          },
          "τῷ ὀνόματι αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "καὶ τούτῳ συμφωνοῦσιν οἱ λόγοι τῶν προφητῶν, καθὼς γέγραπται·"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "Μετὰ ταῦτα ἀναστρέψω καὶ ἀνοικοδομήσω τὴν σκηνὴν Δαυὶδ τὴν πεπτωκυῖαν καὶ τὰ ⸀κατεσκαμμένα",
          {
            "noteId": 536
          },
          "αὐτῆς ἀνοικοδομήσω καὶ ἀνορθώσω αὐτήν,"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ὅπως ἂν ἐκζητήσωσιν οἱ κατάλοιποι τῶν ἀνθρώπων τὸν κύριον, καὶ πάντα τὰ ἔθνη ἐφʼ οὓς ἐπικέκληται τὸ ὄνομά μου ἐπʼ αὐτούς, λέγει ⸀κύριος",
          {
            "noteId": 537
          },
          "ποιῶν ⸀ταῦτα",
          {
            "noteId": 538
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "γνωστὰ ἀπʼ ⸀αἰῶνος",
          {
            "noteId": 539
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "διὸ ἐγὼ κρίνω μὴ παρενοχλεῖν τοῖς ἀπὸ τῶν ἐθνῶν ἐπιστρέφουσιν ἐπὶ τὸν θεόν,"
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἀλλὰ ἐπιστεῖλαι αὐτοῖς τοῦ ⸀ἀπέχεσθαι",
          {
            "noteId": 540
          },
          "τῶν ἀλισγημάτων τῶν εἰδώλων καὶ τῆς πορνείας καὶ ⸀τοῦ",
          {
            "noteId": 541
          },
          "πνικτοῦ καὶ τοῦ αἵματος·"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Μωϋσῆς γὰρ ἐκ γενεῶν ἀρχαίων κατὰ πόλιν τοὺς κηρύσσοντας αὐτὸν ἔχει ἐν ταῖς συναγωγαῖς κατὰ πᾶν σάββατον ἀναγινωσκόμενος."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "Τότε ἔδοξε τοῖς ἀποστόλοις καὶ τοῖς πρεσβυτέροις σὺν ὅλῃ τῇ ἐκκλησίᾳ ἐκλεξαμένους ἄνδρας ἐξ αὐτῶν πέμψαι εἰς Ἀντιόχειαν σὺν ⸀τῷ",
          {
            "noteId": 542
          },
          "Παύλῳ καὶ Βαρναβᾷ, Ἰούδαν τὸν ⸀καλούμενον",
          {
            "noteId": 543
          },
          "Βαρσαββᾶν καὶ Σιλᾶν, ἄνδρας ἡγουμένους ἐν τοῖς ἀδελφοῖς,"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "γράψαντες διὰ χειρὸς ⸀αὐτῶν",
          {
            "noteId": 544
          },
          "Οἱ ἀπόστολοι καὶ οἱ ⸀πρεσβύτεροι",
          {
            "noteId": 545
          },
          "ἀδελφοὶ τοῖς κατὰ τὴν Ἀντιόχειαν καὶ Συρίαν καὶ Κιλικίαν ἀδελφοῖς τοῖς ἐξ ἐθνῶν χαίρειν."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "ἐπειδὴ ἠκούσαμεν ὅτι τινὲς ἐξ ἡμῶν ⸀ἐξελθόντες",
          {
            "noteId": 546
          },
          "ἐτάραξαν ὑμᾶς λόγοις ἀνασκευάζοντες τὰς ψυχὰς ⸀ὑμῶν",
          {
            "noteId": 547
          },
          "οἷς οὐ διεστειλάμεθα,"
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "ἔδοξεν ἡμῖν γενομένοις ὁμοθυμαδὸν ⸀ἐκλεξαμένοις",
          {
            "noteId": 548
          },
          "ἄνδρας πέμψαι πρὸς ὑμᾶς σὺν τοῖς ἀγαπητοῖς ἡμῶν Βαρναβᾷ καὶ Παύλῳ,"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ἀνθρώποις παραδεδωκόσι τὰς ψυχὰς αὐτῶν ὑπὲρ τοῦ ὀνόματος τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "ἀπεστάλκαμεν οὖν Ἰούδαν καὶ Σιλᾶν, καὶ αὐτοὺς διὰ λόγου ἀπαγγέλλοντας τὰ αὐτά."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "ἔδοξεν γὰρ τῷ ⸂πνεύματι τῷ ἁγίῳ",
          {
            "noteId": 549
          },
          "καὶ ἡμῖν μηδὲν πλέον ἐπιτίθεσθαι ὑμῖν βάρος πλὴν ⸂τούτων τῶν ἐπάναγκες",
          {
            "noteId": 550
          },
          ","
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "ἀπέχεσθαι εἰδωλοθύτων καὶ αἵματος καὶ ⸀πνικτῶν",
          {
            "noteId": 551
          },
          "καὶ πορνείας· ἐξ ὧν διατηροῦντες ἑαυτοὺς εὖ πράξετε. ἔρρωσθε."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "Οἱ μὲν οὖν ἀπολυθέντες ⸀κατῆλθον",
          {
            "noteId": 552
          },
          "εἰς Ἀντιόχειαν, καὶ συναγαγόντες τὸ πλῆθος ἐπέδωκαν τὴν ἐπιστολήν·"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "ἀναγνόντες δὲ ἐχάρησαν ἐπὶ τῇ παρακλήσει."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "Ἰούδας τε καὶ Σιλᾶς, καὶ αὐτοὶ προφῆται ὄντες, διὰ λόγου πολλοῦ παρεκάλεσαν τοὺς ἀδελφοὺς καὶ ἐπεστήριξαν·"
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "ποιήσαντες δὲ χρόνον ἀπελύθησαν μετʼ εἰρήνης ἀπὸ τῶν ἀδελφῶν πρὸς τοὺς ⸂ἀποστείλαντας αὐτούς",
          {
            "noteId": 553
          },
          "."
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "Παῦλος δὲ καὶ Βαρναβᾶς διέτριβον ἐν Ἀντιοχείᾳ διδάσκοντες καὶ εὐαγγελιζόμενοι μετὰ καὶ ἑτέρων πολλῶν τὸν λόγον τοῦ κυρίου."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "Μετὰ δέ τινας ἡμέρας εἶπεν ⸂πρὸς Βαρναβᾶν Παῦλος",
          {
            "noteId": 554
          },
          "· Ἐπιστρέψαντες δὴ ἐπισκεψώμεθα τοὺς ⸀ἀδελφοὺς",
          {
            "noteId": 555
          },
          "κατὰ ⸂πόλιν πᾶσαν",
          {
            "noteId": 556
          },
          "ἐν αἷς κατηγγείλαμεν τὸν λόγον τοῦ κυρίου, πῶς ἔχουσιν."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          "Βαρναβᾶς δὲ ⸀ἐβούλετο",
          {
            "noteId": 557
          },
          "συμπαραλαβεῖν ⸀καὶ",
          {
            "noteId": 558
          },
          "τὸν Ἰωάννην τὸν καλούμενον Μᾶρκον·"
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "Παῦλος δὲ ἠξίου, τὸν ἀποστάντα ἀπʼ αὐτῶν ἀπὸ Παμφυλίας καὶ μὴ συνελθόντα αὐτοῖς εἰς τὸ ἔργον, μὴ ⸀συμπαραλαμβάνειν",
          {
            "noteId": 559
          },
          "τοῦτον."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "ἐγένετο ⸀δὲ",
          {
            "noteId": 560
          },
          "παροξυσμὸς ὥστε ἀποχωρισθῆναι αὐτοὺς ἀπʼ ἀλλήλων, τόν τε Βαρναβᾶν παραλαβόντα τὸν Μᾶρκον ἐκπλεῦσαι εἰς Κύπρον,"
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "Παῦλος δὲ ἐπιλεξάμενος Σιλᾶν ἐξῆλθεν παραδοθεὶς τῇ χάριτι τοῦ ⸀κυρίου",
          {
            "noteId": 561
          },
          "ὑπὸ τῶν ἀδελφῶν,"
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "διήρχετο δὲ τὴν",
          {
            "noteId": 562
          },
          "Συρίαν καὶ ⸀τὴν Κιλικίαν ἐπιστηρίζων τὰς ἐκκλησίας."
        ]
      }
    ],
