  },
  "chapter": {
    "number": 27,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Ὡς δὲ ἐκρίθη τοῦ ἀποπλεῖν ἡμᾶς εἰς τὴν Ἰταλίαν, παρεδίδουν τόν τε Παῦλον καί τινας ἑτέρους δεσμώτας ἑκατοντάρχῃ ὀνόματι Ἰουλίῳ σπείρης Σεβαστῆς."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "ἐπιβάντες δὲ πλοίῳ Ἀδραμυττηνῷ ⸀μέλλοντι",
          {
            "noteId": 1015
          },
          "πλεῖν ⸀εἰς",
          {
            "noteId": 1016
          },
          "τοὺς κατὰ τὴν Ἀσίαν τόπους ἀνήχθημεν ὄντος σὺν ἡμῖν Ἀριστάρχου Μακεδόνος Θεσσαλονικέως·"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "τῇ τε ἑτέρᾳ κατήχθημεν εἰς Σιδῶνα, φιλανθρώπως τε ὁ Ἰούλιος τῷ Παύλῳ χρησάμενος ἐπέτρεψεν πρὸς τοὺς φίλους ⸀πορευθέντι",
          {
            "noteId": 1017
          },
          "ἐπιμελείας τυχεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "κἀκεῖθεν ἀναχθέντες ὑπεπλεύσαμεν τὴν Κύπρον διὰ τὸ τοὺς ἀνέμους εἶναι ἐναντίους,"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "τό τε πέλαγος τὸ κατὰ τὴν Κιλικίαν καὶ Παμφυλίαν διαπλεύσαντες κατήλθομεν εἰς Μύρα τῆς Λυκίας."
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "κἀκεῖ εὑρὼν ὁ ⸀ἑκατοντάρχης",
          {
            "noteId": 1018
          },
          "πλοῖον Ἀλεξανδρῖνον πλέον εἰς τὴν Ἰταλίαν ἐνεβίβασεν ἡμᾶς εἰς αὐτό."
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          "ἐν ἱκαναῖς δὲ ἡμέραις βραδυπλοοῦντες καὶ μόλις γενόμενοι κατὰ τὴν Κνίδον, μὴ προσεῶντος ἡμᾶς τοῦ ἀνέμου, ὑπεπλεύσαμεν τὴν Κρήτην κατὰ Σαλμώνην,"
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "μόλις τε παραλεγόμενοι αὐτὴν ἤλθομεν εἰς τόπον τινὰ καλούμενον Καλοὺς Λιμένας ᾧ ἐγγὺς ⸂ἦν πόλις",
          {
            "noteId": 1019
          },
          "⸀Λασαία",
          {
            "noteId": 1020
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "Ἱκανοῦ δὲ χρόνου διαγενομένου καὶ ὄντος ἤδη ἐπισφαλοῦς τοῦ πλοὸς διὰ τὸ καὶ τὴν νηστείαν ἤδη παρεληλυθέναι, παρῄνει ὁ Παῦλος"
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "λέγων αὐτοῖς· Ἄνδρες, θεωρῶ ὅτι μετὰ ὕβρεως καὶ πολλῆς ζημίας οὐ μόνον τοῦ φορτίου καὶ τοῦ πλοίου ἀλλὰ καὶ τῶν ψυχῶν ἡμῶν μέλλειν ἔσεσθαι τὸν πλοῦν."
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "ὁ δὲ ἑκατοντάρχης τῷ κυβερνήτῃ καὶ τῷ ναυκλήρῳ ⸂μᾶλλον ἐπείθετο",
          {
            "noteId": 1021
          },
          "ἢ τοῖς ⸀ὑπὸ",
          {
            "noteId": 1022
          },
          "Παύλου λεγομένοις."
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "ἀνευθέτου δὲ τοῦ λιμένος ὑπάρχοντος πρὸς παραχειμασίαν οἱ πλείονες ἔθεντο βουλὴν ἀναχθῆναι ⸀ἐκεῖθεν",
          {
            "noteId": 1023
          },
          "εἴ πως δύναιντο καταντήσαντες εἰς Φοίνικα παραχειμάσαι, λιμένα τῆς Κρήτης βλέποντα κατὰ λίβα καὶ κατὰ χῶρον."
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "Ὑποπνεύσαντος δὲ νότου δόξαντες τῆς προθέσεως κεκρατηκέναι ἄραντες ἆσσον παρελέγοντο τὴν Κρήτην."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "μετʼ οὐ πολὺ δὲ ἔβαλεν κατʼ αὐτῆς ἄνεμος τυφωνικὸς ὁ καλούμενος ⸀Εὐρακύλων",
          {
            "noteId": 1024
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "συναρπασθέντος δὲ τοῦ πλοίου καὶ μὴ δυναμένου ἀντοφθαλμεῖν τῷ ἀνέμῳ ἐπιδόντες ἐφερόμεθα."
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "νησίον δέ τι ὑποδραμόντες καλούμενον ⸀Καῦδα",
          {
            "noteId": 1025
          },
          "⸂ἰσχύσαμεν μόλις",
          {
            "noteId": 1026
          },
          "περικρατεῖς γενέσθαι τῆς σκάφης,"
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "ἣν ἄραντες βοηθείαις ἐχρῶντο ὑποζωννύντες τὸ πλοῖον· φοβούμενοί τε μὴ εἰς τὴν Σύρτιν ἐκπέσωσιν, χαλάσαντες τὸ σκεῦος, οὕτως ἐφέροντο."
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "σφοδρῶς δὲ χειμαζομένων ἡμῶν τῇ ἑξῆς ἐκβολὴν ἐποιοῦντο,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "καὶ τῇ τρίτῃ αὐτόχειρες τὴν σκευὴν τοῦ πλοίου ⸀ἔρριψαν",
          {
            "noteId": 1027
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "μήτε δὲ ἡλίου μήτε ἄστρων ἐπιφαινόντων ἐπὶ πλείονας ἡμέρας, χειμῶνός τε οὐκ ὀλίγου ἐπικειμένου, λοιπὸν περιῃρεῖτο ⸂ἐλπὶς πᾶσα",
          {
            "noteId": 1028
          },
          "τοῦ σῴζεσθαι ἡμᾶς."
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "Πολλῆς ⸀τε",
          {
            "noteId": 1029
          },
          "ἀσιτίας ὑπαρχούσης τότε σταθεὶς ὁ Παῦλος ἐν μέσῳ αὐτῶν εἶπεν· Ἔδει μέν, ὦ ἄνδρες, πειθαρχήσαντάς μοι μὴ ἀνάγεσθαι ἀπὸ τῆς Κρήτης κερδῆσαί τε τὴν ὕβριν ταύτην καὶ τὴν ζημίαν."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "καὶ τὰ νῦν παραινῶ ὑμᾶς εὐθυμεῖν, ἀποβολὴ γὰρ ψυχῆς οὐδεμία ἔσται ἐξ ὑμῶν πλὴν τοῦ πλοίου·"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "παρέστη γάρ μοι ταύτῃ τῇ ⸀νυκτὶ",
          {
            "noteId": 1030
          },
          "τοῦ θεοῦ, οὗ ⸀εἰμι",
          {
            "noteId": 1031
          },
          "ᾧ καὶ λατρεύω, ⸀ἄγγελος",
          {
            "noteId": 1032
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "λέγων· Μὴ φοβοῦ, Παῦλε· Καίσαρί σε δεῖ παραστῆναι, καὶ ἰδοὺ κεχάρισταί σοι ὁ θεὸς πάντας τοὺς πλέοντας μετὰ σοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "διὸ εὐθυμεῖτε, ἄνδρες· πιστεύω γὰρ τῷ θεῷ ὅτι οὕτως ἔσται καθʼ ὃν τρόπον λελάληταί μοι."
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "εἰς νῆσον δέ τινα δεῖ ἡμᾶς ἐκπεσεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Ὡς δὲ τεσσαρεσκαιδεκάτη νὺξ ἐγένετο διαφερομένων ἡμῶν ἐν τῷ Ἀδρίᾳ, κατὰ μέσον τῆς νυκτὸς ὑπενόουν οἱ ναῦται προσάγειν τινὰ αὐτοῖς χώραν."
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          "καὶ βολίσαντες εὗρον ὀργυιὰς εἴκοσι, βραχὺ δὲ διαστήσαντες καὶ πάλιν βολίσαντες εὗρον ὀργυιὰς δεκαπέντε·"
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          "φοβούμενοί τε ⸂μή που κατὰ",
          {
            "noteId": 1033
          },
          "τραχεῖς τόπους ἐκπέσωμεν ἐκ πρύμνης ῥίψαντες ἀγκύρας τέσσαρας ηὔχοντο ἡμέραν γενέσθαι."
        ]
      },
      {
        "type": "verse",
        "number": 30,
        "content": [
          "τῶν δὲ ναυτῶν ζητούντων φυγεῖν ἐκ τοῦ πλοίου καὶ χαλασάντων τὴν σκάφην εἰς τὴν θάλασσαν προφάσει ὡς ἐκ πρῴρης ⸂ἀγκύρας μελλόντων",
          {
            "noteId": 1034
          },
          "ἐκτείνειν,"
        ]
      },
      {
        "type": "verse",
        "number": 31,
        "content": [
          "εἶπεν ὁ Παῦλος τῷ ἑκατοντάρχῃ καὶ τοῖς στρατιώταις· Ἐὰν μὴ οὗτοι μείνωσιν ἐν τῷ πλοίῳ, ὑμεῖς σωθῆναι οὐ δύνασθε."
        ]
      },
      {
        "type": "verse",
        "number": 32,
        "content": [
          "τότε ⸂ἀπέκοψαν οἱ στρατιῶται",
          {
            "noteId": 1035
          },
          "τὰ σχοινία τῆς σκάφης καὶ εἴασαν αὐτὴν ἐκπεσεῖν."
        ]
      },
      {
        "type": "verse",
        "number": 33,
        "content": [
          "Ἄχρι δὲ οὗ ⸂ἡμέρα ἤμελλεν",
          {
            "noteId": 1036
          },
          "γίνεσθαι παρεκάλει ὁ Παῦλος ἅπαντας μεταλαβεῖν τροφῆς λέγων· Τεσσαρεσκαιδεκάτην σήμερον ἡμέραν προσδοκῶντες ἄσιτοι διατελεῖτε, μηθὲν προσλαβόμενοι·"
        ]
      },
      {
        "type": "verse",
        "number": 34,
        "content": [
          "διὸ παρακαλῶ ὑμᾶς ⸀μεταλαβεῖν",
          {
            "noteId": 1037
          },
          "τροφῆς, τοῦτο γὰρ πρὸς τῆς ὑμετέρας σωτηρίας ὑπάρχει· οὐδενὸς γὰρ ὑμῶν θρὶξ ⸀ἀπὸ",
          {
            "noteId": 1038
          },
          "τῆς κεφαλῆς ⸀ἀπολεῖται",
          {
            "noteId": 1039
          }
        ]
      },
      {
        "type": "verse",
        "number": 35,
        "content": [
          "⸀εἴπας",
          {
            "noteId": 1040
          },
          "δὲ ταῦτα καὶ λαβὼν ἄρτον εὐχαρίστησεν τῷ θεῷ ἐνώπιον πάντων καὶ κλάσας ἤρξατο ἐσθίειν."
        ]
      },
      {
        "type": "verse",
        "number": 36,
        "content": [
          "εὔθυμοι δὲ γενόμενοι πάντες καὶ αὐτοὶ προσελάβοντο τροφῆς."
        ]
      },
      {
        "type": "verse",
        "number": 37,
        "content": [
          {
            "noteId": 1041
          },
          "μεθα δὲ ⸂αἱ πᾶσαι ψυχαὶ ἐν τῷ πλοίῳ⸃ ⸀διακόσιαι",
          {
            "noteId": 1042
          },
          "ἑβδομήκοντα ἕξ."
        ]
      },
      {
        "type": "verse",
        "number": 38,
        "content": [
          "κορεσθέντες ⸀δὲ",
          {
            "noteId": 1043
          },
          "τροφῆς ἐκούφιζον τὸ πλοῖον ἐκβαλλόμενοι τὸν σῖτον εἰς τὴν θάλασσαν."
        ]
      },
      {
        "type": "verse",
        "number": 39,
        "content": [
          "Ὅτε δὲ ἡμέρα ἐγένετο, τὴν γῆν οὐκ ἐπεγίνωσκον, κόλπον δέ τινα κατενόουν ἔχοντα αἰγιαλὸν εἰς ὃν ⸀ἐβουλεύοντο",
          {
            "noteId": 1044
          },
          "εἰ ⸀δύναιντο",
          {
            "noteId": 1045
          },
          "⸀ἐξῶσαι",
          {
            "noteId": 1046
          },
          "τὸ πλοῖον."
        ]
      },
      {
        "type": "verse",
        "number": 40,
        "content": [
          "καὶ τὰς ἀγκύρας περιελόντες εἴων εἰς τὴν θάλασσαν, ἅμα ἀνέντες τὰς ζευκτηρίας τῶν πηδαλίων, καὶ ἐπάραντες τὸν ἀρτέμωνα τῇ πνεούσῃ κατεῖχον εἰς τὸν αἰγιαλόν."
        ]
      },
      {
        "type": "verse",
        "number": 41,
        "content": [
          "περιπεσόντες δὲ εἰς τόπον διθάλασσον ⸀ἐπέκειλαν",
          {
            "noteId": 1047
          },
          "τὴν ναῦν, καὶ ἡ μὲν πρῷρα ἐρείσασα ἔμεινεν ἀσάλευτος, ἡ δὲ πρύμνα ἐλύετο ὑπὸ τῆς ⸀βίας",
          {
            "noteId": 1048
          }
        ]
      },
      {
        "type": "verse",
        "number": 42,
        "content": [
          "τῶν δὲ στρατιωτῶν βουλὴ ἐγένετο ἵνα τοὺς δεσμώτας ἀποκτείνωσιν, μή τις ἐκκολυμβήσας διαφύγῃ·"
        ]
      },
      {
        "type": "verse",
        "number": 43,
        "content": [
          "ὁ δὲ ⸀ἑκατοντάρχης",
          {
            "noteId": 1049
          },
          "βουλόμενος διασῶσαι τὸν Παῦλον ἐκώλυσεν αὐτοὺς τοῦ βουλήματος, ἐκέλευσέν τε τοὺς δυναμένους κολυμβᾶν ἀπορίψαντας πρώτους ἐπὶ τὴν γῆν ἐξιέναι,"
        ]
      },
      {
        "type": "verse",
        "number": 44,
        "content": [
          "καὶ τοὺς λοιποὺς οὓς μὲν ἐπὶ σανίσιν οὓς δὲ ἐπί τινων τῶν ἀπὸ τοῦ πλοίου· καὶ οὕτως ἐγένετο πάντας διασωθῆναι ἐπὶ τὴν γῆν."
        ]
      }
    ],
