  "chapter": {
    "number": 24,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          "Μετὰ δὲ πέντε ἡμέρας κατέβη ὁ ἀρχιερεὺς Ἁνανίας μετὰ ⸂πρεσβυτέρων τινῶν",
          {
            "noteId": 899
          },
          "καὶ ῥήτορος Τερτύλλου τινός, οἵτινες ἐνεφάνισαν τῷ ἡγεμόνι κατὰ τοῦ Παύλου."
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          "κληθέντος δὲ αὐτοῦ ἤρξατο κατηγορεῖν ὁ Τέρτυλλος λέγων· Πολλῆς εἰρήνης τυγχάνοντες διὰ σοῦ καὶ ⸀διορθωμάτων",
          {
            "noteId": 900
          },
          "γινομένων τῷ ἔθνει τούτῳ διὰ τῆς σῆς προνοίας"
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          "πάντῃ τε καὶ πανταχοῦ ἀποδεχόμεθα, κράτιστε Φῆλιξ, μετὰ πάσης εὐχαριστίας."
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          "ἵνα δὲ μὴ ἐπὶ πλεῖόν σε ἐγκόπτω, παρακαλῶ ἀκοῦσαί σε ἡμῶν συντόμως τῇ σῇ ἐπιεικείᾳ."
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          "εὑρόντες γὰρ τὸν ἄνδρα τοῦτον λοιμὸν καὶ κινοῦντα ⸀στάσεις",
          {
            "noteId": 901
          },
          "πᾶσι τοῖς Ἰουδαίοις τοῖς κατὰ τὴν οἰκουμένην πρωτοστάτην τε τῆς τῶν Ναζωραίων αἱρέσεως,"
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          "ὃς καὶ τὸ ἱερὸν ἐπείρασεν βεβηλῶσαι, ὃν καὶ ⸀ἐκρατήσαμεν",
          {
            "noteId": 902
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          "παρʼ οὗ δυνήσῃ αὐτὸς ἀνακρίνας περὶ πάντων τούτων ἐπιγνῶναι ὧν ἡμεῖς κατηγοροῦμεν αὐτοῦ."
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          "συνεπέθεντο δὲ καὶ οἱ Ἰουδαῖοι φάσκοντες ταῦτα οὕτως ἔχειν."
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          "Ἀπεκρίθη ⸀τε",
          {
            "noteId": 903
          },
          "ὁ Παῦλος νεύσαντος αὐτῷ τοῦ ἡγεμόνος λέγειν· Ἐκ πολλῶν ἐτῶν ὄντα σε κριτὴν τῷ ἔθνει τούτῳ ἐπιστάμενος ⸀εὐθύμως",
          {
            "noteId": 904
          },
          "τὰ περὶ ἐμαυτοῦ ἀπολογοῦμαι,"
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          "δυναμένου σου ⸀ἐπιγνῶναι",
          {
            "noteId": 905
          },
          "ὅτι οὐ πλείους εἰσίν μοι ἡμέραι ⸀δώδεκα",
          {
            "noteId": 906
          },
          "ἀφʼ ἧς ἀνέβην προσκυνήσων ⸀εἰς",
          {
            "noteId": 907
          },
          "Ἰερουσαλήμ,"
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          "καὶ οὔτε ἐν τῷ ἱερῷ εὗρόν με πρός τινα διαλεγόμενον ἢ ⸀ἐπίστασιν",
          {
            "noteId": 908
          },
          "ποιοῦντα ὄχλου οὔτε ἐν ταῖς συναγωγαῖς οὔτε κατὰ τὴν πόλιν,"
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          "⸀οὐδὲ",
          {
            "noteId": 909
          },
          "⸀παραστῆσαι",
          {
            "noteId": 910
          },
          "δύνανταί ⸀σοι",
          {
            "noteId": 911
          },
          "περὶ ὧν ⸀νυνὶ",
          {
            "noteId": 912
          },
          "κατηγοροῦσίν μου."
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          "ὁμολογῶ δὲ τοῦτό σοι ὅτι κατὰ τὴν ὁδὸν ἣν λέγουσιν αἵρεσιν οὕτως λατρεύω τῷ πατρῴῳ θεῷ, πιστεύων πᾶσι τοῖς κατὰ τὸν νόμον καὶ ⸂τοῖς ἐν",
          {
            "noteId": 913
          },
          "τοῖς προφήταις γεγραμμένοις,"
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          "ἐλπίδα ἔχων εἰς τὸν θεόν, ἣν καὶ αὐτοὶ οὗτοι προσδέχονται, ἀνάστασιν μέλλειν ⸀ἔσεσθαι",
          {
            "noteId": 914
          },
          "δικαίων τε καὶ ἀδίκων·"
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          "ἐν τούτῳ ⸀καὶ",
          {
            "noteId": 915
          },
          "αὐτὸς ἀσκῶ ἀπρόσκοπον συνείδησιν ⸀ἔχειν",
          {
            "noteId": 916
          },
          "πρὸς τὸν θεὸν καὶ τοὺς ἀνθρώπους διὰ παντός."
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          "διʼ ἐτῶν δὲ πλειόνων ⸂ἐλεημοσύνας ποιήσων εἰς τὸ ἔθνος μου παρεγενόμην",
          {
            "noteId": 917
          },
          "καὶ προσφοράς,"
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          "ἐν ⸀αἷς",
          {
            "noteId": 918
          },
          "εὗρόν με ἡγνισμένον ἐν τῷ ἱερῷ, οὐ μετὰ ὄχλου οὐδὲ μετὰ θορύβου,"
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          "τινὲς δὲ ἀπὸ τῆς Ἀσίας Ἰουδαῖοι, οὓς ⸀ἔδει",
          {
            "noteId": 919
          },
          "ἐπὶ σοῦ παρεῖναι καὶ κατηγορεῖν εἴ τι ἔχοιεν πρὸς ⸀ἐμέ",
          {
            "noteId": 920
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          "ἢ αὐτοὶ οὗτοι εἰπάτωσαν τί ⸀εὗρον",
          {
            "noteId": 921
          },
          "ἀδίκημα στάντος μου ἐπὶ τοῦ συνεδρίου"
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          "ἢ περὶ μιᾶς ταύτης φωνῆς ἧς ἐκέκραξα ⸂ἐν αὐτοῖς ἑστὼς",
          {
            "noteId": 922
          },
          "ὅτι Περὶ ἀναστάσεως νεκρῶν ἐγὼ κρίνομαι σήμερον ⸀ἐφʼ",
          {
            "noteId": 923
          },
          "ὑμῶν."
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          "⸂Ἀνεβάλετο δὲ αὐτοὺς ὁ Φῆλιξ",
          {
            "noteId": 924
          },
          ", ἀκριβέστερον εἰδὼς τὰ περὶ τῆς ὁδοῦ, ⸀εἴπας",
          {
            "noteId": 925
          },
          "Ὅταν Λυσίας ὁ χιλίαρχος καταβῇ διαγνώσομαι τὰ καθʼ ὑμᾶς·"
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          "⸀διαταξάμενος",
          {
            "noteId": 926
          },
          "τῷ ἑκατοντάρχῃ τηρεῖσθαι ⸀αὐτὸν",
          {
            "noteId": 927
          },
          "ἔχειν τε ἄνεσιν καὶ μηδένα κωλύειν τῶν ἰδίων αὐτοῦ ⸀ὑπηρετεῖν",
          {
            "noteId": 928
          },
          "αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          "Μετὰ δὲ ἡμέρας τινὰς παραγενόμενος ὁ Φῆλιξ σὺν Δρουσίλλῃ τῇ ⸀ἰδίᾳ",
          {
            "noteId": 929
          },
          "γυναικὶ οὔσῃ Ἰουδαίᾳ μετεπέμψατο τὸν Παῦλον καὶ ἤκουσεν αὐτοῦ περὶ τῆς εἰς Χριστὸν ⸀Ἰησοῦν",
          {
            "noteId": 930
          },
          "πίστεως."
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          "διαλεγομένου δὲ αὐτοῦ περὶ δικαιοσύνης καὶ ἐγκρατείας καὶ τοῦ κρίματος τοῦ ⸀μέλλοντος",
          {
            "noteId": 931
          },
          "ἔμφοβος γενόμενος ὁ Φῆλιξ ἀπεκρίθη· Τὸ νῦν ἔχον πορεύου, καιρὸν δὲ μεταλαβὼν μετακαλέσομαί σε·"
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          "ἅμα καὶ ἐλπίζων ὅτι χρήματα δοθήσεται αὐτῷ ὑπὸ τοῦ ⸀Παύλου",
          {
            "noteId": 932
          },
          "διὸ καὶ πυκνότερον αὐτὸν μεταπεμπόμενος ὡμίλει αὐτῷ."
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          "Διετίας δὲ πληρωθείσης ἔλαβεν διάδοχον ὁ Φῆλιξ Πόρκιον Φῆστον· θέλων τε ⸀χάριτα",
          {
            "noteId": 933
          },
          "καταθέσθαι τοῖς Ἰουδαίοις ὁ Φῆλιξ κατέλιπε τὸν Παῦλον δεδεμένον."
        ]
      }
