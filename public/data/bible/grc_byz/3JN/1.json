    "numberOfChapters": 1,
    "sha256": "c93c8d51fdcc4018cae4df931ee1d6e160ed8250bd0ce5a7d09a9b71ac2da78c",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_byz/3JN/1.json",
