    "order": 54,
    "numberOfChapters": 6,
    "sha256": "9e5a19a2da525a55bd7634862692695a7c868de961c2ef9504f8e769b77fa2d8",
    "firstChapterNumber": 1,
    "firstChapterApiLink": "/api/grc_byz/1TI/1.json",
