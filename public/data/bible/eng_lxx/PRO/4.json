        }
      },
      {
        "noteId": 19,
        "caller": "+",
        "text": "Gr. wheel-tracks, see chap 2:18; Heb 12:13.",
        "reference": {
          "chapter": 4,
          "verse": 11
        }
      },
      {
        "noteId": 20,
        "caller": "+",
        "text": "Gr. order itself aright.",
        "reference": {
          "chapter": 4,
          "verse": 18
        }
      },
      {
        "noteId": 21,
        "caller": "+",
        "text": "Or, healing.",
        "reference": {
