  "chapter": {
    "number": 23,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "(24) A Psalm for David on the first day of the week."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "The earth is the Lord's and the fullness thereof; the world, and all that dwell in it.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "He has founded it upon the seas, and prepared it upon the rivers.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Who shall go up to the mountain of the Lord, and who shall stand in his holy place?",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "He that is innocent in his hands and pure in his heart; who has not lifted up his soul to vanity, nor sworn deceitfully",
            "poem": 1
          },
          {
            "noteId": 42
          },
          {
            "text": "to his neighbor.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "He shall receive a blessing from the Lord, and mercy from God his Saviour.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "This is the generation of them that seek him, that seek the face of the God of Jacob. Pause.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Lift up your gates, you⌃ princes, and be you⌃ lifted up, you⌃ everlasting doors; and the king of glory shall come in.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Who is this king of Glory? the Lord strong and mighty, the Lord mighty in battle.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Lift up your gates, you⌃ princes; and be you⌃ lift up, you⌃ everlasting doors; and the king of glory shall come in.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Who is this king of glory? The Lord of hosts, he is this king of glory.",
            "poem": 1
          }
        ]
      }
    ],
