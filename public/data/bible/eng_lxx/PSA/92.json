  "chapter": {
    "number": 92,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "(93) For",
          {
            "noteId": 180
          },
          "the day before the Sabbath, when the land was first inhabited, the praise of a Song by David."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "The Lord reigns; he has clothed himself with honor: the Lord has clothed and girded himself with strength; for he has established the world, which shall not be moved.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Your throne is prepared of old: you are from everlasting.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "The rivers have lifted up, O Lord, the rivers have lifted up their voices,",
            "poem": 1
          },
          {
            "noteId": 181
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "at",
            "poem": 1
          },
          {
            "noteId": 182
          },
          {
            "text": "the voices of many waters: the billows of the sea are wonderful: the Lord is wonderful in high places.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Your testimonies are made very sure: holiness becomes your house, O Lord,",
            "poem": 1
          },
          {
            "noteId": 183
          },
          {
            "text": "for ever.",
            "poem": 1
          }
        ]
      }
    ],
