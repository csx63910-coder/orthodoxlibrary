        "reference": {
          "chapter": 38,
          "verse": 6
        }
      },
      {
        "noteId": 75,
        "caller": "+",
        "text": "Gr. made dumb.",
        "reference": {
          "chapter": 38,
          "verse": 9
        }
      }
    ]
  },
