  "chapter": {
    "number": 25,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "(26) A Psalm of David."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Judge me, O Lord; for I have walked in my innocence: and hoping in the Lord I shall not be moved.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Prove me, O Lord, and try me; purify as with fire my reins and my heart.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "For your mercy is before my eyes: and I am well pleased with your truth.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "I have not sat with the council of vanity, and will in nowise enter in with transgressors.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "I have hated the assembly of wicked doers; and will not sit with ungodly men.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "I will wash my hands in",
            "poem": 1
          },
          {
            "noteId": 45
          },
          {
            "text": "innocency, and compass your altar, O Lord:",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "to hear the voice of praise, and to declare all your wonderful works.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "O Lord, I have loved the beauty of your house, and the place of the tabernacle of your glory.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Destroy not my soul together with the ungodly, nor my life with bloody men:",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "in whose hands are iniquities, and their right hand is filled with bribes.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "But I have walked in my innocence: redeem me, and have mercy upon me.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "My foot stands in",
            "poem": 1
          },
          {
            "noteId": 46
          },
          {
            "text": "an even place: in the congregations will I bless you, O Lord.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 45,
        "caller": "+",
        "text": "Gr. innocent things.",
        "reference": {
          "chapter": 25,
          "verse": 6
        }
      },
      {
        "noteId": 46,
        "caller": "+",
        "text": "Gr. in evenness or uprightness.",
        "reference": {
          "chapter": 25,
          "verse": 12
        }
      }
    ]
