  "chapter": {
    "number": 150,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Alleluia."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Praise God in his holy places: praise him in the firmament of his power.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Praise him on account of his mighty acts: praise him according to his abundant greatness.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Praise him with the sound of a trumpet: praise him with lute and harp.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Praise him with timbrel and dance: praise him with stringed instruments and the organ.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Praise him with melodious cymbals: praise him with loud cymbals.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Let every thing that has breath praise the Lord.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
