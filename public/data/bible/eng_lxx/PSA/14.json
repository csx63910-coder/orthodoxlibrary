  "chapter": {
    "number": 14,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "(15) A Psalm of David."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "O Lord, who shall sojourn in your tabernacle? and who shall dwell in your holy mountain?",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "He that walks blameless, and works righteousness, who speaks truth in his heart.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Who has not spoken craftily with his tongue, neither has done evil to his neighbor, nor taken up a reproach against them that lived nearest to him.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "In his sight an evil-worker is set at nothing, but he honors them that fear the Lord. He swears to his neighbor, and disappoints him not.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "He has not",
            "poem": 1
          },
          {
            "noteId": 25
          },
          {
            "text": "lent his money on usury, and has not received bribes against the innocent. He that does these things shall never be moved.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 25,
        "caller": "+",
        "text": "Gr. given.",
        "reference": {
          "chapter": 14,
          "verse": 5
        }
      }
    ]
