  "chapter": {
    "number": 148,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Alleluia, a Psalm of Aggaeus and Zacharias."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Praise you⌃ the Lord from the heavens: praise him in the highest.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Praise you⌃ him, all his angels: praise you⌃ him, all his hosts.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Praise him, sun and moon; praise him, all you⌃ stars and light.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Praise him, you⌃ heavens of heavens, and the water that is above the heavens.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Let them praise the name of the Lord: for he spoke, and they were made; he commanded, and they were created.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "He has established them for ever, even for ever and ever: he has made an ordinance, and it shall not pass away.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Praise the Lord from the earth, you⌃ serpents, and all deeps.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Fire, hail, snow, ice, stormy wind; the things that perform his word.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "Mountains, and all hills; fruitful trees, and all cedars:",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "wild beasts, and all cattle; reptiles, and winged birds:",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "kings of the earth, and all peoples; princes, and all judges of the earth:",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "young men and virgins, old men with youths:",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "let them praise the name of the Lord: for his name only is exalted; his praise is above the earth and heaven,",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "and he shall exalt the horn of his people,",
            "poem": 1
          },
          {
            "noteId": 268
          },
          {
            "text": "there is a hymn for all his saints, even of the children of Israel, a people who draw near to him.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 268,
        "caller": "+",
        "text": "Or, who is the praise of.",
        "reference": {
          "chapter": 148,
          "verse": 14
        }
      }
    ]
  },
