  "chapter": {
    "number": 117,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "(118) Alleluia."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Give thanks to the Lord; for he is good: for his mercy endures for ever.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Let now the house of Israel say, that he is good: for his mercy endures for ever.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Let now the house of Aaron say, that he is good: for his mercy endures for ever.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Let now all that fear the Lord say, that he is good: for his mercy endures for ever.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "I called on the Lord out of affliction: and he listened to me, so as to bring me into a wide place.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "The Lord is my helper; and I will not fear what man shall do to me.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "The Lord is my helper; and I shall see my desire upon my enemies.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "It is better to trust in the Lord than to trust in man.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "It is better to hope in the Lord, than to hope in princes.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "All nations compassed me about: but in the name of the Lord I repulsed them.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "They completely compassed me about: but in the name of the Lord I repulsed them.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "They compassed me about as bees do a honeycomb, and they burst into flame as fire among thorns: but in the name of the Lord I repulsed them.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "I was thrust, and sorely shaken, that I might fall: but the Lord helped me.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "The Lord is my strength and my song, and is become my salvation.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "The voice of exultation and salvation is in the tabernacles of the righteous: the right hand of the Lord has wrought mightily.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "The right hand of the Lord has exalted me: the right hand of the Lord has wrought powerfully.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "I shall not die, but live, and recount the works of the Lord.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "The Lord has chastened me sore: but he has not given me up to death.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "Open to me the gates of righteousness: I will go into them, and give praise to the Lord.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "This is the gate of the Lord: the righteous shall enter by it.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "I will give thanks to you; because you have heard me, and are become my salvation.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 22,
        "content": [
          {
            "text": "The stone which the builders rejected, the same is become the head of the corner.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 23,
        "content": [
          {
            "text": "This has been done of the Lord; and it is wonderful in our eyes.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 24,
        "content": [
          {
            "text": "This is the day which the Lord has made: let us exult and rejoice in it.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 25,
        "content": [
          {
            "text": "O Lord, save now: O Lord, send now prosperity.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 26,
        "content": [
          {
            "text": "Blessed is he that comes in the name of the Lord: we have blessed you out of the house of the Lord.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 27,
        "content": [
          {
            "text": "God is the Lord, and he has shined upon us: celebrate the feast with",
            "poem": 1
          },
          {
            "noteId": 218
          },
          {
            "text": "thick branches, binding the victims even to the horns of the altar.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 28,
        "content": [
          {
            "text": "You are my God, and I will give you thanks: you are my God, and I will exalt you. I will give thanks to you, for you have heard me, and are become my salvation.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 29,
        "content": [
          {
            "text": "Give thanks to the Lord; for he is good: for his mercy endures for ever.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 218,
        "caller": "+",
        "text": "Possibly, the multitude, q. d. cœtu frequenti.",
        "reference": {
          "chapter": 117,
          "verse": 27
        }
      }
    ]
  },
