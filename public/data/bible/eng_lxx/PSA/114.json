  "chapter": {
    "number": 114,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "(115)"
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Not to us, O Lord, not to us, but to your name give glory, because of your mercy and your truth;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "lest at any time the nations should say, Where is their God?",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "But our God has done in heaven and on earth, whatever he has pleased.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "The idols of the nations are silver and gold, the works of men's hands.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "They have a mouth, but they",
            "poem": 1
          },
          {
            "noteId": 213
          },
          {
            "text": "can’t speak; they have eyes, but they can’t see:",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "they have ears, but they can’t hear; they have noses, but they can’t smell;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "they have hands, but they can’t handle; they have feet, but they can’t walk: they can’t speak through their throat.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Let those that make them become like to them, and all who trust in them.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "The house of Israel trusts in the Lord: he is their helper and defender.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "The house of Aaron trusts in the Lord: he is their helper and defender.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "They that fear the Lord trust in the Lord: he is their helper and defender.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "The Lord has remembered us, and blessed us: he has blessed the house of Israel, he has blessed the house of Aaron.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "He has blessed them that fear the Lord, both small and great.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "The Lord",
            "poem": 1
          },
          {
            "noteId": 214
          },
          {
            "text": "add blessings to you and to your children.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "Blessed are you⌃ of the Lord, who made the heaven and the earth.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "The heaven of",
            "poem": 1
          },
          {
            "noteId": 215
          },
          {
            "text": "heavens belongs to the Lord: but he has given the earth to the sons of men.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "The dead shall not praise you, O Lord, nor any that go down to Hades.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "But we, the living, will bless the Lord, from henceforth and for ever.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 213,
        "caller": "+",
        "text": "Gr. will not.",
        "reference": {
          "chapter": 114,
          "verse": 5
        }
      },
      {
        "noteId": 214,
        "caller": "+",
        "text": "Or, increase you.",
        "reference": {
          "chapter": 114,
          "verse": 14
        }
      },
      {
        "noteId": 215,
        "caller": "+",
        "text": "Gr. sing.",
        "reference": {
          "chapter": 114,
          "verse": 16
        }
      }
    ]
  },
