  "chapter": {
    "number": 128,
    "content": [
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "A Song of Degrees. Many a time have they warred against me from my youth, let Israel now say:",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Many a time have they warred against me from my youth: and yet they prevailed not against me.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "The sinners wrought upon my back: they prolonged their",
            "poem": 1
          },
          {
            "noteId": 233
          },
          {
            "text": "iniquity.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "The righteous Lord has cut asunder the necks of sinners.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Let all that hate Sion be put to shame and turned back.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Let them be as the grass of the housetops, which withers before it is plucked up.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Wherewith the reaper fills not his hand, nor he that makes up the sheaves, his bosom.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "Neither do they that go by say, The blessing of the Lord be upon you: we have blessed you in the name of the Lord.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 233,
        "caller": "+",
        "text": "שיך iniquity, easily read for שוכה a furrow.",
        "reference": {
          "chapter": 128,
          "verse": 3
        }
      }
    ]
  },
