  "chapter": {
    "number": 127,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "(128) A Song of Degrees."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Blessed are all they that fear the Lord; who walk in his ways.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "You shall eat the",
            "poem": 1
          },
          {
            "noteId": 232
          },
          {
            "text": "labors of your hands: blessed are you, and it shall be well with you.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Your wife shall be as a fruitful vine on the sides of your house: your children as young olive-plants round about your table.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Behold, thus shall the man be blessed that fears the Lord.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "May the Lord bless you out of Sion; and may you see the prosperity of Jerusalem all the days of your life.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "And may you see your children's children. Peace be upon Israel.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 232,
        "caller": "+",
        "text": "Alex. fruits of your labors.",
        "reference": {
          "chapter": 127,
          "verse": 2
        }
      }
    ]
