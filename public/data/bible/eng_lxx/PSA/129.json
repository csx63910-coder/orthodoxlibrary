  "chapter": {
    "number": 129,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "(130) A Song of Degrees."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Out of the depths have I cried to you, O Lord.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "O Lord, listen to my voice; let your ears be attentive to the voice of my supplication.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "If you, O Lord, should mark iniquities, O Lord, who shall stand?",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "For with you is",
            "poem": 1
          },
          {
            "noteId": 234
          },
          {
            "text": "forgiveness: for your",
            "poem": 1
          },
          {
            "noteId": 235
          },
          {
            "text": "name's sake",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "have I waited for you, O Lord, my soul has waited for your word.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "My soul has hoped in the Lord; from the morning watch till night.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "Let Israel hope in the Lord: for with the Lord is mercy, and with him is plenteous redemption.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "And he shall redeem Israel from all his iniquities.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 234,
        "caller": "+",
        "text": "Or, propitiation.",
        "reference": {
          "chapter": 129,
          "verse": 4
        }
      },
      {
        "noteId": 235,
        "caller": "+",
        "text": "See Gen 31:53.",
        "reference": {
          "chapter": 129,
          "verse": 4
        }
      }
    ]
