  "chapter": {
    "number": 147,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "Alleluia, a Psalm of Aggaeus and Zacharias.",
          {
            "noteId": 265
          }
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Praise the Lord, O Jerusalem; praise your God, O Sion.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "For he has strengthened the bars of your gates; he has blessed your children within you.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "He makes your borders peaceful, and fills you with the",
            "poem": 1
          },
          {
            "noteId": 266
          },
          {
            "text": "flour of wheat.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "He sends his oracle to the earth: his word will run swiftly.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "He gives snow like wool: he scatters the mist like ashes.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Casting forth his ice like morsels: who shall stand before his cold?",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "He shall send out his word, and melt them: he shall blow with his wind, and the waters shall flow.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "He sends his word to Jacob, his ordinances and judgments to Israel.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "He has not done so to",
            "poem": 1
          },
          {
            "noteId": 267
          },
          {
            "text": "any other nation; and he has not shown them his judgments.",
            "poem": 1
          }
        ]
      }
    ],
