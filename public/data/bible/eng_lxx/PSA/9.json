        "text": "Gr. inflamed, as in a fever.",
        "reference": {
          "chapter": 9,
          "verse": 22
        }
      },
      {
        "noteId": 18,
        "caller": "+",
        "text": "Or, anger.",
        "reference": {
          "chapter": 9,
          "verse": 24
        }
      },
      {
        "noteId": 19,
        "caller": "+",
        "text": "Gr. profaned.",
        "reference": {
          "chapter": 9,
          "verse": 25
        }
      },
      {
        "noteId": 20,
        "caller": "+",
        "text": "Gr. look.",
        "reference": {
          "chapter": 9,
          "verse": 28
        }
      }
    ]
  },
