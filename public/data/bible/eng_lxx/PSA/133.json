      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Behold now, bless you⌃ the Lord, all the servants of the Lord, who stand in the house of the Lord, in the courts of the house of our God.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Lift up your hands by night",
            "poem": 1
          },
          {
            "noteId": 240
          },
          {
            "text": "in the sanctuaries, and bless the Lord.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "May the Lord, who made heaven and earth, bless you out of Sion.",
            "poem": 1
          }
        ]
      }
    ],
