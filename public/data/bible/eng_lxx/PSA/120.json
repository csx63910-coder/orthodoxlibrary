  "chapter": {
    "number": 120,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "(121) A Song of Degrees."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "I lifted up my eyes to the mountains, whence my help shall come.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "My help shall come from the Lord, who made the heaven and the earth.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "Let not your foot be moved; and let not your keeper slumber.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Behold, he that keeps Israel shall not slumber nor sleep.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "The Lord shall keep you: the Lord is your shelter upon your right hand.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "The sun shall not burn you by day, neither the moon by night.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "May the Lord preserve you from all evil: the Lord shall keep your soul.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "The Lord shall keep your coming in, and your going out, from henceforth and even for ever.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
