        "reference": {
          "chapter": 67,
          "verse": 33
        }
      },
      {
        "noteId": 122,
        "caller": "+",
        "text": "Or, among his holy ones.",
        "reference": {
          "chapter": 67,
          "verse": 35
        }
      }
    ]
  },
