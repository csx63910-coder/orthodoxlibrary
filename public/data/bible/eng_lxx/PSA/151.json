  "chapter": {
    "number": 151,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "This Psalm is a genuine one of David, though supernumerary, composed when he fought in single combat with",
          {
            "noteId": 271
          },
          "Goliad."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "I was small among my brethren, and youngest in my father's house: I tended my father's sheep.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "My hands formed a musical instrument, and my fingers tuned a lute.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "And who shall tell my Lord? the Lord himself, he himself hears.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "He sent forth his angel, and took me from my father's sheep, and he anointed me with the oil of his anointing.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "My brothers were handsome and tall; but the Lord did not take pleasure in them.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "I went forth to meet the Philistine; and he cursed me by his idols.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "But I drew his own sword, and beheaded him, and removed reproach from the children of Israel.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 271,
        "caller": "+",
        "text": "Alex. Goliath",
        "reference": {
          "chapter": 151,
          "verse": 0
        }
      }
    ]
