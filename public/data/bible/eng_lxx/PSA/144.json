  "chapter": {
    "number": 144,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "(145) David's Psalm of praise."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "I will exalt you, my God, my king; and I will bless your name",
            "poem": 1
          },
          {
            "noteId": 260
          },
          {
            "text": "for ever and ever.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "Every day will I bless you, and I will praise your name",
            "poem": 1
          },
          {
            "noteId": 261
          },
          {
            "text": "for ever and ever.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "The Lord is great, and greatly to be praised; and there is no end to his greatness.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Generation after generation shall praise your works, and tell of your power.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "And they shall speak of the glorious majesty of your holiness, and recount your wonders.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "And they shall speak of the power of your terrible acts; and recount your greatness.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 7,
        "content": [
          {
            "text": "They shall utter the memory of the abundance of your goodness, and shall exult in your righteousness.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          {
            "text": "The Lord is compassionate, and merciful; long suffering, and abundant in mercy.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 9,
        "content": [
          {
            "text": "The Lord is good to those that wait on him; and his compassions are over all his works.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 10,
        "content": [
          {
            "text": "Let all your works, O Lord, give thanks to you; and let your saints bless you.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 11,
        "content": [
          {
            "text": "They shall speak of the glory of your kingdom, and talk of your dominion;",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 12,
        "content": [
          {
            "text": "to make known to the sons of men your power, and the glorious majesty of your kingdom.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 13,
        "content": [
          {
            "text": "Your kingdom is",
            "poem": 1
          },
          {
            "noteId": 262
          },
          {
            "text": "an everlasting kingdom, and your dominion endures",
            "poem": 1
          },
          {
            "noteId": 263
          },
          {
            "text": "through all generations. The Lord is faithful in his words, and holy in all his works.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 14,
        "content": [
          {
            "text": "The Lord supports all that are falling, and sets up all that are broken down.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 15,
        "content": [
          {
            "text": "The eyes of all wait upon you; and you give them their food in due season.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 16,
        "content": [
          {
            "text": "You open your hands, and fill every living thing with pleasure.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 17,
        "content": [
          {
            "text": "The Lord is righteous in all his ways, and holy in all his works.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 18,
        "content": [
          {
            "text": "The Lord is near to all that call upon him, to all that call upon him in truth.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 19,
        "content": [
          {
            "text": "He will perform the desire of them that fear him: and he will hear their supplication, and save them.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 20,
        "content": [
          {
            "text": "The Lord preserves all that love him: but all sinners he will utterly destroy.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 21,
        "content": [
          {
            "text": "My mouth shall speak the praise of the Lord: and let all flesh bless his holy name for ever and ever.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 260,
        "caller": "+",
        "text": "Lit. to the age, and to the age of the age.",
        "reference": {
          "chapter": 144,
          "verse": 1
        }
      },
      {
        "noteId": 261,
        "caller": "+",
        "text": "Lit. to the age, and to the age of the age.",
        "reference": {
          "chapter": 144,
          "verse": 2
        }
      },
      {
        "noteId": 262,
        "caller": "+",
        "text": "Gr. a kingdom of all ages.",
        "reference": {
          "chapter": 144,
          "verse": 13
        }
      },
      {
        "noteId": 263,
        "caller": "+",
        "text": "Gr. in every generation and generation.",
        "reference": {
          "chapter": 144,
          "verse": 13
        }
      }
    ]
  },
